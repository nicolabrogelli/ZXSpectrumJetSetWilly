1092+ 6B59              ; -------------------------------------------------------------------
1093+ 6B59              ; GetRampY
1094+ 6B59              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1095+ 6B59              ; Input: C = PlayerX
1096+ 6B59              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1097+ 6B59              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1098+ 6B59              ; -------------------------------------------------------------------
1099+ 6B59              GetRampY:
1100+ 6B59 3A 88 76         ld   a, (ramp_len)
1101+ 6B5C B7               or   a
1102+ 6B5D C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1103+ 6B5E
1104+ 6B5E 3A 87 76         ld   a, (ramp_dir)
1105+ 6B61 B7               or   a
1106+ 6B62 28 4C            jr   z, .dir_left
1107+ 6B64
1108+ 6B64              .dir_right:
1109+ 6B64                  ; Rampa sale a destra (up-right)
1110+ 6B64 3A 8A 76         ld   a, (ramp_col)
1111+ 6B67 87               add  a, a              ; *2
1112+ 6B68 87               add  a, a              ; *4
1113+ 6B69 87               add  a, a              ; *8 (X start in pixel)
1114+ 6B6A 5F               ld   e, a              ; E = X_left
1115+ 6B6B
1116+ 6B6B 3A 88 76         ld   a, (ramp_len)
1117+ 6B6E 87               add  a, a              ; *2
1118+ 6B6F 87               add  a, a              ; *4
1119+ 6B70 87               add  a, a              ; *8
1120+ 6B71 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1121+ 6B72 67               ld   h, a              ; H = X_right_boundary
1122+ 6B73
1123+ 6B73 79               ld   a, c              ; A = PlayerX
1124+ 6B74 BB               cp   e
1125+ 6B75 DA 0A 6C         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1126+ 6B78
1127+ 6B78 BC               cp   h
1128+ 6B79 38 15            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1129+ 6B7B
1130+ 6B7B                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1131+ 6B7B 94               sub  h                 ; A = PlayerX - X_right_boundary
1132+ 6B7C FE 08            cp   8
1133+ 6B7E D2 0A 6C         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1134+ 6B81
1135+ 6B81                  ; Piattaforma adiacente! Restituisci PlayerY = (ramp_row - ramp_len + 1) * 8 - 16
1136+ 6B81 3A 89 76         ld   a, (ramp_row)
1137+ 6B84 21 88 76         ld   hl, ramp_len
1138+ 6B87 96               sub  (hl)
1139+ 6B88 3C               inc  a                 ; A = Row
1140+ 6B89 87               add  a, a              ; *2
1141+ 6B8A 87               add  a, a              ; *4
1142+ 6B8B 87               add  a, a              ; *8
1143+ 6B8C D6 10            sub  16                ; A = Row * 8 - 16
1144+ 6B8E 37               scf                    ; Set carry (dentro rampa/piattaforma)
1145+ 6B8F C9               ret
1146+ 6B90
1147+ 6B90              .on_ramp_slope:
1148+ 6B90 3A 89 76         ld   a, (ramp_row)
1149+ 6B93 87               add  a, a              ; *2
1150+ 6B94 87               add  a, a              ; *4
1151+ 6B95 87               add  a, a              ; *8
1152+ 6B96 D6 10            sub  16                ; A = ramp_row * 8 - 16
1153+ 6B98 83               add  a, e              ; A = ramp_row * 8 - 16 + X_left
1154+ 6B99 91               sub  c                 ; A = A - PlayerX
1155+ 6B9A
1156+ 6B9A                  ; Calcola la quota della piattaforma:
1157+ 6B9A                  ; platform_Y = (ramp_row - ramp_len + 1) * 8 - 16
1158+ 6B9A 57               ld   d, a              ; D = calculated Y
1159+ 6B9B
1160+ 6B9B 3A 89 76         ld   a, (ramp_row)
1161+ 6B9E 21 88 76         ld   hl, ramp_len
1162+ 6BA1 96               sub  (hl)
1163+ 6BA2 3C               inc  a                 ; A = Row
1164+ 6BA3 87               add  a, a              ; *2
1165+ 6BA4 87               add  a, a              ; *4
1166+ 6BA5 87               add  a, a              ; *8
1167+ 6BA6 D6 10            sub  16                ; A = platform_Y
1168+ 6BA8
1169+ 6BA8 BA               cp   d                 ; Compara platform_Y con calculated Y
1170+ 6BA9 38 02            jr   c, .no_clamp      ; Se platform_Y < calculated Y, non limitare
1171+ 6BAB
1172+ 6BAB                  ; Altrimenti, limita a platform_Y
1173+ 6BAB 37               scf                    ; Set carry (dentro rampa)
1174+ 6BAC C9               ret
1175+ 6BAD
1176+ 6BAD              .no_clamp:
1177+ 6BAD 7A               ld   a, d              ; Ripristina A = calculated Y
1178+ 6BAE 37               scf                    ; Set carry
1179+ 6BAF C9               ret
1180+ 6BB0
1181+ 6BB0              .dir_left:
1182+ 6BB0                  ; Rampa sale a sinistra (up-left)
1183+ 6BB0 21 88 76         ld   hl, ramp_len
1184+ 6BB3 3A 8A 76         ld   a, (ramp_col)
1185+ 6BB6 96               sub  (hl)
1186+ 6BB7 3C               inc  a                 ; A = ramp_col - ramp_len + 1
1187+ 6BB8 87               add  a, a              ; *2
1188+ 6BB9 87               add  a, a              ; *4
1189+ 6BBA 87               add  a, a              ; *8
1190+ 6BBB 5F               ld   e, a              ; E = X_left
1191+ 6BBC
1192+ 6BBC 3A 8A 76         ld   a, (ramp_col)
