 254+ 6EDB              ; -------------------------------------------------------------------
 255+ 6EDB              ; Verifica la collisione tra player e nemico (bounding box a livello di pixel)
 256+ 6EDB              ; Output: Carry flag impostato se collisione, altrimenti resettato
 257+ 6EDB              ; -------------------------------------------------------------------
 258+ 6EDB              CheckCollision:
 259+ 6EDB E5               push hl
 260+ 6EDC D5               push de
 261+ 6EDD C5               push bc
 262+ 6EDE DD E5            push ix
 263+ 6EE0
 264+ 6EE0 DD 21 83 70      ld   ix, ActiveEnemies
 265+ 6EE4 06 04            ld   b, 4              ; 4 slot
 266+ 6EE6              .loop:
 267+ 6EE6 DD 7E 00         ld   a, (ix+0)         ; Flags
 268+ 6EE9 E6 80            and  $80               ; Active?
 269+ 6EEB 28 1F            jr   z, .next
 270+ 6EED
 271+ 6EED                  ; 1. Controllo orizzontale: PlayerX - EnemyX + 7 in [0, 22]
 272+ 6EED 3A E8 75         ld   a, (PlayerPos)    ; A = PlayerX
 273+ 6EF0 DD 96 01         sub  (ix+1)            ; A = PlayerX - EnemyX
 274+ 6EF3 C6 07            add  a, 7              ; A = PlayerX - EnemyX + 7
 275+ 6EF5 FE 17            cp   23                ; Se >= 23, nessuna collisione con questo
 276+ 6EF7 30 13            jr   nc, .next
 277+ 6EF9
 278+ 6EF9                  ; 2. Controllo verticale: PlayerY - EnemyY + 15 in [0, 30]
 279+ 6EF9 3A E9 75         ld   a, (PlayerPos+1)  ; A = PlayerY
 280+ 6EFC DD 96 02         sub  (ix+2)            ; A = PlayerY - EnemyY
 281+ 6EFF C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 282+ 6F01 FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 283+ 6F03 30 07            jr   nc, .next
 284+ 6F05
 285+ 6F05                  ; Collisione avvenuta!
 286+ 6F05 DD E1            pop  ix
 287+ 6F07 C1               pop  bc
 288+ 6F08 D1               pop  de
 289+ 6F09 E1               pop  hl
 290+ 6F0A 37               scf                    ; Imposta carry flag
 291+ 6F0B C9               ret
 292+ 6F0C
 293+ 6F0C              .next:
 294+ 6F0C 11 0A 00         ld   de, 10
 295+ 6F0F DD 19            add  ix, de            ; Prossimo slot
 296+ 6F11 05               dec  b
 297+ 6F12 20 D2            jr   nz, .loop
 298+ 6F14
 299+ 6F14 DD E1            pop  ix
 300+ 6F16 C1               pop  bc
 301+ 6F17 D1               pop  de
 302+ 6F18 E1               pop  hl
 303+ 6F19 B7               or   a                 ; Reset carry flag
 304+ 6F1A C9               ret
