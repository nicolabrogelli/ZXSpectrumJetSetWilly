 670+ 60A5 CD 3E 70         call UnpackRoomLayout
 671+ 60A8
 672+ 60A8 06 00            ld   b, 0              ; B = layout row (0..15)
 673+ 60AA              .row_loop:
 674+ 60AA 0E 00            ld   c, 0              ; C = layout column group (0..7 bytes)
 675+ 60AC              .col_byte_loop:
 676+ 60AC 26 00            ld   h, 0
 677+ 60AE 68               ld   l, b
 678+ 60AF 29               add  hl, hl
 679+ 60B0 29               add  hl, hl
