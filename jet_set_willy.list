 420+ 6F9B
 421+ 6F9B ED 4B E8 75      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 422+ 6F9F
 423+ 6F9F                  ; Calcola screenRow dei piedi del player: RowPiedi = Y / 8
 424+ 6F9F 78               ld   a, b
 425+ 6FA0 CB 3F            srl  a
 426+ 6FA2 CB 3F            srl  a
 427+ 6FA4 CB 3F            srl  a                 ; A = Y / 8
 428+ 6FA6
 429+ 6FA6                  ; Confronta con conveyor_row
 430+ 6FA6 57               ld   d, a              ; D = RowPiedi
 431+ 6FA7 3A FD 78         ld   a, (conveyor_row)
