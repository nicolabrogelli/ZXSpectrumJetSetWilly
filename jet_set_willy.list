 754+ 6109 0C               inc  c
 755+ 610A 79               ld   a, c
 756+ 610B FE 08            cp   8
 757+ 610D C2 AC 60         jp   nz, .col_byte_loop
 758+ 6110
 759+ 6110 04               inc  b
 760+ 6111 78               ld   a, b
 761+ 6112 FE 10            cp   16
 762+ 6114 C2 AA 60         jp   nz, .row_loop
 763+ 6117
 764+ 6117 DD E1            pop  ix
 765+ 6119 E1               pop  hl
 766+ 611A D1               pop  de
 767+ 611B C1               pop  bc
 768+ 611C C9               ret
