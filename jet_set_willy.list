 914+ 6AC3              ; -------------------------------------------------------------------
 915+ 6AC3              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 916+ 6AC3              ; Input: C = X, B = Y
 917+ 6AC3              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 918+ 6AC3              ; -------------------------------------------------------------------
 919+ 6AC3              CheckWallCell:
 920+ 6AC3 E5               push hl
 921+ 6AC4 D5               push de
 922+ 6AC5 C5               push bc
 923+ 6AC6
 924+ 6AC6                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 925+ 6AC6 78               ld   a, b
 926+ 6AC7 FE 80            cp   128
 927+ 6AC9 30 1F            jr   nc, .not_wall
 928+ 6ACB
 929+ 6ACB                  ; 2. Calcola riga di layout: r = Y / 8
 930+ 6ACB CB 3F            srl  a
 931+ 6ACD CB 3F            srl  a
 932+ 6ACF CB 3F            srl  a                 ; A = r (0..15)
 933+ 6AD1
 934+ 6AD1                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 935+ 6AD1 5F               ld   e, a              ; E = r (Row)
 936+ 6AD2 79               ld   a, c
 937+ 6AD3 CB 3F            srl  a
 938+ 6AD5 CB 3F            srl  a
 939+ 6AD7 CB 3F            srl  a                 ; A = c (0..31)
 940+ 6AD9 4F               ld   c, a              ; C = c (Col)
 941+ 6ADA
 942+ 6ADA                  ; Se la cella è sulla rampa, non considerarla un muro!
 943+ 6ADA 53               ld   d, e              ; D = Row
 944+ 6ADB 59               ld   e, c              ; E = Col
 945+ 6ADC CD 48 6A         call IsCellOnRamp
 946+ 6ADF 38 09            jr   c, .not_wall
 947+ 6AE1
 948+ 6AE1 7A               ld   a, d              ; A = Row
 949+ 6AE2 4B               ld   c, e              ; C = Col
 950+ 6AE3 CD 43 6B         call GetCellFromUnpacked ; A = cell type
 951+ 6AE6
 952+ 6AE6                  ; Controlla se è Wall (2)
 953+ 6AE6 FE 02            cp   2
 954+ 6AE8 28 05            jr   z, .is_wall
 955+ 6AEA
 956+ 6AEA              .not_wall:
 957+ 6AEA C1               pop  bc
 958+ 6AEB D1               pop  de
 959+ 6AEC E1               pop  hl
