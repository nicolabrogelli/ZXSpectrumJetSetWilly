   8+ 6DBB              ; Input: C = X, B = Y
   9+ 6DBB              ; Output: Carry flag impostato se solida, altrimenti resettato
  10+ 6DBB              ; -------------------------------------------------------------------
  11+ 6DBB              CheckSolidCell:
  12+ 6DBB E5               push hl
  13+ 6DBC D5               push de
  14+ 6DBD C5               push bc
  15+ 6DBE
  16+ 6DBE                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout (Y < 24)
  17+ 6DBE 78               ld   a, b
  18+ 6DBF FE 18            cp   24
  19+ 6DC1 38 29            jr   c, .not_solid
  20+ 6DC3
  21+ 6DC3                  ; Se Y >= 152, clampiamo a 151 per poter controllare il pavimento (riga 15)
  22+ 6DC3 FE 98            cp   152
  23+ 6DC5 38 02            jr   c, .y_ok
  24+ 6DC7 06 97            ld   b, 151
  25+ 6DC9              .y_ok:
  26+ 6DC9
  27+ 6DC9 CD 1B 6F         call CheckConveyorOrRampCell
  28+ 6DCC 38 23            jr   c, .solid
  29+ 6DCE
  30+ 6DCE                  ; 2. Calcola riga di layout: r = (Y - 24) / 8
  31+ 6DCE 78               ld   a, b
  32+ 6DCF D6 18            sub  24
  33+ 6DD1 CB 3F            srl  a
  34+ 6DD3 CB 3F            srl  a
  35+ 6DD5 CB 3F            srl  a                 ; A = r (0..15)
  36+ 6DD7
  37+ 6DD7                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
  38+ 6DD7 5F               ld   e, a              ; E = r
  39+ 6DD8 79               ld   a, c
  40+ 6DD9 CB 3F            srl  a
  41+ 6DDB CB 3F            srl  a
  42+ 6DDD CB 3F            srl  a                 ; A = c (0..31)
  43+ 6DDF 4F               ld   c, a              ; C = c
  44+ 6DE0 7B               ld   a, e              ; A = r
  45+ 6DE1
  46+ 6DE1 CD 6D 70         call GetCellFromUnpacked ; A = cell type
  47+ 6DE4
  48+ 6DE4                  ; 5. Controlla se è solida: Floor (1) o Wall (2)
  49+ 6DE4 FE 01            cp   1
  50+ 6DE6 28 09            jr   z, .solid
  51+ 6DE8 FE 02            cp   2
  52+ 6DEA 28 05            jr   z, .solid
  53+ 6DEC
  54+ 6DEC              .not_solid:
  55+ 6DEC C1               pop  bc
  56+ 6DED D1               pop  de
  57+ 6DEE E1               pop  hl
  58+ 6DEF B7               or   a                 ; Clear carry
  59+ 6DF0 C9               ret
  60+ 6DF1
  61+ 6DF1              .solid:
  62+ 6DF1 C1               pop  bc
  63+ 6DF2 D1               pop  de
  64+ 6DF3 E1               pop  hl
  65+ 6DF4 37               scf                    ; Set carry
  66+ 6DF5 C9               ret
  67+ 6DF6
  68+ 6DF6
  69+ 6DF6              ; -------------------------------------------------------------------
  70+ 6DF6              ; Applica gravità e gestisce salto
  71+ 6DF6              ; -------------------------------------------------------------------
  72+ 6DF6              ApplyGravity:
  73+ 6DF6 ED 4B E8 75      ld  bc, (PlayerPos)
  74+ 6DFA 78               ld  a, b              ; B = PlayerY (pixel)
  75+ 6DFB
  76+ 6DFB                  ; Controlla se siamo a mezz'aria (on_ground == 0)
  77+ 6DFB 3A F5 75         ld  a, (on_ground)
  78+ 6DFE B7               or  a
  79+ 6DFF CA 38 6E         jp  z, .in_air        ; Se siamo in volo, continua a volare
  80+ 6E02
  81+ 6E02                  ; Se on_ground == 1, controlliamo se siamo ancora su terreno solido
  82+ 6E02                  ; Dobbiamo controllare i pixel direttamente sotto i piedi del player:
  83+ 6E02                  ; (PlayerX, PlayerY + 16) e (PlayerX + 7, PlayerY + 16)
  84+ 6E02 78               ld  a, b
  85+ 6E03 C6 10            add  a, 16
  86+ 6E05 47               ld  b, a              ; B = PlayerY + 16
  87+ 6E06
  88+ 6E06                  ; Controlla se la cella sotto il piede sinistro (PlayerX, PlayerY + 16) è solida
  89+ 6E06 CD BB 6D         call CheckSolidCell
  90+ 6E09 38 13            jr   c, .still_on_ground
  91+ 6E0B
  92+ 6E0B                  ; Controlla se la cella sotto il piede destro (PlayerX + 7, PlayerY + 16) è solida
  93+ 6E0B 79               ld   a, c
  94+ 6E0C C6 07            add  a, 7
  95+ 6E0E 4F               ld   c, a              ; C = PlayerX + 7
  96+ 6E0F CD BB 6D         call CheckSolidCell
  97+ 6E12 38 0A            jr   c, .still_on_ground
  98+ 6E14
  99+ 6E14                  ; Se nessuna delle due è solida, iniziamo a cadere!
 100+ 6E14 AF               xor  a
 101+ 6E15 32 F5 75         ld   (on_ground), a
 102+ 6E18 32 F4 75         ld   (velocity_y), a   ; Inizia la caduta con velocità 0
 103+ 6E1B C3 38 6E         jp   .in_air
 104+ 6E1E
 105+ 6E1E              .still_on_ground:
 106+ 6E1E                  ; Siamo ancora sulla piattaforma o sul pavimento
 107+ 6E1E                  ; Ripristina bc originale (PlayerPos)
 108+ 6E1E ED 4B E8 75      ld   bc, (PlayerPos)
 109+ 6E22
 110+ 6E22                  ; Gestisci il salto
 111+ 6E22 3A F6 75         ld   a, (jump_pressed)
 112+ 6E25 B7               or   a
 113+ 6E26 CA D6 6E         jp   z, .end
 114+ 6E29
 115+ 6E29 3E 0C            ld   a, JUMP_STRENGTH
 116+ 6E2B 32 F4 75         ld   (velocity_y), a
 117+ 6E2E AF               xor  a
 118+ 6E2F 32 F5 75         ld   (on_ground), a
 119+ 6E32 32 F6 75         ld   (jump_pressed), a
 120+ 6E35 C3 38 6E         jp   .in_air
 121+ 6E38
 122+ 6E38              .in_air:
 123+ 6E38                  ; Applica gravità
 124+ 6E38 3A F4 75         ld  a, (velocity_y)
 125+ 6E3B D6 02            sub GRAVITY           ; gravity = 2
 126+ 6E3D
 127+ 6E3D                  ; Controlla se positivo per evitare bug con cp signed
 128+ 6E3D CB 7F            bit 7, a
 129+ 6E3F 28 06            jr  z, .store_vel
 130+ 6E41
 131+ 6E41 FE F4            cp  -MAX_FALL_SPEED   ; -12
 132+ 6E43 30 02            jr  nc, .store_vel
 133+ 6E45 3E F4            ld  a, -MAX_FALL_SPEED
 134+ 6E47
 135+ 6E47              .store_vel:
 136+ 6E47 32 F4 75         ld  (velocity_y), a
 137+ 6E4A
 138+ 6E4A                  ; Applica movimento verticale: PlayerY = PlayerY - velocity_y
 139+ 6E4A ED 4B E8 75      ld  bc, (PlayerPos)
 140+ 6E4E 57               ld  d, a              ; D = velocity_y (signed)
 141+ 6E4F 78               ld  a, b              ; A = PlayerY
 142+ 6E50 92               sub d                 ; A = PlayerY - velocity_y
 143+ 6E51 47               ld  b, a              ; B = new PlayerY
 144+ 6E52
 145+ 6E52                  ; Controlla se stiamo cadendo (velocity_y <= 0)
 146+ 6E52 3A F4 75         ld  a, (velocity_y)
 147+ 6E55 CB 7F            bit 7, a              ; Se negativo, bit 7 = 1
 148+ 6E57 20 05            jr  nz, .falling_checks
 149+ 6E59 B7               or  a                 ; Se zero
 150+ 6E5A 28 02            jr  z, .falling_checks
 151+ 6E5C 18 51            jr  .no_collision_checks ; Se stiamo salendo, non controlliamo collisioni
 152+ 6E5E
 153+ 6E5E              .falling_checks:
 154+ 6E5E                  ; --- CONTROLLO COLLISIONE CON IL TERRENO DURANTE LA CADUTA ---
 155+ 6E5E 78               ld   a, b
 156+ 6E5F C6 10            add  a, 16
 157+ 6E61 FE 98            cp   152
 158+ 6E63 38 02            jr   c, .y_ok_fall
 159+ 6E65 3E 97            ld   a, 151
 160+ 6E67              .y_ok_fall:
 161+ 6E67 47               ld   b, a              ; B = Nuovo Y + 16 (clampato a 151 se >= 152)
 162+ 6E68
 163+ 6E68                  ; Controlla se il piede sinistro tocca solido
 164+ 6E68 CD BB 6D         call CheckSolidCell
 165+ 6E6B 38 0B            jr   c, .check_landing
 166+ 6E6D
 167+ 6E6D                  ; Controlla se il piede destro tocca solido
 168+ 6E6D 79               ld   a, c
 169+ 6E6E C6 07            add  a, 7
 170+ 6E70 4F               ld   c, a              ; C = PlayerX + 7
 171+ 6E71 CD BB 6D         call CheckSolidCell
 172+ 6E74 38 02            jr   c, .check_landing
 173+ 6E76
 174+ 6E76                  ; Nessun atterraggio
 175+ 6E76 18 37            jr   .no_collision_checks
 176+ 6E78
 177+ 6E78              .check_landing:
 178+ 6E78                  ; Abbiamo toccato una cella solida!
 179+ 6E78 78               ld   a, b
 180+ 6E79 D6 18            sub  24
 181+ 6E7B CB 3F            srl  a
 182+ 6E7D CB 3F            srl  a
 183+ 6E7F CB 3F            srl  a                 ; A = r (0..15)
 184+ 6E81
 185+ 6E81                  ; Controlliamo se Vecchio Y + 16 <= r * 8 + 24
 186+ 6E81 5F               ld   e, a              ; E = r
 187+ 6E82 87               add  a, a              ; *2
 188+ 6E83 87               add  a, a              ; *4
 189+ 6E84 87               add  a, a              ; *8
 190+ 6E85 C6 18            add  a, 24             ; A = r * 8 + 24 (limite superiore della riga)
 191+ 6E87 57               ld   d, a              ; D = limite superiore
 192+ 6E88
 193+ 6E88                  ; Vecchio Y + 16
 194+ 6E88 3A E9 75         ld   a, (PlayerPos+1)  ; A = Vecchio Y
 195+ 6E8B C6 10            add  a, 16             ; A = Vecchio Y + 16
 196+ 6E8D
 197+ 6E8D BA               cp   d                 ; Confronta Vecchio Y + 16 con il limite
 198+ 6E8E 28 04            jr   z, .do_landing    ; Se ==, atterra
 199+ 6E90 38 02            jr   c, .do_landing    ; Se <, atterra (eravamo sopra)
 200+ 6E92
 201+ 6E92 18 1B            jr   .no_collision_checks
 202+ 6E94
 203+ 6E94              .do_landing:
 204+ 6E94                  ; Atterra sulla riga di layout E!
 205+ 6E94 7B               ld   a, e
 206+ 6E95 87               add  a, a              ; *2
 207+ 6E96 87               add  a, a              ; *4
 208+ 6E97 87               add  a, a              ; *8
 209+ 6E98 C6 08            add  a, 8              ; A = PlayerY di atterraggio
 210+ 6E9A
 211+ 6E9A ED 4B E8 75      ld   bc, (PlayerPos)   ; Ripristina C = PlayerX
 212+ 6E9E 47               ld   b, a              ; B = Nuovo PlayerY
 213+ 6E9F
 214+ 6E9F ED 43 E8 75      ld   (PlayerPos), bc
 215+ 6EA3 3E 01            ld   a, 1
 216+ 6EA5 32 F5 75         ld   (on_ground), a
 217+ 6EA8 AF               xor  a
 218+ 6EA9 32 F4 75         ld   (velocity_y), a
 219+ 6EAC C3 D6 6E         jp   .end
 220+ 6EAF
