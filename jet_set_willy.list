 446+ 6FB9 CB 3F            srl  a
 447+ 6FBB CB 3F            srl  a                 ; A = ColEnd
 448+ 6FBD 57               ld   d, a              ; D = ColEnd
 449+ 6FBE
 450+ 6FBE                  ; conveyor_col_end = conveyor_col + conveyor_len - 1
 451+ 6FBE 3A FE 78         ld   a, (conveyor_col)
 452+ 6FC1 21 FC 78         ld   hl, conveyor_len
 453+ 6FC4 86               add  a, (hl)
 454+ 6FC5 3D               dec  a                 ; A = conveyor_col_end
 455+ 6FC6
 456+ 6FC6                  ; E <= conveyor_col_end (conveyor_col_end >= E)
 457+ 6FC6 BB               cp   e
 458+ 6FC7 D8               ret  c                 ; Se conveyor_col_end < E, fine
 459+ 6FC8
 460+ 6FC8                  ; D >= conveyor_col
