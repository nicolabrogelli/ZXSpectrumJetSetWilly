 846+ 6A78 47               ld   b, a              ; B = limit_left
 847+ 6A79
 848+ 6A79 3A 8A 76         ld   a, (ramp_col)
 849+ 6A7C 3C               inc  a
 850+ 6A7D 4F               ld   c, a              ; C = limit_right (exclusive)
 851+ 6A7E
 852+ 6A7E 7B               ld   a, e              ; A = Col
 853+ 6A7F B8               cp   b
 854+ 6A80 38 15            jr   c, .check_platform_case
 855+ 6A82 B9               cp   c
 856+ 6A83 30 12            jr   nc, .check_platform_case
 857+ 6A85
 858+ 6A85                  ; Calcola B = ramp_col - Col
 859+ 6A85 3A 8A 76         ld   a, (ramp_col)
