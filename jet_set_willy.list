  63+ 706D              ; DetermineCurrentRoomID
  64+ 706D              ;
  65+ 706D              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 706D              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 706D              ;
  68+ 706D              ; Se viene trovata una corrispondenza:
  69+ 706D              ;   A = ID della stanza
  70+ 706D              ;   current_room = A
  71+ 706D              ;
  72+ 706D              ; Mappatura:
  73+ 706D              ;    0 = The Off Licence
  74+ 706D              ;    1 = The Bridge
  75+ 706D              ;    2 = Under The Mega Tree
  76+ 706D              ;    3 = At The Foot Of The Mega Tree
  77+ 706D              ;    4 = The Drive
  78+ 706D              ;    5 = The Security Guard
  79+ 706D              ;    6 = Entrance To Hades
  80+ 706D              ;    7 = Cuckoo's Nest
  81+ 706D              ;    8 = Inside The Mega Trunk
  82+ 706D              ;    9 = On A Branch Over The Drive
  83+ 706D              ;   10 = The Front Door
  84+ 706D              ;   11 = The Hall
  85+ 706D              ;   12 = Tree Top
  86+ 706D              ;   33 = The Bathroom
  87+ 706D              ;   35 = Master Bedroom
  88+ 706D              ;
  89+ 706D              ; Se nessuna stanza corrisponde viene impostato:
  90+ 706D              ;   current_room = 0
  91+ 706D              ; -------------------------------------------------------------------
  92+ 706D              DetermineCurrentRoomID:
  93+ 706D
  94+ 706D                  ; Salva i registri utilizzati
