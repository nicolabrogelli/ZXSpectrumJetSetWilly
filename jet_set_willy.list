 713+ 60DD 3D               dec  a
 714+ 60DE 20 06            jr   nz, .not_wall
 715+ 60E0 21 B2 00         ld   hl, OFFSET_WALL
 716+ 60E3 19               add  hl, de
 717+ 60E4 18 04            jr   .draw_cell
 718+ 60E6              .not_wall:
 719+ 60E6 21 BB 00         ld   hl, OFFSET_NASTY
 720+ 60E9 19               add  hl, de
 721+ 60EA
 722+ 60EA              .draw_cell:
 723+ 60EA E5               push hl
 724+ 60EB DD E1            pop  ix                ; IX = tile pointer
 725+ 60ED
 726+ 60ED C1               pop  bc                ; BC = original BC
 727+ 60EE D1               pop  de                ; DE = original DE
 728+ 60EF D5               push de                ; Save for next iteration
 729+ 60F0 C5               push bc                ; Save for next iteration
 730+ 60F1
 731+ 60F1 78               ld   a, b
 732+ 60F2 C6 03            add  a, 3              ; A = screen Row (R = r + 3)
 733+ 60F4 67               ld   h, a
 734+ 60F5
 735+ 60F5 79               ld   a, c
 736+ 60F6 87               add  a, a              ; *2
 737+ 60F7 87               add  a, a              ; *4 (Col group * 4)
 738+ 60F8 6F               ld   l, a              ; L = Col group * 4
 739+ 60F9
 740+ 60F9 3E 04            ld   a, 4
 741+ 60FB 93               sub  e                 ; A = 4 - E (0..3)
