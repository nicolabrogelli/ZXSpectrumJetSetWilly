 491+ 7525              ; -------------------------------------------------------------------
 492+ 7525              ; Riproduce un breve segnale acustico all'altoparlante
 493+ 7525              ; -------------------------------------------------------------------
 494+ 7525              PlayCollectSound:
 495+ 7525 C5               push bc
 496+ 7526 D5               push de
 497+ 7527
 498+ 7527 06 78            ld   b, 120            ; Cicli della nota
 499+ 7529              .sound_loop:
 500+ 7529 3A F3 75         ld   a, (room_border_color)
 501+ 752C F6 10            or   $10               ; Speaker ON (bit 4 = 1)
 502+ 752E D3 FE            out  ($fe), a
 503+ 7530 0E 3C            ld   c, 60             ; Mezzo periodo delay
 504+ 7532 0D           .d1: dec  c
 505+ 7533 20 FD            jr   nz, .d1
 506+ 7535
 507+ 7535 3A F3 75         ld   a, (room_border_color)
 508+ 7538 E6 EF            and  $ef               ; Speaker OFF (bit 4 = 0)
 509+ 753A D3 FE            out  ($fe), a
 510+ 753C 0E 3C            ld   c, 60             ; Mezzo periodo delay
 511+ 753E 0D           .d2: dec  c
 512+ 753F 20 FD            jr   nz, .d2
 513+ 7541
 514+ 7541 10 E6            djnz .sound_loop
 515+ 7543
 516+ 7543 D1               pop  de
 517+ 7544 C1               pop  bc
 518+ 7545 C9               ret
