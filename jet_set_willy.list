 417+ 5F93              .no_shift:
 418+ 5F93                  ; Nessuno shift: scrivi i 2 byte direttamente (OR trasparente)
 419+ 5F93 7A               ld   a, d
 420+ 5F94 B6               or   (hl)
 421+ 5F95 77               ld   (hl), a
 422+ 5F96 23               inc  hl
 423+ 5F97 7B               ld   a, e
 424+ 5F98 B6               or   (hl)
 425+ 5F99 77               ld   (hl), a
 426+ 5F9A 2B               dec  hl            ; Ripristina HL alla colonna iniziale
 427+ 5F9B
 428+ 5F9B              .next_line:
 429+ 5F9B CD 2E 5E         call IncScreenLine ; Vai alla prossima riga dello schermo
 430+ 5F9E DD 23            inc  ix
 431+ 5FA0 DD 23            inc  ix            ; Avanza di 2 byte nei dati dello sprite
