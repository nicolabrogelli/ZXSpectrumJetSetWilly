 619+ 705C 0F               rrca
 620+ 705D 0F               rrca
 621+ 705E E6 03            and  3
 622+ 7060 12               ld   (de), a
 623+ 7061 13               inc  de
 624+ 7062
 625+ 7062                  ; Cella 3: bit 1-0
 626+ 7062 79               ld   a, c
 627+ 7063 E6 03            and  3
 628+ 7065 12               ld   (de), a
 629+ 7066 13               inc  de
 630+ 7067
 631+ 7067 10 E0            djnz .byte_loop
 632+ 7069
 633+ 7069 C1               pop  bc
 634+ 706A D1               pop  de
 635+ 706B E1               pop  hl
 636+ 706C C9               ret
