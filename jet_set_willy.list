 819+ 6A5A 3A 88 76         ld   a, (ramp_len)
 820+ 6A5D 80               add  a, b              ; A = ramp_col + ramp_len
 821+ 6A5E 4F               ld   c, a              ; C = limit_right (exclusive)
 822+ 6A5F
 823+ 6A5F 7B               ld   a, e              ; A = Col
 824+ 6A60 B8               cp   b
 825+ 6A61 38 34            jr   c, .check_platform_case ; Col < ramp_col
 826+ 6A63 B9               cp   c
 827+ 6A64 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 828+ 6A66
 829+ 6A66                  ; Calcola B = Col - ramp_col
 830+ 6A66 7B               ld   a, e
 831+ 6A67 90               sub  b
 832+ 6A68 47               ld   b, a              ; B = offset (0..ramp_len-1)
 833+ 6A69
 834+ 6A69                  ; SlopeRow = ramp_row - B
 835+ 6A69 3A 89 76         ld   a, (ramp_row)
