 978+ 6ADD              ; -------------------------------------------------------------------
 979+ 6ADD              ; Ottiene l'attributo colore originale dello sfondo per una cella
 980+ 6ADD              ; Input: H = Row (0..23), B = Col (0..31)
 981+ 6ADD              ; Output: A = Attributo colore
 982+ 6ADD              ; -------------------------------------------------------------------
 983+ 6ADD              GetCellAttribute:
 984+ 6ADD E5               push hl
 985+ 6ADE D5               push de
 986+ 6ADF C5               push bc
 987+ 6AE0
 988+ 6AE0                  ; 1. Controlla se Row (H) è fuori dal layout (H < 3 o H >= 19)
 989+ 6AE0 7C               ld   a, h
 990+ 6AE1 FE 03            cp   3
 991+ 6AE3 38 5E            jr   c, .blank
 992+ 6AE5 FE 13            cp   19
 993+ 6AE7 30 5A            jr   nc, .blank
 994+ 6AE9
 995+ 6AE9                  ; 2. Calcola riga di layout: r = H - 3
 996+ 6AE9 D6 03            sub  3
 997+ 6AEB
 998+ 6AEB                  ; 3. HL = r * 8
 999+ 6AEB 6F               ld   l, a
1000+ 6AEC 26 00            ld   h, 0
1001+ 6AEE 29               add  hl, hl
1002+ 6AEF 29               add  hl, hl
1003+ 6AF0 29               add  hl, hl            ; HL = r * 8
1004+ 6AF1
1005+ 6AF1                  ; 4. HL = r * 8 + c / 4
1006+ 6AF1 78               ld   a, b              ; A = Col
1007+ 6AF2 CB 3F            srl  a
1008+ 6AF4 CB 3F            srl  a                 ; A = c / 4
1009+ 6AF6 85               add  a, l
1010+ 6AF7 6F               ld   l, a              ; HL = r * 8 + c / 4
1011+ 6AF8
1012+ 6AF8 ED 5B 03 79      ld   de, (room_ptr)
1013+ 6AFC 19               add  hl, de            ; HL = layout byte address
1014+ 6AFD 7E               ld   a, (hl)           ; A = layout byte
1015+ 6AFE
1016+ 6AFE                  ; Estrai il bit-pair corrispondente a c % 4
1017+ 6AFE 4F               ld   c, a              ; C = layout byte
1018+ 6AFF 78               ld   a, b              ; A = Col
1019+ 6B00 E6 03            and  3                 ; A = c % 4
1020+ 6B02 28 15            jr   z, .shift_0
1021+ 6B04 3D               dec  a
1022+ 6B05 28 0B            jr   z, .shift_1
1023+ 6B07 3D               dec  a
1024+ 6B08 28 03            jr   z, .shift_2
1025+ 6B0A                  ; Case 3 (c % 4 = 3)
1026+ 6B0A 79               ld   a, c
1027+ 6B0B 18 0F            jr   .got_type
1028+ 6B0D              .shift_2:
1029+ 6B0D 79               ld   a, c
1030+ 6B0E 0F               rrca
1031+ 6B0F 0F               rrca
1032+ 6B10 18 0A            jr   .got_type
1033+ 6B12              .shift_1:
1034+ 6B12 79               ld   a, c
1035+ 6B13 0F               rrca
1036+ 6B14 0F               rrca
1037+ 6B15 0F               rrca
1038+ 6B16 0F               rrca
1039+ 6B17 18 03            jr   .got_type
1040+ 6B19              .shift_0:
1041+ 6B19 79               ld   a, c
1042+ 6B1A 07               rlca
1043+ 6B1B 07               rlca
1044+ 6B1C              .got_type:
1045+ 6B1C E6 03            and  3                 ; A = cell type (0..3)
1046+ 6B1E
1047+ 6B1E                  ; Ottieni l'offset del tile corrispondente e leggi l'attributo (il primo byte del tile)
1048+ 6B1E B7               or   a
1049+ 6B1F 20 05            jr   nz, .not_bg
1050+ 6B21 21 A0 00         ld   hl, OFFSET_BG
1051+ 6B24 18 13            jr   .load_attr
1052+ 6B26              .not_bg:
1053+ 6B26 3D               dec  a
1054+ 6B27 20 05            jr   nz, .not_floor
1055+ 6B29 21 A9 00         ld   hl, OFFSET_FLOOR
1056+ 6B2C 18 0B            jr   .load_attr
1057+ 6B2E              .not_floor:
1058+ 6B2E 3D               dec  a
1059+ 6B2F 20 05            jr   nz, .not_wall
1060+ 6B31 21 B2 00         ld   hl, OFFSET_WALL
1061+ 6B34 18 03            jr   .load_attr
1062+ 6B36              .not_wall:
1063+ 6B36 21 BB 00         ld   hl, OFFSET_NASTY
1064+ 6B39
1065+ 6B39              .load_attr:
1066+ 6B39 ED 5B 03 79      ld   de, (room_ptr)
1067+ 6B3D 19               add  hl, de            ; HL = tile pointer
1068+ 6B3E 7E               ld   a, (hl)           ; A = primo byte del tile (l'attributo colore)
1069+ 6B3F
1070+ 6B3F C1               pop  bc
1071+ 6B40 D1               pop  de
1072+ 6B41 E1               pop  hl
1073+ 6B42 C9               ret
1074+ 6B43
1075+ 6B43              .blank:
1076+ 6B43 3E 07            ld   a, $07            ; Sfondo di default (bianco su nero)
1077+ 6B45 C1               pop  bc
1078+ 6B46 D1               pop  de
1079+ 6B47 E1               pop  hl
1080+ 6B48 C9               ret
1081+ 6B49
1082+ 6B49              ; -------------------------------------------------------------------
1083+ 6B49              ; Imposta gli attributi colore per la cella occupata da un nemico 16x16
1084+ 6B49              ; Input: C = X pixel, B = Y pixel, A = Colore Ink (0..7)
1085+ 6B49              ; -------------------------------------------------------------------
1086+ 6B49              SetEnemyColorAttributes:
1087+ 6B49 E5               push hl
1088+ 6B4A D5               push de
1089+ 6B4B C5               push bc
1090+ 6B4C
1091+ 6B4C 57               ld   d, a              ; D = Colore Ink (salvato)
1092+ 6B4D
1093+ 6B4D                  ; Se Y è fuori dai limiti della griglia di gioco, non fare nulla
1094+ 6B4D 78               ld   a, b
1095+ 6B4E FE 18            cp   24
1096+ 6B50 38 58            jr   c, .done
1097+ 6B52 FE 98            cp   152
1098+ 6B54 30 54            jr   nc, .done
1099+ 6B56
1100+ 6B56                  ; Calcola ColStart: col = X / 8
1101+ 6B56 79               ld   a, c
1102+ 6B57 CB 3F            srl  a
1103+ 6B59 CB 3F            srl  a
1104+ 6B5B CB 3F            srl  a
1105+ 6B5D 5F               ld   e, a              ; E = ColStart
1106+ 6B5E
1107+ 6B5E                  ; Calcola ColEnd: col_end = (X + 15) / 8
1108+ 6B5E 79               ld   a, c
1109+ 6B5F C6 0F            add  a, 15
1110+ 6B61 CB 3F            srl  a
1111+ 6B63 CB 3F            srl  a
1112+ 6B65 CB 3F            srl  a
1113+ 6B67 4F               ld   c, a              ; C = ColEnd
1114+ 6B68
1115+ 6B68                  ; Calcola RowStart: row = Y / 8
1116+ 6B68 78               ld   a, b
1117+ 6B69 CB 3F            srl  a
1118+ 6B6B CB 3F            srl  a
1119+ 6B6D CB 3F            srl  a
1120+ 6B6F 67               ld   h, a              ; H = RowStart
1121+ 6B70
1122+ 6B70                  ; Calcola RowEnd: row_end = (Y + 15) / 8
1123+ 6B70 78               ld   a, b
1124+ 6B71 C6 0F            add  a, 15
1125+ 6B73 CB 3F            srl  a
1126+ 6B75 CB 3F            srl  a
1127+ 6B77 CB 3F            srl  a
1128+ 6B79 6F               ld   l, a              ; L = RowEnd
1129+ 6B7A
1130+ 6B7A                  ; Loop righe: Row corrente in H, fino a L
1131+ 6B7A              .row_loop:
1132+ 6B7A 7C               ld   a, h
1133+ 6B7B BD               cp   l
1134+ 6B7C 28 02            jr   z, .ok_row
1135+ 6B7E 30 2A            jr   nc, .done
1136+ 6B80              .ok_row:
1137+ 6B80 C5               push bc
1138+ 6B81 D5               push de
1139+ 6B82
1140+ 6B82                  ; Col loop from E (ColStart) to C (ColEnd)
1141+ 6B82 43               ld   b, e              ; B = Col corrente
1142+ 6B83              .col_loop:
1143+ 6B83 78               ld   a, b
1144+ 6B84 B9               cp   c
1145+ 6B85 28 02            jr   z, .ok_col
1146+ 6B87 30 1C            jr   nc, .col_done
1147+ 6B89              .ok_col:
1148+ 6B89                  ; Processa la cella a H (Row), B (Col)
1149+ 6B89 E5               push hl
1150+ 6B8A 6C               ld   l, h
1151+ 6B8B 26 00            ld   h, 0
1152+ 6B8D 29               add  hl, hl
1153+ 6B8E 29               add  hl, hl
1154+ 6B8F 29               add  hl, hl
1155+ 6B90 29               add  hl, hl
1156+ 6B91 29               add  hl, hl            ; HL = Row * 32
1157+ 6B92
1158+ 6B92 78               ld   a, b              ; A = Col corrente
1159+ 6B93 85               add  a, l
1160+ 6B94 6F               ld   l, a
1161+ 6B95 30 01            jr   nc, .no_c_s
1162+ 6B97 24               inc  h
1163+ 6B98              .no_c_s:
1164+ 6B98 7C               ld   a, h
1165+ 6B99 C6 58            add  a, $58
1166+ 6B9B 67               ld   h, a              ; HL = Attribute screen address ($5800 + Row * 32 + Col)
1167+ 6B9C
1168+ 6B9C 7E               ld   a, (hl)
1169+ 6B9D E6 F8            and  $f8
1170+ 6B9F B2               or   d                 ; D has the enemy color
1171+ 6BA0 77               ld   (hl), a
1172+ 6BA1 E1               pop  hl
1173+ 6BA2
1174+ 6BA2 04               inc  b                 ; Prossima colonna
1175+ 6BA3 18 DE            jr   .col_loop
1176+ 6BA5
1177+ 6BA5              .col_done:
1178+ 6BA5 D1               pop  de
1179+ 6BA6 C1               pop  bc
1180+ 6BA7 24               inc  h                 ; Prossima riga
