 596+ 6063              ; Disegna la riga/pavimento sotto i piedi degli sprite (Riga 18, Y = 144)
 597+ 6063              ; -------------------------------------------------------------------
 598+ 6063              ; -------------------------------------------------------------------
 599+ 6063              ; Disegna un tile 8x8 sullo schermo
 600+ 6063              ; Input: B = Row (0..23), C = Col (0..31), IX = Puntatore al Tile (9 byte: 1 attr + 8 bitmap)
 601+ 6063              ; -------------------------------------------------------------------
 602+ 6063              DrawTile:
 603+ 6063 C5               push bc
 604+ 6064 D5               push de
 605+ 6065 E5               push hl
 606+ 6066
 607+ 6066                  ; 1. Calcola indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 608+ 6066                  ; HighByte = $40 + (B & $18)
 609+ 6066 78               ld   a, b
 610+ 6067 E6 18            and  $18
 611+ 6069 C6 40            add  a, $40
 612+ 606B 67               ld   h, a              ; H = High byte
 613+ 606C
 614+ 606C                  ; LowByte = ((B & 7) * 32) + C
 615+ 606C 78               ld   a, b
 616+ 606D E6 07            and  7
 617+ 606F 87               add  a, a              ; *2
 618+ 6070 87               add  a, a              ; *4
 619+ 6071 87               add  a, a              ; *8
 620+ 6072 87               add  a, a              ; *16
 621+ 6073 87               add  a, a              ; *32
 622+ 6074 81               add  a, c              ; + Col C
 623+ 6075 6F               ld   l, a              ; L = Low byte
 624+ 6076
 625+ 6076                  ; 2. Copia gli 8 byte del bitmap
 626+ 6076 16 08            ld   d, 8              ; 8 scanline
 627+ 6078 DD E5            push ix
 628+ 607A DD 23            inc  ix                ; Salta l'attributo, vai al bitmap
 629+ 607C              .line_loop:
 630+ 607C DD 7E 00         ld   a, (ix+0)
 631+ 607F 77               ld   (hl), a
 632+ 6080 24               inc  h                 ; Prossima scanline (stessa riga di caratteri)
 633+ 6081 DD 23            inc  ix
 634+ 6083 15               dec  d
 635+ 6084 20 F6            jr   nz, .line_loop
 636+ 6086 DD E1            pop  ix
 637+ 6088
 638+ 6088                  ; 3. Scrivi l'attributo
 639+ 6088                  ; AttrAddr = $5800 + B * 32 + C
 640+ 6088 26 00            ld   h, 0
 641+ 608A 68               ld   l, b              ; HL = B (Row)
 642+ 608B 29               add  hl, hl            ; *2
 643+ 608C 29               add  hl, hl            ; *4
 644+ 608D 29               add  hl, hl            ; *8
 645+ 608E 29               add  hl, hl            ; *16
 646+ 608F 29               add  hl, hl            ; *32
 647+ 6090 16 00            ld   d, 0
 648+ 6092 59               ld   e, c              ; DE = C (Col)
 649+ 6093 19               add  hl, de            ; HL = B * 32 + C
 650+ 6094 11 00 58         ld   de, $5800
 651+ 6097 19               add  hl, de            ; HL = AttrAddr
 652+ 6098
 653+ 6098 DD 7E 00         ld   a, (ix+0)         ; A = attribute byte
 654+ 609B 77               ld   (hl), a           ; Scrivi in memoria attributi
 655+ 609C
 656+ 609C E1               pop  hl
 657+ 609D D1               pop  de
 658+ 609E C1               pop  bc
 659+ 609F C9               ret
