 425+ 74EB              ; -------------------------------------------------------------------
 426+ 74EB              ; Controlla se Willy tocca un item attivo nella stanza corrente
 427+ 74EB              ; -------------------------------------------------------------------
 428+ 74EB              CheckRoomItemsCollision:
 429+ 74EB E5               push hl
 430+ 74EC D5               push de
 431+ 74ED C5               push bc
 432+ 74EE
 433+ 74EE 21 02 73         ld   hl, ItemsTable
 434+ 74F1              .loop:
 435+ 74F1 7E               ld   a, (hl)           ; A = Room ID
 436+ 74F2 FE FF            cp   $FF               ; Fine tabella?
 437+ 74F4 28 2B            jr   z, .done
 438+ 74F6
 439+ 74F6                  ; Stanza corrente?
 440+ 74F6 57               ld   d, a              ; D = Room ID
 441+ 74F7 3A FA 78         ld   a, (current_room)
 442+ 74FA BA               cp   d
 443+ 74FB 20 1D            jr   nz, .next_item
 444+ 74FD
 445+ 74FD 23               inc  hl                ; HL punta a X
 446+ 74FE 4E               ld   c, (hl)           ; C = X
 447+ 74FF 23               inc  hl                ; HL punta a Y
 448+ 7500 46               ld   b, (hl)           ; B = Y
 449+ 7501 23               inc  hl                ; HL punta al colore (lo saltiamo per il controllo collisione)
 450+ 7502 23               inc  hl                ; HL punta a collected
 451+ 7503 7E               ld   a, (hl)           ; A = collected
 452+ 7504 B7               or   a
 453+ 7505 20 17            jr   nz, .next_no_inc  ; Già raccolto, salta
 454+ 7507
 455+ 7507                  ; Controlla collisione
 456+ 7507 79               ld   a, c
 457+ 7508 60               ld   h, b
 458+ 7509 CD A5 74         call CheckWillyItemCollision
 459+ 750C 30 10            jr   nc, .next_no_inc
 460+ 750E
 461+ 750E                  ; RACCOLTO!
 462+ 750E 36 01            ld   (hl), 1           ; Imposta collected = 1
 463+ 7510
 464+ 7510 E5               push hl
 465+ 7511
 466+ 7511                  ; Cancella item dallo schermo
 467+ 7511 CD 61 74         call RestoreBackgroundCell
 468+ 7514
 469+ 7514                  ; Suono di raccolta
 470+ 7514 CD 25 75         call PlayCollectSound
 471+ 7517
 472+ 7517 E1               pop  hl
 473+ 7518
 474+ 7518 18 04            jr   .next_no_inc
 475+ 751A
 476+ 751A              .next_item:
 477+ 751A 23               inc  hl                ; salta X
 478+ 751B 23               inc  hl                ; salta Y
 479+ 751C 23               inc  hl                ; salta colore
 480+ 751D 23               inc  hl                ; salta collected
 481+ 751E              .next_no_inc:
 482+ 751E 23               inc  hl                ; vai al prossimo item
 483+ 751F 18 D0            jr   .loop
