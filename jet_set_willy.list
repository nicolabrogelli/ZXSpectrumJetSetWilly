 335+ 7494              .draw_cell:
 336+ 7494 E5               push hl
 337+ 7495 DD E1            pop  ix                ; IX = tile pointer
 338+ 7497
 339+ 7497 FD E5            push iy
 340+ 7499 C1               pop  bc                ; B = Row, C = Col
