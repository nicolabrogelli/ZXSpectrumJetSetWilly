 221+ 7429              ; -------------------------------------------------------------------
 222+ 7429              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 223+ 7429              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 224+ 7429              ; -------------------------------------------------------------------
 225+ 7429              DrawItemGraphic:
 226+ 7429 C5               push bc
 227+ 742A D5               push de
 228+ 742B E5               push hl
 229+ 742C
 230+ 742C                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 231+ 742C 78               ld   a, b
 232+ 742D E6 18            and  $18
 233+ 742F C6 40            add  a, $40
 234+ 7431 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 235+ 7432
 236+ 7432 78               ld   a, b
 237+ 7433 E6 07            and  7
 238+ 7435 87               add  a, a              ; *2
 239+ 7436 87               add  a, a              ; *4
 240+ 7437 87               add  a, a              ; *8
 241+ 7438 87               add  a, a              ; *16
 242+ 7439 87               add  a, a              ; *32
 243+ 743A 81               add  a, c              ; + Col C
 244+ 743B 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 245+ 743C
 246+ 743C                  ; 2. Copia gli 8 byte del bitmap dello sprite
 247+ 743C C5               push bc                ; Salva BC (contiene Row e Col)
 248+ 743D 06 08            ld   b, 8              ; 8 scanline
 249+ 743F              .line_loop:
 250+ 743F 7E               ld   a, (hl)
 251+ 7440 12               ld   (de), a
 252+ 7441 14               inc  d                 ; Prossima scanline
 253+ 7442 23               inc  hl
 254+ 7443 05               dec  b
 255+ 7444 20 F9            jr   nz, .line_loop
 256+ 7446 C1               pop  bc                ; Ripristina BC
 257+ 7447
 258+ 7447                  ; 3. Calcola l'indirizzo degli attributi dello schermo
 259+ 7447                  ; HL = $5800 + B * 32 + C
 260+ 7447 26 00            ld   h, 0
 261+ 7449 68               ld   l, b              ; HL = B (Row)
 262+ 744A 29               add  hl, hl            ; *2
 263+ 744B 29               add  hl, hl            ; *4
 264+ 744C 29               add  hl, hl            ; *8
 265+ 744D 29               add  hl, hl            ; *16
 266+ 744E 29               add  hl, hl            ; *32
 267+ 744F
 268+ 744F 79               ld   a, c              ; A = Col
 269+ 7450 85               add  a, l
 270+ 7451 6F               ld   l, a
 271+ 7452 30 01            jr   nc, .no_carry
 272+ 7454 24               inc  h
 273+ 7455              .no_carry:
 274+ 7455                  ; HL = B * 32 + C
