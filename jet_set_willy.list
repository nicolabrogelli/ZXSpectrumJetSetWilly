 348+ 7187
 349+ 7187              ; -------------------------------------------------------------------
 350+ 7187              ; DrawRoomItems
 351+ 7187              ;
 352+ 7187              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 353+ 7187              ;
 354+ 7187              ; Operazioni eseguite:
 355+ 7187              ;   1. Azzera la griglia items_grid.
 356+ 7187              ;   2. Svuota la cache degli oggetti attivi.
 357+ 7187              ;   3. Scansiona ItemsTable.
 358+ 7187              ;   4. Per ogni item della stanza corrente:
 359+ 7187              ;        - verifica se è già stato raccolto
 360+ 7187              ;        - disegna la grafica
 361+ 7187              ;        - aggiorna items_grid
 362+ 7187              ;        - memorizza l'item nella cache current_room_items
 363+ 7187              ;   5. Aggiorna num_room_items.
 364+ 7187              ;
 365+ 7187              ; Record ItemsTable:
 366+ 7187              ;   +0  Room ID
 367+ 7187              ;   +1  X (colonna)
 368+ 7187              ;   +2  Y (riga)
 369+ 7187              ;   +3  Colore
 370+ 7187              ;   +4  Collected flag
 371+ 7187              ;
 372+ 7187              ; Cache current_room_items:
 373+ 7187              ;   +0  Colonna
 374+ 7187              ;   +1  Riga
 375+ 7187              ;   +2  Colore
 376+ 7187              ;   +3  Collected flag ptr (Low)
 377+ 7187              ;   +4  Collected flag ptr (High)
 378+ 7187              ;
 379+ 7187              ; Ogni record cache occupa 5 byte.
 380+ 7187              ; -------------------------------------------------------------------
 381+ 7187              DrawRoomItems:
 382+ 7187
 383+ 7187                  ; Salva tutti i registri utilizzati
 384+ 7187 E5               push hl
 385+ 7188 D5               push de
 386+ 7189 C5               push bc
 387+ 718A DD E5            push ix
 388+ 718C FD E5            push iy
 389+ 718E
 390+ 718E                  ; ---------------------------------------------------------------
 391+ 718E                  ; Azzera items_grid (32 x 16 = 512 byte)
 392+ 718E                  ; ---------------------------------------------------------------
 393+ 718E 21 00 A5         ld   hl, items_grid
 394+ 7191 11 01 A5         ld   de, items_grid + 1
 395+ 7194 36 00            ld   (hl), 0
 396+ 7196 01 FF 01         ld   bc, 511
 397+ 7199 ED B0            ldir
 398+ 719B
 399+ 719B                  ; ---------------------------------------------------------------
 400+ 719B                  ; Nessun item attivo nella stanza
 401+ 719B                  ; ---------------------------------------------------------------
 402+ 719B AF               xor  a
 403+ 719C 32 DB 76         ld   (num_room_items), a
 404+ 719F
 405+ 719F                  ; IY punta alla cache degli item attivi
 406+ 719F FD 21 8B 76      ld   iy, current_room_items
 407+ 71A3
 408+ 71A3                  ; ---------------------------------------------------------------
 409+ 71A3                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 410+ 71A3                  ; alla stanza corrente.
 411+ 71A3                  ;
 412+ 71A3                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 413+ 71A3                  ; ---------------------------------------------------------------
 414+ 71A3 2A DC 76         ld   hl, (room_ptr)
 415+ 71A6 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 416+ 71A9 19               add  hl, de
 417+ 71AA
 418+ 71AA E5               push hl
 419+ 71AB DD E1            pop  ix                ; IX = bitmap item
 420+ 71AD
 421+ 71AD                  ; ---------------------------------------------------------------
 422+ 71AD                  ; Inizio scansione della tabella degli item
 423+ 71AD                  ; ---------------------------------------------------------------
 424+ 71AD 21 17 70         ld   hl, ItemsTable
 425+ 71B0
 426+ 71B0              .loop:
 427+ 71B0
 428+ 71B0                  ; ---------------------------------------------------------------
 429+ 71B0                  ; Legge il Room ID del record corrente
 430+ 71B0                  ; ---------------------------------------------------------------
 431+ 71B0 7E               ld   a, (hl)
 432+ 71B1
 433+ 71B1                  ; $FF indica fine tabella
 434+ 71B1 FE FF            cp   $FF
 435+ 71B3 28 53            jr   z, .done
 436+ 71B5
 437+ 71B5                  ; ---------------------------------------------------------------
 438+ 71B5                  ; Verifica se l'item appartiene alla stanza corrente
 439+ 71B5                  ; ---------------------------------------------------------------
 440+ 71B5 57               ld   d, a
 441+ 71B6
 442+ 71B6 3A 82 76         ld   a, (current_room)
 443+ 71B9 BA               cp   d
 444+ 71BA 20 45            jr   nz, .next_item
 445+ 71BC
 446+ 71BC                  ; ---------------------------------------------------------------
 447+ 71BC                  ; Legge i dati dell'item
 448+ 71BC                  ; ---------------------------------------------------------------
 449+ 71BC
 450+ 71BC 23               inc  hl
 451+ 71BD 4E               ld   c, (hl)           ; X (colonna)
 452+ 71BE
 453+ 71BE 23               inc  hl
 454+ 71BF 46               ld   b, (hl)           ; Y (riga)
 455+ 71C0
 456+ 71C0 23               inc  hl
 457+ 71C1 5E               ld   e, (hl)           ; Colore
 458+ 71C2
 459+ 71C2 23               inc  hl
 460+ 71C3 7E               ld   a, (hl)           ; Collected flag
 461+ 71C4
 462+ 71C4                  ; Se diverso da zero l'item è già stato raccolto
 463+ 71C4 B7               or   a
 464+ 71C5 20 3E            jr   nz, .next_no_inc
 465+ 71C7
 466+ 71C7                  ; ---------------------------------------------------------------
 467+ 71C7                  ; Disegna l'item sullo schermo
 468+ 71C7                  ;
 469+ 71C7                  ; B = Row
 470+ 71C7                  ; C = Column
 471+ 71C7                  ; HL = bitmap pointer
 472+ 71C7                  ; E = Color
 473+ 71C7                  ; ---------------------------------------------------------------
 474+ 71C7 E5               push hl
 475+ 71C8
 476+ 71C8 DD E5            push ix
 477+ 71CA E1               pop  hl
 478+ 71CB
 479+ 71CB CD 10 72         call DrawItemGraphic
 480+ 71CE
 481+ 71CE E1               pop  hl                ; ritorna al flag collected
 482+ 71CF
 483+ 71CF                  ; ---------------------------------------------------------------
 484+ 71CF                  ; Aggiorna items_grid
 485+ 71CF                  ;
 486+ 71CF                  ; Calcolo:
 487+ 71CF                  ;   offset = Row * 32 + Col
 488+ 71CF                  ; ---------------------------------------------------------------
 489+ 71CF E5               push hl
 490+ 71D0 D5               push de
 491+ 71D1
 492+ 71D1 26 00            ld   h, 0
 493+ 71D3 68               ld   l, b              ; HL = Row
 494+ 71D4
 495+ 71D4 29               add  hl, hl            ; *2
 496+ 71D5 29               add  hl, hl            ; *4
 497+ 71D6 29               add  hl, hl            ; *8
 498+ 71D7 29               add  hl, hl            ; *16
 499+ 71D8 29               add  hl, hl            ; *32
 500+ 71D9
 501+ 71D9 16 00            ld   d, 0
 502+ 71DB 59               ld   e, c              ; DE = Col
 503+ 71DC
 504+ 71DC 19               add  hl, de            ; Row*32 + Col
 505+ 71DD
 506+ 71DD 11 00 A5         ld   de, items_grid
 507+ 71E0 19               add  hl, de            ; puntatore nella griglia
 508+ 71E1
 509+ 71E1 D1               pop  de                ; ripristina colore
 510+ 71E2
 511+ 71E2 73               ld   (hl), e           ; salva colore cella
 512+ 71E3
 513+ 71E3 E1               pop  hl
 514+ 71E4
 515+ 71E4                  ; ---------------------------------------------------------------
 516+ 71E4                  ; Salva l'item nella cache della stanza
 517+ 71E4                  ;
 518+ 71E4                  ; Questo evita di dover scansionare tutta ItemsTable
 519+ 71E4                  ; durante il controllo delle collisioni.
 520+ 71E4                  ; ---------------------------------------------------------------
 521+ 71E4
 522+ 71E4 FD 71 00         ld   (iy+0), c         ; Colonna
 523+ 71E7 FD 70 01         ld   (iy+1), b         ; Riga
 524+ 71EA FD 73 02         ld   (iy+2), e         ; Colore
 525+ 71ED
 526+ 71ED                  ; Salva il puntatore al flag "collected"
 527+ 71ED FD 75 03         ld   (iy+3), l         ; Low byte
 528+ 71F0 FD 74 04         ld   (iy+4), h         ; High byte
 529+ 71F3
 530+ 71F3                  ; Passa al record successivo della cache
 531+ 71F3 01 05 00         ld   bc, 5
 532+ 71F6 FD 09            add  iy, bc
 533+ 71F8
 534+ 71F8                  ; Incrementa il numero di item attivi
 535+ 71F8 3A DB 76         ld   a, (num_room_items)
 536+ 71FB 3C               inc  a
 537+ 71FC 32 DB 76         ld   (num_room_items), a
 538+ 71FF
 539+ 71FF 18 04            jr   .next_no_inc
 540+ 7201
 541+ 7201              .next_item:
 542+ 7201
 543+ 7201                  ; ---------------------------------------------------------------
 544+ 7201                  ; L'item non appartiene alla stanza corrente.
 545+ 7201                  ; Salta i campi del record:
 546+ 7201                  ;   X
 547+ 7201                  ;   Y
 548+ 7201                  ;   Color
 549+ 7201                  ;   Collected
 550+ 7201                  ; ---------------------------------------------------------------
 551+ 7201 23               inc  hl
 552+ 7202 23               inc  hl
 553+ 7203 23               inc  hl
 554+ 7204 23               inc  hl
 555+ 7205
 556+ 7205              .next_no_inc:
 557+ 7205
 558+ 7205                  ; ---------------------------------------------------------------
 559+ 7205                  ; Avanza al record successivo
 560+ 7205                  ; (prossimo Room ID)
 561+ 7205                  ; ---------------------------------------------------------------
 562+ 7205 23               inc  hl
 563+ 7206 18 A8            jr   .loop
 564+ 7208
 565+ 7208              .done:
 566+ 7208
 567+ 7208                  ; Ripristina i registri
 568+ 7208 FD E1            pop  iy
 569+ 720A DD E1            pop  ix
 570+ 720C D1               pop  de
 571+ 720D C1               pop  bc
 572+ 720E E1               pop  hl
 573+ 720F
 574+ 720F C9               ret
 575+ 7210
 576+ 7210              ; -------------------------------------------------------------------
 577+ 7210              ; DrawItemGraphic
 578+ 7210              ;
 579+ 7210              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 580+ 7210              ; utilizzando una bitmap di 8 byte e un attributo colore.
 581+ 7210              ;
 582+ 7210              ; Input:
 583+ 7210              ;   B = Riga attributi (3..18)
 584+ 7210              ;   C = Colonna attributi (0..31)
 585+ 7210              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 586+ 7210              ;   E = Attributo colore
 587+ 7210              ;
 588+ 7210              ; Output:
 589+ 7210              ;   Nessuno
 590+ 7210              ;
 591+ 7210              ; Registri preservati:
 592+ 7210              ;   BC, DE, HL
 593+ 7210              ; -------------------------------------------------------------------
 594+ 7210              DrawItemGraphic:
 595+ 7210
 596+ 7210                  ; Salva i registri originali
 597+ 7210 C5               push bc
 598+ 7211 D5               push de
 599+ 7212 E5               push hl
 600+ 7213
 601+ 7213                  ; ---------------------------------------------------------------
 602+ 7213                  ; Calcolo indirizzo bitmap dello Spectrum
 603+ 7213                  ;
 604+ 7213                  ; Ogni item occupa una cella attributi (8x8 pixel).
 605+ 7213                  ;
 606+ 7213                  ; Formula:
 607+ 7213                  ;   High = $40 + (Row AND $18)
 608+ 7213                  ;   Low  = (Row AND 7) * 32 + Col
 609+ 7213                  ;
 610+ 7213                  ; DE conterrà l'indirizzo della prima scanline.
 611+ 7213                  ; ---------------------------------------------------------------
 612+ 7213
 613+ 7213 78               ld   a, b
 614+ 7214 E6 18            and  $18
 615+ 7216 C6 40            add  a, $40
 616+ 7218 57               ld   d, a              ; Byte alto indirizzo video
 617+ 7219
 618+ 7219 78               ld   a, b
 619+ 721A E6 07            and  7                 ; Riga interna al blocco da 8
 620+ 721C
 621+ 721C 87               add  a, a              ; *2
 622+ 721D 87               add  a, a              ; *4
 623+ 721E 87               add  a, a              ; *8
 624+ 721F 87               add  a, a              ; *16
 625+ 7220 87               add  a, a              ; *32
 626+ 7221
 627+ 7221 81               add  a, c              ; + colonna
 628+ 7222
 629+ 7222 5F               ld   e, a              ; Byte basso indirizzo video
 630+ 7223
 631+ 7223                  ; ---------------------------------------------------------------
 632+ 7223                  ; Disegno bitmap
 633+ 7223                  ;
 634+ 7223                  ; Copia 8 byte consecutivi nella memoria video.
 635+ 7223                  ; Ogni byte rappresenta una scanline da 8 pixel.
 636+ 7223                  ; ---------------------------------------------------------------
 637+ 7223
 638+ 7223 C5               push bc                ; Conserva Row e Col
 639+ 7224
 640+ 7224 06 08            ld   b, 8              ; Numero scanline
 641+ 7226
 642+ 7226              .line_loop:
 643+ 7226
 644+ 7226 7E               ld   a, (hl)           ; Legge scanline bitmap
 645+ 7227 12               ld   (de), a           ; Scrive nella memoria video
 646+ 7228
 647+ 7228 14               inc  d                 ; Scanline successiva
 648+ 7229 23               inc  hl                ; Byte bitmap successivo
 649+ 722A
 650+ 722A 05               dec  b
 651+ 722B 20 F9            jr   nz, .line_loop
 652+ 722D
 653+ 722D C1               pop  bc                ; Ripristina Row e Col
 654+ 722E
 655+ 722E                  ; ---------------------------------------------------------------
 656+ 722E                  ; Calcolo indirizzo attributo
 657+ 722E                  ;
 658+ 722E                  ; Formula:
 659+ 722E                  ;   AttrAddr = $5800 + Row * 32 + Col
 660+ 722E                  ;
 661+ 722E                  ; HL conterrà l'indirizzo della cella attributi.
 662+ 722E                  ; ---------------------------------------------------------------
 663+ 722E
 664+ 722E 26 00            ld   h, 0
 665+ 7230 68               ld   l, b              ; HL = Row
 666+ 7231
 667+ 7231 29               add  hl, hl            ; *2
 668+ 7232 29               add  hl, hl            ; *4
 669+ 7233 29               add  hl, hl            ; *8
 670+ 7234 29               add  hl, hl            ; *16
 671+ 7235 29               add  hl, hl            ; *32
 672+ 7236
 673+ 7236 79               ld   a, c              ; A = Colonna
 674+ 7237
 675+ 7237 85               add  a, l
 676+ 7238 6F               ld   l, a
 677+ 7239
 678+ 7239 30 01            jr   nc, .no_carry
 679+ 723B 24               inc  h
 680+ 723C
 681+ 723C              .no_carry:
 682+ 723C
 683+ 723C                  ; HL = Row * 32 + Col
 684+ 723C
 685+ 723C 11 00 58         ld   de, $5800
 686+ 723F 19               add  hl, de            ; HL = indirizzo attributi
 687+ 7240
 688+ 7240                  ; ---------------------------------------------------------------
 689+ 7240                  ; Recupera il colore originale dallo stack.
 690+ 7240                  ;
 691+ 7240                  ; Layout stack:
 692+ 7240                  ;   HL originale
 693+ 7240                  ;   DE originale (E = colore)
 694+ 7240                  ;   BC originale
 695+ 7240                  ; ---------------------------------------------------------------
 696+ 7240
 697+ 7240 C1               pop  bc                ; Recupera HL originale
 698+ 7241 D1               pop  de                ; Recupera DE originale
 699+ 7242
 700+ 7242                  ; ---------------------------------------------------------------
 701+ 7242                  ; Scrive l'attributo colore
 702+ 7242                  ; ---------------------------------------------------------------
 703+ 7242
 704+ 7242 7B               ld   a, e              ; A = colore
 705+ 7243 77               ld   (hl), a           ; Scrive nella RAM attributi
 706+ 7244
 707+ 7244                  ; ---------------------------------------------------------------
 708+ 7244                  ; Ripristina HL e BC originali
 709+ 7244                  ; ---------------------------------------------------------------
 710+ 7244
 711+ 7244 C5               push bc
 712+ 7245 E1               pop  hl                ; HL originale
 713+ 7246
 714+ 7246 C1               pop  bc                ; BC originale
 715+ 7247
 716+ 7247 C9               ret
 717+ 7248
 718+ 7248              ; -------------------------------------------------------------------
 719+ 7248              ; RestoreBackgroundCell
 720+ 7248              ;
 721+ 7248              ; Ripristina il contenuto originale di una cella della stanza.
 722+ 7248              ; Viene utilizzata principalmente quando un item viene raccolto:
 723+ 7248              ; invece di lasciare un "buco", la routine ridisegna il tile
 724+ 7248              ; originale presente nella mappa della stanza.
 725+ 7248              ;
 726+ 7248              ; Input:
 727+ 7248              ;   B = Row (3..18)
 728+ 7248              ;   C = Col (0..31)
 729+ 7248              ;
 730+ 7248              ; Utilizza:
 731+ 7248              ;   room_ptr -> struttura dati della stanza corrente
 732+ 7248              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 733+ 7248              ;   DrawTile -> ridisegna il tile selezionato
 734+ 7248              ;
 735+ 7248              ; Tipi di cella:
 736+ 7248              ;   0 = Background
 737+ 7248              ;   1 = Floor
 738+ 7248              ;   2 = Wall
 739+ 7248              ;   3 = Nasty
 740+ 7248              ; -------------------------------------------------------------------
 741+ 7248              RestoreBackgroundCell:
 742+ 7248
 743+ 7248                  ; Salva tutti i registri utilizzati
 744+ 7248 FD E5            push iy
 745+ 724A C5               push bc
 746+ 724B D5               push de
 747+ 724C E5               push hl
 748+ 724D DD E5            push ix
 749+ 724F
 750+ 724F                  ; ---------------------------------------------------------------
 751+ 724F                  ; Conserva Row e Col in IY.
 752+ 724F                  ;
 753+ 724F                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 754+ 724F                  ; BC potrebbe essere modificato.
 755+ 724F                  ; ---------------------------------------------------------------
 756+ 724F C5               push bc
 757+ 7250 FD E1            pop  iy                ; IYH = Row, IYL = Col
 758+ 7252
 759+ 7252                  ; ---------------------------------------------------------------
 760+ 7252                  ; Determina quale tipo di cella è presente nella posizione
 761+ 7252                  ; specificata.
 762+ 7252                  ;
 763+ 7252                  ; Input:
 764+ 7252                  ;   B = Row
 765+ 7252                  ;   C = Col
 766+ 7252                  ;
 767+ 7252                  ; Output:
 768+ 7252                  ;   A = tipo cella
 769+ 7252                  ; ---------------------------------------------------------------
 770+ 7252 78               ld   a, b
 771+ 7253
 772+ 7253 CD 43 6B         call GetCellFromUnpacked
 773+ 7256
 774+ 7256                  ; ---------------------------------------------------------------
 775+ 7256                  ; Recupera il puntatore alla stanza corrente.
 776+ 7256                  ;
 777+ 7256                  ; DE = base della struttura stanza
 778+ 7256                  ; ---------------------------------------------------------------
 779+ 7256 ED 5B DC 76      ld   de, (room_ptr)
 780+ 725A
 781+ 725A                  ; ---------------------------------------------------------------
 782+ 725A                  ; Seleziona il tile corretto in base al tipo di cella.
 783+ 725A                  ;
 784+ 725A                  ; A = 0 -> Background
 785+ 725A                  ; A = 1 -> Floor
 786+ 725A                  ; A = 2 -> Wall
 787+ 725A                  ; A = 3 -> Nasty
 788+ 725A                  ; ---------------------------------------------------------------
 789+ 725A
 790+ 725A B7               or   a
 791+ 725B 20 06            jr   nz, .not_bg
 792+ 725D
 793+ 725D                  ; Background
 794+ 725D 21 A0 00         ld   hl, OFFSET_BG
 795+ 7260 19               add  hl, de
 796+ 7261 18 16            jr   .draw_cell
 797+ 7263
 798+ 7263              .not_bg:
 799+ 7263
 800+ 7263 3D               dec  a
 801+ 7264 20 06            jr   nz, .not_floor
 802+ 7266
 803+ 7266                  ; Floor
 804+ 7266 21 A9 00         ld   hl, OFFSET_FLOOR
 805+ 7269 19               add  hl, de
 806+ 726A 18 0D            jr   .draw_cell
 807+ 726C
 808+ 726C              .not_floor:
 809+ 726C
 810+ 726C 3D               dec  a
 811+ 726D 20 06            jr   nz, .not_wall
 812+ 726F
 813+ 726F                  ; Wall
 814+ 726F 21 B2 00         ld   hl, OFFSET_WALL
 815+ 7272 19               add  hl, de
 816+ 7273 18 04            jr   .draw_cell
 817+ 7275
 818+ 7275              .not_wall:
 819+ 7275
 820+ 7275                  ; Nasty
 821+ 7275 21 BB 00         ld   hl, OFFSET_NASTY
 822+ 7278 19               add  hl, de
 823+ 7279
 824+ 7279              .draw_cell:
 825+ 7279
 826+ 7279                  ; ---------------------------------------------------------------
 827+ 7279                  ; HL punta ora alla grafica del tile da ridisegnare.
 828+ 7279                  ;
 829+ 7279                  ; DrawTile si aspetta:
 830+ 7279                  ;   IX = puntatore tile
 831+ 7279                  ;   B  = Row
 832+ 7279                  ;   C  = Col
 833+ 7279                  ; ---------------------------------------------------------------
 834+ 7279 E5               push hl
 835+ 727A DD E1            pop  ix
 836+ 727C
 837+ 727C                  ; Ripristina Row e Col salvati in IY
 838+ 727C FD E5            push iy
 839+ 727E C1               pop  bc
 840+ 727F
 841+ 727F                  ; Disegna il tile originale
 842+ 727F CD 8C 61         call DrawTile
 843+ 7282
 844+ 7282                  ; ---------------------------------------------------------------
 845+ 7282                  ; Ripristina i registri salvati
 846+ 7282                  ; ---------------------------------------------------------------
 847+ 7282 DD E1            pop  ix
 848+ 7284 E1               pop  hl
 849+ 7285 D1               pop  de
 850+ 7286 C1               pop  bc
 851+ 7287 FD E1            pop  iy
 852+ 7289
 853+ 7289 C9               ret
 854+ 728A
 855+ 728A              ; -------------------------------------------------------------------
 856+ 728A              ; CheckWillyItemCollision
 857+ 728A              ;
 858+ 728A              ; Verifica se Willy collide con un item utilizzando il controllo
 859+ 728A              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 860+ 728A              ;
 861+ 728A              ; Input:
 862+ 728A              ;   A = ItemX (colonna attributi 0..31)
 863+ 728A              ;   H = ItemY (riga attributi 3..18)
 864+ 728A              ;
 865+ 728A              ; Coordinate item:
 866+ 728A              ;   Ogni item occupa una cella da 8x8 pixel.
 867+ 728A              ;
 868+ 728A              ; Coordinate Willy:
 869+ 728A              ;   Willy occupa un rettangolo di 16x16 pixel.
 870+ 728A              ;
 871+ 728A              ; Output:
 872+ 728A              ;   Carry Set   = collisione rilevata
 873+ 728A              ;   Carry Clear = nessuna collisione
 874+ 728A              ;
 875+ 728A              ; Registri preservati:
 876+ 728A              ;   BC, DE, HL
 877+ 728A              ; -------------------------------------------------------------------
 878+ 728A              CheckWillyItemCollision:
 879+ 728A
 880+ 728A                  ; Salva i registri utilizzati
 881+ 728A C5               push bc
 882+ 728B D5               push de
 883+ 728C E5               push hl
 884+ 728D
 885+ 728D                  ; ---------------------------------------------------------------
 886+ 728D                  ; Calcola il bounding box orizzontale dell'item
 887+ 728D                  ;
 888+ 728D                  ; ItemLeft  = ItemX * 8
 889+ 728D                  ; ItemRight = ItemLeft + 7
 890+ 728D                  ;
 891+ 728D                  ; E = ItemLeft
 892+ 728D                  ; D = ItemRight
 893+ 728D                  ; ---------------------------------------------------------------
 894+ 728D 6F               ld   l, a              ; L = ItemX
 895+ 728E
 896+ 728E 7D               ld   a, l
 897+ 728F 87               add  a, a              ; *2
 898+ 7290 87               add  a, a              ; *4
 899+ 7291 87               add  a, a              ; *8
 900+ 7292
 901+ 7292 5F               ld   e, a              ; E = ItemLeft
 902+ 7293
 903+ 7293 C6 07            add  a, 7
 904+ 7295 57               ld   d, a              ; D = ItemRight
 905+ 7296
 906+ 7296                  ; ---------------------------------------------------------------
 907+ 7296                  ; Recupera la posizione corrente di Willy
 908+ 7296                  ;
 909+ 7296                  ; B = WillyY
 910+ 7296                  ; C = WillyX
 911+ 7296                  ; ---------------------------------------------------------------
 912+ 7296 ED 4B 6B 73      ld   bc, (PlayerPos)
 913+ 729A
 914+ 729A                  ; ---------------------------------------------------------------
 915+ 729A                  ; Primo test:
 916+ 729A                  ;
 917+ 729A                  ; WillyLeft <= ItemRight
 918+ 729A                  ;
 919+ 729A                  ; Se Willy è completamente a destra dell'item
 920+ 729A                  ; non può esserci collisione.
 921+ 729A                  ; ---------------------------------------------------------------
 922+ 729A 79               ld   a, c              ; A = WillyLeft
 923+ 729B
 924+ 729B BA               cp   d                 ; WillyLeft vs ItemRight
 925+ 729C
 926+ 729C 28 04            jr   z, .x_ok
 927+ 729E 38 02            jr   c, .x_ok
 928+ 72A0
 929+ 72A0 18 29            jr   .no_collision
 930+ 72A2
 931+ 72A2              .x_ok:
 932+ 72A2
 933+ 72A2                  ; ---------------------------------------------------------------
 934+ 72A2                  ; Secondo test:
 935+ 72A2                  ;
 936+ 72A2                  ; WillyRight >= ItemLeft
 937+ 72A2                  ;
 938+ 72A2                  ; WillyRight = WillyX + 7
 939+ 72A2                  ; ---------------------------------------------------------------
 940+ 72A2 C6 07            add  a, 7
 941+ 72A4
 942+ 72A4 BB               cp   e                 ; WillyRight vs ItemLeft
 943+ 72A5
 944+ 72A5 28 04            jr   z, .y_check
 945+ 72A7 30 02            jr   nc, .y_check
 946+ 72A9
 947+ 72A9 18 20            jr   .no_collision
 948+ 72AB
 949+ 72AB              .y_check:
 950+ 72AB
 951+ 72AB                  ; ---------------------------------------------------------------
 952+ 72AB                  ; Recupera ItemY dal valore originale di HL
 953+ 72AB                  ;
 954+ 72AB                  ; H contiene la riga dell'item.
 955+ 72AB                  ; ---------------------------------------------------------------
 956+ 72AB E1               pop  hl
 957+ 72AC E5               push hl
 958+ 72AD
 959+ 72AD                  ; ---------------------------------------------------------------
 960+ 72AD                  ; Calcola il bounding box verticale dell'item
 961+ 72AD                  ;
 962+ 72AD                  ; ItemTop    = ItemY * 8
 963+ 72AD                  ; ItemBottom = ItemTop + 7
 964+ 72AD                  ;
 965+ 72AD                  ; E = ItemTop
 966+ 72AD                  ; D = ItemBottom
 967+ 72AD                  ; ---------------------------------------------------------------
 968+ 72AD 7C               ld   a, h
 969+ 72AE
 970+ 72AE 87               add  a, a              ; *2
 971+ 72AF 87               add  a, a              ; *4
 972+ 72B0 87               add  a, a              ; *8
 973+ 72B1
 974+ 72B1 5F               ld   e, a              ; ItemTop
 975+ 72B2
 976+ 72B2 C6 07            add  a, 7
 977+ 72B4 57               ld   d, a              ; ItemBottom
 978+ 72B5
 979+ 72B5                  ; ---------------------------------------------------------------
 980+ 72B5                  ; Primo test verticale:
 981+ 72B5                  ;
 982+ 72B5                  ; WillyTop <= ItemBottom
 983+ 72B5                  ; ---------------------------------------------------------------
 984+ 72B5 78               ld   a, b              ; WillyTop
 985+ 72B6
 986+ 72B6 BA               cp   d
 987+ 72B7
 988+ 72B7 28 04            jr   z, .y_ok
 989+ 72B9 38 02            jr   c, .y_ok
 990+ 72BB
 991+ 72BB 18 0E            jr   .no_collision
 992+ 72BD
 993+ 72BD              .y_ok:
 994+ 72BD
 995+ 72BD                  ; ---------------------------------------------------------------
 996+ 72BD                  ; Secondo test verticale:
 997+ 72BD                  ;
 998+ 72BD                  ; WillyBottom >= ItemTop
 999+ 72BD                  ;
1000+ 72BD                  ; WillyBottom = WillyY + 15
1001+ 72BD                  ; ---------------------------------------------------------------
1002+ 72BD C6 0F            add  a, 15
1003+ 72BF
1004+ 72BF BB               cp   e
1005+ 72C0
1006+ 72C0 28 04            jr   z, .collision
1007+ 72C2 30 02            jr   nc, .collision
1008+ 72C4
1009+ 72C4 18 05            jr   .no_collision
1010+ 72C6
1011+ 72C6              .collision:
1012+ 72C6
1013+ 72C6                  ; ---------------------------------------------------------------
1014+ 72C6                  ; Collisione rilevata
1015+ 72C6                  ; ---------------------------------------------------------------
1016+ 72C6 E1               pop  hl
1017+ 72C7 D1               pop  de
1018+ 72C8 C1               pop  bc
1019+ 72C9
1020+ 72C9 37               scf                    ; Carry = 1
1021+ 72CA
1022+ 72CA C9               ret
1023+ 72CB
1024+ 72CB              .no_collision:
1025+ 72CB
1026+ 72CB                  ; ---------------------------------------------------------------
1027+ 72CB                  ; Nessuna collisione
1028+ 72CB                  ; ---------------------------------------------------------------
1029+ 72CB E1               pop  hl
1030+ 72CC D1               pop  de
1031+ 72CD C1               pop  bc
1032+ 72CE
1033+ 72CE B7               or   a                 ; Carry = 0
1034+ 72CF
1035+ 72CF C9               ret
1036+ 72D0
1037+ 72D0              ; -------------------------------------------------------------------
1038+ 72D0              ; CheckRoomItemsCollision
1039+ 72D0              ;
1040+ 72D0              ; Controlla se Willy entra in collisione con uno degli item
1041+ 72D0              ; attivi presenti nella stanza corrente.
1042+ 72D0              ;
1043+ 72D0              ; Per ogni item:
1044+ 72D0              ;   - verifica che appartenga alla stanza corrente
1045+ 72D0              ;   - verifica che non sia già stato raccolto
1046+ 72D0              ;   - esegue il test di collisione con Willy
1047+ 72D0              ;
1048+ 72D0              ; Se l'item viene raccolto:
1049+ 72D0              ;   - imposta il flag "collected"
1050+ 72D0              ;   - rimuove l'item dalla cache items_grid
1051+ 72D0              ;   - incrementa il contatore degli oggetti raccolti
1052+ 72D0              ;   - aggiorna l'HUD
1053+ 72D0              ;   - ripristina il tile di sfondo
1054+ 72D0              ;   - riproduce il suono di raccolta
1055+ 72D0              ;
1056+ 72D0              ; Formato record ItemsTable:
1057+ 72D0              ;   +0 RoomID
1058+ 72D0              ;   +1 X
1059+ 72D0              ;   +2 Y
1060+ 72D0              ;   +3 Color
1061+ 72D0              ;   +4 Collected
1062+ 72D0              ;
1063+ 72D0              ; Fine tabella:
1064+ 72D0              ;   RoomID = $FF
1065+ 72D0              ; -------------------------------------------------------------------
1066+ 72D0              CheckRoomItemsCollision:
1067+ 72D0
1068+ 72D0                  ; Salva i registri utilizzati
1069+ 72D0 E5               push hl
1070+ 72D1 D5               push de
1071+ 72D2 C5               push bc
1072+ 72D3
1073+ 72D3                  ; Inizio scansione della tabella degli item
1074+ 72D3 21 17 70         ld   hl, ItemsTable
1075+ 72D6
1076+ 72D6              .loop:
1077+ 72D6
1078+ 72D6                  ; ---------------------------------------------------------------
1079+ 72D6                  ; Legge il Room ID dell'item corrente
1080+ 72D6                  ; ---------------------------------------------------------------
1081+ 72D6 7E               ld   a, (hl)
1082+ 72D7
1083+ 72D7                  ; $FF indica fine tabella
1084+ 72D7 FE FF            cp   $FF
1085+ 72D9 28 4D            jr   z, .done
1086+ 72DB
1087+ 72DB                  ; ---------------------------------------------------------------
1088+ 72DB                  ; Verifica se l'item appartiene alla stanza corrente
1089+ 72DB                  ; ---------------------------------------------------------------
1090+ 72DB 57               ld   d, a              ; D = RoomID item
1091+ 72DC
1092+ 72DC 3A 82 76         ld   a, (current_room)
1093+ 72DF BA               cp   d
1094+ 72E0
1095+ 72E0                  ; Se appartiene a un'altra stanza salta il record
1096+ 72E0 20 3F            jr   nz, .next_item
1097+ 72E2
1098+ 72E2                  ; ---------------------------------------------------------------
1099+ 72E2                  ; Legge coordinate e stato dell'item
1100+ 72E2                  ; ---------------------------------------------------------------
1101+ 72E2
1102+ 72E2 23               inc  hl
1103+ 72E3 4E               ld   c, (hl)           ; C = X
1104+ 72E4
1105+ 72E4 23               inc  hl
1106+ 72E5 46               ld   b, (hl)           ; B = Y
1107+ 72E6
1108+ 72E6 23               inc  hl                ; salta Color
1109+ 72E7
1110+ 72E7 23               inc  hl                ; punta a Collected
1111+ 72E8
1112+ 72E8 7E               ld   a, (hl)
1113+ 72E9
1114+ 72E9                  ; ---------------------------------------------------------------
1115+ 72E9                  ; Item già raccolto?
1116+ 72E9                  ; ---------------------------------------------------------------
1117+ 72E9 B7               or   a
1118+ 72EA 20 39            jr   nz, .next_no_inc
1119+ 72EC
1120+ 72EC                  ; ---------------------------------------------------------------
1121+ 72EC                  ; Test collisione Willy ↔ Item
1122+ 72EC                  ;
1123+ 72EC                  ; Input richiesto:
1124+ 72EC                  ;   A = ItemX
1125+ 72EC                  ;   H = ItemY
1126+ 72EC                  ; ---------------------------------------------------------------
1127+ 72EC 79               ld   a, c
1128+ 72ED
1129+ 72ED E5               push hl                ; salva puntatore al flag Collected
1130+ 72EE
1131+ 72EE 60               ld   h, b
1132+ 72EF
1133+ 72EF CD 8A 72         call CheckWillyItemCollision
1134+ 72F2
1135+ 72F2 E1               pop  hl
1136+ 72F3
1137+ 72F3                  ; Nessuna collisione
1138+ 72F3 30 30            jr   nc, .next_no_inc
1139+ 72F5
1140+ 72F5                  ; ===============================================================
1141+ 72F5                  ; ITEM RACCOLTO
1142+ 72F5                  ; ===============================================================
1143+ 72F5
1144+ 72F5                  ; ---------------------------------------------------------------
1145+ 72F5                  ; Marca l'item come raccolto
1146+ 72F5                  ; ---------------------------------------------------------------
1147+ 72F5 36 01            ld   (hl), 1
1148+ 72F7
1149+ 72F7                  ; ---------------------------------------------------------------
1150+ 72F7                  ; Rimuove l'item dalla cache items_grid
1151+ 72F7                  ;
1152+ 72F7                  ; Calcolo:
1153+ 72F7                  ;   offset = Row * 32 + Col
1154+ 72F7                  ; ---------------------------------------------------------------
1155+ 72F7 E5               push hl
1156+ 72F8 D5               push de
1157+ 72F9
1158+ 72F9 26 00            ld   h, 0
1159+ 72FB 68               ld   l, b              ; HL = Row
1160+ 72FC
1161+ 72FC 29               add  hl, hl            ; *2
1162+ 72FD 29               add  hl, hl            ; *4
1163+ 72FE 29               add  hl, hl            ; *8
1164+ 72FF 29               add  hl, hl            ; *16
1165+ 7300 29               add  hl, hl            ; *32
1166+ 7301
1167+ 7301 59               ld   e, c
1168+ 7302 16 00            ld   d, 0
1169+ 7304
1170+ 7304 19               add  hl, de            ; Row*32 + Col
1171+ 7305
1172+ 7305 11 00 A5         ld   de, items_grid
1173+ 7308 19               add  hl, de
1174+ 7309
1175+ 7309                  ; La cella non contiene più un item
1176+ 7309 36 00            ld   (hl), 0
1177+ 730B
1178+ 730B D1               pop  de
1179+ 730C E1               pop  hl
1180+ 730D
1181+ 730D                  ; ---------------------------------------------------------------
1182+ 730D                  ; Conserva il puntatore all'entry corrente
1183+ 730D                  ; poiché le routine successive possono alterare HL.
1184+ 730D                  ; ---------------------------------------------------------------
1185+ 730D E5               push hl
1186+ 730E
1187+ 730E                  ; ---------------------------------------------------------------
1188+ 730E                  ; Aggiorna il numero di oggetti raccolti
1189+ 730E                  ; ---------------------------------------------------------------
1190+ 730E 3A 75 73         ld   a, (items_collected)
1191+ 7311
1192+ 7311 3C               inc  a
1193+ 7312
1194+ 7312 32 75 73         ld   (items_collected), a
1195+ 7315
1196+ 7315                  ; ---------------------------------------------------------------
1197+ 7315                  ; Aggiorna il contatore visualizzato a schermo
1198+ 7315                  ; ---------------------------------------------------------------
1199+ 7315 CD CB 60         call UpdateItemsCollectedDisplay
1200+ 7318
1201+ 7318                  ; ---------------------------------------------------------------
1202+ 7318                  ; Ripristina il tile originale della stanza
1203+ 7318                  ; eliminando la grafica dell'item.
1204+ 7318                  ;
1205+ 7318                  ; Input:
1206+ 7318                  ;   B = Row
1207+ 7318                  ;   C = Col
1208+ 7318                  ; ---------------------------------------------------------------
1209+ 7318 CD 48 72         call RestoreBackgroundCell
1210+ 731B
1211+ 731B                  ; ---------------------------------------------------------------
1212+ 731B                  ; Riproduce il suono di raccolta
1213+ 731B                  ; ---------------------------------------------------------------
1214+ 731B CD 2C 73         call PlayCollectSound
1215+ 731E
1216+ 731E                  ; Ripristina il puntatore alla tabella
1217+ 731E E1               pop  hl
1218+ 731F
1219+ 731F                  ; Continua con il record successivo
1220+ 731F 18 04            jr   .next_no_inc
1221+ 7321
1222+ 7321              .next_item:
1223+ 7321
1224+ 7321                  ; ---------------------------------------------------------------
1225+ 7321                  ; Salta i campi del record:
1226+ 7321                  ;   X
1227+ 7321                  ;   Y
1228+ 7321                  ;   Color
1229+ 7321                  ;   Collected
1230+ 7321                  ; ---------------------------------------------------------------
1231+ 7321 23               inc  hl
1232+ 7322 23               inc  hl
1233+ 7323 23               inc  hl
1234+ 7324 23               inc  hl
1235+ 7325
1236+ 7325              .next_no_inc:
1237+ 7325
1238+ 7325                  ; ---------------------------------------------------------------
1239+ 7325                  ; Avanza al record successivo.
1240+ 7325                  ;
1241+ 7325                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1242+ 7325                  ; ---------------------------------------------------------------
1243+ 7325 23               inc  hl
1244+ 7326
1245+ 7326 18 AE            jr   .loop
1246+ 7328
1247+ 7328              .done:
1248+ 7328
1249+ 7328                  ; Ripristina i registri
1250+ 7328 C1               pop  bc
1251+ 7329 D1               pop  de
1252+ 732A E1               pop  hl
1253+ 732B
1254+ 732B C9               ret
1255+ 732C
1256+ 732C              ; -------------------------------------------------------------------
1257+ 732C              ; PlayCollectSound
1258+ 732C              ;
1259+ 732C              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1260+ 732C              ; dello ZX Spectrum utilizzando il port $FE.
1261+ 732C              ;
1262+ 732C              ; Il suono viene prodotto alternando ON/OFF del bit 4
1263+ 732C              ; (speaker) con un semplice delay software.
1264+ 732C              ;
1265+ 732C              ; Effetto risultante:
1266+ 732C              ;   beep breve tipo "pickup item"
1267+ 732C              ; -------------------------------------------------------------------
1268+ 732C              PlayCollectSound:
1269+ 732C
1270+ 732C                  ; Salva registri utilizzati
1271+ 732C C5               push bc
1272+ 732D D5               push de
1273+ 732E
1274+ 732E                  ; ---------------------------------------------------------------
1275+ 732E                  ; Numero di cicli del beep (durata complessiva del suono)
1276+ 732E                  ; ---------------------------------------------------------------
1277+ 732E 06 78            ld   b, 120
1278+ 7330
1279+ 7330              .sound_loop:
1280+ 7330
1281+ 7330                  ; ---------------------------------------------------------------
1282+ 7330                  ; SPEAKER ON
1283+ 7330                  ;
1284+ 7330                  ; Legge il colore del bordo corrente e attiva il bit 4
1285+ 7330                  ; per pilotare lo speaker.
1286+ 7330                  ; ---------------------------------------------------------------
1287+ 7330 3A 77 73         ld   a, (room_border_color)
1288+ 7333 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1289+ 7335
1290+ 7335 D3 FE            out  ($fe), a         ; scrive sul port ULA
1291+ 7337
1292+ 7337                  ; ---------------------------------------------------------------
1293+ 7337                  ; Delay (mezzo periodo)
1294+ 7337                  ; Loop software a consumo CPU
1295+ 7337                  ; ---------------------------------------------------------------
1296+ 7337 0E 3C            ld   c, 60
1297+ 7339
1298+ 7339              .d1:
1299+ 7339 0D               dec  c
1300+ 733A 20 FD            jr   nz, .d1
1301+ 733C
1302+ 733C                  ; ---------------------------------------------------------------
1303+ 733C                  ; SPEAKER OFF
1304+ 733C                  ;
1305+ 733C                  ; Mantiene il colore del bordo ma disattiva lo speaker
1306+ 733C                  ; ---------------------------------------------------------------
1307+ 733C 3A 77 73         ld   a, (room_border_color)
1308+ 733F E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1309+ 7341
1310+ 7341 D3 FE            out  ($fe), a
1311+ 7343
1312+ 7343                  ; ---------------------------------------------------------------
1313+ 7343                  ; Secondo delay (mezzo periodo)
1314+ 7343                  ; Completa l’onda quadra
1315+ 7343                  ; ---------------------------------------------------------------
1316+ 7343 0E 3C            ld   c, 60
1317+ 7345
1318+ 7345              .d2:
1319+ 7345 0D               dec  c
1320+ 7346 20 FD            jr   nz, .d2
1321+ 7348
1322+ 7348                  ; ---------------------------------------------------------------
1323+ 7348                  ; Ripete fino a completare il numero di cicli
1324+ 7348                  ; ---------------------------------------------------------------
1325+ 7348 10 E6            djnz .sound_loop
1326+ 734A
1327+ 734A                  ; Ripristina registri salvati
1328+ 734A D1               pop  de
1329+ 734B C1               pop  bc
1330+ 734C
1331+ 734C C9               ret
1332+ 734D
1333+ 734D              ; -------------------------------------------------------------------
1334+ 734D              ; CheckActiveItemAtCell
1335+ 734D              ;
1336+ 734D              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1337+ 734D              ; nella cella specificata della griglia items_grid.
1338+ 734D              ;
1339+ 734D              ; Questa routine usa una lookup diretta su una mappa 32x16,
1340+ 734D              ; evitando la scansione della ItemsTable.
1341+ 734D              ;
1342+ 734D              ; Input:
1343+ 734D              ;   B = Colonna (0..31)
1344+ 734D              ;   C = Riga (0..15)
1345+ 734D              ;
1346+ 734D              ; Output:
1347+ 734D              ;   Carry Set   = item presente nella cella
1348+ 734D              ;   Carry Clear = nessun item
1349+ 734D              ;
1350+ 734D              ; Nota:
1351+ 734D              ;   HL NON è restituito valido (commento originale non corretto:
1352+ 734D              ;   la routine non punta a ItemsTable).
1353+ 734D              ; -------------------------------------------------------------------
1354+ 734D              CheckActiveItemAtCell:
1355+ 734D
1356+ 734D                  ; Salva registri usati
1357+ 734D D5               push de
1358+ 734E E5               push hl
1359+ 734F
1360+ 734F                  ; ---------------------------------------------------------------
1361+ 734F                  ; Calcolo indice lineare nella griglia 32x16:
1362+ 734F                  ;
1363+ 734F                  ; offset = Row * 32 + Col
1364+ 734F                  ; ---------------------------------------------------------------
1365+ 734F 26 00            ld   h, 0
1366+ 7351 69               ld   l, c              ; HL = Row
1367+ 7352
1368+ 7352 29               add  hl, hl            ; *2
1369+ 7353 29               add  hl, hl            ; *4
1370+ 7354 29               add  hl, hl            ; *8
1371+ 7355 29               add  hl, hl            ; *16
1372+ 7356 29               add  hl, hl            ; *32
1373+ 7357
1374+ 7357                  ; Aggiunge la colonna
1375+ 7357 58               ld   e, b
1376+ 7358 16 00            ld   d, 0
1377+ 735A 19               add  hl, de            ; HL = Row*32 + Col
1378+ 735B
1379+ 735B                  ; ---------------------------------------------------------------
1380+ 735B                  ; Accesso alla griglia degli item attivi
1381+ 735B                  ; ---------------------------------------------------------------
1382+ 735B 11 00 A5         ld   de, items_grid
1383+ 735E 19               add  hl, de            ; HL = address cella
1384+ 735F
1385+ 735F                  ; ---------------------------------------------------------------
1386+ 735F                  ; Controllo presenza item
1387+ 735F                  ;
1388+ 735F                  ; items_grid contiene:
1389+ 735F                  ;   0 = nessun item
1390+ 735F                  ;   >0 = item attivo (colore o flag)
1391+ 735F                  ; ---------------------------------------------------------------
1392+ 735F 7E               ld   a, (hl)
1393+ 7360 B7               or   a
1394+ 7361 28 04            jr   z, .not_active
1395+ 7363
1396+ 7363                  ; ---------------------------------------------------------------
1397+ 7363                  ; Item trovato
1398+ 7363                  ; ---------------------------------------------------------------
1399+ 7363 E1               pop  hl
1400+ 7364 D1               pop  de
1401+ 7365
1402+ 7365 37               scf                    ; Carry = 1
1403+ 7366 C9               ret
1404+ 7367
1405+ 7367              .not_active:
1406+ 7367
1407+ 7367                  ; ---------------------------------------------------------------
1408+ 7367                  ; Nessun item nella cella
1409+ 7367                  ; ---------------------------------------------------------------
1410+ 7367 E1               pop  hl
1411+ 7368 D1               pop  de
1412+ 7369
1413+ 7369 B7               or   a                 ; Carry = 0
1414+ 736A C9               ret
1415+ 736B
