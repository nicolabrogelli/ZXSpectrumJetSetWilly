 306+ 6F1B              ; -------------------------------------------------------------------
 307+ 6F1B              ; Controlla se la coordinata pixel (X, Y) si trova su un conveyor o rampa
 308+ 6F1B              ; Input: C = X, B = Y
 309+ 6F1B              ; Output: Carry flag impostato se solida, altrimenti resettato
 310+ 6F1B              ; -------------------------------------------------------------------
 311+ 6F1B              CheckConveyorOrRampCell:
 312+ 6F1B E5               push hl
 313+ 6F1C D5               push de
 314+ 6F1D C5               push bc
 315+ 6F1E
 316+ 6F1E                  ; 1. Converti Y pixel in B a layout row: r = (Y - 24) / 8
 317+ 6F1E 78               ld   a, b
 318+ 6F1F FE 18            cp   24
 319+ 6F21 38 64            jr   c, .not_solid
 320+ 6F23 FE 98            cp   152
 321+ 6F25 30 60            jr   nc, .not_solid
 322+ 6F27 D6 18            sub  24
 323+ 6F29 CB 3F            srl  a
 324+ 6F2B CB 3F            srl  a
 325+ 6F2D CB 3F            srl  a                 ; A = r (0..15)
 326+ 6F2F 57               ld   d, a              ; D = r (layout row)
 327+ 6F30
 328+ 6F30                  ; 2. Converti X pixel in C a column: c = X / 8
 329+ 6F30 79               ld   a, c
 330+ 6F31 CB 3F            srl  a
 331+ 6F33 CB 3F            srl  a
 332+ 6F35 CB 3F            srl  a                 ; A = c (0..31)
 333+ 6F37 5F               ld   e, a              ; E = c (column)
 334+ 6F38
 335+ 6F38                  ; --- CONTROLLO CONVEYOR ---
 336+ 6F38 3A FC 78         ld   a, (conveyor_len)
 337+ 6F3B B7               or   a
 338+ 6F3C 28 1E            jr   z, .check_ramp    ; Se non c'è conveyor, controlla rampa
 339+ 6F3E
 340+ 6F3E                  ; Controlla se Row corrisponde
 341+ 6F3E 3A FD 78         ld   a, (conveyor_row)
 342+ 6F41 D6 03            sub  3                 ; Converti in layout row
 343+ 6F43 BA               cp   d
 344+ 6F44 20 16            jr   nz, .check_ramp   ; Row diversa, controlla rampa
 345+ 6F46
 346+ 6F46                  ; Controlla se Col è compresa: c >= conveyor_col e c < conveyor_col + conveyor_len
 347+ 6F46 3A FE 78         ld   a, (conveyor_col)
 348+ 6F49 BB               cp   e
 349+ 6F4A 28 0E            jr   z, .is_conveyor   ; c == conveyor_col -> solido!
 350+ 6F4C 38 02            jr   c, .c_greater     ; c > conveyor_col -> controlla limite superiore
 351+ 6F4E 18 0C            jr   .check_ramp       ; c < conveyor_col
 352+ 6F50              .c_greater:
 353+ 6F50 47               ld   b, a              ; B = conveyor_col
 354+ 6F51 3A FC 78         ld   a, (conveyor_len)
 355+ 6F54 80               add  a, b              ; A = conveyor_col + conveyor_len
 356+ 6F55 BB               cp   e
 357+ 6F56 28 04            jr   z, .check_ramp    ; c == len (fuori)
 358+ 6F58 38 02            jr   c, .check_ramp    ; c > len (fuori)
 359+ 6F5A              .is_conveyor:
 360+ 6F5A 18 30            jr   .solid
 361+ 6F5C
 362+ 6F5C              .check_ramp:
 363+ 6F5C                  ; --- CONTROLLO RAMP ---
 364+ 6F5C 3A 00 79         ld   a, (ramp_len)
 365+ 6F5F B7               or   a
 366+ 6F60 28 25            jr   z, .not_solid     ; Se non c'è rampa, fine
 367+ 6F62
 368+ 6F62 3A 01 79         ld   a, (ramp_row)
 369+ 6F65 D6 03            sub  3                 ; A = RampRowStart
 370+ 6F67 BA               cp   d                 ; compare with player row D
 371+ 6F68 38 1D            jr   c, .not_solid     ; if RampRowStart < D, skip!
 372+ 6F6A
 373+ 6F6A 92               sub  d                 ; A = RampRowStart - D
 374+ 6F6B 47               ld   b, a              ; B = distance from start row (0..ramp_len-1)
 375+ 6F6C 3A 00 79         ld   a, (ramp_len)
 376+ 6F6F B8               cp   b
 377+ 6F70 28 15            jr   z, .not_solid     ; if B == ramp_len, too high!
 378+ 6F72 38 13            jr   c, .not_solid     ; if B > ramp_len, too high!
 379+ 6F74
 380+ 6F74                  ; Calcola ExpectedCol:
 381+ 6F74 3A FF 78         ld   a, (ramp_dir)
 382+ 6F77 B7               or   a
 383+ 6F78 28 06            jr   z, .r_left
 384+ 6F7A              .r_right:
