 351+ 74A5              ; -------------------------------------------------------------------
 352+ 74A5              ; Controlla se Willy collide con un item (pixel-level check)
 353+ 74A5              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 354+ 74A5              ; Output: Carry set se collide, altrimenti clear
 355+ 74A5              ; -------------------------------------------------------------------
 356+ 74A5              CheckWillyItemCollision:
 357+ 74A5 C5               push bc
 358+ 74A6 D5               push de
 359+ 74A7 E5               push hl
 360+ 74A8
 361+ 74A8                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 362+ 74A8 6F               ld   l, a
 363+ 74A9 7D               ld   a, l
 364+ 74AA 87               add  a, a              ; *2
 365+ 74AB 87               add  a, a              ; *4
 366+ 74AC 87               add  a, a              ; *8
 367+ 74AD 5F               ld   e, a              ; E = ItemLeft
 368+ 74AE C6 07            add  a, 7
 369+ 74B0 57               ld   d, a              ; D = ItemRight
 370+ 74B1
 371+ 74B1                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 372+ 74B1 ED 4B E8 75      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 373+ 74B5
 374+ 74B5                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 375+ 74B5 79               ld   a, c
 376+ 74B6 BA               cp   d
 377+ 74B7 28 04            jr   z, .x_ok
 378+ 74B9 38 02            jr   c, .x_ok
 379+ 74BB 18 29            jr   .no_collision
 380+ 74BD              .x_ok:
 381+ 74BD C6 0F            add  a, 15
 382+ 74BF BB               cp   e
 383+ 74C0 28 04            jr   z, .y_check
 384+ 74C2 30 02            jr   nc, .y_check
 385+ 74C4 18 20            jr   .no_collision
 386+ 74C6
 387+ 74C6              .y_check:
 388+ 74C6 E1               pop  hl                ; Recupera HL originale (H = ItemY)
 389+ 74C7 E5               push hl
 390+ 74C8 7C               ld   a, h
 391+ 74C9 87               add  a, a              ; *2
 392+ 74CA 87               add  a, a              ; *4
 393+ 74CB 87               add  a, a              ; *8
 394+ 74CC 5F               ld   e, a              ; E = ItemTop
 395+ 74CD C6 07            add  a, 7
 396+ 74CF 57               ld   d, a              ; D = ItemBottom
 397+ 74D0
 398+ 74D0                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 399+ 74D0 78               ld   a, b
 400+ 74D1 BA               cp   d
 401+ 74D2 28 04            jr   z, .y_ok
 402+ 74D4 38 02            jr   c, .y_ok
 403+ 74D6 18 0E            jr   .no_collision
 404+ 74D8              .y_ok:
 405+ 74D8 C6 0F            add  a, 15
 406+ 74DA BB               cp   e
 407+ 74DB 28 04            jr   z, .collision
 408+ 74DD 30 02            jr   nc, .collision
 409+ 74DF 18 05            jr   .no_collision
 410+ 74E1
 411+ 74E1              .collision:
 412+ 74E1 E1               pop  hl
 413+ 74E2 D1               pop  de
 414+ 74E3 C1               pop  bc
 415+ 74E4 37               scf                    ; Set carry (collisione!)
 416+ 74E5 C9               ret
 417+ 74E6
 418+ 74E6              .no_collision:
 419+ 74E6 E1               pop  hl
 420+ 74E7 D1               pop  de
 421+ 74E8 C1               pop  bc
 422+ 74E9 B7               or   a                 ; Clear carry
 423+ 74EA C9               ret
