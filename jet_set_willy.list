1008+ 6B14              ; -------------------------------------------------------------------
1009+ 6B14              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1010+ 6B14              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1011+ 6B14              ; -------------------------------------------------------------------
1012+ 6B14              UnpackRoomLayout:
1013+ 6B14 E5               push hl
1014+ 6B15 D5               push de
1015+ 6B16 C5               push bc
1016+ 6B17
1017+ 6B17 2A DC 76         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1018+ 6B1A 11 82 74         ld   de, unpacked_layout ; DE = buffer RAM
1019+ 6B1D 06 80            ld   b, 128             ; 128 byte
1020+ 6B1F              .byte_loop:
1021+ 6B1F 7E               ld   a, (hl)            ; Leggi byte compresso
1022+ 6B20 23               inc  hl
1023+ 6B21
1024+ 6B21 4F               ld   c, a               ; C = salvataggio
1025+ 6B22
1026+ 6B22                  ; Cella 0: bit 7-6
1027+ 6B22 07               rlca
1028+ 6B23 07               rlca
1029+ 6B24 E6 03            and  3
1030+ 6B26 12               ld   (de), a
1031+ 6B27 13               inc  de
1032+ 6B28
1033+ 6B28                  ; Cella 1: bit 5-4
1034+ 6B28 79               ld   a, c
1035+ 6B29 07               rlca
1036+ 6B2A 07               rlca
1037+ 6B2B 07               rlca
1038+ 6B2C 07               rlca
1039+ 6B2D E6 03            and  3
1040+ 6B2F 12               ld   (de), a
1041+ 6B30 13               inc  de
1042+ 6B31
1043+ 6B31                  ; Cella 2: bit 3-2
1044+ 6B31 79               ld   a, c
1045+ 6B32 0F               rrca
1046+ 6B33 0F               rrca
1047+ 6B34 E6 03            and  3
1048+ 6B36 12               ld   (de), a
1049+ 6B37 13               inc  de
1050+ 6B38
1051+ 6B38                  ; Cella 3: bit 1-0
1052+ 6B38 79               ld   a, c
1053+ 6B39 E6 03            and  3
1054+ 6B3B 12               ld   (de), a
1055+ 6B3C 13               inc  de
1056+ 6B3D
1057+ 6B3D 10 E0            djnz .byte_loop
1058+ 6B3F
1059+ 6B3F C1               pop  bc
1060+ 6B40 D1               pop  de
1061+ 6B41 E1               pop  hl
1062+ 6B42 C9               ret
