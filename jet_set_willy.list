 577+ 6048 3E 16            ld   a, 22             ; Codice di controllo AT (22)
 578+ 604A D7               rst  $10
 579+ 604B 3E 13            ld   a, 19             ; Riga 19
 580+ 604D D7               rst  $10
 581+ 604E 3E 00            ld   a, 0              ; Colonna 0
