1064+ 6B43              ; -------------------------------------------------------------------
1065+ 6B43              ; Legge il tipo di cella dal buffer decompresso in RAM
1066+ 6B43              ; Input: A = Row (0..15), C = Col (0..31)
1067+ 6B43              ; Output: A = tipo di cella (0..3)
1068+ 6B43              ; Preserva tutti gli altri registri.
1069+ 6B43              ; -------------------------------------------------------------------
1070+ 6B43              GetCellFromUnpacked:
1071+ 6B43 E5               push hl
1072+ 6B44 D5               push de
1073+ 6B45
1074+ 6B45 6F               ld   l, a
1075+ 6B46 26 00            ld   h, 0
1076+ 6B48 29               add  hl, hl
1077+ 6B49 29               add  hl, hl
1078+ 6B4A 29               add  hl, hl
1079+ 6B4B 29               add  hl, hl
1080+ 6B4C 29               add  hl, hl            ; HL = Row * 32
1081+ 6B4D 59               ld   e, c
1082+ 6B4E 16 00            ld   d, 0
1083+ 6B50 19               add  hl, de            ; HL = Row * 32 + Col
1084+ 6B51 11 82 74         ld   de, unpacked_layout
1085+ 6B54 19               add  hl, de
1086+ 6B55 7E               ld   a, (hl)           ; A = cell type
1087+ 6B56
1088+ 6B56 D1               pop  de
1089+ 6B57 E1               pop  hl
1090+ 6B58 C9               ret
