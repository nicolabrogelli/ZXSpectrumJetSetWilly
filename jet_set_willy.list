 292+ 7461              ; -------------------------------------------------------------------
 293+ 7461              ; Ripristina la cella dello sfondo originale per cancellare l'item
 294+ 7461              ; Input: B = Row (3..18), C = Col (0..31)
 295+ 7461              ; -------------------------------------------------------------------
 296+ 7461              RestoreBackgroundCell:
 297+ 7461 FD E5            push iy                ; Preserva IY
 298+ 7463 C5               push bc
 299+ 7464 D5               push de
 300+ 7465 E5               push hl
 301+ 7466 DD E5            push ix
 302+ 7468
 303+ 7468 C5               push bc
 304+ 7469 FD E1            pop  iy                ; IY = original BC (IYH = Row, IYL = Col)
 305+ 746B
 306+ 746B                  ; Riga di layout: r = B - 3
 307+ 746B 78               ld   a, b
 308+ 746C D6 03            sub  3                 ; A = r (0..15)
 309+ 746E
 310+ 746E                  ; Colonna: c = C (Col)
 311+ 746E CD 6D 70         call GetCellFromUnpacked ; A = cell type (0..3)
 312+ 7471
 313+ 7471 ED 5B 03 79      ld   de, (room_ptr)
 314+ 7475 B7               or   a
 315+ 7476 20 06            jr   nz, .not_bg
 316+ 7478 21 A0 00         ld   hl, OFFSET_BG
 317+ 747B 19               add  hl, de
 318+ 747C 18 16            jr   .draw_cell
 319+ 747E              .not_bg:
 320+ 747E 3D               dec  a
 321+ 747F 20 06            jr   nz, .not_floor
 322+ 7481 21 A9 00         ld   hl, OFFSET_FLOOR
 323+ 7484 19               add  hl, de
 324+ 7485 18 0D            jr   .draw_cell
 325+ 7487              .not_floor:
 326+ 7487 3D               dec  a
 327+ 7488 20 06            jr   nz, .not_wall
 328+ 748A 21 B2 00         ld   hl, OFFSET_WALL
 329+ 748D 19               add  hl, de
 330+ 748E 18 04            jr   .draw_cell
 331+ 7490              .not_wall:
 332+ 7490 21 BB 00         ld   hl, OFFSET_NASTY
 333+ 7493 19               add  hl, de
