  33+ 7AD3                  ; 1. Imposta IX all'indirizzo dell'array dei colori in ROM (room_ptr + 223)
  34+ 7AD3 2A 68 FB         ld   hl, (room_ptr)
  35+ 7AD6 11 DF 00         ld   de, 223
  36+ 7AD9 19               add  hl, de
  37+ 7ADA E5               push hl
  38+ 7ADB DD E1            pop  ix                ; IX = color pointer
  39+ 7ADD
  40+ 7ADD                  ; 2. Imposta HL all'indirizzo dei dati dei nemici (room_ptr + 240)
  41+ 7ADD 2A 68 FB         ld   hl, (room_ptr)
  42+ 7AE0 11 F0 00         ld   de, 240           ; Offset degli enemy nella stanza
  43+ 7AE3 19               add  hl, de            ; HL = indirizzo di RoomXEnemy1
  44+ 7AE4
  45+ 7AE4 11 76 7A         ld   de, ActiveEnemies
  46+ 7AE7 06 08            ld   b, 8              ; 8 slot per stanza
  47+ 7AE9              .loop:
  48+ 7AE9 78               ld   a, b
  49+ 7AEA FE 04            cp   4
  50+ 7AEC 20 0E            jr   nz, .no_color_reset
  51+ 7AEE
  52+ 7AEE E5               push hl
  53+ 7AEF D5               push de
  54+ 7AF0 2A 68 FB         ld   hl, (room_ptr)
  55+ 7AF3 11 1A 01         ld   de, OFFSET_COLORS_5_8
  56+ 7AF6 19               add  hl, de
  57+ 7AF7 E5               push hl
  58+ 7AF8 DD E1            pop  ix                ; Reset color pointer to ROM offset for enemies 5-8
  59+ 7AFA D1               pop  de
  60+ 7AFB E1               pop  hl
  61+ 7AFC              .no_color_reset:
  62+ 7AFC
  63+ 7AFC                  ; Leggi il colore per questo nemico dal puntatore IX e salvalo sullo stack
  64+ 7AFC DD 7E 00         ld   a, (ix+0)
  65+ 7AFF DD 23            inc  ix
  66+ 7B01 F5               push af                ; Salva colore sullo stack
  67+ 7B02
  68+ 7B02                  ; 1. Copia Flags (Byte 0), Type (Byte 1), StartX (Byte 2), StartY (Byte 3)
  69+ 7B02 7E               ld   a, (hl)           ; A = Flags
  70+ 7B03 CB 7F            bit  7, a              ; Il nemico è attivo?
  71+ 7B05 28 26            jr   z, .store_enemy_flags ; Se non è attivo, memorizza 0
  72+ 7B07
  73+ 7B07                  ; Controlla se siamo nella stanza Master Bedroom
  74+ 7B07 E5               push hl
  75+ 7B08 C5               push bc
  76+ 7B09 2A 68 FB         ld   hl, (room_ptr)
  77+ 7B0C 01 DC B5         ld   bc, MastreBedRoomLayout
  78+ 7B0F B7               or   a
  79+ 7B10 ED 42            sbc  hl, bc
  80+ 7B12 C1               pop  bc
  81+ 7B13 E1               pop  hl
  82+ 7B14 20 17            jr   nz, .store_enemy_flags ; Non è Master Bedroom
  83+ 7B16
  84+ 7B16                  ; Siamo nella Master Bedroom: controlla se il tipo di nemico (Byte 1) è VECCHIA
  85+ 7B16 23               inc  hl
  86+ 7B17 7E               ld   a, (hl)           ; A = Type
  87+ 7B18 2B               dec  hl
  88+ 7B19 FE 22            cp   VECCHIA
  89+ 7B1B 20 10            jr   nz, .store_enemy_flags ; Non è VECCHIA
  90+ 7B1D
  91+ 7B1D                  ; È la Vecchia nella Master Bedroom! Controlla se tutti gli item sono stati raccolti
  92+ 7B1D 3A FA FB         ld   a, (game_objective_completed)
  93+ 7B20 B7               or   a
  94+ 7B21 20 07            jr   nz, .disable_master_bedroom_vecchia
  95+ 7B23 3A F2 F7         ld   a, (items_collected)
  96+ 7B26 FE 4D            cp   TOTAL_ITEMS
  97+ 7B28 38 03            jr   c, .store_enemy_flags ; Meno di TOTAL_ITEMS -> mantieni attiva
  98+ 7B2A
  99+ 7B2A              .disable_master_bedroom_vecchia:
 100+ 7B2A AF               xor  a                 ; Flags = 0 (disattiva il guardiano)
 101+ 7B2B 18 01            jr   .store_enemy_flags_val
 102+ 7B2D
 103+ 7B2D              .store_enemy_flags:
 104+ 7B2D 7E               ld   a, (hl)           ; Ricarica Flags originali da ROM
