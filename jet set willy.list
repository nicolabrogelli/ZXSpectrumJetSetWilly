1252+ 836D
1253+ 836D 19               add  hl, de            ; Row*32 + Col
1254+ 836E
1255+ 836E 11 19 E8         ld   de, items_grid
1256+ 8371 19               add  hl, de            ; puntatore nella griglia
1257+ 8372
1258+ 8372 D1               pop  de                ; ripristina colore
1259+ 8373
1260+ 8373 73               ld   (hl), e           ; salva colore cella
1261+ 8374
1262+ 8374 E1               pop  hl
1263+ 8375
1264+ 8375                  ; ---------------------------------------------------------------
1265+ 8375                  ; Salva l'item nella cache della stanza
1266+ 8375                  ;
1267+ 8375                  ; Questo evita di dover scansionare tutta ItemsTable
1268+ 8375                  ; durante il controllo delle collisioni.
1269+ 8375                  ; ---------------------------------------------------------------
1270+ 8375
1271+ 8375 FD 71 00         ld   (iy+0), c         ; Colonna
1272+ 8378 FD 70 01         ld   (iy+1), b         ; Riga
1273+ 837B FD 73 02         ld   (iy+2), e         ; Colore
1274+ 837E
1275+ 837E                  ; Salva il puntatore al flag "collected"
