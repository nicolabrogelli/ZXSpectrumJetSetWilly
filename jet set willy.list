 155  86DD                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 156  86DD                  IF ENABLE_RAMP_DEBUG_BARS != 0
 157  86DD ~                ld   a, (willy_on_ramp)
 158  86DD ~                or   a
 159  86DD ~                jp   nz, .draw_raster_bars
 160  86DD                  ENDIF
 161  86DD
 162  86DD C3 5A 87         jp   .no_collision
 163  86E0
 164  86E0              .guardian_collision_found:
 165  86E0                  ; C'è collisione con un guardiano!
