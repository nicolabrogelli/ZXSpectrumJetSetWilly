 198+ 8853
 199+ 8853 3A 63 F4         ld   a, (room_border_color)
 200+ 8856 E6 EF            and  $ef              ; speaker OFF
 201+ 8858 D3 FE            out  ($fe), a
 202+ 885A
 203+ 885A 0E 3C            ld   c, 60
 204+ 885C              .d2:
 205+ 885C 0D               dec  c
 206+ 885D 20 FD            jr   nz, .d2
 207+ 885F
 208+ 885F 10 E6            djnz .sound_loop
 209+ 8861
 210+ 8861 D1               pop  de
 211+ 8862 C1               pop  bc
 212+ 8863 C9               ret
