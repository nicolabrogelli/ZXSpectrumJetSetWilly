 941+ 6D83 4F               ld   c, a              ; C = limit_right (exclusive)
 942+ 6D84
 943+ 6D84 7B               ld   a, e              ; A = Col
 944+ 6D85 B8               cp   b
 945+ 6D86 38 34            jr   c, .check_platform_case ; Col < ramp_col
 946+ 6D88 B9               cp   c
 947+ 6D89 30 31            jr   nc, .check_platform_case ; Col >= limit_right
