 572+ 70AB DD 46 03         ld   b, (ix+3)         ; B = Current Y
 573+ 70AE DD 7E 0A         ld   a, (ix+10)        ; A = Color (Offset 10)
 574+ 70B1 CD BE 62         call Gfx_SetEnemyColorAttributes
 575+ 70B4
