 107+ 7576              ; -------------------------------------------------------------------
 108+ 7576              ; DetermineCurrentRoomID
 109+ 7576              ;
 110+ 7576              ; Determina l'ID numerico della stanza corrente confrontando
 111+ 7576              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 112+ 7576              ;
 113+ 7576              ; Se viene trovata una corrispondenza:
 114+ 7576              ;   A = ID della stanza
 115+ 7576              ;   current_room = A
 116+ 7576              ;
 117+ 7576              ; Mappatura:
 118+ 7576              ;    0 = The Off Licence
 119+ 7576              ;    1 = The Bridge
 120+ 7576              ;    2 = Under The Mega Tree
 121+ 7576              ;    3 = Gfx_At The Foot Of The Mega Tree
 122+ 7576              ;    4 = The Drive
 123+ 7576              ;    5 = The Security Guard
 124+ 7576              ;    6 = Entrance To Hades
 125+ 7576              ;    7 = Cuckoo's Nest
 126+ 7576              ;    8 = Inside The Mega Trunk
 127+ 7576              ;    9 = On A Branch Over The Drive
 128+ 7576              ;   10 = The Front Door
 129+ 7576              ;   11 = The Hall
 130+ 7576              ;   12 = Tree Top
 131+ 7576              ;   27 = The Chapel
 132+ 7576              ;   33 = The Bathroom
 133+ 7576              ;   35 = Master Bedroom
 134+ 7576              ;
 135+ 7576              ; Se nessuna stanza corrisponde viene impostato:
 136+ 7576              ;   current_room = 0
 137+ 7576              ; -------------------------------------------------------------------
 138+ 7576              DetermineCurrentRoomID:
 139+ 7576
