 691+ 71E2              ; -------------------------------------------------------------------
 692+ 71E2              ; RestoreBackgroundCell
 693+ 71E2              ;
 694+ 71E2              ; Ripristina il contenuto originale di una cella della stanza.
 695+ 71E2              ; Viene utilizzata principalmente quando un item viene raccolto:
 696+ 71E2              ; invece di lasciare un "buco", la routine ridisegna il tile
 697+ 71E2              ; originale presente nella mappa della stanza.
 698+ 71E2              ;
 699+ 71E2              ; Input:
 700+ 71E2              ;   B = Row (3..18)
 701+ 71E2              ;   C = Col (0..31)
 702+ 71E2              ;
 703+ 71E2              ; Utilizza:
 704+ 71E2              ;   room_ptr -> struttura dati della stanza corrente
 705+ 71E2              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 706+ 71E2              ;   DrawTile -> ridisegna il tile selezionato
 707+ 71E2              ;
 708+ 71E2              ; Tipi di cella:
 709+ 71E2              ;   0 = Background
 710+ 71E2              ;   1 = Floor
 711+ 71E2              ;   2 = Wall
 712+ 71E2              ;   3 = Nasty
 713+ 71E2              ; -------------------------------------------------------------------
 714+ 71E2              RestoreBackgroundCell:
 715+ 71E2
 716+ 71E2                  ; Salva tutti i registri utilizzati
 717+ 71E2 FD E5            push iy
 718+ 71E4 C5               push bc
 719+ 71E5 D5               push de
 720+ 71E6 E5               push hl
 721+ 71E7 DD E5            push ix
 722+ 71E9
 723+ 71E9                  ; ---------------------------------------------------------------
 724+ 71E9                  ; Conserva Row e Col in IY.
 725+ 71E9                  ;
 726+ 71E9                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 727+ 71E9                  ; BC potrebbe essere modificato.
 728+ 71E9                  ; ---------------------------------------------------------------
 729+ 71E9 C5               push bc
 730+ 71EA FD E1            pop  iy                ; IYH = Row, IYL = Col
 731+ 71EC
 732+ 71EC                  ; ---------------------------------------------------------------
 733+ 71EC                  ; Determina quale tipo di cella è presente nella posizione
 734+ 71EC                  ; specificata.
 735+ 71EC                  ;
 736+ 71EC                  ; Input:
 737+ 71EC                  ;   B = Row
 738+ 71EC                  ;   C = Col
 739+ 71EC                  ;
 740+ 71EC                  ; Output:
 741+ 71EC                  ;   A = tipo cella
 742+ 71EC                  ; ---------------------------------------------------------------
 743+ 71EC 78               ld   a, b
 744+ 71ED
 745+ 71ED CD FD 6A         call GetCellFromUnpacked
 746+ 71F0
 747+ 71F0                  ; ---------------------------------------------------------------
 748+ 71F0                  ; Recupera il puntatore alla stanza corrente.
 749+ 71F0                  ;
 750+ 71F0                  ; DE = base della struttura stanza
 751+ 71F0                  ; ---------------------------------------------------------------
 752+ 71F0 ED 5B 76 76      ld   de, (room_ptr)
 753+ 71F4
 754+ 71F4                  ; ---------------------------------------------------------------
 755+ 71F4                  ; Seleziona il tile corretto in base al tipo di cella.
 756+ 71F4                  ;
 757+ 71F4                  ; A = 0 -> Background
 758+ 71F4                  ; A = 1 -> Floor
 759+ 71F4                  ; A = 2 -> Wall
 760+ 71F4                  ; A = 3 -> Nasty
 761+ 71F4                  ; ---------------------------------------------------------------
 762+ 71F4
 763+ 71F4 B7               or   a
 764+ 71F5 20 06            jr   nz, .not_bg
 765+ 71F7
 766+ 71F7                  ; Background
 767+ 71F7 21 A0 00         ld   hl, OFFSET_BG
 768+ 71FA 19               add  hl, de
 769+ 71FB 18 16            jr   .draw_cell
 770+ 71FD
 771+ 71FD              .not_bg:
 772+ 71FD
 773+ 71FD 3D               dec  a
 774+ 71FE 20 06            jr   nz, .not_floor
 775+ 7200
 776+ 7200                  ; Floor
 777+ 7200 21 A9 00         ld   hl, OFFSET_FLOOR
 778+ 7203 19               add  hl, de
 779+ 7204 18 0D            jr   .draw_cell
 780+ 7206
 781+ 7206              .not_floor:
 782+ 7206
 783+ 7206 3D               dec  a
 784+ 7207 20 06            jr   nz, .not_wall
 785+ 7209
 786+ 7209                  ; Wall
 787+ 7209 21 B2 00         ld   hl, OFFSET_WALL
 788+ 720C 19               add  hl, de
 789+ 720D 18 04            jr   .draw_cell
 790+ 720F
 791+ 720F              .not_wall:
 792+ 720F
 793+ 720F                  ; Nasty
 794+ 720F 21 BB 00         ld   hl, OFFSET_NASTY
 795+ 7212 19               add  hl, de
 796+ 7213
 797+ 7213              .draw_cell:
 798+ 7213
 799+ 7213                  ; ---------------------------------------------------------------
 800+ 7213                  ; HL punta ora alla grafica del tile da ridisegnare.
 801+ 7213                  ;
 802+ 7213                  ; DrawTile si aspetta:
 803+ 7213                  ;   IX = puntatore tile
 804+ 7213                  ;   B  = Row
 805+ 7213                  ;   C  = Col
 806+ 7213                  ; ---------------------------------------------------------------
 807+ 7213 E5               push hl
 808+ 7214 DD E1            pop  ix
 809+ 7216
 810+ 7216                  ; Ripristina Row e Col salvati in IY
 811+ 7216 FD E5            push iy
 812+ 7218 C1               pop  bc
 813+ 7219
 814+ 7219                  ; Disegna il tile originale
 815+ 7219 CD 8C 61         call DrawTile
 816+ 721C
 817+ 721C                  ; ---------------------------------------------------------------
 818+ 721C                  ; Ripristina i registri salvati
 819+ 721C                  ; ---------------------------------------------------------------
 820+ 721C DD E1            pop  ix
 821+ 721E E1               pop  hl
 822+ 721F D1               pop  de
 823+ 7220 C1               pop  bc
 824+ 7221 FD E1            pop  iy
 825+ 7223
 826+ 7223 C9               ret
 827+ 7224
 828+ 7224              ; -------------------------------------------------------------------
 829+ 7224              ; CheckWillyItemCollision
 830+ 7224              ;
 831+ 7224              ; Verifica se Willy collide con un item utilizzando il controllo
 832+ 7224              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 833+ 7224              ;
 834+ 7224              ; Input:
 835+ 7224              ;   A = ItemX (colonna attributi 0..31)
 836+ 7224              ;   H = ItemY (riga attributi 3..18)
 837+ 7224              ;
 838+ 7224              ; Coordinate item:
 839+ 7224              ;   Ogni item occupa una cella da 8x8 pixel.
 840+ 7224              ;
 841+ 7224              ; Coordinate Willy:
 842+ 7224              ;   Willy occupa un rettangolo di 16x16 pixel.
 843+ 7224              ;
 844+ 7224              ; Output:
 845+ 7224              ;   Carry Set   = collisione rilevata
 846+ 7224              ;   Carry Clear = nessuna collisione
 847+ 7224              ;
 848+ 7224              ; Registri preservati:
 849+ 7224              ;   BC, DE, HL
 850+ 7224              ; -------------------------------------------------------------------
 851+ 7224              CheckWillyItemCollision:
 852+ 7224
 853+ 7224                  ; Salva i registri utilizzati
 854+ 7224 C5               push bc
 855+ 7225 D5               push de
 856+ 7226 E5               push hl
 857+ 7227
 858+ 7227                  ; ---------------------------------------------------------------
 859+ 7227                  ; Calcola il bounding box orizzontale dell'item
 860+ 7227                  ;
 861+ 7227                  ; ItemLeft  = ItemX * 8
 862+ 7227                  ; ItemRight = ItemLeft + 7
 863+ 7227                  ;
 864+ 7227                  ; E = ItemLeft
 865+ 7227                  ; D = ItemRight
 866+ 7227                  ; ---------------------------------------------------------------
 867+ 7227 6F               ld   l, a              ; L = ItemX
 868+ 7228
 869+ 7228 7D               ld   a, l
 870+ 7229 87               add  a, a              ; *2
 871+ 722A 87               add  a, a              ; *4
 872+ 722B 87               add  a, a              ; *8
 873+ 722C
 874+ 722C 5F               ld   e, a              ; E = ItemLeft
 875+ 722D
 876+ 722D C6 07            add  a, 7
 877+ 722F 57               ld   d, a              ; D = ItemRight
 878+ 7230
 879+ 7230                  ; ---------------------------------------------------------------
 880+ 7230                  ; Recupera la posizione corrente di Willy
 881+ 7230                  ;
 882+ 7230                  ; B = WillyY
 883+ 7230                  ; C = WillyX
 884+ 7230                  ; ---------------------------------------------------------------
 885+ 7230 ED 4B 05 73      ld   bc, (PlayerPos)
 886+ 7234
 887+ 7234                  ; ---------------------------------------------------------------
 888+ 7234                  ; Primo test:
 889+ 7234                  ;
 890+ 7234                  ; WillyLeft <= ItemRight
 891+ 7234                  ;
 892+ 7234                  ; Se Willy è completamente a destra dell'item
 893+ 7234                  ; non può esserci collisione.
 894+ 7234                  ; ---------------------------------------------------------------
 895+ 7234 79               ld   a, c              ; A = WillyLeft
 896+ 7235
 897+ 7235 BA               cp   d                 ; WillyLeft vs ItemRight
 898+ 7236
 899+ 7236 28 04            jr   z, .x_ok
 900+ 7238 38 02            jr   c, .x_ok
 901+ 723A
 902+ 723A 18 29            jr   .no_collision
 903+ 723C
 904+ 723C              .x_ok:
 905+ 723C
 906+ 723C                  ; ---------------------------------------------------------------
 907+ 723C                  ; Secondo test:
 908+ 723C                  ;
 909+ 723C                  ; WillyRight >= ItemLeft
 910+ 723C                  ;
 911+ 723C                  ; WillyRight = WillyX + 7
 912+ 723C                  ; ---------------------------------------------------------------
 913+ 723C C6 07            add  a, 7
 914+ 723E
 915+ 723E BB               cp   e                 ; WillyRight vs ItemLeft
 916+ 723F
 917+ 723F 28 04            jr   z, .y_check
 918+ 7241 30 02            jr   nc, .y_check
 919+ 7243
 920+ 7243 18 20            jr   .no_collision
 921+ 7245
 922+ 7245              .y_check:
 923+ 7245
 924+ 7245                  ; ---------------------------------------------------------------
 925+ 7245                  ; Recupera ItemY dal valore originale di HL
 926+ 7245                  ;
 927+ 7245                  ; H contiene la riga dell'item.
 928+ 7245                  ; ---------------------------------------------------------------
 929+ 7245 E1               pop  hl
 930+ 7246 E5               push hl
 931+ 7247
 932+ 7247                  ; ---------------------------------------------------------------
 933+ 7247                  ; Calcola il bounding box verticale dell'item
 934+ 7247                  ;
 935+ 7247                  ; ItemTop    = ItemY * 8
 936+ 7247                  ; ItemBottom = ItemTop + 7
 937+ 7247                  ;
 938+ 7247                  ; E = ItemTop
 939+ 7247                  ; D = ItemBottom
 940+ 7247                  ; ---------------------------------------------------------------
 941+ 7247 7C               ld   a, h
 942+ 7248
 943+ 7248 87               add  a, a              ; *2
 944+ 7249 87               add  a, a              ; *4
 945+ 724A 87               add  a, a              ; *8
 946+ 724B
 947+ 724B 5F               ld   e, a              ; ItemTop
 948+ 724C
 949+ 724C C6 07            add  a, 7
 950+ 724E 57               ld   d, a              ; ItemBottom
 951+ 724F
 952+ 724F                  ; ---------------------------------------------------------------
 953+ 724F                  ; Primo test verticale:
 954+ 724F                  ;
 955+ 724F                  ; WillyTop <= ItemBottom
 956+ 724F                  ; ---------------------------------------------------------------
 957+ 724F 78               ld   a, b              ; WillyTop
 958+ 7250
 959+ 7250 BA               cp   d
 960+ 7251
 961+ 7251 28 04            jr   z, .y_ok
 962+ 7253 38 02            jr   c, .y_ok
 963+ 7255
 964+ 7255 18 0E            jr   .no_collision
 965+ 7257
 966+ 7257              .y_ok:
 967+ 7257
 968+ 7257                  ; ---------------------------------------------------------------
 969+ 7257                  ; Secondo test verticale:
 970+ 7257                  ;
 971+ 7257                  ; WillyBottom >= ItemTop
 972+ 7257                  ;
 973+ 7257                  ; WillyBottom = WillyY + 15
 974+ 7257                  ; ---------------------------------------------------------------
 975+ 7257 C6 0F            add  a, 15
 976+ 7259
 977+ 7259 BB               cp   e
 978+ 725A
 979+ 725A 28 04            jr   z, .collision
 980+ 725C 30 02            jr   nc, .collision
 981+ 725E
 982+ 725E 18 05            jr   .no_collision
 983+ 7260
 984+ 7260              .collision:
 985+ 7260
 986+ 7260                  ; ---------------------------------------------------------------
 987+ 7260                  ; Collisione rilevata
 988+ 7260                  ; ---------------------------------------------------------------
 989+ 7260 E1               pop  hl
 990+ 7261 D1               pop  de
 991+ 7262 C1               pop  bc
 992+ 7263
 993+ 7263 37               scf                    ; Carry = 1
 994+ 7264
 995+ 7264 C9               ret
 996+ 7265
 997+ 7265              .no_collision:
 998+ 7265
 999+ 7265                  ; ---------------------------------------------------------------
1000+ 7265                  ; Nessuna collisione
1001+ 7265                  ; ---------------------------------------------------------------
1002+ 7265 E1               pop  hl
1003+ 7266 D1               pop  de
1004+ 7267 C1               pop  bc
1005+ 7268
1006+ 7268 B7               or   a                 ; Carry = 0
1007+ 7269
1008+ 7269 C9               ret
1009+ 726A
1010+ 726A              ; -------------------------------------------------------------------
1011+ 726A              ; CheckRoomItemsCollision
1012+ 726A              ;
1013+ 726A              ; Controlla se Willy entra in collisione con uno degli item
1014+ 726A              ; attivi presenti nella stanza corrente.
1015+ 726A              ;
1016+ 726A              ; Per ogni item:
1017+ 726A              ;   - verifica che appartenga alla stanza corrente
1018+ 726A              ;   - verifica che non sia già stato raccolto
1019+ 726A              ;   - esegue il test di collisione con Willy
1020+ 726A              ;
1021+ 726A              ; Se l'item viene raccolto:
1022+ 726A              ;   - imposta il flag "collected"
1023+ 726A              ;   - rimuove l'item dalla cache items_grid
1024+ 726A              ;   - incrementa il contatore degli oggetti raccolti
1025+ 726A              ;   - aggiorna l'HUD
1026+ 726A              ;   - ripristina il tile di sfondo
1027+ 726A              ;   - riproduce il suono di raccolta
1028+ 726A              ;
1029+ 726A              ; Formato record ItemsTable:
1030+ 726A              ;   +0 RoomID
1031+ 726A              ;   +1 X
1032+ 726A              ;   +2 Y
1033+ 726A              ;   +3 Color
1034+ 726A              ;   +4 Collected
1035+ 726A              ;
1036+ 726A              ; Fine tabella:
1037+ 726A              ;   RoomID = $FF
1038+ 726A              ; -------------------------------------------------------------------
1039+ 726A              CheckRoomItemsCollision:
1040+ 726A
1041+ 726A                  ; Salva i registri utilizzati
1042+ 726A E5               push hl
1043+ 726B D5               push de
1044+ 726C C5               push bc
1045+ 726D
1046+ 726D                  ; Inizio scansione della tabella degli item
1047+ 726D 21 D1 6F         ld   hl, ItemsTable
1048+ 7270
1049+ 7270              .loop:
1050+ 7270
1051+ 7270                  ; ---------------------------------------------------------------
1052+ 7270                  ; Legge il Room ID dell'item corrente
1053+ 7270                  ; ---------------------------------------------------------------
1054+ 7270 7E               ld   a, (hl)
1055+ 7271
1056+ 7271                  ; $FF indica fine tabella
1057+ 7271 FE FF            cp   $FF
1058+ 7273 28 4D            jr   z, .done
1059+ 7275
1060+ 7275                  ; ---------------------------------------------------------------
1061+ 7275                  ; Verifica se l'item appartiene alla stanza corrente
1062+ 7275                  ; ---------------------------------------------------------------
1063+ 7275 57               ld   d, a              ; D = RoomID item
1064+ 7276
1065+ 7276 3A 1C 76         ld   a, (current_room)
1066+ 7279 BA               cp   d
1067+ 727A
1068+ 727A                  ; Se appartiene a un'altra stanza salta il record
1069+ 727A 20 3F            jr   nz, .next_item
1070+ 727C
1071+ 727C                  ; ---------------------------------------------------------------
1072+ 727C                  ; Legge coordinate e stato dell'item
1073+ 727C                  ; ---------------------------------------------------------------
1074+ 727C
1075+ 727C 23               inc  hl
1076+ 727D 4E               ld   c, (hl)           ; C = X
1077+ 727E
1078+ 727E 23               inc  hl
1079+ 727F 46               ld   b, (hl)           ; B = Y
1080+ 7280
1081+ 7280 23               inc  hl                ; salta Color
1082+ 7281
1083+ 7281 23               inc  hl                ; punta a Collected
1084+ 7282
1085+ 7282 7E               ld   a, (hl)
1086+ 7283
1087+ 7283                  ; ---------------------------------------------------------------
1088+ 7283                  ; Item già raccolto?
1089+ 7283                  ; ---------------------------------------------------------------
1090+ 7283 B7               or   a
1091+ 7284 20 39            jr   nz, .next_no_inc
1092+ 7286
1093+ 7286                  ; ---------------------------------------------------------------
1094+ 7286                  ; Test collisione Willy ↔ Item
1095+ 7286                  ;
1096+ 7286                  ; Input richiesto:
1097+ 7286                  ;   A = ItemX
1098+ 7286                  ;   H = ItemY
1099+ 7286                  ; ---------------------------------------------------------------
1100+ 7286 79               ld   a, c
1101+ 7287
1102+ 7287 E5               push hl                ; salva puntatore al flag Collected
1103+ 7288
1104+ 7288 60               ld   h, b
1105+ 7289
1106+ 7289 CD 24 72         call CheckWillyItemCollision
1107+ 728C
1108+ 728C E1               pop  hl
1109+ 728D
1110+ 728D                  ; Nessuna collisione
1111+ 728D 30 30            jr   nc, .next_no_inc
1112+ 728F
1113+ 728F                  ; ===============================================================
1114+ 728F                  ; ITEM RACCOLTO
1115+ 728F                  ; ===============================================================
1116+ 728F
1117+ 728F                  ; ---------------------------------------------------------------
1118+ 728F                  ; Marca l'item come raccolto
1119+ 728F                  ; ---------------------------------------------------------------
1120+ 728F 36 01            ld   (hl), 1
1121+ 7291
1122+ 7291                  ; ---------------------------------------------------------------
1123+ 7291                  ; Rimuove l'item dalla cache items_grid
1124+ 7291                  ;
1125+ 7291                  ; Calcolo:
1126+ 7291                  ;   offset = Row * 32 + Col
1127+ 7291                  ; ---------------------------------------------------------------
1128+ 7291 E5               push hl
1129+ 7292 D5               push de
1130+ 7293
1131+ 7293 26 00            ld   h, 0
1132+ 7295 68               ld   l, b              ; HL = Row
1133+ 7296
1134+ 7296 29               add  hl, hl            ; *2
1135+ 7297 29               add  hl, hl            ; *4
1136+ 7298 29               add  hl, hl            ; *8
1137+ 7299 29               add  hl, hl            ; *16
1138+ 729A 29               add  hl, hl            ; *32
1139+ 729B
1140+ 729B 59               ld   e, c
1141+ 729C 16 00            ld   d, 0
1142+ 729E
1143+ 729E 19               add  hl, de            ; Row*32 + Col
1144+ 729F
1145+ 729F 11 00 90         ld   de, items_grid
1146+ 72A2 19               add  hl, de
1147+ 72A3
1148+ 72A3                  ; La cella non contiene più un item
1149+ 72A3 36 00            ld   (hl), 0
1150+ 72A5
1151+ 72A5 D1               pop  de
1152+ 72A6 E1               pop  hl
1153+ 72A7
1154+ 72A7                  ; ---------------------------------------------------------------
1155+ 72A7                  ; Conserva il puntatore all'entry corrente
1156+ 72A7                  ; poiché le routine successive possono alterare HL.
1157+ 72A7                  ; ---------------------------------------------------------------
1158+ 72A7 E5               push hl
1159+ 72A8
1160+ 72A8                  ; ---------------------------------------------------------------
1161+ 72A8                  ; Aggiorna il numero di oggetti raccolti
1162+ 72A8                  ; ---------------------------------------------------------------
1163+ 72A8 3A 0F 73         ld   a, (items_collected)
1164+ 72AB
1165+ 72AB 3C               inc  a
1166+ 72AC
1167+ 72AC 32 0F 73         ld   (items_collected), a
1168+ 72AF
1169+ 72AF                  ; ---------------------------------------------------------------
1170+ 72AF                  ; Aggiorna il contatore visualizzato a schermo
1171+ 72AF                  ; ---------------------------------------------------------------
1172+ 72AF CD CB 60         call UpdateItemsCollectedDisplay
1173+ 72B2
1174+ 72B2                  ; ---------------------------------------------------------------
1175+ 72B2                  ; Ripristina il tile originale della stanza
1176+ 72B2                  ; eliminando la grafica dell'item.
1177+ 72B2                  ;
1178+ 72B2                  ; Input:
1179+ 72B2                  ;   B = Row
1180+ 72B2                  ;   C = Col
1181+ 72B2                  ; ---------------------------------------------------------------
1182+ 72B2 CD E2 71         call RestoreBackgroundCell
1183+ 72B5
1184+ 72B5                  ; ---------------------------------------------------------------
1185+ 72B5                  ; Riproduce il suono di raccolta
1186+ 72B5                  ; ---------------------------------------------------------------
1187+ 72B5 CD C6 72         call PlayCollectSound
1188+ 72B8
1189+ 72B8                  ; Ripristina il puntatore alla tabella
1190+ 72B8 E1               pop  hl
1191+ 72B9
1192+ 72B9                  ; Continua con il record successivo
1193+ 72B9 18 04            jr   .next_no_inc
1194+ 72BB
1195+ 72BB              .next_item:
1196+ 72BB
1197+ 72BB                  ; ---------------------------------------------------------------
1198+ 72BB                  ; Salta i campi del record:
1199+ 72BB                  ;   X
1200+ 72BB                  ;   Y
1201+ 72BB                  ;   Color
1202+ 72BB                  ;   Collected
1203+ 72BB                  ; ---------------------------------------------------------------
1204+ 72BB 23               inc  hl
1205+ 72BC 23               inc  hl
1206+ 72BD 23               inc  hl
1207+ 72BE 23               inc  hl
1208+ 72BF
1209+ 72BF              .next_no_inc:
1210+ 72BF
1211+ 72BF                  ; ---------------------------------------------------------------
1212+ 72BF                  ; Avanza al record successivo.
1213+ 72BF                  ;
1214+ 72BF                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1215+ 72BF                  ; ---------------------------------------------------------------
1216+ 72BF 23               inc  hl
1217+ 72C0
1218+ 72C0 18 AE            jr   .loop
1219+ 72C2
1220+ 72C2              .done:
1221+ 72C2
1222+ 72C2                  ; Ripristina i registri
1223+ 72C2 C1               pop  bc
1224+ 72C3 D1               pop  de
1225+ 72C4 E1               pop  hl
1226+ 72C5
1227+ 72C5 C9               ret
1228+ 72C6
1229+ 72C6              ; -------------------------------------------------------------------
1230+ 72C6              ; PlayCollectSound
1231+ 72C6              ;
1232+ 72C6              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1233+ 72C6              ; dello ZX Spectrum utilizzando il port $FE.
1234+ 72C6              ;
1235+ 72C6              ; Il suono viene prodotto alternando ON/OFF del bit 4
1236+ 72C6              ; (speaker) con un semplice delay software.
1237+ 72C6              ;
1238+ 72C6              ; Effetto risultante:
1239+ 72C6              ;   beep breve tipo "pickup item"
1240+ 72C6              ; -------------------------------------------------------------------
1241+ 72C6              PlayCollectSound:
1242+ 72C6
1243+ 72C6                  ; Salva registri utilizzati
1244+ 72C6 C5               push bc
1245+ 72C7 D5               push de
1246+ 72C8
1247+ 72C8                  ; ---------------------------------------------------------------
1248+ 72C8                  ; Numero di cicli del beep (durata complessiva del suono)
1249+ 72C8                  ; ---------------------------------------------------------------
1250+ 72C8 06 78            ld   b, 120
1251+ 72CA
1252+ 72CA              .sound_loop:
1253+ 72CA
1254+ 72CA                  ; ---------------------------------------------------------------
1255+ 72CA                  ; SPEAKER ON
1256+ 72CA                  ;
1257+ 72CA                  ; Legge il colore del bordo corrente e attiva il bit 4
1258+ 72CA                  ; per pilotare lo speaker.
1259+ 72CA                  ; ---------------------------------------------------------------
1260+ 72CA 3A 11 73         ld   a, (room_border_color)
1261+ 72CD F6 10            or   $10               ; bit 4 = 1 → speaker ON
1262+ 72CF
1263+ 72CF D3 FE            out  ($fe), a         ; scrive sul port ULA
1264+ 72D1
1265+ 72D1                  ; ---------------------------------------------------------------
1266+ 72D1                  ; Delay (mezzo periodo)
1267+ 72D1                  ; Loop software a consumo CPU
1268+ 72D1                  ; ---------------------------------------------------------------
1269+ 72D1 0E 3C            ld   c, 60
1270+ 72D3
1271+ 72D3              .d1:
1272+ 72D3 0D               dec  c
1273+ 72D4 20 FD            jr   nz, .d1
1274+ 72D6
1275+ 72D6                  ; ---------------------------------------------------------------
1276+ 72D6                  ; SPEAKER OFF
1277+ 72D6                  ;
1278+ 72D6                  ; Mantiene il colore del bordo ma disattiva lo speaker
1279+ 72D6                  ; ---------------------------------------------------------------
1280+ 72D6 3A 11 73         ld   a, (room_border_color)
1281+ 72D9 E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1282+ 72DB
1283+ 72DB D3 FE            out  ($fe), a
1284+ 72DD
1285+ 72DD                  ; ---------------------------------------------------------------
1286+ 72DD                  ; Secondo delay (mezzo periodo)
1287+ 72DD                  ; Completa l’onda quadra
1288+ 72DD                  ; ---------------------------------------------------------------
1289+ 72DD 0E 3C            ld   c, 60
1290+ 72DF
1291+ 72DF              .d2:
1292+ 72DF 0D               dec  c
1293+ 72E0 20 FD            jr   nz, .d2
1294+ 72E2
1295+ 72E2                  ; ---------------------------------------------------------------
1296+ 72E2                  ; Ripete fino a completare il numero di cicli
1297+ 72E2                  ; ---------------------------------------------------------------
1298+ 72E2 10 E6            djnz .sound_loop
1299+ 72E4
1300+ 72E4                  ; Ripristina registri salvati
1301+ 72E4 D1               pop  de
1302+ 72E5 C1               pop  bc
1303+ 72E6
1304+ 72E6 C9               ret
1305+ 72E7
1306+ 72E7              ; -------------------------------------------------------------------
1307+ 72E7              ; CheckActiveItemAtCell
1308+ 72E7              ;
1309+ 72E7              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1310+ 72E7              ; nella cella specificata della griglia items_grid.
1311+ 72E7              ;
1312+ 72E7              ; Questa routine usa una lookup diretta su una mappa 32x16,
1313+ 72E7              ; evitando la scansione della ItemsTable.
1314+ 72E7              ;
1315+ 72E7              ; Input:
1316+ 72E7              ;   B = Colonna (0..31)
1317+ 72E7              ;   C = Riga (0..15)
1318+ 72E7              ;
1319+ 72E7              ; Output:
1320+ 72E7              ;   Carry Set   = item presente nella cella
1321+ 72E7              ;   Carry Clear = nessun item
1322+ 72E7              ;
1323+ 72E7              ; Nota:
1324+ 72E7              ;   HL NON è restituito valido (commento originale non corretto:
1325+ 72E7              ;   la routine non punta a ItemsTable).
1326+ 72E7              ; -------------------------------------------------------------------
1327+ 72E7              CheckActiveItemAtCell:
1328+ 72E7
1329+ 72E7                  ; Salva registri usati
1330+ 72E7 D5               push de
1331+ 72E8 E5               push hl
1332+ 72E9
1333+ 72E9                  ; ---------------------------------------------------------------
1334+ 72E9                  ; Calcolo indice lineare nella griglia 32x16:
1335+ 72E9                  ;
1336+ 72E9                  ; offset = Row * 32 + Col
1337+ 72E9                  ; ---------------------------------------------------------------
1338+ 72E9 26 00            ld   h, 0
1339+ 72EB 69               ld   l, c              ; HL = Row
1340+ 72EC
1341+ 72EC 29               add  hl, hl            ; *2
1342+ 72ED 29               add  hl, hl            ; *4
1343+ 72EE 29               add  hl, hl            ; *8
1344+ 72EF 29               add  hl, hl            ; *16
1345+ 72F0 29               add  hl, hl            ; *32
1346+ 72F1
1347+ 72F1                  ; Aggiunge la colonna
1348+ 72F1 58               ld   e, b
1349+ 72F2 16 00            ld   d, 0
1350+ 72F4 19               add  hl, de            ; HL = Row*32 + Col
1351+ 72F5
1352+ 72F5                  ; ---------------------------------------------------------------
1353+ 72F5                  ; Accesso alla griglia degli item attivi
1354+ 72F5                  ; ---------------------------------------------------------------
1355+ 72F5 11 00 90         ld   de, items_grid
1356+ 72F8 19               add  hl, de            ; HL = address cella
1357+ 72F9
1358+ 72F9                  ; ---------------------------------------------------------------
1359+ 72F9                  ; Controllo presenza item
1360+ 72F9                  ;
1361+ 72F9                  ; items_grid contiene:
1362+ 72F9                  ;   0 = nessun item
1363+ 72F9                  ;   >0 = item attivo (colore o flag)
1364+ 72F9                  ; ---------------------------------------------------------------
1365+ 72F9 7E               ld   a, (hl)
1366+ 72FA B7               or   a
1367+ 72FB 28 04            jr   z, .not_active
1368+ 72FD
1369+ 72FD                  ; ---------------------------------------------------------------
1370+ 72FD                  ; Item trovato
1371+ 72FD                  ; ---------------------------------------------------------------
1372+ 72FD E1               pop  hl
1373+ 72FE D1               pop  de
1374+ 72FF
1375+ 72FF 37               scf                    ; Carry = 1
1376+ 7300 C9               ret
1377+ 7301
1378+ 7301              .not_active:
1379+ 7301
1380+ 7301                  ; ---------------------------------------------------------------
1381+ 7301                  ; Nessun item nella cella
1382+ 7301                  ; ---------------------------------------------------------------
1383+ 7301 E1               pop  hl
1384+ 7302 D1               pop  de
1385+ 7303
1386+ 7303 B7               or   a                 ; Carry = 0
1387+ 7304 C9               ret
1388+ 7305
