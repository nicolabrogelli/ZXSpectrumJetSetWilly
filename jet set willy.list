 187+ 6B5A
 188+ 6B5A              .falling_checks:
 189+ 6B5A                  ; --- CONTROLLO COLLISIONE CON IL TERRENO DURANTE LA CADUTA ---
 190+ 6B5A 78               ld   a, b
 191+ 6B5B C6 10            add  a, 16
 192+ 6B5D 47               ld   b, a              ; B = Nuovo Y + 16
 193+ 6B5E
 194+ 6B5E                  ; Controlla se il piede sinistro tocca solido
 195+ 6B5E CD 92 6A         call CheckSolidCell
 196+ 6B61 38 0B            jr   c, .check_landing
