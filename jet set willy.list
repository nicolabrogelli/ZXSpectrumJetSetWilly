 589+ 6048 21 45 DE         ld   hl, MaialeSpriteRight
 590+ 604B
 591+ 604B              .calc_maiale_frame:
 592+ 604B 3A 4B F4         ld   a, (body_state)   ; 0, 1, 2
 593+ 604E E6 03            and  3
 594+ 6050 87               add  a, a              ; *2
 595+ 6051 87               add  a, a              ; *4
 596+ 6052 87               add  a, a              ; *8
 597+ 6053 87               add  a, a              ; *16
 598+ 6054 87               add  a, a              ; *32
 599+ 6055 5F               ld   e, a
 600+ 6056 16 00            ld   d, 0
 601+ 6058 19               add  hl, de            ; HL = frame pointer (32 byte per frame 16x16)
 602+ 6059 E5               push hl
 603+ 605A DD E1            pop  ix                ; IX = frame pointer
 604+ 605C
