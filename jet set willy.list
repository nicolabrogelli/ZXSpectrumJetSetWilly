1816+ 7729              ; Carica le impostazioni di salto e gravità specifiche per la stanza corrente
1817+ 7729              ; Legge il byte di configurazione ad offset OFFSET_PHYSICS_SETTINGS (239).
1818+ 7729              ; Se è 0, applica le impostazioni di default (Jump = 6, Gravity = 1).
1819+ 7729              ; Altrimenti, decodifica il formato %GGGGJJJJ (Jump = JJJJ, Gravity Preset = GGGG).
1820+ 7729              ; -------------------------------------------------------------------
1821+ 7729              Phys_LoadRoomSettings:
1822+ 7729 E5               push hl
1823+ 772A D5               push de
1824+ 772B F5               push af
1825+ 772C
1826+ 772C 2A 99 ED         ld   hl, (room_ptr)
1827+ 772F 11 EF 00         ld   de, OFFSET_PHYSICS_SETTINGS
1828+ 7732 19               add  hl, de
1829+ 7733 7E               ld   a, (hl)
1830+ 7734 B7               or   a
1831+ 7735 20 0C            jr   nz, .custom_settings
1832+ 7737
1833+ 7737 3E 06            ld   a, DEFAULT_JUMP_STRENGTH
1834+ 7739 32 38 EA         ld   (room_jump_strength), a
1835+ 773C 3E 01            ld   a, DEFAULT_GRAVITY_PRESET
1836+ 773E 32 39 EA         ld   (room_gravity_preset), a
1837+ 7741 18 12            jr   .done
1838+ 7743
1839+ 7743              .custom_settings:
