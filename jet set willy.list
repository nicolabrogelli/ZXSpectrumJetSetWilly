 361+ 75C4              ; -------------------------------------------------------------------
 362+ 75C4              ; Controlla se Willy collide con un item (pixel-level check)
 363+ 75C4              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 364+ 75C4              ; Output: Carry set se collide, altrimenti clear
 365+ 75C4              ; -------------------------------------------------------------------
 366+ 75C4              CheckWillyItemCollision:
 367+ 75C4 C5               push bc
 368+ 75C5 D5               push de
 369+ 75C6 E5               push hl
 370+ 75C7
 371+ 75C7                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 372+ 75C7 6F               ld   l, a
 373+ 75C8 7D               ld   a, l
 374+ 75C9 87               add  a, a              ; *2
 375+ 75CA 87               add  a, a              ; *4
 376+ 75CB 87               add  a, a              ; *8
 377+ 75CC 5F               ld   e, a              ; E = ItemLeft
 378+ 75CD C6 07            add  a, 7
 379+ 75CF 57               ld   d, a              ; D = ItemRight
 380+ 75D0
 381+ 75D0                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 382+ 75D0 ED 4B 09 77      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 383+ 75D4
 384+ 75D4                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 385+ 75D4 79               ld   a, c
 386+ 75D5 BA               cp   d
 387+ 75D6 28 04            jr   z, .x_ok
 388+ 75D8 38 02            jr   c, .x_ok
 389+ 75DA 18 29            jr   .no_collision
 390+ 75DC              .x_ok:
 391+ 75DC C6 0F            add  a, 15
 392+ 75DE BB               cp   e
 393+ 75DF 28 04            jr   z, .y_check
 394+ 75E1 30 02            jr   nc, .y_check
 395+ 75E3 18 20            jr   .no_collision
 396+ 75E5
 397+ 75E5              .y_check:
 398+ 75E5 E1               pop  hl                ; Recupera HL originale (H = ItemY)
 399+ 75E6 E5               push hl
 400+ 75E7 7C               ld   a, h
 401+ 75E8 87               add  a, a              ; *2
 402+ 75E9 87               add  a, a              ; *4
 403+ 75EA 87               add  a, a              ; *8
 404+ 75EB 5F               ld   e, a              ; E = ItemTop
 405+ 75EC C6 07            add  a, 7
 406+ 75EE 57               ld   d, a              ; D = ItemBottom
 407+ 75EF
 408+ 75EF                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 409+ 75EF 78               ld   a, b
 410+ 75F0 BA               cp   d
 411+ 75F1 28 04            jr   z, .y_ok
 412+ 75F3 38 02            jr   c, .y_ok
 413+ 75F5 18 0E            jr   .no_collision
 414+ 75F7              .y_ok:
 415+ 75F7 C6 0F            add  a, 15
 416+ 75F9 BB               cp   e
 417+ 75FA 28 04            jr   z, .collision
 418+ 75FC 30 02            jr   nc, .collision
 419+ 75FE 18 05            jr   .no_collision
 420+ 7600
 421+ 7600              .collision:
 422+ 7600 E1               pop  hl
 423+ 7601 D1               pop  de
 424+ 7602 C1               pop  bc
 425+ 7603 37               scf                    ; Set carry (collisione!)
 426+ 7604 C9               ret
 427+ 7605
 428+ 7605              .no_collision:
 429+ 7605 E1               pop  hl
 430+ 7606 D1               pop  de
 431+ 7607 C1               pop  bc
