 438+ 7264
 439+ 7264              ; -------------------------------------------------------------------
 440+ 7264              ; Items_DrawRoom
 441+ 7264              ;
 442+ 7264              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 443+ 7264              ;
 444+ 7264              ; Operazioni eseguite:
 445+ 7264              ;   1. Azzera la griglia items_grid.
 446+ 7264              ;   2. Svuota la cache degli oggetti attivi.
 447+ 7264              ;   3. Scansiona ItemsTable.
 448+ 7264              ;   4. Per ogni item della stanza corrente:
 449+ 7264              ;        - verifica se è già stato raccolto
 450+ 7264              ;        - disegna la grafica
 451+ 7264              ;        - aggiorna items_grid
 452+ 7264              ;        - memorizza l'item nella cache current_room_items
 453+ 7264              ;   5. Aggiorna num_room_items.
 454+ 7264              ;
 455+ 7264              ; Record ItemsTable:
 456+ 7264              ;   +0  Room ID
 457+ 7264              ;   +1  X (colonna)
 458+ 7264              ;   +2  Y (riga)
 459+ 7264              ;   +3  Colore
 460+ 7264              ;   +4  Collected flag
 461+ 7264              ;
 462+ 7264              ; Cache current_room_items:
 463+ 7264              ;   +0  Colonna
 464+ 7264              ;   +1  Riga
 465+ 7264              ;   +2  Colore
 466+ 7264              ;   +3  Collected flag ptr (Low)
 467+ 7264              ;   +4  Collected flag ptr (High)
 468+ 7264              ;
 469+ 7264              ; Ogni record cache occupa 5 byte.
 470+ 7264              ; -------------------------------------------------------------------
 471+ 7264              Items_DrawRoom:
 472+ 7264
 473+ 7264                  ; Salva tutti i registri utilizzati
 474+ 7264 E5               push hl
 475+ 7265 D5               push de
 476+ 7266 C5               push bc
 477+ 7267 DD E5            push ix
 478+ 7269 FD E5            push iy
 479+ 726B
 480+ 726B                  ; ---------------------------------------------------------------
 481+ 726B                  ; Azzera items_grid (32 x 16 = 512 byte)
 482+ 726B                  ; ---------------------------------------------------------------
 483+ 726B 21 00 B0         ld   hl, items_grid
 484+ 726E 11 01 B0         ld   de, items_grid + 1
 485+ 7271 36 00            ld   (hl), 0
 486+ 7273 01 FF 01         ld   bc, 511
 487+ 7276 ED B0            ldir
 488+ 7278
 489+ 7278                  ; ---------------------------------------------------------------
 490+ 7278                  ; Nessun item attivo nella stanza
 491+ 7278                  ; ---------------------------------------------------------------
 492+ 7278 AF               xor  a
 493+ 7279 32 B5 78         ld   (num_room_items), a
 494+ 727C
 495+ 727C                  ; IY punta alla cache degli item attivi
 496+ 727C FD 21 65 78      ld   iy, current_room_items
 497+ 7280
 498+ 7280                  ; ---------------------------------------------------------------
 499+ 7280                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 500+ 7280                  ; alla stanza corrente.
 501+ 7280                  ;
 502+ 7280                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 503+ 7280                  ; ---------------------------------------------------------------
 504+ 7280 2A B6 78         ld   hl, (room_ptr)
 505+ 7283 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 506+ 7286 19               add  hl, de
 507+ 7287
 508+ 7287 E5               push hl
 509+ 7288 DD E1            pop  ix                ; IX = bitmap item
 510+ 728A
 511+ 728A                  ; ---------------------------------------------------------------
 512+ 728A                  ; Inizio scansione della tabella degli item
 513+ 728A                  ; ---------------------------------------------------------------
 514+ 728A 21 8A 70         ld   hl, ItemsTable
 515+ 728D
 516+ 728D              .loop:
 517+ 728D
 518+ 728D                  ; ---------------------------------------------------------------
 519+ 728D                  ; Legge il Room ID del record corrente
 520+ 728D                  ; ---------------------------------------------------------------
 521+ 728D 7E               ld   a, (hl)
 522+ 728E
 523+ 728E                  ; $FF indica fine tabella
 524+ 728E FE FF            cp   $FF
