1212+ 84C8 B7               or   a
1213+ 84C9 20 3E            jr   nz, .next_no_inc
1214+ 84CB
1215+ 84CB                  ; ---------------------------------------------------------------
1216+ 84CB                  ; Disegna l'item sullo schermo
1217+ 84CB                  ;
1218+ 84CB                  ; B = Row
1219+ 84CB                  ; C = Column
1220+ 84CB                  ; HL = bitmap pointer
1221+ 84CB                  ; E = Color
1222+ 84CB                  ; ---------------------------------------------------------------
1223+ 84CB E5               push hl
1224+ 84CC
1225+ 84CC DD E5            push ix
