 115+ 6BEB F5               push af
 116+ 6BEC 18 04            jr   .no_block_conveyor
 117+ 6BEE              .conveyor_block_left:
 118+ 6BEE                  ; Conveyor va a destra: disabilita tasto sinistra (O / bit 1)
 119+ 6BEE 78               ld   a, b
 120+ 6BEF F6 02            or   $02                    ; Forza bit 1 (sinistra) a 1 (non premuto)
 121+ 6BF1 F5               push af
