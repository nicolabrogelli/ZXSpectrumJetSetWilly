 105+ 6AF2              ; Applica gravità e gestisce salto
 106+ 6AF2              ; -------------------------------------------------------------------
 107+ 6AF2              ApplyGravity:
 108+ 6AF2 ED 4B 52 6F      ld  bc, (PlayerPos)
 109+ 6AF6 78               ld  a, b              ; B = PlayerY (pixel)
 110+ 6AF7
 111+ 6AF7                  ; Controlla se siamo a mezz'aria (on_ground == 0)
 112+ 6AF7 3A 5F 6F         ld  a, (on_ground)
 113+ 6AFA B7               or  a
 114+ 6AFB CA 34 6B         jp  z, .in_air        ; Se siamo in volo, continua a volare
 115+ 6AFE
 116+ 6AFE                  ; Se on_ground == 1, controlliamo se siamo ancora su terreno solido
 117+ 6AFE                  ; Dobbiamo controllare i pixel direttamente sotto i piedi del player:
 118+ 6AFE                  ; (PlayerX, PlayerY + 16) e (PlayerX + 7, PlayerY + 16)
 119+ 6AFE 78               ld  a, b
 120+ 6AFF C6 10            add  a, 16
 121+ 6B01 47               ld  b, a              ; B = PlayerY + 16
 122+ 6B02
 123+ 6B02                  ; Controlla se la cella sotto il piede sinistro (PlayerX, PlayerY + 16) è solida
 124+ 6B02 CD 92 6A         call CheckSolidCell
 125+ 6B05 38 13            jr   c, .still_on_ground
 126+ 6B07
 127+ 6B07                  ; Controlla se la cella sotto il piede destro (PlayerX + 7, PlayerY + 16) è solida
 128+ 6B07 79               ld   a, c
 129+ 6B08 C6 07            add  a, 7
 130+ 6B0A 4F               ld   c, a              ; C = PlayerX + 7
 131+ 6B0B CD 92 6A         call CheckSolidCell
 132+ 6B0E 38 0A            jr   c, .still_on_ground
 133+ 6B10
 134+ 6B10                  ; Se nessuna delle due è solida, iniziamo a cadere!
 135+ 6B10 AF               xor  a
 136+ 6B11 32 5F 6F         ld   (on_ground), a
 137+ 6B14 32 5E 6F         ld   (velocity_y), a   ; Inizia la caduta con velocità 0
 138+ 6B17 C3 34 6B         jp   .in_air
 139+ 6B1A
 140+ 6B1A              .still_on_ground:
 141+ 6B1A                  ; Siamo ancora sulla piattaforma o sul pavimento
 142+ 6B1A                  ; Ripristina bc originale (PlayerPos)
 143+ 6B1A ED 4B 52 6F      ld   bc, (PlayerPos)
 144+ 6B1E
 145+ 6B1E                  ; Gestisci il salto
