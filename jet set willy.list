 179+ 7B60              ; Audio_PlayCollectSound
 180+ 7B60              ;
 181+ 7B60              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 7B60              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 7B60              ; -------------------------------------------------------------------
 184+ 7B60              Audio_PlayCollectSound:
 185+ 7B60 C5               push bc
 186+ 7B61 D5               push de
 187+ 7B62
 188+ 7B62 06 78            ld   b, 120
 189+ 7B64              .sound_loop:
 190+ 7B64 3A 8D 7B         ld   a, (room_border_color)
 191+ 7B67 F6 10            or   $10               ; speaker ON
 192+ 7B69 D3 FE            out  ($fe), a
 193+ 7B6B
 194+ 7B6B 0E 3C            ld   c, 60
 195+ 7B6D              .d1:
 196+ 7B6D 0D               dec  c
 197+ 7B6E 20 FD            jr   nz, .d1
 198+ 7B70
 199+ 7B70 3A 8D 7B         ld   a, (room_border_color)
 200+ 7B73 E6 EF            and  $ef              ; speaker OFF
 201+ 7B75 D3 FE            out  ($fe), a
 202+ 7B77
 203+ 7B77 0E 3C            ld   c, 60
 204+ 7B79              .d2:
 205+ 7B79 0D               dec  c
 206+ 7B7A 20 FD            jr   nz, .d2
 207+ 7B7C
 208+ 7B7C 10 E6            djnz .sound_loop
 209+ 7B7E
 210+ 7B7E D1               pop  de
 211+ 7B7F C1               pop  bc
 212+ 7B80 C9               ret
