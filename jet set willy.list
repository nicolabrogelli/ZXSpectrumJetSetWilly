 681+ 60B2 16 00            ld   d, 0
 682+ 60B4 59               ld   e, c              ; DE = C
 683+ 60B5 19               add  hl, de            ; HL = B * 8 + C
 684+ 60B6 ED 5B 24 7A      ld   de, (room_ptr)
 685+ 60BA 19               add  hl, de            ; HL = layout byte address
 686+ 60BB 7E               ld   a, (hl)           ; A = layout byte
 687+ 60BC 57               ld   d, a              ; D = salva il byte di layout
 688+ 60BD
 689+ 60BD 1E 04            ld   e, 4              ; 4 celle per byte
 690+ 60BF              .cell_loop:
