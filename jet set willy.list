 322+ 7103              ; -------------------------------------------------------------------
 323+ 7103              ; DrawRoomItems
 324+ 7103              ;
 325+ 7103              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 326+ 7103              ;
 327+ 7103              ; Operazioni eseguite:
 328+ 7103              ;   1. Azzera la griglia items_grid.
 329+ 7103              ;   2. Svuota la cache degli oggetti attivi.
 330+ 7103              ;   3. Scansiona ItemsTable.
 331+ 7103              ;   4. Per ogni item della stanza corrente:
 332+ 7103              ;        - verifica se è già stato raccolto
 333+ 7103              ;        - disegna la grafica
 334+ 7103              ;        - aggiorna items_grid
 335+ 7103              ;        - memorizza l'item nella cache current_room_items
 336+ 7103              ;   5. Aggiorna num_room_items.
 337+ 7103              ;
 338+ 7103              ; Record ItemsTable:
 339+ 7103              ;   +0  Room ID
 340+ 7103              ;   +1  X (colonna)
 341+ 7103              ;   +2  Y (riga)
 342+ 7103              ;   +3  Colore
 343+ 7103              ;   +4  Collected flag
 344+ 7103              ;
 345+ 7103              ; Cache current_room_items:
 346+ 7103              ;   +0  Colonna
 347+ 7103              ;   +1  Riga
 348+ 7103              ;   +2  Colore
 349+ 7103              ;   +3  Collected flag ptr (Low)
 350+ 7103              ;   +4  Collected flag ptr (High)
 351+ 7103              ;
 352+ 7103              ; Ogni record cache occupa 5 byte.
 353+ 7103              ; -------------------------------------------------------------------
 354+ 7103              DrawRoomItems:
 355+ 7103
 356+ 7103                  ; Salva tutti i registri utilizzati
 357+ 7103 E5               push hl
 358+ 7104 D5               push de
 359+ 7105 C5               push bc
 360+ 7106 DD E5            push ix
 361+ 7108 FD E5            push iy
 362+ 710A
 363+ 710A                  ; ---------------------------------------------------------------
 364+ 710A                  ; Azzera items_grid (32 x 16 = 512 byte)
 365+ 710A                  ; ---------------------------------------------------------------
 366+ 710A 21 00 90         ld   hl, items_grid
 367+ 710D 11 01 90         ld   de, items_grid + 1
 368+ 7110 36 00            ld   (hl), 0
 369+ 7112 01 FF 01         ld   bc, 511
 370+ 7115 ED B0            ldir
 371+ 7117
 372+ 7117                  ; ---------------------------------------------------------------
 373+ 7117                  ; Nessun item attivo nella stanza
 374+ 7117                  ; ---------------------------------------------------------------
 375+ 7117 AF               xor  a
 376+ 7118 32 56 76         ld   (num_room_items), a
 377+ 711B
 378+ 711B                  ; IY punta alla cache degli item attivi
 379+ 711B FD 21 06 76      ld   iy, current_room_items
 380+ 711F
 381+ 711F                  ; ---------------------------------------------------------------
 382+ 711F                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 383+ 711F                  ; alla stanza corrente.
 384+ 711F                  ;
 385+ 711F                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 386+ 711F                  ; ---------------------------------------------------------------
 387+ 711F 2A 57 76         ld   hl, (room_ptr)
 388+ 7122 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 389+ 7125 19               add  hl, de
 390+ 7126
 391+ 7126 E5               push hl
 392+ 7127 DD E1            pop  ix                ; IX = bitmap item
 393+ 7129
 394+ 7129                  ; ---------------------------------------------------------------
 395+ 7129                  ; Inizio scansione della tabella degli item
 396+ 7129                  ; ---------------------------------------------------------------
 397+ 7129 21 B3 6F         ld   hl, ItemsTable
 398+ 712C
 399+ 712C              .loop:
 400+ 712C
 401+ 712C                  ; ---------------------------------------------------------------
 402+ 712C                  ; Legge il Room ID del record corrente
 403+ 712C                  ; ---------------------------------------------------------------
 404+ 712C 7E               ld   a, (hl)
 405+ 712D
 406+ 712D                  ; $FF indica fine tabella
 407+ 712D FE FF            cp   $FF
 408+ 712F 28 53            jr   z, .done
 409+ 7131
 410+ 7131                  ; ---------------------------------------------------------------
 411+ 7131                  ; Verifica se l'item appartiene alla stanza corrente
 412+ 7131                  ; ---------------------------------------------------------------
 413+ 7131 57               ld   d, a
 414+ 7132
 415+ 7132 3A FD 75         ld   a, (current_room)
 416+ 7135 BA               cp   d
 417+ 7136 20 45            jr   nz, .next_item
 418+ 7138
 419+ 7138                  ; ---------------------------------------------------------------
 420+ 7138                  ; Legge i dati dell'item
 421+ 7138                  ; ---------------------------------------------------------------
 422+ 7138
 423+ 7138 23               inc  hl
 424+ 7139 4E               ld   c, (hl)           ; X (colonna)
 425+ 713A
 426+ 713A 23               inc  hl
 427+ 713B 46               ld   b, (hl)           ; Y (riga)
 428+ 713C
 429+ 713C 23               inc  hl
 430+ 713D 5E               ld   e, (hl)           ; Colore
 431+ 713E
 432+ 713E 23               inc  hl
 433+ 713F 7E               ld   a, (hl)           ; Collected flag
 434+ 7140
 435+ 7140                  ; Se diverso da zero l'item è già stato raccolto
 436+ 7140 B7               or   a
 437+ 7141 20 3E            jr   nz, .next_no_inc
 438+ 7143
 439+ 7143                  ; ---------------------------------------------------------------
 440+ 7143                  ; Disegna l'item sullo schermo
 441+ 7143                  ;
 442+ 7143                  ; B = Row
 443+ 7143                  ; C = Column
 444+ 7143                  ; HL = bitmap pointer
 445+ 7143                  ; E = Color
 446+ 7143                  ; ---------------------------------------------------------------
 447+ 7143 E5               push hl
 448+ 7144
 449+ 7144 DD E5            push ix
 450+ 7146 E1               pop  hl
 451+ 7147
 452+ 7147 CD 8C 71         call DrawItemGraphic
 453+ 714A
 454+ 714A E1               pop  hl                ; ritorna al flag collected
 455+ 714B
 456+ 714B                  ; ---------------------------------------------------------------
 457+ 714B                  ; Aggiorna items_grid
 458+ 714B                  ;
 459+ 714B                  ; Calcolo:
 460+ 714B                  ;   offset = Row * 32 + Col
 461+ 714B                  ; ---------------------------------------------------------------
 462+ 714B E5               push hl
 463+ 714C D5               push de
 464+ 714D
 465+ 714D 26 00            ld   h, 0
 466+ 714F 68               ld   l, b              ; HL = Row
 467+ 7150
 468+ 7150 29               add  hl, hl            ; *2
 469+ 7151 29               add  hl, hl            ; *4
 470+ 7152 29               add  hl, hl            ; *8
 471+ 7153 29               add  hl, hl            ; *16
 472+ 7154 29               add  hl, hl            ; *32
 473+ 7155
 474+ 7155 16 00            ld   d, 0
 475+ 7157 59               ld   e, c              ; DE = Col
 476+ 7158
 477+ 7158 19               add  hl, de            ; Row*32 + Col
 478+ 7159
 479+ 7159 11 00 90         ld   de, items_grid
 480+ 715C 19               add  hl, de            ; puntatore nella griglia
 481+ 715D
 482+ 715D D1               pop  de                ; ripristina colore
 483+ 715E
 484+ 715E 73               ld   (hl), e           ; salva colore cella
 485+ 715F
 486+ 715F E1               pop  hl
 487+ 7160
 488+ 7160                  ; ---------------------------------------------------------------
 489+ 7160                  ; Salva l'item nella cache della stanza
 490+ 7160                  ;
 491+ 7160                  ; Questo evita di dover scansionare tutta ItemsTable
 492+ 7160                  ; durante il controllo delle collisioni.
 493+ 7160                  ; ---------------------------------------------------------------
 494+ 7160
 495+ 7160 FD 71 00         ld   (iy+0), c         ; Colonna
 496+ 7163 FD 70 01         ld   (iy+1), b         ; Riga
 497+ 7166 FD 73 02         ld   (iy+2), e         ; Colore
 498+ 7169
 499+ 7169                  ; Salva il puntatore al flag "collected"
 500+ 7169 FD 75 03         ld   (iy+3), l         ; Low byte
 501+ 716C FD 74 04         ld   (iy+4), h         ; High byte
 502+ 716F
 503+ 716F                  ; Passa al record successivo della cache
 504+ 716F 01 05 00         ld   bc, 5
 505+ 7172 FD 09            add  iy, bc
 506+ 7174
 507+ 7174                  ; Incrementa il numero di item attivi
 508+ 7174 3A 56 76         ld   a, (num_room_items)
 509+ 7177 3C               inc  a
 510+ 7178 32 56 76         ld   (num_room_items), a
 511+ 717B
 512+ 717B 18 04            jr   .next_no_inc
 513+ 717D
 514+ 717D              .next_item:
 515+ 717D
 516+ 717D                  ; ---------------------------------------------------------------
 517+ 717D                  ; L'item non appartiene alla stanza corrente.
 518+ 717D                  ; Salta i campi del record:
 519+ 717D                  ;   X
 520+ 717D                  ;   Y
 521+ 717D                  ;   Color
 522+ 717D                  ;   Collected
 523+ 717D                  ; ---------------------------------------------------------------
 524+ 717D 23               inc  hl
 525+ 717E 23               inc  hl
 526+ 717F 23               inc  hl
 527+ 7180 23               inc  hl
 528+ 7181
 529+ 7181              .next_no_inc:
 530+ 7181
 531+ 7181                  ; ---------------------------------------------------------------
 532+ 7181                  ; Avanza al record successivo
 533+ 7181                  ; (prossimo Room ID)
 534+ 7181                  ; ---------------------------------------------------------------
 535+ 7181 23               inc  hl
 536+ 7182 18 A8            jr   .loop
 537+ 7184
 538+ 7184              .done:
 539+ 7184
 540+ 7184                  ; Ripristina i registri
 541+ 7184 FD E1            pop  iy
 542+ 7186 DD E1            pop  ix
 543+ 7188 D1               pop  de
 544+ 7189 C1               pop  bc
 545+ 718A E1               pop  hl
 546+ 718B
 547+ 718B C9               ret
 548+ 718C
 549+ 718C              ; -------------------------------------------------------------------
 550+ 718C              ; DrawItemGraphic
 551+ 718C              ;
 552+ 718C              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 553+ 718C              ; utilizzando una bitmap di 8 byte e un attributo colore.
 554+ 718C              ;
 555+ 718C              ; Input:
 556+ 718C              ;   B = Riga attributi (3..18)
 557+ 718C              ;   C = Colonna attributi (0..31)
 558+ 718C              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 559+ 718C              ;   E = Attributo colore
 560+ 718C              ;
 561+ 718C              ; Output:
 562+ 718C              ;   Nessuno
 563+ 718C              ;
 564+ 718C              ; Registri preservati:
 565+ 718C              ;   BC, DE, HL
 566+ 718C              ; -------------------------------------------------------------------
 567+ 718C              DrawItemGraphic:
 568+ 718C
 569+ 718C                  ; Salva i registri originali
 570+ 718C C5               push bc
 571+ 718D D5               push de
 572+ 718E E5               push hl
 573+ 718F
 574+ 718F                  ; ---------------------------------------------------------------
 575+ 718F                  ; Calcolo indirizzo bitmap dello Spectrum
 576+ 718F                  ;
 577+ 718F                  ; Ogni item occupa una cella attributi (8x8 pixel).
 578+ 718F                  ;
 579+ 718F                  ; Formula:
 580+ 718F                  ;   High = $40 + (Row AND $18)
 581+ 718F                  ;   Low  = (Row AND 7) * 32 + Col
 582+ 718F                  ;
 583+ 718F                  ; DE conterrà l'indirizzo della prima scanline.
 584+ 718F                  ; ---------------------------------------------------------------
 585+ 718F
 586+ 718F 78               ld   a, b
 587+ 7190 E6 18            and  $18
 588+ 7192 C6 40            add  a, $40
 589+ 7194 57               ld   d, a              ; Byte alto indirizzo video
 590+ 7195
 591+ 7195 78               ld   a, b
 592+ 7196 E6 07            and  7                 ; Riga interna al blocco da 8
 593+ 7198
 594+ 7198 87               add  a, a              ; *2
 595+ 7199 87               add  a, a              ; *4
 596+ 719A 87               add  a, a              ; *8
 597+ 719B 87               add  a, a              ; *16
 598+ 719C 87               add  a, a              ; *32
 599+ 719D
 600+ 719D 81               add  a, c              ; + colonna
 601+ 719E
 602+ 719E 5F               ld   e, a              ; Byte basso indirizzo video
 603+ 719F
 604+ 719F                  ; ---------------------------------------------------------------
 605+ 719F                  ; Disegno bitmap
 606+ 719F                  ;
 607+ 719F                  ; Copia 8 byte consecutivi nella memoria video.
 608+ 719F                  ; Ogni byte rappresenta una scanline da 8 pixel.
 609+ 719F                  ; ---------------------------------------------------------------
 610+ 719F
 611+ 719F C5               push bc                ; Conserva Row e Col
 612+ 71A0
 613+ 71A0 06 08            ld   b, 8              ; Numero scanline
 614+ 71A2
 615+ 71A2              .line_loop:
 616+ 71A2
 617+ 71A2 7E               ld   a, (hl)           ; Legge scanline bitmap
 618+ 71A3 12               ld   (de), a           ; Scrive nella memoria video
 619+ 71A4
 620+ 71A4 14               inc  d                 ; Scanline successiva
 621+ 71A5 23               inc  hl                ; Byte bitmap successivo
 622+ 71A6
 623+ 71A6 05               dec  b
 624+ 71A7 20 F9            jr   nz, .line_loop
 625+ 71A9
 626+ 71A9 C1               pop  bc                ; Ripristina Row e Col
 627+ 71AA
 628+ 71AA                  ; ---------------------------------------------------------------
 629+ 71AA                  ; Calcolo indirizzo attributo
 630+ 71AA                  ;
 631+ 71AA                  ; Formula:
 632+ 71AA                  ;   AttrAddr = $5800 + Row * 32 + Col
 633+ 71AA                  ;
 634+ 71AA                  ; HL conterrà l'indirizzo della cella attributi.
 635+ 71AA                  ; ---------------------------------------------------------------
 636+ 71AA
 637+ 71AA 26 00            ld   h, 0
 638+ 71AC 68               ld   l, b              ; HL = Row
 639+ 71AD
 640+ 71AD 29               add  hl, hl            ; *2
 641+ 71AE 29               add  hl, hl            ; *4
 642+ 71AF 29               add  hl, hl            ; *8
 643+ 71B0 29               add  hl, hl            ; *16
 644+ 71B1 29               add  hl, hl            ; *32
 645+ 71B2
 646+ 71B2 79               ld   a, c              ; A = Colonna
 647+ 71B3
 648+ 71B3 85               add  a, l
 649+ 71B4 6F               ld   l, a
 650+ 71B5
 651+ 71B5 30 01            jr   nc, .no_carry
 652+ 71B7 24               inc  h
 653+ 71B8
 654+ 71B8              .no_carry:
 655+ 71B8
 656+ 71B8                  ; HL = Row * 32 + Col
 657+ 71B8
 658+ 71B8 11 00 58         ld   de, $5800
 659+ 71BB 19               add  hl, de            ; HL = indirizzo attributi
 660+ 71BC
 661+ 71BC                  ; ---------------------------------------------------------------
 662+ 71BC                  ; Recupera il colore originale dallo stack.
 663+ 71BC                  ;
 664+ 71BC                  ; Layout stack:
 665+ 71BC                  ;   HL originale
 666+ 71BC                  ;   DE originale (E = colore)
 667+ 71BC                  ;   BC originale
 668+ 71BC                  ; ---------------------------------------------------------------
 669+ 71BC
 670+ 71BC C1               pop  bc                ; Recupera HL originale
 671+ 71BD D1               pop  de                ; Recupera DE originale
 672+ 71BE
 673+ 71BE                  ; ---------------------------------------------------------------
 674+ 71BE                  ; Scrive l'attributo colore
 675+ 71BE                  ; ---------------------------------------------------------------
 676+ 71BE
 677+ 71BE 7B               ld   a, e              ; A = colore
 678+ 71BF 77               ld   (hl), a           ; Scrive nella RAM attributi
 679+ 71C0
 680+ 71C0                  ; ---------------------------------------------------------------
 681+ 71C0                  ; Ripristina HL e BC originali
 682+ 71C0                  ; ---------------------------------------------------------------
 683+ 71C0
 684+ 71C0 C5               push bc
 685+ 71C1 E1               pop  hl                ; HL originale
 686+ 71C2
 687+ 71C2 C1               pop  bc                ; BC originale
 688+ 71C3
 689+ 71C3 C9               ret
 690+ 71C4
 691+ 71C4              ; -------------------------------------------------------------------
 692+ 71C4              ; RestoreBackgroundCell
 693+ 71C4              ;
 694+ 71C4              ; Ripristina il contenuto originale di una cella della stanza.
 695+ 71C4              ; Viene utilizzata principalmente quando un item viene raccolto:
 696+ 71C4              ; invece di lasciare un "buco", la routine ridisegna il tile
 697+ 71C4              ; originale presente nella mappa della stanza.
 698+ 71C4              ;
 699+ 71C4              ; Input:
 700+ 71C4              ;   B = Row (3..18)
 701+ 71C4              ;   C = Col (0..31)
 702+ 71C4              ;
 703+ 71C4              ; Utilizza:
 704+ 71C4              ;   room_ptr -> struttura dati della stanza corrente
 705+ 71C4              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 706+ 71C4              ;   DrawTile -> ridisegna il tile selezionato
 707+ 71C4              ;
 708+ 71C4              ; Tipi di cella:
 709+ 71C4              ;   0 = Background
 710+ 71C4              ;   1 = Floor
 711+ 71C4              ;   2 = Wall
 712+ 71C4              ;   3 = Nasty
 713+ 71C4              ; -------------------------------------------------------------------
 714+ 71C4              RestoreBackgroundCell:
 715+ 71C4
 716+ 71C4                  ; Salva tutti i registri utilizzati
 717+ 71C4 FD E5            push iy
 718+ 71C6 C5               push bc
 719+ 71C7 D5               push de
 720+ 71C8 E5               push hl
 721+ 71C9 DD E5            push ix
 722+ 71CB
 723+ 71CB                  ; ---------------------------------------------------------------
 724+ 71CB                  ; Conserva Row e Col in IY.
 725+ 71CB                  ;
 726+ 71CB                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 727+ 71CB                  ; BC potrebbe essere modificato.
 728+ 71CB                  ; ---------------------------------------------------------------
 729+ 71CB C5               push bc
 730+ 71CC FD E1            pop  iy                ; IYH = Row, IYL = Col
 731+ 71CE
 732+ 71CE                  ; ---------------------------------------------------------------
 733+ 71CE                  ; Determina quale tipo di cella è presente nella posizione
 734+ 71CE                  ; specificata.
 735+ 71CE                  ;
 736+ 71CE                  ; Input:
 737+ 71CE                  ;   B = Row
 738+ 71CE                  ;   C = Col
 739+ 71CE                  ;
 740+ 71CE                  ; Output:
 741+ 71CE                  ;   A = tipo cella
 742+ 71CE                  ; ---------------------------------------------------------------
 743+ 71CE 78               ld   a, b
 744+ 71CF
 745+ 71CF CD DF 6A         call GetCellFromUnpacked
 746+ 71D2
 747+ 71D2                  ; ---------------------------------------------------------------
 748+ 71D2                  ; Recupera il puntatore alla stanza corrente.
 749+ 71D2                  ;
 750+ 71D2                  ; DE = base della struttura stanza
 751+ 71D2                  ; ---------------------------------------------------------------
 752+ 71D2 ED 5B 57 76      ld   de, (room_ptr)
 753+ 71D6
 754+ 71D6                  ; ---------------------------------------------------------------
 755+ 71D6                  ; Seleziona il tile corretto in base al tipo di cella.
 756+ 71D6                  ;
 757+ 71D6                  ; A = 0 -> Background
 758+ 71D6                  ; A = 1 -> Floor
 759+ 71D6                  ; A = 2 -> Wall
 760+ 71D6                  ; A = 3 -> Nasty
 761+ 71D6                  ; ---------------------------------------------------------------
 762+ 71D6
 763+ 71D6 B7               or   a
 764+ 71D7 20 06            jr   nz, .not_bg
 765+ 71D9
 766+ 71D9                  ; Background
 767+ 71D9 21 A0 00         ld   hl, OFFSET_BG
 768+ 71DC 19               add  hl, de
 769+ 71DD 18 16            jr   .draw_cell
 770+ 71DF
 771+ 71DF              .not_bg:
 772+ 71DF
 773+ 71DF 3D               dec  a
 774+ 71E0 20 06            jr   nz, .not_floor
 775+ 71E2
 776+ 71E2                  ; Floor
 777+ 71E2 21 A9 00         ld   hl, OFFSET_FLOOR
 778+ 71E5 19               add  hl, de
 779+ 71E6 18 0D            jr   .draw_cell
 780+ 71E8
 781+ 71E8              .not_floor:
 782+ 71E8
 783+ 71E8 3D               dec  a
 784+ 71E9 20 06            jr   nz, .not_wall
 785+ 71EB
 786+ 71EB                  ; Wall
 787+ 71EB 21 B2 00         ld   hl, OFFSET_WALL
 788+ 71EE 19               add  hl, de
 789+ 71EF 18 04            jr   .draw_cell
 790+ 71F1
 791+ 71F1              .not_wall:
 792+ 71F1
 793+ 71F1                  ; Nasty
 794+ 71F1 21 BB 00         ld   hl, OFFSET_NASTY
 795+ 71F4 19               add  hl, de
 796+ 71F5
 797+ 71F5              .draw_cell:
 798+ 71F5
 799+ 71F5                  ; ---------------------------------------------------------------
 800+ 71F5                  ; HL punta ora alla grafica del tile da ridisegnare.
 801+ 71F5                  ;
 802+ 71F5                  ; DrawTile si aspetta:
 803+ 71F5                  ;   IX = puntatore tile
 804+ 71F5                  ;   B  = Row
 805+ 71F5                  ;   C  = Col
 806+ 71F5                  ; ---------------------------------------------------------------
 807+ 71F5 E5               push hl
 808+ 71F6 DD E1            pop  ix
 809+ 71F8
 810+ 71F8                  ; Ripristina Row e Col salvati in IY
 811+ 71F8 FD E5            push iy
 812+ 71FA C1               pop  bc
 813+ 71FB
 814+ 71FB                  ; Disegna il tile originale
 815+ 71FB CD 8C 61         call DrawTile
 816+ 71FE
 817+ 71FE                  ; ---------------------------------------------------------------
 818+ 71FE                  ; Ripristina i registri salvati
 819+ 71FE                  ; ---------------------------------------------------------------
 820+ 71FE DD E1            pop  ix
 821+ 7200 E1               pop  hl
 822+ 7201 D1               pop  de
 823+ 7202 C1               pop  bc
 824+ 7203 FD E1            pop  iy
 825+ 7205
 826+ 7205 C9               ret
 827+ 7206
 828+ 7206              ; -------------------------------------------------------------------
 829+ 7206              ; CheckWillyItemCollision
 830+ 7206              ;
 831+ 7206              ; Verifica se Willy collide con un item utilizzando il controllo
 832+ 7206              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 833+ 7206              ;
 834+ 7206              ; Input:
 835+ 7206              ;   A = ItemX (colonna attributi 0..31)
 836+ 7206              ;   H = ItemY (riga attributi 3..18)
 837+ 7206              ;
 838+ 7206              ; Coordinate item:
 839+ 7206              ;   Ogni item occupa una cella da 8x8 pixel.
 840+ 7206              ;
 841+ 7206              ; Coordinate Willy:
 842+ 7206              ;   Willy occupa un rettangolo di 16x16 pixel.
 843+ 7206              ;
 844+ 7206              ; Output:
 845+ 7206              ;   Carry Set   = collisione rilevata
 846+ 7206              ;   Carry Clear = nessuna collisione
 847+ 7206              ;
 848+ 7206              ; Registri preservati:
 849+ 7206              ;   BC, DE, HL
 850+ 7206              ; -------------------------------------------------------------------
 851+ 7206              CheckWillyItemCollision:
 852+ 7206
 853+ 7206                  ; Salva i registri utilizzati
 854+ 7206 C5               push bc
 855+ 7207 D5               push de
 856+ 7208 E5               push hl
 857+ 7209
 858+ 7209                  ; ---------------------------------------------------------------
 859+ 7209                  ; Calcola il bounding box orizzontale dell'item
 860+ 7209                  ;
 861+ 7209                  ; ItemLeft  = ItemX * 8
 862+ 7209                  ; ItemRight = ItemLeft + 7
 863+ 7209                  ;
 864+ 7209                  ; E = ItemLeft
 865+ 7209                  ; D = ItemRight
 866+ 7209                  ; ---------------------------------------------------------------
 867+ 7209 6F               ld   l, a              ; L = ItemX
 868+ 720A
 869+ 720A 7D               ld   a, l
 870+ 720B 87               add  a, a              ; *2
 871+ 720C 87               add  a, a              ; *4
 872+ 720D 87               add  a, a              ; *8
 873+ 720E
 874+ 720E 5F               ld   e, a              ; E = ItemLeft
 875+ 720F
 876+ 720F C6 07            add  a, 7
 877+ 7211 57               ld   d, a              ; D = ItemRight
 878+ 7212
 879+ 7212                  ; ---------------------------------------------------------------
 880+ 7212                  ; Recupera la posizione corrente di Willy
 881+ 7212                  ;
 882+ 7212                  ; B = WillyY
 883+ 7212                  ; C = WillyX
 884+ 7212                  ; ---------------------------------------------------------------
 885+ 7212 ED 4B E7 72      ld   bc, (PlayerPos)
 886+ 7216
 887+ 7216                  ; ---------------------------------------------------------------
 888+ 7216                  ; Primo test:
 889+ 7216                  ;
 890+ 7216                  ; WillyLeft <= ItemRight
 891+ 7216                  ;
 892+ 7216                  ; Se Willy è completamente a destra dell'item
 893+ 7216                  ; non può esserci collisione.
 894+ 7216                  ; ---------------------------------------------------------------
 895+ 7216 79               ld   a, c              ; A = WillyLeft
 896+ 7217
 897+ 7217 BA               cp   d                 ; WillyLeft vs ItemRight
 898+ 7218
 899+ 7218 28 04            jr   z, .x_ok
 900+ 721A 38 02            jr   c, .x_ok
 901+ 721C
 902+ 721C 18 29            jr   .no_collision
 903+ 721E
 904+ 721E              .x_ok:
 905+ 721E
 906+ 721E                  ; ---------------------------------------------------------------
 907+ 721E                  ; Secondo test:
 908+ 721E                  ;
 909+ 721E                  ; WillyRight >= ItemLeft
 910+ 721E                  ;
 911+ 721E                  ; WillyRight = WillyX + 7
 912+ 721E                  ; ---------------------------------------------------------------
 913+ 721E C6 07            add  a, 7
 914+ 7220
 915+ 7220 BB               cp   e                 ; WillyRight vs ItemLeft
 916+ 7221
 917+ 7221 28 04            jr   z, .y_check
 918+ 7223 30 02            jr   nc, .y_check
 919+ 7225
 920+ 7225 18 20            jr   .no_collision
 921+ 7227
 922+ 7227              .y_check:
 923+ 7227
 924+ 7227                  ; ---------------------------------------------------------------
 925+ 7227                  ; Recupera ItemY dal valore originale di HL
 926+ 7227                  ;
 927+ 7227                  ; H contiene la riga dell'item.
 928+ 7227                  ; ---------------------------------------------------------------
 929+ 7227 E1               pop  hl
 930+ 7228 E5               push hl
 931+ 7229
 932+ 7229                  ; ---------------------------------------------------------------
 933+ 7229                  ; Calcola il bounding box verticale dell'item
 934+ 7229                  ;
 935+ 7229                  ; ItemTop    = ItemY * 8
 936+ 7229                  ; ItemBottom = ItemTop + 7
 937+ 7229                  ;
 938+ 7229                  ; E = ItemTop
 939+ 7229                  ; D = ItemBottom
 940+ 7229                  ; ---------------------------------------------------------------
 941+ 7229 7C               ld   a, h
 942+ 722A
 943+ 722A 87               add  a, a              ; *2
 944+ 722B 87               add  a, a              ; *4
 945+ 722C 87               add  a, a              ; *8
 946+ 722D
 947+ 722D 5F               ld   e, a              ; ItemTop
 948+ 722E
 949+ 722E C6 07            add  a, 7
 950+ 7230 57               ld   d, a              ; ItemBottom
 951+ 7231
 952+ 7231                  ; ---------------------------------------------------------------
 953+ 7231                  ; Primo test verticale:
 954+ 7231                  ;
 955+ 7231                  ; WillyTop <= ItemBottom
 956+ 7231                  ; ---------------------------------------------------------------
 957+ 7231 78               ld   a, b              ; WillyTop
 958+ 7232
 959+ 7232 BA               cp   d
 960+ 7233
 961+ 7233 28 04            jr   z, .y_ok
 962+ 7235 38 02            jr   c, .y_ok
 963+ 7237
 964+ 7237 18 0E            jr   .no_collision
 965+ 7239
 966+ 7239              .y_ok:
 967+ 7239
 968+ 7239                  ; ---------------------------------------------------------------
 969+ 7239                  ; Secondo test verticale:
 970+ 7239                  ;
 971+ 7239                  ; WillyBottom >= ItemTop
 972+ 7239                  ;
 973+ 7239                  ; WillyBottom = WillyY + 15
 974+ 7239                  ; ---------------------------------------------------------------
 975+ 7239 C6 0F            add  a, 15
 976+ 723B
 977+ 723B BB               cp   e
 978+ 723C
 979+ 723C 28 04            jr   z, .collision
 980+ 723E 30 02            jr   nc, .collision
 981+ 7240
 982+ 7240 18 05            jr   .no_collision
 983+ 7242
 984+ 7242              .collision:
 985+ 7242
 986+ 7242                  ; ---------------------------------------------------------------
 987+ 7242                  ; Collisione rilevata
 988+ 7242                  ; ---------------------------------------------------------------
 989+ 7242 E1               pop  hl
 990+ 7243 D1               pop  de
 991+ 7244 C1               pop  bc
 992+ 7245
 993+ 7245 37               scf                    ; Carry = 1
 994+ 7246
 995+ 7246 C9               ret
 996+ 7247
 997+ 7247              .no_collision:
 998+ 7247
 999+ 7247                  ; ---------------------------------------------------------------
1000+ 7247                  ; Nessuna collisione
1001+ 7247                  ; ---------------------------------------------------------------
1002+ 7247 E1               pop  hl
1003+ 7248 D1               pop  de
1004+ 7249 C1               pop  bc
1005+ 724A
1006+ 724A B7               or   a                 ; Carry = 0
1007+ 724B
1008+ 724B C9               ret
1009+ 724C
1010+ 724C              ; -------------------------------------------------------------------
1011+ 724C              ; CheckRoomItemsCollision
1012+ 724C              ;
1013+ 724C              ; Controlla se Willy entra in collisione con uno degli item
1014+ 724C              ; attivi presenti nella stanza corrente.
1015+ 724C              ;
1016+ 724C              ; Per ogni item:
1017+ 724C              ;   - verifica che appartenga alla stanza corrente
1018+ 724C              ;   - verifica che non sia già stato raccolto
1019+ 724C              ;   - esegue il test di collisione con Willy
1020+ 724C              ;
1021+ 724C              ; Se l'item viene raccolto:
1022+ 724C              ;   - imposta il flag "collected"
1023+ 724C              ;   - rimuove l'item dalla cache items_grid
1024+ 724C              ;   - incrementa il contatore degli oggetti raccolti
1025+ 724C              ;   - aggiorna l'HUD
1026+ 724C              ;   - ripristina il tile di sfondo
1027+ 724C              ;   - riproduce il suono di raccolta
1028+ 724C              ;
1029+ 724C              ; Formato record ItemsTable:
1030+ 724C              ;   +0 RoomID
1031+ 724C              ;   +1 X
1032+ 724C              ;   +2 Y
1033+ 724C              ;   +3 Color
1034+ 724C              ;   +4 Collected
1035+ 724C              ;
1036+ 724C              ; Fine tabella:
1037+ 724C              ;   RoomID = $FF
1038+ 724C              ; -------------------------------------------------------------------
1039+ 724C              CheckRoomItemsCollision:
1040+ 724C
1041+ 724C                  ; Salva i registri utilizzati
1042+ 724C E5               push hl
1043+ 724D D5               push de
1044+ 724E C5               push bc
1045+ 724F
1046+ 724F                  ; Inizio scansione della tabella degli item
1047+ 724F 21 B3 6F         ld   hl, ItemsTable
1048+ 7252
1049+ 7252              .loop:
1050+ 7252
1051+ 7252                  ; ---------------------------------------------------------------
1052+ 7252                  ; Legge il Room ID dell'item corrente
1053+ 7252                  ; ---------------------------------------------------------------
1054+ 7252 7E               ld   a, (hl)
1055+ 7253
1056+ 7253                  ; $FF indica fine tabella
1057+ 7253 FE FF            cp   $FF
1058+ 7255 28 4D            jr   z, .done
1059+ 7257
1060+ 7257                  ; ---------------------------------------------------------------
1061+ 7257                  ; Verifica se l'item appartiene alla stanza corrente
1062+ 7257                  ; ---------------------------------------------------------------
1063+ 7257 57               ld   d, a              ; D = RoomID item
1064+ 7258
1065+ 7258 3A FD 75         ld   a, (current_room)
1066+ 725B BA               cp   d
1067+ 725C
1068+ 725C                  ; Se appartiene a un'altra stanza salta il record
1069+ 725C 20 3F            jr   nz, .next_item
1070+ 725E
1071+ 725E                  ; ---------------------------------------------------------------
1072+ 725E                  ; Legge coordinate e stato dell'item
1073+ 725E                  ; ---------------------------------------------------------------
1074+ 725E
1075+ 725E 23               inc  hl
1076+ 725F 4E               ld   c, (hl)           ; C = X
1077+ 7260
1078+ 7260 23               inc  hl
1079+ 7261 46               ld   b, (hl)           ; B = Y
1080+ 7262
1081+ 7262 23               inc  hl                ; salta Color
1082+ 7263
1083+ 7263 23               inc  hl                ; punta a Collected
1084+ 7264
1085+ 7264 7E               ld   a, (hl)
1086+ 7265
1087+ 7265                  ; ---------------------------------------------------------------
1088+ 7265                  ; Item già raccolto?
1089+ 7265                  ; ---------------------------------------------------------------
1090+ 7265 B7               or   a
1091+ 7266 20 39            jr   nz, .next_no_inc
1092+ 7268
1093+ 7268                  ; ---------------------------------------------------------------
1094+ 7268                  ; Test collisione Willy ↔ Item
1095+ 7268                  ;
1096+ 7268                  ; Input richiesto:
1097+ 7268                  ;   A = ItemX
1098+ 7268                  ;   H = ItemY
1099+ 7268                  ; ---------------------------------------------------------------
1100+ 7268 79               ld   a, c
1101+ 7269
1102+ 7269 E5               push hl                ; salva puntatore al flag Collected
1103+ 726A
1104+ 726A 60               ld   h, b
1105+ 726B
1106+ 726B CD 06 72         call CheckWillyItemCollision
1107+ 726E
1108+ 726E E1               pop  hl
1109+ 726F
1110+ 726F                  ; Nessuna collisione
1111+ 726F 30 30            jr   nc, .next_no_inc
1112+ 7271
1113+ 7271                  ; ===============================================================
1114+ 7271                  ; ITEM RACCOLTO
1115+ 7271                  ; ===============================================================
1116+ 7271
1117+ 7271                  ; ---------------------------------------------------------------
1118+ 7271                  ; Marca l'item come raccolto
1119+ 7271                  ; ---------------------------------------------------------------
1120+ 7271 36 01            ld   (hl), 1
1121+ 7273
1122+ 7273                  ; ---------------------------------------------------------------
1123+ 7273                  ; Rimuove l'item dalla cache items_grid
1124+ 7273                  ;
1125+ 7273                  ; Calcolo:
1126+ 7273                  ;   offset = Row * 32 + Col
1127+ 7273                  ; ---------------------------------------------------------------
1128+ 7273 E5               push hl
1129+ 7274 D5               push de
1130+ 7275
1131+ 7275 26 00            ld   h, 0
1132+ 7277 68               ld   l, b              ; HL = Row
1133+ 7278
1134+ 7278 29               add  hl, hl            ; *2
1135+ 7279 29               add  hl, hl            ; *4
1136+ 727A 29               add  hl, hl            ; *8
1137+ 727B 29               add  hl, hl            ; *16
1138+ 727C 29               add  hl, hl            ; *32
1139+ 727D
1140+ 727D 59               ld   e, c
1141+ 727E 16 00            ld   d, 0
1142+ 7280
1143+ 7280 19               add  hl, de            ; Row*32 + Col
1144+ 7281
1145+ 7281 11 00 90         ld   de, items_grid
1146+ 7284 19               add  hl, de
1147+ 7285
1148+ 7285                  ; La cella non contiene più un item
1149+ 7285 36 00            ld   (hl), 0
1150+ 7287
1151+ 7287 D1               pop  de
1152+ 7288 E1               pop  hl
1153+ 7289
1154+ 7289                  ; ---------------------------------------------------------------
1155+ 7289                  ; Conserva il puntatore all'entry corrente
1156+ 7289                  ; poiché le routine successive possono alterare HL.
1157+ 7289                  ; ---------------------------------------------------------------
1158+ 7289 E5               push hl
1159+ 728A
1160+ 728A                  ; ---------------------------------------------------------------
1161+ 728A                  ; Aggiorna il numero di oggetti raccolti
1162+ 728A                  ; ---------------------------------------------------------------
1163+ 728A 3A F1 72         ld   a, (items_collected)
1164+ 728D
1165+ 728D 3C               inc  a
1166+ 728E
1167+ 728E 32 F1 72         ld   (items_collected), a
1168+ 7291
1169+ 7291                  ; ---------------------------------------------------------------
1170+ 7291                  ; Aggiorna il contatore visualizzato a schermo
1171+ 7291                  ; ---------------------------------------------------------------
1172+ 7291 CD CB 60         call UpdateItemsCollectedDisplay
1173+ 7294
1174+ 7294                  ; ---------------------------------------------------------------
1175+ 7294                  ; Ripristina il tile originale della stanza
1176+ 7294                  ; eliminando la grafica dell'item.
1177+ 7294                  ;
1178+ 7294                  ; Input:
1179+ 7294                  ;   B = Row
1180+ 7294                  ;   C = Col
1181+ 7294                  ; ---------------------------------------------------------------
1182+ 7294 CD C4 71         call RestoreBackgroundCell
1183+ 7297
1184+ 7297                  ; ---------------------------------------------------------------
1185+ 7297                  ; Riproduce il suono di raccolta
1186+ 7297                  ; ---------------------------------------------------------------
1187+ 7297 CD A8 72         call PlayCollectSound
1188+ 729A
1189+ 729A                  ; Ripristina il puntatore alla tabella
1190+ 729A E1               pop  hl
1191+ 729B
1192+ 729B                  ; Continua con il record successivo
1193+ 729B 18 04            jr   .next_no_inc
1194+ 729D
1195+ 729D              .next_item:
1196+ 729D
1197+ 729D                  ; ---------------------------------------------------------------
1198+ 729D                  ; Salta i campi del record:
1199+ 729D                  ;   X
1200+ 729D                  ;   Y
1201+ 729D                  ;   Color
1202+ 729D                  ;   Collected
1203+ 729D                  ; ---------------------------------------------------------------
1204+ 729D 23               inc  hl
1205+ 729E 23               inc  hl
1206+ 729F 23               inc  hl
1207+ 72A0 23               inc  hl
1208+ 72A1
1209+ 72A1              .next_no_inc:
1210+ 72A1
1211+ 72A1                  ; ---------------------------------------------------------------
1212+ 72A1                  ; Avanza al record successivo.
1213+ 72A1                  ;
1214+ 72A1                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1215+ 72A1                  ; ---------------------------------------------------------------
1216+ 72A1 23               inc  hl
1217+ 72A2
1218+ 72A2 18 AE            jr   .loop
1219+ 72A4
1220+ 72A4              .done:
1221+ 72A4
1222+ 72A4                  ; Ripristina i registri
1223+ 72A4 C1               pop  bc
1224+ 72A5 D1               pop  de
1225+ 72A6 E1               pop  hl
1226+ 72A7
1227+ 72A7 C9               ret
1228+ 72A8
1229+ 72A8              ; -------------------------------------------------------------------
1230+ 72A8              ; PlayCollectSound
1231+ 72A8              ;
1232+ 72A8              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1233+ 72A8              ; dello ZX Spectrum utilizzando il port $FE.
1234+ 72A8              ;
1235+ 72A8              ; Il suono viene prodotto alternando ON/OFF del bit 4
1236+ 72A8              ; (speaker) con un semplice delay software.
1237+ 72A8              ;
1238+ 72A8              ; Effetto risultante:
1239+ 72A8              ;   beep breve tipo "pickup item"
1240+ 72A8              ; -------------------------------------------------------------------
1241+ 72A8              PlayCollectSound:
1242+ 72A8
1243+ 72A8                  ; Salva registri utilizzati
1244+ 72A8 C5               push bc
1245+ 72A9 D5               push de
1246+ 72AA
1247+ 72AA                  ; ---------------------------------------------------------------
1248+ 72AA                  ; Numero di cicli del beep (durata complessiva del suono)
1249+ 72AA                  ; ---------------------------------------------------------------
1250+ 72AA 06 78            ld   b, 120
1251+ 72AC
1252+ 72AC              .sound_loop:
1253+ 72AC
1254+ 72AC                  ; ---------------------------------------------------------------
1255+ 72AC                  ; SPEAKER ON
1256+ 72AC                  ;
1257+ 72AC                  ; Legge il colore del bordo corrente e attiva il bit 4
1258+ 72AC                  ; per pilotare lo speaker.
1259+ 72AC                  ; ---------------------------------------------------------------
1260+ 72AC 3A F3 72         ld   a, (room_border_color)
1261+ 72AF F6 10            or   $10               ; bit 4 = 1 → speaker ON
1262+ 72B1
1263+ 72B1 D3 FE            out  ($fe), a         ; scrive sul port ULA
1264+ 72B3
1265+ 72B3                  ; ---------------------------------------------------------------
1266+ 72B3                  ; Delay (mezzo periodo)
1267+ 72B3                  ; Loop software a consumo CPU
1268+ 72B3                  ; ---------------------------------------------------------------
1269+ 72B3 0E 3C            ld   c, 60
1270+ 72B5
1271+ 72B5              .d1:
1272+ 72B5 0D               dec  c
1273+ 72B6 20 FD            jr   nz, .d1
1274+ 72B8
1275+ 72B8                  ; ---------------------------------------------------------------
1276+ 72B8                  ; SPEAKER OFF
1277+ 72B8                  ;
1278+ 72B8                  ; Mantiene il colore del bordo ma disattiva lo speaker
1279+ 72B8                  ; ---------------------------------------------------------------
1280+ 72B8 3A F3 72         ld   a, (room_border_color)
1281+ 72BB E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1282+ 72BD
1283+ 72BD D3 FE            out  ($fe), a
1284+ 72BF
1285+ 72BF                  ; ---------------------------------------------------------------
1286+ 72BF                  ; Secondo delay (mezzo periodo)
1287+ 72BF                  ; Completa l’onda quadra
1288+ 72BF                  ; ---------------------------------------------------------------
1289+ 72BF 0E 3C            ld   c, 60
1290+ 72C1
1291+ 72C1              .d2:
1292+ 72C1 0D               dec  c
1293+ 72C2 20 FD            jr   nz, .d2
1294+ 72C4
1295+ 72C4                  ; ---------------------------------------------------------------
1296+ 72C4                  ; Ripete fino a completare il numero di cicli
1297+ 72C4                  ; ---------------------------------------------------------------
1298+ 72C4 10 E6            djnz .sound_loop
1299+ 72C6
1300+ 72C6                  ; Ripristina registri salvati
1301+ 72C6 D1               pop  de
1302+ 72C7 C1               pop  bc
1303+ 72C8
1304+ 72C8 C9               ret
1305+ 72C9
1306+ 72C9              ; -------------------------------------------------------------------
1307+ 72C9              ; CheckActiveItemAtCell
1308+ 72C9              ;
1309+ 72C9              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1310+ 72C9              ; nella cella specificata della griglia items_grid.
1311+ 72C9              ;
1312+ 72C9              ; Questa routine usa una lookup diretta su una mappa 32x16,
1313+ 72C9              ; evitando la scansione della ItemsTable.
1314+ 72C9              ;
1315+ 72C9              ; Input:
1316+ 72C9              ;   B = Colonna (0..31)
1317+ 72C9              ;   C = Riga (0..15)
1318+ 72C9              ;
1319+ 72C9              ; Output:
1320+ 72C9              ;   Carry Set   = item presente nella cella
1321+ 72C9              ;   Carry Clear = nessun item
1322+ 72C9              ;
1323+ 72C9              ; Nota:
1324+ 72C9              ;   HL NON è restituito valido (commento originale non corretto:
1325+ 72C9              ;   la routine non punta a ItemsTable).
1326+ 72C9              ; -------------------------------------------------------------------
1327+ 72C9              CheckActiveItemAtCell:
1328+ 72C9
1329+ 72C9                  ; Salva registri usati
1330+ 72C9 D5               push de
1331+ 72CA E5               push hl
1332+ 72CB
1333+ 72CB                  ; ---------------------------------------------------------------
1334+ 72CB                  ; Calcolo indice lineare nella griglia 32x16:
1335+ 72CB                  ;
1336+ 72CB                  ; offset = Row * 32 + Col
1337+ 72CB                  ; ---------------------------------------------------------------
1338+ 72CB 26 00            ld   h, 0
1339+ 72CD 69               ld   l, c              ; HL = Row
1340+ 72CE
1341+ 72CE 29               add  hl, hl            ; *2
1342+ 72CF 29               add  hl, hl            ; *4
1343+ 72D0 29               add  hl, hl            ; *8
1344+ 72D1 29               add  hl, hl            ; *16
1345+ 72D2 29               add  hl, hl            ; *32
1346+ 72D3
1347+ 72D3                  ; Aggiunge la colonna
1348+ 72D3 58               ld   e, b
1349+ 72D4 16 00            ld   d, 0
1350+ 72D6 19               add  hl, de            ; HL = Row*32 + Col
1351+ 72D7
1352+ 72D7                  ; ---------------------------------------------------------------
1353+ 72D7                  ; Accesso alla griglia degli item attivi
1354+ 72D7                  ; ---------------------------------------------------------------
1355+ 72D7 11 00 90         ld   de, items_grid
1356+ 72DA 19               add  hl, de            ; HL = address cella
1357+ 72DB
1358+ 72DB                  ; ---------------------------------------------------------------
1359+ 72DB                  ; Controllo presenza item
1360+ 72DB                  ;
1361+ 72DB                  ; items_grid contiene:
1362+ 72DB                  ;   0 = nessun item
1363+ 72DB                  ;   >0 = item attivo (colore o flag)
1364+ 72DB                  ; ---------------------------------------------------------------
1365+ 72DB 7E               ld   a, (hl)
1366+ 72DC B7               or   a
1367+ 72DD 28 04            jr   z, .not_active
1368+ 72DF
1369+ 72DF                  ; ---------------------------------------------------------------
1370+ 72DF                  ; Item trovato
1371+ 72DF                  ; ---------------------------------------------------------------
1372+ 72DF E1               pop  hl
1373+ 72E0 D1               pop  de
1374+ 72E1
1375+ 72E1 37               scf                    ; Carry = 1
1376+ 72E2 C9               ret
1377+ 72E3
1378+ 72E3              .not_active:
1379+ 72E3
1380+ 72E3                  ; ---------------------------------------------------------------
1381+ 72E3                  ; Nessun item nella cella
1382+ 72E3                  ; ---------------------------------------------------------------
1383+ 72E3 E1               pop  hl
1384+ 72E4 D1               pop  de
1385+ 72E5
1386+ 72E5 B7               or   a                 ; Carry = 0
1387+ 72E6 C9               ret
1388+ 72E7
# file closed: items.asm
