  17+ 6A34              ; Tabella dei colori, se aggiungiamo $C davanti al colore questo diventa lampeggiante
  18+ 6A34              ; 1 - BLUE
  19+ 6A34              ; 2 - RED
  20+ 6A34              ; 3 - MAGENTA
  21+ 6A34              ; 4 - GREEN
  22+ 6A34              ; 5 - CYAN
  23+ 6A34              ; 6 - YELLOW
  24+ 6A34              ; 7 - WHITE
