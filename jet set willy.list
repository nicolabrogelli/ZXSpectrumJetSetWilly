1341+ 73C8              ; PlayCollectSound
1342+ 73C8              ;
1343+ 73C8              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1344+ 73C8              ; dello ZX Spectrum utilizzando il port $FE.
1345+ 73C8              ;
1346+ 73C8              ; Il suono viene prodotto alternando ON/OFF del bit 4
1347+ 73C8              ; (speaker) con un semplice delay software.
1348+ 73C8              ;
1349+ 73C8              ; Effetto risultante:
1350+ 73C8              ;   beep breve tipo "pickup item"
1351+ 73C8              ; -------------------------------------------------------------------
1352+ 73C8              PlayCollectSound:
1353+ 73C8
1354+ 73C8                  ; Salva registri utilizzati
1355+ 73C8 C5               push bc
1356+ 73C9 D5               push de
1357+ 73CA
1358+ 73CA                  ; ---------------------------------------------------------------
1359+ 73CA                  ; Numero di cicli del beep (durata complessiva del suono)
1360+ 73CA                  ; ---------------------------------------------------------------
1361+ 73CA 06 78            ld   b, 120
1362+ 73CC
1363+ 73CC              .sound_loop:
1364+ 73CC
1365+ 73CC                  ; ---------------------------------------------------------------
1366+ 73CC                  ; SPEAKER ON
1367+ 73CC                  ;
1368+ 73CC                  ; Legge il colore del bordo corrente e attiva il bit 4
1369+ 73CC                  ; per pilotare lo speaker.
1370+ 73CC                  ; ---------------------------------------------------------------
1371+ 73CC 3A 0F 75         ld   a, (room_border_color)
1372+ 73CF F6 10            or   $10               ; bit 4 = 1 → speaker ON
1373+ 73D1
1374+ 73D1 D3 FE            out  ($fe), a         ; scrive sul port ULA
1375+ 73D3
1376+ 73D3                  ; ---------------------------------------------------------------
1377+ 73D3                  ; Delay (mezzo periodo)
1378+ 73D3                  ; Loop software a consumo CPU
1379+ 73D3                  ; ---------------------------------------------------------------
1380+ 73D3 0E 3C            ld   c, 60
1381+ 73D5
1382+ 73D5              .d1:
1383+ 73D5 0D               dec  c
1384+ 73D6 20 FD            jr   nz, .d1
1385+ 73D8
1386+ 73D8                  ; ---------------------------------------------------------------
1387+ 73D8                  ; SPEAKER OFF
1388+ 73D8                  ;
1389+ 73D8                  ; Mantiene il colore del bordo ma disattiva lo speaker
1390+ 73D8                  ; ---------------------------------------------------------------
1391+ 73D8 3A 0F 75         ld   a, (room_border_color)
1392+ 73DB E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1393+ 73DD
1394+ 73DD D3 FE            out  ($fe), a
1395+ 73DF
1396+ 73DF                  ; ---------------------------------------------------------------
1397+ 73DF                  ; Secondo delay (mezzo periodo)
1398+ 73DF                  ; Completa l’onda quadra
1399+ 73DF                  ; ---------------------------------------------------------------
1400+ 73DF 0E 3C            ld   c, 60
1401+ 73E1
1402+ 73E1              .d2:
1403+ 73E1 0D               dec  c
1404+ 73E2 20 FD            jr   nz, .d2
1405+ 73E4
