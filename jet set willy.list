1880+ 7A1C CB 3F            srl  a
1881+ 7A1E CB 3F            srl  a                 ; A = c (0..31)
1882+ 7A20 4F               ld   c, a              ; C = c
1883+ 7A21 7B               ld   a, e              ; A = r
