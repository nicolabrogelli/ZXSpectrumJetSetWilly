1242+ 75BA              ; -------------------------------------------------------------------
1243+ 75BA              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1244+ 75BA              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1245+ 75BA              ; -------------------------------------------------------------------
1246+ 75BA              UnpackRoomLayout:
1247+ 75BA E5               push hl
1248+ 75BB D5               push de
1249+ 75BC C5               push bc
1250+ 75BD
1251+ 75BD 2A D7 EE         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1252+ 75C0 11 7D EC         ld   de, unpacked_layout ; DE = buffer RAM
1253+ 75C3 06 80            ld   b, 128             ; 128 byte
1254+ 75C5              .byte_loop:
1255+ 75C5 7E               ld   a, (hl)            ; Leggi byte compresso
1256+ 75C6 23               inc  hl
1257+ 75C7
1258+ 75C7 4F               ld   c, a               ; C = salvataggio
1259+ 75C8
1260+ 75C8                  ; Cella 0: bit 7-6
1261+ 75C8 07               rlca
1262+ 75C9 07               rlca
1263+ 75CA E6 03            and  3
1264+ 75CC 12               ld   (de), a
1265+ 75CD 13               inc  de
1266+ 75CE
1267+ 75CE                  ; Cella 1: bit 5-4
1268+ 75CE 79               ld   a, c
1269+ 75CF 07               rlca
1270+ 75D0 07               rlca
1271+ 75D1 07               rlca
1272+ 75D2 07               rlca
1273+ 75D3 E6 03            and  3
1274+ 75D5 12               ld   (de), a
1275+ 75D6 13               inc  de
1276+ 75D7
1277+ 75D7                  ; Cella 2: bit 3-2
1278+ 75D7 79               ld   a, c
1279+ 75D8 0F               rrca
1280+ 75D9 0F               rrca
1281+ 75DA E6 03            and  3
1282+ 75DC 12               ld   (de), a
1283+ 75DD 13               inc  de
1284+ 75DE
1285+ 75DE                  ; Cella 3: bit 1-0
1286+ 75DE 79               ld   a, c
1287+ 75DF E6 03            and  3
1288+ 75E1 12               ld   (de), a
1289+ 75E2 13               inc  de
1290+ 75E3
1291+ 75E3 10 E0            djnz .byte_loop
1292+ 75E5
1293+ 75E5 C1               pop  bc
1294+ 75E6 D1               pop  de
1295+ 75E7 E1               pop  hl
1296+ 75E8 C9               ret
1297+ 75E9
1298+ 75E9              ; -------------------------------------------------------------------
1299+ 75E9              ; Legge il tipo di cella dal buffer decompresso in RAM
1300+ 75E9              ; Input: A = Row (0..15), C = Col (0..31)
1301+ 75E9              ; Output: A = tipo di cella (0..3)
1302+ 75E9              ; Preserva tutti gli altri registri.
1303+ 75E9              ; -------------------------------------------------------------------
1304+ 75E9              GetCellFromUnpacked:
1305+ 75E9 E5               push hl
1306+ 75EA D5               push de
1307+ 75EB
1308+ 75EB 6F               ld   l, a
1309+ 75EC 26 00            ld   h, 0
1310+ 75EE 29               add  hl, hl
1311+ 75EF 29               add  hl, hl
1312+ 75F0 29               add  hl, hl
1313+ 75F1 29               add  hl, hl
1314+ 75F2 29               add  hl, hl            ; HL = Row * 32
1315+ 75F3 59               ld   e, c
