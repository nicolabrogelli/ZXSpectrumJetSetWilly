1352+ 77B8 7A               ld   a, d
1353+ 77B9 B3               or   e
1354+ 77BA CA C1 78         jp   z, .no_ramp_change
1355+ 77BD 3A 14 FB         ld   a, (ramp_len)
1356+ 77C0 B7               or   a
1357+ 77C1 CA C1 78         jp   z, .no_ramp_change
1358+ 77C4
1359+ 77C4                  ; Calcola Row e Col: Offset = DE - 24064
1360+ 77C4 21 00 A2         ld   hl, -24064
1361+ 77C7 19               add  hl, de            ; HL = Offset
1362+ 77C8 54               ld   d, h
1363+ 77C9 5D               ld   e, l
1364+ 77CA
1365+ 77CA 7B               ld   a, e
1366+ 77CB E6 1F            and  31
1367+ 77CD 32 16 FB         ld   (ramp_col), a     ; Col Start
1368+ 77D0
1369+ 77D0 CB 3C            srl  h
1369+ 77D2 CB 1D          rr l
1370+ 77D4 CB 3C            srl  h
1370+ 77D6 CB 1D          rr l
1371+ 77D8 CB 3C            srl  h
1371+ 77DA CB 1D          rr l
1372+ 77DC CB 3C            srl  h
1372+ 77DE CB 1D          rr l
1373+ 77E0 CB 3C            srl  h
