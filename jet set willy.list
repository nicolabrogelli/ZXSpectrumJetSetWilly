1981+ 7C6E              ; CheckActiveItemAtCell
1982+ 7C6E              ;
1983+ 7C6E              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1984+ 7C6E              ; nella cella specificata della griglia items_grid.
1985+ 7C6E              ;
1986+ 7C6E              ; Questa routine usa una lookup diretta su una mappa 32x16,
1987+ 7C6E              ; evitando la scansione della ItemsTable.
1988+ 7C6E              ;
1989+ 7C6E              ; Input:
1990+ 7C6E              ;   B = Colonna (0..31)
1991+ 7C6E              ;   C = Riga (0..15)
1992+ 7C6E              ;
1993+ 7C6E              ; Output:
1994+ 7C6E              ;   Carry Set   = item presente nella cella
1995+ 7C6E              ;   Carry Clear = nessun item
1996+ 7C6E              ;
1997+ 7C6E              ; Nota:
1998+ 7C6E              ;   HL NON è restituito valido (commento originale non corretto:
1999+ 7C6E              ;   la routine non punta a ItemsTable).
2000+ 7C6E              ; -------------------------------------------------------------------
2001+ 7C6E              CheckActiveItemAtCell:
2002+ 7C6E
2003+ 7C6E                  ; Salva registri usati
2004+ 7C6E D5               push de
2005+ 7C6F E5               push hl
2006+ 7C70
2007+ 7C70                  ; ---------------------------------------------------------------
2008+ 7C70                  ; Calcolo indice lineare nella griglia 32x16:
2009+ 7C70                  ;
2010+ 7C70                  ; offset = Row * 32 + Col
2011+ 7C70                  ; ---------------------------------------------------------------
2012+ 7C70 26 00            ld   h, 0
2013+ 7C72 69               ld   l, c              ; HL = Row
2014+ 7C73
2015+ 7C73 29               add  hl, hl            ; *2
2016+ 7C74 29               add  hl, hl            ; *4
2017+ 7C75 29               add  hl, hl            ; *8
2018+ 7C76 29               add  hl, hl            ; *16
2019+ 7C77 29               add  hl, hl            ; *32
2020+ 7C78
2021+ 7C78                  ; Aggiunge la colonna
2022+ 7C78 58               ld   e, b
2023+ 7C79 16 00            ld   d, 0
2024+ 7C7B 19               add  hl, de            ; HL = Row*32 + Col
2025+ 7C7C
2026+ 7C7C                  ; ---------------------------------------------------------------
2027+ 7C7C                  ; Accesso alla griglia degli item attivi
2028+ 7C7C                  ; ---------------------------------------------------------------
2029+ 7C7C 11 26 E4         ld   de, items_grid
2030+ 7C7F 19               add  hl, de            ; HL = address cella
2031+ 7C80
2032+ 7C80                  ; ---------------------------------------------------------------
2033+ 7C80                  ; Controllo presenza item
2034+ 7C80                  ;
2035+ 7C80                  ; items_grid contiene:
2036+ 7C80                  ;   0 = nessun item
2037+ 7C80                  ;   >0 = item attivo (colore o flag)
2038+ 7C80                  ; ---------------------------------------------------------------
2039+ 7C80 7E               ld   a, (hl)
2040+ 7C81 B7               or   a
2041+ 7C82 28 04            jr   z, .not_active
2042+ 7C84
2043+ 7C84                  ; ---------------------------------------------------------------
2044+ 7C84                  ; Item trovato
2045+ 7C84                  ; ---------------------------------------------------------------
2046+ 7C84 E1               pop  hl
2047+ 7C85 D1               pop  de
2048+ 7C86
2049+ 7C86 37               scf                    ; Carry = 1
2050+ 7C87 C9               ret
2051+ 7C88
2052+ 7C88              .not_active:
2053+ 7C88
2054+ 7C88                  ; ---------------------------------------------------------------
2055+ 7C88                  ; Nessun item nella cella
2056+ 7C88                  ; ---------------------------------------------------------------
2057+ 7C88 E1               pop  hl
2058+ 7C89 D1               pop  de
2059+ 7C8A
2060+ 7C8A B7               or   a                 ; Carry = 0
2061+ 7C8B C9               ret
