1342+ 73C8              ; -------------------------------------------------------------------
1343+ 73C8              ; CheckActiveItemAtCell
1344+ 73C8              ;
1345+ 73C8              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1346+ 73C8              ; nella cella specificata della griglia items_grid.
1347+ 73C8              ;
1348+ 73C8              ; Questa routine usa una lookup diretta su una mappa 32x16,
1349+ 73C8              ; evitando la scansione della ItemsTable.
1350+ 73C8              ;
1351+ 73C8              ; Input:
1352+ 73C8              ;   B = Colonna (0..31)
1353+ 73C8              ;   C = Riga (0..15)
1354+ 73C8              ;
1355+ 73C8              ; Output:
1356+ 73C8              ;   Carry Set   = item presente nella cella
1357+ 73C8              ;   Carry Clear = nessun item
1358+ 73C8              ;
1359+ 73C8              ; Nota:
1360+ 73C8              ;   HL NON è restituito valido (commento originale non corretto:
1361+ 73C8              ;   la routine non punta a ItemsTable).
1362+ 73C8              ; -------------------------------------------------------------------
1363+ 73C8              CheckActiveItemAtCell:
1364+ 73C8
1365+ 73C8                  ; Salva registri usati
1366+ 73C8 D5               push de
1367+ 73C9 E5               push hl
1368+ 73CA
1369+ 73CA                  ; ---------------------------------------------------------------
1370+ 73CA                  ; Calcolo indice lineare nella griglia 32x16:
1371+ 73CA                  ;
1372+ 73CA                  ; offset = Row * 32 + Col
1373+ 73CA                  ; ---------------------------------------------------------------
1374+ 73CA 26 00            ld   h, 0
1375+ 73CC 69               ld   l, c              ; HL = Row
1376+ 73CD
1377+ 73CD 29               add  hl, hl            ; *2
1378+ 73CE 29               add  hl, hl            ; *4
1379+ 73CF 29               add  hl, hl            ; *8
1380+ 73D0 29               add  hl, hl            ; *16
1381+ 73D1 29               add  hl, hl            ; *32
1382+ 73D2
1383+ 73D2                  ; Aggiunge la colonna
1384+ 73D2 58               ld   e, b
1385+ 73D3 16 00            ld   d, 0
1386+ 73D5 19               add  hl, de            ; HL = Row*32 + Col
1387+ 73D6
1388+ 73D6                  ; ---------------------------------------------------------------
1389+ 73D6                  ; Accesso alla griglia degli item attivi
1390+ 73D6                  ; ---------------------------------------------------------------
1391+ 73D6 11 00 B0         ld   de, items_grid
1392+ 73D9 19               add  hl, de            ; HL = address cella
1393+ 73DA
1394+ 73DA                  ; ---------------------------------------------------------------
1395+ 73DA                  ; Controllo presenza item
1396+ 73DA                  ;
1397+ 73DA                  ; items_grid contiene:
1398+ 73DA                  ;   0 = nessun item
1399+ 73DA                  ;   >0 = item attivo (colore o flag)
1400+ 73DA                  ; ---------------------------------------------------------------
1401+ 73DA 7E               ld   a, (hl)
1402+ 73DB B7               or   a
1403+ 73DC 28 04            jr   z, .not_active
1404+ 73DE
1405+ 73DE                  ; ---------------------------------------------------------------
1406+ 73DE                  ; Item trovato
1407+ 73DE                  ; ---------------------------------------------------------------
1408+ 73DE E1               pop  hl
1409+ 73DF D1               pop  de
1410+ 73E0
1411+ 73E0 37               scf                    ; Carry = 1
1412+ 73E1 C9               ret
1413+ 73E2
1414+ 73E2              .not_active:
1415+ 73E2
1416+ 73E2                  ; ---------------------------------------------------------------
1417+ 73E2                  ; Nessun item nella cella
1418+ 73E2                  ; ---------------------------------------------------------------
1419+ 73E2 E1               pop  hl
1420+ 73E3 D1               pop  de
1421+ 73E4
1422+ 73E4 B7               or   a                 ; Carry = 0
1423+ 73E5 C9               ret
