 463  8A4E B7               or   a
 464  8A4F 20 19            jr   nz, .keep_current_time
 465  8A51 3A 3C F7         ld   a, (time_hours)
 466  8A54 FE 0C            cp   12
 467  8A56 20 12            jr   nz, .keep_current_time
 468  8A58 3E 07            ld   a, 7
 469  8A5A 32 3C F7         ld   (time_hours), a
