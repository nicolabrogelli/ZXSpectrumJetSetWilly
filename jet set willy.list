1782+ 67A2 19               add  hl, de            ; HL = indirizzo pattern font 8x8 in RAM ($F100)
1783+ 67A3
1784+ 67A3                  ; 2. Imposta l'attributo colore a Riga 23, Colonna C ($5AE0 + C)
1785+ 67A3 E5               push hl                ; Salva indirizzo pattern font
1786+ 67A4 69               ld   l, c
1787+ 67A5 26 00            ld   h, 0
1788+ 67A7 11 E0 5A         ld   de, $5ae0
1789+ 67AA 19               add  hl, de            ; HL = indirizzo attributi Riga 23 ($5AE0 + C)
1790+ 67AB 36 46            ld   (hl), $46         ; Attributo: BRIGHT 1 + PAPER BLACK + INK YELLOW ($46)
1791+ 67AD E1               pop  hl                ; Ripristina indirizzo pattern font in HL
1792+ 67AE
1793+ 67AE                  ; 3. Indirizzo VRAM Riga 23, Colonna C
1794+ 67AE                  ; Low byte VRAM: $E0 | C
1795+ 67AE 79               ld   a, c
1796+ 67AF F6 E0            or   $e0
1797+ 67B1 5F               ld   e, a              ; E = Low byte VRAM ($E0 | C)
1798+ 67B2
