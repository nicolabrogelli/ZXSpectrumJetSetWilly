 279+ 6C98              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 280+ 6C98              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 281+ 6C98              ; -------------------------------------------------------------------
 282+ 6C98              DrawItemGraphic:
 283+ 6C98 C5               push bc
 284+ 6C99 D5               push de
 285+ 6C9A E5               push hl
 286+ 6C9B
 287+ 6C9B                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 288+ 6C9B 78               ld   a, b
 289+ 6C9C E6 18            and  $18
 290+ 6C9E C6 40            add  a, $40
 291+ 6CA0 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 292+ 6CA1
 293+ 6CA1 78               ld   a, b
 294+ 6CA2 E6 07            and  7
 295+ 6CA4 87               add  a, a              ; *2
 296+ 6CA5 87               add  a, a              ; *4
 297+ 6CA6 87               add  a, a              ; *8
 298+ 6CA7 87               add  a, a              ; *16
 299+ 6CA8 87               add  a, a              ; *32
 300+ 6CA9 81               add  a, c              ; + Col C
 301+ 6CAA 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 302+ 6CAB
 303+ 6CAB                  ; 2. Copia gli 8 byte del bitmap dello sprite
 304+ 6CAB C5               push bc                ; Salva BC (contiene Row e Col)
 305+ 6CAC 06 08            ld   b, 8              ; 8 scanline
 306+ 6CAE              .line_loop:
 307+ 6CAE 7E               ld   a, (hl)
 308+ 6CAF 12               ld   (de), a
 309+ 6CB0 14               inc  d                 ; Prossima scanline
 310+ 6CB1 23               inc  hl
 311+ 6CB2 05               dec  b
 312+ 6CB3 20 F9            jr   nz, .line_loop
 313+ 6CB5 C1               pop  bc                ; Ripristina BC
 314+ 6CB6
 315+ 6CB6                  ; 3. Calcola l'indirizzo degli attributi dello schermo
 316+ 6CB6                  ; HL = $5800 + B * 32 + C
 317+ 6CB6 26 00            ld   h, 0
 318+ 6CB8 68               ld   l, b              ; HL = B (Row)
 319+ 6CB9 29               add  hl, hl            ; *2
 320+ 6CBA 29               add  hl, hl            ; *4
 321+ 6CBB 29               add  hl, hl            ; *8
 322+ 6CBC 29               add  hl, hl            ; *16
 323+ 6CBD 29               add  hl, hl            ; *32
