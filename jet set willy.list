 915+ 6AF7 04               inc  b                 ; B = SlopeRow + 1
 916+ 6AF8 B8               cp   b
 917+ 6AF9 28 28            jr   z, .yes           ; Row == SlopeRow + 1
 918+ 6AFB
 919+ 6AFB              .check_platform_case:
 920+ 6AFB                  ; 2. Controlla se è sulla piattaforma adiacente in cima
