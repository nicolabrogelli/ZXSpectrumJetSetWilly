 298+ 6FD4 DD 96 01         sub  (ix+1)            ; A = PlayerX - EnemyX
 299+ 6FD7 C6 07            add  a, 7              ; A = PlayerX - EnemyX + 7
 300+ 6FD9 FE 17            cp   23                ; Se >= 23, nessuna collisione con questo
 301+ 6FDB 30 13            jr   nc, .next
 302+ 6FDD
 303+ 6FDD                  ; 2. Controllo verticale: PlayerY - EnemyY + 15 in [0, 30]
 304+ 6FDD 3A 8C 76         ld   a, (PlayerPos+1)  ; A = PlayerY
 305+ 6FE0 DD 96 02         sub  (ix+2)            ; A = PlayerY - EnemyY
 306+ 6FE3 C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 307+ 6FE5 FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 308+ 6FE7 30 07            jr   nc, .next
