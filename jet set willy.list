1304+ 7048              GetCellFromUnpacked:
1305+ 7048 E5               push hl
1306+ 7049 D5               push de
1307+ 704A
1308+ 704A 6F               ld   l, a
1309+ 704B 26 00            ld   h, 0
1310+ 704D 29               add  hl, hl
1311+ 704E 29               add  hl, hl
1312+ 704F 29               add  hl, hl
1313+ 7050 29               add  hl, hl
1314+ 7051 29               add  hl, hl            ; HL = Row * 32
1315+ 7052 59               ld   e, c
1316+ 7053 16 00            ld   d, 0
1317+ 7055 19               add  hl, de            ; HL = Row * 32 + Col
1318+ 7056 11 4C E7         ld   de, unpacked_layout
1319+ 7059 19               add  hl, de
1320+ 705A 7E               ld   a, (hl)           ; A = cell type
1321+ 705B
1322+ 705B D1               pop  de
1323+ 705C E1               pop  hl
1324+ 705D C9               ret
