 165+ 6B3B              ; Disegna tutti gli oggetti attivi della stanza corrente
 166+ 6B3B              ; -------------------------------------------------------------------
 167+ 6B3B              DrawRoomItems:
 168+ 6B3B E5               push hl
 169+ 6B3C D5               push de
 170+ 6B3D C5               push bc
 171+ 6B3E DD E5            push ix
 172+ 6B40
 173+ 6B40                  ; Ottieni il puntatore alla grafica dell'item della stanza corrente:
 174+ 6B40                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 175+ 6B40 2A FE 7A         ld   hl, (room_ptr)
 176+ 6B43 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 177+ 6B46 19               add  hl, de
 178+ 6B47 E5               push hl
 179+ 6B48 DD E1            pop  ix                ; IX = puntatore alla grafica dell'item della stanza
 180+ 6B4A
 181+ 6B4A 21 4F 6A         ld   hl, ItemsTable
 182+ 6B4D              .loop:
