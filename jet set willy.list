1903+ 85C6                  ; ---------------------------------------------------------------
1904+ 85C6 E5               push hl
1905+ 85C7 D5               push de
1906+ 85C8
1907+ 85C8 26 00            ld   h, 0
1908+ 85CA 68               ld   l, b              ; HL = Row
1909+ 85CB
1910+ 85CB 29               add  hl, hl            ; *2
1911+ 85CC 29               add  hl, hl            ; *4
1912+ 85CD 29               add  hl, hl            ; *8
1913+ 85CE 29               add  hl, hl            ; *16
1914+ 85CF 29               add  hl, hl            ; *32
1915+ 85D0
1916+ 85D0 59               ld   e, c
1917+ 85D1 16 00            ld   d, 0
1918+ 85D3
1919+ 85D3 19               add  hl, de            ; Row*32 + Col
1920+ 85D4
1921+ 85D4 11 57 E9         ld   de, items_grid
1922+ 85D7 19               add  hl, de
1923+ 85D8
1924+ 85D8                  ; La cella non contiene più un item
