1537+ 79CB                  ; ITEM RACCOLTO
1538+ 79CB                  ; ===============================================================
1539+ 79CB
1540+ 79CB                  ; ---------------------------------------------------------------
1541+ 79CB                  ; Marca l'item come raccolto
1542+ 79CB                  ; ---------------------------------------------------------------
1543+ 79CB 36 01            ld   (hl), 1
1544+ 79CD
1545+ 79CD                  ; ---------------------------------------------------------------
1546+ 79CD                  ; Rimuove l'item dalla cache items_grid
1547+ 79CD                  ;
1548+ 79CD                  ; Calcolo:
1549+ 79CD                  ;   offset = Row * 32 + Col
1550+ 79CD                  ; ---------------------------------------------------------------
1551+ 79CD E5               push hl
1552+ 79CE D5               push de
1553+ 79CF
1554+ 79CF 26 00            ld   h, 0
1555+ 79D1 68               ld   l, b              ; HL = Row
1556+ 79D2
1557+ 79D2 29               add  hl, hl            ; *2
1558+ 79D3 29               add  hl, hl            ; *4
1559+ 79D4 29               add  hl, hl            ; *8
1560+ 79D5 29               add  hl, hl            ; *16
1561+ 79D6 29               add  hl, hl            ; *32
1562+ 79D7
1563+ 79D7 59               ld   e, c
1564+ 79D8 16 00            ld   d, 0
1565+ 79DA
1566+ 79DA 19               add  hl, de            ; Row*32 + Col
1567+ 79DB
1568+ 79DB 11 EC CC         ld   de, items_grid
1569+ 79DE 19               add  hl, de
1570+ 79DF
1571+ 79DF                  ; La cella non contiene più un item
1572+ 79DF 36 00            ld   (hl), 0
1573+ 79E1
1574+ 79E1 D1               pop  de
1575+ 79E2 E1               pop  hl
1576+ 79E3
1577+ 79E3                  ; ---------------------------------------------------------------
1578+ 79E3                  ; Conserva il puntatore all'entry corrente
1579+ 79E3                  ; poiché le routine successive possono alterare HL.
1580+ 79E3                  ; ---------------------------------------------------------------
1581+ 79E3 E5               push hl
1582+ 79E4
1583+ 79E4                  ; ---------------------------------------------------------------
1584+ 79E4                  ; Aggiorna il numero di oggetti raccolti
1585+ 79E4                  ; ---------------------------------------------------------------
1586+ 79E4 3A 43 7B         ld   a, (items_collected)
1587+ 79E7
1588+ 79E7 3C               inc  a
1589+ 79E8
1590+ 79E8 32 43 7B         ld   (items_collected), a
1591+ 79EB
1592+ 79EB                  ; ---------------------------------------------------------------
1593+ 79EB                  ; Aggiorna il contatore visualizzato a schermo
1594+ 79EB                  ; ---------------------------------------------------------------
1595+ 79EB CD 65 61         call Gfx_UpdateItemsCollectedDisplay
1596+ 79EE
1597+ 79EE                  ; ---------------------------------------------------------------
1598+ 79EE                  ; Ripristina il tile originale della stanza
1599+ 79EE                  ; eliminando la grafica dell'item.
1600+ 79EE                  ;
1601+ 79EE                  ; Input:
1602+ 79EE                  ;   B = Row
