 797+ 615E 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 798+ 6160 3E 07            ld   a, $07
 799+ 6162 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 800+ 6165
 801+ 6165                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
