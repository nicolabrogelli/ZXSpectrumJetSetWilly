  63+ 70A9              ; DetermineCurrentRoomID
  64+ 70A9              ;
  65+ 70A9              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 70A9              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 70A9              ;
  68+ 70A9              ; Se viene trovata una corrispondenza:
  69+ 70A9              ;   A = ID della stanza
  70+ 70A9              ;   current_room = A
  71+ 70A9              ;
  72+ 70A9              ; Mappatura:
  73+ 70A9              ;    0 = The Off Licence
  74+ 70A9              ;    1 = The Bridge
  75+ 70A9              ;    2 = Under The Mega Tree
  76+ 70A9              ;    3 = Gfx_At The Foot Of The Mega Tree
  77+ 70A9              ;    4 = The Drive
  78+ 70A9              ;    5 = The Security Guard
  79+ 70A9              ;    6 = Entrance To Hades
  80+ 70A9              ;    7 = Cuckoo's Nest
  81+ 70A9              ;    8 = Inside The Mega Trunk
  82+ 70A9              ;    9 = On A Branch Over The Drive
  83+ 70A9              ;   10 = The Front Door
  84+ 70A9              ;   11 = The Hall
  85+ 70A9              ;   12 = Tree Top
  86+ 70A9              ;   33 = The Bathroom
  87+ 70A9              ;   35 = Master Bedroom
  88+ 70A9              ;
  89+ 70A9              ; Se nessuna stanza corrisponde viene impostato:
  90+ 70A9              ;   current_room = 0
  91+ 70A9              ; -------------------------------------------------------------------
  92+ 70A9              DetermineCurrentRoomID:
