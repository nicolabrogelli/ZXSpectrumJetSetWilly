  28+ 6C65 38 21            jr   c, .solid
  29+ 6C67
  30+ 6C67                  ; 2. Calcola riga di layout: r = Y / 8
  31+ 6C67 78               ld   a, b
  32+ 6C68 CB 3F            srl  a
  33+ 6C6A CB 3F            srl  a
  34+ 6C6C CB 3F            srl  a                 ; A = r (0..15)
  35+ 6C6E
  36+ 6C6E                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
  37+ 6C6E 5F               ld   e, a              ; E = r
  38+ 6C6F 79               ld   a, c
  39+ 6C70 CB 3F            srl  a
  40+ 6C72 CB 3F            srl  a
  41+ 6C74 CB 3F            srl  a                 ; A = c (0..31)
  42+ 6C76 4F               ld   c, a              ; C = c
  43+ 6C77 7B               ld   a, e              ; A = r
  44+ 6C78
  45+ 6C78 CD 37 72         call GetCellFromUnpacked ; A = cell type
  46+ 6C7B
  47+ 6C7B                  ; 5. Controlla se è solida: Floor (1) o Wall (2)
  48+ 6C7B FE 01            cp   1
  49+ 6C7D 28 09            jr   z, .solid
  50+ 6C7F FE 02            cp   2
  51+ 6C81 28 05            jr   z, .solid
