 451  8A3D 01 FE DF         ld   bc, $dffe
 452  8A40 ED 78            in   a, (c)
 453  8A42 CB 67            bit  4, a
 454  8A44 28 F6            jr   z, .wait_continue_release
 455  8A46
 456  8A46                  ; 5b. Ripristina lo stato per continuare la partita:
 457  8A46                  ; - Ripristina le vite di Willy al valore iniziale
