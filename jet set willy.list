  72+ 881A ~            ; Audio_UpdateMusic
  73+ 881A ~            ;
  74+ 881A ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 881A ~            ; Viene chiamata a ogni frame.
  76+ 881A ~            ; -------------------------------------------------------------------
  77+ 881A ~            Audio_UpdateMusic:
  78+ 881A ~                push af
  79+ 881A ~                push bc
  80+ 881A ~                push de
  81+ 881A ~                push hl
  82+ 881A ~
  83+ 881A ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 881A ~                ld   a, (Audio_jump_sound_note)
  85+ 881A ~                cp   18
  86+ 881A ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 881A ~
  88+ 881A ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 881A ~                ld   a, (Audio_music_frame_counter)
  90+ 881A ~                dec  a
  91+ 881A ~                ld   (Audio_music_frame_counter), a
  92+ 881A ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 881A ~
  94+ 881A ~                ; Altrimenti carica la nota successiva
  95+ 881A ~                ld   a, (Audio_music_note_idx)
  96+ 881A ~                inc  a
  97+ 881A ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 881A ~                jr   c, .no_wrap
  99+ 881A ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 881A ~            .no_wrap:
 101+ 881A ~                ld   (Audio_music_note_idx), a
 102+ 881A ~
 103+ 881A ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 881A ~                ld   e, a
 105+ 881A ~                ld   d, 0
 106+ 881A ~                ld   hl, Audio_MusicSheet
 107+ 881A ~                add  hl, de
 108+ 881A ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 881A ~
 110+ 881A ~                ; Leggi durata (secondo byte)
 111+ 881A ~                inc  hl
 112+ 881A ~                ld   a, (hl)
 113+ 881A ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 881A ~                jr   nz, .dur_ok
 115+ 881A ~                ld   a, 1
 116+ 881A ~            .dur_ok:
 117+ 881A ~                ld   (Audio_music_frame_counter), a
 118+ 881A ~
 119+ 881A ~            .play_current_note:
 120+ 881A ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 881A ~                ld   a, (Audio_music_note_idx)
 122+ 881A ~                ld   e, a
 123+ 881A ~                ld   d, 0
 124+ 881A ~                ld   hl, Audio_MusicSheet
 125+ 881A ~                add  hl, de
 126+ 881A ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 881A ~                ld   a, (hl)                  ; A = delay
 128+ 881A ~                or   a
 129+ 881A ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 881A ~
 131+ 881A ~                ; Suona la nota: 2 cicli
 132+ 881A ~                ld   d, a                     ; D = delay
 133+ 881A ~                ld   b, 2                     ; 2 cicli per frame
 134+ 881A ~            .note_loop:
 135+ 881A ~                ; Speaker ON
 136+ 881A ~                ld   a, (room_border_color)
 137+ 881A ~                or   $10
 138+ 881A ~                out  ($fe), a
 139+ 881A ~                ld   c, d
 140+ 881A ~            .d1:
 141+ 881A ~                push af
 142+ 881A ~                pop  af
 143+ 881A ~                dec  c
 144+ 881A ~                jr   nz, .d1
 145+ 881A ~
 146+ 881A ~                ; Speaker OFF
 147+ 881A ~                ld   a, (room_border_color)
 148+ 881A ~                and  $ef
 149+ 881A ~                out  ($fe), a
 150+ 881A ~                ld   c, d
 151+ 881A ~            .d2:
 152+ 881A ~                push af
 153+ 881A ~                pop  af
 154+ 881A ~                dec  c
 155+ 881A ~                jr   nz, .d2
 156+ 881A ~
 157+ 881A ~                djnz .note_loop
 158+ 881A ~
 159+ 881A ~            .done:
 160+ 881A ~                pop  hl
 161+ 881A ~                pop  de
 162+ 881A ~                pop  bc
 163+ 881A ~                pop  af
 164+ 881A ~                ret
 165+ 881A ~
 166+ 881A ~            Audio_MusicSheet:
 167+ 881A ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 881A ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 881A ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 881A ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 881A ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 881A ~                db 90, 10, 107, 20, 68, 65
 173+ 881A                  ELSE
 174+ 881A              Audio_UpdateMusic:
 175+ 881A C9               ret
 176+ 881B                  ENDIF
