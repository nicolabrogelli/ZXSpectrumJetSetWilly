1327+ 77A6              ; Phys_CheckRampOnRoomChange
1328+ 77A6              ; Controlla se nella nuova stanza (DE = room layout ptr) c'è una rampa
1329+ 77A6              ; allineata con la posizione d'ingresso di Willy (C = PlayerX, B = PlayerY).
1330+ 77A6              ; Output: Se allineato, modifica B = ramp_Y e C = PlayerX e imposta on_ground = 1.
1331+ 77A6              ; -------------------------------------------------------------------
1332+ 77A6              Phys_CheckRampOnRoomChange:
1333+ 77A6 E5               push hl
1334+ 77A7 D5               push de
1335+ 77A8 C5               push bc
1336+ 77A9
1337+ 77A9                  ; Offsets per RampData: DE + 218
1338+ 77A9 21 DA 00         ld   hl, 218
1339+ 77AC 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1340+ 77AD
1341+ 77AD 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1342+ 77AE 32 6F FB         ld   (ramp_dir), a
