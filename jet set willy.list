1857+ 74B1              ; Verifica se c'è una cella Nasty (tipo 3) alle coordinate pixel (X, Y)
1858+ 74B1              ; Input: C = X, B = Y
1859+ 74B1              ; Output: Carry flag impostato se è Nasty, altrimenti resettato
1860+ 74B1              ; -------------------------------------------------------------------
1861+ 74B1              CheckNastyCell:
1862+ 74B1 E5               push hl
1863+ 74B2 D5               push de
1864+ 74B3 C5               push bc
1865+ 74B4
1866+ 74B4                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1867+ 74B4 78               ld   a, b
1868+ 74B5 FE 80            cp   128
1869+ 74B7 30 17            jr   nc, .not_nasty
1870+ 74B9
1871+ 74B9                  ; 2. Calcola riga di layout: r = Y / 8
1872+ 74B9 CB 3F            srl  a
1873+ 74BB CB 3F            srl  a
1874+ 74BD CB 3F            srl  a                 ; A = r (0..15)
1875+ 74BF
1876+ 74BF                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1877+ 74BF 5F               ld   e, a              ; E = r
1878+ 74C0 79               ld   a, c
1879+ 74C1 CB 3F            srl  a
1880+ 74C3 CB 3F            srl  a
1881+ 74C5 CB 3F            srl  a                 ; A = c (0..31)
1882+ 74C7 4F               ld   c, a              ; C = c
1883+ 74C8 7B               ld   a, e              ; A = r
1884+ 74C9
1885+ 74C9 CD 37 72         call GetCellFromUnpacked ; A = cell type
1886+ 74CC
1887+ 74CC                  ; Controlla se è Nasty (3)
1888+ 74CC FE 03            cp   3
1889+ 74CE 28 05            jr   z, .is_nasty
1890+ 74D0
1891+ 74D0              .not_nasty:
1892+ 74D0 C1               pop  bc
1893+ 74D1 D1               pop  de
1894+ 74D2 E1               pop  hl
1895+ 74D3 B7               or   a                 ; Clear carry
1896+ 74D4 C9               ret
1897+ 74D5
