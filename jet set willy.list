  20+ 7451 00
  21+ 7452 02 1A 07 06      db 2, 26, 7, 6, 0               ; Oggetto 4 alla colonna X=10, riga Y=7
  21+ 7456 00
  22+ 7457 02 19 07 05      db 2, 25, 7, 5, 0               ; Oggetto 5 alla colonna X=20, riga Y=7 (Stato: 0=attivo)
  22+ 745B 00
  23+ 745C 02 18 07 04      db 2, 24, 7, 4, 0               ; Oggetto 6 alla colonna X=10, riga Y=7
  23+ 7460 00
