 131+ 74B9
 132+ 74B9                  ; Suona la nota: 2 cicli
 133+ 74B9 57               ld   d, a                     ; D = delay
 134+ 74BA 06 02            ld   b, 2                     ; 2 cicli per frame
 135+ 74BC              .note_loop:
