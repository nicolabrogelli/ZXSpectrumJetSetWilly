1188+ 6B55 87               add  a, a              ; *4
1189+ 6B56 87               add  a, a              ; *8
1190+ 6B57 5F               ld   e, a              ; E = X_left
1191+ 6B58
1192+ 6B58 3A 05 76         ld   a, (ramp_col)
