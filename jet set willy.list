1829+ 7399 7E               ld   a, (hl)
1830+ 739A B7               or   a
1831+ 739B 20 0C            jr   nz, .custom_settings
1832+ 739D
1833+ 739D 3E 06            ld   a, DEFAULT_JUMP_STRENGTH
1834+ 739F 32 45 E6         ld   (room_jump_strength), a
1835+ 73A2 3E 01            ld   a, DEFAULT_GRAVITY_PRESET
1836+ 73A4 32 46 E6         ld   (room_gravity_preset), a
1837+ 73A7 18 12            jr   .done
1838+ 73A9
1839+ 73A9              .custom_settings:
1840+ 73A9 F5               push af
1841+ 73AA E6 0F            and  $0f                  ; Maschera i 4 bit inferiori (JJJJ)
1842+ 73AC 32 45 E6         ld   (room_jump_strength), a
1843+ 73AF F1               pop  af
1844+ 73B0 CB 3F            srl  a
1845+ 73B2 CB 3F            srl  a
1846+ 73B4 CB 3F            srl  a
1847+ 73B6 CB 3F            srl  a                  ; Sposta i 4 bit superiori in quelli inferiori (GGGG)
1848+ 73B8 32 46 E6         ld   (room_gravity_preset), a
1849+ 73BB
1850+ 73BB              .done:
1851+ 73BB F1               pop  af
1852+ 73BC D1               pop  de
1853+ 73BD E1               pop  hl
1854+ 73BE C9               ret
