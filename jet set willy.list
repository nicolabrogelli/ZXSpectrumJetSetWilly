 754+ 60F1 D5               push de
 755+ 60F2 E5               push hl
 756+ 60F3
 757+ 60F3                  ; 1. Calcola indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 758+ 60F3                  ; HighByte = $40 + (B & $18)
 759+ 60F3 78               ld   a, b
 760+ 60F4 E6 18            and  $18
 761+ 60F6 C6 40            add  a, $40
 762+ 60F8 67               ld   h, a              ; H = High byte
 763+ 60F9
 764+ 60F9                  ; LowByte = ((B & 7) * 32) + C
 765+ 60F9 78               ld   a, b
 766+ 60FA E6 07            and  7
 767+ 60FC 87               add  a, a              ; *2
 768+ 60FD 87               add  a, a              ; *4
 769+ 60FE 87               add  a, a              ; *8
 770+ 60FF 87               add  a, a              ; *16
