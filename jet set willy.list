2019+ 87E3              ; CheckActiveItemAtCell
2020+ 87E3              ;
2021+ 87E3              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2022+ 87E3              ; nella cella specificata della griglia items_grid.
2023+ 87E3              ;
2024+ 87E3              ; Questa routine usa una lookup diretta su una mappa 32x16,
2025+ 87E3              ; evitando la scansione della ItemsTable.
2026+ 87E3              ;
2027+ 87E3              ; Input:
2028+ 87E3              ;   B = Colonna (0..31)
2029+ 87E3              ;   C = Riga (0..15)
2030+ 87E3              ;
2031+ 87E3              ; Output:
2032+ 87E3              ;   Carry Set   = item presente nella cella
2033+ 87E3              ;   Carry Clear = nessun item
2034+ 87E3              ;
2035+ 87E3              ; Nota:
2036+ 87E3              ;   HL NON è restituito valido (commento originale non corretto:
2037+ 87E3              ;   la routine non punta a ItemsTable).
2038+ 87E3              ; -------------------------------------------------------------------
2039+ 87E3              CheckActiveItemAtCell:
2040+ 87E3
2041+ 87E3                  ; Salva registri usati
2042+ 87E3 D5               push de
2043+ 87E4 E5               push hl
2044+ 87E5
2045+ 87E5                  ; ---------------------------------------------------------------
2046+ 87E5                  ; Calcolo indice lineare nella griglia 32x16:
2047+ 87E5                  ;
2048+ 87E5                  ; offset = Row * 32 + Col
2049+ 87E5                  ; ---------------------------------------------------------------
2050+ 87E5 26 00            ld   h, 0
2051+ 87E7 69               ld   l, c              ; HL = Row
2052+ 87E8
2053+ 87E8 29               add  hl, hl            ; *2
2054+ 87E9 29               add  hl, hl            ; *4
2055+ 87EA 29               add  hl, hl            ; *8
2056+ 87EB 29               add  hl, hl            ; *16
2057+ 87EC 29               add  hl, hl            ; *32
2058+ 87ED
2059+ 87ED                  ; Aggiunge la colonna
2060+ 87ED 58               ld   e, b
2061+ 87EE 16 00            ld   d, 0
2062+ 87F0 19               add  hl, de            ; HL = Row*32 + Col
2063+ 87F1
2064+ 87F1                  ; ---------------------------------------------------------------
2065+ 87F1                  ; Accesso alla griglia degli item attivi
2066+ 87F1                  ; ---------------------------------------------------------------
2067+ 87F1 11 E2 F2         ld   de, items_grid
2068+ 87F4 19               add  hl, de            ; HL = address cella
2069+ 87F5
2070+ 87F5                  ; ---------------------------------------------------------------
2071+ 87F5                  ; Controllo presenza item
2072+ 87F5                  ;
2073+ 87F5                  ; items_grid contiene:
2074+ 87F5                  ;   0 = nessun item
2075+ 87F5                  ;   >0 = item attivo (colore o flag)
2076+ 87F5                  ; ---------------------------------------------------------------
2077+ 87F5 7E               ld   a, (hl)
2078+ 87F6 B7               or   a
2079+ 87F7 28 04            jr   z, .not_active
2080+ 87F9
2081+ 87F9                  ; ---------------------------------------------------------------
2082+ 87F9                  ; Item trovato
2083+ 87F9                  ; ---------------------------------------------------------------
2084+ 87F9 E1               pop  hl
2085+ 87FA D1               pop  de
2086+ 87FB
2087+ 87FB 37               scf                    ; Carry = 1
2088+ 87FC C9               ret
2089+ 87FD
2090+ 87FD              .not_active:
2091+ 87FD
2092+ 87FD                  ; ---------------------------------------------------------------
2093+ 87FD                  ; Nessun item nella cella
2094+ 87FD                  ; ---------------------------------------------------------------
2095+ 87FD E1               pop  hl
2096+ 87FE D1               pop  de
2097+ 87FF
2098+ 87FF B7               or   a                 ; Carry = 0
2099+ 8800 C9               ret
