2019+ 8819              ; CheckActiveItemAtCell
2020+ 8819              ;
2021+ 8819              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2022+ 8819              ; nella cella specificata della griglia items_grid.
2023+ 8819              ;
2024+ 8819              ; Questa routine usa una lookup diretta su una mappa 32x16,
2025+ 8819              ; evitando la scansione della ItemsTable.
2026+ 8819              ;
2027+ 8819              ; Input:
2028+ 8819              ;   B = Colonna (0..31)
2029+ 8819              ;   C = Riga (0..15)
2030+ 8819              ;
2031+ 8819              ; Output:
2032+ 8819              ;   Carry Set   = item presente nella cella
2033+ 8819              ;   Carry Clear = nessun item
2034+ 8819              ;
2035+ 8819              ; Nota:
2036+ 8819              ;   HL NON è restituito valido (commento originale non corretto:
2037+ 8819              ;   la routine non punta a ItemsTable).
2038+ 8819              ; -------------------------------------------------------------------
2039+ 8819              CheckActiveItemAtCell:
2040+ 8819
2041+ 8819                  ; Salva registri usati
2042+ 8819 D5               push de
2043+ 881A E5               push hl
2044+ 881B
2045+ 881B                  ; ---------------------------------------------------------------
2046+ 881B                  ; Calcolo indice lineare nella griglia 32x16:
2047+ 881B                  ;
2048+ 881B                  ; offset = Row * 32 + Col
2049+ 881B                  ; ---------------------------------------------------------------
2050+ 881B 26 00            ld   h, 0
2051+ 881D 69               ld   l, c              ; HL = Row
2052+ 881E
2053+ 881E 29               add  hl, hl            ; *2
2054+ 881F 29               add  hl, hl            ; *4
2055+ 8820 29               add  hl, hl            ; *8
2056+ 8821 29               add  hl, hl            ; *16
2057+ 8822 29               add  hl, hl            ; *32
2058+ 8823
2059+ 8823                  ; Aggiunge la colonna
2060+ 8823 58               ld   e, b
2061+ 8824 16 00            ld   d, 0
2062+ 8826 19               add  hl, de            ; HL = Row*32 + Col
2063+ 8827
2064+ 8827                  ; ---------------------------------------------------------------
2065+ 8827                  ; Accesso alla griglia degli item attivi
2066+ 8827                  ; ---------------------------------------------------------------
2067+ 8827 11 44 F6         ld   de, items_grid
2068+ 882A 19               add  hl, de            ; HL = address cella
2069+ 882B
2070+ 882B                  ; ---------------------------------------------------------------
2071+ 882B                  ; Controllo presenza item
2072+ 882B                  ;
2073+ 882B                  ; items_grid contiene:
2074+ 882B                  ;   0 = nessun item
2075+ 882B                  ;   >0 = item attivo (colore o flag)
2076+ 882B                  ; ---------------------------------------------------------------
2077+ 882B 7E               ld   a, (hl)
2078+ 882C B7               or   a
2079+ 882D 28 04            jr   z, .not_active
2080+ 882F
2081+ 882F                  ; ---------------------------------------------------------------
2082+ 882F                  ; Item trovato
2083+ 882F                  ; ---------------------------------------------------------------
2084+ 882F E1               pop  hl
2085+ 8830 D1               pop  de
2086+ 8831
2087+ 8831 37               scf                    ; Carry = 1
2088+ 8832 C9               ret
2089+ 8833
2090+ 8833              .not_active:
2091+ 8833
2092+ 8833                  ; ---------------------------------------------------------------
2093+ 8833                  ; Nessun item nella cella
2094+ 8833                  ; ---------------------------------------------------------------
2095+ 8833 E1               pop  hl
2096+ 8834 D1               pop  de
2097+ 8835
2098+ 8835 B7               or   a                 ; Carry = 0
2099+ 8836 C9               ret
