 242+ 5EBD
 243+ 5EBD 3A E8 74         ld   a, (conveyor_col)
 244+ 5EC0 B9               cp   c
 245+ 5EC1 CA D5 5E         jp   z, .is_conveyor
 246+ 5EC4 DA CA 5E         jp   c, .c_greater
 247+ 5EC7 C3 DB 5E         jp   .check_ramp
 248+ 5ECA              .c_greater:
 249+ 5ECA 21 E6 74         ld   hl, conveyor_len
