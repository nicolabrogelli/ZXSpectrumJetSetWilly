 877+ 7E31 18 00            jr   .do_update
 878+ 7E33
 879+ 7E33              .do_update:
 880+ 7E33 3E 01            ld   a, 1
 881+ 7E35 32 85 F0         ld   (enemy_was_updated), a
 882+ 7E38
 883+ 7E38 DD 21 06 79      ld   ix, ActiveEnemies
 884+ 7E3C 06 08            ld   b, 8              ; 8 slot
 885+ 7E3E              .loop:
 886+ 7E3E DD 7E 00         ld   a, (ix+0)         ; Flags
 887+ 7E41 E6 80            and  $80               ; Active?
 888+ 7E43 CA 15 7F         jp   z, .next
 889+ 7E46
 890+ 7E46                  ; 1. Aggiorna Anim State
 891+ 7E46 DD 7E 01         ld   a, (ix+1)         ; Sprite Type (Offset 1)
 892+ 7E49 E6 3F            and  $3F               ; Tipo
 893+ 7E4B FE 0D            cp   13                ; Tipo 13 = Canguro?
 894+ 7E4D 28 2A            jr   z, .canguro_anim
 895+ 7E4F FE 0B            cp   11                ; Tipo 11 = Soldato?
 896+ 7E51 28 1B            jr   z, .soldato_anim
 897+ 7E53 FE 10            cp   16                ; Tipo 16 = Candelabro?
 898+ 7E55 28 17            jr   z, .soldato_anim
 899+ 7E57 FE 14            cp   20                ; Tipo 20 = Nonnino?
 900+ 7E59 28 13            jr   z, .soldato_anim
 901+ 7E5B FE 15            cp   21                ; Tipo 21 = Parrucca?
 902+ 7E5D 28 0F            jr   z, .soldato_anim
 903+ 7E5F FE 1D            cp   29                ; Tipo 29 = Saliera?
 904+ 7E61 28 0B            jr   z, .soldato_anim
 905+ 7E63
 906+ 7E63 DD 7E 07         ld   a, (ix+7)         ; Anim State (Offset 7)
 907+ 7E66 3C               inc  a
 908+ 7E67 E6 03            and  3                 ; Alterna 0..3
 909+ 7E69 DD 77 07         ld   (ix+7), a
 910+ 7E6C 18 14            jr   .anim_done
