  98  7A04                  ; Collisione attiva: disegna le raster bar nel bordo
  99  7A04 3A 77 76         ld   a, (counter)
 100  7A07 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 101  7A09 06 1E            ld   b, 30             ; Numero di righe della barra raster
 102  7A0B              .raster_loop:
 103  7A0B D3 FE            out  ($fe), a
 104  7A0D 3C               inc  a
 105  7A0E E6 07            and  7
 106  7A10 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 107  7A12              .delay:
 108  7A12 0D               dec  c
 109  7A13 20 FD            jr   nz, .delay
 110  7A15 10 F4            djnz .raster_loop
