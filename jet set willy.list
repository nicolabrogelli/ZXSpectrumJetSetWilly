 928+ 62F0 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 929+ 62F1 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
 930+ 62F4 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 931+ 62F6 3E 07            ld   a, $07
 932+ 62F8 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 933+ 62FB
 934+ 62FB                  ; 2. Stampa riga 1: Titolo principale (Riga 1, Colonna 0)
