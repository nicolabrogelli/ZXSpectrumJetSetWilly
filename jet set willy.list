 197+ 6F46 87               add  a, a              ; *2
 198+ 6F47 87               add  a, a              ; *4
 199+ 6F48 87               add  a, a              ; *8
 200+ 6F49 C6 08            add  a, 8              ; A = PlayerY di atterraggio
 201+ 6F4B
 202+ 6F4B ED 4B B3 76      ld   bc, (PlayerPos)   ; Ripristina C = PlayerX
 203+ 6F4F 47               ld   b, a              ; B = Nuovo PlayerY
