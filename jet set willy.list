1093+ 6AF5              ; GetRampY
1094+ 6AF5              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1095+ 6AF5              ; Input: C = PlayerX
1096+ 6AF5              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1097+ 6AF5              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1098+ 6AF5              ; -------------------------------------------------------------------
1099+ 6AF5              GetRampY:
1100+ 6AF5 3A 7D 75         ld   a, (ramp_len)
1101+ 6AF8 B7               or   a
1102+ 6AF9 C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1103+ 6AFA
1104+ 6AFA 3A 7C 75         ld   a, (ramp_dir)
1105+ 6AFD B7               or   a
1106+ 6AFE 28 4C            jr   z, .dir_left
1107+ 6B00
1108+ 6B00              .dir_right:
1109+ 6B00                  ; Rampa sale a destra (up-right)
1110+ 6B00 3A 7F 75         ld   a, (ramp_col)
1111+ 6B03 87               add  a, a              ; *2
1112+ 6B04 87               add  a, a              ; *4
1113+ 6B05 87               add  a, a              ; *8 (X start in pixel)
1114+ 6B06 5F               ld   e, a              ; E = X_left
1115+ 6B07
1116+ 6B07 3A 7D 75         ld   a, (ramp_len)
