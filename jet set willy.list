 230+ 6B7B
 231+ 6B7B              ; -------------------------------------------------------------------
 232+ 6B7B              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 233+ 6B7B              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 234+ 6B7B              ; -------------------------------------------------------------------
 235+ 6B7B              DrawItemGraphic:
 236+ 6B7B C5               push bc
 237+ 6B7C D5               push de
 238+ 6B7D E5               push hl
 239+ 6B7E
 240+ 6B7E                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 241+ 6B7E 78               ld   a, b
 242+ 6B7F E6 18            and  $18
 243+ 6B81 C6 40            add  a, $40
 244+ 6B83 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 245+ 6B84
 246+ 6B84 78               ld   a, b
 247+ 6B85 E6 07            and  7
 248+ 6B87 87               add  a, a              ; *2
 249+ 6B88 87               add  a, a              ; *4
 250+ 6B89 87               add  a, a              ; *8
 251+ 6B8A 87               add  a, a              ; *16
 252+ 6B8B 87               add  a, a              ; *32
 253+ 6B8C 81               add  a, c              ; + Col C
 254+ 6B8D 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 255+ 6B8E
 256+ 6B8E                  ; 2. Copia gli 8 byte del bitmap dello sprite
 257+ 6B8E C5               push bc                ; Salva BC (contiene Row e Col)
 258+ 6B8F 06 08            ld   b, 8              ; 8 scanline
 259+ 6B91              .line_loop:
 260+ 6B91 7E               ld   a, (hl)
 261+ 6B92 12               ld   (de), a
 262+ 6B93 14               inc  d                 ; Prossima scanline
 263+ 6B94 23               inc  hl
 264+ 6B95 05               dec  b
 265+ 6B96 20 F9            jr   nz, .line_loop
 266+ 6B98 C1               pop  bc                ; Ripristina BC
 267+ 6B99
 268+ 6B99                  ; 3. Calcola l'indirizzo degli attributi dello schermo
 269+ 6B99                  ; HL = $5800 + B * 32 + C
 270+ 6B99 26 00            ld   h, 0
 271+ 6B9B 68               ld   l, b              ; HL = B (Row)
 272+ 6B9C 29               add  hl, hl            ; *2
 273+ 6B9D 29               add  hl, hl            ; *4
 274+ 6B9E 29               add  hl, hl            ; *8
 275+ 6B9F 29               add  hl, hl            ; *16
 276+ 6BA0 29               add  hl, hl            ; *32
 277+ 6BA1
 278+ 6BA1 79               ld   a, c              ; A = Col
 279+ 6BA2 85               add  a, l
 280+ 6BA3 6F               ld   l, a
 281+ 6BA4 30 01            jr   nc, .no_carry
 282+ 6BA6 24               inc  h
 283+ 6BA7              .no_carry:
 284+ 6BA7                  ; HL = B * 32 + C
 285+ 6BA7 11 00 58         ld   de, $5800
 286+ 6BAA 19               add  hl, de            ; HL = AttrAddr
 287+ 6BAB
 288+ 6BAB                  ; Ripristina i registri dallo stack per estrarre il colore in E
 289+ 6BAB                  ; Lo stack ha: HL (originale), DE (originale con colore in E), BC (originale)
 290+ 6BAB C1               pop  bc                ; BC = HL originale
 291+ 6BAC D1               pop  de                ; DE = DE originale (colore in E)
 292+ 6BAD
 293+ 6BAD 7B               ld   a, e              ; A = Colore
 294+ 6BAE 77               ld   (hl), a           ; Scrivi in memoria attributi (HL)
 295+ 6BAF
 296+ 6BAF                  ; Ripristina lo stack e i registri originari
 297+ 6BAF C5               push bc                ; Rimetti HL originale sulla pila
 298+ 6BB0 E1               pop  hl                ; HL = HL originale
 299+ 6BB1 C1               pop  bc                ; BC = BC originale
 300+ 6BB2 C9               ret
 301+ 6BB3
 302+ 6BB3              ; -------------------------------------------------------------------
 303+ 6BB3              ; Ripristina la cella dello sfondo originale per cancellare l'item
 304+ 6BB3              ; Input: B = Row (3..18), C = Col (0..31)
 305+ 6BB3              ; -------------------------------------------------------------------
 306+ 6BB3              RestoreBackgroundCell:
 307+ 6BB3 FD E5            push iy                ; Preserva IY
 308+ 6BB5 C5               push bc
 309+ 6BB6 D5               push de
 310+ 6BB7 E5               push hl
 311+ 6BB8 DD E5            push ix
 312+ 6BBA
 313+ 6BBA C5               push bc
 314+ 6BBB FD E1            pop  iy                ; IY = original BC (IYH = Row, IYL = Col)
 315+ 6BBD
 316+ 6BBD                  ; Riga di layout: r = B
 317+ 6BBD 78               ld   a, b
 318+ 6BBE                  ; A = r (0..15)
 319+ 6BBE
 320+ 6BBE                  ; Colonna: c = C (Col)
 321+ 6BBE CD 90 67         call GetCellFromUnpacked ; A = cell type (0..3)
 322+ 6BC1
 323+ 6BC1 ED 5B FE 7A      ld   de, (room_ptr)
 324+ 6BC5 B7               or   a
 325+ 6BC6 20 06            jr   nz, .not_bg
 326+ 6BC8 21 A0 00         ld   hl, OFFSET_BG
 327+ 6BCB 19               add  hl, de
 328+ 6BCC 18 16            jr   .draw_cell
 329+ 6BCE              .not_bg:
 330+ 6BCE 3D               dec  a
 331+ 6BCF 20 06            jr   nz, .not_floor
 332+ 6BD1 21 A9 00         ld   hl, OFFSET_FLOOR
 333+ 6BD4 19               add  hl, de
 334+ 6BD5 18 0D            jr   .draw_cell
 335+ 6BD7              .not_floor:
 336+ 6BD7 3D               dec  a
 337+ 6BD8 20 06            jr   nz, .not_wall
 338+ 6BDA 21 B2 00         ld   hl, OFFSET_WALL
 339+ 6BDD 19               add  hl, de
 340+ 6BDE 18 04            jr   .draw_cell
 341+ 6BE0              .not_wall:
 342+ 6BE0 21 BB 00         ld   hl, OFFSET_NASTY
 343+ 6BE3 19               add  hl, de
 344+ 6BE4
 345+ 6BE4              .draw_cell:
 346+ 6BE4 E5               push hl
 347+ 6BE5 DD E1            pop  ix                ; IX = tile pointer
 348+ 6BE7
 349+ 6BE7 FD E5            push iy
 350+ 6BE9 C1               pop  bc                ; B = Row, C = Col
 351+ 6BEA
 352+ 6BEA CD 6A 61         call DrawTile
 353+ 6BED
 354+ 6BED DD E1            pop  ix
 355+ 6BEF E1               pop  hl
 356+ 6BF0 D1               pop  de
 357+ 6BF1 C1               pop  bc
 358+ 6BF2 FD E1            pop  iy                ; Ripristina IY
 359+ 6BF4 C9               ret
 360+ 6BF5
 361+ 6BF5              ; -------------------------------------------------------------------
 362+ 6BF5              ; Controlla se Willy collide con un item (pixel-level check)
 363+ 6BF5              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 364+ 6BF5              ; Output: Carry set se collide, altrimenti clear
 365+ 6BF5              ; -------------------------------------------------------------------
 366+ 6BF5              CheckWillyItemCollision:
 367+ 6BF5 C5               push bc
 368+ 6BF6 D5               push de
 369+ 6BF7 E5               push hl
 370+ 6BF8
 371+ 6BF8                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 372+ 6BF8 6F               ld   l, a
 373+ 6BF9 7D               ld   a, l
 374+ 6BFA 87               add  a, a              ; *2
 375+ 6BFB 87               add  a, a              ; *4
 376+ 6BFC 87               add  a, a              ; *8
 377+ 6BFD 5F               ld   e, a              ; E = ItemLeft
 378+ 6BFE C6 07            add  a, 7
 379+ 6C00 57               ld   d, a              ; D = ItemRight
 380+ 6C01
 381+ 6C01                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 382+ 6C01 ED 4B E2 77      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 383+ 6C05
 384+ 6C05                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 385+ 6C05 79               ld   a, c
 386+ 6C06 BA               cp   d
 387+ 6C07 28 04            jr   z, .x_ok
 388+ 6C09 38 02            jr   c, .x_ok
 389+ 6C0B 18 29            jr   .no_collision
 390+ 6C0D              .x_ok:
 391+ 6C0D C6 0F            add  a, 15
 392+ 6C0F BB               cp   e
 393+ 6C10 28 04            jr   z, .y_check
 394+ 6C12 30 02            jr   nc, .y_check
 395+ 6C14 18 20            jr   .no_collision
 396+ 6C16
 397+ 6C16              .y_check:
 398+ 6C16 E1               pop  hl                ; Recupera HL originale (H = ItemY)
 399+ 6C17 E5               push hl
 400+ 6C18 7C               ld   a, h
 401+ 6C19 87               add  a, a              ; *2
 402+ 6C1A 87               add  a, a              ; *4
 403+ 6C1B 87               add  a, a              ; *8
 404+ 6C1C 5F               ld   e, a              ; E = ItemTop
 405+ 6C1D C6 07            add  a, 7
 406+ 6C1F 57               ld   d, a              ; D = ItemBottom
 407+ 6C20
 408+ 6C20                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 409+ 6C20 78               ld   a, b
 410+ 6C21 BA               cp   d
 411+ 6C22 28 04            jr   z, .y_ok
 412+ 6C24 38 02            jr   c, .y_ok
 413+ 6C26 18 0E            jr   .no_collision
 414+ 6C28              .y_ok:
 415+ 6C28 C6 0F            add  a, 15
 416+ 6C2A BB               cp   e
 417+ 6C2B 28 04            jr   z, .collision
 418+ 6C2D 30 02            jr   nc, .collision
 419+ 6C2F 18 05            jr   .no_collision
 420+ 6C31
 421+ 6C31              .collision:
 422+ 6C31 E1               pop  hl
 423+ 6C32 D1               pop  de
 424+ 6C33 C1               pop  bc
 425+ 6C34 37               scf                    ; Set carry (collisione!)
 426+ 6C35 C9               ret
 427+ 6C36
 428+ 6C36              .no_collision:
 429+ 6C36 E1               pop  hl
 430+ 6C37 D1               pop  de
 431+ 6C38 C1               pop  bc
 432+ 6C39 B7               or   a                 ; Clear carry
 433+ 6C3A C9               ret
 434+ 6C3B
 435+ 6C3B              ; -------------------------------------------------------------------
 436+ 6C3B              ; Controlla se Willy tocca un item attivo nella stanza corrente
 437+ 6C3B              ; -------------------------------------------------------------------
 438+ 6C3B              CheckRoomItemsCollision:
 439+ 6C3B E5               push hl
 440+ 6C3C D5               push de
 441+ 6C3D C5               push bc
 442+ 6C3E
 443+ 6C3E 21 4F 6A         ld   hl, ItemsTable
 444+ 6C41              .loop:
 445+ 6C41 7E               ld   a, (hl)           ; A = Room ID
 446+ 6C42 FE FF            cp   $FF               ; Fine tabella?
 447+ 6C44 28 37            jr   z, .done
 448+ 6C46
 449+ 6C46                  ; Stanza corrente?
 450+ 6C46 57               ld   d, a              ; D = Room ID
 451+ 6C47 3A F5 7A         ld   a, (current_room)
 452+ 6C4A BA               cp   d
 453+ 6C4B 20 29            jr   nz, .next_item
 454+ 6C4D
 455+ 6C4D 23               inc  hl                ; HL punta a X
 456+ 6C4E 4E               ld   c, (hl)           ; C = X
 457+ 6C4F 23               inc  hl                ; HL punta a Y
 458+ 6C50 46               ld   b, (hl)           ; B = Y
 459+ 6C51 23               inc  hl                ; HL punta al colore (lo saltiamo per il controllo collisione)
 460+ 6C52 23               inc  hl                ; HL punta a collected
 461+ 6C53 7E               ld   a, (hl)           ; A = collected
 462+ 6C54 B7               or   a
 463+ 6C55 20 23            jr   nz, .next_no_inc  ; Già raccolto, salta
 464+ 6C57
 465+ 6C57                  ; Controlla collisione
 466+ 6C57 79               ld   a, c
 467+ 6C58 E5               push hl
 468+ 6C59 60               ld   h, b
 469+ 6C5A CD F5 6B         call CheckWillyItemCollision
 470+ 6C5D E1               pop  hl
 471+ 6C5E 30 1A            jr   nc, .next_no_inc
 472+ 6C60
 473+ 6C60                  ; RACCOLTO!
 474+ 6C60 36 01            ld   (hl), 1           ; Imposta collected = 1
 475+ 6C62
 476+ 6C62 E5               push hl
 477+ 6C63
 478+ 6C63                  ; Incrementa contatore oggetti raccolti
 479+ 6C63 3A EC 77         ld   a, (items_collected)
 480+ 6C66 3C               inc  a
 481+ 6C67 32 EC 77         ld   (items_collected), a
 482+ 6C6A
 483+ 6C6A                  ; Aggiorna stringa e visualizzazione a schermo
 484+ 6C6A CD A9 60         call UpdateItemsCollectedDisplay
 485+ 6C6D
 486+ 6C6D                  ; Cancella item dallo schermo
 487+ 6C6D CD B3 6B         call RestoreBackgroundCell
 488+ 6C70
 489+ 6C70                  ; Suono di raccolta
 490+ 6C70 CD 81 6C         call PlayCollectSound
 491+ 6C73
 492+ 6C73 E1               pop  hl
 493+ 6C74
 494+ 6C74 18 04            jr   .next_no_inc
 495+ 6C76
 496+ 6C76              .next_item:
 497+ 6C76 23               inc  hl                ; salta X
 498+ 6C77 23               inc  hl                ; salta Y
 499+ 6C78 23               inc  hl                ; salta colore
 500+ 6C79 23               inc  hl                ; salta collected
 501+ 6C7A              .next_no_inc:
