 724+ 6A14              ; -------------------------------------------------------------------
 725+ 6A14              CheckWillyOnConveyor:
 726+ 6A14 C5               push bc
 727+ 6A15 D5               push de
 728+ 6A16 E5               push hl
 729+ 6A17
 730+ 6A17 3A 97 73         ld   a, (on_ground)
 731+ 6A1A B7               or   a
 732+ 6A1B 28 44            jr   z, .not_on_conveyor
 733+ 6A1D
 734+ 6A1D 3A A2 76         ld   a, (conveyor_len)
 735+ 6A20 B7               or   a
 736+ 6A21 28 3E            jr   z, .not_on_conveyor
 737+ 6A23
 738+ 6A23 ED 4B 89 73      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 739+ 6A27
 740+ 6A27                  ; Calcola screenRow dei piedi del player: RowPiedi = (Y + 16) / 8
 741+ 6A27 78               ld   a, b
 742+ 6A28 C6 10            add  a, 16
 743+ 6A2A CB 3F            srl  a
 744+ 6A2C CB 3F            srl  a
 745+ 6A2E CB 3F            srl  a                 ; A = (Y + 16) / 8
 746+ 6A30
 747+ 6A30                  ; Confronta con conveyor_row
 748+ 6A30 57               ld   d, a              ; D = RowPiedi
 749+ 6A31 3A A3 76         ld   a, (conveyor_row)
 750+ 6A34 BA               cp   d
 751+ 6A35 20 2A            jr   nz, .not_on_conveyor
 752+ 6A37
 753+ 6A37                  ; ColStart = WillyX / 8
 754+ 6A37 79               ld   a, c
 755+ 6A38 CB 3F            srl  a
 756+ 6A3A CB 3F            srl  a
 757+ 6A3C CB 3F            srl  a                 ; A = ColStart
 758+ 6A3E 5F               ld   e, a              ; E = ColStart
 759+ 6A3F
 760+ 6A3F                  ; ColEnd = (WillyX + 7) / 8
 761+ 6A3F 79               ld   a, c
 762+ 6A40 C6 07            add  a, 7
 763+ 6A42 CB 3F            srl  a
 764+ 6A44 CB 3F            srl  a
 765+ 6A46 CB 3F            srl  a                 ; A = ColEnd
 766+ 6A48 57               ld   d, a              ; D = ColEnd
 767+ 6A49
 768+ 6A49                  ; conveyor_col_end = conveyor_col + conveyor_len - 1
 769+ 6A49 3A A4 76         ld   a, (conveyor_col)
 770+ 6A4C 21 A2 76         ld   hl, conveyor_len
 771+ 6A4F 86               add  a, (hl)
 772+ 6A50 3D               dec  a                 ; A = conveyor_col_end
 773+ 6A51
 774+ 6A51                  ; E <= conveyor_col_end (conveyor_col_end >= E)
 775+ 6A51 BB               cp   e
 776+ 6A52 38 0D            jr   c, .not_on_conveyor
 777+ 6A54
 778+ 6A54                  ; D >= conveyor_col
 779+ 6A54 3A A4 76         ld   a, (conveyor_col)
 780+ 6A57 5F               ld   e, a
 781+ 6A58 7A               ld   a, d
 782+ 6A59 BB               cp   e
 783+ 6A5A 38 05            jr   c, .not_on_conveyor
 784+ 6A5C
 785+ 6A5C                  ; Willy è sul conveyor! Imposta carry
 786+ 6A5C E1               pop  hl
 787+ 6A5D D1               pop  de
 788+ 6A5E C1               pop  bc
 789+ 6A5F 37               scf
 790+ 6A60 C9               ret
 791+ 6A61
 792+ 6A61              .not_on_conveyor:
 793+ 6A61 E1               pop  hl
 794+ 6A62 D1               pop  de
 795+ 6A63 C1               pop  bc
 796+ 6A64 B7               or   a                 ; Clear carry
 797+ 6A65 C9               ret
 798+ 6A66
 799+ 6A66              ; -------------------------------------------------------------------
 800+ 6A66              ; Verifica se la cella (Col in E, Row in D) è sulla rampa, immediatamente sotto di essa,
 801+ 6A66              ; o sulla piattaforma adiacente in cima.
 802+ 6A66              ; Output: Carry flag impostato se è sulla rampa, altrimenti resettato
 803+ 6A66              ; -------------------------------------------------------------------
 804+ 6A66              IsCellOnRamp:
 805+ 6A66 C5               push bc
 806+ 6A67 E5               push hl
 807+ 6A68
 808+ 6A68 3A A6 76         ld   a, (ramp_len)
 809+ 6A6B B7               or   a
 810+ 6A6C 28 6B            jr   z, .no
 811+ 6A6E
 812+ 6A6E                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 813+ 6A6E 3A A5 76         ld   a, (ramp_dir)
 814+ 6A71 B7               or   a
 815+ 6A72 28 1A            jr   z, .range_left
 816+ 6A74              .range_right:
 817+ 6A74 3A A8 76         ld   a, (ramp_col)
 818+ 6A77 47               ld   b, a              ; B = ramp_col
 819+ 6A78 3A A6 76         ld   a, (ramp_len)
 820+ 6A7B 80               add  a, b              ; A = ramp_col + ramp_len
 821+ 6A7C 4F               ld   c, a              ; C = limit_right (exclusive)
 822+ 6A7D
 823+ 6A7D 7B               ld   a, e              ; A = Col
 824+ 6A7E B8               cp   b
 825+ 6A7F 38 34            jr   c, .check_platform_case ; Col < ramp_col
 826+ 6A81 B9               cp   c
 827+ 6A82 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 828+ 6A84
 829+ 6A84                  ; Calcola B = Col - ramp_col
 830+ 6A84 7B               ld   a, e
 831+ 6A85 90               sub  b
 832+ 6A86 47               ld   b, a              ; B = offset (0..ramp_len-1)
 833+ 6A87
 834+ 6A87                  ; SlopeRow = ramp_row - B
 835+ 6A87 3A A7 76         ld   a, (ramp_row)
 836+ 6A8A 90               sub  b
 837+ 6A8B 47               ld   b, a              ; B = SlopeRow
 838+ 6A8C 18 1F            jr   .check_row_match
 839+ 6A8E
 840+ 6A8E              .range_left:
 841+ 6A8E                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 842+ 6A8E 21 A6 76         ld   hl, ramp_len
 843+ 6A91 3A A8 76         ld   a, (ramp_col)
 844+ 6A94 96               sub  (hl)
 845+ 6A95 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 846+ 6A96 47               ld   b, a              ; B = limit_left
 847+ 6A97
 848+ 6A97 3A A8 76         ld   a, (ramp_col)
 849+ 6A9A 3C               inc  a
 850+ 6A9B 4F               ld   c, a              ; C = limit_right (exclusive)
 851+ 6A9C
 852+ 6A9C 7B               ld   a, e              ; A = Col
 853+ 6A9D B8               cp   b
 854+ 6A9E 38 15            jr   c, .check_platform_case
 855+ 6AA0 B9               cp   c
 856+ 6AA1 30 12            jr   nc, .check_platform_case
 857+ 6AA3
 858+ 6AA3                  ; Calcola B = ramp_col - Col
 859+ 6AA3 3A A8 76         ld   a, (ramp_col)
 860+ 6AA6 93               sub  e
 861+ 6AA7 47               ld   b, a              ; B = offset
 862+ 6AA8
 863+ 6AA8                  ; SlopeRow = ramp_row - B
 864+ 6AA8 3A A7 76         ld   a, (ramp_row)
 865+ 6AAB 90               sub  b
 866+ 6AAC 47               ld   b, a              ; B = SlopeRow
 867+ 6AAD
 868+ 6AAD              .check_row_match:
 869+ 6AAD                  ; D (Row) deve essere uguale a SlopeRow (in B) o SlopeRow + 1 (immediatamente sotto)
 870+ 6AAD 7A               ld   a, d              ; A = Row
 871+ 6AAE B8               cp   b
 872+ 6AAF 28 2C            jr   z, .yes           ; Row == SlopeRow
 873+ 6AB1 04               inc  b                 ; B = SlopeRow + 1
 874+ 6AB2 B8               cp   b
 875+ 6AB3 28 28            jr   z, .yes           ; Row == SlopeRow + 1
 876+ 6AB5
 877+ 6AB5              .check_platform_case:
 878+ 6AB5                  ; 2. Controlla se è sulla piattaforma adiacente in cima
 879+ 6AB5 3A A5 76         ld   a, (ramp_dir)
 880+ 6AB8 B7               or   a
 881+ 6AB9 28 09            jr   z, .plat_left
 882+ 6ABB              .plat_right:
 883+ 6ABB 3A A8 76         ld   a, (ramp_col)
 884+ 6ABE 21 A6 76         ld   hl, ramp_len
 885+ 6AC1 86               add  a, (hl)           ; A = ramp_col + ramp_len
 886+ 6AC2 18 07            jr   .compare_plat
 887+ 6AC4              .plat_left:
 888+ 6AC4 3A A8 76         ld   a, (ramp_col)
 889+ 6AC7 21 A6 76         ld   hl, ramp_len
 890+ 6ACA 96               sub  (hl)              ; A = ramp_col - ramp_len
 891+ 6ACB              .compare_plat:
 892+ 6ACB BB               cp   e                 ; Compare with Col
 893+ 6ACC 20 0B            jr   nz, .no
 894+ 6ACE
 895+ 6ACE 3A A7 76         ld   a, (ramp_row)
 896+ 6AD1 21 A6 76         ld   hl, ramp_len
 897+ 6AD4 96               sub  (hl)
 898+ 6AD5 3C               inc  a                 ; A = ramp_row - ramp_len + 1
 899+ 6AD6 BA               cp   d                 ; Compare with Row
 900+ 6AD7 28 04            jr   z, .yes
 901+ 6AD9
 902+ 6AD9              .no:
 903+ 6AD9 E1               pop  hl
 904+ 6ADA C1               pop  bc
 905+ 6ADB B7               or   a
 906+ 6ADC C9               ret
 907+ 6ADD
 908+ 6ADD              .yes:
 909+ 6ADD E1               pop  hl
 910+ 6ADE C1               pop  bc
 911+ 6ADF 37               scf
 912+ 6AE0 C9               ret
 913+ 6AE1
 914+ 6AE1              ; -------------------------------------------------------------------
 915+ 6AE1              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 916+ 6AE1              ; Input: C = X, B = Y
 917+ 6AE1              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 918+ 6AE1              ; -------------------------------------------------------------------
 919+ 6AE1              CheckWallCell:
 920+ 6AE1 E5               push hl
 921+ 6AE2 D5               push de
 922+ 6AE3 C5               push bc
 923+ 6AE4
 924+ 6AE4                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 925+ 6AE4 78               ld   a, b
 926+ 6AE5 FE 80            cp   128
 927+ 6AE7 30 1F            jr   nc, .not_wall
 928+ 6AE9
 929+ 6AE9                  ; 2. Calcola riga di layout: r = Y / 8
 930+ 6AE9 CB 3F            srl  a
 931+ 6AEB CB 3F            srl  a
 932+ 6AED CB 3F            srl  a                 ; A = r (0..15)
 933+ 6AEF
 934+ 6AEF                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 935+ 6AEF 5F               ld   e, a              ; E = r (Row)
 936+ 6AF0 79               ld   a, c
 937+ 6AF1 CB 3F            srl  a
 938+ 6AF3 CB 3F            srl  a
 939+ 6AF5 CB 3F            srl  a                 ; A = c (0..31)
 940+ 6AF7 4F               ld   c, a              ; C = c (Col)
 941+ 6AF8
 942+ 6AF8                  ; Se la cella è sulla rampa, non considerarla un muro!
 943+ 6AF8 53               ld   d, e              ; D = Row
 944+ 6AF9 59               ld   e, c              ; E = Col
 945+ 6AFA CD 66 6A         call IsCellOnRamp
 946+ 6AFD 38 09            jr   c, .not_wall
 947+ 6AFF
 948+ 6AFF 7A               ld   a, d              ; A = Row
 949+ 6B00 4B               ld   c, e              ; C = Col
 950+ 6B01 CD 61 6B         call GetCellFromUnpacked ; A = cell type
 951+ 6B04
 952+ 6B04                  ; Controlla se è Wall (2)
 953+ 6B04 FE 02            cp   2
 954+ 6B06 28 05            jr   z, .is_wall
 955+ 6B08
 956+ 6B08              .not_wall:
 957+ 6B08 C1               pop  bc
 958+ 6B09 D1               pop  de
 959+ 6B0A E1               pop  hl
 960+ 6B0B B7               or   a                 ; Clear carry
 961+ 6B0C C9               ret
 962+ 6B0D
 963+ 6B0D              .is_wall:
 964+ 6B0D C1               pop  bc
 965+ 6B0E D1               pop  de
 966+ 6B0F E1               pop  hl
 967+ 6B10 37               scf                    ; Set carry
 968+ 6B11 C9               ret
 969+ 6B12
 970+ 6B12
 971+ 6B12              ; -------------------------------------------------------------------
 972+ 6B12              ; Controlla se Willy collide orizzontalmente con un Wall alle coordinate specificate
 973+ 6B12              ; Input: C = X pixel (da controllare), B = Y pixel (attuale)
 974+ 6B12              ; Output: Carry flag impostato se c'è collisione, altrimenti resettato
 975+ 6B12              ; -------------------------------------------------------------------
 976+ 6B12              CheckWillyWallCollision:
 977+ 6B12 C5               push bc
 978+ 6B13
 979+ 6B13                  ; 1. Punto superiore: (X, Y)
 980+ 6B13 CD E1 6A         call CheckWallCell
 981+ 6B16 38 17            jr   c, .collision
 982+ 6B18
 983+ 6B18                  ; 2. Punto medio: (X, Y + 7)
 984+ 6B18 78               ld   a, b
 985+ 6B19 C6 07            add  a, 7
 986+ 6B1B 47               ld   b, a
 987+ 6B1C CD E1 6A         call CheckWallCell
 988+ 6B1F 38 0E            jr   c, .collision
 989+ 6B21
 990+ 6B21                  ; 3. Punto inferiore: (X, Y + 15)
 991+ 6B21 C1               pop  bc
 992+ 6B22 C5               push bc
 993+ 6B23 78               ld   a, b
 994+ 6B24 C6 0F            add  a, 15
 995+ 6B26 47               ld   b, a
 996+ 6B27 CD E1 6A         call CheckWallCell
 997+ 6B2A 38 03            jr   c, .collision
 998+ 6B2C
 999+ 6B2C C1               pop  bc
1000+ 6B2D B7               or   a                 ; Reset carry (nessuna collisione)
1001+ 6B2E C9               ret
1002+ 6B2F
1003+ 6B2F              .collision:
1004+ 6B2F C1               pop  bc
1005+ 6B30 37               scf                    ; Set carry (collisione avvenuta)
1006+ 6B31 C9               ret
1007+ 6B32
1008+ 6B32              ; -------------------------------------------------------------------
1009+ 6B32              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1010+ 6B32              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1011+ 6B32              ; -------------------------------------------------------------------
1012+ 6B32              UnpackRoomLayout:
1013+ 6B32 E5               push hl
1014+ 6B33 D5               push de
1015+ 6B34 C5               push bc
1016+ 6B35
1017+ 6B35 2A FA 76         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1018+ 6B38 11 A0 74         ld   de, unpacked_layout ; DE = buffer RAM
1019+ 6B3B 06 80            ld   b, 128             ; 128 byte
1020+ 6B3D              .byte_loop:
1021+ 6B3D 7E               ld   a, (hl)            ; Leggi byte compresso
1022+ 6B3E 23               inc  hl
1023+ 6B3F
1024+ 6B3F 4F               ld   c, a               ; C = salvataggio
1025+ 6B40
1026+ 6B40                  ; Cella 0: bit 7-6
1027+ 6B40 07               rlca
1028+ 6B41 07               rlca
1029+ 6B42 E6 03            and  3
1030+ 6B44 12               ld   (de), a
1031+ 6B45 13               inc  de
1032+ 6B46
1033+ 6B46                  ; Cella 1: bit 5-4
1034+ 6B46 79               ld   a, c
1035+ 6B47 07               rlca
1036+ 6B48 07               rlca
1037+ 6B49 07               rlca
1038+ 6B4A 07               rlca
1039+ 6B4B E6 03            and  3
1040+ 6B4D 12               ld   (de), a
1041+ 6B4E 13               inc  de
1042+ 6B4F
1043+ 6B4F                  ; Cella 2: bit 3-2
1044+ 6B4F 79               ld   a, c
1045+ 6B50 0F               rrca
1046+ 6B51 0F               rrca
1047+ 6B52 E6 03            and  3
1048+ 6B54 12               ld   (de), a
1049+ 6B55 13               inc  de
1050+ 6B56
1051+ 6B56                  ; Cella 3: bit 1-0
1052+ 6B56 79               ld   a, c
1053+ 6B57 E6 03            and  3
1054+ 6B59 12               ld   (de), a
1055+ 6B5A 13               inc  de
1056+ 6B5B
1057+ 6B5B 10 E0            djnz .byte_loop
1058+ 6B5D
1059+ 6B5D C1               pop  bc
1060+ 6B5E D1               pop  de
1061+ 6B5F E1               pop  hl
1062+ 6B60 C9               ret
1063+ 6B61
1064+ 6B61              ; -------------------------------------------------------------------
1065+ 6B61              ; Legge il tipo di cella dal buffer decompresso in RAM
1066+ 6B61              ; Input: A = Row (0..15), C = Col (0..31)
1067+ 6B61              ; Output: A = tipo di cella (0..3)
1068+ 6B61              ; Preserva tutti gli altri registri.
1069+ 6B61              ; -------------------------------------------------------------------
1070+ 6B61              GetCellFromUnpacked:
1071+ 6B61 E5               push hl
1072+ 6B62 D5               push de
1073+ 6B63
1074+ 6B63 6F               ld   l, a
1075+ 6B64 26 00            ld   h, 0
1076+ 6B66 29               add  hl, hl
1077+ 6B67 29               add  hl, hl
1078+ 6B68 29               add  hl, hl
1079+ 6B69 29               add  hl, hl
1080+ 6B6A 29               add  hl, hl            ; HL = Row * 32
1081+ 6B6B 59               ld   e, c
1082+ 6B6C 16 00            ld   d, 0
1083+ 6B6E 19               add  hl, de            ; HL = Row * 32 + Col
1084+ 6B6F 11 A0 74         ld   de, unpacked_layout
1085+ 6B72 19               add  hl, de
1086+ 6B73 7E               ld   a, (hl)           ; A = cell type
1087+ 6B74
1088+ 6B74 D1               pop  de
1089+ 6B75 E1               pop  hl
1090+ 6B76 C9               ret
1091+ 6B77
1092+ 6B77              ; -------------------------------------------------------------------
1093+ 6B77              ; GetRampY
1094+ 6B77              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1095+ 6B77              ; Input: C = PlayerX
1096+ 6B77              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1097+ 6B77              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1098+ 6B77              ; -------------------------------------------------------------------
1099+ 6B77              GetRampY:
1100+ 6B77 3A A6 76         ld   a, (ramp_len)
1101+ 6B7A B7               or   a
1102+ 6B7B C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1103+ 6B7C
1104+ 6B7C 3A A5 76         ld   a, (ramp_dir)
1105+ 6B7F B7               or   a
1106+ 6B80 28 4C            jr   z, .dir_left
1107+ 6B82
1108+ 6B82              .dir_right:
1109+ 6B82                  ; Rampa sale a destra (up-right)
1110+ 6B82 3A A8 76         ld   a, (ramp_col)
1111+ 6B85 87               add  a, a              ; *2
1112+ 6B86 87               add  a, a              ; *4
1113+ 6B87 87               add  a, a              ; *8 (X start in pixel)
1114+ 6B88 5F               ld   e, a              ; E = X_left
1115+ 6B89
1116+ 6B89 3A A6 76         ld   a, (ramp_len)
1117+ 6B8C 87               add  a, a              ; *2
1118+ 6B8D 87               add  a, a              ; *4
1119+ 6B8E 87               add  a, a              ; *8
1120+ 6B8F 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1121+ 6B90 67               ld   h, a              ; H = X_right_boundary
1122+ 6B91
1123+ 6B91 79               ld   a, c              ; A = PlayerX
1124+ 6B92 BB               cp   e
1125+ 6B93 DA 28 6C         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1126+ 6B96
1127+ 6B96 BC               cp   h
1128+ 6B97 38 15            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1129+ 6B99
1130+ 6B99                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1131+ 6B99 94               sub  h                 ; A = PlayerX - X_right_boundary
1132+ 6B9A FE 08            cp   8
1133+ 6B9C D2 28 6C         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1134+ 6B9F
1135+ 6B9F                  ; Piattaforma adiacente! Restituisci PlayerY = (ramp_row - ramp_len + 1) * 8 - 16
1136+ 6B9F 3A A7 76         ld   a, (ramp_row)
1137+ 6BA2 21 A6 76         ld   hl, ramp_len
1138+ 6BA5 96               sub  (hl)
1139+ 6BA6 3C               inc  a                 ; A = Row
1140+ 6BA7 87               add  a, a              ; *2
1141+ 6BA8 87               add  a, a              ; *4
1142+ 6BA9 87               add  a, a              ; *8
1143+ 6BAA D6 10            sub  16                ; A = Row * 8 - 16
1144+ 6BAC 37               scf                    ; Set carry (dentro rampa/piattaforma)
1145+ 6BAD C9               ret
1146+ 6BAE
1147+ 6BAE              .on_ramp_slope:
1148+ 6BAE 3A A7 76         ld   a, (ramp_row)
1149+ 6BB1 87               add  a, a              ; *2
1150+ 6BB2 87               add  a, a              ; *4
1151+ 6BB3 87               add  a, a              ; *8
1152+ 6BB4 D6 10            sub  16                ; A = ramp_row * 8 - 16
1153+ 6BB6 83               add  a, e              ; A = ramp_row * 8 - 16 + X_left
1154+ 6BB7 91               sub  c                 ; A = A - PlayerX
1155+ 6BB8
1156+ 6BB8                  ; Calcola la quota della piattaforma:
1157+ 6BB8                  ; platform_Y = (ramp_row - ramp_len + 1) * 8 - 16
1158+ 6BB8 57               ld   d, a              ; D = calculated Y
1159+ 6BB9
1160+ 6BB9 3A A7 76         ld   a, (ramp_row)
1161+ 6BBC 21 A6 76         ld   hl, ramp_len
1162+ 6BBF 96               sub  (hl)
1163+ 6BC0 3C               inc  a                 ; A = Row
1164+ 6BC1 87               add  a, a              ; *2
1165+ 6BC2 87               add  a, a              ; *4
1166+ 6BC3 87               add  a, a              ; *8
1167+ 6BC4 D6 10            sub  16                ; A = platform_Y
1168+ 6BC6
1169+ 6BC6 BA               cp   d                 ; Compara platform_Y con calculated Y
1170+ 6BC7 38 02            jr   c, .no_clamp      ; Se platform_Y < calculated Y, non limitare
1171+ 6BC9
1172+ 6BC9                  ; Altrimenti, limita a platform_Y
1173+ 6BC9 37               scf                    ; Set carry (dentro rampa)
1174+ 6BCA C9               ret
1175+ 6BCB
1176+ 6BCB              .no_clamp:
1177+ 6BCB 7A               ld   a, d              ; Ripristina A = calculated Y
1178+ 6BCC 37               scf                    ; Set carry
1179+ 6BCD C9               ret
1180+ 6BCE
1181+ 6BCE              .dir_left:
1182+ 6BCE                  ; Rampa sale a sinistra (up-left)
