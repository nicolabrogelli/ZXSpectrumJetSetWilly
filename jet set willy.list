 277+ 7573              ; -------------------------------------------------------------------
 278+ 7573              ; Controlla se Willy collide con un item (pixel-level check)
 279+ 7573              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 280+ 7573              ; Output: Carry set se collide, altrimenti clear
 281+ 7573              ; -------------------------------------------------------------------
 282+ 7573              CheckWillyItemCollision:
 283+ 7573 C5               push bc
 284+ 7574 D5               push de
 285+ 7575 E5               push hl
 286+ 7576
 287+ 7576                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 288+ 7576 6F               ld   l, a
 289+ 7577 7D               ld   a, l
 290+ 7578 87               add  a, a              ; *2
 291+ 7579 87               add  a, a              ; *4
 292+ 757A 87               add  a, a              ; *8
 293+ 757B 5F               ld   e, a              ; E = ItemLeft
 294+ 757C C6 07            add  a, 7
 295+ 757E 57               ld   d, a              ; D = ItemRight
 296+ 757F
 297+ 757F                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 298+ 757F ED 4B B3 76      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 299+ 7583
 300+ 7583                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 301+ 7583 79               ld   a, c
 302+ 7584 BA               cp   d
 303+ 7585 28 04            jr   z, .x_ok
 304+ 7587 38 02            jr   c, .x_ok
 305+ 7589 18 29            jr   .no_collision
 306+ 758B              .x_ok:
 307+ 758B C6 0F            add  a, 15
 308+ 758D BB               cp   e
 309+ 758E 28 04            jr   z, .y_check
 310+ 7590 30 02            jr   nc, .y_check
 311+ 7592 18 20            jr   .no_collision
 312+ 7594
 313+ 7594              .y_check:
 314+ 7594 E1               pop  hl                ; Recupera HL originale (H = ItemY)
 315+ 7595 E5               push hl
 316+ 7596 7C               ld   a, h
 317+ 7597 87               add  a, a              ; *2
 318+ 7598 87               add  a, a              ; *4
 319+ 7599 87               add  a, a              ; *8
 320+ 759A 5F               ld   e, a              ; E = ItemTop
 321+ 759B C6 07            add  a, 7
 322+ 759D 57               ld   d, a              ; D = ItemBottom
 323+ 759E
 324+ 759E                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 325+ 759E 78               ld   a, b
 326+ 759F BA               cp   d
 327+ 75A0 28 04            jr   z, .y_ok
 328+ 75A2 38 02            jr   c, .y_ok
 329+ 75A4 18 0E            jr   .no_collision
 330+ 75A6              .y_ok:
 331+ 75A6 C6 0F            add  a, 15
 332+ 75A8 BB               cp   e
 333+ 75A9 28 04            jr   z, .collision
 334+ 75AB 30 02            jr   nc, .collision
 335+ 75AD 18 05            jr   .no_collision
 336+ 75AF
 337+ 75AF              .collision:
 338+ 75AF E1               pop  hl
 339+ 75B0 D1               pop  de
 340+ 75B1 C1               pop  bc
 341+ 75B2 37               scf                    ; Set carry (collisione!)
 342+ 75B3 C9               ret
 343+ 75B4
 344+ 75B4              .no_collision:
 345+ 75B4 E1               pop  hl
 346+ 75B5 D1               pop  de
 347+ 75B6 C1               pop  bc
 348+ 75B7 B7               or   a                 ; Clear carry
 349+ 75B8 C9               ret
