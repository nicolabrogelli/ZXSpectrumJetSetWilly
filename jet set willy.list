 217  8956 10 FD            djnz .death_pause
 218  8958
 219  8958                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 220  8958 AF               xor  a
 221  8959 32 F0 F4         ld   (velocity_y), a
 222  895C 32 F2 F4         ld   (jump_pressed), a
