 103  7B8A              .raster_loop:
 104  7B8A D3 FE            out  ($fe), a
 105  7B8C 3C               inc  a
 106  7B8D E6 07            and  7
 107  7B8F 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 108  7B91              .delay:
 109  7B91 0D               dec  c
 110  7B92 20 FD            jr   nz, .delay
 111  7B94 10 F4            djnz .raster_loop
 112  7B96
