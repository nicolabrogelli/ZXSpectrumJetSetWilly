223+  5E9D              .line_loop:
224+  5E9D DD 56 00         ld   d, (ix+0)     ; D = primo byte dello sprite
225+  5EA0 DD 5E 01         ld   e, (ix+1)     ; E = secondo byte dello sprite
226+  5EA3
227+  5EA3                  ; Esegui lo shift a destra se necessario
228+  5EA3 3A 26 6C         ld   a, (sprite_shift)
229+  5EA6 B7               or   a
230+  5EA7 28 15            jr   z, .no_shift
231+  5EA9
232+  5EA9 C5               push bc            ; Salva il contatore delle linee (C) e lo shift (B)
233+  5EAA 47               ld   b, a          ; B = contatore shift
234+  5EAB AF               xor  a             ; A = terzo byte (inizializzato a 0)
235+  5EAC
