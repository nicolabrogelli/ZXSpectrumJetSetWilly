1080+ 8308              ; Items_DrawRoom
1081+ 8308              ;
1082+ 8308              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1083+ 8308              ;
1084+ 8308              ; Operazioni eseguite:
1085+ 8308              ;   1. Azzera la griglia items_grid.
1086+ 8308              ;   2. Svuota la cache degli oggetti attivi.
1087+ 8308              ;   3. Scansiona ItemsTable.
1088+ 8308              ;   4. Per ogni item della stanza corrente:
1089+ 8308              ;        - verifica se è già stato raccolto
1090+ 8308              ;        - disegna la grafica
1091+ 8308              ;        - aggiorna items_grid
1092+ 8308              ;        - memorizza l'item nella cache current_room_items
1093+ 8308              ;   5. Aggiorna num_room_items.
1094+ 8308              ;
1095+ 8308              ; Record ItemsTable:
1096+ 8308              ;   +0  Room ID
1097+ 8308              ;   +1  X (colonna)
1098+ 8308              ;   +2  Y (riga)
1099+ 8308              ;   +3  Colore
1100+ 8308              ;   +4  Collected flag
1101+ 8308              ;
1102+ 8308              ; Cache current_room_items:
1103+ 8308              ;   +0  Colonna
1104+ 8308              ;   +1  Riga
1105+ 8308              ;   +2  Colore
1106+ 8308              ;   +3  Collected flag ptr (Low)
1107+ 8308              ;   +4  Collected flag ptr (High)
1108+ 8308              ;
1109+ 8308              ; Ogni record cache occupa 5 byte.
1110+ 8308              ; -------------------------------------------------------------------
1111+ 8308              ; ResetItemsTable
1112+ 8308              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1113+ 8308              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1114+ 8308              ; -------------------------------------------------------------------
1115+ 8308              ResetItemsTable:
1116+ 8308 21 B1 7D         ld   hl, ItemsTable
1117+ 830B              .reset_loop:
1118+ 830B 7E               ld   a, (hl)
1119+ 830C FE FF            cp   $FF
1120+ 830E C8               ret  z
1121+ 830F 23               inc  hl                        ; +1 (X)
1122+ 8310 23               inc  hl                        ; +2 (Y)
1123+ 8311 23               inc  hl                        ; +3 (Color)
1124+ 8312 23               inc  hl                        ; +4 (Collected flag)
1125+ 8313 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1126+ 8315 23               inc  hl                        ; Prossimo record
1127+ 8316 18 F3            jr   .reset_loop
