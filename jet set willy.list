   6+ 67C6              ; MovePlayer
   7+ 67C6              ;
   8+ 67C6              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 67C6              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 67C6              ; con i muri.
  11+ 67C6              ;
  12+ 67C6              ; Input:
  13+ 67C6              ;   D = stato dei controlli (bitfield)
  14+ 67C6              ;
  15+ 67C6              ; Strutture utilizzate:
  16+ 67C6              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 67C6              ;   player_speed    -> velocità orizzontale
  18+ 67C6              ;   flags           -> flag di stato input
  19+ 67C6              ;
  20+ 67C6              ; Bit controlli:
  21+ 67C6              ;   bit 0 = sinistra
  22+ 67C6              ;   bit 1 = destra
  23+ 67C6              ;
  24+ 67C6              ; Nota:
  25+ 67C6              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 67C6              ;   ignorato per tutta la durata del salto.
  27+ 67C6              ;
  28+ 67C6              ; Output:
  29+ 67C6              ;   aggiorna PlayerPos e body_state
