 447  88A2                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 448  88A2 3E 30            ld   a, '0'
 449  88A4 32 54 67         ld   (status_line + 16), a
 450  88A7 32 55 67         ld   (status_line + 17), a
 451  88AA 32 56 67         ld   (status_line + 18), a
