 255+ 5EE4 C2 ED 5E         jp   nz, .normal_grid  ; If not equal, not on ramp!
 256+ 5EE7
 257+ 5EE7 21 C4 00         ld   hl, OFFSET_RAMP
 258+ 5EEA C3 0C 5F         jp   .load_tile
 259+ 5EED
 260+ 5EED              .normal_grid:
 261+ 5EED 7B               ld   a, e              ; A = r (Row, calculated at the start of GetBackgroundByte)
 262+ 5EEE                  ; C already contains c (Col, calculated at the start of GetBackgroundByte)
 263+ 5EEE CD 3D 67         call GetCellFromUnpacked ; A = cell type (0..3)
 264+ 5EF1
 265+ 5EF1
 266+ 5EF1                  ; 5. Ottieni il puntatore al tile corrispondente
