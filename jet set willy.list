2019+ 87D8              ; CheckActiveItemAtCell
2020+ 87D8              ;
2021+ 87D8              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2022+ 87D8              ; nella cella specificata della griglia items_grid.
2023+ 87D8              ;
2024+ 87D8              ; Questa routine usa una lookup diretta su una mappa 32x16,
2025+ 87D8              ; evitando la scansione della ItemsTable.
2026+ 87D8              ;
2027+ 87D8              ; Input:
2028+ 87D8              ;   B = Colonna (0..31)
2029+ 87D8              ;   C = Riga (0..15)
2030+ 87D8              ;
2031+ 87D8              ; Output:
2032+ 87D8              ;   Carry Set   = item presente nella cella
2033+ 87D8              ;   Carry Clear = nessun item
2034+ 87D8              ;
2035+ 87D8              ; Nota:
2036+ 87D8              ;   HL NON è restituito valido (commento originale non corretto:
2037+ 87D8              ;   la routine non punta a ItemsTable).
2038+ 87D8              ; -------------------------------------------------------------------
2039+ 87D8              CheckActiveItemAtCell:
2040+ 87D8
2041+ 87D8                  ; Salva registri usati
2042+ 87D8 D5               push de
2043+ 87D9 E5               push hl
2044+ 87DA
2045+ 87DA                  ; ---------------------------------------------------------------
2046+ 87DA                  ; Calcolo indice lineare nella griglia 32x16:
2047+ 87DA                  ;
2048+ 87DA                  ; offset = Row * 32 + Col
2049+ 87DA                  ; ---------------------------------------------------------------
2050+ 87DA 26 00            ld   h, 0
2051+ 87DC 69               ld   l, c              ; HL = Row
2052+ 87DD
2053+ 87DD 29               add  hl, hl            ; *2
2054+ 87DE 29               add  hl, hl            ; *4
2055+ 87DF 29               add  hl, hl            ; *8
2056+ 87E0 29               add  hl, hl            ; *16
2057+ 87E1 29               add  hl, hl            ; *32
2058+ 87E2
2059+ 87E2                  ; Aggiunge la colonna
2060+ 87E2 58               ld   e, b
2061+ 87E3 16 00            ld   d, 0
2062+ 87E5 19               add  hl, de            ; HL = Row*32 + Col
2063+ 87E6
2064+ 87E6                  ; ---------------------------------------------------------------
2065+ 87E6                  ; Accesso alla griglia degli item attivi
2066+ 87E6                  ; ---------------------------------------------------------------
2067+ 87E6 11 57 F2         ld   de, items_grid
2068+ 87E9 19               add  hl, de            ; HL = address cella
2069+ 87EA
2070+ 87EA                  ; ---------------------------------------------------------------
2071+ 87EA                  ; Controllo presenza item
2072+ 87EA                  ;
2073+ 87EA                  ; items_grid contiene:
2074+ 87EA                  ;   0 = nessun item
2075+ 87EA                  ;   >0 = item attivo (colore o flag)
2076+ 87EA                  ; ---------------------------------------------------------------
2077+ 87EA 7E               ld   a, (hl)
2078+ 87EB B7               or   a
2079+ 87EC 28 04            jr   z, .not_active
2080+ 87EE
2081+ 87EE                  ; ---------------------------------------------------------------
2082+ 87EE                  ; Item trovato
2083+ 87EE                  ; ---------------------------------------------------------------
2084+ 87EE E1               pop  hl
2085+ 87EF D1               pop  de
2086+ 87F0
2087+ 87F0 37               scf                    ; Carry = 1
2088+ 87F1 C9               ret
2089+ 87F2
2090+ 87F2              .not_active:
2091+ 87F2
2092+ 87F2                  ; ---------------------------------------------------------------
2093+ 87F2                  ; Nessun item nella cella
2094+ 87F2                  ; ---------------------------------------------------------------
2095+ 87F2 E1               pop  hl
2096+ 87F3 D1               pop  de
2097+ 87F4
2098+ 87F4 B7               or   a                 ; Carry = 0
2099+ 87F5 C9               ret
