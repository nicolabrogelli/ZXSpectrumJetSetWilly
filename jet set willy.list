 552  8AF7              ; -------------------------------------------------------------------
 553  8AF7              ; TriggerVictory
 554  8AF7              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 555  8AF7              ; - Pulisce gli elementi di gioco della stanza.
 556  8AF7              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 557  8AF7              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 558  8AF7              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 559  8AF7              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 560  8AF7              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 561  8AF7              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 562  8AF7              ; -------------------------------------------------------------------
 563  8AF7              TriggerVictory:
 564  8AF7                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 565  8AF7 CD 15 66         call Gfx_DrawVictoryScreen
 566  8AFA
 567  8AFA                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 568  8AFA              .wait_keys_release:
 569  8AFA 76               halt
 570  8AFB                  ; Controlla tasto Y (Porta $DF, bit 4)
 571  8AFB 01 FE DF         ld   bc, $dffe
 572  8AFE ED 78            in   a, (c)
 573  8B00 CB 67            bit  4, a
 574  8B02 28 F6            jr   z, .wait_keys_release
 575  8B04
 576  8B04                  ; Controlla tasto N (Porta $7F, bit 3)
 577  8B04 01 FE 7F         ld   bc, $7ffe
 578  8B07 ED 78            in   a, (c)
 579  8B09 CB 5F            bit  3, a
 580  8B0B 28 ED            jr   z, .wait_keys_release
 581  8B0D
 582  8B0D                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 583  8B0D 01 FE BF         ld   bc, $bffe
 584  8B10 ED 78            in   a, (c)
 585  8B12 CB 47            bit  0, a
 586  8B14 28 E4            jr   z, .wait_keys_release
 587  8B16
 588  8B16                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 589  8B16 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 590  8B18              .wait_choice_loop:
 591  8B18 76               halt
 592  8B19
 593  8B19                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 594  8B19 0C               inc  c
 595  8B1A 79               ld   a, c
 596  8B1B CB 3F            srl  a
 597  8B1D CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 598  8B1F E6 07            and  7
 599  8B21 5F               ld   e, a
 600  8B22 16 00            ld   d, 0
 601  8B24 21 F4 64         ld   hl, victory_color_table
 602  8B27 19               add  hl, de
 603  8B28 7E               ld   a, (hl)               ; A = nuovo colore attributo
 604  8B29 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 605  8B2C 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 606  8B2E              .color_cycle_loop:
 607  8B2E 77               ld   (hl), a
 608  8B2F 23               inc  hl
 609  8B30 10 FC            djnz .color_cycle_loop
 610  8B32
 611  8B32                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 612  8B32 01 FE DF         ld   bc, $dffe
 613  8B35 ED 78            in   a, (c)
 614  8B37 CB 67            bit  4, a
 615  8B39 28 2A            jr   z, .play_again_chosen
 616  8B3B
 617  8B3B                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 618  8B3B 01 FE 7F         ld   bc, $7ffe
 619  8B3E ED 78            in   a, (c)
 620  8B40 CB 5F            bit  3, a
 621  8B42 28 0B            jr   z, .quit_chosen
 622  8B44
 623  8B44                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 624  8B44 01 FE BF         ld   bc, $bffe
 625  8B47 ED 78            in   a, (c)
 626  8B49 CB 47            bit  0, a
 627  8B4B 28 02            jr   z, .quit_chosen
 628  8B4D
 629  8B4D 18 C9            jr   .wait_choice_loop
 630  8B4F
 631  8B4F              .quit_chosen:
 632  8B4F                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 633  8B4F              .wait_quit_release:
 634  8B4F 76               halt
 635  8B50 01 FE 7F         ld   bc, $7ffe
 636  8B53 ED 78            in   a, (c)
 637  8B55 CB 5F            bit  3, a
 638  8B57 28 F6            jr   z, .wait_quit_release
 639  8B59 01 FE BF         ld   bc, $bffe
 640  8B5C ED 78            in   a, (c)
 641  8B5E CB 47            bit  0, a
 642  8B60 28 ED            jr   z, .wait_quit_release
 643  8B62
 644  8B62                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 645  8B62 C3 7F 89         jp   ShowTitleScreen
 646  8B65
 647  8B65              .play_again_chosen:
 648  8B65                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 649  8B65              .wait_play_again_release:
 650  8B65 76               halt
 651  8B66 01 FE DF         ld   bc, $dffe
 652  8B69 ED 78            in   a, (c)
 653  8B6B CB 67            bit  4, a
 654  8B6D 28 F6            jr   z, .wait_play_again_release
 655  8B6F
 656  8B6F                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 657  8B6F CD 2F 8C         call ResetFullGameState
 658  8B72 C3 61 88         jp   LoadRoomAndRestart
 659  8B75
 660  8B75              ; -------------------------------------------------------------------
 661  8B75              ; CheckVictoryCondition
 662  8B75              ; Verifica se si verificano contemporaneamente tutte le 3 condizioni di vittoria:
 663  8B75              ; 1. Willy ha raccolto tutti gli oggetti collezionabili del gioco (tutti i flag in ItemsTable = 1);
 664  8B75              ; 2. Willy si trova nella stanza Master Bedroom;
 665  8B75              ; 3. Willy collide con un oggetto/tag di tipo Conveyor in quella stanza.
 666  8B75              ;
 667  8B75              ; Output:
 668  8B75              ;   Carry Flag = 1 se la vittoria è attivata
 669  8B75              ;   Carry Flag = 0 altrimenti
 670  8B75              ; -------------------------------------------------------------------
 671  8B75              CheckVictoryCondition:
 672  8B75 C5               push bc
 673  8B76 D5               push de
 674  8B77 E5               push hl
 675  8B78
 676  8B78                  ; 1. Condizione: tutti gli item raccolti?
 677  8B78 CD 91 8B         call CheckAllItemsCollected
 678  8B7B 30 0F            jr   nc, .no_victory
 679  8B7D
 680  8B7D                  ; 2. Condizione: Willy è nella Master Bedroom?
 681  8B7D CD B8 8B         call CheckInMasterBedroom
 682  8B80 30 0A            jr   nc, .no_victory
 683  8B82
 684  8B82                  ; 3. Condizione: Willy collide con il conveyor?
 685  8B82 CD D4 8B         call CheckWillyConveyorCollision
 686  8B85 30 05            jr   nc, .no_victory
 687  8B87
 688  8B87                  ; Tutte le condizioni sono soddisfatte contemporaneamente!
 689  8B87 E1               pop  hl
 690  8B88 D1               pop  de
 691  8B89 C1               pop  bc
 692  8B8A 37               scf
 693  8B8B C9               ret
 694  8B8C
 695  8B8C              .no_victory:
 696  8B8C E1               pop  hl
 697  8B8D D1               pop  de
 698  8B8E C1               pop  bc
 699  8B8F B7               or   a
 700  8B90 C9               ret
 701  8B91
 702  8B91              ; -------------------------------------------------------------------
 703  8B91              ; CheckAllItemsCollected
 704  8B91              ; Verifica che tutti gli item del gioco siano stati raccolti.
 705  8B91              ; - Controllo preliminare sul conteggio/flag globale
 706  8B91              ; - Verifica puntuale che ogni record in ItemsTable abbia flag = 1 (raccolto)
 707  8B91              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 708  8B91              ; -------------------------------------------------------------------
 709  8B91              CheckAllItemsCollected:
 710  8B91 E5               push hl
 711  8B92 3A 41 F7         ld   a, (game_objective_completed)
 712  8B95 B7               or   a
 713  8B96 20 07            jr   nz, .verify_flags
 714  8B98 3A 39 F3         ld   a, (items_collected)
 715  8B9B FE 4D            cp   TOTAL_ITEMS
 716  8B9D 38 16            jr   c, .not_all
 717  8B9F
 718  8B9F              .verify_flags:
 719  8B9F 21 94 80         ld   hl, ItemsTable
 720  8BA2              .loop:
 721  8BA2 7E               ld   a, (hl)
 722  8BA3 FE FF            cp   $FF
 723  8BA5 28 0B            jr   z, .done_all
 724  8BA7 23               inc  hl                    ; +1 X
 725  8BA8 23               inc  hl                    ; +2 Y
 726  8BA9 23               inc  hl                    ; +3 Color
 727  8BAA 23               inc  hl                    ; +4 Collected flag
 728  8BAB 7E               ld   a, (hl)
 729  8BAC B7               or   a
 730  8BAD 28 06            jr   z, .not_all           ; Trovato un item non raccolto -> fail
 731  8BAF 23               inc  hl                    ; Prossimo record
 732  8BB0 18 F0            jr   .loop
 733  8BB2
 734  8BB2              .done_all:
 735  8BB2 E1               pop  hl
 736  8BB3 37               scf
 737  8BB4 C9               ret
 738  8BB5
 739  8BB5              .not_all:
 740  8BB5 E1               pop  hl
 741  8BB6 B7               or   a
 742  8BB7 C9               ret
 743  8BB8
 744  8BB8              ; -------------------------------------------------------------------
 745  8BB8              ; CheckInMasterBedroom
 746  8BB8              ; Verifica se la stanza corrente è Master Bedroom (ID 35 / MastreBedRoomLayout)
 747  8BB8              ; Output: Carry = 1 se Master Bedroom, Carry = 0 altrimenti
 748  8BB8              ; -------------------------------------------------------------------
 749  8BB8              CheckInMasterBedroom:
 750  8BB8 E5               push hl
 751  8BB9 D5               push de
 752  8BBA 2A AF F6         ld   hl, (room_ptr)
 753  8BBD 11 23 B4         ld   de, MastreBedRoomLayout
 754  8BC0 B7               or   a
 755  8BC1 ED 52            sbc  hl, de
 756  8BC3 28 0B            jr   z, .is_master
 757  8BC5 3A 55 F6         ld   a, (current_room)
 758  8BC8 FE 23            cp   ROOM_MASTER_BEDROOM
 759  8BCA 28 04            jr   z, .is_master
 760  8BCC D1               pop  de
 761  8BCD E1               pop  hl
 762  8BCE B7               or   a
 763  8BCF C9               ret
 764  8BD0              .is_master:
 765  8BD0 D1               pop  de
 766  8BD1 E1               pop  hl
 767  8BD2 37               scf
 768  8BD3 C9               ret
 769  8BD4
 770  8BD4              ; -------------------------------------------------------------------
 771  8BD4              ; CheckWillyConveyorCollision
 772  8BD4              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 773  8BD4              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 774  8BD4              ; -------------------------------------------------------------------
 775  8BD4              CheckWillyConveyorCollision:
 776  8BD4 C5               push bc
 777  8BD5 D5               push de
 778  8BD6 E5               push hl
 779  8BD7
 780  8BD7                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 781  8BD7 CD 41 76         call CheckWillyOnConveyor
 782  8BDA 38 49            jr   c, .collision_detected
 783  8BDC
 784  8BDC                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 785  8BDC 3A 57 F6         ld   a, (conveyor_len)
 786  8BDF B7               or   a
 787  8BE0 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 788  8BE2
 789  8BE2                  ; B = WillyY, C = WillyX
 790  8BE2 ED 4B 2F F3      ld   bc, (PlayerPos)
 791  8BE6
 792  8BE6                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 793  8BE6 3A 58 F6         ld   a, (conveyor_row)
 794  8BE9 87               add  a, a                  ; *2
 795  8BEA 87               add  a, a                  ; *4
 796  8BEB 87               add  a, a                  ; *8
 797  8BEC 5F               ld   e, a                  ; E = ConveyorTop
 798  8BED C6 07            add  a, 7
 799  8BEF 57               ld   d, a                  ; D = ConveyorBottom
 800  8BF0
 801  8BF0                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 802  8BF0 78               ld   a, b                  ; WillyTop
 803  8BF1 BA               cp   d
 804  8BF2 28 04            jr   z, .y_overlap
 805  8BF4 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 806  8BF6 18 32            jr   .no_conv_collision
 807  8BF8
 808  8BF8              .y_overlap:
 809  8BF8 C6 0F            add  a, 15                 ; WillyBottom
 810  8BFA BB               cp   e
 811  8BFB 28 04            jr   z, .x_check
 812  8BFD 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 813  8BFF 18 29            jr   .no_conv_collision
 814  8C01
 815  8C01              .x_check:
 816  8C01                  ; ConveyorLeft = conveyor_col * 8
 817  8C01 3A 59 F6         ld   a, (conveyor_col)
 818  8C04 87               add  a, a                  ; *2
 819  8C05 87               add  a, a                  ; *4
 820  8C06 87               add  a, a                  ; *8
 821  8C07 5F               ld   e, a                  ; E = ConveyorLeft
 822  8C08
 823  8C08                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 824  8C08 21 57 F6         ld   hl, conveyor_len
 825  8C0B 3A 59 F6         ld   a, (conveyor_col)
 826  8C0E 86               add  a, (hl)
 827  8C0F 87               add  a, a                  ; *2
 828  8C10 87               add  a, a                  ; *4
 829  8C11 87               add  a, a                  ; *8
 830  8C12 3D               dec  a                     ; ConveyorRight
 831  8C13 57               ld   d, a                  ; D = ConveyorRight
 832  8C14
 833  8C14                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 834  8C14 79               ld   a, c                  ; WillyLeft
 835  8C15 BA               cp   d
 836  8C16 28 04            jr   z, .x_overlap
 837  8C18 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 838  8C1A 18 0E            jr   .no_conv_collision
 839  8C1C
 840  8C1C              .x_overlap:
 841  8C1C C6 0F            add  a, 15                 ; WillyRight
 842  8C1E BB               cp   e
 843  8C1F 28 04            jr   z, .collision_detected
 844  8C21 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 845  8C23 18 05            jr   .no_conv_collision
 846  8C25
 847  8C25              .collision_detected:
 848  8C25 E1               pop  hl
 849  8C26 D1               pop  de
 850  8C27 C1               pop  bc
 851  8C28 37               scf
 852  8C29 C9               ret
 853  8C2A
 854  8C2A              .no_conv_collision:
 855  8C2A E1               pop  hl
 856  8C2B D1               pop  de
 857  8C2C C1               pop  bc
 858  8C2D B7               or   a
 859  8C2E C9               ret
 860  8C2F
 861  8C2F              ; -------------------------------------------------------------------
 862  8C2F              ; ResetFullGameState
 863  8C2F              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 864  8C2F              ; per l'avvio di una nuova partita dopo il Game Over.
 865  8C2F              ; -------------------------------------------------------------------
 866  8C2F              ResetFullGameState:
 867  8C2F                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 868  8C2F AF               xor  a
 869  8C30 D3 FE            out  ($fe), a              ; Bordo a nero
 870  8C32 21 8D 5C         ld   hl, ATTR_P
 871  8C35 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 872  8C36 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 873  8C39 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 874  8C3B 3E 07            ld   a, $07
 875  8C3D 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 876  8C40
 877  8C40                  ; Ripristina il numero di vite iniziali
 878  8C40 3E 07            ld   a, INITIAL_LIVES
 879  8C42 32 3C F3         ld   (willy_lives), a
 880  8C45
 881  8C45                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 882  8C45 AF               xor  a
 883  8C46 32 39 F3         ld   (items_collected), a
 884  8C49 32 35 F3         ld   (body_state), a
 885  8C4C 32 48 F3         ld   (w_warp_state), a
 886  8C4F 32 4B F3         ld   (w_key_prev), a
 887  8C52 32 4C F3         ld   (enter_key_prev), a
 888  8C55 32 3D F3         ld   (velocity_y), a
 889  8C58 32 3F F3         ld   (jump_pressed), a
 890  8C5B 32 41 F3         ld   (coyote_timer), a
 891  8C5E 32 44 F3         ld   (jump_frame), a
 892  8C61 32 43 F3         ld   (jump_dir), a
 893  8C64 32 B5 F6         ld   (transition_active), a
 894  8C67 32 39 F7         ld   (willy_safety_timer), a
 895  8C6A 3E FF            ld   a, $ff
 896  8C6C 32 4D F3         ld   (digit_key_prev), a
 897  8C6F 3E 01            ld   a, 1
 898  8C71 32 46 F3         ld   (q_prev), a
 899  8C74 32 47 F3         ld   (a_prev), a
 900  8C77 32 3E F3         ld   (on_ground), a
 901  8C7A
 902  8C7A                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 903  8C7A 3E 30            ld   a, '0'
 904  8C7C 32 F9 68         ld   (status_line + 16), a
 905  8C7F 32 FA 68         ld   (status_line + 17), a
 906  8C82 32 FB 68         ld   (status_line + 18), a
 907  8C85
 908  8C85                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 909  8C85 CD F0 85         call ResetItemsTable
 910  8C88
 911  8C88                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 912  8C88 CD 21 6E         call InitRoomEntryPositions
 913  8C8B
 914  8C8B                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 915  8C8B 3E 07            ld   a, 7
 916  8C8D 32 3C F7         ld   (time_hours), a
 917  8C90 AF               xor  a
 918  8C91 32 3D F7         ld   (time_minutes), a
 919  8C94 32 3E F7         ld   (time_period), a       ; 0 = AM
 920  8C97 32 41 F7         ld   (game_objective_completed), a
 921  8C9A 2A 50 F3         ld   hl, (counter)
 922  8C9D 22 3F F7         ld   (time_last_counter), hl
 923  8CA0 CD 6B 68         call Gfx_UpdateTimeDisplay
 924  8CA3
 925  8CA3                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 926  8CA3 21 E7 B1         ld   hl, TheBathroomLayout; TheOffLicenceLayout
 927  8CA6 22 AF F6         ld   (room_ptr), hl
 928  8CA9
 929  8CA9 C9               ret
 930  8CAA
 931  8CAA              ; -------------------------------------------------------------------
 932  8CAA              ; Time_UpdateClock
 933  8CAA              ; Gestisce lo scorrimento del tempo durante il gioco.
 934  8CAA              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 935  8CAA              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 936  8CAA              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 937  8CAA              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 938  8CAA              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 939  8CAA              ; sia completato, scatena immediatamente il Game Over.
 940  8CAA              ; -------------------------------------------------------------------
 941  8CAA              Time_UpdateClock:
 942  8CAA                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 943  8CAA 2A 50 F3         ld   hl, (counter)
 944  8CAD ED 5B 3F F7      ld   de, (time_last_counter)
 945  8CB1 B7               or   a
 946  8CB2 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 947  8CB4
 948  8CB4                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 949  8CB4 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 950  8CB7 B7               or   a
 951  8CB8 ED 52            sbc  hl, de
 952  8CBA D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 953  8CBB
 954  8CBB                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 955  8CBB 2A 3F F7         ld   hl, (time_last_counter)
 956  8CBE 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 957  8CC1 19               add  hl, de
 958  8CC2 22 3F F7         ld   (time_last_counter), hl
 959  8CC5
 960  8CC5                  ; Incrementa di 1 minuto il tempo di gioco
 961  8CC5 3A 3D F7         ld   a, (time_minutes)
 962  8CC8 3C               inc  a
 963  8CC9 FE 3C            cp   60
 964  8CCB 38 21            jr   c, .minutes_ok
 965  8CCD
 966  8CCD                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 967  8CCD AF               xor  a
 968  8CCE 32 3D F7         ld   (time_minutes), a
 969  8CD1 3A 3C F7         ld   a, (time_hours)
 970  8CD4 3C               inc  a
 971  8CD5 FE 0C            cp   12
 972  8CD7 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 973  8CD9 FE 0D            cp   13
 974  8CDB 38 0E            jr   c, .hours_ok
 975  8CDD 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 976  8CDF 18 0A            jr   .hours_ok
 977  8CE1
 978  8CE1              .toggle_period:
 979  8CE1 F5               push af                     ; Salva A (valore 12)
 980  8CE2 3A 3E F7         ld   a, (time_period)
 981  8CE5 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 982  8CE7 32 3E F7         ld   (time_period), a
 983  8CEA F1               pop  af                     ; Ripristina A = 12
 984  8CEB
 985  8CEB              .hours_ok:
 986  8CEB 32 3C F7         ld   (time_hours), a
 987  8CEE
 988  8CEE              .minutes_ok:
 989  8CEE 32 3D F7         ld   (time_minutes), a
 990  8CF1
 991  8CF1                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 992  8CF1 CD 6B 68         call Gfx_UpdateTimeDisplay
 993  8CF4
 994  8CF4                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 995  8CF4 3A 41 F7         ld   a, (game_objective_completed)
 996  8CF7 B7               or   a
 997  8CF8 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 998  8CF9
 999  8CF9                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
1000  8CF9 3A 3E F7         ld   a, (time_period)
1001  8CFC B7               or   a
1002  8CFD C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
1003  8CFE
1004  8CFE 3A 3C F7         ld   a, (time_hours)
1005  8D01 FE 0C            cp   12
1006  8D03 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1007  8D05 C9               ret
1008  8D06
