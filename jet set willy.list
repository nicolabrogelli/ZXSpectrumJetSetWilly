1070+ 8600
1071+ 8600              .set_room:
1072+ 8600
1073+ 8600                  ; Salva l'ID della stanza corrente
1074+ 8600 32 6B F7         ld   (current_room), a
1075+ 8603
1076+ 8603                  ; Ripristina i registri
1077+ 8603 D1               pop  de
1078+ 8604 E1               pop  hl
1079+ 8605
1080+ 8605 C9               ret
1081+ 8606
1082+ 8606              ; -------------------------------------------------------------------
1083+ 8606              ; Items_DrawRoom
1084+ 8606              ;
1085+ 8606              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1086+ 8606              ;
1087+ 8606              ; Operazioni eseguite:
1088+ 8606              ;   1. Azzera la griglia items_grid.
1089+ 8606              ;   2. Svuota la cache degli oggetti attivi.
1090+ 8606              ;   3. Scansiona ItemsTable.
1091+ 8606              ;   4. Per ogni item della stanza corrente:
1092+ 8606              ;        - verifica se è già stato raccolto
1093+ 8606              ;        - disegna la grafica
1094+ 8606              ;        - aggiorna items_grid
1095+ 8606              ;        - memorizza l'item nella cache current_room_items
1096+ 8606              ;   5. Aggiorna num_room_items.
1097+ 8606              ;
1098+ 8606              ; Record ItemsTable:
1099+ 8606              ;   +0  Room ID
1100+ 8606              ;   +1  X (colonna)
1101+ 8606              ;   +2  Y (riga)
1102+ 8606              ;   +3  Colore
1103+ 8606              ;   +4  Collected flag
1104+ 8606              ;
1105+ 8606              ; Cache current_room_items:
1106+ 8606              ;   +0  Colonna
1107+ 8606              ;   +1  Riga
1108+ 8606              ;   +2  Colore
1109+ 8606              ;   +3  Collected flag ptr (Low)
1110+ 8606              ;   +4  Collected flag ptr (High)
1111+ 8606              ;
1112+ 8606              ; Ogni record cache occupa 5 byte.
1113+ 8606              ; -------------------------------------------------------------------
1114+ 8606              ; ResetItemsTable
1115+ 8606              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1116+ 8606              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1117+ 8606              ; -------------------------------------------------------------------
1118+ 8606              ResetItemsTable:
1119+ 8606 21 AA 80         ld   hl, ItemsTable
1120+ 8609              .reset_loop:
1121+ 8609 7E               ld   a, (hl)
1122+ 860A FE FF            cp   $FF
1123+ 860C C8               ret  z
1124+ 860D 23               inc  hl                        ; +1 (X)
1125+ 860E 23               inc  hl                        ; +2 (Y)
1126+ 860F 23               inc  hl                        ; +3 (Color)
1127+ 8610 23               inc  hl                        ; +4 (Collected flag)
1128+ 8611 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1129+ 8613 23               inc  hl                        ; Prossimo record
1130+ 8614 18 F3            jr   .reset_loop
1131+ 8616
1132+ 8616              ; -------------------------------------------------------------------
1133+ 8616              Items_DrawRoom:
1134+ 8616
1135+ 8616                  ; Salva tutti i registri utilizzati
1136+ 8616 E5               push hl
1137+ 8617 D5               push de
1138+ 8618 C5               push bc
1139+ 8619 DD E5            push ix
1140+ 861B FD E5            push iy
1141+ 861D
1142+ 861D                  ; ---------------------------------------------------------------
1143+ 861D                  ; Azzera items_grid (32 x 16 = 512 byte)
1144+ 861D                  ; ---------------------------------------------------------------
1145+ 861D 21 45 F2         ld   hl, items_grid
1146+ 8620 11 46 F2         ld   de, items_grid + 1
1147+ 8623 36 00            ld   (hl), 0
1148+ 8625 01 FF 01         ld   bc, 511
1149+ 8628 ED B0            ldir
1150+ 862A
1151+ 862A                  ; ---------------------------------------------------------------
1152+ 862A                  ; Nessun item attivo nella stanza
1153+ 862A                  ; ---------------------------------------------------------------
1154+ 862A AF               xor  a
1155+ 862B 32 C4 F7         ld   (num_room_items), a
1156+ 862E
1157+ 862E                  ; IY punta alla cache degli item attivi
1158+ 862E FD 21 74 F7      ld   iy, current_room_items
1159+ 8632
1160+ 8632                  ; ---------------------------------------------------------------
1161+ 8632                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1162+ 8632                  ; alla stanza corrente.
1163+ 8632                  ;
1164+ 8632                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1165+ 8632                  ; ---------------------------------------------------------------
1166+ 8632 2A C5 F7         ld   hl, (room_ptr)
1167+ 8635 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1168+ 8638 19               add  hl, de
1169+ 8639
1170+ 8639 E5               push hl
1171+ 863A DD E1            pop  ix                ; IX = bitmap item
1172+ 863C
1173+ 863C                  ; ---------------------------------------------------------------
1174+ 863C                  ; Inizio scansione della tabella degli item
1175+ 863C                  ; ---------------------------------------------------------------
1176+ 863C 21 AA 80         ld   hl, ItemsTable
1177+ 863F
1178+ 863F              .loop:
1179+ 863F
1180+ 863F                  ; ---------------------------------------------------------------
1181+ 863F                  ; Legge il Room ID del record corrente
1182+ 863F                  ; ---------------------------------------------------------------
1183+ 863F 7E               ld   a, (hl)
1184+ 8640
1185+ 8640                  ; $FF indica fine tabella
1186+ 8640 FE FF            cp   $FF
1187+ 8642 28 53            jr   z, .done
1188+ 8644
1189+ 8644                  ; ---------------------------------------------------------------
1190+ 8644                  ; Verifica se l'item appartiene alla stanza corrente
1191+ 8644                  ; ---------------------------------------------------------------
1192+ 8644 57               ld   d, a
1193+ 8645
1194+ 8645 3A 6B F7         ld   a, (current_room)
1195+ 8648 BA               cp   d
1196+ 8649 20 45            jr   nz, .next_item
1197+ 864B
1198+ 864B                  ; ---------------------------------------------------------------
1199+ 864B                  ; Legge i dati dell'item
1200+ 864B                  ; ---------------------------------------------------------------
1201+ 864B
1202+ 864B 23               inc  hl
1203+ 864C 4E               ld   c, (hl)           ; X (colonna)
1204+ 864D
1205+ 864D 23               inc  hl
1206+ 864E 46               ld   b, (hl)           ; Y (riga)
1207+ 864F
1208+ 864F 23               inc  hl
1209+ 8650 5E               ld   e, (hl)           ; Colore
1210+ 8651
1211+ 8651 23               inc  hl
1212+ 8652 7E               ld   a, (hl)           ; Collected flag
1213+ 8653
1214+ 8653                  ; Se diverso da zero l'item è già stato raccolto
1215+ 8653 B7               or   a
1216+ 8654 20 3E            jr   nz, .next_no_inc
1217+ 8656
1218+ 8656                  ; ---------------------------------------------------------------
1219+ 8656                  ; Disegna l'item sullo schermo
1220+ 8656                  ;
1221+ 8656                  ; B = Row
1222+ 8656                  ; C = Column
1223+ 8656                  ; HL = bitmap pointer
1224+ 8656                  ; E = Color
1225+ 8656                  ; ---------------------------------------------------------------
1226+ 8656 E5               push hl
1227+ 8657
1228+ 8657 DD E5            push ix
1229+ 8659 E1               pop  hl
1230+ 865A
1231+ 865A CD 9F 86         call DrawItemGraphic
1232+ 865D
1233+ 865D E1               pop  hl                ; ritorna al flag collected
1234+ 865E
1235+ 865E                  ; ---------------------------------------------------------------
1236+ 865E                  ; Aggiorna items_grid
1237+ 865E                  ;
1238+ 865E                  ; Calcolo:
1239+ 865E                  ;   offset = Row * 32 + Col
1240+ 865E                  ; ---------------------------------------------------------------
1241+ 865E E5               push hl
1242+ 865F D5               push de
1243+ 8660
1244+ 8660 26 00            ld   h, 0
1245+ 8662 68               ld   l, b              ; HL = Row
1246+ 8663
1247+ 8663 29               add  hl, hl            ; *2
1248+ 8664 29               add  hl, hl            ; *4
1249+ 8665 29               add  hl, hl            ; *8
1250+ 8666 29               add  hl, hl            ; *16
1251+ 8667 29               add  hl, hl            ; *32
1252+ 8668
1253+ 8668 16 00            ld   d, 0
1254+ 866A 59               ld   e, c              ; DE = Col
1255+ 866B
1256+ 866B 19               add  hl, de            ; Row*32 + Col
1257+ 866C
1258+ 866C 11 45 F2         ld   de, items_grid
1259+ 866F 19               add  hl, de            ; puntatore nella griglia
1260+ 8670
1261+ 8670 D1               pop  de                ; ripristina colore
1262+ 8671
1263+ 8671 73               ld   (hl), e           ; salva colore cella
1264+ 8672
1265+ 8672 E1               pop  hl
1266+ 8673
1267+ 8673                  ; ---------------------------------------------------------------
1268+ 8673                  ; Salva l'item nella cache della stanza
1269+ 8673                  ;
1270+ 8673                  ; Questo evita di dover scansionare tutta ItemsTable
1271+ 8673                  ; durante il controllo delle collisioni.
1272+ 8673                  ; ---------------------------------------------------------------
1273+ 8673
1274+ 8673 FD 71 00         ld   (iy+0), c         ; Colonna
1275+ 8676 FD 70 01         ld   (iy+1), b         ; Riga
1276+ 8679 FD 73 02         ld   (iy+2), e         ; Colore
1277+ 867C
1278+ 867C                  ; Salva il puntatore al flag "collected"
1279+ 867C FD 75 03         ld   (iy+3), l         ; Low byte
1280+ 867F FD 74 04         ld   (iy+4), h         ; High byte
1281+ 8682
1282+ 8682                  ; Passa al record successivo della cache
1283+ 8682 01 05 00         ld   bc, 5
1284+ 8685 FD 09            add  iy, bc
1285+ 8687
1286+ 8687                  ; Incrementa il numero di item attivi
1287+ 8687 3A C4 F7         ld   a, (num_room_items)
1288+ 868A 3C               inc  a
1289+ 868B 32 C4 F7         ld   (num_room_items), a
1290+ 868E
1291+ 868E 18 04            jr   .next_no_inc
1292+ 8690
1293+ 8690              .next_item:
1294+ 8690
1295+ 8690                  ; ---------------------------------------------------------------
1296+ 8690                  ; L'item non appartiene alla stanza corrente.
1297+ 8690                  ; Salta i campi del record:
1298+ 8690                  ;   X
1299+ 8690                  ;   Y
1300+ 8690                  ;   Color
1301+ 8690                  ;   Collected
1302+ 8690                  ; ---------------------------------------------------------------
1303+ 8690 23               inc  hl
1304+ 8691 23               inc  hl
1305+ 8692 23               inc  hl
1306+ 8693 23               inc  hl
1307+ 8694
1308+ 8694              .next_no_inc:
1309+ 8694
1310+ 8694                  ; ---------------------------------------------------------------
1311+ 8694                  ; Avanza al record successivo
1312+ 8694                  ; (prossimo Room ID)
1313+ 8694                  ; ---------------------------------------------------------------
1314+ 8694 23               inc  hl
1315+ 8695 18 A8            jr   .loop
1316+ 8697
1317+ 8697              .done:
1318+ 8697
1319+ 8697                  ; Ripristina i registri
1320+ 8697 FD E1            pop  iy
1321+ 8699 DD E1            pop  ix
1322+ 869B D1               pop  de
1323+ 869C C1               pop  bc
1324+ 869D E1               pop  hl
1325+ 869E
1326+ 869E C9               ret
1327+ 869F
1328+ 869F              ; -------------------------------------------------------------------
1329+ 869F              ; DrawItemGraphic
1330+ 869F              ;
1331+ 869F              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1332+ 869F              ; utilizzando una bitmap di 8 byte e un attributo colore.
1333+ 869F              ;
1334+ 869F              ; Input:
1335+ 869F              ;   B = Riga attributi (3..18)
1336+ 869F              ;   C = Colonna attributi (0..31)
1337+ 869F              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1338+ 869F              ;   E = Attributo colore
1339+ 869F              ;
1340+ 869F              ; Output:
1341+ 869F              ;   Nessuno
1342+ 869F              ;
1343+ 869F              ; Registri preservati:
1344+ 869F              ;   BC, DE, HL
1345+ 869F              ; -------------------------------------------------------------------
1346+ 869F              DrawItemGraphic:
1347+ 869F
1348+ 869F                  ; Salva i registri originali
1349+ 869F C5               push bc
1350+ 86A0 D5               push de
1351+ 86A1 E5               push hl
1352+ 86A2
1353+ 86A2                  ; ---------------------------------------------------------------
1354+ 86A2                  ; Calcolo indirizzo bitmap dello Spectrum
1355+ 86A2                  ;
1356+ 86A2                  ; Ogni item occupa una cella attributi (8x8 pixel).
1357+ 86A2                  ;
1358+ 86A2                  ; Formula:
1359+ 86A2                  ;   High = $40 + (Row AND $18)
1360+ 86A2                  ;   Low  = (Row AND 7) * 32 + Col
1361+ 86A2                  ;
1362+ 86A2                  ; DE conterrà l'indirizzo della prima scanline.
1363+ 86A2                  ; ---------------------------------------------------------------
1364+ 86A2
1365+ 86A2 78               ld   a, b
1366+ 86A3 E6 18            and  $18
1367+ 86A5 C6 40            add  a, $40
1368+ 86A7 57               ld   d, a              ; Byte alto indirizzo video
1369+ 86A8
1370+ 86A8 78               ld   a, b
1371+ 86A9 E6 07            and  7                 ; Riga interna al blocco da 8
1372+ 86AB
1373+ 86AB 87               add  a, a              ; *2
1374+ 86AC 87               add  a, a              ; *4
1375+ 86AD 87               add  a, a              ; *8
1376+ 86AE 87               add  a, a              ; *16
1377+ 86AF 87               add  a, a              ; *32
1378+ 86B0
1379+ 86B0 81               add  a, c              ; + colonna
1380+ 86B1
1381+ 86B1 5F               ld   e, a              ; Byte basso indirizzo video
1382+ 86B2
1383+ 86B2                  ; ---------------------------------------------------------------
1384+ 86B2                  ; Disegno bitmap
1385+ 86B2                  ;
1386+ 86B2                  ; Copia 8 byte consecutivi nella memoria video.
1387+ 86B2                  ; Ogni byte rappresenta una scanline da 8 pixel.
1388+ 86B2                  ; ---------------------------------------------------------------
1389+ 86B2
1390+ 86B2 C5               push bc                ; Conserva Row e Col
1391+ 86B3
1392+ 86B3 06 08            ld   b, 8              ; Numero scanline
1393+ 86B5
1394+ 86B5              .line_loop:
1395+ 86B5
1396+ 86B5 7E               ld   a, (hl)           ; Legge scanline bitmap
1397+ 86B6 12               ld   (de), a           ; Scrive nella memoria video
1398+ 86B7
1399+ 86B7 14               inc  d                 ; Scanline successiva
1400+ 86B8 23               inc  hl                ; Byte bitmap successivo
1401+ 86B9
1402+ 86B9 05               dec  b
1403+ 86BA 20 F9            jr   nz, .line_loop
1404+ 86BC
1405+ 86BC C1               pop  bc                ; Ripristina Row e Col
1406+ 86BD
1407+ 86BD                  ; ---------------------------------------------------------------
1408+ 86BD                  ; Calcolo indirizzo attributo
1409+ 86BD                  ;
1410+ 86BD                  ; Formula:
1411+ 86BD                  ;   AttrAddr = $5800 + Row * 32 + Col
1412+ 86BD                  ;
1413+ 86BD                  ; HL conterrà l'indirizzo della cella attributi.
1414+ 86BD                  ; ---------------------------------------------------------------
1415+ 86BD
1416+ 86BD 26 00            ld   h, 0
1417+ 86BF 68               ld   l, b              ; HL = Row
1418+ 86C0
1419+ 86C0 29               add  hl, hl            ; *2
1420+ 86C1 29               add  hl, hl            ; *4
1421+ 86C2 29               add  hl, hl            ; *8
1422+ 86C3 29               add  hl, hl            ; *16
1423+ 86C4 29               add  hl, hl            ; *32
1424+ 86C5
1425+ 86C5 79               ld   a, c              ; A = Colonna
1426+ 86C6
1427+ 86C6 85               add  a, l
1428+ 86C7 6F               ld   l, a
1429+ 86C8
1430+ 86C8 30 01            jr   nc, .no_carry
1431+ 86CA 24               inc  h
1432+ 86CB
1433+ 86CB              .no_carry:
1434+ 86CB
1435+ 86CB                  ; HL = Row * 32 + Col
1436+ 86CB
1437+ 86CB 11 00 58         ld   de, $5800
1438+ 86CE 19               add  hl, de            ; HL = indirizzo attributi
1439+ 86CF
1440+ 86CF                  ; ---------------------------------------------------------------
1441+ 86CF                  ; Recupera il colore originale dallo stack.
1442+ 86CF                  ;
1443+ 86CF                  ; Layout stack:
1444+ 86CF                  ;   HL originale
1445+ 86CF                  ;   DE originale (E = colore)
1446+ 86CF                  ;   BC originale
1447+ 86CF                  ; ---------------------------------------------------------------
1448+ 86CF
1449+ 86CF C1               pop  bc                ; Recupera HL originale
1450+ 86D0 D1               pop  de                ; Recupera DE originale
1451+ 86D1
1452+ 86D1                  ; ---------------------------------------------------------------
1453+ 86D1                  ; Scrive l'attributo colore
1454+ 86D1                  ; ---------------------------------------------------------------
1455+ 86D1
1456+ 86D1 7B               ld   a, e              ; A = colore
1457+ 86D2 77               ld   (hl), a           ; Scrive nella RAM attributi
1458+ 86D3
1459+ 86D3                  ; ---------------------------------------------------------------
1460+ 86D3                  ; Ripristina HL e BC originali
1461+ 86D3                  ; ---------------------------------------------------------------
1462+ 86D3
1463+ 86D3 C5               push bc
1464+ 86D4 E1               pop  hl                ; HL originale
1465+ 86D5
1466+ 86D5 C1               pop  bc                ; BC originale
1467+ 86D6
1468+ 86D6 C9               ret
1469+ 86D7
1470+ 86D7              ; -------------------------------------------------------------------
1471+ 86D7              ; RestoreBackgroundCell
1472+ 86D7              ;
1473+ 86D7              ; Ripristina il contenuto originale di una cella della stanza.
1474+ 86D7              ; Viene utilizzata principalmente quando un item viene raccolto:
1475+ 86D7              ; invece di lasciare un "buco", la routine ridisegna il tile
1476+ 86D7              ; originale presente nella mappa della stanza.
1477+ 86D7              ;
1478+ 86D7              ; Input:
1479+ 86D7              ;   B = Row (3..18)
1480+ 86D7              ;   C = Col (0..31)
1481+ 86D7              ;
1482+ 86D7              ; Utilizza:
1483+ 86D7              ;   room_ptr -> struttura dati della stanza corrente
1484+ 86D7              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1485+ 86D7              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1486+ 86D7              ;
1487+ 86D7              ; Tipi di cella:
1488+ 86D7              ;   0 = Background
1489+ 86D7              ;   1 = Floor
1490+ 86D7              ;   2 = Wall
1491+ 86D7              ;   3 = Nasty
1492+ 86D7              ; -------------------------------------------------------------------
1493+ 86D7              RestoreBackgroundCell:
1494+ 86D7
1495+ 86D7                  ; Salva tutti i registri utilizzati
1496+ 86D7 FD E5            push iy
1497+ 86D9 C5               push bc
1498+ 86DA D5               push de
1499+ 86DB E5               push hl
1500+ 86DC DD E5            push ix
1501+ 86DE
1502+ 86DE                  ; ---------------------------------------------------------------
1503+ 86DE                  ; Conserva Row e Col in IY.
1504+ 86DE                  ;
1505+ 86DE                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1506+ 86DE                  ; BC potrebbe essere modificato.
1507+ 86DE                  ; ---------------------------------------------------------------
1508+ 86DE C5               push bc
1509+ 86DF FD E1            pop  iy                ; IYH = Row, IYL = Col
1510+ 86E1
1511+ 86E1                  ; ---------------------------------------------------------------
1512+ 86E1                  ; Determina quale tipo di cella è presente nella posizione
1513+ 86E1                  ; specificata.
1514+ 86E1                  ;
1515+ 86E1                  ; Input:
1516+ 86E1                  ;   B = Row
1517+ 86E1                  ;   C = Col
1518+ 86E1                  ;
1519+ 86E1                  ; Output:
1520+ 86E1                  ;   A = tipo cella
1521+ 86E1                  ; ---------------------------------------------------------------
1522+ 86E1 78               ld   a, b
1523+ 86E2
1524+ 86E2 CD 8E 77         call GetCellFromUnpacked
1525+ 86E5
1526+ 86E5                  ; ---------------------------------------------------------------
1527+ 86E5                  ; Recupera il puntatore alla stanza corrente.
1528+ 86E5                  ;
1529+ 86E5                  ; DE = base della struttura stanza
1530+ 86E5                  ; ---------------------------------------------------------------
1531+ 86E5 ED 5B C5 F7      ld   de, (room_ptr)
1532+ 86E9
1533+ 86E9                  ; ---------------------------------------------------------------
1534+ 86E9                  ; Seleziona il tile corretto in base al tipo di cella.
1535+ 86E9                  ;
1536+ 86E9                  ; A = 0 -> Background
1537+ 86E9                  ; A = 1 -> Floor
1538+ 86E9                  ; A = 2 -> Wall
1539+ 86E9                  ; A = 3 -> Nasty
1540+ 86E9                  ; ---------------------------------------------------------------
1541+ 86E9
1542+ 86E9 B7               or   a
1543+ 86EA 20 06            jr   nz, .not_bg
1544+ 86EC
1545+ 86EC                  ; Background
1546+ 86EC 21 A0 00         ld   hl, OFFSET_BG
1547+ 86EF 19               add  hl, de
1548+ 86F0 18 16            jr   .draw_cell
1549+ 86F2
1550+ 86F2              .not_bg:
1551+ 86F2
1552+ 86F2 3D               dec  a
1553+ 86F3 20 06            jr   nz, .not_floor
1554+ 86F5
1555+ 86F5                  ; Floor
1556+ 86F5 21 A9 00         ld   hl, OFFSET_FLOOR
1557+ 86F8 19               add  hl, de
1558+ 86F9 18 0D            jr   .draw_cell
1559+ 86FB
1560+ 86FB              .not_floor:
1561+ 86FB
1562+ 86FB 3D               dec  a
1563+ 86FC 20 06            jr   nz, .not_wall
1564+ 86FE
1565+ 86FE                  ; Wall
1566+ 86FE 21 B2 00         ld   hl, OFFSET_WALL
1567+ 8701 19               add  hl, de
1568+ 8702 18 04            jr   .draw_cell
1569+ 8704
1570+ 8704              .not_wall:
1571+ 8704
1572+ 8704                  ; Nasty
1573+ 8704 21 BB 00         ld   hl, OFFSET_NASTY
1574+ 8707 19               add  hl, de
1575+ 8708
1576+ 8708              .draw_cell:
1577+ 8708
1578+ 8708                  ; ---------------------------------------------------------------
1579+ 8708                  ; HL punta ora alla grafica del tile da ridisegnare.
1580+ 8708                  ;
1581+ 8708                  ; Gfx_DrawTile si aspetta:
1582+ 8708                  ;   IX = puntatore tile
1583+ 8708                  ;   B  = Row
1584+ 8708                  ;   C  = Col
1585+ 8708                  ; ---------------------------------------------------------------
1586+ 8708 E5               push hl
1587+ 8709 DD E1            pop  ix
1588+ 870B
1589+ 870B                  ; Ripristina Row e Col salvati in IY
1590+ 870B FD E5            push iy
1591+ 870D C1               pop  bc
1592+ 870E
1593+ 870E                  ; Disegna il tile originale
1594+ 870E CD 5D 6A         call Gfx_DrawTile
1595+ 8711
1596+ 8711                  ; ---------------------------------------------------------------
1597+ 8711                  ; Ripristina i registri salvati
1598+ 8711                  ; ---------------------------------------------------------------
1599+ 8711 DD E1            pop  ix
1600+ 8713 E1               pop  hl
1601+ 8714 D1               pop  de
1602+ 8715 C1               pop  bc
1603+ 8716 FD E1            pop  iy
1604+ 8718
1605+ 8718 C9               ret
1606+ 8719
1607+ 8719              ; -------------------------------------------------------------------
1608+ 8719              ; CheckWillyItemCollision
1609+ 8719              ;
1610+ 8719              ; Verifica se Willy collide con un item utilizzando il controllo
1611+ 8719              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1612+ 8719              ;
1613+ 8719              ; Input:
1614+ 8719              ;   A = ItemX (colonna attributi 0..31)
1615+ 8719              ;   H = ItemY (riga attributi 3..18)
1616+ 8719              ;
1617+ 8719              ; Coordinate item:
1618+ 8719              ;   Ogni item occupa una cella da 8x8 pixel.
1619+ 8719              ;
1620+ 8719              ; Coordinate Willy:
1621+ 8719              ;   Willy occupa un rettangolo di 16x16 pixel.
1622+ 8719              ;
1623+ 8719              ; Output:
1624+ 8719              ;   Carry Set   = collisione rilevata
1625+ 8719              ;   Carry Clear = nessuna collisione
1626+ 8719              ;
1627+ 8719              ; Registri preservati:
1628+ 8719              ;   BC, DE, HL
1629+ 8719              ; -------------------------------------------------------------------
1630+ 8719              CheckWillyItemCollision:
1631+ 8719
1632+ 8719                  ; Salva i registri utilizzati
1633+ 8719 C5               push bc
1634+ 871A D5               push de
1635+ 871B E5               push hl
1636+ 871C
1637+ 871C                  ; ---------------------------------------------------------------
1638+ 871C                  ; Calcola il bounding box orizzontale dell'item
1639+ 871C                  ;
1640+ 871C                  ; ItemLeft  = ItemX * 8
1641+ 871C                  ; ItemRight = ItemLeft + 7
1642+ 871C                  ;
1643+ 871C                  ; E = ItemLeft
1644+ 871C                  ; D = ItemRight
1645+ 871C                  ; ---------------------------------------------------------------
1646+ 871C 6F               ld   l, a              ; L = ItemX
1647+ 871D
1648+ 871D 7D               ld   a, l
1649+ 871E 87               add  a, a              ; *2
1650+ 871F 87               add  a, a              ; *4
1651+ 8720 87               add  a, a              ; *8
1652+ 8721
1653+ 8721 5F               ld   e, a              ; E = ItemLeft
1654+ 8722
1655+ 8722 C6 07            add  a, 7
1656+ 8724 57               ld   d, a              ; D = ItemRight
1657+ 8725
1658+ 8725                  ; ---------------------------------------------------------------
1659+ 8725                  ; Recupera la posizione corrente di Willy
1660+ 8725                  ;
1661+ 8725                  ; B = WillyY
1662+ 8725                  ; C = WillyX
1663+ 8725                  ; ---------------------------------------------------------------
1664+ 8725 ED 4B 45 F4      ld   bc, (PlayerPos)
1665+ 8729
1666+ 8729                  ; ---------------------------------------------------------------
1667+ 8729                  ; Primo test:
1668+ 8729                  ;
1669+ 8729                  ; WillyLeft <= ItemRight
1670+ 8729                  ;
1671+ 8729                  ; Se Willy è completamente a destra dell'item
1672+ 8729                  ; non può esserci collisione.
1673+ 8729                  ; ---------------------------------------------------------------
1674+ 8729 79               ld   a, c              ; A = WillyLeft
1675+ 872A
1676+ 872A BA               cp   d                 ; WillyLeft vs ItemRight
1677+ 872B
1678+ 872B 28 04            jr   z, .x_ok
1679+ 872D 38 02            jr   c, .x_ok
1680+ 872F
1681+ 872F 18 29            jr   .no_collision
1682+ 8731
1683+ 8731              .x_ok:
1684+ 8731
1685+ 8731                  ; ---------------------------------------------------------------
1686+ 8731                  ; Secondo test:
1687+ 8731                  ;
1688+ 8731                  ; WillyRight >= ItemLeft
1689+ 8731                  ;
1690+ 8731                  ; WillyRight = WillyX + 7
1691+ 8731                  ; ---------------------------------------------------------------
1692+ 8731 C6 07            add  a, 7
1693+ 8733
1694+ 8733 BB               cp   e                 ; WillyRight vs ItemLeft
1695+ 8734
1696+ 8734 28 04            jr   z, .y_check
1697+ 8736 30 02            jr   nc, .y_check
1698+ 8738
1699+ 8738 18 20            jr   .no_collision
1700+ 873A
1701+ 873A              .y_check:
1702+ 873A
1703+ 873A                  ; ---------------------------------------------------------------
1704+ 873A                  ; Recupera ItemY dal valore originale di HL
1705+ 873A                  ;
1706+ 873A                  ; H contiene la riga dell'item.
1707+ 873A                  ; ---------------------------------------------------------------
1708+ 873A E1               pop  hl
1709+ 873B E5               push hl
1710+ 873C
1711+ 873C                  ; ---------------------------------------------------------------
1712+ 873C                  ; Calcola il bounding box verticale dell'item
1713+ 873C                  ;
1714+ 873C                  ; ItemTop    = ItemY * 8
1715+ 873C                  ; ItemBottom = ItemTop + 7
1716+ 873C                  ;
1717+ 873C                  ; E = ItemTop
1718+ 873C                  ; D = ItemBottom
1719+ 873C                  ; ---------------------------------------------------------------
1720+ 873C 7C               ld   a, h
1721+ 873D
1722+ 873D 87               add  a, a              ; *2
1723+ 873E 87               add  a, a              ; *4
1724+ 873F 87               add  a, a              ; *8
1725+ 8740
1726+ 8740 5F               ld   e, a              ; ItemTop
1727+ 8741
1728+ 8741 C6 07            add  a, 7
1729+ 8743 57               ld   d, a              ; ItemBottom
1730+ 8744
1731+ 8744                  ; ---------------------------------------------------------------
1732+ 8744                  ; Primo test verticale:
1733+ 8744                  ;
1734+ 8744                  ; WillyTop <= ItemBottom
1735+ 8744                  ; ---------------------------------------------------------------
1736+ 8744 78               ld   a, b              ; WillyTop
1737+ 8745
1738+ 8745 BA               cp   d
1739+ 8746
1740+ 8746 28 04            jr   z, .y_ok
1741+ 8748 38 02            jr   c, .y_ok
1742+ 874A
1743+ 874A 18 0E            jr   .no_collision
1744+ 874C
1745+ 874C              .y_ok:
1746+ 874C
1747+ 874C                  ; ---------------------------------------------------------------
1748+ 874C                  ; Secondo test verticale:
1749+ 874C                  ;
1750+ 874C                  ; WillyBottom >= ItemTop
1751+ 874C                  ;
1752+ 874C                  ; WillyBottom = WillyY + 15
1753+ 874C                  ; ---------------------------------------------------------------
1754+ 874C C6 0F            add  a, 15
1755+ 874E
1756+ 874E BB               cp   e
1757+ 874F
1758+ 874F 28 04            jr   z, .collision
1759+ 8751 30 02            jr   nc, .collision
1760+ 8753
1761+ 8753 18 05            jr   .no_collision
1762+ 8755
1763+ 8755              .collision:
1764+ 8755
1765+ 8755                  ; ---------------------------------------------------------------
1766+ 8755                  ; Collisione rilevata
1767+ 8755                  ; ---------------------------------------------------------------
1768+ 8755 E1               pop  hl
1769+ 8756 D1               pop  de
1770+ 8757 C1               pop  bc
1771+ 8758
1772+ 8758 37               scf                    ; Carry = 1
1773+ 8759
1774+ 8759 C9               ret
1775+ 875A
1776+ 875A              .no_collision:
1777+ 875A
1778+ 875A                  ; ---------------------------------------------------------------
1779+ 875A                  ; Nessuna collisione
1780+ 875A                  ; ---------------------------------------------------------------
1781+ 875A E1               pop  hl
1782+ 875B D1               pop  de
1783+ 875C C1               pop  bc
1784+ 875D
1785+ 875D B7               or   a                 ; Carry = 0
1786+ 875E
1787+ 875E C9               ret
1788+ 875F
1789+ 875F              ; -------------------------------------------------------------------
1790+ 875F              ; Items_CheckCollision
1791+ 875F              ;
1792+ 875F              ; Controlla se Willy entra in collisione con uno degli item
1793+ 875F              ; attivi presenti nella stanza corrente.
1794+ 875F              ;
1795+ 875F              ; Per ogni item:
1796+ 875F              ;   - verifica che appartenga alla stanza corrente
1797+ 875F              ;   - verifica che non sia già stato raccolto
1798+ 875F              ;   - esegue il test di collisione con Willy
1799+ 875F              ;
1800+ 875F              ; Se l'item viene raccolto:
1801+ 875F              ;   - imposta il flag "collected"
1802+ 875F              ;   - rimuove l'item dalla cache items_grid
1803+ 875F              ;   - incrementa il contatore degli oggetti raccolti
1804+ 875F              ;   - aggiorna l'HUD
1805+ 875F              ;   - ripristina il tile di sfondo
1806+ 875F              ;   - riproduce il suono di raccolta
1807+ 875F              ;
1808+ 875F              ; Formato record ItemsTable:
1809+ 875F              ;   +0 RoomID
1810+ 875F              ;   +1 X
1811+ 875F              ;   +2 Y
1812+ 875F              ;   +3 Color
1813+ 875F              ;   +4 Collected
1814+ 875F              ;
1815+ 875F              ; Fine tabella:
1816+ 875F              ;   RoomID = $FF
1817+ 875F              ; -------------------------------------------------------------------
1818+ 875F              Items_CheckCollision:
1819+ 875F
1820+ 875F                  ; Salva i registri utilizzati
1821+ 875F E5               push hl
1822+ 8760 D5               push de
1823+ 8761 C5               push bc
1824+ 8762
1825+ 8762                  ; Inizio scansione della tabella degli item
1826+ 8762 21 AA 80         ld   hl, ItemsTable
1827+ 8765
1828+ 8765              .loop:
1829+ 8765
1830+ 8765                  ; ---------------------------------------------------------------
1831+ 8765                  ; Legge il Room ID dell'item corrente
1832+ 8765                  ; ---------------------------------------------------------------
1833+ 8765 7E               ld   a, (hl)
1834+ 8766
1835+ 8766                  ; $FF indica fine tabella
1836+ 8766 FE FF            cp   $FF
1837+ 8768 28 58            jr   z, .done
1838+ 876A
1839+ 876A                  ; ---------------------------------------------------------------
1840+ 876A                  ; Verifica se l'item appartiene alla stanza corrente
1841+ 876A                  ; ---------------------------------------------------------------
1842+ 876A 57               ld   d, a              ; D = RoomID item
1843+ 876B
1844+ 876B 3A 6B F7         ld   a, (current_room)
1845+ 876E BA               cp   d
1846+ 876F
1847+ 876F                  ; Se appartiene a un'altra stanza salta il record
1848+ 876F 20 4A            jr   nz, .next_item
1849+ 8771
1850+ 8771                  ; ---------------------------------------------------------------
1851+ 8771                  ; Legge coordinate e stato dell'item
1852+ 8771                  ; ---------------------------------------------------------------
1853+ 8771
1854+ 8771 23               inc  hl
1855+ 8772 4E               ld   c, (hl)           ; C = X
1856+ 8773
1857+ 8773 23               inc  hl
1858+ 8774 46               ld   b, (hl)           ; B = Y
1859+ 8775
1860+ 8775 23               inc  hl                ; salta Color
1861+ 8776
1862+ 8776 23               inc  hl                ; punta a Collected
1863+ 8777
1864+ 8777 7E               ld   a, (hl)
1865+ 8778
1866+ 8778                  ; ---------------------------------------------------------------
1867+ 8778                  ; Item già raccolto?
1868+ 8778                  ; ---------------------------------------------------------------
1869+ 8778 B7               or   a
1870+ 8779 20 44            jr   nz, .next_no_inc
1871+ 877B
1872+ 877B                  ; ---------------------------------------------------------------
1873+ 877B                  ; Test collisione Willy ↔ Item
1874+ 877B                  ;
1875+ 877B                  ; Input richiesto:
1876+ 877B                  ;   A = ItemX
1877+ 877B                  ;   H = ItemY
1878+ 877B                  ; ---------------------------------------------------------------
1879+ 877B 79               ld   a, c
