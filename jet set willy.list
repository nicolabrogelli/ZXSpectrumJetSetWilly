 974+ 6B2C              ; -------------------------------------------------------------------
 975+ 6B2C              ; Controlla se Willy collide orizzontalmente con un Wall alle coordinate specificate
 976+ 6B2C              ; Input: C = X pixel (da controllare), B = Y pixel (attuale)
 977+ 6B2C              ; Output: Carry flag impostato se c'è collisione, altrimenti resettato
 978+ 6B2C              ; -------------------------------------------------------------------
 979+ 6B2C              CheckWillyWallCollision:
 980+ 6B2C C5               push bc
 981+ 6B2D
 982+ 6B2D                  ; 1. Punto superiore: (X, Y)
 983+ 6B2D CD FB 6A         call CheckWallCell
 984+ 6B30 38 17            jr   c, .collision
 985+ 6B32
 986+ 6B32                  ; 2. Punto medio: (X, Y + 7)
 987+ 6B32 78               ld   a, b
 988+ 6B33 C6 07            add  a, 7
 989+ 6B35 47               ld   b, a
 990+ 6B36 CD FB 6A         call CheckWallCell
 991+ 6B39 38 0E            jr   c, .collision
 992+ 6B3B
 993+ 6B3B                  ; 3. Punto inferiore: (X, Y + 15)
 994+ 6B3B C1               pop  bc
 995+ 6B3C C5               push bc
 996+ 6B3D 78               ld   a, b
 997+ 6B3E C6 0F            add  a, 15
 998+ 6B40 47               ld   b, a
 999+ 6B41 CD FB 6A         call CheckWallCell
1000+ 6B44 38 03            jr   c, .collision
1001+ 6B46
1002+ 6B46 C1               pop  bc
1003+ 6B47 B7               or   a                 ; Reset carry (nessuna collisione)
1004+ 6B48 C9               ret
1005+ 6B49
1006+ 6B49              .collision:
1007+ 6B49 C1               pop  bc
1008+ 6B4A 37               scf                    ; Set carry (collisione avvenuta)
1009+ 6B4B C9               ret
1010+ 6B4C
1011+ 6B4C              ; -------------------------------------------------------------------
1012+ 6B4C              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1013+ 6B4C              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1014+ 6B4C              ; -------------------------------------------------------------------
1015+ 6B4C              UnpackRoomLayout:
1016+ 6B4C E5               push hl
1017+ 6B4D D5               push de
1018+ 6B4E C5               push bc
1019+ 6B4F
1020+ 6B4F 2A B6 78         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1021+ 6B52 11 5C 76         ld   de, unpacked_layout ; DE = buffer RAM
1022+ 6B55 06 80            ld   b, 128             ; 128 byte
1023+ 6B57              .byte_loop:
1024+ 6B57 7E               ld   a, (hl)            ; Leggi byte compresso
1025+ 6B58 23               inc  hl
1026+ 6B59
1027+ 6B59 4F               ld   c, a               ; C = salvataggio
1028+ 6B5A
1029+ 6B5A                  ; Cella 0: bit 7-6
1030+ 6B5A 07               rlca
1031+ 6B5B 07               rlca
1032+ 6B5C E6 03            and  3
1033+ 6B5E 12               ld   (de), a
1034+ 6B5F 13               inc  de
1035+ 6B60
1036+ 6B60                  ; Cella 1: bit 5-4
1037+ 6B60 79               ld   a, c
1038+ 6B61 07               rlca
1039+ 6B62 07               rlca
1040+ 6B63 07               rlca
1041+ 6B64 07               rlca
1042+ 6B65 E6 03            and  3
1043+ 6B67 12               ld   (de), a
1044+ 6B68 13               inc  de
1045+ 6B69
1046+ 6B69                  ; Cella 2: bit 3-2
1047+ 6B69 79               ld   a, c
1048+ 6B6A 0F               rrca
1049+ 6B6B 0F               rrca
1050+ 6B6C E6 03            and  3
1051+ 6B6E 12               ld   (de), a
1052+ 6B6F 13               inc  de
1053+ 6B70
1054+ 6B70                  ; Cella 3: bit 1-0
1055+ 6B70 79               ld   a, c
1056+ 6B71 E6 03            and  3
1057+ 6B73 12               ld   (de), a
1058+ 6B74 13               inc  de
1059+ 6B75
1060+ 6B75 10 E0            djnz .byte_loop
1061+ 6B77
1062+ 6B77 C1               pop  bc
1063+ 6B78 D1               pop  de
1064+ 6B79 E1               pop  hl
1065+ 6B7A C9               ret
1066+ 6B7B
1067+ 6B7B              ; -------------------------------------------------------------------
1068+ 6B7B              ; Legge il tipo di cella dal buffer decompresso in RAM
1069+ 6B7B              ; Input: A = Row (0..15), C = Col (0..31)
1070+ 6B7B              ; Output: A = tipo di cella (0..3)
1071+ 6B7B              ; Preserva tutti gli altri registri.
1072+ 6B7B              ; -------------------------------------------------------------------
1073+ 6B7B              GetCellFromUnpacked:
1074+ 6B7B E5               push hl
1075+ 6B7C D5               push de
1076+ 6B7D
1077+ 6B7D 6F               ld   l, a
1078+ 6B7E 26 00            ld   h, 0
1079+ 6B80 29               add  hl, hl
1080+ 6B81 29               add  hl, hl
1081+ 6B82 29               add  hl, hl
1082+ 6B83 29               add  hl, hl
1083+ 6B84 29               add  hl, hl            ; HL = Row * 32
1084+ 6B85 59               ld   e, c
1085+ 6B86 16 00            ld   d, 0
1086+ 6B88 19               add  hl, de            ; HL = Row * 32 + Col
1087+ 6B89 11 5C 76         ld   de, unpacked_layout
1088+ 6B8C 19               add  hl, de
1089+ 6B8D 7E               ld   a, (hl)           ; A = cell type
1090+ 6B8E
1091+ 6B8E D1               pop  de
1092+ 6B8F E1               pop  hl
1093+ 6B90 C9               ret
1094+ 6B91
1095+ 6B91              ; -------------------------------------------------------------------
1096+ 6B91              ; GetRampY
1097+ 6B91              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1098+ 6B91              ; Input: C = PlayerX
1099+ 6B91              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1100+ 6B91              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1101+ 6B91              ; -------------------------------------------------------------------
1102+ 6B91              GetRampY:
1103+ 6B91 3A 62 78         ld   a, (ramp_len)
1104+ 6B94 B7               or   a
1105+ 6B95 C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1106+ 6B96
1107+ 6B96 3A 61 78         ld   a, (ramp_dir)
1108+ 6B99 B7               or   a
1109+ 6B9A 28 4C            jr   z, .dir_left
1110+ 6B9C
1111+ 6B9C              .dir_right:
1112+ 6B9C                  ; Rampa sale a destra (up-right)
1113+ 6B9C 3A 64 78         ld   a, (ramp_col)
1114+ 6B9F 87               add  a, a              ; *2
1115+ 6BA0 87               add  a, a              ; *4
1116+ 6BA1 87               add  a, a              ; *8 (X start in pixel)
1117+ 6BA2 5F               ld   e, a              ; E = X_left
1118+ 6BA3
1119+ 6BA3 3A 62 78         ld   a, (ramp_len)
1120+ 6BA6 87               add  a, a              ; *2
1121+ 6BA7 87               add  a, a              ; *4
1122+ 6BA8 87               add  a, a              ; *8
1123+ 6BA9 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1124+ 6BAA 67               ld   h, a              ; H = X_right_boundary
1125+ 6BAB
1126+ 6BAB 79               ld   a, c              ; A = PlayerX
1127+ 6BAC BB               cp   e
1128+ 6BAD DA 42 6C         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1129+ 6BB0
1130+ 6BB0 BC               cp   h
1131+ 6BB1 38 15            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1132+ 6BB3
1133+ 6BB3                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1134+ 6BB3 94               sub  h                 ; A = PlayerX - X_right_boundary
1135+ 6BB4 FE 08            cp   8
1136+ 6BB6 D2 42 6C         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1137+ 6BB9
1138+ 6BB9                  ; Piattaforma adiacente! Restituisci PlayerY = (ramp_row - ramp_len + 1) * 8 - 16
1139+ 6BB9 3A 63 78         ld   a, (ramp_row)
1140+ 6BBC 21 62 78         ld   hl, ramp_len
1141+ 6BBF 96               sub  (hl)
1142+ 6BC0 3C               inc  a                 ; A = Row
1143+ 6BC1 87               add  a, a              ; *2
1144+ 6BC2 87               add  a, a              ; *4
1145+ 6BC3 87               add  a, a              ; *8
1146+ 6BC4 D6 10            sub  16                ; A = Row * 8 - 16
1147+ 6BC6 37               scf                    ; Set carry (dentro rampa/piattaforma)
1148+ 6BC7 C9               ret
1149+ 6BC8
1150+ 6BC8              .on_ramp_slope:
1151+ 6BC8 3A 63 78         ld   a, (ramp_row)
1152+ 6BCB 87               add  a, a              ; *2
1153+ 6BCC 87               add  a, a              ; *4
1154+ 6BCD 87               add  a, a              ; *8
1155+ 6BCE D6 10            sub  16                ; A = ramp_row * 8 - 16
1156+ 6BD0 83               add  a, e              ; A = ramp_row * 8 - 16 + X_left
1157+ 6BD1 91               sub  c                 ; A = A - PlayerX
1158+ 6BD2
1159+ 6BD2                  ; Calcola la quota della piattaforma:
1160+ 6BD2                  ; platform_Y = (ramp_row - ramp_len + 1) * 8 - 16
1161+ 6BD2 57               ld   d, a              ; D = calculated Y
1162+ 6BD3
1163+ 6BD3 3A 63 78         ld   a, (ramp_row)
1164+ 6BD6 21 62 78         ld   hl, ramp_len
1165+ 6BD9 96               sub  (hl)
1166+ 6BDA 3C               inc  a                 ; A = Row
1167+ 6BDB 87               add  a, a              ; *2
1168+ 6BDC 87               add  a, a              ; *4
