 996+ 6C63              ; -------------------------------------------------------------------
 997+ 6C63              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 998+ 6C63              ; Input: C = X, B = Y
 999+ 6C63              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
1000+ 6C63              ; -------------------------------------------------------------------
1001+ 6C63              CheckWallCell:
1002+ 6C63 E5               push hl
1003+ 6C64 D5               push de
1004+ 6C65 C5               push bc
1005+ 6C66
1006+ 6C66                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1007+ 6C66 78               ld   a, b
1008+ 6C67 FE 80            cp   128
1009+ 6C69 30 1F            jr   nc, .not_wall
1010+ 6C6B
1011+ 6C6B                  ; 2. Calcola riga di layout: r = Y / 8
1012+ 6C6B CB 3F            srl  a
1013+ 6C6D CB 3F            srl  a
1014+ 6C6F CB 3F            srl  a                 ; A = r (0..15)
1015+ 6C71
1016+ 6C71                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1017+ 6C71 5F               ld   e, a              ; E = r (Row)
1018+ 6C72 79               ld   a, c
1019+ 6C73 CB 3F            srl  a
1020+ 6C75 CB 3F            srl  a
1021+ 6C77 CB 3F            srl  a                 ; A = c (0..31)
1022+ 6C79 4F               ld   c, a              ; C = c (Col)
1023+ 6C7A
1024+ 6C7A                  ; Se la cella è sulla rampa, non considerarla un muro!
1025+ 6C7A 53               ld   d, e              ; D = Row
1026+ 6C7B 59               ld   e, c              ; E = Col
1027+ 6C7C CD E8 6B         call IsCellOnRamp
1028+ 6C7F 38 09            jr   c, .not_wall
1029+ 6C81
1030+ 6C81 7A               ld   a, d              ; A = Row
1031+ 6C82 4B               ld   c, e              ; C = Col
1032+ 6C83 CD E3 6C         call GetCellFromUnpacked ; A = cell type
1033+ 6C86
1034+ 6C86                  ; Controlla se è Wall (2)
1035+ 6C86 FE 02            cp   2
1036+ 6C88 28 05            jr   z, .is_wall
1037+ 6C8A
1038+ 6C8A              .not_wall:
1039+ 6C8A C1               pop  bc
1040+ 6C8B D1               pop  de
1041+ 6C8C E1               pop  hl
