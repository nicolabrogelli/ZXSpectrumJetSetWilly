   8+ 77D4              ; Audio_UpdateJumpSound
   9+ 77D4              ;
  10+ 77D4              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 77D4              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 77D4              ; -------------------------------------------------------------------
  13+ 77D4              Audio_UpdateJumpSound:
  14+ 77D4 F5               push af
  15+ 77D5 C5               push bc
  16+ 77D6 D5               push de
  17+ 77D7 E5               push hl
  18+ 77D8
  19+ 77D8                  ; Controlla se il suono è attivo (note < 18)
  20+ 77D8 3A 6A 7C         ld   a, (Audio_jump_sound_note)
  21+ 77DB FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 77DD 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 77DF
  24+ 77DF                  ; Carica la nota corrente da suonare
  25+ 77DF 5F               ld   e, a
  26+ 77E0 16 00            ld   d, 0
  27+ 77E2 21 0E 78         ld   hl, Audio_JumpSoundDelays
  28+ 77E5 19               add  hl, de
  29+ 77E6 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 77E7 57               ld   d, a                      ; D = delay della nota
  31+ 77E8
  32+ 77E8                  ; Suona la nota: 15 cicli
  33+ 77E8 06 0F            ld   b, 15
  34+ 77EA              .note_loop:
  35+ 77EA                  ; Speaker ON
  36+ 77EA 3A F9 78         ld   a, (room_border_color)
  37+ 77ED F6 10            or   $10
  38+ 77EF D3 FE            out  ($fe), a
  39+ 77F1 4A               ld   c, d
  40+ 77F2              .d1:
  41+ 77F2 0D               dec  c
  42+ 77F3 20 FD            jr   nz, .d1
  43+ 77F5
  44+ 77F5                  ; Speaker OFF
  45+ 77F5 3A F9 78         ld   a, (room_border_color)
  46+ 77F8 E6 EF            and  $ef
  47+ 77FA D3 FE            out  ($fe), a
  48+ 77FC 4A               ld   c, d
  49+ 77FD              .d2:
  50+ 77FD 0D               dec  c
  51+ 77FE 20 FD            jr   nz, .d2
  52+ 7800
  53+ 7800 10 E8            djnz .note_loop
  54+ 7802
  55+ 7802                  ; Passa alla nota successiva
  56+ 7802 3A 6A 7C         ld   a, (Audio_jump_sound_note)
  57+ 7805 3C               inc  a
  58+ 7806 32 6A 7C         ld   (Audio_jump_sound_note), a
  59+ 7809
  60+ 7809              .done:
  61+ 7809 E1               pop  hl
  62+ 780A D1               pop  de
  63+ 780B C1               pop  bc
  64+ 780C F1               pop  af
  65+ 780D C9               ret
  66+ 780E
  67+ 780E              Audio_JumpSoundDelays:
  68+ 780E 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7812 19 13 0C 06
  68+ 7816 0C 13 19 20
  68+ 781A 26 2D 33 3A
  68+ 781E 40 47
