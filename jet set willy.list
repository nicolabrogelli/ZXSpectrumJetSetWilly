 250+ 5ECD 86               add  a, (hl)
 251+ 5ECE B9               cp   c
 252+ 5ECF CA DB 5E         jp   z, .check_ramp
 253+ 5ED2 DA DB 5E         jp   c, .check_ramp
 254+ 5ED5              .is_conveyor:
