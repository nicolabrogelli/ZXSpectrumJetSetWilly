   8+ 7A20              ; Audio_UpdateJumpSound
   9+ 7A20              ;
  10+ 7A20              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7A20              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7A20              ; -------------------------------------------------------------------
  13+ 7A20              Audio_UpdateJumpSound:
  14+ 7A20 F5               push af
  15+ 7A21 C5               push bc
  16+ 7A22 D5               push de
  17+ 7A23 E5               push hl
  18+ 7A24
  19+ 7A24                  ; Controlla se il suono è attivo (note < 18)
  20+ 7A24 3A BA 7E         ld   a, (Audio_jump_sound_note)
  21+ 7A27 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7A29 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7A2B
  24+ 7A2B                  ; Carica la nota corrente da suonare
  25+ 7A2B 5F               ld   e, a
  26+ 7A2C 16 00            ld   d, 0
  27+ 7A2E 21 5A 7A         ld   hl, Audio_JumpSoundDelays
  28+ 7A31 19               add  hl, de
  29+ 7A32 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7A33 57               ld   d, a                      ; D = delay della nota
  31+ 7A34
  32+ 7A34                  ; Suona la nota: 15 cicli
  33+ 7A34 06 0F            ld   b, 15
  34+ 7A36              .note_loop:
  35+ 7A36                  ; Speaker ON
  36+ 7A36 3A 45 7B         ld   a, (room_border_color)
  37+ 7A39 F6 10            or   $10
  38+ 7A3B D3 FE            out  ($fe), a
  39+ 7A3D 4A               ld   c, d
  40+ 7A3E              .d1:
  41+ 7A3E 0D               dec  c
  42+ 7A3F 20 FD            jr   nz, .d1
  43+ 7A41
  44+ 7A41                  ; Speaker OFF
  45+ 7A41 3A 45 7B         ld   a, (room_border_color)
  46+ 7A44 E6 EF            and  $ef
  47+ 7A46 D3 FE            out  ($fe), a
  48+ 7A48 4A               ld   c, d
  49+ 7A49              .d2:
  50+ 7A49 0D               dec  c
  51+ 7A4A 20 FD            jr   nz, .d2
  52+ 7A4C
  53+ 7A4C 10 E8            djnz .note_loop
  54+ 7A4E
  55+ 7A4E                  ; Passa alla nota successiva
  56+ 7A4E 3A BA 7E         ld   a, (Audio_jump_sound_note)
  57+ 7A51 3C               inc  a
  58+ 7A52 32 BA 7E         ld   (Audio_jump_sound_note), a
  59+ 7A55
  60+ 7A55              .done:
  61+ 7A55 E1               pop  hl
  62+ 7A56 D1               pop  de
  63+ 7A57 C1               pop  bc
  64+ 7A58 F1               pop  af
  65+ 7A59 C9               ret
  66+ 7A5A
  67+ 7A5A              Audio_JumpSoundDelays:
  68+ 7A5A 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7A5E 19 13 0C 06
  68+ 7A62 0C 13 19 20
  68+ 7A66 26 2D 33 3A
  68+ 7A6A 40 47
