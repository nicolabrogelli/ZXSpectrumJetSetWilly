   2+ 7A64              ; audio.asm
   3+ 7A64              ;
   4+ 7A64              ; Gestione degli effetti sonori e della musica di sottofondo per il beeper.
   5+ 7A64              ;===========================================================================
   6+ 7A64
   7+ 7A64              ; -------------------------------------------------------------------
   8+ 7A64              ; Audio_UpdateJumpSound
   9+ 7A64              ;
  10+ 7A64              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7A64              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7A64              ; -------------------------------------------------------------------
  13+ 7A64              Audio_UpdateJumpSound:
  14+ 7A64 F5               push af
  15+ 7A65 C5               push bc
  16+ 7A66 D5               push de
  17+ 7A67 E5               push hl
  18+ 7A68
  19+ 7A68                  ; Controlla se il suono è attivo (note < 18)
  20+ 7A68 3A 51 7E         ld   a, (Audio_jump_sound_note)
  21+ 7A6B FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7A6D 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7A6F
  24+ 7A6F                  ; Carica la nota corrente da suonare
  25+ 7A6F 5F               ld   e, a
  26+ 7A70 16 00            ld   d, 0
  27+ 7A72 21 9E 7A         ld   hl, Audio_JumpSoundDelays
  28+ 7A75 19               add  hl, de
  29+ 7A76 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7A77 57               ld   d, a                      ; D = delay della nota
  31+ 7A78
  32+ 7A78                  ; Suona la nota: 15 cicli
  33+ 7A78 06 0F            ld   b, 15
  34+ 7A7A              .note_loop:
  35+ 7A7A                  ; Speaker ON
  36+ 7A7A 3A DE 7A         ld   a, (room_border_color)
  37+ 7A7D F6 10            or   $10
  38+ 7A7F D3 FE            out  ($fe), a
  39+ 7A81 4A               ld   c, d
  40+ 7A82              .d1:
  41+ 7A82 0D               dec  c
  42+ 7A83 20 FD            jr   nz, .d1
  43+ 7A85
  44+ 7A85                  ; Speaker OFF
  45+ 7A85 3A DE 7A         ld   a, (room_border_color)
  46+ 7A88 E6 EF            and  $ef
  47+ 7A8A D3 FE            out  ($fe), a
  48+ 7A8C 4A               ld   c, d
  49+ 7A8D              .d2:
  50+ 7A8D 0D               dec  c
  51+ 7A8E 20 FD            jr   nz, .d2
  52+ 7A90
  53+ 7A90 10 E8            djnz .note_loop
  54+ 7A92
  55+ 7A92                  ; Passa alla nota successiva
  56+ 7A92 3A 51 7E         ld   a, (Audio_jump_sound_note)
  57+ 7A95 3C               inc  a
  58+ 7A96 32 51 7E         ld   (Audio_jump_sound_note), a
  59+ 7A99
  60+ 7A99              .done:
  61+ 7A99 E1               pop  hl
  62+ 7A9A D1               pop  de
  63+ 7A9B C1               pop  bc
  64+ 7A9C F1               pop  af
  65+ 7A9D C9               ret
  66+ 7A9E
  67+ 7A9E              Audio_JumpSoundDelays:
  68+ 7A9E 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7AA2 19 13 0C 06
  68+ 7AA6 0C 13 19 20
  68+ 7AAA 26 2D 33 3A
  68+ 7AAE 40 47
  69+ 7AB0
  70+ 7AB0                  IF ENABLE_MUSIC != 0
  71+ 7AB0 ~            ; -------------------------------------------------------------------
  72+ 7AB0 ~            ; Audio_UpdateMusic
  73+ 7AB0 ~            ;
  74+ 7AB0 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 7AB0 ~            ; Viene chiamata a ogni frame.
  76+ 7AB0 ~            ; -------------------------------------------------------------------
  77+ 7AB0 ~            Audio_UpdateMusic:
  78+ 7AB0 ~                push af
  79+ 7AB0 ~                push bc
  80+ 7AB0 ~                push de
  81+ 7AB0 ~                push hl
  82+ 7AB0 ~
  83+ 7AB0 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 7AB0 ~                ld   a, (Audio_jump_sound_note)
  85+ 7AB0 ~                cp   18
  86+ 7AB0 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 7AB0 ~
  88+ 7AB0 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 7AB0 ~                ld   a, (Audio_music_frame_counter)
  90+ 7AB0 ~                dec  a
  91+ 7AB0 ~                ld   (Audio_music_frame_counter), a
  92+ 7AB0 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 7AB0 ~
  94+ 7AB0 ~                ; Altrimenti carica la nota successiva
  95+ 7AB0 ~                ld   a, (Audio_music_note_idx)
  96+ 7AB0 ~                inc  a
  97+ 7AB0 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 7AB0 ~                jr   c, .no_wrap
  99+ 7AB0 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 7AB0 ~            .no_wrap:
 101+ 7AB0 ~                ld   (Audio_music_note_idx), a
 102+ 7AB0 ~
 103+ 7AB0 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 7AB0 ~                ld   e, a
 105+ 7AB0 ~                ld   d, 0
 106+ 7AB0 ~                ld   hl, Audio_MusicSheet
 107+ 7AB0 ~                add  hl, de
 108+ 7AB0 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 7AB0 ~
 110+ 7AB0 ~                ; Leggi durata (secondo byte)
 111+ 7AB0 ~                inc  hl
 112+ 7AB0 ~                ld   a, (hl)
 113+ 7AB0 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 7AB0 ~                jr   nz, .dur_ok
 115+ 7AB0 ~                ld   a, 1
 116+ 7AB0 ~            .dur_ok:
 117+ 7AB0 ~                ld   (Audio_music_frame_counter), a
 118+ 7AB0 ~
 119+ 7AB0 ~            .play_current_note:
 120+ 7AB0 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 7AB0 ~                ld   a, (Audio_music_note_idx)
 122+ 7AB0 ~                ld   e, a
 123+ 7AB0 ~                ld   d, 0
 124+ 7AB0 ~                ld   hl, Audio_MusicSheet
 125+ 7AB0 ~                add  hl, de
 126+ 7AB0 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 7AB0 ~                ld   a, (hl)                  ; A = delay
 128+ 7AB0 ~                or   a
 129+ 7AB0 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 7AB0 ~
 131+ 7AB0 ~                ; Suona la nota: 2 cicli
 132+ 7AB0 ~                ld   d, a                     ; D = delay
 133+ 7AB0 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 7AB0 ~            .note_loop:
 135+ 7AB0 ~                ; Speaker ON
 136+ 7AB0 ~                ld   a, (room_border_color)
 137+ 7AB0 ~                or   $10
 138+ 7AB0 ~                out  ($fe), a
 139+ 7AB0 ~                ld   c, d
 140+ 7AB0 ~            .d1:
 141+ 7AB0 ~                push af
 142+ 7AB0 ~                pop  af
 143+ 7AB0 ~                dec  c
 144+ 7AB0 ~                jr   nz, .d1
 145+ 7AB0 ~
 146+ 7AB0 ~                ; Speaker OFF
 147+ 7AB0 ~                ld   a, (room_border_color)
 148+ 7AB0 ~                and  $ef
 149+ 7AB0 ~                out  ($fe), a
 150+ 7AB0 ~                ld   c, d
 151+ 7AB0 ~            .d2:
 152+ 7AB0 ~                push af
 153+ 7AB0 ~                pop  af
 154+ 7AB0 ~                dec  c
 155+ 7AB0 ~                jr   nz, .d2
 156+ 7AB0 ~
 157+ 7AB0 ~                djnz .note_loop
 158+ 7AB0 ~
 159+ 7AB0 ~            .done:
 160+ 7AB0 ~                pop  hl
 161+ 7AB0 ~                pop  de
 162+ 7AB0 ~                pop  bc
 163+ 7AB0 ~                pop  af
 164+ 7AB0 ~                ret
 165+ 7AB0 ~
 166+ 7AB0 ~            Audio_MusicSheet:
 167+ 7AB0 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 7AB0 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 7AB0 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 7AB0 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 7AB0 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 7AB0 ~                db 90, 10, 107, 20, 68, 65
 173+ 7AB0                  ELSE
 174+ 7AB0              Audio_UpdateMusic:
 175+ 7AB0 C9               ret
 176+ 7AB1                  ENDIF
 177+ 7AB1
 178+ 7AB1              ; -------------------------------------------------------------------
 179+ 7AB1              ; Audio_PlayCollectSound
 180+ 7AB1              ;
 181+ 7AB1              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 7AB1              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 7AB1              ; -------------------------------------------------------------------
 184+ 7AB1              Audio_PlayCollectSound:
 185+ 7AB1 C5               push bc
 186+ 7AB2 D5               push de
 187+ 7AB3
 188+ 7AB3 06 78            ld   b, 120
 189+ 7AB5              .sound_loop:
 190+ 7AB5 3A DE 7A         ld   a, (room_border_color)
 191+ 7AB8 F6 10            or   $10               ; speaker ON
 192+ 7ABA D3 FE            out  ($fe), a
 193+ 7ABC
 194+ 7ABC 0E 3C            ld   c, 60
 195+ 7ABE              .d1:
 196+ 7ABE 0D               dec  c
 197+ 7ABF 20 FD            jr   nz, .d1
 198+ 7AC1
 199+ 7AC1 3A DE 7A         ld   a, (room_border_color)
 200+ 7AC4 E6 EF            and  $ef              ; speaker OFF
 201+ 7AC6 D3 FE            out  ($fe), a
 202+ 7AC8
 203+ 7AC8 0E 3C            ld   c, 60
 204+ 7ACA              .d2:
 205+ 7ACA 0D               dec  c
 206+ 7ACB 20 FD            jr   nz, .d2
 207+ 7ACD
 208+ 7ACD 10 E6            djnz .sound_loop
 209+ 7ACF
 210+ 7ACF D1               pop  de
 211+ 7AD0 C1               pop  bc
 212+ 7AD1 C9               ret
 213+ 7AD2
