 394  8A06 0C               inc  c
 395  8A07 79               ld   a, c
 396  8A08 CB 3F            srl  a
 397  8A0A CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 398  8A0C E6 07            and  7
 399  8A0E 5F               ld   e, a
 400  8A0F 16 00            ld   d, 0
 401  8A11 21 B8 64         ld   hl, game_over_color_table
