 238+ 89BE
 239+ 89BE              ; -------------------------------------------------------------------
 240+ 89BE              ; Audio_PlayGameOverFootSound
 241+ 89BE              ;
 242+ 89BE              ; Genera l'effetto sonoro originale a frequenza crescente durante la
 243+ 89BE              ; discesa del Piede nella schermata di Game Over (come in music/game-over.ogg).
 244+ 89BE              ; Input: B = coordinata Y del Piede (0..96)
 245+ 89BE              ; -------------------------------------------------------------------
 246+ 89BE              Audio_PlayGameOverFootSound:
 247+ 89BE F5               push af
 248+ 89BF C5               push bc
 249+ 89C0 D5               push de
 250+ 89C1
 251+ 89C1                  ; Calcola il ritardo del semionda E = 255 - (2 * Y)
 252+ 89C1 78               ld   a, b                  ; A = Y (0..96)
 253+ 89C2 87               add  a, a                  ; A = 2 * Y (0..192)
 254+ 89C3 2F               cpl                        ; A = 255 - (2 * Y) -> da 255 (tono grave) a 63 (tono acuto)
 255+ 89C4 5F               ld   e, a                  ; E = periodo delay semionda
 256+ 89C5
 257+ 89C5 AF               xor  a                     ; A = 0 (bordo nero, speaker low)
 258+ 89C6 0E 40            ld   c, 64                 ; C = 64 semicicli di commutazione beeper
 259+ 89C8
 260+ 89C8              .sound_loop:
 261+ 89C8 D3 FE            out  ($fe), a              ; Output beeper
 262+ 89CA EE 18            xor  $18                   ; Toggle EAR (bit 4) e MIC (bit 3)
 263+ 89CC 43               ld   b, e                  ; B = delay semionda
 264+ 89CD              .d1:
 265+ 89CD 10 FE            djnz .d1
 266+ 89CF 0D               dec  c
 267+ 89D0 20 F6            jr   nz, .sound_loop
 268+ 89D2
 269+ 89D2                  ; Spegne lo speaker
 270+ 89D2 AF               xor  a
 271+ 89D3 D3 FE            out  ($fe), a
 272+ 89D5
 273+ 89D5 D1               pop  de
 274+ 89D6 C1               pop  bc
 275+ 89D7 F1               pop  af
 276+ 89D8 C9               ret
 277+ 89D9
 278+ 89D9              ; -------------------------------------------------------------------
 279+ 89D9              ; Audio_PlayDieSound
 280+ 89D9              ;
 281+ 89D9              ; Riproduce l'effetto sonoro originale di morte di Willy (music/die.wav).
 282+ 89D9              ; Esegue 8 passi di frequenza decrescente sfumando gli attributi schermo
 283+ 89D9              ; dei primi due terzi ($5800..$59FF) da INK 7 a INK 0 (routine originale 35841).
 284+ 89D9              ; -------------------------------------------------------------------
 285+ 89D9              Audio_PlayDieSound:
 286+ 89D9 F5               push af
 287+ 89DA C5               push bc
 288+ 89DB D5               push de
 289+ 89DC E5               push hl
 290+ 89DD
 291+ 89DD 3E 47            ld   a, 71                 ; Inizia da $47 (Bright 1, Paper 0, Ink 7)
 292+ 89DF
 293+ 89DF              .die_loop:
 294+ 89DF                  ; Riempe gli attributi dei primi due terzi ($5800..$59FF, 512 byte)
 295+ 89DF 21 00 58         ld   hl, $5800
 296+ 89E2 11 01 58         ld   de, $5801
 297+ 89E5 01 FF 01         ld   bc, 511
 298+ 89E8 77               ld   (hl), a
 299+ 89E9 ED B0            ldir
 300+ 89EB
 301+ 89EB 5F               ld   e, a                  ; Salva attributo in E (da 71 a 64)
 302+ 89EC
 303+ 89EC                  ; Calcola delay semionda D = 63 - 8 * (E & 7) -> da 7 a 63
 304+ 89EC 2F               cpl
 305+ 89ED E6 07            and  7
 306+ 89EF 07               rlca
 307+ 89F0 07               rlca
 308+ 89F1 07               rlca
 309+ 89F2 F6 07            or   7
 310+ 89F4 57               ld   d, a                  ; D = delay semionda
 311+ 89F5
 312+ 89F5                  ; Calcola conteggio cicli C = 8 + 32 * (E & 7) -> da 232 a 8
 313+ 89F5 4B               ld   c, e
 314+ 89F6 CB 09            rrc  c
 315+ 89F8 CB 09            rrc  c
 316+ 89FA CB 09            rrc  c
 317+ 89FC
 318+ 89FC AF               xor  a                     ; A = 0 (bordo nero, speaker low)
 319+ 89FD
 320+ 89FD              .tone_loop:
 321+ 89FD D3 FE            out  ($fe), a              ; Output al beeper
 322+ 89FF EE 18            xor  $18                   ; Toggle EAR (bit 4) e MIC (bit 3)
 323+ 8A01 42               ld   b, d                  ; B = delay semionda
 324+ 8A02              .d1:
 325+ 8A02 10 FE            djnz .d1
 326+ 8A04 0D               dec  c
 327+ 8A05 20 F6            jr   nz, .tone_loop
 328+ 8A07
 329+ 8A07 7B               ld   a, e
 330+ 8A08 3D               dec  a
 331+ 8A09 FE 3F            cp   63                    ; Ha completato Ink 0 ($40 = 64)?
 332+ 8A0B 20 D2            jr   nz, .die_loop
 333+ 8A0D
 334+ 8A0D                  ; Spegne lo speaker e assicura bordo nero
 335+ 8A0D AF               xor  a
 336+ 8A0E D3 FE            out  ($fe), a
 337+ 8A10
 338+ 8A10 E1               pop  hl
 339+ 8A11 D1               pop  de
 340+ 8A12 C1               pop  bc
 341+ 8A13 F1               pop  af
 342+ 8A14 C9               ret
 343+ 8A15                  ELSE
 344+ 8A15 ~            Audio_UpdateMusic:
 345+ 8A15 ~                ret
 346+ 8A15 ~            Audio_PlayTitleNote:
 347+ 8A15 ~                or   1
 348+ 8A15 ~                ret
 349+ 8A15 ~            Audio_PlayGameOverFootSound:
 350+ 8A15 ~                halt
 351+ 8A15 ~                ret
 352+ 8A15 ~            Audio_PlayDieSound:
 353+ 8A15 ~                ret
 354+ 8A15                  ENDIF
 355+ 8A15
 356+ 8A15              ; -------------------------------------------------------------------
 357+ 8A15              ; Audio_PlayCollectSound
 358+ 8A15              ;
 359+ 8A15              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 360+ 8A15              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 361+ 8A15              ; -------------------------------------------------------------------
 362+ 8A15              Audio_PlayCollectSound:
 363+ 8A15 C5               push bc
 364+ 8A16 D5               push de
 365+ 8A17
 366+ 8A17 06 78            ld   b, 120
 367+ 8A19              .sound_loop:
 368+ 8A19 3A 50 F8         ld   a, (room_border_color)
 369+ 8A1C F6 10            or   $10               ; speaker ON
 370+ 8A1E D3 FE            out  ($fe), a
 371+ 8A20
 372+ 8A20 0E 3C            ld   c, 60
 373+ 8A22              .d1:
 374+ 8A22 0D               dec  c
 375+ 8A23 20 FD            jr   nz, .d1
 376+ 8A25
 377+ 8A25 3A 50 F8         ld   a, (room_border_color)
 378+ 8A28 E6 EF            and  $ef              ; speaker OFF
 379+ 8A2A D3 FE            out  ($fe), a
 380+ 8A2C
 381+ 8A2C 0E 3C            ld   c, 60
 382+ 8A2E              .d2:
 383+ 8A2E 0D               dec  c
 384+ 8A2F 20 FD            jr   nz, .d2
 385+ 8A31
 386+ 8A31 10 E6            djnz .sound_loop
 387+ 8A33
 388+ 8A33 D1               pop  de
 389+ 8A34 C1               pop  bc
 390+ 8A35 C9               ret
 391+ 8A36
