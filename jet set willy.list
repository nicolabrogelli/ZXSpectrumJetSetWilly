 223+ 76F4 11 00 84         ld   de, TheOffLicenceLayout
 224+ 76F7 B7               or   a
 225+ 76F8 ED 52            sbc  hl, de
 226+ 76FA 20 05            jr   nz, .not_office
 227+ 76FC
 228+ 76FC 3E 00            ld   a, 0               ; Room ID = 0
 229+ 76FE C3 C3 7A         jp   .set_room
