 940+ 8006 DD BE 04         cp   (ix+4)            ; Min Limit (Offset 4)
 941+ 8009 28 08            jr   z, .h_rev_right
 942+ 800B 38 06            jr   c, .h_rev_right
 943+ 800D DD 77 02         ld   (ix+2), a
