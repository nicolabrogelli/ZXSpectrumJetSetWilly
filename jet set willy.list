1017+ 6AB3 2A D1 75         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1018+ 6AB6 11 77 73         ld   de, unpacked_layout ; DE = buffer RAM
1019+ 6AB9 06 80            ld   b, 128             ; 128 byte
1020+ 6ABB              .byte_loop:
1021+ 6ABB 7E               ld   a, (hl)            ; Leggi byte compresso
1022+ 6ABC 23               inc  hl
1023+ 6ABD
1024+ 6ABD 4F               ld   c, a               ; C = salvataggio
1025+ 6ABE
1026+ 6ABE                  ; Cella 0: bit 7-6
