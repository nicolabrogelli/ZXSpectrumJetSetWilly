1064+ 7E40              .set_room:
1065+ 7E40
1066+ 7E40                  ; Salva l'ID della stanza corrente
1067+ 7E40 32 4C E9         ld   (current_room), a
1068+ 7E43
1069+ 7E43                  ; Ripristina i registri
