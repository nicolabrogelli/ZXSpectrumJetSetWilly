 351+ 75B9              ; -------------------------------------------------------------------
 352+ 75B9              ; Controlla se Willy tocca un item attivo nella stanza corrente
 353+ 75B9              ; -------------------------------------------------------------------
 354+ 75B9              CheckRoomItemsCollision:
 355+ 75B9 E5               push hl
 356+ 75BA D5               push de
 357+ 75BB C5               push bc
 358+ 75BC
 359+ 75BC 21 3E 74         ld   hl, ItemsTable
 360+ 75BF              .loop:
 361+ 75BF 7E               ld   a, (hl)           ; A = Room ID
 362+ 75C0 FE FF            cp   $FF               ; Fine tabella?
 363+ 75C2 28 2B            jr   z, .done
 364+ 75C4
 365+ 75C4                  ; Stanza corrente?
 366+ 75C4 57               ld   d, a              ; D = Room ID
 367+ 75C5 3A C5 79         ld   a, (current_room)
 368+ 75C8 BA               cp   d
 369+ 75C9 20 1D            jr   nz, .next_item
 370+ 75CB
 371+ 75CB 23               inc  hl                ; HL punta a X
 372+ 75CC 4E               ld   c, (hl)           ; C = X
 373+ 75CD 23               inc  hl                ; HL punta a Y
 374+ 75CE 46               ld   b, (hl)           ; B = Y
 375+ 75CF 23               inc  hl                ; HL punta al colore (lo saltiamo per il controllo collisione)
 376+ 75D0 23               inc  hl                ; HL punta a collected
 377+ 75D1 7E               ld   a, (hl)           ; A = collected
 378+ 75D2 B7               or   a
 379+ 75D3 20 17            jr   nz, .next_no_inc  ; Già raccolto, salta
 380+ 75D5
 381+ 75D5                  ; Controlla collisione
 382+ 75D5 79               ld   a, c
 383+ 75D6 60               ld   h, b
 384+ 75D7 CD 73 75         call CheckWillyItemCollision
 385+ 75DA 30 10            jr   nc, .next_no_inc
 386+ 75DC
 387+ 75DC                  ; RACCOLTO!
 388+ 75DC 36 01            ld   (hl), 1           ; Imposta collected = 1
 389+ 75DE
 390+ 75DE E5               push hl
 391+ 75DF
 392+ 75DF                  ; Cancella item dallo schermo
 393+ 75DF CD 2F 75         call RestoreBackgroundCell
 394+ 75E2
 395+ 75E2                  ; Suono di raccolta
 396+ 75E2 CD F3 75         call PlayCollectSound
 397+ 75E5
 398+ 75E5 E1               pop  hl
 399+ 75E6
 400+ 75E6 18 04            jr   .next_no_inc
 401+ 75E8
 402+ 75E8              .next_item:
 403+ 75E8 23               inc  hl                ; salta X
 404+ 75E9 23               inc  hl                ; salta Y
 405+ 75EA 23               inc  hl                ; salta colore
 406+ 75EB 23               inc  hl                ; salta collected
 407+ 75EC              .next_no_inc:
 408+ 75EC 23               inc  hl                ; vai al prossimo item
 409+ 75ED 18 D0            jr   .loop
 410+ 75EF
 411+ 75EF              .done:
 412+ 75EF C1               pop  bc
 413+ 75F0 D1               pop  de
 414+ 75F1 E1               pop  hl
 415+ 75F2 C9               ret
