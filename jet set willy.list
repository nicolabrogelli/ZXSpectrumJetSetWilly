   8+ 73E6              ; Audio_UpdateJumpSound
   9+ 73E6              ;
  10+ 73E6              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 73E6              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 73E6              ; -------------------------------------------------------------------
  13+ 73E6              Audio_UpdateJumpSound:
  14+ 73E6 F5               push af
  15+ 73E7 C5               push bc
  16+ 73E8 D5               push de
  17+ 73E9 E5               push hl
  18+ 73EA
  19+ 73EA                  ; Controlla se il suono è attivo (note < 18)
  20+ 73EA 3A 7A 78         ld   a, (Audio_jump_sound_note)
  21+ 73ED FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 73EF 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 73F1
  24+ 73F1                  ; Carica la nota corrente da suonare
  25+ 73F1 5F               ld   e, a
  26+ 73F2 16 00            ld   d, 0
  27+ 73F4 21 20 74         ld   hl, Audio_JumpSoundDelays
  28+ 73F7 19               add  hl, de
  29+ 73F8 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 73F9 57               ld   d, a                      ; D = delay della nota
  31+ 73FA
  32+ 73FA                  ; Suona la nota: 15 cicli
  33+ 73FA 06 0F            ld   b, 15
  34+ 73FC              .note_loop:
  35+ 73FC                  ; Speaker ON
  36+ 73FC 3A 0F 75         ld   a, (room_border_color)
  37+ 73FF F6 10            or   $10
  38+ 7401 D3 FE            out  ($fe), a
  39+ 7403 4A               ld   c, d
  40+ 7404              .d1:
  41+ 7404 0D               dec  c
  42+ 7405 20 FD            jr   nz, .d1
  43+ 7407
  44+ 7407                  ; Speaker OFF
  45+ 7407 3A 0F 75         ld   a, (room_border_color)
  46+ 740A E6 EF            and  $ef
  47+ 740C D3 FE            out  ($fe), a
  48+ 740E 4A               ld   c, d
  49+ 740F              .d2:
  50+ 740F 0D               dec  c
  51+ 7410 20 FD            jr   nz, .d2
  52+ 7412
  53+ 7412 10 E8            djnz .note_loop
  54+ 7414
  55+ 7414                  ; Passa alla nota successiva
  56+ 7414 3A 7A 78         ld   a, (Audio_jump_sound_note)
  57+ 7417 3C               inc  a
  58+ 7418 32 7A 78         ld   (Audio_jump_sound_note), a
  59+ 741B
  60+ 741B              .done:
  61+ 741B E1               pop  hl
  62+ 741C D1               pop  de
  63+ 741D C1               pop  bc
  64+ 741E F1               pop  af
  65+ 741F C9               ret
