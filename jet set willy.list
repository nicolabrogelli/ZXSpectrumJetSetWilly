 220+ 6CFA 87               add  a, a              ; *8
 221+ 6CFB C6 18            add  a, 24             ; A = r * 8 + 24 (limite superiore della riga)
 222+ 6CFD 57               ld   d, a              ; D = limite superiore
 223+ 6CFE
 224+ 6CFE                  ; Vecchio Y + 16
