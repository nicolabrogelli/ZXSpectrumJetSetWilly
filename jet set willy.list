 176+ 757F              ; Audio_PlayCollectSound
 177+ 757F              ;
 178+ 757F              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 179+ 757F              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 180+ 757F              ; -------------------------------------------------------------------
 181+ 757F              Audio_PlayCollectSound:
 182+ 757F C5               push bc
 183+ 7580 D5               push de
 184+ 7581
 185+ 7581 06 78            ld   b, 120
 186+ 7583              .sound_loop:
 187+ 7583 3A AC 75         ld   a, (room_border_color)
 188+ 7586 F6 10            or   $10               ; speaker ON
 189+ 7588 D3 FE            out  ($fe), a
 190+ 758A
 191+ 758A 0E 3C            ld   c, 60
 192+ 758C              .d1:
 193+ 758C 0D               dec  c
 194+ 758D 20 FD            jr   nz, .d1
 195+ 758F
 196+ 758F 3A AC 75         ld   a, (room_border_color)
 197+ 7592 E6 EF            and  $ef              ; speaker OFF
 198+ 7594 D3 FE            out  ($fe), a
 199+ 7596
 200+ 7596 0E 3C            ld   c, 60
 201+ 7598              .d2:
 202+ 7598 0D               dec  c
 203+ 7599 20 FD            jr   nz, .d2
 204+ 759B
 205+ 759B 10 E6            djnz .sound_loop
 206+ 759D
 207+ 759D D1               pop  de
 208+ 759E C1               pop  bc
 209+ 759F C9               ret
