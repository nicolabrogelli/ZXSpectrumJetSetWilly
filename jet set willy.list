  63  7F91                  ; Leggi il colore del bordo dalla stanza corrente e impostalo
  64  7F91 2A 57 76         ld   hl, (room_ptr)
  65  7F94 11 DE 00         ld   de, OFFSET_BORDER_COLOR
  66  7F97 19               add  hl, de
