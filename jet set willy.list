  72+ 8231 ~            ; Audio_UpdateMusic
  73+ 8231 ~            ;
  74+ 8231 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8231 ~            ; Viene chiamata a ogni frame.
  76+ 8231 ~            ; -------------------------------------------------------------------
  77+ 8231 ~            Audio_UpdateMusic:
  78+ 8231 ~                push af
  79+ 8231 ~                push bc
  80+ 8231 ~                push de
  81+ 8231 ~                push hl
  82+ 8231 ~
  83+ 8231 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8231 ~                ld   a, (Audio_jump_sound_note)
  85+ 8231 ~                cp   18
  86+ 8231 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8231 ~
  88+ 8231 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8231 ~                ld   a, (Audio_music_frame_counter)
  90+ 8231 ~                dec  a
  91+ 8231 ~                ld   (Audio_music_frame_counter), a
  92+ 8231 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8231 ~
  94+ 8231 ~                ; Altrimenti carica la nota successiva
  95+ 8231 ~                ld   a, (Audio_music_note_idx)
  96+ 8231 ~                inc  a
  97+ 8231 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8231 ~                jr   c, .no_wrap
  99+ 8231 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8231 ~            .no_wrap:
 101+ 8231 ~                ld   (Audio_music_note_idx), a
 102+ 8231 ~
 103+ 8231 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8231 ~                ld   e, a
 105+ 8231 ~                ld   d, 0
 106+ 8231 ~                ld   hl, Audio_MusicSheet
 107+ 8231 ~                add  hl, de
 108+ 8231 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8231 ~
 110+ 8231 ~                ; Leggi durata (secondo byte)
 111+ 8231 ~                inc  hl
 112+ 8231 ~                ld   a, (hl)
 113+ 8231 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8231 ~                jr   nz, .dur_ok
 115+ 8231 ~                ld   a, 1
 116+ 8231 ~            .dur_ok:
 117+ 8231 ~                ld   (Audio_music_frame_counter), a
 118+ 8231 ~
 119+ 8231 ~            .play_current_note:
 120+ 8231 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8231 ~                ld   a, (Audio_music_note_idx)
 122+ 8231 ~                ld   e, a
 123+ 8231 ~                ld   d, 0
 124+ 8231 ~                ld   hl, Audio_MusicSheet
 125+ 8231 ~                add  hl, de
 126+ 8231 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8231 ~                ld   a, (hl)                  ; A = delay
 128+ 8231 ~                or   a
 129+ 8231 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8231 ~
 131+ 8231 ~                ; Suona la nota: 2 cicli
 132+ 8231 ~                ld   d, a                     ; D = delay
 133+ 8231 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8231 ~            .note_loop:
 135+ 8231 ~                ; Speaker ON
 136+ 8231 ~                ld   a, (room_border_color)
 137+ 8231 ~                or   $10
 138+ 8231 ~                out  ($fe), a
 139+ 8231 ~                ld   c, d
 140+ 8231 ~            .d1:
 141+ 8231 ~                push af
 142+ 8231 ~                pop  af
 143+ 8231 ~                dec  c
 144+ 8231 ~                jr   nz, .d1
 145+ 8231 ~
 146+ 8231 ~                ; Speaker OFF
 147+ 8231 ~                ld   a, (room_border_color)
 148+ 8231 ~                and  $ef
 149+ 8231 ~                out  ($fe), a
 150+ 8231 ~                ld   c, d
 151+ 8231 ~            .d2:
 152+ 8231 ~                push af
 153+ 8231 ~                pop  af
 154+ 8231 ~                dec  c
 155+ 8231 ~                jr   nz, .d2
 156+ 8231 ~
 157+ 8231 ~                djnz .note_loop
 158+ 8231 ~
 159+ 8231 ~            .done:
 160+ 8231 ~                pop  hl
 161+ 8231 ~                pop  de
 162+ 8231 ~                pop  bc
 163+ 8231 ~                pop  af
 164+ 8231 ~                ret
 165+ 8231 ~
 166+ 8231 ~            Audio_MusicSheet:
 167+ 8231 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8231 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8231 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8231 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8231 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8231 ~                db 90, 10, 107, 20, 68, 65
 173+ 8231                  ELSE
 174+ 8231              Audio_UpdateMusic:
 175+ 8231 C9               ret
 176+ 8232                  ENDIF
