 274  8762              ; ShowTitleScreen
 275  8762              ; Visualizza la schermata iniziale del gioco (Title Screen).
 276  8762              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 277  8762              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 278  8762              ; -------------------------------------------------------------------
 279  8762              ShowTitleScreen:
 280  8762                  ; 1. Disegna la schermata iniziale
 281  8762 CD 1B 63         call Gfx_DrawTitleScreen
 282  8765
 283  8765                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 284  8765              .wait_title_enter_release:
 285  8765 76               halt
 286  8766 3E BF            ld   a, $bf
 287  8768 DB FE            in   a, ($fe)
 288  876A 1F               rra
 289  876B 30 F8            jr   nc, .wait_title_enter_release
 290  876D
 291  876D                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 292  876D 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 293  876F              .title_loop:
 294  876F 76               halt
 295  8770
 296  8770                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 297  8770 0C               inc  c
 298  8771 79               ld   a, c
 299  8772 CB 3F            srl  a
 300  8774 CB 3F            srl  a
 301  8776 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 302  8778 E6 07            and  7
 303  877A 5F               ld   e, a
 304  877B 16 00            ld   d, 0
 305  877D 21 13 63         ld   hl, title_color_table
 306  8780 19               add  hl, de
 307  8781 7E               ld   a, (hl)               ; A = nuovo colore
 308  8782 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 309  8785 06 20            ld   b, 32
 310  8787              .color_title_loop:
 311  8787 77               ld   (hl), a
 312  8788 23               inc  hl
 313  8789 10 FC            djnz .color_title_loop
 314  878B
 315  878B                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 316  878B 3E BF            ld   a, $bf
 317  878D DB FE            in   a, ($fe)
 318  878F 1F               rra
 319  8790 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 320  8792
 321  8792                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 322  8792              .wait_title_enter_release_after:
 323  8792 76               halt
