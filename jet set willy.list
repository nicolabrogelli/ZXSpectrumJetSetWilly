1246+ 84DD
1247+ 84DD 29               add  hl, hl            ; *2
1248+ 84DE 29               add  hl, hl            ; *4
1249+ 84DF 29               add  hl, hl            ; *8
1250+ 84E0 29               add  hl, hl            ; *16
1251+ 84E1 29               add  hl, hl            ; *32
1252+ 84E2
1253+ 84E2 16 00            ld   d, 0
1254+ 84E4 59               ld   e, c              ; DE = Col
1255+ 84E5
1256+ 84E5 19               add  hl, de            ; Row*32 + Col
1257+ 84E6
1258+ 84E6 11 81 EA         ld   de, items_grid
