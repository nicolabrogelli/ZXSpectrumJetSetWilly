1857+ 748E              ; Verifica se c'è una cella Nasty (tipo 3) alle coordinate pixel (X, Y)
1858+ 748E              ; Input: C = X, B = Y
1859+ 748E              ; Output: Carry flag impostato se è Nasty, altrimenti resettato
1860+ 748E              ; -------------------------------------------------------------------
1861+ 748E              CheckNastyCell:
1862+ 748E E5               push hl
1863+ 748F D5               push de
1864+ 7490 C5               push bc
1865+ 7491
1866+ 7491                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1867+ 7491 78               ld   a, b
1868+ 7492 FE 80            cp   128
1869+ 7494 30 17            jr   nc, .not_nasty
1870+ 7496
1871+ 7496                  ; 2. Calcola riga di layout: r = Y / 8
1872+ 7496 CB 3F            srl  a
1873+ 7498 CB 3F            srl  a
1874+ 749A CB 3F            srl  a                 ; A = r (0..15)
1875+ 749C
1876+ 749C                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1877+ 749C 5F               ld   e, a              ; E = r
1878+ 749D 79               ld   a, c
1879+ 749E CB 3F            srl  a
1880+ 74A0 CB 3F            srl  a
1881+ 74A2 CB 3F            srl  a                 ; A = c (0..31)
1882+ 74A4 4F               ld   c, a              ; C = c
1883+ 74A5 7B               ld   a, e              ; A = r
1884+ 74A6
1885+ 74A6 CD 14 72         call GetCellFromUnpacked ; A = cell type
1886+ 74A9
1887+ 74A9                  ; Controlla se è Nasty (3)
1888+ 74A9 FE 03            cp   3
1889+ 74AB 28 05            jr   z, .is_nasty
1890+ 74AD
1891+ 74AD              .not_nasty:
1892+ 74AD C1               pop  bc
1893+ 74AE D1               pop  de
1894+ 74AF E1               pop  hl
1895+ 74B0 B7               or   a                 ; Clear carry
1896+ 74B1 C9               ret
1897+ 74B2
1898+ 74B2              .is_nasty:
