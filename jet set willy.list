   7+ 8659              ; -------------------------------------------------------------------
   8+ 8659              ; Audio_UpdateJumpSound
   9+ 8659              ;
  10+ 8659              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8659              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8659              ; -------------------------------------------------------------------
  13+ 8659              Audio_UpdateJumpSound:
  14+ 8659 F5               push af
  15+ 865A C5               push bc
  16+ 865B D5               push de
  17+ 865C E5               push hl
  18+ 865D
  19+ 865D                  ; Controlla se il suono è attivo (note < 18)
  20+ 865D 3A 8F F0         ld   a, (Audio_jump_sound_note)
  21+ 8660 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8662 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8664
  24+ 8664                  ; Carica la nota corrente da suonare
  25+ 8664 5F               ld   e, a
  26+ 8665 16 00            ld   d, 0
  27+ 8667 21 93 86         ld   hl, Audio_JumpSoundDelays
  28+ 866A 19               add  hl, de
  29+ 866B 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 866C 57               ld   d, a                      ; D = delay della nota
  31+ 866D
  32+ 866D                  ; Suona la nota: 15 cicli
  33+ 866D 06 0F            ld   b, 15
  34+ 866F              .note_loop:
  35+ 866F                  ; Speaker ON
  36+ 866F 3A 88 EC         ld   a, (room_border_color)
  37+ 8672 F6 10            or   $10
  38+ 8674 D3 FE            out  ($fe), a
  39+ 8676 4A               ld   c, d
  40+ 8677              .d1:
  41+ 8677 0D               dec  c
  42+ 8678 20 FD            jr   nz, .d1
  43+ 867A
  44+ 867A                  ; Speaker OFF
  45+ 867A 3A 88 EC         ld   a, (room_border_color)
  46+ 867D E6 EF            and  $ef
  47+ 867F D3 FE            out  ($fe), a
  48+ 8681 4A               ld   c, d
  49+ 8682              .d2:
  50+ 8682 0D               dec  c
  51+ 8683 20 FD            jr   nz, .d2
  52+ 8685
  53+ 8685 10 E8            djnz .note_loop
  54+ 8687
  55+ 8687                  ; Passa alla nota successiva
  56+ 8687 3A 8F F0         ld   a, (Audio_jump_sound_note)
  57+ 868A 3C               inc  a
  58+ 868B 32 8F F0         ld   (Audio_jump_sound_note), a
  59+ 868E
  60+ 868E              .done:
  61+ 868E E1               pop  hl
  62+ 868F D1               pop  de
  63+ 8690 C1               pop  bc
  64+ 8691 F1               pop  af
  65+ 8692 C9               ret
  66+ 8693
  67+ 8693              Audio_JumpSoundDelays:
  68+ 8693 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 8697 19 13 0C 06
  68+ 869B 0C 13 19 20
  68+ 869F 26 2D 33 3A
  68+ 86A3 40 47
  69+ 86A5
  70+ 86A5                  IF ENABLE_MUSIC != 0
  71+ 86A5 ~            ; -------------------------------------------------------------------
  72+ 86A5 ~            ; Audio_UpdateMusic
  73+ 86A5 ~            ;
  74+ 86A5 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 86A5 ~            ; Viene chiamata a ogni frame.
  76+ 86A5 ~            ; -------------------------------------------------------------------
  77+ 86A5 ~            Audio_UpdateMusic:
  78+ 86A5 ~                push af
  79+ 86A5 ~                push bc
  80+ 86A5 ~                push de
  81+ 86A5 ~                push hl
  82+ 86A5 ~
  83+ 86A5 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 86A5 ~                ld   a, (Audio_jump_sound_note)
  85+ 86A5 ~                cp   18
  86+ 86A5 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 86A5 ~
  88+ 86A5 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 86A5 ~                ld   a, (Audio_music_frame_counter)
  90+ 86A5 ~                dec  a
  91+ 86A5 ~                ld   (Audio_music_frame_counter), a
  92+ 86A5 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 86A5 ~
  94+ 86A5 ~                ; Altrimenti carica la nota successiva
  95+ 86A5 ~                ld   a, (Audio_music_note_idx)
  96+ 86A5 ~                inc  a
  97+ 86A5 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 86A5 ~                jr   c, .no_wrap
  99+ 86A5 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 86A5 ~            .no_wrap:
 101+ 86A5 ~                ld   (Audio_music_note_idx), a
 102+ 86A5 ~
 103+ 86A5 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 86A5 ~                ld   e, a
 105+ 86A5 ~                ld   d, 0
 106+ 86A5 ~                ld   hl, Audio_MusicSheet
 107+ 86A5 ~                add  hl, de
 108+ 86A5 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 86A5 ~
 110+ 86A5 ~                ; Leggi durata (secondo byte)
 111+ 86A5 ~                inc  hl
 112+ 86A5 ~                ld   a, (hl)
 113+ 86A5 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 86A5 ~                jr   nz, .dur_ok
 115+ 86A5 ~                ld   a, 1
 116+ 86A5 ~            .dur_ok:
 117+ 86A5 ~                ld   (Audio_music_frame_counter), a
 118+ 86A5 ~
 119+ 86A5 ~            .play_current_note:
 120+ 86A5 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 86A5 ~                ld   a, (Audio_music_note_idx)
 122+ 86A5 ~                ld   e, a
 123+ 86A5 ~                ld   d, 0
 124+ 86A5 ~                ld   hl, Audio_MusicSheet
 125+ 86A5 ~                add  hl, de
 126+ 86A5 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 86A5 ~                ld   a, (hl)                  ; A = delay
 128+ 86A5 ~                or   a
 129+ 86A5 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 86A5 ~
 131+ 86A5 ~                ; Suona la nota: 2 cicli
 132+ 86A5 ~                ld   d, a                     ; D = delay
 133+ 86A5 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 86A5 ~            .note_loop:
 135+ 86A5 ~                ; Speaker ON
 136+ 86A5 ~                ld   a, (room_border_color)
 137+ 86A5 ~                or   $10
 138+ 86A5 ~                out  ($fe), a
 139+ 86A5 ~                ld   c, d
 140+ 86A5 ~            .d1:
 141+ 86A5 ~                push af
 142+ 86A5 ~                pop  af
 143+ 86A5 ~                dec  c
 144+ 86A5 ~                jr   nz, .d1
 145+ 86A5 ~
 146+ 86A5 ~                ; Speaker OFF
 147+ 86A5 ~                ld   a, (room_border_color)
 148+ 86A5 ~                and  $ef
 149+ 86A5 ~                out  ($fe), a
 150+ 86A5 ~                ld   c, d
 151+ 86A5 ~            .d2:
 152+ 86A5 ~                push af
 153+ 86A5 ~                pop  af
 154+ 86A5 ~                dec  c
 155+ 86A5 ~                jr   nz, .d2
 156+ 86A5 ~
 157+ 86A5 ~                djnz .note_loop
 158+ 86A5 ~
 159+ 86A5 ~            .done:
 160+ 86A5 ~                pop  hl
 161+ 86A5 ~                pop  de
 162+ 86A5 ~                pop  bc
 163+ 86A5 ~                pop  af
 164+ 86A5 ~                ret
 165+ 86A5 ~
 166+ 86A5 ~            Audio_MusicSheet:
 167+ 86A5 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 86A5 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 86A5 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 86A5 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 86A5 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 86A5 ~                db 90, 10, 107, 20, 68, 65
 173+ 86A5                  ELSE
 174+ 86A5              Audio_UpdateMusic:
 175+ 86A5 C9               ret
 176+ 86A6                  ENDIF
