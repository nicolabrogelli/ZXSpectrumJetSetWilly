1906+ 74DA              ; Controlla la collisione di Willy con le celle Nasty (tipo 3)
1907+ 74DA              ; Controlla 6 punti strategici della bounding box di Willy (16x8 pixel)
1908+ 74DA              ; Output: Carry flag impostato se c'è collisione, altrimenti resettato
1909+ 74DA              ; -------------------------------------------------------------------
1910+ 74DA              Phys_CheckNastyCollision:
1911+ 74DA C5               push bc
1912+ 74DB
1913+ 74DB ED 4B 16 E7      ld   bc, (PlayerPos)   ; B = Y, C = X
1914+ 74DF
1915+ 74DF                  ; Punto 1: Top-Left (X, Y)
1916+ 74DF CD B1 74         call CheckNastyCell
1917+ 74E2 38 38            jr   c, .collision
1918+ 74E4
1919+ 74E4                  ; Punto 2: Top-Right (X + 7, Y)
1920+ 74E4 79               ld   a, c
1921+ 74E5 C6 07            add  a, 7
1922+ 74E7 4F               ld   c, a
1923+ 74E8 CD B1 74         call CheckNastyCell
1924+ 74EB 38 2F            jr   c, .collision
1925+ 74ED
1926+ 74ED                  ; Punto 3: Mid-Left (X, Y + 7)
1927+ 74ED ED 4B 16 E7      ld   bc, (PlayerPos)
1928+ 74F1 78               ld   a, b
1929+ 74F2 C6 07            add  a, 7
1930+ 74F4 47               ld   b, a
1931+ 74F5 CD B1 74         call CheckNastyCell
1932+ 74F8 38 22            jr   c, .collision
1933+ 74FA
1934+ 74FA                  ; Punto 4: Mid-Right (X + 7, Y + 7)
1935+ 74FA 79               ld   a, c
1936+ 74FB C6 07            add  a, 7
1937+ 74FD 4F               ld   c, a
1938+ 74FE CD B1 74         call CheckNastyCell
1939+ 7501 38 19            jr   c, .collision
1940+ 7503
1941+ 7503                  ; Punto 5: Bottom-Left (X, Y + 15)
1942+ 7503 ED 4B 16 E7      ld   bc, (PlayerPos)
1943+ 7507 78               ld   a, b
1944+ 7508 C6 0F            add  a, 15
1945+ 750A 47               ld   b, a
1946+ 750B CD B1 74         call CheckNastyCell
1947+ 750E 38 0C            jr   c, .collision
1948+ 7510
1949+ 7510                  ; Punto 6: Bottom-Right (X + 7, Y + 15)
1950+ 7510 79               ld   a, c
1951+ 7511 C6 07            add  a, 7
1952+ 7513 4F               ld   c, a
1953+ 7514 CD B1 74         call CheckNastyCell
1954+ 7517 38 03            jr   c, .collision
1955+ 7519
1956+ 7519 C1               pop  bc
1957+ 751A B7               or   a                 ; Clear carry
1958+ 751B C9               ret
1959+ 751C
1960+ 751C              .collision:
1961+ 751C C1               pop  bc
1962+ 751D 37               scf                    ; Set carry
1963+ 751E C9               ret
