 393+ 6D01 E5               push hl
 394+ 6D02 DD E1            pop  ix                ; IX = tile pointer
 395+ 6D04
 396+ 6D04 FD E5            push iy
 397+ 6D06 C1               pop  bc                ; B = Row, C = Col
 398+ 6D07
 399+ 6D07 CD 8C 61         call DrawTile
 400+ 6D0A
 401+ 6D0A DD E1            pop  ix
 402+ 6D0C E1               pop  hl
 403+ 6D0D D1               pop  de
