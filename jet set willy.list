 574+ 775F
 575+ 775F C9               ret
 576+ 7760
 577+ 7760              ; -------------------------------------------------------------------
 578+ 7760              ; Items_DrawRoom
 579+ 7760              ;
 580+ 7760              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 581+ 7760              ;
 582+ 7760              ; Operazioni eseguite:
 583+ 7760              ;   1. Azzera la griglia items_grid.
 584+ 7760              ;   2. Svuota la cache degli oggetti attivi.
 585+ 7760              ;   3. Scansiona ItemsTable.
 586+ 7760              ;   4. Per ogni item della stanza corrente:
 587+ 7760              ;        - verifica se è già stato raccolto
 588+ 7760              ;        - disegna la grafica
 589+ 7760              ;        - aggiorna items_grid
 590+ 7760              ;        - memorizza l'item nella cache current_room_items
 591+ 7760              ;   5. Aggiorna num_room_items.
 592+ 7760              ;
 593+ 7760              ; Record ItemsTable:
 594+ 7760              ;   +0  Room ID
 595+ 7760              ;   +1  X (colonna)
 596+ 7760              ;   +2  Y (riga)
 597+ 7760              ;   +3  Colore
 598+ 7760              ;   +4  Collected flag
 599+ 7760              ;
 600+ 7760              ; Cache current_room_items:
 601+ 7760              ;   +0  Colonna
 602+ 7760              ;   +1  Riga
 603+ 7760              ;   +2  Colore
 604+ 7760              ;   +3  Collected flag ptr (Low)
 605+ 7760              ;   +4  Collected flag ptr (High)
 606+ 7760              ;
 607+ 7760              ; Ogni record cache occupa 5 byte.
 608+ 7760              ; -------------------------------------------------------------------
 609+ 7760              Items_DrawRoom:
 610+ 7760
 611+ 7760                  ; Salva tutti i registri utilizzati
 612+ 7760 E5               push hl
 613+ 7761 D5               push de
 614+ 7762 C5               push bc
 615+ 7763 DD E5            push ix
 616+ 7765 FD E5            push iy
 617+ 7767
 618+ 7767                  ; ---------------------------------------------------------------
 619+ 7767                  ; Azzera items_grid (32 x 16 = 512 byte)
 620+ 7767                  ; ---------------------------------------------------------------
 621+ 7767 21 00 B0         ld   hl, items_grid
 622+ 776A 11 01 B0         ld   de, items_grid + 1
 623+ 776D 36 00            ld   (hl), 0
 624+ 776F 01 FF 01         ld   bc, 511
 625+ 7772 ED B0            ldir
 626+ 7774
 627+ 7774                  ; ---------------------------------------------------------------
 628+ 7774                  ; Nessun item attivo nella stanza
 629+ 7774                  ; ---------------------------------------------------------------
 630+ 7774 AF               xor  a
 631+ 7775 32 B6 7D         ld   (num_room_items), a
 632+ 7778
 633+ 7778                  ; IY punta alla cache degli item attivi
 634+ 7778 FD 21 66 7D      ld   iy, current_room_items
 635+ 777C
 636+ 777C                  ; ---------------------------------------------------------------
 637+ 777C                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 638+ 777C                  ; alla stanza corrente.
 639+ 777C                  ;
 640+ 777C                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 641+ 777C                  ; ---------------------------------------------------------------
 642+ 777C 2A B7 7D         ld   hl, (room_ptr)
 643+ 777F 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 644+ 7782 19               add  hl, de
 645+ 7783
 646+ 7783 E5               push hl
 647+ 7784 DD E1            pop  ix                ; IX = bitmap item
 648+ 7786
 649+ 7786                  ; ---------------------------------------------------------------
 650+ 7786                  ; Inizio scansione della tabella degli item
 651+ 7786                  ; ---------------------------------------------------------------
 652+ 7786 21 AD 74         ld   hl, ItemsTable
 653+ 7789
 654+ 7789              .loop:
 655+ 7789
 656+ 7789                  ; ---------------------------------------------------------------
 657+ 7789                  ; Legge il Room ID del record corrente
 658+ 7789                  ; ---------------------------------------------------------------
 659+ 7789 7E               ld   a, (hl)
 660+ 778A
 661+ 778A                  ; $FF indica fine tabella
 662+ 778A FE FF            cp   $FF
 663+ 778C 28 53            jr   z, .done
 664+ 778E
 665+ 778E                  ; ---------------------------------------------------------------
 666+ 778E                  ; Verifica se l'item appartiene alla stanza corrente
 667+ 778E                  ; ---------------------------------------------------------------
 668+ 778E 57               ld   d, a
 669+ 778F
 670+ 778F 3A 5D 7D         ld   a, (current_room)
 671+ 7792 BA               cp   d
 672+ 7793 20 45            jr   nz, .next_item
 673+ 7795
 674+ 7795                  ; ---------------------------------------------------------------
 675+ 7795                  ; Legge i dati dell'item
 676+ 7795                  ; ---------------------------------------------------------------
 677+ 7795
 678+ 7795 23               inc  hl
 679+ 7796 4E               ld   c, (hl)           ; X (colonna)
 680+ 7797
 681+ 7797 23               inc  hl
 682+ 7798 46               ld   b, (hl)           ; Y (riga)
 683+ 7799
 684+ 7799 23               inc  hl
 685+ 779A 5E               ld   e, (hl)           ; Colore
 686+ 779B
 687+ 779B 23               inc  hl
 688+ 779C 7E               ld   a, (hl)           ; Collected flag
 689+ 779D
 690+ 779D                  ; Se diverso da zero l'item è già stato raccolto
 691+ 779D B7               or   a
 692+ 779E 20 3E            jr   nz, .next_no_inc
 693+ 77A0
 694+ 77A0                  ; ---------------------------------------------------------------
 695+ 77A0                  ; Disegna l'item sullo schermo
 696+ 77A0                  ;
 697+ 77A0                  ; B = Row
 698+ 77A0                  ; C = Column
 699+ 77A0                  ; HL = bitmap pointer
 700+ 77A0                  ; E = Color
 701+ 77A0                  ; ---------------------------------------------------------------
 702+ 77A0 E5               push hl
 703+ 77A1
 704+ 77A1 DD E5            push ix
 705+ 77A3 E1               pop  hl
 706+ 77A4
 707+ 77A4 CD E9 77         call DrawItemGraphic
 708+ 77A7
 709+ 77A7 E1               pop  hl                ; ritorna al flag collected
 710+ 77A8
 711+ 77A8                  ; ---------------------------------------------------------------
 712+ 77A8                  ; Aggiorna items_grid
 713+ 77A8                  ;
 714+ 77A8                  ; Calcolo:
 715+ 77A8                  ;   offset = Row * 32 + Col
 716+ 77A8                  ; ---------------------------------------------------------------
 717+ 77A8 E5               push hl
 718+ 77A9 D5               push de
 719+ 77AA
 720+ 77AA 26 00            ld   h, 0
 721+ 77AC 68               ld   l, b              ; HL = Row
 722+ 77AD
 723+ 77AD 29               add  hl, hl            ; *2
 724+ 77AE 29               add  hl, hl            ; *4
 725+ 77AF 29               add  hl, hl            ; *8
 726+ 77B0 29               add  hl, hl            ; *16
 727+ 77B1 29               add  hl, hl            ; *32
 728+ 77B2
 729+ 77B2 16 00            ld   d, 0
 730+ 77B4 59               ld   e, c              ; DE = Col
 731+ 77B5
 732+ 77B5 19               add  hl, de            ; Row*32 + Col
 733+ 77B6
 734+ 77B6 11 00 B0         ld   de, items_grid
 735+ 77B9 19               add  hl, de            ; puntatore nella griglia
 736+ 77BA
 737+ 77BA D1               pop  de                ; ripristina colore
 738+ 77BB
 739+ 77BB 73               ld   (hl), e           ; salva colore cella
 740+ 77BC
 741+ 77BC E1               pop  hl
 742+ 77BD
 743+ 77BD                  ; ---------------------------------------------------------------
 744+ 77BD                  ; Salva l'item nella cache della stanza
 745+ 77BD                  ;
 746+ 77BD                  ; Questo evita di dover scansionare tutta ItemsTable
 747+ 77BD                  ; durante il controllo delle collisioni.
 748+ 77BD                  ; ---------------------------------------------------------------
 749+ 77BD
 750+ 77BD FD 71 00         ld   (iy+0), c         ; Colonna
 751+ 77C0 FD 70 01         ld   (iy+1), b         ; Riga
 752+ 77C3 FD 73 02         ld   (iy+2), e         ; Colore
 753+ 77C6
 754+ 77C6                  ; Salva il puntatore al flag "collected"
 755+ 77C6 FD 75 03         ld   (iy+3), l         ; Low byte
 756+ 77C9 FD 74 04         ld   (iy+4), h         ; High byte
 757+ 77CC
 758+ 77CC                  ; Passa al record successivo della cache
 759+ 77CC 01 05 00         ld   bc, 5
 760+ 77CF FD 09            add  iy, bc
 761+ 77D1
 762+ 77D1                  ; Incrementa il numero di item attivi
 763+ 77D1 3A B6 7D         ld   a, (num_room_items)
 764+ 77D4 3C               inc  a
 765+ 77D5 32 B6 7D         ld   (num_room_items), a
 766+ 77D8
 767+ 77D8 18 04            jr   .next_no_inc
 768+ 77DA
 769+ 77DA              .next_item:
 770+ 77DA
 771+ 77DA                  ; ---------------------------------------------------------------
 772+ 77DA                  ; L'item non appartiene alla stanza corrente.
 773+ 77DA                  ; Salta i campi del record:
 774+ 77DA                  ;   X
 775+ 77DA                  ;   Y
 776+ 77DA                  ;   Color
 777+ 77DA                  ;   Collected
 778+ 77DA                  ; ---------------------------------------------------------------
 779+ 77DA 23               inc  hl
 780+ 77DB 23               inc  hl
 781+ 77DC 23               inc  hl
 782+ 77DD 23               inc  hl
 783+ 77DE
 784+ 77DE              .next_no_inc:
 785+ 77DE
 786+ 77DE                  ; ---------------------------------------------------------------
 787+ 77DE                  ; Avanza al record successivo
 788+ 77DE                  ; (prossimo Room ID)
 789+ 77DE                  ; ---------------------------------------------------------------
 790+ 77DE 23               inc  hl
 791+ 77DF 18 A8            jr   .loop
 792+ 77E1
 793+ 77E1              .done:
 794+ 77E1
 795+ 77E1                  ; Ripristina i registri
 796+ 77E1 FD E1            pop  iy
 797+ 77E3 DD E1            pop  ix
 798+ 77E5 D1               pop  de
 799+ 77E6 C1               pop  bc
 800+ 77E7 E1               pop  hl
 801+ 77E8
 802+ 77E8 C9               ret
 803+ 77E9
 804+ 77E9              ; -------------------------------------------------------------------
 805+ 77E9              ; DrawItemGraphic
 806+ 77E9              ;
 807+ 77E9              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 808+ 77E9              ; utilizzando una bitmap di 8 byte e un attributo colore.
 809+ 77E9              ;
 810+ 77E9              ; Input:
 811+ 77E9              ;   B = Riga attributi (3..18)
 812+ 77E9              ;   C = Colonna attributi (0..31)
 813+ 77E9              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 814+ 77E9              ;   E = Attributo colore
 815+ 77E9              ;
 816+ 77E9              ; Output:
 817+ 77E9              ;   Nessuno
 818+ 77E9              ;
 819+ 77E9              ; Registri preservati:
 820+ 77E9              ;   BC, DE, HL
 821+ 77E9              ; -------------------------------------------------------------------
 822+ 77E9              DrawItemGraphic:
 823+ 77E9
 824+ 77E9                  ; Salva i registri originali
 825+ 77E9 C5               push bc
 826+ 77EA D5               push de
 827+ 77EB E5               push hl
 828+ 77EC
 829+ 77EC                  ; ---------------------------------------------------------------
 830+ 77EC                  ; Calcolo indirizzo bitmap dello Spectrum
 831+ 77EC                  ;
 832+ 77EC                  ; Ogni item occupa una cella attributi (8x8 pixel).
 833+ 77EC                  ;
 834+ 77EC                  ; Formula:
 835+ 77EC                  ;   High = $40 + (Row AND $18)
 836+ 77EC                  ;   Low  = (Row AND 7) * 32 + Col
 837+ 77EC                  ;
 838+ 77EC                  ; DE conterrà l'indirizzo della prima scanline.
 839+ 77EC                  ; ---------------------------------------------------------------
 840+ 77EC
 841+ 77EC 78               ld   a, b
 842+ 77ED E6 18            and  $18
 843+ 77EF C6 40            add  a, $40
 844+ 77F1 57               ld   d, a              ; Byte alto indirizzo video
 845+ 77F2
 846+ 77F2 78               ld   a, b
 847+ 77F3 E6 07            and  7                 ; Riga interna al blocco da 8
 848+ 77F5
 849+ 77F5 87               add  a, a              ; *2
 850+ 77F6 87               add  a, a              ; *4
 851+ 77F7 87               add  a, a              ; *8
 852+ 77F8 87               add  a, a              ; *16
 853+ 77F9 87               add  a, a              ; *32
 854+ 77FA
 855+ 77FA 81               add  a, c              ; + colonna
 856+ 77FB
 857+ 77FB 5F               ld   e, a              ; Byte basso indirizzo video
 858+ 77FC
 859+ 77FC                  ; ---------------------------------------------------------------
 860+ 77FC                  ; Disegno bitmap
 861+ 77FC                  ;
 862+ 77FC                  ; Copia 8 byte consecutivi nella memoria video.
 863+ 77FC                  ; Ogni byte rappresenta una scanline da 8 pixel.
 864+ 77FC                  ; ---------------------------------------------------------------
 865+ 77FC
 866+ 77FC C5               push bc                ; Conserva Row e Col
 867+ 77FD
 868+ 77FD 06 08            ld   b, 8              ; Numero scanline
 869+ 77FF
 870+ 77FF              .line_loop:
 871+ 77FF
 872+ 77FF 7E               ld   a, (hl)           ; Legge scanline bitmap
 873+ 7800 12               ld   (de), a           ; Scrive nella memoria video
 874+ 7801
 875+ 7801 14               inc  d                 ; Scanline successiva
 876+ 7802 23               inc  hl                ; Byte bitmap successivo
 877+ 7803
 878+ 7803 05               dec  b
 879+ 7804 20 F9            jr   nz, .line_loop
 880+ 7806
 881+ 7806 C1               pop  bc                ; Ripristina Row e Col
 882+ 7807
 883+ 7807                  ; ---------------------------------------------------------------
 884+ 7807                  ; Calcolo indirizzo attributo
 885+ 7807                  ;
 886+ 7807                  ; Formula:
 887+ 7807                  ;   AttrAddr = $5800 + Row * 32 + Col
 888+ 7807                  ;
 889+ 7807                  ; HL conterrà l'indirizzo della cella attributi.
 890+ 7807                  ; ---------------------------------------------------------------
 891+ 7807
 892+ 7807 26 00            ld   h, 0
 893+ 7809 68               ld   l, b              ; HL = Row
 894+ 780A
 895+ 780A 29               add  hl, hl            ; *2
 896+ 780B 29               add  hl, hl            ; *4
 897+ 780C 29               add  hl, hl            ; *8
 898+ 780D 29               add  hl, hl            ; *16
 899+ 780E 29               add  hl, hl            ; *32
 900+ 780F
 901+ 780F 79               ld   a, c              ; A = Colonna
 902+ 7810
 903+ 7810 85               add  a, l
 904+ 7811 6F               ld   l, a
 905+ 7812
 906+ 7812 30 01            jr   nc, .no_carry
 907+ 7814 24               inc  h
 908+ 7815
 909+ 7815              .no_carry:
 910+ 7815
 911+ 7815                  ; HL = Row * 32 + Col
 912+ 7815
 913+ 7815 11 00 58         ld   de, $5800
 914+ 7818 19               add  hl, de            ; HL = indirizzo attributi
 915+ 7819
 916+ 7819                  ; ---------------------------------------------------------------
 917+ 7819                  ; Recupera il colore originale dallo stack.
 918+ 7819                  ;
 919+ 7819                  ; Layout stack:
 920+ 7819                  ;   HL originale
 921+ 7819                  ;   DE originale (E = colore)
 922+ 7819                  ;   BC originale
 923+ 7819                  ; ---------------------------------------------------------------
 924+ 7819
 925+ 7819 C1               pop  bc                ; Recupera HL originale
 926+ 781A D1               pop  de                ; Recupera DE originale
 927+ 781B
 928+ 781B                  ; ---------------------------------------------------------------
 929+ 781B                  ; Scrive l'attributo colore
 930+ 781B                  ; ---------------------------------------------------------------
 931+ 781B
 932+ 781B 7B               ld   a, e              ; A = colore
 933+ 781C 77               ld   (hl), a           ; Scrive nella RAM attributi
 934+ 781D
 935+ 781D                  ; ---------------------------------------------------------------
 936+ 781D                  ; Ripristina HL e BC originali
 937+ 781D                  ; ---------------------------------------------------------------
 938+ 781D
 939+ 781D C5               push bc
 940+ 781E E1               pop  hl                ; HL originale
 941+ 781F
 942+ 781F C1               pop  bc                ; BC originale
 943+ 7820
 944+ 7820 C9               ret
 945+ 7821
 946+ 7821              ; -------------------------------------------------------------------
 947+ 7821              ; RestoreBackgroundCell
 948+ 7821              ;
 949+ 7821              ; Ripristina il contenuto originale di una cella della stanza.
 950+ 7821              ; Viene utilizzata principalmente quando un item viene raccolto:
 951+ 7821              ; invece di lasciare un "buco", la routine ridisegna il tile
 952+ 7821              ; originale presente nella mappa della stanza.
 953+ 7821              ;
 954+ 7821              ; Input:
 955+ 7821              ;   B = Row (3..18)
 956+ 7821              ;   C = Col (0..31)
 957+ 7821              ;
 958+ 7821              ; Utilizza:
 959+ 7821              ;   room_ptr -> struttura dati della stanza corrente
 960+ 7821              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 961+ 7821              ;   Gfx_DrawTile -> ridisegna il tile selezionato
 962+ 7821              ;
 963+ 7821              ; Tipi di cella:
 964+ 7821              ;   0 = Background
 965+ 7821              ;   1 = Floor
 966+ 7821              ;   2 = Wall
 967+ 7821              ;   3 = Nasty
 968+ 7821              ; -------------------------------------------------------------------
 969+ 7821              RestoreBackgroundCell:
 970+ 7821
 971+ 7821                  ; Salva tutti i registri utilizzati
 972+ 7821 FD E5            push iy
 973+ 7823 C5               push bc
 974+ 7824 D5               push de
 975+ 7825 E5               push hl
 976+ 7826 DD E5            push ix
 977+ 7828
 978+ 7828                  ; ---------------------------------------------------------------
 979+ 7828                  ; Conserva Row e Col in IY.
 980+ 7828                  ;
 981+ 7828                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 982+ 7828                  ; BC potrebbe essere modificato.
 983+ 7828                  ; ---------------------------------------------------------------
 984+ 7828 C5               push bc
 985+ 7829 FD E1            pop  iy                ; IYH = Row, IYL = Col
 986+ 782B
 987+ 782B                  ; ---------------------------------------------------------------
 988+ 782B                  ; Determina quale tipo di cella è presente nella posizione
 989+ 782B                  ; specificata.
 990+ 782B                  ;
 991+ 782B                  ; Input:
 992+ 782B                  ;   B = Row
 993+ 782B                  ;   C = Col
 994+ 782B                  ;
 995+ 782B                  ; Output:
 996+ 782B                  ;   A = tipo cella
 997+ 782B                  ; ---------------------------------------------------------------
 998+ 782B 78               ld   a, b
 999+ 782C
1000+ 782C CD 86 6C         call GetCellFromUnpacked
1001+ 782F
1002+ 782F                  ; ---------------------------------------------------------------
1003+ 782F                  ; Recupera il puntatore alla stanza corrente.
1004+ 782F                  ;
1005+ 782F                  ; DE = base della struttura stanza
1006+ 782F                  ; ---------------------------------------------------------------
1007+ 782F ED 5B B7 7D      ld   de, (room_ptr)
1008+ 7833
1009+ 7833                  ; ---------------------------------------------------------------
1010+ 7833                  ; Seleziona il tile corretto in base al tipo di cella.
1011+ 7833                  ;
1012+ 7833                  ; A = 0 -> Background
1013+ 7833                  ; A = 1 -> Floor
1014+ 7833                  ; A = 2 -> Wall
1015+ 7833                  ; A = 3 -> Nasty
1016+ 7833                  ; ---------------------------------------------------------------
1017+ 7833
1018+ 7833 B7               or   a
1019+ 7834 20 06            jr   nz, .not_bg
1020+ 7836
1021+ 7836                  ; Background
1022+ 7836 21 A0 00         ld   hl, OFFSET_BG
1023+ 7839 19               add  hl, de
1024+ 783A 18 16            jr   .draw_cell
1025+ 783C
1026+ 783C              .not_bg:
1027+ 783C
1028+ 783C 3D               dec  a
1029+ 783D 20 06            jr   nz, .not_floor
1030+ 783F
1031+ 783F                  ; Floor
1032+ 783F 21 A9 00         ld   hl, OFFSET_FLOOR
1033+ 7842 19               add  hl, de
1034+ 7843 18 0D            jr   .draw_cell
1035+ 7845
1036+ 7845              .not_floor:
1037+ 7845
1038+ 7845 3D               dec  a
1039+ 7846 20 06            jr   nz, .not_wall
1040+ 7848
1041+ 7848                  ; Wall
1042+ 7848 21 B2 00         ld   hl, OFFSET_WALL
1043+ 784B 19               add  hl, de
1044+ 784C 18 04            jr   .draw_cell
1045+ 784E
1046+ 784E              .not_wall:
1047+ 784E
1048+ 784E                  ; Nasty
1049+ 784E 21 BB 00         ld   hl, OFFSET_NASTY
1050+ 7851 19               add  hl, de
1051+ 7852
1052+ 7852              .draw_cell:
1053+ 7852
1054+ 7852                  ; ---------------------------------------------------------------
1055+ 7852                  ; HL punta ora alla grafica del tile da ridisegnare.
1056+ 7852                  ;
1057+ 7852                  ; Gfx_DrawTile si aspetta:
1058+ 7852                  ;   IX = puntatore tile
1059+ 7852                  ;   B  = Row
1060+ 7852                  ;   C  = Col
1061+ 7852                  ; ---------------------------------------------------------------
1062+ 7852 E5               push hl
1063+ 7853 DD E1            pop  ix
1064+ 7855
1065+ 7855                  ; Ripristina Row e Col salvati in IY
1066+ 7855 FD E5            push iy
1067+ 7857 C1               pop  bc
1068+ 7858
1069+ 7858                  ; Disegna il tile originale
1070+ 7858 CD 5C 62         call Gfx_DrawTile
1071+ 785B
1072+ 785B                  ; ---------------------------------------------------------------
1073+ 785B                  ; Ripristina i registri salvati
1074+ 785B                  ; ---------------------------------------------------------------
1075+ 785B DD E1            pop  ix
1076+ 785D E1               pop  hl
1077+ 785E D1               pop  de
1078+ 785F C1               pop  bc
1079+ 7860 FD E1            pop  iy
1080+ 7862
1081+ 7862 C9               ret
1082+ 7863
1083+ 7863              ; -------------------------------------------------------------------
1084+ 7863              ; CheckWillyItemCollision
1085+ 7863              ;
1086+ 7863              ; Verifica se Willy collide con un item utilizzando il controllo
1087+ 7863              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1088+ 7863              ;
1089+ 7863              ; Input:
1090+ 7863              ;   A = ItemX (colonna attributi 0..31)
1091+ 7863              ;   H = ItemY (riga attributi 3..18)
1092+ 7863              ;
1093+ 7863              ; Coordinate item:
1094+ 7863              ;   Ogni item occupa una cella da 8x8 pixel.
1095+ 7863              ;
1096+ 7863              ; Coordinate Willy:
1097+ 7863              ;   Willy occupa un rettangolo di 16x16 pixel.
1098+ 7863              ;
1099+ 7863              ; Output:
1100+ 7863              ;   Carry Set   = collisione rilevata
1101+ 7863              ;   Carry Clear = nessuna collisione
1102+ 7863              ;
1103+ 7863              ; Registri preservati:
1104+ 7863              ;   BC, DE, HL
1105+ 7863              ; -------------------------------------------------------------------
1106+ 7863              CheckWillyItemCollision:
1107+ 7863
1108+ 7863                  ; Salva i registri utilizzati
1109+ 7863 C5               push bc
1110+ 7864 D5               push de
1111+ 7865 E5               push hl
1112+ 7866
1113+ 7866                  ; ---------------------------------------------------------------
1114+ 7866                  ; Calcola il bounding box orizzontale dell'item
1115+ 7866                  ;
1116+ 7866                  ; ItemLeft  = ItemX * 8
1117+ 7866                  ; ItemRight = ItemLeft + 7
1118+ 7866                  ;
1119+ 7866                  ; E = ItemLeft
1120+ 7866                  ; D = ItemRight
1121+ 7866                  ; ---------------------------------------------------------------
1122+ 7866 6F               ld   l, a              ; L = ItemX
1123+ 7867
1124+ 7867 7D               ld   a, l
1125+ 7868 87               add  a, a              ; *2
1126+ 7869 87               add  a, a              ; *4
1127+ 786A 87               add  a, a              ; *8
1128+ 786B
1129+ 786B 5F               ld   e, a              ; E = ItemLeft
1130+ 786C
1131+ 786C C6 07            add  a, 7
1132+ 786E 57               ld   d, a              ; D = ItemRight
1133+ 786F
1134+ 786F                  ; ---------------------------------------------------------------
1135+ 786F                  ; Recupera la posizione corrente di Willy
1136+ 786F                  ;
1137+ 786F                  ; B = WillyY
1138+ 786F                  ; C = WillyX
1139+ 786F                  ; ---------------------------------------------------------------
1140+ 786F ED 4B 3C 7A      ld   bc, (PlayerPos)
1141+ 7873
1142+ 7873                  ; ---------------------------------------------------------------
1143+ 7873                  ; Primo test:
1144+ 7873                  ;
1145+ 7873                  ; WillyLeft <= ItemRight
1146+ 7873                  ;
1147+ 7873                  ; Se Willy è completamente a destra dell'item
1148+ 7873                  ; non può esserci collisione.
1149+ 7873                  ; ---------------------------------------------------------------
1150+ 7873 79               ld   a, c              ; A = WillyLeft
1151+ 7874
1152+ 7874 BA               cp   d                 ; WillyLeft vs ItemRight
1153+ 7875
1154+ 7875 28 04            jr   z, .x_ok
1155+ 7877 38 02            jr   c, .x_ok
1156+ 7879
1157+ 7879 18 29            jr   .no_collision
1158+ 787B
1159+ 787B              .x_ok:
1160+ 787B
1161+ 787B                  ; ---------------------------------------------------------------
1162+ 787B                  ; Secondo test:
1163+ 787B                  ;
1164+ 787B                  ; WillyRight >= ItemLeft
1165+ 787B                  ;
1166+ 787B                  ; WillyRight = WillyX + 7
1167+ 787B                  ; ---------------------------------------------------------------
1168+ 787B C6 07            add  a, 7
1169+ 787D
1170+ 787D BB               cp   e                 ; WillyRight vs ItemLeft
1171+ 787E
1172+ 787E 28 04            jr   z, .y_check
1173+ 7880 30 02            jr   nc, .y_check
1174+ 7882
1175+ 7882 18 20            jr   .no_collision
1176+ 7884
1177+ 7884              .y_check:
1178+ 7884
1179+ 7884                  ; ---------------------------------------------------------------
1180+ 7884                  ; Recupera ItemY dal valore originale di HL
1181+ 7884                  ;
1182+ 7884                  ; H contiene la riga dell'item.
1183+ 7884                  ; ---------------------------------------------------------------
1184+ 7884 E1               pop  hl
1185+ 7885 E5               push hl
1186+ 7886
1187+ 7886                  ; ---------------------------------------------------------------
1188+ 7886                  ; Calcola il bounding box verticale dell'item
1189+ 7886                  ;
1190+ 7886                  ; ItemTop    = ItemY * 8
1191+ 7886                  ; ItemBottom = ItemTop + 7
1192+ 7886                  ;
1193+ 7886                  ; E = ItemTop
1194+ 7886                  ; D = ItemBottom
1195+ 7886                  ; ---------------------------------------------------------------
1196+ 7886 7C               ld   a, h
1197+ 7887
1198+ 7887 87               add  a, a              ; *2
1199+ 7888 87               add  a, a              ; *4
1200+ 7889 87               add  a, a              ; *8
1201+ 788A
1202+ 788A 5F               ld   e, a              ; ItemTop
1203+ 788B
1204+ 788B C6 07            add  a, 7
1205+ 788D 57               ld   d, a              ; ItemBottom
1206+ 788E
1207+ 788E                  ; ---------------------------------------------------------------
1208+ 788E                  ; Primo test verticale:
1209+ 788E                  ;
1210+ 788E                  ; WillyTop <= ItemBottom
1211+ 788E                  ; ---------------------------------------------------------------
1212+ 788E 78               ld   a, b              ; WillyTop
1213+ 788F
1214+ 788F BA               cp   d
1215+ 7890
1216+ 7890 28 04            jr   z, .y_ok
1217+ 7892 38 02            jr   c, .y_ok
1218+ 7894
1219+ 7894 18 0E            jr   .no_collision
1220+ 7896
1221+ 7896              .y_ok:
1222+ 7896
1223+ 7896                  ; ---------------------------------------------------------------
1224+ 7896                  ; Secondo test verticale:
1225+ 7896                  ;
1226+ 7896                  ; WillyBottom >= ItemTop
1227+ 7896                  ;
1228+ 7896                  ; WillyBottom = WillyY + 15
1229+ 7896                  ; ---------------------------------------------------------------
1230+ 7896 C6 0F            add  a, 15
1231+ 7898
1232+ 7898 BB               cp   e
1233+ 7899
1234+ 7899 28 04            jr   z, .collision
1235+ 789B 30 02            jr   nc, .collision
1236+ 789D
1237+ 789D 18 05            jr   .no_collision
1238+ 789F
1239+ 789F              .collision:
1240+ 789F
1241+ 789F                  ; ---------------------------------------------------------------
1242+ 789F                  ; Collisione rilevata
1243+ 789F                  ; ---------------------------------------------------------------
1244+ 789F E1               pop  hl
1245+ 78A0 D1               pop  de
1246+ 78A1 C1               pop  bc
1247+ 78A2
1248+ 78A2 37               scf                    ; Carry = 1
1249+ 78A3
1250+ 78A3 C9               ret
1251+ 78A4
1252+ 78A4              .no_collision:
1253+ 78A4
1254+ 78A4                  ; ---------------------------------------------------------------
1255+ 78A4                  ; Nessuna collisione
1256+ 78A4                  ; ---------------------------------------------------------------
1257+ 78A4 E1               pop  hl
1258+ 78A5 D1               pop  de
1259+ 78A6 C1               pop  bc
1260+ 78A7
1261+ 78A7 B7               or   a                 ; Carry = 0
1262+ 78A8
1263+ 78A8 C9               ret
1264+ 78A9
1265+ 78A9              ; -------------------------------------------------------------------
1266+ 78A9              ; Items_CheckCollision
1267+ 78A9              ;
1268+ 78A9              ; Controlla se Willy entra in collisione con uno degli item
1269+ 78A9              ; attivi presenti nella stanza corrente.
1270+ 78A9              ;
1271+ 78A9              ; Per ogni item:
1272+ 78A9              ;   - verifica che appartenga alla stanza corrente
1273+ 78A9              ;   - verifica che non sia già stato raccolto
1274+ 78A9              ;   - esegue il test di collisione con Willy
1275+ 78A9              ;
1276+ 78A9              ; Se l'item viene raccolto:
1277+ 78A9              ;   - imposta il flag "collected"
1278+ 78A9              ;   - rimuove l'item dalla cache items_grid
1279+ 78A9              ;   - incrementa il contatore degli oggetti raccolti
1280+ 78A9              ;   - aggiorna l'HUD
1281+ 78A9              ;   - ripristina il tile di sfondo
1282+ 78A9              ;   - riproduce il suono di raccolta
1283+ 78A9              ;
1284+ 78A9              ; Formato record ItemsTable:
1285+ 78A9              ;   +0 RoomID
1286+ 78A9              ;   +1 X
1287+ 78A9              ;   +2 Y
1288+ 78A9              ;   +3 Color
1289+ 78A9              ;   +4 Collected
1290+ 78A9              ;
1291+ 78A9              ; Fine tabella:
1292+ 78A9              ;   RoomID = $FF
1293+ 78A9              ; -------------------------------------------------------------------
1294+ 78A9              Items_CheckCollision:
1295+ 78A9
1296+ 78A9                  ; Salva i registri utilizzati
1297+ 78A9 E5               push hl
1298+ 78AA D5               push de
1299+ 78AB C5               push bc
1300+ 78AC
1301+ 78AC                  ; Inizio scansione della tabella degli item
1302+ 78AC 21 AD 74         ld   hl, ItemsTable
1303+ 78AF
1304+ 78AF              .loop:
1305+ 78AF
1306+ 78AF                  ; ---------------------------------------------------------------
1307+ 78AF                  ; Legge il Room ID dell'item corrente
1308+ 78AF                  ; ---------------------------------------------------------------
1309+ 78AF 7E               ld   a, (hl)
1310+ 78B0
1311+ 78B0                  ; $FF indica fine tabella
1312+ 78B0 FE FF            cp   $FF
1313+ 78B2 28 4D            jr   z, .done
1314+ 78B4
1315+ 78B4                  ; ---------------------------------------------------------------
1316+ 78B4                  ; Verifica se l'item appartiene alla stanza corrente
1317+ 78B4                  ; ---------------------------------------------------------------
1318+ 78B4 57               ld   d, a              ; D = RoomID item
1319+ 78B5
1320+ 78B5 3A 5D 7D         ld   a, (current_room)
1321+ 78B8 BA               cp   d
1322+ 78B9
1323+ 78B9                  ; Se appartiene a un'altra stanza salta il record
1324+ 78B9 20 3F            jr   nz, .next_item
1325+ 78BB
1326+ 78BB                  ; ---------------------------------------------------------------
1327+ 78BB                  ; Legge coordinate e stato dell'item
1328+ 78BB                  ; ---------------------------------------------------------------
1329+ 78BB
1330+ 78BB 23               inc  hl
1331+ 78BC 4E               ld   c, (hl)           ; C = X
1332+ 78BD
1333+ 78BD 23               inc  hl
1334+ 78BE 46               ld   b, (hl)           ; B = Y
1335+ 78BF
1336+ 78BF 23               inc  hl                ; salta Color
1337+ 78C0
1338+ 78C0 23               inc  hl                ; punta a Collected
1339+ 78C1
1340+ 78C1 7E               ld   a, (hl)
1341+ 78C2
1342+ 78C2                  ; ---------------------------------------------------------------
1343+ 78C2                  ; Item già raccolto?
1344+ 78C2                  ; ---------------------------------------------------------------
1345+ 78C2 B7               or   a
1346+ 78C3 20 39            jr   nz, .next_no_inc
1347+ 78C5
1348+ 78C5                  ; ---------------------------------------------------------------
1349+ 78C5                  ; Test collisione Willy ↔ Item
1350+ 78C5                  ;
1351+ 78C5                  ; Input richiesto:
1352+ 78C5                  ;   A = ItemX
1353+ 78C5                  ;   H = ItemY
1354+ 78C5                  ; ---------------------------------------------------------------
1355+ 78C5 79               ld   a, c
1356+ 78C6
1357+ 78C6 E5               push hl                ; salva puntatore al flag Collected
1358+ 78C7
1359+ 78C7 60               ld   h, b
1360+ 78C8
1361+ 78C8 CD 63 78         call CheckWillyItemCollision
1362+ 78CB
1363+ 78CB E1               pop  hl
1364+ 78CC
1365+ 78CC                  ; Nessuna collisione
1366+ 78CC 30 30            jr   nc, .next_no_inc
1367+ 78CE
1368+ 78CE                  ; ===============================================================
1369+ 78CE                  ; ITEM RACCOLTO
1370+ 78CE                  ; ===============================================================
1371+ 78CE
1372+ 78CE                  ; ---------------------------------------------------------------
1373+ 78CE                  ; Marca l'item come raccolto
1374+ 78CE                  ; ---------------------------------------------------------------
1375+ 78CE 36 01            ld   (hl), 1
1376+ 78D0
1377+ 78D0                  ; ---------------------------------------------------------------
1378+ 78D0                  ; Rimuove l'item dalla cache items_grid
1379+ 78D0                  ;
1380+ 78D0                  ; Calcolo:
1381+ 78D0                  ;   offset = Row * 32 + Col
1382+ 78D0                  ; ---------------------------------------------------------------
1383+ 78D0 E5               push hl
1384+ 78D1 D5               push de
1385+ 78D2
1386+ 78D2 26 00            ld   h, 0
1387+ 78D4 68               ld   l, b              ; HL = Row
1388+ 78D5
1389+ 78D5 29               add  hl, hl            ; *2
1390+ 78D6 29               add  hl, hl            ; *4
1391+ 78D7 29               add  hl, hl            ; *8
1392+ 78D8 29               add  hl, hl            ; *16
1393+ 78D9 29               add  hl, hl            ; *32
1394+ 78DA
1395+ 78DA 59               ld   e, c
1396+ 78DB 16 00            ld   d, 0
1397+ 78DD
1398+ 78DD 19               add  hl, de            ; Row*32 + Col
1399+ 78DE
1400+ 78DE 11 00 B0         ld   de, items_grid
1401+ 78E1 19               add  hl, de
1402+ 78E2
1403+ 78E2                  ; La cella non contiene più un item
1404+ 78E2 36 00            ld   (hl), 0
1405+ 78E4
1406+ 78E4 D1               pop  de
1407+ 78E5 E1               pop  hl
1408+ 78E6
1409+ 78E6                  ; ---------------------------------------------------------------
1410+ 78E6                  ; Conserva il puntatore all'entry corrente
1411+ 78E6                  ; poiché le routine successive possono alterare HL.
1412+ 78E6                  ; ---------------------------------------------------------------
1413+ 78E6 E5               push hl
1414+ 78E7
1415+ 78E7                  ; ---------------------------------------------------------------
1416+ 78E7                  ; Aggiorna il numero di oggetti raccolti
1417+ 78E7                  ; ---------------------------------------------------------------
1418+ 78E7 3A 46 7A         ld   a, (items_collected)
1419+ 78EA
1420+ 78EA 3C               inc  a
1421+ 78EB
1422+ 78EB 32 46 7A         ld   (items_collected), a
1423+ 78EE
1424+ 78EE                  ; ---------------------------------------------------------------
1425+ 78EE                  ; Aggiorna il contatore visualizzato a schermo
1426+ 78EE                  ; ---------------------------------------------------------------
1427+ 78EE CD 65 61         call Gfx_UpdateItemsCollectedDisplay
1428+ 78F1
1429+ 78F1                  ; ---------------------------------------------------------------
1430+ 78F1                  ; Ripristina il tile originale della stanza
1431+ 78F1                  ; eliminando la grafica dell'item.
1432+ 78F1                  ;
1433+ 78F1                  ; Input:
1434+ 78F1                  ;   B = Row
1435+ 78F1                  ;   C = Col
1436+ 78F1                  ; ---------------------------------------------------------------
1437+ 78F1 CD 21 78         call RestoreBackgroundCell
1438+ 78F4
1439+ 78F4                  ; ---------------------------------------------------------------
1440+ 78F4                  ; Riproduce il suono di raccolta
1441+ 78F4                  ; ---------------------------------------------------------------
1442+ 78F4 CD 1B 7A         call Audio_PlayCollectSound
1443+ 78F7
1444+ 78F7                  ; Ripristina il puntatore alla tabella
1445+ 78F7 E1               pop  hl
1446+ 78F8
1447+ 78F8                  ; Continua con il record successivo
1448+ 78F8 18 04            jr   .next_no_inc
1449+ 78FA
1450+ 78FA              .next_item:
1451+ 78FA
1452+ 78FA                  ; ---------------------------------------------------------------
1453+ 78FA                  ; Salta i campi del record:
1454+ 78FA                  ;   X
1455+ 78FA                  ;   Y
1456+ 78FA                  ;   Color
1457+ 78FA                  ;   Collected
1458+ 78FA                  ; ---------------------------------------------------------------
1459+ 78FA 23               inc  hl
1460+ 78FB 23               inc  hl
1461+ 78FC 23               inc  hl
1462+ 78FD 23               inc  hl
1463+ 78FE
1464+ 78FE              .next_no_inc:
1465+ 78FE
1466+ 78FE                  ; ---------------------------------------------------------------
1467+ 78FE                  ; Avanza al record successivo.
1468+ 78FE                  ;
1469+ 78FE                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1470+ 78FE                  ; ---------------------------------------------------------------
1471+ 78FE 23               inc  hl
1472+ 78FF
1473+ 78FF 18 AE            jr   .loop
1474+ 7901
1475+ 7901              .done:
1476+ 7901
1477+ 7901                  ; Ripristina i registri
1478+ 7901 C1               pop  bc
1479+ 7902 D1               pop  de
1480+ 7903 E1               pop  hl
1481+ 7904
1482+ 7904 C9               ret
1483+ 7905
1484+ 7905
1485+ 7905
1486+ 7905              ; -------------------------------------------------------------------
1487+ 7905              ; CheckActiveItemAtCell
1488+ 7905              ;
1489+ 7905              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1490+ 7905              ; nella cella specificata della griglia items_grid.
1491+ 7905              ;
1492+ 7905              ; Questa routine usa una lookup diretta su una mappa 32x16,
1493+ 7905              ; evitando la scansione della ItemsTable.
1494+ 7905              ;
1495+ 7905              ; Input:
1496+ 7905              ;   B = Colonna (0..31)
1497+ 7905              ;   C = Riga (0..15)
1498+ 7905              ;
1499+ 7905              ; Output:
1500+ 7905              ;   Carry Set   = item presente nella cella
1501+ 7905              ;   Carry Clear = nessun item
1502+ 7905              ;
1503+ 7905              ; Nota:
1504+ 7905              ;   HL NON è restituito valido (commento originale non corretto:
1505+ 7905              ;   la routine non punta a ItemsTable).
1506+ 7905              ; -------------------------------------------------------------------
1507+ 7905              CheckActiveItemAtCell:
1508+ 7905
1509+ 7905                  ; Salva registri usati
1510+ 7905 D5               push de
1511+ 7906 E5               push hl
1512+ 7907
1513+ 7907                  ; ---------------------------------------------------------------
1514+ 7907                  ; Calcolo indice lineare nella griglia 32x16:
1515+ 7907                  ;
1516+ 7907                  ; offset = Row * 32 + Col
1517+ 7907                  ; ---------------------------------------------------------------
1518+ 7907 26 00            ld   h, 0
1519+ 7909 69               ld   l, c              ; HL = Row
1520+ 790A
1521+ 790A 29               add  hl, hl            ; *2
1522+ 790B 29               add  hl, hl            ; *4
1523+ 790C 29               add  hl, hl            ; *8
1524+ 790D 29               add  hl, hl            ; *16
1525+ 790E 29               add  hl, hl            ; *32
1526+ 790F
1527+ 790F                  ; Aggiunge la colonna
1528+ 790F 58               ld   e, b
1529+ 7910 16 00            ld   d, 0
1530+ 7912 19               add  hl, de            ; HL = Row*32 + Col
1531+ 7913
1532+ 7913                  ; ---------------------------------------------------------------
1533+ 7913                  ; Accesso alla griglia degli item attivi
1534+ 7913                  ; ---------------------------------------------------------------
1535+ 7913 11 00 B0         ld   de, items_grid
1536+ 7916 19               add  hl, de            ; HL = address cella
1537+ 7917
1538+ 7917                  ; ---------------------------------------------------------------
1539+ 7917                  ; Controllo presenza item
1540+ 7917                  ;
1541+ 7917                  ; items_grid contiene:
1542+ 7917                  ;   0 = nessun item
1543+ 7917                  ;   >0 = item attivo (colore o flag)
1544+ 7917                  ; ---------------------------------------------------------------
1545+ 7917 7E               ld   a, (hl)
1546+ 7918 B7               or   a
1547+ 7919 28 04            jr   z, .not_active
1548+ 791B
1549+ 791B                  ; ---------------------------------------------------------------
1550+ 791B                  ; Item trovato
1551+ 791B                  ; ---------------------------------------------------------------
1552+ 791B E1               pop  hl
1553+ 791C D1               pop  de
1554+ 791D
1555+ 791D 37               scf                    ; Carry = 1
1556+ 791E C9               ret
1557+ 791F
1558+ 791F              .not_active:
1559+ 791F
1560+ 791F                  ; ---------------------------------------------------------------
1561+ 791F                  ; Nessun item nella cella
1562+ 791F                  ; ---------------------------------------------------------------
1563+ 791F E1               pop  hl
1564+ 7920 D1               pop  de
1565+ 7921
1566+ 7921 B7               or   a                 ; Carry = 0
1567+ 7922 C9               ret
1568+ 7923
