  84+ 7216              ; DetermineCurrentRoomID
  85+ 7216              ;
  86+ 7216              ; Determina l'ID numerico della stanza corrente confrontando
  87+ 7216              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  88+ 7216              ;
  89+ 7216              ; Se viene trovata una corrispondenza:
  90+ 7216              ;   A = ID della stanza
  91+ 7216              ;   current_room = A
  92+ 7216              ;
  93+ 7216              ; Mappatura:
  94+ 7216              ;    0 = The Off Licence
  95+ 7216              ;    1 = The Bridge
  96+ 7216              ;    2 = Under The Mega Tree
  97+ 7216              ;    3 = Gfx_At The Foot Of The Mega Tree
  98+ 7216              ;    4 = The Drive
  99+ 7216              ;    5 = The Security Guard
 100+ 7216              ;    6 = Entrance To Hades
 101+ 7216              ;    7 = Cuckoo's Nest
 102+ 7216              ;    8 = Inside The Mega Trunk
 103+ 7216              ;    9 = On A Branch Over The Drive
 104+ 7216              ;   10 = The Front Door
 105+ 7216              ;   11 = The Hall
 106+ 7216              ;   12 = Tree Top
 107+ 7216              ;   33 = The Bathroom
 108+ 7216              ;   35 = Master Bedroom
 109+ 7216              ;
 110+ 7216              ; Se nessuna stanza corrisponde viene impostato:
 111+ 7216              ;   current_room = 0
 112+ 7216              ; -------------------------------------------------------------------
