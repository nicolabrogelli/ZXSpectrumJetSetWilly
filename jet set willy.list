 186+ 6B52
 187+ 6B52                  ; Confronta con la stanza corrente
 188+ 6B52 57               ld   d, a              ; D = Room ID dell'item
 189+ 6B53 3A F5 7A         ld   a, (current_room)
 190+ 6B56 BA               cp   d
 191+ 6B57 20 15            jr   nz, .next_item    ; Stanza diversa, salta
 192+ 6B59
 193+ 6B59                  ; Leggi coordinate, colore e stato
 194+ 6B59 23               inc  hl                ; HL punta a X
 195+ 6B5A 4E               ld   c, (hl)           ; C = X colonna
 196+ 6B5B 23               inc  hl                ; HL punta a Y
 197+ 6B5C 46               ld   b, (hl)           ; B = Y riga
 198+ 6B5D 23               inc  hl                ; HL punta al Colore
 199+ 6B5E 5E               ld   e, (hl)           ; E = Colore
 200+ 6B5F 23               inc  hl                ; HL punta a collected flag
 201+ 6B60 7E               ld   a, (hl)           ; A = collected flag
 202+ 6B61 B7               or   a
 203+ 6B62 20 0E            jr   nz, .next_no_inc  ; Già raccolto, salta
 204+ 6B64
 205+ 6B64                  ; Disegna l'item!
 206+ 6B64                  ; B = Row, C = Col, IX = bitmap graphic (8 byte), E = Colore
 207+ 6B64 E5               push hl
 208+ 6B65 DD E5            push ix
 209+ 6B67 E1               pop  hl                ; HL = bitmap pointer
 210+ 6B68 CD 7B 6B         call DrawItemGraphic
