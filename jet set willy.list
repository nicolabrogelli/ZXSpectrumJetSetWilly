   2+ 5DAD              ; settings.asm
   3+ 5DAD              ;
   4+ 5DAD              ; Impostazioni e flag di configurazione a tempo di compilazione per Jet Set Willy.
   5+ 5DAD              ; Ogni flag può essere abilitato (1) o disabilitato (0).
   6+ 5DAD              ; Possono anche essere sovrascritti via riga di comando con sjasmplus
   7+ 5DAD              ; (es. -DENABLE_MUSIC=0 -DENABLE_GUARDIAN_COLLISION_DEATH=0).
   8+ 5DAD              ;===========================================================================
   9+ 5DAD
  10+ 5DAD              ; --- Musica di sottofondo ---
  11+ 5DAD              ; 1 = Musica abilitata
  12+ 5DAD              ; 0 = Musica disabilitata
  13+ 5DAD                  IFNDEF ENABLE_MUSIC
  14+ 5DAD              ENABLE_MUSIC EQU 0
  15+ 5DAD                  ENDIF
  16+ 5DAD
  17+ 5DAD              ; --- Morte per collisione con i guardiani (nemici) ---
  18+ 5DAD              ; 1 = Abilita la morte e il decremento delle vite alla collisione con i guardiani
  19+ 5DAD              ; 0 = Disabilita la morte (disegna le raster bar di debug sul bordo)
  20+ 5DAD                  IFNDEF ENABLE_GUARDIAN_COLLISION_DEATH
  21+ 5DAD              ENABLE_GUARDIAN_COLLISION_DEATH EQU 0
  22+ 5DAD                  ENDIF
  23+ 5DAD
  24+ 5DAD              ; --- Morte per collisione con gli elementi Nasty (tiles pericolose) ---
  25+ 5DAD              ; 1 = Abilita la morte e il decremento delle vite al tocco delle Nasty tiles
  26+ 5DAD              ; 0 = Disabilita il controllo di morte sulle Nasty tiles
  27+ 5DAD                  IFNDEF ENABLE_NASTY_COLLISION_DEATH
  28+ 5DAD              ENABLE_NASTY_COLLISION_DEATH EQU 0
  29+ 5DAD                  ENDIF
  30+ 5DAD
  31+ 5DAD              ; --- Animazione delle icone delle vite ---
  32+ 5DAD              ; 1 = Abilita l'animazione camminante per le icone delle vite in basso a schermo
  33+ 5DAD              ; 0 = Icone delle vite statiche
  34+ 5DAD                  IFNDEF ENABLE_ANIMATE_LIVES
  35+ 5DAD              ENABLE_ANIMATE_LIVES EQU 1
  36+ 5DAD                  ENDIF
  37+ 5DAD
# file closed: settings.asm
