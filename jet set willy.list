 362+ 6CDA
 363+ 6CDA                  ; Riga di layout: r = B
 364+ 6CDA 78               ld   a, b
 365+ 6CDB                  ; A = r (0..15)
 366+ 6CDB
 367+ 6CDB                  ; Colonna: c = C (Col)
 368+ 6CDB CD 12 68         call GetCellFromUnpacked ; A = cell type (0..3)
 369+ 6CDE
 370+ 6CDE ED 5B A1 7D      ld   de, (room_ptr)
 371+ 6CE2 B7               or   a
 372+ 6CE3 20 06            jr   nz, .not_bg
 373+ 6CE5 21 A0 00         ld   hl, OFFSET_BG
 374+ 6CE8 19               add  hl, de
 375+ 6CE9 18 16            jr   .draw_cell
