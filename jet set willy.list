 578+ 603C                  ; --- RENDERING MAIALESPRITE IN THE NIGHTMARE ROOM ---
 579+ 603C 3A 5E F4         ld   a, (direction)
 580+ 603F FE 01            cp   1                 ; Sinistra?
 581+ 6041 20 05            jr   nz, .maiale_right
