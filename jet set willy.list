1012+ 6B58
1013+ 6B58              ; -------------------------------------------------------------------
1014+ 6B58              ; Controlla se Willy collide orizzontalmente con un Wall alle coordinate specificate
1015+ 6B58              ; Input: C = X pixel (da controllare), B = Y pixel (attuale)
1016+ 6B58              ; Output: Carry flag impostato se c'è collisione, altrimenti resettato
1017+ 6B58              ; -------------------------------------------------------------------
1018+ 6B58              CheckWillyWallCollision:
1019+ 6B58 C5               push bc
1020+ 6B59
1021+ 6B59                  ; 1. Punto superiore: (X, Y)
1022+ 6B59 CD 27 6B         call CheckWallCell
1023+ 6B5C 38 17            jr   c, .collision
1024+ 6B5E
1025+ 6B5E                  ; 2. Punto medio: (X, Y + 7)
1026+ 6B5E 78               ld   a, b
1027+ 6B5F C6 07            add  a, 7
1028+ 6B61 47               ld   b, a
1029+ 6B62 CD 27 6B         call CheckWallCell
1030+ 6B65 38 0E            jr   c, .collision
1031+ 6B67
1032+ 6B67                  ; 3. Punto inferiore: (X, Y + 15)
1033+ 6B67 C1               pop  bc
1034+ 6B68 C5               push bc
1035+ 6B69 78               ld   a, b
1036+ 6B6A C6 0F            add  a, 15
1037+ 6B6C 47               ld   b, a
1038+ 6B6D CD 27 6B         call CheckWallCell
1039+ 6B70 38 03            jr   c, .collision
1040+ 6B72
1041+ 6B72 C1               pop  bc
1042+ 6B73 B7               or   a                 ; Reset carry (nessuna collisione)
1043+ 6B74 C9               ret
1044+ 6B75
1045+ 6B75              .collision:
1046+ 6B75 C1               pop  bc
1047+ 6B76 37               scf                    ; Set carry (collisione avvenuta)
1048+ 6B77 C9               ret
1049+ 6B78
1050+ 6B78              ; -------------------------------------------------------------------
1051+ 6B78              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1052+ 6B78              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1053+ 6B78              ; -------------------------------------------------------------------
1054+ 6B78              UnpackRoomLayout:
1055+ 6B78 E5               push hl
1056+ 6B79 D5               push de
1057+ 6B7A C5               push bc
1058+ 6B7B
1059+ 6B7B 2A E4 79         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1060+ 6B7E 11 8A 77         ld   de, unpacked_layout ; DE = buffer RAM
1061+ 6B81 06 80            ld   b, 128             ; 128 byte
1062+ 6B83              .byte_loop:
1063+ 6B83 7E               ld   a, (hl)            ; Leggi byte compresso
1064+ 6B84 23               inc  hl
1065+ 6B85
1066+ 6B85 4F               ld   c, a               ; C = salvataggio
1067+ 6B86
1068+ 6B86                  ; Cella 0: bit 7-6
1069+ 6B86 07               rlca
1070+ 6B87 07               rlca
1071+ 6B88 E6 03            and  3
1072+ 6B8A 12               ld   (de), a
1073+ 6B8B 13               inc  de
1074+ 6B8C
1075+ 6B8C                  ; Cella 1: bit 5-4
1076+ 6B8C 79               ld   a, c
1077+ 6B8D 07               rlca
1078+ 6B8E 07               rlca
1079+ 6B8F 07               rlca
1080+ 6B90 07               rlca
1081+ 6B91 E6 03            and  3
1082+ 6B93 12               ld   (de), a
1083+ 6B94 13               inc  de
1084+ 6B95
1085+ 6B95                  ; Cella 2: bit 3-2
1086+ 6B95 79               ld   a, c
1087+ 6B96 0F               rrca
1088+ 6B97 0F               rrca
1089+ 6B98 E6 03            and  3
1090+ 6B9A 12               ld   (de), a
1091+ 6B9B 13               inc  de
1092+ 6B9C
1093+ 6B9C                  ; Cella 3: bit 1-0
1094+ 6B9C 79               ld   a, c
1095+ 6B9D E6 03            and  3
1096+ 6B9F 12               ld   (de), a
1097+ 6BA0 13               inc  de
1098+ 6BA1
1099+ 6BA1 10 E0            djnz .byte_loop
1100+ 6BA3
1101+ 6BA3 C1               pop  bc
1102+ 6BA4 D1               pop  de
1103+ 6BA5 E1               pop  hl
1104+ 6BA6 C9               ret
1105+ 6BA7
1106+ 6BA7              ; -------------------------------------------------------------------
1107+ 6BA7              ; Legge il tipo di cella dal buffer decompresso in RAM
1108+ 6BA7              ; Input: A = Row (0..15), C = Col (0..31)
1109+ 6BA7              ; Output: A = tipo di cella (0..3)
1110+ 6BA7              ; Preserva tutti gli altri registri.
1111+ 6BA7              ; -------------------------------------------------------------------
1112+ 6BA7              GetCellFromUnpacked:
1113+ 6BA7 E5               push hl
1114+ 6BA8 D5               push de
1115+ 6BA9
1116+ 6BA9 6F               ld   l, a
1117+ 6BAA 26 00            ld   h, 0
1118+ 6BAC 29               add  hl, hl
1119+ 6BAD 29               add  hl, hl
1120+ 6BAE 29               add  hl, hl
1121+ 6BAF 29               add  hl, hl
1122+ 6BB0 29               add  hl, hl            ; HL = Row * 32
1123+ 6BB1 59               ld   e, c
1124+ 6BB2 16 00            ld   d, 0
1125+ 6BB4 19               add  hl, de            ; HL = Row * 32 + Col
1126+ 6BB5 11 8A 77         ld   de, unpacked_layout
1127+ 6BB8 19               add  hl, de
1128+ 6BB9 7E               ld   a, (hl)           ; A = cell type
1129+ 6BBA
1130+ 6BBA D1               pop  de
1131+ 6BBB E1               pop  hl
1132+ 6BBC C9               ret
1133+ 6BBD
1134+ 6BBD              ; -------------------------------------------------------------------
1135+ 6BBD              ; GetRampY
1136+ 6BBD              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1137+ 6BBD              ; Input: C = PlayerX
1138+ 6BBD              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1139+ 6BBD              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1140+ 6BBD              ; -------------------------------------------------------------------
1141+ 6BBD              GetRampY:
1142+ 6BBD 3A 90 79         ld   a, (ramp_len)
1143+ 6BC0 B7               or   a
1144+ 6BC1 C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1145+ 6BC2
1146+ 6BC2 3A 8F 79         ld   a, (ramp_dir)
1147+ 6BC5 B7               or   a
1148+ 6BC6 28 4C            jr   z, .dir_left
1149+ 6BC8
1150+ 6BC8              .dir_right:
1151+ 6BC8                  ; Rampa sale a destra (up-right)
1152+ 6BC8 3A 92 79         ld   a, (ramp_col)
1153+ 6BCB 87               add  a, a              ; *2
1154+ 6BCC 87               add  a, a              ; *4
1155+ 6BCD 87               add  a, a              ; *8 (X start in pixel)
1156+ 6BCE 5F               ld   e, a              ; E = X_left
1157+ 6BCF
1158+ 6BCF 3A 90 79         ld   a, (ramp_len)
1159+ 6BD2 87               add  a, a              ; *2
1160+ 6BD3 87               add  a, a              ; *4
1161+ 6BD4 87               add  a, a              ; *8
1162+ 6BD5 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1163+ 6BD6 67               ld   h, a              ; H = X_right_boundary
1164+ 6BD7
