1833+ 72A0 3E 06            ld   a, DEFAULT_JUMP_STRENGTH
1834+ 72A2 32 45 E6         ld   (room_jump_strength), a
1835+ 72A5 3E 01            ld   a, DEFAULT_GRAVITY_PRESET
1836+ 72A7 32 46 E6         ld   (room_gravity_preset), a
1837+ 72AA 18 12            jr   .done
1838+ 72AC
1839+ 72AC              .custom_settings:
1840+ 72AC F5               push af
1841+ 72AD E6 0F            and  $0f                  ; Maschera i 4 bit inferiori (JJJJ)
1842+ 72AF 32 45 E6         ld   (room_jump_strength), a
1843+ 72B2 F1               pop  af
1844+ 72B3 CB 3F            srl  a
1845+ 72B5 CB 3F            srl  a
1846+ 72B7 CB 3F            srl  a
1847+ 72B9 CB 3F            srl  a                  ; Sposta i 4 bit superiori in quelli inferiori (GGGG)
1848+ 72BB 32 46 E6         ld   (room_gravity_preset), a
1849+ 72BE
1850+ 72BE              .done:
1851+ 72BE F1               pop  af
1852+ 72BF D1               pop  de
1853+ 72C0 E1               pop  hl
1854+ 72C1 C9               ret
