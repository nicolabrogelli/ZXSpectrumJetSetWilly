  73  7978
  74  7978                  ; Aggiorna BORDCR per far sì che la ROM usi lo stesso colore
  75  7978 87               add  a, a
  76  7979 87               add  a, a
  77  797A 87               add  a, a              ; Sposta nei bit 3-5
  78  797B 47               ld   b, a
  79  797C 3A 48 5C         ld   a, (BORDCR)
  80  797F E6 C7            and  $c7               ; Pulisce vecchi bit del bordo
  81  7981 B0               or   b                 ; Imposta nuovo colore bordo
  82  7982 F6 07            or   $07               ; Imposta ink a bianco
  83  7984 32 48 5C         ld   (BORDCR), a
