1176+ 7725                  ; Se la cella è sulla rampa, non considerarla un muro!
1177+ 7725 53               ld   d, e              ; D = Row
1178+ 7726 59               ld   e, c              ; E = Col
1179+ 7727 CD 93 76         call IsCellOnRamp
1180+ 772A 38 09            jr   c, .not_wall
1181+ 772C
1182+ 772C 7A               ld   a, d              ; A = Row
1183+ 772D 4B               ld   c, e              ; C = Col
