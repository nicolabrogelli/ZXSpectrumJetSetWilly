1174+ 6CF9              ; -------------------------------------------------------------------
1175+ 6CF9              ; GetRampY
1176+ 6CF9              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1177+ 6CF9              ; Input: C = PlayerX
1178+ 6CF9              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1179+ 6CF9              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1180+ 6CF9              ; -------------------------------------------------------------------
1181+ 6CF9              GetRampY:
1182+ 6CF9 3A 01 7E         ld   a, (ramp_len)
1183+ 6CFC B7               or   a
1184+ 6CFD C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1185+ 6CFE
1186+ 6CFE 3A 00 7E         ld   a, (ramp_dir)
1187+ 6D01 B7               or   a
1188+ 6D02 28 5C            jr   z, .dir_left
1189+ 6D04
1190+ 6D04              .dir_right:
1191+ 6D04                  ; Rampa sale a destra (up-right)
1192+ 6D04 3A 03 7E         ld   a, (ramp_col)
1193+ 6D07 87               add  a, a              ; *2
1194+ 6D08 87               add  a, a              ; *4
1195+ 6D09 87               add  a, a              ; *8 (X start in pixel)
1196+ 6D0A 5F               ld   e, a              ; E = X_left
1197+ 6D0B
1198+ 6D0B 3A 01 7E         ld   a, (ramp_len)
1199+ 6D0E 87               add  a, a              ; *2
1200+ 6D0F 87               add  a, a              ; *4
1201+ 6D10 87               add  a, a              ; *8
1202+ 6D11 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1203+ 6D12 67               ld   h, a              ; H = X_right_boundary
1204+ 6D13 38 10            jr   c, .no_right_bound_check_right
1205+ 6D15
1206+ 6D15 79               ld   a, c              ; A = PlayerX
1207+ 6D16 BB               cp   e
1208+ 6D17 DA C6 6D         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1209+ 6D1A
1210+ 6D1A BC               cp   h
1211+ 6D1B 38 1E            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1212+ 6D1D
1213+ 6D1D                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1214+ 6D1D 94               sub  h                 ; A = PlayerX - X_right_boundary
1215+ 6D1E FE 08            cp   8
1216+ 6D20 D2 C6 6D         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1217+ 6D23 18 07            jr   .on_platform_right
1218+ 6D25
1219+ 6D25              .no_right_bound_check_right:
1220+ 6D25 79               ld   a, c              ; A = PlayerX
1221+ 6D26 BB               cp   e
1222+ 6D27 DA C6 6D         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1223+ 6D2A 18 0F            jr   .on_ramp_slope    ; Se >= X_left, è sicuramente sulla pendenza rampa (non può superare 256)
1224+ 6D2C
1225+ 6D2C              .on_platform_right:
1226+ 6D2C                  ; Piattaforma adiacente! Restituisci PlayerY = (ramp_row - ramp_len + 1) * 8 - 16
1227+ 6D2C 3A 02 7E         ld   a, (ramp_row)
1228+ 6D2F 21 01 7E         ld   hl, ramp_len
1229+ 6D32 96               sub  (hl)
1230+ 6D33 3C               inc  a                 ; A = Row
1231+ 6D34 87               add  a, a              ; *2
1232+ 6D35 87               add  a, a              ; *4
1233+ 6D36 87               add  a, a              ; *8
1234+ 6D37 D6 10            sub  16                ; A = Row * 8 - 16
1235+ 6D39 37               scf                    ; Set carry (dentro rampa/piattaforma)
1236+ 6D3A C9               ret
1237+ 6D3B
1238+ 6D3B              .on_ramp_slope:
1239+ 6D3B 3A 02 7E         ld   a, (ramp_row)
1240+ 6D3E 87               add  a, a              ; *2
1241+ 6D3F 87               add  a, a              ; *4
1242+ 6D40 87               add  a, a              ; *8
1243+ 6D41 D6 10            sub  16                ; A = ramp_row * 8 - 16
1244+ 6D43 83               add  a, e              ; A = ramp_row * 8 - 16 + X_left
1245+ 6D44 91               sub  c                 ; A = A - PlayerX
1246+ 6D45 57               ld   d, a              ; D = calculated Y
1247+ 6D46
1248+ 6D46                  ; H = platform_Y + 16 (confronto sicuro con offset +16)
1249+ 6D46 3A 02 7E         ld   a, (ramp_row)
1250+ 6D49 21 01 7E         ld   hl, ramp_len
1251+ 6D4C 96               sub  (hl)
1252+ 6D4D 3C               inc  a                 ; A = Row
1253+ 6D4E 87               add  a, a              ; *2
1254+ 6D4F 87               add  a, a              ; *4
1255+ 6D50 87               add  a, a              ; *8
1256+ 6D51 67               ld   h, a              ; H = platform_Y + 16
1257+ 6D52
1258+ 6D52 7A               ld   a, d              ; A = calculated Y
1259+ 6D53 C6 10            add  a, 16             ; A = calculated Y + 16
1260+ 6D55 BC               cp   h                 ; Compare (calculated Y + 16) con (platform_Y + 16)
1261+ 6D56 30 05            jr   nc, .no_clamp     ; Se calculated Y >= platform_Y, non limitare
1262+ 6D58
1263+ 6D58                  ; Altrimenti, limita a platform_Y
1264+ 6D58 7C               ld   a, h
1265+ 6D59 D6 10            sub  16                ; A = platform_Y
1266+ 6D5B 37               scf
1267+ 6D5C C9               ret
