 147+ 7488                  ; Speaker OFF
 148+ 7488 3A 0F 75         ld   a, (room_border_color)
 149+ 748B E6 EF            and  $ef
 150+ 748D D3 FE            out  ($fe), a
 151+ 748F 4A               ld   c, d
 152+ 7490              .d2:
