 694+ 60D8 BE               cp   (hl)
 695+ 60D9 20 11            jr   nz, .player_moved
 696+ 60DB
 697+ 60DB 3A 35 F3         ld   a, (body_state)
 698+ 60DE 21 37 F7         ld   hl, player_old_body
 699+ 60E1 BE               cp   (hl)
 700+ 60E2 20 08            jr   nz, .player_moved
 701+ 60E4
