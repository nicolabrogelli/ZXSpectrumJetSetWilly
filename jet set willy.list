 101+ 796E
 102+ 796E                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 796E 5F               ld   e, a
 104+ 796F 16 00            ld   d, 0
 105+ 7971 21 B4 79         ld   hl, Audio_MusicSheet
 106+ 7974 19               add  hl, de
 107+ 7975 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 7976
 109+ 7976                  ; Leggi durata (secondo byte)
 110+ 7976 23               inc  hl
 111+ 7977 7E               ld   a, (hl)
 112+ 7978 CB 3F            srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 113+ 797A 20 02            jr   nz, .dur_ok
 114+ 797C 3E 01            ld   a, 1
 115+ 797E              .dur_ok:
 116+ 797E 32 9E 7D         ld   (Audio_music_frame_counter), a
 117+ 7981
 118+ 7981              .play_current_note:
 119+ 7981                  ; Ottieni il delay della nota corrente (primo byte)
 120+ 7981 3A 9D 7D         ld   a, (Audio_music_note_idx)
 121+ 7984 5F               ld   e, a
 122+ 7985 16 00            ld   d, 0
 123+ 7987 21 B4 79         ld   hl, Audio_MusicSheet
 124+ 798A 19               add  hl, de
 125+ 798B 19               add  hl, de                   ; hl punta al primo byte della nota
 126+ 798C 7E               ld   a, (hl)                  ; A = delay
 127+ 798D B7               or   a
 128+ 798E 28 1F            jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 129+ 7990
 130+ 7990                  ; Suona la nota: 2 cicli
 131+ 7990 57               ld   d, a                     ; D = delay
 132+ 7991 06 02            ld   b, 2                     ; 2 cicli per frame
 133+ 7993              .note_loop:
 134+ 7993                  ; Speaker ON
 135+ 7993 3A 27 7A         ld   a, (room_border_color)
 136+ 7996 F6 10            or   $10
 137+ 7998 D3 FE            out  ($fe), a
 138+ 799A 4A               ld   c, d
 139+ 799B              .d1:
 140+ 799B F5               push af
 141+ 799C F1               pop  af
 142+ 799D 0D               dec  c
 143+ 799E 20 FB            jr   nz, .d1
 144+ 79A0
 145+ 79A0                  ; Speaker OFF
 146+ 79A0 3A 27 7A         ld   a, (room_border_color)
 147+ 79A3 E6 EF            and  $ef
 148+ 79A5 D3 FE            out  ($fe), a
 149+ 79A7 4A               ld   c, d
 150+ 79A8              .d2:
 151+ 79A8 F5               push af
 152+ 79A9 F1               pop  af
 153+ 79AA 0D               dec  c
 154+ 79AB 20 FB            jr   nz, .d2
 155+ 79AD
 156+ 79AD 10 E4            djnz .note_loop
 157+ 79AF
 158+ 79AF              .done:
 159+ 79AF E1               pop  hl
 160+ 79B0 D1               pop  de
 161+ 79B1 C1               pop  bc
 162+ 79B2 F1               pop  af
 163+ 79B3 C9               ret
