 547+ 6E96 28 08            jr   z, .h_rev_right
 548+ 6E98 38 06            jr   c, .h_rev_right
 549+ 6E9A DD 77 01         ld   (ix+1), a
 550+ 6E9D C3 12 6F         jp   .next
