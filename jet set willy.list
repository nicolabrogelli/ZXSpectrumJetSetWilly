   7+ 69EF              ; Muove il player
   8+ 69EF              ; Input: D = stato controlli
   9+ 69EF              ; -------------------------------------------------------------------
  10+ 69EF              MovePlayer:
  11+ 69EF                  ; Verifica se un tasto di movimento è premuto
  12+ 69EF DD 21 5A 6F      ld   ix, flags
  13+ 69F3 DD CB 00 46      bit  $00, (ix)
  14+ 69F7 C8               ret  z
  15+ 69F8 DD CB 00 86      res  $00, (ix)
  16+ 69FC
  17+ 69FC ED 4B 52 6F      ld   bc, (PlayerPos)   ; C = PlayerX (pixel), B = PlayerY (pixel)
  18+ 6A00
  19+ 6A00 CB 4A            bit  $01, d            ; Tasto Destra premuto?
  20+ 6A02 20 11            jr   nz, movePlayer_right
  21+ 6A04
  22+ 6A04 CB 42            bit  $00, d            ; Tasto Sinistra premuto?
  23+ 6A06 C8               ret  z
  24+ 6A07
  25+ 6A07              movePlayer_left:
  26+ 6A07 79               ld   a, c
  27+ 6A08 D6 02            sub  2                 ; Prova a muoverti di 2 pixel a sinistra
  28+ 6A0A FE 08            cp   PLAYER_MIN_X      ; Confronta con il limite sinistro
  29+ 6A0C 38 03            jr   c, .clamp_left    ; Se < PLAYER_MIN_X, clampa
  30+ 6A0E 4F               ld   c, a              ; Altrimenti memorizza la nuova posizione
  31+ 6A0F 18 12            jr   save_x
  32+ 6A11
  33+ 6A11              .clamp_left:
  34+ 6A11 0E 08            ld   c, PLAYER_MIN_X
  35+ 6A13 18 0E            jr   save_x
  36+ 6A15
  37+ 6A15              movePlayer_right:
  38+ 6A15 79               ld   a, c
  39+ 6A16 C6 02            add  a, 2              ; Prova a muoverti di 2 pixel a destra
  40+ 6A18 FE F0            cp   PLAYER_MAX_X      ; Confronta con il limite destro
  41+ 6A1A 28 02            jr   z, .ok_right      ; Se == PLAYER_MAX_X, va bene
  42+ 6A1C 30 03            jr   nc, .clamp_right  ; Se > PLAYER_MAX_X (senza carry, cioè maggiore), clampa
  43+ 6A1E              .ok_right:
  44+ 6A1E 4F               ld   c, a              ; Altrimenti memorizza la nuova posizione
  45+ 6A1F 18 02            jr   save_x
  46+ 6A21
  47+ 6A21              .clamp_right:
  48+ 6A21 0E F0            ld   c, PLAYER_MAX_X
  49+ 6A23
  50+ 6A23              save_x:
  51+ 6A23 ED 43 52 6F      ld   (PlayerPos), bc
  52+ 6A27
  53+ 6A27              movePlayer_print:
  54+ 6A27                  ; Alterna lo stato delle gambe ad ogni movimento (0, 1, 2, 0, 1, 2...)
  55+ 6A27 3A 58 6F         ld   a, (body_state)
  56+ 6A2A 3C               inc  a
  57+ 6A2B FE 03            cp   3
  58+ 6A2D 20 02            jr   nz, .save_state
  59+ 6A2F 3E 00            ld   a, 0
  60+ 6A31              .save_state:
  61+ 6A31 32 58 6F         ld   (body_state), a
  62+ 6A34 C9               ret
