1327+ 77A4              ; Phys_CheckRampOnRoomChange
1328+ 77A4              ; Controlla se nella nuova stanza (DE = room layout ptr) c'è una rampa
1329+ 77A4              ; allineata con la posizione d'ingresso di Willy (C = PlayerX, B = PlayerY).
1330+ 77A4              ; Output: Se allineato, modifica B = ramp_Y e C = PlayerX e imposta on_ground = 1.
1331+ 77A4              ; -------------------------------------------------------------------
1332+ 77A4              Phys_CheckRampOnRoomChange:
1333+ 77A4 E5               push hl
1334+ 77A5 D5               push de
1335+ 77A6 C5               push bc
1336+ 77A7
1337+ 77A7                  ; Offsets per RampData: DE + 218
1338+ 77A7 21 DA 00         ld   hl, 218
1339+ 77AA 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1340+ 77AB
1341+ 77AB 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1342+ 77AC 32 82 F7         ld   (ramp_dir), a
1343+ 77AF 23               inc  hl
1344+ 77B0 5E               ld   e, (hl)
1345+ 77B1 23               inc  hl
1346+ 77B2 56               ld   d, (hl)           ; DE = Location
1347+ 77B3 23               inc  hl
