 148+ 7424              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 149+ 7424              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 150+ 7424              ; -------------------------------------------------------------------
 151+ 7424              DrawItemGraphic:
 152+ 7424 C5               push bc
 153+ 7425 D5               push de
 154+ 7426 E5               push hl
 155+ 7427
 156+ 7427                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 157+ 7427 78               ld   a, b
 158+ 7428 E6 18            and  $18
 159+ 742A C6 40            add  a, $40
 160+ 742C 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 161+ 742D
 162+ 742D 78               ld   a, b
 163+ 742E E6 07            and  7
 164+ 7430 87               add  a, a              ; *2
 165+ 7431 87               add  a, a              ; *4
 166+ 7432 87               add  a, a              ; *8
 167+ 7433 87               add  a, a              ; *16
 168+ 7434 87               add  a, a              ; *32
 169+ 7435 81               add  a, c              ; + Col C
 170+ 7436 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 171+ 7437
 172+ 7437                  ; 2. Copia gli 8 byte del bitmap dello sprite
 173+ 7437 C5               push bc                ; Salva BC (contiene Row e Col)
 174+ 7438 06 08            ld   b, 8              ; 8 scanline
 175+ 743A              .line_loop:
