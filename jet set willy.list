1329+ 8519              ; DrawItemGraphic
1330+ 8519              ;
1331+ 8519              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1332+ 8519              ; utilizzando una bitmap di 8 byte e un attributo colore.
1333+ 8519              ;
1334+ 8519              ; Input:
1335+ 8519              ;   B = Riga attributi (3..18)
1336+ 8519              ;   C = Colonna attributi (0..31)
1337+ 8519              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1338+ 8519              ;   E = Attributo colore
1339+ 8519              ;
1340+ 8519              ; Output:
1341+ 8519              ;   Nessuno
1342+ 8519              ;
1343+ 8519              ; Registri preservati:
1344+ 8519              ;   BC, DE, HL
1345+ 8519              ; -------------------------------------------------------------------
1346+ 8519              DrawItemGraphic:
1347+ 8519
1348+ 8519                  ; Salva i registri originali
1349+ 8519 C5               push bc
1350+ 851A D5               push de
1351+ 851B E5               push hl
1352+ 851C
1353+ 851C                  ; ---------------------------------------------------------------
1354+ 851C                  ; Calcolo indirizzo bitmap dello Spectrum
1355+ 851C                  ;
1356+ 851C                  ; Ogni item occupa una cella attributi (8x8 pixel).
1357+ 851C                  ;
1358+ 851C                  ; Formula:
1359+ 851C                  ;   High = $40 + (Row AND $18)
1360+ 851C                  ;   Low  = (Row AND 7) * 32 + Col
1361+ 851C                  ;
1362+ 851C                  ; DE conterrà l'indirizzo della prima scanline.
1363+ 851C                  ; ---------------------------------------------------------------
1364+ 851C
1365+ 851C 78               ld   a, b
1366+ 851D E6 18            and  $18
1367+ 851F C6 40            add  a, $40
1368+ 8521 57               ld   d, a              ; Byte alto indirizzo video
1369+ 8522
1370+ 8522 78               ld   a, b
1371+ 8523 E6 07            and  7                 ; Riga interna al blocco da 8
1372+ 8525
1373+ 8525 87               add  a, a              ; *2
1374+ 8526 87               add  a, a              ; *4
1375+ 8527 87               add  a, a              ; *8
1376+ 8528 87               add  a, a              ; *16
1377+ 8529 87               add  a, a              ; *32
1378+ 852A
1379+ 852A 81               add  a, c              ; + colonna
1380+ 852B
1381+ 852B 5F               ld   e, a              ; Byte basso indirizzo video
1382+ 852C
1383+ 852C                  ; ---------------------------------------------------------------
1384+ 852C                  ; Disegno bitmap
1385+ 852C                  ;
1386+ 852C                  ; Copia 8 byte consecutivi nella memoria video.
1387+ 852C                  ; Ogni byte rappresenta una scanline da 8 pixel.
1388+ 852C                  ; ---------------------------------------------------------------
1389+ 852C
1390+ 852C C5               push bc                ; Conserva Row e Col
1391+ 852D
1392+ 852D 06 08            ld   b, 8              ; Numero scanline
1393+ 852F
1394+ 852F              .line_loop:
1395+ 852F
1396+ 852F 7E               ld   a, (hl)           ; Legge scanline bitmap
1397+ 8530 12               ld   (de), a           ; Scrive nella memoria video
1398+ 8531
1399+ 8531 14               inc  d                 ; Scanline successiva
1400+ 8532 23               inc  hl                ; Byte bitmap successivo
1401+ 8533
1402+ 8533 05               dec  b
1403+ 8534 20 F9            jr   nz, .line_loop
1404+ 8536
1405+ 8536 C1               pop  bc                ; Ripristina Row e Col
1406+ 8537
1407+ 8537                  ; ---------------------------------------------------------------
1408+ 8537                  ; Calcolo indirizzo attributo
1409+ 8537                  ;
1410+ 8537                  ; Formula:
1411+ 8537                  ;   AttrAddr = $5800 + Row * 32 + Col
1412+ 8537                  ;
1413+ 8537                  ; HL conterrà l'indirizzo della cella attributi.
1414+ 8537                  ; ---------------------------------------------------------------
1415+ 8537
1416+ 8537 26 00            ld   h, 0
1417+ 8539 68               ld   l, b              ; HL = Row
1418+ 853A
1419+ 853A 29               add  hl, hl            ; *2
1420+ 853B 29               add  hl, hl            ; *4
1421+ 853C 29               add  hl, hl            ; *8
1422+ 853D 29               add  hl, hl            ; *16
1423+ 853E 29               add  hl, hl            ; *32
1424+ 853F
1425+ 853F 79               ld   a, c              ; A = Colonna
1426+ 8540
1427+ 8540 85               add  a, l
1428+ 8541 6F               ld   l, a
1429+ 8542
1430+ 8542 30 01            jr   nc, .no_carry
1431+ 8544 24               inc  h
1432+ 8545
1433+ 8545              .no_carry:
1434+ 8545
1435+ 8545                  ; HL = Row * 32 + Col
1436+ 8545
1437+ 8545 11 00 58         ld   de, $5800
1438+ 8548 19               add  hl, de            ; HL = indirizzo attributi
1439+ 8549
1440+ 8549                  ; ---------------------------------------------------------------
1441+ 8549                  ; Recupera il colore originale dallo stack.
1442+ 8549                  ;
1443+ 8549                  ; Layout stack:
1444+ 8549                  ;   HL originale
1445+ 8549                  ;   DE originale (E = colore)
1446+ 8549                  ;   BC originale
1447+ 8549                  ; ---------------------------------------------------------------
1448+ 8549
1449+ 8549 C1               pop  bc                ; Recupera HL originale
1450+ 854A D1               pop  de                ; Recupera DE originale
1451+ 854B
1452+ 854B                  ; ---------------------------------------------------------------
1453+ 854B                  ; Scrive l'attributo colore
1454+ 854B                  ; ---------------------------------------------------------------
1455+ 854B
1456+ 854B 7B               ld   a, e              ; A = colore
1457+ 854C 77               ld   (hl), a           ; Scrive nella RAM attributi
1458+ 854D
1459+ 854D                  ; ---------------------------------------------------------------
1460+ 854D                  ; Ripristina HL e BC originali
1461+ 854D                  ; ---------------------------------------------------------------
