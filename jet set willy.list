 737+ 60F7 87               add  a, a              ; *4 (Col group * 4)
 738+ 60F8 6F               ld   l, a              ; L = Col group * 4
 739+ 60F9
 740+ 60F9 3E 04            ld   a, 4
 741+ 60FB 93               sub  e                 ; A = 4 - E (0..3)
