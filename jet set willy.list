 971+ 8045 DD BE 05         cp   (ix+5)            ; Max Limit (Offset 5)
 972+ 8048 28 08            jr   z, .h_rev_left
 973+ 804A 30 06            jr   nc, .h_rev_left
 974+ 804C DD 77 02         ld   (ix+2), a
 975+ 804F C3 AD 80         jp   .next
