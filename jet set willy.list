   1+ 708A              ;===========================================================================
   2+ 708A              ; items.asm
   3+ 708A              ;===========================================================================
   4+ 708A
   5+ 708A              ; -------------------------------------------------------------------
   6+ 708A              ; Tabella Globale degli Oggetti (Items)
   7+ 708A              ; Ciascun item occupa 5 byte:
   8+ 708A              ;   Byte 0: ID della stanza (0 = Test Room, 1 = The Bridge, 2 = The Off Licence, 3 = Master Bedroom, 4 = Under the MegaTree, 5 = Gfx_At TheFoot The Mega Tree, 6 = The Drive, 7 = The Security Guard)
   9+ 708A              ;   Byte 1: X colonna dello schermo (0..31)
  10+ 708A              ;   Byte 2: Y riga dello schermo (3..18)
  11+ 708A              ;   Byte 3: Attributo colore (es. $C6 per Giallo Flashing, $C5 per Cyan Flashing)
  12+ 708A              ;   Byte 4: Stato (0 = Attivo/Non raccolto, 1 = Raccolto)
  13+ 708A              ; La tabella termina con $FF
  14+ 708A              ;
  15+ 708A              ; La tabella riposrta solamente le stanza in cui effettivamente ci sono degli oggetti le altre sono omesse
  16+ 708A              ;
  17+ 708A              ; Tabella dei colori, se aggiungiamo $C davanti al colore questo diventa lampeggiante
  18+ 708A              ; 1 - BLUE
  19+ 708A              ; 2 - RED
  20+ 708A              ; 3 - MAGENTA
  21+ 708A              ; 4 - GREEN
  22+ 708A              ; 5 - CYAN
