 279  89E6              ; -------------------------------------------------------------------
 280  89E6              ; ShowTitleScreen
 281  89E6              ; Visualizza la schermata iniziale del gioco (Title Screen).
 282  89E6              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 283  89E6              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 284  89E6              ; -------------------------------------------------------------------
 285  89E6              ShowTitleScreen:
 286  89E6                  ; 1. Disegna la schermata iniziale
 287  89E6 CD 1B 63         call Gfx_DrawTitleScreen
 288  89E9
 289  89E9                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 290  89E9              .wait_title_enter_release:
 291  89E9 76               halt
 292  89EA 3E BF            ld   a, $bf
 293  89EC DB FE            in   a, ($fe)
 294  89EE 1F               rra
 295  89EF 30 F8            jr   nc, .wait_title_enter_release
 296  89F1
 297  89F1                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 298  89F1 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 299  89F3              .title_loop:
 300  89F3 76               halt
 301  89F4
 302  89F4                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 303  89F4 0C               inc  c
 304  89F5 79               ld   a, c
 305  89F6 CB 3F            srl  a
 306  89F8 CB 3F            srl  a
 307  89FA CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 308  89FC E6 07            and  7
 309  89FE 5F               ld   e, a
 310  89FF 16 00            ld   d, 0
 311  8A01 21 13 63         ld   hl, title_color_table
 312  8A04 19               add  hl, de
 313  8A05 7E               ld   a, (hl)               ; A = nuovo colore
 314  8A06 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 315  8A09 06 20            ld   b, 32
 316  8A0B              .color_title_loop:
 317  8A0B 77               ld   (hl), a
 318  8A0C 23               inc  hl
 319  8A0D 10 FC            djnz .color_title_loop
 320  8A0F
 321  8A0F                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 322  8A0F 3E BF            ld   a, $bf
 323  8A11 DB FE            in   a, ($fe)
 324  8A13 1F               rra
 325  8A14 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 326  8A16
 327  8A16                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 328  8A16              .wait_title_enter_release_after:
 329  8A16 76               halt
 330  8A17 3E BF            ld   a, $bf
 331  8A19 DB FE            in   a, ($fe)
 332  8A1B 1F               rra
 333  8A1C 30 F8            jr   nc, .wait_title_enter_release_after
 334  8A1E
 335  8A1E                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 336  8A1E AF               xor  a
 337  8A1F D3 FE            out  ($fe), a              ; Bordo a nero
 338  8A21 21 8D 5C         ld   hl, ATTR_P
 339  8A24 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 340  8A25 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 341  8A28 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 342  8A2A 3E 07            ld   a, $07
 343  8A2C 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
