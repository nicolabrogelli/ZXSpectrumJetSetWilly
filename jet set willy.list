 758+ 6110
 759+ 6110 04               inc  b
 760+ 6111 78               ld   a, b
 761+ 6112 FE 10            cp   16
 762+ 6114 C2 AA 60         jp   nz, .row_loop
 763+ 6117
 764+ 6117 DD E1            pop  ix
 765+ 6119 E1               pop  hl
 766+ 611A D1               pop  de
 767+ 611B C1               pop  bc
