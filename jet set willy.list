 232  8972                  ; 5. Riposiziona Willy nel punto di ingresso dell'ultima stanza raggiunta
 233  8972 CD 49 82         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 234  8975 21 69 F8         ld   hl, room_entry_positions
 235  8978 5F               ld   e, a
 236  8979 16 00            ld   d, 0
 237  897B 19               add  hl, de
 238  897C 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 239  897D 4E               ld   c, (hl)                   ; C = X ingresso
 240  897E 23               inc  hl
 241  897F 46               ld   b, (hl)                   ; B = Y ingresso
 242  8980 ED 43 E2 F4      ld   (PlayerPos), bc           ; Imposta le coordinate di respawn al punto di ingresso
 243  8984 ED 43 E4 F4      ld   (PlayerPosOld), bc
 244  8988
 245  8988 3E 01            ld   a, 1
 246  898A 32 68 F8         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 247  898D
