 776+ 77DA                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 777+ 77DA 3A A8 E9         ld   a, (enemy_update_rate)
 778+ 77DD FE 01            cp   1
 779+ 77DF 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 780+ 77E1
 781+ 77E1 3A A9 E9         ld   a, (enemy_update_timer)
 782+ 77E4 3C               inc  a
 783+ 77E5 47               ld   b, a                      ; B = timer + 1
 784+ 77E6 3A A8 E9         ld   a, (enemy_update_rate)
 785+ 77E9 B8               cp   b
 786+ 77EA 28 0C            jr   z, .reset_timer
 787+ 77EC 38 0A            jr   c, .reset_timer
 788+ 77EE
 789+ 77EE                  ; Salva contatore incrementato e salta l'aggiornamento
 790+ 77EE 78               ld   a, b
 791+ 77EF 32 A9 E9         ld   (enemy_update_timer), a
