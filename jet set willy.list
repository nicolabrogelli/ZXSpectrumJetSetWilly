1185+ 6E68              ; Legge il tipo di cella dal buffer decompresso in RAM
1186+ 6E68              ; Input: A = Row (0..15), C = Col (0..31)
1187+ 6E68              ; Output: A = tipo di cella (0..3)
1188+ 6E68              ; Preserva tutti gli altri registri.
1189+ 6E68              ; -------------------------------------------------------------------
1190+ 6E68              GetCellFromUnpacked:
1191+ 6E68 E5               push hl
1192+ 6E69 D5               push de
1193+ 6E6A
1194+ 6E6A 6F               ld   l, a
1195+ 6E6B 26 00            ld   h, 0
1196+ 6E6D 29               add  hl, hl
1197+ 6E6E 29               add  hl, hl
1198+ 6E6F 29               add  hl, hl
1199+ 6E70 29               add  hl, hl
1200+ 6E71 29               add  hl, hl            ; HL = Row * 32
1201+ 6E72 59               ld   e, c
1202+ 6E73 16 00            ld   d, 0
1203+ 6E75 19               add  hl, de            ; HL = Row * 32 + Col
1204+ 6E76 11 4B E7         ld   de, unpacked_layout
1205+ 6E79 19               add  hl, de
1206+ 6E7A 7E               ld   a, (hl)           ; A = cell type
1207+ 6E7B
1208+ 6E7B D1               pop  de
1209+ 6E7C E1               pop  hl
1210+ 6E7D C9               ret
