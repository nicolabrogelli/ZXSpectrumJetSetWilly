 940+ 7DD3 28 08            jr   z, .v_rev_down
 941+ 7DD5 38 06            jr   c, .v_rev_down
 942+ 7DD7 DD 77 03         ld   (ix+3), a
 943+ 7DDA C3 08 7E         jp   .next
 944+ 7DDD
 945+ 7DDD              .v_rev_down:
 946+ 7DDD DD 7E 04         ld   a, (ix+4)         ; Min Limit
 947+ 7DE0 DD 77 03         ld   (ix+3), a
 948+ 7DE3 3E 02            ld   a, 2
 949+ 7DE5 DD 77 06         ld   (ix+6), a         ; Cambia direzione in Basso
 950+ 7DE8 C3 08 7E         jp   .next
 951+ 7DEB
 952+ 7DEB              .vert_down:
 953+ 7DEB DD 7E 03         ld   a, (ix+3)         ; Current Y
 954+ 7DEE C6 02            add  a, 2              ; Muovi in basso di 2 pixel
 955+ 7DF0 DD BE 05         cp   (ix+5)            ; Max Limit (Bottom)
 956+ 7DF3 28 08            jr   z, .v_rev_up
 957+ 7DF5 30 06            jr   nc, .v_rev_up
 958+ 7DF7 DD 77 03         ld   (ix+3), a
 959+ 7DFA C3 08 7E         jp   .next
 960+ 7DFD
 961+ 7DFD              .v_rev_up:
