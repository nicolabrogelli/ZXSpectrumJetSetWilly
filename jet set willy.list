 322+ 6F84              ; -------------------------------------------------------------------
 323+ 6F84              ; DrawRoomItems
 324+ 6F84              ;
 325+ 6F84              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 326+ 6F84              ;
 327+ 6F84              ; Operazioni eseguite:
 328+ 6F84              ;   1. Azzera la griglia items_grid.
 329+ 6F84              ;   2. Svuota la cache degli oggetti attivi.
 330+ 6F84              ;   3. Scansiona ItemsTable.
 331+ 6F84              ;   4. Per ogni item della stanza corrente:
 332+ 6F84              ;        - verifica se è già stato raccolto
 333+ 6F84              ;        - disegna la grafica
 334+ 6F84              ;        - aggiorna items_grid
 335+ 6F84              ;        - memorizza l'item nella cache current_room_items
 336+ 6F84              ;   5. Aggiorna num_room_items.
 337+ 6F84              ;
 338+ 6F84              ; Record ItemsTable:
 339+ 6F84              ;   +0  Room ID
 340+ 6F84              ;   +1  X (colonna)
 341+ 6F84              ;   +2  Y (riga)
 342+ 6F84              ;   +3  Colore
 343+ 6F84              ;   +4  Collected flag
 344+ 6F84              ;
 345+ 6F84              ; Cache current_room_items:
 346+ 6F84              ;   +0  Colonna
 347+ 6F84              ;   +1  Riga
 348+ 6F84              ;   +2  Colore
 349+ 6F84              ;   +3  Collected flag ptr (Low)
 350+ 6F84              ;   +4  Collected flag ptr (High)
 351+ 6F84              ;
 352+ 6F84              ; Ogni record cache occupa 5 byte.
 353+ 6F84              ; -------------------------------------------------------------------
 354+ 6F84              DrawRoomItems:
 355+ 6F84
 356+ 6F84                  ; Salva tutti i registri utilizzati
 357+ 6F84 E5               push hl
 358+ 6F85 D5               push de
 359+ 6F86 C5               push bc
 360+ 6F87 DD E5            push ix
 361+ 6F89 FD E5            push iy
 362+ 6F8B
 363+ 6F8B                  ; ---------------------------------------------------------------
 364+ 6F8B                  ; Azzera items_grid (32 x 16 = 512 byte)
 365+ 6F8B                  ; ---------------------------------------------------------------
 366+ 6F8B 21 00 90         ld   hl, items_grid
 367+ 6F8E 11 01 90         ld   de, items_grid + 1
 368+ 6F91 36 00            ld   (hl), 0
 369+ 6F93 01 FF 01         ld   bc, 511
 370+ 6F96 ED B0            ldir
 371+ 6F98
 372+ 6F98                  ; ---------------------------------------------------------------
 373+ 6F98                  ; Nessun item attivo nella stanza
 374+ 6F98                  ; ---------------------------------------------------------------
 375+ 6F98 AF               xor  a
 376+ 6F99 32 D7 74         ld   (num_room_items), a
 377+ 6F9C
 378+ 6F9C                  ; IY punta alla cache degli item attivi
 379+ 6F9C FD 21 87 74      ld   iy, current_room_items
 380+ 6FA0
 381+ 6FA0                  ; ---------------------------------------------------------------
 382+ 6FA0                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 383+ 6FA0                  ; alla stanza corrente.
 384+ 6FA0                  ;
 385+ 6FA0                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 386+ 6FA0                  ; ---------------------------------------------------------------
 387+ 6FA0 2A D8 74         ld   hl, (room_ptr)
 388+ 6FA3 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 389+ 6FA6 19               add  hl, de
 390+ 6FA7
 391+ 6FA7 E5               push hl
 392+ 6FA8 DD E1            pop  ix                ; IX = bitmap item
 393+ 6FAA
 394+ 6FAA                  ; ---------------------------------------------------------------
 395+ 6FAA                  ; Inizio scansione della tabella degli item
 396+ 6FAA                  ; ---------------------------------------------------------------
 397+ 6FAA 21 34 6E         ld   hl, ItemsTable
 398+ 6FAD
 399+ 6FAD              .loop:
 400+ 6FAD
 401+ 6FAD                  ; ---------------------------------------------------------------
 402+ 6FAD                  ; Legge il Room ID del record corrente
 403+ 6FAD                  ; ---------------------------------------------------------------
 404+ 6FAD 7E               ld   a, (hl)
 405+ 6FAE
 406+ 6FAE                  ; $FF indica fine tabella
 407+ 6FAE FE FF            cp   $FF
 408+ 6FB0 28 53            jr   z, .done
 409+ 6FB2
 410+ 6FB2                  ; ---------------------------------------------------------------
 411+ 6FB2                  ; Verifica se l'item appartiene alla stanza corrente
 412+ 6FB2                  ; ---------------------------------------------------------------
 413+ 6FB2 57               ld   d, a
 414+ 6FB3
 415+ 6FB3 3A 7E 74         ld   a, (current_room)
 416+ 6FB6 BA               cp   d
 417+ 6FB7 20 45            jr   nz, .next_item
 418+ 6FB9
 419+ 6FB9                  ; ---------------------------------------------------------------
 420+ 6FB9                  ; Legge i dati dell'item
 421+ 6FB9                  ; ---------------------------------------------------------------
 422+ 6FB9
 423+ 6FB9 23               inc  hl
 424+ 6FBA 4E               ld   c, (hl)           ; X (colonna)
 425+ 6FBB
 426+ 6FBB 23               inc  hl
 427+ 6FBC 46               ld   b, (hl)           ; Y (riga)
 428+ 6FBD
 429+ 6FBD 23               inc  hl
 430+ 6FBE 5E               ld   e, (hl)           ; Colore
 431+ 6FBF
 432+ 6FBF 23               inc  hl
 433+ 6FC0 7E               ld   a, (hl)           ; Collected flag
 434+ 6FC1
 435+ 6FC1                  ; Se diverso da zero l'item è già stato raccolto
 436+ 6FC1 B7               or   a
 437+ 6FC2 20 3E            jr   nz, .next_no_inc
 438+ 6FC4
 439+ 6FC4                  ; ---------------------------------------------------------------
 440+ 6FC4                  ; Disegna l'item sullo schermo
 441+ 6FC4                  ;
 442+ 6FC4                  ; B = Row
 443+ 6FC4                  ; C = Column
 444+ 6FC4                  ; HL = bitmap pointer
 445+ 6FC4                  ; E = Color
 446+ 6FC4                  ; ---------------------------------------------------------------
 447+ 6FC4 E5               push hl
 448+ 6FC5
 449+ 6FC5 DD E5            push ix
 450+ 6FC7 E1               pop  hl
 451+ 6FC8
 452+ 6FC8 CD 0D 70         call DrawItemGraphic
 453+ 6FCB
 454+ 6FCB E1               pop  hl                ; ritorna al flag collected
 455+ 6FCC
 456+ 6FCC                  ; ---------------------------------------------------------------
 457+ 6FCC                  ; Aggiorna items_grid
 458+ 6FCC                  ;
 459+ 6FCC                  ; Calcolo:
 460+ 6FCC                  ;   offset = Row * 32 + Col
 461+ 6FCC                  ; ---------------------------------------------------------------
 462+ 6FCC E5               push hl
 463+ 6FCD D5               push de
 464+ 6FCE
 465+ 6FCE 26 00            ld   h, 0
 466+ 6FD0 68               ld   l, b              ; HL = Row
 467+ 6FD1
 468+ 6FD1 29               add  hl, hl            ; *2
 469+ 6FD2 29               add  hl, hl            ; *4
 470+ 6FD3 29               add  hl, hl            ; *8
 471+ 6FD4 29               add  hl, hl            ; *16
 472+ 6FD5 29               add  hl, hl            ; *32
 473+ 6FD6
 474+ 6FD6 16 00            ld   d, 0
 475+ 6FD8 59               ld   e, c              ; DE = Col
 476+ 6FD9
 477+ 6FD9 19               add  hl, de            ; Row*32 + Col
 478+ 6FDA
 479+ 6FDA 11 00 90         ld   de, items_grid
 480+ 6FDD 19               add  hl, de            ; puntatore nella griglia
 481+ 6FDE
 482+ 6FDE D1               pop  de                ; ripristina colore
 483+ 6FDF
 484+ 6FDF 73               ld   (hl), e           ; salva colore cella
 485+ 6FE0
 486+ 6FE0 E1               pop  hl
 487+ 6FE1
 488+ 6FE1                  ; ---------------------------------------------------------------
 489+ 6FE1                  ; Salva l'item nella cache della stanza
 490+ 6FE1                  ;
 491+ 6FE1                  ; Questo evita di dover scansionare tutta ItemsTable
 492+ 6FE1                  ; durante il controllo delle collisioni.
 493+ 6FE1                  ; ---------------------------------------------------------------
 494+ 6FE1
 495+ 6FE1 FD 71 00         ld   (iy+0), c         ; Colonna
 496+ 6FE4 FD 70 01         ld   (iy+1), b         ; Riga
 497+ 6FE7 FD 73 02         ld   (iy+2), e         ; Colore
 498+ 6FEA
 499+ 6FEA                  ; Salva il puntatore al flag "collected"
 500+ 6FEA FD 75 03         ld   (iy+3), l         ; Low byte
 501+ 6FED FD 74 04         ld   (iy+4), h         ; High byte
 502+ 6FF0
 503+ 6FF0                  ; Passa al record successivo della cache
 504+ 6FF0 01 05 00         ld   bc, 5
 505+ 6FF3 FD 09            add  iy, bc
 506+ 6FF5
 507+ 6FF5                  ; Incrementa il numero di item attivi
 508+ 6FF5 3A D7 74         ld   a, (num_room_items)
 509+ 6FF8 3C               inc  a
 510+ 6FF9 32 D7 74         ld   (num_room_items), a
 511+ 6FFC
 512+ 6FFC 18 04            jr   .next_no_inc
 513+ 6FFE
 514+ 6FFE              .next_item:
 515+ 6FFE
 516+ 6FFE                  ; ---------------------------------------------------------------
 517+ 6FFE                  ; L'item non appartiene alla stanza corrente.
 518+ 6FFE                  ; Salta i campi del record:
 519+ 6FFE                  ;   X
 520+ 6FFE                  ;   Y
 521+ 6FFE                  ;   Color
 522+ 6FFE                  ;   Collected
 523+ 6FFE                  ; ---------------------------------------------------------------
 524+ 6FFE 23               inc  hl
 525+ 6FFF 23               inc  hl
 526+ 7000 23               inc  hl
 527+ 7001 23               inc  hl
 528+ 7002
 529+ 7002              .next_no_inc:
 530+ 7002
 531+ 7002                  ; ---------------------------------------------------------------
 532+ 7002                  ; Avanza al record successivo
 533+ 7002                  ; (prossimo Room ID)
 534+ 7002                  ; ---------------------------------------------------------------
 535+ 7002 23               inc  hl
 536+ 7003 18 A8            jr   .loop
 537+ 7005
 538+ 7005              .done:
 539+ 7005
 540+ 7005                  ; Ripristina i registri
 541+ 7005 FD E1            pop  iy
 542+ 7007 DD E1            pop  ix
 543+ 7009 D1               pop  de
 544+ 700A C1               pop  bc
 545+ 700B E1               pop  hl
 546+ 700C
 547+ 700C C9               ret
 548+ 700D
 549+ 700D              ; -------------------------------------------------------------------
 550+ 700D              ; DrawItemGraphic
 551+ 700D              ;
 552+ 700D              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 553+ 700D              ; utilizzando una bitmap di 8 byte e un attributo colore.
 554+ 700D              ;
 555+ 700D              ; Input:
 556+ 700D              ;   B = Riga attributi (3..18)
 557+ 700D              ;   C = Colonna attributi (0..31)
 558+ 700D              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 559+ 700D              ;   E = Attributo colore
 560+ 700D              ;
 561+ 700D              ; Output:
 562+ 700D              ;   Nessuno
 563+ 700D              ;
 564+ 700D              ; Registri preservati:
 565+ 700D              ;   BC, DE, HL
 566+ 700D              ; -------------------------------------------------------------------
 567+ 700D              DrawItemGraphic:
 568+ 700D
 569+ 700D                  ; Salva i registri originali
 570+ 700D C5               push bc
 571+ 700E D5               push de
 572+ 700F E5               push hl
 573+ 7010
 574+ 7010                  ; ---------------------------------------------------------------
 575+ 7010                  ; Calcolo indirizzo bitmap dello Spectrum
 576+ 7010                  ;
 577+ 7010                  ; Ogni item occupa una cella attributi (8x8 pixel).
 578+ 7010                  ;
 579+ 7010                  ; Formula:
 580+ 7010                  ;   High = $40 + (Row AND $18)
 581+ 7010                  ;   Low  = (Row AND 7) * 32 + Col
 582+ 7010                  ;
 583+ 7010                  ; DE conterrà l'indirizzo della prima scanline.
 584+ 7010                  ; ---------------------------------------------------------------
 585+ 7010
 586+ 7010 78               ld   a, b
 587+ 7011 E6 18            and  $18
 588+ 7013 C6 40            add  a, $40
 589+ 7015 57               ld   d, a              ; Byte alto indirizzo video
 590+ 7016
 591+ 7016 78               ld   a, b
 592+ 7017 E6 07            and  7                 ; Riga interna al blocco da 8
 593+ 7019
 594+ 7019 87               add  a, a              ; *2
 595+ 701A 87               add  a, a              ; *4
 596+ 701B 87               add  a, a              ; *8
 597+ 701C 87               add  a, a              ; *16
 598+ 701D 87               add  a, a              ; *32
 599+ 701E
 600+ 701E 81               add  a, c              ; + colonna
 601+ 701F
 602+ 701F 5F               ld   e, a              ; Byte basso indirizzo video
 603+ 7020
 604+ 7020                  ; ---------------------------------------------------------------
 605+ 7020                  ; Disegno bitmap
 606+ 7020                  ;
 607+ 7020                  ; Copia 8 byte consecutivi nella memoria video.
 608+ 7020                  ; Ogni byte rappresenta una scanline da 8 pixel.
 609+ 7020                  ; ---------------------------------------------------------------
 610+ 7020
 611+ 7020 C5               push bc                ; Conserva Row e Col
 612+ 7021
 613+ 7021 06 08            ld   b, 8              ; Numero scanline
 614+ 7023
 615+ 7023              .line_loop:
 616+ 7023
 617+ 7023 7E               ld   a, (hl)           ; Legge scanline bitmap
 618+ 7024 12               ld   (de), a           ; Scrive nella memoria video
 619+ 7025
 620+ 7025 14               inc  d                 ; Scanline successiva
 621+ 7026 23               inc  hl                ; Byte bitmap successivo
 622+ 7027
 623+ 7027 05               dec  b
 624+ 7028 20 F9            jr   nz, .line_loop
 625+ 702A
 626+ 702A C1               pop  bc                ; Ripristina Row e Col
 627+ 702B
 628+ 702B                  ; ---------------------------------------------------------------
 629+ 702B                  ; Calcolo indirizzo attributo
 630+ 702B                  ;
 631+ 702B                  ; Formula:
 632+ 702B                  ;   AttrAddr = $5800 + Row * 32 + Col
 633+ 702B                  ;
 634+ 702B                  ; HL conterrà l'indirizzo della cella attributi.
 635+ 702B                  ; ---------------------------------------------------------------
 636+ 702B
 637+ 702B 26 00            ld   h, 0
 638+ 702D 68               ld   l, b              ; HL = Row
 639+ 702E
 640+ 702E 29               add  hl, hl            ; *2
 641+ 702F 29               add  hl, hl            ; *4
 642+ 7030 29               add  hl, hl            ; *8
 643+ 7031 29               add  hl, hl            ; *16
 644+ 7032 29               add  hl, hl            ; *32
 645+ 7033
 646+ 7033 79               ld   a, c              ; A = Colonna
 647+ 7034
 648+ 7034 85               add  a, l
 649+ 7035 6F               ld   l, a
 650+ 7036
 651+ 7036 30 01            jr   nc, .no_carry
 652+ 7038 24               inc  h
 653+ 7039
 654+ 7039              .no_carry:
 655+ 7039
 656+ 7039                  ; HL = Row * 32 + Col
 657+ 7039
 658+ 7039 11 00 58         ld   de, $5800
 659+ 703C 19               add  hl, de            ; HL = indirizzo attributi
 660+ 703D
 661+ 703D                  ; ---------------------------------------------------------------
 662+ 703D                  ; Recupera il colore originale dallo stack.
 663+ 703D                  ;
 664+ 703D                  ; Layout stack:
 665+ 703D                  ;   HL originale
 666+ 703D                  ;   DE originale (E = colore)
 667+ 703D                  ;   BC originale
 668+ 703D                  ; ---------------------------------------------------------------
 669+ 703D
 670+ 703D C1               pop  bc                ; Recupera HL originale
 671+ 703E D1               pop  de                ; Recupera DE originale
 672+ 703F
 673+ 703F                  ; ---------------------------------------------------------------
 674+ 703F                  ; Scrive l'attributo colore
 675+ 703F                  ; ---------------------------------------------------------------
 676+ 703F
 677+ 703F 7B               ld   a, e              ; A = colore
 678+ 7040 77               ld   (hl), a           ; Scrive nella RAM attributi
 679+ 7041
 680+ 7041                  ; ---------------------------------------------------------------
 681+ 7041                  ; Ripristina HL e BC originali
 682+ 7041                  ; ---------------------------------------------------------------
 683+ 7041
 684+ 7041 C5               push bc
 685+ 7042 E1               pop  hl                ; HL originale
 686+ 7043
 687+ 7043 C1               pop  bc                ; BC originale
 688+ 7044
 689+ 7044 C9               ret
 690+ 7045
 691+ 7045              ; -------------------------------------------------------------------
 692+ 7045              ; RestoreBackgroundCell
 693+ 7045              ;
 694+ 7045              ; Ripristina il contenuto originale di una cella della stanza.
 695+ 7045              ; Viene utilizzata principalmente quando un item viene raccolto:
 696+ 7045              ; invece di lasciare un "buco", la routine ridisegna il tile
 697+ 7045              ; originale presente nella mappa della stanza.
 698+ 7045              ;
 699+ 7045              ; Input:
 700+ 7045              ;   B = Row (3..18)
 701+ 7045              ;   C = Col (0..31)
 702+ 7045              ;
 703+ 7045              ; Utilizza:
 704+ 7045              ;   room_ptr -> struttura dati della stanza corrente
 705+ 7045              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 706+ 7045              ;   DrawTile -> ridisegna il tile selezionato
 707+ 7045              ;
 708+ 7045              ; Tipi di cella:
 709+ 7045              ;   0 = Background
 710+ 7045              ;   1 = Floor
 711+ 7045              ;   2 = Wall
 712+ 7045              ;   3 = Nasty
 713+ 7045              ; -------------------------------------------------------------------
 714+ 7045              RestoreBackgroundCell:
 715+ 7045
 716+ 7045                  ; Salva tutti i registri utilizzati
 717+ 7045 FD E5            push iy
 718+ 7047 C5               push bc
 719+ 7048 D5               push de
 720+ 7049 E5               push hl
 721+ 704A DD E5            push ix
 722+ 704C
 723+ 704C                  ; ---------------------------------------------------------------
 724+ 704C                  ; Conserva Row e Col in IY.
 725+ 704C                  ;
 726+ 704C                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 727+ 704C                  ; BC potrebbe essere modificato.
 728+ 704C                  ; ---------------------------------------------------------------
 729+ 704C C5               push bc
 730+ 704D FD E1            pop  iy                ; IYH = Row, IYL = Col
 731+ 704F
 732+ 704F                  ; ---------------------------------------------------------------
 733+ 704F                  ; Determina quale tipo di cella è presente nella posizione
 734+ 704F                  ; specificata.
 735+ 704F                  ;
 736+ 704F                  ; Input:
 737+ 704F                  ;   B = Row
 738+ 704F                  ;   C = Col
 739+ 704F                  ;
 740+ 704F                  ; Output:
 741+ 704F                  ;   A = tipo cella
 742+ 704F                  ; ---------------------------------------------------------------
 743+ 704F 78               ld   a, b
 744+ 7050
 745+ 7050 CD 59 6A         call GetCellFromUnpacked
 746+ 7053
 747+ 7053                  ; ---------------------------------------------------------------
 748+ 7053                  ; Recupera il puntatore alla stanza corrente.
 749+ 7053                  ;
 750+ 7053                  ; DE = base della struttura stanza
 751+ 7053                  ; ---------------------------------------------------------------
 752+ 7053 ED 5B D8 74      ld   de, (room_ptr)
 753+ 7057
 754+ 7057                  ; ---------------------------------------------------------------
 755+ 7057                  ; Seleziona il tile corretto in base al tipo di cella.
 756+ 7057                  ;
 757+ 7057                  ; A = 0 -> Background
 758+ 7057                  ; A = 1 -> Floor
 759+ 7057                  ; A = 2 -> Wall
 760+ 7057                  ; A = 3 -> Nasty
 761+ 7057                  ; ---------------------------------------------------------------
 762+ 7057
 763+ 7057 B7               or   a
 764+ 7058 20 06            jr   nz, .not_bg
 765+ 705A
 766+ 705A                  ; Background
 767+ 705A 21 A0 00         ld   hl, OFFSET_BG
 768+ 705D 19               add  hl, de
 769+ 705E 18 16            jr   .draw_cell
 770+ 7060
 771+ 7060              .not_bg:
 772+ 7060
 773+ 7060 3D               dec  a
 774+ 7061 20 06            jr   nz, .not_floor
 775+ 7063
 776+ 7063                  ; Floor
 777+ 7063 21 A9 00         ld   hl, OFFSET_FLOOR
 778+ 7066 19               add  hl, de
 779+ 7067 18 0D            jr   .draw_cell
 780+ 7069
 781+ 7069              .not_floor:
 782+ 7069
 783+ 7069 3D               dec  a
 784+ 706A 20 06            jr   nz, .not_wall
 785+ 706C
 786+ 706C                  ; Wall
 787+ 706C 21 B2 00         ld   hl, OFFSET_WALL
 788+ 706F 19               add  hl, de
 789+ 7070 18 04            jr   .draw_cell
 790+ 7072
 791+ 7072              .not_wall:
 792+ 7072
 793+ 7072                  ; Nasty
 794+ 7072 21 BB 00         ld   hl, OFFSET_NASTY
 795+ 7075 19               add  hl, de
 796+ 7076
 797+ 7076              .draw_cell:
 798+ 7076
 799+ 7076                  ; ---------------------------------------------------------------
 800+ 7076                  ; HL punta ora alla grafica del tile da ridisegnare.
 801+ 7076                  ;
 802+ 7076                  ; DrawTile si aspetta:
 803+ 7076                  ;   IX = puntatore tile
 804+ 7076                  ;   B  = Row
 805+ 7076                  ;   C  = Col
 806+ 7076                  ; ---------------------------------------------------------------
 807+ 7076 E5               push hl
 808+ 7077 DD E1            pop  ix
 809+ 7079
 810+ 7079                  ; Ripristina Row e Col salvati in IY
 811+ 7079 FD E5            push iy
 812+ 707B C1               pop  bc
 813+ 707C
 814+ 707C                  ; Disegna il tile originale
 815+ 707C CD 8C 61         call DrawTile
 816+ 707F
 817+ 707F                  ; ---------------------------------------------------------------
 818+ 707F                  ; Ripristina i registri salvati
 819+ 707F                  ; ---------------------------------------------------------------
 820+ 707F DD E1            pop  ix
 821+ 7081 E1               pop  hl
 822+ 7082 D1               pop  de
 823+ 7083 C1               pop  bc
 824+ 7084 FD E1            pop  iy
 825+ 7086
 826+ 7086 C9               ret
 827+ 7087
 828+ 7087              ; -------------------------------------------------------------------
 829+ 7087              ; CheckWillyItemCollision
 830+ 7087              ;
 831+ 7087              ; Verifica se Willy collide con un item utilizzando il controllo
 832+ 7087              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 833+ 7087              ;
 834+ 7087              ; Input:
 835+ 7087              ;   A = ItemX (colonna attributi 0..31)
 836+ 7087              ;   H = ItemY (riga attributi 3..18)
 837+ 7087              ;
 838+ 7087              ; Coordinate item:
 839+ 7087              ;   Ogni item occupa una cella da 8x8 pixel.
 840+ 7087              ;
 841+ 7087              ; Coordinate Willy:
 842+ 7087              ;   Willy occupa un rettangolo di 16x16 pixel.
 843+ 7087              ;
 844+ 7087              ; Output:
 845+ 7087              ;   Carry Set   = collisione rilevata
 846+ 7087              ;   Carry Clear = nessuna collisione
 847+ 7087              ;
 848+ 7087              ; Registri preservati:
 849+ 7087              ;   BC, DE, HL
 850+ 7087              ; -------------------------------------------------------------------
 851+ 7087              CheckWillyItemCollision:
 852+ 7087
 853+ 7087                  ; Salva i registri utilizzati
 854+ 7087 C5               push bc
 855+ 7088 D5               push de
 856+ 7089 E5               push hl
 857+ 708A
 858+ 708A                  ; ---------------------------------------------------------------
 859+ 708A                  ; Calcola il bounding box orizzontale dell'item
 860+ 708A                  ;
 861+ 708A                  ; ItemLeft  = ItemX * 8
 862+ 708A                  ; ItemRight = ItemLeft + 7
 863+ 708A                  ;
 864+ 708A                  ; E = ItemLeft
 865+ 708A                  ; D = ItemRight
 866+ 708A                  ; ---------------------------------------------------------------
 867+ 708A 6F               ld   l, a              ; L = ItemX
 868+ 708B
 869+ 708B 7D               ld   a, l
 870+ 708C 87               add  a, a              ; *2
 871+ 708D 87               add  a, a              ; *4
 872+ 708E 87               add  a, a              ; *8
 873+ 708F
 874+ 708F 5F               ld   e, a              ; E = ItemLeft
 875+ 7090
 876+ 7090 C6 07            add  a, 7
 877+ 7092 57               ld   d, a              ; D = ItemRight
 878+ 7093
 879+ 7093                  ; ---------------------------------------------------------------
 880+ 7093                  ; Recupera la posizione corrente di Willy
 881+ 7093                  ;
 882+ 7093                  ; B = WillyY
 883+ 7093                  ; C = WillyX
 884+ 7093                  ; ---------------------------------------------------------------
 885+ 7093 ED 4B 68 71      ld   bc, (PlayerPos)
 886+ 7097
 887+ 7097                  ; ---------------------------------------------------------------
 888+ 7097                  ; Primo test:
 889+ 7097                  ;
 890+ 7097                  ; WillyLeft <= ItemRight
 891+ 7097                  ;
 892+ 7097                  ; Se Willy è completamente a destra dell'item
 893+ 7097                  ; non può esserci collisione.
 894+ 7097                  ; ---------------------------------------------------------------
 895+ 7097 79               ld   a, c              ; A = WillyLeft
 896+ 7098
 897+ 7098 BA               cp   d                 ; WillyLeft vs ItemRight
 898+ 7099
 899+ 7099 28 04            jr   z, .x_ok
 900+ 709B 38 02            jr   c, .x_ok
 901+ 709D
 902+ 709D 18 29            jr   .no_collision
 903+ 709F
 904+ 709F              .x_ok:
 905+ 709F
 906+ 709F                  ; ---------------------------------------------------------------
 907+ 709F                  ; Secondo test:
 908+ 709F                  ;
 909+ 709F                  ; WillyRight >= ItemLeft
 910+ 709F                  ;
 911+ 709F                  ; WillyRight = WillyX + 7
 912+ 709F                  ; ---------------------------------------------------------------
 913+ 709F C6 07            add  a, 7
 914+ 70A1
 915+ 70A1 BB               cp   e                 ; WillyRight vs ItemLeft
 916+ 70A2
 917+ 70A2 28 04            jr   z, .y_check
 918+ 70A4 30 02            jr   nc, .y_check
 919+ 70A6
 920+ 70A6 18 20            jr   .no_collision
 921+ 70A8
 922+ 70A8              .y_check:
 923+ 70A8
 924+ 70A8                  ; ---------------------------------------------------------------
 925+ 70A8                  ; Recupera ItemY dal valore originale di HL
 926+ 70A8                  ;
 927+ 70A8                  ; H contiene la riga dell'item.
 928+ 70A8                  ; ---------------------------------------------------------------
 929+ 70A8 E1               pop  hl
 930+ 70A9 E5               push hl
 931+ 70AA
 932+ 70AA                  ; ---------------------------------------------------------------
 933+ 70AA                  ; Calcola il bounding box verticale dell'item
 934+ 70AA                  ;
 935+ 70AA                  ; ItemTop    = ItemY * 8
 936+ 70AA                  ; ItemBottom = ItemTop + 7
 937+ 70AA                  ;
 938+ 70AA                  ; E = ItemTop
 939+ 70AA                  ; D = ItemBottom
 940+ 70AA                  ; ---------------------------------------------------------------
 941+ 70AA 7C               ld   a, h
 942+ 70AB
 943+ 70AB 87               add  a, a              ; *2
 944+ 70AC 87               add  a, a              ; *4
 945+ 70AD 87               add  a, a              ; *8
 946+ 70AE
 947+ 70AE 5F               ld   e, a              ; ItemTop
 948+ 70AF
 949+ 70AF C6 07            add  a, 7
 950+ 70B1 57               ld   d, a              ; ItemBottom
 951+ 70B2
 952+ 70B2                  ; ---------------------------------------------------------------
 953+ 70B2                  ; Primo test verticale:
 954+ 70B2                  ;
 955+ 70B2                  ; WillyTop <= ItemBottom
 956+ 70B2                  ; ---------------------------------------------------------------
 957+ 70B2 78               ld   a, b              ; WillyTop
 958+ 70B3
 959+ 70B3 BA               cp   d
 960+ 70B4
 961+ 70B4 28 04            jr   z, .y_ok
 962+ 70B6 38 02            jr   c, .y_ok
 963+ 70B8
 964+ 70B8 18 0E            jr   .no_collision
 965+ 70BA
 966+ 70BA              .y_ok:
 967+ 70BA
 968+ 70BA                  ; ---------------------------------------------------------------
 969+ 70BA                  ; Secondo test verticale:
 970+ 70BA                  ;
 971+ 70BA                  ; WillyBottom >= ItemTop
 972+ 70BA                  ;
 973+ 70BA                  ; WillyBottom = WillyY + 15
 974+ 70BA                  ; ---------------------------------------------------------------
 975+ 70BA C6 0F            add  a, 15
 976+ 70BC
 977+ 70BC BB               cp   e
 978+ 70BD
 979+ 70BD 28 04            jr   z, .collision
 980+ 70BF 30 02            jr   nc, .collision
 981+ 70C1
 982+ 70C1 18 05            jr   .no_collision
 983+ 70C3
 984+ 70C3              .collision:
 985+ 70C3
 986+ 70C3                  ; ---------------------------------------------------------------
 987+ 70C3                  ; Collisione rilevata
 988+ 70C3                  ; ---------------------------------------------------------------
 989+ 70C3 E1               pop  hl
 990+ 70C4 D1               pop  de
 991+ 70C5 C1               pop  bc
 992+ 70C6
 993+ 70C6 37               scf                    ; Carry = 1
 994+ 70C7
 995+ 70C7 C9               ret
 996+ 70C8
 997+ 70C8              .no_collision:
 998+ 70C8
 999+ 70C8                  ; ---------------------------------------------------------------
1000+ 70C8                  ; Nessuna collisione
1001+ 70C8                  ; ---------------------------------------------------------------
1002+ 70C8 E1               pop  hl
1003+ 70C9 D1               pop  de
1004+ 70CA C1               pop  bc
1005+ 70CB
1006+ 70CB B7               or   a                 ; Carry = 0
1007+ 70CC
1008+ 70CC C9               ret
1009+ 70CD
1010+ 70CD              ; -------------------------------------------------------------------
1011+ 70CD              ; CheckRoomItemsCollision
1012+ 70CD              ;
1013+ 70CD              ; Controlla se Willy entra in collisione con uno degli item
1014+ 70CD              ; attivi presenti nella stanza corrente.
1015+ 70CD              ;
1016+ 70CD              ; Per ogni item:
1017+ 70CD              ;   - verifica che appartenga alla stanza corrente
1018+ 70CD              ;   - verifica che non sia già stato raccolto
1019+ 70CD              ;   - esegue il test di collisione con Willy
1020+ 70CD              ;
1021+ 70CD              ; Se l'item viene raccolto:
1022+ 70CD              ;   - imposta il flag "collected"
1023+ 70CD              ;   - rimuove l'item dalla cache items_grid
1024+ 70CD              ;   - incrementa il contatore degli oggetti raccolti
1025+ 70CD              ;   - aggiorna l'HUD
1026+ 70CD              ;   - ripristina il tile di sfondo
1027+ 70CD              ;   - riproduce il suono di raccolta
1028+ 70CD              ;
1029+ 70CD              ; Formato record ItemsTable:
1030+ 70CD              ;   +0 RoomID
1031+ 70CD              ;   +1 X
1032+ 70CD              ;   +2 Y
1033+ 70CD              ;   +3 Color
1034+ 70CD              ;   +4 Collected
1035+ 70CD              ;
1036+ 70CD              ; Fine tabella:
1037+ 70CD              ;   RoomID = $FF
1038+ 70CD              ; -------------------------------------------------------------------
1039+ 70CD              CheckRoomItemsCollision:
1040+ 70CD
1041+ 70CD                  ; Salva i registri utilizzati
1042+ 70CD E5               push hl
1043+ 70CE D5               push de
1044+ 70CF C5               push bc
1045+ 70D0
1046+ 70D0                  ; Inizio scansione della tabella degli item
1047+ 70D0 21 34 6E         ld   hl, ItemsTable
1048+ 70D3
1049+ 70D3              .loop:
1050+ 70D3
1051+ 70D3                  ; ---------------------------------------------------------------
1052+ 70D3                  ; Legge il Room ID dell'item corrente
1053+ 70D3                  ; ---------------------------------------------------------------
1054+ 70D3 7E               ld   a, (hl)
1055+ 70D4
1056+ 70D4                  ; $FF indica fine tabella
1057+ 70D4 FE FF            cp   $FF
1058+ 70D6 28 4D            jr   z, .done
1059+ 70D8
1060+ 70D8                  ; ---------------------------------------------------------------
1061+ 70D8                  ; Verifica se l'item appartiene alla stanza corrente
1062+ 70D8                  ; ---------------------------------------------------------------
1063+ 70D8 57               ld   d, a              ; D = RoomID item
1064+ 70D9
1065+ 70D9 3A 7E 74         ld   a, (current_room)
1066+ 70DC BA               cp   d
1067+ 70DD
1068+ 70DD                  ; Se appartiene a un'altra stanza salta il record
1069+ 70DD 20 3F            jr   nz, .next_item
1070+ 70DF
1071+ 70DF                  ; ---------------------------------------------------------------
1072+ 70DF                  ; Legge coordinate e stato dell'item
1073+ 70DF                  ; ---------------------------------------------------------------
1074+ 70DF
1075+ 70DF 23               inc  hl
1076+ 70E0 4E               ld   c, (hl)           ; C = X
1077+ 70E1
1078+ 70E1 23               inc  hl
1079+ 70E2 46               ld   b, (hl)           ; B = Y
1080+ 70E3
1081+ 70E3 23               inc  hl                ; salta Color
1082+ 70E4
1083+ 70E4 23               inc  hl                ; punta a Collected
1084+ 70E5
1085+ 70E5 7E               ld   a, (hl)
1086+ 70E6
1087+ 70E6                  ; ---------------------------------------------------------------
1088+ 70E6                  ; Item già raccolto?
1089+ 70E6                  ; ---------------------------------------------------------------
1090+ 70E6 B7               or   a
1091+ 70E7 20 39            jr   nz, .next_no_inc
1092+ 70E9
1093+ 70E9                  ; ---------------------------------------------------------------
1094+ 70E9                  ; Test collisione Willy ↔ Item
1095+ 70E9                  ;
1096+ 70E9                  ; Input richiesto:
1097+ 70E9                  ;   A = ItemX
1098+ 70E9                  ;   H = ItemY
1099+ 70E9                  ; ---------------------------------------------------------------
1100+ 70E9 79               ld   a, c
1101+ 70EA
1102+ 70EA E5               push hl                ; salva puntatore al flag Collected
1103+ 70EB
1104+ 70EB 60               ld   h, b
1105+ 70EC
1106+ 70EC CD 87 70         call CheckWillyItemCollision
1107+ 70EF
1108+ 70EF E1               pop  hl
1109+ 70F0
1110+ 70F0                  ; Nessuna collisione
1111+ 70F0 30 30            jr   nc, .next_no_inc
1112+ 70F2
1113+ 70F2                  ; ===============================================================
1114+ 70F2                  ; ITEM RACCOLTO
1115+ 70F2                  ; ===============================================================
1116+ 70F2
1117+ 70F2                  ; ---------------------------------------------------------------
1118+ 70F2                  ; Marca l'item come raccolto
1119+ 70F2                  ; ---------------------------------------------------------------
1120+ 70F2 36 01            ld   (hl), 1
1121+ 70F4
1122+ 70F4                  ; ---------------------------------------------------------------
1123+ 70F4                  ; Rimuove l'item dalla cache items_grid
1124+ 70F4                  ;
1125+ 70F4                  ; Calcolo:
1126+ 70F4                  ;   offset = Row * 32 + Col
1127+ 70F4                  ; ---------------------------------------------------------------
1128+ 70F4 E5               push hl
1129+ 70F5 D5               push de
1130+ 70F6
1131+ 70F6 26 00            ld   h, 0
1132+ 70F8 68               ld   l, b              ; HL = Row
1133+ 70F9
1134+ 70F9 29               add  hl, hl            ; *2
1135+ 70FA 29               add  hl, hl            ; *4
1136+ 70FB 29               add  hl, hl            ; *8
1137+ 70FC 29               add  hl, hl            ; *16
1138+ 70FD 29               add  hl, hl            ; *32
1139+ 70FE
1140+ 70FE 59               ld   e, c
1141+ 70FF 16 00            ld   d, 0
1142+ 7101
1143+ 7101 19               add  hl, de            ; Row*32 + Col
1144+ 7102
1145+ 7102 11 00 90         ld   de, items_grid
1146+ 7105 19               add  hl, de
1147+ 7106
1148+ 7106                  ; La cella non contiene più un item
1149+ 7106 36 00            ld   (hl), 0
1150+ 7108
1151+ 7108 D1               pop  de
1152+ 7109 E1               pop  hl
1153+ 710A
1154+ 710A                  ; ---------------------------------------------------------------
1155+ 710A                  ; Conserva il puntatore all'entry corrente
1156+ 710A                  ; poiché le routine successive possono alterare HL.
1157+ 710A                  ; ---------------------------------------------------------------
1158+ 710A E5               push hl
1159+ 710B
1160+ 710B                  ; ---------------------------------------------------------------
1161+ 710B                  ; Aggiorna il numero di oggetti raccolti
1162+ 710B                  ; ---------------------------------------------------------------
1163+ 710B 3A 72 71         ld   a, (items_collected)
1164+ 710E
1165+ 710E 3C               inc  a
1166+ 710F
1167+ 710F 32 72 71         ld   (items_collected), a
1168+ 7112
1169+ 7112                  ; ---------------------------------------------------------------
1170+ 7112                  ; Aggiorna il contatore visualizzato a schermo
1171+ 7112                  ; ---------------------------------------------------------------
1172+ 7112 CD CB 60         call UpdateItemsCollectedDisplay
1173+ 7115
1174+ 7115                  ; ---------------------------------------------------------------
1175+ 7115                  ; Ripristina il tile originale della stanza
1176+ 7115                  ; eliminando la grafica dell'item.
1177+ 7115                  ;
1178+ 7115                  ; Input:
1179+ 7115                  ;   B = Row
1180+ 7115                  ;   C = Col
1181+ 7115                  ; ---------------------------------------------------------------
1182+ 7115 CD 45 70         call RestoreBackgroundCell
1183+ 7118
1184+ 7118                  ; ---------------------------------------------------------------
1185+ 7118                  ; Riproduce il suono di raccolta
1186+ 7118                  ; ---------------------------------------------------------------
1187+ 7118 CD 29 71         call PlayCollectSound
1188+ 711B
1189+ 711B                  ; Ripristina il puntatore alla tabella
1190+ 711B E1               pop  hl
1191+ 711C
1192+ 711C                  ; Continua con il record successivo
1193+ 711C 18 04            jr   .next_no_inc
1194+ 711E
1195+ 711E              .next_item:
1196+ 711E
1197+ 711E                  ; ---------------------------------------------------------------
1198+ 711E                  ; Salta i campi del record:
1199+ 711E                  ;   X
1200+ 711E                  ;   Y
1201+ 711E                  ;   Color
1202+ 711E                  ;   Collected
1203+ 711E                  ; ---------------------------------------------------------------
1204+ 711E 23               inc  hl
1205+ 711F 23               inc  hl
1206+ 7120 23               inc  hl
1207+ 7121 23               inc  hl
1208+ 7122
1209+ 7122              .next_no_inc:
1210+ 7122
1211+ 7122                  ; ---------------------------------------------------------------
1212+ 7122                  ; Avanza al record successivo.
1213+ 7122                  ;
1214+ 7122                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1215+ 7122                  ; ---------------------------------------------------------------
1216+ 7122 23               inc  hl
1217+ 7123
1218+ 7123 18 AE            jr   .loop
1219+ 7125
1220+ 7125              .done:
1221+ 7125
1222+ 7125                  ; Ripristina i registri
1223+ 7125 C1               pop  bc
1224+ 7126 D1               pop  de
1225+ 7127 E1               pop  hl
1226+ 7128
1227+ 7128 C9               ret
1228+ 7129
1229+ 7129              ; -------------------------------------------------------------------
1230+ 7129              ; PlayCollectSound
1231+ 7129              ;
1232+ 7129              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1233+ 7129              ; dello ZX Spectrum utilizzando il port $FE.
1234+ 7129              ;
1235+ 7129              ; Il suono viene prodotto alternando ON/OFF del bit 4
1236+ 7129              ; (speaker) con un semplice delay software.
1237+ 7129              ;
1238+ 7129              ; Effetto risultante:
1239+ 7129              ;   beep breve tipo "pickup item"
1240+ 7129              ; -------------------------------------------------------------------
1241+ 7129              PlayCollectSound:
1242+ 7129
1243+ 7129                  ; Salva registri utilizzati
1244+ 7129 C5               push bc
1245+ 712A D5               push de
1246+ 712B
1247+ 712B                  ; ---------------------------------------------------------------
1248+ 712B                  ; Numero di cicli del beep (durata complessiva del suono)
1249+ 712B                  ; ---------------------------------------------------------------
1250+ 712B 06 78            ld   b, 120
1251+ 712D
1252+ 712D              .sound_loop:
1253+ 712D
1254+ 712D                  ; ---------------------------------------------------------------
1255+ 712D                  ; SPEAKER ON
1256+ 712D                  ;
1257+ 712D                  ; Legge il colore del bordo corrente e attiva il bit 4
1258+ 712D                  ; per pilotare lo speaker.
1259+ 712D                  ; ---------------------------------------------------------------
1260+ 712D 3A 74 71         ld   a, (room_border_color)
1261+ 7130 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1262+ 7132
1263+ 7132 D3 FE            out  ($fe), a         ; scrive sul port ULA
1264+ 7134
1265+ 7134                  ; ---------------------------------------------------------------
1266+ 7134                  ; Delay (mezzo periodo)
1267+ 7134                  ; Loop software a consumo CPU
1268+ 7134                  ; ---------------------------------------------------------------
1269+ 7134 0E 3C            ld   c, 60
1270+ 7136
1271+ 7136              .d1:
1272+ 7136 0D               dec  c
1273+ 7137 20 FD            jr   nz, .d1
1274+ 7139
1275+ 7139                  ; ---------------------------------------------------------------
1276+ 7139                  ; SPEAKER OFF
1277+ 7139                  ;
1278+ 7139                  ; Mantiene il colore del bordo ma disattiva lo speaker
1279+ 7139                  ; ---------------------------------------------------------------
1280+ 7139 3A 74 71         ld   a, (room_border_color)
1281+ 713C E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1282+ 713E
1283+ 713E D3 FE            out  ($fe), a
1284+ 7140
1285+ 7140                  ; ---------------------------------------------------------------
1286+ 7140                  ; Secondo delay (mezzo periodo)
1287+ 7140                  ; Completa l’onda quadra
1288+ 7140                  ; ---------------------------------------------------------------
1289+ 7140 0E 3C            ld   c, 60
1290+ 7142
1291+ 7142              .d2:
1292+ 7142 0D               dec  c
1293+ 7143 20 FD            jr   nz, .d2
1294+ 7145
1295+ 7145                  ; ---------------------------------------------------------------
1296+ 7145                  ; Ripete fino a completare il numero di cicli
1297+ 7145                  ; ---------------------------------------------------------------
1298+ 7145 10 E6            djnz .sound_loop
1299+ 7147
1300+ 7147                  ; Ripristina registri salvati
1301+ 7147 D1               pop  de
1302+ 7148 C1               pop  bc
1303+ 7149
1304+ 7149 C9               ret
1305+ 714A
1306+ 714A              ; -------------------------------------------------------------------
1307+ 714A              ; CheckActiveItemAtCell
1308+ 714A              ;
1309+ 714A              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1310+ 714A              ; nella cella specificata della griglia items_grid.
1311+ 714A              ;
1312+ 714A              ; Questa routine usa una lookup diretta su una mappa 32x16,
1313+ 714A              ; evitando la scansione della ItemsTable.
1314+ 714A              ;
1315+ 714A              ; Input:
1316+ 714A              ;   B = Colonna (0..31)
1317+ 714A              ;   C = Riga (0..15)
1318+ 714A              ;
1319+ 714A              ; Output:
1320+ 714A              ;   Carry Set   = item presente nella cella
1321+ 714A              ;   Carry Clear = nessun item
1322+ 714A              ;
1323+ 714A              ; Nota:
1324+ 714A              ;   HL NON è restituito valido (commento originale non corretto:
1325+ 714A              ;   la routine non punta a ItemsTable).
1326+ 714A              ; -------------------------------------------------------------------
1327+ 714A              CheckActiveItemAtCell:
1328+ 714A
1329+ 714A                  ; Salva registri usati
1330+ 714A D5               push de
1331+ 714B E5               push hl
1332+ 714C
1333+ 714C                  ; ---------------------------------------------------------------
1334+ 714C                  ; Calcolo indice lineare nella griglia 32x16:
1335+ 714C                  ;
1336+ 714C                  ; offset = Row * 32 + Col
1337+ 714C                  ; ---------------------------------------------------------------
1338+ 714C 26 00            ld   h, 0
1339+ 714E 69               ld   l, c              ; HL = Row
1340+ 714F
1341+ 714F 29               add  hl, hl            ; *2
1342+ 7150 29               add  hl, hl            ; *4
1343+ 7151 29               add  hl, hl            ; *8
1344+ 7152 29               add  hl, hl            ; *16
1345+ 7153 29               add  hl, hl            ; *32
1346+ 7154
1347+ 7154                  ; Aggiunge la colonna
1348+ 7154 58               ld   e, b
1349+ 7155 16 00            ld   d, 0
1350+ 7157 19               add  hl, de            ; HL = Row*32 + Col
1351+ 7158
1352+ 7158                  ; ---------------------------------------------------------------
1353+ 7158                  ; Accesso alla griglia degli item attivi
1354+ 7158                  ; ---------------------------------------------------------------
1355+ 7158 11 00 90         ld   de, items_grid
1356+ 715B 19               add  hl, de            ; HL = address cella
1357+ 715C
1358+ 715C                  ; ---------------------------------------------------------------
1359+ 715C                  ; Controllo presenza item
1360+ 715C                  ;
1361+ 715C                  ; items_grid contiene:
1362+ 715C                  ;   0 = nessun item
1363+ 715C                  ;   >0 = item attivo (colore o flag)
1364+ 715C                  ; ---------------------------------------------------------------
1365+ 715C 7E               ld   a, (hl)
1366+ 715D B7               or   a
1367+ 715E 28 04            jr   z, .not_active
1368+ 7160
1369+ 7160                  ; ---------------------------------------------------------------
1370+ 7160                  ; Item trovato
1371+ 7160                  ; ---------------------------------------------------------------
1372+ 7160 E1               pop  hl
1373+ 7161 D1               pop  de
1374+ 7162
1375+ 7162 37               scf                    ; Carry = 1
1376+ 7163 C9               ret
1377+ 7164
1378+ 7164              .not_active:
1379+ 7164
1380+ 7164                  ; ---------------------------------------------------------------
1381+ 7164                  ; Nessun item nella cella
1382+ 7164                  ; ---------------------------------------------------------------
1383+ 7164 E1               pop  hl
1384+ 7165 D1               pop  de
1385+ 7166
1386+ 7166 B7               or   a                 ; Carry = 0
1387+ 7167 C9               ret
