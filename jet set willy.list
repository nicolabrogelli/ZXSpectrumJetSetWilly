 179+ 8831              ; Audio_PlayCollectSound
 180+ 8831              ;
 181+ 8831              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 8831              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 8831              ; -------------------------------------------------------------------
 184+ 8831              Audio_PlayCollectSound:
 185+ 8831 C5               push bc
 186+ 8832 D5               push de
 187+ 8833
 188+ 8833 06 78            ld   b, 120
 189+ 8835              .sound_loop:
 190+ 8835 3A 51 F4         ld   a, (room_border_color)
 191+ 8838 F6 10            or   $10               ; speaker ON
 192+ 883A D3 FE            out  ($fe), a
 193+ 883C
 194+ 883C 0E 3C            ld   c, 60
 195+ 883E              .d1:
 196+ 883E 0D               dec  c
 197+ 883F 20 FD            jr   nz, .d1
 198+ 8841
 199+ 8841 3A 51 F4         ld   a, (room_border_color)
 200+ 8844 E6 EF            and  $ef              ; speaker OFF
 201+ 8846 D3 FE            out  ($fe), a
 202+ 8848
 203+ 8848 0E 3C            ld   c, 60
 204+ 884A              .d2:
 205+ 884A 0D               dec  c
 206+ 884B 20 FD            jr   nz, .d2
 207+ 884D
 208+ 884D 10 E6            djnz .sound_loop
 209+ 884F
 210+ 884F D1               pop  de
 211+ 8850 C1               pop  bc
 212+ 8851 C9               ret
