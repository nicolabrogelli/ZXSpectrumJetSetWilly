 302+ 5EFA              ; -------------------------------------------------------------------
 303+ 5EFA              ; Cancella uno sprite 8x8 a coordinate pixel (X, Y) ripristinando lo sfondo
 304+ 5EFA              ; Input: C = X, B = Y
 305+ 5EFA              ; -------------------------------------------------------------------
 306+ 5EFA              ErasePixelSprite8x8:
 307+ 5EFA C5               push bc
 308+ 5EFB D5               push de
 309+ 5EFC E5               push hl
 310+ 5EFD
 311+ 5EFD 60               ld   h, b
 312+ 5EFE 69               ld   l, c
 313+ 5EFF CD 0E 5E         call GetScreenAddr ; HL = indirizzo schermo (modifica D ed E)
 314+ 5F02
 315+ 5F02 50               ld   d, b          ; D = Y corrente
 316+ 5F03 79               ld   a, c
 317+ 5F04 E6 F8            and  $f8
 318+ 5F06 5F               ld   e, a          ; E = X del primo byte schermo in pixel
 319+ 5F07
 320+ 5F07 0E 08            ld   c, 8          ; 8 linee
 321+ 5F09              .erase_loop:
 322+ 5F09 7B               ld   a, e
