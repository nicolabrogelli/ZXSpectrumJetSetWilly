  78  7EC1 07               rlca
  79  7EC2 07               rlca                   ; Sposta nei bit 3-5
  80  7EC3 F6 07            or   $07               ; Ink bianco nei bit 0-2
  81  7EC5 32 48 5C         ld   (BORDCR), a
  82  7EC8
  83  7EC8 CD F5 5F         call Gfx_PrintPlayer
  84  7ECB
  85  7ECB              Main_loop:
  86  7ECB              .sync_loop:
  87  7ECB 76               halt
  88  7ECC 2A F6 7A         ld   hl, (counter)
  89  7ECF ED 5B F9 7A      ld   de, (last_frame_counter)
  90  7ED3 B7               or   a
  91  7ED4 ED 52            sbc  hl, de
  92  7ED6 7D               ld   a, l
  93  7ED7 FE 02            cp   2
  94  7ED9 38 F0            jr   c, .sync_loop
  95  7EDB
  96  7EDB 2A F6 7A         ld   hl, (counter)
  97  7EDE 22 F9 7A         ld   (last_frame_counter), hl
  98  7EE1
  99  7EE1 CD 6E 7A         call Audio_UpdateJumpSound    ; Aggiorna l'effetto sonoro del salto
 100  7EE4                  IF ENABLE_MUSIC != 0
 101  7EE4 ~                call Audio_UpdateMusic        ; Aggiorna la musica
 102  7EE4                  ENDIF
 103  7EE4
 104  7EE4                  ; 1. Cancella e disegna i personaggi (back-to-back per minimizzare il flickering)
 105  7EE4 CD 48 60         call Gfx_DeleteCharAtOldPos
 106  7EE7 CD F5 5F         call Gfx_PrintPlayer
 107  7EEA
 108  7EEA CD E8 6F         call Enemy_EraseRoom
 109  7EED CD 1C 70         call Enemy_DrawRoom
 110  7EF0
 111  7EF0                  ; Se l'animazione delle vite è abilitata, aggiorna la visualizzazione delle icone camminanti
 112  7EF0                  IF ENABLE_ANIMATE_LIVES != 0
 113  7EF0 CD 9B 60         call Gfx_PrintWillyLives
 114  7EF3                  ENDIF
 115  7EF3
 116  7EF3
 117  7EF3                  ; 3. Salva le posizioni correnti del player per il prossimo frame
 118  7EF3 ED 4B DC 7A      ld   bc, (PlayerPos)
 119  7EF7 ED 43 DE 7A      ld   (PlayerPosOld), bc
 120  7EFB
 121  7EFB                  ; 4. Aggiorna le posizioni dei personaggi per il prossimo frame
 122  7EFB CD F4 65         call Input_CheckCtrl
 123  7EFE CD 16 65         call MovePlayer
 124  7F01 CD 01 68         call Phys_ApplyGravity
 125  7F04 CD 36 6B         call Phys_ApplyConveyor
 126  7F07 CD 94 72         call Enemy_Update
 127  7F0A CD F4 79         call Items_CheckCollision
 128  7F0D
 129  7F0D                  ; Controlla collisione con Nasties (morte di Willy)
 130  7F0D                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 131  7F0D ~                call Phys_CheckNastyCollision
 132  7F0D ~                jr   c, .willy_dies
 133  7F0D                  ENDIF
 134  7F0D
 135  7F0D                  ; Controlla collisione con guardiani
 136  7F0D CD B5 6A         call CheckCollision
 137  7F10 30 41            jr   nc, .no_collision
 138  7F12
 139  7F12                  ; C'è collisione con un guardiano!
 140  7F12                  ; Controlla se la morte per collisione con i guardiani è abilitata
 141  7F12                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 142  7F12 ~                jr   .willy_dies
 143  7F12                  ELSE
 144  7F12 18 25            jr   .draw_raster_bars ; se disabilitato, disegna le raster bar per debug
 145  7F14                  ENDIF
 146  7F14
 147  7F14              .willy_dies:
 148  7F14                  ; Decrementa le vite e aggiorna la visualizzazione
 149  7F14 21 E9 7A         ld   hl, willy_lives
 150  7F17 7E               ld   a, (hl)
 151  7F18 B7               or   a
 152  7F19 28 01            jr   z, .no_lives_dec
 153  7F1B 35               dec  (hl)
 154  7F1C              .no_lives_dec:
 155  7F1C CD 9B 60         call Gfx_PrintWillyLives
 156  7F1F
 157  7F1F                  ; Gestisci la morte di Willy:
 158  7F1F                  ; 1. Cancella la sprite del player dalla sua posizione attuale a schermo
 159  7F1F CD 48 60         call Gfx_DeleteCharAtOldPos
 160  7F22
 161  7F22                  ; 2. Ripristina la posizione iniziale nella stanza
 162  7F22 CD E1 65         call LoadPositionPlayeinRoom
 163  7F25
 164  7F25                  ; 3. Reimposta la fisica di Willy
 165  7F25 AF               xor  a
 166  7F26 32 EA 7A         ld   (velocity_y), a
 167  7F29 32 EC 7A         ld   (jump_pressed), a
 168  7F2C 32 F0 7A         ld   (jump_frame), a
 169  7F2F 32 EF 7A         ld   (jump_dir), a
 170  7F32 3E 01            ld   a, 1
 171  7F34 32 EB 7A         ld   (on_ground), a
 172  7F37 18 1A            jr   .no_collision ; Salta il disegno delle raster bar poiché Willy è morto
 173  7F39
 174  7F39              .draw_raster_bars:
 175  7F39                  ; Collisione attiva: disegna le raster bar nel bordo
 176  7F39 3A F6 7A         ld   a, (counter)
 177  7F3C E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 178  7F3E 06 1E            ld   b, 30             ; Numero di righe della barra raster
 179  7F40              .raster_loop:
 180  7F40 D3 FE            out  ($fe), a
 181  7F42 3C               inc  a
 182  7F43 E6 07            and  7
 183  7F45 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 184  7F47              .delay:
 185  7F47 0D               dec  c
 186  7F48 20 FD            jr   nz, .delay
 187  7F4A 10 F4            djnz .raster_loop
 188  7F4C
 189  7F4C                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 190  7F4C 3A E8 7A         ld   a, (room_border_color)
 191  7F4F D3 FE            out  ($fe), a
 192  7F51 18 05            jr   .no_collision_change
 193  7F53
 194  7F53              .no_collision:
 195  7F53                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 196  7F53 3A E8 7A         ld   a, (room_border_color)
 197  7F56 D3 FE            out  ($fe), a
 198  7F58
 199  7F58              .no_collision_change:
 200  7F58 C3 CB 7E         jp   Main_loop
