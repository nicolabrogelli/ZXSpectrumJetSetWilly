1212+ 6E7E              ; -------------------------------------------------------------------
1213+ 6E7E              ; GetRampY
1214+ 6E7E              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1215+ 6E7E              ; Input: C = PlayerX
1216+ 6E7E              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1217+ 6E7E              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1218+ 6E7E              ; -------------------------------------------------------------------
1219+ 6E7E              GetRampY:
1220+ 6E7E 3A 51 E9         ld   a, (ramp_len)
1221+ 6E81 B7               or   a
1222+ 6E82 C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1223+ 6E83
1224+ 6E83 3A 50 E9         ld   a, (ramp_dir)
1225+ 6E86 B7               or   a
1226+ 6E87 28 5C            jr   z, .dir_left
1227+ 6E89
1228+ 6E89              .dir_right:
1229+ 6E89                  ; Rampa sale a destra (up-right)
1230+ 6E89 3A 53 E9         ld   a, (ramp_col)
1231+ 6E8C 87               add  a, a              ; *2
1232+ 6E8D 87               add  a, a              ; *4
1233+ 6E8E 87               add  a, a              ; *8 (X start in pixel)
1234+ 6E8F 5F               ld   e, a              ; E = X_left
1235+ 6E90
1236+ 6E90 3A 51 E9         ld   a, (ramp_len)
1237+ 6E93 87               add  a, a              ; *2
1238+ 6E94 87               add  a, a              ; *4
1239+ 6E95 87               add  a, a              ; *8
1240+ 6E96 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1241+ 6E97 67               ld   h, a              ; H = X_right_boundary
1242+ 6E98 38 10            jr   c, .no_right_bound_check_right
1243+ 6E9A
1244+ 6E9A 79               ld   a, c              ; A = PlayerX
1245+ 6E9B BB               cp   e
1246+ 6E9C DA 4B 6F         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1247+ 6E9F
1248+ 6E9F BC               cp   h
1249+ 6EA0 38 1E            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1250+ 6EA2
1251+ 6EA2                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1252+ 6EA2 94               sub  h                 ; A = PlayerX - X_right_boundary
1253+ 6EA3 FE 08            cp   8
1254+ 6EA5 D2 4B 6F         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1255+ 6EA8 18 07            jr   .on_platform_right
1256+ 6EAA
1257+ 6EAA              .no_right_bound_check_right:
1258+ 6EAA 79               ld   a, c              ; A = PlayerX
1259+ 6EAB BB               cp   e
1260+ 6EAC DA 4B 6F         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1261+ 6EAF 18 0F            jr   .on_ramp_slope    ; Se >= X_left, è sicuramente sulla pendenza rampa (non può superare 256)
1262+ 6EB1
1263+ 6EB1              .on_platform_right:
1264+ 6EB1                  ; Piattaforma adiacente! Restituisci PlayerY = (ramp_row - ramp_len + 1) * 8 - 16
1265+ 6EB1 3A 52 E9         ld   a, (ramp_row)
1266+ 6EB4 21 51 E9         ld   hl, ramp_len
1267+ 6EB7 96               sub  (hl)
1268+ 6EB8 3C               inc  a                 ; A = Row
1269+ 6EB9 87               add  a, a              ; *2
1270+ 6EBA 87               add  a, a              ; *4
1271+ 6EBB 87               add  a, a              ; *8
1272+ 6EBC D6 10            sub  16                ; A = Row * 8 - 16
1273+ 6EBE 37               scf                    ; Set carry (dentro rampa/piattaforma)
1274+ 6EBF C9               ret
1275+ 6EC0
1276+ 6EC0              .on_ramp_slope:
1277+ 6EC0 3A 52 E9         ld   a, (ramp_row)
1278+ 6EC3 87               add  a, a              ; *2
1279+ 6EC4 87               add  a, a              ; *4
1280+ 6EC5 87               add  a, a              ; *8
1281+ 6EC6 D6 10            sub  16                ; A = ramp_row * 8 - 16
1282+ 6EC8 83               add  a, e              ; A = ramp_row * 8 - 16 + X_left
1283+ 6EC9 91               sub  c                 ; A = A - PlayerX
1284+ 6ECA 57               ld   d, a              ; D = calculated Y
1285+ 6ECB
1286+ 6ECB                  ; H = platform_Y + 16 (confronto sicuro con offset +16)
1287+ 6ECB 3A 52 E9         ld   a, (ramp_row)
1288+ 6ECE 21 51 E9         ld   hl, ramp_len
1289+ 6ED1 96               sub  (hl)
1290+ 6ED2 3C               inc  a                 ; A = Row
1291+ 6ED3 87               add  a, a              ; *2
1292+ 6ED4 87               add  a, a              ; *4
1293+ 6ED5 87               add  a, a              ; *8
1294+ 6ED6 67               ld   h, a              ; H = platform_Y + 16
1295+ 6ED7
1296+ 6ED7 7A               ld   a, d              ; A = calculated Y
1297+ 6ED8 C6 10            add  a, 16             ; A = calculated Y + 16
1298+ 6EDA BC               cp   h                 ; Compare (calculated Y + 16) con (platform_Y + 16)
1299+ 6EDB 30 05            jr   nc, .no_clamp     ; Se calculated Y >= platform_Y, non limitare
1300+ 6EDD
1301+ 6EDD                  ; Altrimenti, limita a platform_Y
1302+ 6EDD 7C               ld   a, h
1303+ 6EDE D6 10            sub  16                ; A = platform_Y
1304+ 6EE0 37               scf
1305+ 6EE1 C9               ret
