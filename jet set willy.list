  63+ 6F83              ; DetermineCurrentRoomID
  64+ 6F83              ;
  65+ 6F83              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 6F83              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 6F83              ;
  68+ 6F83              ; Se viene trovata una corrispondenza:
  69+ 6F83              ;   A = ID della stanza
  70+ 6F83              ;   current_room = A
  71+ 6F83              ;
  72+ 6F83              ; Mappatura:
  73+ 6F83              ;    0 = The Off Licence
  74+ 6F83              ;    1 = The Bridge
  75+ 6F83              ;    2 = Under The Mega Tree
  76+ 6F83              ;    3 = At The Foot Of The Mega Tree
  77+ 6F83              ;    4 = The Drive
  78+ 6F83              ;    5 = The Security Guard
  79+ 6F83              ;    6 = Entrance To Hades
  80+ 6F83              ;    7 = Cuckoo's Nest
  81+ 6F83              ;    8 = Inside The Mega Trunk
  82+ 6F83              ;    9 = On A Branch Over The Drive
  83+ 6F83              ;   10 = The Front Door
  84+ 6F83              ;   11 = The Hall
  85+ 6F83              ;   12 = Tree Top
  86+ 6F83              ;   33 = The Bathroom
  87+ 6F83              ;   35 = Master Bedroom
  88+ 6F83              ;
  89+ 6F83              ; Se nessuna stanza corrisponde viene impostato:
  90+ 6F83              ;   current_room = 0
  91+ 6F83              ; -------------------------------------------------------------------
