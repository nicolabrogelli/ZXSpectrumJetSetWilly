1090+ 6CB4              ; -------------------------------------------------------------------
1091+ 6CB4              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1092+ 6CB4              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1093+ 6CB4              ; -------------------------------------------------------------------
1094+ 6CB4              UnpackRoomLayout:
1095+ 6CB4 E5               push hl
1096+ 6CB5 D5               push de
1097+ 6CB6 C5               push bc
1098+ 6CB7
1099+ 6CB7 2A 55 7E         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1100+ 6CBA 11 FB 7B         ld   de, unpacked_layout ; DE = buffer RAM
1101+ 6CBD 06 80            ld   b, 128             ; 128 byte
1102+ 6CBF              .byte_loop:
1103+ 6CBF 7E               ld   a, (hl)            ; Leggi byte compresso
1104+ 6CC0 23               inc  hl
1105+ 6CC1
1106+ 6CC1 4F               ld   c, a               ; C = salvataggio
1107+ 6CC2
1108+ 6CC2                  ; Cella 0: bit 7-6
1109+ 6CC2 07               rlca
1110+ 6CC3 07               rlca
1111+ 6CC4 E6 03            and  3
1112+ 6CC6 12               ld   (de), a
1113+ 6CC7 13               inc  de
1114+ 6CC8
1115+ 6CC8                  ; Cella 1: bit 5-4
1116+ 6CC8 79               ld   a, c
1117+ 6CC9 07               rlca
1118+ 6CCA 07               rlca
1119+ 6CCB 07               rlca
1120+ 6CCC 07               rlca
1121+ 6CCD E6 03            and  3
1122+ 6CCF 12               ld   (de), a
1123+ 6CD0 13               inc  de
1124+ 6CD1
1125+ 6CD1                  ; Cella 2: bit 3-2
1126+ 6CD1 79               ld   a, c
1127+ 6CD2 0F               rrca
1128+ 6CD3 0F               rrca
1129+ 6CD4 E6 03            and  3
1130+ 6CD6 12               ld   (de), a
1131+ 6CD7 13               inc  de
1132+ 6CD8
1133+ 6CD8                  ; Cella 3: bit 1-0
1134+ 6CD8 79               ld   a, c
1135+ 6CD9 E6 03            and  3
1136+ 6CDB 12               ld   (de), a
1137+ 6CDC 13               inc  de
1138+ 6CDD
1139+ 6CDD 10 E0            djnz .byte_loop
1140+ 6CDF
1141+ 6CDF C1               pop  bc
1142+ 6CE0 D1               pop  de
1143+ 6CE1 E1               pop  hl
1144+ 6CE2 C9               ret
1145+ 6CE3
1146+ 6CE3              ; -------------------------------------------------------------------
1147+ 6CE3              ; Legge il tipo di cella dal buffer decompresso in RAM
1148+ 6CE3              ; Input: A = Row (0..15), C = Col (0..31)
1149+ 6CE3              ; Output: A = tipo di cella (0..3)
1150+ 6CE3              ; Preserva tutti gli altri registri.
1151+ 6CE3              ; -------------------------------------------------------------------
1152+ 6CE3              GetCellFromUnpacked:
1153+ 6CE3 E5               push hl
1154+ 6CE4 D5               push de
1155+ 6CE5
1156+ 6CE5 6F               ld   l, a
1157+ 6CE6 26 00            ld   h, 0
1158+ 6CE8 29               add  hl, hl
1159+ 6CE9 29               add  hl, hl
1160+ 6CEA 29               add  hl, hl
1161+ 6CEB 29               add  hl, hl
1162+ 6CEC 29               add  hl, hl            ; HL = Row * 32
1163+ 6CED 59               ld   e, c
1164+ 6CEE 16 00            ld   d, 0
1165+ 6CF0 19               add  hl, de            ; HL = Row * 32 + Col
1166+ 6CF1 11 FB 7B         ld   de, unpacked_layout
1167+ 6CF4 19               add  hl, de
1168+ 6CF5 7E               ld   a, (hl)           ; A = cell type
1169+ 6CF6
1170+ 6CF6 D1               pop  de
1171+ 6CF7 E1               pop  hl
1172+ 6CF8 C9               ret
