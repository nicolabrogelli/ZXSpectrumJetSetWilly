 277+ 6D44              ; Verifica la collisione tra player e nemico (bounding box a livello di pixel)
 278+ 6D44              ; Output: Carry flag impostato se collisione, altrimenti resettato
 279+ 6D44              ; -------------------------------------------------------------------
 280+ 6D44              CheckCollision:
 281+ 6D44 E5               push hl
 282+ 6D45 D5               push de
 283+ 6D46 C5               push bc
 284+ 6D47 DD E5            push ix
 285+ 6D49
 286+ 6D49 DD 21 1C 6E      ld   ix, ActiveEnemies
 287+ 6D4D 06 04            ld   b, 4              ; 4 slot
 288+ 6D4F              .loop:
 289+ 6D4F DD 7E 00         ld   a, (ix+0)         ; Flags
 290+ 6D52 E6 80            and  $80               ; Active?
 291+ 6D54 28 1F            jr   z, .next
