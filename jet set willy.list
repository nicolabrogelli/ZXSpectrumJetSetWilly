  72+ 8881 ~            ; Audio_UpdateMusic
  73+ 8881 ~            ;
  74+ 8881 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8881 ~            ; Viene chiamata a ogni frame.
  76+ 8881 ~            ; -------------------------------------------------------------------
  77+ 8881 ~            Audio_UpdateMusic:
  78+ 8881 ~                push af
  79+ 8881 ~                push bc
  80+ 8881 ~                push de
  81+ 8881 ~                push hl
  82+ 8881 ~
  83+ 8881 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8881 ~                ld   a, (Audio_jump_sound_note)
  85+ 8881 ~                cp   18
  86+ 8881 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8881 ~
  88+ 8881 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8881 ~                ld   a, (Audio_music_frame_counter)
  90+ 8881 ~                dec  a
  91+ 8881 ~                ld   (Audio_music_frame_counter), a
  92+ 8881 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8881 ~
  94+ 8881 ~                ; Altrimenti carica la nota successiva
  95+ 8881 ~                ld   a, (Audio_music_note_idx)
  96+ 8881 ~                inc  a
  97+ 8881 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8881 ~                jr   c, .no_wrap
  99+ 8881 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8881 ~            .no_wrap:
 101+ 8881 ~                ld   (Audio_music_note_idx), a
 102+ 8881 ~
 103+ 8881 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8881 ~                ld   e, a
 105+ 8881 ~                ld   d, 0
 106+ 8881 ~                ld   hl, Audio_MusicSheet
 107+ 8881 ~                add  hl, de
 108+ 8881 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8881 ~
 110+ 8881 ~                ; Leggi durata (secondo byte)
 111+ 8881 ~                inc  hl
 112+ 8881 ~                ld   a, (hl)
 113+ 8881 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8881 ~                jr   nz, .dur_ok
 115+ 8881 ~                ld   a, 1
 116+ 8881 ~            .dur_ok:
 117+ 8881 ~                ld   (Audio_music_frame_counter), a
 118+ 8881 ~
 119+ 8881 ~            .play_current_note:
 120+ 8881 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8881 ~                ld   a, (Audio_music_note_idx)
 122+ 8881 ~                ld   e, a
 123+ 8881 ~                ld   d, 0
 124+ 8881 ~                ld   hl, Audio_MusicSheet
 125+ 8881 ~                add  hl, de
 126+ 8881 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8881 ~                ld   a, (hl)                  ; A = delay
 128+ 8881 ~                or   a
 129+ 8881 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8881 ~
 131+ 8881 ~                ; Suona la nota: 2 cicli
 132+ 8881 ~                ld   d, a                     ; D = delay
 133+ 8881 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8881 ~            .note_loop:
 135+ 8881 ~                ; Speaker ON
 136+ 8881 ~                ld   a, (room_border_color)
 137+ 8881 ~                or   $10
 138+ 8881 ~                out  ($fe), a
 139+ 8881 ~                ld   c, d
 140+ 8881 ~            .d1:
 141+ 8881 ~                push af
 142+ 8881 ~                pop  af
 143+ 8881 ~                dec  c
 144+ 8881 ~                jr   nz, .d1
 145+ 8881 ~
 146+ 8881 ~                ; Speaker OFF
 147+ 8881 ~                ld   a, (room_border_color)
 148+ 8881 ~                and  $ef
 149+ 8881 ~                out  ($fe), a
 150+ 8881 ~                ld   c, d
 151+ 8881 ~            .d2:
 152+ 8881 ~                push af
 153+ 8881 ~                pop  af
 154+ 8881 ~                dec  c
 155+ 8881 ~                jr   nz, .d2
 156+ 8881 ~
 157+ 8881 ~                djnz .note_loop
 158+ 8881 ~
 159+ 8881 ~            .done:
 160+ 8881 ~                pop  hl
 161+ 8881 ~                pop  de
 162+ 8881 ~                pop  bc
 163+ 8881 ~                pop  af
 164+ 8881 ~                ret
 165+ 8881 ~
 166+ 8881 ~            Audio_MusicSheet:
 167+ 8881 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8881 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8881 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8881 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8881 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8881 ~                db 90, 10, 107, 20, 68, 65
 173+ 8881                  ELSE
 174+ 8881              Audio_UpdateMusic:
 175+ 8881 C9               ret
 176+ 8882                  ENDIF
