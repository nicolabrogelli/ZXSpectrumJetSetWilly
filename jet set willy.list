  96+ 742B              ; Mappatura:
  97+ 742B              ;    0 = The Off Licence
  98+ 742B              ;    1 = The Bridge
  99+ 742B              ;    2 = Under The Mega Tree
 100+ 742B              ;    3 = Gfx_At The Foot Of The Mega Tree
 101+ 742B              ;    4 = The Drive
 102+ 742B              ;    5 = The Security Guard
 103+ 742B              ;    6 = Entrance To Hades
 104+ 742B              ;    7 = Cuckoo's Nest
 105+ 742B              ;    8 = Inside The Mega Trunk
