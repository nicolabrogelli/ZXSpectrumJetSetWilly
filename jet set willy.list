 917+ 6AFB              ; -------------------------------------------------------------------
 918+ 6AFB              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 919+ 6AFB              ; Input: C = X, B = Y
 920+ 6AFB              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 921+ 6AFB              ; -------------------------------------------------------------------
 922+ 6AFB              CheckWallCell:
 923+ 6AFB E5               push hl
 924+ 6AFC D5               push de
 925+ 6AFD C5               push bc
 926+ 6AFE
 927+ 6AFE                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 928+ 6AFE 78               ld   a, b
 929+ 6AFF FE 80            cp   128
 930+ 6B01 30 1F            jr   nc, .not_wall
 931+ 6B03
 932+ 6B03                  ; 2. Calcola riga di layout: r = Y / 8
 933+ 6B03 CB 3F            srl  a
 934+ 6B05 CB 3F            srl  a
 935+ 6B07 CB 3F            srl  a                 ; A = r (0..15)
 936+ 6B09
 937+ 6B09                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 938+ 6B09 5F               ld   e, a              ; E = r (Row)
 939+ 6B0A 79               ld   a, c
 940+ 6B0B CB 3F            srl  a
 941+ 6B0D CB 3F            srl  a
 942+ 6B0F CB 3F            srl  a                 ; A = c (0..31)
 943+ 6B11 4F               ld   c, a              ; C = c (Col)
 944+ 6B12
 945+ 6B12                  ; Se la cella è sulla rampa, non considerarla un muro!
 946+ 6B12 53               ld   d, e              ; D = Row
 947+ 6B13 59               ld   e, c              ; E = Col
 948+ 6B14 CD 80 6A         call IsCellOnRamp
 949+ 6B17 38 09            jr   c, .not_wall
 950+ 6B19
 951+ 6B19 7A               ld   a, d              ; A = Row
 952+ 6B1A 4B               ld   c, e              ; C = Col
 953+ 6B1B CD 7B 6B         call GetCellFromUnpacked ; A = cell type
 954+ 6B1E
 955+ 6B1E                  ; Controlla se è Wall (2)
 956+ 6B1E FE 02            cp   2
 957+ 6B20 28 05            jr   z, .is_wall
 958+ 6B22
 959+ 6B22              .not_wall:
 960+ 6B22 C1               pop  bc
 961+ 6B23 D1               pop  de
 962+ 6B24 E1               pop  hl
