   6+ 6516              ; MovePlayer
   7+ 6516              ;
   8+ 6516              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6516              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6516              ; con i muri.
  11+ 6516              ;
  12+ 6516              ; Input:
  13+ 6516              ;   D = stato dei controlli (bitfield)
  14+ 6516              ;
  15+ 6516              ; Strutture utilizzate:
  16+ 6516              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6516              ;   player_speed    -> velocità orizzontale
  18+ 6516              ;   flags           -> flag di stato input
  19+ 6516              ;
  20+ 6516              ; Bit controlli:
  21+ 6516              ;   bit 0 = sinistra
  22+ 6516              ;   bit 1 = destra
  23+ 6516              ;
  24+ 6516              ; Nota:
  25+ 6516              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6516              ;   ignorato per tutta la durata del salto.
  27+ 6516              ;
  28+ 6516              ; Output:
  29+ 6516              ;   aggiorna PlayerPos e body_state
  30+ 6516              ; -------------------------------------------------------------------
  31+ 6516              MovePlayer:
  32+ 6516
  33+ 6516                  ; ---------------------------------------------------------------
  34+ 6516                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6516                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6516                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6516                  ; ---------------------------------------------------------------
  38+ 6516 3A EB 7A         ld   a, (on_ground)
  39+ 6519 B7               or   a
  40+ 651A 20 1A            jr   nz, .on_ground_check
  41+ 651C
  42+ 651C 3A EF 7A         ld   a, (jump_dir)
  43+ 651F B7               or   a
  44+ 6520 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6521
  46+ 6521                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6521 DD 21 E4 7A      ld   ix, flags
  48+ 6525 DD CB 00 86      res  $00, (ix)
  49+ 6529
  50+ 6529 ED 4B DC 7A      ld   bc, (PlayerPos)
  51+ 652D FE 01            cp   1
  52+ 652F 28 1D            jr   z, movePlayer_left
  53+ 6531 FE 02            cp   2
  54+ 6533 28 52            jr   z, movePlayer_right
  55+ 6535 C9               ret
  56+ 6536
  57+ 6536              .on_ground_check:
  58+ 6536                  ; ---------------------------------------------------------------
  59+ 6536                  ; Se siamo a terra, muoviti solo se c'è input (bit 0 di flags impostato)
  60+ 6536                  ; ---------------------------------------------------------------
  61+ 6536 DD 21 E4 7A      ld   ix, flags
