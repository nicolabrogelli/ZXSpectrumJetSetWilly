 485  8B7D 32 4C F7         ld   (coyote_timer), a
 486  8B80 32 4F F7         ld   (jump_frame), a
 487  8B83 32 4E F7         ld   (jump_dir), a
 488  8B86 32 40 F7         ld   (body_state), a
 489  8B89 32 53 F7         ld   (w_warp_state), a
 490  8B8C 32 56 F7         ld   (w_key_prev), a
 491  8B8F 32 57 F7         ld   (enter_key_prev), a
 492  8B92 32 43 F7         ld   (collision_active), a
 493  8B95 32 42 F7         ld   (flags), a
 494  8B98 32 3B FB         ld   (ramp_entry_guard), a
 495  8B9B 32 46 FB         ld   (willy_on_ramp), a
 496  8B9E 32 45 FB         ld   (willy_needs_redraw), a
 497  8BA1 3E FF            ld   a, $ff
 498  8BA3 32 58 F7         ld   (digit_key_prev), a
 499  8BA6 32 40 FB         ld   (player_drawn_pos+1), a
 500  8BA9 32 41 FB         ld   (player_old_dir), a
 501  8BAC 32 42 FB         ld   (player_old_body), a
 502  8BAF 3E 01            ld   a, 1
 503  8BB1 32 51 F7         ld   (q_prev), a
 504  8BB4 32 52 F7         ld   (a_prev), a
 505  8BB7 32 49 F7         ld   (on_ground), a
 506  8BBA 32 43 FB         ld   (enemy_was_updated), a
 507  8BBD
 508  8BBD                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 509  8BBD 3E 00            ld   a, RESPAWN_SAFETY_TIME
 510  8BBF 32 44 FB         ld   (willy_safety_timer), a
 511  8BC2
 512  8BC2                  ; - Ripristina lo stato audio
 513  8BC2 3E 12            ld   a, 18
 514  8BC4 32 4D FB         ld   (Audio_jump_sound_note), a
 515  8BC7 AF               xor  a
 516  8BC8 32 4E FB         ld   (Audio_jump_sound_timer), a
 517  8BCB                  IF ENABLE_MUSIC != 0
 518  8BCB 32 4F FB         ld   (Audio_music_note_idx), a
 519  8BCE 3E 01            ld   a, 1
 520  8BD0 32 50 FB         ld   (Audio_music_frame_counter), a
 521  8BD3                  ENDIF
 522  8BD3
 523  8BD3                  ; - Riposiziona Willy nel punto di ingresso dell'ultima stanza raggiunta
 524  8BD3 CD 7D 82         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 525  8BD6 21 C1 FA         ld   hl, room_entry_positions
 526  8BD9 5F               ld   e, a
 527  8BDA 16 00            ld   d, 0
 528  8BDC 19               add  hl, de
 529  8BDD 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 530  8BDE 4E               ld   c, (hl)                   ; C = X ingresso
 531  8BDF 23               inc  hl
 532  8BE0 46               ld   b, (hl)                   ; B = Y ingresso
 533  8BE1 ED 43 3A F7      ld   (PlayerPos), bc           ; Imposta le coordinate al punto di ingresso
 534  8BE5 ED 43 3C F7      ld   (PlayerPosOld), bc
 535  8BE9
 536  8BE9 3E 01            ld   a, 1
 537  8BEB 32 C0 FA         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 538  8BEE
 539  8BEE                  ; - Cancella lo schermo a nero prima del caricamento
 540  8BEE AF               xor  a
 541  8BEF D3 FE            out  ($fe), a
 542  8BF1 21 8D 5C         ld   hl, ATTR_P
 543  8BF4 77               ld   (hl), a
 544  8BF5 CD AF 0D         call CLS
 545  8BF8 36 07            ld   (hl), $07
 546  8BFA 3E 07            ld   a, $07
 547  8BFC 32 8F 5C         ld   (ATTR_T), a
 548  8BFF
 549  8BFF                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 550  8BFF C3 5E 89         jp   LoadRoomAndRestart
 551  8C02
 552  8C02              ; -------------------------------------------------------------------
 553  8C02              ; TriggerVictory
 554  8C02              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 555  8C02              ; - Pulisce gli elementi di gioco della stanza.
 556  8C02              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 557  8C02              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 558  8C02              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 559  8C02              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 560  8C02              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 561  8C02              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 562  8C02              ; -------------------------------------------------------------------
 563  8C02              TriggerVictory:
 564  8C02                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 565  8C02 CD 15 66         call Gfx_DrawVictoryScreen
 566  8C05
 567  8C05                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 568  8C05              .wait_keys_release:
 569  8C05 76               halt
 570  8C06                  ; Controlla tasto Y (Porta $DF, bit 4)
 571  8C06 01 FE DF         ld   bc, $dffe
 572  8C09 ED 78            in   a, (c)
 573  8C0B CB 67            bit  4, a
 574  8C0D 28 F6            jr   z, .wait_keys_release
 575  8C0F
 576  8C0F                  ; Controlla tasto N (Porta $7F, bit 3)
 577  8C0F 01 FE 7F         ld   bc, $7ffe
 578  8C12 ED 78            in   a, (c)
 579  8C14 CB 5F            bit  3, a
 580  8C16 28 ED            jr   z, .wait_keys_release
 581  8C18
 582  8C18                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 583  8C18 01 FE BF         ld   bc, $bffe
 584  8C1B ED 78            in   a, (c)
 585  8C1D CB 47            bit  0, a
 586  8C1F 28 E4            jr   z, .wait_keys_release
 587  8C21
 588  8C21                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 589  8C21 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 590  8C23              .wait_choice_loop:
 591  8C23 76               halt
 592  8C24
 593  8C24                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 594  8C24 0C               inc  c
 595  8C25 79               ld   a, c
 596  8C26 CB 3F            srl  a
 597  8C28 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 598  8C2A E6 07            and  7
 599  8C2C 5F               ld   e, a
 600  8C2D 16 00            ld   d, 0
 601  8C2F 21 F4 64         ld   hl, victory_color_table
 602  8C32 19               add  hl, de
 603  8C33 7E               ld   a, (hl)               ; A = nuovo colore attributo
 604  8C34 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 605  8C37 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 606  8C39              .color_cycle_loop:
 607  8C39 77               ld   (hl), a
 608  8C3A 23               inc  hl
 609  8C3B 10 FC            djnz .color_cycle_loop
 610  8C3D
 611  8C3D                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 612  8C3D 01 FE DF         ld   bc, $dffe
 613  8C40 ED 78            in   a, (c)
 614  8C42 CB 67            bit  4, a
 615  8C44 28 2A            jr   z, .play_again_chosen
 616  8C46
 617  8C46                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 618  8C46 01 FE 7F         ld   bc, $7ffe
 619  8C49 ED 78            in   a, (c)
 620  8C4B CB 5F            bit  3, a
 621  8C4D 28 0B            jr   z, .quit_chosen
 622  8C4F
 623  8C4F                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 624  8C4F 01 FE BF         ld   bc, $bffe
 625  8C52 ED 78            in   a, (c)
 626  8C54 CB 47            bit  0, a
 627  8C56 28 02            jr   z, .quit_chosen
 628  8C58
 629  8C58 18 C9            jr   .wait_choice_loop
 630  8C5A
 631  8C5A              .quit_chosen:
 632  8C5A                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 633  8C5A              .wait_quit_release:
 634  8C5A 76               halt
 635  8C5B 01 FE 7F         ld   bc, $7ffe
 636  8C5E ED 78            in   a, (c)
 637  8C60 CB 5F            bit  3, a
 638  8C62 28 F6            jr   z, .wait_quit_release
 639  8C64 01 FE BF         ld   bc, $bffe
 640  8C67 ED 78            in   a, (c)
 641  8C69 CB 47            bit  0, a
 642  8C6B 28 ED            jr   z, .wait_quit_release
 643  8C6D
 644  8C6D                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 645  8C6D C3 82 8A         jp   ShowTitleScreen
 646  8C70
 647  8C70              .play_again_chosen:
 648  8C70                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 649  8C70              .wait_play_again_release:
 650  8C70 76               halt
 651  8C71 01 FE DF         ld   bc, $dffe
 652  8C74 ED 78            in   a, (c)
 653  8C76 CB 67            bit  4, a
 654  8C78 28 F6            jr   z, .wait_play_again_release
 655  8C7A
 656  8C7A                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 657  8C7A CD 3A 8D         call ResetFullGameState
 658  8C7D C3 5E 89         jp   LoadRoomAndRestart
 659  8C80
 660  8C80              ; -------------------------------------------------------------------
 661  8C80              ; CheckVictoryCondition
 662  8C80              ; Verifica se si verificano contemporaneamente tutte le 3 condizioni di vittoria:
 663  8C80              ; 1. Willy ha raccolto tutti gli oggetti collezionabili del gioco (tutti i flag in ItemsTable = 1);
 664  8C80              ; 2. Willy si trova nella stanza Master Bedroom;
 665  8C80              ; 3. Willy collide con un oggetto/tag di tipo Conveyor in quella stanza.
 666  8C80              ;
 667  8C80              ; Output:
 668  8C80              ;   Carry Flag = 1 se la vittoria è attivata
 669  8C80              ;   Carry Flag = 0 altrimenti
 670  8C80              ; -------------------------------------------------------------------
 671  8C80              CheckVictoryCondition:
 672  8C80 C5               push bc
 673  8C81 D5               push de
 674  8C82 E5               push hl
 675  8C83
 676  8C83                  ; 1. Condizione: tutti gli item raccolti?
 677  8C83 CD 9C 8C         call CheckAllItemsCollected
 678  8C86 30 0F            jr   nc, .no_victory
 679  8C88
 680  8C88                  ; 2. Condizione: Willy è nella Master Bedroom?
 681  8C88 CD C3 8C         call CheckInMasterBedroom
 682  8C8B 30 0A            jr   nc, .no_victory
 683  8C8D
 684  8C8D                  ; 3. Condizione: Willy collide con il conveyor?
 685  8C8D CD DF 8C         call CheckWillyConveyorCollision
 686  8C90 30 05            jr   nc, .no_victory
 687  8C92
 688  8C92                  ; Tutte le condizioni sono soddisfatte contemporaneamente!
 689  8C92 E1               pop  hl
 690  8C93 D1               pop  de
 691  8C94 C1               pop  bc
 692  8C95 37               scf
 693  8C96 C9               ret
 694  8C97
 695  8C97              .no_victory:
 696  8C97 E1               pop  hl
 697  8C98 D1               pop  de
 698  8C99 C1               pop  bc
 699  8C9A B7               or   a
 700  8C9B C9               ret
 701  8C9C
 702  8C9C              ; -------------------------------------------------------------------
 703  8C9C              ; CheckAllItemsCollected
 704  8C9C              ; Verifica che tutti gli item del gioco siano stati raccolti.
 705  8C9C              ; - Controllo preliminare sul conteggio/flag globale
 706  8C9C              ; - Verifica puntuale che ogni record in ItemsTable abbia flag = 1 (raccolto)
 707  8C9C              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 708  8C9C              ; -------------------------------------------------------------------
 709  8C9C              CheckAllItemsCollected:
 710  8C9C E5               push hl
 711  8C9D 3A 4C FB         ld   a, (game_objective_completed)
 712  8CA0 B7               or   a
 713  8CA1 20 07            jr   nz, .verify_flags
 714  8CA3 3A 44 F7         ld   a, (items_collected)
 715  8CA6 FE 4D            cp   TOTAL_ITEMS
 716  8CA8 38 16            jr   c, .not_all
 717  8CAA
 718  8CAA              .verify_flags:
 719  8CAA 21 FB 80         ld   hl, ItemsTable
 720  8CAD              .loop:
 721  8CAD 7E               ld   a, (hl)
 722  8CAE FE FF            cp   $FF
 723  8CB0 28 0B            jr   z, .done_all
 724  8CB2 23               inc  hl                    ; +1 X
 725  8CB3 23               inc  hl                    ; +2 Y
 726  8CB4 23               inc  hl                    ; +3 Color
 727  8CB5 23               inc  hl                    ; +4 Collected flag
 728  8CB6 7E               ld   a, (hl)
 729  8CB7 B7               or   a
 730  8CB8 28 06            jr   z, .not_all           ; Trovato un item non raccolto -> fail
 731  8CBA 23               inc  hl                    ; Prossimo record
 732  8CBB 18 F0            jr   .loop
 733  8CBD
 734  8CBD              .done_all:
 735  8CBD E1               pop  hl
 736  8CBE 37               scf
 737  8CBF C9               ret
 738  8CC0
 739  8CC0              .not_all:
 740  8CC0 E1               pop  hl
 741  8CC1 B7               or   a
 742  8CC2 C9               ret
 743  8CC3
 744  8CC3              ; -------------------------------------------------------------------
 745  8CC3              ; CheckInMasterBedroom
 746  8CC3              ; Verifica se la stanza corrente è Master Bedroom (ID 35 / MastreBedRoomLayout)
 747  8CC3              ; Output: Carry = 1 se Master Bedroom, Carry = 0 altrimenti
 748  8CC3              ; -------------------------------------------------------------------
 749  8CC3              CheckInMasterBedroom:
 750  8CC3 E5               push hl
 751  8CC4 D5               push de
 752  8CC5 2A BA FA         ld   hl, (room_ptr)
 753  8CC8 11 2E B5         ld   de, MastreBedRoomLayout
 754  8CCB B7               or   a
 755  8CCC ED 52            sbc  hl, de
 756  8CCE 28 0B            jr   z, .is_master
 757  8CD0 3A 60 FA         ld   a, (current_room)
 758  8CD3 FE 23            cp   ROOM_MASTER_BEDROOM
 759  8CD5 28 04            jr   z, .is_master
 760  8CD7 D1               pop  de
 761  8CD8 E1               pop  hl
 762  8CD9 B7               or   a
 763  8CDA C9               ret
 764  8CDB              .is_master:
 765  8CDB D1               pop  de
 766  8CDC E1               pop  hl
 767  8CDD 37               scf
 768  8CDE C9               ret
 769  8CDF
 770  8CDF              ; -------------------------------------------------------------------
 771  8CDF              ; CheckWillyConveyorCollision
 772  8CDF              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 773  8CDF              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 774  8CDF              ; -------------------------------------------------------------------
 775  8CDF              CheckWillyConveyorCollision:
 776  8CDF C5               push bc
 777  8CE0 D5               push de
 778  8CE1 E5               push hl
 779  8CE2
 780  8CE2                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 781  8CE2 CD 41 76         call CheckWillyOnConveyor
 782  8CE5 38 49            jr   c, .collision_detected
 783  8CE7
 784  8CE7                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 785  8CE7 3A 62 FA         ld   a, (conveyor_len)
 786  8CEA B7               or   a
 787  8CEB 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 788  8CED
 789  8CED                  ; B = WillyY, C = WillyX
 790  8CED ED 4B 3A F7      ld   bc, (PlayerPos)
 791  8CF1
 792  8CF1                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 793  8CF1 3A 63 FA         ld   a, (conveyor_row)
 794  8CF4 87               add  a, a                  ; *2
 795  8CF5 87               add  a, a                  ; *4
 796  8CF6 87               add  a, a                  ; *8
 797  8CF7 5F               ld   e, a                  ; E = ConveyorTop
 798  8CF8 C6 07            add  a, 7
 799  8CFA 57               ld   d, a                  ; D = ConveyorBottom
 800  8CFB
 801  8CFB                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 802  8CFB 78               ld   a, b                  ; WillyTop
 803  8CFC BA               cp   d
 804  8CFD 28 04            jr   z, .y_overlap
 805  8CFF 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 806  8D01 18 32            jr   .no_conv_collision
 807  8D03
 808  8D03              .y_overlap:
 809  8D03 C6 0F            add  a, 15                 ; WillyBottom
 810  8D05 BB               cp   e
 811  8D06 28 04            jr   z, .x_check
 812  8D08 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 813  8D0A 18 29            jr   .no_conv_collision
 814  8D0C
 815  8D0C              .x_check:
 816  8D0C                  ; ConveyorLeft = conveyor_col * 8
 817  8D0C 3A 64 FA         ld   a, (conveyor_col)
 818  8D0F 87               add  a, a                  ; *2
 819  8D10 87               add  a, a                  ; *4
 820  8D11 87               add  a, a                  ; *8
 821  8D12 5F               ld   e, a                  ; E = ConveyorLeft
 822  8D13
 823  8D13                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 824  8D13 21 62 FA         ld   hl, conveyor_len
 825  8D16 3A 64 FA         ld   a, (conveyor_col)
 826  8D19 86               add  a, (hl)
 827  8D1A 87               add  a, a                  ; *2
 828  8D1B 87               add  a, a                  ; *4
 829  8D1C 87               add  a, a                  ; *8
 830  8D1D 3D               dec  a                     ; ConveyorRight
 831  8D1E 57               ld   d, a                  ; D = ConveyorRight
 832  8D1F
 833  8D1F                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 834  8D1F 79               ld   a, c                  ; WillyLeft
 835  8D20 BA               cp   d
 836  8D21 28 04            jr   z, .x_overlap
 837  8D23 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 838  8D25 18 0E            jr   .no_conv_collision
 839  8D27
 840  8D27              .x_overlap:
 841  8D27 C6 0F            add  a, 15                 ; WillyRight
 842  8D29 BB               cp   e
 843  8D2A 28 04            jr   z, .collision_detected
 844  8D2C 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 845  8D2E 18 05            jr   .no_conv_collision
 846  8D30
 847  8D30              .collision_detected:
 848  8D30 E1               pop  hl
 849  8D31 D1               pop  de
 850  8D32 C1               pop  bc
 851  8D33 37               scf
 852  8D34 C9               ret
 853  8D35
 854  8D35              .no_conv_collision:
 855  8D35 E1               pop  hl
 856  8D36 D1               pop  de
 857  8D37 C1               pop  bc
 858  8D38 B7               or   a
 859  8D39 C9               ret
 860  8D3A
 861  8D3A              ; -------------------------------------------------------------------
 862  8D3A              ; ResetFullGameState
 863  8D3A              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 864  8D3A              ; per l'avvio di una nuova partita dopo il Game Over.
 865  8D3A              ; -------------------------------------------------------------------
 866  8D3A              ResetFullGameState:
 867  8D3A                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 868  8D3A AF               xor  a
 869  8D3B D3 FE            out  ($fe), a              ; Bordo a nero
 870  8D3D 21 8D 5C         ld   hl, ATTR_P
 871  8D40 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 872  8D41 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 873  8D44 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 874  8D46 3E 07            ld   a, $07
 875  8D48 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 876  8D4B
 877  8D4B                  ; Ripristina il numero di vite iniziali
 878  8D4B 3E 07            ld   a, INITIAL_LIVES
 879  8D4D 32 47 F7         ld   (willy_lives), a
 880  8D50
 881  8D50                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 882  8D50 AF               xor  a
 883  8D51 32 44 F7         ld   (items_collected), a
 884  8D54 32 40 F7         ld   (body_state), a
 885  8D57 32 53 F7         ld   (w_warp_state), a
 886  8D5A 32 56 F7         ld   (w_key_prev), a
 887  8D5D 32 57 F7         ld   (enter_key_prev), a
 888  8D60 32 48 F7         ld   (velocity_y), a
 889  8D63 32 4A F7         ld   (jump_pressed), a
 890  8D66 32 4C F7         ld   (coyote_timer), a
 891  8D69 32 4F F7         ld   (jump_frame), a
 892  8D6C 32 4E F7         ld   (jump_dir), a
 893  8D6F 32 C0 FA         ld   (transition_active), a
 894  8D72 32 44 FB         ld   (willy_safety_timer), a
 895  8D75 3E FF            ld   a, $ff
 896  8D77 32 58 F7         ld   (digit_key_prev), a
 897  8D7A 3E 01            ld   a, 1
 898  8D7C 32 51 F7         ld   (q_prev), a
 899  8D7F 32 52 F7         ld   (a_prev), a
 900  8D82 32 49 F7         ld   (on_ground), a
 901  8D85
 902  8D85                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 903  8D85 3E 30            ld   a, '0'
 904  8D87 32 F9 68         ld   (status_line + 16), a
 905  8D8A 32 FA 68         ld   (status_line + 17), a
 906  8D8D 32 FB 68         ld   (status_line + 18), a
 907  8D90
 908  8D90                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 909  8D90 CD 57 86         call ResetItemsTable
 910  8D93
 911  8D93                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 912  8D93 CD 21 6E         call InitRoomEntryPositions
 913  8D96
 914  8D96                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 915  8D96 3E 07            ld   a, 7
 916  8D98 32 47 FB         ld   (time_hours), a
 917  8D9B AF               xor  a
 918  8D9C 32 48 FB         ld   (time_minutes), a
 919  8D9F 32 49 FB         ld   (time_period), a       ; 0 = AM
 920  8DA2 32 4C FB         ld   (game_objective_completed), a
 921  8DA5 2A 5B F7         ld   hl, (counter)
 922  8DA8 22 4A FB         ld   (time_last_counter), hl
 923  8DAB CD 6B 68         call Gfx_UpdateTimeDisplay
 924  8DAE
 925  8DAE                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 926  8DAE 21 F2 B2         ld   hl, TheBathroomLayout; TheOffLicenceLayout
 927  8DB1 22 BA FA         ld   (room_ptr), hl
 928  8DB4
 929  8DB4 C9               ret
 930  8DB5
 931  8DB5              ; -------------------------------------------------------------------
 932  8DB5              ; Time_UpdateClock
 933  8DB5              ; Gestisce lo scorrimento del tempo durante il gioco.
 934  8DB5              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 935  8DB5              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 936  8DB5              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 937  8DB5              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 938  8DB5              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 939  8DB5              ; sia completato, scatena immediatamente il Game Over.
 940  8DB5              ; -------------------------------------------------------------------
 941  8DB5              Time_UpdateClock:
 942  8DB5                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 943  8DB5 2A 5B F7         ld   hl, (counter)
 944  8DB8 ED 5B 4A FB      ld   de, (time_last_counter)
 945  8DBC B7               or   a
 946  8DBD ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 947  8DBF
 948  8DBF                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 949  8DBF 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 950  8DC2 B7               or   a
 951  8DC3 ED 52            sbc  hl, de
 952  8DC5 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 953  8DC6
 954  8DC6                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 955  8DC6 2A 4A FB         ld   hl, (time_last_counter)
 956  8DC9 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 957  8DCC 19               add  hl, de
 958  8DCD 22 4A FB         ld   (time_last_counter), hl
 959  8DD0
 960  8DD0                  ; Incrementa di 1 minuto il tempo di gioco
 961  8DD0 3A 48 FB         ld   a, (time_minutes)
 962  8DD3 3C               inc  a
 963  8DD4 FE 3C            cp   60
 964  8DD6 38 21            jr   c, .minutes_ok
 965  8DD8
 966  8DD8                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 967  8DD8 AF               xor  a
 968  8DD9 32 48 FB         ld   (time_minutes), a
 969  8DDC 3A 47 FB         ld   a, (time_hours)
 970  8DDF 3C               inc  a
 971  8DE0 FE 0C            cp   12
 972  8DE2 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 973  8DE4 FE 0D            cp   13
 974  8DE6 38 0E            jr   c, .hours_ok
 975  8DE8 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 976  8DEA 18 0A            jr   .hours_ok
 977  8DEC
 978  8DEC              .toggle_period:
 979  8DEC F5               push af                     ; Salva A (valore 12)
 980  8DED 3A 49 FB         ld   a, (time_period)
 981  8DF0 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 982  8DF2 32 49 FB         ld   (time_period), a
 983  8DF5 F1               pop  af                     ; Ripristina A = 12
 984  8DF6
 985  8DF6              .hours_ok:
 986  8DF6 32 47 FB         ld   (time_hours), a
 987  8DF9
 988  8DF9              .minutes_ok:
 989  8DF9 32 48 FB         ld   (time_minutes), a
 990  8DFC
 991  8DFC                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 992  8DFC CD 6B 68         call Gfx_UpdateTimeDisplay
 993  8DFF
 994  8DFF                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 995  8DFF 3A 4C FB         ld   a, (game_objective_completed)
 996  8E02 B7               or   a
 997  8E03 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 998  8E04
 999  8E04                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
1000  8E04 3A 49 FB         ld   a, (time_period)
1001  8E07 B7               or   a
1002  8E08 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
1003  8E09
1004  8E09 3A 47 FB         ld   a, (time_hours)
1005  8E0C FE 0C            cp   12
1006  8E0E 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1007  8E10 C9               ret
1008  8E11
1009  8E11              .time_limit_reached:
1010  8E11                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
1011  8E11                  ; Scatena immediatamente il Game Over temporale!
1012  8E11 C3 D1 8A         jp   TriggerGameOver
1013  8E14
1014  8E14
1015  8E14
