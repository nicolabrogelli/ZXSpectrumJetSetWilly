 286+ 5EEF 24               inc  h
 287+ 5EF0              .no_carry:
 288+ 5EF0 7E               ld   a, (hl)           ; A = byte dello sfondo
 289+ 5EF1
 290+ 5EF1 C1               pop  bc
 291+ 5EF2 D1               pop  de
 292+ 5EF3 E1               pop  hl
