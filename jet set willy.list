  72+ 8842 ~            ; Audio_UpdateMusic
  73+ 8842 ~            ;
  74+ 8842 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8842 ~            ; Viene chiamata a ogni frame.
  76+ 8842 ~            ; -------------------------------------------------------------------
  77+ 8842 ~            Audio_UpdateMusic:
  78+ 8842 ~                push af
  79+ 8842 ~                push bc
  80+ 8842 ~                push de
  81+ 8842 ~                push hl
  82+ 8842 ~
  83+ 8842 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8842 ~                ld   a, (Audio_jump_sound_note)
  85+ 8842 ~                cp   18
  86+ 8842 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8842 ~
  88+ 8842 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8842 ~                ld   a, (Audio_music_frame_counter)
  90+ 8842 ~                dec  a
  91+ 8842 ~                ld   (Audio_music_frame_counter), a
  92+ 8842 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8842 ~
  94+ 8842 ~                ; Altrimenti carica la nota successiva
  95+ 8842 ~                ld   a, (Audio_music_note_idx)
  96+ 8842 ~                inc  a
  97+ 8842 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8842 ~                jr   c, .no_wrap
  99+ 8842 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8842 ~            .no_wrap:
 101+ 8842 ~                ld   (Audio_music_note_idx), a
 102+ 8842 ~
 103+ 8842 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8842 ~                ld   e, a
 105+ 8842 ~                ld   d, 0
 106+ 8842 ~                ld   hl, Audio_MusicSheet
 107+ 8842 ~                add  hl, de
 108+ 8842 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8842 ~
 110+ 8842 ~                ; Leggi durata (secondo byte)
 111+ 8842 ~                inc  hl
 112+ 8842 ~                ld   a, (hl)
 113+ 8842 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8842 ~                jr   nz, .dur_ok
 115+ 8842 ~                ld   a, 1
 116+ 8842 ~            .dur_ok:
 117+ 8842 ~                ld   (Audio_music_frame_counter), a
 118+ 8842 ~
 119+ 8842 ~            .play_current_note:
 120+ 8842 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8842 ~                ld   a, (Audio_music_note_idx)
 122+ 8842 ~                ld   e, a
 123+ 8842 ~                ld   d, 0
 124+ 8842 ~                ld   hl, Audio_MusicSheet
 125+ 8842 ~                add  hl, de
 126+ 8842 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8842 ~                ld   a, (hl)                  ; A = delay
 128+ 8842 ~                or   a
 129+ 8842 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8842 ~
 131+ 8842 ~                ; Suona la nota: 2 cicli
 132+ 8842 ~                ld   d, a                     ; D = delay
 133+ 8842 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8842 ~            .note_loop:
 135+ 8842 ~                ; Speaker ON
 136+ 8842 ~                ld   a, (room_border_color)
 137+ 8842 ~                or   $10
 138+ 8842 ~                out  ($fe), a
 139+ 8842 ~                ld   c, d
 140+ 8842 ~            .d1:
 141+ 8842 ~                push af
 142+ 8842 ~                pop  af
 143+ 8842 ~                dec  c
 144+ 8842 ~                jr   nz, .d1
 145+ 8842 ~
 146+ 8842 ~                ; Speaker OFF
 147+ 8842 ~                ld   a, (room_border_color)
 148+ 8842 ~                and  $ef
 149+ 8842 ~                out  ($fe), a
 150+ 8842 ~                ld   c, d
 151+ 8842 ~            .d2:
 152+ 8842 ~                push af
 153+ 8842 ~                pop  af
 154+ 8842 ~                dec  c
 155+ 8842 ~                jr   nz, .d2
 156+ 8842 ~
 157+ 8842 ~                djnz .note_loop
 158+ 8842 ~
 159+ 8842 ~            .done:
 160+ 8842 ~                pop  hl
 161+ 8842 ~                pop  de
 162+ 8842 ~                pop  bc
 163+ 8842 ~                pop  af
 164+ 8842 ~                ret
 165+ 8842 ~
 166+ 8842 ~            Audio_MusicSheet:
 167+ 8842 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8842 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8842 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8842 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8842 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8842 ~                db 90, 10, 107, 20, 68, 65
 173+ 8842                  ELSE
 174+ 8842              Audio_UpdateMusic:
 175+ 8842 C9               ret
 176+ 8843                  ENDIF
