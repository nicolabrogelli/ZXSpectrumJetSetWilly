 846+ 7892 23               inc  hl
 847+ 7893 4E               ld   c, (hl)           ; X (colonna)
 848+ 7894
 849+ 7894 23               inc  hl
 850+ 7895 46               ld   b, (hl)           ; Y (riga)
 851+ 7896
 852+ 7896 23               inc  hl
 853+ 7897 5E               ld   e, (hl)           ; Colore
 854+ 7898
 855+ 7898 23               inc  hl
 856+ 7899 7E               ld   a, (hl)           ; Collected flag
 857+ 789A
 858+ 789A                  ; Se diverso da zero l'item è già stato raccolto
