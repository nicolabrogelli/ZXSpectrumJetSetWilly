1857+ 77BF              ; Verifica se c'è una cella Nasty (tipo 3) alle coordinate pixel (X, Y)
1858+ 77BF              ; Input: C = X, B = Y
1859+ 77BF              ; Output: Carry flag impostato se è Nasty, altrimenti resettato
1860+ 77BF              ; -------------------------------------------------------------------
1861+ 77BF              CheckNastyCell:
1862+ 77BF E5               push hl
1863+ 77C0 D5               push de
1864+ 77C1 C5               push bc
1865+ 77C2
1866+ 77C2                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1867+ 77C2 78               ld   a, b
1868+ 77C3 FE 80            cp   128
1869+ 77C5 30 17            jr   nc, .not_nasty
1870+ 77C7
1871+ 77C7                  ; 2. Calcola riga di layout: r = Y / 8
1872+ 77C7 CB 3F            srl  a
1873+ 77C9 CB 3F            srl  a
1874+ 77CB CB 3F            srl  a                 ; A = r (0..15)
1875+ 77CD
1876+ 77CD                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1877+ 77CD 5F               ld   e, a              ; E = r
1878+ 77CE 79               ld   a, c
1879+ 77CF CB 3F            srl  a
1880+ 77D1 CB 3F            srl  a
1881+ 77D3 CB 3F            srl  a                 ; A = c (0..31)
1882+ 77D5 4F               ld   c, a              ; C = c
1883+ 77D6 7B               ld   a, e              ; A = r
1884+ 77D7
1885+ 77D7 CD 45 75         call GetCellFromUnpacked ; A = cell type
1886+ 77DA
1887+ 77DA                  ; Controlla se è Nasty (3)
1888+ 77DA FE 03            cp   3
1889+ 77DC 28 05            jr   z, .is_nasty
1890+ 77DE
1891+ 77DE              .not_nasty:
1892+ 77DE C1               pop  bc
1893+ 77DF D1               pop  de
1894+ 77E0 E1               pop  hl
1895+ 77E1 B7               or   a                 ; Clear carry
1896+ 77E2 C9               ret
1897+ 77E3
1898+ 77E3              .is_nasty:
1899+ 77E3 C1               pop  bc
1900+ 77E4 D1               pop  de
1901+ 77E5 E1               pop  hl
1902+ 77E6 37               scf                    ; Set carry
1903+ 77E7 C9               ret
