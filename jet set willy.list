1360+ 6471 19               add  hl, de            ; HL = indirizzo pattern font 8x8 in RAM ($F100)
1361+ 6472
1362+ 6472                  ; 2. Imposta l'attributo colore a Riga 23, Colonna C ($5AE0 + C)
1363+ 6472 E5               push hl                ; Salva indirizzo pattern font
1364+ 6473 69               ld   l, c
1365+ 6474 26 00            ld   h, 0
1366+ 6476 11 E0 5A         ld   de, $5ae0
