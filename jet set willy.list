 225+ 5EB9
 226+ 5EB9              .check_ramp:
 227+ 5EB9 3A 60 7A         ld   a, (ramp_len)
 228+ 5EBC B7               or   a
 229+ 5EBD CA ED 5E         jp   z, .normal_grid
 230+ 5EC0
 231+ 5EC0 3A 61 7A         ld   a, (ramp_row)     ; A = RampRowStart
 232+ 5EC3 BB               cp   e                 ; compare with player row E
 233+ 5EC4 DA ED 5E         jp   c, .normal_grid   ; if RampRowStart < E, skip!
 234+ 5EC7
 235+ 5EC7 93               sub  e                 ; A = RampRowStart - E
 236+ 5EC8 47               ld   b, a              ; B = distance from start row (0..ramp_len-1)
 237+ 5EC9 3A 60 7A         ld   a, (ramp_len)
 238+ 5ECC B8               cp   b
 239+ 5ECD CA ED 5E         jp   z, .normal_grid   ; if B == ramp_len, too high!
 240+ 5ED0 DA ED 5E         jp   c, .normal_grid   ; if B > ramp_len, too high!
 241+ 5ED3
 242+ 5ED3                  ; Calcola ExpectedCol:
 243+ 5ED3 3A 5F 7A         ld   a, (ramp_dir)
 244+ 5ED6 B7               or   a
 245+ 5ED7 28 06            jr   z, .r_left
 246+ 5ED9              .r_right:
