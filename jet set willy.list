1075+ 8444 E1               pop  hl
1076+ 8445
1077+ 8445 C9               ret
1078+ 8446
1079+ 8446              ; -------------------------------------------------------------------
1080+ 8446              ; Items_DrawRoom
1081+ 8446              ;
1082+ 8446              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1083+ 8446              ;
1084+ 8446              ; Operazioni eseguite:
1085+ 8446              ;   1. Azzera la griglia items_grid.
1086+ 8446              ;   2. Svuota la cache degli oggetti attivi.
1087+ 8446              ;   3. Scansiona ItemsTable.
1088+ 8446              ;   4. Per ogni item della stanza corrente:
1089+ 8446              ;        - verifica se è già stato raccolto
1090+ 8446              ;        - disegna la grafica
1091+ 8446              ;        - aggiorna items_grid
1092+ 8446              ;        - memorizza l'item nella cache current_room_items
1093+ 8446              ;   5. Aggiorna num_room_items.
1094+ 8446              ;
1095+ 8446              ; Record ItemsTable:
1096+ 8446              ;   +0  Room ID
1097+ 8446              ;   +1  X (colonna)
1098+ 8446              ;   +2  Y (riga)
1099+ 8446              ;   +3  Colore
1100+ 8446              ;   +4  Collected flag
1101+ 8446              ;
1102+ 8446              ; Cache current_room_items:
1103+ 8446              ;   +0  Colonna
1104+ 8446              ;   +1  Riga
1105+ 8446              ;   +2  Colore
1106+ 8446              ;   +3  Collected flag ptr (Low)
1107+ 8446              ;   +4  Collected flag ptr (High)
1108+ 8446              ;
1109+ 8446              ; Ogni record cache occupa 5 byte.
1110+ 8446              ; -------------------------------------------------------------------
1111+ 8446              ; ResetItemsTable
1112+ 8446              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1113+ 8446              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1114+ 8446              ; -------------------------------------------------------------------
1115+ 8446              ResetItemsTable:
1116+ 8446 21 EF 7E         ld   hl, ItemsTable
1117+ 8449              .reset_loop:
1118+ 8449 7E               ld   a, (hl)
1119+ 844A FE FF            cp   $FF
1120+ 844C C8               ret  z
1121+ 844D 23               inc  hl                        ; +1 (X)
1122+ 844E 23               inc  hl                        ; +2 (Y)
1123+ 844F 23               inc  hl                        ; +3 (Color)
1124+ 8450 23               inc  hl                        ; +4 (Collected flag)
1125+ 8451 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1126+ 8453 23               inc  hl                        ; Prossimo record
1127+ 8454 18 F3            jr   .reset_loop
1128+ 8456
1129+ 8456              ; -------------------------------------------------------------------
1130+ 8456              Items_DrawRoom:
1131+ 8456
1132+ 8456                  ; Salva tutti i registri utilizzati
1133+ 8456 E5               push hl
1134+ 8457 D5               push de
1135+ 8458 C5               push bc
1136+ 8459 DD E5            push ix
1137+ 845B FD E5            push iy
1138+ 845D
1139+ 845D                  ; ---------------------------------------------------------------
1140+ 845D                  ; Azzera items_grid (32 x 16 = 512 byte)
1141+ 845D                  ; ---------------------------------------------------------------
1142+ 845D 21 57 E9         ld   hl, items_grid
1143+ 8460 11 58 E9         ld   de, items_grid + 1
1144+ 8463 36 00            ld   (hl), 0
1145+ 8465 01 FF 01         ld   bc, 511
1146+ 8468 ED B0            ldir
1147+ 846A
1148+ 846A                  ; ---------------------------------------------------------------
1149+ 846A                  ; Nessun item attivo nella stanza
1150+ 846A                  ; ---------------------------------------------------------------
1151+ 846A AF               xor  a
1152+ 846B 32 D6 EE         ld   (num_room_items), a
1153+ 846E
1154+ 846E                  ; IY punta alla cache degli item attivi
1155+ 846E FD 21 86 EE      ld   iy, current_room_items
1156+ 8472
1157+ 8472                  ; ---------------------------------------------------------------
1158+ 8472                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1159+ 8472                  ; alla stanza corrente.
1160+ 8472                  ;
1161+ 8472                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1162+ 8472                  ; ---------------------------------------------------------------
1163+ 8472 2A D7 EE         ld   hl, (room_ptr)
1164+ 8475 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1165+ 8478 19               add  hl, de
1166+ 8479
1167+ 8479 E5               push hl
1168+ 847A DD E1            pop  ix                ; IX = bitmap item
1169+ 847C
1170+ 847C                  ; ---------------------------------------------------------------
1171+ 847C                  ; Inizio scansione della tabella degli item
1172+ 847C                  ; ---------------------------------------------------------------
1173+ 847C 21 EF 7E         ld   hl, ItemsTable
1174+ 847F
1175+ 847F              .loop:
1176+ 847F
1177+ 847F                  ; ---------------------------------------------------------------
1178+ 847F                  ; Legge il Room ID del record corrente
1179+ 847F                  ; ---------------------------------------------------------------
1180+ 847F 7E               ld   a, (hl)
1181+ 8480
1182+ 8480                  ; $FF indica fine tabella
1183+ 8480 FE FF            cp   $FF
1184+ 8482 28 53            jr   z, .done
1185+ 8484
1186+ 8484                  ; ---------------------------------------------------------------
1187+ 8484                  ; Verifica se l'item appartiene alla stanza corrente
1188+ 8484                  ; ---------------------------------------------------------------
1189+ 8484 57               ld   d, a
1190+ 8485
1191+ 8485 3A 7D EE         ld   a, (current_room)
1192+ 8488 BA               cp   d
1193+ 8489 20 45            jr   nz, .next_item
1194+ 848B
1195+ 848B                  ; ---------------------------------------------------------------
1196+ 848B                  ; Legge i dati dell'item
1197+ 848B                  ; ---------------------------------------------------------------
1198+ 848B
1199+ 848B 23               inc  hl
1200+ 848C 4E               ld   c, (hl)           ; X (colonna)
1201+ 848D
1202+ 848D 23               inc  hl
1203+ 848E 46               ld   b, (hl)           ; Y (riga)
1204+ 848F
1205+ 848F 23               inc  hl
1206+ 8490 5E               ld   e, (hl)           ; Colore
1207+ 8491
1208+ 8491 23               inc  hl
1209+ 8492 7E               ld   a, (hl)           ; Collected flag
1210+ 8493
1211+ 8493                  ; Se diverso da zero l'item è già stato raccolto
1212+ 8493 B7               or   a
1213+ 8494 20 3E            jr   nz, .next_no_inc
1214+ 8496
1215+ 8496                  ; ---------------------------------------------------------------
1216+ 8496                  ; Disegna l'item sullo schermo
1217+ 8496                  ;
1218+ 8496                  ; B = Row
1219+ 8496                  ; C = Column
1220+ 8496                  ; HL = bitmap pointer
1221+ 8496                  ; E = Color
1222+ 8496                  ; ---------------------------------------------------------------
1223+ 8496 E5               push hl
1224+ 8497
1225+ 8497 DD E5            push ix
1226+ 8499 E1               pop  hl
1227+ 849A
1228+ 849A CD DF 84         call DrawItemGraphic
1229+ 849D
1230+ 849D E1               pop  hl                ; ritorna al flag collected
1231+ 849E
1232+ 849E                  ; ---------------------------------------------------------------
1233+ 849E                  ; Aggiorna items_grid
1234+ 849E                  ;
1235+ 849E                  ; Calcolo:
1236+ 849E                  ;   offset = Row * 32 + Col
1237+ 849E                  ; ---------------------------------------------------------------
1238+ 849E E5               push hl
1239+ 849F D5               push de
1240+ 84A0
1241+ 84A0 26 00            ld   h, 0
1242+ 84A2 68               ld   l, b              ; HL = Row
1243+ 84A3
1244+ 84A3 29               add  hl, hl            ; *2
1245+ 84A4 29               add  hl, hl            ; *4
1246+ 84A5 29               add  hl, hl            ; *8
1247+ 84A6 29               add  hl, hl            ; *16
1248+ 84A7 29               add  hl, hl            ; *32
1249+ 84A8
1250+ 84A8 16 00            ld   d, 0
1251+ 84AA 59               ld   e, c              ; DE = Col
1252+ 84AB
1253+ 84AB 19               add  hl, de            ; Row*32 + Col
1254+ 84AC
1255+ 84AC 11 57 E9         ld   de, items_grid
1256+ 84AF 19               add  hl, de            ; puntatore nella griglia
1257+ 84B0
1258+ 84B0 D1               pop  de                ; ripristina colore
1259+ 84B1
1260+ 84B1 73               ld   (hl), e           ; salva colore cella
1261+ 84B2
1262+ 84B2 E1               pop  hl
1263+ 84B3
1264+ 84B3                  ; ---------------------------------------------------------------
1265+ 84B3                  ; Salva l'item nella cache della stanza
1266+ 84B3                  ;
1267+ 84B3                  ; Questo evita di dover scansionare tutta ItemsTable
1268+ 84B3                  ; durante il controllo delle collisioni.
1269+ 84B3                  ; ---------------------------------------------------------------
1270+ 84B3
1271+ 84B3 FD 71 00         ld   (iy+0), c         ; Colonna
1272+ 84B6 FD 70 01         ld   (iy+1), b         ; Riga
1273+ 84B9 FD 73 02         ld   (iy+2), e         ; Colore
1274+ 84BC
1275+ 84BC                  ; Salva il puntatore al flag "collected"
1276+ 84BC FD 75 03         ld   (iy+3), l         ; Low byte
1277+ 84BF FD 74 04         ld   (iy+4), h         ; High byte
1278+ 84C2
1279+ 84C2                  ; Passa al record successivo della cache
1280+ 84C2 01 05 00         ld   bc, 5
1281+ 84C5 FD 09            add  iy, bc
1282+ 84C7
1283+ 84C7                  ; Incrementa il numero di item attivi
1284+ 84C7 3A D6 EE         ld   a, (num_room_items)
1285+ 84CA 3C               inc  a
1286+ 84CB 32 D6 EE         ld   (num_room_items), a
1287+ 84CE
1288+ 84CE 18 04            jr   .next_no_inc
1289+ 84D0
1290+ 84D0              .next_item:
1291+ 84D0
1292+ 84D0                  ; ---------------------------------------------------------------
1293+ 84D0                  ; L'item non appartiene alla stanza corrente.
1294+ 84D0                  ; Salta i campi del record:
1295+ 84D0                  ;   X
1296+ 84D0                  ;   Y
1297+ 84D0                  ;   Color
1298+ 84D0                  ;   Collected
1299+ 84D0                  ; ---------------------------------------------------------------
1300+ 84D0 23               inc  hl
1301+ 84D1 23               inc  hl
1302+ 84D2 23               inc  hl
1303+ 84D3 23               inc  hl
1304+ 84D4
1305+ 84D4              .next_no_inc:
1306+ 84D4
1307+ 84D4                  ; ---------------------------------------------------------------
1308+ 84D4                  ; Avanza al record successivo
1309+ 84D4                  ; (prossimo Room ID)
1310+ 84D4                  ; ---------------------------------------------------------------
1311+ 84D4 23               inc  hl
1312+ 84D5 18 A8            jr   .loop
1313+ 84D7
1314+ 84D7              .done:
1315+ 84D7
1316+ 84D7                  ; Ripristina i registri
1317+ 84D7 FD E1            pop  iy
1318+ 84D9 DD E1            pop  ix
1319+ 84DB D1               pop  de
1320+ 84DC C1               pop  bc
1321+ 84DD E1               pop  hl
1322+ 84DE
1323+ 84DE C9               ret
1324+ 84DF
1325+ 84DF              ; -------------------------------------------------------------------
1326+ 84DF              ; DrawItemGraphic
1327+ 84DF              ;
1328+ 84DF              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1329+ 84DF              ; utilizzando una bitmap di 8 byte e un attributo colore.
1330+ 84DF              ;
1331+ 84DF              ; Input:
1332+ 84DF              ;   B = Riga attributi (3..18)
1333+ 84DF              ;   C = Colonna attributi (0..31)
1334+ 84DF              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1335+ 84DF              ;   E = Attributo colore
1336+ 84DF              ;
1337+ 84DF              ; Output:
1338+ 84DF              ;   Nessuno
1339+ 84DF              ;
1340+ 84DF              ; Registri preservati:
1341+ 84DF              ;   BC, DE, HL
1342+ 84DF              ; -------------------------------------------------------------------
1343+ 84DF              DrawItemGraphic:
1344+ 84DF
1345+ 84DF                  ; Salva i registri originali
1346+ 84DF C5               push bc
1347+ 84E0 D5               push de
1348+ 84E1 E5               push hl
1349+ 84E2
1350+ 84E2                  ; ---------------------------------------------------------------
1351+ 84E2                  ; Calcolo indirizzo bitmap dello Spectrum
1352+ 84E2                  ;
1353+ 84E2                  ; Ogni item occupa una cella attributi (8x8 pixel).
1354+ 84E2                  ;
1355+ 84E2                  ; Formula:
1356+ 84E2                  ;   High = $40 + (Row AND $18)
1357+ 84E2                  ;   Low  = (Row AND 7) * 32 + Col
1358+ 84E2                  ;
1359+ 84E2                  ; DE conterrà l'indirizzo della prima scanline.
1360+ 84E2                  ; ---------------------------------------------------------------
1361+ 84E2
1362+ 84E2 78               ld   a, b
1363+ 84E3 E6 18            and  $18
1364+ 84E5 C6 40            add  a, $40
1365+ 84E7 57               ld   d, a              ; Byte alto indirizzo video
1366+ 84E8
1367+ 84E8 78               ld   a, b
1368+ 84E9 E6 07            and  7                 ; Riga interna al blocco da 8
1369+ 84EB
1370+ 84EB 87               add  a, a              ; *2
1371+ 84EC 87               add  a, a              ; *4
1372+ 84ED 87               add  a, a              ; *8
1373+ 84EE 87               add  a, a              ; *16
1374+ 84EF 87               add  a, a              ; *32
1375+ 84F0
1376+ 84F0 81               add  a, c              ; + colonna
1377+ 84F1
1378+ 84F1 5F               ld   e, a              ; Byte basso indirizzo video
1379+ 84F2
1380+ 84F2                  ; ---------------------------------------------------------------
1381+ 84F2                  ; Disegno bitmap
1382+ 84F2                  ;
1383+ 84F2                  ; Copia 8 byte consecutivi nella memoria video.
1384+ 84F2                  ; Ogni byte rappresenta una scanline da 8 pixel.
1385+ 84F2                  ; ---------------------------------------------------------------
1386+ 84F2
1387+ 84F2 C5               push bc                ; Conserva Row e Col
1388+ 84F3
1389+ 84F3 06 08            ld   b, 8              ; Numero scanline
1390+ 84F5
1391+ 84F5              .line_loop:
1392+ 84F5
1393+ 84F5 7E               ld   a, (hl)           ; Legge scanline bitmap
1394+ 84F6 12               ld   (de), a           ; Scrive nella memoria video
1395+ 84F7
1396+ 84F7 14               inc  d                 ; Scanline successiva
1397+ 84F8 23               inc  hl                ; Byte bitmap successivo
1398+ 84F9
1399+ 84F9 05               dec  b
1400+ 84FA 20 F9            jr   nz, .line_loop
1401+ 84FC
1402+ 84FC C1               pop  bc                ; Ripristina Row e Col
1403+ 84FD
1404+ 84FD                  ; ---------------------------------------------------------------
1405+ 84FD                  ; Calcolo indirizzo attributo
1406+ 84FD                  ;
1407+ 84FD                  ; Formula:
1408+ 84FD                  ;   AttrAddr = $5800 + Row * 32 + Col
1409+ 84FD                  ;
1410+ 84FD                  ; HL conterrà l'indirizzo della cella attributi.
1411+ 84FD                  ; ---------------------------------------------------------------
1412+ 84FD
1413+ 84FD 26 00            ld   h, 0
1414+ 84FF 68               ld   l, b              ; HL = Row
1415+ 8500
1416+ 8500 29               add  hl, hl            ; *2
1417+ 8501 29               add  hl, hl            ; *4
1418+ 8502 29               add  hl, hl            ; *8
1419+ 8503 29               add  hl, hl            ; *16
1420+ 8504 29               add  hl, hl            ; *32
1421+ 8505
1422+ 8505 79               ld   a, c              ; A = Colonna
1423+ 8506
1424+ 8506 85               add  a, l
1425+ 8507 6F               ld   l, a
1426+ 8508
1427+ 8508 30 01            jr   nc, .no_carry
1428+ 850A 24               inc  h
1429+ 850B
1430+ 850B              .no_carry:
1431+ 850B
1432+ 850B                  ; HL = Row * 32 + Col
1433+ 850B
1434+ 850B 11 00 58         ld   de, $5800
1435+ 850E 19               add  hl, de            ; HL = indirizzo attributi
1436+ 850F
1437+ 850F                  ; ---------------------------------------------------------------
1438+ 850F                  ; Recupera il colore originale dallo stack.
1439+ 850F                  ;
1440+ 850F                  ; Layout stack:
1441+ 850F                  ;   HL originale
1442+ 850F                  ;   DE originale (E = colore)
1443+ 850F                  ;   BC originale
1444+ 850F                  ; ---------------------------------------------------------------
1445+ 850F
1446+ 850F C1               pop  bc                ; Recupera HL originale
1447+ 8510 D1               pop  de                ; Recupera DE originale
1448+ 8511
1449+ 8511                  ; ---------------------------------------------------------------
1450+ 8511                  ; Scrive l'attributo colore
1451+ 8511                  ; ---------------------------------------------------------------
1452+ 8511
1453+ 8511 7B               ld   a, e              ; A = colore
1454+ 8512 77               ld   (hl), a           ; Scrive nella RAM attributi
1455+ 8513
1456+ 8513                  ; ---------------------------------------------------------------
1457+ 8513                  ; Ripristina HL e BC originali
1458+ 8513                  ; ---------------------------------------------------------------
1459+ 8513
1460+ 8513 C5               push bc
1461+ 8514 E1               pop  hl                ; HL originale
1462+ 8515
1463+ 8515 C1               pop  bc                ; BC originale
1464+ 8516
1465+ 8516 C9               ret
1466+ 8517
1467+ 8517              ; -------------------------------------------------------------------
1468+ 8517              ; RestoreBackgroundCell
1469+ 8517              ;
1470+ 8517              ; Ripristina il contenuto originale di una cella della stanza.
1471+ 8517              ; Viene utilizzata principalmente quando un item viene raccolto:
1472+ 8517              ; invece di lasciare un "buco", la routine ridisegna il tile
1473+ 8517              ; originale presente nella mappa della stanza.
1474+ 8517              ;
1475+ 8517              ; Input:
1476+ 8517              ;   B = Row (3..18)
1477+ 8517              ;   C = Col (0..31)
1478+ 8517              ;
1479+ 8517              ; Utilizza:
1480+ 8517              ;   room_ptr -> struttura dati della stanza corrente
1481+ 8517              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1482+ 8517              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1483+ 8517              ;
1484+ 8517              ; Tipi di cella:
1485+ 8517              ;   0 = Background
1486+ 8517              ;   1 = Floor
1487+ 8517              ;   2 = Wall
1488+ 8517              ;   3 = Nasty
1489+ 8517              ; -------------------------------------------------------------------
1490+ 8517              RestoreBackgroundCell:
1491+ 8517
1492+ 8517                  ; Salva tutti i registri utilizzati
1493+ 8517 FD E5            push iy
1494+ 8519 C5               push bc
1495+ 851A D5               push de
1496+ 851B E5               push hl
1497+ 851C DD E5            push ix
1498+ 851E
1499+ 851E                  ; ---------------------------------------------------------------
1500+ 851E                  ; Conserva Row e Col in IY.
1501+ 851E                  ;
1502+ 851E                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1503+ 851E                  ; BC potrebbe essere modificato.
1504+ 851E                  ; ---------------------------------------------------------------
1505+ 851E C5               push bc
1506+ 851F FD E1            pop  iy                ; IYH = Row, IYL = Col
1507+ 8521
1508+ 8521                  ; ---------------------------------------------------------------
1509+ 8521                  ; Determina quale tipo di cella è presente nella posizione
1510+ 8521                  ; specificata.
1511+ 8521                  ;
1512+ 8521                  ; Input:
1513+ 8521                  ;   B = Row
1514+ 8521                  ;   C = Col
1515+ 8521                  ;
1516+ 8521                  ; Output:
1517+ 8521                  ;   A = tipo cella
1518+ 8521                  ; ---------------------------------------------------------------
1519+ 8521 78               ld   a, b
1520+ 8522
1521+ 8522 CD E9 75         call GetCellFromUnpacked
1522+ 8525
1523+ 8525                  ; ---------------------------------------------------------------
1524+ 8525                  ; Recupera il puntatore alla stanza corrente.
1525+ 8525                  ;
1526+ 8525                  ; DE = base della struttura stanza
1527+ 8525                  ; ---------------------------------------------------------------
1528+ 8525 ED 5B D7 EE      ld   de, (room_ptr)
1529+ 8529
1530+ 8529                  ; ---------------------------------------------------------------
1531+ 8529                  ; Seleziona il tile corretto in base al tipo di cella.
1532+ 8529                  ;
1533+ 8529                  ; A = 0 -> Background
1534+ 8529                  ; A = 1 -> Floor
1535+ 8529                  ; A = 2 -> Wall
1536+ 8529                  ; A = 3 -> Nasty
1537+ 8529                  ; ---------------------------------------------------------------
1538+ 8529
1539+ 8529 B7               or   a
1540+ 852A 20 06            jr   nz, .not_bg
1541+ 852C
1542+ 852C                  ; Background
1543+ 852C 21 A0 00         ld   hl, OFFSET_BG
1544+ 852F 19               add  hl, de
1545+ 8530 18 16            jr   .draw_cell
1546+ 8532
1547+ 8532              .not_bg:
1548+ 8532
1549+ 8532 3D               dec  a
1550+ 8533 20 06            jr   nz, .not_floor
1551+ 8535
1552+ 8535                  ; Floor
1553+ 8535 21 A9 00         ld   hl, OFFSET_FLOOR
1554+ 8538 19               add  hl, de
1555+ 8539 18 0D            jr   .draw_cell
1556+ 853B
1557+ 853B              .not_floor:
1558+ 853B
1559+ 853B 3D               dec  a
1560+ 853C 20 06            jr   nz, .not_wall
1561+ 853E
1562+ 853E                  ; Wall
1563+ 853E 21 B2 00         ld   hl, OFFSET_WALL
1564+ 8541 19               add  hl, de
1565+ 8542 18 04            jr   .draw_cell
1566+ 8544
1567+ 8544              .not_wall:
1568+ 8544
1569+ 8544                  ; Nasty
1570+ 8544 21 BB 00         ld   hl, OFFSET_NASTY
1571+ 8547 19               add  hl, de
1572+ 8548
1573+ 8548              .draw_cell:
1574+ 8548
1575+ 8548                  ; ---------------------------------------------------------------
1576+ 8548                  ; HL punta ora alla grafica del tile da ridisegnare.
1577+ 8548                  ;
1578+ 8548                  ; Gfx_DrawTile si aspetta:
1579+ 8548                  ;   IX = puntatore tile
1580+ 8548                  ;   B  = Row
1581+ 8548                  ;   C  = Col
1582+ 8548                  ; ---------------------------------------------------------------
1583+ 8548 E5               push hl
1584+ 8549 DD E1            pop  ix
1585+ 854B
1586+ 854B                  ; Ripristina Row e Col salvati in IY
1587+ 854B FD E5            push iy
1588+ 854D C1               pop  bc
1589+ 854E
1590+ 854E                  ; Disegna il tile originale
1591+ 854E CD B8 68         call Gfx_DrawTile
1592+ 8551
1593+ 8551                  ; ---------------------------------------------------------------
1594+ 8551                  ; Ripristina i registri salvati
1595+ 8551                  ; ---------------------------------------------------------------
1596+ 8551 DD E1            pop  ix
1597+ 8553 E1               pop  hl
1598+ 8554 D1               pop  de
1599+ 8555 C1               pop  bc
1600+ 8556 FD E1            pop  iy
1601+ 8558
1602+ 8558 C9               ret
1603+ 8559
1604+ 8559              ; -------------------------------------------------------------------
1605+ 8559              ; CheckWillyItemCollision
1606+ 8559              ;
1607+ 8559              ; Verifica se Willy collide con un item utilizzando il controllo
1608+ 8559              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1609+ 8559              ;
1610+ 8559              ; Input:
1611+ 8559              ;   A = ItemX (colonna attributi 0..31)
1612+ 8559              ;   H = ItemY (riga attributi 3..18)
1613+ 8559              ;
1614+ 8559              ; Coordinate item:
1615+ 8559              ;   Ogni item occupa una cella da 8x8 pixel.
1616+ 8559              ;
1617+ 8559              ; Coordinate Willy:
1618+ 8559              ;   Willy occupa un rettangolo di 16x16 pixel.
1619+ 8559              ;
1620+ 8559              ; Output:
1621+ 8559              ;   Carry Set   = collisione rilevata
1622+ 8559              ;   Carry Clear = nessuna collisione
1623+ 8559              ;
1624+ 8559              ; Registri preservati:
1625+ 8559              ;   BC, DE, HL
1626+ 8559              ; -------------------------------------------------------------------
1627+ 8559              CheckWillyItemCollision:
1628+ 8559
1629+ 8559                  ; Salva i registri utilizzati
1630+ 8559 C5               push bc
1631+ 855A D5               push de
1632+ 855B E5               push hl
1633+ 855C
1634+ 855C                  ; ---------------------------------------------------------------
1635+ 855C                  ; Calcola il bounding box orizzontale dell'item
1636+ 855C                  ;
1637+ 855C                  ; ItemLeft  = ItemX * 8
1638+ 855C                  ; ItemRight = ItemLeft + 7
1639+ 855C                  ;
1640+ 855C                  ; E = ItemLeft
1641+ 855C                  ; D = ItemRight
1642+ 855C                  ; ---------------------------------------------------------------
1643+ 855C 6F               ld   l, a              ; L = ItemX
1644+ 855D
1645+ 855D 7D               ld   a, l
1646+ 855E 87               add  a, a              ; *2
1647+ 855F 87               add  a, a              ; *4
1648+ 8560 87               add  a, a              ; *8
1649+ 8561
1650+ 8561 5F               ld   e, a              ; E = ItemLeft
1651+ 8562
1652+ 8562 C6 07            add  a, 7
1653+ 8564 57               ld   d, a              ; D = ItemRight
1654+ 8565
1655+ 8565                  ; ---------------------------------------------------------------
1656+ 8565                  ; Recupera la posizione corrente di Willy
1657+ 8565                  ;
1658+ 8565                  ; B = WillyY
1659+ 8565                  ; C = WillyX
1660+ 8565                  ; ---------------------------------------------------------------
1661+ 8565 ED 4B 57 EB      ld   bc, (PlayerPos)
1662+ 8569
1663+ 8569                  ; ---------------------------------------------------------------
1664+ 8569                  ; Primo test:
1665+ 8569                  ;
1666+ 8569                  ; WillyLeft <= ItemRight
1667+ 8569                  ;
1668+ 8569                  ; Se Willy è completamente a destra dell'item
1669+ 8569                  ; non può esserci collisione.
1670+ 8569                  ; ---------------------------------------------------------------
1671+ 8569 79               ld   a, c              ; A = WillyLeft
1672+ 856A
1673+ 856A BA               cp   d                 ; WillyLeft vs ItemRight
1674+ 856B
1675+ 856B 28 04            jr   z, .x_ok
1676+ 856D 38 02            jr   c, .x_ok
1677+ 856F
1678+ 856F 18 29            jr   .no_collision
1679+ 8571
1680+ 8571              .x_ok:
1681+ 8571
1682+ 8571                  ; ---------------------------------------------------------------
1683+ 8571                  ; Secondo test:
1684+ 8571                  ;
1685+ 8571                  ; WillyRight >= ItemLeft
1686+ 8571                  ;
1687+ 8571                  ; WillyRight = WillyX + 7
1688+ 8571                  ; ---------------------------------------------------------------
1689+ 8571 C6 07            add  a, 7
1690+ 8573
1691+ 8573 BB               cp   e                 ; WillyRight vs ItemLeft
1692+ 8574
1693+ 8574 28 04            jr   z, .y_check
1694+ 8576 30 02            jr   nc, .y_check
1695+ 8578
1696+ 8578 18 20            jr   .no_collision
1697+ 857A
1698+ 857A              .y_check:
1699+ 857A
1700+ 857A                  ; ---------------------------------------------------------------
1701+ 857A                  ; Recupera ItemY dal valore originale di HL
1702+ 857A                  ;
1703+ 857A                  ; H contiene la riga dell'item.
1704+ 857A                  ; ---------------------------------------------------------------
1705+ 857A E1               pop  hl
1706+ 857B E5               push hl
1707+ 857C
1708+ 857C                  ; ---------------------------------------------------------------
1709+ 857C                  ; Calcola il bounding box verticale dell'item
1710+ 857C                  ;
1711+ 857C                  ; ItemTop    = ItemY * 8
1712+ 857C                  ; ItemBottom = ItemTop + 7
1713+ 857C                  ;
1714+ 857C                  ; E = ItemTop
1715+ 857C                  ; D = ItemBottom
1716+ 857C                  ; ---------------------------------------------------------------
1717+ 857C 7C               ld   a, h
1718+ 857D
1719+ 857D 87               add  a, a              ; *2
1720+ 857E 87               add  a, a              ; *4
1721+ 857F 87               add  a, a              ; *8
1722+ 8580
1723+ 8580 5F               ld   e, a              ; ItemTop
1724+ 8581
1725+ 8581 C6 07            add  a, 7
1726+ 8583 57               ld   d, a              ; ItemBottom
1727+ 8584
1728+ 8584                  ; ---------------------------------------------------------------
1729+ 8584                  ; Primo test verticale:
1730+ 8584                  ;
1731+ 8584                  ; WillyTop <= ItemBottom
1732+ 8584                  ; ---------------------------------------------------------------
1733+ 8584 78               ld   a, b              ; WillyTop
1734+ 8585
1735+ 8585 BA               cp   d
1736+ 8586
1737+ 8586 28 04            jr   z, .y_ok
1738+ 8588 38 02            jr   c, .y_ok
1739+ 858A
1740+ 858A 18 0E            jr   .no_collision
1741+ 858C
1742+ 858C              .y_ok:
1743+ 858C
1744+ 858C                  ; ---------------------------------------------------------------
1745+ 858C                  ; Secondo test verticale:
1746+ 858C                  ;
1747+ 858C                  ; WillyBottom >= ItemTop
1748+ 858C                  ;
1749+ 858C                  ; WillyBottom = WillyY + 15
1750+ 858C                  ; ---------------------------------------------------------------
1751+ 858C C6 0F            add  a, 15
1752+ 858E
1753+ 858E BB               cp   e
1754+ 858F
1755+ 858F 28 04            jr   z, .collision
1756+ 8591 30 02            jr   nc, .collision
1757+ 8593
1758+ 8593 18 05            jr   .no_collision
1759+ 8595
1760+ 8595              .collision:
1761+ 8595
1762+ 8595                  ; ---------------------------------------------------------------
1763+ 8595                  ; Collisione rilevata
1764+ 8595                  ; ---------------------------------------------------------------
1765+ 8595 E1               pop  hl
1766+ 8596 D1               pop  de
1767+ 8597 C1               pop  bc
1768+ 8598
1769+ 8598 37               scf                    ; Carry = 1
1770+ 8599
1771+ 8599 C9               ret
1772+ 859A
1773+ 859A              .no_collision:
1774+ 859A
1775+ 859A                  ; ---------------------------------------------------------------
1776+ 859A                  ; Nessuna collisione
1777+ 859A                  ; ---------------------------------------------------------------
1778+ 859A E1               pop  hl
1779+ 859B D1               pop  de
1780+ 859C C1               pop  bc
1781+ 859D
1782+ 859D B7               or   a                 ; Carry = 0
1783+ 859E
1784+ 859E C9               ret
1785+ 859F
1786+ 859F              ; -------------------------------------------------------------------
1787+ 859F              ; Items_CheckCollision
1788+ 859F              ;
1789+ 859F              ; Controlla se Willy entra in collisione con uno degli item
1790+ 859F              ; attivi presenti nella stanza corrente.
1791+ 859F              ;
1792+ 859F              ; Per ogni item:
1793+ 859F              ;   - verifica che appartenga alla stanza corrente
1794+ 859F              ;   - verifica che non sia già stato raccolto
1795+ 859F              ;   - esegue il test di collisione con Willy
1796+ 859F              ;
1797+ 859F              ; Se l'item viene raccolto:
1798+ 859F              ;   - imposta il flag "collected"
