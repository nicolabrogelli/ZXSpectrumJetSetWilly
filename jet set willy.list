 403  8A15 7E               ld   a, (hl)               ; A = nuovo colore attributo
 404  8A16 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 405  8A19 06 09            ld   b, 9
