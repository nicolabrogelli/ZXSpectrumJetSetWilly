   8+ 823E              ; Audio_UpdateJumpSound
   9+ 823E              ;
  10+ 823E              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 823E              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 823E              ; -------------------------------------------------------------------
  13+ 823E              Audio_UpdateJumpSound:
  14+ 823E F5               push af
  15+ 823F C5               push bc
  16+ 8240 D5               push de
  17+ 8241 E5               push hl
  18+ 8242
  19+ 8242                  ; Controlla se il suono è attivo (note < 18)
  20+ 8242 3A 29 EB         ld   a, (Audio_jump_sound_note)
  21+ 8245 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8247 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8249
  24+ 8249                  ; Carica la nota corrente da suonare
  25+ 8249 5F               ld   e, a
  26+ 824A 16 00            ld   d, 0
  27+ 824C 21 78 82         ld   hl, Audio_JumpSoundDelays
  28+ 824F 19               add  hl, de
  29+ 8250 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8251 57               ld   d, a                      ; D = delay della nota
  31+ 8252
  32+ 8252                  ; Suona la nota: 15 cicli
  33+ 8252 06 0F            ld   b, 15
  34+ 8254              .note_loop:
  35+ 8254                  ; Speaker ON
  36+ 8254 3A 22 E7         ld   a, (room_border_color)
  37+ 8257 F6 10            or   $10
  38+ 8259 D3 FE            out  ($fe), a
  39+ 825B 4A               ld   c, d
  40+ 825C              .d1:
  41+ 825C 0D               dec  c
  42+ 825D 20 FD            jr   nz, .d1
  43+ 825F
  44+ 825F                  ; Speaker OFF
  45+ 825F 3A 22 E7         ld   a, (room_border_color)
  46+ 8262 E6 EF            and  $ef
  47+ 8264 D3 FE            out  ($fe), a
  48+ 8266 4A               ld   c, d
  49+ 8267              .d2:
  50+ 8267 0D               dec  c
  51+ 8268 20 FD            jr   nz, .d2
  52+ 826A
  53+ 826A 10 E8            djnz .note_loop
  54+ 826C
  55+ 826C                  ; Passa alla nota successiva
  56+ 826C 3A 29 EB         ld   a, (Audio_jump_sound_note)
  57+ 826F 3C               inc  a
  58+ 8270 32 29 EB         ld   (Audio_jump_sound_note), a
  59+ 8273
  60+ 8273              .done:
  61+ 8273 E1               pop  hl
  62+ 8274 D1               pop  de
  63+ 8275 C1               pop  bc
  64+ 8276 F1               pop  af
  65+ 8277 C9               ret
  66+ 8278
  67+ 8278              Audio_JumpSoundDelays:
  68+ 8278 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 827C 19 13 0C 06
  68+ 8280 0C 13 19 20
  68+ 8284 26 2D 33 3A
  68+ 8288 40 47
  69+ 828A
