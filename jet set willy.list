 150+ 6C4B 2A 21 7E         ld   hl, (room_ptr)
 151+ 6C4E 11 08 87         ld   de, TheDriveLayout
 152+ 6C51 B7               or   a
 153+ 6C52 ED 52            sbc  hl, de
 154+ 6C54 20 04            jr   nz, .not_thedrive
 155+ 6C56
 156+ 6C56 3E 04            ld   a, 4               ; Room ID = 4
 157+ 6C58 18 2F            jr   .set_room
 158+ 6C5A
 159+ 6C5A              .not_thedrive:
 160+ 6C5A
 161+ 6C5A                  ; ---------------------------------------------------------------
