   6+ 651C              ; MovePlayer
   7+ 651C              ;
   8+ 651C              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 651C              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 651C              ; con i muri.
  11+ 651C              ;
  12+ 651C              ; Input:
  13+ 651C              ;   D = stato dei controlli (bitfield)
  14+ 651C              ;
  15+ 651C              ; Strutture utilizzate:
  16+ 651C              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 651C              ;   player_speed    -> velocità orizzontale
  18+ 651C              ;   flags           -> flag di stato input
  19+ 651C              ;
  20+ 651C              ; Bit controlli:
  21+ 651C              ;   bit 0 = sinistra
  22+ 651C              ;   bit 1 = destra
  23+ 651C              ;
  24+ 651C              ; Nota:
  25+ 651C              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 651C              ;   ignorato per tutta la durata del salto.
  27+ 651C              ;
  28+ 651C              ; Output:
  29+ 651C              ;   aggiorna PlayerPos e body_state
  30+ 651C              ; -------------------------------------------------------------------
  31+ 651C              MovePlayer:
  32+ 651C
  33+ 651C                  ; ---------------------------------------------------------------
  34+ 651C                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 651C                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 651C                  ; tasti di direzione premuti (jump_dir decide).
  37+ 651C                  ; ---------------------------------------------------------------
  38+ 651C 3A 94 7A         ld   a, (on_ground)
  39+ 651F B7               or   a
  40+ 6520 20 1A            jr   nz, .on_ground_check
  41+ 6522
  42+ 6522 3A 98 7A         ld   a, (jump_dir)
  43+ 6525 B7               or   a
  44+ 6526 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6527
  46+ 6527                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6527 DD 21 8A 7A      ld   ix, flags
  48+ 652B DD CB 00 86      res  $00, (ix)
  49+ 652F
  50+ 652F ED 4B 82 7A      ld   bc, (PlayerPos)
