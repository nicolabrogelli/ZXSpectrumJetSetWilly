 722+ 6A16              ; Verifica se Willy si trova sopra un blocco Conveyor attivo
 723+ 6A16              ; Output: Carry flag impostato se Willy è sul conveyor, altrimenti resettato
 724+ 6A16              ; -------------------------------------------------------------------
 725+ 6A16              CheckWillyOnConveyor:
 726+ 6A16 C5               push bc
 727+ 6A17 D5               push de
 728+ 6A18 E5               push hl
 729+ 6A19
 730+ 6A19 3A F9 73         ld   a, (on_ground)
 731+ 6A1C B7               or   a
 732+ 6A1D 28 44            jr   z, .not_on_conveyor
 733+ 6A1F
 734+ 6A1F 3A 04 77         ld   a, (conveyor_len)
 735+ 6A22 B7               or   a
 736+ 6A23 28 3E            jr   z, .not_on_conveyor
 737+ 6A25
 738+ 6A25 ED 4B EB 73      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 739+ 6A29
 740+ 6A29                  ; Calcola screenRow dei piedi del player: RowPiedi = (Y + 16) / 8
 741+ 6A29 78               ld   a, b
 742+ 6A2A C6 10            add  a, 16
 743+ 6A2C CB 3F            srl  a
 744+ 6A2E CB 3F            srl  a
 745+ 6A30 CB 3F            srl  a                 ; A = (Y + 16) / 8
 746+ 6A32
 747+ 6A32                  ; Confronta con conveyor_row
 748+ 6A32 57               ld   d, a              ; D = RowPiedi
 749+ 6A33 3A 05 77         ld   a, (conveyor_row)
 750+ 6A36 BA               cp   d
 751+ 6A37 20 2A            jr   nz, .not_on_conveyor
 752+ 6A39
 753+ 6A39                  ; ColStart = WillyX / 8
 754+ 6A39 79               ld   a, c
 755+ 6A3A CB 3F            srl  a
 756+ 6A3C CB 3F            srl  a
 757+ 6A3E CB 3F            srl  a                 ; A = ColStart
 758+ 6A40 5F               ld   e, a              ; E = ColStart
 759+ 6A41
 760+ 6A41                  ; ColEnd = (WillyX + 7) / 8
 761+ 6A41 79               ld   a, c
 762+ 6A42 C6 07            add  a, 7
 763+ 6A44 CB 3F            srl  a
 764+ 6A46 CB 3F            srl  a
 765+ 6A48 CB 3F            srl  a                 ; A = ColEnd
 766+ 6A4A 57               ld   d, a              ; D = ColEnd
 767+ 6A4B
 768+ 6A4B                  ; conveyor_col_end = conveyor_col + conveyor_len - 1
 769+ 6A4B 3A 06 77         ld   a, (conveyor_col)
 770+ 6A4E 21 04 77         ld   hl, conveyor_len
 771+ 6A51 86               add  a, (hl)
 772+ 6A52 3D               dec  a                 ; A = conveyor_col_end
 773+ 6A53
 774+ 6A53                  ; E <= conveyor_col_end (conveyor_col_end >= E)
 775+ 6A53 BB               cp   e
 776+ 6A54 38 0D            jr   c, .not_on_conveyor
 777+ 6A56
 778+ 6A56                  ; D >= conveyor_col
 779+ 6A56 3A 06 77         ld   a, (conveyor_col)
 780+ 6A59 5F               ld   e, a
 781+ 6A5A 7A               ld   a, d
 782+ 6A5B BB               cp   e
 783+ 6A5C 38 05            jr   c, .not_on_conveyor
 784+ 6A5E
