 231+ 6A88              ; -------------------------------------------------------------------
 232+ 6A88              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 233+ 6A88              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 234+ 6A88              ; -------------------------------------------------------------------
 235+ 6A88              DrawItemGraphic:
 236+ 6A88 C5               push bc
 237+ 6A89 D5               push de
 238+ 6A8A E5               push hl
 239+ 6A8B
 240+ 6A8B                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 241+ 6A8B 78               ld   a, b
 242+ 6A8C E6 18            and  $18
 243+ 6A8E C6 40            add  a, $40
 244+ 6A90 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 245+ 6A91
 246+ 6A91 78               ld   a, b
 247+ 6A92 E6 07            and  7
 248+ 6A94 87               add  a, a              ; *2
 249+ 6A95 87               add  a, a              ; *4
 250+ 6A96 87               add  a, a              ; *8
 251+ 6A97 87               add  a, a              ; *16
 252+ 6A98 87               add  a, a              ; *32
 253+ 6A99 81               add  a, c              ; + Col C
 254+ 6A9A 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 255+ 6A9B
 256+ 6A9B                  ; 2. Copia gli 8 byte del bitmap dello sprite
 257+ 6A9B C5               push bc                ; Salva BC (contiene Row e Col)
 258+ 6A9C 06 08            ld   b, 8              ; 8 scanline
 259+ 6A9E              .line_loop:
 260+ 6A9E 7E               ld   a, (hl)
 261+ 6A9F 12               ld   (de), a
 262+ 6AA0 14               inc  d                 ; Prossima scanline
 263+ 6AA1 23               inc  hl
 264+ 6AA2 05               dec  b
 265+ 6AA3 20 F9            jr   nz, .line_loop
 266+ 6AA5 C1               pop  bc                ; Ripristina BC
 267+ 6AA6
 268+ 6AA6                  ; 3. Calcola l'indirizzo degli attributi dello schermo
 269+ 6AA6                  ; HL = $5800 + B * 32 + C
 270+ 6AA6 26 00            ld   h, 0
 271+ 6AA8 68               ld   l, b              ; HL = B (Row)
 272+ 6AA9 29               add  hl, hl            ; *2
 273+ 6AAA 29               add  hl, hl            ; *4
 274+ 6AAB 29               add  hl, hl            ; *8
 275+ 6AAC 29               add  hl, hl            ; *16
 276+ 6AAD 29               add  hl, hl            ; *32
 277+ 6AAE
 278+ 6AAE 79               ld   a, c              ; A = Col
 279+ 6AAF 85               add  a, l
 280+ 6AB0 6F               ld   l, a
 281+ 6AB1 30 01            jr   nc, .no_carry
 282+ 6AB3 24               inc  h
 283+ 6AB4              .no_carry:
 284+ 6AB4                  ; HL = B * 32 + C
 285+ 6AB4 11 00 58         ld   de, $5800
 286+ 6AB7 19               add  hl, de            ; HL = AttrAddr
 287+ 6AB8
 288+ 6AB8                  ; Ripristina i registri dallo stack per estrarre il colore in E
 289+ 6AB8                  ; Lo stack ha: HL (originale), DE (originale con colore in E), BC (originale)
 290+ 6AB8 C1               pop  bc                ; BC = HL originale
 291+ 6AB9 D1               pop  de                ; DE = DE originale (colore in E)
 292+ 6ABA
 293+ 6ABA 7B               ld   a, e              ; A = Colore
 294+ 6ABB 77               ld   (hl), a           ; Scrivi in memoria attributi (HL)
 295+ 6ABC
 296+ 6ABC                  ; Ripristina lo stack e i registri originari
 297+ 6ABC C5               push bc                ; Rimetti HL originale sulla pila
 298+ 6ABD E1               pop  hl                ; HL = HL originale
 299+ 6ABE C1               pop  bc                ; BC = BC originale
 300+ 6ABF C9               ret
 301+ 6AC0
 302+ 6AC0              ; -------------------------------------------------------------------
 303+ 6AC0              ; Ripristina la cella dello sfondo originale per cancellare l'item
 304+ 6AC0              ; Input: B = Row (3..18), C = Col (0..31)
 305+ 6AC0              ; -------------------------------------------------------------------
 306+ 6AC0              RestoreBackgroundCell:
 307+ 6AC0 FD E5            push iy                ; Preserva IY
 308+ 6AC2 C5               push bc
 309+ 6AC3 D5               push de
 310+ 6AC4 E5               push hl
 311+ 6AC5 DD E5            push ix
 312+ 6AC7
 313+ 6AC7 C5               push bc
 314+ 6AC8 FD E1            pop  iy                ; IY = original BC (IYH = Row, IYL = Col)
 315+ 6ACA
 316+ 6ACA                  ; Riga di layout: r = B - 3
 317+ 6ACA 78               ld   a, b
 318+ 6ACB D6 03            sub  3                 ; A = r (0..15)
 319+ 6ACD
 320+ 6ACD                  ; Colonna: c = C (Col)
 321+ 6ACD CD AD 66         call GetCellFromUnpacked ; A = cell type (0..3)
 322+ 6AD0
 323+ 6AD0 ED 5B 82 79      ld   de, (room_ptr)
 324+ 6AD4 B7               or   a
 325+ 6AD5 20 06            jr   nz, .not_bg
 326+ 6AD7 21 A0 00         ld   hl, OFFSET_BG
 327+ 6ADA 19               add  hl, de
 328+ 6ADB 18 16            jr   .draw_cell
 329+ 6ADD              .not_bg:
 330+ 6ADD 3D               dec  a
 331+ 6ADE 20 06            jr   nz, .not_floor
 332+ 6AE0 21 A9 00         ld   hl, OFFSET_FLOOR
 333+ 6AE3 19               add  hl, de
 334+ 6AE4 18 0D            jr   .draw_cell
 335+ 6AE6              .not_floor:
 336+ 6AE6 3D               dec  a
 337+ 6AE7 20 06            jr   nz, .not_wall
 338+ 6AE9 21 B2 00         ld   hl, OFFSET_WALL
 339+ 6AEC 19               add  hl, de
 340+ 6AED 18 04            jr   .draw_cell
 341+ 6AEF              .not_wall:
 342+ 6AEF 21 BB 00         ld   hl, OFFSET_NASTY
 343+ 6AF2 19               add  hl, de
