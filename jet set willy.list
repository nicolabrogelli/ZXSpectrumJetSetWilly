 366+ 71BF              .set_room:
 367+ 71BF
 368+ 71BF                  ; Salva l'ID della stanza corrente
 369+ 71BF 32 C0 76         ld   (current_room), a
 370+ 71C2
 371+ 71C2                  ; Ripristina i registri
 372+ 71C2 D1               pop  de
 373+ 71C3 E1               pop  hl
 374+ 71C4
 375+ 71C4 C9               ret
 376+ 71C5
 377+ 71C5              ; -------------------------------------------------------------------
 378+ 71C5              ; DrawRoomItems
 379+ 71C5              ;
 380+ 71C5              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 381+ 71C5              ;
 382+ 71C5              ; Operazioni eseguite:
 383+ 71C5              ;   1. Azzera la griglia items_grid.
 384+ 71C5              ;   2. Svuota la cache degli oggetti attivi.
 385+ 71C5              ;   3. Scansiona ItemsTable.
 386+ 71C5              ;   4. Per ogni item della stanza corrente:
 387+ 71C5              ;        - verifica se è già stato raccolto
 388+ 71C5              ;        - disegna la grafica
 389+ 71C5              ;        - aggiorna items_grid
 390+ 71C5              ;        - memorizza l'item nella cache current_room_items
 391+ 71C5              ;   5. Aggiorna num_room_items.
 392+ 71C5              ;
 393+ 71C5              ; Record ItemsTable:
 394+ 71C5              ;   +0  Room ID
 395+ 71C5              ;   +1  X (colonna)
 396+ 71C5              ;   +2  Y (riga)
 397+ 71C5              ;   +3  Colore
 398+ 71C5              ;   +4  Collected flag
 399+ 71C5              ;
 400+ 71C5              ; Cache current_room_items:
 401+ 71C5              ;   +0  Colonna
 402+ 71C5              ;   +1  Riga
 403+ 71C5              ;   +2  Colore
 404+ 71C5              ;   +3  Collected flag ptr (Low)
 405+ 71C5              ;   +4  Collected flag ptr (High)
 406+ 71C5              ;
 407+ 71C5              ; Ogni record cache occupa 5 byte.
 408+ 71C5              ; -------------------------------------------------------------------
 409+ 71C5              DrawRoomItems:
 410+ 71C5
 411+ 71C5                  ; Salva tutti i registri utilizzati
 412+ 71C5 E5               push hl
 413+ 71C6 D5               push de
 414+ 71C7 C5               push bc
 415+ 71C8 DD E5            push ix
 416+ 71CA FD E5            push iy
 417+ 71CC
 418+ 71CC                  ; ---------------------------------------------------------------
 419+ 71CC                  ; Azzera items_grid (32 x 16 = 512 byte)
 420+ 71CC                  ; ---------------------------------------------------------------
 421+ 71CC 21 00 A5         ld   hl, items_grid
 422+ 71CF 11 01 A5         ld   de, items_grid + 1
 423+ 71D2 36 00            ld   (hl), 0
 424+ 71D4 01 FF 01         ld   bc, 511
 425+ 71D7 ED B0            ldir
 426+ 71D9
 427+ 71D9                  ; ---------------------------------------------------------------
 428+ 71D9                  ; Nessun item attivo nella stanza
 429+ 71D9                  ; ---------------------------------------------------------------
 430+ 71D9 AF               xor  a
 431+ 71DA 32 19 77         ld   (num_room_items), a
 432+ 71DD
 433+ 71DD                  ; IY punta alla cache degli item attivi
 434+ 71DD FD 21 C9 76      ld   iy, current_room_items
 435+ 71E1
 436+ 71E1                  ; ---------------------------------------------------------------
 437+ 71E1                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 438+ 71E1                  ; alla stanza corrente.
 439+ 71E1                  ;
 440+ 71E1                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 441+ 71E1                  ; ---------------------------------------------------------------
 442+ 71E1 2A 1A 77         ld   hl, (room_ptr)
 443+ 71E4 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 444+ 71E7 19               add  hl, de
 445+ 71E8
 446+ 71E8 E5               push hl
 447+ 71E9 DD E1            pop  ix                ; IX = bitmap item
 448+ 71EB
 449+ 71EB                  ; ---------------------------------------------------------------
 450+ 71EB                  ; Inizio scansione della tabella degli item
 451+ 71EB                  ; ---------------------------------------------------------------
 452+ 71EB 21 35 70         ld   hl, ItemsTable
 453+ 71EE
 454+ 71EE              .loop:
 455+ 71EE
 456+ 71EE                  ; ---------------------------------------------------------------
 457+ 71EE                  ; Legge il Room ID del record corrente
 458+ 71EE                  ; ---------------------------------------------------------------
 459+ 71EE 7E               ld   a, (hl)
 460+ 71EF
 461+ 71EF                  ; $FF indica fine tabella
 462+ 71EF FE FF            cp   $FF
 463+ 71F1 28 53            jr   z, .done
 464+ 71F3
 465+ 71F3                  ; ---------------------------------------------------------------
 466+ 71F3                  ; Verifica se l'item appartiene alla stanza corrente
 467+ 71F3                  ; ---------------------------------------------------------------
 468+ 71F3 57               ld   d, a
 469+ 71F4
 470+ 71F4 3A C0 76         ld   a, (current_room)
 471+ 71F7 BA               cp   d
 472+ 71F8 20 45            jr   nz, .next_item
 473+ 71FA
 474+ 71FA                  ; ---------------------------------------------------------------
 475+ 71FA                  ; Legge i dati dell'item
 476+ 71FA                  ; ---------------------------------------------------------------
 477+ 71FA
 478+ 71FA 23               inc  hl
 479+ 71FB 4E               ld   c, (hl)           ; X (colonna)
 480+ 71FC
 481+ 71FC 23               inc  hl
 482+ 71FD 46               ld   b, (hl)           ; Y (riga)
 483+ 71FE
 484+ 71FE 23               inc  hl
 485+ 71FF 5E               ld   e, (hl)           ; Colore
 486+ 7200
 487+ 7200 23               inc  hl
 488+ 7201 7E               ld   a, (hl)           ; Collected flag
 489+ 7202
 490+ 7202                  ; Se diverso da zero l'item è già stato raccolto
 491+ 7202 B7               or   a
 492+ 7203 20 3E            jr   nz, .next_no_inc
 493+ 7205
 494+ 7205                  ; ---------------------------------------------------------------
 495+ 7205                  ; Disegna l'item sullo schermo
 496+ 7205                  ;
 497+ 7205                  ; B = Row
 498+ 7205                  ; C = Column
 499+ 7205                  ; HL = bitmap pointer
 500+ 7205                  ; E = Color
 501+ 7205                  ; ---------------------------------------------------------------
 502+ 7205 E5               push hl
 503+ 7206
 504+ 7206 DD E5            push ix
 505+ 7208 E1               pop  hl
 506+ 7209
 507+ 7209 CD 4E 72         call DrawItemGraphic
 508+ 720C
 509+ 720C E1               pop  hl                ; ritorna al flag collected
 510+ 720D
 511+ 720D                  ; ---------------------------------------------------------------
 512+ 720D                  ; Aggiorna items_grid
 513+ 720D                  ;
 514+ 720D                  ; Calcolo:
 515+ 720D                  ;   offset = Row * 32 + Col
 516+ 720D                  ; ---------------------------------------------------------------
 517+ 720D E5               push hl
 518+ 720E D5               push de
 519+ 720F
 520+ 720F 26 00            ld   h, 0
 521+ 7211 68               ld   l, b              ; HL = Row
 522+ 7212
 523+ 7212 29               add  hl, hl            ; *2
 524+ 7213 29               add  hl, hl            ; *4
 525+ 7214 29               add  hl, hl            ; *8
 526+ 7215 29               add  hl, hl            ; *16
 527+ 7216 29               add  hl, hl            ; *32
 528+ 7217
 529+ 7217 16 00            ld   d, 0
 530+ 7219 59               ld   e, c              ; DE = Col
 531+ 721A
 532+ 721A 19               add  hl, de            ; Row*32 + Col
 533+ 721B
 534+ 721B 11 00 A5         ld   de, items_grid
 535+ 721E 19               add  hl, de            ; puntatore nella griglia
 536+ 721F
 537+ 721F D1               pop  de                ; ripristina colore
 538+ 7220
 539+ 7220 73               ld   (hl), e           ; salva colore cella
 540+ 7221
 541+ 7221 E1               pop  hl
 542+ 7222
 543+ 7222                  ; ---------------------------------------------------------------
 544+ 7222                  ; Salva l'item nella cache della stanza
 545+ 7222                  ;
 546+ 7222                  ; Questo evita di dover scansionare tutta ItemsTable
 547+ 7222                  ; durante il controllo delle collisioni.
 548+ 7222                  ; ---------------------------------------------------------------
 549+ 7222
 550+ 7222 FD 71 00         ld   (iy+0), c         ; Colonna
 551+ 7225 FD 70 01         ld   (iy+1), b         ; Riga
 552+ 7228 FD 73 02         ld   (iy+2), e         ; Colore
 553+ 722B
 554+ 722B                  ; Salva il puntatore al flag "collected"
 555+ 722B FD 75 03         ld   (iy+3), l         ; Low byte
 556+ 722E FD 74 04         ld   (iy+4), h         ; High byte
 557+ 7231
 558+ 7231                  ; Passa al record successivo della cache
 559+ 7231 01 05 00         ld   bc, 5
 560+ 7234 FD 09            add  iy, bc
 561+ 7236
 562+ 7236                  ; Incrementa il numero di item attivi
 563+ 7236 3A 19 77         ld   a, (num_room_items)
 564+ 7239 3C               inc  a
 565+ 723A 32 19 77         ld   (num_room_items), a
 566+ 723D
 567+ 723D 18 04            jr   .next_no_inc
 568+ 723F
 569+ 723F              .next_item:
 570+ 723F
 571+ 723F                  ; ---------------------------------------------------------------
 572+ 723F                  ; L'item non appartiene alla stanza corrente.
 573+ 723F                  ; Salta i campi del record:
 574+ 723F                  ;   X
 575+ 723F                  ;   Y
 576+ 723F                  ;   Color
 577+ 723F                  ;   Collected
 578+ 723F                  ; ---------------------------------------------------------------
 579+ 723F 23               inc  hl
 580+ 7240 23               inc  hl
 581+ 7241 23               inc  hl
 582+ 7242 23               inc  hl
 583+ 7243
 584+ 7243              .next_no_inc:
 585+ 7243
 586+ 7243                  ; ---------------------------------------------------------------
 587+ 7243                  ; Avanza al record successivo
 588+ 7243                  ; (prossimo Room ID)
 589+ 7243                  ; ---------------------------------------------------------------
 590+ 7243 23               inc  hl
 591+ 7244 18 A8            jr   .loop
 592+ 7246
 593+ 7246              .done:
 594+ 7246
 595+ 7246                  ; Ripristina i registri
 596+ 7246 FD E1            pop  iy
 597+ 7248 DD E1            pop  ix
 598+ 724A D1               pop  de
 599+ 724B C1               pop  bc
 600+ 724C E1               pop  hl
 601+ 724D
 602+ 724D C9               ret
 603+ 724E
 604+ 724E              ; -------------------------------------------------------------------
 605+ 724E              ; DrawItemGraphic
 606+ 724E              ;
 607+ 724E              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 608+ 724E              ; utilizzando una bitmap di 8 byte e un attributo colore.
 609+ 724E              ;
 610+ 724E              ; Input:
 611+ 724E              ;   B = Riga attributi (3..18)
 612+ 724E              ;   C = Colonna attributi (0..31)
 613+ 724E              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 614+ 724E              ;   E = Attributo colore
 615+ 724E              ;
 616+ 724E              ; Output:
 617+ 724E              ;   Nessuno
 618+ 724E              ;
 619+ 724E              ; Registri preservati:
 620+ 724E              ;   BC, DE, HL
 621+ 724E              ; -------------------------------------------------------------------
 622+ 724E              DrawItemGraphic:
 623+ 724E
 624+ 724E                  ; Salva i registri originali
 625+ 724E C5               push bc
 626+ 724F D5               push de
 627+ 7250 E5               push hl
 628+ 7251
 629+ 7251                  ; ---------------------------------------------------------------
 630+ 7251                  ; Calcolo indirizzo bitmap dello Spectrum
 631+ 7251                  ;
 632+ 7251                  ; Ogni item occupa una cella attributi (8x8 pixel).
 633+ 7251                  ;
 634+ 7251                  ; Formula:
 635+ 7251                  ;   High = $40 + (Row AND $18)
 636+ 7251                  ;   Low  = (Row AND 7) * 32 + Col
 637+ 7251                  ;
 638+ 7251                  ; DE conterrà l'indirizzo della prima scanline.
 639+ 7251                  ; ---------------------------------------------------------------
 640+ 7251
 641+ 7251 78               ld   a, b
 642+ 7252 E6 18            and  $18
 643+ 7254 C6 40            add  a, $40
 644+ 7256 57               ld   d, a              ; Byte alto indirizzo video
 645+ 7257
 646+ 7257 78               ld   a, b
 647+ 7258 E6 07            and  7                 ; Riga interna al blocco da 8
 648+ 725A
 649+ 725A 87               add  a, a              ; *2
 650+ 725B 87               add  a, a              ; *4
 651+ 725C 87               add  a, a              ; *8
 652+ 725D 87               add  a, a              ; *16
 653+ 725E 87               add  a, a              ; *32
 654+ 725F
 655+ 725F 81               add  a, c              ; + colonna
 656+ 7260
 657+ 7260 5F               ld   e, a              ; Byte basso indirizzo video
 658+ 7261
 659+ 7261                  ; ---------------------------------------------------------------
 660+ 7261                  ; Disegno bitmap
 661+ 7261                  ;
 662+ 7261                  ; Copia 8 byte consecutivi nella memoria video.
 663+ 7261                  ; Ogni byte rappresenta una scanline da 8 pixel.
 664+ 7261                  ; ---------------------------------------------------------------
 665+ 7261
 666+ 7261 C5               push bc                ; Conserva Row e Col
 667+ 7262
 668+ 7262 06 08            ld   b, 8              ; Numero scanline
 669+ 7264
 670+ 7264              .line_loop:
 671+ 7264
 672+ 7264 7E               ld   a, (hl)           ; Legge scanline bitmap
 673+ 7265 12               ld   (de), a           ; Scrive nella memoria video
 674+ 7266
 675+ 7266 14               inc  d                 ; Scanline successiva
 676+ 7267 23               inc  hl                ; Byte bitmap successivo
 677+ 7268
 678+ 7268 05               dec  b
 679+ 7269 20 F9            jr   nz, .line_loop
 680+ 726B
 681+ 726B C1               pop  bc                ; Ripristina Row e Col
 682+ 726C
 683+ 726C                  ; ---------------------------------------------------------------
 684+ 726C                  ; Calcolo indirizzo attributo
 685+ 726C                  ;
 686+ 726C                  ; Formula:
 687+ 726C                  ;   AttrAddr = $5800 + Row * 32 + Col
 688+ 726C                  ;
 689+ 726C                  ; HL conterrà l'indirizzo della cella attributi.
 690+ 726C                  ; ---------------------------------------------------------------
 691+ 726C
 692+ 726C 26 00            ld   h, 0
 693+ 726E 68               ld   l, b              ; HL = Row
 694+ 726F
 695+ 726F 29               add  hl, hl            ; *2
 696+ 7270 29               add  hl, hl            ; *4
 697+ 7271 29               add  hl, hl            ; *8
 698+ 7272 29               add  hl, hl            ; *16
 699+ 7273 29               add  hl, hl            ; *32
 700+ 7274
 701+ 7274 79               ld   a, c              ; A = Colonna
 702+ 7275
 703+ 7275 85               add  a, l
 704+ 7276 6F               ld   l, a
 705+ 7277
 706+ 7277 30 01            jr   nc, .no_carry
 707+ 7279 24               inc  h
 708+ 727A
 709+ 727A              .no_carry:
 710+ 727A
 711+ 727A                  ; HL = Row * 32 + Col
 712+ 727A
 713+ 727A 11 00 58         ld   de, $5800
 714+ 727D 19               add  hl, de            ; HL = indirizzo attributi
 715+ 727E
 716+ 727E                  ; ---------------------------------------------------------------
 717+ 727E                  ; Recupera il colore originale dallo stack.
 718+ 727E                  ;
 719+ 727E                  ; Layout stack:
 720+ 727E                  ;   HL originale
 721+ 727E                  ;   DE originale (E = colore)
 722+ 727E                  ;   BC originale
 723+ 727E                  ; ---------------------------------------------------------------
 724+ 727E
 725+ 727E C1               pop  bc                ; Recupera HL originale
 726+ 727F D1               pop  de                ; Recupera DE originale
 727+ 7280
 728+ 7280                  ; ---------------------------------------------------------------
 729+ 7280                  ; Scrive l'attributo colore
 730+ 7280                  ; ---------------------------------------------------------------
 731+ 7280
 732+ 7280 7B               ld   a, e              ; A = colore
 733+ 7281 77               ld   (hl), a           ; Scrive nella RAM attributi
 734+ 7282
 735+ 7282                  ; ---------------------------------------------------------------
 736+ 7282                  ; Ripristina HL e BC originali
 737+ 7282                  ; ---------------------------------------------------------------
 738+ 7282
 739+ 7282 C5               push bc
 740+ 7283 E1               pop  hl                ; HL originale
 741+ 7284
 742+ 7284 C1               pop  bc                ; BC originale
 743+ 7285
 744+ 7285 C9               ret
 745+ 7286
 746+ 7286              ; -------------------------------------------------------------------
 747+ 7286              ; RestoreBackgroundCell
 748+ 7286              ;
 749+ 7286              ; Ripristina il contenuto originale di una cella della stanza.
 750+ 7286              ; Viene utilizzata principalmente quando un item viene raccolto:
 751+ 7286              ; invece di lasciare un "buco", la routine ridisegna il tile
 752+ 7286              ; originale presente nella mappa della stanza.
 753+ 7286              ;
 754+ 7286              ; Input:
 755+ 7286              ;   B = Row (3..18)
 756+ 7286              ;   C = Col (0..31)
 757+ 7286              ;
 758+ 7286              ; Utilizza:
 759+ 7286              ;   room_ptr -> struttura dati della stanza corrente
 760+ 7286              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 761+ 7286              ;   DrawTile -> ridisegna il tile selezionato
 762+ 7286              ;
 763+ 7286              ; Tipi di cella:
 764+ 7286              ;   0 = Background
 765+ 7286              ;   1 = Floor
 766+ 7286              ;   2 = Wall
 767+ 7286              ;   3 = Nasty
 768+ 7286              ; -------------------------------------------------------------------
 769+ 7286              RestoreBackgroundCell:
 770+ 7286
 771+ 7286                  ; Salva tutti i registri utilizzati
 772+ 7286 FD E5            push iy
 773+ 7288 C5               push bc
 774+ 7289 D5               push de
 775+ 728A E5               push hl
 776+ 728B DD E5            push ix
 777+ 728D
 778+ 728D                  ; ---------------------------------------------------------------
 779+ 728D                  ; Conserva Row e Col in IY.
 780+ 728D                  ;
 781+ 728D                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 782+ 728D                  ; BC potrebbe essere modificato.
 783+ 728D                  ; ---------------------------------------------------------------
 784+ 728D C5               push bc
 785+ 728E FD E1            pop  iy                ; IYH = Row, IYL = Col
 786+ 7290
 787+ 7290                  ; ---------------------------------------------------------------
 788+ 7290                  ; Determina quale tipo di cella è presente nella posizione
 789+ 7290                  ; specificata.
 790+ 7290                  ;
 791+ 7290                  ; Input:
 792+ 7290                  ;   B = Row
 793+ 7290                  ;   C = Col
 794+ 7290                  ;
 795+ 7290                  ; Output:
 796+ 7290                  ;   A = tipo cella
 797+ 7290                  ; ---------------------------------------------------------------
 798+ 7290 78               ld   a, b
 799+ 7291
 800+ 7291 CD 61 6B         call GetCellFromUnpacked
 801+ 7294
 802+ 7294                  ; ---------------------------------------------------------------
 803+ 7294                  ; Recupera il puntatore alla stanza corrente.
 804+ 7294                  ;
 805+ 7294                  ; DE = base della struttura stanza
 806+ 7294                  ; ---------------------------------------------------------------
 807+ 7294 ED 5B 1A 77      ld   de, (room_ptr)
 808+ 7298
 809+ 7298                  ; ---------------------------------------------------------------
 810+ 7298                  ; Seleziona il tile corretto in base al tipo di cella.
 811+ 7298                  ;
 812+ 7298                  ; A = 0 -> Background
 813+ 7298                  ; A = 1 -> Floor
 814+ 7298                  ; A = 2 -> Wall
 815+ 7298                  ; A = 3 -> Nasty
 816+ 7298                  ; ---------------------------------------------------------------
 817+ 7298
 818+ 7298 B7               or   a
 819+ 7299 20 06            jr   nz, .not_bg
 820+ 729B
 821+ 729B                  ; Background
 822+ 729B 21 A0 00         ld   hl, OFFSET_BG
 823+ 729E 19               add  hl, de
 824+ 729F 18 16            jr   .draw_cell
 825+ 72A1
 826+ 72A1              .not_bg:
 827+ 72A1
 828+ 72A1 3D               dec  a
 829+ 72A2 20 06            jr   nz, .not_floor
 830+ 72A4
 831+ 72A4                  ; Floor
 832+ 72A4 21 A9 00         ld   hl, OFFSET_FLOOR
 833+ 72A7 19               add  hl, de
 834+ 72A8 18 0D            jr   .draw_cell
 835+ 72AA
 836+ 72AA              .not_floor:
 837+ 72AA
 838+ 72AA 3D               dec  a
 839+ 72AB 20 06            jr   nz, .not_wall
 840+ 72AD
 841+ 72AD                  ; Wall
 842+ 72AD 21 B2 00         ld   hl, OFFSET_WALL
 843+ 72B0 19               add  hl, de
 844+ 72B1 18 04            jr   .draw_cell
 845+ 72B3
 846+ 72B3              .not_wall:
 847+ 72B3
 848+ 72B3                  ; Nasty
 849+ 72B3 21 BB 00         ld   hl, OFFSET_NASTY
 850+ 72B6 19               add  hl, de
 851+ 72B7
 852+ 72B7              .draw_cell:
 853+ 72B7
 854+ 72B7                  ; ---------------------------------------------------------------
 855+ 72B7                  ; HL punta ora alla grafica del tile da ridisegnare.
 856+ 72B7                  ;
 857+ 72B7                  ; DrawTile si aspetta:
 858+ 72B7                  ;   IX = puntatore tile
 859+ 72B7                  ;   B  = Row
 860+ 72B7                  ;   C  = Col
 861+ 72B7                  ; ---------------------------------------------------------------
 862+ 72B7 E5               push hl
 863+ 72B8 DD E1            pop  ix
 864+ 72BA
 865+ 72BA                  ; Ripristina Row e Col salvati in IY
 866+ 72BA FD E5            push iy
 867+ 72BC C1               pop  bc
 868+ 72BD
 869+ 72BD                  ; Disegna il tile originale
 870+ 72BD CD 8C 61         call DrawTile
 871+ 72C0
 872+ 72C0                  ; ---------------------------------------------------------------
 873+ 72C0                  ; Ripristina i registri salvati
 874+ 72C0                  ; ---------------------------------------------------------------
 875+ 72C0 DD E1            pop  ix
 876+ 72C2 E1               pop  hl
 877+ 72C3 D1               pop  de
 878+ 72C4 C1               pop  bc
 879+ 72C5 FD E1            pop  iy
 880+ 72C7
 881+ 72C7 C9               ret
 882+ 72C8
 883+ 72C8              ; -------------------------------------------------------------------
 884+ 72C8              ; CheckWillyItemCollision
 885+ 72C8              ;
 886+ 72C8              ; Verifica se Willy collide con un item utilizzando il controllo
 887+ 72C8              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 888+ 72C8              ;
 889+ 72C8              ; Input:
 890+ 72C8              ;   A = ItemX (colonna attributi 0..31)
 891+ 72C8              ;   H = ItemY (riga attributi 3..18)
 892+ 72C8              ;
 893+ 72C8              ; Coordinate item:
 894+ 72C8              ;   Ogni item occupa una cella da 8x8 pixel.
 895+ 72C8              ;
 896+ 72C8              ; Coordinate Willy:
 897+ 72C8              ;   Willy occupa un rettangolo di 16x16 pixel.
 898+ 72C8              ;
 899+ 72C8              ; Output:
 900+ 72C8              ;   Carry Set   = collisione rilevata
 901+ 72C8              ;   Carry Clear = nessuna collisione
 902+ 72C8              ;
 903+ 72C8              ; Registri preservati:
 904+ 72C8              ;   BC, DE, HL
 905+ 72C8              ; -------------------------------------------------------------------
 906+ 72C8              CheckWillyItemCollision:
 907+ 72C8
 908+ 72C8                  ; Salva i registri utilizzati
 909+ 72C8 C5               push bc
 910+ 72C9 D5               push de
 911+ 72CA E5               push hl
 912+ 72CB
 913+ 72CB                  ; ---------------------------------------------------------------
 914+ 72CB                  ; Calcola il bounding box orizzontale dell'item
 915+ 72CB                  ;
 916+ 72CB                  ; ItemLeft  = ItemX * 8
 917+ 72CB                  ; ItemRight = ItemLeft + 7
 918+ 72CB                  ;
 919+ 72CB                  ; E = ItemLeft
 920+ 72CB                  ; D = ItemRight
 921+ 72CB                  ; ---------------------------------------------------------------
 922+ 72CB 6F               ld   l, a              ; L = ItemX
 923+ 72CC
 924+ 72CC 7D               ld   a, l
 925+ 72CD 87               add  a, a              ; *2
 926+ 72CE 87               add  a, a              ; *4
 927+ 72CF 87               add  a, a              ; *8
 928+ 72D0
 929+ 72D0 5F               ld   e, a              ; E = ItemLeft
 930+ 72D1
 931+ 72D1 C6 07            add  a, 7
 932+ 72D3 57               ld   d, a              ; D = ItemRight
 933+ 72D4
 934+ 72D4                  ; ---------------------------------------------------------------
 935+ 72D4                  ; Recupera la posizione corrente di Willy
 936+ 72D4                  ;
 937+ 72D4                  ; B = WillyY
 938+ 72D4                  ; C = WillyX
 939+ 72D4                  ; ---------------------------------------------------------------
 940+ 72D4 ED 4B A9 73      ld   bc, (PlayerPos)
 941+ 72D8
 942+ 72D8                  ; ---------------------------------------------------------------
 943+ 72D8                  ; Primo test:
 944+ 72D8                  ;
 945+ 72D8                  ; WillyLeft <= ItemRight
 946+ 72D8                  ;
 947+ 72D8                  ; Se Willy è completamente a destra dell'item
 948+ 72D8                  ; non può esserci collisione.
 949+ 72D8                  ; ---------------------------------------------------------------
 950+ 72D8 79               ld   a, c              ; A = WillyLeft
 951+ 72D9
 952+ 72D9 BA               cp   d                 ; WillyLeft vs ItemRight
 953+ 72DA
 954+ 72DA 28 04            jr   z, .x_ok
 955+ 72DC 38 02            jr   c, .x_ok
 956+ 72DE
 957+ 72DE 18 29            jr   .no_collision
 958+ 72E0
 959+ 72E0              .x_ok:
 960+ 72E0
 961+ 72E0                  ; ---------------------------------------------------------------
 962+ 72E0                  ; Secondo test:
 963+ 72E0                  ;
 964+ 72E0                  ; WillyRight >= ItemLeft
 965+ 72E0                  ;
 966+ 72E0                  ; WillyRight = WillyX + 7
 967+ 72E0                  ; ---------------------------------------------------------------
 968+ 72E0 C6 07            add  a, 7
 969+ 72E2
 970+ 72E2 BB               cp   e                 ; WillyRight vs ItemLeft
 971+ 72E3
 972+ 72E3 28 04            jr   z, .y_check
 973+ 72E5 30 02            jr   nc, .y_check
 974+ 72E7
 975+ 72E7 18 20            jr   .no_collision
 976+ 72E9
 977+ 72E9              .y_check:
 978+ 72E9
 979+ 72E9                  ; ---------------------------------------------------------------
 980+ 72E9                  ; Recupera ItemY dal valore originale di HL
 981+ 72E9                  ;
 982+ 72E9                  ; H contiene la riga dell'item.
 983+ 72E9                  ; ---------------------------------------------------------------
 984+ 72E9 E1               pop  hl
 985+ 72EA E5               push hl
 986+ 72EB
 987+ 72EB                  ; ---------------------------------------------------------------
 988+ 72EB                  ; Calcola il bounding box verticale dell'item
 989+ 72EB                  ;
 990+ 72EB                  ; ItemTop    = ItemY * 8
 991+ 72EB                  ; ItemBottom = ItemTop + 7
 992+ 72EB                  ;
 993+ 72EB                  ; E = ItemTop
 994+ 72EB                  ; D = ItemBottom
 995+ 72EB                  ; ---------------------------------------------------------------
 996+ 72EB 7C               ld   a, h
 997+ 72EC
 998+ 72EC 87               add  a, a              ; *2
 999+ 72ED 87               add  a, a              ; *4
1000+ 72EE 87               add  a, a              ; *8
1001+ 72EF
1002+ 72EF 5F               ld   e, a              ; ItemTop
1003+ 72F0
1004+ 72F0 C6 07            add  a, 7
1005+ 72F2 57               ld   d, a              ; ItemBottom
1006+ 72F3
1007+ 72F3                  ; ---------------------------------------------------------------
1008+ 72F3                  ; Primo test verticale:
1009+ 72F3                  ;
1010+ 72F3                  ; WillyTop <= ItemBottom
1011+ 72F3                  ; ---------------------------------------------------------------
1012+ 72F3 78               ld   a, b              ; WillyTop
1013+ 72F4
1014+ 72F4 BA               cp   d
1015+ 72F5
1016+ 72F5 28 04            jr   z, .y_ok
1017+ 72F7 38 02            jr   c, .y_ok
1018+ 72F9
1019+ 72F9 18 0E            jr   .no_collision
1020+ 72FB
1021+ 72FB              .y_ok:
1022+ 72FB
1023+ 72FB                  ; ---------------------------------------------------------------
1024+ 72FB                  ; Secondo test verticale:
1025+ 72FB                  ;
1026+ 72FB                  ; WillyBottom >= ItemTop
1027+ 72FB                  ;
1028+ 72FB                  ; WillyBottom = WillyY + 15
1029+ 72FB                  ; ---------------------------------------------------------------
1030+ 72FB C6 0F            add  a, 15
1031+ 72FD
1032+ 72FD BB               cp   e
1033+ 72FE
1034+ 72FE 28 04            jr   z, .collision
1035+ 7300 30 02            jr   nc, .collision
1036+ 7302
1037+ 7302 18 05            jr   .no_collision
1038+ 7304
1039+ 7304              .collision:
1040+ 7304
1041+ 7304                  ; ---------------------------------------------------------------
1042+ 7304                  ; Collisione rilevata
1043+ 7304                  ; ---------------------------------------------------------------
1044+ 7304 E1               pop  hl
1045+ 7305 D1               pop  de
1046+ 7306 C1               pop  bc
1047+ 7307
1048+ 7307 37               scf                    ; Carry = 1
1049+ 7308
1050+ 7308 C9               ret
1051+ 7309
1052+ 7309              .no_collision:
1053+ 7309
1054+ 7309                  ; ---------------------------------------------------------------
1055+ 7309                  ; Nessuna collisione
1056+ 7309                  ; ---------------------------------------------------------------
1057+ 7309 E1               pop  hl
1058+ 730A D1               pop  de
1059+ 730B C1               pop  bc
1060+ 730C
1061+ 730C B7               or   a                 ; Carry = 0
1062+ 730D
1063+ 730D C9               ret
1064+ 730E
1065+ 730E              ; -------------------------------------------------------------------
1066+ 730E              ; CheckRoomItemsCollision
1067+ 730E              ;
1068+ 730E              ; Controlla se Willy entra in collisione con uno degli item
1069+ 730E              ; attivi presenti nella stanza corrente.
1070+ 730E              ;
1071+ 730E              ; Per ogni item:
1072+ 730E              ;   - verifica che appartenga alla stanza corrente
1073+ 730E              ;   - verifica che non sia già stato raccolto
1074+ 730E              ;   - esegue il test di collisione con Willy
1075+ 730E              ;
1076+ 730E              ; Se l'item viene raccolto:
1077+ 730E              ;   - imposta il flag "collected"
1078+ 730E              ;   - rimuove l'item dalla cache items_grid
1079+ 730E              ;   - incrementa il contatore degli oggetti raccolti
1080+ 730E              ;   - aggiorna l'HUD
1081+ 730E              ;   - ripristina il tile di sfondo
1082+ 730E              ;   - riproduce il suono di raccolta
1083+ 730E              ;
1084+ 730E              ; Formato record ItemsTable:
1085+ 730E              ;   +0 RoomID
1086+ 730E              ;   +1 X
1087+ 730E              ;   +2 Y
1088+ 730E              ;   +3 Color
1089+ 730E              ;   +4 Collected
1090+ 730E              ;
1091+ 730E              ; Fine tabella:
1092+ 730E              ;   RoomID = $FF
1093+ 730E              ; -------------------------------------------------------------------
1094+ 730E              CheckRoomItemsCollision:
1095+ 730E
1096+ 730E                  ; Salva i registri utilizzati
1097+ 730E E5               push hl
1098+ 730F D5               push de
1099+ 7310 C5               push bc
1100+ 7311
1101+ 7311                  ; Inizio scansione della tabella degli item
1102+ 7311 21 35 70         ld   hl, ItemsTable
1103+ 7314
1104+ 7314              .loop:
1105+ 7314
1106+ 7314                  ; ---------------------------------------------------------------
1107+ 7314                  ; Legge il Room ID dell'item corrente
1108+ 7314                  ; ---------------------------------------------------------------
1109+ 7314 7E               ld   a, (hl)
1110+ 7315
1111+ 7315                  ; $FF indica fine tabella
1112+ 7315 FE FF            cp   $FF
1113+ 7317 28 4D            jr   z, .done
1114+ 7319
1115+ 7319                  ; ---------------------------------------------------------------
1116+ 7319                  ; Verifica se l'item appartiene alla stanza corrente
1117+ 7319                  ; ---------------------------------------------------------------
1118+ 7319 57               ld   d, a              ; D = RoomID item
1119+ 731A
1120+ 731A 3A C0 76         ld   a, (current_room)
1121+ 731D BA               cp   d
1122+ 731E
1123+ 731E                  ; Se appartiene a un'altra stanza salta il record
1124+ 731E 20 3F            jr   nz, .next_item
1125+ 7320
1126+ 7320                  ; ---------------------------------------------------------------
1127+ 7320                  ; Legge coordinate e stato dell'item
1128+ 7320                  ; ---------------------------------------------------------------
1129+ 7320
1130+ 7320 23               inc  hl
1131+ 7321 4E               ld   c, (hl)           ; C = X
1132+ 7322
1133+ 7322 23               inc  hl
1134+ 7323 46               ld   b, (hl)           ; B = Y
1135+ 7324
1136+ 7324 23               inc  hl                ; salta Color
1137+ 7325
1138+ 7325 23               inc  hl                ; punta a Collected
1139+ 7326
1140+ 7326 7E               ld   a, (hl)
1141+ 7327
1142+ 7327                  ; ---------------------------------------------------------------
1143+ 7327                  ; Item già raccolto?
1144+ 7327                  ; ---------------------------------------------------------------
1145+ 7327 B7               or   a
1146+ 7328 20 39            jr   nz, .next_no_inc
1147+ 732A
1148+ 732A                  ; ---------------------------------------------------------------
1149+ 732A                  ; Test collisione Willy ↔ Item
1150+ 732A                  ;
1151+ 732A                  ; Input richiesto:
1152+ 732A                  ;   A = ItemX
1153+ 732A                  ;   H = ItemY
1154+ 732A                  ; ---------------------------------------------------------------
1155+ 732A 79               ld   a, c
1156+ 732B
1157+ 732B E5               push hl                ; salva puntatore al flag Collected
1158+ 732C
1159+ 732C 60               ld   h, b
1160+ 732D
1161+ 732D CD C8 72         call CheckWillyItemCollision
1162+ 7330
1163+ 7330 E1               pop  hl
1164+ 7331
1165+ 7331                  ; Nessuna collisione
1166+ 7331 30 30            jr   nc, .next_no_inc
1167+ 7333
1168+ 7333                  ; ===============================================================
1169+ 7333                  ; ITEM RACCOLTO
1170+ 7333                  ; ===============================================================
1171+ 7333
1172+ 7333                  ; ---------------------------------------------------------------
1173+ 7333                  ; Marca l'item come raccolto
1174+ 7333                  ; ---------------------------------------------------------------
1175+ 7333 36 01            ld   (hl), 1
1176+ 7335
1177+ 7335                  ; ---------------------------------------------------------------
1178+ 7335                  ; Rimuove l'item dalla cache items_grid
1179+ 7335                  ;
1180+ 7335                  ; Calcolo:
1181+ 7335                  ;   offset = Row * 32 + Col
1182+ 7335                  ; ---------------------------------------------------------------
1183+ 7335 E5               push hl
1184+ 7336 D5               push de
1185+ 7337
1186+ 7337 26 00            ld   h, 0
1187+ 7339 68               ld   l, b              ; HL = Row
1188+ 733A
1189+ 733A 29               add  hl, hl            ; *2
1190+ 733B 29               add  hl, hl            ; *4
1191+ 733C 29               add  hl, hl            ; *8
1192+ 733D 29               add  hl, hl            ; *16
1193+ 733E 29               add  hl, hl            ; *32
1194+ 733F
1195+ 733F 59               ld   e, c
1196+ 7340 16 00            ld   d, 0
1197+ 7342
1198+ 7342 19               add  hl, de            ; Row*32 + Col
1199+ 7343
1200+ 7343 11 00 A5         ld   de, items_grid
1201+ 7346 19               add  hl, de
1202+ 7347
1203+ 7347                  ; La cella non contiene più un item
1204+ 7347 36 00            ld   (hl), 0
1205+ 7349
1206+ 7349 D1               pop  de
1207+ 734A E1               pop  hl
1208+ 734B
1209+ 734B                  ; ---------------------------------------------------------------
1210+ 734B                  ; Conserva il puntatore all'entry corrente
1211+ 734B                  ; poiché le routine successive possono alterare HL.
1212+ 734B                  ; ---------------------------------------------------------------
1213+ 734B E5               push hl
1214+ 734C
1215+ 734C                  ; ---------------------------------------------------------------
1216+ 734C                  ; Aggiorna il numero di oggetti raccolti
1217+ 734C                  ; ---------------------------------------------------------------
1218+ 734C 3A B3 73         ld   a, (items_collected)
1219+ 734F
1220+ 734F 3C               inc  a
1221+ 7350
1222+ 7350 32 B3 73         ld   (items_collected), a
1223+ 7353
1224+ 7353                  ; ---------------------------------------------------------------
1225+ 7353                  ; Aggiorna il contatore visualizzato a schermo
1226+ 7353                  ; ---------------------------------------------------------------
1227+ 7353 CD CB 60         call UpdateItemsCollectedDisplay
1228+ 7356
1229+ 7356                  ; ---------------------------------------------------------------
1230+ 7356                  ; Ripristina il tile originale della stanza
1231+ 7356                  ; eliminando la grafica dell'item.
1232+ 7356                  ;
1233+ 7356                  ; Input:
1234+ 7356                  ;   B = Row
1235+ 7356                  ;   C = Col
1236+ 7356                  ; ---------------------------------------------------------------
1237+ 7356 CD 86 72         call RestoreBackgroundCell
1238+ 7359
1239+ 7359                  ; ---------------------------------------------------------------
1240+ 7359                  ; Riproduce il suono di raccolta
1241+ 7359                  ; ---------------------------------------------------------------
1242+ 7359 CD 6A 73         call PlayCollectSound
1243+ 735C
1244+ 735C                  ; Ripristina il puntatore alla tabella
1245+ 735C E1               pop  hl
1246+ 735D
1247+ 735D                  ; Continua con il record successivo
1248+ 735D 18 04            jr   .next_no_inc
1249+ 735F
1250+ 735F              .next_item:
1251+ 735F
1252+ 735F                  ; ---------------------------------------------------------------
1253+ 735F                  ; Salta i campi del record:
1254+ 735F                  ;   X
1255+ 735F                  ;   Y
1256+ 735F                  ;   Color
1257+ 735F                  ;   Collected
1258+ 735F                  ; ---------------------------------------------------------------
1259+ 735F 23               inc  hl
1260+ 7360 23               inc  hl
1261+ 7361 23               inc  hl
1262+ 7362 23               inc  hl
1263+ 7363
1264+ 7363              .next_no_inc:
1265+ 7363
1266+ 7363                  ; ---------------------------------------------------------------
1267+ 7363                  ; Avanza al record successivo.
1268+ 7363                  ;
1269+ 7363                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1270+ 7363                  ; ---------------------------------------------------------------
1271+ 7363 23               inc  hl
1272+ 7364
1273+ 7364 18 AE            jr   .loop
1274+ 7366
1275+ 7366              .done:
1276+ 7366
1277+ 7366                  ; Ripristina i registri
1278+ 7366 C1               pop  bc
1279+ 7367 D1               pop  de
1280+ 7368 E1               pop  hl
1281+ 7369
1282+ 7369 C9               ret
1283+ 736A
1284+ 736A              ; -------------------------------------------------------------------
1285+ 736A              ; PlayCollectSound
1286+ 736A              ;
1287+ 736A              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1288+ 736A              ; dello ZX Spectrum utilizzando il port $FE.
1289+ 736A              ;
1290+ 736A              ; Il suono viene prodotto alternando ON/OFF del bit 4
1291+ 736A              ; (speaker) con un semplice delay software.
1292+ 736A              ;
1293+ 736A              ; Effetto risultante:
1294+ 736A              ;   beep breve tipo "pickup item"
1295+ 736A              ; -------------------------------------------------------------------
1296+ 736A              PlayCollectSound:
1297+ 736A
1298+ 736A                  ; Salva registri utilizzati
1299+ 736A C5               push bc
1300+ 736B D5               push de
1301+ 736C
1302+ 736C                  ; ---------------------------------------------------------------
1303+ 736C                  ; Numero di cicli del beep (durata complessiva del suono)
1304+ 736C                  ; ---------------------------------------------------------------
1305+ 736C 06 78            ld   b, 120
1306+ 736E
1307+ 736E              .sound_loop:
1308+ 736E
1309+ 736E                  ; ---------------------------------------------------------------
1310+ 736E                  ; SPEAKER ON
1311+ 736E                  ;
1312+ 736E                  ; Legge il colore del bordo corrente e attiva il bit 4
1313+ 736E                  ; per pilotare lo speaker.
1314+ 736E                  ; ---------------------------------------------------------------
1315+ 736E 3A B5 73         ld   a, (room_border_color)
1316+ 7371 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1317+ 7373
1318+ 7373 D3 FE            out  ($fe), a         ; scrive sul port ULA
1319+ 7375
1320+ 7375                  ; ---------------------------------------------------------------
1321+ 7375                  ; Delay (mezzo periodo)
1322+ 7375                  ; Loop software a consumo CPU
1323+ 7375                  ; ---------------------------------------------------------------
1324+ 7375 0E 3C            ld   c, 60
1325+ 7377
1326+ 7377              .d1:
1327+ 7377 0D               dec  c
1328+ 7378 20 FD            jr   nz, .d1
1329+ 737A
1330+ 737A                  ; ---------------------------------------------------------------
1331+ 737A                  ; SPEAKER OFF
1332+ 737A                  ;
1333+ 737A                  ; Mantiene il colore del bordo ma disattiva lo speaker
1334+ 737A                  ; ---------------------------------------------------------------
1335+ 737A 3A B5 73         ld   a, (room_border_color)
1336+ 737D E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1337+ 737F
1338+ 737F D3 FE            out  ($fe), a
1339+ 7381
1340+ 7381                  ; ---------------------------------------------------------------
1341+ 7381                  ; Secondo delay (mezzo periodo)
1342+ 7381                  ; Completa l’onda quadra
1343+ 7381                  ; ---------------------------------------------------------------
1344+ 7381 0E 3C            ld   c, 60
1345+ 7383
1346+ 7383              .d2:
1347+ 7383 0D               dec  c
1348+ 7384 20 FD            jr   nz, .d2
1349+ 7386
1350+ 7386                  ; ---------------------------------------------------------------
1351+ 7386                  ; Ripete fino a completare il numero di cicli
1352+ 7386                  ; ---------------------------------------------------------------
1353+ 7386 10 E6            djnz .sound_loop
1354+ 7388
1355+ 7388                  ; Ripristina registri salvati
1356+ 7388 D1               pop  de
1357+ 7389 C1               pop  bc
1358+ 738A
1359+ 738A C9               ret
1360+ 738B
1361+ 738B              ; -------------------------------------------------------------------
1362+ 738B              ; CheckActiveItemAtCell
1363+ 738B              ;
1364+ 738B              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1365+ 738B              ; nella cella specificata della griglia items_grid.
1366+ 738B              ;
1367+ 738B              ; Questa routine usa una lookup diretta su una mappa 32x16,
1368+ 738B              ; evitando la scansione della ItemsTable.
1369+ 738B              ;
1370+ 738B              ; Input:
1371+ 738B              ;   B = Colonna (0..31)
1372+ 738B              ;   C = Riga (0..15)
1373+ 738B              ;
1374+ 738B              ; Output:
1375+ 738B              ;   Carry Set   = item presente nella cella
1376+ 738B              ;   Carry Clear = nessun item
1377+ 738B              ;
1378+ 738B              ; Nota:
1379+ 738B              ;   HL NON è restituito valido (commento originale non corretto:
1380+ 738B              ;   la routine non punta a ItemsTable).
1381+ 738B              ; -------------------------------------------------------------------
1382+ 738B              CheckActiveItemAtCell:
1383+ 738B
1384+ 738B                  ; Salva registri usati
1385+ 738B D5               push de
1386+ 738C E5               push hl
1387+ 738D
1388+ 738D                  ; ---------------------------------------------------------------
1389+ 738D                  ; Calcolo indice lineare nella griglia 32x16:
1390+ 738D                  ;
1391+ 738D                  ; offset = Row * 32 + Col
1392+ 738D                  ; ---------------------------------------------------------------
1393+ 738D 26 00            ld   h, 0
1394+ 738F 69               ld   l, c              ; HL = Row
1395+ 7390
1396+ 7390 29               add  hl, hl            ; *2
1397+ 7391 29               add  hl, hl            ; *4
1398+ 7392 29               add  hl, hl            ; *8
1399+ 7393 29               add  hl, hl            ; *16
1400+ 7394 29               add  hl, hl            ; *32
1401+ 7395
1402+ 7395                  ; Aggiunge la colonna
1403+ 7395 58               ld   e, b
1404+ 7396 16 00            ld   d, 0
1405+ 7398 19               add  hl, de            ; HL = Row*32 + Col
1406+ 7399
1407+ 7399                  ; ---------------------------------------------------------------
1408+ 7399                  ; Accesso alla griglia degli item attivi
1409+ 7399                  ; ---------------------------------------------------------------
1410+ 7399 11 00 A5         ld   de, items_grid
1411+ 739C 19               add  hl, de            ; HL = address cella
1412+ 739D
1413+ 739D                  ; ---------------------------------------------------------------
1414+ 739D                  ; Controllo presenza item
1415+ 739D                  ;
1416+ 739D                  ; items_grid contiene:
1417+ 739D                  ;   0 = nessun item
1418+ 739D                  ;   >0 = item attivo (colore o flag)
1419+ 739D                  ; ---------------------------------------------------------------
1420+ 739D 7E               ld   a, (hl)
1421+ 739E B7               or   a
1422+ 739F 28 04            jr   z, .not_active
1423+ 73A1
1424+ 73A1                  ; ---------------------------------------------------------------
1425+ 73A1                  ; Item trovato
1426+ 73A1                  ; ---------------------------------------------------------------
1427+ 73A1 E1               pop  hl
1428+ 73A2 D1               pop  de
1429+ 73A3
1430+ 73A3 37               scf                    ; Carry = 1
1431+ 73A4 C9               ret
1432+ 73A5
1433+ 73A5              .not_active:
1434+ 73A5
1435+ 73A5                  ; ---------------------------------------------------------------
1436+ 73A5                  ; Nessun item nella cella
1437+ 73A5                  ; ---------------------------------------------------------------
1438+ 73A5 E1               pop  hl
1439+ 73A6 D1               pop  de
1440+ 73A7
1441+ 73A7 B7               or   a                 ; Carry = 0
1442+ 73A8 C9               ret
1443+ 73A9
