 117+ 73A6              ; -------------------------------------------------------------------
 118+ 73A6              ; Disegna tutti gli oggetti attivi della stanza corrente
 119+ 73A6              ; -------------------------------------------------------------------
 120+ 73A6              DrawRoomItems:
 121+ 73A6 E5               push hl
 122+ 73A7 D5               push de
 123+ 73A8 C5               push bc
 124+ 73A9 DD E5            push ix
 125+ 73AB
 126+ 73AB                  ; Ottieni il puntatore alla grafica dell'item della stanza corrente:
 127+ 73AB                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 128+ 73AB 2A C0 78         ld   hl, (room_ptr)
 129+ 73AE 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 130+ 73B1 19               add  hl, de
 131+ 73B2 E5               push hl
 132+ 73B3 DD E1            pop  ix                ; IX = puntatore alla grafica dell'item della stanza
 133+ 73B5
 134+ 73B5 21 EC 72         ld   hl, ItemsTable
 135+ 73B8              .loop:
 136+ 73B8 7E               ld   a, (hl)           ; A = Room ID
 137+ 73B9 FE FF            cp   $FF               ; Fine tabella?
 138+ 73BB 28 23            jr   z, .done
 139+ 73BD
 140+ 73BD                  ; Confronta con la stanza corrente
 141+ 73BD 57               ld   d, a              ; D = Room ID dell'item
 142+ 73BE 3A B7 78         ld   a, (current_room)
 143+ 73C1 BA               cp   d
 144+ 73C2 20 15            jr   nz, .next_item    ; Stanza diversa, salta
 145+ 73C4
 146+ 73C4                  ; Leggi coordinate, colore e stato
 147+ 73C4 23               inc  hl                ; HL punta a X
 148+ 73C5 4E               ld   c, (hl)           ; C = X colonna
 149+ 73C6 23               inc  hl                ; HL punta a Y
 150+ 73C7 46               ld   b, (hl)           ; B = Y riga
 151+ 73C8 23               inc  hl                ; HL punta al Colore
 152+ 73C9 5E               ld   e, (hl)           ; E = Colore
 153+ 73CA 23               inc  hl                ; HL punta a collected flag
 154+ 73CB 7E               ld   a, (hl)           ; A = collected flag
 155+ 73CC B7               or   a
 156+ 73CD 20 0E            jr   nz, .next_no_inc  ; Già raccolto, salta
 157+ 73CF
 158+ 73CF                  ; Disegna l'item!
 159+ 73CF                  ; B = Row, C = Col, IX = bitmap graphic (8 byte), E = Colore
 160+ 73CF E5               push hl
 161+ 73D0 DD E5            push ix
 162+ 73D2 E1               pop  hl                ; HL = bitmap pointer
 163+ 73D3 CD E6 73         call DrawItemGraphic
 164+ 73D6 E1               pop  hl
 165+ 73D7
 166+ 73D7 18 04            jr   .next_no_inc
 167+ 73D9
 168+ 73D9              .next_item:
 169+ 73D9 23               inc  hl                ; salta X
 170+ 73DA 23               inc  hl                ; salta Y
 171+ 73DB 23               inc  hl                ; salta colore
 172+ 73DC 23               inc  hl                ; salta collected
 173+ 73DD              .next_no_inc:
 174+ 73DD 23               inc  hl                ; vai al prossimo record (prossimo Room ID)
 175+ 73DE 18 D8            jr   .loop
