 145+ 74A7 20 FB            jr   nz, .d1
 146+ 74A9
 147+ 74A9                  ; Speaker OFF
 148+ 74A9 3A 0F 75         ld   a, (room_border_color)
 149+ 74AC E6 EF            and  $ef
 150+ 74AE D3 FE            out  ($fe), a
 151+ 74B0 4A               ld   c, d
