 378+ 5F66 3A 52 77         ld   a, (sprite_shift)
 379+ 5F69 B7               or   a
 380+ 5F6A 28 1C            jr   z, .no_shift
 381+ 5F6C
 382+ 5F6C C5               push bc            ; Salva il contatore delle linee (C) e lo shift (B)
 383+ 5F6D 47               ld   b, a          ; B = contatore shift
 384+ 5F6E AF               xor  a             ; A = terzo byte (inizializzato a 0)
 385+ 5F6F
