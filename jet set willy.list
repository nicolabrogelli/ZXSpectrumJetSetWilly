 527  8B02 16 00            ld   d, 0
 528  8B04 19               add  hl, de
 529  8B05 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 530  8B06 4E               ld   c, (hl)                   ; C = X ingresso
 531  8B07 23               inc  hl
 532  8B08 46               ld   b, (hl)                   ; B = Y ingresso
 533  8B09 ED 43 E2 F4      ld   (PlayerPos), bc           ; Imposta le coordinate al punto di ingresso
 534  8B0D ED 43 E4 F4      ld   (PlayerPosOld), bc
 535  8B11
 536  8B11 3E 01            ld   a, 1
 537  8B13 32 68 F8         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 538  8B16
 539  8B16                  ; - Cancella lo schermo a nero prima del caricamento
 540  8B16 AF               xor  a
 541  8B17 D3 FE            out  ($fe), a
 542  8B19 21 8D 5C         ld   hl, ATTR_P
 543  8B1C 77               ld   (hl), a
 544  8B1D CD AF 0D         call CLS
 545  8B20 36 07            ld   (hl), $07
 546  8B22 3E 07            ld   a, $07
 547  8B24 32 8F 5C         ld   (ATTR_T), a
 548  8B27
 549  8B27                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 550  8B27 C3 94 88         jp   LoadRoomAndRestart
 551  8B2A
 552  8B2A              ; -------------------------------------------------------------------
 553  8B2A              ; TriggerVictory
 554  8B2A              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 555  8B2A              ; - Pulisce gli elementi di gioco della stanza.
 556  8B2A              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 557  8B2A              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 558  8B2A              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 559  8B2A              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 560  8B2A              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 561  8B2A              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 562  8B2A              ; -------------------------------------------------------------------
 563  8B2A              TriggerVictory:
 564  8B2A                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 565  8B2A CD 15 66         call Gfx_DrawVictoryScreen
 566  8B2D
 567  8B2D                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 568  8B2D              .wait_keys_release:
 569  8B2D 76               halt
 570  8B2E                  ; Controlla tasto Y (Porta $DF, bit 4)
 571  8B2E 01 FE DF         ld   bc, $dffe
 572  8B31 ED 78            in   a, (c)
 573  8B33 CB 67            bit  4, a
 574  8B35 28 F6            jr   z, .wait_keys_release
 575  8B37
 576  8B37                  ; Controlla tasto N (Porta $7F, bit 3)
 577  8B37 01 FE 7F         ld   bc, $7ffe
 578  8B3A ED 78            in   a, (c)
 579  8B3C CB 5F            bit  3, a
 580  8B3E 28 ED            jr   z, .wait_keys_release
 581  8B40
 582  8B40                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 583  8B40 01 FE BF         ld   bc, $bffe
 584  8B43 ED 78            in   a, (c)
 585  8B45 CB 47            bit  0, a
 586  8B47 28 E4            jr   z, .wait_keys_release
 587  8B49
 588  8B49                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 589  8B49 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 590  8B4B              .wait_choice_loop:
 591  8B4B 76               halt
 592  8B4C
 593  8B4C                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 594  8B4C 0C               inc  c
 595  8B4D 79               ld   a, c
 596  8B4E CB 3F            srl  a
 597  8B50 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 598  8B52 E6 07            and  7
 599  8B54 5F               ld   e, a
 600  8B55 16 00            ld   d, 0
 601  8B57 21 F4 64         ld   hl, victory_color_table
 602  8B5A 19               add  hl, de
 603  8B5B 7E               ld   a, (hl)               ; A = nuovo colore attributo
 604  8B5C 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 605  8B5F 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 606  8B61              .color_cycle_loop:
 607  8B61 77               ld   (hl), a
 608  8B62 23               inc  hl
 609  8B63 10 FC            djnz .color_cycle_loop
 610  8B65
 611  8B65                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 612  8B65 01 FE DF         ld   bc, $dffe
 613  8B68 ED 78            in   a, (c)
 614  8B6A CB 67            bit  4, a
 615  8B6C 28 2A            jr   z, .play_again_chosen
 616  8B6E
 617  8B6E                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 618  8B6E 01 FE 7F         ld   bc, $7ffe
 619  8B71 ED 78            in   a, (c)
 620  8B73 CB 5F            bit  3, a
 621  8B75 28 0B            jr   z, .quit_chosen
 622  8B77
 623  8B77                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 624  8B77 01 FE BF         ld   bc, $bffe
 625  8B7A ED 78            in   a, (c)
 626  8B7C CB 47            bit  0, a
 627  8B7E 28 02            jr   z, .quit_chosen
 628  8B80
 629  8B80 18 C9            jr   .wait_choice_loop
 630  8B82
 631  8B82              .quit_chosen:
 632  8B82                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 633  8B82              .wait_quit_release:
 634  8B82 76               halt
 635  8B83 01 FE 7F         ld   bc, $7ffe
 636  8B86 ED 78            in   a, (c)
 637  8B88 CB 5F            bit  3, a
 638  8B8A 28 F6            jr   z, .wait_quit_release
 639  8B8C 01 FE BF         ld   bc, $bffe
 640  8B8F ED 78            in   a, (c)
 641  8B91 CB 47            bit  0, a
 642  8B93 28 ED            jr   z, .wait_quit_release
 643  8B95
 644  8B95                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 645  8B95 C3 B2 89         jp   ShowTitleScreen
 646  8B98
 647  8B98              .play_again_chosen:
 648  8B98                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 649  8B98              .wait_play_again_release:
 650  8B98 76               halt
 651  8B99 01 FE DF         ld   bc, $dffe
 652  8B9C ED 78            in   a, (c)
 653  8B9E CB 67            bit  4, a
 654  8BA0 28 F6            jr   z, .wait_play_again_release
 655  8BA2
 656  8BA2                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 657  8BA2 CD 62 8C         call ResetFullGameState
 658  8BA5 C3 94 88         jp   LoadRoomAndRestart
 659  8BA8
 660  8BA8              ; -------------------------------------------------------------------
 661  8BA8              ; CheckVictoryCondition
 662  8BA8              ; Verifica se si verificano contemporaneamente tutte le 3 condizioni di vittoria:
 663  8BA8              ; 1. Willy ha raccolto tutti gli oggetti collezionabili del gioco (tutti i flag in ItemsTable = 1);
 664  8BA8              ; 2. Willy si trova nella stanza Master Bedroom;
 665  8BA8              ; 3. Willy collide con un oggetto/tag di tipo Conveyor in quella stanza.
 666  8BA8              ;
 667  8BA8              ; Output:
 668  8BA8              ;   Carry Flag = 1 se la vittoria è attivata
 669  8BA8              ;   Carry Flag = 0 altrimenti
 670  8BA8              ; -------------------------------------------------------------------
 671  8BA8              CheckVictoryCondition:
 672  8BA8 C5               push bc
 673  8BA9 D5               push de
 674  8BAA E5               push hl
 675  8BAB
 676  8BAB                  ; 1. Condizione: tutti gli item raccolti?
 677  8BAB CD C4 8B         call CheckAllItemsCollected
 678  8BAE 30 0F            jr   nc, .no_victory
 679  8BB0
 680  8BB0                  ; 2. Condizione: Willy è nella Master Bedroom?
 681  8BB0 CD EB 8B         call CheckInMasterBedroom
 682  8BB3 30 0A            jr   nc, .no_victory
 683  8BB5
 684  8BB5                  ; 3. Condizione: Willy collide con il conveyor?
 685  8BB5 CD 07 8C         call CheckWillyConveyorCollision
 686  8BB8 30 05            jr   nc, .no_victory
 687  8BBA
 688  8BBA                  ; Tutte le condizioni sono soddisfatte contemporaneamente!
 689  8BBA E1               pop  hl
 690  8BBB D1               pop  de
 691  8BBC C1               pop  bc
 692  8BBD 37               scf
 693  8BBE C9               ret
 694  8BBF
 695  8BBF              .no_victory:
 696  8BBF E1               pop  hl
 697  8BC0 D1               pop  de
 698  8BC1 C1               pop  bc
 699  8BC2 B7               or   a
 700  8BC3 C9               ret
 701  8BC4
 702  8BC4              ; -------------------------------------------------------------------
 703  8BC4              ; CheckAllItemsCollected
 704  8BC4              ; Verifica che tutti gli item del gioco siano stati raccolti.
 705  8BC4              ; - Controllo preliminare sul conteggio/flag globale
 706  8BC4              ; - Verifica puntuale che ogni record in ItemsTable abbia flag = 1 (raccolto)
 707  8BC4              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 708  8BC4              ; -------------------------------------------------------------------
 709  8BC4              CheckAllItemsCollected:
 710  8BC4 E5               push hl
 711  8BC5 3A F4 F8         ld   a, (game_objective_completed)
 712  8BC8 B7               or   a
 713  8BC9 20 07            jr   nz, .verify_flags
 714  8BCB 3A EC F4         ld   a, (items_collected)
 715  8BCE FE 4D            cp   TOTAL_ITEMS
 716  8BD0 38 16            jr   c, .not_all
 717  8BD2
 718  8BD2              .verify_flags:
 719  8BD2 21 C7 80         ld   hl, ItemsTable
 720  8BD5              .loop:
 721  8BD5 7E               ld   a, (hl)
 722  8BD6 FE FF            cp   $FF
 723  8BD8 28 0B            jr   z, .done_all
 724  8BDA 23               inc  hl                    ; +1 X
 725  8BDB 23               inc  hl                    ; +2 Y
 726  8BDC 23               inc  hl                    ; +3 Color
 727  8BDD 23               inc  hl                    ; +4 Collected flag
 728  8BDE 7E               ld   a, (hl)
 729  8BDF B7               or   a
 730  8BE0 28 06            jr   z, .not_all           ; Trovato un item non raccolto -> fail
 731  8BE2 23               inc  hl                    ; Prossimo record
 732  8BE3 18 F0            jr   .loop
 733  8BE5
 734  8BE5              .done_all:
 735  8BE5 E1               pop  hl
 736  8BE6 37               scf
 737  8BE7 C9               ret
 738  8BE8
 739  8BE8              .not_all:
 740  8BE8 E1               pop  hl
 741  8BE9 B7               or   a
 742  8BEA C9               ret
 743  8BEB
 744  8BEB              ; -------------------------------------------------------------------
 745  8BEB              ; CheckInMasterBedroom
 746  8BEB              ; Verifica se la stanza corrente è Master Bedroom (ID 35 / MastreBedRoomLayout)
 747  8BEB              ; Output: Carry = 1 se Master Bedroom, Carry = 0 altrimenti
 748  8BEB              ; -------------------------------------------------------------------
 749  8BEB              CheckInMasterBedroom:
 750  8BEB E5               push hl
 751  8BEC D5               push de
 752  8BED 2A 62 F8         ld   hl, (room_ptr)
 753  8BF0 11 56 B4         ld   de, MastreBedRoomLayout
 754  8BF3 B7               or   a
 755  8BF4 ED 52            sbc  hl, de
 756  8BF6 28 0B            jr   z, .is_master
 757  8BF8 3A 08 F8         ld   a, (current_room)
 758  8BFB FE 23            cp   ROOM_MASTER_BEDROOM
 759  8BFD 28 04            jr   z, .is_master
 760  8BFF D1               pop  de
 761  8C00 E1               pop  hl
 762  8C01 B7               or   a
 763  8C02 C9               ret
 764  8C03              .is_master:
 765  8C03 D1               pop  de
 766  8C04 E1               pop  hl
 767  8C05 37               scf
 768  8C06 C9               ret
 769  8C07
 770  8C07              ; -------------------------------------------------------------------
 771  8C07              ; CheckWillyConveyorCollision
 772  8C07              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 773  8C07              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 774  8C07              ; -------------------------------------------------------------------
 775  8C07              CheckWillyConveyorCollision:
 776  8C07 C5               push bc
 777  8C08 D5               push de
 778  8C09 E5               push hl
 779  8C0A
 780  8C0A                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 781  8C0A CD 41 76         call CheckWillyOnConveyor
 782  8C0D 38 49            jr   c, .collision_detected
 783  8C0F
 784  8C0F                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 785  8C0F 3A 0A F8         ld   a, (conveyor_len)
 786  8C12 B7               or   a
 787  8C13 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 788  8C15
 789  8C15                  ; B = WillyY, C = WillyX
 790  8C15 ED 4B E2 F4      ld   bc, (PlayerPos)
 791  8C19
 792  8C19                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 793  8C19 3A 0B F8         ld   a, (conveyor_row)
 794  8C1C 87               add  a, a                  ; *2
 795  8C1D 87               add  a, a                  ; *4
 796  8C1E 87               add  a, a                  ; *8
 797  8C1F 5F               ld   e, a                  ; E = ConveyorTop
 798  8C20 C6 07            add  a, 7
 799  8C22 57               ld   d, a                  ; D = ConveyorBottom
 800  8C23
 801  8C23                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 802  8C23 78               ld   a, b                  ; WillyTop
 803  8C24 BA               cp   d
 804  8C25 28 04            jr   z, .y_overlap
 805  8C27 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 806  8C29 18 32            jr   .no_conv_collision
 807  8C2B
 808  8C2B              .y_overlap:
 809  8C2B C6 0F            add  a, 15                 ; WillyBottom
 810  8C2D BB               cp   e
 811  8C2E 28 04            jr   z, .x_check
 812  8C30 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 813  8C32 18 29            jr   .no_conv_collision
 814  8C34
 815  8C34              .x_check:
 816  8C34                  ; ConveyorLeft = conveyor_col * 8
 817  8C34 3A 0C F8         ld   a, (conveyor_col)
 818  8C37 87               add  a, a                  ; *2
 819  8C38 87               add  a, a                  ; *4
 820  8C39 87               add  a, a                  ; *8
 821  8C3A 5F               ld   e, a                  ; E = ConveyorLeft
 822  8C3B
 823  8C3B                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 824  8C3B 21 0A F8         ld   hl, conveyor_len
 825  8C3E 3A 0C F8         ld   a, (conveyor_col)
 826  8C41 86               add  a, (hl)
 827  8C42 87               add  a, a                  ; *2
 828  8C43 87               add  a, a                  ; *4
 829  8C44 87               add  a, a                  ; *8
 830  8C45 3D               dec  a                     ; ConveyorRight
 831  8C46 57               ld   d, a                  ; D = ConveyorRight
 832  8C47
 833  8C47                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 834  8C47 79               ld   a, c                  ; WillyLeft
 835  8C48 BA               cp   d
 836  8C49 28 04            jr   z, .x_overlap
 837  8C4B 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 838  8C4D 18 0E            jr   .no_conv_collision
 839  8C4F
 840  8C4F              .x_overlap:
 841  8C4F C6 0F            add  a, 15                 ; WillyRight
 842  8C51 BB               cp   e
 843  8C52 28 04            jr   z, .collision_detected
 844  8C54 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 845  8C56 18 05            jr   .no_conv_collision
 846  8C58
 847  8C58              .collision_detected:
 848  8C58 E1               pop  hl
 849  8C59 D1               pop  de
 850  8C5A C1               pop  bc
 851  8C5B 37               scf
 852  8C5C C9               ret
 853  8C5D
 854  8C5D              .no_conv_collision:
 855  8C5D E1               pop  hl
 856  8C5E D1               pop  de
 857  8C5F C1               pop  bc
 858  8C60 B7               or   a
 859  8C61 C9               ret
 860  8C62
 861  8C62              ; -------------------------------------------------------------------
 862  8C62              ; ResetFullGameState
 863  8C62              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 864  8C62              ; per l'avvio di una nuova partita dopo il Game Over.
 865  8C62              ; -------------------------------------------------------------------
 866  8C62              ResetFullGameState:
 867  8C62                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 868  8C62 AF               xor  a
 869  8C63 D3 FE            out  ($fe), a              ; Bordo a nero
 870  8C65 21 8D 5C         ld   hl, ATTR_P
 871  8C68 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 872  8C69 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 873  8C6C 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 874  8C6E 3E 07            ld   a, $07
 875  8C70 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 876  8C73
 877  8C73                  ; Ripristina il numero di vite iniziali
 878  8C73 3E 07            ld   a, INITIAL_LIVES
 879  8C75 32 EF F4         ld   (willy_lives), a
 880  8C78
 881  8C78                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 882  8C78 AF               xor  a
 883  8C79 32 EC F4         ld   (items_collected), a
 884  8C7C 32 E8 F4         ld   (body_state), a
 885  8C7F 32 FB F4         ld   (w_warp_state), a
 886  8C82 32 FE F4         ld   (w_key_prev), a
 887  8C85 32 FF F4         ld   (enter_key_prev), a
 888  8C88 32 F0 F4         ld   (velocity_y), a
 889  8C8B 32 F2 F4         ld   (jump_pressed), a
 890  8C8E 32 F4 F4         ld   (coyote_timer), a
 891  8C91 32 F7 F4         ld   (jump_frame), a
 892  8C94 32 F6 F4         ld   (jump_dir), a
 893  8C97 32 68 F8         ld   (transition_active), a
 894  8C9A 32 EC F8         ld   (willy_safety_timer), a
 895  8C9D 3E FF            ld   a, $ff
 896  8C9F 32 00 F5         ld   (digit_key_prev), a
 897  8CA2 3E 01            ld   a, 1
 898  8CA4 32 F9 F4         ld   (q_prev), a
 899  8CA7 32 FA F4         ld   (a_prev), a
 900  8CAA 32 F1 F4         ld   (on_ground), a
 901  8CAD
 902  8CAD                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 903  8CAD 3E 30            ld   a, '0'
 904  8CAF 32 F9 68         ld   (status_line + 16), a
 905  8CB2 32 FA 68         ld   (status_line + 17), a
 906  8CB5 32 FB 68         ld   (status_line + 18), a
 907  8CB8
 908  8CB8                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 909  8CB8 CD 23 86         call ResetItemsTable
 910  8CBB
 911  8CBB                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 912  8CBB CD 21 6E         call InitRoomEntryPositions
 913  8CBE
 914  8CBE                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 915  8CBE 3E 07            ld   a, 7
 916  8CC0 32 EF F8         ld   (time_hours), a
 917  8CC3 AF               xor  a
 918  8CC4 32 F0 F8         ld   (time_minutes), a
 919  8CC7 32 F1 F8         ld   (time_period), a       ; 0 = AM
 920  8CCA 32 F4 F8         ld   (game_objective_completed), a
 921  8CCD 2A 03 F5         ld   hl, (counter)
 922  8CD0 22 F2 F8         ld   (time_last_counter), hl
 923  8CD3 CD 6B 68         call Gfx_UpdateTimeDisplay
 924  8CD6
 925  8CD6                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 926  8CD6 21 1A B2         ld   hl, TheBathroomLayout; TheOffLicenceLayout
 927  8CD9 22 62 F8         ld   (room_ptr), hl
 928  8CDC
 929  8CDC C9               ret
 930  8CDD
 931  8CDD              ; -------------------------------------------------------------------
 932  8CDD              ; Time_UpdateClock
 933  8CDD              ; Gestisce lo scorrimento del tempo durante il gioco.
 934  8CDD              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 935  8CDD              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 936  8CDD              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 937  8CDD              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 938  8CDD              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 939  8CDD              ; sia completato, scatena immediatamente il Game Over.
 940  8CDD              ; -------------------------------------------------------------------
 941  8CDD              Time_UpdateClock:
 942  8CDD                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 943  8CDD 2A 03 F5         ld   hl, (counter)
 944  8CE0 ED 5B F2 F8      ld   de, (time_last_counter)
 945  8CE4 B7               or   a
 946  8CE5 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 947  8CE7
 948  8CE7                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 949  8CE7 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 950  8CEA B7               or   a
 951  8CEB ED 52            sbc  hl, de
 952  8CED D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 953  8CEE
 954  8CEE                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 955  8CEE 2A F2 F8         ld   hl, (time_last_counter)
 956  8CF1 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 957  8CF4 19               add  hl, de
 958  8CF5 22 F2 F8         ld   (time_last_counter), hl
 959  8CF8
 960  8CF8                  ; Incrementa di 1 minuto il tempo di gioco
 961  8CF8 3A F0 F8         ld   a, (time_minutes)
 962  8CFB 3C               inc  a
 963  8CFC FE 3C            cp   60
 964  8CFE 38 21            jr   c, .minutes_ok
 965  8D00
 966  8D00                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 967  8D00 AF               xor  a
 968  8D01 32 F0 F8         ld   (time_minutes), a
 969  8D04 3A EF F8         ld   a, (time_hours)
 970  8D07 3C               inc  a
 971  8D08 FE 0C            cp   12
 972  8D0A 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 973  8D0C FE 0D            cp   13
 974  8D0E 38 0E            jr   c, .hours_ok
 975  8D10 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 976  8D12 18 0A            jr   .hours_ok
 977  8D14
 978  8D14              .toggle_period:
 979  8D14 F5               push af                     ; Salva A (valore 12)
 980  8D15 3A F1 F8         ld   a, (time_period)
 981  8D18 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 982  8D1A 32 F1 F8         ld   (time_period), a
 983  8D1D F1               pop  af                     ; Ripristina A = 12
 984  8D1E
 985  8D1E              .hours_ok:
 986  8D1E 32 EF F8         ld   (time_hours), a
 987  8D21
 988  8D21              .minutes_ok:
 989  8D21 32 F0 F8         ld   (time_minutes), a
 990  8D24
 991  8D24                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 992  8D24 CD 6B 68         call Gfx_UpdateTimeDisplay
 993  8D27
 994  8D27                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 995  8D27 3A F4 F8         ld   a, (game_objective_completed)
 996  8D2A B7               or   a
 997  8D2B C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 998  8D2C
 999  8D2C                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
1000  8D2C 3A F1 F8         ld   a, (time_period)
1001  8D2F B7               or   a
1002  8D30 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
1003  8D31
1004  8D31 3A EF F8         ld   a, (time_hours)
1005  8D34 FE 0C            cp   12
1006  8D36 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1007  8D38 C9               ret
1008  8D39
1009  8D39              .time_limit_reached:
1010  8D39                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
1011  8D39                  ; Scatena immediatamente il Game Over temporale!
1012  8D39 C3 01 8A         jp   TriggerGameOver
1013  8D3C
1014  8D3C
1015  8D3C
