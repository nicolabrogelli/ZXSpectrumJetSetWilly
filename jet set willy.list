 385+ 5F70              ; Disegna uno sprite 16x16 a coordinate pixel (X, Y)
 386+ 5F70              ; Input: C = X, B = Y, IX = puntatore dati sprite (32 byte)
 387+ 5F70              ; -------------------------------------------------------------------
 388+ 5F70              DrawPixelSprite16x16:
 389+ 5F70 C5               push bc
 390+ 5F71 D5               push de
 391+ 5F72 E5               push hl
 392+ 5F73 DD E5            push ix
 393+ 5F75
 394+ 5F75                  ; 1. Salva la coordinata X per calcolare lo shift
 395+ 5F75 79               ld   a, c
 396+ 5F76 E6 07            and  7
 397+ 5F78 32 73 71         ld   (sprite_shift), a
 398+ 5F7B
 399+ 5F7B                  ; 2. Calcola indirizzo schermo
 400+ 5F7B 60               ld   h, b
 401+ 5F7C 69               ld   l, c
 402+ 5F7D CD 0E 5E         call GetScreenAddr ; HL = indirizzo schermo
 403+ 5F80
 404+ 5F80 0E 10            ld   c, 16          ; 16 linee/scanline
 405+ 5F82              .line_loop:
 406+ 5F82 DD 56 00         ld   d, (ix+0)     ; D = primo byte dello sprite
 407+ 5F85 DD 5E 01         ld   e, (ix+1)     ; E = secondo byte dello sprite
 408+ 5F88
 409+ 5F88                  ; Esegui lo shift a destra se necessario
 410+ 5F88 3A 73 71         ld   a, (sprite_shift)
 411+ 5F8B B7               or   a
 412+ 5F8C 28 1C            jr   z, .no_shift
 413+ 5F8E
 414+ 5F8E C5               push bc            ; Salva il contatore delle linee (C) e lo shift (B)
 415+ 5F8F 47               ld   b, a          ; B = contatore shift
 416+ 5F90 AF               xor  a             ; A = terzo byte (inizializzato a 0)
 417+ 5F91
 418+ 5F91              .shift_loop:
 419+ 5F91 CB 3A            srl  d
 420+ 5F93 CB 1B            rr   e
 421+ 5F95 CB 1F            rr   a
 422+ 5F97 10 F8            djnz .shift_loop
 423+ 5F99
 424+ 5F99 C1               pop  bc            ; Ripristina C (contatore linee)
 425+ 5F9A
 426+ 5F9A                  ; Scrive i 3 byte sullo schermo (OR trasparente)
 427+ 5F9A 47               ld   b, a          ; Salva il 3° byte dello sprite in B
 428+ 5F9B 7A               ld   a, d
 429+ 5F9C B6               or   (hl)
 430+ 5F9D 77               ld   (hl), a
 431+ 5F9E 23               inc  hl
 432+ 5F9F 7B               ld   a, e
 433+ 5FA0 B6               or   (hl)
 434+ 5FA1 77               ld   (hl), a
 435+ 5FA2 23               inc  hl
 436+ 5FA3 78               ld   a, b          ; Recupera il 3° byte dello sprite
 437+ 5FA4 B6               or   (hl)
 438+ 5FA5 77               ld   (hl), a
 439+ 5FA6 2B               dec  hl
 440+ 5FA7 2B               dec  hl            ; Ripristina HL alla colonna iniziale
 441+ 5FA8 18 08            jr   .next_line
 442+ 5FAA
 443+ 5FAA              .no_shift:
 444+ 5FAA                  ; Nessuno shift: scrivi i 2 byte direttamente (OR trasparente)
 445+ 5FAA 7A               ld   a, d
 446+ 5FAB B6               or   (hl)
 447+ 5FAC 77               ld   (hl), a
 448+ 5FAD 23               inc  hl
 449+ 5FAE 7B               ld   a, e
 450+ 5FAF B6               or   (hl)
 451+ 5FB0 77               ld   (hl), a
 452+ 5FB1 2B               dec  hl            ; Ripristina HL alla colonna iniziale
 453+ 5FB2
