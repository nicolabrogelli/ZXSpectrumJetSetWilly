1327+ 77A4              ; Phys_CheckRampOnRoomChange
1328+ 77A4              ; Controlla se nella nuova stanza (DE = room layout ptr) c'è una rampa
1329+ 77A4              ; allineata con la posizione d'ingresso di Willy (C = PlayerX, B = PlayerY).
1330+ 77A4              ; Output: Se allineato, modifica B = ramp_Y e C = PlayerX e imposta on_ground = 1.
1331+ 77A4              ; -------------------------------------------------------------------
1332+ 77A4              Phys_CheckRampOnRoomChange:
1333+ 77A4 E5               push hl
1334+ 77A5 D5               push de
1335+ 77A6 C5               push bc
1336+ 77A7
1337+ 77A7                  ; Offsets per RampData: DE + 218
1338+ 77A7 21 DA 00         ld   hl, 218
1339+ 77AA 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1340+ 77AB
1341+ 77AB 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1342+ 77AC 32 70 F7         ld   (ramp_dir), a
1343+ 77AF 23               inc  hl
1344+ 77B0 5E               ld   e, (hl)
1345+ 77B1 23               inc  hl
1346+ 77B2 56               ld   d, (hl)           ; DE = Location
1347+ 77B3 23               inc  hl
1348+ 77B4 7E               ld   a, (hl)           ; A = Length
1349+ 77B5 32 71 F7         ld   (ramp_len), a
1350+ 77B8
1351+ 77B8                  ; Controlla se DE (Location) è 0 o Length è 0
1352+ 77B8 7A               ld   a, d
1353+ 77B9 B3               or   e
1354+ 77BA CA C1 78         jp   z, .no_ramp_change
1355+ 77BD 3A 71 F7         ld   a, (ramp_len)
1356+ 77C0 B7               or   a
1357+ 77C1 CA C1 78         jp   z, .no_ramp_change
1358+ 77C4
1359+ 77C4                  ; Calcola Row e Col: Offset = DE - 24064
1360+ 77C4 21 00 A2         ld   hl, -24064
1361+ 77C7 19               add  hl, de            ; HL = Offset
1362+ 77C8 54               ld   d, h
1363+ 77C9 5D               ld   e, l
1364+ 77CA
1365+ 77CA 7B               ld   a, e
1366+ 77CB E6 1F            and  31
1367+ 77CD 32 73 F7         ld   (ramp_col), a     ; Col Start
1368+ 77D0
1369+ 77D0 CB 3C            srl  h
1369+ 77D2 CB 1D          rr l
1370+ 77D4 CB 3C            srl  h
1370+ 77D6 CB 1D          rr l
1371+ 77D8 CB 3C            srl  h
1371+ 77DA CB 1D          rr l
1372+ 77DC CB 3C            srl  h
1372+ 77DE CB 1D          rr l
1373+ 77E0 CB 3C            srl  h
1373+ 77E2 CB 1D          rr l
1374+ 77E4 7D               ld   a, l
1375+ 77E5 32 72 F7         ld   (ramp_row), a     ; Row Start
