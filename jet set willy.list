 315+ 6D30
 316+ 6D30                  ; Ripristina i registri
 317+ 6D30 D1               pop  de
 318+ 6D31 E1               pop  hl
 319+ 6D32
 320+ 6D32 C9               ret
 321+ 6D33
 322+ 6D33              ; -------------------------------------------------------------------
 323+ 6D33              ; DrawRoomItems
 324+ 6D33              ;
 325+ 6D33              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 326+ 6D33              ;
 327+ 6D33              ; Operazioni eseguite:
 328+ 6D33              ;   1. Azzera la griglia items_grid.
 329+ 6D33              ;   2. Svuota la cache degli oggetti attivi.
 330+ 6D33              ;   3. Scansiona ItemsTable.
 331+ 6D33              ;   4. Per ogni item della stanza corrente:
 332+ 6D33              ;        - verifica se è già stato raccolto
 333+ 6D33              ;        - disegna la grafica
 334+ 6D33              ;        - aggiorna items_grid
 335+ 6D33              ;        - memorizza l'item nella cache current_room_items
 336+ 6D33              ;   5. Aggiorna num_room_items.
 337+ 6D33              ;
 338+ 6D33              ; Record ItemsTable:
 339+ 6D33              ;   +0  Room ID
 340+ 6D33              ;   +1  X (colonna)
 341+ 6D33              ;   +2  Y (riga)
 342+ 6D33              ;   +3  Colore
 343+ 6D33              ;   +4  Collected flag
 344+ 6D33              ;
 345+ 6D33              ; Cache current_room_items:
 346+ 6D33              ;   +0  Colonna
 347+ 6D33              ;   +1  Riga
 348+ 6D33              ;   +2  Colore
 349+ 6D33              ;   +3  Collected flag ptr (Low)
 350+ 6D33              ;   +4  Collected flag ptr (High)
 351+ 6D33              ;
 352+ 6D33              ; Ogni record cache occupa 5 byte.
 353+ 6D33              ; -------------------------------------------------------------------
 354+ 6D33              DrawRoomItems:
 355+ 6D33
 356+ 6D33                  ; Salva tutti i registri utilizzati
 357+ 6D33 E5               push hl
 358+ 6D34 D5               push de
 359+ 6D35 C5               push bc
 360+ 6D36 DD E5            push ix
 361+ 6D38 FD E5            push iy
 362+ 6D3A
 363+ 6D3A                  ; ---------------------------------------------------------------
 364+ 6D3A                  ; Azzera items_grid (32 x 16 = 512 byte)
 365+ 6D3A                  ; ---------------------------------------------------------------
 366+ 6D3A 21 00 90         ld   hl, items_grid
 367+ 6D3D 11 01 90         ld   de, items_grid + 1
 368+ 6D40 36 00            ld   (hl), 0
 369+ 6D42 01 FF 01         ld   bc, 511
 370+ 6D45 ED B0            ldir
 371+ 6D47
 372+ 6D47                  ; ---------------------------------------------------------------
 373+ 6D47                  ; Nessun item attivo nella stanza
 374+ 6D47                  ; ---------------------------------------------------------------
 375+ 6D47 AF               xor  a
 376+ 6D48 32 C4 7E         ld   (num_room_items), a
 377+ 6D4B
 378+ 6D4B                  ; IY punta alla cache degli item attivi
 379+ 6D4B FD 21 74 7E      ld   iy, current_room_items
 380+ 6D4F
 381+ 6D4F                  ; ---------------------------------------------------------------
 382+ 6D4F                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 383+ 6D4F                  ; alla stanza corrente.
 384+ 6D4F                  ;
 385+ 6D4F                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 386+ 6D4F                  ; ---------------------------------------------------------------
 387+ 6D4F 2A C5 7E         ld   hl, (room_ptr)
 388+ 6D52 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 389+ 6D55 19               add  hl, de
 390+ 6D56
 391+ 6D56 E5               push hl
 392+ 6D57 DD E1            pop  ix                ; IX = bitmap item
 393+ 6D59
 394+ 6D59                  ; ---------------------------------------------------------------
 395+ 6D59                  ; Inizio scansione della tabella degli item
 396+ 6D59                  ; ---------------------------------------------------------------
 397+ 6D59 21 E3 6B         ld   hl, ItemsTable
 398+ 6D5C
 399+ 6D5C              .loop:
 400+ 6D5C
 401+ 6D5C                  ; ---------------------------------------------------------------
 402+ 6D5C                  ; Legge il Room ID del record corrente
 403+ 6D5C                  ; ---------------------------------------------------------------
 404+ 6D5C 7E               ld   a, (hl)
 405+ 6D5D
 406+ 6D5D                  ; $FF indica fine tabella
 407+ 6D5D FE FF            cp   $FF
 408+ 6D5F 28 53            jr   z, .done
 409+ 6D61
 410+ 6D61                  ; ---------------------------------------------------------------
 411+ 6D61                  ; Verifica se l'item appartiene alla stanza corrente
 412+ 6D61                  ; ---------------------------------------------------------------
 413+ 6D61 57               ld   d, a
 414+ 6D62
 415+ 6D62 3A 6B 7E         ld   a, (current_room)
 416+ 6D65 BA               cp   d
 417+ 6D66 20 45            jr   nz, .next_item
 418+ 6D68
 419+ 6D68                  ; ---------------------------------------------------------------
 420+ 6D68                  ; Legge i dati dell'item
 421+ 6D68                  ; ---------------------------------------------------------------
 422+ 6D68
 423+ 6D68 23               inc  hl
 424+ 6D69 4E               ld   c, (hl)           ; X (colonna)
 425+ 6D6A
 426+ 6D6A 23               inc  hl
 427+ 6D6B 46               ld   b, (hl)           ; Y (riga)
 428+ 6D6C
 429+ 6D6C 23               inc  hl
 430+ 6D6D 5E               ld   e, (hl)           ; Colore
 431+ 6D6E
 432+ 6D6E 23               inc  hl
 433+ 6D6F 7E               ld   a, (hl)           ; Collected flag
 434+ 6D70
 435+ 6D70                  ; Se diverso da zero l'item è già stato raccolto
 436+ 6D70 B7               or   a
 437+ 6D71 20 3E            jr   nz, .next_no_inc
 438+ 6D73
 439+ 6D73                  ; ---------------------------------------------------------------
 440+ 6D73                  ; Disegna l'item sullo schermo
 441+ 6D73                  ;
 442+ 6D73                  ; B = Row
 443+ 6D73                  ; C = Column
 444+ 6D73                  ; HL = bitmap pointer
 445+ 6D73                  ; E = Color
 446+ 6D73                  ; ---------------------------------------------------------------
 447+ 6D73 E5               push hl
 448+ 6D74
 449+ 6D74 DD E5            push ix
 450+ 6D76 E1               pop  hl
 451+ 6D77
 452+ 6D77 CD BC 6D         call DrawItemGraphic
 453+ 6D7A
 454+ 6D7A E1               pop  hl                ; ritorna al flag collected
 455+ 6D7B
 456+ 6D7B                  ; ---------------------------------------------------------------
 457+ 6D7B                  ; Aggiorna items_grid
 458+ 6D7B                  ;
 459+ 6D7B                  ; Calcolo:
 460+ 6D7B                  ;   offset = Row * 32 + Col
 461+ 6D7B                  ; ---------------------------------------------------------------
 462+ 6D7B E5               push hl
 463+ 6D7C D5               push de
 464+ 6D7D
 465+ 6D7D 26 00            ld   h, 0
 466+ 6D7F 68               ld   l, b              ; HL = Row
 467+ 6D80
 468+ 6D80 29               add  hl, hl            ; *2
 469+ 6D81 29               add  hl, hl            ; *4
 470+ 6D82 29               add  hl, hl            ; *8
 471+ 6D83 29               add  hl, hl            ; *16
 472+ 6D84 29               add  hl, hl            ; *32
 473+ 6D85
 474+ 6D85 16 00            ld   d, 0
 475+ 6D87 59               ld   e, c              ; DE = Col
 476+ 6D88
 477+ 6D88 19               add  hl, de            ; Row*32 + Col
 478+ 6D89
 479+ 6D89 11 00 90         ld   de, items_grid
 480+ 6D8C 19               add  hl, de            ; puntatore nella griglia
 481+ 6D8D
 482+ 6D8D D1               pop  de                ; ripristina colore
 483+ 6D8E
 484+ 6D8E 73               ld   (hl), e           ; salva colore cella
 485+ 6D8F
 486+ 6D8F E1               pop  hl
 487+ 6D90
 488+ 6D90                  ; ---------------------------------------------------------------
 489+ 6D90                  ; Salva l'item nella cache della stanza
 490+ 6D90                  ;
 491+ 6D90                  ; Questo evita di dover scansionare tutta ItemsTable
 492+ 6D90                  ; durante il controllo delle collisioni.
 493+ 6D90                  ; ---------------------------------------------------------------
 494+ 6D90
 495+ 6D90 FD 71 00         ld   (iy+0), c         ; Colonna
 496+ 6D93 FD 70 01         ld   (iy+1), b         ; Riga
 497+ 6D96 FD 73 02         ld   (iy+2), e         ; Colore
 498+ 6D99
 499+ 6D99                  ; Salva il puntatore al flag "collected"
 500+ 6D99 FD 75 03         ld   (iy+3), l         ; Low byte
 501+ 6D9C FD 74 04         ld   (iy+4), h         ; High byte
 502+ 6D9F
 503+ 6D9F                  ; Passa al record successivo della cache
 504+ 6D9F 01 05 00         ld   bc, 5
 505+ 6DA2 FD 09            add  iy, bc
 506+ 6DA4
 507+ 6DA4                  ; Incrementa il numero di item attivi
 508+ 6DA4 3A C4 7E         ld   a, (num_room_items)
 509+ 6DA7 3C               inc  a
 510+ 6DA8 32 C4 7E         ld   (num_room_items), a
 511+ 6DAB
 512+ 6DAB 18 04            jr   .next_no_inc
 513+ 6DAD
 514+ 6DAD              .next_item:
 515+ 6DAD
 516+ 6DAD                  ; ---------------------------------------------------------------
 517+ 6DAD                  ; L'item non appartiene alla stanza corrente.
 518+ 6DAD                  ; Salta i campi del record:
 519+ 6DAD                  ;   X
 520+ 6DAD                  ;   Y
 521+ 6DAD                  ;   Color
 522+ 6DAD                  ;   Collected
 523+ 6DAD                  ; ---------------------------------------------------------------
 524+ 6DAD 23               inc  hl
 525+ 6DAE 23               inc  hl
 526+ 6DAF 23               inc  hl
 527+ 6DB0 23               inc  hl
 528+ 6DB1
 529+ 6DB1              .next_no_inc:
 530+ 6DB1
 531+ 6DB1                  ; ---------------------------------------------------------------
 532+ 6DB1                  ; Avanza al record successivo
 533+ 6DB1                  ; (prossimo Room ID)
 534+ 6DB1                  ; ---------------------------------------------------------------
 535+ 6DB1 23               inc  hl
 536+ 6DB2 18 A8            jr   .loop
 537+ 6DB4
 538+ 6DB4              .done:
 539+ 6DB4
 540+ 6DB4                  ; Ripristina i registri
 541+ 6DB4 FD E1            pop  iy
 542+ 6DB6 DD E1            pop  ix
 543+ 6DB8 D1               pop  de
 544+ 6DB9 C1               pop  bc
 545+ 6DBA E1               pop  hl
 546+ 6DBB
 547+ 6DBB C9               ret
 548+ 6DBC
 549+ 6DBC              ; -------------------------------------------------------------------
 550+ 6DBC              ; DrawItemGraphic
 551+ 6DBC              ;
 552+ 6DBC              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 553+ 6DBC              ; utilizzando una bitmap di 8 byte e un attributo colore.
 554+ 6DBC              ;
 555+ 6DBC              ; Input:
 556+ 6DBC              ;   B = Riga attributi (3..18)
 557+ 6DBC              ;   C = Colonna attributi (0..31)
 558+ 6DBC              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 559+ 6DBC              ;   E = Attributo colore
 560+ 6DBC              ;
 561+ 6DBC              ; Output:
 562+ 6DBC              ;   Nessuno
 563+ 6DBC              ;
 564+ 6DBC              ; Registri preservati:
 565+ 6DBC              ;   BC, DE, HL
 566+ 6DBC              ; -------------------------------------------------------------------
 567+ 6DBC              DrawItemGraphic:
 568+ 6DBC
 569+ 6DBC                  ; Salva i registri originali
 570+ 6DBC C5               push bc
 571+ 6DBD D5               push de
 572+ 6DBE E5               push hl
 573+ 6DBF
 574+ 6DBF                  ; ---------------------------------------------------------------
 575+ 6DBF                  ; Calcolo indirizzo bitmap dello Spectrum
 576+ 6DBF                  ;
 577+ 6DBF                  ; Ogni item occupa una cella attributi (8x8 pixel).
 578+ 6DBF                  ;
 579+ 6DBF                  ; Formula:
 580+ 6DBF                  ;   High = $40 + (Row AND $18)
 581+ 6DBF                  ;   Low  = (Row AND 7) * 32 + Col
 582+ 6DBF                  ;
 583+ 6DBF                  ; DE conterrà l'indirizzo della prima scanline.
 584+ 6DBF                  ; ---------------------------------------------------------------
 585+ 6DBF
 586+ 6DBF 78               ld   a, b
 587+ 6DC0 E6 18            and  $18
 588+ 6DC2 C6 40            add  a, $40
 589+ 6DC4 57               ld   d, a              ; Byte alto indirizzo video
 590+ 6DC5
 591+ 6DC5 78               ld   a, b
 592+ 6DC6 E6 07            and  7                 ; Riga interna al blocco da 8
 593+ 6DC8
 594+ 6DC8 87               add  a, a              ; *2
 595+ 6DC9 87               add  a, a              ; *4
 596+ 6DCA 87               add  a, a              ; *8
 597+ 6DCB 87               add  a, a              ; *16
 598+ 6DCC 87               add  a, a              ; *32
 599+ 6DCD
 600+ 6DCD 81               add  a, c              ; + colonna
 601+ 6DCE
 602+ 6DCE 5F               ld   e, a              ; Byte basso indirizzo video
 603+ 6DCF
 604+ 6DCF                  ; ---------------------------------------------------------------
 605+ 6DCF                  ; Disegno bitmap
 606+ 6DCF                  ;
 607+ 6DCF                  ; Copia 8 byte consecutivi nella memoria video.
 608+ 6DCF                  ; Ogni byte rappresenta una scanline da 8 pixel.
 609+ 6DCF                  ; ---------------------------------------------------------------
 610+ 6DCF
 611+ 6DCF C5               push bc                ; Conserva Row e Col
 612+ 6DD0
 613+ 6DD0 06 08            ld   b, 8              ; Numero scanline
 614+ 6DD2
 615+ 6DD2              .line_loop:
 616+ 6DD2
 617+ 6DD2 7E               ld   a, (hl)           ; Legge scanline bitmap
 618+ 6DD3 12               ld   (de), a           ; Scrive nella memoria video
 619+ 6DD4
 620+ 6DD4 14               inc  d                 ; Scanline successiva
 621+ 6DD5 23               inc  hl                ; Byte bitmap successivo
 622+ 6DD6
 623+ 6DD6 05               dec  b
 624+ 6DD7 20 F9            jr   nz, .line_loop
 625+ 6DD9
 626+ 6DD9 C1               pop  bc                ; Ripristina Row e Col
 627+ 6DDA
 628+ 6DDA                  ; ---------------------------------------------------------------
 629+ 6DDA                  ; Calcolo indirizzo attributo
 630+ 6DDA                  ;
 631+ 6DDA                  ; Formula:
 632+ 6DDA                  ;   AttrAddr = $5800 + Row * 32 + Col
 633+ 6DDA                  ;
 634+ 6DDA                  ; HL conterrà l'indirizzo della cella attributi.
 635+ 6DDA                  ; ---------------------------------------------------------------
 636+ 6DDA
 637+ 6DDA 26 00            ld   h, 0
 638+ 6DDC 68               ld   l, b              ; HL = Row
 639+ 6DDD
 640+ 6DDD 29               add  hl, hl            ; *2
 641+ 6DDE 29               add  hl, hl            ; *4
 642+ 6DDF 29               add  hl, hl            ; *8
 643+ 6DE0 29               add  hl, hl            ; *16
 644+ 6DE1 29               add  hl, hl            ; *32
 645+ 6DE2
 646+ 6DE2 79               ld   a, c              ; A = Colonna
 647+ 6DE3
 648+ 6DE3 85               add  a, l
 649+ 6DE4 6F               ld   l, a
 650+ 6DE5
 651+ 6DE5 30 01            jr   nc, .no_carry
 652+ 6DE7 24               inc  h
 653+ 6DE8
 654+ 6DE8              .no_carry:
 655+ 6DE8
 656+ 6DE8                  ; HL = Row * 32 + Col
 657+ 6DE8
 658+ 6DE8 11 00 58         ld   de, $5800
 659+ 6DEB 19               add  hl, de            ; HL = indirizzo attributi
 660+ 6DEC
 661+ 6DEC                  ; ---------------------------------------------------------------
 662+ 6DEC                  ; Recupera il colore originale dallo stack.
 663+ 6DEC                  ;
 664+ 6DEC                  ; Layout stack:
 665+ 6DEC                  ;   HL originale
 666+ 6DEC                  ;   DE originale (E = colore)
 667+ 6DEC                  ;   BC originale
 668+ 6DEC                  ; ---------------------------------------------------------------
 669+ 6DEC
 670+ 6DEC C1               pop  bc                ; Recupera HL originale
 671+ 6DED D1               pop  de                ; Recupera DE originale
 672+ 6DEE
 673+ 6DEE                  ; ---------------------------------------------------------------
 674+ 6DEE                  ; Scrive l'attributo colore
 675+ 6DEE                  ; ---------------------------------------------------------------
 676+ 6DEE
 677+ 6DEE 7B               ld   a, e              ; A = colore
 678+ 6DEF 77               ld   (hl), a           ; Scrive nella RAM attributi
 679+ 6DF0
 680+ 6DF0                  ; ---------------------------------------------------------------
 681+ 6DF0                  ; Ripristina HL e BC originali
 682+ 6DF0                  ; ---------------------------------------------------------------
 683+ 6DF0
 684+ 6DF0 C5               push bc
 685+ 6DF1 E1               pop  hl                ; HL originale
 686+ 6DF2
 687+ 6DF2 C1               pop  bc                ; BC originale
 688+ 6DF3
 689+ 6DF3 C9               ret
 690+ 6DF4
 691+ 6DF4              ; -------------------------------------------------------------------
 692+ 6DF4              ; RestoreBackgroundCell
 693+ 6DF4              ;
 694+ 6DF4              ; Ripristina il contenuto originale di una cella della stanza.
 695+ 6DF4              ; Viene utilizzata principalmente quando un item viene raccolto:
 696+ 6DF4              ; invece di lasciare un "buco", la routine ridisegna il tile
 697+ 6DF4              ; originale presente nella mappa della stanza.
 698+ 6DF4              ;
 699+ 6DF4              ; Input:
 700+ 6DF4              ;   B = Row (3..18)
 701+ 6DF4              ;   C = Col (0..31)
 702+ 6DF4              ;
 703+ 6DF4              ; Utilizza:
 704+ 6DF4              ;   room_ptr -> struttura dati della stanza corrente
 705+ 6DF4              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 706+ 6DF4              ;   DrawTile -> ridisegna il tile selezionato
 707+ 6DF4              ;
 708+ 6DF4              ; Tipi di cella:
 709+ 6DF4              ;   0 = Background
 710+ 6DF4              ;   1 = Floor
 711+ 6DF4              ;   2 = Wall
 712+ 6DF4              ;   3 = Nasty
 713+ 6DF4              ; -------------------------------------------------------------------
 714+ 6DF4              RestoreBackgroundCell:
 715+ 6DF4
 716+ 6DF4                  ; Salva tutti i registri utilizzati
 717+ 6DF4 FD E5            push iy
 718+ 6DF6 C5               push bc
 719+ 6DF7 D5               push de
 720+ 6DF8 E5               push hl
 721+ 6DF9 DD E5            push ix
 722+ 6DFB
 723+ 6DFB                  ; ---------------------------------------------------------------
 724+ 6DFB                  ; Conserva Row e Col in IY.
 725+ 6DFB                  ;
 726+ 6DFB                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 727+ 6DFB                  ; BC potrebbe essere modificato.
 728+ 6DFB                  ; ---------------------------------------------------------------
 729+ 6DFB C5               push bc
 730+ 6DFC FD E1            pop  iy                ; IYH = Row, IYL = Col
 731+ 6DFE
 732+ 6DFE                  ; ---------------------------------------------------------------
 733+ 6DFE                  ; Determina quale tipo di cella è presente nella posizione
 734+ 6DFE                  ; specificata.
 735+ 6DFE                  ;
 736+ 6DFE                  ; Input:
 737+ 6DFE                  ;   B = Row
 738+ 6DFE                  ;   C = Col
 739+ 6DFE                  ;
 740+ 6DFE                  ; Output:
 741+ 6DFE                  ;   A = tipo cella
 742+ 6DFE                  ; ---------------------------------------------------------------
 743+ 6DFE 78               ld   a, b
 744+ 6DFF
 745+ 6DFF CD BB 68         call GetCellFromUnpacked
 746+ 6E02
 747+ 6E02                  ; ---------------------------------------------------------------
 748+ 6E02                  ; Recupera il puntatore alla stanza corrente.
 749+ 6E02                  ;
 750+ 6E02                  ; DE = base della struttura stanza
 751+ 6E02                  ; ---------------------------------------------------------------
 752+ 6E02 ED 5B C5 7E      ld   de, (room_ptr)
 753+ 6E06
 754+ 6E06                  ; ---------------------------------------------------------------
 755+ 6E06                  ; Seleziona il tile corretto in base al tipo di cella.
 756+ 6E06                  ;
 757+ 6E06                  ; A = 0 -> Background
 758+ 6E06                  ; A = 1 -> Floor
 759+ 6E06                  ; A = 2 -> Wall
 760+ 6E06                  ; A = 3 -> Nasty
 761+ 6E06                  ; ---------------------------------------------------------------
 762+ 6E06
 763+ 6E06 B7               or   a
 764+ 6E07 20 06            jr   nz, .not_bg
 765+ 6E09
 766+ 6E09                  ; Background
 767+ 6E09 21 A0 00         ld   hl, OFFSET_BG
 768+ 6E0C 19               add  hl, de
 769+ 6E0D 18 16            jr   .draw_cell
 770+ 6E0F
 771+ 6E0F              .not_bg:
 772+ 6E0F
 773+ 6E0F 3D               dec  a
 774+ 6E10 20 06            jr   nz, .not_floor
 775+ 6E12
 776+ 6E12                  ; Floor
 777+ 6E12 21 A9 00         ld   hl, OFFSET_FLOOR
 778+ 6E15 19               add  hl, de
 779+ 6E16 18 0D            jr   .draw_cell
 780+ 6E18
 781+ 6E18              .not_floor:
 782+ 6E18
 783+ 6E18 3D               dec  a
 784+ 6E19 20 06            jr   nz, .not_wall
 785+ 6E1B
 786+ 6E1B                  ; Wall
 787+ 6E1B 21 B2 00         ld   hl, OFFSET_WALL
 788+ 6E1E 19               add  hl, de
 789+ 6E1F 18 04            jr   .draw_cell
 790+ 6E21
 791+ 6E21              .not_wall:
 792+ 6E21
 793+ 6E21                  ; Nasty
 794+ 6E21 21 BB 00         ld   hl, OFFSET_NASTY
 795+ 6E24 19               add  hl, de
 796+ 6E25
 797+ 6E25              .draw_cell:
 798+ 6E25
 799+ 6E25                  ; ---------------------------------------------------------------
 800+ 6E25                  ; HL punta ora alla grafica del tile da ridisegnare.
 801+ 6E25                  ;
 802+ 6E25                  ; DrawTile si aspetta:
 803+ 6E25                  ;   IX = puntatore tile
 804+ 6E25                  ;   B  = Row
 805+ 6E25                  ;   C  = Col
 806+ 6E25                  ; ---------------------------------------------------------------
 807+ 6E25 E5               push hl
 808+ 6E26 DD E1            pop  ix
 809+ 6E28
 810+ 6E28                  ; Ripristina Row e Col salvati in IY
 811+ 6E28 FD E5            push iy
 812+ 6E2A C1               pop  bc
 813+ 6E2B
 814+ 6E2B                  ; Disegna il tile originale
 815+ 6E2B CD 8C 61         call DrawTile
 816+ 6E2E
 817+ 6E2E                  ; ---------------------------------------------------------------
 818+ 6E2E                  ; Ripristina i registri salvati
 819+ 6E2E                  ; ---------------------------------------------------------------
 820+ 6E2E DD E1            pop  ix
 821+ 6E30 E1               pop  hl
 822+ 6E31 D1               pop  de
 823+ 6E32 C1               pop  bc
 824+ 6E33 FD E1            pop  iy
 825+ 6E35
 826+ 6E35 C9               ret
 827+ 6E36
 828+ 6E36              ; -------------------------------------------------------------------
 829+ 6E36              ; CheckWillyItemCollision
 830+ 6E36              ;
 831+ 6E36              ; Verifica se Willy collide con un item utilizzando il controllo
 832+ 6E36              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 833+ 6E36              ;
 834+ 6E36              ; Input:
 835+ 6E36              ;   A = ItemX (colonna attributi 0..31)
 836+ 6E36              ;   H = ItemY (riga attributi 3..18)
 837+ 6E36              ;
 838+ 6E36              ; Coordinate item:
 839+ 6E36              ;   Ogni item occupa una cella da 8x8 pixel.
 840+ 6E36              ;
 841+ 6E36              ; Coordinate Willy:
 842+ 6E36              ;   Willy occupa un rettangolo di 16x16 pixel.
 843+ 6E36              ;
 844+ 6E36              ; Output:
 845+ 6E36              ;   Carry Set   = collisione rilevata
 846+ 6E36              ;   Carry Clear = nessuna collisione
 847+ 6E36              ;
 848+ 6E36              ; Registri preservati:
 849+ 6E36              ;   BC, DE, HL
 850+ 6E36              ; -------------------------------------------------------------------
 851+ 6E36              CheckWillyItemCollision:
 852+ 6E36
 853+ 6E36                  ; Salva i registri utilizzati
 854+ 6E36 C5               push bc
 855+ 6E37 D5               push de
 856+ 6E38 E5               push hl
 857+ 6E39
 858+ 6E39                  ; ---------------------------------------------------------------
 859+ 6E39                  ; Calcola il bounding box orizzontale dell'item
 860+ 6E39                  ;
 861+ 6E39                  ; ItemLeft  = ItemX * 8
 862+ 6E39                  ; ItemRight = ItemLeft + 7
 863+ 6E39                  ;
 864+ 6E39                  ; E = ItemLeft
 865+ 6E39                  ; D = ItemRight
 866+ 6E39                  ; ---------------------------------------------------------------
 867+ 6E39 6F               ld   l, a              ; L = ItemX
 868+ 6E3A
 869+ 6E3A 7D               ld   a, l
 870+ 6E3B 87               add  a, a              ; *2
 871+ 6E3C 87               add  a, a              ; *4
 872+ 6E3D 87               add  a, a              ; *8
 873+ 6E3E
 874+ 6E3E 5F               ld   e, a              ; E = ItemLeft
 875+ 6E3F
 876+ 6E3F C6 07            add  a, 7
 877+ 6E41 57               ld   d, a              ; D = ItemRight
 878+ 6E42
 879+ 6E42                  ; ---------------------------------------------------------------
 880+ 6E42                  ; Recupera la posizione corrente di Willy
 881+ 6E42                  ;
 882+ 6E42                  ; B = WillyY
 883+ 6E42                  ; C = WillyX
 884+ 6E42                  ; ---------------------------------------------------------------
 885+ 6E42 ED 4B 57 7B      ld   bc, (PlayerPos)
 886+ 6E46
 887+ 6E46                  ; ---------------------------------------------------------------
 888+ 6E46                  ; Primo test:
 889+ 6E46                  ;
 890+ 6E46                  ; WillyLeft <= ItemRight
 891+ 6E46                  ;
 892+ 6E46                  ; Se Willy è completamente a destra dell'item
 893+ 6E46                  ; non può esserci collisione.
 894+ 6E46                  ; ---------------------------------------------------------------
 895+ 6E46 79               ld   a, c              ; A = WillyLeft
 896+ 6E47
 897+ 6E47 BA               cp   d                 ; WillyLeft vs ItemRight
 898+ 6E48
 899+ 6E48 28 04            jr   z, .x_ok
 900+ 6E4A 38 02            jr   c, .x_ok
 901+ 6E4C
 902+ 6E4C 18 29            jr   .no_collision
 903+ 6E4E
 904+ 6E4E              .x_ok:
 905+ 6E4E
 906+ 6E4E                  ; ---------------------------------------------------------------
 907+ 6E4E                  ; Secondo test:
 908+ 6E4E                  ;
 909+ 6E4E                  ; WillyRight >= ItemLeft
 910+ 6E4E                  ;
 911+ 6E4E                  ; WillyRight = WillyX + 7
 912+ 6E4E                  ; ---------------------------------------------------------------
 913+ 6E4E C6 07            add  a, 7
 914+ 6E50
 915+ 6E50 BB               cp   e                 ; WillyRight vs ItemLeft
 916+ 6E51
 917+ 6E51 28 04            jr   z, .y_check
 918+ 6E53 30 02            jr   nc, .y_check
 919+ 6E55
 920+ 6E55 18 20            jr   .no_collision
 921+ 6E57
 922+ 6E57              .y_check:
 923+ 6E57
 924+ 6E57                  ; ---------------------------------------------------------------
 925+ 6E57                  ; Recupera ItemY dal valore originale di HL
 926+ 6E57                  ;
 927+ 6E57                  ; H contiene la riga dell'item.
 928+ 6E57                  ; ---------------------------------------------------------------
 929+ 6E57 E1               pop  hl
 930+ 6E58 E5               push hl
 931+ 6E59
 932+ 6E59                  ; ---------------------------------------------------------------
 933+ 6E59                  ; Calcola il bounding box verticale dell'item
 934+ 6E59                  ;
 935+ 6E59                  ; ItemTop    = ItemY * 8
 936+ 6E59                  ; ItemBottom = ItemTop + 7
 937+ 6E59                  ;
 938+ 6E59                  ; E = ItemTop
 939+ 6E59                  ; D = ItemBottom
 940+ 6E59                  ; ---------------------------------------------------------------
 941+ 6E59 7C               ld   a, h
 942+ 6E5A
 943+ 6E5A 87               add  a, a              ; *2
 944+ 6E5B 87               add  a, a              ; *4
 945+ 6E5C 87               add  a, a              ; *8
 946+ 6E5D
 947+ 6E5D 5F               ld   e, a              ; ItemTop
 948+ 6E5E
 949+ 6E5E C6 07            add  a, 7
 950+ 6E60 57               ld   d, a              ; ItemBottom
 951+ 6E61
 952+ 6E61                  ; ---------------------------------------------------------------
 953+ 6E61                  ; Primo test verticale:
 954+ 6E61                  ;
 955+ 6E61                  ; WillyTop <= ItemBottom
 956+ 6E61                  ; ---------------------------------------------------------------
 957+ 6E61 78               ld   a, b              ; WillyTop
 958+ 6E62
 959+ 6E62 BA               cp   d
 960+ 6E63
 961+ 6E63 28 04            jr   z, .y_ok
 962+ 6E65 38 02            jr   c, .y_ok
 963+ 6E67
 964+ 6E67 18 0E            jr   .no_collision
 965+ 6E69
 966+ 6E69              .y_ok:
 967+ 6E69
 968+ 6E69                  ; ---------------------------------------------------------------
 969+ 6E69                  ; Secondo test verticale:
 970+ 6E69                  ;
 971+ 6E69                  ; WillyBottom >= ItemTop
 972+ 6E69                  ;
 973+ 6E69                  ; WillyBottom = WillyY + 15
 974+ 6E69                  ; ---------------------------------------------------------------
 975+ 6E69 C6 0F            add  a, 15
 976+ 6E6B
 977+ 6E6B BB               cp   e
 978+ 6E6C
 979+ 6E6C 28 04            jr   z, .collision
 980+ 6E6E 30 02            jr   nc, .collision
 981+ 6E70
 982+ 6E70 18 05            jr   .no_collision
 983+ 6E72
 984+ 6E72              .collision:
 985+ 6E72
 986+ 6E72                  ; ---------------------------------------------------------------
 987+ 6E72                  ; Collisione rilevata
 988+ 6E72                  ; ---------------------------------------------------------------
 989+ 6E72 E1               pop  hl
 990+ 6E73 D1               pop  de
 991+ 6E74 C1               pop  bc
 992+ 6E75
 993+ 6E75 37               scf                    ; Carry = 1
 994+ 6E76
 995+ 6E76 C9               ret
 996+ 6E77
 997+ 6E77              .no_collision:
 998+ 6E77
 999+ 6E77                  ; ---------------------------------------------------------------
1000+ 6E77                  ; Nessuna collisione
1001+ 6E77                  ; ---------------------------------------------------------------
1002+ 6E77 E1               pop  hl
1003+ 6E78 D1               pop  de
1004+ 6E79 C1               pop  bc
1005+ 6E7A
1006+ 6E7A B7               or   a                 ; Carry = 0
1007+ 6E7B
1008+ 6E7B C9               ret
1009+ 6E7C
1010+ 6E7C              ; -------------------------------------------------------------------
1011+ 6E7C              ; CheckRoomItemsCollision
1012+ 6E7C              ;
1013+ 6E7C              ; Controlla se Willy entra in collisione con uno degli item
1014+ 6E7C              ; attivi presenti nella stanza corrente.
1015+ 6E7C              ;
1016+ 6E7C              ; Per ogni item:
1017+ 6E7C              ;   - verifica che appartenga alla stanza corrente
1018+ 6E7C              ;   - verifica che non sia già stato raccolto
1019+ 6E7C              ;   - esegue il test di collisione con Willy
1020+ 6E7C              ;
1021+ 6E7C              ; Se l'item viene raccolto:
1022+ 6E7C              ;   - imposta il flag "collected"
1023+ 6E7C              ;   - rimuove l'item dalla cache items_grid
1024+ 6E7C              ;   - incrementa il contatore degli oggetti raccolti
1025+ 6E7C              ;   - aggiorna l'HUD
1026+ 6E7C              ;   - ripristina il tile di sfondo
1027+ 6E7C              ;   - riproduce il suono di raccolta
1028+ 6E7C              ;
1029+ 6E7C              ; Formato record ItemsTable:
1030+ 6E7C              ;   +0 RoomID
1031+ 6E7C              ;   +1 X
1032+ 6E7C              ;   +2 Y
1033+ 6E7C              ;   +3 Color
1034+ 6E7C              ;   +4 Collected
1035+ 6E7C              ;
1036+ 6E7C              ; Fine tabella:
1037+ 6E7C              ;   RoomID = $FF
1038+ 6E7C              ; -------------------------------------------------------------------
1039+ 6E7C              CheckRoomItemsCollision:
1040+ 6E7C
1041+ 6E7C                  ; Salva i registri utilizzati
1042+ 6E7C E5               push hl
1043+ 6E7D D5               push de
1044+ 6E7E C5               push bc
1045+ 6E7F
1046+ 6E7F                  ; Inizio scansione della tabella degli item
1047+ 6E7F 21 E3 6B         ld   hl, ItemsTable
1048+ 6E82
1049+ 6E82              .loop:
1050+ 6E82
1051+ 6E82                  ; ---------------------------------------------------------------
1052+ 6E82                  ; Legge il Room ID dell'item corrente
1053+ 6E82                  ; ---------------------------------------------------------------
1054+ 6E82 7E               ld   a, (hl)
1055+ 6E83
1056+ 6E83                  ; $FF indica fine tabella
1057+ 6E83 FE FF            cp   $FF
1058+ 6E85 28 4D            jr   z, .done
1059+ 6E87
1060+ 6E87                  ; ---------------------------------------------------------------
1061+ 6E87                  ; Verifica se l'item appartiene alla stanza corrente
1062+ 6E87                  ; ---------------------------------------------------------------
1063+ 6E87 57               ld   d, a              ; D = RoomID item
1064+ 6E88
1065+ 6E88 3A 6B 7E         ld   a, (current_room)
1066+ 6E8B BA               cp   d
1067+ 6E8C
1068+ 6E8C                  ; Se appartiene a un'altra stanza salta il record
1069+ 6E8C 20 3F            jr   nz, .next_item
1070+ 6E8E
1071+ 6E8E                  ; ---------------------------------------------------------------
1072+ 6E8E                  ; Legge coordinate e stato dell'item
1073+ 6E8E                  ; ---------------------------------------------------------------
1074+ 6E8E
1075+ 6E8E 23               inc  hl
1076+ 6E8F 4E               ld   c, (hl)           ; C = X
1077+ 6E90
1078+ 6E90 23               inc  hl
1079+ 6E91 46               ld   b, (hl)           ; B = Y
1080+ 6E92
1081+ 6E92 23               inc  hl                ; salta Color
1082+ 6E93
1083+ 6E93 23               inc  hl                ; punta a Collected
1084+ 6E94
1085+ 6E94 7E               ld   a, (hl)
1086+ 6E95
1087+ 6E95                  ; ---------------------------------------------------------------
1088+ 6E95                  ; Item già raccolto?
1089+ 6E95                  ; ---------------------------------------------------------------
1090+ 6E95 B7               or   a
1091+ 6E96 20 39            jr   nz, .next_no_inc
1092+ 6E98
1093+ 6E98                  ; ---------------------------------------------------------------
1094+ 6E98                  ; Test collisione Willy ↔ Item
1095+ 6E98                  ;
1096+ 6E98                  ; Input richiesto:
1097+ 6E98                  ;   A = ItemX
1098+ 6E98                  ;   H = ItemY
1099+ 6E98                  ; ---------------------------------------------------------------
1100+ 6E98 79               ld   a, c
1101+ 6E99
1102+ 6E99 E5               push hl                ; salva puntatore al flag Collected
1103+ 6E9A
1104+ 6E9A 60               ld   h, b
1105+ 6E9B
1106+ 6E9B CD 36 6E         call CheckWillyItemCollision
1107+ 6E9E
1108+ 6E9E E1               pop  hl
1109+ 6E9F
1110+ 6E9F                  ; Nessuna collisione
1111+ 6E9F 30 30            jr   nc, .next_no_inc
1112+ 6EA1
1113+ 6EA1                  ; ===============================================================
1114+ 6EA1                  ; ITEM RACCOLTO
1115+ 6EA1                  ; ===============================================================
1116+ 6EA1
1117+ 6EA1                  ; ---------------------------------------------------------------
1118+ 6EA1                  ; Marca l'item come raccolto
1119+ 6EA1                  ; ---------------------------------------------------------------
1120+ 6EA1 36 01            ld   (hl), 1
1121+ 6EA3
1122+ 6EA3                  ; ---------------------------------------------------------------
1123+ 6EA3                  ; Rimuove l'item dalla cache items_grid
1124+ 6EA3                  ;
1125+ 6EA3                  ; Calcolo:
1126+ 6EA3                  ;   offset = Row * 32 + Col
1127+ 6EA3                  ; ---------------------------------------------------------------
1128+ 6EA3 E5               push hl
1129+ 6EA4 D5               push de
1130+ 6EA5
1131+ 6EA5 26 00            ld   h, 0
1132+ 6EA7 68               ld   l, b              ; HL = Row
1133+ 6EA8
1134+ 6EA8 29               add  hl, hl            ; *2
1135+ 6EA9 29               add  hl, hl            ; *4
1136+ 6EAA 29               add  hl, hl            ; *8
1137+ 6EAB 29               add  hl, hl            ; *16
1138+ 6EAC 29               add  hl, hl            ; *32
1139+ 6EAD
1140+ 6EAD 59               ld   e, c
1141+ 6EAE 16 00            ld   d, 0
1142+ 6EB0
1143+ 6EB0 19               add  hl, de            ; Row*32 + Col
1144+ 6EB1
1145+ 6EB1 11 00 90         ld   de, items_grid
1146+ 6EB4 19               add  hl, de
1147+ 6EB5
1148+ 6EB5                  ; La cella non contiene più un item
1149+ 6EB5 36 00            ld   (hl), 0
1150+ 6EB7
1151+ 6EB7 D1               pop  de
1152+ 6EB8 E1               pop  hl
1153+ 6EB9
1154+ 6EB9                  ; ---------------------------------------------------------------
1155+ 6EB9                  ; Conserva il puntatore all'entry corrente
1156+ 6EB9                  ; poiché le routine successive possono alterare HL.
1157+ 6EB9                  ; ---------------------------------------------------------------
1158+ 6EB9 E5               push hl
1159+ 6EBA
1160+ 6EBA                  ; ---------------------------------------------------------------
1161+ 6EBA                  ; Aggiorna il numero di oggetti raccolti
1162+ 6EBA                  ; ---------------------------------------------------------------
1163+ 6EBA 3A 61 7B         ld   a, (items_collected)
1164+ 6EBD
1165+ 6EBD 3C               inc  a
1166+ 6EBE
1167+ 6EBE 32 61 7B         ld   (items_collected), a
1168+ 6EC1
1169+ 6EC1                  ; ---------------------------------------------------------------
1170+ 6EC1                  ; Aggiorna il contatore visualizzato a schermo
1171+ 6EC1                  ; ---------------------------------------------------------------
1172+ 6EC1 CD CB 60         call UpdateItemsCollectedDisplay
1173+ 6EC4
1174+ 6EC4                  ; ---------------------------------------------------------------
1175+ 6EC4                  ; Ripristina il tile originale della stanza
1176+ 6EC4                  ; eliminando la grafica dell'item.
1177+ 6EC4                  ;
1178+ 6EC4                  ; Input:
1179+ 6EC4                  ;   B = Row
1180+ 6EC4                  ;   C = Col
1181+ 6EC4                  ; ---------------------------------------------------------------
1182+ 6EC4 CD F4 6D         call RestoreBackgroundCell
1183+ 6EC7
1184+ 6EC7                  ; ---------------------------------------------------------------
1185+ 6EC7                  ; Riproduce il suono di raccolta
1186+ 6EC7                  ; ---------------------------------------------------------------
1187+ 6EC7 CD D8 6E         call PlayCollectSound
1188+ 6ECA
1189+ 6ECA                  ; Ripristina il puntatore alla tabella
1190+ 6ECA E1               pop  hl
1191+ 6ECB
1192+ 6ECB                  ; Continua con il record successivo
1193+ 6ECB 18 04            jr   .next_no_inc
1194+ 6ECD
1195+ 6ECD              .next_item:
1196+ 6ECD
1197+ 6ECD                  ; ---------------------------------------------------------------
1198+ 6ECD                  ; Salta i campi del record:
1199+ 6ECD                  ;   X
1200+ 6ECD                  ;   Y
1201+ 6ECD                  ;   Color
1202+ 6ECD                  ;   Collected
1203+ 6ECD                  ; ---------------------------------------------------------------
1204+ 6ECD 23               inc  hl
1205+ 6ECE 23               inc  hl
1206+ 6ECF 23               inc  hl
1207+ 6ED0 23               inc  hl
1208+ 6ED1
1209+ 6ED1              .next_no_inc:
1210+ 6ED1
1211+ 6ED1                  ; ---------------------------------------------------------------
1212+ 6ED1                  ; Avanza al record successivo.
1213+ 6ED1                  ;
1214+ 6ED1                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1215+ 6ED1                  ; ---------------------------------------------------------------
1216+ 6ED1 23               inc  hl
1217+ 6ED2
1218+ 6ED2 18 AE            jr   .loop
1219+ 6ED4
1220+ 6ED4              .done:
1221+ 6ED4
1222+ 6ED4                  ; Ripristina i registri
1223+ 6ED4 C1               pop  bc
1224+ 6ED5 D1               pop  de
1225+ 6ED6 E1               pop  hl
1226+ 6ED7
1227+ 6ED7 C9               ret
1228+ 6ED8
1229+ 6ED8              ; -------------------------------------------------------------------
1230+ 6ED8              ; PlayCollectSound
1231+ 6ED8              ;
1232+ 6ED8              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1233+ 6ED8              ; dello ZX Spectrum utilizzando il port $FE.
1234+ 6ED8              ;
1235+ 6ED8              ; Il suono viene prodotto alternando ON/OFF del bit 4
1236+ 6ED8              ; (speaker) con un semplice delay software.
1237+ 6ED8              ;
1238+ 6ED8              ; Effetto risultante:
1239+ 6ED8              ;   beep breve tipo "pickup item"
1240+ 6ED8              ; -------------------------------------------------------------------
1241+ 6ED8              PlayCollectSound:
1242+ 6ED8
1243+ 6ED8                  ; Salva registri utilizzati
1244+ 6ED8 C5               push bc
1245+ 6ED9 D5               push de
1246+ 6EDA
1247+ 6EDA                  ; ---------------------------------------------------------------
1248+ 6EDA                  ; Numero di cicli del beep (durata complessiva del suono)
1249+ 6EDA                  ; ---------------------------------------------------------------
1250+ 6EDA 06 78            ld   b, 120
1251+ 6EDC
1252+ 6EDC              .sound_loop:
1253+ 6EDC
1254+ 6EDC                  ; ---------------------------------------------------------------
1255+ 6EDC                  ; SPEAKER ON
1256+ 6EDC                  ;
1257+ 6EDC                  ; Legge il colore del bordo corrente e attiva il bit 4
1258+ 6EDC                  ; per pilotare lo speaker.
1259+ 6EDC                  ; ---------------------------------------------------------------
1260+ 6EDC 3A 63 7B         ld   a, (room_border_color)
1261+ 6EDF F6 10            or   $10               ; bit 4 = 1 → speaker ON
1262+ 6EE1
1263+ 6EE1 D3 FE            out  ($fe), a         ; scrive sul port ULA
1264+ 6EE3
1265+ 6EE3                  ; ---------------------------------------------------------------
1266+ 6EE3                  ; Delay (mezzo periodo)
1267+ 6EE3                  ; Loop software a consumo CPU
1268+ 6EE3                  ; ---------------------------------------------------------------
1269+ 6EE3 0E 3C            ld   c, 60
1270+ 6EE5
1271+ 6EE5              .d1:
1272+ 6EE5 0D               dec  c
1273+ 6EE6 20 FD            jr   nz, .d1
1274+ 6EE8
1275+ 6EE8                  ; ---------------------------------------------------------------
1276+ 6EE8                  ; SPEAKER OFF
1277+ 6EE8                  ;
1278+ 6EE8                  ; Mantiene il colore del bordo ma disattiva lo speaker
1279+ 6EE8                  ; ---------------------------------------------------------------
1280+ 6EE8 3A 63 7B         ld   a, (room_border_color)
1281+ 6EEB E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1282+ 6EED
1283+ 6EED D3 FE            out  ($fe), a
1284+ 6EEF
1285+ 6EEF                  ; ---------------------------------------------------------------
1286+ 6EEF                  ; Secondo delay (mezzo periodo)
1287+ 6EEF                  ; Completa l’onda quadra
1288+ 6EEF                  ; ---------------------------------------------------------------
1289+ 6EEF 0E 3C            ld   c, 60
1290+ 6EF1
1291+ 6EF1              .d2:
1292+ 6EF1 0D               dec  c
1293+ 6EF2 20 FD            jr   nz, .d2
1294+ 6EF4
1295+ 6EF4                  ; ---------------------------------------------------------------
1296+ 6EF4                  ; Ripete fino a completare il numero di cicli
1297+ 6EF4                  ; ---------------------------------------------------------------
1298+ 6EF4 10 E6            djnz .sound_loop
1299+ 6EF6
1300+ 6EF6                  ; Ripristina registri salvati
1301+ 6EF6 D1               pop  de
1302+ 6EF7 C1               pop  bc
1303+ 6EF8
1304+ 6EF8 C9               ret
1305+ 6EF9
1306+ 6EF9              ; -------------------------------------------------------------------
1307+ 6EF9              ; CheckActiveItemAtCell
1308+ 6EF9              ;
1309+ 6EF9              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1310+ 6EF9              ; nella cella specificata della griglia items_grid.
1311+ 6EF9              ;
1312+ 6EF9              ; Questa routine usa una lookup diretta su una mappa 32x16,
1313+ 6EF9              ; evitando la scansione della ItemsTable.
1314+ 6EF9              ;
1315+ 6EF9              ; Input:
1316+ 6EF9              ;   B = Colonna (0..31)
1317+ 6EF9              ;   C = Riga (0..15)
1318+ 6EF9              ;
1319+ 6EF9              ; Output:
1320+ 6EF9              ;   Carry Set   = item presente nella cella
1321+ 6EF9              ;   Carry Clear = nessun item
1322+ 6EF9              ;
1323+ 6EF9              ; Nota:
1324+ 6EF9              ;   HL NON è restituito valido (commento originale non corretto:
1325+ 6EF9              ;   la routine non punta a ItemsTable).
1326+ 6EF9              ; -------------------------------------------------------------------
1327+ 6EF9              CheckActiveItemAtCell:
1328+ 6EF9
1329+ 6EF9                  ; Salva registri usati
1330+ 6EF9 D5               push de
1331+ 6EFA E5               push hl
1332+ 6EFB
1333+ 6EFB                  ; ---------------------------------------------------------------
1334+ 6EFB                  ; Calcolo indice lineare nella griglia 32x16:
1335+ 6EFB                  ;
1336+ 6EFB                  ; offset = Row * 32 + Col
1337+ 6EFB                  ; ---------------------------------------------------------------
1338+ 6EFB 26 00            ld   h, 0
1339+ 6EFD 69               ld   l, c              ; HL = Row
1340+ 6EFE
1341+ 6EFE 29               add  hl, hl            ; *2
1342+ 6EFF 29               add  hl, hl            ; *4
1343+ 6F00 29               add  hl, hl            ; *8
1344+ 6F01 29               add  hl, hl            ; *16
1345+ 6F02 29               add  hl, hl            ; *32
1346+ 6F03
1347+ 6F03                  ; Aggiunge la colonna
1348+ 6F03 58               ld   e, b
1349+ 6F04 16 00            ld   d, 0
1350+ 6F06 19               add  hl, de            ; HL = Row*32 + Col
1351+ 6F07
1352+ 6F07                  ; ---------------------------------------------------------------
1353+ 6F07                  ; Accesso alla griglia degli item attivi
1354+ 6F07                  ; ---------------------------------------------------------------
1355+ 6F07 11 00 90         ld   de, items_grid
1356+ 6F0A 19               add  hl, de            ; HL = address cella
1357+ 6F0B
1358+ 6F0B                  ; ---------------------------------------------------------------
1359+ 6F0B                  ; Controllo presenza item
1360+ 6F0B                  ;
1361+ 6F0B                  ; items_grid contiene:
1362+ 6F0B                  ;   0 = nessun item
1363+ 6F0B                  ;   >0 = item attivo (colore o flag)
1364+ 6F0B                  ; ---------------------------------------------------------------
1365+ 6F0B 7E               ld   a, (hl)
1366+ 6F0C B7               or   a
1367+ 6F0D 28 04            jr   z, .not_active
1368+ 6F0F
1369+ 6F0F                  ; ---------------------------------------------------------------
1370+ 6F0F                  ; Item trovato
1371+ 6F0F                  ; ---------------------------------------------------------------
1372+ 6F0F E1               pop  hl
1373+ 6F10 D1               pop  de
1374+ 6F11
1375+ 6F11 37               scf                    ; Carry = 1
1376+ 6F12 C9               ret
1377+ 6F13
1378+ 6F13              .not_active:
1379+ 6F13
1380+ 6F13                  ; ---------------------------------------------------------------
1381+ 6F13                  ; Nessun item nella cella
1382+ 6F13                  ; ---------------------------------------------------------------
1383+ 6F13 E1               pop  hl
1384+ 6F14 D1               pop  de
1385+ 6F15
1386+ 6F15 B7               or   a                 ; Carry = 0
1387+ 6F16 C9               ret
1388+ 6F17
# file closed: items.asm
