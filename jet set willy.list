  40+ 6898 FE F0            cp   PLAYER_MAX_X      ; Confronta con il limite destro
  41+ 689A 28 02            jr   z, .ok_right      ; Se == PLAYER_MAX_X, va bene
  42+ 689C 30 03            jr   nc, .clamp_right  ; Se > PLAYER_MAX_X (senza carry, cioè maggiore), clampa
  43+ 689E              .ok_right:
