  51  7F7C CD 07 72         call DrawRoomItems
  52  7F7F CD 84 6C         call LoadRoomEnemies
  53  7F82
  54  7F82 3A 61 77         ld   a, (transition_active)
  55  7F85 B7               or   a
  56  7F86 20 05            jr   nz, .skip_player_pos
  57  7F88 CD 17 65         call LoadPositionPlayeinRoom
  58  7F8B 18 04            jr   .after_player_pos
  59  7F8D              .skip_player_pos:
  60  7F8D AF               xor  a
  61  7F8E 32 61 77         ld   (transition_active), a
