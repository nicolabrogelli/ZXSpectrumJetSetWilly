  71+ 7453              ; UpdateMusic
  72+ 7453              ;
  73+ 7453              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 7453              ; Viene chiamata a ogni frame.
  75+ 7453              ; -------------------------------------------------------------------
  76+ 7453              UpdateMusic:
  77+ 7453 F5               push af
  78+ 7454 C5               push bc
  79+ 7455 D5               push de
  80+ 7456 E5               push hl
  81+ 7457
  82+ 7457                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 7457 3A 7A 78         ld   a, (jump_sound_note)
  84+ 745A FE 12            cp   18
  85+ 745C 38 5A            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 745E
  87+ 745E                  ; Decrementa il contatore dei frame della nota corrente
  88+ 745E 3A 7D 78         ld   a, (music_frame_counter)
  89+ 7461 3D               dec  a
  90+ 7462 32 7D 78         ld   (music_frame_counter), a
  91+ 7465 20 23            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 7467
  93+ 7467                  ; Altrimenti carica la nota successiva
  94+ 7467 3A 7C 78         ld   a, (music_note_idx)
  95+ 746A 3C               inc  a
  96+ 746B FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 746D 38 01            jr   c, .no_wrap
  98+ 746F AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 7470              .no_wrap:
 100+ 7470 32 7C 78         ld   (music_note_idx), a
 101+ 7473
 102+ 7473                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 7473 5F               ld   e, a
 104+ 7474 16 00            ld   d, 0
 105+ 7476 21 BD 74         ld   hl, MusicSheet
 106+ 7479 19               add  hl, de
 107+ 747A 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 747B
 109+ 747B                  ; Leggi durata (secondo byte)
 110+ 747B 23               inc  hl
 111+ 747C 7E               ld   a, (hl)
 112+ 747D CB 3F            srl  a                        ; Divide per 8 (velocizza 8x)
 113+ 747F CB 3F            srl  a
