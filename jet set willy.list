 118+ 79E8              .play_current_note:
 119+ 79E8                  ; Ottieni il delay della nota corrente (primo byte)
 120+ 79E8 3A 05 7E         ld   a, (Audio_music_note_idx)
 121+ 79EB 5F               ld   e, a
 122+ 79EC 16 00            ld   d, 0
 123+ 79EE 21 1B 7A         ld   hl, Audio_MusicSheet
 124+ 79F1 19               add  hl, de
 125+ 79F2 19               add  hl, de                   ; hl punta al primo byte della nota
 126+ 79F3 7E               ld   a, (hl)                  ; A = delay
 127+ 79F4 B7               or   a
 128+ 79F5 28 1F            jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 129+ 79F7
 130+ 79F7                  ; Suona la nota: 2 cicli
 131+ 79F7 57               ld   d, a                     ; D = delay
 132+ 79F8 06 02            ld   b, 2                     ; 2 cicli per frame
 133+ 79FA              .note_loop:
 134+ 79FA                  ; Speaker ON
 135+ 79FA 3A 8E 7A         ld   a, (room_border_color)
 136+ 79FD F6 10            or   $10
 137+ 79FF D3 FE            out  ($fe), a
 138+ 7A01 4A               ld   c, d
 139+ 7A02              .d1:
 140+ 7A02 F5               push af
 141+ 7A03 F1               pop  af
 142+ 7A04 0D               dec  c
 143+ 7A05 20 FB            jr   nz, .d1
 144+ 7A07
 145+ 7A07                  ; Speaker OFF
 146+ 7A07 3A 8E 7A         ld   a, (room_border_color)
 147+ 7A0A E6 EF            and  $ef
 148+ 7A0C D3 FE            out  ($fe), a
 149+ 7A0E 4A               ld   c, d
 150+ 7A0F              .d2:
 151+ 7A0F F5               push af
 152+ 7A10 F1               pop  af
 153+ 7A11 0D               dec  c
 154+ 7A12 20 FB            jr   nz, .d2
 155+ 7A14
 156+ 7A14 10 E4            djnz .note_loop
