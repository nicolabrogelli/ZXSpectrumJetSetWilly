  63+ 6C32              ; DetermineCurrentRoomID
  64+ 6C32              ;
  65+ 6C32              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 6C32              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 6C32              ;
  68+ 6C32              ; Se viene trovata una corrispondenza:
  69+ 6C32              ;   A = ID della stanza
  70+ 6C32              ;   current_room = A
