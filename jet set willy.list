 190+ 827D
 191+ 827D              ; -------------------------------------------------------------------
 192+ 827D              ; DetermineCurrentRoomID
 193+ 827D              ;
 194+ 827D              ; Determina l'ID numerico della stanza corrente confrontando
 195+ 827D              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 196+ 827D              ;
 197+ 827D              ; Se viene trovata una corrispondenza:
 198+ 827D              ;   A = ID della stanza
 199+ 827D              ;   current_room = A
 200+ 827D              ;
 201+ 827D              ; Mappatura:
 202+ 827D              ;    0 = The Off Licence
 203+ 827D              ;    1 = The Bridge
 204+ 827D              ;    2 = Under The Mega Tree
 205+ 827D              ;    3 = Gfx_At The Foot Of The Mega Tree
 206+ 827D              ;    4 = The Drive
 207+ 827D              ;    5 = The Security Guard
 208+ 827D              ;    6 = Entrance To Hades
 209+ 827D              ;    7 = Cuckoo's Nest
 210+ 827D              ;    8 = Inside The Mega Trunk
 211+ 827D              ;    9 = On A Branch Over The Drive
 212+ 827D              ;   10 = The Front Door
 213+ 827D              ;   11 = The Hall
 214+ 827D              ;   12 = Tree Top
 215+ 827D              ;   27 = The Chapel
 216+ 827D              ;   28 = First Landing
 217+ 827D              ;   29 = The Nightmare Room
 218+ 827D              ;   33 = The Bathroom
 219+ 827D              ;   35 = Master Bedroom
 220+ 827D              ;
 221+ 827D              ; Se nessuna stanza corrisponde viene impostato:
 222+ 827D              ;   current_room = 0
 223+ 827D              ; -------------------------------------------------------------------
 224+ 827D              DetermineCurrentRoomID:
 225+ 827D
