 772+ 6101 81               add  a, c              ; + Col C
 773+ 6102 6F               ld   l, a              ; L = Low byte
 774+ 6103
 775+ 6103                  ; 2. Copia gli 8 byte del bitmap
 776+ 6103 16 08            ld   d, 8              ; 8 scanline
 777+ 6105 DD E5            push ix
 778+ 6107 DD 23            inc  ix                ; Salta l'attributo, vai al bitmap
