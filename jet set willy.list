1385+ 6D51 B7               or   a
1386+ 6D52 20 0C            jr   nz, .custom_settings
1387+ 6D54
1388+ 6D54 3E 06            ld   a, 6
1389+ 6D56 32 34 7A         ld   (room_jump_strength), a
1390+ 6D59 3E 01            ld   a, 1
1391+ 6D5B 32 35 7A         ld   (room_gravity_preset), a
1392+ 6D5E 18 12            jr   .done
1393+ 6D60
1394+ 6D60              .custom_settings:
1395+ 6D60 F5               push af
1396+ 6D61 E6 0F            and  $0f                  ; Maschera i 4 bit inferiori (JJJJ)
1397+ 6D63 32 34 7A         ld   (room_jump_strength), a
1398+ 6D66 F1               pop  af
1399+ 6D67 CB 3F            srl  a
1400+ 6D69 CB 3F            srl  a
1401+ 6D6B CB 3F            srl  a
1402+ 6D6D CB 3F            srl  a                  ; Sposta i 4 bit superiori in quelli inferiori (GGGG)
1403+ 6D6F 32 35 7A         ld   (room_gravity_preset), a
1404+ 6D72
1405+ 6D72              .done:
1406+ 6D72 F1               pop  af
1407+ 6D73 D1               pop  de
1408+ 6D74 E1               pop  hl
1409+ 6D75 C9               ret
