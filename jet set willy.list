 225+ 7C3A                  ; ---------------------------------------------------------------
 226+ 7C3A 2A 3D EA         ld   hl, (room_ptr)
 227+ 7C3D 11 97 84         ld   de, TheOffLicenceLayout
 228+ 7C40 B7               or   a
 229+ 7C41 ED 52            sbc  hl, de
 230+ 7C43 20 05            jr   nz, .not_office
 231+ 7C45
 232+ 7C45 3E 00            ld   a, 0               ; Room ID = 0
 233+ 7C47 C3 0C 80         jp   .set_room
 234+ 7C4A
 235+ 7C4A              .not_office:
