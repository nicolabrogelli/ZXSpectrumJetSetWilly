 406  877F              ; -------------------------------------------------------------------
 407  877F              ; ResetFullGameState
 408  877F              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 409  877F              ; per l'avvio di una nuova partita dopo il Game Over.
 410  877F              ; -------------------------------------------------------------------
 411  877F              ResetFullGameState:
 412  877F                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 413  877F AF               xor  a
 414  8780 D3 FE            out  ($fe), a              ; Bordo a nero
 415  8782 21 8D 5C         ld   hl, ATTR_P
 416  8785 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 417  8786 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 418  8789 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 419  878B 3E 07            ld   a, $07
 420  878D 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 421  8790
 422  8790                  ; Ripristina il numero di vite iniziali
 423  8790 3E 07            ld   a, INITIAL_LIVES
 424  8792 32 8C EA         ld   (willy_lives), a
 425  8795
 426  8795                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 427  8795 AF               xor  a
 428  8796 32 89 EA         ld   (items_collected), a
 429  8799 32 85 EA         ld   (body_state), a
 430  879C 32 98 EA         ld   (w_warp_state), a
 431  879F 32 9B EA         ld   (w_key_prev), a
 432  87A2 32 9C EA         ld   (enter_key_prev), a
 433  87A5 32 8D EA         ld   (velocity_y), a
 434  87A8 32 8F EA         ld   (jump_pressed), a
 435  87AB 32 91 EA         ld   (coyote_timer), a
 436  87AE 32 94 EA         ld   (jump_frame), a
 437  87B1 32 93 EA         ld   (jump_dir), a
 438  87B4 32 05 EE         ld   (transition_active), a
 439  87B7 32 89 EE         ld   (willy_safety_timer), a
 440  87BA 3E FF            ld   a, $ff
 441  87BC 32 9D EA         ld   (digit_key_prev), a
 442  87BF 3E 01            ld   a, 1
 443  87C1 32 96 EA         ld   (q_prev), a
 444  87C4 32 97 EA         ld   (a_prev), a
 445  87C7 32 8E EA         ld   (on_ground), a
 446  87CA
 447  87CA                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 448  87CA 3E 30            ld   a, '0'
 449  87CC 32 1A 67         ld   (status_line + 16), a
 450  87CF 32 1B 67         ld   (status_line + 17), a
 451  87D2 32 1C 67         ld   (status_line + 18), a
 452  87D5
 453  87D5                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 454  87D5 CD 6E 83         call ResetItemsTable
 455  87D8
