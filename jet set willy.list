 327  8BA9                  ; Controlla se la melodia è finita (terminatore 255): se sì, ricomincia in loop
 328  8BA9 7E               ld   a, (hl)
 329  8BAA FE FF            cp   255
 330  8BAC 20 03            jr   nz, .play_title_note
 331  8BAE 21 5A 89         ld   hl, Audio_TitleMusicSheet
 332  8BB1              .play_title_note:
 333  8BB1 CD 1A 89         call Audio_PlayTitleNote   ; Suona una nota della melodia e controlla ENTER
 334  8BB4 28 03            jr   z, .enter_pressed     ; Z flag = 1 -> ENTER premuto!
 335  8BB6 23               inc  hl
 336  8BB7 18 D9            jr   .title_loop
 337  8BB9                  ELSE
 338  8BB9 ~                halt
 339  8BB9 ~                ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 340  8BB9 ~                ld   a, $bf
 341  8BB9 ~                in   a, ($fe)
 342  8BB9 ~                rra
 343  8BB9 ~                jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 344  8BB9                  ENDIF
 345  8BB9
 346  8BB9              .enter_pressed:
 347  8BB9                  ; Spegne lo speaker
 348  8BB9 AF               xor  a
 349  8BBA D3 FE            out  ($fe), a
 350  8BBC
 351  8BBC                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 352  8BBC              .wait_title_enter_release_after:
 353  8BBC 76               halt
 354  8BBD 3E BF            ld   a, $bf
 355  8BBF DB FE            in   a, ($fe)
 356  8BC1 1F               rra
 357  8BC2 30 F8            jr   nc, .wait_title_enter_release_after
 358  8BC4
 359  8BC4                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 360  8BC4 AF               xor  a
 361  8BC5 D3 FE            out  ($fe), a              ; Bordo a nero
 362  8BC7 21 8D 5C         ld   hl, ATTR_P
 363  8BCA 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 364  8BCB CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 365  8BCE 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 366  8BD0 3E 07            ld   a, $07
 367  8BD2 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 368  8BD5
 369  8BD5                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 370  8BD5 CD 44 8E         call ResetFullGameState
 371  8BD8
 372  8BD8                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 373  8BD8 C3 5B 8A         jp   LoadRoomAndRestart
 374  8BDB
 375  8BDB              ; -------------------------------------------------------------------
 376  8BDB              ; TriggerGameOver
 377  8BDB              ; Scatena la schermata di Game Over per la stanza corrente.
 378  8BDB              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 379  8BDB              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 380  8BDB              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 381  8BDB              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 382  8BDB              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 383  8BDB              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 384  8BDB              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 385  8BDB              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 386  8BDB              ; -------------------------------------------------------------------
 387  8BDB              TriggerGameOver:
 388  8BDB                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 389  8BDB CD FC 64         call Gfx_DrawGameOverScreen
 390  8BDE
 391  8BDE                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 392  8BDE              .wait_keys_release:
 393  8BDE 76               halt
 394  8BDF                  ; Controlla tasto Y (Porta $DF, bit 4)
 395  8BDF 01 FE DF         ld   bc, $dffe
 396  8BE2 ED 78            in   a, (c)
 397  8BE4 CB 67            bit  4, a
 398  8BE6 28 F6            jr   z, .wait_keys_release
 399  8BE8
 400  8BE8                  ; Controlla tasto N (Porta $7F, bit 3)
 401  8BE8 01 FE 7F         ld   bc, $7ffe
 402  8BEB ED 78            in   a, (c)
 403  8BED CB 5F            bit  3, a
 404  8BEF 28 ED            jr   z, .wait_keys_release
 405  8BF1
 406  8BF1                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 407  8BF1 01 FE BF         ld   bc, $bffe
 408  8BF4 ED 78            in   a, (c)
 409  8BF6 CB 47            bit  0, a
 410  8BF8 28 E4            jr   z, .wait_keys_release
