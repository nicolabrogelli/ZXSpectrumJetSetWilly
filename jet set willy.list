 481  8BFC
 482  8BFC                  ; - Se il Game Over era avvenuto per limite di tempo (12:00 AM), ripristina a 07:00 AM
 483  8BFC 3A F7 FB         ld   a, (time_period)
 484  8BFF B7               or   a
 485  8C00 20 19            jr   nz, .keep_current_time
 486  8C02 3A F5 FB         ld   a, (time_hours)
 487  8C05 FE 0C            cp   12
 488  8C07 20 12            jr   nz, .keep_current_time
 489  8C09 3E 07            ld   a, 7
 490  8C0B 32 F5 FB         ld   (time_hours), a
 491  8C0E AF               xor  a
 492  8C0F 32 F6 FB         ld   (time_minutes), a
 493  8C12 32 F7 FB         ld   (time_period), a
 494  8C15 32 FA FB         ld   (game_objective_completed), a
 495  8C18 CD 6B 68         call Gfx_UpdateTimeDisplay
 496  8C1B              .keep_current_time:
