1046+ 74F6                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
1047+ 74F6 3A 82 EE         ld   a, (ramp_dir)
1048+ 74F9 B7               or   a
1049+ 74FA 28 1A            jr   z, .range_left
1050+ 74FC              .range_right:
1051+ 74FC 3A 85 EE         ld   a, (ramp_col)
1052+ 74FF 47               ld   b, a              ; B = ramp_col
1053+ 7500 3A 83 EE         ld   a, (ramp_len)
1054+ 7503 80               add  a, b              ; A = ramp_col + ramp_len
1055+ 7504 4F               ld   c, a              ; C = limit_right (exclusive)
1056+ 7505
1057+ 7505 7B               ld   a, e              ; A = Col
1058+ 7506 B8               cp   b
1059+ 7507 38 34            jr   c, .check_platform_case ; Col < ramp_col
1060+ 7509 B9               cp   c
1061+ 750A 30 31            jr   nc, .check_platform_case ; Col >= limit_right
1062+ 750C
1063+ 750C                  ; Calcola B = Col - ramp_col
1064+ 750C 7B               ld   a, e
1065+ 750D 90               sub  b
1066+ 750E 47               ld   b, a              ; B = offset (0..ramp_len-1)
1067+ 750F
1068+ 750F                  ; SlopeRow = ramp_row - B
1069+ 750F 3A 84 EE         ld   a, (ramp_row)
1070+ 7512 90               sub  b
1071+ 7513 47               ld   b, a              ; B = SlopeRow
