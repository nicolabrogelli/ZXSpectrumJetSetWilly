 696+ 6A9E B7               or   a
 697+ 6A9F 28 25            jr   z, .not_solid     ; Se non c'è rampa, fine
 698+ 6AA1
 699+ 6AA1 3A 42 7D         ld   a, (ramp_row)     ; A = RampRowStart
 700+ 6AA4 BA               cp   d                 ; compare with player row D
 701+ 6AA5 38 1F            jr   c, .not_solid     ; if RampRowStart < D, skip!
 702+ 6AA7
 703+ 6AA7 92               sub  d                 ; A = RampRowStart - D
 704+ 6AA8 47               ld   b, a              ; B = distance from start row (0..ramp_len-1)
 705+ 6AA9 3A 41 7D         ld   a, (ramp_len)
