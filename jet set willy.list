1349+ 7409              ; CheckActiveItemAtCell
1350+ 7409              ;
1351+ 7409              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1352+ 7409              ; nella cella specificata della griglia items_grid.
1353+ 7409              ;
1354+ 7409              ; Questa routine usa una lookup diretta su una mappa 32x16,
1355+ 7409              ; evitando la scansione della ItemsTable.
1356+ 7409              ;
1357+ 7409              ; Input:
1358+ 7409              ;   B = Colonna (0..31)
1359+ 7409              ;   C = Riga (0..15)
1360+ 7409              ;
1361+ 7409              ; Output:
1362+ 7409              ;   Carry Set   = item presente nella cella
1363+ 7409              ;   Carry Clear = nessun item
1364+ 7409              ;
1365+ 7409              ; Nota:
1366+ 7409              ;   HL NON è restituito valido (commento originale non corretto:
1367+ 7409              ;   la routine non punta a ItemsTable).
1368+ 7409              ; -------------------------------------------------------------------
1369+ 7409              CheckActiveItemAtCell:
1370+ 7409
1371+ 7409                  ; Salva registri usati
1372+ 7409 D5               push de
1373+ 740A E5               push hl
1374+ 740B
1375+ 740B                  ; ---------------------------------------------------------------
1376+ 740B                  ; Calcolo indice lineare nella griglia 32x16:
1377+ 740B                  ;
1378+ 740B                  ; offset = Row * 32 + Col
1379+ 740B                  ; ---------------------------------------------------------------
1380+ 740B 26 00            ld   h, 0
1381+ 740D 69               ld   l, c              ; HL = Row
1382+ 740E
1383+ 740E 29               add  hl, hl            ; *2
1384+ 740F 29               add  hl, hl            ; *4
1385+ 7410 29               add  hl, hl            ; *8
1386+ 7411 29               add  hl, hl            ; *16
1387+ 7412 29               add  hl, hl            ; *32
1388+ 7413
1389+ 7413                  ; Aggiunge la colonna
1390+ 7413 58               ld   e, b
1391+ 7414 16 00            ld   d, 0
1392+ 7416 19               add  hl, de            ; HL = Row*32 + Col
1393+ 7417
1394+ 7417                  ; ---------------------------------------------------------------
1395+ 7417                  ; Accesso alla griglia degli item attivi
1396+ 7417                  ; ---------------------------------------------------------------
1397+ 7417 11 00 B0         ld   de, items_grid
1398+ 741A 19               add  hl, de            ; HL = address cella
1399+ 741B
1400+ 741B                  ; ---------------------------------------------------------------
1401+ 741B                  ; Controllo presenza item
1402+ 741B                  ;
1403+ 741B                  ; items_grid contiene:
1404+ 741B                  ;   0 = nessun item
1405+ 741B                  ;   >0 = item attivo (colore o flag)
1406+ 741B                  ; ---------------------------------------------------------------
1407+ 741B 7E               ld   a, (hl)
1408+ 741C B7               or   a
1409+ 741D 28 04            jr   z, .not_active
1410+ 741F
