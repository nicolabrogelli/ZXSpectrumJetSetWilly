 295+ 5F1E                  ; 6. Calcola offset scanline: s = Y % 8 (in D)
 296+ 5F1E 7A               ld   a, d
 297+ 5F1F E6 07            and  7                 ; A = s (0..7)
 298+ 5F21 3C               inc  a                 ; A = 1 + s
 299+ 5F22 85               add  a, l
