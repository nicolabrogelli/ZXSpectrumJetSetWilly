  79+ 6C34              ;    6 = Entrance To Hades
  80+ 6C34              ;    7 = Cuckoo's Nest
  81+ 6C34              ;    8 = Inside The Mega Trunk
  82+ 6C34              ;    9 = On A Branch Over The Drive
  83+ 6C34              ;   10 = The Fornt Door
  84+ 6C34              ;   33 = The Bathroom
  85+ 6C34              ;   35 = Master Bedroom
  86+ 6C34              ;
  87+ 6C34              ; Se nessuna stanza corrisponde viene impostato:
  88+ 6C34              ;   current_room = 0
