 378+ 6CEC 20 06            jr   nz, .not_floor
 379+ 6CEE 21 A9 00         ld   hl, OFFSET_FLOOR
 380+ 6CF1 19               add  hl, de
 381+ 6CF2 18 0D            jr   .draw_cell
