1243+ 754D              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1244+ 754D              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1245+ 754D              ; -------------------------------------------------------------------
1246+ 754D              UnpackRoomLayout:
1247+ 754D E5               push hl
1248+ 754E D5               push de
1249+ 754F C5               push bc
1250+ 7550
1251+ 7550 2A 6A EE         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1252+ 7553 11 10 EC         ld   de, unpacked_layout ; DE = buffer RAM
1253+ 7556 06 80            ld   b, 128             ; 128 byte
1254+ 7558              .byte_loop:
1255+ 7558 7E               ld   a, (hl)            ; Leggi byte compresso
1256+ 7559 23               inc  hl
1257+ 755A
1258+ 755A 4F               ld   c, a               ; C = salvataggio
1259+ 755B
1260+ 755B                  ; Cella 0: bit 7-6
1261+ 755B 07               rlca
1262+ 755C 07               rlca
1263+ 755D E6 03            and  3
1264+ 755F 12               ld   (de), a
1265+ 7560 13               inc  de
1266+ 7561
1267+ 7561                  ; Cella 1: bit 5-4
1268+ 7561 79               ld   a, c
1269+ 7562 07               rlca
1270+ 7563 07               rlca
1271+ 7564 07               rlca
1272+ 7565 07               rlca
1273+ 7566 E6 03            and  3
1274+ 7568 12               ld   (de), a
1275+ 7569 13               inc  de
1276+ 756A
1277+ 756A                  ; Cella 2: bit 3-2
1278+ 756A 79               ld   a, c
1279+ 756B 0F               rrca
1280+ 756C 0F               rrca
1281+ 756D E6 03            and  3
1282+ 756F 12               ld   (de), a
1283+ 7570 13               inc  de
1284+ 7571
1285+ 7571                  ; Cella 3: bit 1-0
1286+ 7571 79               ld   a, c
1287+ 7572 E6 03            and  3
1288+ 7574 12               ld   (de), a
1289+ 7575 13               inc  de
1290+ 7576
1291+ 7576 10 E0            djnz .byte_loop
1292+ 7578
1293+ 7578 C1               pop  bc
1294+ 7579 D1               pop  de
1295+ 757A E1               pop  hl
1296+ 757B C9               ret
