1236+ 742E                  ; ---------------------------------------------------------------
1237+ 742E 36 01            ld   (hl), 1
1238+ 7430
1239+ 7430                  ; ---------------------------------------------------------------
1240+ 7430                  ; Rimuove l'item dalla cache items_grid
