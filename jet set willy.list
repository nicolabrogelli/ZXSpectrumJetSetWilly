 432+ 7207
 433+ 7207              ; -------------------------------------------------------------------
 434+ 7207              ; DrawRoomItems
 435+ 7207              ;
 436+ 7207              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 437+ 7207              ;
 438+ 7207              ; Operazioni eseguite:
 439+ 7207              ;   1. Azzera la griglia items_grid.
 440+ 7207              ;   2. Svuota la cache degli oggetti attivi.
 441+ 7207              ;   3. Scansiona ItemsTable.
 442+ 7207              ;   4. Per ogni item della stanza corrente:
 443+ 7207              ;        - verifica se è già stato raccolto
 444+ 7207              ;        - disegna la grafica
 445+ 7207              ;        - aggiorna items_grid
 446+ 7207              ;        - memorizza l'item nella cache current_room_items
 447+ 7207              ;   5. Aggiorna num_room_items.
 448+ 7207              ;
 449+ 7207              ; Record ItemsTable:
 450+ 7207              ;   +0  Room ID
 451+ 7207              ;   +1  X (colonna)
 452+ 7207              ;   +2  Y (riga)
 453+ 7207              ;   +3  Colore
 454+ 7207              ;   +4  Collected flag
 455+ 7207              ;
 456+ 7207              ; Cache current_room_items:
 457+ 7207              ;   +0  Colonna
 458+ 7207              ;   +1  Riga
 459+ 7207              ;   +2  Colore
 460+ 7207              ;   +3  Collected flag ptr (Low)
 461+ 7207              ;   +4  Collected flag ptr (High)
 462+ 7207              ;
 463+ 7207              ; Ogni record cache occupa 5 byte.
 464+ 7207              ; -------------------------------------------------------------------
 465+ 7207              DrawRoomItems:
 466+ 7207
 467+ 7207                  ; Salva tutti i registri utilizzati
 468+ 7207 E5               push hl
 469+ 7208 D5               push de
 470+ 7209 C5               push bc
 471+ 720A DD E5            push ix
 472+ 720C FD E5            push iy
 473+ 720E
 474+ 720E                  ; ---------------------------------------------------------------
 475+ 720E                  ; Azzera items_grid (32 x 16 = 512 byte)
 476+ 720E                  ; ---------------------------------------------------------------
 477+ 720E 21 00 B0         ld   hl, items_grid
 478+ 7211 11 01 B0         ld   de, items_grid + 1
 479+ 7214 36 00            ld   (hl), 0
 480+ 7216 01 FF 01         ld   bc, 511
 481+ 7219 ED B0            ldir
 482+ 721B
 483+ 721B                  ; ---------------------------------------------------------------
 484+ 721B                  ; Nessun item attivo nella stanza
 485+ 721B                  ; ---------------------------------------------------------------
 486+ 721B AF               xor  a
 487+ 721C 32 5B 77         ld   (num_room_items), a
 488+ 721F
 489+ 721F                  ; IY punta alla cache degli item attivi
 490+ 721F FD 21 0B 77      ld   iy, current_room_items
 491+ 7223
 492+ 7223                  ; ---------------------------------------------------------------
 493+ 7223                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 494+ 7223                  ; alla stanza corrente.
 495+ 7223                  ;
 496+ 7223                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 497+ 7223                  ; ---------------------------------------------------------------
 498+ 7223 2A 5C 77         ld   hl, (room_ptr)
 499+ 7226 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 500+ 7229 19               add  hl, de
 501+ 722A
 502+ 722A E5               push hl
 503+ 722B DD E1            pop  ix                ; IX = bitmap item
 504+ 722D
 505+ 722D                  ; ---------------------------------------------------------------
 506+ 722D                  ; Inizio scansione della tabella degli item
 507+ 722D                  ; ---------------------------------------------------------------
 508+ 722D 21 37 70         ld   hl, ItemsTable
 509+ 7230
 510+ 7230              .loop:
 511+ 7230
 512+ 7230                  ; ---------------------------------------------------------------
 513+ 7230                  ; Legge il Room ID del record corrente
 514+ 7230                  ; ---------------------------------------------------------------
 515+ 7230 7E               ld   a, (hl)
 516+ 7231
 517+ 7231                  ; $FF indica fine tabella
 518+ 7231 FE FF            cp   $FF
 519+ 7233 28 53            jr   z, .done
 520+ 7235
 521+ 7235                  ; ---------------------------------------------------------------
 522+ 7235                  ; Verifica se l'item appartiene alla stanza corrente
 523+ 7235                  ; ---------------------------------------------------------------
 524+ 7235 57               ld   d, a
 525+ 7236
 526+ 7236 3A 02 77         ld   a, (current_room)
 527+ 7239 BA               cp   d
 528+ 723A 20 45            jr   nz, .next_item
 529+ 723C
 530+ 723C                  ; ---------------------------------------------------------------
 531+ 723C                  ; Legge i dati dell'item
 532+ 723C                  ; ---------------------------------------------------------------
 533+ 723C
 534+ 723C 23               inc  hl
 535+ 723D 4E               ld   c, (hl)           ; X (colonna)
 536+ 723E
 537+ 723E 23               inc  hl
 538+ 723F 46               ld   b, (hl)           ; Y (riga)
 539+ 7240
 540+ 7240 23               inc  hl
 541+ 7241 5E               ld   e, (hl)           ; Colore
 542+ 7242
 543+ 7242 23               inc  hl
 544+ 7243 7E               ld   a, (hl)           ; Collected flag
 545+ 7244
 546+ 7244                  ; Se diverso da zero l'item è già stato raccolto
 547+ 7244 B7               or   a
 548+ 7245 20 3E            jr   nz, .next_no_inc
 549+ 7247
 550+ 7247                  ; ---------------------------------------------------------------
 551+ 7247                  ; Disegna l'item sullo schermo
 552+ 7247                  ;
 553+ 7247                  ; B = Row
 554+ 7247                  ; C = Column
 555+ 7247                  ; HL = bitmap pointer
 556+ 7247                  ; E = Color
 557+ 7247                  ; ---------------------------------------------------------------
 558+ 7247 E5               push hl
 559+ 7248
 560+ 7248 DD E5            push ix
 561+ 724A E1               pop  hl
 562+ 724B
 563+ 724B CD 90 72         call DrawItemGraphic
 564+ 724E
 565+ 724E E1               pop  hl                ; ritorna al flag collected
 566+ 724F
 567+ 724F                  ; ---------------------------------------------------------------
 568+ 724F                  ; Aggiorna items_grid
 569+ 724F                  ;
 570+ 724F                  ; Calcolo:
 571+ 724F                  ;   offset = Row * 32 + Col
 572+ 724F                  ; ---------------------------------------------------------------
 573+ 724F E5               push hl
 574+ 7250 D5               push de
 575+ 7251
 576+ 7251 26 00            ld   h, 0
 577+ 7253 68               ld   l, b              ; HL = Row
 578+ 7254
 579+ 7254 29               add  hl, hl            ; *2
 580+ 7255 29               add  hl, hl            ; *4
 581+ 7256 29               add  hl, hl            ; *8
 582+ 7257 29               add  hl, hl            ; *16
 583+ 7258 29               add  hl, hl            ; *32
 584+ 7259
 585+ 7259 16 00            ld   d, 0
 586+ 725B 59               ld   e, c              ; DE = Col
 587+ 725C
 588+ 725C 19               add  hl, de            ; Row*32 + Col
 589+ 725D
 590+ 725D 11 00 B0         ld   de, items_grid
 591+ 7260 19               add  hl, de            ; puntatore nella griglia
 592+ 7261
 593+ 7261 D1               pop  de                ; ripristina colore
 594+ 7262
 595+ 7262 73               ld   (hl), e           ; salva colore cella
 596+ 7263
 597+ 7263 E1               pop  hl
 598+ 7264
 599+ 7264                  ; ---------------------------------------------------------------
 600+ 7264                  ; Salva l'item nella cache della stanza
 601+ 7264                  ;
 602+ 7264                  ; Questo evita di dover scansionare tutta ItemsTable
 603+ 7264                  ; durante il controllo delle collisioni.
 604+ 7264                  ; ---------------------------------------------------------------
 605+ 7264
 606+ 7264 FD 71 00         ld   (iy+0), c         ; Colonna
 607+ 7267 FD 70 01         ld   (iy+1), b         ; Riga
 608+ 726A FD 73 02         ld   (iy+2), e         ; Colore
 609+ 726D
 610+ 726D                  ; Salva il puntatore al flag "collected"
 611+ 726D FD 75 03         ld   (iy+3), l         ; Low byte
 612+ 7270 FD 74 04         ld   (iy+4), h         ; High byte
 613+ 7273
 614+ 7273                  ; Passa al record successivo della cache
 615+ 7273 01 05 00         ld   bc, 5
 616+ 7276 FD 09            add  iy, bc
 617+ 7278
 618+ 7278                  ; Incrementa il numero di item attivi
 619+ 7278 3A 5B 77         ld   a, (num_room_items)
 620+ 727B 3C               inc  a
 621+ 727C 32 5B 77         ld   (num_room_items), a
 622+ 727F
 623+ 727F 18 04            jr   .next_no_inc
 624+ 7281
 625+ 7281              .next_item:
 626+ 7281
 627+ 7281                  ; ---------------------------------------------------------------
 628+ 7281                  ; L'item non appartiene alla stanza corrente.
 629+ 7281                  ; Salta i campi del record:
 630+ 7281                  ;   X
 631+ 7281                  ;   Y
 632+ 7281                  ;   Color
 633+ 7281                  ;   Collected
 634+ 7281                  ; ---------------------------------------------------------------
 635+ 7281 23               inc  hl
 636+ 7282 23               inc  hl
 637+ 7283 23               inc  hl
 638+ 7284 23               inc  hl
 639+ 7285
 640+ 7285              .next_no_inc:
 641+ 7285
 642+ 7285                  ; ---------------------------------------------------------------
 643+ 7285                  ; Avanza al record successivo
 644+ 7285                  ; (prossimo Room ID)
 645+ 7285                  ; ---------------------------------------------------------------
 646+ 7285 23               inc  hl
 647+ 7286 18 A8            jr   .loop
 648+ 7288
 649+ 7288              .done:
 650+ 7288
 651+ 7288                  ; Ripristina i registri
 652+ 7288 FD E1            pop  iy
 653+ 728A DD E1            pop  ix
 654+ 728C D1               pop  de
 655+ 728D C1               pop  bc
 656+ 728E E1               pop  hl
 657+ 728F
 658+ 728F C9               ret
 659+ 7290
 660+ 7290              ; -------------------------------------------------------------------
 661+ 7290              ; DrawItemGraphic
 662+ 7290              ;
 663+ 7290              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 664+ 7290              ; utilizzando una bitmap di 8 byte e un attributo colore.
 665+ 7290              ;
 666+ 7290              ; Input:
 667+ 7290              ;   B = Riga attributi (3..18)
 668+ 7290              ;   C = Colonna attributi (0..31)
 669+ 7290              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 670+ 7290              ;   E = Attributo colore
 671+ 7290              ;
 672+ 7290              ; Output:
 673+ 7290              ;   Nessuno
 674+ 7290              ;
 675+ 7290              ; Registri preservati:
 676+ 7290              ;   BC, DE, HL
 677+ 7290              ; -------------------------------------------------------------------
 678+ 7290              DrawItemGraphic:
 679+ 7290
 680+ 7290                  ; Salva i registri originali
 681+ 7290 C5               push bc
 682+ 7291 D5               push de
 683+ 7292 E5               push hl
 684+ 7293
 685+ 7293                  ; ---------------------------------------------------------------
 686+ 7293                  ; Calcolo indirizzo bitmap dello Spectrum
 687+ 7293                  ;
 688+ 7293                  ; Ogni item occupa una cella attributi (8x8 pixel).
 689+ 7293                  ;
 690+ 7293                  ; Formula:
 691+ 7293                  ;   High = $40 + (Row AND $18)
 692+ 7293                  ;   Low  = (Row AND 7) * 32 + Col
 693+ 7293                  ;
 694+ 7293                  ; DE conterrà l'indirizzo della prima scanline.
 695+ 7293                  ; ---------------------------------------------------------------
 696+ 7293
 697+ 7293 78               ld   a, b
 698+ 7294 E6 18            and  $18
 699+ 7296 C6 40            add  a, $40
 700+ 7298 57               ld   d, a              ; Byte alto indirizzo video
 701+ 7299
 702+ 7299 78               ld   a, b
 703+ 729A E6 07            and  7                 ; Riga interna al blocco da 8
 704+ 729C
 705+ 729C 87               add  a, a              ; *2
 706+ 729D 87               add  a, a              ; *4
 707+ 729E 87               add  a, a              ; *8
 708+ 729F 87               add  a, a              ; *16
 709+ 72A0 87               add  a, a              ; *32
 710+ 72A1
 711+ 72A1 81               add  a, c              ; + colonna
 712+ 72A2
 713+ 72A2 5F               ld   e, a              ; Byte basso indirizzo video
 714+ 72A3
 715+ 72A3                  ; ---------------------------------------------------------------
 716+ 72A3                  ; Disegno bitmap
 717+ 72A3                  ;
 718+ 72A3                  ; Copia 8 byte consecutivi nella memoria video.
 719+ 72A3                  ; Ogni byte rappresenta una scanline da 8 pixel.
 720+ 72A3                  ; ---------------------------------------------------------------
 721+ 72A3
 722+ 72A3 C5               push bc                ; Conserva Row e Col
 723+ 72A4
 724+ 72A4 06 08            ld   b, 8              ; Numero scanline
 725+ 72A6
 726+ 72A6              .line_loop:
 727+ 72A6
 728+ 72A6 7E               ld   a, (hl)           ; Legge scanline bitmap
 729+ 72A7 12               ld   (de), a           ; Scrive nella memoria video
 730+ 72A8
 731+ 72A8 14               inc  d                 ; Scanline successiva
 732+ 72A9 23               inc  hl                ; Byte bitmap successivo
 733+ 72AA
 734+ 72AA 05               dec  b
 735+ 72AB 20 F9            jr   nz, .line_loop
 736+ 72AD
 737+ 72AD C1               pop  bc                ; Ripristina Row e Col
 738+ 72AE
 739+ 72AE                  ; ---------------------------------------------------------------
 740+ 72AE                  ; Calcolo indirizzo attributo
 741+ 72AE                  ;
 742+ 72AE                  ; Formula:
 743+ 72AE                  ;   AttrAddr = $5800 + Row * 32 + Col
 744+ 72AE                  ;
 745+ 72AE                  ; HL conterrà l'indirizzo della cella attributi.
 746+ 72AE                  ; ---------------------------------------------------------------
 747+ 72AE
 748+ 72AE 26 00            ld   h, 0
 749+ 72B0 68               ld   l, b              ; HL = Row
 750+ 72B1
 751+ 72B1 29               add  hl, hl            ; *2
 752+ 72B2 29               add  hl, hl            ; *4
 753+ 72B3 29               add  hl, hl            ; *8
 754+ 72B4 29               add  hl, hl            ; *16
 755+ 72B5 29               add  hl, hl            ; *32
 756+ 72B6
 757+ 72B6 79               ld   a, c              ; A = Colonna
 758+ 72B7
 759+ 72B7 85               add  a, l
 760+ 72B8 6F               ld   l, a
 761+ 72B9
 762+ 72B9 30 01            jr   nc, .no_carry
 763+ 72BB 24               inc  h
 764+ 72BC
 765+ 72BC              .no_carry:
 766+ 72BC
 767+ 72BC                  ; HL = Row * 32 + Col
 768+ 72BC
 769+ 72BC 11 00 58         ld   de, $5800
 770+ 72BF 19               add  hl, de            ; HL = indirizzo attributi
 771+ 72C0
 772+ 72C0                  ; ---------------------------------------------------------------
 773+ 72C0                  ; Recupera il colore originale dallo stack.
 774+ 72C0                  ;
 775+ 72C0                  ; Layout stack:
 776+ 72C0                  ;   HL originale
 777+ 72C0                  ;   DE originale (E = colore)
 778+ 72C0                  ;   BC originale
 779+ 72C0                  ; ---------------------------------------------------------------
 780+ 72C0
 781+ 72C0 C1               pop  bc                ; Recupera HL originale
 782+ 72C1 D1               pop  de                ; Recupera DE originale
 783+ 72C2
 784+ 72C2                  ; ---------------------------------------------------------------
 785+ 72C2                  ; Scrive l'attributo colore
 786+ 72C2                  ; ---------------------------------------------------------------
 787+ 72C2
 788+ 72C2 7B               ld   a, e              ; A = colore
 789+ 72C3 77               ld   (hl), a           ; Scrive nella RAM attributi
 790+ 72C4
 791+ 72C4                  ; ---------------------------------------------------------------
 792+ 72C4                  ; Ripristina HL e BC originali
 793+ 72C4                  ; ---------------------------------------------------------------
 794+ 72C4
 795+ 72C4 C5               push bc
 796+ 72C5 E1               pop  hl                ; HL originale
 797+ 72C6
 798+ 72C6 C1               pop  bc                ; BC originale
 799+ 72C7
 800+ 72C7 C9               ret
 801+ 72C8
 802+ 72C8              ; -------------------------------------------------------------------
 803+ 72C8              ; RestoreBackgroundCell
 804+ 72C8              ;
 805+ 72C8              ; Ripristina il contenuto originale di una cella della stanza.
 806+ 72C8              ; Viene utilizzata principalmente quando un item viene raccolto:
 807+ 72C8              ; invece di lasciare un "buco", la routine ridisegna il tile
 808+ 72C8              ; originale presente nella mappa della stanza.
 809+ 72C8              ;
 810+ 72C8              ; Input:
 811+ 72C8              ;   B = Row (3..18)
 812+ 72C8              ;   C = Col (0..31)
 813+ 72C8              ;
 814+ 72C8              ; Utilizza:
 815+ 72C8              ;   room_ptr -> struttura dati della stanza corrente
 816+ 72C8              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 817+ 72C8              ;   DrawTile -> ridisegna il tile selezionato
 818+ 72C8              ;
 819+ 72C8              ; Tipi di cella:
 820+ 72C8              ;   0 = Background
 821+ 72C8              ;   1 = Floor
 822+ 72C8              ;   2 = Wall
 823+ 72C8              ;   3 = Nasty
 824+ 72C8              ; -------------------------------------------------------------------
 825+ 72C8              RestoreBackgroundCell:
 826+ 72C8
 827+ 72C8                  ; Salva tutti i registri utilizzati
 828+ 72C8 FD E5            push iy
 829+ 72CA C5               push bc
 830+ 72CB D5               push de
 831+ 72CC E5               push hl
 832+ 72CD DD E5            push ix
 833+ 72CF
 834+ 72CF                  ; ---------------------------------------------------------------
 835+ 72CF                  ; Conserva Row e Col in IY.
 836+ 72CF                  ;
 837+ 72CF                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 838+ 72CF                  ; BC potrebbe essere modificato.
 839+ 72CF                  ; ---------------------------------------------------------------
 840+ 72CF C5               push bc
 841+ 72D0 FD E1            pop  iy                ; IYH = Row, IYL = Col
 842+ 72D2
 843+ 72D2                  ; ---------------------------------------------------------------
 844+ 72D2                  ; Determina quale tipo di cella è presente nella posizione
 845+ 72D2                  ; specificata.
 846+ 72D2                  ;
 847+ 72D2                  ; Input:
 848+ 72D2                  ;   B = Row
 849+ 72D2                  ;   C = Col
 850+ 72D2                  ;
 851+ 72D2                  ; Output:
 852+ 72D2                  ;   A = tipo cella
 853+ 72D2                  ; ---------------------------------------------------------------
 854+ 72D2 78               ld   a, b
 855+ 72D3
 856+ 72D3 CD 63 6B         call GetCellFromUnpacked
 857+ 72D6
 858+ 72D6                  ; ---------------------------------------------------------------
 859+ 72D6                  ; Recupera il puntatore alla stanza corrente.
 860+ 72D6                  ;
 861+ 72D6                  ; DE = base della struttura stanza
 862+ 72D6                  ; ---------------------------------------------------------------
 863+ 72D6 ED 5B 5C 77      ld   de, (room_ptr)
 864+ 72DA
 865+ 72DA                  ; ---------------------------------------------------------------
 866+ 72DA                  ; Seleziona il tile corretto in base al tipo di cella.
 867+ 72DA                  ;
 868+ 72DA                  ; A = 0 -> Background
 869+ 72DA                  ; A = 1 -> Floor
 870+ 72DA                  ; A = 2 -> Wall
 871+ 72DA                  ; A = 3 -> Nasty
 872+ 72DA                  ; ---------------------------------------------------------------
 873+ 72DA
 874+ 72DA B7               or   a
 875+ 72DB 20 06            jr   nz, .not_bg
 876+ 72DD
 877+ 72DD                  ; Background
 878+ 72DD 21 A0 00         ld   hl, OFFSET_BG
 879+ 72E0 19               add  hl, de
 880+ 72E1 18 16            jr   .draw_cell
 881+ 72E3
 882+ 72E3              .not_bg:
 883+ 72E3
 884+ 72E3 3D               dec  a
 885+ 72E4 20 06            jr   nz, .not_floor
 886+ 72E6
 887+ 72E6                  ; Floor
 888+ 72E6 21 A9 00         ld   hl, OFFSET_FLOOR
 889+ 72E9 19               add  hl, de
 890+ 72EA 18 0D            jr   .draw_cell
 891+ 72EC
 892+ 72EC              .not_floor:
 893+ 72EC
 894+ 72EC 3D               dec  a
 895+ 72ED 20 06            jr   nz, .not_wall
 896+ 72EF
 897+ 72EF                  ; Wall
 898+ 72EF 21 B2 00         ld   hl, OFFSET_WALL
 899+ 72F2 19               add  hl, de
 900+ 72F3 18 04            jr   .draw_cell
 901+ 72F5
 902+ 72F5              .not_wall:
 903+ 72F5
 904+ 72F5                  ; Nasty
 905+ 72F5 21 BB 00         ld   hl, OFFSET_NASTY
 906+ 72F8 19               add  hl, de
 907+ 72F9
 908+ 72F9              .draw_cell:
 909+ 72F9
 910+ 72F9                  ; ---------------------------------------------------------------
 911+ 72F9                  ; HL punta ora alla grafica del tile da ridisegnare.
 912+ 72F9                  ;
 913+ 72F9                  ; DrawTile si aspetta:
 914+ 72F9                  ;   IX = puntatore tile
 915+ 72F9                  ;   B  = Row
 916+ 72F9                  ;   C  = Col
 917+ 72F9                  ; ---------------------------------------------------------------
 918+ 72F9 E5               push hl
 919+ 72FA DD E1            pop  ix
 920+ 72FC
 921+ 72FC                  ; Ripristina Row e Col salvati in IY
 922+ 72FC FD E5            push iy
 923+ 72FE C1               pop  bc
 924+ 72FF
 925+ 72FF                  ; Disegna il tile originale
 926+ 72FF CD 8C 61         call DrawTile
 927+ 7302
 928+ 7302                  ; ---------------------------------------------------------------
 929+ 7302                  ; Ripristina i registri salvati
 930+ 7302                  ; ---------------------------------------------------------------
 931+ 7302 DD E1            pop  ix
 932+ 7304 E1               pop  hl
 933+ 7305 D1               pop  de
 934+ 7306 C1               pop  bc
 935+ 7307 FD E1            pop  iy
 936+ 7309
 937+ 7309 C9               ret
 938+ 730A
 939+ 730A              ; -------------------------------------------------------------------
 940+ 730A              ; CheckWillyItemCollision
 941+ 730A              ;
 942+ 730A              ; Verifica se Willy collide con un item utilizzando il controllo
 943+ 730A              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 944+ 730A              ;
 945+ 730A              ; Input:
 946+ 730A              ;   A = ItemX (colonna attributi 0..31)
 947+ 730A              ;   H = ItemY (riga attributi 3..18)
 948+ 730A              ;
 949+ 730A              ; Coordinate item:
 950+ 730A              ;   Ogni item occupa una cella da 8x8 pixel.
 951+ 730A              ;
 952+ 730A              ; Coordinate Willy:
 953+ 730A              ;   Willy occupa un rettangolo di 16x16 pixel.
 954+ 730A              ;
 955+ 730A              ; Output:
 956+ 730A              ;   Carry Set   = collisione rilevata
 957+ 730A              ;   Carry Clear = nessuna collisione
 958+ 730A              ;
 959+ 730A              ; Registri preservati:
 960+ 730A              ;   BC, DE, HL
 961+ 730A              ; -------------------------------------------------------------------
 962+ 730A              CheckWillyItemCollision:
 963+ 730A
 964+ 730A                  ; Salva i registri utilizzati
 965+ 730A C5               push bc
 966+ 730B D5               push de
 967+ 730C E5               push hl
 968+ 730D
 969+ 730D                  ; ---------------------------------------------------------------
 970+ 730D                  ; Calcola il bounding box orizzontale dell'item
 971+ 730D                  ;
 972+ 730D                  ; ItemLeft  = ItemX * 8
 973+ 730D                  ; ItemRight = ItemLeft + 7
 974+ 730D                  ;
 975+ 730D                  ; E = ItemLeft
 976+ 730D                  ; D = ItemRight
 977+ 730D                  ; ---------------------------------------------------------------
 978+ 730D 6F               ld   l, a              ; L = ItemX
 979+ 730E
 980+ 730E 7D               ld   a, l
 981+ 730F 87               add  a, a              ; *2
 982+ 7310 87               add  a, a              ; *4
 983+ 7311 87               add  a, a              ; *8
 984+ 7312
 985+ 7312 5F               ld   e, a              ; E = ItemLeft
 986+ 7313
 987+ 7313 C6 07            add  a, 7
 988+ 7315 57               ld   d, a              ; D = ItemRight
 989+ 7316
 990+ 7316                  ; ---------------------------------------------------------------
 991+ 7316                  ; Recupera la posizione corrente di Willy
 992+ 7316                  ;
 993+ 7316                  ; B = WillyY
 994+ 7316                  ; C = WillyX
 995+ 7316                  ; ---------------------------------------------------------------
 996+ 7316 ED 4B EB 73      ld   bc, (PlayerPos)
 997+ 731A
 998+ 731A                  ; ---------------------------------------------------------------
 999+ 731A                  ; Primo test:
1000+ 731A                  ;
1001+ 731A                  ; WillyLeft <= ItemRight
1002+ 731A                  ;
1003+ 731A                  ; Se Willy è completamente a destra dell'item
1004+ 731A                  ; non può esserci collisione.
1005+ 731A                  ; ---------------------------------------------------------------
1006+ 731A 79               ld   a, c              ; A = WillyLeft
1007+ 731B
1008+ 731B BA               cp   d                 ; WillyLeft vs ItemRight
1009+ 731C
1010+ 731C 28 04            jr   z, .x_ok
1011+ 731E 38 02            jr   c, .x_ok
1012+ 7320
1013+ 7320 18 29            jr   .no_collision
1014+ 7322
1015+ 7322              .x_ok:
1016+ 7322
1017+ 7322                  ; ---------------------------------------------------------------
1018+ 7322                  ; Secondo test:
1019+ 7322                  ;
1020+ 7322                  ; WillyRight >= ItemLeft
1021+ 7322                  ;
1022+ 7322                  ; WillyRight = WillyX + 7
1023+ 7322                  ; ---------------------------------------------------------------
1024+ 7322 C6 07            add  a, 7
1025+ 7324
1026+ 7324 BB               cp   e                 ; WillyRight vs ItemLeft
1027+ 7325
1028+ 7325 28 04            jr   z, .y_check
1029+ 7327 30 02            jr   nc, .y_check
1030+ 7329
1031+ 7329 18 20            jr   .no_collision
1032+ 732B
1033+ 732B              .y_check:
1034+ 732B
1035+ 732B                  ; ---------------------------------------------------------------
1036+ 732B                  ; Recupera ItemY dal valore originale di HL
1037+ 732B                  ;
1038+ 732B                  ; H contiene la riga dell'item.
1039+ 732B                  ; ---------------------------------------------------------------
1040+ 732B E1               pop  hl
1041+ 732C E5               push hl
1042+ 732D
1043+ 732D                  ; ---------------------------------------------------------------
1044+ 732D                  ; Calcola il bounding box verticale dell'item
1045+ 732D                  ;
1046+ 732D                  ; ItemTop    = ItemY * 8
1047+ 732D                  ; ItemBottom = ItemTop + 7
1048+ 732D                  ;
1049+ 732D                  ; E = ItemTop
1050+ 732D                  ; D = ItemBottom
1051+ 732D                  ; ---------------------------------------------------------------
1052+ 732D 7C               ld   a, h
1053+ 732E
1054+ 732E 87               add  a, a              ; *2
1055+ 732F 87               add  a, a              ; *4
1056+ 7330 87               add  a, a              ; *8
1057+ 7331
1058+ 7331 5F               ld   e, a              ; ItemTop
1059+ 7332
1060+ 7332 C6 07            add  a, 7
1061+ 7334 57               ld   d, a              ; ItemBottom
1062+ 7335
1063+ 7335                  ; ---------------------------------------------------------------
1064+ 7335                  ; Primo test verticale:
1065+ 7335                  ;
1066+ 7335                  ; WillyTop <= ItemBottom
1067+ 7335                  ; ---------------------------------------------------------------
1068+ 7335 78               ld   a, b              ; WillyTop
1069+ 7336
1070+ 7336 BA               cp   d
1071+ 7337
1072+ 7337 28 04            jr   z, .y_ok
1073+ 7339 38 02            jr   c, .y_ok
1074+ 733B
1075+ 733B 18 0E            jr   .no_collision
1076+ 733D
1077+ 733D              .y_ok:
1078+ 733D
1079+ 733D                  ; ---------------------------------------------------------------
1080+ 733D                  ; Secondo test verticale:
1081+ 733D                  ;
1082+ 733D                  ; WillyBottom >= ItemTop
1083+ 733D                  ;
1084+ 733D                  ; WillyBottom = WillyY + 15
1085+ 733D                  ; ---------------------------------------------------------------
1086+ 733D C6 0F            add  a, 15
1087+ 733F
1088+ 733F BB               cp   e
1089+ 7340
1090+ 7340 28 04            jr   z, .collision
1091+ 7342 30 02            jr   nc, .collision
1092+ 7344
1093+ 7344 18 05            jr   .no_collision
1094+ 7346
1095+ 7346              .collision:
1096+ 7346
1097+ 7346                  ; ---------------------------------------------------------------
1098+ 7346                  ; Collisione rilevata
1099+ 7346                  ; ---------------------------------------------------------------
1100+ 7346 E1               pop  hl
1101+ 7347 D1               pop  de
1102+ 7348 C1               pop  bc
1103+ 7349
1104+ 7349 37               scf                    ; Carry = 1
1105+ 734A
1106+ 734A C9               ret
1107+ 734B
1108+ 734B              .no_collision:
1109+ 734B
1110+ 734B                  ; ---------------------------------------------------------------
1111+ 734B                  ; Nessuna collisione
1112+ 734B                  ; ---------------------------------------------------------------
1113+ 734B E1               pop  hl
1114+ 734C D1               pop  de
1115+ 734D C1               pop  bc
1116+ 734E
1117+ 734E B7               or   a                 ; Carry = 0
1118+ 734F
1119+ 734F C9               ret
1120+ 7350
1121+ 7350              ; -------------------------------------------------------------------
1122+ 7350              ; CheckRoomItemsCollision
1123+ 7350              ;
1124+ 7350              ; Controlla se Willy entra in collisione con uno degli item
1125+ 7350              ; attivi presenti nella stanza corrente.
1126+ 7350              ;
1127+ 7350              ; Per ogni item:
1128+ 7350              ;   - verifica che appartenga alla stanza corrente
1129+ 7350              ;   - verifica che non sia già stato raccolto
1130+ 7350              ;   - esegue il test di collisione con Willy
1131+ 7350              ;
1132+ 7350              ; Se l'item viene raccolto:
1133+ 7350              ;   - imposta il flag "collected"
1134+ 7350              ;   - rimuove l'item dalla cache items_grid
1135+ 7350              ;   - incrementa il contatore degli oggetti raccolti
1136+ 7350              ;   - aggiorna l'HUD
1137+ 7350              ;   - ripristina il tile di sfondo
1138+ 7350              ;   - riproduce il suono di raccolta
1139+ 7350              ;
1140+ 7350              ; Formato record ItemsTable:
1141+ 7350              ;   +0 RoomID
1142+ 7350              ;   +1 X
1143+ 7350              ;   +2 Y
1144+ 7350              ;   +3 Color
1145+ 7350              ;   +4 Collected
1146+ 7350              ;
1147+ 7350              ; Fine tabella:
1148+ 7350              ;   RoomID = $FF
1149+ 7350              ; -------------------------------------------------------------------
1150+ 7350              CheckRoomItemsCollision:
1151+ 7350
1152+ 7350                  ; Salva i registri utilizzati
1153+ 7350 E5               push hl
1154+ 7351 D5               push de
1155+ 7352 C5               push bc
1156+ 7353
1157+ 7353                  ; Inizio scansione della tabella degli item
1158+ 7353 21 37 70         ld   hl, ItemsTable
1159+ 7356
1160+ 7356              .loop:
1161+ 7356
1162+ 7356                  ; ---------------------------------------------------------------
1163+ 7356                  ; Legge il Room ID dell'item corrente
1164+ 7356                  ; ---------------------------------------------------------------
1165+ 7356 7E               ld   a, (hl)
1166+ 7357
1167+ 7357                  ; $FF indica fine tabella
1168+ 7357 FE FF            cp   $FF
1169+ 7359 28 4D            jr   z, .done
1170+ 735B
1171+ 735B                  ; ---------------------------------------------------------------
1172+ 735B                  ; Verifica se l'item appartiene alla stanza corrente
1173+ 735B                  ; ---------------------------------------------------------------
1174+ 735B 57               ld   d, a              ; D = RoomID item
1175+ 735C
1176+ 735C 3A 02 77         ld   a, (current_room)
1177+ 735F BA               cp   d
1178+ 7360
1179+ 7360                  ; Se appartiene a un'altra stanza salta il record
1180+ 7360 20 3F            jr   nz, .next_item
1181+ 7362
1182+ 7362                  ; ---------------------------------------------------------------
1183+ 7362                  ; Legge coordinate e stato dell'item
1184+ 7362                  ; ---------------------------------------------------------------
1185+ 7362
1186+ 7362 23               inc  hl
1187+ 7363 4E               ld   c, (hl)           ; C = X
1188+ 7364
1189+ 7364 23               inc  hl
1190+ 7365 46               ld   b, (hl)           ; B = Y
1191+ 7366
1192+ 7366 23               inc  hl                ; salta Color
1193+ 7367
1194+ 7367 23               inc  hl                ; punta a Collected
1195+ 7368
1196+ 7368 7E               ld   a, (hl)
1197+ 7369
1198+ 7369                  ; ---------------------------------------------------------------
1199+ 7369                  ; Item già raccolto?
1200+ 7369                  ; ---------------------------------------------------------------
1201+ 7369 B7               or   a
1202+ 736A 20 39            jr   nz, .next_no_inc
1203+ 736C
1204+ 736C                  ; ---------------------------------------------------------------
1205+ 736C                  ; Test collisione Willy ↔ Item
1206+ 736C                  ;
1207+ 736C                  ; Input richiesto:
1208+ 736C                  ;   A = ItemX
1209+ 736C                  ;   H = ItemY
1210+ 736C                  ; ---------------------------------------------------------------
1211+ 736C 79               ld   a, c
1212+ 736D
1213+ 736D E5               push hl                ; salva puntatore al flag Collected
1214+ 736E
1215+ 736E 60               ld   h, b
1216+ 736F
1217+ 736F CD 0A 73         call CheckWillyItemCollision
1218+ 7372
1219+ 7372 E1               pop  hl
1220+ 7373
1221+ 7373                  ; Nessuna collisione
1222+ 7373 30 30            jr   nc, .next_no_inc
1223+ 7375
1224+ 7375                  ; ===============================================================
1225+ 7375                  ; ITEM RACCOLTO
1226+ 7375                  ; ===============================================================
1227+ 7375
1228+ 7375                  ; ---------------------------------------------------------------
1229+ 7375                  ; Marca l'item come raccolto
1230+ 7375                  ; ---------------------------------------------------------------
1231+ 7375 36 01            ld   (hl), 1
1232+ 7377
1233+ 7377                  ; ---------------------------------------------------------------
1234+ 7377                  ; Rimuove l'item dalla cache items_grid
1235+ 7377                  ;
1236+ 7377                  ; Calcolo:
1237+ 7377                  ;   offset = Row * 32 + Col
1238+ 7377                  ; ---------------------------------------------------------------
1239+ 7377 E5               push hl
1240+ 7378 D5               push de
1241+ 7379
1242+ 7379 26 00            ld   h, 0
1243+ 737B 68               ld   l, b              ; HL = Row
1244+ 737C
1245+ 737C 29               add  hl, hl            ; *2
1246+ 737D 29               add  hl, hl            ; *4
1247+ 737E 29               add  hl, hl            ; *8
1248+ 737F 29               add  hl, hl            ; *16
1249+ 7380 29               add  hl, hl            ; *32
1250+ 7381
1251+ 7381 59               ld   e, c
1252+ 7382 16 00            ld   d, 0
1253+ 7384
1254+ 7384 19               add  hl, de            ; Row*32 + Col
1255+ 7385
1256+ 7385 11 00 B0         ld   de, items_grid
1257+ 7388 19               add  hl, de
1258+ 7389
1259+ 7389                  ; La cella non contiene più un item
1260+ 7389 36 00            ld   (hl), 0
1261+ 738B
1262+ 738B D1               pop  de
1263+ 738C E1               pop  hl
1264+ 738D
1265+ 738D                  ; ---------------------------------------------------------------
1266+ 738D                  ; Conserva il puntatore all'entry corrente
1267+ 738D                  ; poiché le routine successive possono alterare HL.
1268+ 738D                  ; ---------------------------------------------------------------
1269+ 738D E5               push hl
1270+ 738E
1271+ 738E                  ; ---------------------------------------------------------------
1272+ 738E                  ; Aggiorna il numero di oggetti raccolti
1273+ 738E                  ; ---------------------------------------------------------------
1274+ 738E 3A F5 73         ld   a, (items_collected)
1275+ 7391
1276+ 7391 3C               inc  a
1277+ 7392
1278+ 7392 32 F5 73         ld   (items_collected), a
1279+ 7395
1280+ 7395                  ; ---------------------------------------------------------------
1281+ 7395                  ; Aggiorna il contatore visualizzato a schermo
1282+ 7395                  ; ---------------------------------------------------------------
1283+ 7395 CD CB 60         call UpdateItemsCollectedDisplay
1284+ 7398
1285+ 7398                  ; ---------------------------------------------------------------
1286+ 7398                  ; Ripristina il tile originale della stanza
1287+ 7398                  ; eliminando la grafica dell'item.
1288+ 7398                  ;
1289+ 7398                  ; Input:
1290+ 7398                  ;   B = Row
1291+ 7398                  ;   C = Col
1292+ 7398                  ; ---------------------------------------------------------------
1293+ 7398 CD C8 72         call RestoreBackgroundCell
1294+ 739B
1295+ 739B                  ; ---------------------------------------------------------------
1296+ 739B                  ; Riproduce il suono di raccolta
1297+ 739B                  ; ---------------------------------------------------------------
1298+ 739B CD AC 73         call PlayCollectSound
1299+ 739E
1300+ 739E                  ; Ripristina il puntatore alla tabella
1301+ 739E E1               pop  hl
1302+ 739F
1303+ 739F                  ; Continua con il record successivo
1304+ 739F 18 04            jr   .next_no_inc
1305+ 73A1
1306+ 73A1              .next_item:
1307+ 73A1
1308+ 73A1                  ; ---------------------------------------------------------------
1309+ 73A1                  ; Salta i campi del record:
1310+ 73A1                  ;   X
1311+ 73A1                  ;   Y
1312+ 73A1                  ;   Color
1313+ 73A1                  ;   Collected
1314+ 73A1                  ; ---------------------------------------------------------------
1315+ 73A1 23               inc  hl
1316+ 73A2 23               inc  hl
1317+ 73A3 23               inc  hl
1318+ 73A4 23               inc  hl
1319+ 73A5
1320+ 73A5              .next_no_inc:
1321+ 73A5
1322+ 73A5                  ; ---------------------------------------------------------------
1323+ 73A5                  ; Avanza al record successivo.
1324+ 73A5                  ;
1325+ 73A5                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1326+ 73A5                  ; ---------------------------------------------------------------
1327+ 73A5 23               inc  hl
1328+ 73A6
1329+ 73A6 18 AE            jr   .loop
1330+ 73A8
1331+ 73A8              .done:
1332+ 73A8
1333+ 73A8                  ; Ripristina i registri
1334+ 73A8 C1               pop  bc
1335+ 73A9 D1               pop  de
1336+ 73AA E1               pop  hl
1337+ 73AB
1338+ 73AB C9               ret
1339+ 73AC
1340+ 73AC              ; -------------------------------------------------------------------
1341+ 73AC              ; PlayCollectSound
1342+ 73AC              ;
1343+ 73AC              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1344+ 73AC              ; dello ZX Spectrum utilizzando il port $FE.
1345+ 73AC              ;
1346+ 73AC              ; Il suono viene prodotto alternando ON/OFF del bit 4
1347+ 73AC              ; (speaker) con un semplice delay software.
1348+ 73AC              ;
1349+ 73AC              ; Effetto risultante:
1350+ 73AC              ;   beep breve tipo "pickup item"
1351+ 73AC              ; -------------------------------------------------------------------
1352+ 73AC              PlayCollectSound:
1353+ 73AC
1354+ 73AC                  ; Salva registri utilizzati
1355+ 73AC C5               push bc
1356+ 73AD D5               push de
1357+ 73AE
1358+ 73AE                  ; ---------------------------------------------------------------
1359+ 73AE                  ; Numero di cicli del beep (durata complessiva del suono)
1360+ 73AE                  ; ---------------------------------------------------------------
1361+ 73AE 06 78            ld   b, 120
1362+ 73B0
1363+ 73B0              .sound_loop:
1364+ 73B0
1365+ 73B0                  ; ---------------------------------------------------------------
1366+ 73B0                  ; SPEAKER ON
1367+ 73B0                  ;
1368+ 73B0                  ; Legge il colore del bordo corrente e attiva il bit 4
1369+ 73B0                  ; per pilotare lo speaker.
1370+ 73B0                  ; ---------------------------------------------------------------
1371+ 73B0 3A F7 73         ld   a, (room_border_color)
1372+ 73B3 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1373+ 73B5
1374+ 73B5 D3 FE            out  ($fe), a         ; scrive sul port ULA
1375+ 73B7
1376+ 73B7                  ; ---------------------------------------------------------------
1377+ 73B7                  ; Delay (mezzo periodo)
1378+ 73B7                  ; Loop software a consumo CPU
1379+ 73B7                  ; ---------------------------------------------------------------
1380+ 73B7 0E 3C            ld   c, 60
1381+ 73B9
1382+ 73B9              .d1:
1383+ 73B9 0D               dec  c
1384+ 73BA 20 FD            jr   nz, .d1
1385+ 73BC
1386+ 73BC                  ; ---------------------------------------------------------------
1387+ 73BC                  ; SPEAKER OFF
1388+ 73BC                  ;
1389+ 73BC                  ; Mantiene il colore del bordo ma disattiva lo speaker
1390+ 73BC                  ; ---------------------------------------------------------------
1391+ 73BC 3A F7 73         ld   a, (room_border_color)
1392+ 73BF E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1393+ 73C1
1394+ 73C1 D3 FE            out  ($fe), a
1395+ 73C3
1396+ 73C3                  ; ---------------------------------------------------------------
1397+ 73C3                  ; Secondo delay (mezzo periodo)
1398+ 73C3                  ; Completa l’onda quadra
1399+ 73C3                  ; ---------------------------------------------------------------
1400+ 73C3 0E 3C            ld   c, 60
1401+ 73C5
1402+ 73C5              .d2:
1403+ 73C5 0D               dec  c
1404+ 73C6 20 FD            jr   nz, .d2
1405+ 73C8
1406+ 73C8                  ; ---------------------------------------------------------------
1407+ 73C8                  ; Ripete fino a completare il numero di cicli
1408+ 73C8                  ; ---------------------------------------------------------------
1409+ 73C8 10 E6            djnz .sound_loop
1410+ 73CA
1411+ 73CA                  ; Ripristina registri salvati
1412+ 73CA D1               pop  de
1413+ 73CB C1               pop  bc
1414+ 73CC
1415+ 73CC C9               ret
1416+ 73CD
1417+ 73CD              ; -------------------------------------------------------------------
1418+ 73CD              ; CheckActiveItemAtCell
1419+ 73CD              ;
1420+ 73CD              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1421+ 73CD              ; nella cella specificata della griglia items_grid.
1422+ 73CD              ;
1423+ 73CD              ; Questa routine usa una lookup diretta su una mappa 32x16,
1424+ 73CD              ; evitando la scansione della ItemsTable.
1425+ 73CD              ;
1426+ 73CD              ; Input:
1427+ 73CD              ;   B = Colonna (0..31)
1428+ 73CD              ;   C = Riga (0..15)
1429+ 73CD              ;
1430+ 73CD              ; Output:
1431+ 73CD              ;   Carry Set   = item presente nella cella
1432+ 73CD              ;   Carry Clear = nessun item
1433+ 73CD              ;
1434+ 73CD              ; Nota:
1435+ 73CD              ;   HL NON è restituito valido (commento originale non corretto:
1436+ 73CD              ;   la routine non punta a ItemsTable).
1437+ 73CD              ; -------------------------------------------------------------------
1438+ 73CD              CheckActiveItemAtCell:
1439+ 73CD
1440+ 73CD                  ; Salva registri usati
1441+ 73CD D5               push de
1442+ 73CE E5               push hl
1443+ 73CF
1444+ 73CF                  ; ---------------------------------------------------------------
1445+ 73CF                  ; Calcolo indice lineare nella griglia 32x16:
1446+ 73CF                  ;
1447+ 73CF                  ; offset = Row * 32 + Col
1448+ 73CF                  ; ---------------------------------------------------------------
1449+ 73CF 26 00            ld   h, 0
1450+ 73D1 69               ld   l, c              ; HL = Row
1451+ 73D2
1452+ 73D2 29               add  hl, hl            ; *2
1453+ 73D3 29               add  hl, hl            ; *4
1454+ 73D4 29               add  hl, hl            ; *8
1455+ 73D5 29               add  hl, hl            ; *16
1456+ 73D6 29               add  hl, hl            ; *32
1457+ 73D7
1458+ 73D7                  ; Aggiunge la colonna
1459+ 73D7 58               ld   e, b
1460+ 73D8 16 00            ld   d, 0
1461+ 73DA 19               add  hl, de            ; HL = Row*32 + Col
1462+ 73DB
1463+ 73DB                  ; ---------------------------------------------------------------
1464+ 73DB                  ; Accesso alla griglia degli item attivi
1465+ 73DB                  ; ---------------------------------------------------------------
1466+ 73DB 11 00 B0         ld   de, items_grid
1467+ 73DE 19               add  hl, de            ; HL = address cella
1468+ 73DF
1469+ 73DF                  ; ---------------------------------------------------------------
1470+ 73DF                  ; Controllo presenza item
1471+ 73DF                  ;
1472+ 73DF                  ; items_grid contiene:
1473+ 73DF                  ;   0 = nessun item
1474+ 73DF                  ;   >0 = item attivo (colore o flag)
1475+ 73DF                  ; ---------------------------------------------------------------
1476+ 73DF 7E               ld   a, (hl)
1477+ 73E0 B7               or   a
1478+ 73E1 28 04            jr   z, .not_active
1479+ 73E3
1480+ 73E3                  ; ---------------------------------------------------------------
1481+ 73E3                  ; Item trovato
1482+ 73E3                  ; ---------------------------------------------------------------
1483+ 73E3 E1               pop  hl
1484+ 73E4 D1               pop  de
1485+ 73E5
1486+ 73E5 37               scf                    ; Carry = 1
1487+ 73E6 C9               ret
1488+ 73E7
1489+ 73E7              .not_active:
1490+ 73E7
1491+ 73E7                  ; ---------------------------------------------------------------
1492+ 73E7                  ; Nessun item nella cella
1493+ 73E7                  ; ---------------------------------------------------------------
1494+ 73E7 E1               pop  hl
1495+ 73E8 D1               pop  de
1496+ 73E9
1497+ 73E9 B7               or   a                 ; Carry = 0
1498+ 73EA C9               ret
1499+ 73EB
