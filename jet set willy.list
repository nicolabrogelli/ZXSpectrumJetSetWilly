 205+ 826E 0D               dec  c
 206+ 826F 20 FD            jr   nz, .d2
 207+ 8271
 208+ 8271 10 E6            djnz .sound_loop
 209+ 8273
 210+ 8273 D1               pop  de
 211+ 8274 C1               pop  bc
 212+ 8275 C9               ret
