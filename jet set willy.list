 187+ 806C
 188+ 806C              ; -------------------------------------------------------------------
 189+ 806C              ; DetermineCurrentRoomID
 190+ 806C              ;
 191+ 806C              ; Determina l'ID numerico della stanza corrente confrontando
 192+ 806C              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 193+ 806C              ;
 194+ 806C              ; Se viene trovata una corrispondenza:
 195+ 806C              ;   A = ID della stanza
 196+ 806C              ;   current_room = A
 197+ 806C              ;
 198+ 806C              ; Mappatura:
 199+ 806C              ;    0 = The Off Licence
 200+ 806C              ;    1 = The Bridge
 201+ 806C              ;    2 = Under The Mega Tree
 202+ 806C              ;    3 = Gfx_At The Foot Of The Mega Tree
 203+ 806C              ;    4 = The Drive
 204+ 806C              ;    5 = The Security Guard
 205+ 806C              ;    6 = Entrance To Hades
 206+ 806C              ;    7 = Cuckoo's Nest
 207+ 806C              ;    8 = Inside The Mega Trunk
 208+ 806C              ;    9 = On A Branch Over The Drive
 209+ 806C              ;   10 = The Front Door
 210+ 806C              ;   11 = The Hall
 211+ 806C              ;   12 = Tree Top
 212+ 806C              ;   27 = The Chapel
 213+ 806C              ;   28 = First Landing
 214+ 806C              ;   29 = The Nightmare Room
 215+ 806C              ;   33 = The Bathroom
 216+ 806C              ;   35 = Master Bedroom
 217+ 806C              ;
 218+ 806C              ; Se nessuna stanza corrisponde viene impostato:
 219+ 806C              ;   current_room = 0
 220+ 806C              ; -------------------------------------------------------------------
 221+ 806C              DetermineCurrentRoomID:
 222+ 806C
