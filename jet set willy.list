 605+ 72C1                  ; ---------------------------------------------------------------
 606+ 72C1                  ; Salva l'item nella cache della stanza
 607+ 72C1                  ;
 608+ 72C1                  ; Questo evita di dover scansionare tutta ItemsTable
 609+ 72C1                  ; durante il controllo delle collisioni.
 610+ 72C1                  ; ---------------------------------------------------------------
 611+ 72C1
 612+ 72C1 FD 71 00         ld   (iy+0), c         ; Colonna
 613+ 72C4 FD 70 01         ld   (iy+1), b         ; Riga
