 157+ 5E63 23               inc  hl
 158+ 5E64 7B               ld   a, e
 159+ 5E65 B6               or   (hl)
 160+ 5E66 77               ld   (hl), a
 161+ 5E67 2B               dec  hl            ; Ritorna alla colonna iniziale
