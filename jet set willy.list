  11+ 5DE1 01 00 03         ld bc, 768    ; Numero di byte da copiare (96 caratteri * 8 byte ciascuno)
  12+ 5DE4 ED B0            ldir          ; Copiare i dati
  13+ 5DE6 C9               ret
