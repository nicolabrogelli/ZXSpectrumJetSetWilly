2019+ 8640              ; CheckActiveItemAtCell
2020+ 8640              ;
2021+ 8640              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2022+ 8640              ; nella cella specificata della griglia items_grid.
2023+ 8640              ;
2024+ 8640              ; Questa routine usa una lookup diretta su una mappa 32x16,
2025+ 8640              ; evitando la scansione della ItemsTable.
2026+ 8640              ;
2027+ 8640              ; Input:
2028+ 8640              ;   B = Colonna (0..31)
2029+ 8640              ;   C = Riga (0..15)
2030+ 8640              ;
2031+ 8640              ; Output:
2032+ 8640              ;   Carry Set   = item presente nella cella
2033+ 8640              ;   Carry Clear = nessun item
2034+ 8640              ;
2035+ 8640              ; Nota:
2036+ 8640              ;   HL NON è restituito valido (commento originale non corretto:
2037+ 8640              ;   la routine non punta a ItemsTable).
2038+ 8640              ; -------------------------------------------------------------------
2039+ 8640              CheckActiveItemAtCell:
2040+ 8640
2041+ 8640                  ; Salva registri usati
2042+ 8640 D5               push de
2043+ 8641 E5               push hl
2044+ 8642
2045+ 8642                  ; ---------------------------------------------------------------
2046+ 8642                  ; Calcolo indice lineare nella griglia 32x16:
2047+ 8642                  ;
2048+ 8642                  ; offset = Row * 32 + Col
2049+ 8642                  ; ---------------------------------------------------------------
2050+ 8642 26 00            ld   h, 0
2051+ 8644 69               ld   l, c              ; HL = Row
2052+ 8645
2053+ 8645 29               add  hl, hl            ; *2
2054+ 8646 29               add  hl, hl            ; *4
2055+ 8647 29               add  hl, hl            ; *8
2056+ 8648 29               add  hl, hl            ; *16
2057+ 8649 29               add  hl, hl            ; *32
2058+ 864A
2059+ 864A                  ; Aggiunge la colonna
2060+ 864A 58               ld   e, b
2061+ 864B 16 00            ld   d, 0
2062+ 864D 19               add  hl, de            ; HL = Row*32 + Col
2063+ 864E
2064+ 864E                  ; ---------------------------------------------------------------
2065+ 864E                  ; Accesso alla griglia degli item attivi
2066+ 864E                  ; ---------------------------------------------------------------
2067+ 864E 11 81 EA         ld   de, items_grid
2068+ 8651 19               add  hl, de            ; HL = address cella
2069+ 8652
2070+ 8652                  ; ---------------------------------------------------------------
2071+ 8652                  ; Controllo presenza item
2072+ 8652                  ;
2073+ 8652                  ; items_grid contiene:
2074+ 8652                  ;   0 = nessun item
2075+ 8652                  ;   >0 = item attivo (colore o flag)
2076+ 8652                  ; ---------------------------------------------------------------
2077+ 8652 7E               ld   a, (hl)
2078+ 8653 B7               or   a
2079+ 8654 28 04            jr   z, .not_active
2080+ 8656
2081+ 8656                  ; ---------------------------------------------------------------
2082+ 8656                  ; Item trovato
2083+ 8656                  ; ---------------------------------------------------------------
2084+ 8656 E1               pop  hl
2085+ 8657 D1               pop  de
2086+ 8658
2087+ 8658 37               scf                    ; Carry = 1
2088+ 8659 C9               ret
2089+ 865A
2090+ 865A              .not_active:
2091+ 865A
2092+ 865A                  ; ---------------------------------------------------------------
2093+ 865A                  ; Nessun item nella cella
2094+ 865A                  ; ---------------------------------------------------------------
2095+ 865A E1               pop  hl
2096+ 865B D1               pop  de
2097+ 865C
2098+ 865C B7               or   a                 ; Carry = 0
2099+ 865D C9               ret
