  51+ 797E
  52+ 797E E5               push hl
  53+ 797F D5               push de
  54+ 7980 2A 01 F0         ld   hl, (room_ptr)
  55+ 7983 11 1A 01         ld   de, OFFSET_COLORS_5_8
  56+ 7986 19               add  hl, de
  57+ 7987 E5               push hl
  58+ 7988 DD E1            pop  ix                ; Reset color pointer to ROM offset for enemies 5-8
  59+ 798A D1               pop  de
  60+ 798B E1               pop  hl
  61+ 798C              .no_color_reset:
  62+ 798C
  63+ 798C                  ; Leggi il colore per questo nemico dal puntatore IX e salvalo sullo stack
  64+ 798C DD 7E 00         ld   a, (ix+0)
  65+ 798F DD 23            inc  ix
  66+ 7991 F5               push af                ; Salva colore sullo stack
  67+ 7992
  68+ 7992                  ; 1. Copia Flags (Byte 0), Type (Byte 1), StartX (Byte 2), StartY (Byte 3)
  69+ 7992 7E               ld   a, (hl)           ; A = Flags
  70+ 7993 CB 7F            bit  7, a              ; Il nemico è attivo?
  71+ 7995 28 26            jr   z, .store_enemy_flags ; Se non è attivo, memorizza 0
  72+ 7997
  73+ 7997                  ; Controlla se siamo nella stanza Master Bedroom
  74+ 7997 E5               push hl
  75+ 7998 C5               push bc
  76+ 7999 2A 01 F0         ld   hl, (room_ptr)
  77+ 799C 01 75 B1         ld   bc, MastreBedRoomLayout
