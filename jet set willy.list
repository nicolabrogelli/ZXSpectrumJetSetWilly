   7+ 67FA              ; Input_CheckCtrl
   8+ 67FA              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 67FA              ;
  10+ 67FA              ; Output:
  11+ 67FA              ;   D = bitmask tasti attivi:
  12+ 67FA              ;       bit 0 → sinistra (O)
  13+ 67FA              ;       bit 1 → destra   (P)
  14+ 67FA              ;       bit 2 → salto    (Z)
  15+ 67FA              ;
  16+ 67FA              ; Effetti collaterali in RAM:
  17+ 67FA              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 67FA              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 67FA              ;   (jump_prev)     → debounce tasto salto
  20+ 67FA              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 67FA              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 67FA              ; -------------------------------------------------------------------
  23+ 67FA
  24+ 67FA              Input_CheckCtrl:
  25+ 67FA AF               xor  a
  26+ 67FB 32 3C E6         ld   (current_input_dir), a
  27+ 67FE
  28+ 67FE                  IF ENABLE_ROOM_SKIP_KEYS != 0
  29+ 67FE                  ; ── Sezione 1a: tasto Q (cambio stanza AVANTI) ─────────────────────
  30+ 67FE                  ;
  31+ 67FE                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  32+ 67FE                  ; Se bit 0 = 0, Q è premuto.
  33+ 67FE
  34+ 67FE 01 FE FB         ld   bc, $fbfe
  35+ 6801 ED 78            in   a, (c)
  36+ 6803 CB 47            bit  0, a
  37+ 6805 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 6807
  39+ 6807                  ; Q è premuto: debounce tramite (q_prev).
  40+ 6807                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 6807 3A 3D E6         ld   a, (q_prev)
  42+ 680A B7               or   a
  43+ 680B 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 680D
  45+ 680D                  ; ── Primo frame di pressione di Q ──
  46+ 680D 3E 01            ld   a, 1
  47+ 680F 32 3D E6         ld   (q_prev), a            ; marca "Q era premuto"
  48+ 6812
  49+ 6812                  ; NOTA sullo stack:
  50+ 6812                  ; Input_CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  51+ 6812                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChangeNext senza
  52+ 6812                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  53+ 6812                  ; poi JP salta direttamente.
  54+ 6812 E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  55+ 6813 C3 C5 68         jp   PerformRoomChangeNext  ; salta al cambio stanza avanti (non torna qui)
  56+ 6816
  57+ 6816              .q_not_pressed:
  58+ 6816 AF               xor  a
  59+ 6817 32 3D E6         ld   (q_prev), a            ; Q rilasciato → azzera debounce
  60+ 681A
  61+ 681A              .q_handled:
  62+ 681A
  63+ 681A                  ; ── Sezione 1b: tasto A (cambio stanza INDIETRO) ────────────────────
  64+ 681A                  ;
  65+ 681A                  ; Porta $FD → riga A, S, D, F, G. Bit 0 = A.
  66+ 681A                  ; Se bit 0 = 0, A è premuto.
  67+ 681A
  68+ 681A 01 FE FD         ld   bc, $fdfe
  69+ 681D ED 78            in   a, (c)
  70+ 681F CB 47            bit  0, a
  71+ 6821 20 0F            jr   nz, .a_not_pressed     ; bit 0 = 1 → A non premuto, salta
  72+ 6823
  73+ 6823                  ; A è premuto: debounce tramite (a_prev).
  74+ 6823 3A 3E E6         ld   a, (a_prev)
  75+ 6826 B7               or   a
  76+ 6827 20 0D            jr   nz, .a_handled         ; era già premuto, niente da fare
  77+ 6829
  78+ 6829                  ; ── Primo frame di pressione di A ──
  79+ 6829 3E 01            ld   a, 1
  80+ 682B 32 3E E6         ld   (a_prev), a            ; marca "A era premuto"
  81+ 682E
  82+ 682E E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  83+ 682F C3 C9 68         jp   PerformRoomChangePrev  ; salta al cambio stanza indietro (non torna qui)
  84+ 6832
