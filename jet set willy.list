1028+ 6ABF 07               rlca
1029+ 6AC0 E6 03            and  3
1030+ 6AC2 12               ld   (de), a
1031+ 6AC3 13               inc  de
1032+ 6AC4
1033+ 6AC4                  ; Cella 1: bit 5-4
1034+ 6AC4 79               ld   a, c
1035+ 6AC5 07               rlca
1036+ 6AC6 07               rlca
1037+ 6AC7 07               rlca
1038+ 6AC8 07               rlca
1039+ 6AC9 E6 03            and  3
1040+ 6ACB 12               ld   (de), a
1041+ 6ACC 13               inc  de
1042+ 6ACD
1043+ 6ACD                  ; Cella 2: bit 3-2
1044+ 6ACD 79               ld   a, c
1045+ 6ACE 0F               rrca
1046+ 6ACF 0F               rrca
1047+ 6AD0 E6 03            and  3
1048+ 6AD2 12               ld   (de), a
1049+ 6AD3 13               inc  de
1050+ 6AD4
1051+ 6AD4                  ; Cella 3: bit 1-0
1052+ 6AD4 79               ld   a, c
1053+ 6AD5 E6 03            and  3
1054+ 6AD7 12               ld   (de), a
1055+ 6AD8 13               inc  de
1056+ 6AD9
1057+ 6AD9 10 E0            djnz .byte_loop
1058+ 6ADB
1059+ 6ADB C1               pop  bc
1060+ 6ADC D1               pop  de
1061+ 6ADD E1               pop  hl
