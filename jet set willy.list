 836  8DBA              .x_check:
 837  8DBA                  ; ConveyorLeft = conveyor_col * 8
 838  8DBA 3A 12 FB         ld   a, (conveyor_col)
 839  8DBD 87               add  a, a                  ; *2
 840  8DBE 87               add  a, a                  ; *4
 841  8DBF 87               add  a, a                  ; *8
 842  8DC0 5F               ld   e, a                  ; E = ConveyorLeft
 843  8DC1
 844  8DC1                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 845  8DC1 21 10 FB         ld   hl, conveyor_len
 846  8DC4 3A 12 FB         ld   a, (conveyor_col)
 847  8DC7 86               add  a, (hl)
 848  8DC8 87               add  a, a                  ; *2
 849  8DC9 87               add  a, a                  ; *4
 850  8DCA 87               add  a, a                  ; *8
 851  8DCB 3D               dec  a                     ; ConveyorRight
 852  8DCC 57               ld   d, a                  ; D = ConveyorRight
 853  8DCD
 854  8DCD                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 855  8DCD 79               ld   a, c                  ; WillyLeft
 856  8DCE BA               cp   d
 857  8DCF 28 04            jr   z, .x_overlap
 858  8DD1 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 859  8DD3 18 0E            jr   .no_conv_collision
 860  8DD5
 861  8DD5              .x_overlap:
 862  8DD5 C6 0F            add  a, 15                 ; WillyRight
 863  8DD7 BB               cp   e
 864  8DD8 28 04            jr   z, .collision_detected
 865  8DDA 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 866  8DDC 18 05            jr   .no_conv_collision
 867  8DDE
 868  8DDE              .collision_detected:
 869  8DDE E1               pop  hl
 870  8DDF D1               pop  de
 871  8DE0 C1               pop  bc
 872  8DE1 37               scf
 873  8DE2 C9               ret
 874  8DE3
 875  8DE3              .no_conv_collision:
 876  8DE3 E1               pop  hl
 877  8DE4 D1               pop  de
 878  8DE5 C1               pop  bc
