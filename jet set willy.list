1349+ 7465              ; CheckActiveItemAtCell
1350+ 7465              ;
1351+ 7465              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1352+ 7465              ; nella cella specificata della griglia items_grid.
1353+ 7465              ;
1354+ 7465              ; Questa routine usa una lookup diretta su una mappa 32x16,
1355+ 7465              ; evitando la scansione della ItemsTable.
1356+ 7465              ;
1357+ 7465              ; Input:
1358+ 7465              ;   B = Colonna (0..31)
1359+ 7465              ;   C = Riga (0..15)
1360+ 7465              ;
1361+ 7465              ; Output:
1362+ 7465              ;   Carry Set   = item presente nella cella
1363+ 7465              ;   Carry Clear = nessun item
1364+ 7465              ;
1365+ 7465              ; Nota:
1366+ 7465              ;   HL NON è restituito valido (commento originale non corretto:
1367+ 7465              ;   la routine non punta a ItemsTable).
1368+ 7465              ; -------------------------------------------------------------------
1369+ 7465              CheckActiveItemAtCell:
1370+ 7465
1371+ 7465                  ; Salva registri usati
1372+ 7465 D5               push de
1373+ 7466 E5               push hl
1374+ 7467
1375+ 7467                  ; ---------------------------------------------------------------
1376+ 7467                  ; Calcolo indice lineare nella griglia 32x16:
1377+ 7467                  ;
1378+ 7467                  ; offset = Row * 32 + Col
1379+ 7467                  ; ---------------------------------------------------------------
1380+ 7467 26 00            ld   h, 0
1381+ 7469 69               ld   l, c              ; HL = Row
1382+ 746A
1383+ 746A 29               add  hl, hl            ; *2
1384+ 746B 29               add  hl, hl            ; *4
1385+ 746C 29               add  hl, hl            ; *8
1386+ 746D 29               add  hl, hl            ; *16
1387+ 746E 29               add  hl, hl            ; *32
1388+ 746F
1389+ 746F                  ; Aggiunge la colonna
1390+ 746F 58               ld   e, b
1391+ 7470 16 00            ld   d, 0
1392+ 7472 19               add  hl, de            ; HL = Row*32 + Col
1393+ 7473
1394+ 7473                  ; ---------------------------------------------------------------
1395+ 7473                  ; Accesso alla griglia degli item attivi
1396+ 7473                  ; ---------------------------------------------------------------
1397+ 7473 11 00 B0         ld   de, items_grid
1398+ 7476 19               add  hl, de            ; HL = address cella
1399+ 7477
1400+ 7477                  ; ---------------------------------------------------------------
1401+ 7477                  ; Controllo presenza item
1402+ 7477                  ;
1403+ 7477                  ; items_grid contiene:
1404+ 7477                  ;   0 = nessun item
1405+ 7477                  ;   >0 = item attivo (colore o flag)
1406+ 7477                  ; ---------------------------------------------------------------
1407+ 7477 7E               ld   a, (hl)
1408+ 7478 B7               or   a
1409+ 7479 28 04            jr   z, .not_active
1410+ 747B
1411+ 747B                  ; ---------------------------------------------------------------
1412+ 747B                  ; Item trovato
1413+ 747B                  ; ---------------------------------------------------------------
1414+ 747B E1               pop  hl
1415+ 747C D1               pop  de
1416+ 747D
1417+ 747D 37               scf                    ; Carry = 1
1418+ 747E C9               ret
1419+ 747F
1420+ 747F              .not_active:
1421+ 747F
1422+ 747F                  ; ---------------------------------------------------------------
1423+ 747F                  ; Nessun item nella cella
1424+ 747F                  ; ---------------------------------------------------------------
1425+ 747F E1               pop  hl
1426+ 7480 D1               pop  de
1427+ 7481
1428+ 7481 B7               or   a                 ; Carry = 0
1429+ 7482 C9               ret
