1831+ 779B 20 0C            jr   nz, .custom_settings
1832+ 779D
1833+ 779D 3E 06            ld   a, DEFAULT_JUMP_STRENGTH
1834+ 779F 32 9E EA         ld   (room_jump_strength), a
1835+ 77A2 3E 01            ld   a, DEFAULT_GRAVITY_PRESET
