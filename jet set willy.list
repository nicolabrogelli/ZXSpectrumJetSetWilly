   6+ 660D              ; MovePlayer
   7+ 660D              ;
   8+ 660D              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 660D              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 660D              ; con i muri.
  11+ 660D              ;
  12+ 660D              ; Input:
  13+ 660D              ;   D = stato dei controlli (bitfield)
  14+ 660D              ;
  15+ 660D              ; Strutture utilizzate:
  16+ 660D              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 660D              ;   player_speed    -> velocità orizzontale
  18+ 660D              ;   flags           -> flag di stato input
  19+ 660D              ;
  20+ 660D              ; Bit controlli:
  21+ 660D              ;   bit 0 = sinistra
  22+ 660D              ;   bit 1 = destra
  23+ 660D              ;
  24+ 660D              ; Nota:
  25+ 660D              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 660D              ;   ignorato per tutta la durata del salto.
  27+ 660D              ;
  28+ 660D              ; Output:
  29+ 660D              ;   aggiorna PlayerPos e body_state
  30+ 660D              ; -------------------------------------------------------------------
  31+ 660D              MovePlayer:
  32+ 660D
  33+ 660D                  ; ---------------------------------------------------------------
  34+ 660D                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 660D                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 660D                  ; tasti di direzione premuti (jump_dir decide).
  37+ 660D                  ; ---------------------------------------------------------------
  38+ 660D 3A 35 E6         ld   a, (on_ground)
  39+ 6610 B7               or   a
  40+ 6611 20 1A            jr   nz, .on_ground_check
  41+ 6613
  42+ 6613 3A 3A E6         ld   a, (jump_dir)
  43+ 6616 B7               or   a
  44+ 6617 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6618
  46+ 6618                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6618 DD 21 2E E6      ld   ix, flags
  48+ 661C DD CB 00 86      res  $00, (ix)
  49+ 6620
  50+ 6620 ED 4B 26 E6      ld   bc, (PlayerPos)
  51+ 6624 FE 01            cp   1
  52+ 6626 28 1D            jr   z, movePlayer_left
  53+ 6628 FE 02            cp   2
  54+ 662A 28 6A            jr   z, movePlayer_right
  55+ 662C C9               ret
  56+ 662D
  57+ 662D              .on_ground_check:
  58+ 662D                  ; ---------------------------------------------------------------
  59+ 662D                  ; Se siamo a terra, muoviti solo se c'è input (bit 0 di flags impostato)
  60+ 662D                  ; ---------------------------------------------------------------
  61+ 662D DD 21 2E E6      ld   ix, flags
  62+ 6631 DD CB 00 46      bit  $00, (ix)
  63+ 6635 C8               ret  z
  64+ 6636
  65+ 6636 DD CB 00 86      res  $00, (ix)
  66+ 663A
  67+ 663A ED 4B 26 E6      ld   bc, (PlayerPos)
  68+ 663E
