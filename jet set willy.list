1170+ 771D 79               ld   a, c
1171+ 771E CB 3F            srl  a
1172+ 7720 CB 3F            srl  a
1173+ 7722 CB 3F            srl  a                 ; A = c (0..31)
1174+ 7724 4F               ld   c, a              ; C = c (Col)
