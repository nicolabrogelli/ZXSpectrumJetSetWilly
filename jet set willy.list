   8+ 7427              ; Audio_UpdateJumpSound
   9+ 7427              ;
  10+ 7427              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7427              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7427              ; -------------------------------------------------------------------
  13+ 7427              Audio_UpdateJumpSound:
  14+ 7427 F5               push af
  15+ 7428 C5               push bc
  16+ 7429 D5               push de
  17+ 742A E5               push hl
  18+ 742B
  19+ 742B                  ; Controlla se il suono è attivo (note < 18)
  20+ 742B 3A BC 78         ld   a, (Audio_jump_sound_note)
  21+ 742E FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7430 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7432
  24+ 7432                  ; Carica la nota corrente da suonare
  25+ 7432 5F               ld   e, a
  26+ 7433 16 00            ld   d, 0
  27+ 7435 21 61 74         ld   hl, Audio_JumpSoundDelays
  28+ 7438 19               add  hl, de
  29+ 7439 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 743A 57               ld   d, a                      ; D = delay della nota
  31+ 743B
  32+ 743B                  ; Suona la nota: 15 cicli
  33+ 743B 06 0F            ld   b, 15
  34+ 743D              .note_loop:
  35+ 743D                  ; Speaker ON
  36+ 743D 3A 50 75         ld   a, (room_border_color)
  37+ 7440 F6 10            or   $10
  38+ 7442 D3 FE            out  ($fe), a
  39+ 7444 4A               ld   c, d
  40+ 7445              .d1:
  41+ 7445 0D               dec  c
  42+ 7446 20 FD            jr   nz, .d1
  43+ 7448
  44+ 7448                  ; Speaker OFF
  45+ 7448 3A 50 75         ld   a, (room_border_color)
  46+ 744B E6 EF            and  $ef
  47+ 744D D3 FE            out  ($fe), a
  48+ 744F 4A               ld   c, d
  49+ 7450              .d2:
  50+ 7450 0D               dec  c
  51+ 7451 20 FD            jr   nz, .d2
  52+ 7453
  53+ 7453 10 E8            djnz .note_loop
  54+ 7455
  55+ 7455                  ; Passa alla nota successiva
  56+ 7455 3A BC 78         ld   a, (Audio_jump_sound_note)
  57+ 7458 3C               inc  a
  58+ 7459 32 BC 78         ld   (Audio_jump_sound_note), a
  59+ 745C
  60+ 745C              .done:
  61+ 745C E1               pop  hl
  62+ 745D D1               pop  de
  63+ 745E C1               pop  bc
  64+ 745F F1               pop  af
  65+ 7460 C9               ret
