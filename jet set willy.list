1801+ 67BB              ; Disegna un carattere ASCII A alla colonna C (0..31) di Riga 23 direttamente in VRAM
1802+ 67BB              ; -------------------------------------------------------------------
1803+ 67BB              Gfx_DrawCharVRAM_Row23:
1804+ 67BB F5               push af
1805+ 67BC C5               push bc
1806+ 67BD D5               push de
1807+ 67BE E5               push hl
1808+ 67BF
1809+ 67BF                  ; C = colonna (0..31), A = carattere ASCII
1810+ 67BF 47               ld   b, a              ; B = salva carattere ASCII
1811+ 67C0 79               ld   a, c
1812+ 67C1 FE 20            cp   32
1813+ 67C3 30 2E            jr   nc, .exit_draw_char ; Se C >= 32, ignora per sicurezza!
1814+ 67C5
1815+ 67C5                  ; Check dei limiti ASCII (32..127) per non accedere a RAM fuori dal font
1816+ 67C5 78               ld   a, b              ; A = carattere ASCII
1817+ 67C6 FE 20            cp   32
1818+ 67C8 38 29            jr   c, .exit_draw_char ; Se CHAR < 32 (non stampabile), ignora!
1819+ 67CA FE 80            cp   128
1820+ 67CC 30 25            jr   nc, .exit_draw_char ; Se CHAR >= 128 (fuori dal font RAM), ignora!
1821+ 67CE
1822+ 67CE                  ; 1. Indirizzo del font in RAM ($F100 + (ASCII - 32) * 8)
1823+ 67CE D6 20            sub  32                ; A = ASCII - 32
1824+ 67D0 6F               ld   l, a
1825+ 67D1 26 00            ld   h, 0
1826+ 67D3 29               add  hl, hl            ; *2
1827+ 67D4 29               add  hl, hl            ; *4
1828+ 67D5 29               add  hl, hl            ; *8
1829+ 67D6 11 00 F1         ld   de, $F100         ; Indirizzo base del font 8x8 in RAM ($F100)
1830+ 67D9 19               add  hl, de            ; HL = indirizzo pattern font 8x8 in RAM ($F100)
1831+ 67DA
1832+ 67DA                  ; 2. Imposta l'attributo colore a Riga 23, Colonna C ($5AE0 + C)
1833+ 67DA E5               push hl                ; Salva indirizzo pattern font
1834+ 67DB 69               ld   l, c
1835+ 67DC 26 00            ld   h, 0
1836+ 67DE 11 E0 5A         ld   de, $5ae0
1837+ 67E1 19               add  hl, de            ; HL = indirizzo attributi Riga 23 ($5AE0 + C)
1838+ 67E2 36 46            ld   (hl), $46         ; Attributo: BRIGHT 1 + PAPER BLACK + INK YELLOW ($46)
1839+ 67E4 E1               pop  hl                ; Ripristina indirizzo pattern font in HL
1840+ 67E5
1841+ 67E5                  ; 3. Indirizzo VRAM Riga 23, Colonna C
1842+ 67E5                  ; Low byte VRAM: $E0 | C
1843+ 67E5 79               ld   a, c
1844+ 67E6 F6 E0            or   $e0
1845+ 67E8 5F               ld   e, a              ; E = Low byte VRAM ($E0 | C)
1846+ 67E9
1847+ 67E9                  ; Copia gli 8 byte di pattern nelle 8 linee di VRAM ($5000, $5100, ..., $5700)
1848+ 67E9 16 50            ld   d, $50            ; D = High byte iniziale VRAM ($50)
1849+ 67EB 06 08            ld   b, 8              ; B = 8 linee di pixel
1850+ 67ED              .loop_vram_lines:
1851+ 67ED 7E               ld   a, (hl)           ; Leggi byte dal font ROM
1852+ 67EE 12               ld   (de), a           ; Scrivi direttamente in VRAM bitmap
1853+ 67EF 23               inc  hl                ; Prossimo byte del font
1854+ 67F0 14               inc  d                 ; Prossima linea schermo ($50 -> $51 -> ... -> $57)
1855+ 67F1 10 FA            djnz .loop_vram_lines
