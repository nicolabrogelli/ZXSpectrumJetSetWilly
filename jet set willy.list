 228+ 64E7              ;   PlayerPosOld  = copia della posizione iniziale
 229+ 64E7              ;
 230+ 64E7              ; Struttura dati stanza:
 231+ 64E7              ;   OFFSET_POS_WILLY:
 232+ 64E7              ;       +0 = X
 233+ 64E7              ;       +1 = Y
