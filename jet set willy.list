 179+ 884E              ; Audio_PlayCollectSound
 180+ 884E              ;
 181+ 884E              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 884E              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 884E              ; -------------------------------------------------------------------
 184+ 884E              Audio_PlayCollectSound:
 185+ 884E C5               push bc
 186+ 884F D5               push de
 187+ 8850
 188+ 8850 06 78            ld   b, 120
 189+ 8852              .sound_loop:
 190+ 8852 3A EE F4         ld   a, (room_border_color)
 191+ 8855 F6 10            or   $10               ; speaker ON
 192+ 8857 D3 FE            out  ($fe), a
 193+ 8859
 194+ 8859 0E 3C            ld   c, 60
 195+ 885B              .d1:
 196+ 885B 0D               dec  c
 197+ 885C 20 FD            jr   nz, .d1
 198+ 885E
 199+ 885E 3A EE F4         ld   a, (room_border_color)
 200+ 8861 E6 EF            and  $ef              ; speaker OFF
 201+ 8863 D3 FE            out  ($fe), a
 202+ 8865
 203+ 8865 0E 3C            ld   c, 60
 204+ 8867              .d2:
 205+ 8867 0D               dec  c
 206+ 8868 20 FD            jr   nz, .d2
 207+ 886A
 208+ 886A 10 E6            djnz .sound_loop
 209+ 886C
 210+ 886C D1               pop  de
 211+ 886D C1               pop  bc
 212+ 886E C9               ret
