 914+ 6A7D              ; -------------------------------------------------------------------
 915+ 6A7D              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 916+ 6A7D              ; Input: C = X, B = Y
 917+ 6A7D              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 918+ 6A7D              ; -------------------------------------------------------------------
 919+ 6A7D              CheckWallCell:
 920+ 6A7D E5               push hl
 921+ 6A7E D5               push de
 922+ 6A7F C5               push bc
 923+ 6A80
 924+ 6A80                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 925+ 6A80 78               ld   a, b
 926+ 6A81 FE 80            cp   128
 927+ 6A83 30 1F            jr   nc, .not_wall
 928+ 6A85
 929+ 6A85                  ; 2. Calcola riga di layout: r = Y / 8
 930+ 6A85 CB 3F            srl  a
 931+ 6A87 CB 3F            srl  a
 932+ 6A89 CB 3F            srl  a                 ; A = r (0..15)
 933+ 6A8B
 934+ 6A8B                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 935+ 6A8B 5F               ld   e, a              ; E = r (Row)
 936+ 6A8C 79               ld   a, c
 937+ 6A8D CB 3F            srl  a
 938+ 6A8F CB 3F            srl  a
 939+ 6A91 CB 3F            srl  a                 ; A = c (0..31)
 940+ 6A93 4F               ld   c, a              ; C = c (Col)
 941+ 6A94
 942+ 6A94                  ; Se la cella è sulla rampa, non considerarla un muro!
 943+ 6A94 53               ld   d, e              ; D = Row
 944+ 6A95 59               ld   e, c              ; E = Col
 945+ 6A96 CD 02 6A         call IsCellOnRamp
 946+ 6A99 38 09            jr   c, .not_wall
 947+ 6A9B
 948+ 6A9B 7A               ld   a, d              ; A = Row
 949+ 6A9C 4B               ld   c, e              ; C = Col
 950+ 6A9D CD FD 6A         call GetCellFromUnpacked ; A = cell type
 951+ 6AA0
 952+ 6AA0                  ; Controlla se è Wall (2)
 953+ 6AA0 FE 02            cp   2
 954+ 6AA2 28 05            jr   z, .is_wall
 955+ 6AA4
