 230+ 5EC2              .check_ramp:
 231+ 5EC2 3A 7F 79         ld   a, (ramp_len)
 232+ 5EC5 B7               or   a
 233+ 5EC6 CA F8 5E         jp   z, .normal_grid
 234+ 5EC9
 235+ 5EC9 3A 80 79         ld   a, (ramp_row)
 236+ 5ECC D6 03            sub  3                 ; A = RampRowStart
 237+ 5ECE BB               cp   e                 ; compare with player row E
 238+ 5ECF DA F8 5E         jp   c, .normal_grid   ; if RampRowStart < E, skip!
 239+ 5ED2
 240+ 5ED2 93               sub  e                 ; A = RampRowStart - E
 241+ 5ED3 47               ld   b, a              ; B = distance from start row (0..ramp_len-1)
 242+ 5ED4 3A 7F 79         ld   a, (ramp_len)
 243+ 5ED7 B8               cp   b
 244+ 5ED8 CA F8 5E         jp   z, .normal_grid   ; if B == ramp_len, too high!
 245+ 5EDB DA F8 5E         jp   c, .normal_grid   ; if B > ramp_len, too high!
 246+ 5EDE
 247+ 5EDE                  ; Calcola ExpectedCol:
 248+ 5EDE 3A 7E 79         ld   a, (ramp_dir)
 249+ 5EE1 B7               or   a
 250+ 5EE2 28 06            jr   z, .r_left
