 191+ 8249              ; -------------------------------------------------------------------
 192+ 8249              ; DetermineCurrentRoomID
 193+ 8249              ;
 194+ 8249              ; Determina l'ID numerico della stanza corrente confrontando
 195+ 8249              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 196+ 8249              ;
 197+ 8249              ; Se viene trovata una corrispondenza:
 198+ 8249              ;   A = ID della stanza
 199+ 8249              ;   current_room = A
 200+ 8249              ;
 201+ 8249              ; Mappatura:
 202+ 8249              ;    0 = The Off Licence
 203+ 8249              ;    1 = The Bridge
 204+ 8249              ;    2 = Under The Mega Tree
 205+ 8249              ;    3 = Gfx_At The Foot Of The Mega Tree
 206+ 8249              ;    4 = The Drive
 207+ 8249              ;    5 = The Security Guard
 208+ 8249              ;    6 = Entrance To Hades
 209+ 8249              ;    7 = Cuckoo's Nest
 210+ 8249              ;    8 = Inside The Mega Trunk
 211+ 8249              ;    9 = On A Branch Over The Drive
 212+ 8249              ;   10 = The Front Door
 213+ 8249              ;   11 = The Hall
 214+ 8249              ;   12 = Tree Top
 215+ 8249              ;   27 = The Chapel
 216+ 8249              ;   28 = First Landing
 217+ 8249              ;   29 = The Nightmare Room
 218+ 8249              ;   33 = The Bathroom
 219+ 8249              ;   35 = Master Bedroom
 220+ 8249              ;
 221+ 8249              ; Se nessuna stanza corrisponde viene impostato:
 222+ 8249              ;   current_room = 0
 223+ 8249              ; -------------------------------------------------------------------
 224+ 8249              DetermineCurrentRoomID:
 225+ 8249
