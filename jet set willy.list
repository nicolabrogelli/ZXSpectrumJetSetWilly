  16+ 6A6E              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6A6E              ;   player_speed    -> velocità orizzontale
  18+ 6A6E              ;   flags           -> flag di stato input
  19+ 6A6E              ;
  20+ 6A6E              ; Bit controlli:
  21+ 6A6E              ;   bit 0 = sinistra
  22+ 6A6E              ;   bit 1 = destra
  23+ 6A6E              ;
  24+ 6A6E              ; Nota:
  25+ 6A6E              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6A6E              ;   ignorato per tutta la durata del salto.
  27+ 6A6E              ;
  28+ 6A6E              ; Output:
  29+ 6A6E              ;   aggiorna PlayerPos e body_state
