 184+ 7C38              ; -------------------------------------------------------------------
 185+ 7C38              ; DetermineCurrentRoomID
 186+ 7C38              ;
 187+ 7C38              ; Determina l'ID numerico della stanza corrente confrontando
 188+ 7C38              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 189+ 7C38              ;
 190+ 7C38              ; Se viene trovata una corrispondenza:
 191+ 7C38              ;   A = ID della stanza
 192+ 7C38              ;   current_room = A
 193+ 7C38              ;
 194+ 7C38              ; Mappatura:
 195+ 7C38              ;    0 = The Off Licence
 196+ 7C38              ;    1 = The Bridge
 197+ 7C38              ;    2 = Under The Mega Tree
 198+ 7C38              ;    3 = Gfx_At The Foot Of The Mega Tree
 199+ 7C38              ;    4 = The Drive
 200+ 7C38              ;    5 = The Security Guard
 201+ 7C38              ;    6 = Entrance To Hades
 202+ 7C38              ;    7 = Cuckoo's Nest
 203+ 7C38              ;    8 = Inside The Mega Trunk
 204+ 7C38              ;    9 = On A Branch Over The Drive
 205+ 7C38              ;   10 = The Front Door
 206+ 7C38              ;   11 = The Hall
 207+ 7C38              ;   12 = Tree Top
 208+ 7C38              ;   27 = The Chapel
 209+ 7C38              ;   28 = First Landing
 210+ 7C38              ;   29 = The Nightmare Room
 211+ 7C38              ;   33 = The Bathroom
 212+ 7C38              ;   35 = Master Bedroom
 213+ 7C38              ;
 214+ 7C38              ; Se nessuna stanza corrisponde viene impostato:
 215+ 7C38              ;   current_room = 0
 216+ 7C38              ; -------------------------------------------------------------------
 217+ 7C38              DetermineCurrentRoomID:
 218+ 7C38
 219+ 7C38                  ; Salva i registri utilizzati
 220+ 7C38 E5               push hl
 221+ 7C39 D5               push de
 222+ 7C3A
 223+ 7C3A                  ; ---------------------------------------------------------------
