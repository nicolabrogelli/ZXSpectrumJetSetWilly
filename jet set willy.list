 463+ 7551              ; -------------------------------------------------------------------
 464+ 7551              ; Riproduce un breve segnale acustico all'altoparlante
 465+ 7551              ; -------------------------------------------------------------------
 466+ 7551              PlayCollectSound:
 467+ 7551 C5               push bc
 468+ 7552 D5               push de
 469+ 7553
 470+ 7553 06 78            ld   b, 120            ; Cicli della nota
 471+ 7555              .sound_loop:
 472+ 7555 3A 1C 76         ld   a, (room_border_color)
 473+ 7558 F6 10            or   $10               ; Speaker ON (bit 4 = 1)
 474+ 755A D3 FE            out  ($fe), a
 475+ 755C 0E 3C            ld   c, 60             ; Mezzo periodo delay
 476+ 755E 0D           .d1: dec  c
 477+ 755F 20 FD            jr   nz, .d1
 478+ 7561
 479+ 7561 3A 1C 76         ld   a, (room_border_color)
 480+ 7564 E6 EF            and  $ef               ; Speaker OFF (bit 4 = 0)
 481+ 7566 D3 FE            out  ($fe), a
 482+ 7568 0E 3C            ld   c, 60             ; Mezzo periodo delay
 483+ 756A 0D           .d2: dec  c
 484+ 756B 20 FD            jr   nz, .d2
 485+ 756D
 486+ 756D 10 E6            djnz .sound_loop
 487+ 756F
 488+ 756F D1               pop  de
 489+ 7570 C1               pop  bc
 490+ 7571 C9               ret
