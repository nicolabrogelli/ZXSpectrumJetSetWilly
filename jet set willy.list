   8+ 7969              ; Audio_UpdateJumpSound
   9+ 7969              ;
  10+ 7969              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7969              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7969              ; -------------------------------------------------------------------
  13+ 7969              Audio_UpdateJumpSound:
  14+ 7969 F5               push af
  15+ 796A C5               push bc
  16+ 796B D5               push de
  17+ 796C E5               push hl
  18+ 796D
  19+ 796D                  ; Controlla se il suono è attivo (note < 18)
  20+ 796D 3A 03 7E         ld   a, (Audio_jump_sound_note)
  21+ 7970 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7972 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7974
  24+ 7974                  ; Carica la nota corrente da suonare
  25+ 7974 5F               ld   e, a
  26+ 7975 16 00            ld   d, 0
  27+ 7977 21 A3 79         ld   hl, Audio_JumpSoundDelays
  28+ 797A 19               add  hl, de
  29+ 797B 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 797C 57               ld   d, a                      ; D = delay della nota
  31+ 797D
  32+ 797D                  ; Suona la nota: 15 cicli
  33+ 797D 06 0F            ld   b, 15
  34+ 797F              .note_loop:
  35+ 797F                  ; Speaker ON
  36+ 797F 3A 8E 7A         ld   a, (room_border_color)
  37+ 7982 F6 10            or   $10
  38+ 7984 D3 FE            out  ($fe), a
  39+ 7986 4A               ld   c, d
  40+ 7987              .d1:
  41+ 7987 0D               dec  c
  42+ 7988 20 FD            jr   nz, .d1
  43+ 798A
  44+ 798A                  ; Speaker OFF
  45+ 798A 3A 8E 7A         ld   a, (room_border_color)
  46+ 798D E6 EF            and  $ef
  47+ 798F D3 FE            out  ($fe), a
  48+ 7991 4A               ld   c, d
  49+ 7992              .d2:
  50+ 7992 0D               dec  c
  51+ 7993 20 FD            jr   nz, .d2
  52+ 7995
  53+ 7995 10 E8            djnz .note_loop
  54+ 7997
  55+ 7997                  ; Passa alla nota successiva
  56+ 7997 3A 03 7E         ld   a, (Audio_jump_sound_note)
  57+ 799A 3C               inc  a
  58+ 799B 32 03 7E         ld   (Audio_jump_sound_note), a
  59+ 799E
  60+ 799E              .done:
  61+ 799E E1               pop  hl
  62+ 799F D1               pop  de
  63+ 79A0 C1               pop  bc
  64+ 79A1 F1               pop  af
  65+ 79A2 C9               ret
