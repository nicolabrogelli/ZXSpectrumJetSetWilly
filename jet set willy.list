1907+ 80C9 29               add  hl, hl            ; *4
1908+ 80CA 29               add  hl, hl            ; *8
1909+ 80CB 29               add  hl, hl            ; *16
1910+ 80CC 29               add  hl, hl            ; *32
1911+ 80CD
1912+ 80CD 59               ld   e, c
