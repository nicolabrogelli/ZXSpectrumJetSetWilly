   6+ 6D1D              ; MovePlayer
   7+ 6D1D              ;
   8+ 6D1D              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6D1D              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6D1D              ; con i muri.
  11+ 6D1D              ;
  12+ 6D1D              ; Input:
  13+ 6D1D              ;   D = stato dei controlli (bitfield)
  14+ 6D1D              ;
  15+ 6D1D              ; Strutture utilizzate:
  16+ 6D1D              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6D1D              ;   player_speed    -> velocità orizzontale
  18+ 6D1D              ;   flags           -> flag di stato input
  19+ 6D1D              ;
  20+ 6D1D              ; Bit controlli:
  21+ 6D1D              ;   bit 0 = sinistra
  22+ 6D1D              ;   bit 1 = destra
  23+ 6D1D              ;
  24+ 6D1D              ; Nota:
  25+ 6D1D              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6D1D              ;   ignorato per tutta la durata del salto.
  27+ 6D1D              ;
  28+ 6D1D              ; Output:
  29+ 6D1D              ;   aggiorna PlayerPos e body_state
  30+ 6D1D              ; -------------------------------------------------------------------
  31+ 6D1D              MovePlayer:
  32+ 6D1D
  33+ 6D1D                  ; ---------------------------------------------------------------
  34+ 6D1D                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6D1D                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6D1D                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6D1D                  ; ---------------------------------------------------------------
  38+ 6D1D 3A 49 F7         ld   a, (on_ground)
  39+ 6D20 B7               or   a
  40+ 6D21 20 1A            jr   nz, .on_ground_check
  41+ 6D23
  42+ 6D23 3A 4E F7         ld   a, (jump_dir)
  43+ 6D26 B7               or   a
  44+ 6D27 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6D28
  46+ 6D28                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6D28 DD 21 42 F7      ld   ix, flags
  48+ 6D2C DD CB 00 86      res  $00, (ix)
  49+ 6D30
  50+ 6D30 ED 4B 3A F7      ld   bc, (PlayerPos)
