 231  837E 4E               ld   c, (hl)                   ; C = X ingresso
 232  837F 23               inc  hl
 233  8380 46               ld   b, (hl)                   ; B = Y ingresso
 234  8381 ED 43 E0 E6      ld   (PlayerPos), bc           ; Imposta le coordinate di respawn al punto di ingresso
 235  8385 ED 43 E2 E6      ld   (PlayerPosOld), bc
 236  8389
 237  8389 3E 01            ld   a, 1
 238  838B 32 66 EA         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 239  838E
 240  838E                  ; 6. Ridisegna completamente la stanza e riposiziona Willy nel punto di ingresso
 241  838E C3 9B 82         jp   LoadRoomAndRestart
 242  8391
 243  8391              .draw_raster_bars:
 244  8391                  ; Collisione attiva: disegna le raster bar nel bordo
 245  8391 3A 01 E7         ld   a, (counter)
 246  8394 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 247  8396 06 1E            ld   b, 30             ; Numero di righe della barra raster
 248  8398              .raster_loop:
 249  8398 D3 FE            out  ($fe), a
 250  839A 3C               inc  a
 251  839B E6 07            and  7
 252  839D 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 253  839F              .delay:
 254  839F 0D               dec  c
 255  83A0 20 FD            jr   nz, .delay
 256  83A2 10 F4            djnz .raster_loop
 257  83A4
 258  83A4                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 259  83A4 3A EC E6         ld   a, (room_border_color)
 260  83A7 D3 FE            out  ($fe), a
 261  83A9 18 05            jr   .no_collision_change
