 990+ 7EF8              .vert_down:
 991+ 7EF8 DD 7E 03         ld   a, (ix+3)         ; Current Y
 992+ 7EFB C6 02            add  a, 2              ; Muovi in basso di 2 pixel
 993+ 7EFD DD BE 05         cp   (ix+5)            ; Max Limit (Bottom)
 994+ 7F00 28 08            jr   z, .v_rev_up
 995+ 7F02 30 06            jr   nc, .v_rev_up
 996+ 7F04 DD 77 03         ld   (ix+3), a
 997+ 7F07 C3 15 7F         jp   .next
 998+ 7F0A
 999+ 7F0A              .v_rev_up:
1000+ 7F0A DD 7E 05         ld   a, (ix+5)         ; Max Limit
1001+ 7F0D DD 77 03         ld   (ix+3), a
1002+ 7F10 3E 01            ld   a, 1
1003+ 7F12 DD 77 06         ld   (ix+6), a         ; Cambia direzione in Alto
1004+ 7F15
1005+ 7F15              .next:
