   4+ 6912
   5+ 6912
   6+ 6912              ; -------------------------------------------------------------------
   7+ 6912              ; Verifica se c'è una cella solida (Floor o Wall) alle coordinate pixel (X, Y)
   8+ 6912              ; Input: C = X, B = Y
   9+ 6912              ; Output: Carry flag impostato se solida, altrimenti resettato
  10+ 6912              ; -------------------------------------------------------------------
  11+ 6912              CheckSolidCell:
  12+ 6912 E5               push hl
  13+ 6913 D5               push de
  14+ 6914 C5               push bc
  15+ 6915
  16+ 6915                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout (Y < 24 o Y >= 152)
  17+ 6915 78               ld   a, b
  18+ 6916 FE 18            cp   24
  19+ 6918 38 4E            jr   c, .not_solid
  20+ 691A FE 98            cp   152
  21+ 691C 30 4A            jr   nc, .not_solid
  22+ 691E
  23+ 691E                  ; 2. Calcola riga di layout: r = (Y - 24) / 8
  24+ 691E D6 18            sub  24
  25+ 6920 CB 3F            srl  a
  26+ 6922 CB 3F            srl  a
  27+ 6924 CB 3F            srl  a                 ; A = r (0..15)
  28+ 6926
  29+ 6926                  ; 3. HL = r * 8
  30+ 6926 6F               ld   l, a
  31+ 6927 26 00            ld   h, 0
  32+ 6929 29               add  hl, hl
  33+ 692A 29               add  hl, hl
  34+ 692B 29               add  hl, hl            ; HL = r * 8
  35+ 692C
  36+ 692C                  ; 4. Calcola colonna di layout: c = X / 8 (in C)
  37+ 692C 79               ld   a, c
  38+ 692D CB 3F            srl  a
  39+ 692F CB 3F            srl  a
  40+ 6931 CB 3F            srl  a                 ; A = c (0..31)
  41+ 6933 4F               ld   c, a              ; C = c (salva colonna)
  42+ 6934
  43+ 6934                  ; HL = r * 8 + c / 4
  44+ 6934 CB 3F            srl  a
  45+ 6936 CB 3F            srl  a                 ; A = c / 4
  46+ 6938 85               add  a, l
  47+ 6939 6F               ld   l, a              ; HL = r * 8 + c / 4
  48+ 693A
  49+ 693A ED 5B BB 6E      ld   de, (room_ptr)
  50+ 693E 19               add  hl, de            ; HL = layout byte address
  51+ 693F 7E               ld   a, (hl)           ; A = layout byte
  52+ 6940
  53+ 6940                  ; Estrai il bit-pair corrispondente a c % 4
  54+ 6940 57               ld   d, a              ; D = layout byte
  55+ 6941 79               ld   a, c
  56+ 6942 E6 03            and  3                 ; A = c % 4
  57+ 6944 28 15            jr   z, .shift_0
  58+ 6946 3D               dec  a
  59+ 6947 28 0B            jr   z, .shift_1
  60+ 6949 3D               dec  a
  61+ 694A 28 03            jr   z, .shift_2
  62+ 694C                  ; Case 3 (c % 4 = 3)
  63+ 694C 7A               ld   a, d
  64+ 694D 18 0F            jr   .got_type
  65+ 694F              .shift_2:
  66+ 694F 7A               ld   a, d
  67+ 6950 0F               rrca
  68+ 6951 0F               rrca
  69+ 6952 18 0A            jr   .got_type
  70+ 6954              .shift_1:
  71+ 6954 7A               ld   a, d
  72+ 6955 0F               rrca
  73+ 6956 0F               rrca
  74+ 6957 0F               rrca
  75+ 6958 0F               rrca
  76+ 6959 18 03            jr   .got_type
  77+ 695B              .shift_0:
  78+ 695B 7A               ld   a, d
  79+ 695C 07               rlca
  80+ 695D 07               rlca
  81+ 695E              .got_type:
  82+ 695E E6 03            and  3                 ; A = cell type (0..3)
  83+ 6960
  84+ 6960                  ; 5. Controlla se è solida: Floor (1) o Wall (2)
  85+ 6960 FE 01            cp   1
  86+ 6962 28 09            jr   z, .solid
  87+ 6964 FE 02            cp   2
  88+ 6966 28 05            jr   z, .solid
  89+ 6968
  90+ 6968              .not_solid:
  91+ 6968 C1               pop  bc
  92+ 6969 D1               pop  de
  93+ 696A E1               pop  hl
  94+ 696B B7               or   a                 ; Clear carry
  95+ 696C C9               ret
  96+ 696D
  97+ 696D              .solid:
  98+ 696D C1               pop  bc
  99+ 696E D1               pop  de
 100+ 696F E1               pop  hl
 101+ 6970 37               scf                    ; Set carry
 102+ 6971 C9               ret
 103+ 6972
 104+ 6972              ; -------------------------------------------------------------------
 105+ 6972              ; Applica gravità e gestisce salto
 106+ 6972              ; -------------------------------------------------------------------
 107+ 6972              ApplyGravity:
 108+ 6972 ED 4B A8 6D      ld  bc, (PlayerPos)
 109+ 6976 78               ld  a, b              ; B = PlayerY (pixel)
 110+ 6977
 111+ 6977                  ; Controlla se siamo a mezz'aria (on_ground == 0)
 112+ 6977 3A B5 6D         ld  a, (on_ground)
 113+ 697A B7               or  a
 114+ 697B CA B4 69         jp  z, .in_air        ; Se siamo in volo, continua a volare
 115+ 697E
 116+ 697E                  ; Se on_ground == 1, controlliamo se siamo ancora su terreno solido
 117+ 697E                  ; Dobbiamo controllare i pixel direttamente sotto i piedi del player:
 118+ 697E                  ; (PlayerX, PlayerY + 16) e (PlayerX + 7, PlayerY + 16)
 119+ 697E 78               ld  a, b
 120+ 697F C6 10            add  a, 16
 121+ 6981 47               ld  b, a              ; B = PlayerY + 16
 122+ 6982
 123+ 6982                  ; Controlla se la cella sotto il piede sinistro (PlayerX, PlayerY + 16) è solida
 124+ 6982 CD 12 69         call CheckSolidCell
 125+ 6985 38 13            jr   c, .still_on_ground
 126+ 6987
 127+ 6987                  ; Controlla se la cella sotto il piede destro (PlayerX + 7, PlayerY + 16) è solida
 128+ 6987 79               ld   a, c
 129+ 6988 C6 07            add  a, 7
 130+ 698A 4F               ld   c, a              ; C = PlayerX + 7
 131+ 698B CD 12 69         call CheckSolidCell
 132+ 698E 38 0A            jr   c, .still_on_ground
 133+ 6990
 134+ 6990                  ; Se nessuna delle due è solida, iniziamo a cadere!
 135+ 6990 AF               xor  a
 136+ 6991 32 B5 6D         ld   (on_ground), a
 137+ 6994 32 B4 6D         ld   (velocity_y), a   ; Inizia la caduta con velocità 0
 138+ 6997 C3 B4 69         jp   .in_air
 139+ 699A
 140+ 699A              .still_on_ground:
 141+ 699A                  ; Siamo ancora sulla piattaforma o sul pavimento
 142+ 699A                  ; Ripristina bc originale (PlayerPos)
 143+ 699A ED 4B A8 6D      ld   bc, (PlayerPos)
 144+ 699E
 145+ 699E                  ; Gestisci il salto
 146+ 699E 3A B6 6D         ld   a, (jump_pressed)
 147+ 69A1 B7               or   a
 148+ 69A2 CA 3F 6A         jp   z, .end
 149+ 69A5
 150+ 69A5 3E 0C            ld   a, JUMP_STRENGTH
 151+ 69A7 32 B4 6D         ld   (velocity_y), a
 152+ 69AA AF               xor  a
 153+ 69AB 32 B5 6D         ld   (on_ground), a
 154+ 69AE 32 B6 6D         ld   (jump_pressed), a
 155+ 69B1 C3 B4 69         jp   .in_air
