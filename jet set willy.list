 189+ 8216
 190+ 8216
 191+ 8216              ; -------------------------------------------------------------------
 192+ 8216              ; DetermineCurrentRoomID
 193+ 8216              ;
 194+ 8216              ; Determina l'ID numerico della stanza corrente confrontando
 195+ 8216              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 196+ 8216              ;
 197+ 8216              ; Se viene trovata una corrispondenza:
 198+ 8216              ;   A = ID della stanza
 199+ 8216              ;   current_room = A
 200+ 8216              ;
 201+ 8216              ; Mappatura:
 202+ 8216              ;    0 = The Off Licence
 203+ 8216              ;    1 = The Bridge
 204+ 8216              ;    2 = Under The Mega Tree
 205+ 8216              ;    3 = Gfx_At The Foot Of The Mega Tree
 206+ 8216              ;    4 = The Drive
 207+ 8216              ;    5 = The Security Guard
 208+ 8216              ;    6 = Entrance To Hades
 209+ 8216              ;    7 = Cuckoo's Nest
 210+ 8216              ;    8 = Inside The Mega Trunk
 211+ 8216              ;    9 = On A Branch Over The Drive
 212+ 8216              ;   10 = The Front Door
 213+ 8216              ;   11 = The Hall
 214+ 8216              ;   12 = Tree Top
 215+ 8216              ;   27 = The Chapel
 216+ 8216              ;   28 = First Landing
 217+ 8216              ;   29 = The Nightmare Room
 218+ 8216              ;   33 = The Bathroom
 219+ 8216              ;   35 = Master Bedroom
 220+ 8216              ;
 221+ 8216              ; Se nessuna stanza corrisponde viene impostato:
 222+ 8216              ;   current_room = 0
 223+ 8216              ; -------------------------------------------------------------------
 224+ 8216              DetermineCurrentRoomID:
 225+ 8216
