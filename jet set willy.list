 206  8979 21 8D 5C         ld   hl, ATTR_P
 207  897C 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 208  897D CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 209  8980 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 210  8982 3E 07            ld   a, $07
 211  8984 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
