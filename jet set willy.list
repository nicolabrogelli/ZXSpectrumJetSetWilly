 641  8CF9 CB 5F            bit  3, a
 642  8CFB 28 0B            jr   z, .quit_chosen
 643  8CFD
 644  8CFD                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 645  8CFD 01 FE BF         ld   bc, $bffe
 646  8D00 ED 78            in   a, (c)
 647  8D02 CB 47            bit  0, a
 648  8D04 28 02            jr   z, .quit_chosen
 649  8D06
