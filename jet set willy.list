 565+ 775A
 566+ 775A              .set_room:
 567+ 775A
 568+ 775A                  ; Salva l'ID della stanza corrente
 569+ 775A 32 5D 7D         ld   (current_room), a
 570+ 775D
 571+ 775D                  ; Ripristina i registri
 572+ 775D D1               pop  de
