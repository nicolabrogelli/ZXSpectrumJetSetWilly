   6+ 6AD4              ; MovePlayer
   7+ 6AD4              ;
   8+ 6AD4              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6AD4              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6AD4              ; con i muri.
  11+ 6AD4              ;
  12+ 6AD4              ; Input:
  13+ 6AD4              ;   D = stato dei controlli (bitfield)
  14+ 6AD4              ;
  15+ 6AD4              ; Strutture utilizzate:
  16+ 6AD4              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6AD4              ;   player_speed    -> velocità orizzontale
  18+ 6AD4              ;   flags           -> flag di stato input
  19+ 6AD4              ;
  20+ 6AD4              ; Bit controlli:
  21+ 6AD4              ;   bit 0 = sinistra
  22+ 6AD4              ;   bit 1 = destra
  23+ 6AD4              ;
  24+ 6AD4              ; Nota:
  25+ 6AD4              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6AD4              ;   ignorato per tutta la durata del salto.
  27+ 6AD4              ;
  28+ 6AD4              ; Output:
  29+ 6AD4              ;   aggiorna PlayerPos e body_state
  30+ 6AD4              ; -------------------------------------------------------------------
  31+ 6AD4              MovePlayer:
  32+ 6AD4
  33+ 6AD4                  ; ---------------------------------------------------------------
  34+ 6AD4                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6AD4                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6AD4                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6AD4                  ; ---------------------------------------------------------------
  38+ 6AD4 3A 8E EA         ld   a, (on_ground)
  39+ 6AD7 B7               or   a
  40+ 6AD8 20 1A            jr   nz, .on_ground_check
  41+ 6ADA
  42+ 6ADA 3A 93 EA         ld   a, (jump_dir)
  43+ 6ADD B7               or   a
  44+ 6ADE C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6ADF
  46+ 6ADF                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6ADF DD 21 87 EA      ld   ix, flags
  48+ 6AE3 DD CB 00 86      res  $00, (ix)
  49+ 6AE7
  50+ 6AE7 ED 4B 7F EA      ld   bc, (PlayerPos)
