 861+ 7F9B              Enemy_Update:
 862+ 7F9B E5               push hl
 863+ 7F9C D5               push de
 864+ 7F9D C5               push bc
 865+ 7F9E DD E5            push ix
 866+ 7FA0
 867+ 7FA0                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 868+ 7FA0 3A 64 F8         ld   a, (enemy_update_rate)
 869+ 7FA3 FE 01            cp   1
 870+ 7FA5 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 871+ 7FA7
 872+ 7FA7 3A 65 F8         ld   a, (enemy_update_timer)
 873+ 7FAA 3C               inc  a
 874+ 7FAB 47               ld   b, a                      ; B = timer + 1
 875+ 7FAC 3A 64 F8         ld   a, (enemy_update_rate)
 876+ 7FAF B8               cp   b
 877+ 7FB0 28 0C            jr   z, .reset_timer
 878+ 7FB2 38 0A            jr   c, .reset_timer
 879+ 7FB4
 880+ 7FB4                  ; Salva contatore incrementato e salta l'aggiornamento
