 279+ 6B5F              ; Output:
 280+ 6B5F              ;   PlayerPos     = posizione iniziale (Y, X)
 281+ 6B5F              ;   PlayerPosOld  = copia della posizione iniziale
 282+ 6B5F              ;
 283+ 6B5F              ; Struttura dati stanza:
 284+ 6B5F              ;   OFFSET_POS_WILLY:
 285+ 6B5F              ;       +0 = X
 286+ 6B5F              ;       +1 = Y
