  99+ 7467              ; DetermineCurrentRoomID
 100+ 7467              ;
 101+ 7467              ; Determina l'ID numerico della stanza corrente confrontando
 102+ 7467              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 103+ 7467              ;
 104+ 7467              ; Se viene trovata una corrispondenza:
 105+ 7467              ;   A = ID della stanza
 106+ 7467              ;   current_room = A
 107+ 7467              ;
 108+ 7467              ; Mappatura:
 109+ 7467              ;    0 = The Off Licence
 110+ 7467              ;    1 = The Bridge
 111+ 7467              ;    2 = Under The Mega Tree
 112+ 7467              ;    3 = Gfx_At The Foot Of The Mega Tree
 113+ 7467              ;    4 = The Drive
 114+ 7467              ;    5 = The Security Guard
 115+ 7467              ;    6 = Entrance To Hades
 116+ 7467              ;    7 = Cuckoo's Nest
 117+ 7467              ;    8 = Inside The Mega Trunk
 118+ 7467              ;    9 = On A Branch Over The Drive
 119+ 7467              ;   10 = The Front Door
 120+ 7467              ;   11 = The Hall
 121+ 7467              ;   12 = Tree Top
 122+ 7467              ;   33 = The Bathroom
 123+ 7467              ;   35 = Master Bedroom
 124+ 7467              ;
 125+ 7467              ; Se nessuna stanza corrisponde viene impostato:
 126+ 7467              ;   current_room = 0
 127+ 7467              ; -------------------------------------------------------------------
