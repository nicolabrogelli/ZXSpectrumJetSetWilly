 423  8384                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 424  8384 CD 8C 62         call Gfx_UpdateTimeDisplay
 425  8387
 426  8387                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 427  8387 3A 38 EA         ld   a, (game_objective_completed)
 428  838A B7               or   a
 429  838B C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 430  838C
 431  838C                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 432  838C 3A 35 EA         ld   a, (time_period)
 433  838F B7               or   a
 434  8390 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 435  8391
 436  8391 3A 33 EA         ld   a, (time_hours)
 437  8394 FE 0C            cp   12
 438  8396 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
 439  8398 C9               ret
 440  8399
 441  8399              .time_limit_reached:
 442  8399                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
 443  8399                  ; Scatena immediatamente il Game Over temporale!
 444  8399 C3 BA 82         jp   TriggerGameOver
