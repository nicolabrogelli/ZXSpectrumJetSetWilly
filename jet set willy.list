  23+ 730E 00
  24+ 730F 02 17 07 03      db 2, 23, 7, 3, 0               ; Oggetto 7 alla colonna X=20, riga Y=7 (Stato: 0=attivo)
  24+ 7313 00
  25+ 7314 02 16 07 06      db 2, 22, 7, 6, 0               ; Oggetto 8 alla colonna X=10, riga Y=7
  25+ 7318 00
  26+ 7319 02 15 07 05      db 2, 21, 7, 5, 0               ; Oggetto 9 alla colonna X=20, riga Y=7 (Stato: 0=attivo)
