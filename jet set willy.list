1148+ 6FC8              ; -------------------------------------------------------------------
1149+ 6FC8              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
1150+ 6FC8              ; Input: C = X, B = Y
1151+ 6FC8              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
1152+ 6FC8              ; -------------------------------------------------------------------
1153+ 6FC8              CheckWallCell:
1154+ 6FC8 E5               push hl
1155+ 6FC9 D5               push de
1156+ 6FCA C5               push bc
1157+ 6FCB
1158+ 6FCB                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1159+ 6FCB 78               ld   a, b
1160+ 6FCC FE 80            cp   128
1161+ 6FCE 30 1F            jr   nc, .not_wall
1162+ 6FD0
1163+ 6FD0                  ; 2. Calcola riga di layout: r = Y / 8
1164+ 6FD0 CB 3F            srl  a
1165+ 6FD2 CB 3F            srl  a
1166+ 6FD4 CB 3F            srl  a                 ; A = r (0..15)
1167+ 6FD6
1168+ 6FD6                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1169+ 6FD6 5F               ld   e, a              ; E = r (Row)
1170+ 6FD7 79               ld   a, c
1171+ 6FD8 CB 3F            srl  a
1172+ 6FDA CB 3F            srl  a
1173+ 6FDC CB 3F            srl  a                 ; A = c (0..31)
1174+ 6FDE 4F               ld   c, a              ; C = c (Col)
1175+ 6FDF
1176+ 6FDF                  ; Se la cella è sulla rampa, non considerarla un muro!
1177+ 6FDF 53               ld   d, e              ; D = Row
1178+ 6FE0 59               ld   e, c              ; E = Col
1179+ 6FE1 CD 4D 6F         call IsCellOnRamp
1180+ 6FE4 38 09            jr   c, .not_wall
1181+ 6FE6
1182+ 6FE6 7A               ld   a, d              ; A = Row
1183+ 6FE7 4B               ld   c, e              ; C = Col
1184+ 6FE8 CD 48 70         call GetCellFromUnpacked ; A = cell type
1185+ 6FEB
1186+ 6FEB                  ; Controlla se è Wall (2)
1187+ 6FEB FE 02            cp   2
1188+ 6FED 28 05            jr   z, .is_wall
1189+ 6FEF
1190+ 6FEF              .not_wall:
