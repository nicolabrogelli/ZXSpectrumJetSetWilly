 234+ 5EAF                  ; --- Controlla Conveyor ---
 235+ 5EAF 3A 5C 7E         ld   a, (conveyor_len)
 236+ 5EB2 B7               or   a
 237+ 5EB3 CA DB 5E         jp   z, .check_ramp
 238+ 5EB6
 239+ 5EB6 3A 5D 7E         ld   a, (conveyor_row)
 240+ 5EB9 BB               cp   e
 241+ 5EBA C2 DB 5E         jp   nz, .check_ramp
 242+ 5EBD
 243+ 5EBD 3A 5E 7E         ld   a, (conveyor_col)
 244+ 5EC0 B9               cp   c
 245+ 5EC1 CA D5 5E         jp   z, .is_conveyor
 246+ 5EC4 DA CA 5E         jp   c, .c_greater
 247+ 5EC7 C3 DB 5E         jp   .check_ramp
 248+ 5ECA              .c_greater:
 249+ 5ECA 21 5C 7E         ld   hl, conveyor_len
 250+ 5ECD 86               add  a, (hl)
 251+ 5ECE B9               cp   c
 252+ 5ECF CA DB 5E         jp   z, .check_ramp
 253+ 5ED2 DA DB 5E         jp   c, .check_ramp
 254+ 5ED5              .is_conveyor:
 255+ 5ED5 21 CD 00         ld   hl, OFFSET_CONVEYOR
 256+ 5ED8 C3 2E 5F         jp   .load_tile
 257+ 5EDB
 258+ 5EDB              .check_ramp:
 259+ 5EDB 3A 60 7E         ld   a, (ramp_len)
 260+ 5EDE B7               or   a
 261+ 5EDF CA 0F 5F         jp   z, .normal_grid
 262+ 5EE2
 263+ 5EE2 3A 61 7E         ld   a, (ramp_row)     ; A = RampRowStart
 264+ 5EE5 BB               cp   e                 ; compare with player row E
 265+ 5EE6 DA 0F 5F         jp   c, .normal_grid   ; if RampRowStart < E, skip!
 266+ 5EE9
 267+ 5EE9 93               sub  e                 ; A = RampRowStart - E
 268+ 5EEA 47               ld   b, a              ; B = distance from start row (0..ramp_len-1)
 269+ 5EEB 3A 60 7E         ld   a, (ramp_len)
 270+ 5EEE B8               cp   b
 271+ 5EEF CA 0F 5F         jp   z, .normal_grid   ; if B == ramp_len, too high!
 272+ 5EF2 DA 0F 5F         jp   c, .normal_grid   ; if B > ramp_len, too high!
 273+ 5EF5
 274+ 5EF5                  ; Calcola ExpectedCol:
