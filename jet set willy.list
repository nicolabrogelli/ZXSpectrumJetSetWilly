 853+ 7F90              ; -------------------------------------------------------------------
 854+ 7F90              Enemy_Update:
 855+ 7F90 E5               push hl
 856+ 7F91 D5               push de
 857+ 7F92 C5               push bc
 858+ 7F93 DD E5            push ix
 859+ 7F95
 860+ 7F95                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 861+ 7F95 3A C7 F7         ld   a, (enemy_update_rate)
 862+ 7F98 FE 01            cp   1
 863+ 7F9A 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 864+ 7F9C
 865+ 7F9C 3A C8 F7         ld   a, (enemy_update_timer)
 866+ 7F9F 3C               inc  a
 867+ 7FA0 47               ld   b, a                      ; B = timer + 1
 868+ 7FA1 3A C7 F7         ld   a, (enemy_update_rate)
 869+ 7FA4 B8               cp   b
 870+ 7FA5 28 0C            jr   z, .reset_timer
 871+ 7FA7 38 0A            jr   c, .reset_timer
 872+ 7FA9
 873+ 7FA9                  ; Salva contatore incrementato e salta l'aggiornamento
 874+ 7FA9 78               ld   a, b
 875+ 7FAA 32 C8 F7         ld   (enemy_update_timer), a
 876+ 7FAD
 877+ 7FAD              .skip_update:
