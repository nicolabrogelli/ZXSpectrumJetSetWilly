  47  7D42 CD 5F 60         call PrintRoomName
  48  7D45 CD 9B 6B         call DrawRoomItems
  49  7D48 CD 00 68         call LoadRoomEnemies
  50  7D4B CD B9 64         call LoadPositionPlayeinRoom
  51  7D4E
  52  7D4E                  ; Leggi il colore del bordo dalla stanza corrente e impostalo
  53  7D4E 2A 14 7D         ld   hl, (room_ptr)
  54  7D51 11 DE 00         ld   de, OFFSET_BORDER_COLOR
  55  7D54 19               add  hl, de
  56  7D55 7E               ld   a, (hl)
  57  7D56 32 B3 79         ld   (room_border_color), a
  58  7D59 D3 FE            out  ($fe), a          ; Imposta colore bordo hardware
  59  7D5B
  60  7D5B                  ; Aggiorna BORDCR per far sì che la ROM usi lo stesso colore
  61  7D5B 87               add  a, a
  62  7D5C 87               add  a, a
  63  7D5D 87               add  a, a              ; Sposta nei bit 3-5
  64  7D5E 47               ld   b, a
  65  7D5F 3A 48 5C         ld   a, (BORDCR)
  66  7D62 E6 C7            and  $c7               ; Pulisce vecchi bit del bordo
  67  7D64 B0               or   b                 ; Imposta nuovo colore bordo
  68  7D65 F6 07            or   $07               ; Imposta ink a bianco
  69  7D67 32 48 5C         ld   (BORDCR), a
  70  7D6A
  71  7D6A CD F3 5F         call PrintPlayer
  72  7D6D
  73  7D6D              Main_loop:
  74  7D6D 76               halt
  75  7D6E
  76  7D6E                  ; 1. Cancella e disegna i personaggi (back-to-back per minimizzare il flickering)
  77  7D6E CD 46 60         call DeleteCharAtOldPos
  78  7D71 CD F3 5F         call PrintPlayer
  79  7D74
  80  7D74 CD 86 68         call EraseRoomEnemies
  81  7D77 CD BA 68         call DrawRoomEnemies
  82  7D7A
  83  7D7A                  ; 3. Salva le posizioni correnti del player per il prossimo frame
  84  7D7A ED 4B A7 79      ld   bc, (PlayerPos)
  85  7D7E ED 43 A9 79      ld   (PlayerPosOld), bc
  86  7D82
  87  7D82                  ; 4. Aggiorna le posizioni dei personaggi per il prossimo frame
  88  7D82 CD CB 64         call CheckCtrl
  89  7D85 CD 46 64         call MovePlayer
  90  7D88 CD 5D 65         call ApplyGravity
  91  7D8B CD EA 66         call ApplyConveyorForce
  92  7D8E CD E5 69         call UpdateRoomEnemies
  93  7D91 CD C2 6C         call CheckRoomItemsCollision
  94  7D94
  95  7D94                  ; 5. Gestisci la collisione (disegna le raster bar se collide)
  96  7D94 CD 3E 66         call CheckCollision
  97  7D97 30 1A            jr   nc, .no_collision
  98  7D99
  99  7D99                  ; Collisione attiva: disegna le raster bar nel bordo
 100  7D99 3A B8 79         ld   a, (counter)
 101  7D9C E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 102  7D9E 06 1E            ld   b, 30             ; Numero di righe della barra raster
 103  7DA0              .raster_loop:
 104  7DA0 D3 FE            out  ($fe), a
 105  7DA2 3C               inc  a
 106  7DA3 E6 07            and  7
 107  7DA5 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 108  7DA7              .delay:
 109  7DA7 0D               dec  c
 110  7DA8 20 FD            jr   nz, .delay
 111  7DAA 10 F4            djnz .raster_loop
 112  7DAC
 113  7DAC                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 114  7DAC 3A B3 79         ld   a, (room_border_color)
 115  7DAF D3 FE            out  ($fe), a
 116  7DB1 18 05            jr   .no_collision_change
 117  7DB3
 118  7DB3              .no_collision:
 119  7DB3                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 120  7DB3 3A B3 79         ld   a, (room_border_color)
 121  7DB6 D3 FE            out  ($fe), a
 122  7DB8
 123  7DB8              .no_collision_change:
 124  7DB8 C3 6D 7D         jp   Main_loop
