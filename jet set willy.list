 236+ 6C87 C9               ret
 237+ 6C88
 238+ 6C88              ; -------------------------------------------------------------------
 239+ 6C88              ; DrawRoomItems
 240+ 6C88              ;
 241+ 6C88              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 242+ 6C88              ;
 243+ 6C88              ; Operazioni eseguite:
 244+ 6C88              ;   1. Azzera la griglia items_grid.
 245+ 6C88              ;   2. Svuota la cache degli oggetti attivi.
 246+ 6C88              ;   3. Scansiona ItemsTable.
 247+ 6C88              ;   4. Per ogni item della stanza corrente:
 248+ 6C88              ;        - verifica se è già stato raccolto
 249+ 6C88              ;        - disegna la grafica
 250+ 6C88              ;        - aggiorna items_grid
 251+ 6C88              ;        - memorizza l'item nella cache current_room_items
 252+ 6C88              ;   5. Aggiorna num_room_items.
 253+ 6C88              ;
 254+ 6C88              ; Record ItemsTable:
 255+ 6C88              ;   +0  Room ID
 256+ 6C88              ;   +1  X (colonna)
 257+ 6C88              ;   +2  Y (riga)
 258+ 6C88              ;   +3  Colore
 259+ 6C88              ;   +4  Collected flag
 260+ 6C88              ;
 261+ 6C88              ; Cache current_room_items:
 262+ 6C88              ;   +0  Colonna
 263+ 6C88              ;   +1  Riga
 264+ 6C88              ;   +2  Colore
 265+ 6C88              ;   +3  Collected flag ptr (Low)
 266+ 6C88              ;   +4  Collected flag ptr (High)
 267+ 6C88              ;
 268+ 6C88              ; Ogni record cache occupa 5 byte.
 269+ 6C88              ; -------------------------------------------------------------------
 270+ 6C88              DrawRoomItems:
 271+ 6C88
 272+ 6C88                  ; Salva tutti i registri utilizzati
 273+ 6C88 E5               push hl
 274+ 6C89 D5               push de
 275+ 6C8A C5               push bc
 276+ 6C8B DD E5            push ix
 277+ 6C8D FD E5            push iy
 278+ 6C8F
 279+ 6C8F                  ; ---------------------------------------------------------------
 280+ 6C8F                  ; Azzera items_grid (32 x 16 = 512 byte)
 281+ 6C8F                  ; ---------------------------------------------------------------
 282+ 6C8F 21 00 90         ld   hl, items_grid
 283+ 6C92 11 01 90         ld   de, items_grid + 1
 284+ 6C95 36 00            ld   (hl), 0
 285+ 6C97 01 FF 01         ld   bc, 511
 286+ 6C9A ED B0            ldir
 287+ 6C9C
 288+ 6C9C                  ; ---------------------------------------------------------------
 289+ 6C9C                  ; Nessun item attivo nella stanza
 290+ 6C9C                  ; ---------------------------------------------------------------
 291+ 6C9C AF               xor  a
 292+ 6C9D 32 19 7E         ld   (num_room_items), a
 293+ 6CA0
 294+ 6CA0                  ; IY punta alla cache degli item attivi
 295+ 6CA0 FD 21 C9 7D      ld   iy, current_room_items
 296+ 6CA4
 297+ 6CA4                  ; ---------------------------------------------------------------
 298+ 6CA4                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 299+ 6CA4                  ; alla stanza corrente.
 300+ 6CA4                  ;
 301+ 6CA4                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 302+ 6CA4                  ; ---------------------------------------------------------------
 303+ 6CA4 2A 1A 7E         ld   hl, (room_ptr)
 304+ 6CA7 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 305+ 6CAA 19               add  hl, de
 306+ 6CAB
 307+ 6CAB E5               push hl
 308+ 6CAC DD E1            pop  ix                ; IX = bitmap item
 309+ 6CAE
 310+ 6CAE                  ; ---------------------------------------------------------------
 311+ 6CAE                  ; Inizio scansione della tabella degli item
 312+ 6CAE                  ; ---------------------------------------------------------------
 313+ 6CAE 21 9C 6B         ld   hl, ItemsTable
 314+ 6CB1
 315+ 6CB1              .loop:
 316+ 6CB1
 317+ 6CB1                  ; ---------------------------------------------------------------
 318+ 6CB1                  ; Legge il Room ID del record corrente
 319+ 6CB1                  ; ---------------------------------------------------------------
 320+ 6CB1 7E               ld   a, (hl)
 321+ 6CB2
 322+ 6CB2                  ; $FF indica fine tabella
 323+ 6CB2 FE FF            cp   $FF
 324+ 6CB4 28 53            jr   z, .done
 325+ 6CB6
 326+ 6CB6                  ; ---------------------------------------------------------------
 327+ 6CB6                  ; Verifica se l'item appartiene alla stanza corrente
 328+ 6CB6                  ; ---------------------------------------------------------------
 329+ 6CB6 57               ld   d, a
 330+ 6CB7
 331+ 6CB7 3A C0 7D         ld   a, (current_room)
 332+ 6CBA BA               cp   d
 333+ 6CBB 20 45            jr   nz, .next_item
 334+ 6CBD
 335+ 6CBD                  ; ---------------------------------------------------------------
 336+ 6CBD                  ; Legge i dati dell'item
 337+ 6CBD                  ; ---------------------------------------------------------------
 338+ 6CBD
 339+ 6CBD 23               inc  hl
 340+ 6CBE 4E               ld   c, (hl)           ; X (colonna)
 341+ 6CBF
 342+ 6CBF 23               inc  hl
 343+ 6CC0 46               ld   b, (hl)           ; Y (riga)
 344+ 6CC1
 345+ 6CC1 23               inc  hl
 346+ 6CC2 5E               ld   e, (hl)           ; Colore
 347+ 6CC3
 348+ 6CC3 23               inc  hl
 349+ 6CC4 7E               ld   a, (hl)           ; Collected flag
 350+ 6CC5
 351+ 6CC5                  ; Se diverso da zero l'item è già stato raccolto
 352+ 6CC5 B7               or   a
 353+ 6CC6 20 3E            jr   nz, .next_no_inc
 354+ 6CC8
 355+ 6CC8                  ; ---------------------------------------------------------------
 356+ 6CC8                  ; Disegna l'item sullo schermo
 357+ 6CC8                  ;
 358+ 6CC8                  ; B = Row
 359+ 6CC8                  ; C = Column
 360+ 6CC8                  ; HL = bitmap pointer
 361+ 6CC8                  ; E = Color
 362+ 6CC8                  ; ---------------------------------------------------------------
 363+ 6CC8 E5               push hl
 364+ 6CC9
 365+ 6CC9 DD E5            push ix
 366+ 6CCB E1               pop  hl
 367+ 6CCC
 368+ 6CCC CD 11 6D         call DrawItemGraphic
 369+ 6CCF
 370+ 6CCF E1               pop  hl                ; ritorna al flag collected
 371+ 6CD0
 372+ 6CD0                  ; ---------------------------------------------------------------
 373+ 6CD0                  ; Aggiorna items_grid
 374+ 6CD0                  ;
 375+ 6CD0                  ; Calcolo:
 376+ 6CD0                  ;   offset = Row * 32 + Col
 377+ 6CD0                  ; ---------------------------------------------------------------
 378+ 6CD0 E5               push hl
 379+ 6CD1 D5               push de
 380+ 6CD2
 381+ 6CD2 26 00            ld   h, 0
 382+ 6CD4 68               ld   l, b              ; HL = Row
 383+ 6CD5
 384+ 6CD5 29               add  hl, hl            ; *2
 385+ 6CD6 29               add  hl, hl            ; *4
 386+ 6CD7 29               add  hl, hl            ; *8
 387+ 6CD8 29               add  hl, hl            ; *16
 388+ 6CD9 29               add  hl, hl            ; *32
 389+ 6CDA
 390+ 6CDA 16 00            ld   d, 0
 391+ 6CDC 59               ld   e, c              ; DE = Col
 392+ 6CDD
 393+ 6CDD 19               add  hl, de            ; Row*32 + Col
 394+ 6CDE
 395+ 6CDE 11 00 90         ld   de, items_grid
 396+ 6CE1 19               add  hl, de            ; puntatore nella griglia
 397+ 6CE2
 398+ 6CE2 D1               pop  de                ; ripristina colore
 399+ 6CE3
 400+ 6CE3 73               ld   (hl), e           ; salva colore cella
 401+ 6CE4
 402+ 6CE4 E1               pop  hl
 403+ 6CE5
 404+ 6CE5                  ; ---------------------------------------------------------------
 405+ 6CE5                  ; Salva l'item nella cache della stanza
 406+ 6CE5                  ;
 407+ 6CE5                  ; Questo evita di dover scansionare tutta ItemsTable
 408+ 6CE5                  ; durante il controllo delle collisioni.
 409+ 6CE5                  ; ---------------------------------------------------------------
 410+ 6CE5
 411+ 6CE5 FD 71 00         ld   (iy+0), c         ; Colonna
 412+ 6CE8 FD 70 01         ld   (iy+1), b         ; Riga
 413+ 6CEB FD 73 02         ld   (iy+2), e         ; Colore
 414+ 6CEE
 415+ 6CEE                  ; Salva il puntatore al flag "collected"
 416+ 6CEE FD 75 03         ld   (iy+3), l         ; Low byte
 417+ 6CF1 FD 74 04         ld   (iy+4), h         ; High byte
 418+ 6CF4
 419+ 6CF4                  ; Passa al record successivo della cache
 420+ 6CF4 01 05 00         ld   bc, 5
 421+ 6CF7 FD 09            add  iy, bc
 422+ 6CF9
 423+ 6CF9                  ; Incrementa il numero di item attivi
 424+ 6CF9 3A 19 7E         ld   a, (num_room_items)
 425+ 6CFC 3C               inc  a
 426+ 6CFD 32 19 7E         ld   (num_room_items), a
 427+ 6D00
 428+ 6D00 18 04            jr   .next_no_inc
 429+ 6D02
 430+ 6D02              .next_item:
 431+ 6D02
 432+ 6D02                  ; ---------------------------------------------------------------
 433+ 6D02                  ; L'item non appartiene alla stanza corrente.
 434+ 6D02                  ; Salta i campi del record:
 435+ 6D02                  ;   X
 436+ 6D02                  ;   Y
 437+ 6D02                  ;   Color
 438+ 6D02                  ;   Collected
 439+ 6D02                  ; ---------------------------------------------------------------
 440+ 6D02 23               inc  hl
 441+ 6D03 23               inc  hl
 442+ 6D04 23               inc  hl
 443+ 6D05 23               inc  hl
 444+ 6D06
 445+ 6D06              .next_no_inc:
 446+ 6D06
 447+ 6D06                  ; ---------------------------------------------------------------
 448+ 6D06                  ; Avanza al record successivo
 449+ 6D06                  ; (prossimo Room ID)
 450+ 6D06                  ; ---------------------------------------------------------------
 451+ 6D06 23               inc  hl
 452+ 6D07 18 A8            jr   .loop
 453+ 6D09
 454+ 6D09              .done:
 455+ 6D09
 456+ 6D09                  ; Ripristina i registri
 457+ 6D09 FD E1            pop  iy
 458+ 6D0B DD E1            pop  ix
 459+ 6D0D D1               pop  de
 460+ 6D0E C1               pop  bc
 461+ 6D0F E1               pop  hl
 462+ 6D10
 463+ 6D10 C9               ret
 464+ 6D11
 465+ 6D11              ; -------------------------------------------------------------------
 466+ 6D11              ; DrawItemGraphic
 467+ 6D11              ;
 468+ 6D11              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 469+ 6D11              ; utilizzando una bitmap di 8 byte e un attributo colore.
 470+ 6D11              ;
 471+ 6D11              ; Input:
 472+ 6D11              ;   B = Riga attributi (3..18)
 473+ 6D11              ;   C = Colonna attributi (0..31)
 474+ 6D11              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 475+ 6D11              ;   E = Attributo colore
 476+ 6D11              ;
 477+ 6D11              ; Output:
 478+ 6D11              ;   Nessuno
 479+ 6D11              ;
 480+ 6D11              ; Registri preservati:
 481+ 6D11              ;   BC, DE, HL
 482+ 6D11              ; -------------------------------------------------------------------
 483+ 6D11              DrawItemGraphic:
 484+ 6D11
 485+ 6D11                  ; Salva i registri originali
 486+ 6D11 C5               push bc
 487+ 6D12 D5               push de
 488+ 6D13 E5               push hl
 489+ 6D14
 490+ 6D14                  ; ---------------------------------------------------------------
 491+ 6D14                  ; Calcolo indirizzo bitmap dello Spectrum
 492+ 6D14                  ;
 493+ 6D14                  ; Ogni item occupa una cella attributi (8x8 pixel).
 494+ 6D14                  ;
 495+ 6D14                  ; Formula:
 496+ 6D14                  ;   High = $40 + (Row AND $18)
 497+ 6D14                  ;   Low  = (Row AND 7) * 32 + Col
 498+ 6D14                  ;
 499+ 6D14                  ; DE conterrà l'indirizzo della prima scanline.
 500+ 6D14                  ; ---------------------------------------------------------------
 501+ 6D14
 502+ 6D14 78               ld   a, b
 503+ 6D15 E6 18            and  $18
 504+ 6D17 C6 40            add  a, $40
 505+ 6D19 57               ld   d, a              ; Byte alto indirizzo video
 506+ 6D1A
 507+ 6D1A 78               ld   a, b
 508+ 6D1B E6 07            and  7                 ; Riga interna al blocco da 8
 509+ 6D1D
 510+ 6D1D 87               add  a, a              ; *2
 511+ 6D1E 87               add  a, a              ; *4
 512+ 6D1F 87               add  a, a              ; *8
 513+ 6D20 87               add  a, a              ; *16
 514+ 6D21 87               add  a, a              ; *32
 515+ 6D22
 516+ 6D22 81               add  a, c              ; + colonna
 517+ 6D23
 518+ 6D23 5F               ld   e, a              ; Byte basso indirizzo video
 519+ 6D24
 520+ 6D24                  ; ---------------------------------------------------------------
 521+ 6D24                  ; Disegno bitmap
 522+ 6D24                  ;
 523+ 6D24                  ; Copia 8 byte consecutivi nella memoria video.
 524+ 6D24                  ; Ogni byte rappresenta una scanline da 8 pixel.
 525+ 6D24                  ; ---------------------------------------------------------------
 526+ 6D24
 527+ 6D24 C5               push bc                ; Conserva Row e Col
 528+ 6D25
 529+ 6D25 06 08            ld   b, 8              ; Numero scanline
 530+ 6D27
 531+ 6D27              .line_loop:
 532+ 6D27
 533+ 6D27 7E               ld   a, (hl)           ; Legge scanline bitmap
 534+ 6D28 12               ld   (de), a           ; Scrive nella memoria video
 535+ 6D29
 536+ 6D29 14               inc  d                 ; Scanline successiva
 537+ 6D2A 23               inc  hl                ; Byte bitmap successivo
 538+ 6D2B
 539+ 6D2B 05               dec  b
 540+ 6D2C 20 F9            jr   nz, .line_loop
 541+ 6D2E
 542+ 6D2E C1               pop  bc                ; Ripristina Row e Col
 543+ 6D2F
 544+ 6D2F                  ; ---------------------------------------------------------------
 545+ 6D2F                  ; Calcolo indirizzo attributo
 546+ 6D2F                  ;
 547+ 6D2F                  ; Formula:
 548+ 6D2F                  ;   AttrAddr = $5800 + Row * 32 + Col
 549+ 6D2F                  ;
 550+ 6D2F                  ; HL conterrà l'indirizzo della cella attributi.
 551+ 6D2F                  ; ---------------------------------------------------------------
 552+ 6D2F
 553+ 6D2F 26 00            ld   h, 0
 554+ 6D31 68               ld   l, b              ; HL = Row
 555+ 6D32
 556+ 6D32 29               add  hl, hl            ; *2
 557+ 6D33 29               add  hl, hl            ; *4
 558+ 6D34 29               add  hl, hl            ; *8
 559+ 6D35 29               add  hl, hl            ; *16
 560+ 6D36 29               add  hl, hl            ; *32
 561+ 6D37
 562+ 6D37 79               ld   a, c              ; A = Colonna
 563+ 6D38
 564+ 6D38 85               add  a, l
 565+ 6D39 6F               ld   l, a
 566+ 6D3A
 567+ 6D3A 30 01            jr   nc, .no_carry
 568+ 6D3C 24               inc  h
 569+ 6D3D
 570+ 6D3D              .no_carry:
 571+ 6D3D
 572+ 6D3D                  ; HL = Row * 32 + Col
 573+ 6D3D
 574+ 6D3D 11 00 58         ld   de, $5800
 575+ 6D40 19               add  hl, de            ; HL = indirizzo attributi
 576+ 6D41
 577+ 6D41                  ; ---------------------------------------------------------------
 578+ 6D41                  ; Recupera il colore originale dallo stack.
 579+ 6D41                  ;
 580+ 6D41                  ; Layout stack:
 581+ 6D41                  ;   HL originale
 582+ 6D41                  ;   DE originale (E = colore)
 583+ 6D41                  ;   BC originale
 584+ 6D41                  ; ---------------------------------------------------------------
 585+ 6D41
 586+ 6D41 C1               pop  bc                ; Recupera HL originale
 587+ 6D42 D1               pop  de                ; Recupera DE originale
 588+ 6D43
 589+ 6D43                  ; ---------------------------------------------------------------
 590+ 6D43                  ; Scrive l'attributo colore
 591+ 6D43                  ; ---------------------------------------------------------------
 592+ 6D43
 593+ 6D43 7B               ld   a, e              ; A = colore
 594+ 6D44 77               ld   (hl), a           ; Scrive nella RAM attributi
 595+ 6D45
 596+ 6D45                  ; ---------------------------------------------------------------
 597+ 6D45                  ; Ripristina HL e BC originali
 598+ 6D45                  ; ---------------------------------------------------------------
 599+ 6D45
 600+ 6D45 C5               push bc
 601+ 6D46 E1               pop  hl                ; HL originale
 602+ 6D47
 603+ 6D47 C1               pop  bc                ; BC originale
 604+ 6D48
 605+ 6D48 C9               ret
 606+ 6D49
 607+ 6D49              ; -------------------------------------------------------------------
 608+ 6D49              ; RestoreBackgroundCell
 609+ 6D49              ;
 610+ 6D49              ; Ripristina il contenuto originale di una cella della stanza.
 611+ 6D49              ; Viene utilizzata principalmente quando un item viene raccolto:
 612+ 6D49              ; invece di lasciare un "buco", la routine ridisegna il tile
 613+ 6D49              ; originale presente nella mappa della stanza.
 614+ 6D49              ;
 615+ 6D49              ; Input:
 616+ 6D49              ;   B = Row (3..18)
 617+ 6D49              ;   C = Col (0..31)
 618+ 6D49              ;
 619+ 6D49              ; Utilizza:
 620+ 6D49              ;   room_ptr -> struttura dati della stanza corrente
 621+ 6D49              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 622+ 6D49              ;   DrawTile -> ridisegna il tile selezionato
 623+ 6D49              ;
 624+ 6D49              ; Tipi di cella:
 625+ 6D49              ;   0 = Background
 626+ 6D49              ;   1 = Floor
 627+ 6D49              ;   2 = Wall
 628+ 6D49              ;   3 = Nasty
 629+ 6D49              ; -------------------------------------------------------------------
 630+ 6D49              RestoreBackgroundCell:
 631+ 6D49
 632+ 6D49                  ; Salva tutti i registri utilizzati
 633+ 6D49 FD E5            push iy
 634+ 6D4B C5               push bc
 635+ 6D4C D5               push de
 636+ 6D4D E5               push hl
 637+ 6D4E DD E5            push ix
 638+ 6D50
 639+ 6D50                  ; ---------------------------------------------------------------
 640+ 6D50                  ; Conserva Row e Col in IY.
 641+ 6D50                  ;
 642+ 6D50                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 643+ 6D50                  ; BC potrebbe essere modificato.
 644+ 6D50                  ; ---------------------------------------------------------------
 645+ 6D50 C5               push bc
 646+ 6D51 FD E1            pop  iy                ; IYH = Row, IYL = Col
 647+ 6D53
 648+ 6D53                  ; ---------------------------------------------------------------
 649+ 6D53                  ; Determina quale tipo di cella è presente nella posizione
 650+ 6D53                  ; specificata.
 651+ 6D53                  ;
 652+ 6D53                  ; Input:
 653+ 6D53                  ;   B = Row
 654+ 6D53                  ;   C = Col
 655+ 6D53                  ;
 656+ 6D53                  ; Output:
 657+ 6D53                  ;   A = tipo cella
 658+ 6D53                  ; ---------------------------------------------------------------
 659+ 6D53 78               ld   a, b
 660+ 6D54
 661+ 6D54 CD 8B 68         call GetCellFromUnpacked
 662+ 6D57
 663+ 6D57                  ; ---------------------------------------------------------------
 664+ 6D57                  ; Recupera il puntatore alla stanza corrente.
 665+ 6D57                  ;
 666+ 6D57                  ; DE = base della struttura stanza
 667+ 6D57                  ; ---------------------------------------------------------------
 668+ 6D57 ED 5B 1A 7E      ld   de, (room_ptr)
 669+ 6D5B
 670+ 6D5B                  ; ---------------------------------------------------------------
 671+ 6D5B                  ; Seleziona il tile corretto in base al tipo di cella.
 672+ 6D5B                  ;
 673+ 6D5B                  ; A = 0 -> Background
 674+ 6D5B                  ; A = 1 -> Floor
 675+ 6D5B                  ; A = 2 -> Wall
 676+ 6D5B                  ; A = 3 -> Nasty
 677+ 6D5B                  ; ---------------------------------------------------------------
 678+ 6D5B
 679+ 6D5B B7               or   a
 680+ 6D5C 20 06            jr   nz, .not_bg
 681+ 6D5E
 682+ 6D5E                  ; Background
 683+ 6D5E 21 A0 00         ld   hl, OFFSET_BG
 684+ 6D61 19               add  hl, de
 685+ 6D62 18 16            jr   .draw_cell
 686+ 6D64
 687+ 6D64              .not_bg:
 688+ 6D64
 689+ 6D64 3D               dec  a
 690+ 6D65 20 06            jr   nz, .not_floor
 691+ 6D67
 692+ 6D67                  ; Floor
 693+ 6D67 21 A9 00         ld   hl, OFFSET_FLOOR
 694+ 6D6A 19               add  hl, de
 695+ 6D6B 18 0D            jr   .draw_cell
 696+ 6D6D
 697+ 6D6D              .not_floor:
 698+ 6D6D
 699+ 6D6D 3D               dec  a
 700+ 6D6E 20 06            jr   nz, .not_wall
 701+ 6D70
 702+ 6D70                  ; Wall
 703+ 6D70 21 B2 00         ld   hl, OFFSET_WALL
 704+ 6D73 19               add  hl, de
 705+ 6D74 18 04            jr   .draw_cell
 706+ 6D76
 707+ 6D76              .not_wall:
 708+ 6D76
 709+ 6D76                  ; Nasty
 710+ 6D76 21 BB 00         ld   hl, OFFSET_NASTY
 711+ 6D79 19               add  hl, de
 712+ 6D7A
 713+ 6D7A              .draw_cell:
 714+ 6D7A
 715+ 6D7A                  ; ---------------------------------------------------------------
 716+ 6D7A                  ; HL punta ora alla grafica del tile da ridisegnare.
 717+ 6D7A                  ;
 718+ 6D7A                  ; DrawTile si aspetta:
 719+ 6D7A                  ;   IX = puntatore tile
 720+ 6D7A                  ;   B  = Row
 721+ 6D7A                  ;   C  = Col
 722+ 6D7A                  ; ---------------------------------------------------------------
 723+ 6D7A E5               push hl
 724+ 6D7B DD E1            pop  ix
 725+ 6D7D
 726+ 6D7D                  ; Ripristina Row e Col salvati in IY
 727+ 6D7D FD E5            push iy
 728+ 6D7F C1               pop  bc
 729+ 6D80
 730+ 6D80                  ; Disegna il tile originale
 731+ 6D80 CD 8C 61         call DrawTile
 732+ 6D83
 733+ 6D83                  ; ---------------------------------------------------------------
 734+ 6D83                  ; Ripristina i registri salvati
 735+ 6D83                  ; ---------------------------------------------------------------
 736+ 6D83 DD E1            pop  ix
 737+ 6D85 E1               pop  hl
 738+ 6D86 D1               pop  de
 739+ 6D87 C1               pop  bc
 740+ 6D88 FD E1            pop  iy
 741+ 6D8A
 742+ 6D8A C9               ret
 743+ 6D8B
 744+ 6D8B              ; -------------------------------------------------------------------
 745+ 6D8B              ; CheckWillyItemCollision
 746+ 6D8B              ;
 747+ 6D8B              ; Verifica se Willy collide con un item utilizzando il controllo
 748+ 6D8B              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 749+ 6D8B              ;
 750+ 6D8B              ; Input:
 751+ 6D8B              ;   A = ItemX (colonna attributi 0..31)
 752+ 6D8B              ;   H = ItemY (riga attributi 3..18)
 753+ 6D8B              ;
 754+ 6D8B              ; Coordinate item:
 755+ 6D8B              ;   Ogni item occupa una cella da 8x8 pixel.
 756+ 6D8B              ;
 757+ 6D8B              ; Coordinate Willy:
 758+ 6D8B              ;   Willy occupa un rettangolo di 16x16 pixel.
 759+ 6D8B              ;
 760+ 6D8B              ; Output:
 761+ 6D8B              ;   Carry Set   = collisione rilevata
 762+ 6D8B              ;   Carry Clear = nessuna collisione
 763+ 6D8B              ;
 764+ 6D8B              ; Registri preservati:
 765+ 6D8B              ;   BC, DE, HL
 766+ 6D8B              ; -------------------------------------------------------------------
 767+ 6D8B              CheckWillyItemCollision:
 768+ 6D8B
 769+ 6D8B                  ; Salva i registri utilizzati
 770+ 6D8B C5               push bc
 771+ 6D8C D5               push de
 772+ 6D8D E5               push hl
 773+ 6D8E
 774+ 6D8E                  ; ---------------------------------------------------------------
 775+ 6D8E                  ; Calcola il bounding box orizzontale dell'item
 776+ 6D8E                  ;
 777+ 6D8E                  ; ItemLeft  = ItemX * 8
 778+ 6D8E                  ; ItemRight = ItemLeft + 7
 779+ 6D8E                  ;
 780+ 6D8E                  ; E = ItemLeft
 781+ 6D8E                  ; D = ItemRight
 782+ 6D8E                  ; ---------------------------------------------------------------
 783+ 6D8E 6F               ld   l, a              ; L = ItemX
 784+ 6D8F
 785+ 6D8F 7D               ld   a, l
 786+ 6D90 87               add  a, a              ; *2
 787+ 6D91 87               add  a, a              ; *4
 788+ 6D92 87               add  a, a              ; *8
 789+ 6D93
 790+ 6D93 5F               ld   e, a              ; E = ItemLeft
 791+ 6D94
 792+ 6D94 C6 07            add  a, 7
 793+ 6D96 57               ld   d, a              ; D = ItemRight
 794+ 6D97
 795+ 6D97                  ; ---------------------------------------------------------------
 796+ 6D97                  ; Recupera la posizione corrente di Willy
 797+ 6D97                  ;
 798+ 6D97                  ; B = WillyY
 799+ 6D97                  ; C = WillyX
 800+ 6D97                  ; ---------------------------------------------------------------
 801+ 6D97 ED 4B AC 7A      ld   bc, (PlayerPos)
 802+ 6D9B
 803+ 6D9B                  ; ---------------------------------------------------------------
 804+ 6D9B                  ; Primo test:
 805+ 6D9B                  ;
 806+ 6D9B                  ; WillyLeft <= ItemRight
 807+ 6D9B                  ;
 808+ 6D9B                  ; Se Willy è completamente a destra dell'item
 809+ 6D9B                  ; non può esserci collisione.
 810+ 6D9B                  ; ---------------------------------------------------------------
 811+ 6D9B 79               ld   a, c              ; A = WillyLeft
 812+ 6D9C
 813+ 6D9C BA               cp   d                 ; WillyLeft vs ItemRight
 814+ 6D9D
 815+ 6D9D 28 04            jr   z, .x_ok
 816+ 6D9F 38 02            jr   c, .x_ok
 817+ 6DA1
 818+ 6DA1 18 29            jr   .no_collision
 819+ 6DA3
 820+ 6DA3              .x_ok:
 821+ 6DA3
 822+ 6DA3                  ; ---------------------------------------------------------------
 823+ 6DA3                  ; Secondo test:
 824+ 6DA3                  ;
 825+ 6DA3                  ; WillyRight >= ItemLeft
 826+ 6DA3                  ;
 827+ 6DA3                  ; WillyRight = WillyX + 7
 828+ 6DA3                  ; ---------------------------------------------------------------
 829+ 6DA3 C6 07            add  a, 7
 830+ 6DA5
 831+ 6DA5 BB               cp   e                 ; WillyRight vs ItemLeft
 832+ 6DA6
 833+ 6DA6 28 04            jr   z, .y_check
 834+ 6DA8 30 02            jr   nc, .y_check
 835+ 6DAA
 836+ 6DAA 18 20            jr   .no_collision
 837+ 6DAC
 838+ 6DAC              .y_check:
 839+ 6DAC
 840+ 6DAC                  ; ---------------------------------------------------------------
 841+ 6DAC                  ; Recupera ItemY dal valore originale di HL
 842+ 6DAC                  ;
 843+ 6DAC                  ; H contiene la riga dell'item.
 844+ 6DAC                  ; ---------------------------------------------------------------
 845+ 6DAC E1               pop  hl
 846+ 6DAD E5               push hl
 847+ 6DAE
 848+ 6DAE                  ; ---------------------------------------------------------------
 849+ 6DAE                  ; Calcola il bounding box verticale dell'item
 850+ 6DAE                  ;
 851+ 6DAE                  ; ItemTop    = ItemY * 8
 852+ 6DAE                  ; ItemBottom = ItemTop + 7
 853+ 6DAE                  ;
 854+ 6DAE                  ; E = ItemTop
 855+ 6DAE                  ; D = ItemBottom
 856+ 6DAE                  ; ---------------------------------------------------------------
 857+ 6DAE 7C               ld   a, h
 858+ 6DAF
 859+ 6DAF 87               add  a, a              ; *2
 860+ 6DB0 87               add  a, a              ; *4
 861+ 6DB1 87               add  a, a              ; *8
 862+ 6DB2
 863+ 6DB2 5F               ld   e, a              ; ItemTop
 864+ 6DB3
 865+ 6DB3 C6 07            add  a, 7
 866+ 6DB5 57               ld   d, a              ; ItemBottom
 867+ 6DB6
 868+ 6DB6                  ; ---------------------------------------------------------------
 869+ 6DB6                  ; Primo test verticale:
 870+ 6DB6                  ;
 871+ 6DB6                  ; WillyTop <= ItemBottom
 872+ 6DB6                  ; ---------------------------------------------------------------
 873+ 6DB6 78               ld   a, b              ; WillyTop
 874+ 6DB7
 875+ 6DB7 BA               cp   d
 876+ 6DB8
 877+ 6DB8 28 04            jr   z, .y_ok
 878+ 6DBA 38 02            jr   c, .y_ok
 879+ 6DBC
 880+ 6DBC 18 0E            jr   .no_collision
 881+ 6DBE
 882+ 6DBE              .y_ok:
 883+ 6DBE
 884+ 6DBE                  ; ---------------------------------------------------------------
 885+ 6DBE                  ; Secondo test verticale:
 886+ 6DBE                  ;
 887+ 6DBE                  ; WillyBottom >= ItemTop
 888+ 6DBE                  ;
 889+ 6DBE                  ; WillyBottom = WillyY + 15
 890+ 6DBE                  ; ---------------------------------------------------------------
 891+ 6DBE C6 0F            add  a, 15
 892+ 6DC0
 893+ 6DC0 BB               cp   e
 894+ 6DC1
 895+ 6DC1 28 04            jr   z, .collision
 896+ 6DC3 30 02            jr   nc, .collision
 897+ 6DC5
 898+ 6DC5 18 05            jr   .no_collision
 899+ 6DC7
 900+ 6DC7              .collision:
 901+ 6DC7
 902+ 6DC7                  ; ---------------------------------------------------------------
 903+ 6DC7                  ; Collisione rilevata
 904+ 6DC7                  ; ---------------------------------------------------------------
 905+ 6DC7 E1               pop  hl
 906+ 6DC8 D1               pop  de
 907+ 6DC9 C1               pop  bc
 908+ 6DCA
 909+ 6DCA 37               scf                    ; Carry = 1
 910+ 6DCB
 911+ 6DCB C9               ret
 912+ 6DCC
 913+ 6DCC              .no_collision:
 914+ 6DCC
 915+ 6DCC                  ; ---------------------------------------------------------------
 916+ 6DCC                  ; Nessuna collisione
 917+ 6DCC                  ; ---------------------------------------------------------------
 918+ 6DCC E1               pop  hl
 919+ 6DCD D1               pop  de
 920+ 6DCE C1               pop  bc
 921+ 6DCF
 922+ 6DCF B7               or   a                 ; Carry = 0
 923+ 6DD0
 924+ 6DD0 C9               ret
 925+ 6DD1
 926+ 6DD1              ; -------------------------------------------------------------------
 927+ 6DD1              ; CheckRoomItemsCollision
 928+ 6DD1              ;
 929+ 6DD1              ; Controlla se Willy entra in collisione con uno degli item
 930+ 6DD1              ; attivi presenti nella stanza corrente.
 931+ 6DD1              ;
 932+ 6DD1              ; Per ogni item:
 933+ 6DD1              ;   - verifica che appartenga alla stanza corrente
 934+ 6DD1              ;   - verifica che non sia già stato raccolto
 935+ 6DD1              ;   - esegue il test di collisione con Willy
 936+ 6DD1              ;
 937+ 6DD1              ; Se l'item viene raccolto:
 938+ 6DD1              ;   - imposta il flag "collected"
 939+ 6DD1              ;   - rimuove l'item dalla cache items_grid
 940+ 6DD1              ;   - incrementa il contatore degli oggetti raccolti
 941+ 6DD1              ;   - aggiorna l'HUD
 942+ 6DD1              ;   - ripristina il tile di sfondo
 943+ 6DD1              ;   - riproduce il suono di raccolta
 944+ 6DD1              ;
 945+ 6DD1              ; Formato record ItemsTable:
 946+ 6DD1              ;   +0 RoomID
 947+ 6DD1              ;   +1 X
 948+ 6DD1              ;   +2 Y
 949+ 6DD1              ;   +3 Color
 950+ 6DD1              ;   +4 Collected
 951+ 6DD1              ;
 952+ 6DD1              ; Fine tabella:
 953+ 6DD1              ;   RoomID = $FF
 954+ 6DD1              ; -------------------------------------------------------------------
 955+ 6DD1              CheckRoomItemsCollision:
 956+ 6DD1
 957+ 6DD1                  ; Salva i registri utilizzati
 958+ 6DD1 E5               push hl
 959+ 6DD2 D5               push de
 960+ 6DD3 C5               push bc
 961+ 6DD4
 962+ 6DD4                  ; Inizio scansione della tabella degli item
 963+ 6DD4 21 9C 6B         ld   hl, ItemsTable
 964+ 6DD7
 965+ 6DD7              .loop:
 966+ 6DD7
 967+ 6DD7                  ; ---------------------------------------------------------------
 968+ 6DD7                  ; Legge il Room ID dell'item corrente
 969+ 6DD7                  ; ---------------------------------------------------------------
 970+ 6DD7 7E               ld   a, (hl)
 971+ 6DD8
 972+ 6DD8                  ; $FF indica fine tabella
 973+ 6DD8 FE FF            cp   $FF
 974+ 6DDA 28 4D            jr   z, .done
 975+ 6DDC
 976+ 6DDC                  ; ---------------------------------------------------------------
 977+ 6DDC                  ; Verifica se l'item appartiene alla stanza corrente
 978+ 6DDC                  ; ---------------------------------------------------------------
 979+ 6DDC 57               ld   d, a              ; D = RoomID item
 980+ 6DDD
 981+ 6DDD 3A C0 7D         ld   a, (current_room)
 982+ 6DE0 BA               cp   d
 983+ 6DE1
 984+ 6DE1                  ; Se appartiene a un'altra stanza salta il record
 985+ 6DE1 20 3F            jr   nz, .next_item
 986+ 6DE3
 987+ 6DE3                  ; ---------------------------------------------------------------
 988+ 6DE3                  ; Legge coordinate e stato dell'item
 989+ 6DE3                  ; ---------------------------------------------------------------
 990+ 6DE3
 991+ 6DE3 23               inc  hl
 992+ 6DE4 4E               ld   c, (hl)           ; C = X
 993+ 6DE5
 994+ 6DE5 23               inc  hl
 995+ 6DE6 46               ld   b, (hl)           ; B = Y
 996+ 6DE7
 997+ 6DE7 23               inc  hl                ; salta Color
 998+ 6DE8
 999+ 6DE8 23               inc  hl                ; punta a Collected
1000+ 6DE9
1001+ 6DE9 7E               ld   a, (hl)
1002+ 6DEA
1003+ 6DEA                  ; ---------------------------------------------------------------
1004+ 6DEA                  ; Item già raccolto?
1005+ 6DEA                  ; ---------------------------------------------------------------
1006+ 6DEA B7               or   a
1007+ 6DEB 20 39            jr   nz, .next_no_inc
1008+ 6DED
1009+ 6DED                  ; ---------------------------------------------------------------
1010+ 6DED                  ; Test collisione Willy ↔ Item
1011+ 6DED                  ;
1012+ 6DED                  ; Input richiesto:
1013+ 6DED                  ;   A = ItemX
1014+ 6DED                  ;   H = ItemY
1015+ 6DED                  ; ---------------------------------------------------------------
1016+ 6DED 79               ld   a, c
1017+ 6DEE
1018+ 6DEE E5               push hl                ; salva puntatore al flag Collected
1019+ 6DEF
1020+ 6DEF 60               ld   h, b
1021+ 6DF0
1022+ 6DF0 CD 8B 6D         call CheckWillyItemCollision
1023+ 6DF3
1024+ 6DF3 E1               pop  hl
1025+ 6DF4
1026+ 6DF4                  ; Nessuna collisione
1027+ 6DF4 30 30            jr   nc, .next_no_inc
1028+ 6DF6
1029+ 6DF6                  ; ===============================================================
1030+ 6DF6                  ; ITEM RACCOLTO
1031+ 6DF6                  ; ===============================================================
1032+ 6DF6
1033+ 6DF6                  ; ---------------------------------------------------------------
1034+ 6DF6                  ; Marca l'item come raccolto
1035+ 6DF6                  ; ---------------------------------------------------------------
1036+ 6DF6 36 01            ld   (hl), 1
1037+ 6DF8
1038+ 6DF8                  ; ---------------------------------------------------------------
1039+ 6DF8                  ; Rimuove l'item dalla cache items_grid
1040+ 6DF8                  ;
1041+ 6DF8                  ; Calcolo:
1042+ 6DF8                  ;   offset = Row * 32 + Col
1043+ 6DF8                  ; ---------------------------------------------------------------
1044+ 6DF8 E5               push hl
1045+ 6DF9 D5               push de
1046+ 6DFA
1047+ 6DFA 26 00            ld   h, 0
1048+ 6DFC 68               ld   l, b              ; HL = Row
1049+ 6DFD
1050+ 6DFD 29               add  hl, hl            ; *2
1051+ 6DFE 29               add  hl, hl            ; *4
1052+ 6DFF 29               add  hl, hl            ; *8
1053+ 6E00 29               add  hl, hl            ; *16
1054+ 6E01 29               add  hl, hl            ; *32
1055+ 6E02
1056+ 6E02 59               ld   e, c
1057+ 6E03 16 00            ld   d, 0
1058+ 6E05
1059+ 6E05 19               add  hl, de            ; Row*32 + Col
1060+ 6E06
1061+ 6E06 11 00 90         ld   de, items_grid
1062+ 6E09 19               add  hl, de
1063+ 6E0A
1064+ 6E0A                  ; La cella non contiene più un item
1065+ 6E0A 36 00            ld   (hl), 0
1066+ 6E0C
1067+ 6E0C D1               pop  de
1068+ 6E0D E1               pop  hl
1069+ 6E0E
1070+ 6E0E                  ; ---------------------------------------------------------------
1071+ 6E0E                  ; Conserva il puntatore all'entry corrente
1072+ 6E0E                  ; poiché le routine successive possono alterare HL.
1073+ 6E0E                  ; ---------------------------------------------------------------
1074+ 6E0E E5               push hl
1075+ 6E0F
1076+ 6E0F                  ; ---------------------------------------------------------------
1077+ 6E0F                  ; Aggiorna il numero di oggetti raccolti
1078+ 6E0F                  ; ---------------------------------------------------------------
1079+ 6E0F 3A B6 7A         ld   a, (items_collected)
1080+ 6E12
1081+ 6E12 3C               inc  a
1082+ 6E13
1083+ 6E13 32 B6 7A         ld   (items_collected), a
1084+ 6E16
1085+ 6E16                  ; ---------------------------------------------------------------
1086+ 6E16                  ; Aggiorna il contatore visualizzato a schermo
1087+ 6E16                  ; ---------------------------------------------------------------
1088+ 6E16 CD CB 60         call UpdateItemsCollectedDisplay
1089+ 6E19
1090+ 6E19                  ; ---------------------------------------------------------------
1091+ 6E19                  ; Ripristina il tile originale della stanza
1092+ 6E19                  ; eliminando la grafica dell'item.
1093+ 6E19                  ;
1094+ 6E19                  ; Input:
1095+ 6E19                  ;   B = Row
1096+ 6E19                  ;   C = Col
1097+ 6E19                  ; ---------------------------------------------------------------
1098+ 6E19 CD 49 6D         call RestoreBackgroundCell
1099+ 6E1C
1100+ 6E1C                  ; ---------------------------------------------------------------
1101+ 6E1C                  ; Riproduce il suono di raccolta
1102+ 6E1C                  ; ---------------------------------------------------------------
1103+ 6E1C CD 2D 6E         call PlayCollectSound
1104+ 6E1F
1105+ 6E1F                  ; Ripristina il puntatore alla tabella
1106+ 6E1F E1               pop  hl
1107+ 6E20
1108+ 6E20                  ; Continua con il record successivo
1109+ 6E20 18 04            jr   .next_no_inc
1110+ 6E22
1111+ 6E22              .next_item:
1112+ 6E22
1113+ 6E22                  ; ---------------------------------------------------------------
1114+ 6E22                  ; Salta i campi del record:
1115+ 6E22                  ;   X
1116+ 6E22                  ;   Y
1117+ 6E22                  ;   Color
1118+ 6E22                  ;   Collected
1119+ 6E22                  ; ---------------------------------------------------------------
1120+ 6E22 23               inc  hl
1121+ 6E23 23               inc  hl
1122+ 6E24 23               inc  hl
1123+ 6E25 23               inc  hl
1124+ 6E26
1125+ 6E26              .next_no_inc:
1126+ 6E26
1127+ 6E26                  ; ---------------------------------------------------------------
1128+ 6E26                  ; Avanza al record successivo.
1129+ 6E26                  ;
1130+ 6E26                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1131+ 6E26                  ; ---------------------------------------------------------------
1132+ 6E26 23               inc  hl
1133+ 6E27
1134+ 6E27 18 AE            jr   .loop
1135+ 6E29
1136+ 6E29              .done:
1137+ 6E29
1138+ 6E29                  ; Ripristina i registri
1139+ 6E29 C1               pop  bc
1140+ 6E2A D1               pop  de
1141+ 6E2B E1               pop  hl
1142+ 6E2C
1143+ 6E2C C9               ret
1144+ 6E2D
1145+ 6E2D              ; -------------------------------------------------------------------
1146+ 6E2D              ; PlayCollectSound
1147+ 6E2D              ;
1148+ 6E2D              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1149+ 6E2D              ; dello ZX Spectrum utilizzando il port $FE.
1150+ 6E2D              ;
1151+ 6E2D              ; Il suono viene prodotto alternando ON/OFF del bit 4
1152+ 6E2D              ; (speaker) con un semplice delay software.
1153+ 6E2D              ;
1154+ 6E2D              ; Effetto risultante:
1155+ 6E2D              ;   beep breve tipo "pickup item"
1156+ 6E2D              ; -------------------------------------------------------------------
1157+ 6E2D              PlayCollectSound:
1158+ 6E2D
1159+ 6E2D                  ; Salva registri utilizzati
1160+ 6E2D C5               push bc
1161+ 6E2E D5               push de
1162+ 6E2F
1163+ 6E2F                  ; ---------------------------------------------------------------
1164+ 6E2F                  ; Numero di cicli del beep (durata complessiva del suono)
1165+ 6E2F                  ; ---------------------------------------------------------------
1166+ 6E2F 06 78            ld   b, 120
1167+ 6E31
1168+ 6E31              .sound_loop:
1169+ 6E31
1170+ 6E31                  ; ---------------------------------------------------------------
1171+ 6E31                  ; SPEAKER ON
1172+ 6E31                  ;
1173+ 6E31                  ; Legge il colore del bordo corrente e attiva il bit 4
1174+ 6E31                  ; per pilotare lo speaker.
1175+ 6E31                  ; ---------------------------------------------------------------
1176+ 6E31 3A B8 7A         ld   a, (room_border_color)
1177+ 6E34 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1178+ 6E36
1179+ 6E36 D3 FE            out  ($fe), a         ; scrive sul port ULA
1180+ 6E38
1181+ 6E38                  ; ---------------------------------------------------------------
1182+ 6E38                  ; Delay (mezzo periodo)
1183+ 6E38                  ; Loop software a consumo CPU
1184+ 6E38                  ; ---------------------------------------------------------------
1185+ 6E38 0E 3C            ld   c, 60
1186+ 6E3A
1187+ 6E3A              .d1:
1188+ 6E3A 0D               dec  c
1189+ 6E3B 20 FD            jr   nz, .d1
1190+ 6E3D
1191+ 6E3D                  ; ---------------------------------------------------------------
1192+ 6E3D                  ; SPEAKER OFF
1193+ 6E3D                  ;
1194+ 6E3D                  ; Mantiene il colore del bordo ma disattiva lo speaker
1195+ 6E3D                  ; ---------------------------------------------------------------
1196+ 6E3D 3A B8 7A         ld   a, (room_border_color)
1197+ 6E40 E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1198+ 6E42
1199+ 6E42 D3 FE            out  ($fe), a
1200+ 6E44
1201+ 6E44                  ; ---------------------------------------------------------------
1202+ 6E44                  ; Secondo delay (mezzo periodo)
1203+ 6E44                  ; Completa l’onda quadra
1204+ 6E44                  ; ---------------------------------------------------------------
1205+ 6E44 0E 3C            ld   c, 60
1206+ 6E46
1207+ 6E46              .d2:
1208+ 6E46 0D               dec  c
1209+ 6E47 20 FD            jr   nz, .d2
1210+ 6E49
1211+ 6E49                  ; ---------------------------------------------------------------
1212+ 6E49                  ; Ripete fino a completare il numero di cicli
1213+ 6E49                  ; ---------------------------------------------------------------
1214+ 6E49 10 E6            djnz .sound_loop
1215+ 6E4B
1216+ 6E4B                  ; Ripristina registri salvati
1217+ 6E4B D1               pop  de
1218+ 6E4C C1               pop  bc
1219+ 6E4D
1220+ 6E4D C9               ret
1221+ 6E4E
1222+ 6E4E              ; -------------------------------------------------------------------
1223+ 6E4E              ; CheckActiveItemAtCell
1224+ 6E4E              ;
1225+ 6E4E              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1226+ 6E4E              ; nella cella specificata della griglia items_grid.
1227+ 6E4E              ;
1228+ 6E4E              ; Questa routine usa una lookup diretta su una mappa 32x16,
1229+ 6E4E              ; evitando la scansione della ItemsTable.
1230+ 6E4E              ;
1231+ 6E4E              ; Input:
1232+ 6E4E              ;   B = Colonna (0..31)
1233+ 6E4E              ;   C = Riga (0..15)
1234+ 6E4E              ;
1235+ 6E4E              ; Output:
1236+ 6E4E              ;   Carry Set   = item presente nella cella
1237+ 6E4E              ;   Carry Clear = nessun item
1238+ 6E4E              ;
1239+ 6E4E              ; Nota:
1240+ 6E4E              ;   HL NON è restituito valido (commento originale non corretto:
1241+ 6E4E              ;   la routine non punta a ItemsTable).
1242+ 6E4E              ; -------------------------------------------------------------------
1243+ 6E4E              CheckActiveItemAtCell:
1244+ 6E4E
1245+ 6E4E                  ; Salva registri usati
1246+ 6E4E D5               push de
1247+ 6E4F E5               push hl
1248+ 6E50
1249+ 6E50                  ; ---------------------------------------------------------------
1250+ 6E50                  ; Calcolo indice lineare nella griglia 32x16:
1251+ 6E50                  ;
1252+ 6E50                  ; offset = Row * 32 + Col
1253+ 6E50                  ; ---------------------------------------------------------------
1254+ 6E50 26 00            ld   h, 0
1255+ 6E52 69               ld   l, c              ; HL = Row
1256+ 6E53
1257+ 6E53 29               add  hl, hl            ; *2
1258+ 6E54 29               add  hl, hl            ; *4
1259+ 6E55 29               add  hl, hl            ; *8
1260+ 6E56 29               add  hl, hl            ; *16
1261+ 6E57 29               add  hl, hl            ; *32
1262+ 6E58
1263+ 6E58                  ; Aggiunge la colonna
1264+ 6E58 58               ld   e, b
