1750+ 7AF5              ; -------------------------------------------------------------------
1751+ 7AF5              ; CheckActiveItemAtCell
1752+ 7AF5              ;
1753+ 7AF5              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1754+ 7AF5              ; nella cella specificata della griglia items_grid.
1755+ 7AF5              ;
1756+ 7AF5              ; Questa routine usa una lookup diretta su una mappa 32x16,
1757+ 7AF5              ; evitando la scansione della ItemsTable.
1758+ 7AF5              ;
1759+ 7AF5              ; Input:
1760+ 7AF5              ;   B = Colonna (0..31)
1761+ 7AF5              ;   C = Riga (0..15)
1762+ 7AF5              ;
1763+ 7AF5              ; Output:
1764+ 7AF5              ;   Carry Set   = item presente nella cella
1765+ 7AF5              ;   Carry Clear = nessun item
1766+ 7AF5              ;
1767+ 7AF5              ; Nota:
1768+ 7AF5              ;   HL NON è restituito valido (commento originale non corretto:
1769+ 7AF5              ;   la routine non punta a ItemsTable).
1770+ 7AF5              ; -------------------------------------------------------------------
1771+ 7AF5              CheckActiveItemAtCell:
1772+ 7AF5
1773+ 7AF5                  ; Salva registri usati
1774+ 7AF5 D5               push de
1775+ 7AF6 E5               push hl
1776+ 7AF7
1777+ 7AF7                  ; ---------------------------------------------------------------
1778+ 7AF7                  ; Calcolo indice lineare nella griglia 32x16:
1779+ 7AF7                  ;
1780+ 7AF7                  ; offset = Row * 32 + Col
1781+ 7AF7                  ; ---------------------------------------------------------------
1782+ 7AF7 26 00            ld   h, 0
1783+ 7AF9 69               ld   l, c              ; HL = Row
1784+ 7AFA
1785+ 7AFA 29               add  hl, hl            ; *2
1786+ 7AFB 29               add  hl, hl            ; *4
1787+ 7AFC 29               add  hl, hl            ; *8
1788+ 7AFD 29               add  hl, hl            ; *16
1789+ 7AFE 29               add  hl, hl            ; *32
1790+ 7AFF
1791+ 7AFF                  ; Aggiunge la colonna
1792+ 7AFF 58               ld   e, b
1793+ 7B00 16 00            ld   d, 0
1794+ 7B02 19               add  hl, de            ; HL = Row*32 + Col
1795+ 7B03
1796+ 7B03                  ; ---------------------------------------------------------------
1797+ 7B03                  ; Accesso alla griglia degli item attivi
1798+ 7B03                  ; ---------------------------------------------------------------
1799+ 7B03 11 A0 D5         ld   de, items_grid
1800+ 7B06 19               add  hl, de            ; HL = address cella
1801+ 7B07
1802+ 7B07                  ; ---------------------------------------------------------------
1803+ 7B07                  ; Controllo presenza item
1804+ 7B07                  ;
1805+ 7B07                  ; items_grid contiene:
1806+ 7B07                  ;   0 = nessun item
1807+ 7B07                  ;   >0 = item attivo (colore o flag)
1808+ 7B07                  ; ---------------------------------------------------------------
1809+ 7B07 7E               ld   a, (hl)
1810+ 7B08 B7               or   a
1811+ 7B09 28 04            jr   z, .not_active
1812+ 7B0B
1813+ 7B0B                  ; ---------------------------------------------------------------
1814+ 7B0B                  ; Item trovato
1815+ 7B0B                  ; ---------------------------------------------------------------
1816+ 7B0B E1               pop  hl
1817+ 7B0C D1               pop  de
1818+ 7B0D
1819+ 7B0D 37               scf                    ; Carry = 1
1820+ 7B0E C9               ret
1821+ 7B0F
1822+ 7B0F              .not_active:
1823+ 7B0F
1824+ 7B0F                  ; ---------------------------------------------------------------
1825+ 7B0F                  ; Nessun item nella cella
1826+ 7B0F                  ; ---------------------------------------------------------------
1827+ 7B0F E1               pop  hl
1828+ 7B10 D1               pop  de
1829+ 7B11
1830+ 7B11 B7               or   a                 ; Carry = 0
1831+ 7B12 C9               ret
1832+ 7B13
