 123  88E6                  IF ENABLE_MUSIC != 0
 124  88E6 ~                call Audio_UpdateMusic        ; Aggiorna la musica
 125  88E6                  ENDIF
 126  88E6
 127  88E6                  ; Se l'animazione delle vite è abilitata, aggiorna la visualizzazione delle icone camminanti
 128  88E6                  IF ENABLE_ANIMATE_LIVES != 0
 129  88E6 ~                call Gfx_PrintWillyLives
 130  88E6                  ENDIF
 131  88E6
 132  88E6
 133  88E6                  ; 3. Salva le posizioni correnti del player per il prossimo frame
 134  88E6 ED 4B 45 F4      ld   bc, (PlayerPos)
 135  88EA ED 43 47 F4      ld   (PlayerPosOld), bc
 136  88EE
 137  88EE                  ; 4. Aggiorna le posizioni dei personaggi per il prossimo frame
 138  88EE CD 43 6E         call Input_CheckCtrl
 139  88F1 CD 1D 6D         call MovePlayer
 140  88F4 CD E4 71         call Phys_ApplyGravity
 141  88F7 CD B3 75         call Phys_ApplyConveyor
 142  88FA CD 90 7F         call Enemy_Update
 143  88FD CD 5F 87         call Items_CheckCollision
 144  8900
 145  8900                  ; Controlla condizione di vittoria (Tutti gli item + Master Bedroom + Conveyor)
 146  8900                  IF ENABLE_VICTORY_SCREEN != 0
 147  8900 CD 8B 8B         call CheckVictoryCondition
 148  8903 DA 0D 8B         jp   c, TriggerVictory
 149  8906                  ENDIF
 150  8906
 151  8906                  ; Controlla collisione con Nasties (morte di Willy)
 152  8906                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 153  8906 CD 31 7A         call Phys_CheckNastyCollision
 154  8909 38 0B            jr   c, .willy_dies
 155  890B                  ENDIF
 156  890B
 157  890B                  ; Controlla collisione con guardiani
 158  890B CD 2A 75         call CheckCollision
 159  890E 38 03            jr   c, .guardian_collision_found
 160  8910
 161  8910                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 162  8910                  IF ENABLE_RAMP_DEBUG_BARS != 0
 163  8910 ~                ld   a, (willy_on_ramp)
 164  8910 ~                or   a
 165  8910 ~                jp   nz, .draw_raster_bars
 166  8910                  ENDIF
 167  8910
 168  8910 C3 8D 89         jp   .no_collision
 169  8913
 170  8913              .guardian_collision_found:
 171  8913                  ; C'è collisione con un guardiano!
 172  8913                  ; Controlla se la morte per collisione con i guardiani è abilitata
 173  8913                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 174  8913 C3 16 89         jp   .willy_dies
 175  8916                  ELSE
 176  8916 ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 177  8916 ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 178  8916 ~                    ELSE
 179  8916 ~                    jp   .no_collision
 180  8916 ~                    ENDIF
 181  8916                  ENDIF
 182  8916
 183  8916              .willy_dies:
 184  8916                  ; 1. Decrementa le vite
 185  8916 21 52 F4         ld   hl, willy_lives
 186  8919 7E               ld   a, (hl)
 187  891A B7               or   a
 188  891B 28 05            jr   z, .check_game_over
 189  891D 35               dec  (hl)
 190  891E 28 02            jr   z, .check_game_over
 191  8920 18 03            jr   .normal_respawn
 192  8922
 193  8922              .check_game_over:
 194  8922                  IF ENABLE_GAME_OVER_RESTART != 0
 195  8922 C3 E4 89         jp   TriggerGameOver
 196  8925                  ELSE
 197  8925 ~                ld   a, 1
 198  8925 ~                ld   (willy_lives), a
 199  8925 ~                jr   .normal_respawn
 200  8925                  ENDIF
 201  8925
 202  8925              .normal_respawn:
 203  8925                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 204  8925 AF               xor  a
 205  8926 D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 206  8928 21 8D 5C         ld   hl, ATTR_P
 207  892B 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 208  892C CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 209  892F 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 210  8931 3E 07            ld   a, $07
 211  8933 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 212  8936
 213  8936                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 214  8936 06 19            ld   b, 25
 215  8938              .death_pause:
 216  8938 76               halt
 217  8939 10 FD            djnz .death_pause
 218  893B
 219  893B                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 220  893B AF               xor  a
 221  893C 32 53 F4         ld   (velocity_y), a
 222  893F 32 55 F4         ld   (jump_pressed), a
 223  8942 32 57 F4         ld   (coyote_timer), a
 224  8945 32 5A F4         ld   (jump_frame), a
 225  8948 32 59 F4         ld   (jump_dir), a
 226  894B 3E 01            ld   a, 1
 227  894D 32 54 F4         ld   (on_ground), a
 228  8950
 229  8950 3E 00            ld   a, RESPAWN_SAFETY_TIME
 230  8952 32 4F F8         ld   (willy_safety_timer), a
 231  8955
 232  8955                  ; 5. Riposiziona Willy nel punto di ingresso dell'ultima stanza raggiunta
 233  8955 CD 2C 82         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 234  8958 21 CC F7         ld   hl, room_entry_positions
 235  895B 5F               ld   e, a
 236  895C 16 00            ld   d, 0
 237  895E 19               add  hl, de
 238  895F 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 239  8960 4E               ld   c, (hl)                   ; C = X ingresso
 240  8961 23               inc  hl
 241  8962 46               ld   b, (hl)                   ; B = Y ingresso
 242  8963 ED 43 45 F4      ld   (PlayerPos), bc           ; Imposta le coordinate di respawn al punto di ingresso
 243  8967 ED 43 47 F4      ld   (PlayerPosOld), bc
 244  896B
 245  896B 3E 01            ld   a, 1
 246  896D 32 CB F7         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 247  8970
 248  8970                  ; 6. Ridisegna completamente la stanza e riposiziona Willy nel punto di ingresso
 249  8970 C3 77 88         jp   LoadRoomAndRestart
