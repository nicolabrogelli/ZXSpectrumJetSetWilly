 804+ 7CFD              ; Aggiorna le posizioni dei nemici attivi per il prossimo frame
 805+ 7CFD              ; -------------------------------------------------------------------
 806+ 7CFD              Enemy_Update:
 807+ 7CFD E5               push hl
 808+ 7CFE D5               push de
 809+ 7CFF C5               push bc
 810+ 7D00 DD E5            push ix
 811+ 7D02
 812+ 7D02                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 813+ 7D02 3A 01 EE         ld   a, (enemy_update_rate)
 814+ 7D05 FE 01            cp   1
 815+ 7D07 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 816+ 7D09
 817+ 7D09 3A 02 EE         ld   a, (enemy_update_timer)
 818+ 7D0C 3C               inc  a
 819+ 7D0D 47               ld   b, a                      ; B = timer + 1
 820+ 7D0E 3A 01 EE         ld   a, (enemy_update_rate)
 821+ 7D11 B8               cp   b
 822+ 7D12 28 0C            jr   z, .reset_timer
 823+ 7D14 38 0A            jr   c, .reset_timer
 824+ 7D16
 825+ 7D16                  ; Salva contatore incrementato e salta l'aggiornamento
 826+ 7D16 78               ld   a, b
 827+ 7D17 32 02 EE         ld   (enemy_update_timer), a
 828+ 7D1A
 829+ 7D1A              .skip_update:
 830+ 7D1A DD E1            pop  ix
 831+ 7D1C C1               pop  bc
 832+ 7D1D D1               pop  de
 833+ 7D1E E1               pop  hl
 834+ 7D1F C9               ret
 835+ 7D20
 836+ 7D20              .reset_timer:
 837+ 7D20 AF               xor  a
 838+ 7D21 32 02 EE         ld   (enemy_update_timer), a
 839+ 7D24 18 00            jr   .do_update
 840+ 7D26
 841+ 7D26              .do_update:
 842+ 7D26 3E 01            ld   a, 1
 843+ 7D28 32 88 EE         ld   (enemy_was_updated), a
 844+ 7D2B
 845+ 7D2B DD 21 2D 78      ld   ix, ActiveEnemies
 846+ 7D2F 06 08            ld   b, 8              ; 8 slot
 847+ 7D31              .loop:
 848+ 7D31 DD 7E 00         ld   a, (ix+0)         ; Flags
 849+ 7D34 E6 80            and  $80               ; Active?
 850+ 7D36 CA 08 7E         jp   z, .next
 851+ 7D39
 852+ 7D39                  ; 1. Aggiorna Anim State
 853+ 7D39 DD 7E 01         ld   a, (ix+1)         ; Sprite Type (Offset 1)
 854+ 7D3C E6 3F            and  $3F               ; Tipo
 855+ 7D3E FE 0D            cp   13                ; Tipo 13 = Canguro?
 856+ 7D40 28 2A            jr   z, .canguro_anim
 857+ 7D42 FE 0B            cp   11                ; Tipo 11 = Soldato?
 858+ 7D44 28 1B            jr   z, .soldato_anim
 859+ 7D46 FE 10            cp   16                ; Tipo 16 = Candelabro?
 860+ 7D48 28 17            jr   z, .soldato_anim
 861+ 7D4A FE 14            cp   20                ; Tipo 20 = Nonnino?
 862+ 7D4C 28 13            jr   z, .soldato_anim
 863+ 7D4E FE 15            cp   21                ; Tipo 21 = Parrucca?
 864+ 7D50 28 0F            jr   z, .soldato_anim
 865+ 7D52 FE 1D            cp   29                ; Tipo 29 = Saliera?
 866+ 7D54 28 0B            jr   z, .soldato_anim
 867+ 7D56
 868+ 7D56 DD 7E 07         ld   a, (ix+7)         ; Anim State (Offset 7)
 869+ 7D59 3C               inc  a
 870+ 7D5A E6 03            and  3                 ; Alterna 0..3
 871+ 7D5C DD 77 07         ld   (ix+7), a
 872+ 7D5F 18 14            jr   .anim_done
 873+ 7D61
 874+ 7D61              .soldato_anim:
 875+ 7D61 DD 7E 07         ld   a, (ix+7)         ; Anim State
 876+ 7D64 3C               inc  a
 877+ 7D65 E6 01            and  1                 ; Alterna 0..1
 878+ 7D67 DD 77 07         ld   (ix+7), a
 879+ 7D6A 18 09            jr   .anim_done
 880+ 7D6C
 881+ 7D6C              .canguro_anim:
 882+ 7D6C DD 7E 07         ld   a, (ix+7)         ; Anim State
 883+ 7D6F 3C               inc  a
 884+ 7D70 E6 07            and  7                 ; Alterna 0..7
 885+ 7D72 DD 77 07         ld   (ix+7), a
 886+ 7D75
 887+ 7D75              .anim_done:
 888+ 7D75
 889+ 7D75                  ; 3. Determina se orizzontale o verticale
 890+ 7D75 DD 7E 00         ld   a, (ix+0)         ; Flags
 891+ 7D78 E6 40            and  $40               ; Vertical? (Bit 6)
 892+ 7D7A C2 C4 7D         jp   nz, .vertical
 893+ 7D7D
 894+ 7D7D              .horizontal:
 895+ 7D7D DD 7E 06         ld   a, (ix+6)         ; Direction (1=Left, 2=Right) (Offset 6)
 896+ 7D80 FE 01            cp   1
 897+ 7D82 20 20            jr   nz, .horiz_right
 898+ 7D84
 899+ 7D84              .horiz_left:
 900+ 7D84 DD 7E 02         ld   a, (ix+2)         ; Current X
 901+ 7D87 D6 02            sub  2                 ; Muovi a sinistra di 2 pixel
 902+ 7D89 DD BE 04         cp   (ix+4)            ; Min Limit (Offset 4)
 903+ 7D8C 28 08            jr   z, .h_rev_right
 904+ 7D8E 38 06            jr   c, .h_rev_right
 905+ 7D90 DD 77 02         ld   (ix+2), a
 906+ 7D93 C3 08 7E         jp   .next
 907+ 7D96
 908+ 7D96              .h_rev_right:
 909+ 7D96 DD 7E 04         ld   a, (ix+4)         ; Min Limit
 910+ 7D99 DD 77 02         ld   (ix+2), a
 911+ 7D9C 3E 02            ld   a, 2
 912+ 7D9E DD 77 06         ld   (ix+6), a         ; Cambia direzione a Destra (Offset 6)
 913+ 7DA1 C3 08 7E         jp   .next
 914+ 7DA4
 915+ 7DA4              .horiz_right:
 916+ 7DA4 DD 7E 02         ld   a, (ix+2)         ; Current X
 917+ 7DA7 C6 02            add  a, 2              ; Muovi a destra di 2 pixel
 918+ 7DA9 DD BE 05         cp   (ix+5)            ; Max Limit (Offset 5)
 919+ 7DAC 28 08            jr   z, .h_rev_left
 920+ 7DAE 30 06            jr   nc, .h_rev_left
 921+ 7DB0 DD 77 02         ld   (ix+2), a
 922+ 7DB3 C3 08 7E         jp   .next
 923+ 7DB6
 924+ 7DB6              .h_rev_left:
 925+ 7DB6 DD 7E 05         ld   a, (ix+5)         ; Max Limit
 926+ 7DB9 DD 77 02         ld   (ix+2), a
 927+ 7DBC 3E 01            ld   a, 1
 928+ 7DBE DD 77 06         ld   (ix+6), a         ; Cambia direzione a Sinistra
 929+ 7DC1 C3 08 7E         jp   .next
