 103  7698 D3 FE            out  ($fe), a
 104  769A 3C               inc  a
 105  769B E6 07            and  7
 106  769D 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 107  769F              .delay:
 108  769F 0D               dec  c
 109  76A0 20 FD            jr   nz, .delay
 110  76A2 10 F4            djnz .raster_loop
 111  76A4
 112  76A4                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 113  76A4 3A BE 76         ld   a, (room_border_color)
 114  76A7 D3 FE            out  ($fe), a
 115  76A9 18 05            jr   .no_collision_change
 116  76AB
 117  76AB              .no_collision:
 118  76AB                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 119  76AB 3A BE 76         ld   a, (room_border_color)
 120  76AE D3 FE            out  ($fe), a
