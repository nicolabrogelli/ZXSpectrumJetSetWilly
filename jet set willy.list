  72  898D E6 07            and  $07               ; Garantisci un valore valido 0..7
  73  898F 32 46 F7         ld   (room_border_color), a
  74  8992 D3 FE            out  ($fe), a          ; Imposta colore bordo hardware
  75  8994
  76  8994                  ; Aggiorna BORDCR per la ROM in modo sicuro (Paper = border, Ink = white)
  77  8994 07               rlca
  78  8995 07               rlca
