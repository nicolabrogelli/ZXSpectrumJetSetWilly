1326+ 8514              ; DrawItemGraphic
1327+ 8514              ;
1328+ 8514              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1329+ 8514              ; utilizzando una bitmap di 8 byte e un attributo colore.
1330+ 8514              ;
1331+ 8514              ; Input:
1332+ 8514              ;   B = Riga attributi (3..18)
1333+ 8514              ;   C = Colonna attributi (0..31)
1334+ 8514              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1335+ 8514              ;   E = Attributo colore
1336+ 8514              ;
1337+ 8514              ; Output:
1338+ 8514              ;   Nessuno
1339+ 8514              ;
1340+ 8514              ; Registri preservati:
1341+ 8514              ;   BC, DE, HL
1342+ 8514              ; -------------------------------------------------------------------
1343+ 8514              DrawItemGraphic:
1344+ 8514
1345+ 8514                  ; Salva i registri originali
1346+ 8514 C5               push bc
1347+ 8515 D5               push de
1348+ 8516 E5               push hl
1349+ 8517
1350+ 8517                  ; ---------------------------------------------------------------
1351+ 8517                  ; Calcolo indirizzo bitmap dello Spectrum
1352+ 8517                  ;
1353+ 8517                  ; Ogni item occupa una cella attributi (8x8 pixel).
1354+ 8517                  ;
1355+ 8517                  ; Formula:
1356+ 8517                  ;   High = $40 + (Row AND $18)
1357+ 8517                  ;   Low  = (Row AND 7) * 32 + Col
1358+ 8517                  ;
1359+ 8517                  ; DE conterrà l'indirizzo della prima scanline.
1360+ 8517                  ; ---------------------------------------------------------------
1361+ 8517
1362+ 8517 78               ld   a, b
1363+ 8518 E6 18            and  $18
1364+ 851A C6 40            add  a, $40
1365+ 851C 57               ld   d, a              ; Byte alto indirizzo video
1366+ 851D
1367+ 851D 78               ld   a, b
1368+ 851E E6 07            and  7                 ; Riga interna al blocco da 8
1369+ 8520
1370+ 8520 87               add  a, a              ; *2
1371+ 8521 87               add  a, a              ; *4
1372+ 8522 87               add  a, a              ; *8
1373+ 8523 87               add  a, a              ; *16
1374+ 8524 87               add  a, a              ; *32
1375+ 8525
1376+ 8525 81               add  a, c              ; + colonna
1377+ 8526
1378+ 8526 5F               ld   e, a              ; Byte basso indirizzo video
1379+ 8527
1380+ 8527                  ; ---------------------------------------------------------------
1381+ 8527                  ; Disegno bitmap
1382+ 8527                  ;
1383+ 8527                  ; Copia 8 byte consecutivi nella memoria video.
1384+ 8527                  ; Ogni byte rappresenta una scanline da 8 pixel.
1385+ 8527                  ; ---------------------------------------------------------------
1386+ 8527
1387+ 8527 C5               push bc                ; Conserva Row e Col
1388+ 8528
1389+ 8528 06 08            ld   b, 8              ; Numero scanline
1390+ 852A
1391+ 852A              .line_loop:
1392+ 852A
1393+ 852A 7E               ld   a, (hl)           ; Legge scanline bitmap
1394+ 852B 12               ld   (de), a           ; Scrive nella memoria video
1395+ 852C
1396+ 852C 14               inc  d                 ; Scanline successiva
1397+ 852D 23               inc  hl                ; Byte bitmap successivo
1398+ 852E
1399+ 852E 05               dec  b
1400+ 852F 20 F9            jr   nz, .line_loop
1401+ 8531
1402+ 8531 C1               pop  bc                ; Ripristina Row e Col
1403+ 8532
1404+ 8532                  ; ---------------------------------------------------------------
1405+ 8532                  ; Calcolo indirizzo attributo
1406+ 8532                  ;
1407+ 8532                  ; Formula:
1408+ 8532                  ;   AttrAddr = $5800 + Row * 32 + Col
1409+ 8532                  ;
1410+ 8532                  ; HL conterrà l'indirizzo della cella attributi.
1411+ 8532                  ; ---------------------------------------------------------------
1412+ 8532
1413+ 8532 26 00            ld   h, 0
1414+ 8534 68               ld   l, b              ; HL = Row
1415+ 8535
1416+ 8535 29               add  hl, hl            ; *2
1417+ 8536 29               add  hl, hl            ; *4
1418+ 8537 29               add  hl, hl            ; *8
1419+ 8538 29               add  hl, hl            ; *16
1420+ 8539 29               add  hl, hl            ; *32
1421+ 853A
1422+ 853A 79               ld   a, c              ; A = Colonna
1423+ 853B
1424+ 853B 85               add  a, l
1425+ 853C 6F               ld   l, a
1426+ 853D
1427+ 853D 30 01            jr   nc, .no_carry
1428+ 853F 24               inc  h
1429+ 8540
1430+ 8540              .no_carry:
1431+ 8540
1432+ 8540                  ; HL = Row * 32 + Col
1433+ 8540
1434+ 8540 11 00 58         ld   de, $5800
1435+ 8543 19               add  hl, de            ; HL = indirizzo attributi
1436+ 8544
1437+ 8544                  ; ---------------------------------------------------------------
1438+ 8544                  ; Recupera il colore originale dallo stack.
1439+ 8544                  ;
1440+ 8544                  ; Layout stack:
1441+ 8544                  ;   HL originale
1442+ 8544                  ;   DE originale (E = colore)
1443+ 8544                  ;   BC originale
1444+ 8544                  ; ---------------------------------------------------------------
1445+ 8544
1446+ 8544 C1               pop  bc                ; Recupera HL originale
1447+ 8545 D1               pop  de                ; Recupera DE originale
1448+ 8546
1449+ 8546                  ; ---------------------------------------------------------------
1450+ 8546                  ; Scrive l'attributo colore
1451+ 8546                  ; ---------------------------------------------------------------
1452+ 8546
1453+ 8546 7B               ld   a, e              ; A = colore
1454+ 8547 77               ld   (hl), a           ; Scrive nella RAM attributi
1455+ 8548
1456+ 8548                  ; ---------------------------------------------------------------
1457+ 8548                  ; Ripristina HL e BC originali
1458+ 8548                  ; ---------------------------------------------------------------
1459+ 8548
1460+ 8548 C5               push bc
1461+ 8549 E1               pop  hl                ; HL originale
1462+ 854A
1463+ 854A C1               pop  bc                ; BC originale
1464+ 854B
1465+ 854B C9               ret
