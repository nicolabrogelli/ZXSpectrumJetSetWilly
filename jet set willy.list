 993+ 806D DD BE 05         cp   (ix+5)            ; Max Limit (Bottom)
 994+ 8070 28 08            jr   z, .v_rev_up
 995+ 8072 30 06            jr   nc, .v_rev_up
 996+ 8074 DD 77 03         ld   (ix+3), a
 997+ 8077 C3 85 80         jp   .next
 998+ 807A
