  32+ 6C45 CB 3F            srl  a
  33+ 6C47 CB 3F            srl  a
  34+ 6C49 CB 3F            srl  a                 ; A = r (0..15)
  35+ 6C4B
  36+ 6C4B                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
  37+ 6C4B 5F               ld   e, a              ; E = r
  38+ 6C4C 79               ld   a, c
  39+ 6C4D CB 3F            srl  a
  40+ 6C4F CB 3F            srl  a
  41+ 6C51 CB 3F            srl  a                 ; A = c (0..31)
  42+ 6C53 4F               ld   c, a              ; C = c
  43+ 6C54 7B               ld   a, e              ; A = r
  44+ 6C55
  45+ 6C55 CD 14 72         call GetCellFromUnpacked ; A = cell type
  46+ 6C58
  47+ 6C58                  ; 5. Controlla se è solida: Floor (1) o Wall (2)
  48+ 6C58 FE 01            cp   1
  49+ 6C5A 28 09            jr   z, .solid
