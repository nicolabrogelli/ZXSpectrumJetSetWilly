 923+ 6AFF 80               add  a, b              ; A = ramp_col + ramp_len
 924+ 6B00 4F               ld   c, a              ; C = limit_right (exclusive)
 925+ 6B01
 926+ 6B01 7B               ld   a, e              ; A = Col
 927+ 6B02 B8               cp   b
