1396+ 77FC 79               ld   a, c              ; A = PlayerX
1397+ 77FD BB               cp   e
1398+ 77FE 30 0C            jr   nc, .check_prox_right_bound
1399+ 7800
1400+ 7800                  ; PlayerX < X_left
