1383+ 6CB7 19               add  hl, de
1384+ 6CB8 7E               ld   a, (hl)
1385+ 6CB9 B7               or   a
1386+ 6CBA 20 0C            jr   nz, .custom_settings
1387+ 6CBC
1388+ 6CBC 3E 06            ld   a, 6
1389+ 6CBE 32 B7 78         ld   (room_jump_strength), a
1390+ 6CC1 3E 01            ld   a, 1
1391+ 6CC3 32 B8 78         ld   (room_gravity_preset), a
1392+ 6CC6 18 12            jr   .done
