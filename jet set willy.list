 303+ 74B6 90               sub  b                  ; A = WillyY - EnemyY
 304+ 74B7 C6 0F            add  a, 15
 305+ 74B9 FE 1F            cp   31
 306+ 74BB D0               ret  nc                 ; Fuori portata Y
