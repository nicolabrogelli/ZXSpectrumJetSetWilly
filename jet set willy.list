  72+ 8532 ~            ; Audio_UpdateMusic
  73+ 8532 ~            ;
  74+ 8532 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8532 ~            ; Viene chiamata a ogni frame.
  76+ 8532 ~            ; -------------------------------------------------------------------
  77+ 8532 ~            Audio_UpdateMusic:
  78+ 8532 ~                push af
  79+ 8532 ~                push bc
  80+ 8532 ~                push de
  81+ 8532 ~                push hl
  82+ 8532 ~
  83+ 8532 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8532 ~                ld   a, (Audio_jump_sound_note)
  85+ 8532 ~                cp   18
  86+ 8532 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8532 ~
  88+ 8532 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8532 ~                ld   a, (Audio_music_frame_counter)
  90+ 8532 ~                dec  a
  91+ 8532 ~                ld   (Audio_music_frame_counter), a
  92+ 8532 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8532 ~
  94+ 8532 ~                ; Altrimenti carica la nota successiva
  95+ 8532 ~                ld   a, (Audio_music_note_idx)
  96+ 8532 ~                inc  a
  97+ 8532 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8532 ~                jr   c, .no_wrap
  99+ 8532 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8532 ~            .no_wrap:
 101+ 8532 ~                ld   (Audio_music_note_idx), a
 102+ 8532 ~
 103+ 8532 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8532 ~                ld   e, a
 105+ 8532 ~                ld   d, 0
 106+ 8532 ~                ld   hl, Audio_MusicSheet
 107+ 8532 ~                add  hl, de
 108+ 8532 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8532 ~
 110+ 8532 ~                ; Leggi durata (secondo byte)
 111+ 8532 ~                inc  hl
 112+ 8532 ~                ld   a, (hl)
 113+ 8532 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8532 ~                jr   nz, .dur_ok
 115+ 8532 ~                ld   a, 1
 116+ 8532 ~            .dur_ok:
 117+ 8532 ~                ld   (Audio_music_frame_counter), a
 118+ 8532 ~
 119+ 8532 ~            .play_current_note:
 120+ 8532 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8532 ~                ld   a, (Audio_music_note_idx)
 122+ 8532 ~                ld   e, a
 123+ 8532 ~                ld   d, 0
 124+ 8532 ~                ld   hl, Audio_MusicSheet
 125+ 8532 ~                add  hl, de
 126+ 8532 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8532 ~                ld   a, (hl)                  ; A = delay
 128+ 8532 ~                or   a
 129+ 8532 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8532 ~
 131+ 8532 ~                ; Suona la nota: 2 cicli
 132+ 8532 ~                ld   d, a                     ; D = delay
 133+ 8532 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8532 ~            .note_loop:
 135+ 8532 ~                ; Speaker ON
 136+ 8532 ~                ld   a, (room_border_color)
 137+ 8532 ~                or   $10
 138+ 8532 ~                out  ($fe), a
 139+ 8532 ~                ld   c, d
 140+ 8532 ~            .d1:
 141+ 8532 ~                push af
 142+ 8532 ~                pop  af
 143+ 8532 ~                dec  c
 144+ 8532 ~                jr   nz, .d1
 145+ 8532 ~
 146+ 8532 ~                ; Speaker OFF
 147+ 8532 ~                ld   a, (room_border_color)
 148+ 8532 ~                and  $ef
 149+ 8532 ~                out  ($fe), a
 150+ 8532 ~                ld   c, d
 151+ 8532 ~            .d2:
 152+ 8532 ~                push af
 153+ 8532 ~                pop  af
 154+ 8532 ~                dec  c
 155+ 8532 ~                jr   nz, .d2
 156+ 8532 ~
 157+ 8532 ~                djnz .note_loop
 158+ 8532 ~
 159+ 8532 ~            .done:
 160+ 8532 ~                pop  hl
 161+ 8532 ~                pop  de
 162+ 8532 ~                pop  bc
 163+ 8532 ~                pop  af
 164+ 8532 ~                ret
 165+ 8532 ~
 166+ 8532 ~            Audio_MusicSheet:
 167+ 8532 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8532 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8532 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8532 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8532 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8532 ~                db 90, 10, 107, 20, 68, 65
 173+ 8532                  ELSE
 174+ 8532              Audio_UpdateMusic:
 175+ 8532 C9               ret
 176+ 8533                  ENDIF
