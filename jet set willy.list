 222+ 752F              RestoreBackgroundCell:
 223+ 752F FD E5            push iy                ; Preserva IY
 224+ 7531 C5               push bc
 225+ 7532 D5               push de
 226+ 7533 E5               push hl
 227+ 7534 DD E5            push ix
 228+ 7536
 229+ 7536 C5               push bc
 230+ 7537 FD E1            pop  iy                ; IY = original BC (IYH = Row, IYL = Col)
 231+ 7539
 232+ 7539                  ; Riga di layout: r = B - 3
 233+ 7539 78               ld   a, b
 234+ 753A D6 03            sub  3                 ; A = r (0..15)
 235+ 753C
 236+ 753C                  ; Colonna: c = C (Col)
 237+ 753C CD 11 71         call GetCellFromUnpacked ; A = cell type (0..3)
 238+ 753F
 239+ 753F ED 5B CE 79      ld   de, (room_ptr)
 240+ 7543 B7               or   a
 241+ 7544 20 06            jr   nz, .not_bg
 242+ 7546 21 A0 00         ld   hl, OFFSET_BG
 243+ 7549 19               add  hl, de
 244+ 754A 18 16            jr   .draw_cell
