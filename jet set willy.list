1424+ 7549 28 04            jr   z, .not_active
1425+ 754B
1426+ 754B                  ; ---------------------------------------------------------------
1427+ 754B                  ; Item trovato
1428+ 754B                  ; ---------------------------------------------------------------
1429+ 754B E1               pop  hl
1430+ 754C D1               pop  de
1431+ 754D
1432+ 754D 37               scf                    ; Carry = 1
1433+ 754E C9               ret
1434+ 754F
1435+ 754F              .not_active:
1436+ 754F
1437+ 754F                  ; ---------------------------------------------------------------
