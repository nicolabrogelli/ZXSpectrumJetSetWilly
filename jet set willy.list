   7+ 6C9E              ; Input_CheckCtrl
   8+ 6C9E              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 6C9E              ;
  10+ 6C9E              ; Output:
  11+ 6C9E              ;   D = bitmask tasti attivi:
  12+ 6C9E              ;       bit 0 → sinistra (O)
  13+ 6C9E              ;       bit 1 → destra   (P)
  14+ 6C9E              ;       bit 2 → salto    (Z)
  15+ 6C9E              ;
  16+ 6C9E              ; Effetti collaterali in RAM:
  17+ 6C9E              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 6C9E              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 6C9E              ;   (jump_prev)     → debounce tasto salto
  20+ 6C9E              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 6C9E              ;   (flags)         → bit 0 impostato se movimento rilevato
