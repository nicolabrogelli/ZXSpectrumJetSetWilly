  72+ 6BF4              ; Mappatura:
  73+ 6BF4              ;   0 = The Off Licence
  74+ 6BF4              ;   1 = The Bridge
  75+ 6BF4              ;   2 = Master Bedroom
  76+ 6BF4              ;   3 = Under The Mega Tree
  77+ 6BF4              ;   4 = At The Foot Of The Mega Tree
  78+ 6BF4              ;   5 = The Drive
  79+ 6BF4              ;   6 = The Security Guard
  80+ 6BF4              ;   7 = The Bathroom
  81+ 6BF4              ;
  82+ 6BF4              ; Se nessuna stanza corrisponde viene impostato:
  83+ 6BF4              ;   current_room = 0
  84+ 6BF4              ; -------------------------------------------------------------------
