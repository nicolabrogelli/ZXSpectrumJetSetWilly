 120+ 655A              ; Clamp sinistra: forzatura al limite minimo
 121+ 655A              ; ---------------------------------------------------------------
 122+ 655A              .clamp_left:
 123+ 655A                  ; Controlla se c'è una stanza a sinistra
 124+ 655A 2A 4B 7E         ld   hl, (room_ptr)
 125+ 655D 11 EB 00         ld   de, 235           ; Offset per stanza a sinistra
 126+ 6560 19               add  hl, de
