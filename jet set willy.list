   8+ 8624              ; Audio_UpdateJumpSound
   9+ 8624              ;
  10+ 8624              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8624              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8624              ; -------------------------------------------------------------------
  13+ 8624              Audio_UpdateJumpSound:
  14+ 8624 F5               push af
  15+ 8625 C5               push bc
  16+ 8626 D5               push de
  17+ 8627 E5               push hl
  18+ 8628
  19+ 8628                  ; Controlla se il suono è attivo (note < 18)
  20+ 8628 3A 6A EF         ld   a, (Audio_jump_sound_note)
  21+ 862B FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 862D 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 862F
  24+ 862F                  ; Carica la nota corrente da suonare
  25+ 862F 5F               ld   e, a
  26+ 8630 16 00            ld   d, 0
  27+ 8632 21 5E 86         ld   hl, Audio_JumpSoundDelays
  28+ 8635 19               add  hl, de
  29+ 8636 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8637 57               ld   d, a                      ; D = delay della nota
  31+ 8638
  32+ 8638                  ; Suona la nota: 15 cicli
  33+ 8638 06 0F            ld   b, 15
  34+ 863A              .note_loop:
  35+ 863A                  ; Speaker ON
  36+ 863A 3A 63 EB         ld   a, (room_border_color)
  37+ 863D F6 10            or   $10
  38+ 863F D3 FE            out  ($fe), a
  39+ 8641 4A               ld   c, d
  40+ 8642              .d1:
  41+ 8642 0D               dec  c
  42+ 8643 20 FD            jr   nz, .d1
  43+ 8645
  44+ 8645                  ; Speaker OFF
  45+ 8645 3A 63 EB         ld   a, (room_border_color)
  46+ 8648 E6 EF            and  $ef
  47+ 864A D3 FE            out  ($fe), a
  48+ 864C 4A               ld   c, d
  49+ 864D              .d2:
  50+ 864D 0D               dec  c
  51+ 864E 20 FD            jr   nz, .d2
  52+ 8650
  53+ 8650 10 E8            djnz .note_loop
  54+ 8652
  55+ 8652                  ; Passa alla nota successiva
  56+ 8652 3A 6A EF         ld   a, (Audio_jump_sound_note)
  57+ 8655 3C               inc  a
  58+ 8656 32 6A EF         ld   (Audio_jump_sound_note), a
  59+ 8659
  60+ 8659              .done:
  61+ 8659 E1               pop  hl
  62+ 865A D1               pop  de
  63+ 865B C1               pop  bc
  64+ 865C F1               pop  af
  65+ 865D C9               ret
  66+ 865E
  67+ 865E              Audio_JumpSoundDelays:
  68+ 865E 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 8662 19 13 0C 06
  68+ 8666 0C 13 19 20
  68+ 866A 26 2D 33 3A
  68+ 866E 40 47
  69+ 8670
