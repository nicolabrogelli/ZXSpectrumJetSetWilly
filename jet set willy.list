  42+ 65D5 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  43+ 65D7
  44+ 65D7                  ; ── Primo frame di pressione di Q ──
  45+ 65D7 3E 01            ld   a, 1
  46+ 65D9 32 33 7A         ld   (q_prev), a            ; marca "Q era premuto"
  47+ 65DC
  48+ 65DC                  ; NOTA sullo stack:
  49+ 65DC                  ; Input_CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  50+ 65DC                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChange senza
  51+ 65DC                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
