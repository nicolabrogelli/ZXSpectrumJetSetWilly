1352+ 6466                  ; 1. Indirizzo del font in RAM ($F100 + (ASCII - 32) * 8)
1353+ 6466 D6 20            sub  32                ; A = ASCII - 32
1354+ 6468 6F               ld   l, a
1355+ 6469 26 00            ld   h, 0
1356+ 646B 29               add  hl, hl            ; *2
1357+ 646C 29               add  hl, hl            ; *4
1358+ 646D 29               add  hl, hl            ; *8
