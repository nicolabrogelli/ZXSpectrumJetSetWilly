   8+ 5DDB              CopyChars:
   9+ 5DDB 21 00 3D         ld hl, $3D00  ; Indirizzo del set di caratteri originale in ROM
  10+ 5DDE 11 00 80         ld de, $8000  ; Indirizzo nella RAM in cui copiare il set di caratteri
  11+ 5DE1 01 00 03         ld bc, 768    ; Numero di byte da copiare (96 caratteri * 8 byte ciascuno)
  12+ 5DE4 ED B0            ldir          ; Copiare i dati
  13+ 5DE6 C9               ret
  14+ 5DE7
  15+ 5DE7              ; -------------------------------------------------------------------
  16+ 5DE7              ; Ridefinisci i caratteri (incluso quello per i bordi)
  17+ 5DE7              ; -------------------------------------------------------------------
  18+ 5DE7              DefineChars:
  19+ 5DE7 21 A7 6B         ld hl, Willy             ; Indirizzo dei dati del nuovo carattere
  20+ 5DEA 11 08 7F         ld de, $7F00 + (1 * 8)      ; Indirizzo di ASCII 1 nel nuovo set di caratteri
  21+ 5DED 01 48 00         ld bc, 72                   ; Numero di byte da copiare (9 caratteri * 8 byte)
  22+ 5DF0 ED B0            ldir                        ; Effettua la copia dei caratteri
  23+ 5DF2 21 00 7F         ld hl, $7F00                ; Indirizzo del nuovo set di caratteri in RAM (font start - 256)
  24+ 5DF5 22 36 5C         ld ($5C36), hl              ; Aggiornare la variabile di sistema CHARS
  25+ 5DF8 C9               ret
