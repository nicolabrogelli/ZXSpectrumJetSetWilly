 624+ 607A CD 3F 5E         call Gfx_DrawPixelSprite8x8 ; Disegna testa
 625+ 607D
 626+ 607D                  ; 2. Determina sprite per il corpo (sinistra o destra con frame animazione)
 627+ 607D 3A E9 F4         ld   a, (direction)
 628+ 6080 FE 01            cp   1                 ; Sinistra?
 629+ 6082 20 13            jr   nz, .right_body
 630+ 6084
 631+ 6084                  ; Corpo a sinistra
 632+ 6084 3A E8 F4         ld   a, (body_state)   ; 0, 1, 2
 633+ 6087 C6 05            add  a, 5              ; offset del tile per il corpo sinistro (5, 6, 7)
 634+ 6089 87               add  a, a              ; *2
 635+ 608A 87               add  a, a              ; *4
 636+ 608B 87               add  a, a              ; *8
 637+ 608C 5F               ld   e, a
 638+ 608D 16 00            ld   d, 0
 639+ 608F DD 21 62 D1      ld   ix, Willy
 640+ 6093 DD 19            add  ix, de
 641+ 6095 18 11            jr   .draw_body
 642+ 6097
 643+ 6097              .right_body:
 644+ 6097                  ; Corpo a destra
 645+ 6097 3A E8 F4         ld   a, (body_state)   ; 0, 1, 2
 646+ 609A C6 01            add  a, 1              ; offset del tile per il corpo destro (1, 2, 3)
 647+ 609C 87               add  a, a              ; *2
 648+ 609D 87               add  a, a              ; *4
 649+ 609E 87               add  a, a              ; *8
 650+ 609F 5F               ld   e, a
 651+ 60A0 16 00            ld   d, 0
 652+ 60A2 DD 21 62 D1      ld   ix, Willy
 653+ 60A6 DD 19            add  ix, de
