1481+ 6E07 38 0C            jr   c, .collision
1482+ 6E09
1483+ 6E09                  ; Punto 6: Bottom-Right (X + 7, Y + 15)
1484+ 6E09 79               ld   a, c
1485+ 6E0A C6 07            add  a, 7
1486+ 6E0C 4F               ld   c, a
1487+ 6E0D CD AA 6D         call CheckNastyCell
1488+ 6E10 38 03            jr   c, .collision
