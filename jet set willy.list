 184+ 7B69              ; -------------------------------------------------------------------
 185+ 7B69              ; DetermineCurrentRoomID
 186+ 7B69              ;
 187+ 7B69              ; Determina l'ID numerico della stanza corrente confrontando
 188+ 7B69              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 189+ 7B69              ;
 190+ 7B69              ; Se viene trovata una corrispondenza:
 191+ 7B69              ;   A = ID della stanza
 192+ 7B69              ;   current_room = A
 193+ 7B69              ;
 194+ 7B69              ; Mappatura:
 195+ 7B69              ;    0 = The Off Licence
 196+ 7B69              ;    1 = The Bridge
 197+ 7B69              ;    2 = Under The Mega Tree
 198+ 7B69              ;    3 = Gfx_At The Foot Of The Mega Tree
 199+ 7B69              ;    4 = The Drive
 200+ 7B69              ;    5 = The Security Guard
 201+ 7B69              ;    6 = Entrance To Hades
 202+ 7B69              ;    7 = Cuckoo's Nest
 203+ 7B69              ;    8 = Inside The Mega Trunk
 204+ 7B69              ;    9 = On A Branch Over The Drive
 205+ 7B69              ;   10 = The Front Door
 206+ 7B69              ;   11 = The Hall
 207+ 7B69              ;   12 = Tree Top
 208+ 7B69              ;   27 = The Chapel
 209+ 7B69              ;   28 = First Landing
 210+ 7B69              ;   29 = The Nightmare Room
 211+ 7B69              ;   33 = The Bathroom
 212+ 7B69              ;   35 = Master Bedroom
 213+ 7B69              ;
 214+ 7B69              ; Se nessuna stanza corrisponde viene impostato:
 215+ 7B69              ;   current_room = 0
 216+ 7B69              ; -------------------------------------------------------------------
 217+ 7B69              DetermineCurrentRoomID:
 218+ 7B69
