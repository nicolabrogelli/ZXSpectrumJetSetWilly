  63+ 6C39              ; DetermineCurrentRoomID
  64+ 6C39              ;
  65+ 6C39              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 6C39              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 6C39              ;
  68+ 6C39              ; Se viene trovata una corrispondenza:
  69+ 6C39              ;   A = ID della stanza
  70+ 6C39              ;   current_room = A
  71+ 6C39              ;
  72+ 6C39              ; Mappatura:
  73+ 6C39              ;    0 = The Off Licence
  74+ 6C39              ;    1 = The Bridge
  75+ 6C39              ;    2 = Under The Mega Tree
  76+ 6C39              ;    3 = At The Foot Of The Mega Tree
  77+ 6C39              ;    4 = The Drive
  78+ 6C39              ;    5 = The Security Guard
  79+ 6C39              ;    6 = Entrance To Hades
  80+ 6C39              ;    7 = Cuckoo's Nest
  81+ 6C39              ;    8 = Inside The Mega Trunk
  82+ 6C39              ;    9 = On A Branch Over The Drive
  83+ 6C39              ;   10 = The Front Door
  84+ 6C39              ;   11 = The Hall
  85+ 6C39              ;   12 = Tree Top
  86+ 6C39              ;   33 = The Bathroom
  87+ 6C39              ;   35 = Master Bedroom
  88+ 6C39              ;
  89+ 6C39              ; Se nessuna stanza corrisponde viene impostato:
  90+ 6C39              ;   current_room = 0
  91+ 6C39              ; -------------------------------------------------------------------
