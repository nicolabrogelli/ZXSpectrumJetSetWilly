 922+ 6AFA 3A 10 7C         ld   a, (ramp_len)
 923+ 6AFD 80               add  a, b              ; A = ramp_col + ramp_len
 924+ 6AFE 4F               ld   c, a              ; C = limit_right (exclusive)
 925+ 6AFF
 926+ 6AFF 7B               ld   a, e              ; A = Col
 927+ 6B00 B8               cp   b
 928+ 6B01 38 34            jr   c, .check_platform_case ; Col < ramp_col
 929+ 6B03 B9               cp   c
 930+ 6B04 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 931+ 6B06
 932+ 6B06                  ; Calcola B = Col - ramp_col
 933+ 6B06 7B               ld   a, e
 934+ 6B07 90               sub  b
 935+ 6B08 47               ld   b, a              ; B = offset (0..ramp_len-1)
 936+ 6B09
 937+ 6B09                  ; SlopeRow = ramp_row - B
 938+ 6B09 3A 11 7C         ld   a, (ramp_row)
