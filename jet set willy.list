  72+ 6C32              ; Mappatura:
  73+ 6C32              ;   0 = The Off Licence
  74+ 6C32              ;   1 = The Bridge
  75+ 6C32              ;   2 = Under The Mega Tree
  76+ 6C32              ;   3 = At The Foot Of The Mega Tree
  77+ 6C32              ;   4 = The Drive
  78+ 6C32              ;   5 = The Security Guard
  79+ 6C32              ;   6 = Entrance To Hades
  80+ 6C32              ;   7 = Cuckoo's Nest
  81+ 6C32              ;   8 = Inside The Mega Trunk
  82+ 6C32              ;   9 = On A Branch Over The Drive
  83+ 6C32              ;   33 = The Bathroom
  84+ 6C32              ;   35 = Master Bedroom
  85+ 6C32              ;
  86+ 6C32              ; Se nessuna stanza corrisponde viene impostato:
  87+ 6C32              ;   current_room = 0
  88+ 6C32              ; -------------------------------------------------------------------
