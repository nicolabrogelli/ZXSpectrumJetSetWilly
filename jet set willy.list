 255+ 64EF 23               inc  hl
 256+ 64F0
 257+ 64F0 66               ld   h, (hl)           ; H = Y iniziale
 258+ 64F1
 259+ 64F1 6F               ld   l, a              ; HL = (Y, X)
 260+ 64F2
 261+ 64F2                  ; ---------------------------------------------------------------
 262+ 64F2                  ; Salva posizione corrente e posizione precedente
 263+ 64F2                  ; ---------------------------------------------------------------
 264+ 64F2 22 B3 7A         ld   (PlayerPos), hl
 265+ 64F5 22 B5 7A         ld   (PlayerPosOld), hl
