1867+ 85B9 20 44            jr   nz, .next_no_inc
1868+ 85BB
1869+ 85BB                  ; ---------------------------------------------------------------
1870+ 85BB                  ; Test collisione Willy ↔ Item
1871+ 85BB                  ;
1872+ 85BB                  ; Input richiesto:
1873+ 85BB                  ;   A = ItemX
1874+ 85BB                  ;   H = ItemY
1875+ 85BB                  ; ---------------------------------------------------------------
