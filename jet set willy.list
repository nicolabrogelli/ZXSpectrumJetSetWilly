   8+ 75AC              ; Audio_UpdateJumpSound
   9+ 75AC              ;
  10+ 75AC              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 75AC              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 75AC              ; -------------------------------------------------------------------
  13+ 75AC              Audio_UpdateJumpSound:
  14+ 75AC F5               push af
  15+ 75AD C5               push bc
  16+ 75AE D5               push de
  17+ 75AF E5               push hl
  18+ 75B0
  19+ 75B0                  ; Controlla se il suono è attivo (note < 18)
  20+ 75B0 3A 43 7A         ld   a, (Audio_jump_sound_note)
  21+ 75B3 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 75B5 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 75B7
  24+ 75B7                  ; Carica la nota corrente da suonare
  25+ 75B7 5F               ld   e, a
  26+ 75B8 16 00            ld   d, 0
  27+ 75BA 21 E6 75         ld   hl, Audio_JumpSoundDelays
  28+ 75BD 19               add  hl, de
  29+ 75BE 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 75BF 57               ld   d, a                      ; D = delay della nota
  31+ 75C0
  32+ 75C0                  ; Suona la nota: 15 cicli
  33+ 75C0 06 0F            ld   b, 15
  34+ 75C2              .note_loop:
  35+ 75C2                  ; Speaker ON
  36+ 75C2 3A D5 76         ld   a, (room_border_color)
  37+ 75C5 F6 10            or   $10
  38+ 75C7 D3 FE            out  ($fe), a
  39+ 75C9 4A               ld   c, d
  40+ 75CA              .d1:
  41+ 75CA 0D               dec  c
  42+ 75CB 20 FD            jr   nz, .d1
  43+ 75CD
  44+ 75CD                  ; Speaker OFF
  45+ 75CD 3A D5 76         ld   a, (room_border_color)
  46+ 75D0 E6 EF            and  $ef
  47+ 75D2 D3 FE            out  ($fe), a
  48+ 75D4 4A               ld   c, d
  49+ 75D5              .d2:
  50+ 75D5 0D               dec  c
  51+ 75D6 20 FD            jr   nz, .d2
  52+ 75D8
  53+ 75D8 10 E8            djnz .note_loop
  54+ 75DA
  55+ 75DA                  ; Passa alla nota successiva
  56+ 75DA 3A 43 7A         ld   a, (Audio_jump_sound_note)
  57+ 75DD 3C               inc  a
  58+ 75DE 32 43 7A         ld   (Audio_jump_sound_note), a
  59+ 75E1
  60+ 75E1              .done:
  61+ 75E1 E1               pop  hl
  62+ 75E2 D1               pop  de
  63+ 75E3 C1               pop  bc
  64+ 75E4 F1               pop  af
  65+ 75E5 C9               ret
