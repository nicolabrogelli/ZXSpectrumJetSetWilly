 186  8376                  IF ENABLE_GAME_OVER_RESTART != 0
 187  8376 C3 E9 83         jp   TriggerGameOver
 188  8379                  ELSE
 189  8379 ~                ld   a, 1
 190  8379 ~                ld   (willy_lives), a
 191  8379 ~                jr   .normal_respawn
 192  8379                  ENDIF
 193  8379
 194  8379              .normal_respawn:
 195  8379                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 196  8379 AF               xor  a
 197  837A D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 198  837C 21 8D 5C         ld   hl, ATTR_P
 199  837F 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 200  8380 CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 201  8383 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 202  8385 3E 07            ld   a, $07
 203  8387 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 204  838A
 205  838A                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 206  838A 06 19            ld   b, 25
 207  838C              .death_pause:
 208  838C 76               halt
 209  838D 10 FD            djnz .death_pause
 210  838F
 211  838F                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 212  838F AF               xor  a
 213  8390 32 24 E7         ld   (velocity_y), a
 214  8393 32 26 E7         ld   (jump_pressed), a
 215  8396 32 28 E7         ld   (coyote_timer), a
 216  8399 32 2B E7         ld   (jump_frame), a
 217  839C 32 2A E7         ld   (jump_dir), a
 218  839F 3E 01            ld   a, 1
 219  83A1 32 25 E7         ld   (on_ground), a
 220  83A4
 221  83A4 3E 32            ld   a, RESPAWN_SAFETY_TIME
 222  83A6 32 20 EB         ld   (willy_safety_timer), a
 223  83A9
 224  83A9                  ; 5. Riposiziona Willy nel punto di ingresso dell'ultima stanza raggiunta
 225  83A9 CD 86 7C         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 226  83AC 21 9D EA         ld   hl, room_entry_positions
 227  83AF 5F               ld   e, a
 228  83B0 16 00            ld   d, 0
 229  83B2 19               add  hl, de
 230  83B3 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 231  83B4 4E               ld   c, (hl)                   ; C = X ingresso
 232  83B5 23               inc  hl
 233  83B6 46               ld   b, (hl)                   ; B = Y ingresso
 234  83B7 ED 43 16 E7      ld   (PlayerPos), bc           ; Imposta le coordinate di respawn al punto di ingresso
 235  83BB ED 43 18 E7      ld   (PlayerPosOld), bc
 236  83BF
 237  83BF 3E 01            ld   a, 1
 238  83C1 32 9C EA         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 239  83C4
 240  83C4                  ; 6. Ridisegna completamente la stanza e riposiziona Willy nel punto di ingresso
 241  83C4 C3 D1 82         jp   LoadRoomAndRestart
 242  83C7
 243  83C7              .draw_raster_bars:
 244  83C7                  ; Collisione attiva: disegna le raster bar nel bordo
 245  83C7 3A 37 E7         ld   a, (counter)
 246  83CA E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 247  83CC 06 1E            ld   b, 30             ; Numero di righe della barra raster
 248  83CE              .raster_loop:
 249  83CE D3 FE            out  ($fe), a
 250  83D0 3C               inc  a
 251  83D1 E6 07            and  7
 252  83D3 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 253  83D5              .delay:
 254  83D5 0D               dec  c
 255  83D6 20 FD            jr   nz, .delay
 256  83D8 10 F4            djnz .raster_loop
 257  83DA
 258  83DA                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 259  83DA 3A 22 E7         ld   a, (room_border_color)
 260  83DD D3 FE            out  ($fe), a
 261  83DF 18 05            jr   .no_collision_change
 262  83E1
 263  83E1              .no_collision:
 264  83E1                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 265  83E1 3A 22 E7         ld   a, (room_border_color)
 266  83E4 D3 FE            out  ($fe), a
 267  83E6
 268  83E6              .no_collision_change:
 269  83E6 C3 17 83         jp   Main_loop
 270  83E9
 271  83E9              ; -------------------------------------------------------------------
 272  83E9              ; TriggerGameOver
 273  83E9              ; Scatena la schermata di Game Over per la stanza corrente.
 274  83E9              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 275  83E9              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 276  83E9              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 277  83E9              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 278  83E9              ; - Premendo ENTER, ripristina integralmente la partita ed avvia la nuova
 279  83E9              ;   sessione dal primo livello (Stanza 0: The Off Licence) alle 07:00 AM.
 280  83E9              ; -------------------------------------------------------------------
 281  83E9              TriggerGameOver:
 282  83E9                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede e della scritta GAME OVER
 283  83E9 CD 67 61         call Gfx_DrawGameOverScreen
 284  83EC
 285  83EC                  ; 2. Attende il rilascio del tasto ENTER se era già premuto
 286  83EC              .wait_enter_release:
 287  83EC 76               halt
 288  83ED 3E BF            ld   a, $bf
 289  83EF DB FE            in   a, ($fe)
 290  83F1 1F               rra
 291  83F2 30 F8            jr   nc, .wait_enter_release
 292  83F4
 293  83F4                  ; 3. Attesa della pressione del tasto ENTER con animazione ciclo colore su GAME OVER (Riga 5, Col 11)
 294  83F4 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 295  83F6              .wait_enter_press:
 296  83F6 76               halt
 297  83F7
 298  83F7                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 299  83F7 0C               inc  c
 300  83F8 79               ld   a, c
 301  83F9 CB 3F            srl  a
 302  83FB CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 303  83FD E6 07            and  7
 304  83FF 5F               ld   e, a
 305  8400 16 00            ld   d, 0
 306  8402 21 5F 61         ld   hl, game_over_color_table
 307  8405 19               add  hl, de
 308  8406 7E               ld   a, (hl)               ; A = nuovo colore attributo
 309  8407 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 310  840A 06 09            ld   b, 9
 311  840C              .color_cycle_loop:
 312  840C 77               ld   (hl), a
 313  840D 23               inc  hl
 314  840E 10 FC            djnz .color_cycle_loop
 315  8410
 316  8410                  ; Controlla se il tasto ENTER è premuto
 317  8410 3E BF            ld   a, $bf
 318  8412 DB FE            in   a, ($fe)
 319  8414 1F               rra
 320  8415 38 DF            jr   c, .wait_enter_press
 321  8417
 322  8417                  ; 4. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 323  8417 CD 1D 84         call ResetFullGameState
 324  841A
 325  841A                  ; 5. Avvia la nuova partita dal primo livello (Stanza 0: The Off Licence)
 326  841A C3 D1 82         jp   LoadRoomAndRestart
 327  841D
 328  841D              ; -------------------------------------------------------------------
 329  841D              ; ResetFullGameState
 330  841D              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 331  841D              ; per l'avvio di una nuova partita dopo il Game Over.
 332  841D              ; -------------------------------------------------------------------
 333  841D              ResetFullGameState:
 334  841D                  ; Ripristina gli attributi schermo di default (Inchiostro Bianco, Sfondo Nero)
 335  841D 21 8D 5C         ld   hl, ATTR_P
 336  8420 36 07            ld   (hl), $07
 337  8422 3E 07            ld   a, $07
 338  8424 32 8F 5C         ld   (ATTR_T), a
 339  8427
 340  8427                  ; Ripristina il numero di vite iniziali
 341  8427 3E 07            ld   a, INITIAL_LIVES
 342  8429 32 23 E7         ld   (willy_lives), a
 343  842C
 344  842C                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 345  842C AF               xor  a
 346  842D 32 20 E7         ld   (items_collected), a
 347  8430 32 1C E7         ld   (body_state), a
 348  8433 32 2F E7         ld   (w_warp_state), a
 349  8436 32 32 E7         ld   (w_key_prev), a
 350  8439 32 33 E7         ld   (enter_key_prev), a
 351  843C 32 24 E7         ld   (velocity_y), a
 352  843F 32 26 E7         ld   (jump_pressed), a
 353  8442 32 28 E7         ld   (coyote_timer), a
 354  8445 32 2B E7         ld   (jump_frame), a
 355  8448 32 2A E7         ld   (jump_dir), a
 356  844B 32 9C EA         ld   (transition_active), a
 357  844E 32 20 EB         ld   (willy_safety_timer), a
 358  8451 3E FF            ld   a, $ff
 359  8453 32 34 E7         ld   (digit_key_prev), a
 360  8456 3E 01            ld   a, 1
 361  8458 32 2D E7         ld   (q_prev), a
 362  845B 32 2E E7         ld   (a_prev), a
 363  845E 32 25 E7         ld   (on_ground), a
 364  8461
 365  8461                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 366  8461 3E 30            ld   a, '0'
 367  8463 32 0C 64         ld   (status_line + 16), a
 368  8466 32 0D 64         ld   (status_line + 17), a
 369  8469 32 0E 64         ld   (status_line + 18), a
 370  846C
 371  846C                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 372  846C CD 60 80         call ResetItemsTable
 373  846F
 374  846F                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 375  846F CD CA 68         call InitRoomEntryPositions
 376  8472
 377  8472                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 378  8472 3E 07            ld   a, 7
 379  8474 32 23 EB         ld   (time_hours), a
 380  8477 AF               xor  a
 381  8478 32 24 EB         ld   (time_minutes), a
 382  847B 32 25 EB         ld   (time_period), a       ; 0 = AM
 383  847E 32 28 EB         ld   (game_objective_completed), a
 384  8481 2A 37 E7         ld   hl, (counter)
 385  8484 22 26 EB         ld   (time_last_counter), hl
 386  8487 CD 7E 63         call Gfx_UpdateTimeDisplay
 387  848A
 388  848A                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 389  848A 21 F0 84         ld   hl, TheOffLicenceLayout
 390  848D 22 96 EA         ld   (room_ptr), hl
 391  8490
 392  8490 C9               ret
 393  8491
 394  8491              ; -------------------------------------------------------------------
 395  8491              ; Time_UpdateClock
 396  8491              ; Gestisce lo scorrimento del tempo durante il gioco.
 397  8491              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 398  8491              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 399  8491              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 400  8491              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 401  8491              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 402  8491              ; sia completato, scatena immediatamente il Game Over.
 403  8491              ; -------------------------------------------------------------------
 404  8491              Time_UpdateClock:
 405  8491                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 406  8491 2A 37 E7         ld   hl, (counter)
 407  8494 ED 5B 26 EB      ld   de, (time_last_counter)
 408  8498 B7               or   a
 409  8499 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 410  849B
 411  849B                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 412  849B 11 32 00         ld   de, CLOCK_TICKS_PER_MINUTE
 413  849E B7               or   a
 414  849F ED 52            sbc  hl, de
 415  84A1 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 416  84A2
 417  84A2                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 418  84A2 2A 26 EB         ld   hl, (time_last_counter)
 419  84A5 11 32 00         ld   de, CLOCK_TICKS_PER_MINUTE
 420  84A8 19               add  hl, de
 421  84A9 22 26 EB         ld   (time_last_counter), hl
 422  84AC
 423  84AC                  ; Incrementa di 1 minuto il tempo di gioco
 424  84AC 3A 24 EB         ld   a, (time_minutes)
 425  84AF 3C               inc  a
 426  84B0 FE 3C            cp   60
 427  84B2 38 21            jr   c, .minutes_ok
 428  84B4
 429  84B4                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 430  84B4 AF               xor  a
 431  84B5 32 24 EB         ld   (time_minutes), a
 432  84B8 3A 23 EB         ld   a, (time_hours)
 433  84BB 3C               inc  a
 434  84BC FE 0C            cp   12
 435  84BE 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 436  84C0 FE 0D            cp   13
 437  84C2 38 0E            jr   c, .hours_ok
 438  84C4 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 439  84C6 18 0A            jr   .hours_ok
 440  84C8
 441  84C8              .toggle_period:
 442  84C8 F5               push af                     ; Salva A (valore 12)
 443  84C9 3A 25 EB         ld   a, (time_period)
 444  84CC EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 445  84CE 32 25 EB         ld   (time_period), a
 446  84D1 F1               pop  af                     ; Ripristina A = 12
 447  84D2
 448  84D2              .hours_ok:
 449  84D2 32 23 EB         ld   (time_hours), a
 450  84D5
 451  84D5              .minutes_ok:
 452  84D5 32 24 EB         ld   (time_minutes), a
 453  84D8
 454  84D8                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 455  84D8 CD 7E 63         call Gfx_UpdateTimeDisplay
 456  84DB
 457  84DB                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 458  84DB 3A 28 EB         ld   a, (game_objective_completed)
 459  84DE B7               or   a
 460  84DF C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 461  84E0
 462  84E0                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 463  84E0 3A 25 EB         ld   a, (time_period)
 464  84E3 B7               or   a
 465  84E4 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 466  84E5
 467  84E5 3A 23 EB         ld   a, (time_hours)
 468  84E8 FE 0C            cp   12
 469  84EA 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
 470  84EC C9               ret
 471  84ED
 472  84ED              .time_limit_reached:
 473  84ED                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
 474  84ED                  ; Scatena immediatamente il Game Over temporale!
 475  84ED C3 E9 83         jp   TriggerGameOver
