 973+ 7ED8
 974+ 7ED8              .vert_up:
 975+ 7ED8 DD 7E 03         ld   a, (ix+3)         ; Current Y
 976+ 7EDB D6 02            sub  2                 ; Muovi in alto di 2 pixel
 977+ 7EDD DD BE 04         cp   (ix+4)            ; Min Limit (Top)
 978+ 7EE0 28 08            jr   z, .v_rev_down
 979+ 7EE2 38 06            jr   c, .v_rev_down
 980+ 7EE4 DD 77 03         ld   (ix+3), a
 981+ 7EE7 C3 15 7F         jp   .next
