  76+ 6E8A              ;    3 = At The Foot Of The Mega Tree
  77+ 6E8A              ;    4 = The Drive
  78+ 6E8A              ;    5 = The Security Guard
  79+ 6E8A              ;    6 = Entrance To Hades
  80+ 6E8A              ;    7 = Cuckoo's Nest
  81+ 6E8A              ;    8 = Inside The Mega Trunk
  82+ 6E8A              ;    9 = On A Branch Over The Drive
  83+ 6E8A              ;   10 = The Front Door
