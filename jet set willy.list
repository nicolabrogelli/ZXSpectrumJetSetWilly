 687+ 6A94 BB               cp   e
 688+ 6A95 28 04            jr   z, .check_ramp    ; c == len (fuori)
 689+ 6A97 38 02            jr   c, .check_ramp    ; c > len (fuori)
 690+ 6A99              .is_conveyor:
 691+ 6A99 18 30            jr   .solid
