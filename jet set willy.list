 552  8B0D              ; -------------------------------------------------------------------
 553  8B0D              ; TriggerVictory
 554  8B0D              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 555  8B0D              ; - Pulisce gli elementi di gioco della stanza.
 556  8B0D              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 557  8B0D              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 558  8B0D              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 559  8B0D              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 560  8B0D              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 561  8B0D              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 562  8B0D              ; -------------------------------------------------------------------
 563  8B0D              TriggerVictory:
 564  8B0D                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 565  8B0D CD 15 66         call Gfx_DrawVictoryScreen
 566  8B10
 567  8B10                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 568  8B10              .wait_keys_release:
 569  8B10 76               halt
 570  8B11                  ; Controlla tasto Y (Porta $DF, bit 4)
 571  8B11 01 FE DF         ld   bc, $dffe
 572  8B14 ED 78            in   a, (c)
 573  8B16 CB 67            bit  4, a
 574  8B18 28 F6            jr   z, .wait_keys_release
 575  8B1A
 576  8B1A                  ; Controlla tasto N (Porta $7F, bit 3)
 577  8B1A 01 FE 7F         ld   bc, $7ffe
 578  8B1D ED 78            in   a, (c)
 579  8B1F CB 5F            bit  3, a
 580  8B21 28 ED            jr   z, .wait_keys_release
 581  8B23
 582  8B23                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 583  8B23 01 FE BF         ld   bc, $bffe
 584  8B26 ED 78            in   a, (c)
 585  8B28 CB 47            bit  0, a
 586  8B2A 28 E4            jr   z, .wait_keys_release
 587  8B2C
 588  8B2C                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 589  8B2C 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 590  8B2E              .wait_choice_loop:
 591  8B2E 76               halt
 592  8B2F
 593  8B2F                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 594  8B2F 0C               inc  c
 595  8B30 79               ld   a, c
 596  8B31 CB 3F            srl  a
 597  8B33 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 598  8B35 E6 07            and  7
 599  8B37 5F               ld   e, a
 600  8B38 16 00            ld   d, 0
 601  8B3A 21 F4 64         ld   hl, victory_color_table
 602  8B3D 19               add  hl, de
 603  8B3E 7E               ld   a, (hl)               ; A = nuovo colore attributo
 604  8B3F 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 605  8B42 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 606  8B44              .color_cycle_loop:
 607  8B44 77               ld   (hl), a
 608  8B45 23               inc  hl
 609  8B46 10 FC            djnz .color_cycle_loop
 610  8B48
 611  8B48                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 612  8B48 01 FE DF         ld   bc, $dffe
 613  8B4B ED 78            in   a, (c)
 614  8B4D CB 67            bit  4, a
 615  8B4F 28 2A            jr   z, .play_again_chosen
 616  8B51
 617  8B51                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 618  8B51 01 FE 7F         ld   bc, $7ffe
 619  8B54 ED 78            in   a, (c)
 620  8B56 CB 5F            bit  3, a
 621  8B58 28 0B            jr   z, .quit_chosen
 622  8B5A
 623  8B5A                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 624  8B5A 01 FE BF         ld   bc, $bffe
 625  8B5D ED 78            in   a, (c)
 626  8B5F CB 47            bit  0, a
 627  8B61 28 02            jr   z, .quit_chosen
 628  8B63
 629  8B63 18 C9            jr   .wait_choice_loop
 630  8B65
 631  8B65              .quit_chosen:
 632  8B65                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 633  8B65              .wait_quit_release:
 634  8B65 76               halt
 635  8B66 01 FE 7F         ld   bc, $7ffe
 636  8B69 ED 78            in   a, (c)
 637  8B6B CB 5F            bit  3, a
 638  8B6D 28 F6            jr   z, .wait_quit_release
 639  8B6F 01 FE BF         ld   bc, $bffe
 640  8B72 ED 78            in   a, (c)
 641  8B74 CB 47            bit  0, a
 642  8B76 28 ED            jr   z, .wait_quit_release
 643  8B78
 644  8B78                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 645  8B78 C3 95 89         jp   ShowTitleScreen
 646  8B7B
 647  8B7B              .play_again_chosen:
 648  8B7B                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 649  8B7B              .wait_play_again_release:
 650  8B7B 76               halt
 651  8B7C 01 FE DF         ld   bc, $dffe
 652  8B7F ED 78            in   a, (c)
 653  8B81 CB 67            bit  4, a
 654  8B83 28 F6            jr   z, .wait_play_again_release
 655  8B85
 656  8B85                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 657  8B85 CD 45 8C         call ResetFullGameState
 658  8B88 C3 77 88         jp   LoadRoomAndRestart
 659  8B8B
 660  8B8B              ; -------------------------------------------------------------------
 661  8B8B              ; CheckVictoryCondition
 662  8B8B              ; Verifica se si verificano contemporaneamente tutte le 3 condizioni di vittoria:
 663  8B8B              ; 1. Willy ha raccolto tutti gli oggetti collezionabili del gioco (tutti i flag in ItemsTable = 1);
 664  8B8B              ; 2. Willy si trova nella stanza Master Bedroom;
 665  8B8B              ; 3. Willy collide con un oggetto/tag di tipo Conveyor in quella stanza.
 666  8B8B              ;
 667  8B8B              ; Output:
 668  8B8B              ;   Carry Flag = 1 se la vittoria è attivata
 669  8B8B              ;   Carry Flag = 0 altrimenti
 670  8B8B              ; -------------------------------------------------------------------
 671  8B8B              CheckVictoryCondition:
 672  8B8B C5               push bc
 673  8B8C D5               push de
 674  8B8D E5               push hl
 675  8B8E
 676  8B8E                  ; 1. Condizione: tutti gli item raccolti?
 677  8B8E CD A7 8B         call CheckAllItemsCollected
 678  8B91 30 0F            jr   nc, .no_victory
 679  8B93
 680  8B93                  ; 2. Condizione: Willy è nella Master Bedroom?
 681  8B93 CD CE 8B         call CheckInMasterBedroom
 682  8B96 30 0A            jr   nc, .no_victory
 683  8B98
 684  8B98                  ; 3. Condizione: Willy collide con il conveyor?
 685  8B98 CD EA 8B         call CheckWillyConveyorCollision
 686  8B9B 30 05            jr   nc, .no_victory
 687  8B9D
 688  8B9D                  ; Tutte le condizioni sono soddisfatte contemporaneamente!
 689  8B9D E1               pop  hl
 690  8B9E D1               pop  de
 691  8B9F C1               pop  bc
 692  8BA0 37               scf
 693  8BA1 C9               ret
 694  8BA2
 695  8BA2              .no_victory:
 696  8BA2 E1               pop  hl
 697  8BA3 D1               pop  de
 698  8BA4 C1               pop  bc
 699  8BA5 B7               or   a
 700  8BA6 C9               ret
 701  8BA7
 702  8BA7              ; -------------------------------------------------------------------
 703  8BA7              ; CheckAllItemsCollected
 704  8BA7              ; Verifica che tutti gli item del gioco siano stati raccolti.
 705  8BA7              ; - Controllo preliminare sul conteggio/flag globale
 706  8BA7              ; - Verifica puntuale che ogni record in ItemsTable abbia flag = 1 (raccolto)
 707  8BA7              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 708  8BA7              ; -------------------------------------------------------------------
 709  8BA7              CheckAllItemsCollected:
 710  8BA7 E5               push hl
 711  8BA8 3A 57 F8         ld   a, (game_objective_completed)
 712  8BAB B7               or   a
 713  8BAC 20 07            jr   nz, .verify_flags
 714  8BAE 3A 4F F4         ld   a, (items_collected)
 715  8BB1 FE 4D            cp   TOTAL_ITEMS
 716  8BB3 38 16            jr   c, .not_all
 717  8BB5
 718  8BB5              .verify_flags:
 719  8BB5 21 AA 80         ld   hl, ItemsTable
 720  8BB8              .loop:
 721  8BB8 7E               ld   a, (hl)
 722  8BB9 FE FF            cp   $FF
 723  8BBB 28 0B            jr   z, .done_all
 724  8BBD 23               inc  hl                    ; +1 X
 725  8BBE 23               inc  hl                    ; +2 Y
 726  8BBF 23               inc  hl                    ; +3 Color
 727  8BC0 23               inc  hl                    ; +4 Collected flag
 728  8BC1 7E               ld   a, (hl)
 729  8BC2 B7               or   a
 730  8BC3 28 06            jr   z, .not_all           ; Trovato un item non raccolto -> fail
 731  8BC5 23               inc  hl                    ; Prossimo record
 732  8BC6 18 F0            jr   .loop
 733  8BC8
 734  8BC8              .done_all:
 735  8BC8 E1               pop  hl
 736  8BC9 37               scf
 737  8BCA C9               ret
 738  8BCB
 739  8BCB              .not_all:
 740  8BCB E1               pop  hl
 741  8BCC B7               or   a
 742  8BCD C9               ret
 743  8BCE
 744  8BCE              ; -------------------------------------------------------------------
 745  8BCE              ; CheckInMasterBedroom
 746  8BCE              ; Verifica se la stanza corrente è Master Bedroom (ID 35 / MastreBedRoomLayout)
 747  8BCE              ; Output: Carry = 1 se Master Bedroom, Carry = 0 altrimenti
 748  8BCE              ; -------------------------------------------------------------------
 749  8BCE              CheckInMasterBedroom:
 750  8BCE E5               push hl
 751  8BCF D5               push de
 752  8BD0 2A C5 F7         ld   hl, (room_ptr)
 753  8BD3 11 39 B4         ld   de, MastreBedRoomLayout
 754  8BD6 B7               or   a
 755  8BD7 ED 52            sbc  hl, de
 756  8BD9 28 0B            jr   z, .is_master
 757  8BDB 3A 6B F7         ld   a, (current_room)
 758  8BDE FE 23            cp   ROOM_MASTER_BEDROOM
 759  8BE0 28 04            jr   z, .is_master
 760  8BE2 D1               pop  de
 761  8BE3 E1               pop  hl
 762  8BE4 B7               or   a
 763  8BE5 C9               ret
 764  8BE6              .is_master:
 765  8BE6 D1               pop  de
 766  8BE7 E1               pop  hl
 767  8BE8 37               scf
 768  8BE9 C9               ret
 769  8BEA
 770  8BEA              ; -------------------------------------------------------------------
 771  8BEA              ; CheckWillyConveyorCollision
 772  8BEA              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 773  8BEA              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 774  8BEA              ; -------------------------------------------------------------------
 775  8BEA              CheckWillyConveyorCollision:
 776  8BEA C5               push bc
 777  8BEB D5               push de
 778  8BEC E5               push hl
 779  8BED
 780  8BED                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 781  8BED CD 41 76         call CheckWillyOnConveyor
 782  8BF0 38 49            jr   c, .collision_detected
 783  8BF2
 784  8BF2                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 785  8BF2 3A 6D F7         ld   a, (conveyor_len)
 786  8BF5 B7               or   a
 787  8BF6 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 788  8BF8
 789  8BF8                  ; B = WillyY, C = WillyX
 790  8BF8 ED 4B 45 F4      ld   bc, (PlayerPos)
 791  8BFC
 792  8BFC                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 793  8BFC 3A 6E F7         ld   a, (conveyor_row)
 794  8BFF 87               add  a, a                  ; *2
 795  8C00 87               add  a, a                  ; *4
 796  8C01 87               add  a, a                  ; *8
 797  8C02 5F               ld   e, a                  ; E = ConveyorTop
 798  8C03 C6 07            add  a, 7
 799  8C05 57               ld   d, a                  ; D = ConveyorBottom
 800  8C06
 801  8C06                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 802  8C06 78               ld   a, b                  ; WillyTop
 803  8C07 BA               cp   d
 804  8C08 28 04            jr   z, .y_overlap
 805  8C0A 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 806  8C0C 18 32            jr   .no_conv_collision
 807  8C0E
 808  8C0E              .y_overlap:
 809  8C0E C6 0F            add  a, 15                 ; WillyBottom
 810  8C10 BB               cp   e
 811  8C11 28 04            jr   z, .x_check
 812  8C13 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 813  8C15 18 29            jr   .no_conv_collision
 814  8C17
 815  8C17              .x_check:
 816  8C17                  ; ConveyorLeft = conveyor_col * 8
 817  8C17 3A 6F F7         ld   a, (conveyor_col)
 818  8C1A 87               add  a, a                  ; *2
 819  8C1B 87               add  a, a                  ; *4
 820  8C1C 87               add  a, a                  ; *8
 821  8C1D 5F               ld   e, a                  ; E = ConveyorLeft
 822  8C1E
 823  8C1E                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 824  8C1E 21 6D F7         ld   hl, conveyor_len
 825  8C21 3A 6F F7         ld   a, (conveyor_col)
 826  8C24 86               add  a, (hl)
 827  8C25 87               add  a, a                  ; *2
 828  8C26 87               add  a, a                  ; *4
 829  8C27 87               add  a, a                  ; *8
 830  8C28 3D               dec  a                     ; ConveyorRight
 831  8C29 57               ld   d, a                  ; D = ConveyorRight
 832  8C2A
 833  8C2A                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 834  8C2A 79               ld   a, c                  ; WillyLeft
 835  8C2B BA               cp   d
 836  8C2C 28 04            jr   z, .x_overlap
 837  8C2E 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 838  8C30 18 0E            jr   .no_conv_collision
 839  8C32
 840  8C32              .x_overlap:
 841  8C32 C6 0F            add  a, 15                 ; WillyRight
 842  8C34 BB               cp   e
 843  8C35 28 04            jr   z, .collision_detected
 844  8C37 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 845  8C39 18 05            jr   .no_conv_collision
 846  8C3B
 847  8C3B              .collision_detected:
 848  8C3B E1               pop  hl
 849  8C3C D1               pop  de
 850  8C3D C1               pop  bc
 851  8C3E 37               scf
 852  8C3F C9               ret
 853  8C40
 854  8C40              .no_conv_collision:
 855  8C40 E1               pop  hl
 856  8C41 D1               pop  de
 857  8C42 C1               pop  bc
 858  8C43 B7               or   a
 859  8C44 C9               ret
 860  8C45
 861  8C45              ; -------------------------------------------------------------------
 862  8C45              ; ResetFullGameState
 863  8C45              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 864  8C45              ; per l'avvio di una nuova partita dopo il Game Over.
 865  8C45              ; -------------------------------------------------------------------
 866  8C45              ResetFullGameState:
 867  8C45                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 868  8C45 AF               xor  a
 869  8C46 D3 FE            out  ($fe), a              ; Bordo a nero
 870  8C48 21 8D 5C         ld   hl, ATTR_P
 871  8C4B 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 872  8C4C CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 873  8C4F 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 874  8C51 3E 07            ld   a, $07
 875  8C53 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 876  8C56
 877  8C56                  ; Ripristina il numero di vite iniziali
 878  8C56 3E 07            ld   a, INITIAL_LIVES
 879  8C58 32 52 F4         ld   (willy_lives), a
 880  8C5B
 881  8C5B                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 882  8C5B AF               xor  a
 883  8C5C 32 4F F4         ld   (items_collected), a
 884  8C5F 32 4B F4         ld   (body_state), a
 885  8C62 32 5E F4         ld   (w_warp_state), a
 886  8C65 32 61 F4         ld   (w_key_prev), a
 887  8C68 32 62 F4         ld   (enter_key_prev), a
 888  8C6B 32 53 F4         ld   (velocity_y), a
 889  8C6E 32 55 F4         ld   (jump_pressed), a
 890  8C71 32 57 F4         ld   (coyote_timer), a
 891  8C74 32 5A F4         ld   (jump_frame), a
 892  8C77 32 59 F4         ld   (jump_dir), a
 893  8C7A 32 CB F7         ld   (transition_active), a
 894  8C7D 32 4F F8         ld   (willy_safety_timer), a
 895  8C80 3E FF            ld   a, $ff
 896  8C82 32 63 F4         ld   (digit_key_prev), a
 897  8C85 3E 01            ld   a, 1
 898  8C87 32 5C F4         ld   (q_prev), a
 899  8C8A 32 5D F4         ld   (a_prev), a
 900  8C8D 32 54 F4         ld   (on_ground), a
 901  8C90
 902  8C90                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 903  8C90 3E 30            ld   a, '0'
 904  8C92 32 F9 68         ld   (status_line + 16), a
 905  8C95 32 FA 68         ld   (status_line + 17), a
 906  8C98 32 FB 68         ld   (status_line + 18), a
 907  8C9B
 908  8C9B                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 909  8C9B CD 06 86         call ResetItemsTable
 910  8C9E
 911  8C9E                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 912  8C9E CD 21 6E         call InitRoomEntryPositions
 913  8CA1
 914  8CA1                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 915  8CA1 3E 07            ld   a, 7
 916  8CA3 32 52 F8         ld   (time_hours), a
 917  8CA6 AF               xor  a
 918  8CA7 32 53 F8         ld   (time_minutes), a
 919  8CAA 32 54 F8         ld   (time_period), a       ; 0 = AM
 920  8CAD 32 57 F8         ld   (game_objective_completed), a
 921  8CB0 2A 66 F4         ld   hl, (counter)
 922  8CB3 22 55 F8         ld   (time_last_counter), hl
 923  8CB6 CD 6B 68         call Gfx_UpdateTimeDisplay
 924  8CB9
 925  8CB9                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 926  8CB9 21 FD B1         ld   hl, TheBathroomLayout; TheOffLicenceLayout
 927  8CBC 22 C5 F7         ld   (room_ptr), hl
 928  8CBF
 929  8CBF C9               ret
 930  8CC0
 931  8CC0              ; -------------------------------------------------------------------
 932  8CC0              ; Time_UpdateClock
 933  8CC0              ; Gestisce lo scorrimento del tempo durante il gioco.
 934  8CC0              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 935  8CC0              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 936  8CC0              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 937  8CC0              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 938  8CC0              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 939  8CC0              ; sia completato, scatena immediatamente il Game Over.
 940  8CC0              ; -------------------------------------------------------------------
 941  8CC0              Time_UpdateClock:
 942  8CC0                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 943  8CC0 2A 66 F4         ld   hl, (counter)
 944  8CC3 ED 5B 55 F8      ld   de, (time_last_counter)
 945  8CC7 B7               or   a
 946  8CC8 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 947  8CCA
 948  8CCA                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 949  8CCA 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 950  8CCD B7               or   a
 951  8CCE ED 52            sbc  hl, de
 952  8CD0 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 953  8CD1
 954  8CD1                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 955  8CD1 2A 55 F8         ld   hl, (time_last_counter)
 956  8CD4 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 957  8CD7 19               add  hl, de
 958  8CD8 22 55 F8         ld   (time_last_counter), hl
 959  8CDB
 960  8CDB                  ; Incrementa di 1 minuto il tempo di gioco
 961  8CDB 3A 53 F8         ld   a, (time_minutes)
 962  8CDE 3C               inc  a
 963  8CDF FE 3C            cp   60
 964  8CE1 38 21            jr   c, .minutes_ok
 965  8CE3
 966  8CE3                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 967  8CE3 AF               xor  a
 968  8CE4 32 53 F8         ld   (time_minutes), a
 969  8CE7 3A 52 F8         ld   a, (time_hours)
 970  8CEA 3C               inc  a
 971  8CEB FE 0C            cp   12
 972  8CED 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 973  8CEF FE 0D            cp   13
 974  8CF1 38 0E            jr   c, .hours_ok
 975  8CF3 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 976  8CF5 18 0A            jr   .hours_ok
 977  8CF7
 978  8CF7              .toggle_period:
 979  8CF7 F5               push af                     ; Salva A (valore 12)
 980  8CF8 3A 54 F8         ld   a, (time_period)
 981  8CFB EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 982  8CFD 32 54 F8         ld   (time_period), a
 983  8D00 F1               pop  af                     ; Ripristina A = 12
 984  8D01
 985  8D01              .hours_ok:
 986  8D01 32 52 F8         ld   (time_hours), a
 987  8D04
 988  8D04              .minutes_ok:
 989  8D04 32 53 F8         ld   (time_minutes), a
 990  8D07
 991  8D07                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 992  8D07 CD 6B 68         call Gfx_UpdateTimeDisplay
 993  8D0A
 994  8D0A                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 995  8D0A 3A 57 F8         ld   a, (game_objective_completed)
 996  8D0D B7               or   a
 997  8D0E C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 998  8D0F
 999  8D0F                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
1000  8D0F 3A 54 F8         ld   a, (time_period)
1001  8D12 B7               or   a
1002  8D13 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
1003  8D14
1004  8D14 3A 52 F8         ld   a, (time_hours)
1005  8D17 FE 0C            cp   12
1006  8D19 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1007  8D1B C9               ret
1008  8D1C
