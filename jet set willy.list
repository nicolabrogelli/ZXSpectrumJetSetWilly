 345  8746              ; -------------------------------------------------------------------
 346  8746              ; TriggerGameOver
 347  8746              ; Scatena la schermata di Game Over per la stanza corrente.
 348  8746              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 349  8746              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 350  8746              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 351  8746              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 352  8746              ; - Premendo ENTER, riporta il giocatore alla schermata iniziale (Title Screen).
 353  8746              ; -------------------------------------------------------------------
 354  8746              TriggerGameOver:
 355  8746                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede e della scritta GAME OVER
 356  8746 CD 75 64         call Gfx_DrawGameOverScreen
 357  8749
 358  8749                  ; 2. Attende il rilascio del tasto ENTER se era già premuto
 359  8749              .wait_enter_release:
 360  8749 76               halt
 361  874A 3E BF            ld   a, $bf
 362  874C DB FE            in   a, ($fe)
 363  874E 1F               rra
 364  874F 30 F8            jr   nc, .wait_enter_release
 365  8751
 366  8751                  ; 3. Attesa della pressione del tasto ENTER con animazione ciclo colore su GAME OVER (Riga 5, Col 11)
 367  8751 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 368  8753              .wait_enter_press:
 369  8753 76               halt
 370  8754
 371  8754                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 372  8754 0C               inc  c
 373  8755 79               ld   a, c
 374  8756 CB 3F            srl  a
 375  8758 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 376  875A E6 07            and  7
 377  875C 5F               ld   e, a
 378  875D 16 00            ld   d, 0
 379  875F 21 6D 64         ld   hl, game_over_color_table
 380  8762 19               add  hl, de
 381  8763 7E               ld   a, (hl)               ; A = nuovo colore attributo
 382  8764 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 383  8767 06 09            ld   b, 9
 384  8769              .color_cycle_loop:
 385  8769 77               ld   (hl), a
 386  876A 23               inc  hl
 387  876B 10 FC            djnz .color_cycle_loop
 388  876D
 389  876D                  ; Controlla se il tasto ENTER è premuto
 390  876D 3E BF            ld   a, $bf
 391  876F DB FE            in   a, ($fe)
 392  8771 1F               rra
 393  8772 38 DF            jr   c, .wait_enter_press
 394  8774
 395  8774                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 396  8774              .wait_enter_release_after:
