 249+ 5EDD 18 04            jr   .compare_col
 250+ 5EDF              .r_left:
 251+ 5EDF 3A FD 7A         ld   a, (ramp_col)
 252+ 5EE2 90               sub  b                 ; A = ramp_col - B
 253+ 5EE3              .compare_col:
