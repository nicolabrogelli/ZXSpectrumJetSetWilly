   4+ 6AAF
   5+ 6AAF              ; -------------------------------------------------------------------
   6+ 6AAF              ; Tabella Globale degli Oggetti (Items)
   7+ 6AAF              ; Ciascun item occupa 5 byte:
   8+ 6AAF              ;   Byte 0: ID della stanza (0 = Test Room, 1 = The Bridge, 2 = The Off Licence, 3 = Master Bedroom, 4 = Under the MegaTree, 5 = At TheFoot The Mega Tree, 6 = The Drive, 7 = The Security Guard)
   9+ 6AAF              ;   Byte 1: X colonna dello schermo (0..31)
  10+ 6AAF              ;   Byte 2: Y riga dello schermo (3..18)
  11+ 6AAF              ;   Byte 3: Attributo colore (es. $C6 per Giallo Flashing, $C5 per Cyan Flashing)
  12+ 6AAF              ;   Byte 4: Stato (0 = Attivo/Non raccolto, 1 = Raccolto)
  13+ 6AAF              ; La tabella termina con $FF
  14+ 6AAF              ;
  15+ 6AAF              ; La tabella riposrta solamente le stanza in cui effettivamente ci sono degli oggetti le altre sono omesse
  16+ 6AAF              ;
  17+ 6AAF              ; Tabella dei colori, se aggiungiamo $C davanti al colore questo diventa lampeggiante
  18+ 6AAF              ; 1 - BLUE
  19+ 6AAF              ; 2 - RED
  20+ 6AAF              ; 3 - MAGENTA
  21+ 6AAF              ; 4 - GREEN
  22+ 6AAF              ; 5 - CYAN
  23+ 6AAF              ; 6 - YELLOW
  24+ 6AAF              ; 7 - WHITE
  25+ 6AAF              ; -------------------------------------------------------------------
  26+ 6AAF              ItemsTable:
  27+ 6AAF                  ; Stanza 0 (The Test Room)
  28+ 6AAF 00 0F 0E C2      db 0, 15, 14, RED_FLASH, 0          ; Oggetto 1 alla colonna X=15, riga Y=14, RED FLASH, (Stato: 0=attivo)
  28+ 6AB3 00
  29+ 6AB4
  30+ 6AB4                  ; Stanza 1 (The Bridge)
  31+ 6AB4
  32+ 6AB4                  ; Stanza 2 (The Off Licence)
  33+ 6AB4 02 1E 04 06      db 2, 30, 4, YELLOW, 0              ; Oggetto 1 alla colonna X=30,  riga Y=4, YELLOW, (Stato: 0=attivo)
  33+ 6AB8 00
  34+ 6AB9 02 1D 04 05      db 2, 29, 4, CYAN, 0                ; Oggetto 2 alla colonna X=29,  riga Y=4, CYAN, (Stato: 0=attivo)
  34+ 6ABD 00
  35+ 6ABE 02 1C 04 04      db 2, 28, 4, GREEN, 0               ; Oggetto 4 alla colonna X=28,  riga Y=4, GREEN, (Stato: 0=attivo)
  35+ 6AC2 00
  36+ 6AC3 02 1B 04 03      db 2, 27, 4, MAGENTA, 0             ; Oggetto 5 alla colonna X=27,  riga Y=4, GREEN, (Stato: 0=attivo)
  36+ 6AC7 00
  37+ 6AC8 02 1A 04 06      db 2, 26, 4, YELLOW, 0              ; Oggetto 6 alla colonna X=26,  riga Y=4, YELLOW, (Stato: 0=attivo)
  37+ 6ACC 00
  38+ 6ACD 02 19 04 05      db 2, 25, 4, CYAN, 0                ; Oggetto 7 alla colonna X=25,  riga Y=4, CYAN, (Stato: 0=attivo)
  38+ 6AD1 00
  39+ 6AD2 02 18 04 04      db 2, 24, 4, GREEN, 0               ; Oggetto 8 alla colonna X=24,  riga Y=4, GREEN, (Stato: 0=attivo)
  39+ 6AD6 00
  40+ 6AD7 02 17 04 03      db 2, 23, 4, MAGENTA, 0             ; Oggetto 9 alla colonna X=23,  riga Y=4, MAGENTA, (Stato: 0=attivo)
  40+ 6ADB 00
  41+ 6ADC 02 16 04 06      db 2, 22, 4, YELLOW, 0              ; Oggetto 10 alla colonna X=22, riga Y=4, YELLOW, (Stato: 0=attivo)
  41+ 6AE0 00
  42+ 6AE1 02 15 04 05      db 2, 21, 4, CYAN, 0                ; Oggetto 11 alla colonna X=21, riga Y=4, CYAN, (Stato: 0=attivo)
  42+ 6AE5 00
  43+ 6AE6 02 14 04 04      db 2, 20, 4, GREEN, 0               ; Oggetto 12 alla colonna X=20, riga Y=4, GREEN, (Stato: 0=attivo)
  43+ 6AEA 00
  44+ 6AEB 02 13 04 03      db 2, 19, 4, MAGENTA, 0             ; Oggetto 13 alla colonna X=19, riga Y=4, MAGENTA, (Stato: 0=attivo)
  44+ 6AEF 00
  45+ 6AF0
  46+ 6AF0                  ; Stanza 3 (The Bridge)
  47+ 6AF0
  48+ 6AF0                  ; Stanza 4 (Under the MegaTree)
  49+ 6AF0 04 16 00 03      db 4, 22, 0, MAGENTA, 0             ; Oggetto 1 alla colonna X=22, riga Y=0, MAGENTA, (Stato: 0=attivo)
  49+ 6AF4 00
  50+ 6AF5
  51+ 6AF5                  ; Stanza 5 (At The Foot TheMega Tree)
  52+ 6AF5 05 01 0B 03      db 5, 1, 11, MAGENTA, 0             ; Oggetto 1 alla colonna X=1, riga Y=11, MAGENTA, (Stato: 0=attivo)
  52+ 6AF9 00
  53+ 6AFA 05 04 0A 04      db 5, 4, 10, GREEN, 0               ; Oggetto 3 alla colonna X=4, riga Y=10, GREEN, (Stato: 0=attivo)
  53+ 6AFE 00
  54+ 6AFF 05 07 0B 05      db 5, 7, 11, CYAN, 0                ; Oggetto 3 alla colonna X=7, riga Y=11, CYAN, (Stato: 0=attivo)
  54+ 6B03 00
  55+ 6B04
  56+ 6B04                  ; Stabza 6 (The Drive)
  57+ 6B04
  58+ 6B04                  ; Stanza 7 (The Security Guard)
  59+ 6B04
  60+ 6B04                  ; Stanza 8 (The Bathroom)
  61+ 6B04 08 17 0D 05      db 8, 23, 13, CYAN, 0                ; Oggetto 1 alla colonna X=7, riga Y=13, CYAN, (Stato: 0=attivo)
  61+ 6B08 00
  62+ 6B09
  63+ 6B09 FF               db $FF                        ; Fine tabella
  64+ 6B0A
  65+ 6B0A              ; -------------------------------------------------------------------
  66+ 6B0A              ; Determina e imposta il current_room ID in base a room_ptr
  67+ 6B0A              ; -------------------------------------------------------------------
  68+ 6B0A              DetermineCurrentRoomID:
  69+ 6B0A E5               push hl
  70+ 6B0B D5               push de
  71+ 6B0C
  72+ 6B0C 2A 14 7D         ld   hl, (room_ptr)
  73+ 6B0F
  74+ 6B0F                  ; Test Room?
  75+ 6B0F 11 10 8B         ld   de, TheTestRoomLayout
  76+ 6B12 B7               or   a
  77+ 6B13 ED 52            sbc  hl, de
  78+ 6B15 20 04            jr   nz, .not_test
  79+ 6B17 3E 00            ld   a, 0
  80+ 6B19 18 7A            jr   .set_room
  81+ 6B1B
  82+ 6B1B              .not_test:
  83+ 6B1B 2A 14 7D         ld   hl, (room_ptr)
  84+ 6B1E 11 02 84         ld   de, TheBridgeLayout
  85+ 6B21 B7               or   a
  86+ 6B22 ED 52            sbc  hl, de
  87+ 6B24 20 04            jr   nz, .not_bridge
  88+ 6B26 3E 01            ld   a, 1
  89+ 6B28 18 6B            jr   .set_room
  90+ 6B2A
  91+ 6B2A              .not_bridge:
  92+ 6B2A 2A 14 7D         ld   hl, (room_ptr)
  93+ 6B2D 11 00 83         ld   de, TheOffLicenceLayout
  94+ 6B30 B7               or   a
  95+ 6B31 ED 52            sbc  hl, de
  96+ 6B33 20 04            jr   nz, .not_office
  97+ 6B35 3E 02            ld   a, 2
  98+ 6B37 18 5C            jr   .set_room
  99+ 6B39
 100+ 6B39              .not_office:
 101+ 6B39 2A 14 7D         ld   hl, (room_ptr)
 102+ 6B3C 11 0E 8A         ld   de, MastreBedRoomLayout
 103+ 6B3F B7               or   a
 104+ 6B40 ED 52            sbc  hl, de
 105+ 6B42 20 04            jr   nz, .not_masterbed
 106+ 6B44 3E 03            ld   a, 3
 107+ 6B46 18 4D            jr   .set_room
 108+ 6B48
 109+ 6B48              .not_masterbed:
 110+ 6B48 2A 14 7D         ld   hl, (room_ptr)
 111+ 6B4B 11 04 85         ld   de, UnderTheMegaTreeLayout
 112+ 6B4E B7               or   a
 113+ 6B4F ED 52            sbc  hl, de
 114+ 6B51 20 04            jr   nz, .not_undertree
 115+ 6B53 3E 04            ld   a, 4
 116+ 6B55 18 3E            jr   .set_room
 117+ 6B57
 118+ 6B57              .not_undertree:
 119+ 6B57 2A 14 7D         ld   hl, (room_ptr)
 120+ 6B5A 11 06 86         ld   de, AtTheFootTheMegaTreeLayout
 121+ 6B5D B7               or   a
 122+ 6B5E ED 52            sbc  hl, de
 123+ 6B60 20 04            jr   nz, .not_foottree
 124+ 6B62 3E 05            ld   a, 5
 125+ 6B64 18 2F            jr   .set_room
 126+ 6B66
 127+ 6B66              .not_foottree:
 128+ 6B66 2A 14 7D         ld   hl, (room_ptr)
 129+ 6B69 11 08 87         ld   de, TheDriveLayout
 130+ 6B6C B7               or   a
 131+ 6B6D ED 52            sbc  hl, de
 132+ 6B6F 20 04            jr   nz, .not_thedrive
 133+ 6B71 3E 06            ld   a, 6
 134+ 6B73 18 20            jr   .set_room
 135+ 6B75
 136+ 6B75              .not_thedrive:
 137+ 6B75 2A 14 7D         ld   hl, (room_ptr)
 138+ 6B78 11 0A 88         ld   de, TheSecurityGuardLayout
 139+ 6B7B B7               or   a
 140+ 6B7C ED 52            sbc  hl, de
 141+ 6B7E 20 04            jr   nz, .not_securityguard
 142+ 6B80 3E 07            ld   a, 7
 143+ 6B82 18 11            jr   .set_room
 144+ 6B84
 145+ 6B84              .not_securityguard:
 146+ 6B84 2A 14 7D         ld   hl, (room_ptr)
 147+ 6B87 11 0C 89         ld   de, TheBathroomLayout
 148+ 6B8A B7               or   a
 149+ 6B8B ED 52            sbc  hl, de
 150+ 6B8D 20 04            jr   nz, .unknown
 151+ 6B8F 3E 08            ld   a, 8
 152+ 6B91 18 02            jr   .set_room
 153+ 6B93
 154+ 6B93              .unknown:
 155+ 6B93 3E 00            ld   a, 0                    ; Default fallback
 156+ 6B95
 157+ 6B95              .set_room:
 158+ 6B95 32 BA 7C         ld   (current_room), a
 159+ 6B98
 160+ 6B98 D1               pop  de
 161+ 6B99 E1               pop  hl
 162+ 6B9A C9               ret
 163+ 6B9B
 164+ 6B9B              ; -------------------------------------------------------------------
 165+ 6B9B              ; Disegna tutti gli oggetti attivi della stanza corrente
 166+ 6B9B              ; -------------------------------------------------------------------
 167+ 6B9B              DrawRoomItems:
 168+ 6B9B E5               push hl
 169+ 6B9C D5               push de
 170+ 6B9D C5               push bc
 171+ 6B9E DD E5            push ix
 172+ 6BA0 FD E5            push iy
 173+ 6BA2
 174+ 6BA2                  ; Azzera il numero di item attivi in questa stanza
 175+ 6BA2 AF               xor  a
 176+ 6BA3 32 13 7D         ld   (num_room_items), a
 177+ 6BA6 FD 21 C3 7C      ld   iy, current_room_items
 178+ 6BAA
 179+ 6BAA                  ; Ottieni il puntatore alla grafica dell'item della stanza corrente:
 180+ 6BAA                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 181+ 6BAA 2A 14 7D         ld   hl, (room_ptr)
 182+ 6BAD 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 183+ 6BB0 19               add  hl, de
 184+ 6BB1 E5               push hl
 185+ 6BB2 DD E1            pop  ix                ; IX = puntatore alla grafica dell'item della stanza
 186+ 6BB4
 187+ 6BB4 21 AF 6A         ld   hl, ItemsTable
 188+ 6BB7              .loop:
 189+ 6BB7 7E               ld   a, (hl)           ; A = Room ID
 190+ 6BB8 FE FF            cp   $FF               ; Fine tabella?
 191+ 6BBA 28 3E            jr   z, .done
 192+ 6BBC
 193+ 6BBC                  ; Confronta con la stanza corrente
 194+ 6BBC 57               ld   d, a              ; D = Room ID dell'item
 195+ 6BBD 3A BA 7C         ld   a, (current_room)
 196+ 6BC0 BA               cp   d
 197+ 6BC1 20 30            jr   nz, .next_item    ; Stanza diversa, salta
 198+ 6BC3
 199+ 6BC3                  ; Leggi coordinate, colore e stato
 200+ 6BC3 23               inc  hl                ; HL punta a X
 201+ 6BC4 4E               ld   c, (hl)           ; C = X colonna
 202+ 6BC5 23               inc  hl                ; HL punta a Y
 203+ 6BC6 46               ld   b, (hl)           ; B = Y riga
 204+ 6BC7 23               inc  hl                ; HL punta al Colore
 205+ 6BC8 5E               ld   e, (hl)           ; E = Colore
 206+ 6BC9 23               inc  hl                ; HL punta a collected flag
 207+ 6BCA 7E               ld   a, (hl)           ; A = collected flag
 208+ 6BCB B7               or   a
 209+ 6BCC 20 29            jr   nz, .next_no_inc  ; Già raccolto, salta
 210+ 6BCE
 211+ 6BCE                  ; Disegna l'item!
 212+ 6BCE                  ; B = Row, C = Col, IX = bitmap graphic (8 byte), E = Colore
 213+ 6BCE E5               push hl
 214+ 6BCF DD E5            push ix
 215+ 6BD1 E1               pop  hl                ; HL = bitmap pointer
 216+ 6BD2 CD 02 6C         call DrawItemGraphic
 217+ 6BD5 E1               pop  hl                ; HL = collected flag address
 218+ 6BD6
 219+ 6BD6                  ; Cacha l'item attivo per velocizzare CheckActiveItemAtCell
 220+ 6BD6 FD 71 00         ld   (iy+0), c         ; Col
 221+ 6BD9 FD 70 01         ld   (iy+1), b         ; Row
 222+ 6BDC FD 73 02         ld   (iy+2), e         ; Color
 223+ 6BDF FD 75 03         ld   (iy+3), l         ; Pointer to collected flag (Low)
 224+ 6BE2 FD 74 04         ld   (iy+4), h         ; Pointer to collected flag (High)
 225+ 6BE5
 226+ 6BE5 01 05 00         ld   bc, 5
 227+ 6BE8 FD 09            add  iy, bc
 228+ 6BEA
 229+ 6BEA 3A 13 7D         ld   a, (num_room_items)
 230+ 6BED 3C               inc  a
 231+ 6BEE 32 13 7D         ld   (num_room_items), a
 232+ 6BF1
 233+ 6BF1 18 04            jr   .next_no_inc
 234+ 6BF3
 235+ 6BF3              .next_item:
 236+ 6BF3 23               inc  hl                ; salta X
 237+ 6BF4 23               inc  hl                ; salta Y
 238+ 6BF5 23               inc  hl                ; salta colore
 239+ 6BF6 23               inc  hl                ; salta collected
 240+ 6BF7              .next_no_inc:
 241+ 6BF7 23               inc  hl                ; vai al prossimo record (prossimo Room ID)
 242+ 6BF8 18 BD            jr   .loop
 243+ 6BFA
 244+ 6BFA              .done:
 245+ 6BFA FD E1            pop  iy
 246+ 6BFC DD E1            pop  ix
 247+ 6BFE D1               pop  de
 248+ 6BFF C1               pop  bc
 249+ 6C00 E1               pop  hl
 250+ 6C01 C9               ret
 251+ 6C02
 252+ 6C02              ; -------------------------------------------------------------------
 253+ 6C02              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 254+ 6C02              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 255+ 6C02              ; -------------------------------------------------------------------
 256+ 6C02              DrawItemGraphic:
 257+ 6C02 C5               push bc
 258+ 6C03 D5               push de
 259+ 6C04 E5               push hl
 260+ 6C05
 261+ 6C05                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 262+ 6C05 78               ld   a, b
 263+ 6C06 E6 18            and  $18
 264+ 6C08 C6 40            add  a, $40
 265+ 6C0A 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 266+ 6C0B
 267+ 6C0B 78               ld   a, b
 268+ 6C0C E6 07            and  7
 269+ 6C0E 87               add  a, a              ; *2
 270+ 6C0F 87               add  a, a              ; *4
 271+ 6C10 87               add  a, a              ; *8
 272+ 6C11 87               add  a, a              ; *16
 273+ 6C12 87               add  a, a              ; *32
 274+ 6C13 81               add  a, c              ; + Col C
 275+ 6C14 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 276+ 6C15
 277+ 6C15                  ; 2. Copia gli 8 byte del bitmap dello sprite
 278+ 6C15 C5               push bc                ; Salva BC (contiene Row e Col)
 279+ 6C16 06 08            ld   b, 8              ; 8 scanline
 280+ 6C18              .line_loop:
 281+ 6C18 7E               ld   a, (hl)
 282+ 6C19 12               ld   (de), a
 283+ 6C1A 14               inc  d                 ; Prossima scanline
 284+ 6C1B 23               inc  hl
 285+ 6C1C 05               dec  b
 286+ 6C1D 20 F9            jr   nz, .line_loop
 287+ 6C1F C1               pop  bc                ; Ripristina BC
 288+ 6C20
 289+ 6C20                  ; 3. Calcola l'indirizzo degli attributi dello schermo
 290+ 6C20                  ; HL = $5800 + B * 32 + C
 291+ 6C20 26 00            ld   h, 0
 292+ 6C22 68               ld   l, b              ; HL = B (Row)
 293+ 6C23 29               add  hl, hl            ; *2
 294+ 6C24 29               add  hl, hl            ; *4
 295+ 6C25 29               add  hl, hl            ; *8
 296+ 6C26 29               add  hl, hl            ; *16
 297+ 6C27 29               add  hl, hl            ; *32
 298+ 6C28
 299+ 6C28 79               ld   a, c              ; A = Col
 300+ 6C29 85               add  a, l
 301+ 6C2A 6F               ld   l, a
 302+ 6C2B 30 01            jr   nc, .no_carry
 303+ 6C2D 24               inc  h
 304+ 6C2E              .no_carry:
 305+ 6C2E                  ; HL = B * 32 + C
 306+ 6C2E 11 00 58         ld   de, $5800
 307+ 6C31 19               add  hl, de            ; HL = AttrAddr
 308+ 6C32
 309+ 6C32                  ; Ripristina i registri dallo stack per estrarre il colore in E
 310+ 6C32                  ; Lo stack ha: HL (originale), DE (originale con colore in E), BC (originale)
 311+ 6C32 C1               pop  bc                ; BC = HL originale
 312+ 6C33 D1               pop  de                ; DE = DE originale (colore in E)
 313+ 6C34
 314+ 6C34 7B               ld   a, e              ; A = Colore
 315+ 6C35 77               ld   (hl), a           ; Scrivi in memoria attributi (HL)
 316+ 6C36
 317+ 6C36                  ; Ripristina lo stack e i registri originari
 318+ 6C36 C5               push bc                ; Rimetti HL originale sulla pila
 319+ 6C37 E1               pop  hl                ; HL = HL originale
 320+ 6C38 C1               pop  bc                ; BC = BC originale
 321+ 6C39 C9               ret
 322+ 6C3A
 323+ 6C3A              ; -------------------------------------------------------------------
 324+ 6C3A              ; Ripristina la cella dello sfondo originale per cancellare l'item
 325+ 6C3A              ; Input: B = Row (3..18), C = Col (0..31)
 326+ 6C3A              ; -------------------------------------------------------------------
 327+ 6C3A              RestoreBackgroundCell:
 328+ 6C3A FD E5            push iy                ; Preserva IY
 329+ 6C3C C5               push bc
 330+ 6C3D D5               push de
 331+ 6C3E E5               push hl
 332+ 6C3F DD E5            push ix
 333+ 6C41
 334+ 6C41 C5               push bc
 335+ 6C42 FD E1            pop  iy                ; IY = original BC (IYH = Row, IYL = Col)
 336+ 6C44
 337+ 6C44                  ; Riga di layout: r = B
 338+ 6C44 78               ld   a, b
 339+ 6C45                  ; A = r (0..15)
 340+ 6C45
 341+ 6C45                  ; Colonna: c = C (Col)
 342+ 6C45 CD C2 67         call GetCellFromUnpacked ; A = cell type (0..3)
 343+ 6C48
 344+ 6C48 ED 5B 14 7D      ld   de, (room_ptr)
 345+ 6C4C B7               or   a
 346+ 6C4D 20 06            jr   nz, .not_bg
 347+ 6C4F 21 A0 00         ld   hl, OFFSET_BG
 348+ 6C52 19               add  hl, de
 349+ 6C53 18 16            jr   .draw_cell
 350+ 6C55              .not_bg:
 351+ 6C55 3D               dec  a
 352+ 6C56 20 06            jr   nz, .not_floor
 353+ 6C58 21 A9 00         ld   hl, OFFSET_FLOOR
 354+ 6C5B 19               add  hl, de
 355+ 6C5C 18 0D            jr   .draw_cell
 356+ 6C5E              .not_floor:
 357+ 6C5E 3D               dec  a
 358+ 6C5F 20 06            jr   nz, .not_wall
 359+ 6C61 21 B2 00         ld   hl, OFFSET_WALL
 360+ 6C64 19               add  hl, de
 361+ 6C65 18 04            jr   .draw_cell
 362+ 6C67              .not_wall:
 363+ 6C67 21 BB 00         ld   hl, OFFSET_NASTY
 364+ 6C6A 19               add  hl, de
 365+ 6C6B
 366+ 6C6B              .draw_cell:
 367+ 6C6B E5               push hl
 368+ 6C6C DD E1            pop  ix                ; IX = tile pointer
 369+ 6C6E
 370+ 6C6E FD E5            push iy
 371+ 6C70 C1               pop  bc                ; B = Row, C = Col
 372+ 6C71
 373+ 6C71 CD 8C 61         call DrawTile
 374+ 6C74
 375+ 6C74 DD E1            pop  ix
 376+ 6C76 E1               pop  hl
 377+ 6C77 D1               pop  de
 378+ 6C78 C1               pop  bc
 379+ 6C79 FD E1            pop  iy                ; Ripristina IY
 380+ 6C7B C9               ret
 381+ 6C7C
 382+ 6C7C              ; -------------------------------------------------------------------
 383+ 6C7C              ; Controlla se Willy collide con un item (pixel-level check)
 384+ 6C7C              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 385+ 6C7C              ; Output: Carry set se collide, altrimenti clear
 386+ 6C7C              ; -------------------------------------------------------------------
 387+ 6C7C              CheckWillyItemCollision:
 388+ 6C7C C5               push bc
 389+ 6C7D D5               push de
 390+ 6C7E E5               push hl
 391+ 6C7F
 392+ 6C7F                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 393+ 6C7F 6F               ld   l, a
 394+ 6C80 7D               ld   a, l
 395+ 6C81 87               add  a, a              ; *2
 396+ 6C82 87               add  a, a              ; *4
 397+ 6C83 87               add  a, a              ; *8
 398+ 6C84 5F               ld   e, a              ; E = ItemLeft
 399+ 6C85 C6 07            add  a, 7
 400+ 6C87 57               ld   d, a              ; D = ItemRight
 401+ 6C88
 402+ 6C88                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 403+ 6C88 ED 4B A7 79      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 404+ 6C8C
 405+ 6C8C                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 406+ 6C8C 79               ld   a, c
 407+ 6C8D BA               cp   d
 408+ 6C8E 28 04            jr   z, .x_ok
 409+ 6C90 38 02            jr   c, .x_ok
 410+ 6C92 18 29            jr   .no_collision
 411+ 6C94              .x_ok:
 412+ 6C94 C6 0F            add  a, 15
 413+ 6C96 BB               cp   e
 414+ 6C97 28 04            jr   z, .y_check
 415+ 6C99 30 02            jr   nc, .y_check
 416+ 6C9B 18 20            jr   .no_collision
 417+ 6C9D
 418+ 6C9D              .y_check:
 419+ 6C9D E1               pop  hl                ; Recupera HL originale (H = ItemY)
 420+ 6C9E E5               push hl
 421+ 6C9F 7C               ld   a, h
 422+ 6CA0 87               add  a, a              ; *2
 423+ 6CA1 87               add  a, a              ; *4
 424+ 6CA2 87               add  a, a              ; *8
 425+ 6CA3 5F               ld   e, a              ; E = ItemTop
 426+ 6CA4 C6 07            add  a, 7
 427+ 6CA6 57               ld   d, a              ; D = ItemBottom
 428+ 6CA7
 429+ 6CA7                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 430+ 6CA7 78               ld   a, b
 431+ 6CA8 BA               cp   d
 432+ 6CA9 28 04            jr   z, .y_ok
 433+ 6CAB 38 02            jr   c, .y_ok
 434+ 6CAD 18 0E            jr   .no_collision
 435+ 6CAF              .y_ok:
 436+ 6CAF C6 0F            add  a, 15
 437+ 6CB1 BB               cp   e
 438+ 6CB2 28 04            jr   z, .collision
 439+ 6CB4 30 02            jr   nc, .collision
 440+ 6CB6 18 05            jr   .no_collision
 441+ 6CB8
 442+ 6CB8              .collision:
 443+ 6CB8 E1               pop  hl
 444+ 6CB9 D1               pop  de
 445+ 6CBA C1               pop  bc
 446+ 6CBB 37               scf                    ; Set carry (collisione!)
 447+ 6CBC C9               ret
 448+ 6CBD
 449+ 6CBD              .no_collision:
 450+ 6CBD E1               pop  hl
 451+ 6CBE D1               pop  de
 452+ 6CBF C1               pop  bc
 453+ 6CC0 B7               or   a                 ; Clear carry
 454+ 6CC1 C9               ret
 455+ 6CC2
 456+ 6CC2              ; -------------------------------------------------------------------
 457+ 6CC2              ; Controlla se Willy tocca un item attivo nella stanza corrente
 458+ 6CC2              ; -------------------------------------------------------------------
 459+ 6CC2              CheckRoomItemsCollision:
 460+ 6CC2 E5               push hl
 461+ 6CC3 D5               push de
 462+ 6CC4 C5               push bc
 463+ 6CC5
 464+ 6CC5 21 AF 6A         ld   hl, ItemsTable
 465+ 6CC8              .loop:
 466+ 6CC8 7E               ld   a, (hl)           ; A = Room ID
 467+ 6CC9 FE FF            cp   $FF               ; Fine tabella?
 468+ 6CCB 28 37            jr   z, .done
 469+ 6CCD
 470+ 6CCD                  ; Stanza corrente?
 471+ 6CCD 57               ld   d, a              ; D = Room ID
 472+ 6CCE 3A BA 7C         ld   a, (current_room)
 473+ 6CD1 BA               cp   d
 474+ 6CD2 20 29            jr   nz, .next_item
 475+ 6CD4
 476+ 6CD4 23               inc  hl                ; HL punta a X
 477+ 6CD5 4E               ld   c, (hl)           ; C = X
 478+ 6CD6 23               inc  hl                ; HL punta a Y
 479+ 6CD7 46               ld   b, (hl)           ; B = Y
 480+ 6CD8 23               inc  hl                ; HL punta al colore (lo saltiamo per il controllo collisione)
 481+ 6CD9 23               inc  hl                ; HL punta a collected
 482+ 6CDA 7E               ld   a, (hl)           ; A = collected
 483+ 6CDB B7               or   a
 484+ 6CDC 20 23            jr   nz, .next_no_inc  ; Già raccolto, salta
 485+ 6CDE
 486+ 6CDE                  ; Controlla collisione
 487+ 6CDE 79               ld   a, c
 488+ 6CDF E5               push hl
 489+ 6CE0 60               ld   h, b
 490+ 6CE1 CD 7C 6C         call CheckWillyItemCollision
 491+ 6CE4 E1               pop  hl
 492+ 6CE5 30 1A            jr   nc, .next_no_inc
 493+ 6CE7
 494+ 6CE7                  ; RACCOLTO!
 495+ 6CE7 36 01            ld   (hl), 1           ; Imposta collected = 1
 496+ 6CE9
 497+ 6CE9 E5               push hl
 498+ 6CEA
 499+ 6CEA                  ; Incrementa contatore oggetti raccolti
 500+ 6CEA 3A B1 79         ld   a, (items_collected)
 501+ 6CED 3C               inc  a
 502+ 6CEE 32 B1 79         ld   (items_collected), a
 503+ 6CF1
 504+ 6CF1                  ; Aggiorna stringa e visualizzazione a schermo
 505+ 6CF1 CD CB 60         call UpdateItemsCollectedDisplay
 506+ 6CF4
 507+ 6CF4                  ; Cancella item dallo schermo
 508+ 6CF4 CD 3A 6C         call RestoreBackgroundCell
 509+ 6CF7
 510+ 6CF7                  ; Suono di raccolta
 511+ 6CF7 CD 08 6D         call PlayCollectSound
 512+ 6CFA
 513+ 6CFA E1               pop  hl
 514+ 6CFB
 515+ 6CFB 18 04            jr   .next_no_inc
 516+ 6CFD
 517+ 6CFD              .next_item:
 518+ 6CFD 23               inc  hl                ; salta X
 519+ 6CFE 23               inc  hl                ; salta Y
 520+ 6CFF 23               inc  hl                ; salta colore
 521+ 6D00 23               inc  hl                ; salta collected
 522+ 6D01              .next_no_inc:
 523+ 6D01 23               inc  hl                ; vai al prossimo item
 524+ 6D02 18 C4            jr   .loop
 525+ 6D04
 526+ 6D04              .done:
 527+ 6D04 C1               pop  bc
 528+ 6D05 D1               pop  de
 529+ 6D06 E1               pop  hl
 530+ 6D07 C9               ret
 531+ 6D08
 532+ 6D08              ; -------------------------------------------------------------------
 533+ 6D08              ; Riproduce un breve segnale acustico all'altoparlante
 534+ 6D08              ; -------------------------------------------------------------------
 535+ 6D08              PlayCollectSound:
 536+ 6D08 C5               push bc
 537+ 6D09 D5               push de
 538+ 6D0A
 539+ 6D0A 06 78            ld   b, 120            ; Cicli della nota
 540+ 6D0C              .sound_loop:
 541+ 6D0C 3A B3 79         ld   a, (room_border_color)
 542+ 6D0F F6 10            or   $10               ; Speaker ON (bit 4 = 1)
 543+ 6D11 D3 FE            out  ($fe), a
 544+ 6D13 0E 3C            ld   c, 60             ; Mezzo periodo delay
 545+ 6D15 0D           .d1: dec  c
 546+ 6D16 20 FD            jr   nz, .d1
 547+ 6D18
 548+ 6D18 3A B3 79         ld   a, (room_border_color)
 549+ 6D1B E6 EF            and  $ef               ; Speaker OFF (bit 4 = 0)
 550+ 6D1D D3 FE            out  ($fe), a
 551+ 6D1F 0E 3C            ld   c, 60             ; Mezzo periodo delay
 552+ 6D21 0D           .d2: dec  c
 553+ 6D22 20 FD            jr   nz, .d2
 554+ 6D24
 555+ 6D24 10 E6            djnz .sound_loop
 556+ 6D26
 557+ 6D26 D1               pop  de
 558+ 6D27 C1               pop  bc
 559+ 6D28 C9               ret
 560+ 6D29
 561+ 6D29              ; -------------------------------------------------------------------
 562+ 6D29              ; Cerca se c'è un item attivo (non raccolto) alla cella specificata.
 563+ 6D29              ; Input: B = Colonna (0..31), C = Riga (0..15)
 564+ 6D29              ; Output: Carry flag impostato se trovato, in tal caso HL punta all'inizio dell'entry in ItemsTable.
 565+ 6D29              ; -------------------------------------------------------------------
 566+ 6D29              CheckActiveItemAtCell:
 567+ 6D29 D5               push de
 568+ 6D2A C5               push bc
 569+ 6D2B DD E5            push ix
 570+ 6D2D
 571+ 6D2D 3A 13 7D         ld   a, (num_room_items)
 572+ 6D30 B7               or   a
 573+ 6D31 28 2E            jr   z, .not_found
 574+ 6D33
 575+ 6D33 DD 21 C3 7C      ld   ix, current_room_items
 576+ 6D37 57               ld   d, a              ; D = loop counter
 577+ 6D38              .loop:
 578+ 6D38 DD 7E 00         ld   a, (ix+0)         ; Colonna dell'item cachato
 579+ 6D3B B8               cp   b
 580+ 6D3C 20 19            jr   nz, .next
 581+ 6D3E
 582+ 6D3E DD 7E 01         ld   a, (ix+1)         ; Riga dell'item cachato
 583+ 6D41 B9               cp   c
 584+ 6D42 20 13            jr   nz, .next
 585+ 6D44
 586+ 6D44                  ; Controlla se l'item è già stato raccolto
 587+ 6D44 DD 6E 03         ld   l, (ix+3)
 588+ 6D47 DD 66 04         ld   h, (ix+4)
 589+ 6D4A 7E               ld   a, (hl)
 590+ 6D4B B7               or   a
 591+ 6D4C 20 09            jr   nz, .next
 592+ 6D4E
 593+ 6D4E                  ; Trovato! Ritorna il colore in A
 594+ 6D4E DD 7E 02         ld   a, (ix+2)
 595+ 6D51 DD E1            pop  ix
 596+ 6D53 C1               pop  bc
 597+ 6D54 D1               pop  de
 598+ 6D55 37               scf                    ; Set carry
 599+ 6D56 C9               ret
 600+ 6D57
 601+ 6D57              .next:
 602+ 6D57 D5               push de
 603+ 6D58 11 05 00         ld   de, 5
 604+ 6D5B DD 19            add  ix, de
 605+ 6D5D D1               pop  de
 606+ 6D5E 15               dec  d
 607+ 6D5F 20 D7            jr   nz, .loop
 608+ 6D61
 609+ 6D61              .not_found:
 610+ 6D61 DD E1            pop  ix
 611+ 6D63 C1               pop  bc
 612+ 6D64 D1               pop  de
 613+ 6D65 B7               or   a                 ; Clear carry
 614+ 6D66 C9               ret
