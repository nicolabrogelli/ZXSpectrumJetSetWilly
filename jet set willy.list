 748+ 78A1              ; Items_DrawRoom
 749+ 78A1              ;
 750+ 78A1              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 751+ 78A1              ;
 752+ 78A1              ; Operazioni eseguite:
 753+ 78A1              ;   1. Azzera la griglia items_grid.
 754+ 78A1              ;   2. Svuota la cache degli oggetti attivi.
 755+ 78A1              ;   3. Scansiona ItemsTable.
 756+ 78A1              ;   4. Per ogni item della stanza corrente:
 757+ 78A1              ;        - verifica se è già stato raccolto
 758+ 78A1              ;        - disegna la grafica
 759+ 78A1              ;        - aggiorna items_grid
 760+ 78A1              ;        - memorizza l'item nella cache current_room_items
 761+ 78A1              ;   5. Aggiorna num_room_items.
 762+ 78A1              ;
 763+ 78A1              ; Record ItemsTable:
 764+ 78A1              ;   +0  Room ID
 765+ 78A1              ;   +1  X (colonna)
 766+ 78A1              ;   +2  Y (riga)
 767+ 78A1              ;   +3  Colore
 768+ 78A1              ;   +4  Collected flag
 769+ 78A1              ;
 770+ 78A1              ; Cache current_room_items:
 771+ 78A1              ;   +0  Colonna
 772+ 78A1              ;   +1  Riga
 773+ 78A1              ;   +2  Colore
 774+ 78A1              ;   +3  Collected flag ptr (Low)
 775+ 78A1              ;   +4  Collected flag ptr (High)
 776+ 78A1              ;
 777+ 78A1              ; Ogni record cache occupa 5 byte.
 778+ 78A1              ; -------------------------------------------------------------------
 779+ 78A1              Items_DrawRoom:
 780+ 78A1
 781+ 78A1                  ; Salva tutti i registri utilizzati
 782+ 78A1 E5               push hl
 783+ 78A2 D5               push de
 784+ 78A3 C5               push bc
 785+ 78A4 DD E5            push ix
 786+ 78A6 FD E5            push iy
 787+ 78A8
 788+ 78A8                  ; ---------------------------------------------------------------
 789+ 78A8                  ; Azzera items_grid (32 x 16 = 512 byte)
 790+ 78A8                  ; ---------------------------------------------------------------
 791+ 78A8 21 6C CD         ld   hl, items_grid
 792+ 78AB 11 6D CD         ld   de, items_grid + 1
 793+ 78AE 36 00            ld   (hl), 0
 794+ 78B0 01 FF 01         ld   bc, 511
 795+ 78B3 ED B0            ldir
 796+ 78B5
 797+ 78B5                  ; ---------------------------------------------------------------
 798+ 78B5                  ; Nessun item attivo nella stanza
 799+ 78B5                  ; ---------------------------------------------------------------
 800+ 78B5 AF               xor  a
 801+ 78B6 32 4A 7E         ld   (num_room_items), a
 802+ 78B9
 803+ 78B9                  ; IY punta alla cache degli item attivi
 804+ 78B9 FD 21 FA 7D      ld   iy, current_room_items
 805+ 78BD
 806+ 78BD                  ; ---------------------------------------------------------------
 807+ 78BD                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 808+ 78BD                  ; alla stanza corrente.
 809+ 78BD                  ;
 810+ 78BD                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 811+ 78BD                  ; ---------------------------------------------------------------
 812+ 78BD 2A 4B 7E         ld   hl, (room_ptr)
 813+ 78C0 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 814+ 78C3 19               add  hl, de
 815+ 78C4
 816+ 78C4 E5               push hl
 817+ 78C5 DD E1            pop  ix                ; IX = bitmap item
 818+ 78C7
 819+ 78C7                  ; ---------------------------------------------------------------
 820+ 78C7                  ; Inizio scansione della tabella degli item
 821+ 78C7                  ; ---------------------------------------------------------------
 822+ 78C7 21 1B 75         ld   hl, ItemsTable
 823+ 78CA
 824+ 78CA              .loop:
 825+ 78CA
 826+ 78CA                  ; ---------------------------------------------------------------
 827+ 78CA                  ; Legge il Room ID del record corrente
 828+ 78CA                  ; ---------------------------------------------------------------
