 773+ 6A58 CB 3F            srl  a
 774+ 6A5A CB 3F            srl  a                 ; A = ColStart
 775+ 6A5C 5F               ld   e, a              ; E = ColStart
 776+ 6A5D
 777+ 6A5D                  ; ColEnd = (WillyX + 7) / 8
 778+ 6A5D 79               ld   a, c
 779+ 6A5E C6 07            add  a, 7
