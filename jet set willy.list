1081+ 8623
1082+ 8623              ; -------------------------------------------------------------------
1083+ 8623              ; Items_DrawRoom
1084+ 8623              ;
1085+ 8623              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1086+ 8623              ;
1087+ 8623              ; Operazioni eseguite:
1088+ 8623              ;   1. Azzera la griglia items_grid.
1089+ 8623              ;   2. Svuota la cache degli oggetti attivi.
1090+ 8623              ;   3. Scansiona ItemsTable.
1091+ 8623              ;   4. Per ogni item della stanza corrente:
1092+ 8623              ;        - verifica se è già stato raccolto
1093+ 8623              ;        - disegna la grafica
1094+ 8623              ;        - aggiorna items_grid
1095+ 8623              ;        - memorizza l'item nella cache current_room_items
1096+ 8623              ;   5. Aggiorna num_room_items.
1097+ 8623              ;
1098+ 8623              ; Record ItemsTable:
1099+ 8623              ;   +0  Room ID
1100+ 8623              ;   +1  X (colonna)
1101+ 8623              ;   +2  Y (riga)
1102+ 8623              ;   +3  Colore
1103+ 8623              ;   +4  Collected flag
1104+ 8623              ;
1105+ 8623              ; Cache current_room_items:
1106+ 8623              ;   +0  Colonna
1107+ 8623              ;   +1  Riga
1108+ 8623              ;   +2  Colore
1109+ 8623              ;   +3  Collected flag ptr (Low)
1110+ 8623              ;   +4  Collected flag ptr (High)
1111+ 8623              ;
1112+ 8623              ; Ogni record cache occupa 5 byte.
1113+ 8623              ; -------------------------------------------------------------------
1114+ 8623              ; ResetItemsTable
1115+ 8623              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1116+ 8623              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1117+ 8623              ; -------------------------------------------------------------------
1118+ 8623              ResetItemsTable:
1119+ 8623 21 C7 80         ld   hl, ItemsTable
1120+ 8626              .reset_loop:
1121+ 8626 7E               ld   a, (hl)
1122+ 8627 FE FF            cp   $FF
1123+ 8629 C8               ret  z
1124+ 862A 23               inc  hl                        ; +1 (X)
1125+ 862B 23               inc  hl                        ; +2 (Y)
1126+ 862C 23               inc  hl                        ; +3 (Color)
1127+ 862D 23               inc  hl                        ; +4 (Collected flag)
1128+ 862E 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1129+ 8630 23               inc  hl                        ; Prossimo record
1130+ 8631 18 F3            jr   .reset_loop
1131+ 8633
1132+ 8633              ; -------------------------------------------------------------------
1133+ 8633              Items_DrawRoom:
1134+ 8633
1135+ 8633                  ; Salva tutti i registri utilizzati
1136+ 8633 E5               push hl
1137+ 8634 D5               push de
1138+ 8635 C5               push bc
1139+ 8636 DD E5            push ix
1140+ 8638 FD E5            push iy
1141+ 863A
1142+ 863A                  ; ---------------------------------------------------------------
1143+ 863A                  ; Azzera items_grid (32 x 16 = 512 byte)
1144+ 863A                  ; ---------------------------------------------------------------
1145+ 863A 21 E2 F2         ld   hl, items_grid
1146+ 863D 11 E3 F2         ld   de, items_grid + 1
1147+ 8640 36 00            ld   (hl), 0
1148+ 8642 01 FF 01         ld   bc, 511
1149+ 8645 ED B0            ldir
1150+ 8647
1151+ 8647                  ; ---------------------------------------------------------------
1152+ 8647                  ; Nessun item attivo nella stanza
1153+ 8647                  ; ---------------------------------------------------------------
1154+ 8647 AF               xor  a
1155+ 8648 32 61 F8         ld   (num_room_items), a
1156+ 864B
1157+ 864B                  ; IY punta alla cache degli item attivi
1158+ 864B FD 21 11 F8      ld   iy, current_room_items
1159+ 864F
1160+ 864F                  ; ---------------------------------------------------------------
1161+ 864F                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1162+ 864F                  ; alla stanza corrente.
1163+ 864F                  ;
1164+ 864F                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1165+ 864F                  ; ---------------------------------------------------------------
1166+ 864F 2A 62 F8         ld   hl, (room_ptr)
1167+ 8652 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1168+ 8655 19               add  hl, de
1169+ 8656
1170+ 8656 E5               push hl
1171+ 8657 DD E1            pop  ix                ; IX = bitmap item
1172+ 8659
1173+ 8659                  ; ---------------------------------------------------------------
1174+ 8659                  ; Inizio scansione della tabella degli item
1175+ 8659                  ; ---------------------------------------------------------------
1176+ 8659 21 C7 80         ld   hl, ItemsTable
1177+ 865C
1178+ 865C              .loop:
1179+ 865C
1180+ 865C                  ; ---------------------------------------------------------------
1181+ 865C                  ; Legge il Room ID del record corrente
1182+ 865C                  ; ---------------------------------------------------------------
1183+ 865C 7E               ld   a, (hl)
1184+ 865D
1185+ 865D                  ; $FF indica fine tabella
1186+ 865D FE FF            cp   $FF
1187+ 865F 28 53            jr   z, .done
1188+ 8661
1189+ 8661                  ; ---------------------------------------------------------------
1190+ 8661                  ; Verifica se l'item appartiene alla stanza corrente
1191+ 8661                  ; ---------------------------------------------------------------
1192+ 8661 57               ld   d, a
1193+ 8662
1194+ 8662 3A 08 F8         ld   a, (current_room)
1195+ 8665 BA               cp   d
1196+ 8666 20 45            jr   nz, .next_item
1197+ 8668
1198+ 8668                  ; ---------------------------------------------------------------
1199+ 8668                  ; Legge i dati dell'item
1200+ 8668                  ; ---------------------------------------------------------------
1201+ 8668
1202+ 8668 23               inc  hl
1203+ 8669 4E               ld   c, (hl)           ; X (colonna)
1204+ 866A
1205+ 866A 23               inc  hl
1206+ 866B 46               ld   b, (hl)           ; Y (riga)
1207+ 866C
1208+ 866C 23               inc  hl
1209+ 866D 5E               ld   e, (hl)           ; Colore
1210+ 866E
1211+ 866E 23               inc  hl
1212+ 866F 7E               ld   a, (hl)           ; Collected flag
1213+ 8670
1214+ 8670                  ; Se diverso da zero l'item è già stato raccolto
1215+ 8670 B7               or   a
1216+ 8671 20 3E            jr   nz, .next_no_inc
1217+ 8673
1218+ 8673                  ; ---------------------------------------------------------------
1219+ 8673                  ; Disegna l'item sullo schermo
1220+ 8673                  ;
1221+ 8673                  ; B = Row
1222+ 8673                  ; C = Column
1223+ 8673                  ; HL = bitmap pointer
1224+ 8673                  ; E = Color
1225+ 8673                  ; ---------------------------------------------------------------
1226+ 8673 E5               push hl
1227+ 8674
1228+ 8674 DD E5            push ix
1229+ 8676 E1               pop  hl
1230+ 8677
1231+ 8677 CD BC 86         call DrawItemGraphic
1232+ 867A
1233+ 867A E1               pop  hl                ; ritorna al flag collected
1234+ 867B
1235+ 867B                  ; ---------------------------------------------------------------
1236+ 867B                  ; Aggiorna items_grid
1237+ 867B                  ;
1238+ 867B                  ; Calcolo:
1239+ 867B                  ;   offset = Row * 32 + Col
1240+ 867B                  ; ---------------------------------------------------------------
1241+ 867B E5               push hl
1242+ 867C D5               push de
1243+ 867D
1244+ 867D 26 00            ld   h, 0
1245+ 867F 68               ld   l, b              ; HL = Row
1246+ 8680
1247+ 8680 29               add  hl, hl            ; *2
1248+ 8681 29               add  hl, hl            ; *4
1249+ 8682 29               add  hl, hl            ; *8
1250+ 8683 29               add  hl, hl            ; *16
1251+ 8684 29               add  hl, hl            ; *32
1252+ 8685
1253+ 8685 16 00            ld   d, 0
1254+ 8687 59               ld   e, c              ; DE = Col
1255+ 8688
1256+ 8688 19               add  hl, de            ; Row*32 + Col
1257+ 8689
1258+ 8689 11 E2 F2         ld   de, items_grid
1259+ 868C 19               add  hl, de            ; puntatore nella griglia
1260+ 868D
1261+ 868D D1               pop  de                ; ripristina colore
1262+ 868E
1263+ 868E 73               ld   (hl), e           ; salva colore cella
1264+ 868F
1265+ 868F E1               pop  hl
1266+ 8690
1267+ 8690                  ; ---------------------------------------------------------------
1268+ 8690                  ; Salva l'item nella cache della stanza
1269+ 8690                  ;
1270+ 8690                  ; Questo evita di dover scansionare tutta ItemsTable
1271+ 8690                  ; durante il controllo delle collisioni.
1272+ 8690                  ; ---------------------------------------------------------------
1273+ 8690
1274+ 8690 FD 71 00         ld   (iy+0), c         ; Colonna
1275+ 8693 FD 70 01         ld   (iy+1), b         ; Riga
1276+ 8696 FD 73 02         ld   (iy+2), e         ; Colore
1277+ 8699
1278+ 8699                  ; Salva il puntatore al flag "collected"
1279+ 8699 FD 75 03         ld   (iy+3), l         ; Low byte
1280+ 869C FD 74 04         ld   (iy+4), h         ; High byte
1281+ 869F
1282+ 869F                  ; Passa al record successivo della cache
1283+ 869F 01 05 00         ld   bc, 5
1284+ 86A2 FD 09            add  iy, bc
1285+ 86A4
1286+ 86A4                  ; Incrementa il numero di item attivi
1287+ 86A4 3A 61 F8         ld   a, (num_room_items)
1288+ 86A7 3C               inc  a
1289+ 86A8 32 61 F8         ld   (num_room_items), a
1290+ 86AB
1291+ 86AB 18 04            jr   .next_no_inc
1292+ 86AD
1293+ 86AD              .next_item:
1294+ 86AD
1295+ 86AD                  ; ---------------------------------------------------------------
1296+ 86AD                  ; L'item non appartiene alla stanza corrente.
1297+ 86AD                  ; Salta i campi del record:
1298+ 86AD                  ;   X
1299+ 86AD                  ;   Y
1300+ 86AD                  ;   Color
1301+ 86AD                  ;   Collected
1302+ 86AD                  ; ---------------------------------------------------------------
1303+ 86AD 23               inc  hl
1304+ 86AE 23               inc  hl
1305+ 86AF 23               inc  hl
1306+ 86B0 23               inc  hl
1307+ 86B1
1308+ 86B1              .next_no_inc:
1309+ 86B1
1310+ 86B1                  ; ---------------------------------------------------------------
1311+ 86B1                  ; Avanza al record successivo
1312+ 86B1                  ; (prossimo Room ID)
1313+ 86B1                  ; ---------------------------------------------------------------
1314+ 86B1 23               inc  hl
1315+ 86B2 18 A8            jr   .loop
1316+ 86B4
1317+ 86B4              .done:
1318+ 86B4
1319+ 86B4                  ; Ripristina i registri
1320+ 86B4 FD E1            pop  iy
1321+ 86B6 DD E1            pop  ix
1322+ 86B8 D1               pop  de
1323+ 86B9 C1               pop  bc
1324+ 86BA E1               pop  hl
1325+ 86BB
1326+ 86BB C9               ret
1327+ 86BC
1328+ 86BC              ; -------------------------------------------------------------------
1329+ 86BC              ; DrawItemGraphic
1330+ 86BC              ;
1331+ 86BC              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1332+ 86BC              ; utilizzando una bitmap di 8 byte e un attributo colore.
1333+ 86BC              ;
1334+ 86BC              ; Input:
1335+ 86BC              ;   B = Riga attributi (3..18)
1336+ 86BC              ;   C = Colonna attributi (0..31)
1337+ 86BC              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1338+ 86BC              ;   E = Attributo colore
1339+ 86BC              ;
1340+ 86BC              ; Output:
1341+ 86BC              ;   Nessuno
1342+ 86BC              ;
1343+ 86BC              ; Registri preservati:
1344+ 86BC              ;   BC, DE, HL
1345+ 86BC              ; -------------------------------------------------------------------
1346+ 86BC              DrawItemGraphic:
1347+ 86BC
1348+ 86BC                  ; Salva i registri originali
1349+ 86BC C5               push bc
1350+ 86BD D5               push de
1351+ 86BE E5               push hl
1352+ 86BF
1353+ 86BF                  ; ---------------------------------------------------------------
1354+ 86BF                  ; Calcolo indirizzo bitmap dello Spectrum
1355+ 86BF                  ;
1356+ 86BF                  ; Ogni item occupa una cella attributi (8x8 pixel).
1357+ 86BF                  ;
1358+ 86BF                  ; Formula:
1359+ 86BF                  ;   High = $40 + (Row AND $18)
1360+ 86BF                  ;   Low  = (Row AND 7) * 32 + Col
1361+ 86BF                  ;
1362+ 86BF                  ; DE conterrà l'indirizzo della prima scanline.
1363+ 86BF                  ; ---------------------------------------------------------------
1364+ 86BF
1365+ 86BF 78               ld   a, b
1366+ 86C0 E6 18            and  $18
1367+ 86C2 C6 40            add  a, $40
1368+ 86C4 57               ld   d, a              ; Byte alto indirizzo video
1369+ 86C5
1370+ 86C5 78               ld   a, b
1371+ 86C6 E6 07            and  7                 ; Riga interna al blocco da 8
1372+ 86C8
1373+ 86C8 87               add  a, a              ; *2
1374+ 86C9 87               add  a, a              ; *4
1375+ 86CA 87               add  a, a              ; *8
1376+ 86CB 87               add  a, a              ; *16
1377+ 86CC 87               add  a, a              ; *32
1378+ 86CD
1379+ 86CD 81               add  a, c              ; + colonna
1380+ 86CE
1381+ 86CE 5F               ld   e, a              ; Byte basso indirizzo video
1382+ 86CF
1383+ 86CF                  ; ---------------------------------------------------------------
1384+ 86CF                  ; Disegno bitmap
1385+ 86CF                  ;
1386+ 86CF                  ; Copia 8 byte consecutivi nella memoria video.
1387+ 86CF                  ; Ogni byte rappresenta una scanline da 8 pixel.
1388+ 86CF                  ; ---------------------------------------------------------------
1389+ 86CF
1390+ 86CF C5               push bc                ; Conserva Row e Col
1391+ 86D0
1392+ 86D0 06 08            ld   b, 8              ; Numero scanline
1393+ 86D2
1394+ 86D2              .line_loop:
1395+ 86D2
1396+ 86D2 7E               ld   a, (hl)           ; Legge scanline bitmap
1397+ 86D3 12               ld   (de), a           ; Scrive nella memoria video
1398+ 86D4
1399+ 86D4 14               inc  d                 ; Scanline successiva
1400+ 86D5 23               inc  hl                ; Byte bitmap successivo
1401+ 86D6
1402+ 86D6 05               dec  b
1403+ 86D7 20 F9            jr   nz, .line_loop
1404+ 86D9
1405+ 86D9 C1               pop  bc                ; Ripristina Row e Col
1406+ 86DA
1407+ 86DA                  ; ---------------------------------------------------------------
1408+ 86DA                  ; Calcolo indirizzo attributo
1409+ 86DA                  ;
1410+ 86DA                  ; Formula:
1411+ 86DA                  ;   AttrAddr = $5800 + Row * 32 + Col
1412+ 86DA                  ;
1413+ 86DA                  ; HL conterrà l'indirizzo della cella attributi.
1414+ 86DA                  ; ---------------------------------------------------------------
1415+ 86DA
1416+ 86DA 26 00            ld   h, 0
1417+ 86DC 68               ld   l, b              ; HL = Row
1418+ 86DD
1419+ 86DD 29               add  hl, hl            ; *2
1420+ 86DE 29               add  hl, hl            ; *4
1421+ 86DF 29               add  hl, hl            ; *8
1422+ 86E0 29               add  hl, hl            ; *16
1423+ 86E1 29               add  hl, hl            ; *32
1424+ 86E2
1425+ 86E2 79               ld   a, c              ; A = Colonna
1426+ 86E3
1427+ 86E3 85               add  a, l
1428+ 86E4 6F               ld   l, a
1429+ 86E5
1430+ 86E5 30 01            jr   nc, .no_carry
1431+ 86E7 24               inc  h
1432+ 86E8
1433+ 86E8              .no_carry:
1434+ 86E8
1435+ 86E8                  ; HL = Row * 32 + Col
1436+ 86E8
1437+ 86E8 11 00 58         ld   de, $5800
1438+ 86EB 19               add  hl, de            ; HL = indirizzo attributi
1439+ 86EC
1440+ 86EC                  ; ---------------------------------------------------------------
1441+ 86EC                  ; Recupera il colore originale dallo stack.
1442+ 86EC                  ;
1443+ 86EC                  ; Layout stack:
1444+ 86EC                  ;   HL originale
1445+ 86EC                  ;   DE originale (E = colore)
1446+ 86EC                  ;   BC originale
1447+ 86EC                  ; ---------------------------------------------------------------
1448+ 86EC
1449+ 86EC C1               pop  bc                ; Recupera HL originale
1450+ 86ED D1               pop  de                ; Recupera DE originale
1451+ 86EE
1452+ 86EE                  ; ---------------------------------------------------------------
1453+ 86EE                  ; Scrive l'attributo colore
1454+ 86EE                  ; ---------------------------------------------------------------
1455+ 86EE
1456+ 86EE 7B               ld   a, e              ; A = colore
1457+ 86EF 77               ld   (hl), a           ; Scrive nella RAM attributi
1458+ 86F0
1459+ 86F0                  ; ---------------------------------------------------------------
1460+ 86F0                  ; Ripristina HL e BC originali
1461+ 86F0                  ; ---------------------------------------------------------------
1462+ 86F0
1463+ 86F0 C5               push bc
1464+ 86F1 E1               pop  hl                ; HL originale
1465+ 86F2
1466+ 86F2 C1               pop  bc                ; BC originale
1467+ 86F3
1468+ 86F3 C9               ret
1469+ 86F4
1470+ 86F4              ; -------------------------------------------------------------------
1471+ 86F4              ; RestoreBackgroundCell
1472+ 86F4              ;
1473+ 86F4              ; Ripristina il contenuto originale di una cella della stanza.
1474+ 86F4              ; Viene utilizzata principalmente quando un item viene raccolto:
1475+ 86F4              ; invece di lasciare un "buco", la routine ridisegna il tile
1476+ 86F4              ; originale presente nella mappa della stanza.
1477+ 86F4              ;
1478+ 86F4              ; Input:
1479+ 86F4              ;   B = Row (3..18)
1480+ 86F4              ;   C = Col (0..31)
1481+ 86F4              ;
1482+ 86F4              ; Utilizza:
1483+ 86F4              ;   room_ptr -> struttura dati della stanza corrente
1484+ 86F4              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1485+ 86F4              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1486+ 86F4              ;
1487+ 86F4              ; Tipi di cella:
1488+ 86F4              ;   0 = Background
1489+ 86F4              ;   1 = Floor
1490+ 86F4              ;   2 = Wall
1491+ 86F4              ;   3 = Nasty
1492+ 86F4              ; -------------------------------------------------------------------
1493+ 86F4              RestoreBackgroundCell:
1494+ 86F4
1495+ 86F4                  ; Salva tutti i registri utilizzati
1496+ 86F4 FD E5            push iy
1497+ 86F6 C5               push bc
1498+ 86F7 D5               push de
1499+ 86F8 E5               push hl
1500+ 86F9 DD E5            push ix
1501+ 86FB
1502+ 86FB                  ; ---------------------------------------------------------------
1503+ 86FB                  ; Conserva Row e Col in IY.
1504+ 86FB                  ;
1505+ 86FB                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1506+ 86FB                  ; BC potrebbe essere modificato.
1507+ 86FB                  ; ---------------------------------------------------------------
1508+ 86FB C5               push bc
1509+ 86FC FD E1            pop  iy                ; IYH = Row, IYL = Col
1510+ 86FE
1511+ 86FE                  ; ---------------------------------------------------------------
1512+ 86FE                  ; Determina quale tipo di cella è presente nella posizione
1513+ 86FE                  ; specificata.
1514+ 86FE                  ;
1515+ 86FE                  ; Input:
1516+ 86FE                  ;   B = Row
1517+ 86FE                  ;   C = Col
1518+ 86FE                  ;
1519+ 86FE                  ; Output:
1520+ 86FE                  ;   A = tipo cella
1521+ 86FE                  ; ---------------------------------------------------------------
1522+ 86FE 78               ld   a, b
1523+ 86FF
1524+ 86FF CD 8E 77         call GetCellFromUnpacked
1525+ 8702
1526+ 8702                  ; ---------------------------------------------------------------
1527+ 8702                  ; Recupera il puntatore alla stanza corrente.
1528+ 8702                  ;
1529+ 8702                  ; DE = base della struttura stanza
1530+ 8702                  ; ---------------------------------------------------------------
1531+ 8702 ED 5B 62 F8      ld   de, (room_ptr)
1532+ 8706
1533+ 8706                  ; ---------------------------------------------------------------
1534+ 8706                  ; Seleziona il tile corretto in base al tipo di cella.
1535+ 8706                  ;
1536+ 8706                  ; A = 0 -> Background
1537+ 8706                  ; A = 1 -> Floor
1538+ 8706                  ; A = 2 -> Wall
1539+ 8706                  ; A = 3 -> Nasty
1540+ 8706                  ; ---------------------------------------------------------------
1541+ 8706
1542+ 8706 B7               or   a
1543+ 8707 20 06            jr   nz, .not_bg
1544+ 8709
1545+ 8709                  ; Background
1546+ 8709 21 A0 00         ld   hl, OFFSET_BG
1547+ 870C 19               add  hl, de
1548+ 870D 18 16            jr   .draw_cell
1549+ 870F
1550+ 870F              .not_bg:
1551+ 870F
1552+ 870F 3D               dec  a
1553+ 8710 20 06            jr   nz, .not_floor
1554+ 8712
1555+ 8712                  ; Floor
1556+ 8712 21 A9 00         ld   hl, OFFSET_FLOOR
1557+ 8715 19               add  hl, de
1558+ 8716 18 0D            jr   .draw_cell
1559+ 8718
1560+ 8718              .not_floor:
1561+ 8718
1562+ 8718 3D               dec  a
1563+ 8719 20 06            jr   nz, .not_wall
1564+ 871B
1565+ 871B                  ; Wall
1566+ 871B 21 B2 00         ld   hl, OFFSET_WALL
1567+ 871E 19               add  hl, de
1568+ 871F 18 04            jr   .draw_cell
1569+ 8721
1570+ 8721              .not_wall:
1571+ 8721
1572+ 8721                  ; Nasty
1573+ 8721 21 BB 00         ld   hl, OFFSET_NASTY
1574+ 8724 19               add  hl, de
1575+ 8725
1576+ 8725              .draw_cell:
1577+ 8725
1578+ 8725                  ; ---------------------------------------------------------------
1579+ 8725                  ; HL punta ora alla grafica del tile da ridisegnare.
1580+ 8725                  ;
1581+ 8725                  ; Gfx_DrawTile si aspetta:
1582+ 8725                  ;   IX = puntatore tile
1583+ 8725                  ;   B  = Row
1584+ 8725                  ;   C  = Col
1585+ 8725                  ; ---------------------------------------------------------------
1586+ 8725 E5               push hl
1587+ 8726 DD E1            pop  ix
1588+ 8728
1589+ 8728                  ; Ripristina Row e Col salvati in IY
1590+ 8728 FD E5            push iy
1591+ 872A C1               pop  bc
1592+ 872B
1593+ 872B                  ; Disegna il tile originale
1594+ 872B CD 5D 6A         call Gfx_DrawTile
1595+ 872E
1596+ 872E                  ; ---------------------------------------------------------------
1597+ 872E                  ; Ripristina i registri salvati
1598+ 872E                  ; ---------------------------------------------------------------
1599+ 872E DD E1            pop  ix
1600+ 8730 E1               pop  hl
1601+ 8731 D1               pop  de
1602+ 8732 C1               pop  bc
1603+ 8733 FD E1            pop  iy
1604+ 8735
1605+ 8735 C9               ret
1606+ 8736
1607+ 8736              ; -------------------------------------------------------------------
1608+ 8736              ; CheckWillyItemCollision
1609+ 8736              ;
1610+ 8736              ; Verifica se Willy collide con un item utilizzando il controllo
1611+ 8736              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1612+ 8736              ;
1613+ 8736              ; Input:
1614+ 8736              ;   A = ItemX (colonna attributi 0..31)
1615+ 8736              ;   H = ItemY (riga attributi 3..18)
1616+ 8736              ;
1617+ 8736              ; Coordinate item:
1618+ 8736              ;   Ogni item occupa una cella da 8x8 pixel.
1619+ 8736              ;
1620+ 8736              ; Coordinate Willy:
1621+ 8736              ;   Willy occupa un rettangolo di 16x16 pixel.
1622+ 8736              ;
1623+ 8736              ; Output:
1624+ 8736              ;   Carry Set   = collisione rilevata
1625+ 8736              ;   Carry Clear = nessuna collisione
1626+ 8736              ;
1627+ 8736              ; Registri preservati:
1628+ 8736              ;   BC, DE, HL
1629+ 8736              ; -------------------------------------------------------------------
1630+ 8736              CheckWillyItemCollision:
1631+ 8736
1632+ 8736                  ; Salva i registri utilizzati
1633+ 8736 C5               push bc
1634+ 8737 D5               push de
1635+ 8738 E5               push hl
1636+ 8739
1637+ 8739                  ; ---------------------------------------------------------------
1638+ 8739                  ; Calcola il bounding box orizzontale dell'item
1639+ 8739                  ;
1640+ 8739                  ; ItemLeft  = ItemX * 8
1641+ 8739                  ; ItemRight = ItemLeft + 7
1642+ 8739                  ;
1643+ 8739                  ; E = ItemLeft
1644+ 8739                  ; D = ItemRight
1645+ 8739                  ; ---------------------------------------------------------------
1646+ 8739 6F               ld   l, a              ; L = ItemX
1647+ 873A
1648+ 873A 7D               ld   a, l
1649+ 873B 87               add  a, a              ; *2
1650+ 873C 87               add  a, a              ; *4
1651+ 873D 87               add  a, a              ; *8
1652+ 873E
1653+ 873E 5F               ld   e, a              ; E = ItemLeft
1654+ 873F
1655+ 873F C6 07            add  a, 7
1656+ 8741 57               ld   d, a              ; D = ItemRight
1657+ 8742
1658+ 8742                  ; ---------------------------------------------------------------
1659+ 8742                  ; Recupera la posizione corrente di Willy
1660+ 8742                  ;
1661+ 8742                  ; B = WillyY
1662+ 8742                  ; C = WillyX
1663+ 8742                  ; ---------------------------------------------------------------
1664+ 8742 ED 4B E2 F4      ld   bc, (PlayerPos)
1665+ 8746
1666+ 8746                  ; ---------------------------------------------------------------
1667+ 8746                  ; Primo test:
1668+ 8746                  ;
1669+ 8746                  ; WillyLeft <= ItemRight
1670+ 8746                  ;
1671+ 8746                  ; Se Willy è completamente a destra dell'item
1672+ 8746                  ; non può esserci collisione.
1673+ 8746                  ; ---------------------------------------------------------------
1674+ 8746 79               ld   a, c              ; A = WillyLeft
1675+ 8747
1676+ 8747 BA               cp   d                 ; WillyLeft vs ItemRight
1677+ 8748
1678+ 8748 28 04            jr   z, .x_ok
1679+ 874A 38 02            jr   c, .x_ok
1680+ 874C
1681+ 874C 18 29            jr   .no_collision
1682+ 874E
1683+ 874E              .x_ok:
1684+ 874E
1685+ 874E                  ; ---------------------------------------------------------------
1686+ 874E                  ; Secondo test:
1687+ 874E                  ;
1688+ 874E                  ; WillyRight >= ItemLeft
1689+ 874E                  ;
1690+ 874E                  ; WillyRight = WillyX + 7
1691+ 874E                  ; ---------------------------------------------------------------
1692+ 874E C6 07            add  a, 7
1693+ 8750
1694+ 8750 BB               cp   e                 ; WillyRight vs ItemLeft
1695+ 8751
1696+ 8751 28 04            jr   z, .y_check
1697+ 8753 30 02            jr   nc, .y_check
1698+ 8755
1699+ 8755 18 20            jr   .no_collision
1700+ 8757
1701+ 8757              .y_check:
1702+ 8757
1703+ 8757                  ; ---------------------------------------------------------------
1704+ 8757                  ; Recupera ItemY dal valore originale di HL
1705+ 8757                  ;
1706+ 8757                  ; H contiene la riga dell'item.
1707+ 8757                  ; ---------------------------------------------------------------
1708+ 8757 E1               pop  hl
1709+ 8758 E5               push hl
1710+ 8759
1711+ 8759                  ; ---------------------------------------------------------------
1712+ 8759                  ; Calcola il bounding box verticale dell'item
1713+ 8759                  ;
1714+ 8759                  ; ItemTop    = ItemY * 8
1715+ 8759                  ; ItemBottom = ItemTop + 7
1716+ 8759                  ;
1717+ 8759                  ; E = ItemTop
1718+ 8759                  ; D = ItemBottom
1719+ 8759                  ; ---------------------------------------------------------------
1720+ 8759 7C               ld   a, h
1721+ 875A
1722+ 875A 87               add  a, a              ; *2
1723+ 875B 87               add  a, a              ; *4
1724+ 875C 87               add  a, a              ; *8
1725+ 875D
1726+ 875D 5F               ld   e, a              ; ItemTop
1727+ 875E
1728+ 875E C6 07            add  a, 7
1729+ 8760 57               ld   d, a              ; ItemBottom
1730+ 8761
1731+ 8761                  ; ---------------------------------------------------------------
1732+ 8761                  ; Primo test verticale:
1733+ 8761                  ;
1734+ 8761                  ; WillyTop <= ItemBottom
1735+ 8761                  ; ---------------------------------------------------------------
1736+ 8761 78               ld   a, b              ; WillyTop
1737+ 8762
1738+ 8762 BA               cp   d
1739+ 8763
1740+ 8763 28 04            jr   z, .y_ok
1741+ 8765 38 02            jr   c, .y_ok
1742+ 8767
1743+ 8767 18 0E            jr   .no_collision
1744+ 8769
1745+ 8769              .y_ok:
1746+ 8769
1747+ 8769                  ; ---------------------------------------------------------------
1748+ 8769                  ; Secondo test verticale:
1749+ 8769                  ;
1750+ 8769                  ; WillyBottom >= ItemTop
1751+ 8769                  ;
1752+ 8769                  ; WillyBottom = WillyY + 15
1753+ 8769                  ; ---------------------------------------------------------------
1754+ 8769 C6 0F            add  a, 15
1755+ 876B
1756+ 876B BB               cp   e
1757+ 876C
1758+ 876C 28 04            jr   z, .collision
1759+ 876E 30 02            jr   nc, .collision
1760+ 8770
1761+ 8770 18 05            jr   .no_collision
1762+ 8772
1763+ 8772              .collision:
1764+ 8772
1765+ 8772                  ; ---------------------------------------------------------------
1766+ 8772                  ; Collisione rilevata
1767+ 8772                  ; ---------------------------------------------------------------
1768+ 8772 E1               pop  hl
1769+ 8773 D1               pop  de
1770+ 8774 C1               pop  bc
1771+ 8775
1772+ 8775 37               scf                    ; Carry = 1
1773+ 8776
1774+ 8776 C9               ret
1775+ 8777
1776+ 8777              .no_collision:
1777+ 8777
1778+ 8777                  ; ---------------------------------------------------------------
1779+ 8777                  ; Nessuna collisione
1780+ 8777                  ; ---------------------------------------------------------------
1781+ 8777 E1               pop  hl
1782+ 8778 D1               pop  de
1783+ 8779 C1               pop  bc
1784+ 877A
1785+ 877A B7               or   a                 ; Carry = 0
1786+ 877B
1787+ 877B C9               ret
1788+ 877C
1789+ 877C              ; -------------------------------------------------------------------
1790+ 877C              ; Items_CheckCollision
1791+ 877C              ;
1792+ 877C              ; Controlla se Willy entra in collisione con uno degli item
1793+ 877C              ; attivi presenti nella stanza corrente.
1794+ 877C              ;
1795+ 877C              ; Per ogni item:
1796+ 877C              ;   - verifica che appartenga alla stanza corrente
1797+ 877C              ;   - verifica che non sia già stato raccolto
1798+ 877C              ;   - esegue il test di collisione con Willy
1799+ 877C              ;
1800+ 877C              ; Se l'item viene raccolto:
1801+ 877C              ;   - imposta il flag "collected"
1802+ 877C              ;   - rimuove l'item dalla cache items_grid
1803+ 877C              ;   - incrementa il contatore degli oggetti raccolti
1804+ 877C              ;   - aggiorna l'HUD
1805+ 877C              ;   - ripristina il tile di sfondo
1806+ 877C              ;   - riproduce il suono di raccolta
1807+ 877C              ;
1808+ 877C              ; Formato record ItemsTable:
1809+ 877C              ;   +0 RoomID
1810+ 877C              ;   +1 X
1811+ 877C              ;   +2 Y
1812+ 877C              ;   +3 Color
1813+ 877C              ;   +4 Collected
1814+ 877C              ;
1815+ 877C              ; Fine tabella:
1816+ 877C              ;   RoomID = $FF
1817+ 877C              ; -------------------------------------------------------------------
1818+ 877C              Items_CheckCollision:
1819+ 877C
1820+ 877C                  ; Salva i registri utilizzati
1821+ 877C E5               push hl
1822+ 877D D5               push de
1823+ 877E C5               push bc
1824+ 877F
1825+ 877F                  ; Inizio scansione della tabella degli item
1826+ 877F 21 C7 80         ld   hl, ItemsTable
1827+ 8782
1828+ 8782              .loop:
1829+ 8782
1830+ 8782                  ; ---------------------------------------------------------------
1831+ 8782                  ; Legge il Room ID dell'item corrente
1832+ 8782                  ; ---------------------------------------------------------------
1833+ 8782 7E               ld   a, (hl)
1834+ 8783
1835+ 8783                  ; $FF indica fine tabella
1836+ 8783 FE FF            cp   $FF
1837+ 8785 28 58            jr   z, .done
1838+ 8787
1839+ 8787                  ; ---------------------------------------------------------------
1840+ 8787                  ; Verifica se l'item appartiene alla stanza corrente
1841+ 8787                  ; ---------------------------------------------------------------
1842+ 8787 57               ld   d, a              ; D = RoomID item
1843+ 8788
1844+ 8788 3A 08 F8         ld   a, (current_room)
1845+ 878B BA               cp   d
1846+ 878C
1847+ 878C                  ; Se appartiene a un'altra stanza salta il record
1848+ 878C 20 4A            jr   nz, .next_item
1849+ 878E
