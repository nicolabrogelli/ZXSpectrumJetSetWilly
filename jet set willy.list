 128+ 5E44 CD 0E 5E         call GetScreenAddr ; HL = indirizzo schermo
 129+ 5E47
 130+ 5E47                  ; 2. Calcola offset shift = X & 7
 131+ 5E47 79               ld   a, c
 132+ 5E48 E6 07            and  7
 133+ 5E4A 47               ld   b, a          ; B = shift offset (0..7)
 134+ 5E4B
 135+ 5E4B 0E 08            ld   c, 8          ; 8 linee
 136+ 5E4D              .line_loop:
 137+ 5E4D DD 7E 00         ld   a, (ix+0)     ; A = byte dello sprite
 138+ 5E50 57               ld   d, a
