1829+ 79E2 7E               ld   a, (hl)
1830+ 79E3 B7               or   a
1831+ 79E4 20 0C            jr   nz, .custom_settings
1832+ 79E6
1833+ 79E6 3E 06            ld   a, DEFAULT_JUMP_STRENGTH
