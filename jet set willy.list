1869+ 72C8 30 17            jr   nc, .not_nasty
1870+ 72CA
1871+ 72CA                  ; 2. Calcola riga di layout: r = Y / 8
1872+ 72CA CB 3F            srl  a
1873+ 72CC CB 3F            srl  a
1874+ 72CE CB 3F            srl  a                 ; A = r (0..15)
1875+ 72D0
1876+ 72D0                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1877+ 72D0 5F               ld   e, a              ; E = r
1878+ 72D1 79               ld   a, c
1879+ 72D2 CB 3F            srl  a
1880+ 72D4 CB 3F            srl  a
1881+ 72D6 CB 3F            srl  a                 ; A = c (0..31)
1882+ 72D8 4F               ld   c, a              ; C = c
1883+ 72D9 7B               ld   a, e              ; A = r
1884+ 72DA
1885+ 72DA CD 48 70         call GetCellFromUnpacked ; A = cell type
1886+ 72DD
1887+ 72DD                  ; Controlla se è Nasty (3)
1888+ 72DD FE 03            cp   3
1889+ 72DF 28 05            jr   z, .is_nasty
