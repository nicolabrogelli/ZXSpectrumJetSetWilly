1131+ 6BC5 07               rlca
1132+ 6BC6 E6 03            and  3
1133+ 6BC8 12               ld   (de), a
1134+ 6BC9 13               inc  de
1135+ 6BCA
1136+ 6BCA                  ; Cella 1: bit 5-4
1137+ 6BCA 79               ld   a, c
1138+ 6BCB 07               rlca
1139+ 6BCC 07               rlca
1140+ 6BCD 07               rlca
1141+ 6BCE 07               rlca
1142+ 6BCF E6 03            and  3
1143+ 6BD1 12               ld   (de), a
1144+ 6BD2 13               inc  de
