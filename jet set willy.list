   1+ 7A6E              ;===========================================================================
   2+ 7A6E              ; audio.asm
   3+ 7A6E              ;
   4+ 7A6E              ; Gestione degli effetti sonori e della musica di sottofondo per il beeper.
   5+ 7A6E              ;===========================================================================
   6+ 7A6E
   7+ 7A6E              ; -------------------------------------------------------------------
   8+ 7A6E              ; Audio_UpdateJumpSound
   9+ 7A6E              ;
  10+ 7A6E              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7A6E              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7A6E              ; -------------------------------------------------------------------
  13+ 7A6E              Audio_UpdateJumpSound:
  14+ 7A6E F5               push af
  15+ 7A6F C5               push bc
  16+ 7A70 D5               push de
  17+ 7A71 E5               push hl
  18+ 7A72
  19+ 7A72                  ; Controlla se il suono è attivo (note < 18)
  20+ 7A72 3A 5B 7E         ld   a, (Audio_jump_sound_note)
  21+ 7A75 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7A77 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7A79
  24+ 7A79                  ; Carica la nota corrente da suonare
  25+ 7A79 5F               ld   e, a
  26+ 7A7A 16 00            ld   d, 0
  27+ 7A7C 21 A8 7A         ld   hl, Audio_JumpSoundDelays
  28+ 7A7F 19               add  hl, de
  29+ 7A80 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7A81 57               ld   d, a                      ; D = delay della nota
  31+ 7A82
  32+ 7A82                  ; Suona la nota: 15 cicli
  33+ 7A82 06 0F            ld   b, 15
  34+ 7A84              .note_loop:
  35+ 7A84                  ; Speaker ON
  36+ 7A84 3A E8 7A         ld   a, (room_border_color)
  37+ 7A87 F6 10            or   $10
  38+ 7A89 D3 FE            out  ($fe), a
  39+ 7A8B 4A               ld   c, d
  40+ 7A8C              .d1:
  41+ 7A8C 0D               dec  c
  42+ 7A8D 20 FD            jr   nz, .d1
  43+ 7A8F
  44+ 7A8F                  ; Speaker OFF
  45+ 7A8F 3A E8 7A         ld   a, (room_border_color)
  46+ 7A92 E6 EF            and  $ef
  47+ 7A94 D3 FE            out  ($fe), a
  48+ 7A96 4A               ld   c, d
  49+ 7A97              .d2:
  50+ 7A97 0D               dec  c
  51+ 7A98 20 FD            jr   nz, .d2
  52+ 7A9A
  53+ 7A9A 10 E8            djnz .note_loop
  54+ 7A9C
  55+ 7A9C                  ; Passa alla nota successiva
  56+ 7A9C 3A 5B 7E         ld   a, (Audio_jump_sound_note)
  57+ 7A9F 3C               inc  a
  58+ 7AA0 32 5B 7E         ld   (Audio_jump_sound_note), a
  59+ 7AA3
  60+ 7AA3              .done:
  61+ 7AA3 E1               pop  hl
  62+ 7AA4 D1               pop  de
  63+ 7AA5 C1               pop  bc
  64+ 7AA6 F1               pop  af
  65+ 7AA7 C9               ret
