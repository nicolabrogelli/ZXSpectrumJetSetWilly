 454+ 761C
 455+ 761C 23               inc  hl                ; HL punta a X
 456+ 761D 4E               ld   c, (hl)           ; C = X
 457+ 761E 23               inc  hl                ; HL punta a Y
 458+ 761F 46               ld   b, (hl)           ; B = Y
