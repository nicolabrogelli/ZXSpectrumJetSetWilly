 279  8995              ; -------------------------------------------------------------------
 280  8995              ; ShowTitleScreen
 281  8995              ; Visualizza la schermata iniziale del gioco (Title Screen).
 282  8995              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 283  8995              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 284  8995              ; -------------------------------------------------------------------
 285  8995              ShowTitleScreen:
 286  8995                  ; 1. Disegna la schermata iniziale
 287  8995 CD 1B 63         call Gfx_DrawTitleScreen
 288  8998
 289  8998                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 290  8998              .wait_title_enter_release:
 291  8998 76               halt
 292  8999 3E BF            ld   a, $bf
 293  899B DB FE            in   a, ($fe)
 294  899D 1F               rra
 295  899E 30 F8            jr   nc, .wait_title_enter_release
 296  89A0
 297  89A0                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 298  89A0 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 299  89A2              .title_loop:
 300  89A2 76               halt
 301  89A3
 302  89A3                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 303  89A3 0C               inc  c
 304  89A4 79               ld   a, c
 305  89A5 CB 3F            srl  a
 306  89A7 CB 3F            srl  a
 307  89A9 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 308  89AB E6 07            and  7
 309  89AD 5F               ld   e, a
 310  89AE 16 00            ld   d, 0
 311  89B0 21 13 63         ld   hl, title_color_table
 312  89B3 19               add  hl, de
 313  89B4 7E               ld   a, (hl)               ; A = nuovo colore
 314  89B5 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 315  89B8 06 20            ld   b, 32
 316  89BA              .color_title_loop:
 317  89BA 77               ld   (hl), a
 318  89BB 23               inc  hl
 319  89BC 10 FC            djnz .color_title_loop
 320  89BE
 321  89BE                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 322  89BE 3E BF            ld   a, $bf
 323  89C0 DB FE            in   a, ($fe)
 324  89C2 1F               rra
 325  89C3 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 326  89C5
 327  89C5                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 328  89C5              .wait_title_enter_release_after:
 329  89C5 76               halt
 330  89C6 3E BF            ld   a, $bf
 331  89C8 DB FE            in   a, ($fe)
 332  89CA 1F               rra
 333  89CB 30 F8            jr   nc, .wait_title_enter_release_after
 334  89CD
 335  89CD                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 336  89CD AF               xor  a
 337  89CE D3 FE            out  ($fe), a              ; Bordo a nero
 338  89D0 21 8D 5C         ld   hl, ATTR_P
 339  89D3 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 340  89D4 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 341  89D7 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 342  89D9 3E 07            ld   a, $07
 343  89DB 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 344  89DE
 345  89DE                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 346  89DE CD 45 8C         call ResetFullGameState
 347  89E1
 348  89E1                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 349  89E1 C3 77 88         jp   LoadRoomAndRestart
