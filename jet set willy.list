 836+ 6A96 3A 20 78         ld   a, (ramp_len)
 837+ 6A99 80               add  a, b              ; A = ramp_col + ramp_len
 838+ 6A9A 4F               ld   c, a              ; C = limit_right (exclusive)
 839+ 6A9B
 840+ 6A9B 7B               ld   a, e              ; A = Col
 841+ 6A9C B8               cp   b
 842+ 6A9D 38 34            jr   c, .check_platform_case ; Col < ramp_col
 843+ 6A9F B9               cp   c
 844+ 6AA0 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 845+ 6AA2
 846+ 6AA2                  ; Calcola B = Col - ramp_col
 847+ 6AA2 7B               ld   a, e
 848+ 6AA3 90               sub  b
 849+ 6AA4 47               ld   b, a              ; B = offset (0..ramp_len-1)
 850+ 6AA5
 851+ 6AA5                  ; SlopeRow = ramp_row - B
 852+ 6AA5 3A 21 78         ld   a, (ramp_row)
 853+ 6AA8 90               sub  b
 854+ 6AA9 47               ld   b, a              ; B = SlopeRow
 855+ 6AAA 18 1F            jr   .check_row_match
