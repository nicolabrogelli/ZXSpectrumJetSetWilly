 781+ 618C              ; -------------------------------------------------------------------
 782+ 618C              ; Disegna un tile 8x8 sullo schermo
 783+ 618C              ; Input: B = Row (0..23), C = Col (0..31), IX = Puntatore al Tile (9 byte: 1 attr + 8 bitmap)
 784+ 618C              ; -------------------------------------------------------------------
 785+ 618C              DrawTile:
 786+ 618C C5               push bc
 787+ 618D D5               push de
 788+ 618E E5               push hl
 789+ 618F
 790+ 618F                  ; 1. Calcola indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 791+ 618F                  ; HighByte = $40 + (B & $18)
 792+ 618F 78               ld   a, b
 793+ 6190 E6 18            and  $18
 794+ 6192 C6 40            add  a, $40
 795+ 6194 67               ld   h, a              ; H = High byte
 796+ 6195
 797+ 6195                  ; LowByte = ((B & 7) * 32) + C
 798+ 6195 78               ld   a, b
 799+ 6196 E6 07            and  7
 800+ 6198 87               add  a, a              ; *2
 801+ 6199 87               add  a, a              ; *4
 802+ 619A 87               add  a, a              ; *8
 803+ 619B 87               add  a, a              ; *16
 804+ 619C 87               add  a, a              ; *32
 805+ 619D 81               add  a, c              ; + Col C
 806+ 619E 6F               ld   l, a              ; L = Low byte
 807+ 619F
 808+ 619F                  ; 2. Copia gli 8 byte del bitmap
 809+ 619F 16 08            ld   d, 8              ; 8 scanline
 810+ 61A1 DD E5            push ix
 811+ 61A3 DD 23            inc  ix                ; Salta l'attributo, vai al bitmap
 812+ 61A5              .line_loop:
 813+ 61A5 DD 7E 00         ld   a, (ix+0)
 814+ 61A8 77               ld   (hl), a
 815+ 61A9 24               inc  h                 ; Prossima scanline (stessa riga di caratteri)
 816+ 61AA DD 23            inc  ix
 817+ 61AC 15               dec  d
 818+ 61AD 20 F6            jr   nz, .line_loop
 819+ 61AF DD E1            pop  ix
 820+ 61B1
 821+ 61B1                  ; 3. Scrivi l'attributo
 822+ 61B1                  ; AttrAddr = $5800 + B * 32 + C
