 351  89E4              ; -------------------------------------------------------------------
 352  89E4              ; TriggerGameOver
 353  89E4              ; Scatena la schermata di Game Over per la stanza corrente.
 354  89E4              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 355  89E4              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 356  89E4              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 357  89E4              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 358  89E4              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 359  89E4              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 360  89E4              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 361  89E4              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 362  89E4              ; -------------------------------------------------------------------
 363  89E4              TriggerGameOver:
 364  89E4                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 365  89E4 CD FC 64         call Gfx_DrawGameOverScreen
 366  89E7
 367  89E7                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 368  89E7              .wait_keys_release:
 369  89E7 76               halt
 370  89E8                  ; Controlla tasto Y (Porta $DF, bit 4)
 371  89E8 01 FE DF         ld   bc, $dffe
 372  89EB ED 78            in   a, (c)
 373  89ED CB 67            bit  4, a
 374  89EF 28 F6            jr   z, .wait_keys_release
 375  89F1
 376  89F1                  ; Controlla tasto N (Porta $7F, bit 3)
 377  89F1 01 FE 7F         ld   bc, $7ffe
 378  89F4 ED 78            in   a, (c)
 379  89F6 CB 5F            bit  3, a
 380  89F8 28 ED            jr   z, .wait_keys_release
 381  89FA
 382  89FA                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 383  89FA 01 FE BF         ld   bc, $bffe
 384  89FD ED 78            in   a, (c)
 385  89FF CB 47            bit  0, a
 386  8A01 28 E4            jr   z, .wait_keys_release
 387  8A03
 388  8A03                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 389  8A03 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
