  69+ 7146              ; DetermineCurrentRoomID
  70+ 7146              ;
  71+ 7146              ; Determina l'ID numerico della stanza corrente confrontando
  72+ 7146              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  73+ 7146              ;
  74+ 7146              ; Se viene trovata una corrispondenza:
  75+ 7146              ;   A = ID della stanza
  76+ 7146              ;   current_room = A
  77+ 7146              ;
  78+ 7146              ; Mappatura:
  79+ 7146              ;    0 = The Off Licence
  80+ 7146              ;    1 = The Bridge
  81+ 7146              ;    2 = Under The Mega Tree
  82+ 7146              ;    3 = Gfx_At The Foot Of The Mega Tree
  83+ 7146              ;    4 = The Drive
  84+ 7146              ;    5 = The Security Guard
  85+ 7146              ;    6 = Entrance To Hades
  86+ 7146              ;    7 = Cuckoo's Nest
  87+ 7146              ;    8 = Inside The Mega Trunk
  88+ 7146              ;    9 = On A Branch Over The Drive
  89+ 7146              ;   10 = The Front Door
  90+ 7146              ;   11 = The Hall
  91+ 7146              ;   12 = Tree Top
  92+ 7146              ;   33 = The Bathroom
  93+ 7146              ;   35 = Master Bedroom
  94+ 7146              ;
  95+ 7146              ; Se nessuna stanza corrisponde viene impostato:
  96+ 7146              ;   current_room = 0
  97+ 7146              ; -------------------------------------------------------------------
