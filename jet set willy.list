481+  5FC9              ; -------------------------------------------------------------------
482+  5FC9              ; NUOVA ROUTINE: Disegna bordi verticali
483+  5FC9              ; Input: B = riga di partenza, C = numero di righe
484+  5FC9              ; -------------------------------------------------------------------
485+  5FC9              DrawVerticalBorders:
486+  5FC9 C5               push bc
487+  5FCA D5               push de
