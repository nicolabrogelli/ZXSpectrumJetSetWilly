 966+ 803C DD BE 05         cp   (ix+5)            ; Max Limit (Offset 5)
 967+ 803F 28 08            jr   z, .h_rev_left
 968+ 8041 30 06            jr   nc, .h_rev_left
 969+ 8043 DD 77 02         ld   (ix+2), a
