1210+ 7A11              ; -------------------------------------------------------------------
1211+ 7A11              ; RestoreBackgroundCell
1212+ 7A11              ;
1213+ 7A11              ; Ripristina il contenuto originale di una cella della stanza.
1214+ 7A11              ; Viene utilizzata principalmente quando un item viene raccolto:
1215+ 7A11              ; invece di lasciare un "buco", la routine ridisegna il tile
1216+ 7A11              ; originale presente nella mappa della stanza.
1217+ 7A11              ;
1218+ 7A11              ; Input:
1219+ 7A11              ;   B = Row (3..18)
1220+ 7A11              ;   C = Col (0..31)
1221+ 7A11              ;
1222+ 7A11              ; Utilizza:
1223+ 7A11              ;   room_ptr -> struttura dati della stanza corrente
1224+ 7A11              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1225+ 7A11              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1226+ 7A11              ;
1227+ 7A11              ; Tipi di cella:
1228+ 7A11              ;   0 = Background
1229+ 7A11              ;   1 = Floor
1230+ 7A11              ;   2 = Wall
1231+ 7A11              ;   3 = Nasty
1232+ 7A11              ; -------------------------------------------------------------------
1233+ 7A11              RestoreBackgroundCell:
1234+ 7A11
1235+ 7A11                  ; Salva tutti i registri utilizzati
1236+ 7A11 FD E5            push iy
1237+ 7A13 C5               push bc
1238+ 7A14 D5               push de
1239+ 7A15 E5               push hl
1240+ 7A16 DD E5            push ix
1241+ 7A18
1242+ 7A18                  ; ---------------------------------------------------------------
1243+ 7A18                  ; Conserva Row e Col in IY.
1244+ 7A18                  ;
1245+ 7A18                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1246+ 7A18                  ; BC potrebbe essere modificato.
1247+ 7A18                  ; ---------------------------------------------------------------
1248+ 7A18 C5               push bc
1249+ 7A19 FD E1            pop  iy                ; IYH = Row, IYL = Col
1250+ 7A1B
1251+ 7A1B                  ; ---------------------------------------------------------------
1252+ 7A1B                  ; Determina quale tipo di cella è presente nella posizione
1253+ 7A1B                  ; specificata.
1254+ 7A1B                  ;
1255+ 7A1B                  ; Input:
1256+ 7A1B                  ;   B = Row
1257+ 7A1B                  ;   C = Col
1258+ 7A1B                  ;
1259+ 7A1B                  ; Output:
1260+ 7A1B                  ;   A = tipo cella
1261+ 7A1B                  ; ---------------------------------------------------------------
1262+ 7A1B 78               ld   a, b
1263+ 7A1C
1264+ 7A1C CD D4 6C         call GetCellFromUnpacked
1265+ 7A1F
1266+ 7A1F                  ; ---------------------------------------------------------------
1267+ 7A1F                  ; Recupera il puntatore alla stanza corrente.
1268+ 7A1F                  ;
1269+ 7A1F                  ; DE = base della struttura stanza
1270+ 7A1F                  ; ---------------------------------------------------------------
1271+ 7A1F ED 5B FA 7E      ld   de, (room_ptr)
1272+ 7A23
1273+ 7A23                  ; ---------------------------------------------------------------
1274+ 7A23                  ; Seleziona il tile corretto in base al tipo di cella.
1275+ 7A23                  ;
1276+ 7A23                  ; A = 0 -> Background
1277+ 7A23                  ; A = 1 -> Floor
1278+ 7A23                  ; A = 2 -> Wall
1279+ 7A23                  ; A = 3 -> Nasty
1280+ 7A23                  ; ---------------------------------------------------------------
1281+ 7A23
1282+ 7A23 B7               or   a
1283+ 7A24 20 06            jr   nz, .not_bg
1284+ 7A26
1285+ 7A26                  ; Background
1286+ 7A26 21 A0 00         ld   hl, OFFSET_BG
1287+ 7A29 19               add  hl, de
1288+ 7A2A 18 16            jr   .draw_cell
1289+ 7A2C
1290+ 7A2C              .not_bg:
1291+ 7A2C
1292+ 7A2C 3D               dec  a
1293+ 7A2D 20 06            jr   nz, .not_floor
1294+ 7A2F
1295+ 7A2F                  ; Floor
1296+ 7A2F 21 A9 00         ld   hl, OFFSET_FLOOR
1297+ 7A32 19               add  hl, de
1298+ 7A33 18 0D            jr   .draw_cell
1299+ 7A35
1300+ 7A35              .not_floor:
1301+ 7A35
1302+ 7A35 3D               dec  a
1303+ 7A36 20 06            jr   nz, .not_wall
1304+ 7A38
1305+ 7A38                  ; Wall
1306+ 7A38 21 B2 00         ld   hl, OFFSET_WALL
1307+ 7A3B 19               add  hl, de
1308+ 7A3C 18 04            jr   .draw_cell
1309+ 7A3E
1310+ 7A3E              .not_wall:
1311+ 7A3E
1312+ 7A3E                  ; Nasty
1313+ 7A3E 21 BB 00         ld   hl, OFFSET_NASTY
1314+ 7A41 19               add  hl, de
1315+ 7A42
1316+ 7A42              .draw_cell:
1317+ 7A42
1318+ 7A42                  ; ---------------------------------------------------------------
1319+ 7A42                  ; HL punta ora alla grafica del tile da ridisegnare.
1320+ 7A42                  ;
1321+ 7A42                  ; Gfx_DrawTile si aspetta:
1322+ 7A42                  ;   IX = puntatore tile
1323+ 7A42                  ;   B  = Row
1324+ 7A42                  ;   C  = Col
1325+ 7A42                  ; ---------------------------------------------------------------
1326+ 7A42 E5               push hl
1327+ 7A43 DD E1            pop  ix
1328+ 7A45
1329+ 7A45                  ; Ripristina Row e Col salvati in IY
1330+ 7A45 FD E5            push iy
1331+ 7A47 C1               pop  bc
1332+ 7A48
1333+ 7A48                  ; Disegna il tile originale
1334+ 7A48 CD 47 62         call Gfx_DrawTile
1335+ 7A4B
1336+ 7A4B                  ; ---------------------------------------------------------------
1337+ 7A4B                  ; Ripristina i registri salvati
1338+ 7A4B                  ; ---------------------------------------------------------------
1339+ 7A4B DD E1            pop  ix
1340+ 7A4D E1               pop  hl
1341+ 7A4E D1               pop  de
1342+ 7A4F C1               pop  bc
1343+ 7A50 FD E1            pop  iy
1344+ 7A52
1345+ 7A52 C9               ret
1346+ 7A53
1347+ 7A53              ; -------------------------------------------------------------------
1348+ 7A53              ; CheckWillyItemCollision
1349+ 7A53              ;
1350+ 7A53              ; Verifica se Willy collide con un item utilizzando il controllo
1351+ 7A53              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1352+ 7A53              ;
1353+ 7A53              ; Input:
1354+ 7A53              ;   A = ItemX (colonna attributi 0..31)
1355+ 7A53              ;   H = ItemY (riga attributi 3..18)
1356+ 7A53              ;
1357+ 7A53              ; Coordinate item:
1358+ 7A53              ;   Ogni item occupa una cella da 8x8 pixel.
1359+ 7A53              ;
1360+ 7A53              ; Coordinate Willy:
1361+ 7A53              ;   Willy occupa un rettangolo di 16x16 pixel.
1362+ 7A53              ;
1363+ 7A53              ; Output:
1364+ 7A53              ;   Carry Set   = collisione rilevata
1365+ 7A53              ;   Carry Clear = nessuna collisione
1366+ 7A53              ;
1367+ 7A53              ; Registri preservati:
1368+ 7A53              ;   BC, DE, HL
1369+ 7A53              ; -------------------------------------------------------------------
1370+ 7A53              CheckWillyItemCollision:
1371+ 7A53
1372+ 7A53                  ; Salva i registri utilizzati
1373+ 7A53 C5               push bc
1374+ 7A54 D5               push de
1375+ 7A55 E5               push hl
1376+ 7A56
1377+ 7A56                  ; ---------------------------------------------------------------
1378+ 7A56                  ; Calcola il bounding box orizzontale dell'item
1379+ 7A56                  ;
1380+ 7A56                  ; ItemLeft  = ItemX * 8
1381+ 7A56                  ; ItemRight = ItemLeft + 7
1382+ 7A56                  ;
1383+ 7A56                  ; E = ItemLeft
1384+ 7A56                  ; D = ItemRight
1385+ 7A56                  ; ---------------------------------------------------------------
1386+ 7A56 6F               ld   l, a              ; L = ItemX
1387+ 7A57
1388+ 7A57 7D               ld   a, l
1389+ 7A58 87               add  a, a              ; *2
1390+ 7A59 87               add  a, a              ; *4
1391+ 7A5A 87               add  a, a              ; *8
1392+ 7A5B
1393+ 7A5B 5F               ld   e, a              ; E = ItemLeft
1394+ 7A5C
1395+ 7A5C C6 07            add  a, 7
1396+ 7A5E 57               ld   d, a              ; D = ItemRight
1397+ 7A5F
1398+ 7A5F                  ; ---------------------------------------------------------------
1399+ 7A5F                  ; Recupera la posizione corrente di Willy
1400+ 7A5F                  ;
1401+ 7A5F                  ; B = WillyY
1402+ 7A5F                  ; C = WillyX
1403+ 7A5F                  ; ---------------------------------------------------------------
1404+ 7A5F ED 4B 81 7B      ld   bc, (PlayerPos)
1405+ 7A63
1406+ 7A63                  ; ---------------------------------------------------------------
1407+ 7A63                  ; Primo test:
1408+ 7A63                  ;
1409+ 7A63                  ; WillyLeft <= ItemRight
1410+ 7A63                  ;
1411+ 7A63                  ; Se Willy è completamente a destra dell'item
1412+ 7A63                  ; non può esserci collisione.
1413+ 7A63                  ; ---------------------------------------------------------------
1414+ 7A63 79               ld   a, c              ; A = WillyLeft
1415+ 7A64
1416+ 7A64 BA               cp   d                 ; WillyLeft vs ItemRight
1417+ 7A65
1418+ 7A65 28 04            jr   z, .x_ok
1419+ 7A67 38 02            jr   c, .x_ok
1420+ 7A69
1421+ 7A69 18 29            jr   .no_collision
1422+ 7A6B
1423+ 7A6B              .x_ok:
1424+ 7A6B
1425+ 7A6B                  ; ---------------------------------------------------------------
1426+ 7A6B                  ; Secondo test:
1427+ 7A6B                  ;
1428+ 7A6B                  ; WillyRight >= ItemLeft
1429+ 7A6B                  ;
1430+ 7A6B                  ; WillyRight = WillyX + 7
1431+ 7A6B                  ; ---------------------------------------------------------------
1432+ 7A6B C6 07            add  a, 7
1433+ 7A6D
1434+ 7A6D BB               cp   e                 ; WillyRight vs ItemLeft
1435+ 7A6E
1436+ 7A6E 28 04            jr   z, .y_check
1437+ 7A70 30 02            jr   nc, .y_check
1438+ 7A72
1439+ 7A72 18 20            jr   .no_collision
1440+ 7A74
1441+ 7A74              .y_check:
1442+ 7A74
1443+ 7A74                  ; ---------------------------------------------------------------
1444+ 7A74                  ; Recupera ItemY dal valore originale di HL
1445+ 7A74                  ;
1446+ 7A74                  ; H contiene la riga dell'item.
1447+ 7A74                  ; ---------------------------------------------------------------
1448+ 7A74 E1               pop  hl
1449+ 7A75 E5               push hl
1450+ 7A76
1451+ 7A76                  ; ---------------------------------------------------------------
1452+ 7A76                  ; Calcola il bounding box verticale dell'item
1453+ 7A76                  ;
1454+ 7A76                  ; ItemTop    = ItemY * 8
1455+ 7A76                  ; ItemBottom = ItemTop + 7
1456+ 7A76                  ;
1457+ 7A76                  ; E = ItemTop
1458+ 7A76                  ; D = ItemBottom
1459+ 7A76                  ; ---------------------------------------------------------------
1460+ 7A76 7C               ld   a, h
1461+ 7A77
1462+ 7A77 87               add  a, a              ; *2
1463+ 7A78 87               add  a, a              ; *4
1464+ 7A79 87               add  a, a              ; *8
1465+ 7A7A
1466+ 7A7A 5F               ld   e, a              ; ItemTop
1467+ 7A7B
1468+ 7A7B C6 07            add  a, 7
1469+ 7A7D 57               ld   d, a              ; ItemBottom
1470+ 7A7E
1471+ 7A7E                  ; ---------------------------------------------------------------
1472+ 7A7E                  ; Primo test verticale:
1473+ 7A7E                  ;
1474+ 7A7E                  ; WillyTop <= ItemBottom
1475+ 7A7E                  ; ---------------------------------------------------------------
1476+ 7A7E 78               ld   a, b              ; WillyTop
1477+ 7A7F
1478+ 7A7F BA               cp   d
1479+ 7A80
1480+ 7A80 28 04            jr   z, .y_ok
1481+ 7A82 38 02            jr   c, .y_ok
1482+ 7A84
1483+ 7A84 18 0E            jr   .no_collision
1484+ 7A86
1485+ 7A86              .y_ok:
1486+ 7A86
1487+ 7A86                  ; ---------------------------------------------------------------
1488+ 7A86                  ; Secondo test verticale:
1489+ 7A86                  ;
1490+ 7A86                  ; WillyBottom >= ItemTop
1491+ 7A86                  ;
1492+ 7A86                  ; WillyBottom = WillyY + 15
1493+ 7A86                  ; ---------------------------------------------------------------
1494+ 7A86 C6 0F            add  a, 15
1495+ 7A88
1496+ 7A88 BB               cp   e
1497+ 7A89
1498+ 7A89 28 04            jr   z, .collision
1499+ 7A8B 30 02            jr   nc, .collision
1500+ 7A8D
1501+ 7A8D 18 05            jr   .no_collision
1502+ 7A8F
1503+ 7A8F              .collision:
1504+ 7A8F
1505+ 7A8F                  ; ---------------------------------------------------------------
1506+ 7A8F                  ; Collisione rilevata
1507+ 7A8F                  ; ---------------------------------------------------------------
1508+ 7A8F E1               pop  hl
1509+ 7A90 D1               pop  de
1510+ 7A91 C1               pop  bc
1511+ 7A92
1512+ 7A92 37               scf                    ; Carry = 1
1513+ 7A93
1514+ 7A93 C9               ret
1515+ 7A94
1516+ 7A94              .no_collision:
1517+ 7A94
1518+ 7A94                  ; ---------------------------------------------------------------
1519+ 7A94                  ; Nessuna collisione
1520+ 7A94                  ; ---------------------------------------------------------------
1521+ 7A94 E1               pop  hl
1522+ 7A95 D1               pop  de
1523+ 7A96 C1               pop  bc
1524+ 7A97
1525+ 7A97 B7               or   a                 ; Carry = 0
1526+ 7A98
1527+ 7A98 C9               ret
1528+ 7A99
1529+ 7A99              ; -------------------------------------------------------------------
1530+ 7A99              ; Items_CheckCollision
1531+ 7A99              ;
1532+ 7A99              ; Controlla se Willy entra in collisione con uno degli item
1533+ 7A99              ; attivi presenti nella stanza corrente.
1534+ 7A99              ;
1535+ 7A99              ; Per ogni item:
1536+ 7A99              ;   - verifica che appartenga alla stanza corrente
1537+ 7A99              ;   - verifica che non sia già stato raccolto
1538+ 7A99              ;   - esegue il test di collisione con Willy
1539+ 7A99              ;
1540+ 7A99              ; Se l'item viene raccolto:
1541+ 7A99              ;   - imposta il flag "collected"
1542+ 7A99              ;   - rimuove l'item dalla cache items_grid
1543+ 7A99              ;   - incrementa il contatore degli oggetti raccolti
1544+ 7A99              ;   - aggiorna l'HUD
1545+ 7A99              ;   - ripristina il tile di sfondo
1546+ 7A99              ;   - riproduce il suono di raccolta
1547+ 7A99              ;
1548+ 7A99              ; Formato record ItemsTable:
1549+ 7A99              ;   +0 RoomID
1550+ 7A99              ;   +1 X
1551+ 7A99              ;   +2 Y
1552+ 7A99              ;   +3 Color
1553+ 7A99              ;   +4 Collected
1554+ 7A99              ;
1555+ 7A99              ; Fine tabella:
1556+ 7A99              ;   RoomID = $FF
1557+ 7A99              ; -------------------------------------------------------------------
1558+ 7A99              Items_CheckCollision:
1559+ 7A99
1560+ 7A99                  ; Salva i registri utilizzati
1561+ 7A99 E5               push hl
1562+ 7A9A D5               push de
1563+ 7A9B C5               push bc
1564+ 7A9C
1565+ 7A9C                  ; Inizio scansione della tabella degli item
1566+ 7A9C 21 57 75         ld   hl, ItemsTable
1567+ 7A9F
1568+ 7A9F              .loop:
1569+ 7A9F
1570+ 7A9F                  ; ---------------------------------------------------------------
1571+ 7A9F                  ; Legge il Room ID dell'item corrente
1572+ 7A9F                  ; ---------------------------------------------------------------
1573+ 7A9F 7E               ld   a, (hl)
1574+ 7AA0
1575+ 7AA0                  ; $FF indica fine tabella
1576+ 7AA0 FE FF            cp   $FF
1577+ 7AA2 28 4D            jr   z, .done
1578+ 7AA4
1579+ 7AA4                  ; ---------------------------------------------------------------
1580+ 7AA4                  ; Verifica se l'item appartiene alla stanza corrente
1581+ 7AA4                  ; ---------------------------------------------------------------
1582+ 7AA4 57               ld   d, a              ; D = RoomID item
1583+ 7AA5
1584+ 7AA5 3A A0 7E         ld   a, (current_room)
1585+ 7AA8 BA               cp   d
1586+ 7AA9
1587+ 7AA9                  ; Se appartiene a un'altra stanza salta il record
1588+ 7AA9 20 3F            jr   nz, .next_item
1589+ 7AAB
1590+ 7AAB                  ; ---------------------------------------------------------------
1591+ 7AAB                  ; Legge coordinate e stato dell'item
1592+ 7AAB                  ; ---------------------------------------------------------------
1593+ 7AAB
1594+ 7AAB 23               inc  hl
1595+ 7AAC 4E               ld   c, (hl)           ; C = X
1596+ 7AAD
1597+ 7AAD 23               inc  hl
1598+ 7AAE 46               ld   b, (hl)           ; B = Y
1599+ 7AAF
1600+ 7AAF 23               inc  hl                ; salta Color
1601+ 7AB0
1602+ 7AB0 23               inc  hl                ; punta a Collected
1603+ 7AB1
1604+ 7AB1 7E               ld   a, (hl)
1605+ 7AB2
1606+ 7AB2                  ; ---------------------------------------------------------------
1607+ 7AB2                  ; Item già raccolto?
1608+ 7AB2                  ; ---------------------------------------------------------------
1609+ 7AB2 B7               or   a
1610+ 7AB3 20 39            jr   nz, .next_no_inc
1611+ 7AB5
1612+ 7AB5                  ; ---------------------------------------------------------------
1613+ 7AB5                  ; Test collisione Willy ↔ Item
1614+ 7AB5                  ;
1615+ 7AB5                  ; Input richiesto:
1616+ 7AB5                  ;   A = ItemX
1617+ 7AB5                  ;   H = ItemY
1618+ 7AB5                  ; ---------------------------------------------------------------
1619+ 7AB5 79               ld   a, c
1620+ 7AB6
1621+ 7AB6 E5               push hl                ; salva puntatore al flag Collected
1622+ 7AB7
1623+ 7AB7 60               ld   h, b
1624+ 7AB8
1625+ 7AB8 CD 53 7A         call CheckWillyItemCollision
1626+ 7ABB
1627+ 7ABB E1               pop  hl
1628+ 7ABC
1629+ 7ABC                  ; Nessuna collisione
1630+ 7ABC 30 30            jr   nc, .next_no_inc
1631+ 7ABE
1632+ 7ABE                  ; ===============================================================
1633+ 7ABE                  ; ITEM RACCOLTO
1634+ 7ABE                  ; ===============================================================
1635+ 7ABE
1636+ 7ABE                  ; ---------------------------------------------------------------
1637+ 7ABE                  ; Marca l'item come raccolto
1638+ 7ABE                  ; ---------------------------------------------------------------
1639+ 7ABE 36 01            ld   (hl), 1
1640+ 7AC0
1641+ 7AC0                  ; ---------------------------------------------------------------
1642+ 7AC0                  ; Rimuove l'item dalla cache items_grid
1643+ 7AC0                  ;
1644+ 7AC0                  ; Calcolo:
1645+ 7AC0                  ;   offset = Row * 32 + Col
1646+ 7AC0                  ; ---------------------------------------------------------------
1647+ 7AC0 E5               push hl
1648+ 7AC1 D5               push de
1649+ 7AC2
1650+ 7AC2 26 00            ld   h, 0
1651+ 7AC4 68               ld   l, b              ; HL = Row
1652+ 7AC5
1653+ 7AC5 29               add  hl, hl            ; *2
1654+ 7AC6 29               add  hl, hl            ; *4
1655+ 7AC7 29               add  hl, hl            ; *8
1656+ 7AC8 29               add  hl, hl            ; *16
1657+ 7AC9 29               add  hl, hl            ; *32
1658+ 7ACA
1659+ 7ACA 59               ld   e, c
