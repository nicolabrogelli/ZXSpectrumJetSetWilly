 971+ 6AAE              ; -------------------------------------------------------------------
 972+ 6AAE              ; Controlla se Willy collide orizzontalmente con un Wall alle coordinate specificate
 973+ 6AAE              ; Input: C = X pixel (da controllare), B = Y pixel (attuale)
 974+ 6AAE              ; Output: Carry flag impostato se c'è collisione, altrimenti resettato
 975+ 6AAE              ; -------------------------------------------------------------------
 976+ 6AAE              CheckWillyWallCollision:
 977+ 6AAE C5               push bc
 978+ 6AAF
 979+ 6AAF                  ; 1. Punto superiore: (X, Y)
 980+ 6AAF CD 7D 6A         call CheckWallCell
 981+ 6AB2 38 17            jr   c, .collision
 982+ 6AB4
 983+ 6AB4                  ; 2. Punto medio: (X, Y + 7)
 984+ 6AB4 78               ld   a, b
 985+ 6AB5 C6 07            add  a, 7
 986+ 6AB7 47               ld   b, a
 987+ 6AB8 CD 7D 6A         call CheckWallCell
 988+ 6ABB 38 0E            jr   c, .collision
 989+ 6ABD
 990+ 6ABD                  ; 3. Punto inferiore: (X, Y + 15)
 991+ 6ABD C1               pop  bc
 992+ 6ABE C5               push bc
 993+ 6ABF 78               ld   a, b
 994+ 6AC0 C6 0F            add  a, 15
 995+ 6AC2 47               ld   b, a
 996+ 6AC3 CD 7D 6A         call CheckWallCell
 997+ 6AC6 38 03            jr   c, .collision
 998+ 6AC8
 999+ 6AC8 C1               pop  bc
1000+ 6AC9 B7               or   a                 ; Reset carry (nessuna collisione)
1001+ 6ACA C9               ret
1002+ 6ACB
1003+ 6ACB              .collision:
1004+ 6ACB C1               pop  bc
1005+ 6ACC 37               scf                    ; Set carry (collisione avvenuta)
1006+ 6ACD C9               ret
