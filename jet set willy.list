 652  8D08              .quit_chosen:
 653  8D08                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 654  8D08              .wait_quit_release:
 655  8D08 76               halt
 656  8D09 01 FE 7F         ld   bc, $7ffe
 657  8D0C ED 78            in   a, (c)
 658  8D0E CB 5F            bit  3, a
 659  8D10 28 F6            jr   z, .wait_quit_release
 660  8D12 01 FE BF         ld   bc, $bffe
 661  8D15 ED 78            in   a, (c)
 662  8D17 CB 47            bit  0, a
 663  8D19 28 ED            jr   z, .wait_quit_release
