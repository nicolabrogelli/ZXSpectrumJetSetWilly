  71+ 79B5              ; Audio_UpdateMusic
  72+ 79B5              ;
  73+ 79B5              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 79B5              ; Viene chiamata a ogni frame.
  75+ 79B5              ; -------------------------------------------------------------------
  76+ 79B5              Audio_UpdateMusic:
  77+ 79B5 F5               push af
  78+ 79B6 C5               push bc
  79+ 79B7 D5               push de
  80+ 79B8 E5               push hl
  81+ 79B9
  82+ 79B9                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 79B9 3A 03 7E         ld   a, (Audio_jump_sound_note)
  84+ 79BC FE 12            cp   18
  85+ 79BE 38 56            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 79C0
  87+ 79C0                  ; Decrementa il contatore dei frame della nota corrente
  88+ 79C0 3A 06 7E         ld   a, (Audio_music_frame_counter)
  89+ 79C3 3D               dec  a
  90+ 79C4 32 06 7E         ld   (Audio_music_frame_counter), a
  91+ 79C7 20 1F            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 79C9
  93+ 79C9                  ; Altrimenti carica la nota successiva
  94+ 79C9 3A 05 7E         ld   a, (Audio_music_note_idx)
  95+ 79CC 3C               inc  a
  96+ 79CD FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 79CF 38 01            jr   c, .no_wrap
  98+ 79D1 AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 79D2              .no_wrap:
 100+ 79D2 32 05 7E         ld   (Audio_music_note_idx), a
 101+ 79D5
 102+ 79D5                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 79D5 5F               ld   e, a
 104+ 79D6 16 00            ld   d, 0
 105+ 79D8 21 1B 7A         ld   hl, Audio_MusicSheet
 106+ 79DB 19               add  hl, de
 107+ 79DC 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 79DD
 109+ 79DD                  ; Leggi durata (secondo byte)
 110+ 79DD 23               inc  hl
 111+ 79DE 7E               ld   a, (hl)
 112+ 79DF CB 3F            srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 113+ 79E1 20 02            jr   nz, .dur_ok
 114+ 79E3 3E 01            ld   a, 1
 115+ 79E5              .dur_ok:
 116+ 79E5 32 06 7E         ld   (Audio_music_frame_counter), a
