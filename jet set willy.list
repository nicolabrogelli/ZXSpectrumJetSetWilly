 143+ 7ABC 20 FB            jr   nz, .d1
 144+ 7ABE
 145+ 7ABE                  ; Speaker OFF
 146+ 7ABE 3A 45 7B         ld   a, (room_border_color)
 147+ 7AC1 E6 EF            and  $ef
 148+ 7AC3 D3 FE            out  ($fe), a
 149+ 7AC5 4A               ld   c, d
 150+ 7AC6              .d2:
 151+ 7AC6 F5               push af
 152+ 7AC7 F1               pop  af
 153+ 7AC8 0D               dec  c
 154+ 7AC9 20 FB            jr   nz, .d2
