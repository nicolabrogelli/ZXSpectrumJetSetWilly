   8+ 8835              ; Audio_UpdateJumpSound
   9+ 8835              ;
  10+ 8835              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8835              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8835              ; -------------------------------------------------------------------
  13+ 8835              Audio_UpdateJumpSound:
  14+ 8835 F5               push af
  15+ 8836 C5               push bc
  16+ 8837 D5               push de
  17+ 8838 E5               push hl
  18+ 8839
  19+ 8839                  ; Controlla se il suono è attivo (note < 18)
  20+ 8839 3A A9 FA         ld   a, (Audio_jump_sound_note)
  21+ 883C FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 883E 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8840
  24+ 8840                  ; Carica la nota corrente da suonare
  25+ 8840 5F               ld   e, a
  26+ 8841 16 00            ld   d, 0
  27+ 8843 21 6F 88         ld   hl, Audio_JumpSoundDelays
  28+ 8846 19               add  hl, de
  29+ 8847 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8848 57               ld   d, a                      ; D = delay della nota
  31+ 8849
  32+ 8849                  ; Suona la nota: 15 cicli
  33+ 8849 06 0F            ld   b, 15
  34+ 884B              .note_loop:
  35+ 884B                  ; Speaker ON
  36+ 884B 3A A2 F6         ld   a, (room_border_color)
  37+ 884E F6 10            or   $10
  38+ 8850 D3 FE            out  ($fe), a
  39+ 8852 4A               ld   c, d
  40+ 8853              .d1:
  41+ 8853 0D               dec  c
  42+ 8854 20 FD            jr   nz, .d1
  43+ 8856
  44+ 8856                  ; Speaker OFF
  45+ 8856 3A A2 F6         ld   a, (room_border_color)
  46+ 8859 E6 EF            and  $ef
  47+ 885B D3 FE            out  ($fe), a
  48+ 885D 4A               ld   c, d
  49+ 885E              .d2:
  50+ 885E 0D               dec  c
  51+ 885F 20 FD            jr   nz, .d2
  52+ 8861
  53+ 8861 10 E8            djnz .note_loop
  54+ 8863
  55+ 8863                  ; Passa alla nota successiva
  56+ 8863 3A A9 FA         ld   a, (Audio_jump_sound_note)
  57+ 8866 3C               inc  a
  58+ 8867 32 A9 FA         ld   (Audio_jump_sound_note), a
  59+ 886A
  60+ 886A              .done:
  61+ 886A E1               pop  hl
  62+ 886B D1               pop  de
  63+ 886C C1               pop  bc
  64+ 886D F1               pop  af
  65+ 886E C9               ret
  66+ 886F
  67+ 886F              Audio_JumpSoundDelays:
  68+ 886F 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 8873 19 13 0C 06
  68+ 8877 0C 13 19 20
  68+ 887B 26 2D 33 3A
  68+ 887F 40 47
