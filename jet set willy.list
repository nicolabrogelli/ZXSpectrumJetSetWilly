 848+ 6AAF 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 849+ 6AB0 47               ld   b, a              ; B = limit_left
 850+ 6AB1
 851+ 6AB1 3A 64 78         ld   a, (ramp_col)
 852+ 6AB4 3C               inc  a
 853+ 6AB5 4F               ld   c, a              ; C = limit_right (exclusive)
 854+ 6AB6
 855+ 6AB6 7B               ld   a, e              ; A = Col
 856+ 6AB7 B8               cp   b
 857+ 6AB8 38 15            jr   c, .check_platform_case
 858+ 6ABA B9               cp   c
 859+ 6ABB 30 12            jr   nc, .check_platform_case
 860+ 6ABD
 861+ 6ABD                  ; Calcola B = ramp_col - Col
 862+ 6ABD 3A 64 78         ld   a, (ramp_col)
 863+ 6AC0 93               sub  e
 864+ 6AC1 47               ld   b, a              ; B = offset
 865+ 6AC2
 866+ 6AC2                  ; SlopeRow = ramp_row - B
 867+ 6AC2 3A 63 78         ld   a, (ramp_row)
 868+ 6AC5 90               sub  b
