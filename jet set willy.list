 226+ 6D01 C6 10            add  a, 16             ; A = Vecchio Y + 16
 227+ 6D03
 228+ 6D03 BA               cp   d                 ; Confronta Vecchio Y + 16 con il limite
 229+ 6D04 28 04            jr   z, .do_landing    ; Se ==, atterra
 230+ 6D06 38 02            jr   c, .do_landing    ; Se <, atterra (eravamo sopra)
 231+ 6D08
 232+ 6D08 18 1B            jr   .no_collision_checks
 233+ 6D0A
 234+ 6D0A              .do_landing:
 235+ 6D0A                  ; Atterra sulla riga di layout E!
