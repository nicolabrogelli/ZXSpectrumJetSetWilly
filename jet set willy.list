 771+ 7D75                  ; Calcola il frame dell'animazione: Anim State * 32
 772+ 7D75 DD 7E 07         ld   a, (ix+7)         ; Anim State (0..3) (Offset 7)
 773+ 7D78 87               add  a, a              ; *2
 774+ 7D79 87               add  a, a              ; *4
 775+ 7D7A 87               add  a, a              ; *8
 776+ 7D7B 87               add  a, a              ; *16
 777+ 7D7C 87               add  a, a              ; *32
 778+ 7D7D 5F               ld   e, a
 779+ 7D7E 16 00            ld   d, 0              ; DE = offset del frame
 780+ 7D80 19               add  hl, de            ; HL = indirizzo del frame corretto
 781+ 7D81
 782+ 7D81                  ; Disegna alla coordinata corrente
 783+ 7D81 DD 4E 02         ld   c, (ix+2)         ; C = Current X (Offset 2)
 784+ 7D84 DD 46 03         ld   b, (ix+3)         ; B = Current Y (Offset 3)
 785+ 7D87
 786+ 7D87 DD E5            push ix                ; Salva slot pointer
 787+ 7D89 E5               push hl
 788+ 7D8A DD E1            pop  ix                ; IX = sprite data pointer
 789+ 7D8C CD 89 5F         call Gfx_DrawPixelSprite16x16
 790+ 7D8F DD E1            pop  ix                ; Ripristina slot pointer
 791+ 7D91
