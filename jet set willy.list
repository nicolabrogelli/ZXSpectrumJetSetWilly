  56+ 5E0E              ; NUOVE ROUTINE DI RENDERING PIXEL-BY-PIXEL
  57+ 5E0E              ; ===================================================================
  58+ 5E0E
  59+ 5E0E              ; -------------------------------------------------------------------
  60+ 5E0E              ; Calcola indirizzo schermo da coordinate pixel (X, Y)
  61+ 5E0E              ; Input: H = Y (0..191), L = X (0..255)
  62+ 5E0E              ; Output: HL = indirizzo schermo
  63+ 5E0E              ; -------------------------------------------------------------------
  64+ 5E0E              GetScreenAddr:
  65+ 5E0E 7C               ld a, h
  66+ 5E0F E6 07            and %00000111     ; A = y2 y1 y0 (scanline offset)
  67+ 5E11 F6 40            or  %01000000     ; Base dello schermo ($40)
  68+ 5E13 57               ld  d, a          ; D = high byte parziale
  69+ 5E14
  70+ 5E14 7C               ld  a, h
  71+ 5E15 E6 C0            and %11000000     ; A = y7 y6 000000 (third select)
  72+ 5E17 0F               rrca
  73+ 5E18 0F               rrca
  74+ 5E19 0F               rrca              ; Shift a destra di 3 -> 000 y7 y6 000
  75+ 5E1A B2               or  d
  76+ 5E1B 57               ld  d, a          ; D = high byte completo (010 y7 y6 y2 y1 y0)
  77+ 5E1C
  78+ 5E1C 7C               ld  a, h
  79+ 5E1D E6 38            and %00111000     ; A = 00 y5 y4 y3 000 (character row)
  80+ 5E1F 87               add a, a
  81+ 5E20 87               add a, a          ; Shift a sinistra di 2 -> y5 y4 y3 00000
  82+ 5E21 5F               ld  e, a          ; E = low byte parziale
  83+ 5E22
  84+ 5E22 7D               ld  a, l
  85+ 5E23 CB 3F            srl a
  86+ 5E25 CB 3F            srl a
  87+ 5E27 CB 3F            srl a              ; A = X / 8 (colonna)
  88+ 5E29 B3               or  e
  89+ 5E2A 5F               ld  e, a          ; E = low byte completo
  90+ 5E2B
  91+ 5E2B 62               ld  h, d
  92+ 5E2C 6B               ld  l, e          ; HL = indirizzo finale
  93+ 5E2D C9               ret
  94+ 5E2E
  95+ 5E2E              ; -------------------------------------------------------------------
  96+ 5E2E              ; Incrementa indirizzo schermo alla riga (scanline) successiva
  97+ 5E2E              ; Input/Output: HL = indirizzo schermo
  98+ 5E2E              ; -------------------------------------------------------------------
  99+ 5E2E              IncScreenLine:
 100+ 5E2E 24               inc h             ; Vai alla riga successiva
 101+ 5E2F 7C               ld  a, h
 102+ 5E30 E6 07            and 7             ; Controlla se la scanline è tornata a 0 (wrap)
 103+ 5E32 C0               ret nz            ; Se non è 0, abbiamo finito!
 104+ 5E33
 105+ 5E33 7D               ld  a, l
 106+ 5E34 C6 20            add a, 32         ; Altrimenti passa alla riga di caratteri successiva
 107+ 5E36 6F               ld  l, a
 108+ 5E37 D8               ret c             ; Se c'è carry, abbiamo cambiato terzo e H è già corretto!
 109+ 5E38
 110+ 5E38                  ; Se non c'è carry, rimaniamo nello stesso terzo. Ripristina il terzo corretto in H.
 111+ 5E38 7C               ld  a, h
 112+ 5E39 D6 08            sub 8
 113+ 5E3B 67               ld  h, a
 114+ 5E3C C9               ret
 115+ 5E3D
 116+ 5E3D              ; -------------------------------------------------------------------
 117+ 5E3D              ; Disegna uno sprite 8x8 a coordinate pixel (X, Y)
 118+ 5E3D              ; Input: C = X, B = Y, IX = puntatore dati sprite (8 byte)
 119+ 5E3D              ; -------------------------------------------------------------------
 120+ 5E3D              DrawPixelSprite8x8:
 121+ 5E3D C5               push bc
 122+ 5E3E D5               push de
 123+ 5E3F E5               push hl
 124+ 5E40 DD E5            push ix
 125+ 5E42
 126+ 5E42                  ; 1. Calcola indirizzo schermo
 127+ 5E42 60               ld   h, b
 128+ 5E43 69               ld   l, c
 129+ 5E44 CD 0E 5E         call GetScreenAddr ; HL = indirizzo schermo
 130+ 5E47
 131+ 5E47                  ; 2. Calcola offset shift = X & 7
 132+ 5E47 79               ld   a, c
 133+ 5E48 E6 07            and  7
 134+ 5E4A 47               ld   b, a          ; B = shift offset (0..7)
 135+ 5E4B
 136+ 5E4B 0E 08            ld   c, 8          ; 8 linee
 137+ 5E4D              .line_loop:
 138+ 5E4D DD 7E 00         ld   a, (ix+0)     ; A = byte dello sprite
 139+ 5E50 57               ld   d, a
 140+ 5E51 1E 00            ld   e, 0
 141+ 5E53
 142+ 5E53 78               ld   a, b          ; Shift se necessario
 143+ 5E54 B7               or   a
 144+ 5E55 28 07            jr   z, .no_shift
 145+ 5E57
 146+ 5E57              .shift_loop:
 147+ 5E57 CB 3A            srl  d
 148+ 5E59 CB 1B            rr   e
 149+ 5E5B 3D               dec  a
 150+ 5E5C 20 F9            jr   nz, .shift_loop
 151+ 5E5E
 152+ 5E5E              .no_shift:
 153+ 5E5E                  ; Scrivi sullo schermo (OR trasparente)
 154+ 5E5E 7A               ld   a, d
 155+ 5E5F B6               or   (hl)
 156+ 5E60 77               ld   (hl), a
 157+ 5E61 23               inc  hl
 158+ 5E62 7B               ld   a, e
 159+ 5E63 B6               or   (hl)
 160+ 5E64 77               ld   (hl), a
 161+ 5E65 2B               dec  hl            ; Ritorna alla colonna iniziale
 162+ 5E66
 163+ 5E66 CD 2E 5E         call IncScreenLine ; Prossima scanline sullo schermo
 164+ 5E69 DD 23            inc  ix            ; Prossimo byte dello sprite
 165+ 5E6B 0D               dec  c
 166+ 5E6C 20 DF            jr   nz, .line_loop
 167+ 5E6E
 168+ 5E6E DD E1            pop  ix
 169+ 5E70 E1               pop  hl
 170+ 5E71 D1               pop  de
 171+ 5E72 C1               pop  bc
 172+ 5E73 C9               ret
 173+ 5E74
 174+ 5E74              ; -------------------------------------------------------------------
 175+ 5E74              ; Ripristina un byte dello sfondo statico.
 176+ 5E74              ; Input: A = X del byte schermo in pixel (0, 8, 16...), D = Y pixel
 177+ 5E74              ; Output: A = byte di sfondo
 178+ 5E74              ; ---------------------------------------------------------------
 179+ 5E74              GetBackgroundByte:
 180+ 5E74 E5               push hl
 181+ 5E75 D5               push de
 182+ 5E76 C5               push bc
 183+ 5E77
 184+ 5E77 47               ld   b, a              ; B = X (pixel)
 185+ 5E78
 186+ 5E78                  ; 1. Controlla se Y (in D) è fuori dalla griglia di layout (Y < 24 o Y >= 152)
 187+ 5E78 7A               ld   a, d
 188+ 5E79 FE 18            cp   24
 189+ 5E7B 38 78            jr   c, .blank
 190+ 5E7D FE 98            cp   152
 191+ 5E7F 30 74            jr   nc, .blank
 192+ 5E81
 193+ 5E81                  ; 2. Calcola riga di layout: r = (Y - 24) / 8
 194+ 5E81 D6 18            sub  24
 195+ 5E83 CB 3F            srl  a
 196+ 5E85 CB 3F            srl  a
 197+ 5E87 CB 3F            srl  a                 ; A = r (0..15)
 198+ 5E89
 199+ 5E89                  ; 3. HL = r * 8
 200+ 5E89 6F               ld   l, a
 201+ 5E8A 26 00            ld   h, 0
 202+ 5E8C 29               add  hl, hl
 203+ 5E8D 29               add  hl, hl
 204+ 5E8E 29               add  hl, hl            ; HL = r * 8
 205+ 5E8F
 206+ 5E8F                  ; 4. Calcola colonna di layout: c = X / 8 (in B)
 207+ 5E8F 78               ld   a, b
 208+ 5E90 CB 3F            srl  a
 209+ 5E92 CB 3F            srl  a
 210+ 5E94 CB 3F            srl  a                 ; A = c (0..31)
 211+ 5E96 47               ld   b, a              ; B = c
 212+ 5E97
 213+ 5E97                  ; HL = r * 8 + c / 4
 214+ 5E97 CB 3F            srl  a
 215+ 5E99 CB 3F            srl  a                 ; A = c / 4 (0..7)
 216+ 5E9B 85               add  a, l
 217+ 5E9C 6F               ld   l, a              ; HL = r * 8 + (c / 4)
 218+ 5E9D
 219+ 5E9D D5               push de
 220+ 5E9E ED 5B BB 6E      ld   de, (room_ptr)
 221+ 5EA2 19               add  hl, de            ; HL = layout byte address
 222+ 5EA3 D1               pop  de
 223+ 5EA4 7E               ld   a, (hl)           ; A = layout byte
 224+ 5EA5
 225+ 5EA5                  ; Estrai il bit-pair corrispondente a c % 4
 226+ 5EA5 4F               ld   c, a              ; C = layout byte
 227+ 5EA6 78               ld   a, b
 228+ 5EA7 E6 03            and  3                 ; A = c % 4
 229+ 5EA9 28 15            jr   z, .shift_0
 230+ 5EAB 3D               dec  a
 231+ 5EAC 28 0B            jr   z, .shift_1
 232+ 5EAE 3D               dec  a
 233+ 5EAF 28 03            jr   z, .shift_2
 234+ 5EB1                  ; Case 3 (c % 4 = 3)
 235+ 5EB1 79               ld   a, c
 236+ 5EB2 18 0F            jr   .got_type
 237+ 5EB4              .shift_2:
 238+ 5EB4 79               ld   a, c
 239+ 5EB5 0F               rrca
 240+ 5EB6 0F               rrca
 241+ 5EB7 18 0A            jr   .got_type
 242+ 5EB9              .shift_1:
 243+ 5EB9 79               ld   a, c
 244+ 5EBA 0F               rrca
 245+ 5EBB 0F               rrca
 246+ 5EBC 0F               rrca
 247+ 5EBD 0F               rrca
 248+ 5EBE 18 03            jr   .got_type
 249+ 5EC0              .shift_0:
 250+ 5EC0 79               ld   a, c
 251+ 5EC1 07               rlca
 252+ 5EC2 07               rlca
 253+ 5EC3              .got_type:
 254+ 5EC3 E6 03            and  3                 ; A = cell type (0..3)
 255+ 5EC5
 256+ 5EC5                  ; 5. Ottieni il puntatore al tile corrispondente
 257+ 5EC5 B7               or   a
 258+ 5EC6 20 05            jr   nz, .not_bg
 259+ 5EC8 21 A0 00         ld   hl, OFFSET_BG
 260+ 5ECB 18 13            jr   .load_tile
 261+ 5ECD              .not_bg:
 262+ 5ECD 3D               dec  a
 263+ 5ECE 20 05            jr   nz, .not_floor
 264+ 5ED0 21 A9 00         ld   hl, OFFSET_FLOOR
 265+ 5ED3 18 0B            jr   .load_tile
 266+ 5ED5              .not_floor:
