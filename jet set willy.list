 955+ 6C33 04               inc  b                 ; B = SlopeRow + 1
 956+ 6C34 B8               cp   b
 957+ 6C35 28 28            jr   z, .yes           ; Row == SlopeRow + 1
 958+ 6C37
 959+ 6C37              .check_platform_case:
 960+ 6C37                  ; 2. Controlla se è sulla piattaforma adiacente in cima
