 453+ 7390
 454+ 7390              ; -------------------------------------------------------------------
 455+ 7390              ; Items_DrawRoom
 456+ 7390              ;
 457+ 7390              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 458+ 7390              ;
 459+ 7390              ; Operazioni eseguite:
 460+ 7390              ;   1. Azzera la griglia items_grid.
 461+ 7390              ;   2. Svuota la cache degli oggetti attivi.
 462+ 7390              ;   3. Scansiona ItemsTable.
 463+ 7390              ;   4. Per ogni item della stanza corrente:
 464+ 7390              ;        - verifica se è già stato raccolto
 465+ 7390              ;        - disegna la grafica
 466+ 7390              ;        - aggiorna items_grid
 467+ 7390              ;        - memorizza l'item nella cache current_room_items
 468+ 7390              ;   5. Aggiorna num_room_items.
 469+ 7390              ;
 470+ 7390              ; Record ItemsTable:
 471+ 7390              ;   +0  Room ID
 472+ 7390              ;   +1  X (colonna)
 473+ 7390              ;   +2  Y (riga)
 474+ 7390              ;   +3  Colore
 475+ 7390              ;   +4  Collected flag
 476+ 7390              ;
 477+ 7390              ; Cache current_room_items:
 478+ 7390              ;   +0  Colonna
 479+ 7390              ;   +1  Riga
 480+ 7390              ;   +2  Colore
 481+ 7390              ;   +3  Collected flag ptr (Low)
 482+ 7390              ;   +4  Collected flag ptr (High)
 483+ 7390              ;
 484+ 7390              ; Ogni record cache occupa 5 byte.
 485+ 7390              ; -------------------------------------------------------------------
 486+ 7390              Items_DrawRoom:
 487+ 7390
 488+ 7390                  ; Salva tutti i registri utilizzati
 489+ 7390 E5               push hl
 490+ 7391 D5               push de
 491+ 7392 C5               push bc
 492+ 7393 DD E5            push ix
 493+ 7395 FD E5            push iy
 494+ 7397
 495+ 7397                  ; ---------------------------------------------------------------
 496+ 7397                  ; Azzera items_grid (32 x 16 = 512 byte)
 497+ 7397                  ; ---------------------------------------------------------------
 498+ 7397 21 00 B0         ld   hl, items_grid
 499+ 739A 11 01 B0         ld   de, items_grid + 1
 500+ 739D 36 00            ld   (hl), 0
 501+ 739F 01 FF 01         ld   bc, 511
 502+ 73A2 ED B0            ldir
 503+ 73A4
 504+ 73A4                  ; ---------------------------------------------------------------
 505+ 73A4                  ; Nessun item attivo nella stanza
 506+ 73A4                  ; ---------------------------------------------------------------
 507+ 73A4 AF               xor  a
 508+ 73A5 32 E3 79         ld   (num_room_items), a
 509+ 73A8
 510+ 73A8                  ; IY punta alla cache degli item attivi
 511+ 73A8 FD 21 93 79      ld   iy, current_room_items
 512+ 73AC
 513+ 73AC                  ; ---------------------------------------------------------------
 514+ 73AC                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 515+ 73AC                  ; alla stanza corrente.
 516+ 73AC                  ;
 517+ 73AC                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 518+ 73AC                  ; ---------------------------------------------------------------
 519+ 73AC 2A E4 79         ld   hl, (room_ptr)
 520+ 73AF 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 521+ 73B2 19               add  hl, de
 522+ 73B3
 523+ 73B3 E5               push hl
 524+ 73B4 DD E1            pop  ix                ; IX = bitmap item
 525+ 73B6
 526+ 73B6                  ; ---------------------------------------------------------------
 527+ 73B6                  ; Inizio scansione della tabella degli item
 528+ 73B6                  ; ---------------------------------------------------------------
 529+ 73B6 21 93 71         ld   hl, ItemsTable
 530+ 73B9
 531+ 73B9              .loop:
 532+ 73B9
 533+ 73B9                  ; ---------------------------------------------------------------
 534+ 73B9                  ; Legge il Room ID del record corrente
 535+ 73B9                  ; ---------------------------------------------------------------
 536+ 73B9 7E               ld   a, (hl)
 537+ 73BA
 538+ 73BA                  ; $FF indica fine tabella
 539+ 73BA FE FF            cp   $FF
 540+ 73BC 28 53            jr   z, .done
 541+ 73BE
 542+ 73BE                  ; ---------------------------------------------------------------
 543+ 73BE                  ; Verifica se l'item appartiene alla stanza corrente
 544+ 73BE                  ; ---------------------------------------------------------------
 545+ 73BE 57               ld   d, a
 546+ 73BF
 547+ 73BF 3A 8A 79         ld   a, (current_room)
 548+ 73C2 BA               cp   d
 549+ 73C3 20 45            jr   nz, .next_item
 550+ 73C5
 551+ 73C5                  ; ---------------------------------------------------------------
 552+ 73C5                  ; Legge i dati dell'item
 553+ 73C5                  ; ---------------------------------------------------------------
 554+ 73C5
 555+ 73C5 23               inc  hl
 556+ 73C6 4E               ld   c, (hl)           ; X (colonna)
 557+ 73C7
 558+ 73C7 23               inc  hl
 559+ 73C8 46               ld   b, (hl)           ; Y (riga)
 560+ 73C9
 561+ 73C9 23               inc  hl
 562+ 73CA 5E               ld   e, (hl)           ; Colore
 563+ 73CB
 564+ 73CB 23               inc  hl
 565+ 73CC 7E               ld   a, (hl)           ; Collected flag
 566+ 73CD
 567+ 73CD                  ; Se diverso da zero l'item è già stato raccolto
 568+ 73CD B7               or   a
 569+ 73CE 20 3E            jr   nz, .next_no_inc
 570+ 73D0
 571+ 73D0                  ; ---------------------------------------------------------------
 572+ 73D0                  ; Disegna l'item sullo schermo
 573+ 73D0                  ;
 574+ 73D0                  ; B = Row
 575+ 73D0                  ; C = Column
 576+ 73D0                  ; HL = bitmap pointer
 577+ 73D0                  ; E = Color
 578+ 73D0                  ; ---------------------------------------------------------------
 579+ 73D0 E5               push hl
 580+ 73D1
 581+ 73D1 DD E5            push ix
 582+ 73D3 E1               pop  hl
 583+ 73D4
 584+ 73D4 CD 19 74         call DrawItemGraphic
 585+ 73D7
 586+ 73D7 E1               pop  hl                ; ritorna al flag collected
 587+ 73D8
 588+ 73D8                  ; ---------------------------------------------------------------
 589+ 73D8                  ; Aggiorna items_grid
 590+ 73D8                  ;
 591+ 73D8                  ; Calcolo:
 592+ 73D8                  ;   offset = Row * 32 + Col
 593+ 73D8                  ; ---------------------------------------------------------------
 594+ 73D8 E5               push hl
 595+ 73D9 D5               push de
 596+ 73DA
 597+ 73DA 26 00            ld   h, 0
 598+ 73DC 68               ld   l, b              ; HL = Row
 599+ 73DD
 600+ 73DD 29               add  hl, hl            ; *2
 601+ 73DE 29               add  hl, hl            ; *4
 602+ 73DF 29               add  hl, hl            ; *8
 603+ 73E0 29               add  hl, hl            ; *16
 604+ 73E1 29               add  hl, hl            ; *32
 605+ 73E2
 606+ 73E2 16 00            ld   d, 0
 607+ 73E4 59               ld   e, c              ; DE = Col
 608+ 73E5
 609+ 73E5 19               add  hl, de            ; Row*32 + Col
 610+ 73E6
 611+ 73E6 11 00 B0         ld   de, items_grid
 612+ 73E9 19               add  hl, de            ; puntatore nella griglia
 613+ 73EA
 614+ 73EA D1               pop  de                ; ripristina colore
 615+ 73EB
 616+ 73EB 73               ld   (hl), e           ; salva colore cella
 617+ 73EC
 618+ 73EC E1               pop  hl
 619+ 73ED
 620+ 73ED                  ; ---------------------------------------------------------------
 621+ 73ED                  ; Salva l'item nella cache della stanza
 622+ 73ED                  ;
 623+ 73ED                  ; Questo evita di dover scansionare tutta ItemsTable
 624+ 73ED                  ; durante il controllo delle collisioni.
 625+ 73ED                  ; ---------------------------------------------------------------
 626+ 73ED
 627+ 73ED FD 71 00         ld   (iy+0), c         ; Colonna
 628+ 73F0 FD 70 01         ld   (iy+1), b         ; Riga
 629+ 73F3 FD 73 02         ld   (iy+2), e         ; Colore
 630+ 73F6
 631+ 73F6                  ; Salva il puntatore al flag "collected"
 632+ 73F6 FD 75 03         ld   (iy+3), l         ; Low byte
 633+ 73F9 FD 74 04         ld   (iy+4), h         ; High byte
 634+ 73FC
 635+ 73FC                  ; Passa al record successivo della cache
 636+ 73FC 01 05 00         ld   bc, 5
 637+ 73FF FD 09            add  iy, bc
 638+ 7401
 639+ 7401                  ; Incrementa il numero di item attivi
 640+ 7401 3A E3 79         ld   a, (num_room_items)
 641+ 7404 3C               inc  a
 642+ 7405 32 E3 79         ld   (num_room_items), a
 643+ 7408
 644+ 7408 18 04            jr   .next_no_inc
 645+ 740A
 646+ 740A              .next_item:
 647+ 740A
 648+ 740A                  ; ---------------------------------------------------------------
 649+ 740A                  ; L'item non appartiene alla stanza corrente.
 650+ 740A                  ; Salta i campi del record:
 651+ 740A                  ;   X
 652+ 740A                  ;   Y
 653+ 740A                  ;   Color
 654+ 740A                  ;   Collected
 655+ 740A                  ; ---------------------------------------------------------------
 656+ 740A 23               inc  hl
 657+ 740B 23               inc  hl
 658+ 740C 23               inc  hl
 659+ 740D 23               inc  hl
 660+ 740E
 661+ 740E              .next_no_inc:
 662+ 740E
 663+ 740E                  ; ---------------------------------------------------------------
 664+ 740E                  ; Avanza al record successivo
 665+ 740E                  ; (prossimo Room ID)
 666+ 740E                  ; ---------------------------------------------------------------
 667+ 740E 23               inc  hl
 668+ 740F 18 A8            jr   .loop
 669+ 7411
 670+ 7411              .done:
 671+ 7411
 672+ 7411                  ; Ripristina i registri
 673+ 7411 FD E1            pop  iy
 674+ 7413 DD E1            pop  ix
 675+ 7415 D1               pop  de
 676+ 7416 C1               pop  bc
 677+ 7417 E1               pop  hl
 678+ 7418
 679+ 7418 C9               ret
 680+ 7419
 681+ 7419              ; -------------------------------------------------------------------
 682+ 7419              ; DrawItemGraphic
 683+ 7419              ;
 684+ 7419              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 685+ 7419              ; utilizzando una bitmap di 8 byte e un attributo colore.
 686+ 7419              ;
 687+ 7419              ; Input:
 688+ 7419              ;   B = Riga attributi (3..18)
 689+ 7419              ;   C = Colonna attributi (0..31)
 690+ 7419              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 691+ 7419              ;   E = Attributo colore
 692+ 7419              ;
 693+ 7419              ; Output:
 694+ 7419              ;   Nessuno
 695+ 7419              ;
 696+ 7419              ; Registri preservati:
 697+ 7419              ;   BC, DE, HL
 698+ 7419              ; -------------------------------------------------------------------
 699+ 7419              DrawItemGraphic:
 700+ 7419
 701+ 7419                  ; Salva i registri originali
 702+ 7419 C5               push bc
 703+ 741A D5               push de
 704+ 741B E5               push hl
 705+ 741C
 706+ 741C                  ; ---------------------------------------------------------------
 707+ 741C                  ; Calcolo indirizzo bitmap dello Spectrum
 708+ 741C                  ;
 709+ 741C                  ; Ogni item occupa una cella attributi (8x8 pixel).
 710+ 741C                  ;
 711+ 741C                  ; Formula:
 712+ 741C                  ;   High = $40 + (Row AND $18)
 713+ 741C                  ;   Low  = (Row AND 7) * 32 + Col
 714+ 741C                  ;
 715+ 741C                  ; DE conterrà l'indirizzo della prima scanline.
 716+ 741C                  ; ---------------------------------------------------------------
 717+ 741C
 718+ 741C 78               ld   a, b
 719+ 741D E6 18            and  $18
 720+ 741F C6 40            add  a, $40
 721+ 7421 57               ld   d, a              ; Byte alto indirizzo video
 722+ 7422
 723+ 7422 78               ld   a, b
 724+ 7423 E6 07            and  7                 ; Riga interna al blocco da 8
 725+ 7425
 726+ 7425 87               add  a, a              ; *2
 727+ 7426 87               add  a, a              ; *4
 728+ 7427 87               add  a, a              ; *8
 729+ 7428 87               add  a, a              ; *16
 730+ 7429 87               add  a, a              ; *32
 731+ 742A
 732+ 742A 81               add  a, c              ; + colonna
 733+ 742B
 734+ 742B 5F               ld   e, a              ; Byte basso indirizzo video
 735+ 742C
 736+ 742C                  ; ---------------------------------------------------------------
 737+ 742C                  ; Disegno bitmap
 738+ 742C                  ;
 739+ 742C                  ; Copia 8 byte consecutivi nella memoria video.
 740+ 742C                  ; Ogni byte rappresenta una scanline da 8 pixel.
 741+ 742C                  ; ---------------------------------------------------------------
 742+ 742C
 743+ 742C C5               push bc                ; Conserva Row e Col
 744+ 742D
 745+ 742D 06 08            ld   b, 8              ; Numero scanline
 746+ 742F
 747+ 742F              .line_loop:
 748+ 742F
 749+ 742F 7E               ld   a, (hl)           ; Legge scanline bitmap
 750+ 7430 12               ld   (de), a           ; Scrive nella memoria video
 751+ 7431
 752+ 7431 14               inc  d                 ; Scanline successiva
 753+ 7432 23               inc  hl                ; Byte bitmap successivo
 754+ 7433
 755+ 7433 05               dec  b
 756+ 7434 20 F9            jr   nz, .line_loop
 757+ 7436
 758+ 7436 C1               pop  bc                ; Ripristina Row e Col
 759+ 7437
 760+ 7437                  ; ---------------------------------------------------------------
 761+ 7437                  ; Calcolo indirizzo attributo
 762+ 7437                  ;
 763+ 7437                  ; Formula:
 764+ 7437                  ;   AttrAddr = $5800 + Row * 32 + Col
 765+ 7437                  ;
 766+ 7437                  ; HL conterrà l'indirizzo della cella attributi.
 767+ 7437                  ; ---------------------------------------------------------------
 768+ 7437
 769+ 7437 26 00            ld   h, 0
 770+ 7439 68               ld   l, b              ; HL = Row
 771+ 743A
 772+ 743A 29               add  hl, hl            ; *2
 773+ 743B 29               add  hl, hl            ; *4
 774+ 743C 29               add  hl, hl            ; *8
 775+ 743D 29               add  hl, hl            ; *16
 776+ 743E 29               add  hl, hl            ; *32
 777+ 743F
 778+ 743F 79               ld   a, c              ; A = Colonna
 779+ 7440
 780+ 7440 85               add  a, l
 781+ 7441 6F               ld   l, a
 782+ 7442
 783+ 7442 30 01            jr   nc, .no_carry
 784+ 7444 24               inc  h
 785+ 7445
 786+ 7445              .no_carry:
 787+ 7445
 788+ 7445                  ; HL = Row * 32 + Col
 789+ 7445
 790+ 7445 11 00 58         ld   de, $5800
 791+ 7448 19               add  hl, de            ; HL = indirizzo attributi
 792+ 7449
 793+ 7449                  ; ---------------------------------------------------------------
 794+ 7449                  ; Recupera il colore originale dallo stack.
 795+ 7449                  ;
 796+ 7449                  ; Layout stack:
 797+ 7449                  ;   HL originale
 798+ 7449                  ;   DE originale (E = colore)
 799+ 7449                  ;   BC originale
 800+ 7449                  ; ---------------------------------------------------------------
 801+ 7449
 802+ 7449 C1               pop  bc                ; Recupera HL originale
 803+ 744A D1               pop  de                ; Recupera DE originale
 804+ 744B
 805+ 744B                  ; ---------------------------------------------------------------
 806+ 744B                  ; Scrive l'attributo colore
 807+ 744B                  ; ---------------------------------------------------------------
 808+ 744B
 809+ 744B 7B               ld   a, e              ; A = colore
 810+ 744C 77               ld   (hl), a           ; Scrive nella RAM attributi
 811+ 744D
 812+ 744D                  ; ---------------------------------------------------------------
 813+ 744D                  ; Ripristina HL e BC originali
 814+ 744D                  ; ---------------------------------------------------------------
 815+ 744D
 816+ 744D C5               push bc
 817+ 744E E1               pop  hl                ; HL originale
 818+ 744F
 819+ 744F C1               pop  bc                ; BC originale
 820+ 7450
 821+ 7450 C9               ret
 822+ 7451
 823+ 7451              ; -------------------------------------------------------------------
 824+ 7451              ; RestoreBackgroundCell
 825+ 7451              ;
 826+ 7451              ; Ripristina il contenuto originale di una cella della stanza.
 827+ 7451              ; Viene utilizzata principalmente quando un item viene raccolto:
 828+ 7451              ; invece di lasciare un "buco", la routine ridisegna il tile
 829+ 7451              ; originale presente nella mappa della stanza.
 830+ 7451              ;
 831+ 7451              ; Input:
 832+ 7451              ;   B = Row (3..18)
 833+ 7451              ;   C = Col (0..31)
 834+ 7451              ;
 835+ 7451              ; Utilizza:
 836+ 7451              ;   room_ptr -> struttura dati della stanza corrente
 837+ 7451              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 838+ 7451              ;   Gfx_DrawTile -> ridisegna il tile selezionato
 839+ 7451              ;
 840+ 7451              ; Tipi di cella:
 841+ 7451              ;   0 = Background
 842+ 7451              ;   1 = Floor
 843+ 7451              ;   2 = Wall
 844+ 7451              ;   3 = Nasty
 845+ 7451              ; -------------------------------------------------------------------
 846+ 7451              RestoreBackgroundCell:
 847+ 7451
 848+ 7451                  ; Salva tutti i registri utilizzati
 849+ 7451 FD E5            push iy
 850+ 7453 C5               push bc
 851+ 7454 D5               push de
 852+ 7455 E5               push hl
 853+ 7456 DD E5            push ix
 854+ 7458
 855+ 7458                  ; ---------------------------------------------------------------
 856+ 7458                  ; Conserva Row e Col in IY.
 857+ 7458                  ;
 858+ 7458                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 859+ 7458                  ; BC potrebbe essere modificato.
 860+ 7458                  ; ---------------------------------------------------------------
 861+ 7458 C5               push bc
 862+ 7459 FD E1            pop  iy                ; IYH = Row, IYL = Col
 863+ 745B
 864+ 745B                  ; ---------------------------------------------------------------
 865+ 745B                  ; Determina quale tipo di cella è presente nella posizione
 866+ 745B                  ; specificata.
 867+ 745B                  ;
 868+ 745B                  ; Input:
 869+ 745B                  ;   B = Row
 870+ 745B                  ;   C = Col
 871+ 745B                  ;
 872+ 745B                  ; Output:
 873+ 745B                  ;   A = tipo cella
 874+ 745B                  ; ---------------------------------------------------------------
 875+ 745B 78               ld   a, b
 876+ 745C
 877+ 745C CD A7 6B         call GetCellFromUnpacked
 878+ 745F
 879+ 745F                  ; ---------------------------------------------------------------
 880+ 745F                  ; Recupera il puntatore alla stanza corrente.
 881+ 745F                  ;
 882+ 745F                  ; DE = base della struttura stanza
 883+ 745F                  ; ---------------------------------------------------------------
 884+ 745F ED 5B E4 79      ld   de, (room_ptr)
 885+ 7463
 886+ 7463                  ; ---------------------------------------------------------------
 887+ 7463                  ; Seleziona il tile corretto in base al tipo di cella.
 888+ 7463                  ;
 889+ 7463                  ; A = 0 -> Background
 890+ 7463                  ; A = 1 -> Floor
 891+ 7463                  ; A = 2 -> Wall
 892+ 7463                  ; A = 3 -> Nasty
 893+ 7463                  ; ---------------------------------------------------------------
 894+ 7463
 895+ 7463 B7               or   a
 896+ 7464 20 06            jr   nz, .not_bg
 897+ 7466
 898+ 7466                  ; Background
 899+ 7466 21 A0 00         ld   hl, OFFSET_BG
 900+ 7469 19               add  hl, de
 901+ 746A 18 16            jr   .draw_cell
 902+ 746C
 903+ 746C              .not_bg:
 904+ 746C
 905+ 746C 3D               dec  a
 906+ 746D 20 06            jr   nz, .not_floor
 907+ 746F
 908+ 746F                  ; Floor
 909+ 746F 21 A9 00         ld   hl, OFFSET_FLOOR
 910+ 7472 19               add  hl, de
 911+ 7473 18 0D            jr   .draw_cell
 912+ 7475
 913+ 7475              .not_floor:
 914+ 7475
 915+ 7475 3D               dec  a
 916+ 7476 20 06            jr   nz, .not_wall
 917+ 7478
 918+ 7478                  ; Wall
 919+ 7478 21 B2 00         ld   hl, OFFSET_WALL
 920+ 747B 19               add  hl, de
 921+ 747C 18 04            jr   .draw_cell
 922+ 747E
 923+ 747E              .not_wall:
 924+ 747E
 925+ 747E                  ; Nasty
 926+ 747E 21 BB 00         ld   hl, OFFSET_NASTY
 927+ 7481 19               add  hl, de
 928+ 7482
 929+ 7482              .draw_cell:
 930+ 7482
 931+ 7482                  ; ---------------------------------------------------------------
 932+ 7482                  ; HL punta ora alla grafica del tile da ridisegnare.
 933+ 7482                  ;
 934+ 7482                  ; Gfx_DrawTile si aspetta:
 935+ 7482                  ;   IX = puntatore tile
 936+ 7482                  ;   B  = Row
 937+ 7482                  ;   C  = Col
 938+ 7482                  ; ---------------------------------------------------------------
 939+ 7482 E5               push hl
 940+ 7483 DD E1            pop  ix
 941+ 7485
 942+ 7485                  ; Ripristina Row e Col salvati in IY
 943+ 7485 FD E5            push iy
 944+ 7487 C1               pop  bc
 945+ 7488
 946+ 7488                  ; Disegna il tile originale
 947+ 7488 CD 8C 61         call Gfx_DrawTile
 948+ 748B
 949+ 748B                  ; ---------------------------------------------------------------
 950+ 748B                  ; Ripristina i registri salvati
 951+ 748B                  ; ---------------------------------------------------------------
 952+ 748B DD E1            pop  ix
 953+ 748D E1               pop  hl
 954+ 748E D1               pop  de
 955+ 748F C1               pop  bc
 956+ 7490 FD E1            pop  iy
 957+ 7492
 958+ 7492 C9               ret
 959+ 7493
 960+ 7493              ; -------------------------------------------------------------------
 961+ 7493              ; CheckWillyItemCollision
 962+ 7493              ;
 963+ 7493              ; Verifica se Willy collide con un item utilizzando il controllo
 964+ 7493              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 965+ 7493              ;
 966+ 7493              ; Input:
 967+ 7493              ;   A = ItemX (colonna attributi 0..31)
 968+ 7493              ;   H = ItemY (riga attributi 3..18)
 969+ 7493              ;
 970+ 7493              ; Coordinate item:
 971+ 7493              ;   Ogni item occupa una cella da 8x8 pixel.
 972+ 7493              ;
 973+ 7493              ; Coordinate Willy:
 974+ 7493              ;   Willy occupa un rettangolo di 16x16 pixel.
 975+ 7493              ;
 976+ 7493              ; Output:
 977+ 7493              ;   Carry Set   = collisione rilevata
 978+ 7493              ;   Carry Clear = nessuna collisione
 979+ 7493              ;
 980+ 7493              ; Registri preservati:
 981+ 7493              ;   BC, DE, HL
 982+ 7493              ; -------------------------------------------------------------------
 983+ 7493              CheckWillyItemCollision:
 984+ 7493
 985+ 7493                  ; Salva i registri utilizzati
 986+ 7493 C5               push bc
 987+ 7494 D5               push de
 988+ 7495 E5               push hl
 989+ 7496
 990+ 7496                  ; ---------------------------------------------------------------
 991+ 7496                  ; Calcola il bounding box orizzontale dell'item
 992+ 7496                  ;
 993+ 7496                  ; ItemLeft  = ItemX * 8
 994+ 7496                  ; ItemRight = ItemLeft + 7
 995+ 7496                  ;
 996+ 7496                  ; E = ItemLeft
 997+ 7496                  ; D = ItemRight
 998+ 7496                  ; ---------------------------------------------------------------
 999+ 7496 6F               ld   l, a              ; L = ItemX
1000+ 7497
1001+ 7497 7D               ld   a, l
1002+ 7498 87               add  a, a              ; *2
1003+ 7499 87               add  a, a              ; *4
1004+ 749A 87               add  a, a              ; *8
1005+ 749B
1006+ 749B 5F               ld   e, a              ; E = ItemLeft
1007+ 749C
1008+ 749C C6 07            add  a, 7
1009+ 749E 57               ld   d, a              ; D = ItemRight
1010+ 749F
1011+ 749F                  ; ---------------------------------------------------------------
1012+ 749F                  ; Recupera la posizione corrente di Willy
1013+ 749F                  ;
1014+ 749F                  ; B = WillyY
1015+ 749F                  ; C = WillyX
1016+ 749F                  ; ---------------------------------------------------------------
1017+ 749F ED 4B 70 76      ld   bc, (PlayerPos)
1018+ 74A3
1019+ 74A3                  ; ---------------------------------------------------------------
1020+ 74A3                  ; Primo test:
1021+ 74A3                  ;
1022+ 74A3                  ; WillyLeft <= ItemRight
1023+ 74A3                  ;
1024+ 74A3                  ; Se Willy è completamente a destra dell'item
1025+ 74A3                  ; non può esserci collisione.
1026+ 74A3                  ; ---------------------------------------------------------------
1027+ 74A3 79               ld   a, c              ; A = WillyLeft
1028+ 74A4
1029+ 74A4 BA               cp   d                 ; WillyLeft vs ItemRight
1030+ 74A5
1031+ 74A5 28 04            jr   z, .x_ok
1032+ 74A7 38 02            jr   c, .x_ok
1033+ 74A9
1034+ 74A9 18 29            jr   .no_collision
1035+ 74AB
1036+ 74AB              .x_ok:
1037+ 74AB
1038+ 74AB                  ; ---------------------------------------------------------------
1039+ 74AB                  ; Secondo test:
1040+ 74AB                  ;
1041+ 74AB                  ; WillyRight >= ItemLeft
1042+ 74AB                  ;
1043+ 74AB                  ; WillyRight = WillyX + 7
1044+ 74AB                  ; ---------------------------------------------------------------
1045+ 74AB C6 07            add  a, 7
1046+ 74AD
1047+ 74AD BB               cp   e                 ; WillyRight vs ItemLeft
1048+ 74AE
1049+ 74AE 28 04            jr   z, .y_check
1050+ 74B0 30 02            jr   nc, .y_check
1051+ 74B2
1052+ 74B2 18 20            jr   .no_collision
1053+ 74B4
1054+ 74B4              .y_check:
1055+ 74B4
1056+ 74B4                  ; ---------------------------------------------------------------
1057+ 74B4                  ; Recupera ItemY dal valore originale di HL
1058+ 74B4                  ;
1059+ 74B4                  ; H contiene la riga dell'item.
1060+ 74B4                  ; ---------------------------------------------------------------
1061+ 74B4 E1               pop  hl
1062+ 74B5 E5               push hl
1063+ 74B6
1064+ 74B6                  ; ---------------------------------------------------------------
1065+ 74B6                  ; Calcola il bounding box verticale dell'item
1066+ 74B6                  ;
1067+ 74B6                  ; ItemTop    = ItemY * 8
1068+ 74B6                  ; ItemBottom = ItemTop + 7
1069+ 74B6                  ;
1070+ 74B6                  ; E = ItemTop
1071+ 74B6                  ; D = ItemBottom
1072+ 74B6                  ; ---------------------------------------------------------------
1073+ 74B6 7C               ld   a, h
1074+ 74B7
1075+ 74B7 87               add  a, a              ; *2
1076+ 74B8 87               add  a, a              ; *4
1077+ 74B9 87               add  a, a              ; *8
1078+ 74BA
1079+ 74BA 5F               ld   e, a              ; ItemTop
1080+ 74BB
1081+ 74BB C6 07            add  a, 7
1082+ 74BD 57               ld   d, a              ; ItemBottom
1083+ 74BE
1084+ 74BE                  ; ---------------------------------------------------------------
1085+ 74BE                  ; Primo test verticale:
1086+ 74BE                  ;
1087+ 74BE                  ; WillyTop <= ItemBottom
1088+ 74BE                  ; ---------------------------------------------------------------
1089+ 74BE 78               ld   a, b              ; WillyTop
1090+ 74BF
1091+ 74BF BA               cp   d
1092+ 74C0
1093+ 74C0 28 04            jr   z, .y_ok
1094+ 74C2 38 02            jr   c, .y_ok
1095+ 74C4
1096+ 74C4 18 0E            jr   .no_collision
1097+ 74C6
1098+ 74C6              .y_ok:
1099+ 74C6
1100+ 74C6                  ; ---------------------------------------------------------------
1101+ 74C6                  ; Secondo test verticale:
1102+ 74C6                  ;
1103+ 74C6                  ; WillyBottom >= ItemTop
1104+ 74C6                  ;
1105+ 74C6                  ; WillyBottom = WillyY + 15
1106+ 74C6                  ; ---------------------------------------------------------------
1107+ 74C6 C6 0F            add  a, 15
1108+ 74C8
1109+ 74C8 BB               cp   e
1110+ 74C9
1111+ 74C9 28 04            jr   z, .collision
1112+ 74CB 30 02            jr   nc, .collision
1113+ 74CD
1114+ 74CD 18 05            jr   .no_collision
1115+ 74CF
1116+ 74CF              .collision:
1117+ 74CF
1118+ 74CF                  ; ---------------------------------------------------------------
1119+ 74CF                  ; Collisione rilevata
1120+ 74CF                  ; ---------------------------------------------------------------
1121+ 74CF E1               pop  hl
1122+ 74D0 D1               pop  de
1123+ 74D1 C1               pop  bc
1124+ 74D2
1125+ 74D2 37               scf                    ; Carry = 1
1126+ 74D3
1127+ 74D3 C9               ret
1128+ 74D4
1129+ 74D4              .no_collision:
1130+ 74D4
1131+ 74D4                  ; ---------------------------------------------------------------
1132+ 74D4                  ; Nessuna collisione
1133+ 74D4                  ; ---------------------------------------------------------------
1134+ 74D4 E1               pop  hl
1135+ 74D5 D1               pop  de
1136+ 74D6 C1               pop  bc
1137+ 74D7
1138+ 74D7 B7               or   a                 ; Carry = 0
1139+ 74D8
1140+ 74D8 C9               ret
1141+ 74D9
1142+ 74D9              ; -------------------------------------------------------------------
1143+ 74D9              ; Items_CheckCollision
1144+ 74D9              ;
1145+ 74D9              ; Controlla se Willy entra in collisione con uno degli item
1146+ 74D9              ; attivi presenti nella stanza corrente.
1147+ 74D9              ;
1148+ 74D9              ; Per ogni item:
1149+ 74D9              ;   - verifica che appartenga alla stanza corrente
1150+ 74D9              ;   - verifica che non sia già stato raccolto
1151+ 74D9              ;   - esegue il test di collisione con Willy
1152+ 74D9              ;
1153+ 74D9              ; Se l'item viene raccolto:
1154+ 74D9              ;   - imposta il flag "collected"
1155+ 74D9              ;   - rimuove l'item dalla cache items_grid
1156+ 74D9              ;   - incrementa il contatore degli oggetti raccolti
1157+ 74D9              ;   - aggiorna l'HUD
1158+ 74D9              ;   - ripristina il tile di sfondo
1159+ 74D9              ;   - riproduce il suono di raccolta
1160+ 74D9              ;
1161+ 74D9              ; Formato record ItemsTable:
1162+ 74D9              ;   +0 RoomID
1163+ 74D9              ;   +1 X
1164+ 74D9              ;   +2 Y
1165+ 74D9              ;   +3 Color
1166+ 74D9              ;   +4 Collected
1167+ 74D9              ;
1168+ 74D9              ; Fine tabella:
1169+ 74D9              ;   RoomID = $FF
1170+ 74D9              ; -------------------------------------------------------------------
1171+ 74D9              Items_CheckCollision:
1172+ 74D9
1173+ 74D9                  ; Salva i registri utilizzati
1174+ 74D9 E5               push hl
1175+ 74DA D5               push de
1176+ 74DB C5               push bc
1177+ 74DC
1178+ 74DC                  ; Inizio scansione della tabella degli item
1179+ 74DC 21 93 71         ld   hl, ItemsTable
1180+ 74DF
1181+ 74DF              .loop:
1182+ 74DF
1183+ 74DF                  ; ---------------------------------------------------------------
1184+ 74DF                  ; Legge il Room ID dell'item corrente
1185+ 74DF                  ; ---------------------------------------------------------------
1186+ 74DF 7E               ld   a, (hl)
1187+ 74E0
1188+ 74E0                  ; $FF indica fine tabella
1189+ 74E0 FE FF            cp   $FF
1190+ 74E2 28 4D            jr   z, .done
1191+ 74E4
1192+ 74E4                  ; ---------------------------------------------------------------
1193+ 74E4                  ; Verifica se l'item appartiene alla stanza corrente
1194+ 74E4                  ; ---------------------------------------------------------------
1195+ 74E4 57               ld   d, a              ; D = RoomID item
1196+ 74E5
1197+ 74E5 3A 8A 79         ld   a, (current_room)
1198+ 74E8 BA               cp   d
1199+ 74E9
1200+ 74E9                  ; Se appartiene a un'altra stanza salta il record
1201+ 74E9 20 3F            jr   nz, .next_item
1202+ 74EB
1203+ 74EB                  ; ---------------------------------------------------------------
1204+ 74EB                  ; Legge coordinate e stato dell'item
1205+ 74EB                  ; ---------------------------------------------------------------
1206+ 74EB
1207+ 74EB 23               inc  hl
1208+ 74EC 4E               ld   c, (hl)           ; C = X
1209+ 74ED
1210+ 74ED 23               inc  hl
1211+ 74EE 46               ld   b, (hl)           ; B = Y
1212+ 74EF
1213+ 74EF 23               inc  hl                ; salta Color
1214+ 74F0
1215+ 74F0 23               inc  hl                ; punta a Collected
1216+ 74F1
1217+ 74F1 7E               ld   a, (hl)
1218+ 74F2
1219+ 74F2                  ; ---------------------------------------------------------------
1220+ 74F2                  ; Item già raccolto?
1221+ 74F2                  ; ---------------------------------------------------------------
1222+ 74F2 B7               or   a
1223+ 74F3 20 39            jr   nz, .next_no_inc
1224+ 74F5
1225+ 74F5                  ; ---------------------------------------------------------------
1226+ 74F5                  ; Test collisione Willy ↔ Item
1227+ 74F5                  ;
1228+ 74F5                  ; Input richiesto:
1229+ 74F5                  ;   A = ItemX
1230+ 74F5                  ;   H = ItemY
1231+ 74F5                  ; ---------------------------------------------------------------
1232+ 74F5 79               ld   a, c
1233+ 74F6
1234+ 74F6 E5               push hl                ; salva puntatore al flag Collected
1235+ 74F7
1236+ 74F7 60               ld   h, b
1237+ 74F8
1238+ 74F8 CD 93 74         call CheckWillyItemCollision
1239+ 74FB
1240+ 74FB E1               pop  hl
1241+ 74FC
1242+ 74FC                  ; Nessuna collisione
1243+ 74FC 30 30            jr   nc, .next_no_inc
1244+ 74FE
1245+ 74FE                  ; ===============================================================
1246+ 74FE                  ; ITEM RACCOLTO
1247+ 74FE                  ; ===============================================================
1248+ 74FE
1249+ 74FE                  ; ---------------------------------------------------------------
1250+ 74FE                  ; Marca l'item come raccolto
1251+ 74FE                  ; ---------------------------------------------------------------
1252+ 74FE 36 01            ld   (hl), 1
1253+ 7500
1254+ 7500                  ; ---------------------------------------------------------------
1255+ 7500                  ; Rimuove l'item dalla cache items_grid
1256+ 7500                  ;
1257+ 7500                  ; Calcolo:
1258+ 7500                  ;   offset = Row * 32 + Col
1259+ 7500                  ; ---------------------------------------------------------------
1260+ 7500 E5               push hl
1261+ 7501 D5               push de
1262+ 7502
1263+ 7502 26 00            ld   h, 0
1264+ 7504 68               ld   l, b              ; HL = Row
1265+ 7505
1266+ 7505 29               add  hl, hl            ; *2
1267+ 7506 29               add  hl, hl            ; *4
1268+ 7507 29               add  hl, hl            ; *8
1269+ 7508 29               add  hl, hl            ; *16
1270+ 7509 29               add  hl, hl            ; *32
1271+ 750A
1272+ 750A 59               ld   e, c
1273+ 750B 16 00            ld   d, 0
1274+ 750D
1275+ 750D 19               add  hl, de            ; Row*32 + Col
1276+ 750E
1277+ 750E 11 00 B0         ld   de, items_grid
1278+ 7511 19               add  hl, de
1279+ 7512
1280+ 7512                  ; La cella non contiene più un item
1281+ 7512 36 00            ld   (hl), 0
1282+ 7514
1283+ 7514 D1               pop  de
1284+ 7515 E1               pop  hl
1285+ 7516
1286+ 7516                  ; ---------------------------------------------------------------
1287+ 7516                  ; Conserva il puntatore all'entry corrente
1288+ 7516                  ; poiché le routine successive possono alterare HL.
1289+ 7516                  ; ---------------------------------------------------------------
1290+ 7516 E5               push hl
1291+ 7517
1292+ 7517                  ; ---------------------------------------------------------------
1293+ 7517                  ; Aggiorna il numero di oggetti raccolti
1294+ 7517                  ; ---------------------------------------------------------------
1295+ 7517 3A 7A 76         ld   a, (items_collected)
1296+ 751A
1297+ 751A 3C               inc  a
1298+ 751B
1299+ 751B 32 7A 76         ld   (items_collected), a
1300+ 751E
1301+ 751E                  ; ---------------------------------------------------------------
1302+ 751E                  ; Aggiorna il contatore visualizzato a schermo
1303+ 751E                  ; ---------------------------------------------------------------
1304+ 751E CD CB 60         call Gfx_UpdateItemsCollectedDisplay
1305+ 7521
1306+ 7521                  ; ---------------------------------------------------------------
1307+ 7521                  ; Ripristina il tile originale della stanza
1308+ 7521                  ; eliminando la grafica dell'item.
1309+ 7521                  ;
1310+ 7521                  ; Input:
1311+ 7521                  ;   B = Row
1312+ 7521                  ;   C = Col
1313+ 7521                  ; ---------------------------------------------------------------
1314+ 7521 CD 51 74         call RestoreBackgroundCell
1315+ 7524
1316+ 7524                  ; ---------------------------------------------------------------
1317+ 7524                  ; Riproduce il suono di raccolta
1318+ 7524                  ; ---------------------------------------------------------------
1319+ 7524 CD 4F 76         call Audio_PlayCollectSound
1320+ 7527
1321+ 7527                  ; Ripristina il puntatore alla tabella
1322+ 7527 E1               pop  hl
1323+ 7528
1324+ 7528                  ; Continua con il record successivo
1325+ 7528 18 04            jr   .next_no_inc
1326+ 752A
1327+ 752A              .next_item:
1328+ 752A
1329+ 752A                  ; ---------------------------------------------------------------
1330+ 752A                  ; Salta i campi del record:
1331+ 752A                  ;   X
1332+ 752A                  ;   Y
1333+ 752A                  ;   Color
1334+ 752A                  ;   Collected
1335+ 752A                  ; ---------------------------------------------------------------
1336+ 752A 23               inc  hl
1337+ 752B 23               inc  hl
1338+ 752C 23               inc  hl
1339+ 752D 23               inc  hl
1340+ 752E
1341+ 752E              .next_no_inc:
1342+ 752E
1343+ 752E                  ; ---------------------------------------------------------------
1344+ 752E                  ; Avanza al record successivo.
1345+ 752E                  ;
1346+ 752E                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1347+ 752E                  ; ---------------------------------------------------------------
1348+ 752E 23               inc  hl
1349+ 752F
1350+ 752F 18 AE            jr   .loop
1351+ 7531
1352+ 7531              .done:
1353+ 7531
1354+ 7531                  ; Ripristina i registri
1355+ 7531 C1               pop  bc
1356+ 7532 D1               pop  de
1357+ 7533 E1               pop  hl
1358+ 7534
1359+ 7534 C9               ret
1360+ 7535
1361+ 7535
1362+ 7535
1363+ 7535              ; -------------------------------------------------------------------
1364+ 7535              ; CheckActiveItemAtCell
1365+ 7535              ;
1366+ 7535              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1367+ 7535              ; nella cella specificata della griglia items_grid.
1368+ 7535              ;
1369+ 7535              ; Questa routine usa una lookup diretta su una mappa 32x16,
1370+ 7535              ; evitando la scansione della ItemsTable.
1371+ 7535              ;
1372+ 7535              ; Input:
1373+ 7535              ;   B = Colonna (0..31)
1374+ 7535              ;   C = Riga (0..15)
1375+ 7535              ;
1376+ 7535              ; Output:
1377+ 7535              ;   Carry Set   = item presente nella cella
1378+ 7535              ;   Carry Clear = nessun item
1379+ 7535              ;
1380+ 7535              ; Nota:
1381+ 7535              ;   HL NON è restituito valido (commento originale non corretto:
1382+ 7535              ;   la routine non punta a ItemsTable).
