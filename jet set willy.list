   6+ 6B0B              ; MovePlayer
   7+ 6B0B              ;
   8+ 6B0B              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6B0B              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6B0B              ; con i muri.
  11+ 6B0B              ;
  12+ 6B0B              ; Input:
  13+ 6B0B              ;   D = stato dei controlli (bitfield)
  14+ 6B0B              ;
  15+ 6B0B              ; Strutture utilizzate:
  16+ 6B0B              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6B0B              ;   player_speed    -> velocità orizzontale
  18+ 6B0B              ;   flags           -> flag di stato input
  19+ 6B0B              ;
  20+ 6B0B              ; Bit controlli:
  21+ 6B0B              ;   bit 0 = sinistra
  22+ 6B0B              ;   bit 1 = destra
  23+ 6B0B              ;
  24+ 6B0B              ; Nota:
  25+ 6B0B              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6B0B              ;   ignorato per tutta la durata del salto.
  27+ 6B0B              ;
  28+ 6B0B              ; Output:
  29+ 6B0B              ;   aggiorna PlayerPos e body_state
  30+ 6B0B              ; -------------------------------------------------------------------
  31+ 6B0B              MovePlayer:
  32+ 6B0B
  33+ 6B0B                  ; ---------------------------------------------------------------
  34+ 6B0B                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6B0B                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6B0B                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6B0B                  ; ---------------------------------------------------------------
  38+ 6B0B 3A F9 EA         ld   a, (on_ground)
  39+ 6B0E B7               or   a
  40+ 6B0F 20 1A            jr   nz, .on_ground_check
  41+ 6B11
