 167  86E0                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 168  86E0 C3 E3 86         jp   .willy_dies
 169  86E3                  ELSE
 170  86E3 ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 171  86E3 ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 172  86E3 ~                    ELSE
 173  86E3 ~                    jp   .no_collision
 174  86E3 ~                    ENDIF
 175  86E3                  ENDIF
