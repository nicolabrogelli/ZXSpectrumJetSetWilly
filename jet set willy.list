 231+ 6B60              ; -------------------------------------------------------------------
 232+ 6B60              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 233+ 6B60              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 234+ 6B60              ; -------------------------------------------------------------------
 235+ 6B60              DrawItemGraphic:
 236+ 6B60 C5               push bc
 237+ 6B61 D5               push de
 238+ 6B62 E5               push hl
 239+ 6B63
 240+ 6B63                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 241+ 6B63 78               ld   a, b
 242+ 6B64 E6 18            and  $18
 243+ 6B66 C6 40            add  a, $40
 244+ 6B68 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 245+ 6B69
 246+ 6B69 78               ld   a, b
 247+ 6B6A E6 07            and  7
 248+ 6B6C 87               add  a, a              ; *2
 249+ 6B6D 87               add  a, a              ; *4
 250+ 6B6E 87               add  a, a              ; *8
 251+ 6B6F 87               add  a, a              ; *16
 252+ 6B70 87               add  a, a              ; *32
 253+ 6B71 81               add  a, c              ; + Col C
 254+ 6B72 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 255+ 6B73
 256+ 6B73                  ; 2. Copia gli 8 byte del bitmap dello sprite
 257+ 6B73 C5               push bc                ; Salva BC (contiene Row e Col)
 258+ 6B74 06 08            ld   b, 8              ; 8 scanline
 259+ 6B76              .line_loop:
 260+ 6B76 7E               ld   a, (hl)
 261+ 6B77 12               ld   (de), a
 262+ 6B78 14               inc  d                 ; Prossima scanline
 263+ 6B79 23               inc  hl
 264+ 6B7A 05               dec  b
 265+ 6B7B 20 F9            jr   nz, .line_loop
 266+ 6B7D C1               pop  bc                ; Ripristina BC
 267+ 6B7E
 268+ 6B7E                  ; 3. Calcola l'indirizzo degli attributi dello schermo
 269+ 6B7E                  ; HL = $5800 + B * 32 + C
 270+ 6B7E 26 00            ld   h, 0
 271+ 6B80 68               ld   l, b              ; HL = B (Row)
 272+ 6B81 29               add  hl, hl            ; *2
 273+ 6B82 29               add  hl, hl            ; *4
 274+ 6B83 29               add  hl, hl            ; *8
 275+ 6B84 29               add  hl, hl            ; *16
 276+ 6B85 29               add  hl, hl            ; *32
 277+ 6B86
 278+ 6B86 79               ld   a, c              ; A = Col
 279+ 6B87 85               add  a, l
 280+ 6B88 6F               ld   l, a
 281+ 6B89 30 01            jr   nc, .no_carry
 282+ 6B8B 24               inc  h
 283+ 6B8C              .no_carry:
 284+ 6B8C                  ; HL = B * 32 + C
 285+ 6B8C 11 00 58         ld   de, $5800
 286+ 6B8F 19               add  hl, de            ; HL = AttrAddr
 287+ 6B90
 288+ 6B90                  ; Ripristina i registri dallo stack per estrarre il colore in E
 289+ 6B90                  ; Lo stack ha: HL (originale), DE (originale con colore in E), BC (originale)
 290+ 6B90 C1               pop  bc                ; BC = HL originale
 291+ 6B91 D1               pop  de                ; DE = DE originale (colore in E)
 292+ 6B92
 293+ 6B92 7B               ld   a, e              ; A = Colore
 294+ 6B93 77               ld   (hl), a           ; Scrivi in memoria attributi (HL)
 295+ 6B94
 296+ 6B94                  ; Ripristina lo stack e i registri originari
 297+ 6B94 C5               push bc                ; Rimetti HL originale sulla pila
 298+ 6B95 E1               pop  hl                ; HL = HL originale
 299+ 6B96 C1               pop  bc                ; BC = BC originale
 300+ 6B97 C9               ret
 301+ 6B98
 302+ 6B98              ; -------------------------------------------------------------------
 303+ 6B98              ; Ripristina la cella dello sfondo originale per cancellare l'item
 304+ 6B98              ; Input: B = Row (3..18), C = Col (0..31)
 305+ 6B98              ; -------------------------------------------------------------------
 306+ 6B98              RestoreBackgroundCell:
 307+ 6B98 FD E5            push iy                ; Preserva IY
 308+ 6B9A C5               push bc
 309+ 6B9B D5               push de
 310+ 6B9C E5               push hl
