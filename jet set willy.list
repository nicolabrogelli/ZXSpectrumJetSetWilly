 666+ 72ED              ; -------------------------------------------------------------------
 667+ 72ED              ; DrawItemGraphic
 668+ 72ED              ;
 669+ 72ED              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 670+ 72ED              ; utilizzando una bitmap di 8 byte e un attributo colore.
 671+ 72ED              ;
 672+ 72ED              ; Input:
 673+ 72ED              ;   B = Riga attributi (3..18)
 674+ 72ED              ;   C = Colonna attributi (0..31)
 675+ 72ED              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 676+ 72ED              ;   E = Attributo colore
 677+ 72ED              ;
 678+ 72ED              ; Output:
 679+ 72ED              ;   Nessuno
 680+ 72ED              ;
 681+ 72ED              ; Registri preservati:
 682+ 72ED              ;   BC, DE, HL
 683+ 72ED              ; -------------------------------------------------------------------
 684+ 72ED              DrawItemGraphic:
 685+ 72ED
 686+ 72ED                  ; Salva i registri originali
 687+ 72ED C5               push bc
 688+ 72EE D5               push de
 689+ 72EF E5               push hl
 690+ 72F0
 691+ 72F0                  ; ---------------------------------------------------------------
 692+ 72F0                  ; Calcolo indirizzo bitmap dello Spectrum
 693+ 72F0                  ;
 694+ 72F0                  ; Ogni item occupa una cella attributi (8x8 pixel).
 695+ 72F0                  ;
 696+ 72F0                  ; Formula:
 697+ 72F0                  ;   High = $40 + (Row AND $18)
 698+ 72F0                  ;   Low  = (Row AND 7) * 32 + Col
 699+ 72F0                  ;
 700+ 72F0                  ; DE conterrà l'indirizzo della prima scanline.
 701+ 72F0                  ; ---------------------------------------------------------------
 702+ 72F0
 703+ 72F0 78               ld   a, b
 704+ 72F1 E6 18            and  $18
 705+ 72F3 C6 40            add  a, $40
 706+ 72F5 57               ld   d, a              ; Byte alto indirizzo video
 707+ 72F6
 708+ 72F6 78               ld   a, b
 709+ 72F7 E6 07            and  7                 ; Riga interna al blocco da 8
 710+ 72F9
 711+ 72F9 87               add  a, a              ; *2
 712+ 72FA 87               add  a, a              ; *4
 713+ 72FB 87               add  a, a              ; *8
 714+ 72FC 87               add  a, a              ; *16
 715+ 72FD 87               add  a, a              ; *32
 716+ 72FE
 717+ 72FE 81               add  a, c              ; + colonna
 718+ 72FF
 719+ 72FF 5F               ld   e, a              ; Byte basso indirizzo video
 720+ 7300
 721+ 7300                  ; ---------------------------------------------------------------
 722+ 7300                  ; Disegno bitmap
 723+ 7300                  ;
 724+ 7300                  ; Copia 8 byte consecutivi nella memoria video.
 725+ 7300                  ; Ogni byte rappresenta una scanline da 8 pixel.
 726+ 7300                  ; ---------------------------------------------------------------
 727+ 7300
 728+ 7300 C5               push bc                ; Conserva Row e Col
 729+ 7301
 730+ 7301 06 08            ld   b, 8              ; Numero scanline
 731+ 7303
 732+ 7303              .line_loop:
 733+ 7303
 734+ 7303 7E               ld   a, (hl)           ; Legge scanline bitmap
 735+ 7304 12               ld   (de), a           ; Scrive nella memoria video
 736+ 7305
 737+ 7305 14               inc  d                 ; Scanline successiva
 738+ 7306 23               inc  hl                ; Byte bitmap successivo
 739+ 7307
 740+ 7307 05               dec  b
 741+ 7308 20 F9            jr   nz, .line_loop
 742+ 730A
 743+ 730A C1               pop  bc                ; Ripristina Row e Col
 744+ 730B
 745+ 730B                  ; ---------------------------------------------------------------
 746+ 730B                  ; Calcolo indirizzo attributo
 747+ 730B                  ;
 748+ 730B                  ; Formula:
 749+ 730B                  ;   AttrAddr = $5800 + Row * 32 + Col
 750+ 730B                  ;
 751+ 730B                  ; HL conterrà l'indirizzo della cella attributi.
 752+ 730B                  ; ---------------------------------------------------------------
 753+ 730B
 754+ 730B 26 00            ld   h, 0
 755+ 730D 68               ld   l, b              ; HL = Row
 756+ 730E
 757+ 730E 29               add  hl, hl            ; *2
 758+ 730F 29               add  hl, hl            ; *4
 759+ 7310 29               add  hl, hl            ; *8
 760+ 7311 29               add  hl, hl            ; *16
 761+ 7312 29               add  hl, hl            ; *32
 762+ 7313
 763+ 7313 79               ld   a, c              ; A = Colonna
 764+ 7314
 765+ 7314 85               add  a, l
 766+ 7315 6F               ld   l, a
 767+ 7316
 768+ 7316 30 01            jr   nc, .no_carry
 769+ 7318 24               inc  h
 770+ 7319
 771+ 7319              .no_carry:
 772+ 7319
 773+ 7319                  ; HL = Row * 32 + Col
 774+ 7319
 775+ 7319 11 00 58         ld   de, $5800
 776+ 731C 19               add  hl, de            ; HL = indirizzo attributi
 777+ 731D
 778+ 731D                  ; ---------------------------------------------------------------
 779+ 731D                  ; Recupera il colore originale dallo stack.
 780+ 731D                  ;
 781+ 731D                  ; Layout stack:
 782+ 731D                  ;   HL originale
 783+ 731D                  ;   DE originale (E = colore)
 784+ 731D                  ;   BC originale
 785+ 731D                  ; ---------------------------------------------------------------
 786+ 731D
 787+ 731D C1               pop  bc                ; Recupera HL originale
 788+ 731E D1               pop  de                ; Recupera DE originale
 789+ 731F
 790+ 731F                  ; ---------------------------------------------------------------
 791+ 731F                  ; Scrive l'attributo colore
 792+ 731F                  ; ---------------------------------------------------------------
 793+ 731F
 794+ 731F 7B               ld   a, e              ; A = colore
 795+ 7320 77               ld   (hl), a           ; Scrive nella RAM attributi
 796+ 7321
 797+ 7321                  ; ---------------------------------------------------------------
 798+ 7321                  ; Ripristina HL e BC originali
 799+ 7321                  ; ---------------------------------------------------------------
 800+ 7321
 801+ 7321 C5               push bc
 802+ 7322 E1               pop  hl                ; HL originale
 803+ 7323
 804+ 7323 C1               pop  bc                ; BC originale
 805+ 7324
 806+ 7324 C9               ret
 807+ 7325
 808+ 7325              ; -------------------------------------------------------------------
 809+ 7325              ; RestoreBackgroundCell
 810+ 7325              ;
 811+ 7325              ; Ripristina il contenuto originale di una cella della stanza.
 812+ 7325              ; Viene utilizzata principalmente quando un item viene raccolto:
 813+ 7325              ; invece di lasciare un "buco", la routine ridisegna il tile
 814+ 7325              ; originale presente nella mappa della stanza.
 815+ 7325              ;
 816+ 7325              ; Input:
 817+ 7325              ;   B = Row (3..18)
 818+ 7325              ;   C = Col (0..31)
 819+ 7325              ;
 820+ 7325              ; Utilizza:
 821+ 7325              ;   room_ptr -> struttura dati della stanza corrente
 822+ 7325              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 823+ 7325              ;   Gfx_DrawTile -> ridisegna il tile selezionato
 824+ 7325              ;
 825+ 7325              ; Tipi di cella:
 826+ 7325              ;   0 = Background
 827+ 7325              ;   1 = Floor
 828+ 7325              ;   2 = Wall
 829+ 7325              ;   3 = Nasty
 830+ 7325              ; -------------------------------------------------------------------
 831+ 7325              RestoreBackgroundCell:
 832+ 7325
 833+ 7325                  ; Salva tutti i registri utilizzati
 834+ 7325 FD E5            push iy
 835+ 7327 C5               push bc
 836+ 7328 D5               push de
 837+ 7329 E5               push hl
 838+ 732A DD E5            push ix
 839+ 732C
 840+ 732C                  ; ---------------------------------------------------------------
 841+ 732C                  ; Conserva Row e Col in IY.
 842+ 732C                  ;
 843+ 732C                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 844+ 732C                  ; BC potrebbe essere modificato.
 845+ 732C                  ; ---------------------------------------------------------------
 846+ 732C C5               push bc
 847+ 732D FD E1            pop  iy                ; IYH = Row, IYL = Col
 848+ 732F
 849+ 732F                  ; ---------------------------------------------------------------
 850+ 732F                  ; Determina quale tipo di cella è presente nella posizione
 851+ 732F                  ; specificata.
 852+ 732F                  ;
 853+ 732F                  ; Input:
 854+ 732F                  ;   B = Row
 855+ 732F                  ;   C = Col
 856+ 732F                  ;
 857+ 732F                  ; Output:
 858+ 732F                  ;   A = tipo cella
 859+ 732F                  ; ---------------------------------------------------------------
 860+ 732F 78               ld   a, b
 861+ 7330
 862+ 7330 CD 7B 6B         call GetCellFromUnpacked
 863+ 7333
 864+ 7333                  ; ---------------------------------------------------------------
 865+ 7333                  ; Recupera il puntatore alla stanza corrente.
 866+ 7333                  ;
 867+ 7333                  ; DE = base della struttura stanza
 868+ 7333                  ; ---------------------------------------------------------------
 869+ 7333 ED 5B B6 78      ld   de, (room_ptr)
 870+ 7337
 871+ 7337                  ; ---------------------------------------------------------------
 872+ 7337                  ; Seleziona il tile corretto in base al tipo di cella.
 873+ 7337                  ;
 874+ 7337                  ; A = 0 -> Background
 875+ 7337                  ; A = 1 -> Floor
 876+ 7337                  ; A = 2 -> Wall
 877+ 7337                  ; A = 3 -> Nasty
 878+ 7337                  ; ---------------------------------------------------------------
 879+ 7337
 880+ 7337 B7               or   a
 881+ 7338 20 06            jr   nz, .not_bg
 882+ 733A
 883+ 733A                  ; Background
 884+ 733A 21 A0 00         ld   hl, OFFSET_BG
 885+ 733D 19               add  hl, de
 886+ 733E 18 16            jr   .draw_cell
 887+ 7340
 888+ 7340              .not_bg:
 889+ 7340
 890+ 7340 3D               dec  a
 891+ 7341 20 06            jr   nz, .not_floor
 892+ 7343
 893+ 7343                  ; Floor
 894+ 7343 21 A9 00         ld   hl, OFFSET_FLOOR
 895+ 7346 19               add  hl, de
 896+ 7347 18 0D            jr   .draw_cell
 897+ 7349
 898+ 7349              .not_floor:
 899+ 7349
 900+ 7349 3D               dec  a
 901+ 734A 20 06            jr   nz, .not_wall
 902+ 734C
 903+ 734C                  ; Wall
 904+ 734C 21 B2 00         ld   hl, OFFSET_WALL
 905+ 734F 19               add  hl, de
 906+ 7350 18 04            jr   .draw_cell
 907+ 7352
 908+ 7352              .not_wall:
 909+ 7352
 910+ 7352                  ; Nasty
 911+ 7352 21 BB 00         ld   hl, OFFSET_NASTY
 912+ 7355 19               add  hl, de
 913+ 7356
 914+ 7356              .draw_cell:
 915+ 7356
 916+ 7356                  ; ---------------------------------------------------------------
 917+ 7356                  ; HL punta ora alla grafica del tile da ridisegnare.
 918+ 7356                  ;
 919+ 7356                  ; Gfx_DrawTile si aspetta:
 920+ 7356                  ;   IX = puntatore tile
 921+ 7356                  ;   B  = Row
 922+ 7356                  ;   C  = Col
 923+ 7356                  ; ---------------------------------------------------------------
 924+ 7356 E5               push hl
 925+ 7357 DD E1            pop  ix
 926+ 7359
 927+ 7359                  ; Ripristina Row e Col salvati in IY
 928+ 7359 FD E5            push iy
 929+ 735B C1               pop  bc
 930+ 735C
 931+ 735C                  ; Disegna il tile originale
 932+ 735C CD 8C 61         call Gfx_DrawTile
 933+ 735F
 934+ 735F                  ; ---------------------------------------------------------------
 935+ 735F                  ; Ripristina i registri salvati
 936+ 735F                  ; ---------------------------------------------------------------
 937+ 735F DD E1            pop  ix
 938+ 7361 E1               pop  hl
 939+ 7362 D1               pop  de
 940+ 7363 C1               pop  bc
 941+ 7364 FD E1            pop  iy
 942+ 7366
 943+ 7366 C9               ret
 944+ 7367
 945+ 7367              ; -------------------------------------------------------------------
 946+ 7367              ; CheckWillyItemCollision
 947+ 7367              ;
 948+ 7367              ; Verifica se Willy collide con un item utilizzando il controllo
 949+ 7367              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 950+ 7367              ;
 951+ 7367              ; Input:
 952+ 7367              ;   A = ItemX (colonna attributi 0..31)
 953+ 7367              ;   H = ItemY (riga attributi 3..18)
 954+ 7367              ;
 955+ 7367              ; Coordinate item:
 956+ 7367              ;   Ogni item occupa una cella da 8x8 pixel.
 957+ 7367              ;
 958+ 7367              ; Coordinate Willy:
 959+ 7367              ;   Willy occupa un rettangolo di 16x16 pixel.
 960+ 7367              ;
 961+ 7367              ; Output:
 962+ 7367              ;   Carry Set   = collisione rilevata
 963+ 7367              ;   Carry Clear = nessuna collisione
 964+ 7367              ;
 965+ 7367              ; Registri preservati:
 966+ 7367              ;   BC, DE, HL
 967+ 7367              ; -------------------------------------------------------------------
 968+ 7367              CheckWillyItemCollision:
 969+ 7367
 970+ 7367                  ; Salva i registri utilizzati
 971+ 7367 C5               push bc
 972+ 7368 D5               push de
 973+ 7369 E5               push hl
 974+ 736A
 975+ 736A                  ; ---------------------------------------------------------------
 976+ 736A                  ; Calcola il bounding box orizzontale dell'item
 977+ 736A                  ;
 978+ 736A                  ; ItemLeft  = ItemX * 8
 979+ 736A                  ; ItemRight = ItemLeft + 7
 980+ 736A                  ;
 981+ 736A                  ; E = ItemLeft
 982+ 736A                  ; D = ItemRight
 983+ 736A                  ; ---------------------------------------------------------------
 984+ 736A 6F               ld   l, a              ; L = ItemX
 985+ 736B
 986+ 736B 7D               ld   a, l
 987+ 736C 87               add  a, a              ; *2
 988+ 736D 87               add  a, a              ; *4
 989+ 736E 87               add  a, a              ; *8
 990+ 736F
 991+ 736F 5F               ld   e, a              ; E = ItemLeft
 992+ 7370
 993+ 7370 C6 07            add  a, 7
 994+ 7372 57               ld   d, a              ; D = ItemRight
 995+ 7373
 996+ 7373                  ; ---------------------------------------------------------------
 997+ 7373                  ; Recupera la posizione corrente di Willy
 998+ 7373                  ;
 999+ 7373                  ; B = WillyY
1000+ 7373                  ; C = WillyX
1001+ 7373                  ; ---------------------------------------------------------------
1002+ 7373 ED 4B 44 75      ld   bc, (PlayerPos)
1003+ 7377
1004+ 7377                  ; ---------------------------------------------------------------
1005+ 7377                  ; Primo test:
1006+ 7377                  ;
1007+ 7377                  ; WillyLeft <= ItemRight
1008+ 7377                  ;
1009+ 7377                  ; Se Willy è completamente a destra dell'item
1010+ 7377                  ; non può esserci collisione.
1011+ 7377                  ; ---------------------------------------------------------------
1012+ 7377 79               ld   a, c              ; A = WillyLeft
1013+ 7378
1014+ 7378 BA               cp   d                 ; WillyLeft vs ItemRight
1015+ 7379
1016+ 7379 28 04            jr   z, .x_ok
1017+ 737B 38 02            jr   c, .x_ok
1018+ 737D
1019+ 737D 18 29            jr   .no_collision
1020+ 737F
1021+ 737F              .x_ok:
1022+ 737F
1023+ 737F                  ; ---------------------------------------------------------------
1024+ 737F                  ; Secondo test:
1025+ 737F                  ;
1026+ 737F                  ; WillyRight >= ItemLeft
1027+ 737F                  ;
1028+ 737F                  ; WillyRight = WillyX + 7
1029+ 737F                  ; ---------------------------------------------------------------
1030+ 737F C6 07            add  a, 7
1031+ 7381
1032+ 7381 BB               cp   e                 ; WillyRight vs ItemLeft
1033+ 7382
1034+ 7382 28 04            jr   z, .y_check
1035+ 7384 30 02            jr   nc, .y_check
1036+ 7386
1037+ 7386 18 20            jr   .no_collision
1038+ 7388
1039+ 7388              .y_check:
1040+ 7388
1041+ 7388                  ; ---------------------------------------------------------------
1042+ 7388                  ; Recupera ItemY dal valore originale di HL
1043+ 7388                  ;
1044+ 7388                  ; H contiene la riga dell'item.
1045+ 7388                  ; ---------------------------------------------------------------
1046+ 7388 E1               pop  hl
1047+ 7389 E5               push hl
1048+ 738A
1049+ 738A                  ; ---------------------------------------------------------------
1050+ 738A                  ; Calcola il bounding box verticale dell'item
1051+ 738A                  ;
1052+ 738A                  ; ItemTop    = ItemY * 8
1053+ 738A                  ; ItemBottom = ItemTop + 7
1054+ 738A                  ;
1055+ 738A                  ; E = ItemTop
1056+ 738A                  ; D = ItemBottom
1057+ 738A                  ; ---------------------------------------------------------------
1058+ 738A 7C               ld   a, h
1059+ 738B
1060+ 738B 87               add  a, a              ; *2
1061+ 738C 87               add  a, a              ; *4
1062+ 738D 87               add  a, a              ; *8
1063+ 738E
1064+ 738E 5F               ld   e, a              ; ItemTop
1065+ 738F
1066+ 738F C6 07            add  a, 7
1067+ 7391 57               ld   d, a              ; ItemBottom
1068+ 7392
1069+ 7392                  ; ---------------------------------------------------------------
1070+ 7392                  ; Primo test verticale:
1071+ 7392                  ;
1072+ 7392                  ; WillyTop <= ItemBottom
1073+ 7392                  ; ---------------------------------------------------------------
1074+ 7392 78               ld   a, b              ; WillyTop
1075+ 7393
1076+ 7393 BA               cp   d
1077+ 7394
1078+ 7394 28 04            jr   z, .y_ok
1079+ 7396 38 02            jr   c, .y_ok
1080+ 7398
1081+ 7398 18 0E            jr   .no_collision
1082+ 739A
1083+ 739A              .y_ok:
1084+ 739A
1085+ 739A                  ; ---------------------------------------------------------------
1086+ 739A                  ; Secondo test verticale:
1087+ 739A                  ;
1088+ 739A                  ; WillyBottom >= ItemTop
1089+ 739A                  ;
1090+ 739A                  ; WillyBottom = WillyY + 15
1091+ 739A                  ; ---------------------------------------------------------------
1092+ 739A C6 0F            add  a, 15
1093+ 739C
1094+ 739C BB               cp   e
1095+ 739D
1096+ 739D 28 04            jr   z, .collision
1097+ 739F 30 02            jr   nc, .collision
1098+ 73A1
1099+ 73A1 18 05            jr   .no_collision
1100+ 73A3
1101+ 73A3              .collision:
1102+ 73A3
1103+ 73A3                  ; ---------------------------------------------------------------
1104+ 73A3                  ; Collisione rilevata
1105+ 73A3                  ; ---------------------------------------------------------------
1106+ 73A3 E1               pop  hl
1107+ 73A4 D1               pop  de
1108+ 73A5 C1               pop  bc
1109+ 73A6
1110+ 73A6 37               scf                    ; Carry = 1
1111+ 73A7
1112+ 73A7 C9               ret
1113+ 73A8
1114+ 73A8              .no_collision:
1115+ 73A8
