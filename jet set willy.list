1111+ 6BB6              ; -------------------------------------------------------------------
1112+ 6BB6              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1113+ 6BB6              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1114+ 6BB6              ; -------------------------------------------------------------------
1115+ 6BB6              UnpackRoomLayout:
1116+ 6BB6 E5               push hl
1117+ 6BB7 D5               push de
1118+ 6BB8 C5               push bc
1119+ 6BB9
1120+ 6BB9 2A 3D 7A         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1121+ 6BBC 11 E3 77         ld   de, unpacked_layout ; DE = buffer RAM
1122+ 6BBF 06 80            ld   b, 128             ; 128 byte
1123+ 6BC1              .byte_loop:
1124+ 6BC1 7E               ld   a, (hl)            ; Leggi byte compresso
1125+ 6BC2 23               inc  hl
1126+ 6BC3
1127+ 6BC3 4F               ld   c, a               ; C = salvataggio
1128+ 6BC4
1129+ 6BC4                  ; Cella 0: bit 7-6
1130+ 6BC4 07               rlca
1131+ 6BC5 07               rlca
1132+ 6BC6 E6 03            and  3
1133+ 6BC8 12               ld   (de), a
1134+ 6BC9 13               inc  de
1135+ 6BCA
1136+ 6BCA                  ; Cella 1: bit 5-4
1137+ 6BCA 79               ld   a, c
1138+ 6BCB 07               rlca
1139+ 6BCC 07               rlca
1140+ 6BCD 07               rlca
1141+ 6BCE 07               rlca
1142+ 6BCF E6 03            and  3
1143+ 6BD1 12               ld   (de), a
1144+ 6BD2 13               inc  de
1145+ 6BD3
1146+ 6BD3                  ; Cella 2: bit 3-2
1147+ 6BD3 79               ld   a, c
1148+ 6BD4 0F               rrca
1149+ 6BD5 0F               rrca
1150+ 6BD6 E6 03            and  3
1151+ 6BD8 12               ld   (de), a
1152+ 6BD9 13               inc  de
1153+ 6BDA
1154+ 6BDA                  ; Cella 3: bit 1-0
1155+ 6BDA 79               ld   a, c
1156+ 6BDB E6 03            and  3
