  80+ 7B12 C1               pop  bc
  81+ 7B13 E1               pop  hl
  82+ 7B14 20 17            jr   nz, .store_enemy_flags ; Non è Master Bedroom
  83+ 7B16
  84+ 7B16                  ; Siamo nella Master Bedroom: controlla se il tipo di nemico (Byte 1) è VECCHIA
  85+ 7B16 23               inc  hl
  86+ 7B17 7E               ld   a, (hl)           ; A = Type
  87+ 7B18 2B               dec  hl
  88+ 7B19 FE 22            cp   VECCHIA
  89+ 7B1B 20 10            jr   nz, .store_enemy_flags ; Non è VECCHIA
  90+ 7B1D
  91+ 7B1D                  ; È la Vecchia nella Master Bedroom! Controlla se tutti gli item sono stati raccolti
  92+ 7B1D 3A 57 F8         ld   a, (game_objective_completed)
  93+ 7B20 B7               or   a
  94+ 7B21 20 07            jr   nz, .disable_master_bedroom_vecchia
  95+ 7B23 3A 4F F4         ld   a, (items_collected)
  96+ 7B26 FE 4D            cp   TOTAL_ITEMS
  97+ 7B28 38 03            jr   c, .store_enemy_flags ; Meno di TOTAL_ITEMS -> mantieni attiva
  98+ 7B2A
  99+ 7B2A              .disable_master_bedroom_vecchia:
