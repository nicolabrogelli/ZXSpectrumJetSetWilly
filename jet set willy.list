 332  879D 21 8D 5C         ld   hl, ATTR_P
 333  87A0 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 334  87A1 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 335  87A4 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 336  87A6 3E 07            ld   a, $07
 337  87A8 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 338  87AB
 339  87AB                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
