  83+ 6D55              ; MOVIMENTO SINISTRA
  84+ 6D55              ; ===============================================================
  85+ 6D55              movePlayer_left:
  86+ 6D55                  ; Impedisci lo spostamento a sinistra se Willy è sul conveyor ed il conveyor va a destra.
  87+ 6D55 CD 41 76         call CheckWillyOnConveyor
  88+ 6D58 30 05            jr   nc, .continue_left
  89+ 6D5A 3A 6C F7         ld   a, (conveyor_dir)
  90+ 6D5D B7               or   a
  91+ 6D5E C0               ret  nz                     ; Se è sul conveyor e va a destra, ritorna senza muovere
  92+ 6D5F
