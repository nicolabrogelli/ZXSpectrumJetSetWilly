 822+ 6A92 3A 62 78         ld   a, (ramp_len)
 823+ 6A95 80               add  a, b              ; A = ramp_col + ramp_len
 824+ 6A96 4F               ld   c, a              ; C = limit_right (exclusive)
 825+ 6A97
 826+ 6A97 7B               ld   a, e              ; A = Col
 827+ 6A98 B8               cp   b
 828+ 6A99 38 34            jr   c, .check_platform_case ; Col < ramp_col
 829+ 6A9B B9               cp   c
 830+ 6A9C 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 831+ 6A9E
 832+ 6A9E                  ; Calcola B = Col - ramp_col
 833+ 6A9E 7B               ld   a, e
 834+ 6A9F 90               sub  b
 835+ 6AA0 47               ld   b, a              ; B = offset (0..ramp_len-1)
 836+ 6AA1
 837+ 6AA1                  ; SlopeRow = ramp_row - B
 838+ 6AA1 3A 63 78         ld   a, (ramp_row)
 839+ 6AA4 90               sub  b
 840+ 6AA5 47               ld   b, a              ; B = SlopeRow
 841+ 6AA6 18 1F            jr   .check_row_match
 842+ 6AA8
 843+ 6AA8              .range_left:
 844+ 6AA8                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 845+ 6AA8 21 62 78         ld   hl, ramp_len
