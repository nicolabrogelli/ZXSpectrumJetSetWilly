 361  833C C9               ret
 362  833D
 363  833D              ; -------------------------------------------------------------------
 364  833D              ; Time_UpdateClock
 365  833D              ; Gestisce lo scorrimento del tempo durante il gioco.
 366  833D              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 367  833D              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 368  833D              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 369  833D              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 370  833D              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 371  833D              ; sia completato, scatena immediatamente il Game Over.
 372  833D              ; -------------------------------------------------------------------
 373  833D              Time_UpdateClock:
 374  833D                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 375  833D 2A 47 E6         ld   hl, (counter)
 376  8340 ED 5B 36 EA      ld   de, (time_last_counter)
 377  8344 B7               or   a
 378  8345 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 379  8347
 380  8347                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 381  8347 11 32 00         ld   de, CLOCK_TICKS_PER_MINUTE
 382  834A B7               or   a
 383  834B ED 52            sbc  hl, de
 384  834D D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 385  834E
 386  834E                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 387  834E 2A 36 EA         ld   hl, (time_last_counter)
 388  8351 11 32 00         ld   de, CLOCK_TICKS_PER_MINUTE
 389  8354 19               add  hl, de
 390  8355 22 36 EA         ld   (time_last_counter), hl
 391  8358
 392  8358                  ; Incrementa di 1 minuto il tempo di gioco
 393  8358 3A 34 EA         ld   a, (time_minutes)
 394  835B 3C               inc  a
 395  835C FE 3C            cp   60
 396  835E 38 21            jr   c, .minutes_ok
 397  8360
 398  8360                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 399  8360 AF               xor  a
 400  8361 32 34 EA         ld   (time_minutes), a
 401  8364 3A 33 EA         ld   a, (time_hours)
 402  8367 3C               inc  a
 403  8368 FE 0C            cp   12
 404  836A 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 405  836C FE 0D            cp   13
 406  836E 38 0E            jr   c, .hours_ok
 407  8370 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 408  8372 18 0A            jr   .hours_ok
 409  8374
 410  8374              .toggle_period:
 411  8374 F5               push af                     ; Salva A (valore 12)
 412  8375 3A 35 EA         ld   a, (time_period)
 413  8378 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 414  837A 32 35 EA         ld   (time_period), a
 415  837D F1               pop  af                     ; Ripristina A = 12
 416  837E
 417  837E              .hours_ok:
 418  837E 32 33 EA         ld   (time_hours), a
 419  8381
 420  8381              .minutes_ok:
 421  8381 32 34 EA         ld   (time_minutes), a
