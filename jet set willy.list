 206+ 6C70
 207+ 6C70              .set_room:
 208+ 6C70
 209+ 6C70                  ; Salva l'ID della stanza corrente
 210+ 6C70 32 AE 7D         ld   (current_room), a
 211+ 6C73
 212+ 6C73                  ; Ripristina i registri
 213+ 6C73 D1               pop  de
