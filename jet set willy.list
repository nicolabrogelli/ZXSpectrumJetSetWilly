1985+ 7FEB              ; CheckActiveItemAtCell
1986+ 7FEB              ;
1987+ 7FEB              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1988+ 7FEB              ; nella cella specificata della griglia items_grid.
1989+ 7FEB              ;
1990+ 7FEB              ; Questa routine usa una lookup diretta su una mappa 32x16,
1991+ 7FEB              ; evitando la scansione della ItemsTable.
1992+ 7FEB              ;
1993+ 7FEB              ; Input:
1994+ 7FEB              ;   B = Colonna (0..31)
1995+ 7FEB              ;   C = Riga (0..15)
1996+ 7FEB              ;
1997+ 7FEB              ; Output:
1998+ 7FEB              ;   Carry Set   = item presente nella cella
1999+ 7FEB              ;   Carry Clear = nessun item
2000+ 7FEB              ;
2001+ 7FEB              ; Nota:
2002+ 7FEB              ;   HL NON è restituito valido (commento originale non corretto:
2003+ 7FEB              ;   la routine non punta a ItemsTable).
2004+ 7FEB              ; -------------------------------------------------------------------
2005+ 7FEB              CheckActiveItemAtCell:
2006+ 7FEB
2007+ 7FEB                  ; Salva registri usati
2008+ 7FEB D5               push de
2009+ 7FEC E5               push hl
2010+ 7FED
2011+ 7FED                  ; ---------------------------------------------------------------
2012+ 7FED                  ; Calcolo indice lineare nella griglia 32x16:
2013+ 7FED                  ;
2014+ 7FED                  ; offset = Row * 32 + Col
2015+ 7FED                  ; ---------------------------------------------------------------
2016+ 7FED 26 00            ld   h, 0
2017+ 7FEF 69               ld   l, c              ; HL = Row
2018+ 7FF0
2019+ 7FF0 29               add  hl, hl            ; *2
2020+ 7FF1 29               add  hl, hl            ; *4
2021+ 7FF2 29               add  hl, hl            ; *8
2022+ 7FF3 29               add  hl, hl            ; *16
2023+ 7FF4 29               add  hl, hl            ; *32
2024+ 7FF5
2025+ 7FF5                  ; Aggiunge la colonna
2026+ 7FF5 58               ld   e, b
2027+ 7FF6 16 00            ld   d, 0
2028+ 7FF8 19               add  hl, de            ; HL = Row*32 + Col
2029+ 7FF9
2030+ 7FF9                  ; ---------------------------------------------------------------
2031+ 7FF9                  ; Accesso alla griglia degli item attivi
2032+ 7FF9                  ; ---------------------------------------------------------------
2033+ 7FF9 11 26 E4         ld   de, items_grid
2034+ 7FFC 19               add  hl, de            ; HL = address cella
2035+ 7FFD
2036+ 7FFD                  ; ---------------------------------------------------------------
2037+ 7FFD                  ; Controllo presenza item
2038+ 7FFD                  ;
2039+ 7FFD                  ; items_grid contiene:
2040+ 7FFD                  ;   0 = nessun item
2041+ 7FFD                  ;   >0 = item attivo (colore o flag)
2042+ 7FFD                  ; ---------------------------------------------------------------
2043+ 7FFD 7E               ld   a, (hl)
2044+ 7FFE B7               or   a
2045+ 7FFF 28 04            jr   z, .not_active
2046+ 8001
2047+ 8001                  ; ---------------------------------------------------------------
2048+ 8001                  ; Item trovato
2049+ 8001                  ; ---------------------------------------------------------------
2050+ 8001 E1               pop  hl
2051+ 8002 D1               pop  de
2052+ 8003
2053+ 8003 37               scf                    ; Carry = 1
2054+ 8004 C9               ret
2055+ 8005
2056+ 8005              .not_active:
2057+ 8005
2058+ 8005                  ; ---------------------------------------------------------------
2059+ 8005                  ; Nessun item nella cella
2060+ 8005                  ; ---------------------------------------------------------------
2061+ 8005 E1               pop  hl
2062+ 8006 D1               pop  de
2063+ 8007
2064+ 8007 B7               or   a                 ; Carry = 0
2065+ 8008 C9               ret
