1257+ 64B8 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
1258+ 64B9 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
1259+ 64BC 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
1260+ 64BE 3E 07            ld   a, $07
1261+ 64C0 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
1262+ 64C3
1263+ 64C3                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1264+ 64C3                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1265+ 64C3 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1266+ 64C6 DD 21 EA CC      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1267+ 64CA CD 3F 5E         call Gfx_DrawPixelSprite8x8
1268+ 64CD
