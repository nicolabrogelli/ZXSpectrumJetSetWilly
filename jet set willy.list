 127+ 7607              ; -------------------------------------------------------------------
 128+ 7607              ; DetermineCurrentRoomID
 129+ 7607              ;
 130+ 7607              ; Determina l'ID numerico della stanza corrente confrontando
 131+ 7607              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 132+ 7607              ;
 133+ 7607              ; Se viene trovata una corrispondenza:
 134+ 7607              ;   A = ID della stanza
 135+ 7607              ;   current_room = A
 136+ 7607              ;
 137+ 7607              ; Mappatura:
 138+ 7607              ;    0 = The Off Licence
 139+ 7607              ;    1 = The Bridge
 140+ 7607              ;    2 = Under The Mega Tree
 141+ 7607              ;    3 = Gfx_At The Foot Of The Mega Tree
 142+ 7607              ;    4 = The Drive
 143+ 7607              ;    5 = The Security Guard
 144+ 7607              ;    6 = Entrance To Hades
 145+ 7607              ;    7 = Cuckoo's Nest
 146+ 7607              ;    8 = Inside The Mega Trunk
 147+ 7607              ;    9 = On A Branch Over The Drive
 148+ 7607              ;   10 = The Front Door
 149+ 7607              ;   11 = The Hall
 150+ 7607              ;   12 = Tree Top
 151+ 7607              ;   27 = The Chapel
 152+ 7607              ;   28 = First Landing
 153+ 7607              ;   29 = The Nightmare Room
 154+ 7607              ;   33 = The Bathroom
 155+ 7607              ;   35 = Master Bedroom
 156+ 7607              ;
 157+ 7607              ; Se nessuna stanza corrisponde viene impostato:
 158+ 7607              ;   current_room = 0
 159+ 7607              ; -------------------------------------------------------------------
 160+ 7607              DetermineCurrentRoomID:
 161+ 7607
