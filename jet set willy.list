 246+ 89BC              ; -------------------------------------------------------------------
 247+ 89BC              ; Audio_PlayCollectSound
 248+ 89BC              ;
 249+ 89BC              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 250+ 89BC              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 251+ 89BC              ; -------------------------------------------------------------------
 252+ 89BC              Audio_PlayCollectSound:
 253+ 89BC C5               push bc
 254+ 89BD D5               push de
 255+ 89BE
 256+ 89BE 06 78            ld   b, 120
 257+ 89C0              .sound_loop:
 258+ 89C0 3A F4 F7         ld   a, (room_border_color)
 259+ 89C3 F6 10            or   $10               ; speaker ON
 260+ 89C5 D3 FE            out  ($fe), a
 261+ 89C7
 262+ 89C7 0E 3C            ld   c, 60
 263+ 89C9              .d1:
 264+ 89C9 0D               dec  c
 265+ 89CA 20 FD            jr   nz, .d1
 266+ 89CC
 267+ 89CC 3A F4 F7         ld   a, (room_border_color)
 268+ 89CF E6 EF            and  $ef              ; speaker OFF
 269+ 89D1 D3 FE            out  ($fe), a
 270+ 89D3
 271+ 89D3 0E 3C            ld   c, 60
 272+ 89D5              .d2:
 273+ 89D5 0D               dec  c
 274+ 89D6 20 FD            jr   nz, .d2
 275+ 89D8
 276+ 89D8 10 E6            djnz .sound_loop
 277+ 89DA
 278+ 89DA D1               pop  de
 279+ 89DB C1               pop  bc
 280+ 89DC C9               ret
