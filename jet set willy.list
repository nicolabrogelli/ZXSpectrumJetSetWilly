  69+ 70EA              ; DetermineCurrentRoomID
  70+ 70EA              ;
  71+ 70EA              ; Determina l'ID numerico della stanza corrente confrontando
  72+ 70EA              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  73+ 70EA              ;
  74+ 70EA              ; Se viene trovata una corrispondenza:
  75+ 70EA              ;   A = ID della stanza
  76+ 70EA              ;   current_room = A
  77+ 70EA              ;
  78+ 70EA              ; Mappatura:
  79+ 70EA              ;    0 = The Off Licence
  80+ 70EA              ;    1 = The Bridge
  81+ 70EA              ;    2 = Under The Mega Tree
  82+ 70EA              ;    3 = Gfx_At The Foot Of The Mega Tree
  83+ 70EA              ;    4 = The Drive
  84+ 70EA              ;    5 = The Security Guard
  85+ 70EA              ;    6 = Entrance To Hades
  86+ 70EA              ;    7 = Cuckoo's Nest
  87+ 70EA              ;    8 = Inside The Mega Trunk
  88+ 70EA              ;    9 = On A Branch Over The Drive
  89+ 70EA              ;   10 = The Front Door
  90+ 70EA              ;   11 = The Hall
  91+ 70EA              ;   12 = Tree Top
  92+ 70EA              ;   33 = The Bathroom
  93+ 70EA              ;   35 = Master Bedroom
  94+ 70EA              ;
  95+ 70EA              ; Se nessuna stanza corrisponde viene impostato:
  96+ 70EA              ;   current_room = 0
  97+ 70EA              ; -------------------------------------------------------------------
