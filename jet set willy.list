 616  89F7              ; -------------------------------------------------------------------
 617  89F7              ; Time_UpdateClock
 618  89F7              ; Gestisce lo scorrimento del tempo durante il gioco.
 619  89F7              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 620  89F7              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 621  89F7              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 622  89F7              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 623  89F7              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 624  89F7              ; sia completato, scatena immediatamente il Game Over.
 625  89F7              ; -------------------------------------------------------------------
 626  89F7              Time_UpdateClock:
 627  89F7                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 628  89F7 2A 9D EC         ld   hl, (counter)
 629  89FA ED 5B 8C F0      ld   de, (time_last_counter)
 630  89FE B7               or   a
 631  89FF ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 632  8A01
 633  8A01                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 634  8A01 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 635  8A04 B7               or   a
 636  8A05 ED 52            sbc  hl, de
 637  8A07 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 638  8A08
 639  8A08                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 640  8A08 2A 8C F0         ld   hl, (time_last_counter)
 641  8A0B 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 642  8A0E 19               add  hl, de
 643  8A0F 22 8C F0         ld   (time_last_counter), hl
 644  8A12
 645  8A12                  ; Incrementa di 1 minuto il tempo di gioco
 646  8A12 3A 8A F0         ld   a, (time_minutes)
 647  8A15 3C               inc  a
 648  8A16 FE 3C            cp   60
 649  8A18 38 21            jr   c, .minutes_ok
 650  8A1A
 651  8A1A                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 652  8A1A AF               xor  a
 653  8A1B 32 8A F0         ld   (time_minutes), a
 654  8A1E 3A 89 F0         ld   a, (time_hours)
 655  8A21 3C               inc  a
 656  8A22 FE 0C            cp   12
 657  8A24 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 658  8A26 FE 0D            cp   13
 659  8A28 38 0E            jr   c, .hours_ok
 660  8A2A 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 661  8A2C 18 0A            jr   .hours_ok
 662  8A2E
 663  8A2E              .toggle_period:
 664  8A2E F5               push af                     ; Salva A (valore 12)
 665  8A2F 3A 8B F0         ld   a, (time_period)
 666  8A32 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 667  8A34 32 8B F0         ld   (time_period), a
 668  8A37 F1               pop  af                     ; Ripristina A = 12
 669  8A38
 670  8A38              .hours_ok:
 671  8A38 32 89 F0         ld   (time_hours), a
 672  8A3B
 673  8A3B              .minutes_ok:
 674  8A3B 32 8A F0         ld   (time_minutes), a
 675  8A3E
 676  8A3E                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 677  8A3E CD FB 66         call Gfx_UpdateTimeDisplay
 678  8A41
 679  8A41                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 680  8A41 3A 8E F0         ld   a, (game_objective_completed)
 681  8A44 B7               or   a
 682  8A45 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 683  8A46
 684  8A46                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 685  8A46 3A 8B F0         ld   a, (time_period)
 686  8A49 B7               or   a
 687  8A4A C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 688  8A4B
 689  8A4B 3A 89 F0         ld   a, (time_hours)
 690  8A4E FE 0C            cp   12
 691  8A50 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
 692  8A52 C9               ret
 693  8A53
 694  8A53              .time_limit_reached:
 695  8A53                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
 696  8A53                  ; Scatena immediatamente il Game Over temporale!
 697  8A53 C3 53 88         jp   TriggerGameOver
