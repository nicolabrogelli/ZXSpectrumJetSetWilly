 568+ 72A8
 569+ 72A8 CD ED 72         call DrawItemGraphic
 570+ 72AB
 571+ 72AB E1               pop  hl                ; ritorna al flag collected
 572+ 72AC
 573+ 72AC                  ; ---------------------------------------------------------------
 574+ 72AC                  ; Aggiorna items_grid
 575+ 72AC                  ;
 576+ 72AC                  ; Calcolo:
 577+ 72AC                  ;   offset = Row * 32 + Col
 578+ 72AC                  ; ---------------------------------------------------------------
 579+ 72AC E5               push hl
 580+ 72AD D5               push de
 581+ 72AE
 582+ 72AE 26 00            ld   h, 0
 583+ 72B0 68               ld   l, b              ; HL = Row
