 882+ 7A4D DD BE 05         cp   (ix+5)            ; Max Limit (Offset 5)
 883+ 7A50 28 08            jr   z, .h_rev_left
 884+ 7A52 30 06            jr   nc, .h_rev_left
 885+ 7A54 DD 77 02         ld   (ix+2), a
 886+ 7A57 C3 AC 7A         jp   .next
