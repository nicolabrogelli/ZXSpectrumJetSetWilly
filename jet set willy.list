 974+ 792A              ; -------------------------------------------------------------------
 975+ 792A              ; DrawItemGraphic
 976+ 792A              ;
 977+ 792A              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 978+ 792A              ; utilizzando una bitmap di 8 byte e un attributo colore.
 979+ 792A              ;
 980+ 792A              ; Input:
 981+ 792A              ;   B = Riga attributi (3..18)
 982+ 792A              ;   C = Colonna attributi (0..31)
 983+ 792A              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 984+ 792A              ;   E = Attributo colore
 985+ 792A              ;
 986+ 792A              ; Output:
 987+ 792A              ;   Nessuno
 988+ 792A              ;
 989+ 792A              ; Registri preservati:
 990+ 792A              ;   BC, DE, HL
 991+ 792A              ; -------------------------------------------------------------------
 992+ 792A              DrawItemGraphic:
 993+ 792A
 994+ 792A                  ; Salva i registri originali
 995+ 792A C5               push bc
 996+ 792B D5               push de
 997+ 792C E5               push hl
 998+ 792D
 999+ 792D                  ; ---------------------------------------------------------------
1000+ 792D                  ; Calcolo indirizzo bitmap dello Spectrum
1001+ 792D                  ;
1002+ 792D                  ; Ogni item occupa una cella attributi (8x8 pixel).
1003+ 792D                  ;
1004+ 792D                  ; Formula:
1005+ 792D                  ;   High = $40 + (Row AND $18)
1006+ 792D                  ;   Low  = (Row AND 7) * 32 + Col
1007+ 792D                  ;
1008+ 792D                  ; DE conterrà l'indirizzo della prima scanline.
1009+ 792D                  ; ---------------------------------------------------------------
1010+ 792D
1011+ 792D 78               ld   a, b
1012+ 792E E6 18            and  $18
1013+ 7930 C6 40            add  a, $40
1014+ 7932 57               ld   d, a              ; Byte alto indirizzo video
1015+ 7933
1016+ 7933 78               ld   a, b
1017+ 7934 E6 07            and  7                 ; Riga interna al blocco da 8
1018+ 7936
1019+ 7936 87               add  a, a              ; *2
1020+ 7937 87               add  a, a              ; *4
1021+ 7938 87               add  a, a              ; *8
1022+ 7939 87               add  a, a              ; *16
1023+ 793A 87               add  a, a              ; *32
1024+ 793B
1025+ 793B 81               add  a, c              ; + colonna
1026+ 793C
1027+ 793C 5F               ld   e, a              ; Byte basso indirizzo video
1028+ 793D
1029+ 793D                  ; ---------------------------------------------------------------
1030+ 793D                  ; Disegno bitmap
1031+ 793D                  ;
1032+ 793D                  ; Copia 8 byte consecutivi nella memoria video.
1033+ 793D                  ; Ogni byte rappresenta una scanline da 8 pixel.
1034+ 793D                  ; ---------------------------------------------------------------
1035+ 793D
1036+ 793D C5               push bc                ; Conserva Row e Col
1037+ 793E
1038+ 793E 06 08            ld   b, 8              ; Numero scanline
1039+ 7940
1040+ 7940              .line_loop:
1041+ 7940
1042+ 7940 7E               ld   a, (hl)           ; Legge scanline bitmap
1043+ 7941 12               ld   (de), a           ; Scrive nella memoria video
1044+ 7942
1045+ 7942 14               inc  d                 ; Scanline successiva
1046+ 7943 23               inc  hl                ; Byte bitmap successivo
1047+ 7944
1048+ 7944 05               dec  b
1049+ 7945 20 F9            jr   nz, .line_loop
1050+ 7947
1051+ 7947 C1               pop  bc                ; Ripristina Row e Col
1052+ 7948
1053+ 7948                  ; ---------------------------------------------------------------
1054+ 7948                  ; Calcolo indirizzo attributo
1055+ 7948                  ;
1056+ 7948                  ; Formula:
1057+ 7948                  ;   AttrAddr = $5800 + Row * 32 + Col
1058+ 7948                  ;
1059+ 7948                  ; HL conterrà l'indirizzo della cella attributi.
1060+ 7948                  ; ---------------------------------------------------------------
1061+ 7948
1062+ 7948 26 00            ld   h, 0
1063+ 794A 68               ld   l, b              ; HL = Row
1064+ 794B
1065+ 794B 29               add  hl, hl            ; *2
1066+ 794C 29               add  hl, hl            ; *4
1067+ 794D 29               add  hl, hl            ; *8
1068+ 794E 29               add  hl, hl            ; *16
1069+ 794F 29               add  hl, hl            ; *32
1070+ 7950
1071+ 7950 79               ld   a, c              ; A = Colonna
1072+ 7951
1073+ 7951 85               add  a, l
1074+ 7952 6F               ld   l, a
1075+ 7953
1076+ 7953 30 01            jr   nc, .no_carry
1077+ 7955 24               inc  h
1078+ 7956
1079+ 7956              .no_carry:
1080+ 7956
1081+ 7956                  ; HL = Row * 32 + Col
1082+ 7956
1083+ 7956 11 00 58         ld   de, $5800
1084+ 7959 19               add  hl, de            ; HL = indirizzo attributi
1085+ 795A
1086+ 795A                  ; ---------------------------------------------------------------
1087+ 795A                  ; Recupera il colore originale dallo stack.
1088+ 795A                  ;
1089+ 795A                  ; Layout stack:
1090+ 795A                  ;   HL originale
1091+ 795A                  ;   DE originale (E = colore)
1092+ 795A                  ;   BC originale
1093+ 795A                  ; ---------------------------------------------------------------
1094+ 795A
1095+ 795A C1               pop  bc                ; Recupera HL originale
1096+ 795B D1               pop  de                ; Recupera DE originale
1097+ 795C
1098+ 795C                  ; ---------------------------------------------------------------
1099+ 795C                  ; Scrive l'attributo colore
1100+ 795C                  ; ---------------------------------------------------------------
1101+ 795C
1102+ 795C 7B               ld   a, e              ; A = colore
1103+ 795D 77               ld   (hl), a           ; Scrive nella RAM attributi
1104+ 795E
1105+ 795E                  ; ---------------------------------------------------------------
1106+ 795E                  ; Ripristina HL e BC originali
1107+ 795E                  ; ---------------------------------------------------------------
1108+ 795E
1109+ 795E C5               push bc
1110+ 795F E1               pop  hl                ; HL originale
1111+ 7960
1112+ 7960 C1               pop  bc                ; BC originale
1113+ 7961
1114+ 7961 C9               ret
1115+ 7962
1116+ 7962              ; -------------------------------------------------------------------
1117+ 7962              ; RestoreBackgroundCell
1118+ 7962              ;
1119+ 7962              ; Ripristina il contenuto originale di una cella della stanza.
1120+ 7962              ; Viene utilizzata principalmente quando un item viene raccolto:
1121+ 7962              ; invece di lasciare un "buco", la routine ridisegna il tile
1122+ 7962              ; originale presente nella mappa della stanza.
1123+ 7962              ;
1124+ 7962              ; Input:
1125+ 7962              ;   B = Row (3..18)
1126+ 7962              ;   C = Col (0..31)
1127+ 7962              ;
1128+ 7962              ; Utilizza:
1129+ 7962              ;   room_ptr -> struttura dati della stanza corrente
1130+ 7962              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1131+ 7962              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1132+ 7962              ;
1133+ 7962              ; Tipi di cella:
1134+ 7962              ;   0 = Background
1135+ 7962              ;   1 = Floor
1136+ 7962              ;   2 = Wall
1137+ 7962              ;   3 = Nasty
1138+ 7962              ; -------------------------------------------------------------------
1139+ 7962              RestoreBackgroundCell:
1140+ 7962
1141+ 7962                  ; Salva tutti i registri utilizzati
1142+ 7962 FD E5            push iy
1143+ 7964 C5               push bc
1144+ 7965 D5               push de
1145+ 7966 E5               push hl
1146+ 7967 DD E5            push ix
1147+ 7969
1148+ 7969                  ; ---------------------------------------------------------------
1149+ 7969                  ; Conserva Row e Col in IY.
1150+ 7969                  ;
1151+ 7969                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1152+ 7969                  ; BC potrebbe essere modificato.
1153+ 7969                  ; ---------------------------------------------------------------
1154+ 7969 C5               push bc
1155+ 796A FD E1            pop  iy                ; IYH = Row, IYL = Col
1156+ 796C
1157+ 796C                  ; ---------------------------------------------------------------
1158+ 796C                  ; Determina quale tipo di cella è presente nella posizione
1159+ 796C                  ; specificata.
1160+ 796C                  ;
1161+ 796C                  ; Input:
1162+ 796C                  ;   B = Row
1163+ 796C                  ;   C = Col
1164+ 796C                  ;
1165+ 796C                  ; Output:
1166+ 796C                  ;   A = tipo cella
1167+ 796C                  ; ---------------------------------------------------------------
1168+ 796C 78               ld   a, b
1169+ 796D
1170+ 796D CD AE 6C         call GetCellFromUnpacked
1171+ 7970
1172+ 7970                  ; ---------------------------------------------------------------
1173+ 7970                  ; Recupera il puntatore alla stanza corrente.
1174+ 7970                  ;
1175+ 7970                  ; DE = base della struttura stanza
1176+ 7970                  ; ---------------------------------------------------------------
1177+ 7970 ED 5B 4B 7E      ld   de, (room_ptr)
1178+ 7974
1179+ 7974                  ; ---------------------------------------------------------------
