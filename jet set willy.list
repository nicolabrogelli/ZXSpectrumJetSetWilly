  71+ 794E              ; Audio_UpdateMusic
  72+ 794E              ;
  73+ 794E              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 794E              ; Viene chiamata a ogni frame.
  75+ 794E              ; -------------------------------------------------------------------
  76+ 794E              Audio_UpdateMusic:
  77+ 794E F5               push af
  78+ 794F C5               push bc
  79+ 7950 D5               push de
  80+ 7951 E5               push hl
  81+ 7952
  82+ 7952                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 7952 3A 9B 7D         ld   a, (Audio_jump_sound_note)
