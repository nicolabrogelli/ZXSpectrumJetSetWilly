1254+ 776A              .byte_loop:
1255+ 776A 7E               ld   a, (hl)            ; Leggi byte compresso
1256+ 776B 23               inc  hl
1257+ 776C
1258+ 776C 4F               ld   c, a               ; C = salvataggio
1259+ 776D
1260+ 776D                  ; Cella 0: bit 7-6
1261+ 776D 07               rlca
1262+ 776E 07               rlca
1263+ 776F E6 03            and  3
1264+ 7771 12               ld   (de), a
1265+ 7772 13               inc  de
1266+ 7773
1267+ 7773                  ; Cella 1: bit 5-4
1268+ 7773 79               ld   a, c
1269+ 7774 07               rlca
1270+ 7775 07               rlca
1271+ 7776 07               rlca
1272+ 7777 07               rlca
1273+ 7778 E6 03            and  3
1274+ 777A 12               ld   (de), a
1275+ 777B 13               inc  de
1276+ 777C
1277+ 777C                  ; Cella 2: bit 3-2
1278+ 777C 79               ld   a, c
1279+ 777D 0F               rrca
1280+ 777E 0F               rrca
1281+ 777F E6 03            and  3
1282+ 7781 12               ld   (de), a
1283+ 7782 13               inc  de
1284+ 7783
1285+ 7783                  ; Cella 3: bit 1-0
