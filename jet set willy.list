  92+ 7B1D 3A 41 F7         ld   a, (game_objective_completed)
  93+ 7B20 B7               or   a
  94+ 7B21 20 07            jr   nz, .disable_master_bedroom_vecchia
  95+ 7B23 3A 39 F3         ld   a, (items_collected)
  96+ 7B26 FE 4D            cp   TOTAL_ITEMS
