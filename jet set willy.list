650+  608D              DrawFloorDirect:
651+  608D C5               push bc
652+  608E D5               push de
653+  608F E5               push hl
654+  6090 DD E5            push ix
655+  6092
656+  6092                  ; Disegniamo le 8 scanline della riga 18
657+  6092 DD 21 62 61      ld   ix, TilesDef + 64 ; Puntatore alla grafica del bordo/pavimento (9° carattere)
658+  6096 16 00            ld   d, 0              ; D = offset scanline (0..6)
659+  6098
660+  6098              .scanline_loop:
661+  6098 3E 50            ld   a, $50            ; Base del terzo 2 per scanline 0, riga 18
662+  609A 82               add  a, d              ; A = $50 + scanline offset (D)
663+  609B 67               ld   h, a              ; HL high byte = $50 + D
664+  609C 2E 40            ld   l, $40            ; HL low byte = $40 (Colonna 0 per la riga 18)
665+  609E
666+  609E DD 5E 00         ld   e, (ix+0)         ; E = byte grafico per questa scanline
667+  60A1 0E 20            ld   c, 32             ; 32 colonne
668+  60A3
669+  60A3              .col_loop:
670+  60A3 73               ld   (hl), e           ; Scrivi il byte grafico direttamente nello schermo
671+  60A4 2C               inc  l                 ; Vai alla colonna successiva
672+  60A5 0D               dec  c
673+  60A6 20 FB            jr   nz, .col_loop
674+  60A8
675+  60A8 DD 23            inc  ix                ; Prossimo byte grafico
676+  60AA 14               inc  d                 ; Prossima scanline
677+  60AB 7A               ld   a, d
678+  60AC FE 07            cp   7
679+  60AE 20 E8            jr   nz, .scanline_loop
680+  60B0
