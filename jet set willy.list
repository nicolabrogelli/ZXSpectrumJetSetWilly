 857+ 6AAC              .range_left:
 858+ 6AAC                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 859+ 6AAC 21 20 78         ld   hl, ramp_len
 860+ 6AAF 3A 22 78         ld   a, (ramp_col)
