  41+ 6E2E CB 3F            srl  a
  42+ 6E30 CB 3F            srl  a
  43+ 6E32 CB 3F            srl  a                 ; A = c (0..31)
  44+ 6E34 4F               ld   c, a              ; C = c (salva colonna)
  45+ 6E35
  46+ 6E35                  ; HL = r * 8 + c / 4
  47+ 6E35 CB 3F            srl  a
  48+ 6E37 CB 3F            srl  a                 ; A = c / 4
