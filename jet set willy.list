1061+ 6DFF
1062+ 6DFF                  ; Se la cella è sulla rampa, non considerarla un muro!
1063+ 6DFF 53               ld   d, e              ; D = Row
1064+ 6E00 59               ld   e, c              ; E = Col
1065+ 6E01 CD 6D 6D         call IsCellOnRamp
1066+ 6E04 38 09            jr   c, .not_wall
