 264+ 5EE5 BB               cp   e                 ; compare with player row E
 265+ 5EE6 DA 0F 5F         jp   c, .normal_grid   ; if RampRowStart < E, skip!
 266+ 5EE9
 267+ 5EE9 93               sub  e                 ; A = RampRowStart - E
 268+ 5EEA 47               ld   b, a              ; B = distance from start row (0..ramp_len-1)
 269+ 5EEB 3A 3A 7E         ld   a, (ramp_len)
 270+ 5EEE B8               cp   b
 271+ 5EEF CA 0F 5F         jp   z, .normal_grid   ; if B == ramp_len, too high!
 272+ 5EF2 DA 0F 5F         jp   c, .normal_grid   ; if B > ramp_len, too high!
 273+ 5EF5
 274+ 5EF5                  ; Calcola ExpectedCol:
