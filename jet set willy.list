 803+ 72E4              ; RestoreBackgroundCell
 804+ 72E4              ;
 805+ 72E4              ; Ripristina il contenuto originale di una cella della stanza.
 806+ 72E4              ; Viene utilizzata principalmente quando un item viene raccolto:
 807+ 72E4              ; invece di lasciare un "buco", la routine ridisegna il tile
 808+ 72E4              ; originale presente nella mappa della stanza.
 809+ 72E4              ;
 810+ 72E4              ; Input:
 811+ 72E4              ;   B = Row (3..18)
 812+ 72E4              ;   C = Col (0..31)
 813+ 72E4              ;
 814+ 72E4              ; Utilizza:
 815+ 72E4              ;   room_ptr -> struttura dati della stanza corrente
 816+ 72E4              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 817+ 72E4              ;   DrawTile -> ridisegna il tile selezionato
 818+ 72E4              ;
 819+ 72E4              ; Tipi di cella:
 820+ 72E4              ;   0 = Background
 821+ 72E4              ;   1 = Floor
 822+ 72E4              ;   2 = Wall
 823+ 72E4              ;   3 = Nasty
 824+ 72E4              ; -------------------------------------------------------------------
 825+ 72E4              RestoreBackgroundCell:
 826+ 72E4
 827+ 72E4                  ; Salva tutti i registri utilizzati
 828+ 72E4 FD E5            push iy
 829+ 72E6 C5               push bc
 830+ 72E7 D5               push de
 831+ 72E8 E5               push hl
 832+ 72E9 DD E5            push ix
 833+ 72EB
 834+ 72EB                  ; ---------------------------------------------------------------
 835+ 72EB                  ; Conserva Row e Col in IY.
 836+ 72EB                  ;
 837+ 72EB                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 838+ 72EB                  ; BC potrebbe essere modificato.
 839+ 72EB                  ; ---------------------------------------------------------------
 840+ 72EB C5               push bc
 841+ 72EC FD E1            pop  iy                ; IYH = Row, IYL = Col
 842+ 72EE
 843+ 72EE                  ; ---------------------------------------------------------------
 844+ 72EE                  ; Determina quale tipo di cella è presente nella posizione
 845+ 72EE                  ; specificata.
 846+ 72EE                  ;
 847+ 72EE                  ; Input:
 848+ 72EE                  ;   B = Row
 849+ 72EE                  ;   C = Col
 850+ 72EE                  ;
 851+ 72EE                  ; Output:
 852+ 72EE                  ;   A = tipo cella
 853+ 72EE                  ; ---------------------------------------------------------------
 854+ 72EE 78               ld   a, b
 855+ 72EF
 856+ 72EF CD 7F 6B         call GetCellFromUnpacked
 857+ 72F2
 858+ 72F2                  ; ---------------------------------------------------------------
 859+ 72F2                  ; Recupera il puntatore alla stanza corrente.
 860+ 72F2                  ;
 861+ 72F2                  ; DE = base della struttura stanza
 862+ 72F2                  ; ---------------------------------------------------------------
 863+ 72F2 ED 5B 74 78      ld   de, (room_ptr)
 864+ 72F6
 865+ 72F6                  ; ---------------------------------------------------------------
 866+ 72F6                  ; Seleziona il tile corretto in base al tipo di cella.
 867+ 72F6                  ;
 868+ 72F6                  ; A = 0 -> Background
 869+ 72F6                  ; A = 1 -> Floor
 870+ 72F6                  ; A = 2 -> Wall
 871+ 72F6                  ; A = 3 -> Nasty
 872+ 72F6                  ; ---------------------------------------------------------------
 873+ 72F6
 874+ 72F6 B7               or   a
 875+ 72F7 20 06            jr   nz, .not_bg
 876+ 72F9
 877+ 72F9                  ; Background
 878+ 72F9 21 A0 00         ld   hl, OFFSET_BG
 879+ 72FC 19               add  hl, de
 880+ 72FD 18 16            jr   .draw_cell
 881+ 72FF
 882+ 72FF              .not_bg:
 883+ 72FF
 884+ 72FF 3D               dec  a
 885+ 7300 20 06            jr   nz, .not_floor
 886+ 7302
 887+ 7302                  ; Floor
 888+ 7302 21 A9 00         ld   hl, OFFSET_FLOOR
 889+ 7305 19               add  hl, de
 890+ 7306 18 0D            jr   .draw_cell
 891+ 7308
 892+ 7308              .not_floor:
 893+ 7308
 894+ 7308 3D               dec  a
 895+ 7309 20 06            jr   nz, .not_wall
 896+ 730B
 897+ 730B                  ; Wall
 898+ 730B 21 B2 00         ld   hl, OFFSET_WALL
 899+ 730E 19               add  hl, de
 900+ 730F 18 04            jr   .draw_cell
 901+ 7311
 902+ 7311              .not_wall:
 903+ 7311
 904+ 7311                  ; Nasty
 905+ 7311 21 BB 00         ld   hl, OFFSET_NASTY
 906+ 7314 19               add  hl, de
 907+ 7315
 908+ 7315              .draw_cell:
 909+ 7315
 910+ 7315                  ; ---------------------------------------------------------------
 911+ 7315                  ; HL punta ora alla grafica del tile da ridisegnare.
 912+ 7315                  ;
 913+ 7315                  ; DrawTile si aspetta:
 914+ 7315                  ;   IX = puntatore tile
 915+ 7315                  ;   B  = Row
 916+ 7315                  ;   C  = Col
 917+ 7315                  ; ---------------------------------------------------------------
 918+ 7315 E5               push hl
 919+ 7316 DD E1            pop  ix
 920+ 7318
 921+ 7318                  ; Ripristina Row e Col salvati in IY
 922+ 7318 FD E5            push iy
 923+ 731A C1               pop  bc
 924+ 731B
 925+ 731B                  ; Disegna il tile originale
 926+ 731B CD 8C 61         call DrawTile
 927+ 731E
 928+ 731E                  ; ---------------------------------------------------------------
 929+ 731E                  ; Ripristina i registri salvati
 930+ 731E                  ; ---------------------------------------------------------------
 931+ 731E DD E1            pop  ix
 932+ 7320 E1               pop  hl
 933+ 7321 D1               pop  de
 934+ 7322 C1               pop  bc
 935+ 7323 FD E1            pop  iy
