   6+ 6B78              ; MovePlayer
   7+ 6B78              ;
   8+ 6B78              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6B78              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6B78              ; con i muri.
  11+ 6B78              ;
  12+ 6B78              ; Input:
  13+ 6B78              ;   D = stato dei controlli (bitfield)
  14+ 6B78              ;
  15+ 6B78              ; Strutture utilizzate:
  16+ 6B78              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6B78              ;   player_speed    -> velocità orizzontale
  18+ 6B78              ;   flags           -> flag di stato input
  19+ 6B78              ;
  20+ 6B78              ; Bit controlli:
  21+ 6B78              ;   bit 0 = sinistra
  22+ 6B78              ;   bit 1 = destra
  23+ 6B78              ;
  24+ 6B78              ; Nota:
  25+ 6B78              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6B78              ;   ignorato per tutta la durata del salto.
  27+ 6B78              ;
  28+ 6B78              ; Output:
  29+ 6B78              ;   aggiorna PlayerPos e body_state
  30+ 6B78              ; -------------------------------------------------------------------
  31+ 6B78              MovePlayer:
  32+ 6B78
  33+ 6B78                  ; ---------------------------------------------------------------
  34+ 6B78                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6B78                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6B78                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6B78                  ; ---------------------------------------------------------------
  38+ 6B78 3A 66 EB         ld   a, (on_ground)
  39+ 6B7B B7               or   a
  40+ 6B7C 20 1A            jr   nz, .on_ground_check
  41+ 6B7E
  42+ 6B7E 3A 6B EB         ld   a, (jump_dir)
  43+ 6B81 B7               or   a
  44+ 6B82 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6B83
  46+ 6B83                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6B83 DD 21 5F EB      ld   ix, flags
  48+ 6B87 DD CB 00 86      res  $00, (ix)
  49+ 6B8B
  50+ 6B8B ED 4B 57 EB      ld   bc, (PlayerPos)
  51+ 6B8F FE 01            cp   1
  52+ 6B91 28 1D            jr   z, movePlayer_left
  53+ 6B93 FE 02            cp   2
  54+ 6B95 28 6A            jr   z, movePlayer_right
  55+ 6B97 C9               ret
  56+ 6B98
  57+ 6B98              .on_ground_check:
  58+ 6B98                  ; ---------------------------------------------------------------
  59+ 6B98                  ; Se siamo a terra, muoviti solo se c'è input (bit 0 di flags impostato)
  60+ 6B98                  ; ---------------------------------------------------------------
  61+ 6B98 DD 21 5F EB      ld   ix, flags
  62+ 6B9C DD CB 00 46      bit  $00, (ix)
  63+ 6BA0 C8               ret  z
  64+ 6BA1
  65+ 6BA1 DD CB 00 86      res  $00, (ix)
  66+ 6BA5
  67+ 6BA5 ED 4B 57 EB      ld   bc, (PlayerPos)
  68+ 6BA9
