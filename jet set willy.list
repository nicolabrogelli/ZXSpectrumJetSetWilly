  63+ 6C36              ; DetermineCurrentRoomID
  64+ 6C36              ;
  65+ 6C36              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 6C36              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 6C36              ;
  68+ 6C36              ; Se viene trovata una corrispondenza:
  69+ 6C36              ;   A = ID della stanza
  70+ 6C36              ;   current_room = A
  71+ 6C36              ;
  72+ 6C36              ; Mappatura:
  73+ 6C36              ;    0 = The Off Licence
  74+ 6C36              ;    1 = The Bridge
  75+ 6C36              ;    2 = Under The Mega Tree
  76+ 6C36              ;    3 = At The Foot Of The Mega Tree
  77+ 6C36              ;    4 = The Drive
  78+ 6C36              ;    5 = The Security Guard
  79+ 6C36              ;    6 = Entrance To Hades
  80+ 6C36              ;    7 = Cuckoo's Nest
  81+ 6C36              ;    8 = Inside The Mega Trunk
  82+ 6C36              ;    9 = On A Branch Over The Drive
  83+ 6C36              ;   10 = The Fornt Door
  84+ 6C36              ;   33 = The Bathroom
  85+ 6C36              ;   35 = Master Bedroom
  86+ 6C36              ;
  87+ 6C36              ; Se nessuna stanza corrisponde viene impostato:
  88+ 6C36              ;   current_room = 0
  89+ 6C36              ; -------------------------------------------------------------------
