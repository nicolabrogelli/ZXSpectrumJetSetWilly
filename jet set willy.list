 867+ 6AB9 4F               ld   c, a              ; C = limit_right (exclusive)
 868+ 6ABA
 869+ 6ABA 7B               ld   a, e              ; A = Col
 870+ 6ABB B8               cp   b
 871+ 6ABC 38 15            jr   c, .check_platform_case
 872+ 6ABE B9               cp   c
