 271+ 5EFC
 272+ 5EFC                  ; 5. Ottieni il puntatore al tile corrispondente
 273+ 5EFC B7               or   a
 274+ 5EFD 20 05            jr   nz, .not_bg
 275+ 5EFF 21 A0 00         ld   hl, OFFSET_BG
 276+ 5F02 18 13            jr   .load_tile
 277+ 5F04              .not_bg:
 278+ 5F04 3D               dec  a
 279+ 5F05 20 05            jr   nz, .not_floor
