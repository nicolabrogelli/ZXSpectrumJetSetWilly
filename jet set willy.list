  71+ 6CFA 20 0F            jr   nz, .a_not_pressed     ; bit 0 = 1 → A non premuto, salta
  72+ 6CFC
  73+ 6CFC                  ; A è premuto: debounce tramite (a_prev).
  74+ 6CFC 3A 99 EC         ld   a, (a_prev)
