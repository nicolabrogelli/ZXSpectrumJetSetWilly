 147+ 74F7              ; -------------------------------------------------------------------
 148+ 74F7              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 149+ 74F7              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 150+ 74F7              ; -------------------------------------------------------------------
 151+ 74F7              DrawItemGraphic:
 152+ 74F7 C5               push bc
 153+ 74F8 D5               push de
 154+ 74F9 E5               push hl
 155+ 74FA
 156+ 74FA                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 157+ 74FA 78               ld   a, b
 158+ 74FB E6 18            and  $18
 159+ 74FD C6 40            add  a, $40
 160+ 74FF 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 161+ 7500
 162+ 7500 78               ld   a, b
 163+ 7501 E6 07            and  7
 164+ 7503 87               add  a, a              ; *2
 165+ 7504 87               add  a, a              ; *4
 166+ 7505 87               add  a, a              ; *8
 167+ 7506 87               add  a, a              ; *16
 168+ 7507 87               add  a, a              ; *32
 169+ 7508 81               add  a, c              ; + Col C
 170+ 7509 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 171+ 750A
 172+ 750A                  ; 2. Copia gli 8 byte del bitmap dello sprite
 173+ 750A C5               push bc                ; Salva BC (contiene Row e Col)
 174+ 750B 06 08            ld   b, 8              ; 8 scanline
 175+ 750D              .line_loop:
 176+ 750D 7E               ld   a, (hl)
 177+ 750E 12               ld   (de), a
 178+ 750F 14               inc  d                 ; Prossima scanline
 179+ 7510 23               inc  hl
 180+ 7511 05               dec  b
 181+ 7512 20 F9            jr   nz, .line_loop
 182+ 7514 C1               pop  bc                ; Ripristina BC
 183+ 7515
 184+ 7515                  ; 3. Calcola l'indirizzo degli attributi dello schermo
 185+ 7515                  ; HL = $5800 + B * 32 + C
 186+ 7515 26 00            ld   h, 0
 187+ 7517 68               ld   l, b              ; HL = B (Row)
 188+ 7518 29               add  hl, hl            ; *2
 189+ 7519 29               add  hl, hl            ; *4
 190+ 751A 29               add  hl, hl            ; *8
 191+ 751B 29               add  hl, hl            ; *16
 192+ 751C 29               add  hl, hl            ; *32
 193+ 751D
 194+ 751D 79               ld   a, c              ; A = Col
 195+ 751E 85               add  a, l
 196+ 751F 6F               ld   l, a
 197+ 7520 30 01            jr   nc, .no_carry
 198+ 7522 24               inc  h
 199+ 7523              .no_carry:
 200+ 7523                  ; HL = B * 32 + C
 201+ 7523 11 00 58         ld   de, $5800
 202+ 7526 19               add  hl, de            ; HL = AttrAddr
 203+ 7527
 204+ 7527                  ; Ripristina i registri dallo stack per estrarre il colore in E
 205+ 7527                  ; Lo stack ha: HL (originale), DE (originale con colore in E), BC (originale)
 206+ 7527 C1               pop  bc                ; BC = HL originale
 207+ 7528 D1               pop  de                ; DE = DE originale (colore in E)
 208+ 7529
 209+ 7529 7B               ld   a, e              ; A = Colore
 210+ 752A 77               ld   (hl), a           ; Scrivi in memoria attributi (HL)
 211+ 752B
 212+ 752B                  ; Ripristina lo stack e i registri originari
 213+ 752B C5               push bc                ; Rimetti HL originale sulla pila
 214+ 752C E1               pop  hl                ; HL = HL originale
 215+ 752D C1               pop  bc                ; BC = BC originale
 216+ 752E C9               ret
 217+ 752F
 218+ 752F              ; -------------------------------------------------------------------
 219+ 752F              ; Ripristina la cella dello sfondo originale per cancellare l'item
 220+ 752F              ; Input: B = Row (3..18), C = Col (0..31)
