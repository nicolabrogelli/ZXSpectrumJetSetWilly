1326+ 83A1              ; DrawItemGraphic
1327+ 83A1              ;
1328+ 83A1              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1329+ 83A1              ; utilizzando una bitmap di 8 byte e un attributo colore.
1330+ 83A1              ;
1331+ 83A1              ; Input:
1332+ 83A1              ;   B = Riga attributi (3..18)
1333+ 83A1              ;   C = Colonna attributi (0..31)
1334+ 83A1              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1335+ 83A1              ;   E = Attributo colore
1336+ 83A1              ;
1337+ 83A1              ; Output:
1338+ 83A1              ;   Nessuno
1339+ 83A1              ;
1340+ 83A1              ; Registri preservati:
1341+ 83A1              ;   BC, DE, HL
1342+ 83A1              ; -------------------------------------------------------------------
1343+ 83A1              DrawItemGraphic:
1344+ 83A1
1345+ 83A1                  ; Salva i registri originali
1346+ 83A1 C5               push bc
1347+ 83A2 D5               push de
1348+ 83A3 E5               push hl
1349+ 83A4
1350+ 83A4                  ; ---------------------------------------------------------------
1351+ 83A4                  ; Calcolo indirizzo bitmap dello Spectrum
1352+ 83A4                  ;
1353+ 83A4                  ; Ogni item occupa una cella attributi (8x8 pixel).
1354+ 83A4                  ;
1355+ 83A4                  ; Formula:
1356+ 83A4                  ;   High = $40 + (Row AND $18)
1357+ 83A4                  ;   Low  = (Row AND 7) * 32 + Col
1358+ 83A4                  ;
1359+ 83A4                  ; DE conterrà l'indirizzo della prima scanline.
1360+ 83A4                  ; ---------------------------------------------------------------
1361+ 83A4
1362+ 83A4 78               ld   a, b
1363+ 83A5 E6 18            and  $18
1364+ 83A7 C6 40            add  a, $40
1365+ 83A9 57               ld   d, a              ; Byte alto indirizzo video
1366+ 83AA
1367+ 83AA 78               ld   a, b
1368+ 83AB E6 07            and  7                 ; Riga interna al blocco da 8
1369+ 83AD
1370+ 83AD 87               add  a, a              ; *2
1371+ 83AE 87               add  a, a              ; *4
1372+ 83AF 87               add  a, a              ; *8
1373+ 83B0 87               add  a, a              ; *16
1374+ 83B1 87               add  a, a              ; *32
1375+ 83B2
1376+ 83B2 81               add  a, c              ; + colonna
1377+ 83B3
1378+ 83B3 5F               ld   e, a              ; Byte basso indirizzo video
1379+ 83B4
1380+ 83B4                  ; ---------------------------------------------------------------
1381+ 83B4                  ; Disegno bitmap
1382+ 83B4                  ;
1383+ 83B4                  ; Copia 8 byte consecutivi nella memoria video.
1384+ 83B4                  ; Ogni byte rappresenta una scanline da 8 pixel.
1385+ 83B4                  ; ---------------------------------------------------------------
1386+ 83B4
1387+ 83B4 C5               push bc                ; Conserva Row e Col
1388+ 83B5
1389+ 83B5 06 08            ld   b, 8              ; Numero scanline
1390+ 83B7
1391+ 83B7              .line_loop:
1392+ 83B7
1393+ 83B7 7E               ld   a, (hl)           ; Legge scanline bitmap
1394+ 83B8 12               ld   (de), a           ; Scrive nella memoria video
1395+ 83B9
1396+ 83B9 14               inc  d                 ; Scanline successiva
1397+ 83BA 23               inc  hl                ; Byte bitmap successivo
1398+ 83BB
1399+ 83BB 05               dec  b
1400+ 83BC 20 F9            jr   nz, .line_loop
1401+ 83BE
1402+ 83BE C1               pop  bc                ; Ripristina Row e Col
1403+ 83BF
1404+ 83BF                  ; ---------------------------------------------------------------
1405+ 83BF                  ; Calcolo indirizzo attributo
1406+ 83BF                  ;
1407+ 83BF                  ; Formula:
1408+ 83BF                  ;   AttrAddr = $5800 + Row * 32 + Col
1409+ 83BF                  ;
1410+ 83BF                  ; HL conterrà l'indirizzo della cella attributi.
1411+ 83BF                  ; ---------------------------------------------------------------
1412+ 83BF
1413+ 83BF 26 00            ld   h, 0
1414+ 83C1 68               ld   l, b              ; HL = Row
1415+ 83C2
1416+ 83C2 29               add  hl, hl            ; *2
1417+ 83C3 29               add  hl, hl            ; *4
1418+ 83C4 29               add  hl, hl            ; *8
1419+ 83C5 29               add  hl, hl            ; *16
1420+ 83C6 29               add  hl, hl            ; *32
1421+ 83C7
1422+ 83C7 79               ld   a, c              ; A = Colonna
1423+ 83C8
1424+ 83C8 85               add  a, l
1425+ 83C9 6F               ld   l, a
1426+ 83CA
1427+ 83CA 30 01            jr   nc, .no_carry
1428+ 83CC 24               inc  h
1429+ 83CD
1430+ 83CD              .no_carry:
1431+ 83CD
1432+ 83CD                  ; HL = Row * 32 + Col
1433+ 83CD
1434+ 83CD 11 00 58         ld   de, $5800
1435+ 83D0 19               add  hl, de            ; HL = indirizzo attributi
1436+ 83D1
1437+ 83D1                  ; ---------------------------------------------------------------
1438+ 83D1                  ; Recupera il colore originale dallo stack.
1439+ 83D1                  ;
1440+ 83D1                  ; Layout stack:
1441+ 83D1                  ;   HL originale
1442+ 83D1                  ;   DE originale (E = colore)
1443+ 83D1                  ;   BC originale
1444+ 83D1                  ; ---------------------------------------------------------------
1445+ 83D1
1446+ 83D1 C1               pop  bc                ; Recupera HL originale
1447+ 83D2 D1               pop  de                ; Recupera DE originale
1448+ 83D3
1449+ 83D3                  ; ---------------------------------------------------------------
1450+ 83D3                  ; Scrive l'attributo colore
1451+ 83D3                  ; ---------------------------------------------------------------
1452+ 83D3
1453+ 83D3 7B               ld   a, e              ; A = colore
1454+ 83D4 77               ld   (hl), a           ; Scrive nella RAM attributi
1455+ 83D5
1456+ 83D5                  ; ---------------------------------------------------------------
1457+ 83D5                  ; Ripristina HL e BC originali
1458+ 83D5                  ; ---------------------------------------------------------------
1459+ 83D5
1460+ 83D5 C5               push bc
1461+ 83D6 E1               pop  hl                ; HL originale
1462+ 83D7
1463+ 83D7 C1               pop  bc                ; BC originale
1464+ 83D8
1465+ 83D8 C9               ret
1466+ 83D9
1467+ 83D9              ; -------------------------------------------------------------------
1468+ 83D9              ; RestoreBackgroundCell
1469+ 83D9              ;
1470+ 83D9              ; Ripristina il contenuto originale di una cella della stanza.
1471+ 83D9              ; Viene utilizzata principalmente quando un item viene raccolto:
1472+ 83D9              ; invece di lasciare un "buco", la routine ridisegna il tile
1473+ 83D9              ; originale presente nella mappa della stanza.
1474+ 83D9              ;
1475+ 83D9              ; Input:
1476+ 83D9              ;   B = Row (3..18)
1477+ 83D9              ;   C = Col (0..31)
1478+ 83D9              ;
1479+ 83D9              ; Utilizza:
1480+ 83D9              ;   room_ptr -> struttura dati della stanza corrente
1481+ 83D9              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1482+ 83D9              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1483+ 83D9              ;
1484+ 83D9              ; Tipi di cella:
1485+ 83D9              ;   0 = Background
1486+ 83D9              ;   1 = Floor
1487+ 83D9              ;   2 = Wall
1488+ 83D9              ;   3 = Nasty
1489+ 83D9              ; -------------------------------------------------------------------
1490+ 83D9              RestoreBackgroundCell:
1491+ 83D9
1492+ 83D9                  ; Salva tutti i registri utilizzati
1493+ 83D9 FD E5            push iy
1494+ 83DB C5               push bc
1495+ 83DC D5               push de
1496+ 83DD E5               push hl
1497+ 83DE DD E5            push ix
1498+ 83E0
1499+ 83E0                  ; ---------------------------------------------------------------
1500+ 83E0                  ; Conserva Row e Col in IY.
1501+ 83E0                  ;
1502+ 83E0                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1503+ 83E0                  ; BC potrebbe essere modificato.
1504+ 83E0                  ; ---------------------------------------------------------------
1505+ 83E0 C5               push bc
1506+ 83E1 FD E1            pop  iy                ; IYH = Row, IYL = Col
1507+ 83E3
1508+ 83E3                  ; ---------------------------------------------------------------
1509+ 83E3                  ; Determina quale tipo di cella è presente nella posizione
1510+ 83E3                  ; specificata.
1511+ 83E3                  ;
1512+ 83E3                  ; Input:
1513+ 83E3                  ;   B = Row
1514+ 83E3                  ;   C = Col
1515+ 83E3                  ;
1516+ 83E3                  ; Output:
1517+ 83E3                  ;   A = tipo cella
1518+ 83E3                  ; ---------------------------------------------------------------
1519+ 83E3 78               ld   a, b
1520+ 83E4
1521+ 83E4 CD DF 74         call GetCellFromUnpacked
1522+ 83E7
1523+ 83E7                  ; ---------------------------------------------------------------
1524+ 83E7                  ; Recupera il puntatore alla stanza corrente.
1525+ 83E7                  ;
1526+ 83E7                  ; DE = base della struttura stanza
1527+ 83E7                  ; ---------------------------------------------------------------
1528+ 83E7 ED 5B 99 ED      ld   de, (room_ptr)
1529+ 83EB
1530+ 83EB                  ; ---------------------------------------------------------------
1531+ 83EB                  ; Seleziona il tile corretto in base al tipo di cella.
1532+ 83EB                  ;
1533+ 83EB                  ; A = 0 -> Background
1534+ 83EB                  ; A = 1 -> Floor
1535+ 83EB                  ; A = 2 -> Wall
1536+ 83EB                  ; A = 3 -> Nasty
1537+ 83EB                  ; ---------------------------------------------------------------
1538+ 83EB
1539+ 83EB B7               or   a
1540+ 83EC 20 06            jr   nz, .not_bg
1541+ 83EE
1542+ 83EE                  ; Background
1543+ 83EE 21 A0 00         ld   hl, OFFSET_BG
1544+ 83F1 19               add  hl, de
1545+ 83F2 18 16            jr   .draw_cell
1546+ 83F4
1547+ 83F4              .not_bg:
1548+ 83F4
1549+ 83F4 3D               dec  a
1550+ 83F5 20 06            jr   nz, .not_floor
1551+ 83F7
1552+ 83F7                  ; Floor
1553+ 83F7 21 A9 00         ld   hl, OFFSET_FLOOR
1554+ 83FA 19               add  hl, de
1555+ 83FB 18 0D            jr   .draw_cell
1556+ 83FD
1557+ 83FD              .not_floor:
1558+ 83FD
1559+ 83FD 3D               dec  a
1560+ 83FE 20 06            jr   nz, .not_wall
1561+ 8400
1562+ 8400                  ; Wall
1563+ 8400 21 B2 00         ld   hl, OFFSET_WALL
1564+ 8403 19               add  hl, de
1565+ 8404 18 04            jr   .draw_cell
1566+ 8406
1567+ 8406              .not_wall:
1568+ 8406
1569+ 8406                  ; Nasty
1570+ 8406 21 BB 00         ld   hl, OFFSET_NASTY
1571+ 8409 19               add  hl, de
1572+ 840A
1573+ 840A              .draw_cell:
1574+ 840A
1575+ 840A                  ; ---------------------------------------------------------------
1576+ 840A                  ; HL punta ora alla grafica del tile da ridisegnare.
1577+ 840A                  ;
1578+ 840A                  ; Gfx_DrawTile si aspetta:
1579+ 840A                  ;   IX = puntatore tile
1580+ 840A                  ;   B  = Row
1581+ 840A                  ;   C  = Col
1582+ 840A                  ; ---------------------------------------------------------------
1583+ 840A E5               push hl
1584+ 840B DD E1            pop  ix
1585+ 840D
1586+ 840D                  ; Ripristina Row e Col salvati in IY
1587+ 840D FD E5            push iy
1588+ 840F C1               pop  bc
1589+ 8410
1590+ 8410                  ; Disegna il tile originale
1591+ 8410 CD AE 67         call Gfx_DrawTile
1592+ 8413
1593+ 8413                  ; ---------------------------------------------------------------
1594+ 8413                  ; Ripristina i registri salvati
1595+ 8413                  ; ---------------------------------------------------------------
1596+ 8413 DD E1            pop  ix
1597+ 8415 E1               pop  hl
1598+ 8416 D1               pop  de
1599+ 8417 C1               pop  bc
1600+ 8418 FD E1            pop  iy
1601+ 841A
1602+ 841A C9               ret
1603+ 841B
1604+ 841B              ; -------------------------------------------------------------------
1605+ 841B              ; CheckWillyItemCollision
1606+ 841B              ;
1607+ 841B              ; Verifica se Willy collide con un item utilizzando il controllo
1608+ 841B              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1609+ 841B              ;
1610+ 841B              ; Input:
1611+ 841B              ;   A = ItemX (colonna attributi 0..31)
1612+ 841B              ;   H = ItemY (riga attributi 3..18)
1613+ 841B              ;
1614+ 841B              ; Coordinate item:
1615+ 841B              ;   Ogni item occupa una cella da 8x8 pixel.
1616+ 841B              ;
1617+ 841B              ; Coordinate Willy:
1618+ 841B              ;   Willy occupa un rettangolo di 16x16 pixel.
1619+ 841B              ;
1620+ 841B              ; Output:
1621+ 841B              ;   Carry Set   = collisione rilevata
1622+ 841B              ;   Carry Clear = nessuna collisione
1623+ 841B              ;
1624+ 841B              ; Registri preservati:
1625+ 841B              ;   BC, DE, HL
1626+ 841B              ; -------------------------------------------------------------------
1627+ 841B              CheckWillyItemCollision:
1628+ 841B
1629+ 841B                  ; Salva i registri utilizzati
1630+ 841B C5               push bc
1631+ 841C D5               push de
1632+ 841D E5               push hl
1633+ 841E
1634+ 841E                  ; ---------------------------------------------------------------
1635+ 841E                  ; Calcola il bounding box orizzontale dell'item
1636+ 841E                  ;
1637+ 841E                  ; ItemLeft  = ItemX * 8
1638+ 841E                  ; ItemRight = ItemLeft + 7
1639+ 841E                  ;
1640+ 841E                  ; E = ItemLeft
1641+ 841E                  ; D = ItemRight
1642+ 841E                  ; ---------------------------------------------------------------
1643+ 841E 6F               ld   l, a              ; L = ItemX
1644+ 841F
1645+ 841F 7D               ld   a, l
1646+ 8420 87               add  a, a              ; *2
1647+ 8421 87               add  a, a              ; *4
1648+ 8422 87               add  a, a              ; *8
1649+ 8423
1650+ 8423 5F               ld   e, a              ; E = ItemLeft
1651+ 8424
1652+ 8424 C6 07            add  a, 7
1653+ 8426 57               ld   d, a              ; D = ItemRight
1654+ 8427
1655+ 8427                  ; ---------------------------------------------------------------
1656+ 8427                  ; Recupera la posizione corrente di Willy
1657+ 8427                  ;
1658+ 8427                  ; B = WillyY
1659+ 8427                  ; C = WillyX
1660+ 8427                  ; ---------------------------------------------------------------
1661+ 8427 ED 4B 19 EA      ld   bc, (PlayerPos)
1662+ 842B
1663+ 842B                  ; ---------------------------------------------------------------
1664+ 842B                  ; Primo test:
1665+ 842B                  ;
1666+ 842B                  ; WillyLeft <= ItemRight
1667+ 842B                  ;
1668+ 842B                  ; Se Willy è completamente a destra dell'item
1669+ 842B                  ; non può esserci collisione.
1670+ 842B                  ; ---------------------------------------------------------------
1671+ 842B 79               ld   a, c              ; A = WillyLeft
1672+ 842C
1673+ 842C BA               cp   d                 ; WillyLeft vs ItemRight
1674+ 842D
1675+ 842D 28 04            jr   z, .x_ok
1676+ 842F 38 02            jr   c, .x_ok
1677+ 8431
1678+ 8431 18 29            jr   .no_collision
1679+ 8433
1680+ 8433              .x_ok:
1681+ 8433
1682+ 8433                  ; ---------------------------------------------------------------
1683+ 8433                  ; Secondo test:
1684+ 8433                  ;
1685+ 8433                  ; WillyRight >= ItemLeft
1686+ 8433                  ;
1687+ 8433                  ; WillyRight = WillyX + 7
1688+ 8433                  ; ---------------------------------------------------------------
1689+ 8433 C6 07            add  a, 7
1690+ 8435
1691+ 8435 BB               cp   e                 ; WillyRight vs ItemLeft
1692+ 8436
1693+ 8436 28 04            jr   z, .y_check
1694+ 8438 30 02            jr   nc, .y_check
1695+ 843A
1696+ 843A 18 20            jr   .no_collision
1697+ 843C
1698+ 843C              .y_check:
1699+ 843C
1700+ 843C                  ; ---------------------------------------------------------------
1701+ 843C                  ; Recupera ItemY dal valore originale di HL
1702+ 843C                  ;
1703+ 843C                  ; H contiene la riga dell'item.
1704+ 843C                  ; ---------------------------------------------------------------
1705+ 843C E1               pop  hl
1706+ 843D E5               push hl
1707+ 843E
1708+ 843E                  ; ---------------------------------------------------------------
1709+ 843E                  ; Calcola il bounding box verticale dell'item
1710+ 843E                  ;
1711+ 843E                  ; ItemTop    = ItemY * 8
1712+ 843E                  ; ItemBottom = ItemTop + 7
1713+ 843E                  ;
1714+ 843E                  ; E = ItemTop
1715+ 843E                  ; D = ItemBottom
1716+ 843E                  ; ---------------------------------------------------------------
1717+ 843E 7C               ld   a, h
1718+ 843F
1719+ 843F 87               add  a, a              ; *2
1720+ 8440 87               add  a, a              ; *4
1721+ 8441 87               add  a, a              ; *8
1722+ 8442
1723+ 8442 5F               ld   e, a              ; ItemTop
1724+ 8443
1725+ 8443 C6 07            add  a, 7
1726+ 8445 57               ld   d, a              ; ItemBottom
1727+ 8446
1728+ 8446                  ; ---------------------------------------------------------------
1729+ 8446                  ; Primo test verticale:
1730+ 8446                  ;
1731+ 8446                  ; WillyTop <= ItemBottom
1732+ 8446                  ; ---------------------------------------------------------------
1733+ 8446 78               ld   a, b              ; WillyTop
1734+ 8447
1735+ 8447 BA               cp   d
1736+ 8448
1737+ 8448 28 04            jr   z, .y_ok
1738+ 844A 38 02            jr   c, .y_ok
1739+ 844C
1740+ 844C 18 0E            jr   .no_collision
1741+ 844E
1742+ 844E              .y_ok:
1743+ 844E
1744+ 844E                  ; ---------------------------------------------------------------
1745+ 844E                  ; Secondo test verticale:
1746+ 844E                  ;
1747+ 844E                  ; WillyBottom >= ItemTop
1748+ 844E                  ;
1749+ 844E                  ; WillyBottom = WillyY + 15
1750+ 844E                  ; ---------------------------------------------------------------
1751+ 844E C6 0F            add  a, 15
1752+ 8450
1753+ 8450 BB               cp   e
1754+ 8451
1755+ 8451 28 04            jr   z, .collision
1756+ 8453 30 02            jr   nc, .collision
1757+ 8455
1758+ 8455 18 05            jr   .no_collision
1759+ 8457
1760+ 8457              .collision:
1761+ 8457
1762+ 8457                  ; ---------------------------------------------------------------
1763+ 8457                  ; Collisione rilevata
1764+ 8457                  ; ---------------------------------------------------------------
1765+ 8457 E1               pop  hl
1766+ 8458 D1               pop  de
1767+ 8459 C1               pop  bc
1768+ 845A
1769+ 845A 37               scf                    ; Carry = 1
1770+ 845B
1771+ 845B C9               ret
1772+ 845C
1773+ 845C              .no_collision:
1774+ 845C
1775+ 845C                  ; ---------------------------------------------------------------
1776+ 845C                  ; Nessuna collisione
1777+ 845C                  ; ---------------------------------------------------------------
1778+ 845C E1               pop  hl
1779+ 845D D1               pop  de
1780+ 845E C1               pop  bc
1781+ 845F
1782+ 845F B7               or   a                 ; Carry = 0
1783+ 8460
1784+ 8460 C9               ret
1785+ 8461
1786+ 8461              ; -------------------------------------------------------------------
1787+ 8461              ; Items_CheckCollision
1788+ 8461              ;
1789+ 8461              ; Controlla se Willy entra in collisione con uno degli item
1790+ 8461              ; attivi presenti nella stanza corrente.
1791+ 8461              ;
1792+ 8461              ; Per ogni item:
1793+ 8461              ;   - verifica che appartenga alla stanza corrente
1794+ 8461              ;   - verifica che non sia già stato raccolto
1795+ 8461              ;   - esegue il test di collisione con Willy
1796+ 8461              ;
1797+ 8461              ; Se l'item viene raccolto:
1798+ 8461              ;   - imposta il flag "collected"
1799+ 8461              ;   - rimuove l'item dalla cache items_grid
1800+ 8461              ;   - incrementa il contatore degli oggetti raccolti
1801+ 8461              ;   - aggiorna l'HUD
1802+ 8461              ;   - ripristina il tile di sfondo
1803+ 8461              ;   - riproduce il suono di raccolta
1804+ 8461              ;
1805+ 8461              ; Formato record ItemsTable:
1806+ 8461              ;   +0 RoomID
1807+ 8461              ;   +1 X
1808+ 8461              ;   +2 Y
1809+ 8461              ;   +3 Color
1810+ 8461              ;   +4 Collected
1811+ 8461              ;
1812+ 8461              ; Fine tabella:
1813+ 8461              ;   RoomID = $FF
1814+ 8461              ; -------------------------------------------------------------------
1815+ 8461              Items_CheckCollision:
1816+ 8461
1817+ 8461                  ; Salva i registri utilizzati
1818+ 8461 E5               push hl
1819+ 8462 D5               push de
1820+ 8463 C5               push bc
1821+ 8464
1822+ 8464                  ; Inizio scansione della tabella degli item
1823+ 8464 21 B1 7D         ld   hl, ItemsTable
1824+ 8467
1825+ 8467              .loop:
1826+ 8467
1827+ 8467                  ; ---------------------------------------------------------------
1828+ 8467                  ; Legge il Room ID dell'item corrente
1829+ 8467                  ; ---------------------------------------------------------------
1830+ 8467 7E               ld   a, (hl)
1831+ 8468
1832+ 8468                  ; $FF indica fine tabella
1833+ 8468 FE FF            cp   $FF
1834+ 846A 28 58            jr   z, .done
1835+ 846C
1836+ 846C                  ; ---------------------------------------------------------------
1837+ 846C                  ; Verifica se l'item appartiene alla stanza corrente
1838+ 846C                  ; ---------------------------------------------------------------
1839+ 846C 57               ld   d, a              ; D = RoomID item
1840+ 846D
1841+ 846D 3A 3F ED         ld   a, (current_room)
1842+ 8470 BA               cp   d
1843+ 8471
1844+ 8471                  ; Se appartiene a un'altra stanza salta il record
1845+ 8471 20 4A            jr   nz, .next_item
1846+ 8473
1847+ 8473                  ; ---------------------------------------------------------------
1848+ 8473                  ; Legge coordinate e stato dell'item
1849+ 8473                  ; ---------------------------------------------------------------
1850+ 8473
1851+ 8473 23               inc  hl
1852+ 8474 4E               ld   c, (hl)           ; C = X
1853+ 8475
1854+ 8475 23               inc  hl
1855+ 8476 46               ld   b, (hl)           ; B = Y
1856+ 8477
1857+ 8477 23               inc  hl                ; salta Color
1858+ 8478
1859+ 8478 23               inc  hl                ; punta a Collected
1860+ 8479
1861+ 8479 7E               ld   a, (hl)
1862+ 847A
1863+ 847A                  ; ---------------------------------------------------------------
1864+ 847A                  ; Item già raccolto?
1865+ 847A                  ; ---------------------------------------------------------------
1866+ 847A B7               or   a
1867+ 847B 20 44            jr   nz, .next_no_inc
1868+ 847D
1869+ 847D                  ; ---------------------------------------------------------------
1870+ 847D                  ; Test collisione Willy ↔ Item
1871+ 847D                  ;
1872+ 847D                  ; Input richiesto:
1873+ 847D                  ;   A = ItemX
1874+ 847D                  ;   H = ItemY
1875+ 847D                  ; ---------------------------------------------------------------
1876+ 847D 79               ld   a, c
1877+ 847E
1878+ 847E E5               push hl                ; salva puntatore al flag Collected
1879+ 847F
1880+ 847F 60               ld   h, b
1881+ 8480
1882+ 8480 CD 1B 84         call CheckWillyItemCollision
1883+ 8483
1884+ 8483 E1               pop  hl
1885+ 8484
1886+ 8484                  ; Nessuna collisione
1887+ 8484 30 3B            jr   nc, .next_no_inc
1888+ 8486
1889+ 8486                  ; ===============================================================
1890+ 8486                  ; ITEM RACCOLTO
1891+ 8486                  ; ===============================================================
1892+ 8486
1893+ 8486                  ; ---------------------------------------------------------------
1894+ 8486                  ; Marca l'item come raccolto
1895+ 8486                  ; ---------------------------------------------------------------
1896+ 8486 36 01            ld   (hl), 1
1897+ 8488
1898+ 8488                  ; ---------------------------------------------------------------
1899+ 8488                  ; Rimuove l'item dalla cache items_grid
1900+ 8488                  ;
1901+ 8488                  ; Calcolo:
1902+ 8488                  ;   offset = Row * 32 + Col
1903+ 8488                  ; ---------------------------------------------------------------
1904+ 8488 E5               push hl
1905+ 8489 D5               push de
1906+ 848A
1907+ 848A 26 00            ld   h, 0
1908+ 848C 68               ld   l, b              ; HL = Row
1909+ 848D
1910+ 848D 29               add  hl, hl            ; *2
1911+ 848E 29               add  hl, hl            ; *4
1912+ 848F 29               add  hl, hl            ; *8
1913+ 8490 29               add  hl, hl            ; *16
1914+ 8491 29               add  hl, hl            ; *32
1915+ 8492
1916+ 8492 59               ld   e, c
1917+ 8493 16 00            ld   d, 0
1918+ 8495
1919+ 8495 19               add  hl, de            ; Row*32 + Col
1920+ 8496
1921+ 8496 11 19 E8         ld   de, items_grid
1922+ 8499 19               add  hl, de
1923+ 849A
1924+ 849A                  ; La cella non contiene più un item
1925+ 849A 36 00            ld   (hl), 0
1926+ 849C
1927+ 849C D1               pop  de
1928+ 849D E1               pop  hl
1929+ 849E
1930+ 849E                  ; ---------------------------------------------------------------
1931+ 849E                  ; Conserva il puntatore all'entry corrente
1932+ 849E                  ; poiché le routine successive possono alterare HL.
1933+ 849E                  ; ---------------------------------------------------------------
1934+ 849E E5               push hl
1935+ 849F
1936+ 849F                  ; ---------------------------------------------------------------
1937+ 849F                  ; Aggiorna il numero di oggetti raccolti
1938+ 849F                  ; ---------------------------------------------------------------
1939+ 849F 3A 23 EA         ld   a, (items_collected)
1940+ 84A2
1941+ 84A2 3C               inc  a
1942+ 84A3
1943+ 84A3 32 23 EA         ld   (items_collected), a
1944+ 84A6
1945+ 84A6 FE 4C            cp   TOTAL_ITEMS
1946+ 84A8 38 07            jr   c, .objective_not_completed
1947+ 84AA F5               push af
1948+ 84AB 3E 01            ld   a, 1
1949+ 84AD 32 2B EE         ld   (game_objective_completed), a
1950+ 84B0 F1               pop  af
1951+ 84B1              .objective_not_completed:
1952+ 84B1
1953+ 84B1                  ; ---------------------------------------------------------------
1954+ 84B1                  ; Aggiorna il contatore visualizzato a schermo
1955+ 84B1                  ; ---------------------------------------------------------------
1956+ 84B1 CD D3 65         call Gfx_UpdateItemsCollectedDisplay
1957+ 84B4
1958+ 84B4                  ; ---------------------------------------------------------------
1959+ 84B4                  ; Ripristina il tile originale della stanza
1960+ 84B4                  ; eliminando la grafica dell'item.
1961+ 84B4                  ;
1962+ 84B4                  ; Input:
1963+ 84B4                  ;   B = Row
1964+ 84B4                  ;   C = Col
1965+ 84B4                  ; ---------------------------------------------------------------
1966+ 84B4 CD D9 83         call RestoreBackgroundCell
1967+ 84B7
1968+ 84B7                  ; ---------------------------------------------------------------
1969+ 84B7                  ; Riproduce il suono di raccolta
1970+ 84B7                  ; ---------------------------------------------------------------
1971+ 84B7 CD 33 85         call Audio_PlayCollectSound
1972+ 84BA
1973+ 84BA                  ; Ripristina il puntatore alla tabella
1974+ 84BA E1               pop  hl
1975+ 84BB
1976+ 84BB                  ; Continua con il record successivo
1977+ 84BB 18 04            jr   .next_no_inc
1978+ 84BD
1979+ 84BD              .next_item:
1980+ 84BD
1981+ 84BD                  ; ---------------------------------------------------------------
1982+ 84BD                  ; Salta i campi del record:
1983+ 84BD                  ;   X
1984+ 84BD                  ;   Y
1985+ 84BD                  ;   Color
1986+ 84BD                  ;   Collected
1987+ 84BD                  ; ---------------------------------------------------------------
1988+ 84BD 23               inc  hl
1989+ 84BE 23               inc  hl
1990+ 84BF 23               inc  hl
1991+ 84C0 23               inc  hl
1992+ 84C1
1993+ 84C1              .next_no_inc:
1994+ 84C1
1995+ 84C1                  ; ---------------------------------------------------------------
1996+ 84C1                  ; Avanza al record successivo.
1997+ 84C1                  ;
1998+ 84C1                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1999+ 84C1                  ; ---------------------------------------------------------------
2000+ 84C1 23               inc  hl
2001+ 84C2
2002+ 84C2 18 A3            jr   .loop
2003+ 84C4
2004+ 84C4              .done:
2005+ 84C4
2006+ 84C4                  ; Ripristina i registri
2007+ 84C4 C1               pop  bc
2008+ 84C5 D1               pop  de
2009+ 84C6 E1               pop  hl
2010+ 84C7
2011+ 84C7 C9               ret
2012+ 84C8
2013+ 84C8
2014+ 84C8
2015+ 84C8              ; -------------------------------------------------------------------
2016+ 84C8              ; CheckActiveItemAtCell
2017+ 84C8              ;
2018+ 84C8              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2019+ 84C8              ; nella cella specificata della griglia items_grid.
2020+ 84C8              ;
2021+ 84C8              ; Questa routine usa una lookup diretta su una mappa 32x16,
2022+ 84C8              ; evitando la scansione della ItemsTable.
2023+ 84C8              ;
2024+ 84C8              ; Input:
2025+ 84C8              ;   B = Colonna (0..31)
2026+ 84C8              ;   C = Riga (0..15)
2027+ 84C8              ;
2028+ 84C8              ; Output:
2029+ 84C8              ;   Carry Set   = item presente nella cella
2030+ 84C8              ;   Carry Clear = nessun item
2031+ 84C8              ;
2032+ 84C8              ; Nota:
2033+ 84C8              ;   HL NON è restituito valido (commento originale non corretto:
2034+ 84C8              ;   la routine non punta a ItemsTable).
2035+ 84C8              ; -------------------------------------------------------------------
2036+ 84C8              CheckActiveItemAtCell:
2037+ 84C8
2038+ 84C8                  ; Salva registri usati
2039+ 84C8 D5               push de
2040+ 84C9 E5               push hl
2041+ 84CA
2042+ 84CA                  ; ---------------------------------------------------------------
2043+ 84CA                  ; Calcolo indice lineare nella griglia 32x16:
2044+ 84CA                  ;
2045+ 84CA                  ; offset = Row * 32 + Col
2046+ 84CA                  ; ---------------------------------------------------------------
2047+ 84CA 26 00            ld   h, 0
2048+ 84CC 69               ld   l, c              ; HL = Row
2049+ 84CD
2050+ 84CD 29               add  hl, hl            ; *2
2051+ 84CE 29               add  hl, hl            ; *4
2052+ 84CF 29               add  hl, hl            ; *8
2053+ 84D0 29               add  hl, hl            ; *16
2054+ 84D1 29               add  hl, hl            ; *32
2055+ 84D2
2056+ 84D2                  ; Aggiunge la colonna
2057+ 84D2 58               ld   e, b
2058+ 84D3 16 00            ld   d, 0
2059+ 84D5 19               add  hl, de            ; HL = Row*32 + Col
2060+ 84D6
2061+ 84D6                  ; ---------------------------------------------------------------
2062+ 84D6                  ; Accesso alla griglia degli item attivi
2063+ 84D6                  ; ---------------------------------------------------------------
2064+ 84D6 11 19 E8         ld   de, items_grid
2065+ 84D9 19               add  hl, de            ; HL = address cella
2066+ 84DA
2067+ 84DA                  ; ---------------------------------------------------------------
2068+ 84DA                  ; Controllo presenza item
2069+ 84DA                  ;
2070+ 84DA                  ; items_grid contiene:
2071+ 84DA                  ;   0 = nessun item
2072+ 84DA                  ;   >0 = item attivo (colore o flag)
2073+ 84DA                  ; ---------------------------------------------------------------
2074+ 84DA 7E               ld   a, (hl)
2075+ 84DB B7               or   a
2076+ 84DC 28 04            jr   z, .not_active
2077+ 84DE
2078+ 84DE                  ; ---------------------------------------------------------------
2079+ 84DE                  ; Item trovato
2080+ 84DE                  ; ---------------------------------------------------------------
2081+ 84DE E1               pop  hl
2082+ 84DF D1               pop  de
2083+ 84E0
2084+ 84E0 37               scf                    ; Carry = 1
2085+ 84E1 C9               ret
2086+ 84E2
2087+ 84E2              .not_active:
2088+ 84E2
2089+ 84E2                  ; ---------------------------------------------------------------
2090+ 84E2                  ; Nessun item nella cella
2091+ 84E2                  ; ---------------------------------------------------------------
2092+ 84E2 E1               pop  hl
2093+ 84E3 D1               pop  de
2094+ 84E4
2095+ 84E4 B7               or   a                 ; Carry = 0
2096+ 84E5 C9               ret
2097+ 84E6
