 547  897C              ; ResetFullGameState
 548  897C              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 549  897C              ; per l'avvio di una nuova partita dopo il Game Over.
 550  897C              ; -------------------------------------------------------------------
 551  897C              ResetFullGameState:
 552  897C                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 553  897C AF               xor  a
 554  897D D3 FE            out  ($fe), a              ; Bordo a nero
 555  897F 21 8D 5C         ld   hl, ATTR_P
 556  8982 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 557  8983 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 558  8986 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 559  8988 3E 07            ld   a, $07
