1055+ 6F63 4F               ld   c, a              ; C = limit_right (exclusive)
1056+ 6F64
1057+ 6F64 7B               ld   a, e              ; A = Col
1058+ 6F65 B8               cp   b
1059+ 6F66 38 34            jr   c, .check_platform_case ; Col < ramp_col
1060+ 6F68 B9               cp   c
1061+ 6F69 30 31            jr   nc, .check_platform_case ; Col >= limit_right
1062+ 6F6B
1063+ 6F6B                  ; Calcola B = Col - ramp_col
1064+ 6F6B 7B               ld   a, e
1065+ 6F6C 90               sub  b
1066+ 6F6D 47               ld   b, a              ; B = offset (0..ramp_len-1)
1067+ 6F6E
1068+ 6F6E                  ; SlopeRow = ramp_row - B
1069+ 6F6E 3A 53 E9         ld   a, (ramp_row)
1070+ 6F71 90               sub  b
1071+ 6F72 47               ld   b, a              ; B = SlopeRow
1072+ 6F73 18 1F            jr   .check_row_match
1073+ 6F75
1074+ 6F75              .range_left:
1075+ 6F75                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
1076+ 6F75 21 52 E9         ld   hl, ramp_len
