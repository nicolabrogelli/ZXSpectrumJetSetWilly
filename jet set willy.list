  68+ 7420 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7424 19 13 0C 06
  68+ 7428 0C 13 19 20
