1079+ 8658
1080+ 8658 C9               ret
1081+ 8659
1082+ 8659              ; -------------------------------------------------------------------
1083+ 8659              ; Items_DrawRoom
1084+ 8659              ;
1085+ 8659              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1086+ 8659              ;
1087+ 8659              ; Operazioni eseguite:
1088+ 8659              ;   1. Azzera la griglia items_grid.
1089+ 8659              ;   2. Svuota la cache degli oggetti attivi.
1090+ 8659              ;   3. Scansiona ItemsTable.
1091+ 8659              ;   4. Per ogni item della stanza corrente:
1092+ 8659              ;        - verifica se è già stato raccolto
1093+ 8659              ;        - disegna la grafica
1094+ 8659              ;        - aggiorna items_grid
1095+ 8659              ;        - memorizza l'item nella cache current_room_items
1096+ 8659              ;   5. Aggiorna num_room_items.
1097+ 8659              ;
1098+ 8659              ; Record ItemsTable:
1099+ 8659              ;   +0  Room ID
1100+ 8659              ;   +1  X (colonna)
1101+ 8659              ;   +2  Y (riga)
1102+ 8659              ;   +3  Colore
1103+ 8659              ;   +4  Collected flag
1104+ 8659              ;
1105+ 8659              ; Cache current_room_items:
1106+ 8659              ;   +0  Colonna
1107+ 8659              ;   +1  Riga
1108+ 8659              ;   +2  Colore
1109+ 8659              ;   +3  Collected flag ptr (Low)
1110+ 8659              ;   +4  Collected flag ptr (High)
1111+ 8659              ;
1112+ 8659              ; Ogni record cache occupa 5 byte.
1113+ 8659              ; -------------------------------------------------------------------
1114+ 8659              ; ResetItemsTable
1115+ 8659              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1116+ 8659              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1117+ 8659              ; -------------------------------------------------------------------
1118+ 8659              ResetItemsTable:
1119+ 8659 21 FD 80         ld   hl, ItemsTable
1120+ 865C              .reset_loop:
1121+ 865C 7E               ld   a, (hl)
1122+ 865D FE FF            cp   $FF
1123+ 865F C8               ret  z
1124+ 8660 23               inc  hl                        ; +1 (X)
1125+ 8661 23               inc  hl                        ; +2 (Y)
1126+ 8662 23               inc  hl                        ; +3 (Color)
1127+ 8663 23               inc  hl                        ; +4 (Collected flag)
1128+ 8664 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1129+ 8666 23               inc  hl                        ; Prossimo record
1130+ 8667 18 F3            jr   .reset_loop
1131+ 8669
1132+ 8669              ; -------------------------------------------------------------------
1133+ 8669              Items_DrawRoom:
1134+ 8669
1135+ 8669                  ; Salva tutti i registri utilizzati
1136+ 8669 E5               push hl
1137+ 866A D5               push de
1138+ 866B C5               push bc
1139+ 866C DD E5            push ix
1140+ 866E FD E5            push iy
1141+ 8670
1142+ 8670                  ; ---------------------------------------------------------------
1143+ 8670                  ; Azzera items_grid (32 x 16 = 512 byte)
1144+ 8670                  ; ---------------------------------------------------------------
1145+ 8670 21 44 F6         ld   hl, items_grid
1146+ 8673 11 45 F6         ld   de, items_grid + 1
1147+ 8676 36 00            ld   (hl), 0
1148+ 8678 01 FF 01         ld   bc, 511
1149+ 867B ED B0            ldir
1150+ 867D
1151+ 867D                  ; ---------------------------------------------------------------
1152+ 867D                  ; Nessun item attivo nella stanza
1153+ 867D                  ; ---------------------------------------------------------------
1154+ 867D AF               xor  a
1155+ 867E 32 C3 FB         ld   (num_room_items), a
1156+ 8681
1157+ 8681                  ; IY punta alla cache degli item attivi
1158+ 8681 FD 21 73 FB      ld   iy, current_room_items
1159+ 8685
1160+ 8685                  ; ---------------------------------------------------------------
1161+ 8685                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1162+ 8685                  ; alla stanza corrente.
1163+ 8685                  ;
1164+ 8685                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1165+ 8685                  ; ---------------------------------------------------------------
1166+ 8685 2A C4 FB         ld   hl, (room_ptr)
1167+ 8688 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1168+ 868B 19               add  hl, de
1169+ 868C
1170+ 868C E5               push hl
1171+ 868D DD E1            pop  ix                ; IX = bitmap item
1172+ 868F
1173+ 868F                  ; ---------------------------------------------------------------
1174+ 868F                  ; Inizio scansione della tabella degli item
1175+ 868F                  ; ---------------------------------------------------------------
1176+ 868F 21 FD 80         ld   hl, ItemsTable
1177+ 8692
1178+ 8692              .loop:
1179+ 8692
1180+ 8692                  ; ---------------------------------------------------------------
1181+ 8692                  ; Legge il Room ID del record corrente
1182+ 8692                  ; ---------------------------------------------------------------
1183+ 8692 7E               ld   a, (hl)
1184+ 8693
1185+ 8693                  ; $FF indica fine tabella
1186+ 8693 FE FF            cp   $FF
1187+ 8695 28 53            jr   z, .done
1188+ 8697
1189+ 8697                  ; ---------------------------------------------------------------
1190+ 8697                  ; Verifica se l'item appartiene alla stanza corrente
1191+ 8697                  ; ---------------------------------------------------------------
1192+ 8697 57               ld   d, a
1193+ 8698
1194+ 8698 3A 6A FB         ld   a, (current_room)
1195+ 869B BA               cp   d
1196+ 869C 20 45            jr   nz, .next_item
1197+ 869E
1198+ 869E                  ; ---------------------------------------------------------------
1199+ 869E                  ; Legge i dati dell'item
1200+ 869E                  ; ---------------------------------------------------------------
1201+ 869E
1202+ 869E 23               inc  hl
1203+ 869F 4E               ld   c, (hl)           ; X (colonna)
1204+ 86A0
1205+ 86A0 23               inc  hl
1206+ 86A1 46               ld   b, (hl)           ; Y (riga)
1207+ 86A2
1208+ 86A2 23               inc  hl
1209+ 86A3 5E               ld   e, (hl)           ; Colore
1210+ 86A4
1211+ 86A4 23               inc  hl
1212+ 86A5 7E               ld   a, (hl)           ; Collected flag
1213+ 86A6
1214+ 86A6                  ; Se diverso da zero l'item è già stato raccolto
1215+ 86A6 B7               or   a
1216+ 86A7 20 3E            jr   nz, .next_no_inc
1217+ 86A9
1218+ 86A9                  ; ---------------------------------------------------------------
1219+ 86A9                  ; Disegna l'item sullo schermo
1220+ 86A9                  ;
1221+ 86A9                  ; B = Row
1222+ 86A9                  ; C = Column
1223+ 86A9                  ; HL = bitmap pointer
1224+ 86A9                  ; E = Color
1225+ 86A9                  ; ---------------------------------------------------------------
1226+ 86A9 E5               push hl
1227+ 86AA
1228+ 86AA DD E5            push ix
1229+ 86AC E1               pop  hl
1230+ 86AD
1231+ 86AD CD F2 86         call DrawItemGraphic
1232+ 86B0
1233+ 86B0 E1               pop  hl                ; ritorna al flag collected
1234+ 86B1
1235+ 86B1                  ; ---------------------------------------------------------------
1236+ 86B1                  ; Aggiorna items_grid
1237+ 86B1                  ;
1238+ 86B1                  ; Calcolo:
1239+ 86B1                  ;   offset = Row * 32 + Col
1240+ 86B1                  ; ---------------------------------------------------------------
1241+ 86B1 E5               push hl
1242+ 86B2 D5               push de
1243+ 86B3
1244+ 86B3 26 00            ld   h, 0
1245+ 86B5 68               ld   l, b              ; HL = Row
1246+ 86B6
1247+ 86B6 29               add  hl, hl            ; *2
1248+ 86B7 29               add  hl, hl            ; *4
1249+ 86B8 29               add  hl, hl            ; *8
1250+ 86B9 29               add  hl, hl            ; *16
1251+ 86BA 29               add  hl, hl            ; *32
1252+ 86BB
1253+ 86BB 16 00            ld   d, 0
1254+ 86BD 59               ld   e, c              ; DE = Col
1255+ 86BE
1256+ 86BE 19               add  hl, de            ; Row*32 + Col
1257+ 86BF
1258+ 86BF 11 44 F6         ld   de, items_grid
1259+ 86C2 19               add  hl, de            ; puntatore nella griglia
1260+ 86C3
1261+ 86C3 D1               pop  de                ; ripristina colore
1262+ 86C4
1263+ 86C4 73               ld   (hl), e           ; salva colore cella
1264+ 86C5
1265+ 86C5 E1               pop  hl
1266+ 86C6
1267+ 86C6                  ; ---------------------------------------------------------------
1268+ 86C6                  ; Salva l'item nella cache della stanza
1269+ 86C6                  ;
1270+ 86C6                  ; Questo evita di dover scansionare tutta ItemsTable
1271+ 86C6                  ; durante il controllo delle collisioni.
1272+ 86C6                  ; ---------------------------------------------------------------
1273+ 86C6
1274+ 86C6 FD 71 00         ld   (iy+0), c         ; Colonna
1275+ 86C9 FD 70 01         ld   (iy+1), b         ; Riga
1276+ 86CC FD 73 02         ld   (iy+2), e         ; Colore
1277+ 86CF
1278+ 86CF                  ; Salva il puntatore al flag "collected"
1279+ 86CF FD 75 03         ld   (iy+3), l         ; Low byte
1280+ 86D2 FD 74 04         ld   (iy+4), h         ; High byte
1281+ 86D5
1282+ 86D5                  ; Passa al record successivo della cache
1283+ 86D5 01 05 00         ld   bc, 5
1284+ 86D8 FD 09            add  iy, bc
1285+ 86DA
1286+ 86DA                  ; Incrementa il numero di item attivi
1287+ 86DA 3A C3 FB         ld   a, (num_room_items)
1288+ 86DD 3C               inc  a
1289+ 86DE 32 C3 FB         ld   (num_room_items), a
1290+ 86E1
1291+ 86E1 18 04            jr   .next_no_inc
1292+ 86E3
1293+ 86E3              .next_item:
1294+ 86E3
1295+ 86E3                  ; ---------------------------------------------------------------
1296+ 86E3                  ; L'item non appartiene alla stanza corrente.
1297+ 86E3                  ; Salta i campi del record:
1298+ 86E3                  ;   X
1299+ 86E3                  ;   Y
1300+ 86E3                  ;   Color
1301+ 86E3                  ;   Collected
1302+ 86E3                  ; ---------------------------------------------------------------
1303+ 86E3 23               inc  hl
1304+ 86E4 23               inc  hl
1305+ 86E5 23               inc  hl
1306+ 86E6 23               inc  hl
1307+ 86E7
1308+ 86E7              .next_no_inc:
1309+ 86E7
1310+ 86E7                  ; ---------------------------------------------------------------
1311+ 86E7                  ; Avanza al record successivo
1312+ 86E7                  ; (prossimo Room ID)
1313+ 86E7                  ; ---------------------------------------------------------------
1314+ 86E7 23               inc  hl
1315+ 86E8 18 A8            jr   .loop
1316+ 86EA
1317+ 86EA              .done:
1318+ 86EA
1319+ 86EA                  ; Ripristina i registri
1320+ 86EA FD E1            pop  iy
1321+ 86EC DD E1            pop  ix
1322+ 86EE D1               pop  de
1323+ 86EF C1               pop  bc
1324+ 86F0 E1               pop  hl
1325+ 86F1
1326+ 86F1 C9               ret
1327+ 86F2
1328+ 86F2              ; -------------------------------------------------------------------
1329+ 86F2              ; DrawItemGraphic
1330+ 86F2              ;
1331+ 86F2              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1332+ 86F2              ; utilizzando una bitmap di 8 byte e un attributo colore.
1333+ 86F2              ;
1334+ 86F2              ; Input:
1335+ 86F2              ;   B = Riga attributi (3..18)
1336+ 86F2              ;   C = Colonna attributi (0..31)
1337+ 86F2              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1338+ 86F2              ;   E = Attributo colore
1339+ 86F2              ;
1340+ 86F2              ; Output:
1341+ 86F2              ;   Nessuno
1342+ 86F2              ;
1343+ 86F2              ; Registri preservati:
1344+ 86F2              ;   BC, DE, HL
1345+ 86F2              ; -------------------------------------------------------------------
1346+ 86F2              DrawItemGraphic:
1347+ 86F2
1348+ 86F2                  ; Salva i registri originali
1349+ 86F2 C5               push bc
1350+ 86F3 D5               push de
1351+ 86F4 E5               push hl
1352+ 86F5
1353+ 86F5                  ; ---------------------------------------------------------------
1354+ 86F5                  ; Calcolo indirizzo bitmap dello Spectrum
1355+ 86F5                  ;
1356+ 86F5                  ; Ogni item occupa una cella attributi (8x8 pixel).
1357+ 86F5                  ;
1358+ 86F5                  ; Formula:
1359+ 86F5                  ;   High = $40 + (Row AND $18)
1360+ 86F5                  ;   Low  = (Row AND 7) * 32 + Col
1361+ 86F5                  ;
1362+ 86F5                  ; DE conterrà l'indirizzo della prima scanline.
1363+ 86F5                  ; ---------------------------------------------------------------
1364+ 86F5
1365+ 86F5 78               ld   a, b
1366+ 86F6 E6 18            and  $18
1367+ 86F8 C6 40            add  a, $40
1368+ 86FA 57               ld   d, a              ; Byte alto indirizzo video
1369+ 86FB
1370+ 86FB 78               ld   a, b
1371+ 86FC E6 07            and  7                 ; Riga interna al blocco da 8
1372+ 86FE
1373+ 86FE 87               add  a, a              ; *2
1374+ 86FF 87               add  a, a              ; *4
1375+ 8700 87               add  a, a              ; *8
1376+ 8701 87               add  a, a              ; *16
1377+ 8702 87               add  a, a              ; *32
1378+ 8703
1379+ 8703 81               add  a, c              ; + colonna
1380+ 8704
1381+ 8704 5F               ld   e, a              ; Byte basso indirizzo video
1382+ 8705
1383+ 8705                  ; ---------------------------------------------------------------
1384+ 8705                  ; Disegno bitmap
1385+ 8705                  ;
1386+ 8705                  ; Copia 8 byte consecutivi nella memoria video.
1387+ 8705                  ; Ogni byte rappresenta una scanline da 8 pixel.
1388+ 8705                  ; ---------------------------------------------------------------
1389+ 8705
1390+ 8705 C5               push bc                ; Conserva Row e Col
1391+ 8706
1392+ 8706 06 08            ld   b, 8              ; Numero scanline
1393+ 8708
1394+ 8708              .line_loop:
1395+ 8708
1396+ 8708 7E               ld   a, (hl)           ; Legge scanline bitmap
1397+ 8709 12               ld   (de), a           ; Scrive nella memoria video
1398+ 870A
1399+ 870A 14               inc  d                 ; Scanline successiva
1400+ 870B 23               inc  hl                ; Byte bitmap successivo
1401+ 870C
1402+ 870C 05               dec  b
1403+ 870D 20 F9            jr   nz, .line_loop
1404+ 870F
1405+ 870F C1               pop  bc                ; Ripristina Row e Col
1406+ 8710
1407+ 8710                  ; ---------------------------------------------------------------
1408+ 8710                  ; Calcolo indirizzo attributo
1409+ 8710                  ;
1410+ 8710                  ; Formula:
1411+ 8710                  ;   AttrAddr = $5800 + Row * 32 + Col
1412+ 8710                  ;
1413+ 8710                  ; HL conterrà l'indirizzo della cella attributi.
1414+ 8710                  ; ---------------------------------------------------------------
1415+ 8710
1416+ 8710 26 00            ld   h, 0
1417+ 8712 68               ld   l, b              ; HL = Row
1418+ 8713
1419+ 8713 29               add  hl, hl            ; *2
1420+ 8714 29               add  hl, hl            ; *4
1421+ 8715 29               add  hl, hl            ; *8
1422+ 8716 29               add  hl, hl            ; *16
1423+ 8717 29               add  hl, hl            ; *32
1424+ 8718
1425+ 8718 79               ld   a, c              ; A = Colonna
1426+ 8719
1427+ 8719 85               add  a, l
1428+ 871A 6F               ld   l, a
1429+ 871B
1430+ 871B 30 01            jr   nc, .no_carry
1431+ 871D 24               inc  h
1432+ 871E
1433+ 871E              .no_carry:
1434+ 871E
1435+ 871E                  ; HL = Row * 32 + Col
1436+ 871E
1437+ 871E 11 00 58         ld   de, $5800
1438+ 8721 19               add  hl, de            ; HL = indirizzo attributi
1439+ 8722
1440+ 8722                  ; ---------------------------------------------------------------
1441+ 8722                  ; Recupera il colore originale dallo stack.
1442+ 8722                  ;
1443+ 8722                  ; Layout stack:
1444+ 8722                  ;   HL originale
1445+ 8722                  ;   DE originale (E = colore)
1446+ 8722                  ;   BC originale
1447+ 8722                  ; ---------------------------------------------------------------
1448+ 8722
1449+ 8722 C1               pop  bc                ; Recupera HL originale
1450+ 8723 D1               pop  de                ; Recupera DE originale
1451+ 8724
1452+ 8724                  ; ---------------------------------------------------------------
1453+ 8724                  ; Scrive l'attributo colore
1454+ 8724                  ; ---------------------------------------------------------------
1455+ 8724
1456+ 8724 7B               ld   a, e              ; A = colore
1457+ 8725 77               ld   (hl), a           ; Scrive nella RAM attributi
1458+ 8726
1459+ 8726                  ; ---------------------------------------------------------------
1460+ 8726                  ; Ripristina HL e BC originali
1461+ 8726                  ; ---------------------------------------------------------------
1462+ 8726
1463+ 8726 C5               push bc
1464+ 8727 E1               pop  hl                ; HL originale
1465+ 8728
1466+ 8728 C1               pop  bc                ; BC originale
1467+ 8729
1468+ 8729 C9               ret
1469+ 872A
1470+ 872A              ; -------------------------------------------------------------------
1471+ 872A              ; RestoreBackgroundCell
1472+ 872A              ;
1473+ 872A              ; Ripristina il contenuto originale di una cella della stanza.
1474+ 872A              ; Viene utilizzata principalmente quando un item viene raccolto:
1475+ 872A              ; invece di lasciare un "buco", la routine ridisegna il tile
1476+ 872A              ; originale presente nella mappa della stanza.
1477+ 872A              ;
1478+ 872A              ; Input:
1479+ 872A              ;   B = Row (3..18)
1480+ 872A              ;   C = Col (0..31)
1481+ 872A              ;
1482+ 872A              ; Utilizza:
1483+ 872A              ;   room_ptr -> struttura dati della stanza corrente
1484+ 872A              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1485+ 872A              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1486+ 872A              ;
1487+ 872A              ; Tipi di cella:
1488+ 872A              ;   0 = Background
1489+ 872A              ;   1 = Floor
1490+ 872A              ;   2 = Wall
1491+ 872A              ;   3 = Nasty
1492+ 872A              ; -------------------------------------------------------------------
1493+ 872A              RestoreBackgroundCell:
1494+ 872A
1495+ 872A                  ; Salva tutti i registri utilizzati
1496+ 872A FD E5            push iy
1497+ 872C C5               push bc
1498+ 872D D5               push de
1499+ 872E E5               push hl
1500+ 872F DD E5            push ix
1501+ 8731
1502+ 8731                  ; ---------------------------------------------------------------
1503+ 8731                  ; Conserva Row e Col in IY.
1504+ 8731                  ;
1505+ 8731                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1506+ 8731                  ; BC potrebbe essere modificato.
1507+ 8731                  ; ---------------------------------------------------------------
1508+ 8731 C5               push bc
1509+ 8732 FD E1            pop  iy                ; IYH = Row, IYL = Col
1510+ 8734
1511+ 8734                  ; ---------------------------------------------------------------
1512+ 8734                  ; Determina quale tipo di cella è presente nella posizione
1513+ 8734                  ; specificata.
1514+ 8734                  ;
1515+ 8734                  ; Input:
1516+ 8734                  ;   B = Row
1517+ 8734                  ;   C = Col
1518+ 8734                  ;
1519+ 8734                  ; Output:
1520+ 8734                  ;   A = tipo cella
1521+ 8734                  ; ---------------------------------------------------------------
1522+ 8734 78               ld   a, b
1523+ 8735
1524+ 8735 CD 90 77         call GetCellFromUnpacked
1525+ 8738
1526+ 8738                  ; ---------------------------------------------------------------
1527+ 8738                  ; Recupera il puntatore alla stanza corrente.
1528+ 8738                  ;
1529+ 8738                  ; DE = base della struttura stanza
1530+ 8738                  ; ---------------------------------------------------------------
1531+ 8738 ED 5B C4 FB      ld   de, (room_ptr)
1532+ 873C
1533+ 873C                  ; ---------------------------------------------------------------
1534+ 873C                  ; Seleziona il tile corretto in base al tipo di cella.
1535+ 873C                  ;
1536+ 873C                  ; A = 0 -> Background
1537+ 873C                  ; A = 1 -> Floor
1538+ 873C                  ; A = 2 -> Wall
1539+ 873C                  ; A = 3 -> Nasty
1540+ 873C                  ; ---------------------------------------------------------------
1541+ 873C
1542+ 873C B7               or   a
1543+ 873D 20 06            jr   nz, .not_bg
1544+ 873F
1545+ 873F                  ; Background
1546+ 873F 21 A0 00         ld   hl, OFFSET_BG
1547+ 8742 19               add  hl, de
1548+ 8743 18 16            jr   .draw_cell
1549+ 8745
1550+ 8745              .not_bg:
1551+ 8745
1552+ 8745 3D               dec  a
1553+ 8746 20 06            jr   nz, .not_floor
1554+ 8748
1555+ 8748                  ; Floor
1556+ 8748 21 A9 00         ld   hl, OFFSET_FLOOR
1557+ 874B 19               add  hl, de
1558+ 874C 18 0D            jr   .draw_cell
1559+ 874E
1560+ 874E              .not_floor:
1561+ 874E
1562+ 874E 3D               dec  a
1563+ 874F 20 06            jr   nz, .not_wall
1564+ 8751
1565+ 8751                  ; Wall
1566+ 8751 21 B2 00         ld   hl, OFFSET_WALL
1567+ 8754 19               add  hl, de
1568+ 8755 18 04            jr   .draw_cell
1569+ 8757
1570+ 8757              .not_wall:
1571+ 8757
1572+ 8757                  ; Nasty
1573+ 8757 21 BB 00         ld   hl, OFFSET_NASTY
1574+ 875A 19               add  hl, de
1575+ 875B
1576+ 875B              .draw_cell:
1577+ 875B
1578+ 875B                  ; ---------------------------------------------------------------
1579+ 875B                  ; HL punta ora alla grafica del tile da ridisegnare.
1580+ 875B                  ;
1581+ 875B                  ; Gfx_DrawTile si aspetta:
1582+ 875B                  ;   IX = puntatore tile
1583+ 875B                  ;   B  = Row
1584+ 875B                  ;   C  = Col
1585+ 875B                  ; ---------------------------------------------------------------
1586+ 875B E5               push hl
1587+ 875C DD E1            pop  ix
1588+ 875E
1589+ 875E                  ; Ripristina Row e Col salvati in IY
1590+ 875E FD E5            push iy
1591+ 8760 C1               pop  bc
1592+ 8761
1593+ 8761                  ; Disegna il tile originale
1594+ 8761 CD 5F 6A         call Gfx_DrawTile
1595+ 8764
1596+ 8764                  ; ---------------------------------------------------------------
1597+ 8764                  ; Ripristina i registri salvati
1598+ 8764                  ; ---------------------------------------------------------------
1599+ 8764 DD E1            pop  ix
1600+ 8766 E1               pop  hl
1601+ 8767 D1               pop  de
1602+ 8768 C1               pop  bc
1603+ 8769 FD E1            pop  iy
1604+ 876B
1605+ 876B C9               ret
1606+ 876C
1607+ 876C              ; -------------------------------------------------------------------
1608+ 876C              ; CheckWillyItemCollision
1609+ 876C              ;
1610+ 876C              ; Verifica se Willy collide con un item utilizzando il controllo
1611+ 876C              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1612+ 876C              ;
1613+ 876C              ; Input:
1614+ 876C              ;   A = ItemX (colonna attributi 0..31)
1615+ 876C              ;   H = ItemY (riga attributi 3..18)
1616+ 876C              ;
1617+ 876C              ; Coordinate item:
1618+ 876C              ;   Ogni item occupa una cella da 8x8 pixel.
1619+ 876C              ;
1620+ 876C              ; Coordinate Willy:
1621+ 876C              ;   Willy occupa un rettangolo di 16x16 pixel.
1622+ 876C              ;
1623+ 876C              ; Output:
1624+ 876C              ;   Carry Set   = collisione rilevata
1625+ 876C              ;   Carry Clear = nessuna collisione
1626+ 876C              ;
1627+ 876C              ; Registri preservati:
1628+ 876C              ;   BC, DE, HL
1629+ 876C              ; -------------------------------------------------------------------
1630+ 876C              CheckWillyItemCollision:
1631+ 876C
1632+ 876C                  ; Salva i registri utilizzati
1633+ 876C C5               push bc
1634+ 876D D5               push de
1635+ 876E E5               push hl
1636+ 876F
1637+ 876F                  ; ---------------------------------------------------------------
1638+ 876F                  ; Calcola il bounding box orizzontale dell'item
1639+ 876F                  ;
1640+ 876F                  ; ItemLeft  = ItemX * 8
1641+ 876F                  ; ItemRight = ItemLeft + 7
1642+ 876F                  ;
1643+ 876F                  ; E = ItemLeft
1644+ 876F                  ; D = ItemRight
1645+ 876F                  ; ---------------------------------------------------------------
1646+ 876F 6F               ld   l, a              ; L = ItemX
1647+ 8770
1648+ 8770 7D               ld   a, l
1649+ 8771 87               add  a, a              ; *2
1650+ 8772 87               add  a, a              ; *4
1651+ 8773 87               add  a, a              ; *8
1652+ 8774
1653+ 8774 5F               ld   e, a              ; E = ItemLeft
1654+ 8775
1655+ 8775 C6 07            add  a, 7
1656+ 8777 57               ld   d, a              ; D = ItemRight
1657+ 8778
1658+ 8778                  ; ---------------------------------------------------------------
1659+ 8778                  ; Recupera la posizione corrente di Willy
1660+ 8778                  ;
1661+ 8778                  ; B = WillyY
1662+ 8778                  ; C = WillyX
1663+ 8778                  ; ---------------------------------------------------------------
1664+ 8778 ED 4B 44 F8      ld   bc, (PlayerPos)
1665+ 877C
1666+ 877C                  ; ---------------------------------------------------------------
1667+ 877C                  ; Primo test:
1668+ 877C                  ;
1669+ 877C                  ; WillyLeft <= ItemRight
1670+ 877C                  ;
1671+ 877C                  ; Se Willy è completamente a destra dell'item
1672+ 877C                  ; non può esserci collisione.
1673+ 877C                  ; ---------------------------------------------------------------
1674+ 877C 79               ld   a, c              ; A = WillyLeft
1675+ 877D
1676+ 877D BA               cp   d                 ; WillyLeft vs ItemRight
1677+ 877E
1678+ 877E 28 04            jr   z, .x_ok
1679+ 8780 38 02            jr   c, .x_ok
1680+ 8782
1681+ 8782 18 29            jr   .no_collision
1682+ 8784
1683+ 8784              .x_ok:
1684+ 8784
1685+ 8784                  ; ---------------------------------------------------------------
1686+ 8784                  ; Secondo test:
1687+ 8784                  ;
1688+ 8784                  ; WillyRight >= ItemLeft
1689+ 8784                  ;
1690+ 8784                  ; WillyRight = WillyX + 7
1691+ 8784                  ; ---------------------------------------------------------------
1692+ 8784 C6 07            add  a, 7
1693+ 8786
1694+ 8786 BB               cp   e                 ; WillyRight vs ItemLeft
1695+ 8787
1696+ 8787 28 04            jr   z, .y_check
1697+ 8789 30 02            jr   nc, .y_check
1698+ 878B
1699+ 878B 18 20            jr   .no_collision
1700+ 878D
1701+ 878D              .y_check:
1702+ 878D
1703+ 878D                  ; ---------------------------------------------------------------
1704+ 878D                  ; Recupera ItemY dal valore originale di HL
1705+ 878D                  ;
1706+ 878D                  ; H contiene la riga dell'item.
1707+ 878D                  ; ---------------------------------------------------------------
1708+ 878D E1               pop  hl
1709+ 878E E5               push hl
1710+ 878F
1711+ 878F                  ; ---------------------------------------------------------------
1712+ 878F                  ; Calcola il bounding box verticale dell'item
1713+ 878F                  ;
1714+ 878F                  ; ItemTop    = ItemY * 8
1715+ 878F                  ; ItemBottom = ItemTop + 7
1716+ 878F                  ;
1717+ 878F                  ; E = ItemTop
1718+ 878F                  ; D = ItemBottom
1719+ 878F                  ; ---------------------------------------------------------------
1720+ 878F 7C               ld   a, h
1721+ 8790
1722+ 8790 87               add  a, a              ; *2
1723+ 8791 87               add  a, a              ; *4
1724+ 8792 87               add  a, a              ; *8
1725+ 8793
1726+ 8793 5F               ld   e, a              ; ItemTop
1727+ 8794
1728+ 8794 C6 07            add  a, 7
1729+ 8796 57               ld   d, a              ; ItemBottom
1730+ 8797
1731+ 8797                  ; ---------------------------------------------------------------
1732+ 8797                  ; Primo test verticale:
1733+ 8797                  ;
1734+ 8797                  ; WillyTop <= ItemBottom
1735+ 8797                  ; ---------------------------------------------------------------
1736+ 8797 78               ld   a, b              ; WillyTop
1737+ 8798
1738+ 8798 BA               cp   d
1739+ 8799
1740+ 8799 28 04            jr   z, .y_ok
1741+ 879B 38 02            jr   c, .y_ok
1742+ 879D
1743+ 879D 18 0E            jr   .no_collision
1744+ 879F
1745+ 879F              .y_ok:
1746+ 879F
1747+ 879F                  ; ---------------------------------------------------------------
1748+ 879F                  ; Secondo test verticale:
1749+ 879F                  ;
1750+ 879F                  ; WillyBottom >= ItemTop
1751+ 879F                  ;
1752+ 879F                  ; WillyBottom = WillyY + 15
1753+ 879F                  ; ---------------------------------------------------------------
1754+ 879F C6 0F            add  a, 15
1755+ 87A1
1756+ 87A1 BB               cp   e
1757+ 87A2
1758+ 87A2 28 04            jr   z, .collision
1759+ 87A4 30 02            jr   nc, .collision
1760+ 87A6
1761+ 87A6 18 05            jr   .no_collision
1762+ 87A8
1763+ 87A8              .collision:
1764+ 87A8
1765+ 87A8                  ; ---------------------------------------------------------------
1766+ 87A8                  ; Collisione rilevata
1767+ 87A8                  ; ---------------------------------------------------------------
1768+ 87A8 E1               pop  hl
1769+ 87A9 D1               pop  de
1770+ 87AA C1               pop  bc
1771+ 87AB
1772+ 87AB 37               scf                    ; Carry = 1
1773+ 87AC
1774+ 87AC C9               ret
1775+ 87AD
1776+ 87AD              .no_collision:
1777+ 87AD
1778+ 87AD                  ; ---------------------------------------------------------------
1779+ 87AD                  ; Nessuna collisione
1780+ 87AD                  ; ---------------------------------------------------------------
1781+ 87AD E1               pop  hl
1782+ 87AE D1               pop  de
1783+ 87AF C1               pop  bc
1784+ 87B0
1785+ 87B0 B7               or   a                 ; Carry = 0
1786+ 87B1
1787+ 87B1 C9               ret
1788+ 87B2
1789+ 87B2              ; -------------------------------------------------------------------
1790+ 87B2              ; Items_CheckCollision
1791+ 87B2              ;
1792+ 87B2              ; Controlla se Willy entra in collisione con uno degli item
1793+ 87B2              ; attivi presenti nella stanza corrente.
1794+ 87B2              ;
1795+ 87B2              ; Per ogni item:
1796+ 87B2              ;   - verifica che appartenga alla stanza corrente
1797+ 87B2              ;   - verifica che non sia già stato raccolto
1798+ 87B2              ;   - esegue il test di collisione con Willy
1799+ 87B2              ;
1800+ 87B2              ; Se l'item viene raccolto:
1801+ 87B2              ;   - imposta il flag "collected"
1802+ 87B2              ;   - rimuove l'item dalla cache items_grid
1803+ 87B2              ;   - incrementa il contatore degli oggetti raccolti
1804+ 87B2              ;   - aggiorna l'HUD
1805+ 87B2              ;   - ripristina il tile di sfondo
1806+ 87B2              ;   - riproduce il suono di raccolta
1807+ 87B2              ;
1808+ 87B2              ; Formato record ItemsTable:
1809+ 87B2              ;   +0 RoomID
1810+ 87B2              ;   +1 X
1811+ 87B2              ;   +2 Y
1812+ 87B2              ;   +3 Color
1813+ 87B2              ;   +4 Collected
1814+ 87B2              ;
1815+ 87B2              ; Fine tabella:
1816+ 87B2              ;   RoomID = $FF
1817+ 87B2              ; -------------------------------------------------------------------
1818+ 87B2              Items_CheckCollision:
1819+ 87B2
1820+ 87B2                  ; Salva i registri utilizzati
1821+ 87B2 E5               push hl
1822+ 87B3 D5               push de
1823+ 87B4 C5               push bc
1824+ 87B5
1825+ 87B5                  ; Inizio scansione della tabella degli item
1826+ 87B5 21 FD 80         ld   hl, ItemsTable
1827+ 87B8
1828+ 87B8              .loop:
1829+ 87B8
1830+ 87B8                  ; ---------------------------------------------------------------
1831+ 87B8                  ; Legge il Room ID dell'item corrente
1832+ 87B8                  ; ---------------------------------------------------------------
1833+ 87B8 7E               ld   a, (hl)
1834+ 87B9
1835+ 87B9                  ; $FF indica fine tabella
1836+ 87B9 FE FF            cp   $FF
1837+ 87BB 28 58            jr   z, .done
1838+ 87BD
1839+ 87BD                  ; ---------------------------------------------------------------
1840+ 87BD                  ; Verifica se l'item appartiene alla stanza corrente
1841+ 87BD                  ; ---------------------------------------------------------------
1842+ 87BD 57               ld   d, a              ; D = RoomID item
