 710+ 60C8              ; Disegna la riga/pavimento sotto i piedi degli sprite (Riga 18, Y = 144)
 711+ 60C8              ; -------------------------------------------------------------------
 712+ 60C8              ; -------------------------------------------------------------------
 713+ 60C8              ; Disegna un tile 8x8 sullo schermo
 714+ 60C8              ; Input: B = Row (0..23), C = Col (0..31), IX = Puntatore al Tile (9 byte: 1 attr + 8 bitmap)
 715+ 60C8              ; -------------------------------------------------------------------
 716+ 60C8              DrawTile:
 717+ 60C8 C5               push bc
 718+ 60C9 D5               push de
 719+ 60CA E5               push hl
 720+ 60CB
 721+ 60CB                  ; 1. Calcola indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 722+ 60CB                  ; HighByte = $40 + (B & $18)
 723+ 60CB 78               ld   a, b
 724+ 60CC E6 18            and  $18
 725+ 60CE C6 40            add  a, $40
 726+ 60D0 67               ld   h, a              ; H = High byte
 727+ 60D1
 728+ 60D1                  ; LowByte = ((B & 7) * 32) + C
 729+ 60D1 78               ld   a, b
 730+ 60D2 E6 07            and  7
 731+ 60D4 87               add  a, a              ; *2
 732+ 60D5 87               add  a, a              ; *4
 733+ 60D6 87               add  a, a              ; *8
 734+ 60D7 87               add  a, a              ; *16
 735+ 60D8 87               add  a, a              ; *32
 736+ 60D9 81               add  a, c              ; + Col C
 737+ 60DA 6F               ld   l, a              ; L = Low byte
 738+ 60DB
 739+ 60DB                  ; 2. Copia gli 8 byte del bitmap
 740+ 60DB 16 08            ld   d, 8              ; 8 scanline
 741+ 60DD DD E5            push ix
 742+ 60DF DD 23            inc  ix                ; Salta l'attributo, vai al bitmap
 743+ 60E1              .line_loop:
 744+ 60E1 DD 7E 00         ld   a, (ix+0)
 745+ 60E4 77               ld   (hl), a
 746+ 60E5 24               inc  h                 ; Prossima scanline (stessa riga di caratteri)
 747+ 60E6 DD 23            inc  ix
 748+ 60E8 15               dec  d
 749+ 60E9 20 F6            jr   nz, .line_loop
 750+ 60EB DD E1            pop  ix
 751+ 60ED
 752+ 60ED                  ; 3. Scrivi l'attributo
 753+ 60ED                  ; AttrAddr = $5800 + B * 32 + C
 754+ 60ED 26 00            ld   h, 0
 755+ 60EF 68               ld   l, b              ; HL = B (Row)
 756+ 60F0 29               add  hl, hl            ; *2
 757+ 60F1 29               add  hl, hl            ; *4
 758+ 60F2 29               add  hl, hl            ; *8
 759+ 60F3 29               add  hl, hl            ; *16
 760+ 60F4 29               add  hl, hl            ; *32
 761+ 60F5 16 00            ld   d, 0
 762+ 60F7 59               ld   e, c              ; DE = C (Col)
 763+ 60F8 19               add  hl, de            ; HL = B * 32 + C
 764+ 60F9 11 00 58         ld   de, $5800
 765+ 60FC 19               add  hl, de            ; HL = AttrAddr
 766+ 60FD
 767+ 60FD DD 7E 00         ld   a, (ix+0)         ; A = attribute byte
 768+ 6100 77               ld   (hl), a           ; Scrivi in memoria attributi
