   6+ 64E6              ; MovePlayer
   7+ 64E6              ;
   8+ 64E6              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 64E6              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 64E6              ; con i muri.
  11+ 64E6              ;
  12+ 64E6              ; Input:
  13+ 64E6              ;   D = stato dei controlli (bitfield)
  14+ 64E6              ;
  15+ 64E6              ; Strutture utilizzate:
  16+ 64E6              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 64E6              ;   player_speed    -> velocità orizzontale
  18+ 64E6              ;   flags           -> flag di stato input
  19+ 64E6              ;
  20+ 64E6              ; Bit controlli:
  21+ 64E6              ;   bit 0 = sinistra
  22+ 64E6              ;   bit 1 = destra
  23+ 64E6              ;
  24+ 64E6              ; Nota:
  25+ 64E6              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 64E6              ;   ignorato per tutta la durata del salto.
  27+ 64E6              ;
  28+ 64E6              ; Output:
  29+ 64E6              ;   aggiorna PlayerPos e body_state
  30+ 64E6              ; -------------------------------------------------------------------
  31+ 64E6              MovePlayer:
  32+ 64E6
  33+ 64E6                  ; ---------------------------------------------------------------
  34+ 64E6                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 64E6                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 64E6                  ; tasti di direzione premuti (jump_dir decide).
  37+ 64E6                  ; ---------------------------------------------------------------
  38+ 64E6 3A 2C 7A         ld   a, (on_ground)
  39+ 64E9 B7               or   a
  40+ 64EA 20 1A            jr   nz, .on_ground_check
  41+ 64EC
  42+ 64EC 3A 30 7A         ld   a, (jump_dir)
  43+ 64EF B7               or   a
  44+ 64F0 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 64F1
  46+ 64F1                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 64F1 DD 21 23 7A      ld   ix, flags
  48+ 64F5 DD CB 00 86      res  $00, (ix)
  49+ 64F9
  50+ 64F9 ED 4B 1B 7A      ld   bc, (PlayerPos)
