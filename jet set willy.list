 298  8813 79               ld   a, c
 299  8814 CB 3F            srl  a
 300  8816 CB 3F            srl  a
 301  8818 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 302  881A E6 07            and  7
 303  881C 5F               ld   e, a
 304  881D 16 00            ld   d, 0
 305  881F 21 13 63         ld   hl, title_color_table
 306  8822 19               add  hl, de
 307  8823 7E               ld   a, (hl)               ; A = nuovo colore
 308  8824 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 309  8827 06 20            ld   b, 32
