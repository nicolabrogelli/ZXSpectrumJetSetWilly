1076+ 6AE4 29               add  hl, hl
1077+ 6AE5 29               add  hl, hl
1078+ 6AE6 29               add  hl, hl
1079+ 6AE7 29               add  hl, hl
1080+ 6AE8 29               add  hl, hl            ; HL = Row * 32
1081+ 6AE9 59               ld   e, c
1082+ 6AEA 16 00            ld   d, 0
1083+ 6AEC 19               add  hl, de            ; HL = Row * 32 + Col
1084+ 6AED 11 FD 73         ld   de, unpacked_layout
1085+ 6AF0 19               add  hl, de
1086+ 6AF1 7E               ld   a, (hl)           ; A = cell type
