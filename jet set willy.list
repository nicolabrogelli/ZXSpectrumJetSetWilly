 795  8DE9              ; CheckWillyConveyorCollision
 796  8DE9              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 797  8DE9              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 798  8DE9              ; -------------------------------------------------------------------
 799  8DE9              CheckWillyConveyorCollision:
 800  8DE9 C5               push bc
 801  8DEA D5               push de
 802  8DEB E5               push hl
 803  8DEC
 804  8DEC                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 805  8DEC CD 43 76         call CheckWillyOnConveyor
 806  8DEF 38 49            jr   c, .collision_detected
 807  8DF1
 808  8DF1                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 809  8DF1 3A 6C FB         ld   a, (conveyor_len)
 810  8DF4 B7               or   a
 811  8DF5 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 812  8DF7
 813  8DF7                  ; B = WillyY, C = WillyX
 814  8DF7 ED 4B 44 F8      ld   bc, (PlayerPos)
 815  8DFB
 816  8DFB                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 817  8DFB 3A 6D FB         ld   a, (conveyor_row)
 818  8DFE 87               add  a, a                  ; *2
 819  8DFF 87               add  a, a                  ; *4
 820  8E00 87               add  a, a                  ; *8
 821  8E01 5F               ld   e, a                  ; E = ConveyorTop
 822  8E02 C6 07            add  a, 7
 823  8E04 57               ld   d, a                  ; D = ConveyorBottom
 824  8E05
 825  8E05                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 826  8E05 78               ld   a, b                  ; WillyTop
 827  8E06 BA               cp   d
 828  8E07 28 04            jr   z, .y_overlap
 829  8E09 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 830  8E0B 18 32            jr   .no_conv_collision
 831  8E0D
 832  8E0D              .y_overlap:
 833  8E0D C6 0F            add  a, 15                 ; WillyBottom
 834  8E0F BB               cp   e
 835  8E10 28 04            jr   z, .x_check
 836  8E12 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 837  8E14 18 29            jr   .no_conv_collision
 838  8E16
 839  8E16              .x_check:
 840  8E16                  ; ConveyorLeft = conveyor_col * 8
 841  8E16 3A 6E FB         ld   a, (conveyor_col)
 842  8E19 87               add  a, a                  ; *2
 843  8E1A 87               add  a, a                  ; *4
 844  8E1B 87               add  a, a                  ; *8
 845  8E1C 5F               ld   e, a                  ; E = ConveyorLeft
 846  8E1D
 847  8E1D                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 848  8E1D 21 6C FB         ld   hl, conveyor_len
 849  8E20 3A 6E FB         ld   a, (conveyor_col)
 850  8E23 86               add  a, (hl)
 851  8E24 87               add  a, a                  ; *2
 852  8E25 87               add  a, a                  ; *4
 853  8E26 87               add  a, a                  ; *8
 854  8E27 3D               dec  a                     ; ConveyorRight
 855  8E28 57               ld   d, a                  ; D = ConveyorRight
 856  8E29
 857  8E29                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 858  8E29 79               ld   a, c                  ; WillyLeft
 859  8E2A BA               cp   d
 860  8E2B 28 04            jr   z, .x_overlap
 861  8E2D 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 862  8E2F 18 0E            jr   .no_conv_collision
 863  8E31
 864  8E31              .x_overlap:
 865  8E31 C6 0F            add  a, 15                 ; WillyRight
 866  8E33 BB               cp   e
 867  8E34 28 04            jr   z, .collision_detected
 868  8E36 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 869  8E38 18 05            jr   .no_conv_collision
 870  8E3A
