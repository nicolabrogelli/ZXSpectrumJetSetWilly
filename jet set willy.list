   7+ 5DDB              ; Copia il set dei caratteri dalla ROM alla RAM
   8+ 5DDB              ; -------------------------------------------------------------------
   9+ 5DDB              CopyChars:
  10+ 5DDB 21 00 3D         ld hl, $3D00  ; Indirizzo del set di caratteri originale in ROM
  11+ 5DDE 11 00 80         ld de, $8000  ; Indirizzo nella RAM in cui copiare il set di caratteri
  12+ 5DE1 01 00 03         ld bc, 768    ; Numero di byte da copiare (96 caratteri * 8 byte ciascuno)
  13+ 5DE4 ED B0            ldir          ; Copiare i dati
  14+ 5DE6 C9               ret
  15+ 5DE7
  16+ 5DE7              ; -------------------------------------------------------------------
  17+ 5DE7              ; Ridefinisci i caratteri (incluso quello per i bordi)
  18+ 5DE7              ; -------------------------------------------------------------------
  19+ 5DE7              DefineChars:
  20+ 5DE7 21 A7 61         ld hl, TilesDef             ; Indirizzo dei dati del nuovo carattere
  21+ 5DEA 11 08 7F         ld de, $7F00 + (1 * 8)      ; Indirizzo di ASCII 1 nel nuovo set di caratteri
  22+ 5DED 01 48 00         ld bc, 72                   ; Numero di byte da copiare (9 caratteri * 8 byte)
  23+ 5DF0 ED B0            ldir                        ; Effettua la copia dei caratteri
  24+ 5DF2 21 00 7F         ld hl, $7F00                ; Indirizzo del nuovo set di caratteri in RAM (font start - 256)
  25+ 5DF5 22 36 5C         ld ($5C36), hl              ; Aggiornare la variabile di sistema CHARS
  26+ 5DF8 C9               ret
  27+ 5DF9
  28+ 5DF9              ; -------------------------------------------------------------------
  29+ 5DF9              ; Posiziona il cursore
