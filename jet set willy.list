 457  87D8 CD D8 6B         call InitRoomEntryPositions
 458  87DB
 459  87DB                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 460  87DB 3E 07            ld   a, 7
 461  87DD 32 8C EE         ld   (time_hours), a
 462  87E0 AF               xor  a
 463  87E1 32 8D EE         ld   (time_minutes), a
 464  87E4 32 8E EE         ld   (time_period), a       ; 0 = AM
 465  87E7 32 91 EE         ld   (game_objective_completed), a
 466  87EA 2A A0 EA         ld   hl, (counter)
 467  87ED 22 8F EE         ld   (time_last_counter), hl
 468  87F0 CD 8C 66         call Gfx_UpdateTimeDisplay
 469  87F3
 470  87F3                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 471  87F3 21 37 AD         ld   hl, TheBathroomLayout; TheOffLicenceLayout
 472  87F6 22 FF ED         ld   (room_ptr), hl
 473  87F9
 474  87F9 C9               ret
 475  87FA
 476  87FA              ; -------------------------------------------------------------------
 477  87FA              ; Time_UpdateClock
 478  87FA              ; Gestisce lo scorrimento del tempo durante il gioco.
 479  87FA              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 480  87FA              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 481  87FA              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 482  87FA              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 483  87FA              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 484  87FA              ; sia completato, scatena immediatamente il Game Over.
 485  87FA              ; -------------------------------------------------------------------
 486  87FA              Time_UpdateClock:
 487  87FA                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 488  87FA 2A A0 EA         ld   hl, (counter)
 489  87FD ED 5B 8F EE      ld   de, (time_last_counter)
 490  8801 B7               or   a
 491  8802 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 492  8804
 493  8804                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 494  8804 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 495  8807 B7               or   a
 496  8808 ED 52            sbc  hl, de
 497  880A D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 498  880B
 499  880B                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 500  880B 2A 8F EE         ld   hl, (time_last_counter)
 501  880E 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 502  8811 19               add  hl, de
 503  8812 22 8F EE         ld   (time_last_counter), hl
 504  8815
 505  8815                  ; Incrementa di 1 minuto il tempo di gioco
 506  8815 3A 8D EE         ld   a, (time_minutes)
 507  8818 3C               inc  a
 508  8819 FE 3C            cp   60
 509  881B 38 21            jr   c, .minutes_ok
 510  881D
 511  881D                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 512  881D AF               xor  a
 513  881E 32 8D EE         ld   (time_minutes), a
 514  8821 3A 8C EE         ld   a, (time_hours)
 515  8824 3C               inc  a
 516  8825 FE 0C            cp   12
 517  8827 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 518  8829 FE 0D            cp   13
 519  882B 38 0E            jr   c, .hours_ok
 520  882D 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 521  882F 18 0A            jr   .hours_ok
 522  8831
 523  8831              .toggle_period:
 524  8831 F5               push af                     ; Salva A (valore 12)
 525  8832 3A 8E EE         ld   a, (time_period)
 526  8835 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 527  8837 32 8E EE         ld   (time_period), a
 528  883A F1               pop  af                     ; Ripristina A = 12
 529  883B
 530  883B              .hours_ok:
 531  883B 32 8C EE         ld   (time_hours), a
 532  883E
 533  883E              .minutes_ok:
 534  883E 32 8D EE         ld   (time_minutes), a
 535  8841
 536  8841                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 537  8841 CD 8C 66         call Gfx_UpdateTimeDisplay
 538  8844
 539  8844                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 540  8844 3A 91 EE         ld   a, (game_objective_completed)
 541  8847 B7               or   a
 542  8848 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 543  8849
 544  8849                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 545  8849 3A 8E EE         ld   a, (time_period)
 546  884C B7               or   a
 547  884D C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 548  884E
 549  884E 3A 8C EE         ld   a, (time_hours)
 550  8851 FE 0C            cp   12
 551  8853 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
 552  8855 C9               ret
 553  8856
 554  8856              .time_limit_reached:
 555  8856                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
 556  8856                  ; Scatena immediatamente il Game Over temporale!
 557  8856 C3 46 87         jp   TriggerGameOver
