 804+ 6A02              IsCellOnRamp:
 805+ 6A02 C5               push bc
 806+ 6A03 E5               push hl
 807+ 6A04
 808+ 6A04 3A 22 76         ld   a, (ramp_len)
 809+ 6A07 B7               or   a
 810+ 6A08 28 6B            jr   z, .no
 811+ 6A0A
 812+ 6A0A                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 813+ 6A0A 3A 21 76         ld   a, (ramp_dir)
 814+ 6A0D B7               or   a
 815+ 6A0E 28 1A            jr   z, .range_left
 816+ 6A10              .range_right:
 817+ 6A10 3A 24 76         ld   a, (ramp_col)
 818+ 6A13 47               ld   b, a              ; B = ramp_col
 819+ 6A14 3A 22 76         ld   a, (ramp_len)
 820+ 6A17 80               add  a, b              ; A = ramp_col + ramp_len
 821+ 6A18 4F               ld   c, a              ; C = limit_right (exclusive)
 822+ 6A19
 823+ 6A19 7B               ld   a, e              ; A = Col
 824+ 6A1A B8               cp   b
 825+ 6A1B 38 34            jr   c, .check_platform_case ; Col < ramp_col
 826+ 6A1D B9               cp   c
 827+ 6A1E 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 828+ 6A20
 829+ 6A20                  ; Calcola B = Col - ramp_col
 830+ 6A20 7B               ld   a, e
 831+ 6A21 90               sub  b
 832+ 6A22 47               ld   b, a              ; B = offset (0..ramp_len-1)
 833+ 6A23
 834+ 6A23                  ; SlopeRow = ramp_row - B
 835+ 6A23 3A 23 76         ld   a, (ramp_row)
 836+ 6A26 90               sub  b
 837+ 6A27 47               ld   b, a              ; B = SlopeRow
 838+ 6A28 18 1F            jr   .check_row_match
 839+ 6A2A
 840+ 6A2A              .range_left:
 841+ 6A2A                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
