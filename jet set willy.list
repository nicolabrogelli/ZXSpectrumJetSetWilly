 177  7FE3              .draw_raster_bars:
 178  7FE3                  ; Collisione attiva: disegna le raster bar nel bordo
 179  7FE3 3A 9B 7B         ld   a, (counter)
 180  7FE6 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 181  7FE8 06 1E            ld   b, 30             ; Numero di righe della barra raster
 182  7FEA              .raster_loop:
 183  7FEA D3 FE            out  ($fe), a
 184  7FEC 3C               inc  a
 185  7FED E6 07            and  7
 186  7FEF 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 187  7FF1              .delay:
 188  7FF1 0D               dec  c
 189  7FF2 20 FD            jr   nz, .delay
 190  7FF4 10 F4            djnz .raster_loop
 191  7FF6
