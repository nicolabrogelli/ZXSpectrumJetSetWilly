1075+ 8615
1076+ 8615                  ; Ripristina i registri
1077+ 8615 D1               pop  de
1078+ 8616 E1               pop  hl
1079+ 8617
1080+ 8617 C9               ret
1081+ 8618
1082+ 8618              ; -------------------------------------------------------------------
1083+ 8618              ; Items_DrawRoom
1084+ 8618              ;
1085+ 8618              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1086+ 8618              ;
1087+ 8618              ; Operazioni eseguite:
1088+ 8618              ;   1. Azzera la griglia items_grid.
1089+ 8618              ;   2. Svuota la cache degli oggetti attivi.
1090+ 8618              ;   3. Scansiona ItemsTable.
1091+ 8618              ;   4. Per ogni item della stanza corrente:
1092+ 8618              ;        - verifica se è già stato raccolto
1093+ 8618              ;        - disegna la grafica
1094+ 8618              ;        - aggiorna items_grid
1095+ 8618              ;        - memorizza l'item nella cache current_room_items
1096+ 8618              ;   5. Aggiorna num_room_items.
1097+ 8618              ;
1098+ 8618              ; Record ItemsTable:
1099+ 8618              ;   +0  Room ID
1100+ 8618              ;   +1  X (colonna)
1101+ 8618              ;   +2  Y (riga)
1102+ 8618              ;   +3  Colore
1103+ 8618              ;   +4  Collected flag
1104+ 8618              ;
1105+ 8618              ; Cache current_room_items:
1106+ 8618              ;   +0  Colonna
1107+ 8618              ;   +1  Riga
1108+ 8618              ;   +2  Colore
1109+ 8618              ;   +3  Collected flag ptr (Low)
1110+ 8618              ;   +4  Collected flag ptr (High)
1111+ 8618              ;
1112+ 8618              ; Ogni record cache occupa 5 byte.
1113+ 8618              ; -------------------------------------------------------------------
1114+ 8618              ; ResetItemsTable
1115+ 8618              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1116+ 8618              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1117+ 8618              ; -------------------------------------------------------------------
1118+ 8618              ResetItemsTable:
1119+ 8618 21 BC 80         ld   hl, ItemsTable
1120+ 861B              .reset_loop:
1121+ 861B 7E               ld   a, (hl)
1122+ 861C FE FF            cp   $FF
1123+ 861E C8               ret  z
1124+ 861F 23               inc  hl                        ; +1 (X)
1125+ 8620 23               inc  hl                        ; +2 (Y)
1126+ 8621 23               inc  hl                        ; +3 (Color)
1127+ 8622 23               inc  hl                        ; +4 (Collected flag)
1128+ 8623 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1129+ 8625 23               inc  hl                        ; Prossimo record
1130+ 8626 18 F3            jr   .reset_loop
1131+ 8628
1132+ 8628              ; -------------------------------------------------------------------
1133+ 8628              Items_DrawRoom:
1134+ 8628
1135+ 8628                  ; Salva tutti i registri utilizzati
1136+ 8628 E5               push hl
1137+ 8629 D5               push de
1138+ 862A C5               push bc
1139+ 862B DD E5            push ix
1140+ 862D FD E5            push iy
1141+ 862F
1142+ 862F                  ; ---------------------------------------------------------------
1143+ 862F                  ; Azzera items_grid (32 x 16 = 512 byte)
1144+ 862F                  ; ---------------------------------------------------------------
1145+ 862F 21 57 F2         ld   hl, items_grid
1146+ 8632 11 58 F2         ld   de, items_grid + 1
1147+ 8635 36 00            ld   (hl), 0
1148+ 8637 01 FF 01         ld   bc, 511
1149+ 863A ED B0            ldir
1150+ 863C
1151+ 863C                  ; ---------------------------------------------------------------
1152+ 863C                  ; Nessun item attivo nella stanza
1153+ 863C                  ; ---------------------------------------------------------------
1154+ 863C AF               xor  a
1155+ 863D 32 D6 F7         ld   (num_room_items), a
1156+ 8640
1157+ 8640                  ; IY punta alla cache degli item attivi
1158+ 8640 FD 21 86 F7      ld   iy, current_room_items
1159+ 8644
1160+ 8644                  ; ---------------------------------------------------------------
1161+ 8644                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1162+ 8644                  ; alla stanza corrente.
1163+ 8644                  ;
1164+ 8644                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1165+ 8644                  ; ---------------------------------------------------------------
1166+ 8644 2A D7 F7         ld   hl, (room_ptr)
1167+ 8647 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1168+ 864A 19               add  hl, de
1169+ 864B
1170+ 864B E5               push hl
1171+ 864C DD E1            pop  ix                ; IX = bitmap item
1172+ 864E
1173+ 864E                  ; ---------------------------------------------------------------
1174+ 864E                  ; Inizio scansione della tabella degli item
1175+ 864E                  ; ---------------------------------------------------------------
1176+ 864E 21 BC 80         ld   hl, ItemsTable
1177+ 8651
1178+ 8651              .loop:
1179+ 8651
1180+ 8651                  ; ---------------------------------------------------------------
1181+ 8651                  ; Legge il Room ID del record corrente
1182+ 8651                  ; ---------------------------------------------------------------
1183+ 8651 7E               ld   a, (hl)
1184+ 8652
1185+ 8652                  ; $FF indica fine tabella
1186+ 8652 FE FF            cp   $FF
1187+ 8654 28 53            jr   z, .done
1188+ 8656
1189+ 8656                  ; ---------------------------------------------------------------
1190+ 8656                  ; Verifica se l'item appartiene alla stanza corrente
1191+ 8656                  ; ---------------------------------------------------------------
1192+ 8656 57               ld   d, a
1193+ 8657
1194+ 8657 3A 7D F7         ld   a, (current_room)
1195+ 865A BA               cp   d
1196+ 865B 20 45            jr   nz, .next_item
1197+ 865D
1198+ 865D                  ; ---------------------------------------------------------------
1199+ 865D                  ; Legge i dati dell'item
1200+ 865D                  ; ---------------------------------------------------------------
1201+ 865D
1202+ 865D 23               inc  hl
1203+ 865E 4E               ld   c, (hl)           ; X (colonna)
1204+ 865F
1205+ 865F 23               inc  hl
1206+ 8660 46               ld   b, (hl)           ; Y (riga)
1207+ 8661
1208+ 8661 23               inc  hl
1209+ 8662 5E               ld   e, (hl)           ; Colore
1210+ 8663
1211+ 8663 23               inc  hl
1212+ 8664 7E               ld   a, (hl)           ; Collected flag
1213+ 8665
1214+ 8665                  ; Se diverso da zero l'item è già stato raccolto
1215+ 8665 B7               or   a
1216+ 8666 20 3E            jr   nz, .next_no_inc
1217+ 8668
1218+ 8668                  ; ---------------------------------------------------------------
1219+ 8668                  ; Disegna l'item sullo schermo
1220+ 8668                  ;
1221+ 8668                  ; B = Row
1222+ 8668                  ; C = Column
1223+ 8668                  ; HL = bitmap pointer
1224+ 8668                  ; E = Color
1225+ 8668                  ; ---------------------------------------------------------------
1226+ 8668 E5               push hl
1227+ 8669
1228+ 8669 DD E5            push ix
1229+ 866B E1               pop  hl
1230+ 866C
1231+ 866C CD B1 86         call DrawItemGraphic
1232+ 866F
1233+ 866F E1               pop  hl                ; ritorna al flag collected
1234+ 8670
1235+ 8670                  ; ---------------------------------------------------------------
1236+ 8670                  ; Aggiorna items_grid
1237+ 8670                  ;
1238+ 8670                  ; Calcolo:
1239+ 8670                  ;   offset = Row * 32 + Col
1240+ 8670                  ; ---------------------------------------------------------------
1241+ 8670 E5               push hl
1242+ 8671 D5               push de
1243+ 8672
1244+ 8672 26 00            ld   h, 0
1245+ 8674 68               ld   l, b              ; HL = Row
1246+ 8675
1247+ 8675 29               add  hl, hl            ; *2
1248+ 8676 29               add  hl, hl            ; *4
1249+ 8677 29               add  hl, hl            ; *8
1250+ 8678 29               add  hl, hl            ; *16
1251+ 8679 29               add  hl, hl            ; *32
1252+ 867A
1253+ 867A 16 00            ld   d, 0
1254+ 867C 59               ld   e, c              ; DE = Col
1255+ 867D
1256+ 867D 19               add  hl, de            ; Row*32 + Col
1257+ 867E
1258+ 867E 11 57 F2         ld   de, items_grid
1259+ 8681 19               add  hl, de            ; puntatore nella griglia
1260+ 8682
1261+ 8682 D1               pop  de                ; ripristina colore
1262+ 8683
1263+ 8683 73               ld   (hl), e           ; salva colore cella
1264+ 8684
1265+ 8684 E1               pop  hl
1266+ 8685
1267+ 8685                  ; ---------------------------------------------------------------
1268+ 8685                  ; Salva l'item nella cache della stanza
1269+ 8685                  ;
1270+ 8685                  ; Questo evita di dover scansionare tutta ItemsTable
1271+ 8685                  ; durante il controllo delle collisioni.
1272+ 8685                  ; ---------------------------------------------------------------
1273+ 8685
1274+ 8685 FD 71 00         ld   (iy+0), c         ; Colonna
1275+ 8688 FD 70 01         ld   (iy+1), b         ; Riga
1276+ 868B FD 73 02         ld   (iy+2), e         ; Colore
1277+ 868E
1278+ 868E                  ; Salva il puntatore al flag "collected"
1279+ 868E FD 75 03         ld   (iy+3), l         ; Low byte
1280+ 8691 FD 74 04         ld   (iy+4), h         ; High byte
1281+ 8694
1282+ 8694                  ; Passa al record successivo della cache
1283+ 8694 01 05 00         ld   bc, 5
1284+ 8697 FD 09            add  iy, bc
1285+ 8699
1286+ 8699                  ; Incrementa il numero di item attivi
1287+ 8699 3A D6 F7         ld   a, (num_room_items)
1288+ 869C 3C               inc  a
1289+ 869D 32 D6 F7         ld   (num_room_items), a
1290+ 86A0
1291+ 86A0 18 04            jr   .next_no_inc
1292+ 86A2
1293+ 86A2              .next_item:
1294+ 86A2
1295+ 86A2                  ; ---------------------------------------------------------------
1296+ 86A2                  ; L'item non appartiene alla stanza corrente.
1297+ 86A2                  ; Salta i campi del record:
1298+ 86A2                  ;   X
1299+ 86A2                  ;   Y
1300+ 86A2                  ;   Color
1301+ 86A2                  ;   Collected
1302+ 86A2                  ; ---------------------------------------------------------------
1303+ 86A2 23               inc  hl
1304+ 86A3 23               inc  hl
1305+ 86A4 23               inc  hl
1306+ 86A5 23               inc  hl
1307+ 86A6
1308+ 86A6              .next_no_inc:
1309+ 86A6
1310+ 86A6                  ; ---------------------------------------------------------------
1311+ 86A6                  ; Avanza al record successivo
1312+ 86A6                  ; (prossimo Room ID)
1313+ 86A6                  ; ---------------------------------------------------------------
1314+ 86A6 23               inc  hl
1315+ 86A7 18 A8            jr   .loop
1316+ 86A9
1317+ 86A9              .done:
1318+ 86A9
1319+ 86A9                  ; Ripristina i registri
1320+ 86A9 FD E1            pop  iy
1321+ 86AB DD E1            pop  ix
1322+ 86AD D1               pop  de
1323+ 86AE C1               pop  bc
1324+ 86AF E1               pop  hl
1325+ 86B0
1326+ 86B0 C9               ret
1327+ 86B1
1328+ 86B1              ; -------------------------------------------------------------------
1329+ 86B1              ; DrawItemGraphic
1330+ 86B1              ;
1331+ 86B1              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1332+ 86B1              ; utilizzando una bitmap di 8 byte e un attributo colore.
1333+ 86B1              ;
1334+ 86B1              ; Input:
1335+ 86B1              ;   B = Riga attributi (3..18)
1336+ 86B1              ;   C = Colonna attributi (0..31)
1337+ 86B1              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1338+ 86B1              ;   E = Attributo colore
1339+ 86B1              ;
1340+ 86B1              ; Output:
1341+ 86B1              ;   Nessuno
1342+ 86B1              ;
1343+ 86B1              ; Registri preservati:
1344+ 86B1              ;   BC, DE, HL
1345+ 86B1              ; -------------------------------------------------------------------
1346+ 86B1              DrawItemGraphic:
1347+ 86B1
1348+ 86B1                  ; Salva i registri originali
1349+ 86B1 C5               push bc
1350+ 86B2 D5               push de
1351+ 86B3 E5               push hl
1352+ 86B4
1353+ 86B4                  ; ---------------------------------------------------------------
1354+ 86B4                  ; Calcolo indirizzo bitmap dello Spectrum
1355+ 86B4                  ;
1356+ 86B4                  ; Ogni item occupa una cella attributi (8x8 pixel).
1357+ 86B4                  ;
1358+ 86B4                  ; Formula:
1359+ 86B4                  ;   High = $40 + (Row AND $18)
1360+ 86B4                  ;   Low  = (Row AND 7) * 32 + Col
1361+ 86B4                  ;
1362+ 86B4                  ; DE conterrà l'indirizzo della prima scanline.
1363+ 86B4                  ; ---------------------------------------------------------------
1364+ 86B4
1365+ 86B4 78               ld   a, b
1366+ 86B5 E6 18            and  $18
1367+ 86B7 C6 40            add  a, $40
1368+ 86B9 57               ld   d, a              ; Byte alto indirizzo video
1369+ 86BA
1370+ 86BA 78               ld   a, b
1371+ 86BB E6 07            and  7                 ; Riga interna al blocco da 8
1372+ 86BD
1373+ 86BD 87               add  a, a              ; *2
1374+ 86BE 87               add  a, a              ; *4
1375+ 86BF 87               add  a, a              ; *8
1376+ 86C0 87               add  a, a              ; *16
1377+ 86C1 87               add  a, a              ; *32
1378+ 86C2
1379+ 86C2 81               add  a, c              ; + colonna
1380+ 86C3
1381+ 86C3 5F               ld   e, a              ; Byte basso indirizzo video
1382+ 86C4
1383+ 86C4                  ; ---------------------------------------------------------------
1384+ 86C4                  ; Disegno bitmap
1385+ 86C4                  ;
1386+ 86C4                  ; Copia 8 byte consecutivi nella memoria video.
1387+ 86C4                  ; Ogni byte rappresenta una scanline da 8 pixel.
1388+ 86C4                  ; ---------------------------------------------------------------
1389+ 86C4
1390+ 86C4 C5               push bc                ; Conserva Row e Col
1391+ 86C5
1392+ 86C5 06 08            ld   b, 8              ; Numero scanline
1393+ 86C7
1394+ 86C7              .line_loop:
1395+ 86C7
1396+ 86C7 7E               ld   a, (hl)           ; Legge scanline bitmap
1397+ 86C8 12               ld   (de), a           ; Scrive nella memoria video
1398+ 86C9
1399+ 86C9 14               inc  d                 ; Scanline successiva
1400+ 86CA 23               inc  hl                ; Byte bitmap successivo
1401+ 86CB
1402+ 86CB 05               dec  b
1403+ 86CC 20 F9            jr   nz, .line_loop
1404+ 86CE
1405+ 86CE C1               pop  bc                ; Ripristina Row e Col
1406+ 86CF
1407+ 86CF                  ; ---------------------------------------------------------------
1408+ 86CF                  ; Calcolo indirizzo attributo
1409+ 86CF                  ;
1410+ 86CF                  ; Formula:
1411+ 86CF                  ;   AttrAddr = $5800 + Row * 32 + Col
1412+ 86CF                  ;
1413+ 86CF                  ; HL conterrà l'indirizzo della cella attributi.
1414+ 86CF                  ; ---------------------------------------------------------------
1415+ 86CF
1416+ 86CF 26 00            ld   h, 0
1417+ 86D1 68               ld   l, b              ; HL = Row
1418+ 86D2
1419+ 86D2 29               add  hl, hl            ; *2
1420+ 86D3 29               add  hl, hl            ; *4
1421+ 86D4 29               add  hl, hl            ; *8
1422+ 86D5 29               add  hl, hl            ; *16
1423+ 86D6 29               add  hl, hl            ; *32
1424+ 86D7
1425+ 86D7 79               ld   a, c              ; A = Colonna
1426+ 86D8
1427+ 86D8 85               add  a, l
1428+ 86D9 6F               ld   l, a
1429+ 86DA
1430+ 86DA 30 01            jr   nc, .no_carry
1431+ 86DC 24               inc  h
1432+ 86DD
1433+ 86DD              .no_carry:
1434+ 86DD
1435+ 86DD                  ; HL = Row * 32 + Col
1436+ 86DD
1437+ 86DD 11 00 58         ld   de, $5800
1438+ 86E0 19               add  hl, de            ; HL = indirizzo attributi
1439+ 86E1
1440+ 86E1                  ; ---------------------------------------------------------------
1441+ 86E1                  ; Recupera il colore originale dallo stack.
1442+ 86E1                  ;
1443+ 86E1                  ; Layout stack:
1444+ 86E1                  ;   HL originale
1445+ 86E1                  ;   DE originale (E = colore)
1446+ 86E1                  ;   BC originale
1447+ 86E1                  ; ---------------------------------------------------------------
1448+ 86E1
1449+ 86E1 C1               pop  bc                ; Recupera HL originale
1450+ 86E2 D1               pop  de                ; Recupera DE originale
1451+ 86E3
1452+ 86E3                  ; ---------------------------------------------------------------
1453+ 86E3                  ; Scrive l'attributo colore
1454+ 86E3                  ; ---------------------------------------------------------------
1455+ 86E3
1456+ 86E3 7B               ld   a, e              ; A = colore
1457+ 86E4 77               ld   (hl), a           ; Scrive nella RAM attributi
1458+ 86E5
1459+ 86E5                  ; ---------------------------------------------------------------
1460+ 86E5                  ; Ripristina HL e BC originali
1461+ 86E5                  ; ---------------------------------------------------------------
1462+ 86E5
1463+ 86E5 C5               push bc
1464+ 86E6 E1               pop  hl                ; HL originale
1465+ 86E7
1466+ 86E7 C1               pop  bc                ; BC originale
1467+ 86E8
1468+ 86E8 C9               ret
1469+ 86E9
1470+ 86E9              ; -------------------------------------------------------------------
1471+ 86E9              ; RestoreBackgroundCell
1472+ 86E9              ;
1473+ 86E9              ; Ripristina il contenuto originale di una cella della stanza.
1474+ 86E9              ; Viene utilizzata principalmente quando un item viene raccolto:
1475+ 86E9              ; invece di lasciare un "buco", la routine ridisegna il tile
1476+ 86E9              ; originale presente nella mappa della stanza.
1477+ 86E9              ;
1478+ 86E9              ; Input:
1479+ 86E9              ;   B = Row (3..18)
1480+ 86E9              ;   C = Col (0..31)
1481+ 86E9              ;
1482+ 86E9              ; Utilizza:
1483+ 86E9              ;   room_ptr -> struttura dati della stanza corrente
1484+ 86E9              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1485+ 86E9              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1486+ 86E9              ;
1487+ 86E9              ; Tipi di cella:
1488+ 86E9              ;   0 = Background
1489+ 86E9              ;   1 = Floor
1490+ 86E9              ;   2 = Wall
1491+ 86E9              ;   3 = Nasty
1492+ 86E9              ; -------------------------------------------------------------------
1493+ 86E9              RestoreBackgroundCell:
1494+ 86E9
1495+ 86E9                  ; Salva tutti i registri utilizzati
1496+ 86E9 FD E5            push iy
1497+ 86EB C5               push bc
1498+ 86EC D5               push de
1499+ 86ED E5               push hl
1500+ 86EE DD E5            push ix
1501+ 86F0
1502+ 86F0                  ; ---------------------------------------------------------------
1503+ 86F0                  ; Conserva Row e Col in IY.
1504+ 86F0                  ;
1505+ 86F0                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1506+ 86F0                  ; BC potrebbe essere modificato.
1507+ 86F0                  ; ---------------------------------------------------------------
1508+ 86F0 C5               push bc
1509+ 86F1 FD E1            pop  iy                ; IYH = Row, IYL = Col
1510+ 86F3
1511+ 86F3                  ; ---------------------------------------------------------------
1512+ 86F3                  ; Determina quale tipo di cella è presente nella posizione
1513+ 86F3                  ; specificata.
1514+ 86F3                  ;
1515+ 86F3                  ; Input:
1516+ 86F3                  ;   B = Row
1517+ 86F3                  ;   C = Col
1518+ 86F3                  ;
1519+ 86F3                  ; Output:
1520+ 86F3                  ;   A = tipo cella
1521+ 86F3                  ; ---------------------------------------------------------------
1522+ 86F3 78               ld   a, b
1523+ 86F4
1524+ 86F4 CD 8E 77         call GetCellFromUnpacked
1525+ 86F7
1526+ 86F7                  ; ---------------------------------------------------------------
1527+ 86F7                  ; Recupera il puntatore alla stanza corrente.
1528+ 86F7                  ;
1529+ 86F7                  ; DE = base della struttura stanza
1530+ 86F7                  ; ---------------------------------------------------------------
1531+ 86F7 ED 5B D7 F7      ld   de, (room_ptr)
1532+ 86FB
1533+ 86FB                  ; ---------------------------------------------------------------
1534+ 86FB                  ; Seleziona il tile corretto in base al tipo di cella.
1535+ 86FB                  ;
1536+ 86FB                  ; A = 0 -> Background
1537+ 86FB                  ; A = 1 -> Floor
1538+ 86FB                  ; A = 2 -> Wall
1539+ 86FB                  ; A = 3 -> Nasty
1540+ 86FB                  ; ---------------------------------------------------------------
1541+ 86FB
1542+ 86FB B7               or   a
1543+ 86FC 20 06            jr   nz, .not_bg
1544+ 86FE
1545+ 86FE                  ; Background
1546+ 86FE 21 A0 00         ld   hl, OFFSET_BG
1547+ 8701 19               add  hl, de
1548+ 8702 18 16            jr   .draw_cell
1549+ 8704
1550+ 8704              .not_bg:
1551+ 8704
1552+ 8704 3D               dec  a
1553+ 8705 20 06            jr   nz, .not_floor
1554+ 8707
1555+ 8707                  ; Floor
1556+ 8707 21 A9 00         ld   hl, OFFSET_FLOOR
1557+ 870A 19               add  hl, de
1558+ 870B 18 0D            jr   .draw_cell
1559+ 870D
1560+ 870D              .not_floor:
1561+ 870D
1562+ 870D 3D               dec  a
1563+ 870E 20 06            jr   nz, .not_wall
1564+ 8710
1565+ 8710                  ; Wall
1566+ 8710 21 B2 00         ld   hl, OFFSET_WALL
1567+ 8713 19               add  hl, de
1568+ 8714 18 04            jr   .draw_cell
1569+ 8716
1570+ 8716              .not_wall:
1571+ 8716
1572+ 8716                  ; Nasty
1573+ 8716 21 BB 00         ld   hl, OFFSET_NASTY
1574+ 8719 19               add  hl, de
1575+ 871A
1576+ 871A              .draw_cell:
1577+ 871A
1578+ 871A                  ; ---------------------------------------------------------------
1579+ 871A                  ; HL punta ora alla grafica del tile da ridisegnare.
1580+ 871A                  ;
1581+ 871A                  ; Gfx_DrawTile si aspetta:
1582+ 871A                  ;   IX = puntatore tile
1583+ 871A                  ;   B  = Row
1584+ 871A                  ;   C  = Col
1585+ 871A                  ; ---------------------------------------------------------------
1586+ 871A E5               push hl
1587+ 871B DD E1            pop  ix
1588+ 871D
1589+ 871D                  ; Ripristina Row e Col salvati in IY
1590+ 871D FD E5            push iy
1591+ 871F C1               pop  bc
1592+ 8720
1593+ 8720                  ; Disegna il tile originale
1594+ 8720 CD 5D 6A         call Gfx_DrawTile
1595+ 8723
1596+ 8723                  ; ---------------------------------------------------------------
1597+ 8723                  ; Ripristina i registri salvati
1598+ 8723                  ; ---------------------------------------------------------------
1599+ 8723 DD E1            pop  ix
1600+ 8725 E1               pop  hl
1601+ 8726 D1               pop  de
1602+ 8727 C1               pop  bc
1603+ 8728 FD E1            pop  iy
1604+ 872A
1605+ 872A C9               ret
1606+ 872B
1607+ 872B              ; -------------------------------------------------------------------
1608+ 872B              ; CheckWillyItemCollision
1609+ 872B              ;
1610+ 872B              ; Verifica se Willy collide con un item utilizzando il controllo
1611+ 872B              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1612+ 872B              ;
1613+ 872B              ; Input:
1614+ 872B              ;   A = ItemX (colonna attributi 0..31)
1615+ 872B              ;   H = ItemY (riga attributi 3..18)
1616+ 872B              ;
1617+ 872B              ; Coordinate item:
1618+ 872B              ;   Ogni item occupa una cella da 8x8 pixel.
1619+ 872B              ;
1620+ 872B              ; Coordinate Willy:
1621+ 872B              ;   Willy occupa un rettangolo di 16x16 pixel.
1622+ 872B              ;
1623+ 872B              ; Output:
1624+ 872B              ;   Carry Set   = collisione rilevata
1625+ 872B              ;   Carry Clear = nessuna collisione
1626+ 872B              ;
1627+ 872B              ; Registri preservati:
1628+ 872B              ;   BC, DE, HL
1629+ 872B              ; -------------------------------------------------------------------
1630+ 872B              CheckWillyItemCollision:
1631+ 872B
1632+ 872B                  ; Salva i registri utilizzati
1633+ 872B C5               push bc
1634+ 872C D5               push de
1635+ 872D E5               push hl
1636+ 872E
1637+ 872E                  ; ---------------------------------------------------------------
1638+ 872E                  ; Calcola il bounding box orizzontale dell'item
1639+ 872E                  ;
1640+ 872E                  ; ItemLeft  = ItemX * 8
1641+ 872E                  ; ItemRight = ItemLeft + 7
1642+ 872E                  ;
1643+ 872E                  ; E = ItemLeft
1644+ 872E                  ; D = ItemRight
1645+ 872E                  ; ---------------------------------------------------------------
1646+ 872E 6F               ld   l, a              ; L = ItemX
1647+ 872F
1648+ 872F 7D               ld   a, l
1649+ 8730 87               add  a, a              ; *2
1650+ 8731 87               add  a, a              ; *4
1651+ 8732 87               add  a, a              ; *8
1652+ 8733
1653+ 8733 5F               ld   e, a              ; E = ItemLeft
1654+ 8734
1655+ 8734 C6 07            add  a, 7
1656+ 8736 57               ld   d, a              ; D = ItemRight
1657+ 8737
1658+ 8737                  ; ---------------------------------------------------------------
1659+ 8737                  ; Recupera la posizione corrente di Willy
1660+ 8737                  ;
1661+ 8737                  ; B = WillyY
1662+ 8737                  ; C = WillyX
1663+ 8737                  ; ---------------------------------------------------------------
1664+ 8737 ED 4B 57 F4      ld   bc, (PlayerPos)
1665+ 873B
1666+ 873B                  ; ---------------------------------------------------------------
1667+ 873B                  ; Primo test:
1668+ 873B                  ;
1669+ 873B                  ; WillyLeft <= ItemRight
1670+ 873B                  ;
1671+ 873B                  ; Se Willy è completamente a destra dell'item
1672+ 873B                  ; non può esserci collisione.
1673+ 873B                  ; ---------------------------------------------------------------
1674+ 873B 79               ld   a, c              ; A = WillyLeft
1675+ 873C
1676+ 873C BA               cp   d                 ; WillyLeft vs ItemRight
1677+ 873D
1678+ 873D 28 04            jr   z, .x_ok
1679+ 873F 38 02            jr   c, .x_ok
1680+ 8741
1681+ 8741 18 29            jr   .no_collision
1682+ 8743
1683+ 8743              .x_ok:
1684+ 8743
1685+ 8743                  ; ---------------------------------------------------------------
1686+ 8743                  ; Secondo test:
1687+ 8743                  ;
1688+ 8743                  ; WillyRight >= ItemLeft
1689+ 8743                  ;
1690+ 8743                  ; WillyRight = WillyX + 7
1691+ 8743                  ; ---------------------------------------------------------------
1692+ 8743 C6 07            add  a, 7
1693+ 8745
1694+ 8745 BB               cp   e                 ; WillyRight vs ItemLeft
1695+ 8746
1696+ 8746 28 04            jr   z, .y_check
1697+ 8748 30 02            jr   nc, .y_check
1698+ 874A
1699+ 874A 18 20            jr   .no_collision
1700+ 874C
1701+ 874C              .y_check:
1702+ 874C
1703+ 874C                  ; ---------------------------------------------------------------
1704+ 874C                  ; Recupera ItemY dal valore originale di HL
1705+ 874C                  ;
1706+ 874C                  ; H contiene la riga dell'item.
1707+ 874C                  ; ---------------------------------------------------------------
1708+ 874C E1               pop  hl
1709+ 874D E5               push hl
1710+ 874E
1711+ 874E                  ; ---------------------------------------------------------------
1712+ 874E                  ; Calcola il bounding box verticale dell'item
1713+ 874E                  ;
1714+ 874E                  ; ItemTop    = ItemY * 8
1715+ 874E                  ; ItemBottom = ItemTop + 7
1716+ 874E                  ;
1717+ 874E                  ; E = ItemTop
1718+ 874E                  ; D = ItemBottom
1719+ 874E                  ; ---------------------------------------------------------------
1720+ 874E 7C               ld   a, h
1721+ 874F
1722+ 874F 87               add  a, a              ; *2
1723+ 8750 87               add  a, a              ; *4
1724+ 8751 87               add  a, a              ; *8
1725+ 8752
1726+ 8752 5F               ld   e, a              ; ItemTop
1727+ 8753
1728+ 8753 C6 07            add  a, 7
1729+ 8755 57               ld   d, a              ; ItemBottom
1730+ 8756
1731+ 8756                  ; ---------------------------------------------------------------
1732+ 8756                  ; Primo test verticale:
1733+ 8756                  ;
1734+ 8756                  ; WillyTop <= ItemBottom
1735+ 8756                  ; ---------------------------------------------------------------
1736+ 8756 78               ld   a, b              ; WillyTop
1737+ 8757
1738+ 8757 BA               cp   d
1739+ 8758
1740+ 8758 28 04            jr   z, .y_ok
1741+ 875A 38 02            jr   c, .y_ok
1742+ 875C
1743+ 875C 18 0E            jr   .no_collision
1744+ 875E
1745+ 875E              .y_ok:
1746+ 875E
1747+ 875E                  ; ---------------------------------------------------------------
1748+ 875E                  ; Secondo test verticale:
1749+ 875E                  ;
1750+ 875E                  ; WillyBottom >= ItemTop
1751+ 875E                  ;
1752+ 875E                  ; WillyBottom = WillyY + 15
1753+ 875E                  ; ---------------------------------------------------------------
1754+ 875E C6 0F            add  a, 15
1755+ 8760
1756+ 8760 BB               cp   e
1757+ 8761
1758+ 8761 28 04            jr   z, .collision
1759+ 8763 30 02            jr   nc, .collision
1760+ 8765
1761+ 8765 18 05            jr   .no_collision
1762+ 8767
1763+ 8767              .collision:
1764+ 8767
1765+ 8767                  ; ---------------------------------------------------------------
1766+ 8767                  ; Collisione rilevata
1767+ 8767                  ; ---------------------------------------------------------------
1768+ 8767 E1               pop  hl
1769+ 8768 D1               pop  de
1770+ 8769 C1               pop  bc
1771+ 876A
1772+ 876A 37               scf                    ; Carry = 1
1773+ 876B
1774+ 876B C9               ret
1775+ 876C
1776+ 876C              .no_collision:
1777+ 876C
1778+ 876C                  ; ---------------------------------------------------------------
1779+ 876C                  ; Nessuna collisione
1780+ 876C                  ; ---------------------------------------------------------------
1781+ 876C E1               pop  hl
1782+ 876D D1               pop  de
1783+ 876E C1               pop  bc
1784+ 876F
1785+ 876F B7               or   a                 ; Carry = 0
1786+ 8770
1787+ 8770 C9               ret
1788+ 8771
1789+ 8771              ; -------------------------------------------------------------------
1790+ 8771              ; Items_CheckCollision
1791+ 8771              ;
1792+ 8771              ; Controlla se Willy entra in collisione con uno degli item
1793+ 8771              ; attivi presenti nella stanza corrente.
1794+ 8771              ;
1795+ 8771              ; Per ogni item:
1796+ 8771              ;   - verifica che appartenga alla stanza corrente
1797+ 8771              ;   - verifica che non sia già stato raccolto
1798+ 8771              ;   - esegue il test di collisione con Willy
1799+ 8771              ;
1800+ 8771              ; Se l'item viene raccolto:
1801+ 8771              ;   - imposta il flag "collected"
1802+ 8771              ;   - rimuove l'item dalla cache items_grid
1803+ 8771              ;   - incrementa il contatore degli oggetti raccolti
1804+ 8771              ;   - aggiorna l'HUD
1805+ 8771              ;   - ripristina il tile di sfondo
1806+ 8771              ;   - riproduce il suono di raccolta
1807+ 8771              ;
1808+ 8771              ; Formato record ItemsTable:
1809+ 8771              ;   +0 RoomID
1810+ 8771              ;   +1 X
1811+ 8771              ;   +2 Y
1812+ 8771              ;   +3 Color
1813+ 8771              ;   +4 Collected
1814+ 8771              ;
1815+ 8771              ; Fine tabella:
1816+ 8771              ;   RoomID = $FF
1817+ 8771              ; -------------------------------------------------------------------
1818+ 8771              Items_CheckCollision:
1819+ 8771
1820+ 8771                  ; Salva i registri utilizzati
1821+ 8771 E5               push hl
1822+ 8772 D5               push de
1823+ 8773 C5               push bc
1824+ 8774
1825+ 8774                  ; Inizio scansione della tabella degli item
1826+ 8774 21 BC 80         ld   hl, ItemsTable
1827+ 8777
1828+ 8777              .loop:
1829+ 8777
1830+ 8777                  ; ---------------------------------------------------------------
1831+ 8777                  ; Legge il Room ID dell'item corrente
1832+ 8777                  ; ---------------------------------------------------------------
1833+ 8777 7E               ld   a, (hl)
1834+ 8778
1835+ 8778                  ; $FF indica fine tabella
1836+ 8778 FE FF            cp   $FF
1837+ 877A 28 58            jr   z, .done
1838+ 877C
1839+ 877C                  ; ---------------------------------------------------------------
1840+ 877C                  ; Verifica se l'item appartiene alla stanza corrente
1841+ 877C                  ; ---------------------------------------------------------------
1842+ 877C 57               ld   d, a              ; D = RoomID item
1843+ 877D
1844+ 877D 3A 7D F7         ld   a, (current_room)
1845+ 8780 BA               cp   d
1846+ 8781
1847+ 8781                  ; Se appartiene a un'altra stanza salta il record
1848+ 8781 20 4A            jr   nz, .next_item
1849+ 8783
1850+ 8783                  ; ---------------------------------------------------------------
1851+ 8783                  ; Legge coordinate e stato dell'item
1852+ 8783                  ; ---------------------------------------------------------------
1853+ 8783
1854+ 8783 23               inc  hl
1855+ 8784 4E               ld   c, (hl)           ; C = X
1856+ 8785
1857+ 8785 23               inc  hl
1858+ 8786 46               ld   b, (hl)           ; B = Y
1859+ 8787
1860+ 8787 23               inc  hl                ; salta Color
1861+ 8788
1862+ 8788 23               inc  hl                ; punta a Collected
1863+ 8789
1864+ 8789 7E               ld   a, (hl)
1865+ 878A
1866+ 878A                  ; ---------------------------------------------------------------
