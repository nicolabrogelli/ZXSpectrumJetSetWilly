 188+ 823E              TOTAL_ITEMS: EQU (ItemsTableEnd - ItemsTable) / 5
 189+ 823E
 190+ 823E
 191+ 823E              ; -------------------------------------------------------------------
 192+ 823E              ; DetermineCurrentRoomID
 193+ 823E              ;
 194+ 823E              ; Determina l'ID numerico della stanza corrente confrontando
 195+ 823E              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 196+ 823E              ;
 197+ 823E              ; Se viene trovata una corrispondenza:
 198+ 823E              ;   A = ID della stanza
 199+ 823E              ;   current_room = A
 200+ 823E              ;
 201+ 823E              ; Mappatura:
 202+ 823E              ;    0 = The Off Licence
 203+ 823E              ;    1 = The Bridge
 204+ 823E              ;    2 = Under The Mega Tree
 205+ 823E              ;    3 = Gfx_At The Foot Of The Mega Tree
 206+ 823E              ;    4 = The Drive
 207+ 823E              ;    5 = The Security Guard
 208+ 823E              ;    6 = Entrance To Hades
