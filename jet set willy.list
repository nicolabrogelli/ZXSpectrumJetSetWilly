   6+ 743E              ; Tabella Globale degli Oggetti (Items)
   7+ 743E              ; Ciascun item occupa 5 byte:
   8+ 743E              ;   Byte 0: ID della stanza (0 = Test Room, 1 = The Bridge, 2 = The Off Licence)
   9+ 743E              ;   Byte 1: X colonna dello schermo (0..31)
  10+ 743E              ;   Byte 2: Y riga dello schermo (3..18)
  11+ 743E              ;   Byte 3: Attributo colore (es. $C6 per Giallo Flashing, $C5 per Cyan Flashing)
  12+ 743E              ;   Byte 4: Stato (0 = Attivo/Non raccolto, 1 = Raccolto)
  13+ 743E              ; La tabella termina con $FF
  14+ 743E              ; -------------------------------------------------------------------
  15+ 743E              ItemsTable:
  16+ 743E                  ; Stanza 2 (The Off Licence)
  17+ 743E 02 1E 07 06      db 2, 30, 7, 6, 0               ; Oggetto 1 alla colonna X=30, riga Y=7 (Stato: 0=attivo)
  17+ 7442 00
  18+ 7443 02 1D 07 05      db 2, 29, 7, 5, 0               ; Oggetto 2 alla colonna X=10, riga Y=7
