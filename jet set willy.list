 366+ 5F5E
 367+ 5F5E                  ; 1. Salva la coordinata X per calcolare lo shift
 368+ 5F5E 79               ld   a, c
 369+ 5F5F E6 07            and  7
 370+ 5F61 32 71 76         ld   (sprite_shift), a
 371+ 5F64
 372+ 5F64                  ; 2. Calcola indirizzo schermo
 373+ 5F64 60               ld   h, b
