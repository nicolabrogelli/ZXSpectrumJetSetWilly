 856+ 7A32 28 2A            jr   z, .canguro_anim
 857+ 7A34 FE 0B            cp   11                ; Tipo 11 = Soldato?
 858+ 7A36 28 1B            jr   z, .soldato_anim
 859+ 7A38 FE 10            cp   16                ; Tipo 16 = Candelabro?
 860+ 7A3A 28 17            jr   z, .soldato_anim
 861+ 7A3C FE 14            cp   20                ; Tipo 20 = Nonnino?
 862+ 7A3E 28 13            jr   z, .soldato_anim
 863+ 7A40 FE 15            cp   21                ; Tipo 21 = Parrucca?
 864+ 7A42 28 0F            jr   z, .soldato_anim
