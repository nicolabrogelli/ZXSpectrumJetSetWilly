 361+ 6B04              ; -------------------------------------------------------------------
 362+ 6B04              ; Controlla se Willy collide con un item (pixel-level check)
 363+ 6B04              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 364+ 6B04              ; Output: Carry set se collide, altrimenti clear
 365+ 6B04              ; -------------------------------------------------------------------
 366+ 6B04              CheckWillyItemCollision:
 367+ 6B04 C5               push bc
 368+ 6B05 D5               push de
 369+ 6B06 E5               push hl
 370+ 6B07
 371+ 6B07                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 372+ 6B07 6F               ld   l, a
 373+ 6B08 7D               ld   a, l
 374+ 6B09 87               add  a, a              ; *2
 375+ 6B0A 87               add  a, a              ; *4
 376+ 6B0B 87               add  a, a              ; *8
 377+ 6B0C 5F               ld   e, a              ; E = ItemLeft
 378+ 6B0D C6 07            add  a, 7
 379+ 6B0F 57               ld   d, a              ; D = ItemRight
 380+ 6B10
 381+ 6B10                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 382+ 6B10 ED 4B 67 76      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 383+ 6B14
 384+ 6B14                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 385+ 6B14 79               ld   a, c
 386+ 6B15 BA               cp   d
 387+ 6B16 28 04            jr   z, .x_ok
 388+ 6B18 38 02            jr   c, .x_ok
 389+ 6B1A 18 29            jr   .no_collision
 390+ 6B1C              .x_ok:
 391+ 6B1C C6 0F            add  a, 15
 392+ 6B1E BB               cp   e
 393+ 6B1F 28 04            jr   z, .y_check
 394+ 6B21 30 02            jr   nc, .y_check
 395+ 6B23 18 20            jr   .no_collision
 396+ 6B25
 397+ 6B25              .y_check:
 398+ 6B25 E1               pop  hl                ; Recupera HL originale (H = ItemY)
 399+ 6B26 E5               push hl
 400+ 6B27 7C               ld   a, h
 401+ 6B28 87               add  a, a              ; *2
 402+ 6B29 87               add  a, a              ; *4
 403+ 6B2A 87               add  a, a              ; *8
 404+ 6B2B 5F               ld   e, a              ; E = ItemTop
 405+ 6B2C C6 07            add  a, 7
 406+ 6B2E 57               ld   d, a              ; D = ItemBottom
 407+ 6B2F
 408+ 6B2F                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 409+ 6B2F 78               ld   a, b
 410+ 6B30 BA               cp   d
 411+ 6B31 28 04            jr   z, .y_ok
 412+ 6B33 38 02            jr   c, .y_ok
 413+ 6B35 18 0E            jr   .no_collision
 414+ 6B37              .y_ok:
 415+ 6B37 C6 0F            add  a, 15
 416+ 6B39 BB               cp   e
 417+ 6B3A 28 04            jr   z, .collision
 418+ 6B3C 30 02            jr   nc, .collision
 419+ 6B3E 18 05            jr   .no_collision
 420+ 6B40
 421+ 6B40              .collision:
 422+ 6B40 E1               pop  hl
 423+ 6B41 D1               pop  de
 424+ 6B42 C1               pop  bc
 425+ 6B43 37               scf                    ; Set carry (collisione!)
 426+ 6B44 C9               ret
 427+ 6B45
 428+ 6B45              .no_collision:
 429+ 6B45 E1               pop  hl
 430+ 6B46 D1               pop  de
 431+ 6B47 C1               pop  bc
 432+ 6B48 B7               or   a                 ; Clear carry
 433+ 6B49 C9               ret
