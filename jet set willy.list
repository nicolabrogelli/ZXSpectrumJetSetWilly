 179+ 8882              ; Audio_PlayCollectSound
 180+ 8882              ;
 181+ 8882              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 8882              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 8882              ; -------------------------------------------------------------------
 184+ 8882              Audio_PlayCollectSound:
 185+ 8882 C5               push bc
 186+ 8883 D5               push de
 187+ 8884
 188+ 8884 06 78            ld   b, 120
 189+ 8886              .sound_loop:
 190+ 8886 3A A2 F6         ld   a, (room_border_color)
 191+ 8889 F6 10            or   $10               ; speaker ON
 192+ 888B D3 FE            out  ($fe), a
 193+ 888D
 194+ 888D 0E 3C            ld   c, 60
 195+ 888F              .d1:
 196+ 888F 0D               dec  c
 197+ 8890 20 FD            jr   nz, .d1
 198+ 8892
 199+ 8892 3A A2 F6         ld   a, (room_border_color)
 200+ 8895 E6 EF            and  $ef              ; speaker OFF
 201+ 8897 D3 FE            out  ($fe), a
 202+ 8899
 203+ 8899 0E 3C            ld   c, 60
 204+ 889B              .d2:
 205+ 889B 0D               dec  c
 206+ 889C 20 FD            jr   nz, .d2
 207+ 889E
 208+ 889E 10 E6            djnz .sound_loop
 209+ 88A0
 210+ 88A0 D1               pop  de
 211+ 88A1 C1               pop  bc
 212+ 88A2 C9               ret
