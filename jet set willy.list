   7+ 651E              ; CheckCtrl
   8+ 651E              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 651E              ;
  10+ 651E              ; Output:
  11+ 651E              ;   D = bitmask tasti attivi:
  12+ 651E              ;       bit 0 → sinistra (O)
  13+ 651E              ;       bit 1 → destra   (P)
  14+ 651E              ;       bit 2 → salto    (Z)
  15+ 651E              ;
  16+ 651E              ; Effetti collaterali in RAM:
  17+ 651E              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 651E              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 651E              ;   (jump_prev)     → debounce tasto salto
  20+ 651E              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 651E              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 651E              ; -------------------------------------------------------------------
  23+ 651E
  24+ 651E              CheckCtrl:
  25+ 651E
  26+ 651E                  ; ── Sezione 1: tasto Q (cambio stanza) ──────────────────────────
  27+ 651E                  ;
  28+ 651E                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  29+ 651E                  ; Se bit 0 = 0, Q è premuto.
  30+ 651E
  31+ 651E 3E FB            ld   a, $fb
  32+ 6520 DB FE            in   a, ($fe)
  33+ 6522 CB 47            bit  0, a
  34+ 6524 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  35+ 6526
  36+ 6526                  ; Q è premuto: debounce tramite (q_prev).
  37+ 6526                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  38+ 6526 3A FA 72         ld   a, (q_prev)
  39+ 6529 B7               or   a
  40+ 652A 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  41+ 652C
  42+ 652C                  ; ── Primo frame di pressione di Q ──
  43+ 652C 3E 01            ld   a, 1
  44+ 652E 32 FA 72         ld   (q_prev), a            ; marca "Q era premuto"
  45+ 6531
  46+ 6531                  ; NOTA sullo stack:
  47+ 6531                  ; CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  48+ 6531                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChange senza
  49+ 6531                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  50+ 6531                  ; poi JP salta direttamente.
  51+ 6531 E1               pop  hl                     ; rimuove indirizzo di ritorno di CheckCtrl
  52+ 6532 C3 AB 65         jp   PerformRoomChange      ; salta al cambio stanza (non torna qui)
  53+ 6535
  54+ 6535              .q_not_pressed:
  55+ 6535 AF               xor  a
  56+ 6536 32 FA 72         ld   (q_prev), a            ; Q rilasciato → azzera debounce
  57+ 6539
  58+ 6539              .q_handled:
  59+ 6539
  60+ 6539                  ; ── Sezione 2: movimento (sinistra / destra) ────────────────────
  61+ 6539                  ;
  62+ 6539                  ; Porta $DF → riga P, O, I, U, Y.
  63+ 6539                  ; Bit 0 = P (destra), Bit 1 = O (sinistra).
  64+ 6539
  65+ 6539 16 00            ld  d, $00                  ; azzera output
  66+ 653B 3E DF            ld  a, $df
  67+ 653D DB FE            in  a, ($fe)                ; legge riga $FE
  68+ 653F
  69+ 653F                  ; Se Willy è sul conveyor nella stanza The Off Licence (room 0),
  70+ 653F                  ; impedisci lo spostamento da sinistra a destra (disabilita tasto destra P / bit 0).
  71+ 653F F5               push af
  72+ 6540 3A FD 75         ld   a, (current_room)
  73+ 6543 B7               or   a                      ; Room 0 = The Off Licence
  74+ 6544 20 09            jr   nz, .no_block_conveyor
  75+ 6546 CD 92 69         call CheckWillyOnConveyor
  76+ 6549 30 04            jr   nc, .no_block_conveyor
  77+ 654B F1               pop  af
  78+ 654C F6 01            or   $01                    ; Forza bit 0 (destra) a 1 (non premuto)
  79+ 654E F5               push af
  80+ 654F              .no_block_conveyor:
  81+ 654F F1               pop  af
  82+ 6550
  83+ 6550 DD 21 EF 72      ld  ix, flags               ; IX punta alla variabile flags
  84+ 6554
  85+ 6554              checkCtrl_left:
  86+ 6554 CB 4F            bit $01, a                  ; bit 1 = O → sinistra?
  87+ 6556 20 13            jr  nz, checkCtrl_right     ; bit = 1 → O non premuto, prova destra
  88+ 6558 CB C2            set $00, d                  ; imposta bit 0 di D = "sinistra attiva"
  89+ 655A DD CB 00 C6      set 0, (ix)                 ; flags bit 0 = "movimento in corso"
  90+ 655E 5F               ld  e, a                    ; salva A
  91+ 655F 3A F5 72         ld  a, (on_ground)
  92+ 6562 B7               or  a
  93+ 6563 28 05            jr  z, .skip_dir_left
  94+ 6565 3E 01            ld  a, 1
  95+ 6567 32 EE 72         ld  (direction), a          ; direction = 1 → sinistra
  96+ 656A              .skip_dir_left:
  97+ 656A 7B               ld  a, e                    ; ripristina A
  98+ 656B
  99+ 656B              checkCtrl_right:
 100+ 656B CB 47            bit $00, a                  ; bit 0 = P → destra?
 101+ 656D 20 13            jr  nz, checkCtrl_jump      ; bit = 1 → P non premuto, prova salto
 102+ 656F CB CA            set $01, d                  ; imposta bit 1 di D = "destra attiva"
 103+ 6571 DD CB 00 C6      set 0, (ix)                 ; flags bit 0 = "movimento in corso"
 104+ 6575 5F               ld  e, a
 105+ 6576 3A F5 72         ld  a, (on_ground)
 106+ 6579 B7               or  a
 107+ 657A 28 05            jr  z, .skip_dir_right
 108+ 657C 3E 02            ld  a, 2
 109+ 657E 32 EE 72         ld  (direction), a          ; direction = 2 → destra
 110+ 6581              .skip_dir_right:
 111+ 6581 7B               ld  a, e
