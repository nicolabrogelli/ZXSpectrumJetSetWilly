 251  8973              .draw_raster_bars:
 252  8973                  ; Collisione attiva: disegna le raster bar nel bordo
 253  8973 3A 66 F4         ld   a, (counter)
 254  8976 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 255  8978 06 1E            ld   b, 30             ; Numero di righe della barra raster
 256  897A              .raster_loop:
 257  897A D3 FE            out  ($fe), a
 258  897C 3C               inc  a
 259  897D E6 07            and  7
 260  897F 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 261  8981              .delay:
 262  8981 0D               dec  c
 263  8982 20 FD            jr   nz, .delay
 264  8984 10 F4            djnz .raster_loop
 265  8986
 266  8986                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 267  8986 3A 51 F4         ld   a, (room_border_color)
 268  8989 D3 FE            out  ($fe), a
 269  898B 18 05            jr   .no_collision_change
 270  898D
 271  898D              .no_collision:
 272  898D                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 273  898D 3A 51 F4         ld   a, (room_border_color)
 274  8990 D3 FE            out  ($fe), a
