 842+ 7D68              ; Aggiorna le posizioni dei nemici attivi per il prossimo frame
 843+ 7D68              ; -------------------------------------------------------------------
 844+ 7D68              Enemy_Update:
 845+ 7D68 E5               push hl
 846+ 7D69 D5               push de
 847+ 7D6A C5               push bc
 848+ 7D6B DD E5            push ix
 849+ 7D6D
 850+ 7D6D                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 851+ 7D6D 3A 6C EE         ld   a, (enemy_update_rate)
 852+ 7D70 FE 01            cp   1
 853+ 7D72 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 854+ 7D74
 855+ 7D74 3A 6D EE         ld   a, (enemy_update_timer)
 856+ 7D77 3C               inc  a
 857+ 7D78 47               ld   b, a                      ; B = timer + 1
 858+ 7D79 3A 6C EE         ld   a, (enemy_update_rate)
 859+ 7D7C B8               cp   b
 860+ 7D7D 28 0C            jr   z, .reset_timer
 861+ 7D7F 38 0A            jr   c, .reset_timer
 862+ 7D81
 863+ 7D81                  ; Salva contatore incrementato e salta l'aggiornamento
 864+ 7D81 78               ld   a, b
 865+ 7D82 32 6D EE         ld   (enemy_update_timer), a
 866+ 7D85
 867+ 7D85              .skip_update:
 868+ 7D85 DD E1            pop  ix
 869+ 7D87 C1               pop  bc
 870+ 7D88 D1               pop  de
 871+ 7D89 E1               pop  hl
 872+ 7D8A C9               ret
 873+ 7D8B
 874+ 7D8B              .reset_timer:
