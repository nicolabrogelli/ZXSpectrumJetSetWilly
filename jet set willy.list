 504  8C25 32 F6 F7         ld   (velocity_y), a
 505  8C28 32 F8 F7         ld   (jump_pressed), a
 506  8C2B 32 FA F7         ld   (coyote_timer), a
 507  8C2E 32 FD F7         ld   (jump_frame), a
 508  8C31 32 FC F7         ld   (jump_dir), a
 509  8C34 32 EE F7         ld   (body_state), a
