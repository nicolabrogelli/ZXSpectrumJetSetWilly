1344+ 645D
1345+ 645D                  ; Check dei limiti ASCII (32..127) per non accedere a RAM fuori dal font
1346+ 645D 78               ld   a, b              ; A = carattere ASCII
1347+ 645E FE 20            cp   32
1348+ 6460 38 29            jr   c, .exit_draw_char ; Se CHAR < 32 (non stampabile), ignora!
