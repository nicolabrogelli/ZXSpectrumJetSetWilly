1242+ 75EF              ; -------------------------------------------------------------------
1243+ 75EF              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1244+ 75EF              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1245+ 75EF              ; -------------------------------------------------------------------
1246+ 75EF              UnpackRoomLayout:
1247+ 75EF E5               push hl
1248+ 75F0 D5               push de
1249+ 75F1 C5               push bc
1250+ 75F2
1251+ 75F2 2A 01 F0         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1252+ 75F5 11 A7 ED         ld   de, unpacked_layout ; DE = buffer RAM
1253+ 75F8 06 80            ld   b, 128             ; 128 byte
1254+ 75FA              .byte_loop:
1255+ 75FA 7E               ld   a, (hl)            ; Leggi byte compresso
1256+ 75FB 23               inc  hl
1257+ 75FC
1258+ 75FC 4F               ld   c, a               ; C = salvataggio
1259+ 75FD
1260+ 75FD                  ; Cella 0: bit 7-6
1261+ 75FD 07               rlca
1262+ 75FE 07               rlca
1263+ 75FF E6 03            and  3
1264+ 7601 12               ld   (de), a
1265+ 7602 13               inc  de
1266+ 7603
1267+ 7603                  ; Cella 1: bit 5-4
1268+ 7603 79               ld   a, c
1269+ 7604 07               rlca
1270+ 7605 07               rlca
1271+ 7606 07               rlca
