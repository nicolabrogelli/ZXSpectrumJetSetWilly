 608+ 6AB5              ; -------------------------------------------------------------------
 609+ 6AB5              ; Verifica la collisione tra player e nemico (bounding box a livello di pixel)
 610+ 6AB5              ; Output: Carry flag impostato se collisione, altrimenti resettato
 611+ 6AB5              ; -------------------------------------------------------------------
 612+ 6AB5              CheckCollision:
 613+ 6AB5 E5               push hl
 614+ 6AB6 D5               push de
 615+ 6AB7 C5               push bc
 616+ 6AB8 DD E5            push ix
 617+ 6ABA
 618+ 6ABA DD 21 66 6E      ld   ix, ActiveEnemies
 619+ 6ABE 06 08            ld   b, 8              ; 8 slot
 620+ 6AC0              .loop:
 621+ 6AC0 DD 7E 00         ld   a, (ix+0)         ; Flags
 622+ 6AC3 E6 80            and  $80               ; Active?
 623+ 6AC5 28 1F            jr   z, .next
 624+ 6AC7
 625+ 6AC7                  ; 1. Controllo orizzontale: PlayerX - EnemyX + 7 in [0, 22]
 626+ 6AC7 3A DC 7A         ld   a, (PlayerPos)    ; A = PlayerX
 627+ 6ACA DD 96 02         sub  (ix+2)            ; A = PlayerX - EnemyX (Offset 2: Current X)
 628+ 6ACD C6 07            add  a, 7              ; A = PlayerX - EnemyX + 7
 629+ 6ACF FE 17            cp   23                ; Se >= 23, nessuna collisione con questo
 630+ 6AD1 30 13            jr   nc, .next
 631+ 6AD3
 632+ 6AD3                  ; 2. Controllo verticale: PlayerY - EnemyY + 15 in [0, 30]
 633+ 6AD3 3A DD 7A         ld   a, (PlayerPos+1)  ; A = PlayerY
 634+ 6AD6 DD 96 03         sub  (ix+3)            ; A = PlayerY - EnemyY (Offset 3: Current Y)
 635+ 6AD9 C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 636+ 6ADB FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 637+ 6ADD 30 07            jr   nc, .next
 638+ 6ADF
 639+ 6ADF                  ; Collisione avvenuta!
