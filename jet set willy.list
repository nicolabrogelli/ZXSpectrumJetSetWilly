 977+ 7E3B DD BE 04         cp   (ix+4)            ; Min Limit (Top)
 978+ 7E3E 28 08            jr   z, .v_rev_down
 979+ 7E40 38 06            jr   c, .v_rev_down
 980+ 7E42 DD 77 03         ld   (ix+3), a
 981+ 7E45 C3 73 7E         jp   .next
 982+ 7E48
 983+ 7E48              .v_rev_down:
