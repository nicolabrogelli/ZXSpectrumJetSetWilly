 312+ 5F00
 313+ 5F00 50               ld   d, b          ; D = Y corrente
 314+ 5F01 79               ld   a, c
 315+ 5F02 E6 F8            and  $f8
 316+ 5F04 5F               ld   e, a          ; E = X del primo byte schermo in pixel
 317+ 5F05
 318+ 5F05 0E 08            ld   c, 8          ; 8 linee
