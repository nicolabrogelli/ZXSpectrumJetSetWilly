 173+ 5E74              ; -------------------------------------------------------------------
 174+ 5E74              ; Ripristina un byte dello sfondo statico.
 175+ 5E74              ; Input: A = X del byte schermo in pixel (0, 8, 16...), D = Y pixel
 176+ 5E74              ; Output: A = byte di sfondo
 177+ 5E74              ; ---------------------------------------------------------------
 178+ 5E74              Gfx_GetBackgroundByte:
 179+ 5E74 E5               push hl
 180+ 5E75 D5               push de
 181+ 5E76 C5               push bc
 182+ 5E77
 183+ 5E77 47               ld   b, a              ; B = X (pixel)
 184+ 5E78
 185+ 5E78                  ; 1. Controlla se Y (in D) è fuori dalla griglia di layout (Y >= 128)
 186+ 5E78 7A               ld   a, d
 187+ 5E79 FE 80            cp   128
 188+ 5E7B D2 43 5F         jp   nc, .blank
 189+ 5E7E
 190+ 5E7E                  ; Converti Y (in D) e X (in B) a cella
 191+ 5E7E CB 3F            srl  a
 192+ 5E80 CB 3F            srl  a
 193+ 5E82 CB 3F            srl  a                 ; A = layout row r (0..15)
 194+ 5E84 5F               ld   e, a              ; E = r (Row)
 195+ 5E85
 196+ 5E85 78               ld   a, b
 197+ 5E86 CB 3F            srl  a
 198+ 5E88 CB 3F            srl  a
 199+ 5E8A CB 3F            srl  a                 ; A = column c (0..31)
 200+ 5E8C 4F               ld   c, a              ; C = c (Col)
 201+ 5E8D
 202+ 5E8D                  ; --- Controlla se c'è un Item Attivo in questa cella ---
 203+ 5E8D D5               push de
 204+ 5E8E C5               push bc
 205+ 5E8F 41               ld   b, c              ; B = Col
 206+ 5E90 4B               ld   c, e              ; C = Row
 207+ 5E91 CD 02 7A         call CheckActiveItemAtCell
 208+ 5E94 30 17            jr   nc, .no_item
 209+ 5E96
 210+ 5E96 C1               pop  bc
 211+ 5E97 D1               pop  de
 212+ 5E98
 213+ 5E98 7A               ld   a, d
 214+ 5E99 E6 07            and  7                 ; A = scanline (0..7)
 215+ 5E9B 5F               ld   e, a
 216+ 5E9C 16 00            ld   d, 0              ; DE = scanline offset
 217+ 5E9E 2A B4 7E         ld   hl, (room_ptr)
