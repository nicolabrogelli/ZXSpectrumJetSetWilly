1064+ 6AFD              ; -------------------------------------------------------------------
1065+ 6AFD              ; Legge il tipo di cella dal buffer decompresso in RAM
1066+ 6AFD              ; Input: A = Row (0..15), C = Col (0..31)
1067+ 6AFD              ; Output: A = tipo di cella (0..3)
1068+ 6AFD              ; Preserva tutti gli altri registri.
1069+ 6AFD              ; -------------------------------------------------------------------
1070+ 6AFD              GetCellFromUnpacked:
1071+ 6AFD E5               push hl
1072+ 6AFE D5               push de
1073+ 6AFF
1074+ 6AFF 6F               ld   l, a
1075+ 6B00 26 00            ld   h, 0
1076+ 6B02 29               add  hl, hl
1077+ 6B03 29               add  hl, hl
1078+ 6B04 29               add  hl, hl
1079+ 6B05 29               add  hl, hl
1080+ 6B06 29               add  hl, hl            ; HL = Row * 32
1081+ 6B07 59               ld   e, c
1082+ 6B08 16 00            ld   d, 0
1083+ 6B0A 19               add  hl, de            ; HL = Row * 32 + Col
1084+ 6B0B 11 1C 74         ld   de, unpacked_layout
1085+ 6B0E 19               add  hl, de
1086+ 6B0F 7E               ld   a, (hl)           ; A = cell type
1087+ 6B10
1088+ 6B10 D1               pop  de
1089+ 6B11 E1               pop  hl
1090+ 6B12 C9               ret
