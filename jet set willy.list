  63+ 6F77              ; DetermineCurrentRoomID
  64+ 6F77              ;
  65+ 6F77              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 6F77              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 6F77              ;
  68+ 6F77              ; Se viene trovata una corrispondenza:
  69+ 6F77              ;   A = ID della stanza
  70+ 6F77              ;   current_room = A
  71+ 6F77              ;
  72+ 6F77              ; Mappatura:
  73+ 6F77              ;    0 = The Off Licence
  74+ 6F77              ;    1 = The Bridge
  75+ 6F77              ;    2 = Under The Mega Tree
  76+ 6F77              ;    3 = At The Foot Of The Mega Tree
  77+ 6F77              ;    4 = The Drive
  78+ 6F77              ;    5 = The Security Guard
  79+ 6F77              ;    6 = Entrance To Hades
  80+ 6F77              ;    7 = Cuckoo's Nest
  81+ 6F77              ;    8 = Inside The Mega Trunk
  82+ 6F77              ;    9 = On A Branch Over The Drive
  83+ 6F77              ;   10 = The Front Door
  84+ 6F77              ;   11 = The Hall
  85+ 6F77              ;   12 = Tree Top
  86+ 6F77              ;   33 = The Bathroom
  87+ 6F77              ;   35 = Master Bedroom
  88+ 6F77              ;
  89+ 6F77              ; Se nessuna stanza corrisponde viene impostato:
  90+ 6F77              ;   current_room = 0
  91+ 6F77              ; -------------------------------------------------------------------
