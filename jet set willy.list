   7+ 865E              ; -------------------------------------------------------------------
   8+ 865E              ; Audio_UpdateJumpSound
   9+ 865E              ;
  10+ 865E              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 865E              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 865E              ; -------------------------------------------------------------------
  13+ 865E              Audio_UpdateJumpSound:
  14+ 865E F5               push af
  15+ 865F C5               push bc
  16+ 8660 D5               push de
  17+ 8661 E5               push hl
  18+ 8662
  19+ 8662                  ; Controlla se il suono è attivo (note < 18)
  20+ 8662 3A 94 F0         ld   a, (Audio_jump_sound_note)
  21+ 8665 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8667 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8669
  24+ 8669                  ; Carica la nota corrente da suonare
  25+ 8669 5F               ld   e, a
  26+ 866A 16 00            ld   d, 0
  27+ 866C 21 98 86         ld   hl, Audio_JumpSoundDelays
  28+ 866F 19               add  hl, de
  29+ 8670 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8671 57               ld   d, a                      ; D = delay della nota
  31+ 8672
  32+ 8672                  ; Suona la nota: 15 cicli
  33+ 8672 06 0F            ld   b, 15
  34+ 8674              .note_loop:
  35+ 8674                  ; Speaker ON
  36+ 8674 3A 8D EC         ld   a, (room_border_color)
  37+ 8677 F6 10            or   $10
  38+ 8679 D3 FE            out  ($fe), a
  39+ 867B 4A               ld   c, d
  40+ 867C              .d1:
  41+ 867C 0D               dec  c
  42+ 867D 20 FD            jr   nz, .d1
  43+ 867F
  44+ 867F                  ; Speaker OFF
  45+ 867F 3A 8D EC         ld   a, (room_border_color)
  46+ 8682 E6 EF            and  $ef
  47+ 8684 D3 FE            out  ($fe), a
  48+ 8686 4A               ld   c, d
  49+ 8687              .d2:
  50+ 8687 0D               dec  c
  51+ 8688 20 FD            jr   nz, .d2
  52+ 868A
  53+ 868A 10 E8            djnz .note_loop
  54+ 868C
  55+ 868C                  ; Passa alla nota successiva
  56+ 868C 3A 94 F0         ld   a, (Audio_jump_sound_note)
  57+ 868F 3C               inc  a
  58+ 8690 32 94 F0         ld   (Audio_jump_sound_note), a
  59+ 8693
  60+ 8693              .done:
  61+ 8693 E1               pop  hl
  62+ 8694 D1               pop  de
  63+ 8695 C1               pop  bc
  64+ 8696 F1               pop  af
  65+ 8697 C9               ret
  66+ 8698
  67+ 8698              Audio_JumpSoundDelays:
  68+ 8698 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 869C 19 13 0C 06
  68+ 86A0 0C 13 19 20
  68+ 86A4 26 2D 33 3A
  68+ 86A8 40 47
  69+ 86AA
  70+ 86AA                  IF ENABLE_MUSIC != 0
  71+ 86AA ~            ; -------------------------------------------------------------------
  72+ 86AA ~            ; Audio_UpdateMusic
  73+ 86AA ~            ;
  74+ 86AA ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 86AA ~            ; Viene chiamata a ogni frame.
  76+ 86AA ~            ; -------------------------------------------------------------------
  77+ 86AA ~            Audio_UpdateMusic:
  78+ 86AA ~                push af
  79+ 86AA ~                push bc
  80+ 86AA ~                push de
  81+ 86AA ~                push hl
  82+ 86AA ~
  83+ 86AA ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 86AA ~                ld   a, (Audio_jump_sound_note)
  85+ 86AA ~                cp   18
  86+ 86AA ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 86AA ~
  88+ 86AA ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 86AA ~                ld   a, (Audio_music_frame_counter)
  90+ 86AA ~                dec  a
  91+ 86AA ~                ld   (Audio_music_frame_counter), a
  92+ 86AA ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 86AA ~
  94+ 86AA ~                ; Altrimenti carica la nota successiva
  95+ 86AA ~                ld   a, (Audio_music_note_idx)
  96+ 86AA ~                inc  a
  97+ 86AA ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 86AA ~                jr   c, .no_wrap
  99+ 86AA ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 86AA ~            .no_wrap:
 101+ 86AA ~                ld   (Audio_music_note_idx), a
 102+ 86AA ~
 103+ 86AA ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 86AA ~                ld   e, a
 105+ 86AA ~                ld   d, 0
 106+ 86AA ~                ld   hl, Audio_MusicSheet
 107+ 86AA ~                add  hl, de
 108+ 86AA ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 86AA ~
 110+ 86AA ~                ; Leggi durata (secondo byte)
 111+ 86AA ~                inc  hl
 112+ 86AA ~                ld   a, (hl)
 113+ 86AA ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 86AA ~                jr   nz, .dur_ok
 115+ 86AA ~                ld   a, 1
 116+ 86AA ~            .dur_ok:
 117+ 86AA ~                ld   (Audio_music_frame_counter), a
 118+ 86AA ~
 119+ 86AA ~            .play_current_note:
 120+ 86AA ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 86AA ~                ld   a, (Audio_music_note_idx)
 122+ 86AA ~                ld   e, a
 123+ 86AA ~                ld   d, 0
 124+ 86AA ~                ld   hl, Audio_MusicSheet
 125+ 86AA ~                add  hl, de
 126+ 86AA ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 86AA ~                ld   a, (hl)                  ; A = delay
 128+ 86AA ~                or   a
 129+ 86AA ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 86AA ~
 131+ 86AA ~                ; Suona la nota: 2 cicli
 132+ 86AA ~                ld   d, a                     ; D = delay
 133+ 86AA ~                ld   b, 2                     ; 2 cicli per frame
 134+ 86AA ~            .note_loop:
 135+ 86AA ~                ; Speaker ON
 136+ 86AA ~                ld   a, (room_border_color)
 137+ 86AA ~                or   $10
 138+ 86AA ~                out  ($fe), a
 139+ 86AA ~                ld   c, d
 140+ 86AA ~            .d1:
 141+ 86AA ~                push af
 142+ 86AA ~                pop  af
 143+ 86AA ~                dec  c
 144+ 86AA ~                jr   nz, .d1
 145+ 86AA ~
 146+ 86AA ~                ; Speaker OFF
 147+ 86AA ~                ld   a, (room_border_color)
 148+ 86AA ~                and  $ef
 149+ 86AA ~                out  ($fe), a
 150+ 86AA ~                ld   c, d
 151+ 86AA ~            .d2:
 152+ 86AA ~                push af
 153+ 86AA ~                pop  af
 154+ 86AA ~                dec  c
 155+ 86AA ~                jr   nz, .d2
 156+ 86AA ~
 157+ 86AA ~                djnz .note_loop
 158+ 86AA ~
 159+ 86AA ~            .done:
 160+ 86AA ~                pop  hl
 161+ 86AA ~                pop  de
 162+ 86AA ~                pop  bc
 163+ 86AA ~                pop  af
 164+ 86AA ~                ret
 165+ 86AA ~
 166+ 86AA ~            Audio_MusicSheet:
 167+ 86AA ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 86AA ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 86AA ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 86AA ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 86AA ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 86AA ~                db 90, 10, 107, 20, 68, 65
 173+ 86AA                  ELSE
 174+ 86AA              Audio_UpdateMusic:
 175+ 86AA C9               ret
 176+ 86AB                  ENDIF
