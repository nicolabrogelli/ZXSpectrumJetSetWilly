 221  817E              .draw_raster_bars:
 222  817E                  ; Collisione attiva: disegna le raster bar nel bordo
 223  817E 3A 47 E6         ld   a, (counter)
 224  8181 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 225  8183 06 1E            ld   b, 30             ; Numero di righe della barra raster
 226  8185              .raster_loop:
 227  8185 D3 FE            out  ($fe), a
 228  8187 3C               inc  a
 229  8188 E6 07            and  7
 230  818A 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 231  818C              .delay:
 232  818C 0D               dec  c
 233  818D 20 FD            jr   nz, .delay
 234  818F 10 F4            djnz .raster_loop
