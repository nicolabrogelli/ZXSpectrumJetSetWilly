 323+ 754B              ; -------------------------------------------------------------------
 324+ 754B              ; Controlla se Willy collide con un item (pixel-level check)
 325+ 754B              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 326+ 754B              ; Output: Carry set se collide, altrimenti clear
 327+ 754B              ; -------------------------------------------------------------------
 328+ 754B              CheckWillyItemCollision:
 329+ 754B C5               push bc
 330+ 754C D5               push de
 331+ 754D E5               push hl
 332+ 754E
 333+ 754E                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 334+ 754E 6F               ld   l, a
 335+ 754F 7D               ld   a, l
 336+ 7550 87               add  a, a              ; *2
 337+ 7551 87               add  a, a              ; *4
 338+ 7552 87               add  a, a              ; *8
 339+ 7553 5F               ld   e, a              ; E = ItemLeft
 340+ 7554 C6 07            add  a, 7
 341+ 7556 57               ld   d, a              ; D = ItemRight
 342+ 7557
 343+ 7557                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 344+ 7557 ED 4B 8B 76      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 345+ 755B
 346+ 755B                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 347+ 755B 79               ld   a, c
 348+ 755C BA               cp   d
 349+ 755D 28 04            jr   z, .x_ok
 350+ 755F 38 02            jr   c, .x_ok
 351+ 7561 18 29            jr   .no_collision
 352+ 7563              .x_ok:
 353+ 7563 C6 0F            add  a, 15
 354+ 7565 BB               cp   e
 355+ 7566 28 04            jr   z, .y_check
 356+ 7568 30 02            jr   nc, .y_check
 357+ 756A 18 20            jr   .no_collision
 358+ 756C
 359+ 756C              .y_check:
 360+ 756C E1               pop  hl                ; Recupera HL originale (H = ItemY)
 361+ 756D E5               push hl
 362+ 756E 7C               ld   a, h
 363+ 756F 87               add  a, a              ; *2
 364+ 7570 87               add  a, a              ; *4
 365+ 7571 87               add  a, a              ; *8
 366+ 7572 5F               ld   e, a              ; E = ItemTop
 367+ 7573 C6 07            add  a, 7
 368+ 7575 57               ld   d, a              ; D = ItemBottom
 369+ 7576
 370+ 7576                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 371+ 7576 78               ld   a, b
 372+ 7577 BA               cp   d
 373+ 7578 28 04            jr   z, .y_ok
 374+ 757A 38 02            jr   c, .y_ok
 375+ 757C 18 0E            jr   .no_collision
 376+ 757E              .y_ok:
 377+ 757E C6 0F            add  a, 15
 378+ 7580 BB               cp   e
 379+ 7581 28 04            jr   z, .collision
 380+ 7583 30 02            jr   nc, .collision
 381+ 7585 18 05            jr   .no_collision
 382+ 7587
 383+ 7587              .collision:
 384+ 7587 E1               pop  hl
 385+ 7588 D1               pop  de
 386+ 7589 C1               pop  bc
 387+ 758A 37               scf                    ; Set carry (collisione!)
 388+ 758B C9               ret
 389+ 758C
 390+ 758C              .no_collision:
 391+ 758C E1               pop  hl
 392+ 758D D1               pop  de
 393+ 758E C1               pop  bc
 394+ 758F B7               or   a                 ; Clear carry
 395+ 7590 C9               ret
