 295+ 6E4C                  ; ---------------------------------------------------------------
 296+ 6E4C 2A B7 73         ld   hl, (room_ptr)
 297+ 6E4F 11 1C 91         ld   de, MastreBedRoomLayout
 298+ 6E52 B7               or   a
 299+ 6E53 ED 52            sbc  hl, de
 300+ 6E55 20 05            jr   nz, .unknown
 301+ 6E57
 302+ 6E57 3E 23            ld   a, 35               ; Room ID = 35
 303+ 6E59 C3 5E 6E         jp   .set_room
 304+ 6E5C
 305+ 6E5C              .unknown:
 306+ 6E5C
 307+ 6E5C                  ; Nessuna corrispondenza trovata.
 308+ 6E5C                  ; Imposta la stanza di default.
 309+ 6E5C 3E 00            ld   a, 0
 310+ 6E5E
 311+ 6E5E              .set_room:
 312+ 6E5E
 313+ 6E5E                  ; Salva l'ID della stanza corrente
 314+ 6E5E 32 5D 73         ld   (current_room), a
 315+ 6E61
 316+ 6E61                  ; Ripristina i registri
 317+ 6E61 D1               pop  de
 318+ 6E62 E1               pop  hl
 319+ 6E63
 320+ 6E63 C9               ret
 321+ 6E64
 322+ 6E64              ; -------------------------------------------------------------------
 323+ 6E64              ; DrawRoomItems
 324+ 6E64              ;
 325+ 6E64              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 326+ 6E64              ;
 327+ 6E64              ; Operazioni eseguite:
 328+ 6E64              ;   1. Azzera la griglia items_grid.
 329+ 6E64              ;   2. Svuota la cache degli oggetti attivi.
 330+ 6E64              ;   3. Scansiona ItemsTable.
 331+ 6E64              ;   4. Per ogni item della stanza corrente:
 332+ 6E64              ;        - verifica se è già stato raccolto
 333+ 6E64              ;        - disegna la grafica
 334+ 6E64              ;        - aggiorna items_grid
 335+ 6E64              ;        - memorizza l'item nella cache current_room_items
 336+ 6E64              ;   5. Aggiorna num_room_items.
 337+ 6E64              ;
 338+ 6E64              ; Record ItemsTable:
 339+ 6E64              ;   +0  Room ID
 340+ 6E64              ;   +1  X (colonna)
 341+ 6E64              ;   +2  Y (riga)
 342+ 6E64              ;   +3  Colore
 343+ 6E64              ;   +4  Collected flag
 344+ 6E64              ;
 345+ 6E64              ; Cache current_room_items:
 346+ 6E64              ;   +0  Colonna
 347+ 6E64              ;   +1  Riga
 348+ 6E64              ;   +2  Colore
 349+ 6E64              ;   +3  Collected flag ptr (Low)
 350+ 6E64              ;   +4  Collected flag ptr (High)
 351+ 6E64              ;
 352+ 6E64              ; Ogni record cache occupa 5 byte.
 353+ 6E64              ; -------------------------------------------------------------------
 354+ 6E64              DrawRoomItems:
 355+ 6E64
 356+ 6E64                  ; Salva tutti i registri utilizzati
 357+ 6E64 E5               push hl
 358+ 6E65 D5               push de
 359+ 6E66 C5               push bc
 360+ 6E67 DD E5            push ix
 361+ 6E69 FD E5            push iy
 362+ 6E6B
 363+ 6E6B                  ; ---------------------------------------------------------------
 364+ 6E6B                  ; Azzera items_grid (32 x 16 = 512 byte)
 365+ 6E6B                  ; ---------------------------------------------------------------
 366+ 6E6B 21 00 90         ld   hl, items_grid
 367+ 6E6E 11 01 90         ld   de, items_grid + 1
 368+ 6E71 36 00            ld   (hl), 0
 369+ 6E73 01 FF 01         ld   bc, 511
 370+ 6E76 ED B0            ldir
 371+ 6E78
 372+ 6E78                  ; ---------------------------------------------------------------
 373+ 6E78                  ; Nessun item attivo nella stanza
 374+ 6E78                  ; ---------------------------------------------------------------
 375+ 6E78 AF               xor  a
 376+ 6E79 32 B6 73         ld   (num_room_items), a
 377+ 6E7C
 378+ 6E7C                  ; IY punta alla cache degli item attivi
 379+ 6E7C FD 21 66 73      ld   iy, current_room_items
 380+ 6E80
 381+ 6E80                  ; ---------------------------------------------------------------
 382+ 6E80                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 383+ 6E80                  ; alla stanza corrente.
 384+ 6E80                  ;
 385+ 6E80                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 386+ 6E80                  ; ---------------------------------------------------------------
 387+ 6E80 2A B7 73         ld   hl, (room_ptr)
 388+ 6E83 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 389+ 6E86 19               add  hl, de
 390+ 6E87
 391+ 6E87 E5               push hl
 392+ 6E88 DD E1            pop  ix                ; IX = bitmap item
 393+ 6E8A
 394+ 6E8A                  ; ---------------------------------------------------------------
 395+ 6E8A                  ; Inizio scansione della tabella degli item
 396+ 6E8A                  ; ---------------------------------------------------------------
 397+ 6E8A 21 14 6D         ld   hl, ItemsTable
 398+ 6E8D
 399+ 6E8D              .loop:
 400+ 6E8D
 401+ 6E8D                  ; ---------------------------------------------------------------
 402+ 6E8D                  ; Legge il Room ID del record corrente
 403+ 6E8D                  ; ---------------------------------------------------------------
 404+ 6E8D 7E               ld   a, (hl)
 405+ 6E8E
 406+ 6E8E                  ; $FF indica fine tabella
 407+ 6E8E FE FF            cp   $FF
 408+ 6E90 28 53            jr   z, .done
 409+ 6E92
 410+ 6E92                  ; ---------------------------------------------------------------
 411+ 6E92                  ; Verifica se l'item appartiene alla stanza corrente
 412+ 6E92                  ; ---------------------------------------------------------------
 413+ 6E92 57               ld   d, a
 414+ 6E93
 415+ 6E93 3A 5D 73         ld   a, (current_room)
 416+ 6E96 BA               cp   d
 417+ 6E97 20 45            jr   nz, .next_item
 418+ 6E99
 419+ 6E99                  ; ---------------------------------------------------------------
 420+ 6E99                  ; Legge i dati dell'item
 421+ 6E99                  ; ---------------------------------------------------------------
 422+ 6E99
 423+ 6E99 23               inc  hl
 424+ 6E9A 4E               ld   c, (hl)           ; X (colonna)
 425+ 6E9B
 426+ 6E9B 23               inc  hl
 427+ 6E9C 46               ld   b, (hl)           ; Y (riga)
 428+ 6E9D
 429+ 6E9D 23               inc  hl
 430+ 6E9E 5E               ld   e, (hl)           ; Colore
 431+ 6E9F
 432+ 6E9F 23               inc  hl
 433+ 6EA0 7E               ld   a, (hl)           ; Collected flag
 434+ 6EA1
 435+ 6EA1                  ; Se diverso da zero l'item è già stato raccolto
 436+ 6EA1 B7               or   a
 437+ 6EA2 20 3E            jr   nz, .next_no_inc
 438+ 6EA4
 439+ 6EA4                  ; ---------------------------------------------------------------
 440+ 6EA4                  ; Disegna l'item sullo schermo
 441+ 6EA4                  ;
 442+ 6EA4                  ; B = Row
 443+ 6EA4                  ; C = Column
 444+ 6EA4                  ; HL = bitmap pointer
 445+ 6EA4                  ; E = Color
 446+ 6EA4                  ; ---------------------------------------------------------------
 447+ 6EA4 E5               push hl
 448+ 6EA5
 449+ 6EA5 DD E5            push ix
 450+ 6EA7 E1               pop  hl
 451+ 6EA8
 452+ 6EA8 CD ED 6E         call DrawItemGraphic
 453+ 6EAB
 454+ 6EAB E1               pop  hl                ; ritorna al flag collected
 455+ 6EAC
 456+ 6EAC                  ; ---------------------------------------------------------------
 457+ 6EAC                  ; Aggiorna items_grid
 458+ 6EAC                  ;
 459+ 6EAC                  ; Calcolo:
 460+ 6EAC                  ;   offset = Row * 32 + Col
 461+ 6EAC                  ; ---------------------------------------------------------------
 462+ 6EAC E5               push hl
 463+ 6EAD D5               push de
 464+ 6EAE
 465+ 6EAE 26 00            ld   h, 0
 466+ 6EB0 68               ld   l, b              ; HL = Row
 467+ 6EB1
 468+ 6EB1 29               add  hl, hl            ; *2
 469+ 6EB2 29               add  hl, hl            ; *4
 470+ 6EB3 29               add  hl, hl            ; *8
 471+ 6EB4 29               add  hl, hl            ; *16
 472+ 6EB5 29               add  hl, hl            ; *32
 473+ 6EB6
 474+ 6EB6 16 00            ld   d, 0
 475+ 6EB8 59               ld   e, c              ; DE = Col
 476+ 6EB9
 477+ 6EB9 19               add  hl, de            ; Row*32 + Col
 478+ 6EBA
 479+ 6EBA 11 00 90         ld   de, items_grid
 480+ 6EBD 19               add  hl, de            ; puntatore nella griglia
 481+ 6EBE
 482+ 6EBE D1               pop  de                ; ripristina colore
 483+ 6EBF
 484+ 6EBF 73               ld   (hl), e           ; salva colore cella
 485+ 6EC0
 486+ 6EC0 E1               pop  hl
 487+ 6EC1
 488+ 6EC1                  ; ---------------------------------------------------------------
 489+ 6EC1                  ; Salva l'item nella cache della stanza
 490+ 6EC1                  ;
 491+ 6EC1                  ; Questo evita di dover scansionare tutta ItemsTable
 492+ 6EC1                  ; durante il controllo delle collisioni.
 493+ 6EC1                  ; ---------------------------------------------------------------
 494+ 6EC1
 495+ 6EC1 FD 71 00         ld   (iy+0), c         ; Colonna
 496+ 6EC4 FD 70 01         ld   (iy+1), b         ; Riga
 497+ 6EC7 FD 73 02         ld   (iy+2), e         ; Colore
 498+ 6ECA
 499+ 6ECA                  ; Salva il puntatore al flag "collected"
 500+ 6ECA FD 75 03         ld   (iy+3), l         ; Low byte
 501+ 6ECD FD 74 04         ld   (iy+4), h         ; High byte
 502+ 6ED0
 503+ 6ED0                  ; Passa al record successivo della cache
 504+ 6ED0 01 05 00         ld   bc, 5
 505+ 6ED3 FD 09            add  iy, bc
 506+ 6ED5
 507+ 6ED5                  ; Incrementa il numero di item attivi
 508+ 6ED5 3A B6 73         ld   a, (num_room_items)
 509+ 6ED8 3C               inc  a
 510+ 6ED9 32 B6 73         ld   (num_room_items), a
 511+ 6EDC
 512+ 6EDC 18 04            jr   .next_no_inc
 513+ 6EDE
 514+ 6EDE              .next_item:
 515+ 6EDE
 516+ 6EDE                  ; ---------------------------------------------------------------
 517+ 6EDE                  ; L'item non appartiene alla stanza corrente.
 518+ 6EDE                  ; Salta i campi del record:
 519+ 6EDE                  ;   X
 520+ 6EDE                  ;   Y
 521+ 6EDE                  ;   Color
 522+ 6EDE                  ;   Collected
 523+ 6EDE                  ; ---------------------------------------------------------------
 524+ 6EDE 23               inc  hl
 525+ 6EDF 23               inc  hl
 526+ 6EE0 23               inc  hl
 527+ 6EE1 23               inc  hl
 528+ 6EE2
 529+ 6EE2              .next_no_inc:
 530+ 6EE2
 531+ 6EE2                  ; ---------------------------------------------------------------
 532+ 6EE2                  ; Avanza al record successivo
 533+ 6EE2                  ; (prossimo Room ID)
 534+ 6EE2                  ; ---------------------------------------------------------------
 535+ 6EE2 23               inc  hl
 536+ 6EE3 18 A8            jr   .loop
 537+ 6EE5
 538+ 6EE5              .done:
 539+ 6EE5
 540+ 6EE5                  ; Ripristina i registri
 541+ 6EE5 FD E1            pop  iy
 542+ 6EE7 DD E1            pop  ix
 543+ 6EE9 D1               pop  de
 544+ 6EEA C1               pop  bc
 545+ 6EEB E1               pop  hl
 546+ 6EEC
 547+ 6EEC C9               ret
 548+ 6EED
 549+ 6EED              ; -------------------------------------------------------------------
 550+ 6EED              ; DrawItemGraphic
 551+ 6EED              ;
 552+ 6EED              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 553+ 6EED              ; utilizzando una bitmap di 8 byte e un attributo colore.
 554+ 6EED              ;
 555+ 6EED              ; Input:
 556+ 6EED              ;   B = Riga attributi (3..18)
 557+ 6EED              ;   C = Colonna attributi (0..31)
 558+ 6EED              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 559+ 6EED              ;   E = Attributo colore
 560+ 6EED              ;
 561+ 6EED              ; Output:
 562+ 6EED              ;   Nessuno
 563+ 6EED              ;
 564+ 6EED              ; Registri preservati:
 565+ 6EED              ;   BC, DE, HL
 566+ 6EED              ; -------------------------------------------------------------------
 567+ 6EED              DrawItemGraphic:
 568+ 6EED
 569+ 6EED                  ; Salva i registri originali
 570+ 6EED C5               push bc
 571+ 6EEE D5               push de
 572+ 6EEF E5               push hl
 573+ 6EF0
 574+ 6EF0                  ; ---------------------------------------------------------------
 575+ 6EF0                  ; Calcolo indirizzo bitmap dello Spectrum
 576+ 6EF0                  ;
 577+ 6EF0                  ; Ogni item occupa una cella attributi (8x8 pixel).
 578+ 6EF0                  ;
 579+ 6EF0                  ; Formula:
 580+ 6EF0                  ;   High = $40 + (Row AND $18)
 581+ 6EF0                  ;   Low  = (Row AND 7) * 32 + Col
 582+ 6EF0                  ;
 583+ 6EF0                  ; DE conterrà l'indirizzo della prima scanline.
 584+ 6EF0                  ; ---------------------------------------------------------------
 585+ 6EF0
 586+ 6EF0 78               ld   a, b
 587+ 6EF1 E6 18            and  $18
 588+ 6EF3 C6 40            add  a, $40
 589+ 6EF5 57               ld   d, a              ; Byte alto indirizzo video
 590+ 6EF6
 591+ 6EF6 78               ld   a, b
 592+ 6EF7 E6 07            and  7                 ; Riga interna al blocco da 8
 593+ 6EF9
 594+ 6EF9 87               add  a, a              ; *2
 595+ 6EFA 87               add  a, a              ; *4
 596+ 6EFB 87               add  a, a              ; *8
 597+ 6EFC 87               add  a, a              ; *16
 598+ 6EFD 87               add  a, a              ; *32
 599+ 6EFE
 600+ 6EFE 81               add  a, c              ; + colonna
 601+ 6EFF
 602+ 6EFF 5F               ld   e, a              ; Byte basso indirizzo video
 603+ 6F00
 604+ 6F00                  ; ---------------------------------------------------------------
 605+ 6F00                  ; Disegno bitmap
 606+ 6F00                  ;
 607+ 6F00                  ; Copia 8 byte consecutivi nella memoria video.
 608+ 6F00                  ; Ogni byte rappresenta una scanline da 8 pixel.
 609+ 6F00                  ; ---------------------------------------------------------------
 610+ 6F00
 611+ 6F00 C5               push bc                ; Conserva Row e Col
 612+ 6F01
 613+ 6F01 06 08            ld   b, 8              ; Numero scanline
 614+ 6F03
 615+ 6F03              .line_loop:
 616+ 6F03
 617+ 6F03 7E               ld   a, (hl)           ; Legge scanline bitmap
 618+ 6F04 12               ld   (de), a           ; Scrive nella memoria video
 619+ 6F05
 620+ 6F05 14               inc  d                 ; Scanline successiva
 621+ 6F06 23               inc  hl                ; Byte bitmap successivo
 622+ 6F07
 623+ 6F07 05               dec  b
 624+ 6F08 20 F9            jr   nz, .line_loop
 625+ 6F0A
 626+ 6F0A C1               pop  bc                ; Ripristina Row e Col
 627+ 6F0B
 628+ 6F0B                  ; ---------------------------------------------------------------
 629+ 6F0B                  ; Calcolo indirizzo attributo
 630+ 6F0B                  ;
 631+ 6F0B                  ; Formula:
 632+ 6F0B                  ;   AttrAddr = $5800 + Row * 32 + Col
 633+ 6F0B                  ;
 634+ 6F0B                  ; HL conterrà l'indirizzo della cella attributi.
 635+ 6F0B                  ; ---------------------------------------------------------------
 636+ 6F0B
 637+ 6F0B 26 00            ld   h, 0
 638+ 6F0D 68               ld   l, b              ; HL = Row
 639+ 6F0E
 640+ 6F0E 29               add  hl, hl            ; *2
 641+ 6F0F 29               add  hl, hl            ; *4
 642+ 6F10 29               add  hl, hl            ; *8
 643+ 6F11 29               add  hl, hl            ; *16
 644+ 6F12 29               add  hl, hl            ; *32
 645+ 6F13
 646+ 6F13 79               ld   a, c              ; A = Colonna
 647+ 6F14
 648+ 6F14 85               add  a, l
 649+ 6F15 6F               ld   l, a
 650+ 6F16
 651+ 6F16 30 01            jr   nc, .no_carry
 652+ 6F18 24               inc  h
 653+ 6F19
 654+ 6F19              .no_carry:
 655+ 6F19
 656+ 6F19                  ; HL = Row * 32 + Col
 657+ 6F19
 658+ 6F19 11 00 58         ld   de, $5800
 659+ 6F1C 19               add  hl, de            ; HL = indirizzo attributi
 660+ 6F1D
 661+ 6F1D                  ; ---------------------------------------------------------------
 662+ 6F1D                  ; Recupera il colore originale dallo stack.
 663+ 6F1D                  ;
 664+ 6F1D                  ; Layout stack:
 665+ 6F1D                  ;   HL originale
 666+ 6F1D                  ;   DE originale (E = colore)
 667+ 6F1D                  ;   BC originale
 668+ 6F1D                  ; ---------------------------------------------------------------
 669+ 6F1D
 670+ 6F1D C1               pop  bc                ; Recupera HL originale
 671+ 6F1E D1               pop  de                ; Recupera DE originale
 672+ 6F1F
 673+ 6F1F                  ; ---------------------------------------------------------------
 674+ 6F1F                  ; Scrive l'attributo colore
 675+ 6F1F                  ; ---------------------------------------------------------------
 676+ 6F1F
 677+ 6F1F 7B               ld   a, e              ; A = colore
 678+ 6F20 77               ld   (hl), a           ; Scrive nella RAM attributi
 679+ 6F21
 680+ 6F21                  ; ---------------------------------------------------------------
 681+ 6F21                  ; Ripristina HL e BC originali
 682+ 6F21                  ; ---------------------------------------------------------------
 683+ 6F21
 684+ 6F21 C5               push bc
 685+ 6F22 E1               pop  hl                ; HL originale
 686+ 6F23
 687+ 6F23 C1               pop  bc                ; BC originale
 688+ 6F24
 689+ 6F24 C9               ret
 690+ 6F25
 691+ 6F25              ; -------------------------------------------------------------------
 692+ 6F25              ; RestoreBackgroundCell
 693+ 6F25              ;
 694+ 6F25              ; Ripristina il contenuto originale di una cella della stanza.
 695+ 6F25              ; Viene utilizzata principalmente quando un item viene raccolto:
 696+ 6F25              ; invece di lasciare un "buco", la routine ridisegna il tile
 697+ 6F25              ; originale presente nella mappa della stanza.
 698+ 6F25              ;
 699+ 6F25              ; Input:
 700+ 6F25              ;   B = Row (3..18)
 701+ 6F25              ;   C = Col (0..31)
 702+ 6F25              ;
 703+ 6F25              ; Utilizza:
 704+ 6F25              ;   room_ptr -> struttura dati della stanza corrente
 705+ 6F25              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 706+ 6F25              ;   DrawTile -> ridisegna il tile selezionato
 707+ 6F25              ;
 708+ 6F25              ; Tipi di cella:
 709+ 6F25              ;   0 = Background
 710+ 6F25              ;   1 = Floor
 711+ 6F25              ;   2 = Wall
 712+ 6F25              ;   3 = Nasty
 713+ 6F25              ; -------------------------------------------------------------------
 714+ 6F25              RestoreBackgroundCell:
 715+ 6F25
 716+ 6F25                  ; Salva tutti i registri utilizzati
 717+ 6F25 FD E5            push iy
 718+ 6F27 C5               push bc
 719+ 6F28 D5               push de
 720+ 6F29 E5               push hl
 721+ 6F2A DD E5            push ix
 722+ 6F2C
 723+ 6F2C                  ; ---------------------------------------------------------------
 724+ 6F2C                  ; Conserva Row e Col in IY.
 725+ 6F2C                  ;
 726+ 6F2C                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 727+ 6F2C                  ; BC potrebbe essere modificato.
 728+ 6F2C                  ; ---------------------------------------------------------------
 729+ 6F2C C5               push bc
 730+ 6F2D FD E1            pop  iy                ; IYH = Row, IYL = Col
 731+ 6F2F
 732+ 6F2F                  ; ---------------------------------------------------------------
 733+ 6F2F                  ; Determina quale tipo di cella è presente nella posizione
 734+ 6F2F                  ; specificata.
 735+ 6F2F                  ;
 736+ 6F2F                  ; Input:
 737+ 6F2F                  ;   B = Row
 738+ 6F2F                  ;   C = Col
 739+ 6F2F                  ;
 740+ 6F2F                  ; Output:
 741+ 6F2F                  ;   A = tipo cella
 742+ 6F2F                  ; ---------------------------------------------------------------
 743+ 6F2F 78               ld   a, b
 744+ 6F30
 745+ 6F30 CD 39 69         call GetCellFromUnpacked
 746+ 6F33
 747+ 6F33                  ; ---------------------------------------------------------------
 748+ 6F33                  ; Recupera il puntatore alla stanza corrente.
 749+ 6F33                  ;
 750+ 6F33                  ; DE = base della struttura stanza
 751+ 6F33                  ; ---------------------------------------------------------------
 752+ 6F33 ED 5B B7 73      ld   de, (room_ptr)
 753+ 6F37
 754+ 6F37                  ; ---------------------------------------------------------------
 755+ 6F37                  ; Seleziona il tile corretto in base al tipo di cella.
 756+ 6F37                  ;
 757+ 6F37                  ; A = 0 -> Background
 758+ 6F37                  ; A = 1 -> Floor
 759+ 6F37                  ; A = 2 -> Wall
 760+ 6F37                  ; A = 3 -> Nasty
 761+ 6F37                  ; ---------------------------------------------------------------
 762+ 6F37
 763+ 6F37 B7               or   a
 764+ 6F38 20 06            jr   nz, .not_bg
 765+ 6F3A
 766+ 6F3A                  ; Background
 767+ 6F3A 21 A0 00         ld   hl, OFFSET_BG
 768+ 6F3D 19               add  hl, de
 769+ 6F3E 18 16            jr   .draw_cell
 770+ 6F40
 771+ 6F40              .not_bg:
 772+ 6F40
 773+ 6F40 3D               dec  a
 774+ 6F41 20 06            jr   nz, .not_floor
 775+ 6F43
 776+ 6F43                  ; Floor
 777+ 6F43 21 A9 00         ld   hl, OFFSET_FLOOR
 778+ 6F46 19               add  hl, de
 779+ 6F47 18 0D            jr   .draw_cell
 780+ 6F49
 781+ 6F49              .not_floor:
 782+ 6F49
 783+ 6F49 3D               dec  a
 784+ 6F4A 20 06            jr   nz, .not_wall
 785+ 6F4C
 786+ 6F4C                  ; Wall
 787+ 6F4C 21 B2 00         ld   hl, OFFSET_WALL
 788+ 6F4F 19               add  hl, de
 789+ 6F50 18 04            jr   .draw_cell
 790+ 6F52
 791+ 6F52              .not_wall:
 792+ 6F52
 793+ 6F52                  ; Nasty
 794+ 6F52 21 BB 00         ld   hl, OFFSET_NASTY
 795+ 6F55 19               add  hl, de
 796+ 6F56
 797+ 6F56              .draw_cell:
 798+ 6F56
 799+ 6F56                  ; ---------------------------------------------------------------
 800+ 6F56                  ; HL punta ora alla grafica del tile da ridisegnare.
 801+ 6F56                  ;
 802+ 6F56                  ; DrawTile si aspetta:
 803+ 6F56                  ;   IX = puntatore tile
 804+ 6F56                  ;   B  = Row
 805+ 6F56                  ;   C  = Col
 806+ 6F56                  ; ---------------------------------------------------------------
 807+ 6F56 E5               push hl
 808+ 6F57 DD E1            pop  ix
 809+ 6F59
 810+ 6F59                  ; Ripristina Row e Col salvati in IY
 811+ 6F59 FD E5            push iy
 812+ 6F5B C1               pop  bc
 813+ 6F5C
 814+ 6F5C                  ; Disegna il tile originale
 815+ 6F5C CD 8C 61         call DrawTile
 816+ 6F5F
 817+ 6F5F                  ; ---------------------------------------------------------------
 818+ 6F5F                  ; Ripristina i registri salvati
 819+ 6F5F                  ; ---------------------------------------------------------------
 820+ 6F5F DD E1            pop  ix
 821+ 6F61 E1               pop  hl
 822+ 6F62 D1               pop  de
 823+ 6F63 C1               pop  bc
 824+ 6F64 FD E1            pop  iy
 825+ 6F66
 826+ 6F66 C9               ret
 827+ 6F67
 828+ 6F67              ; -------------------------------------------------------------------
 829+ 6F67              ; CheckWillyItemCollision
 830+ 6F67              ;
 831+ 6F67              ; Verifica se Willy collide con un item utilizzando il controllo
 832+ 6F67              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 833+ 6F67              ;
 834+ 6F67              ; Input:
 835+ 6F67              ;   A = ItemX (colonna attributi 0..31)
 836+ 6F67              ;   H = ItemY (riga attributi 3..18)
 837+ 6F67              ;
 838+ 6F67              ; Coordinate item:
 839+ 6F67              ;   Ogni item occupa una cella da 8x8 pixel.
 840+ 6F67              ;
 841+ 6F67              ; Coordinate Willy:
 842+ 6F67              ;   Willy occupa un rettangolo di 16x16 pixel.
 843+ 6F67              ;
 844+ 6F67              ; Output:
 845+ 6F67              ;   Carry Set   = collisione rilevata
 846+ 6F67              ;   Carry Clear = nessuna collisione
 847+ 6F67              ;
 848+ 6F67              ; Registri preservati:
 849+ 6F67              ;   BC, DE, HL
 850+ 6F67              ; -------------------------------------------------------------------
 851+ 6F67              CheckWillyItemCollision:
 852+ 6F67
 853+ 6F67                  ; Salva i registri utilizzati
 854+ 6F67 C5               push bc
 855+ 6F68 D5               push de
 856+ 6F69 E5               push hl
 857+ 6F6A
 858+ 6F6A                  ; ---------------------------------------------------------------
 859+ 6F6A                  ; Calcola il bounding box orizzontale dell'item
 860+ 6F6A                  ;
 861+ 6F6A                  ; ItemLeft  = ItemX * 8
 862+ 6F6A                  ; ItemRight = ItemLeft + 7
 863+ 6F6A                  ;
 864+ 6F6A                  ; E = ItemLeft
 865+ 6F6A                  ; D = ItemRight
 866+ 6F6A                  ; ---------------------------------------------------------------
 867+ 6F6A 6F               ld   l, a              ; L = ItemX
 868+ 6F6B
 869+ 6F6B 7D               ld   a, l
 870+ 6F6C 87               add  a, a              ; *2
 871+ 6F6D 87               add  a, a              ; *4
 872+ 6F6E 87               add  a, a              ; *8
 873+ 6F6F
 874+ 6F6F 5F               ld   e, a              ; E = ItemLeft
 875+ 6F70
 876+ 6F70 C6 07            add  a, 7
 877+ 6F72 57               ld   d, a              ; D = ItemRight
 878+ 6F73
 879+ 6F73                  ; ---------------------------------------------------------------
 880+ 6F73                  ; Recupera la posizione corrente di Willy
 881+ 6F73                  ;
 882+ 6F73                  ; B = WillyY
 883+ 6F73                  ; C = WillyX
 884+ 6F73                  ; ---------------------------------------------------------------
 885+ 6F73 ED 4B 48 70      ld   bc, (PlayerPos)
 886+ 6F77
 887+ 6F77                  ; ---------------------------------------------------------------
 888+ 6F77                  ; Primo test:
 889+ 6F77                  ;
 890+ 6F77                  ; WillyLeft <= ItemRight
 891+ 6F77                  ;
 892+ 6F77                  ; Se Willy è completamente a destra dell'item
 893+ 6F77                  ; non può esserci collisione.
 894+ 6F77                  ; ---------------------------------------------------------------
 895+ 6F77 79               ld   a, c              ; A = WillyLeft
 896+ 6F78
 897+ 6F78 BA               cp   d                 ; WillyLeft vs ItemRight
 898+ 6F79
 899+ 6F79 28 04            jr   z, .x_ok
 900+ 6F7B 38 02            jr   c, .x_ok
 901+ 6F7D
 902+ 6F7D 18 29            jr   .no_collision
 903+ 6F7F
 904+ 6F7F              .x_ok:
 905+ 6F7F
 906+ 6F7F                  ; ---------------------------------------------------------------
 907+ 6F7F                  ; Secondo test:
 908+ 6F7F                  ;
 909+ 6F7F                  ; WillyRight >= ItemLeft
 910+ 6F7F                  ;
 911+ 6F7F                  ; WillyRight = WillyX + 7
 912+ 6F7F                  ; ---------------------------------------------------------------
 913+ 6F7F C6 07            add  a, 7
 914+ 6F81
 915+ 6F81 BB               cp   e                 ; WillyRight vs ItemLeft
 916+ 6F82
 917+ 6F82 28 04            jr   z, .y_check
 918+ 6F84 30 02            jr   nc, .y_check
 919+ 6F86
 920+ 6F86 18 20            jr   .no_collision
 921+ 6F88
 922+ 6F88              .y_check:
 923+ 6F88
 924+ 6F88                  ; ---------------------------------------------------------------
 925+ 6F88                  ; Recupera ItemY dal valore originale di HL
 926+ 6F88                  ;
 927+ 6F88                  ; H contiene la riga dell'item.
 928+ 6F88                  ; ---------------------------------------------------------------
 929+ 6F88 E1               pop  hl
 930+ 6F89 E5               push hl
 931+ 6F8A
 932+ 6F8A                  ; ---------------------------------------------------------------
 933+ 6F8A                  ; Calcola il bounding box verticale dell'item
 934+ 6F8A                  ;
 935+ 6F8A                  ; ItemTop    = ItemY * 8
 936+ 6F8A                  ; ItemBottom = ItemTop + 7
 937+ 6F8A                  ;
 938+ 6F8A                  ; E = ItemTop
 939+ 6F8A                  ; D = ItemBottom
 940+ 6F8A                  ; ---------------------------------------------------------------
 941+ 6F8A 7C               ld   a, h
 942+ 6F8B
 943+ 6F8B 87               add  a, a              ; *2
 944+ 6F8C 87               add  a, a              ; *4
 945+ 6F8D 87               add  a, a              ; *8
 946+ 6F8E
 947+ 6F8E 5F               ld   e, a              ; ItemTop
 948+ 6F8F
 949+ 6F8F C6 07            add  a, 7
 950+ 6F91 57               ld   d, a              ; ItemBottom
 951+ 6F92
 952+ 6F92                  ; ---------------------------------------------------------------
 953+ 6F92                  ; Primo test verticale:
 954+ 6F92                  ;
 955+ 6F92                  ; WillyTop <= ItemBottom
 956+ 6F92                  ; ---------------------------------------------------------------
 957+ 6F92 78               ld   a, b              ; WillyTop
 958+ 6F93
 959+ 6F93 BA               cp   d
 960+ 6F94
 961+ 6F94 28 04            jr   z, .y_ok
 962+ 6F96 38 02            jr   c, .y_ok
 963+ 6F98
 964+ 6F98 18 0E            jr   .no_collision
 965+ 6F9A
 966+ 6F9A              .y_ok:
 967+ 6F9A
 968+ 6F9A                  ; ---------------------------------------------------------------
 969+ 6F9A                  ; Secondo test verticale:
 970+ 6F9A                  ;
 971+ 6F9A                  ; WillyBottom >= ItemTop
 972+ 6F9A                  ;
 973+ 6F9A                  ; WillyBottom = WillyY + 15
 974+ 6F9A                  ; ---------------------------------------------------------------
 975+ 6F9A C6 0F            add  a, 15
 976+ 6F9C
 977+ 6F9C BB               cp   e
 978+ 6F9D
 979+ 6F9D 28 04            jr   z, .collision
 980+ 6F9F 30 02            jr   nc, .collision
 981+ 6FA1
 982+ 6FA1 18 05            jr   .no_collision
 983+ 6FA3
 984+ 6FA3              .collision:
 985+ 6FA3
 986+ 6FA3                  ; ---------------------------------------------------------------
 987+ 6FA3                  ; Collisione rilevata
 988+ 6FA3                  ; ---------------------------------------------------------------
 989+ 6FA3 E1               pop  hl
 990+ 6FA4 D1               pop  de
 991+ 6FA5 C1               pop  bc
 992+ 6FA6
 993+ 6FA6 37               scf                    ; Carry = 1
 994+ 6FA7
 995+ 6FA7 C9               ret
 996+ 6FA8
 997+ 6FA8              .no_collision:
 998+ 6FA8
 999+ 6FA8                  ; ---------------------------------------------------------------
1000+ 6FA8                  ; Nessuna collisione
1001+ 6FA8                  ; ---------------------------------------------------------------
1002+ 6FA8 E1               pop  hl
1003+ 6FA9 D1               pop  de
1004+ 6FAA C1               pop  bc
1005+ 6FAB
1006+ 6FAB B7               or   a                 ; Carry = 0
1007+ 6FAC
1008+ 6FAC C9               ret
1009+ 6FAD
1010+ 6FAD              ; -------------------------------------------------------------------
1011+ 6FAD              ; CheckRoomItemsCollision
1012+ 6FAD              ;
1013+ 6FAD              ; Controlla se Willy entra in collisione con uno degli item
1014+ 6FAD              ; attivi presenti nella stanza corrente.
1015+ 6FAD              ;
1016+ 6FAD              ; Per ogni item:
1017+ 6FAD              ;   - verifica che appartenga alla stanza corrente
1018+ 6FAD              ;   - verifica che non sia già stato raccolto
1019+ 6FAD              ;   - esegue il test di collisione con Willy
1020+ 6FAD              ;
1021+ 6FAD              ; Se l'item viene raccolto:
1022+ 6FAD              ;   - imposta il flag "collected"
1023+ 6FAD              ;   - rimuove l'item dalla cache items_grid
1024+ 6FAD              ;   - incrementa il contatore degli oggetti raccolti
1025+ 6FAD              ;   - aggiorna l'HUD
1026+ 6FAD              ;   - ripristina il tile di sfondo
1027+ 6FAD              ;   - riproduce il suono di raccolta
1028+ 6FAD              ;
1029+ 6FAD              ; Formato record ItemsTable:
1030+ 6FAD              ;   +0 RoomID
1031+ 6FAD              ;   +1 X
1032+ 6FAD              ;   +2 Y
1033+ 6FAD              ;   +3 Color
1034+ 6FAD              ;   +4 Collected
1035+ 6FAD              ;
1036+ 6FAD              ; Fine tabella:
1037+ 6FAD              ;   RoomID = $FF
1038+ 6FAD              ; -------------------------------------------------------------------
1039+ 6FAD              CheckRoomItemsCollision:
1040+ 6FAD
1041+ 6FAD                  ; Salva i registri utilizzati
1042+ 6FAD E5               push hl
1043+ 6FAE D5               push de
1044+ 6FAF C5               push bc
1045+ 6FB0
1046+ 6FB0                  ; Inizio scansione della tabella degli item
1047+ 6FB0 21 14 6D         ld   hl, ItemsTable
1048+ 6FB3
1049+ 6FB3              .loop:
1050+ 6FB3
1051+ 6FB3                  ; ---------------------------------------------------------------
1052+ 6FB3                  ; Legge il Room ID dell'item corrente
1053+ 6FB3                  ; ---------------------------------------------------------------
1054+ 6FB3 7E               ld   a, (hl)
1055+ 6FB4
1056+ 6FB4                  ; $FF indica fine tabella
1057+ 6FB4 FE FF            cp   $FF
1058+ 6FB6 28 4D            jr   z, .done
1059+ 6FB8
1060+ 6FB8                  ; ---------------------------------------------------------------
1061+ 6FB8                  ; Verifica se l'item appartiene alla stanza corrente
1062+ 6FB8                  ; ---------------------------------------------------------------
1063+ 6FB8 57               ld   d, a              ; D = RoomID item
1064+ 6FB9
1065+ 6FB9 3A 5D 73         ld   a, (current_room)
1066+ 6FBC BA               cp   d
1067+ 6FBD
1068+ 6FBD                  ; Se appartiene a un'altra stanza salta il record
1069+ 6FBD 20 3F            jr   nz, .next_item
1070+ 6FBF
1071+ 6FBF                  ; ---------------------------------------------------------------
1072+ 6FBF                  ; Legge coordinate e stato dell'item
1073+ 6FBF                  ; ---------------------------------------------------------------
1074+ 6FBF
1075+ 6FBF 23               inc  hl
1076+ 6FC0 4E               ld   c, (hl)           ; C = X
1077+ 6FC1
1078+ 6FC1 23               inc  hl
1079+ 6FC2 46               ld   b, (hl)           ; B = Y
1080+ 6FC3
1081+ 6FC3 23               inc  hl                ; salta Color
1082+ 6FC4
1083+ 6FC4 23               inc  hl                ; punta a Collected
1084+ 6FC5
1085+ 6FC5 7E               ld   a, (hl)
1086+ 6FC6
1087+ 6FC6                  ; ---------------------------------------------------------------
1088+ 6FC6                  ; Item già raccolto?
1089+ 6FC6                  ; ---------------------------------------------------------------
1090+ 6FC6 B7               or   a
1091+ 6FC7 20 39            jr   nz, .next_no_inc
1092+ 6FC9
1093+ 6FC9                  ; ---------------------------------------------------------------
1094+ 6FC9                  ; Test collisione Willy ↔ Item
1095+ 6FC9                  ;
1096+ 6FC9                  ; Input richiesto:
1097+ 6FC9                  ;   A = ItemX
1098+ 6FC9                  ;   H = ItemY
1099+ 6FC9                  ; ---------------------------------------------------------------
1100+ 6FC9 79               ld   a, c
1101+ 6FCA
1102+ 6FCA E5               push hl                ; salva puntatore al flag Collected
1103+ 6FCB
1104+ 6FCB 60               ld   h, b
1105+ 6FCC
1106+ 6FCC CD 67 6F         call CheckWillyItemCollision
1107+ 6FCF
1108+ 6FCF E1               pop  hl
1109+ 6FD0
1110+ 6FD0                  ; Nessuna collisione
1111+ 6FD0 30 30            jr   nc, .next_no_inc
1112+ 6FD2
1113+ 6FD2                  ; ===============================================================
1114+ 6FD2                  ; ITEM RACCOLTO
1115+ 6FD2                  ; ===============================================================
1116+ 6FD2
1117+ 6FD2                  ; ---------------------------------------------------------------
1118+ 6FD2                  ; Marca l'item come raccolto
1119+ 6FD2                  ; ---------------------------------------------------------------
1120+ 6FD2 36 01            ld   (hl), 1
1121+ 6FD4
1122+ 6FD4                  ; ---------------------------------------------------------------
1123+ 6FD4                  ; Rimuove l'item dalla cache items_grid
1124+ 6FD4                  ;
1125+ 6FD4                  ; Calcolo:
1126+ 6FD4                  ;   offset = Row * 32 + Col
1127+ 6FD4                  ; ---------------------------------------------------------------
1128+ 6FD4 E5               push hl
1129+ 6FD5 D5               push de
1130+ 6FD6
1131+ 6FD6 26 00            ld   h, 0
1132+ 6FD8 68               ld   l, b              ; HL = Row
1133+ 6FD9
1134+ 6FD9 29               add  hl, hl            ; *2
1135+ 6FDA 29               add  hl, hl            ; *4
1136+ 6FDB 29               add  hl, hl            ; *8
1137+ 6FDC 29               add  hl, hl            ; *16
1138+ 6FDD 29               add  hl, hl            ; *32
1139+ 6FDE
1140+ 6FDE 59               ld   e, c
1141+ 6FDF 16 00            ld   d, 0
1142+ 6FE1
1143+ 6FE1 19               add  hl, de            ; Row*32 + Col
1144+ 6FE2
1145+ 6FE2 11 00 90         ld   de, items_grid
1146+ 6FE5 19               add  hl, de
1147+ 6FE6
1148+ 6FE6                  ; La cella non contiene più un item
1149+ 6FE6 36 00            ld   (hl), 0
1150+ 6FE8
1151+ 6FE8 D1               pop  de
1152+ 6FE9 E1               pop  hl
1153+ 6FEA
1154+ 6FEA                  ; ---------------------------------------------------------------
1155+ 6FEA                  ; Conserva il puntatore all'entry corrente
1156+ 6FEA                  ; poiché le routine successive possono alterare HL.
1157+ 6FEA                  ; ---------------------------------------------------------------
1158+ 6FEA E5               push hl
1159+ 6FEB
1160+ 6FEB                  ; ---------------------------------------------------------------
1161+ 6FEB                  ; Aggiorna il numero di oggetti raccolti
1162+ 6FEB                  ; ---------------------------------------------------------------
1163+ 6FEB 3A 52 70         ld   a, (items_collected)
1164+ 6FEE
1165+ 6FEE 3C               inc  a
1166+ 6FEF
1167+ 6FEF 32 52 70         ld   (items_collected), a
1168+ 6FF2
1169+ 6FF2                  ; ---------------------------------------------------------------
1170+ 6FF2                  ; Aggiorna il contatore visualizzato a schermo
1171+ 6FF2                  ; ---------------------------------------------------------------
1172+ 6FF2 CD CB 60         call UpdateItemsCollectedDisplay
1173+ 6FF5
1174+ 6FF5                  ; ---------------------------------------------------------------
1175+ 6FF5                  ; Ripristina il tile originale della stanza
1176+ 6FF5                  ; eliminando la grafica dell'item.
1177+ 6FF5                  ;
1178+ 6FF5                  ; Input:
1179+ 6FF5                  ;   B = Row
1180+ 6FF5                  ;   C = Col
1181+ 6FF5                  ; ---------------------------------------------------------------
1182+ 6FF5 CD 25 6F         call RestoreBackgroundCell
1183+ 6FF8
1184+ 6FF8                  ; ---------------------------------------------------------------
1185+ 6FF8                  ; Riproduce il suono di raccolta
1186+ 6FF8                  ; ---------------------------------------------------------------
1187+ 6FF8 CD 09 70         call PlayCollectSound
1188+ 6FFB
1189+ 6FFB                  ; Ripristina il puntatore alla tabella
1190+ 6FFB E1               pop  hl
1191+ 6FFC
1192+ 6FFC                  ; Continua con il record successivo
1193+ 6FFC 18 04            jr   .next_no_inc
1194+ 6FFE
1195+ 6FFE              .next_item:
1196+ 6FFE
1197+ 6FFE                  ; ---------------------------------------------------------------
1198+ 6FFE                  ; Salta i campi del record:
1199+ 6FFE                  ;   X
1200+ 6FFE                  ;   Y
1201+ 6FFE                  ;   Color
1202+ 6FFE                  ;   Collected
1203+ 6FFE                  ; ---------------------------------------------------------------
1204+ 6FFE 23               inc  hl
1205+ 6FFF 23               inc  hl
1206+ 7000 23               inc  hl
1207+ 7001 23               inc  hl
1208+ 7002
1209+ 7002              .next_no_inc:
1210+ 7002
1211+ 7002                  ; ---------------------------------------------------------------
1212+ 7002                  ; Avanza al record successivo.
1213+ 7002                  ;
1214+ 7002                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1215+ 7002                  ; ---------------------------------------------------------------
1216+ 7002 23               inc  hl
1217+ 7003
1218+ 7003 18 AE            jr   .loop
1219+ 7005
1220+ 7005              .done:
1221+ 7005
1222+ 7005                  ; Ripristina i registri
1223+ 7005 C1               pop  bc
1224+ 7006 D1               pop  de
1225+ 7007 E1               pop  hl
1226+ 7008
1227+ 7008 C9               ret
1228+ 7009
1229+ 7009              ; -------------------------------------------------------------------
1230+ 7009              ; PlayCollectSound
1231+ 7009              ;
1232+ 7009              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1233+ 7009              ; dello ZX Spectrum utilizzando il port $FE.
1234+ 7009              ;
1235+ 7009              ; Il suono viene prodotto alternando ON/OFF del bit 4
1236+ 7009              ; (speaker) con un semplice delay software.
1237+ 7009              ;
1238+ 7009              ; Effetto risultante:
1239+ 7009              ;   beep breve tipo "pickup item"
1240+ 7009              ; -------------------------------------------------------------------
1241+ 7009              PlayCollectSound:
1242+ 7009
1243+ 7009                  ; Salva registri utilizzati
1244+ 7009 C5               push bc
1245+ 700A D5               push de
1246+ 700B
1247+ 700B                  ; ---------------------------------------------------------------
1248+ 700B                  ; Numero di cicli del beep (durata complessiva del suono)
1249+ 700B                  ; ---------------------------------------------------------------
1250+ 700B 06 78            ld   b, 120
1251+ 700D
1252+ 700D              .sound_loop:
1253+ 700D
1254+ 700D                  ; ---------------------------------------------------------------
1255+ 700D                  ; SPEAKER ON
1256+ 700D                  ;
1257+ 700D                  ; Legge il colore del bordo corrente e attiva il bit 4
1258+ 700D                  ; per pilotare lo speaker.
1259+ 700D                  ; ---------------------------------------------------------------
1260+ 700D 3A 54 70         ld   a, (room_border_color)
1261+ 7010 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1262+ 7012
1263+ 7012 D3 FE            out  ($fe), a         ; scrive sul port ULA
1264+ 7014
1265+ 7014                  ; ---------------------------------------------------------------
1266+ 7014                  ; Delay (mezzo periodo)
1267+ 7014                  ; Loop software a consumo CPU
1268+ 7014                  ; ---------------------------------------------------------------
1269+ 7014 0E 3C            ld   c, 60
1270+ 7016
1271+ 7016              .d1:
1272+ 7016 0D               dec  c
1273+ 7017 20 FD            jr   nz, .d1
1274+ 7019
1275+ 7019                  ; ---------------------------------------------------------------
1276+ 7019                  ; SPEAKER OFF
1277+ 7019                  ;
1278+ 7019                  ; Mantiene il colore del bordo ma disattiva lo speaker
1279+ 7019                  ; ---------------------------------------------------------------
1280+ 7019 3A 54 70         ld   a, (room_border_color)
1281+ 701C E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1282+ 701E
1283+ 701E D3 FE            out  ($fe), a
1284+ 7020
1285+ 7020                  ; ---------------------------------------------------------------
1286+ 7020                  ; Secondo delay (mezzo periodo)
1287+ 7020                  ; Completa l’onda quadra
1288+ 7020                  ; ---------------------------------------------------------------
1289+ 7020 0E 3C            ld   c, 60
1290+ 7022
1291+ 7022              .d2:
1292+ 7022 0D               dec  c
1293+ 7023 20 FD            jr   nz, .d2
1294+ 7025
1295+ 7025                  ; ---------------------------------------------------------------
1296+ 7025                  ; Ripete fino a completare il numero di cicli
1297+ 7025                  ; ---------------------------------------------------------------
1298+ 7025 10 E6            djnz .sound_loop
1299+ 7027
1300+ 7027                  ; Ripristina registri salvati
1301+ 7027 D1               pop  de
1302+ 7028 C1               pop  bc
1303+ 7029
1304+ 7029 C9               ret
1305+ 702A
1306+ 702A              ; -------------------------------------------------------------------
1307+ 702A              ; CheckActiveItemAtCell
1308+ 702A              ;
1309+ 702A              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1310+ 702A              ; nella cella specificata della griglia items_grid.
1311+ 702A              ;
1312+ 702A              ; Questa routine usa una lookup diretta su una mappa 32x16,
1313+ 702A              ; evitando la scansione della ItemsTable.
1314+ 702A              ;
1315+ 702A              ; Input:
1316+ 702A              ;   B = Colonna (0..31)
1317+ 702A              ;   C = Riga (0..15)
1318+ 702A              ;
1319+ 702A              ; Output:
1320+ 702A              ;   Carry Set   = item presente nella cella
1321+ 702A              ;   Carry Clear = nessun item
1322+ 702A              ;
1323+ 702A              ; Nota:
1324+ 702A              ;   HL NON è restituito valido (commento originale non corretto:
1325+ 702A              ;   la routine non punta a ItemsTable).
1326+ 702A              ; -------------------------------------------------------------------
1327+ 702A              CheckActiveItemAtCell:
1328+ 702A
1329+ 702A                  ; Salva registri usati
1330+ 702A D5               push de
1331+ 702B E5               push hl
1332+ 702C
1333+ 702C                  ; ---------------------------------------------------------------
1334+ 702C                  ; Calcolo indice lineare nella griglia 32x16:
1335+ 702C                  ;
1336+ 702C                  ; offset = Row * 32 + Col
1337+ 702C                  ; ---------------------------------------------------------------
1338+ 702C 26 00            ld   h, 0
1339+ 702E 69               ld   l, c              ; HL = Row
1340+ 702F
1341+ 702F 29               add  hl, hl            ; *2
1342+ 7030 29               add  hl, hl            ; *4
1343+ 7031 29               add  hl, hl            ; *8
1344+ 7032 29               add  hl, hl            ; *16
1345+ 7033 29               add  hl, hl            ; *32
1346+ 7034
1347+ 7034                  ; Aggiunge la colonna
1348+ 7034 58               ld   e, b
1349+ 7035 16 00            ld   d, 0
1350+ 7037 19               add  hl, de            ; HL = Row*32 + Col
1351+ 7038
1352+ 7038                  ; ---------------------------------------------------------------
1353+ 7038                  ; Accesso alla griglia degli item attivi
1354+ 7038                  ; ---------------------------------------------------------------
1355+ 7038 11 00 90         ld   de, items_grid
1356+ 703B 19               add  hl, de            ; HL = address cella
1357+ 703C
1358+ 703C                  ; ---------------------------------------------------------------
1359+ 703C                  ; Controllo presenza item
1360+ 703C                  ;
1361+ 703C                  ; items_grid contiene:
1362+ 703C                  ;   0 = nessun item
1363+ 703C                  ;   >0 = item attivo (colore o flag)
1364+ 703C                  ; ---------------------------------------------------------------
1365+ 703C 7E               ld   a, (hl)
1366+ 703D B7               or   a
1367+ 703E 28 04            jr   z, .not_active
1368+ 7040
1369+ 7040                  ; ---------------------------------------------------------------
1370+ 7040                  ; Item trovato
1371+ 7040                  ; ---------------------------------------------------------------
1372+ 7040 E1               pop  hl
1373+ 7041 D1               pop  de
1374+ 7042
1375+ 7042 37               scf                    ; Carry = 1
1376+ 7043 C9               ret
1377+ 7044
1378+ 7044              .not_active:
1379+ 7044
1380+ 7044                  ; ---------------------------------------------------------------
1381+ 7044                  ; Nessun item nella cella
1382+ 7044                  ; ---------------------------------------------------------------
1383+ 7044 E1               pop  hl
1384+ 7045 D1               pop  de
1385+ 7046
1386+ 7046 B7               or   a                 ; Carry = 0
1387+ 7047 C9               ret
1388+ 7048
