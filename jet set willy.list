   5+ 6BAD              ; -------------------------------------------------------------------
   6+ 6BAD              ; MovePlayer
   7+ 6BAD              ;
   8+ 6BAD              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6BAD              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6BAD              ; con i muri.
  11+ 6BAD              ;
  12+ 6BAD              ; Input:
  13+ 6BAD              ;   D = stato dei controlli (bitfield)
  14+ 6BAD              ;
  15+ 6BAD              ; Strutture utilizzate:
  16+ 6BAD              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6BAD              ;   player_speed    -> velocità orizzontale
  18+ 6BAD              ;   flags           -> flag di stato input
  19+ 6BAD              ;
  20+ 6BAD              ; Bit controlli:
  21+ 6BAD              ;   bit 0 = sinistra
  22+ 6BAD              ;   bit 1 = destra
  23+ 6BAD              ;
  24+ 6BAD              ; Nota:
  25+ 6BAD              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6BAD              ;   ignorato per tutta la durata del salto.
  27+ 6BAD              ;
  28+ 6BAD              ; Output:
  29+ 6BAD              ;   aggiorna PlayerPos e body_state
  30+ 6BAD              ; -------------------------------------------------------------------
  31+ 6BAD              MovePlayer:
  32+ 6BAD
  33+ 6BAD                  ; ---------------------------------------------------------------
  34+ 6BAD                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6BAD                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6BAD                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6BAD                  ; ---------------------------------------------------------------
  38+ 6BAD 3A 8B EC         ld   a, (on_ground)
  39+ 6BB0 B7               or   a
  40+ 6BB1 20 1A            jr   nz, .on_ground_check
  41+ 6BB3
  42+ 6BB3 3A 90 EC         ld   a, (jump_dir)
  43+ 6BB6 B7               or   a
  44+ 6BB7 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6BB8
  46+ 6BB8                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6BB8 DD 21 84 EC      ld   ix, flags
  48+ 6BBC DD CB 00 86      res  $00, (ix)
  49+ 6BC0
  50+ 6BC0 ED 4B 7C EC      ld   bc, (PlayerPos)
  51+ 6BC4 FE 01            cp   1
  52+ 6BC6 28 1D            jr   z, movePlayer_left
  53+ 6BC8 FE 02            cp   2
  54+ 6BCA 28 6A            jr   z, movePlayer_right
  55+ 6BCC C9               ret
  56+ 6BCD
  57+ 6BCD              .on_ground_check:
  58+ 6BCD                  ; ---------------------------------------------------------------
  59+ 6BCD                  ; Se siamo a terra, muoviti solo se c'è input (bit 0 di flags impostato)
  60+ 6BCD                  ; ---------------------------------------------------------------
  61+ 6BCD DD 21 84 EC      ld   ix, flags
  62+ 6BD1 DD CB 00 46      bit  $00, (ix)
  63+ 6BD5 C8               ret  z
  64+ 6BD6
  65+ 6BD6 DD CB 00 86      res  $00, (ix)
  66+ 6BDA
  67+ 6BDA ED 4B 7C EC      ld   bc, (PlayerPos)
  68+ 6BDE
  69+ 6BDE              .ground_input:
  70+ 6BDE                  ; ---------------------------------------------------------------
  71+ 6BDE                  ; Input: destra?
  72+ 6BDE                  ; ---------------------------------------------------------------
  73+ 6BDE CB 4A            bit  $01, d
  74+ 6BE0 20 54            jr   nz, movePlayer_right
  75+ 6BE2
  76+ 6BE2                  ; ---------------------------------------------------------------
  77+ 6BE2                  ; Input: sinistra?
  78+ 6BE2                  ; ---------------------------------------------------------------
  79+ 6BE2 CB 42            bit  $00, d
  80+ 6BE4 C8               ret  z
  81+ 6BE5
  82+ 6BE5              ; ===============================================================
  83+ 6BE5              ; MOVIMENTO SINISTRA
  84+ 6BE5              ; ===============================================================
  85+ 6BE5              movePlayer_left:
  86+ 6BE5                  ; Impedisci lo spostamento a sinistra se Willy è sul conveyor ed il conveyor va a destra.
  87+ 6BE5 CD D1 74         call CheckWillyOnConveyor
  88+ 6BE8 30 05            jr   nc, .continue_left
  89+ 6BEA 3A A3 EF         ld   a, (conveyor_dir)
  90+ 6BED B7               or   a
  91+ 6BEE C0               ret  nz                     ; Se è sul conveyor e va a destra, ritorna senza muovere
  92+ 6BEF
  93+ 6BEF              .continue_left:
  94+ 6BEF                  ; Calcola nuova posizione: X - speed
