 926+ 6BE1 96               sub  (hl)
 927+ 6BE2 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 928+ 6BE3 47               ld   b, a              ; B = limit_left
 929+ 6BE4
 930+ 6BE4 3A F9 7D         ld   a, (ramp_col)
 931+ 6BE7 3C               inc  a
 932+ 6BE8 4F               ld   c, a              ; C = limit_right (exclusive)
 933+ 6BE9
 934+ 6BE9 7B               ld   a, e              ; A = Col
 935+ 6BEA B8               cp   b
 936+ 6BEB 38 15            jr   c, .check_platform_case
 937+ 6BED B9               cp   c
 938+ 6BEE 30 12            jr   nc, .check_platform_case
 939+ 6BF0
 940+ 6BF0                  ; Calcola B = ramp_col - Col
 941+ 6BF0 3A F9 7D         ld   a, (ramp_col)
 942+ 6BF3 93               sub  e
 943+ 6BF4 47               ld   b, a              ; B = offset
 944+ 6BF5
 945+ 6BF5                  ; SlopeRow = ramp_row - B
 946+ 6BF5 3A F8 7D         ld   a, (ramp_row)
