 161  8961                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 162  8961                  IF ENABLE_RAMP_DEBUG_BARS != 0
 163  8961 ~                ld   a, (willy_on_ramp)
 164  8961 ~                or   a
