 970+ 6B14
 971+ 6B14              ; -------------------------------------------------------------------
 972+ 6B14              ; Controlla se Willy collide orizzontalmente con un Wall alle coordinate specificate
 973+ 6B14              ; Input: C = X pixel (da controllare), B = Y pixel (attuale)
 974+ 6B14              ; Output: Carry flag impostato se c'è collisione, altrimenti resettato
 975+ 6B14              ; -------------------------------------------------------------------
 976+ 6B14              CheckWillyWallCollision:
 977+ 6B14 C5               push bc
 978+ 6B15
 979+ 6B15                  ; 1. Punto superiore: (X, Y)
 980+ 6B15 CD E3 6A         call CheckWallCell
 981+ 6B18 38 17            jr   c, .collision
 982+ 6B1A
 983+ 6B1A                  ; 2. Punto medio: (X, Y + 7)
 984+ 6B1A 78               ld   a, b
 985+ 6B1B C6 07            add  a, 7
 986+ 6B1D 47               ld   b, a
 987+ 6B1E CD E3 6A         call CheckWallCell
 988+ 6B21 38 0E            jr   c, .collision
 989+ 6B23
 990+ 6B23                  ; 3. Punto inferiore: (X, Y + 15)
 991+ 6B23 C1               pop  bc
 992+ 6B24 C5               push bc
 993+ 6B25 78               ld   a, b
 994+ 6B26 C6 0F            add  a, 15
 995+ 6B28 47               ld   b, a
 996+ 6B29 CD E3 6A         call CheckWallCell
 997+ 6B2C 38 03            jr   c, .collision
 998+ 6B2E
 999+ 6B2E C1               pop  bc
1000+ 6B2F B7               or   a                 ; Reset carry (nessuna collisione)
1001+ 6B30 C9               ret
1002+ 6B31
1003+ 6B31              .collision:
1004+ 6B31 C1               pop  bc
1005+ 6B32 37               scf                    ; Set carry (collisione avvenuta)
1006+ 6B33 C9               ret
1007+ 6B34
1008+ 6B34              ; -------------------------------------------------------------------
1009+ 6B34              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1010+ 6B34              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1011+ 6B34              ; -------------------------------------------------------------------
1012+ 6B34              UnpackRoomLayout:
1013+ 6B34 E5               push hl
1014+ 6B35 D5               push de
1015+ 6B36 C5               push bc
1016+ 6B37
1017+ 6B37 2A 5C 77         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1018+ 6B3A 11 02 75         ld   de, unpacked_layout ; DE = buffer RAM
1019+ 6B3D 06 80            ld   b, 128             ; 128 byte
1020+ 6B3F              .byte_loop:
1021+ 6B3F 7E               ld   a, (hl)            ; Leggi byte compresso
1022+ 6B40 23               inc  hl
1023+ 6B41
1024+ 6B41 4F               ld   c, a               ; C = salvataggio
1025+ 6B42
1026+ 6B42                  ; Cella 0: bit 7-6
1027+ 6B42 07               rlca
1028+ 6B43 07               rlca
1029+ 6B44 E6 03            and  3
1030+ 6B46 12               ld   (de), a
1031+ 6B47 13               inc  de
1032+ 6B48
1033+ 6B48                  ; Cella 1: bit 5-4
1034+ 6B48 79               ld   a, c
1035+ 6B49 07               rlca
1036+ 6B4A 07               rlca
1037+ 6B4B 07               rlca
1038+ 6B4C 07               rlca
1039+ 6B4D E6 03            and  3
1040+ 6B4F 12               ld   (de), a
1041+ 6B50 13               inc  de
1042+ 6B51
1043+ 6B51                  ; Cella 2: bit 3-2
1044+ 6B51 79               ld   a, c
1045+ 6B52 0F               rrca
1046+ 6B53 0F               rrca
1047+ 6B54 E6 03            and  3
1048+ 6B56 12               ld   (de), a
1049+ 6B57 13               inc  de
1050+ 6B58
1051+ 6B58                  ; Cella 3: bit 1-0
1052+ 6B58 79               ld   a, c
1053+ 6B59 E6 03            and  3
1054+ 6B5B 12               ld   (de), a
1055+ 6B5C 13               inc  de
1056+ 6B5D
1057+ 6B5D 10 E0            djnz .byte_loop
1058+ 6B5F
1059+ 6B5F C1               pop  bc
1060+ 6B60 D1               pop  de
1061+ 6B61 E1               pop  hl
1062+ 6B62 C9               ret
1063+ 6B63
1064+ 6B63              ; -------------------------------------------------------------------
1065+ 6B63              ; Legge il tipo di cella dal buffer decompresso in RAM
1066+ 6B63              ; Input: A = Row (0..15), C = Col (0..31)
1067+ 6B63              ; Output: A = tipo di cella (0..3)
1068+ 6B63              ; Preserva tutti gli altri registri.
1069+ 6B63              ; -------------------------------------------------------------------
1070+ 6B63              GetCellFromUnpacked:
1071+ 6B63 E5               push hl
1072+ 6B64 D5               push de
1073+ 6B65
1074+ 6B65 6F               ld   l, a
1075+ 6B66 26 00            ld   h, 0
1076+ 6B68 29               add  hl, hl
1077+ 6B69 29               add  hl, hl
1078+ 6B6A 29               add  hl, hl
1079+ 6B6B 29               add  hl, hl
1080+ 6B6C 29               add  hl, hl            ; HL = Row * 32
1081+ 6B6D 59               ld   e, c
1082+ 6B6E 16 00            ld   d, 0
1083+ 6B70 19               add  hl, de            ; HL = Row * 32 + Col
1084+ 6B71 11 02 75         ld   de, unpacked_layout
1085+ 6B74 19               add  hl, de
1086+ 6B75 7E               ld   a, (hl)           ; A = cell type
1087+ 6B76
1088+ 6B76 D1               pop  de
1089+ 6B77 E1               pop  hl
1090+ 6B78 C9               ret
1091+ 6B79
1092+ 6B79              ; -------------------------------------------------------------------
1093+ 6B79              ; GetRampY
1094+ 6B79              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1095+ 6B79              ; Input: C = PlayerX
1096+ 6B79              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1097+ 6B79              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1098+ 6B79              ; -------------------------------------------------------------------
1099+ 6B79              GetRampY:
1100+ 6B79 3A 08 77         ld   a, (ramp_len)
1101+ 6B7C B7               or   a
1102+ 6B7D C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1103+ 6B7E
1104+ 6B7E 3A 07 77         ld   a, (ramp_dir)
1105+ 6B81 B7               or   a
1106+ 6B82 28 4C            jr   z, .dir_left
1107+ 6B84
1108+ 6B84              .dir_right:
1109+ 6B84                  ; Rampa sale a destra (up-right)
1110+ 6B84 3A 0A 77         ld   a, (ramp_col)
1111+ 6B87 87               add  a, a              ; *2
1112+ 6B88 87               add  a, a              ; *4
1113+ 6B89 87               add  a, a              ; *8 (X start in pixel)
1114+ 6B8A 5F               ld   e, a              ; E = X_left
1115+ 6B8B
1116+ 6B8B 3A 08 77         ld   a, (ramp_len)
1117+ 6B8E 87               add  a, a              ; *2
1118+ 6B8F 87               add  a, a              ; *4
1119+ 6B90 87               add  a, a              ; *8
1120+ 6B91 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1121+ 6B92 67               ld   h, a              ; H = X_right_boundary
1122+ 6B93
1123+ 6B93 79               ld   a, c              ; A = PlayerX
1124+ 6B94 BB               cp   e
1125+ 6B95 DA 2A 6C         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1126+ 6B98
1127+ 6B98 BC               cp   h
1128+ 6B99 38 15            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1129+ 6B9B
1130+ 6B9B                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1131+ 6B9B 94               sub  h                 ; A = PlayerX - X_right_boundary
1132+ 6B9C FE 08            cp   8
1133+ 6B9E D2 2A 6C         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1134+ 6BA1
1135+ 6BA1                  ; Piattaforma adiacente! Restituisci PlayerY = (ramp_row - ramp_len + 1) * 8 - 16
1136+ 6BA1 3A 09 77         ld   a, (ramp_row)
1137+ 6BA4 21 08 77         ld   hl, ramp_len
1138+ 6BA7 96               sub  (hl)
1139+ 6BA8 3C               inc  a                 ; A = Row
1140+ 6BA9 87               add  a, a              ; *2
1141+ 6BAA 87               add  a, a              ; *4
1142+ 6BAB 87               add  a, a              ; *8
1143+ 6BAC D6 10            sub  16                ; A = Row * 8 - 16
1144+ 6BAE 37               scf                    ; Set carry (dentro rampa/piattaforma)
1145+ 6BAF C9               ret
1146+ 6BB0
1147+ 6BB0              .on_ramp_slope:
1148+ 6BB0 3A 09 77         ld   a, (ramp_row)
1149+ 6BB3 87               add  a, a              ; *2
1150+ 6BB4 87               add  a, a              ; *4
1151+ 6BB5 87               add  a, a              ; *8
1152+ 6BB6 D6 10            sub  16                ; A = ramp_row * 8 - 16
1153+ 6BB8 83               add  a, e              ; A = ramp_row * 8 - 16 + X_left
1154+ 6BB9 91               sub  c                 ; A = A - PlayerX
1155+ 6BBA
1156+ 6BBA                  ; Calcola la quota della piattaforma:
1157+ 6BBA                  ; platform_Y = (ramp_row - ramp_len + 1) * 8 - 16
1158+ 6BBA 57               ld   d, a              ; D = calculated Y
1159+ 6BBB
1160+ 6BBB 3A 09 77         ld   a, (ramp_row)
1161+ 6BBE 21 08 77         ld   hl, ramp_len
1162+ 6BC1 96               sub  (hl)
1163+ 6BC2 3C               inc  a                 ; A = Row
1164+ 6BC3 87               add  a, a              ; *2
1165+ 6BC4 87               add  a, a              ; *4
1166+ 6BC5 87               add  a, a              ; *8
1167+ 6BC6 D6 10            sub  16                ; A = platform_Y
1168+ 6BC8
1169+ 6BC8 BA               cp   d                 ; Compara platform_Y con calculated Y
1170+ 6BC9 38 02            jr   c, .no_clamp      ; Se platform_Y < calculated Y, non limitare
1171+ 6BCB
1172+ 6BCB                  ; Altrimenti, limita a platform_Y
1173+ 6BCB 37               scf                    ; Set carry (dentro rampa)
1174+ 6BCC C9               ret
1175+ 6BCD
1176+ 6BCD              .no_clamp:
1177+ 6BCD 7A               ld   a, d              ; Ripristina A = calculated Y
1178+ 6BCE 37               scf                    ; Set carry
1179+ 6BCF C9               ret
1180+ 6BD0
1181+ 6BD0              .dir_left:
1182+ 6BD0                  ; Rampa sale a sinistra (up-left)
