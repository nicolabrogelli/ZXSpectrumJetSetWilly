 914+ 6AE3              ; -------------------------------------------------------------------
 915+ 6AE3              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 916+ 6AE3              ; Input: C = X, B = Y
 917+ 6AE3              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 918+ 6AE3              ; -------------------------------------------------------------------
 919+ 6AE3              CheckWallCell:
 920+ 6AE3 E5               push hl
 921+ 6AE4 D5               push de
 922+ 6AE5 C5               push bc
 923+ 6AE6
 924+ 6AE6                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 925+ 6AE6 78               ld   a, b
 926+ 6AE7 FE 80            cp   128
 927+ 6AE9 30 1F            jr   nc, .not_wall
 928+ 6AEB
 929+ 6AEB                  ; 2. Calcola riga di layout: r = Y / 8
 930+ 6AEB CB 3F            srl  a
 931+ 6AED CB 3F            srl  a
 932+ 6AEF CB 3F            srl  a                 ; A = r (0..15)
 933+ 6AF1
 934+ 6AF1                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 935+ 6AF1 5F               ld   e, a              ; E = r (Row)
 936+ 6AF2 79               ld   a, c
 937+ 6AF3 CB 3F            srl  a
 938+ 6AF5 CB 3F            srl  a
 939+ 6AF7 CB 3F            srl  a                 ; A = c (0..31)
 940+ 6AF9 4F               ld   c, a              ; C = c (Col)
 941+ 6AFA
 942+ 6AFA                  ; Se la cella è sulla rampa, non considerarla un muro!
 943+ 6AFA 53               ld   d, e              ; D = Row
 944+ 6AFB 59               ld   e, c              ; E = Col
 945+ 6AFC CD 68 6A         call IsCellOnRamp
 946+ 6AFF 38 09            jr   c, .not_wall
 947+ 6B01
 948+ 6B01 7A               ld   a, d              ; A = Row
 949+ 6B02 4B               ld   c, e              ; C = Col
 950+ 6B03 CD 63 6B         call GetCellFromUnpacked ; A = cell type
 951+ 6B06
 952+ 6B06                  ; Controlla se è Wall (2)
 953+ 6B06 FE 02            cp   2
 954+ 6B08 28 05            jr   z, .is_wall
 955+ 6B0A
 956+ 6B0A              .not_wall:
 957+ 6B0A C1               pop  bc
 958+ 6B0B D1               pop  de
 959+ 6B0C E1               pop  hl
 960+ 6B0D B7               or   a                 ; Clear carry
 961+ 6B0E C9               ret
 962+ 6B0F
 963+ 6B0F              .is_wall:
 964+ 6B0F C1               pop  bc
 965+ 6B10 D1               pop  de
 966+ 6B11 E1               pop  hl
