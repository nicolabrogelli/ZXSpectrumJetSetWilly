 987+ 7E50 DD 77 06         ld   (ix+6), a         ; Cambia direzione in Basso
 988+ 7E53 C3 73 7E         jp   .next
 989+ 7E56
 990+ 7E56              .vert_down:
 991+ 7E56 DD 7E 03         ld   a, (ix+3)         ; Current Y
 992+ 7E59 C6 02            add  a, 2              ; Muovi in basso di 2 pixel
 993+ 7E5B DD BE 05         cp   (ix+5)            ; Max Limit (Bottom)
 994+ 7E5E 28 08            jr   z, .v_rev_up
 995+ 7E60 30 06            jr   nc, .v_rev_up
 996+ 7E62 DD 77 03         ld   (ix+3), a
 997+ 7E65 C3 73 7E         jp   .next
 998+ 7E68
