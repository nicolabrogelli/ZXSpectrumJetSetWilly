1304+ 73BB 18 04            jr   .next_no_inc
1305+ 73BD
1306+ 73BD              .next_item:
1307+ 73BD
1308+ 73BD                  ; ---------------------------------------------------------------
1309+ 73BD                  ; Salta i campi del record:
1310+ 73BD                  ;   X
1311+ 73BD                  ;   Y
1312+ 73BD                  ;   Color
1313+ 73BD                  ;   Collected
1314+ 73BD                  ; ---------------------------------------------------------------
1315+ 73BD 23               inc  hl
1316+ 73BE 23               inc  hl
1317+ 73BF 23               inc  hl
1318+ 73C0 23               inc  hl
1319+ 73C1
1320+ 73C1              .next_no_inc:
1321+ 73C1
1322+ 73C1                  ; ---------------------------------------------------------------
1323+ 73C1                  ; Avanza al record successivo.
1324+ 73C1                  ;
