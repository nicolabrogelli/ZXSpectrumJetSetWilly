 856  8DEB BA               cp   d
 857  8DEC 28 04            jr   z, .x_overlap
 858  8DEE 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 859  8DF0 18 0E            jr   .no_conv_collision
 860  8DF2
