1352+ 77BA 7A               ld   a, d
1353+ 77BB B3               or   e
1354+ 77BC CA C3 78         jp   z, .no_ramp_change
1355+ 77BF 3A 70 FB         ld   a, (ramp_len)
1356+ 77C2 B7               or   a
1357+ 77C3 CA C3 78         jp   z, .no_ramp_change
1358+ 77C6
1359+ 77C6                  ; Calcola Row e Col: Offset = DE - 24064
1360+ 77C6 21 00 A2         ld   hl, -24064
1361+ 77C9 19               add  hl, de            ; HL = Offset
1362+ 77CA 54               ld   d, h
1363+ 77CB 5D               ld   e, l
1364+ 77CC
1365+ 77CC 7B               ld   a, e
1366+ 77CD E6 1F            and  31
1367+ 77CF 32 72 FB         ld   (ramp_col), a     ; Col Start
1368+ 77D2
1369+ 77D2 CB 3C            srl  h
1369+ 77D4 CB 1D          rr l
1370+ 77D6 CB 3C            srl  h
1370+ 77D8 CB 1D          rr l
1371+ 77DA CB 3C            srl  h
1371+ 77DC CB 1D          rr l
1372+ 77DE CB 3C            srl  h
1372+ 77E0 CB 1D          rr l
1373+ 77E2 CB 3C            srl  h
