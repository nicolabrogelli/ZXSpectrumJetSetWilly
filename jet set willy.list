 255+ 5EE8 18 04            jr   .compare_col
 256+ 5EEA              .r_left:
 257+ 5EEA 3A BF 78         ld   a, (ramp_col)
 258+ 5EED 90               sub  b                 ; A = ramp_col - B
 259+ 5EEE              .compare_col:
