1246+ 7431 D5               push de
1247+ 7432
1248+ 7432 26 00            ld   h, 0
1249+ 7434 68               ld   l, b              ; HL = Row
1250+ 7435
1251+ 7435 29               add  hl, hl            ; *2
1252+ 7436 29               add  hl, hl            ; *4
1253+ 7437 29               add  hl, hl            ; *8
1254+ 7438 29               add  hl, hl            ; *16
1255+ 7439 29               add  hl, hl            ; *32
1256+ 743A
1257+ 743A 59               ld   e, c
1258+ 743B 16 00            ld   d, 0
1259+ 743D
1260+ 743D 19               add  hl, de            ; Row*32 + Col
1261+ 743E
1262+ 743E 11 00 B0         ld   de, items_grid
1263+ 7441 19               add  hl, de
1264+ 7442
1265+ 7442                  ; La cella non contiene più un item
1266+ 7442 36 00            ld   (hl), 0
1267+ 7444
1268+ 7444 D1               pop  de
1269+ 7445 E1               pop  hl
1270+ 7446
1271+ 7446                  ; ---------------------------------------------------------------
1272+ 7446                  ; Conserva il puntatore all'entry corrente
1273+ 7446                  ; poiché le routine successive possono alterare HL.
1274+ 7446                  ; ---------------------------------------------------------------
1275+ 7446 E5               push hl
1276+ 7447
1277+ 7447                  ; ---------------------------------------------------------------
