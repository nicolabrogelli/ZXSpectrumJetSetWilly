 270  8390
 271  8390              ; -------------------------------------------------------------------
 272  8390              ; TriggerGameOver
 273  8390              ; Scatena la schermata di Game Over per la stanza corrente.
 274  8390              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 275  8390              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 276  8390              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 277  8390              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 278  8390              ; - Premendo ENTER, ripristina integralmente la partita ed avvia la nuova
 279  8390              ;   sessione dal primo livello (Stanza 0: The Off Licence) alle 07:00 AM.
 280  8390              ; -------------------------------------------------------------------
 281  8390              TriggerGameOver:
 282  8390                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede e della scritta GAME OVER
 283  8390 CD 4E 61         call Gfx_DrawGameOverScreen
 284  8393
 285  8393                  ; 2. Attende il rilascio del tasto ENTER se era già premuto
 286  8393              .wait_enter_release:
 287  8393 76               halt
 288  8394 3E BF            ld   a, $bf
 289  8396 DB FE            in   a, ($fe)
 290  8398 1F               rra
 291  8399 30 F8            jr   nc, .wait_enter_release
 292  839B
 293  839B                  ; 3. Attesa della pressione del tasto ENTER con animazione ciclo colore su GAME OVER (Riga 5, Col 11)
 294  839B 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 295  839D              .wait_enter_press:
 296  839D 76               halt
 297  839E
 298  839E                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 299  839E 0C               inc  c
 300  839F 79               ld   a, c
 301  83A0 CB 3F            srl  a
 302  83A2 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 303  83A4 E6 07            and  7
 304  83A6 5F               ld   e, a
 305  83A7 16 00            ld   d, 0
 306  83A9 21 46 61         ld   hl, game_over_color_table
 307  83AC 19               add  hl, de
 308  83AD 7E               ld   a, (hl)               ; A = nuovo colore attributo
 309  83AE 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 310  83B1 06 09            ld   b, 9
 311  83B3              .color_cycle_loop:
 312  83B3 77               ld   (hl), a
 313  83B4 23               inc  hl
 314  83B5 10 FC            djnz .color_cycle_loop
 315  83B7
 316  83B7                  ; Controlla se il tasto ENTER è premuto
 317  83B7 3E BF            ld   a, $bf
 318  83B9 DB FE            in   a, ($fe)
 319  83BB 1F               rra
 320  83BC 38 DF            jr   c, .wait_enter_press
 321  83BE
 322  83BE                  ; 4. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 323  83BE CD C4 83         call ResetFullGameState
 324  83C1
 325  83C1                  ; 5. Avvia la nuova partita dal primo livello (Stanza 0: The Off Licence)
 326  83C1 C3 78 82         jp   LoadRoomAndRestart
 327  83C4
 328  83C4              ; -------------------------------------------------------------------
 329  83C4              ; ResetFullGameState
 330  83C4              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 331  83C4              ; per l'avvio di una nuova partita dopo il Game Over.
 332  83C4              ; -------------------------------------------------------------------
 333  83C4              ResetFullGameState:
 334  83C4                  ; Ripristina gli attributi schermo di default (Inchiostro Bianco, Sfondo Nero)
 335  83C4 21 8D 5C         ld   hl, ATTR_P
 336  83C7 36 07            ld   (hl), $07
 337  83C9 3E 07            ld   a, $07
 338  83CB 32 8F 5C         ld   (ATTR_T), a
 339  83CE
 340  83CE                  ; Ripristina il numero di vite iniziali
 341  83CE 3E 07            ld   a, INITIAL_LIVES
 342  83D0 32 CA E6         ld   (willy_lives), a
 343  83D3
 344  83D3                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 345  83D3 AF               xor  a
 346  83D4 32 C7 E6         ld   (items_collected), a
 347  83D7 32 C3 E6         ld   (body_state), a
 348  83DA 32 D6 E6         ld   (w_warp_state), a
 349  83DD 32 D9 E6         ld   (w_key_prev), a
 350  83E0 32 DA E6         ld   (enter_key_prev), a
 351  83E3 32 CB E6         ld   (velocity_y), a
 352  83E6 32 CD E6         ld   (jump_pressed), a
 353  83E9 32 CF E6         ld   (coyote_timer), a
 354  83EC 32 D2 E6         ld   (jump_frame), a
 355  83EF 32 D1 E6         ld   (jump_dir), a
 356  83F2 32 43 EA         ld   (transition_active), a
 357  83F5 32 C7 EA         ld   (willy_safety_timer), a
 358  83F8 3E FF            ld   a, $ff
 359  83FA 32 DB E6         ld   (digit_key_prev), a
 360  83FD 3E 01            ld   a, 1
 361  83FF 32 D4 E6         ld   (q_prev), a
 362  8402 32 D5 E6         ld   (a_prev), a
 363  8405 32 CC E6         ld   (on_ground), a
 364  8408
 365  8408                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 366  8408 3E 30            ld   a, '0'
 367  840A 32 E9 63         ld   (status_line + 16), a
 368  840D 32 EA 63         ld   (status_line + 17), a
 369  8410 32 EB 63         ld   (status_line + 18), a
 370  8413
 371  8413                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 372  8413 CD 12 80         call ResetItemsTable
 373  8416
 374  8416                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 375  8416 CD A7 68         call InitRoomEntryPositions
 376  8419
 377  8419                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 378  8419 3E 07            ld   a, 7
 379  841B 32 CA EA         ld   (time_hours), a
 380  841E AF               xor  a
 381  841F 32 CB EA         ld   (time_minutes), a
 382  8422 32 CC EA         ld   (time_period), a       ; 0 = AM
 383  8425 32 CF EA         ld   (game_objective_completed), a
 384  8428 2A DE E6         ld   hl, (counter)
 385  842B 22 CD EA         ld   (time_last_counter), hl
 386  842E CD 5B 63         call Gfx_UpdateTimeDisplay
 387  8431
 388  8431                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 389  8431 21 97 84         ld   hl, TheOffLicenceLayout
 390  8434 22 3D EA         ld   (room_ptr), hl
 391  8437
 392  8437 C9               ret
 393  8438
 394  8438              ; -------------------------------------------------------------------
 395  8438              ; Time_UpdateClock
 396  8438              ; Gestisce lo scorrimento del tempo durante il gioco.
 397  8438              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 398  8438              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 399  8438              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 400  8438              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 401  8438              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 402  8438              ; sia completato, scatena immediatamente il Game Over.
 403  8438              ; -------------------------------------------------------------------
 404  8438              Time_UpdateClock:
 405  8438                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 406  8438 2A DE E6         ld   hl, (counter)
 407  843B ED 5B CD EA      ld   de, (time_last_counter)
 408  843F B7               or   a
 409  8440 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 410  8442
 411  8442                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 412  8442 11 32 00         ld   de, CLOCK_TICKS_PER_MINUTE
 413  8445 B7               or   a
 414  8446 ED 52            sbc  hl, de
 415  8448 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 416  8449
 417  8449                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 418  8449 2A CD EA         ld   hl, (time_last_counter)
 419  844C 11 32 00         ld   de, CLOCK_TICKS_PER_MINUTE
 420  844F 19               add  hl, de
 421  8450 22 CD EA         ld   (time_last_counter), hl
 422  8453
 423  8453                  ; Incrementa di 1 minuto il tempo di gioco
 424  8453 3A CB EA         ld   a, (time_minutes)
 425  8456 3C               inc  a
 426  8457 FE 3C            cp   60
 427  8459 38 21            jr   c, .minutes_ok
 428  845B
 429  845B                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 430  845B AF               xor  a
 431  845C 32 CB EA         ld   (time_minutes), a
 432  845F 3A CA EA         ld   a, (time_hours)
 433  8462 3C               inc  a
 434  8463 FE 0C            cp   12
 435  8465 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 436  8467 FE 0D            cp   13
 437  8469 38 0E            jr   c, .hours_ok
 438  846B 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 439  846D 18 0A            jr   .hours_ok
 440  846F
 441  846F              .toggle_period:
 442  846F F5               push af                     ; Salva A (valore 12)
 443  8470 3A CC EA         ld   a, (time_period)
 444  8473 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 445  8475 32 CC EA         ld   (time_period), a
 446  8478 F1               pop  af                     ; Ripristina A = 12
 447  8479
 448  8479              .hours_ok:
 449  8479 32 CA EA         ld   (time_hours), a
 450  847C
 451  847C              .minutes_ok:
 452  847C 32 CB EA         ld   (time_minutes), a
 453  847F
 454  847F                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 455  847F CD 5B 63         call Gfx_UpdateTimeDisplay
 456  8482
 457  8482                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 458  8482 3A CF EA         ld   a, (game_objective_completed)
 459  8485 B7               or   a
 460  8486 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 461  8487
 462  8487                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 463  8487 3A CC EA         ld   a, (time_period)
 464  848A B7               or   a
 465  848B C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 466  848C
 467  848C 3A CA EA         ld   a, (time_hours)
 468  848F FE 0C            cp   12
 469  8491 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
 470  8493 C9               ret
 471  8494
 472  8494              .time_limit_reached:
 473  8494                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
 474  8494                  ; Scatena immediatamente il Game Over temporale!
 475  8494 C3 90 83         jp   TriggerGameOver
