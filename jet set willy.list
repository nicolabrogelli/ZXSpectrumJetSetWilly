   8+ 87E4              ; Audio_UpdateJumpSound
   9+ 87E4              ;
  10+ 87E4              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 87E4              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 87E4              ; -------------------------------------------------------------------
  13+ 87E4              Audio_UpdateJumpSound:
  14+ 87E4 F5               push af
  15+ 87E5 C5               push bc
  16+ 87E6 D5               push de
  17+ 87E7 E5               push hl
  18+ 87E8
  19+ 87E8                  ; Controlla se il suono è attivo (note < 18)
  20+ 87E8 3A 58 F8         ld   a, (Audio_jump_sound_note)
  21+ 87EB FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 87ED 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 87EF
  24+ 87EF                  ; Carica la nota corrente da suonare
  25+ 87EF 5F               ld   e, a
  26+ 87F0 16 00            ld   d, 0
  27+ 87F2 21 1E 88         ld   hl, Audio_JumpSoundDelays
  28+ 87F5 19               add  hl, de
  29+ 87F6 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 87F7 57               ld   d, a                      ; D = delay della nota
  31+ 87F8
  32+ 87F8                  ; Suona la nota: 15 cicli
  33+ 87F8 06 0F            ld   b, 15
  34+ 87FA              .note_loop:
  35+ 87FA                  ; Speaker ON
  36+ 87FA 3A 51 F4         ld   a, (room_border_color)
  37+ 87FD F6 10            or   $10
  38+ 87FF D3 FE            out  ($fe), a
  39+ 8801 4A               ld   c, d
  40+ 8802              .d1:
  41+ 8802 0D               dec  c
  42+ 8803 20 FD            jr   nz, .d1
  43+ 8805
  44+ 8805                  ; Speaker OFF
  45+ 8805 3A 51 F4         ld   a, (room_border_color)
  46+ 8808 E6 EF            and  $ef
  47+ 880A D3 FE            out  ($fe), a
  48+ 880C 4A               ld   c, d
  49+ 880D              .d2:
  50+ 880D 0D               dec  c
  51+ 880E 20 FD            jr   nz, .d2
  52+ 8810
  53+ 8810 10 E8            djnz .note_loop
  54+ 8812
  55+ 8812                  ; Passa alla nota successiva
  56+ 8812 3A 58 F8         ld   a, (Audio_jump_sound_note)
  57+ 8815 3C               inc  a
  58+ 8816 32 58 F8         ld   (Audio_jump_sound_note), a
  59+ 8819
  60+ 8819              .done:
  61+ 8819 E1               pop  hl
  62+ 881A D1               pop  de
  63+ 881B C1               pop  bc
  64+ 881C F1               pop  af
  65+ 881D C9               ret
  66+ 881E
  67+ 881E              Audio_JumpSoundDelays:
  68+ 881E 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 8822 19 13 0C 06
  68+ 8826 0C 13 19 20
  68+ 882A 26 2D 33 3A
  68+ 882E 40 47
