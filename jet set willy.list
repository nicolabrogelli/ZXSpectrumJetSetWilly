1018+ 6BFD              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
1019+ 6BFD              ; Input: C = X, B = Y
1020+ 6BFD              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
1021+ 6BFD              ; -------------------------------------------------------------------
1022+ 6BFD              CheckWallCell:
1023+ 6BFD E5               push hl
1024+ 6BFE D5               push de
1025+ 6BFF C5               push bc
1026+ 6C00
1027+ 6C00                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1028+ 6C00 78               ld   a, b
1029+ 6C01 FE 80            cp   128
1030+ 6C03 30 1F            jr   nc, .not_wall
1031+ 6C05
1032+ 6C05                  ; 2. Calcola riga di layout: r = Y / 8
1033+ 6C05 CB 3F            srl  a
1034+ 6C07 CB 3F            srl  a
1035+ 6C09 CB 3F            srl  a                 ; A = r (0..15)
1036+ 6C0B
1037+ 6C0B                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1038+ 6C0B 5F               ld   e, a              ; E = r (Row)
1039+ 6C0C 79               ld   a, c
1040+ 6C0D CB 3F            srl  a
1041+ 6C0F CB 3F            srl  a
1042+ 6C11 CB 3F            srl  a                 ; A = c (0..31)
1043+ 6C13 4F               ld   c, a              ; C = c (Col)
1044+ 6C14
1045+ 6C14                  ; Se la cella è sulla rampa, non considerarla un muro!
1046+ 6C14 53               ld   d, e              ; D = Row
1047+ 6C15 59               ld   e, c              ; E = Col
1048+ 6C16 CD 82 6B         call IsCellOnRamp
1049+ 6C19 38 09            jr   c, .not_wall
1050+ 6C1B
1051+ 6C1B 7A               ld   a, d              ; A = Row
1052+ 6C1C 4B               ld   c, e              ; C = Col
1053+ 6C1D CD 7D 6C         call GetCellFromUnpacked ; A = cell type
1054+ 6C20
1055+ 6C20                  ; Controlla se è Wall (2)
1056+ 6C20 FE 02            cp   2
1057+ 6C22 28 05            jr   z, .is_wall
1058+ 6C24
