1604+ 858E              ; -------------------------------------------------------------------
1605+ 858E              ; CheckWillyItemCollision
1606+ 858E              ;
1607+ 858E              ; Verifica se Willy collide con un item utilizzando il controllo
1608+ 858E              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1609+ 858E              ;
1610+ 858E              ; Input:
1611+ 858E              ;   A = ItemX (colonna attributi 0..31)
1612+ 858E              ;   H = ItemY (riga attributi 3..18)
1613+ 858E              ;
1614+ 858E              ; Coordinate item:
1615+ 858E              ;   Ogni item occupa una cella da 8x8 pixel.
1616+ 858E              ;
1617+ 858E              ; Coordinate Willy:
1618+ 858E              ;   Willy occupa un rettangolo di 16x16 pixel.
1619+ 858E              ;
1620+ 858E              ; Output:
1621+ 858E              ;   Carry Set   = collisione rilevata
1622+ 858E              ;   Carry Clear = nessuna collisione
1623+ 858E              ;
1624+ 858E              ; Registri preservati:
1625+ 858E              ;   BC, DE, HL
1626+ 858E              ; -------------------------------------------------------------------
1627+ 858E              CheckWillyItemCollision:
1628+ 858E
1629+ 858E                  ; Salva i registri utilizzati
1630+ 858E C5               push bc
1631+ 858F D5               push de
1632+ 8590 E5               push hl
1633+ 8591
1634+ 8591                  ; ---------------------------------------------------------------
1635+ 8591                  ; Calcola il bounding box orizzontale dell'item
1636+ 8591                  ;
1637+ 8591                  ; ItemLeft  = ItemX * 8
1638+ 8591                  ; ItemRight = ItemLeft + 7
1639+ 8591                  ;
1640+ 8591                  ; E = ItemLeft
1641+ 8591                  ; D = ItemRight
1642+ 8591                  ; ---------------------------------------------------------------
1643+ 8591 6F               ld   l, a              ; L = ItemX
1644+ 8592
1645+ 8592 7D               ld   a, l
1646+ 8593 87               add  a, a              ; *2
1647+ 8594 87               add  a, a              ; *4
1648+ 8595 87               add  a, a              ; *8
1649+ 8596
1650+ 8596 5F               ld   e, a              ; E = ItemLeft
1651+ 8597
1652+ 8597 C6 07            add  a, 7
1653+ 8599 57               ld   d, a              ; D = ItemRight
1654+ 859A
1655+ 859A                  ; ---------------------------------------------------------------
1656+ 859A                  ; Recupera la posizione corrente di Willy
1657+ 859A                  ;
1658+ 859A                  ; B = WillyY
1659+ 859A                  ; C = WillyX
1660+ 859A                  ; ---------------------------------------------------------------
1661+ 859A ED 4B 7C EC      ld   bc, (PlayerPos)
1662+ 859E
1663+ 859E                  ; ---------------------------------------------------------------
1664+ 859E                  ; Primo test:
1665+ 859E                  ;
1666+ 859E                  ; WillyLeft <= ItemRight
1667+ 859E                  ;
1668+ 859E                  ; Se Willy è completamente a destra dell'item
1669+ 859E                  ; non può esserci collisione.
1670+ 859E                  ; ---------------------------------------------------------------
1671+ 859E 79               ld   a, c              ; A = WillyLeft
1672+ 859F
1673+ 859F BA               cp   d                 ; WillyLeft vs ItemRight
1674+ 85A0
1675+ 85A0 28 04            jr   z, .x_ok
1676+ 85A2 38 02            jr   c, .x_ok
1677+ 85A4
1678+ 85A4 18 29            jr   .no_collision
1679+ 85A6
1680+ 85A6              .x_ok:
1681+ 85A6
1682+ 85A6                  ; ---------------------------------------------------------------
1683+ 85A6                  ; Secondo test:
1684+ 85A6                  ;
1685+ 85A6                  ; WillyRight >= ItemLeft
1686+ 85A6                  ;
1687+ 85A6                  ; WillyRight = WillyX + 7
1688+ 85A6                  ; ---------------------------------------------------------------
1689+ 85A6 C6 07            add  a, 7
1690+ 85A8
1691+ 85A8 BB               cp   e                 ; WillyRight vs ItemLeft
1692+ 85A9
1693+ 85A9 28 04            jr   z, .y_check
1694+ 85AB 30 02            jr   nc, .y_check
1695+ 85AD
1696+ 85AD 18 20            jr   .no_collision
1697+ 85AF
1698+ 85AF              .y_check:
1699+ 85AF
1700+ 85AF                  ; ---------------------------------------------------------------
1701+ 85AF                  ; Recupera ItemY dal valore originale di HL
1702+ 85AF                  ;
1703+ 85AF                  ; H contiene la riga dell'item.
1704+ 85AF                  ; ---------------------------------------------------------------
1705+ 85AF E1               pop  hl
1706+ 85B0 E5               push hl
1707+ 85B1
1708+ 85B1                  ; ---------------------------------------------------------------
1709+ 85B1                  ; Calcola il bounding box verticale dell'item
1710+ 85B1                  ;
1711+ 85B1                  ; ItemTop    = ItemY * 8
1712+ 85B1                  ; ItemBottom = ItemTop + 7
1713+ 85B1                  ;
1714+ 85B1                  ; E = ItemTop
1715+ 85B1                  ; D = ItemBottom
1716+ 85B1                  ; ---------------------------------------------------------------
1717+ 85B1 7C               ld   a, h
1718+ 85B2
1719+ 85B2 87               add  a, a              ; *2
1720+ 85B3 87               add  a, a              ; *4
1721+ 85B4 87               add  a, a              ; *8
1722+ 85B5
1723+ 85B5 5F               ld   e, a              ; ItemTop
1724+ 85B6
1725+ 85B6 C6 07            add  a, 7
1726+ 85B8 57               ld   d, a              ; ItemBottom
1727+ 85B9
1728+ 85B9                  ; ---------------------------------------------------------------
1729+ 85B9                  ; Primo test verticale:
1730+ 85B9                  ;
1731+ 85B9                  ; WillyTop <= ItemBottom
1732+ 85B9                  ; ---------------------------------------------------------------
1733+ 85B9 78               ld   a, b              ; WillyTop
1734+ 85BA
1735+ 85BA BA               cp   d
1736+ 85BB
1737+ 85BB 28 04            jr   z, .y_ok
1738+ 85BD 38 02            jr   c, .y_ok
1739+ 85BF
1740+ 85BF 18 0E            jr   .no_collision
1741+ 85C1
1742+ 85C1              .y_ok:
1743+ 85C1
1744+ 85C1                  ; ---------------------------------------------------------------
1745+ 85C1                  ; Secondo test verticale:
1746+ 85C1                  ;
1747+ 85C1                  ; WillyBottom >= ItemTop
1748+ 85C1                  ;
1749+ 85C1                  ; WillyBottom = WillyY + 15
1750+ 85C1                  ; ---------------------------------------------------------------
1751+ 85C1 C6 0F            add  a, 15
1752+ 85C3
1753+ 85C3 BB               cp   e
1754+ 85C4
1755+ 85C4 28 04            jr   z, .collision
1756+ 85C6 30 02            jr   nc, .collision
1757+ 85C8
1758+ 85C8 18 05            jr   .no_collision
1759+ 85CA
1760+ 85CA              .collision:
