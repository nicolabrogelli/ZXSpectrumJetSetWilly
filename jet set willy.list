   7+ 7788              ; -------------------------------------------------------------------
   8+ 7788              ; Audio_UpdateJumpSound
   9+ 7788              ;
  10+ 7788              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7788              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7788              ; -------------------------------------------------------------------
  13+ 7788              Audio_UpdateJumpSound:
  14+ 7788 F5               push af
  15+ 7789 C5               push bc
  16+ 778A D5               push de
  17+ 778B E5               push hl
  18+ 778C
  19+ 778C                  ; Controlla se il suono è attivo (note < 18)
  20+ 778C 3A 1E 7C         ld   a, (Audio_jump_sound_note)
  21+ 778F FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7791 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7793
  24+ 7793                  ; Carica la nota corrente da suonare
  25+ 7793 5F               ld   e, a
  26+ 7794 16 00            ld   d, 0
  27+ 7796 21 C2 77         ld   hl, Audio_JumpSoundDelays
  28+ 7799 19               add  hl, de
  29+ 779A 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 779B 57               ld   d, a                      ; D = delay della nota
  31+ 779C
  32+ 779C                  ; Suona la nota: 15 cicli
  33+ 779C 06 0F            ld   b, 15
  34+ 779E              .note_loop:
  35+ 779E                  ; Speaker ON
  36+ 779E 3A AD 78         ld   a, (room_border_color)
  37+ 77A1 F6 10            or   $10
  38+ 77A3 D3 FE            out  ($fe), a
  39+ 77A5 4A               ld   c, d
  40+ 77A6              .d1:
  41+ 77A6 0D               dec  c
  42+ 77A7 20 FD            jr   nz, .d1
  43+ 77A9
  44+ 77A9                  ; Speaker OFF
  45+ 77A9 3A AD 78         ld   a, (room_border_color)
  46+ 77AC E6 EF            and  $ef
  47+ 77AE D3 FE            out  ($fe), a
  48+ 77B0 4A               ld   c, d
  49+ 77B1              .d2:
  50+ 77B1 0D               dec  c
  51+ 77B2 20 FD            jr   nz, .d2
  52+ 77B4
  53+ 77B4 10 E8            djnz .note_loop
  54+ 77B6
  55+ 77B6                  ; Passa alla nota successiva
  56+ 77B6 3A 1E 7C         ld   a, (Audio_jump_sound_note)
  57+ 77B9 3C               inc  a
  58+ 77BA 32 1E 7C         ld   (Audio_jump_sound_note), a
  59+ 77BD
  60+ 77BD              .done:
  61+ 77BD E1               pop  hl
  62+ 77BE D1               pop  de
  63+ 77BF C1               pop  bc
  64+ 77C0 F1               pop  af
  65+ 77C1 C9               ret
  66+ 77C2
  67+ 77C2              Audio_JumpSoundDelays:
  68+ 77C2 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 77C6 19 13 0C 06
  68+ 77CA 0C 13 19 20
  68+ 77CE 26 2D 33 3A
  68+ 77D2 40 47
  69+ 77D4
