1215+ 798F
1216+ 798F              .not_wall:
1217+ 798F
1218+ 798F                  ; Nasty
1219+ 798F 21 BB 00         ld   hl, OFFSET_NASTY
1220+ 7992 19               add  hl, de
1221+ 7993
1222+ 7993              .draw_cell:
1223+ 7993
1224+ 7993                  ; ---------------------------------------------------------------
1225+ 7993                  ; HL punta ora alla grafica del tile da ridisegnare.
1226+ 7993                  ;
1227+ 7993                  ; Gfx_DrawTile si aspetta:
1228+ 7993                  ;   IX = puntatore tile
1229+ 7993                  ;   B  = Row
1230+ 7993                  ;   C  = Col
1231+ 7993                  ; ---------------------------------------------------------------
1232+ 7993 E5               push hl
1233+ 7994 DD E1            pop  ix
1234+ 7996
1235+ 7996                  ; Ripristina Row e Col salvati in IY
1236+ 7996 FD E5            push iy
1237+ 7998 C1               pop  bc
1238+ 7999
1239+ 7999                  ; Disegna il tile originale
1240+ 7999 CD 47 62         call Gfx_DrawTile
1241+ 799C
1242+ 799C                  ; ---------------------------------------------------------------
1243+ 799C                  ; Ripristina i registri salvati
1244+ 799C                  ; ---------------------------------------------------------------
1245+ 799C DD E1            pop  ix
1246+ 799E E1               pop  hl
1247+ 799F D1               pop  de
1248+ 79A0 C1               pop  bc
1249+ 79A1 FD E1            pop  iy
1250+ 79A3
1251+ 79A3 C9               ret
