  72+ 7B5F ~            ; Audio_UpdateMusic
  73+ 7B5F ~            ;
  74+ 7B5F ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 7B5F ~            ; Viene chiamata a ogni frame.
  76+ 7B5F ~            ; -------------------------------------------------------------------
  77+ 7B5F ~            Audio_UpdateMusic:
  78+ 7B5F ~                push af
  79+ 7B5F ~                push bc
  80+ 7B5F ~                push de
  81+ 7B5F ~                push hl
  82+ 7B5F ~
  83+ 7B5F ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 7B5F ~                ld   a, (Audio_jump_sound_note)
  85+ 7B5F ~                cp   18
  86+ 7B5F ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 7B5F ~
  88+ 7B5F ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 7B5F ~                ld   a, (Audio_music_frame_counter)
  90+ 7B5F ~                dec  a
  91+ 7B5F ~                ld   (Audio_music_frame_counter), a
  92+ 7B5F ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 7B5F ~
  94+ 7B5F ~                ; Altrimenti carica la nota successiva
  95+ 7B5F ~                ld   a, (Audio_music_note_idx)
  96+ 7B5F ~                inc  a
  97+ 7B5F ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 7B5F ~                jr   c, .no_wrap
  99+ 7B5F ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 7B5F ~            .no_wrap:
 101+ 7B5F ~                ld   (Audio_music_note_idx), a
 102+ 7B5F ~
 103+ 7B5F ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 7B5F ~                ld   e, a
 105+ 7B5F ~                ld   d, 0
 106+ 7B5F ~                ld   hl, Audio_MusicSheet
 107+ 7B5F ~                add  hl, de
 108+ 7B5F ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 7B5F ~
 110+ 7B5F ~                ; Leggi durata (secondo byte)
 111+ 7B5F ~                inc  hl
 112+ 7B5F ~                ld   a, (hl)
 113+ 7B5F ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 7B5F ~                jr   nz, .dur_ok
 115+ 7B5F ~                ld   a, 1
 116+ 7B5F ~            .dur_ok:
 117+ 7B5F ~                ld   (Audio_music_frame_counter), a
 118+ 7B5F ~
 119+ 7B5F ~            .play_current_note:
 120+ 7B5F ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 7B5F ~                ld   a, (Audio_music_note_idx)
 122+ 7B5F ~                ld   e, a
 123+ 7B5F ~                ld   d, 0
 124+ 7B5F ~                ld   hl, Audio_MusicSheet
 125+ 7B5F ~                add  hl, de
 126+ 7B5F ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 7B5F ~                ld   a, (hl)                  ; A = delay
 128+ 7B5F ~                or   a
 129+ 7B5F ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 7B5F ~
 131+ 7B5F ~                ; Suona la nota: 2 cicli
 132+ 7B5F ~                ld   d, a                     ; D = delay
 133+ 7B5F ~                ld   b, 2                     ; 2 cicli per frame
 134+ 7B5F ~            .note_loop:
 135+ 7B5F ~                ; Speaker ON
 136+ 7B5F ~                ld   a, (room_border_color)
 137+ 7B5F ~                or   $10
 138+ 7B5F ~                out  ($fe), a
 139+ 7B5F ~                ld   c, d
 140+ 7B5F ~            .d1:
 141+ 7B5F ~                push af
 142+ 7B5F ~                pop  af
 143+ 7B5F ~                dec  c
 144+ 7B5F ~                jr   nz, .d1
 145+ 7B5F ~
 146+ 7B5F ~                ; Speaker OFF
 147+ 7B5F ~                ld   a, (room_border_color)
 148+ 7B5F ~                and  $ef
 149+ 7B5F ~                out  ($fe), a
 150+ 7B5F ~                ld   c, d
 151+ 7B5F ~            .d2:
 152+ 7B5F ~                push af
 153+ 7B5F ~                pop  af
 154+ 7B5F ~                dec  c
 155+ 7B5F ~                jr   nz, .d2
 156+ 7B5F ~
 157+ 7B5F ~                djnz .note_loop
 158+ 7B5F ~
 159+ 7B5F ~            .done:
 160+ 7B5F ~                pop  hl
 161+ 7B5F ~                pop  de
 162+ 7B5F ~                pop  bc
 163+ 7B5F ~                pop  af
 164+ 7B5F ~                ret
 165+ 7B5F ~
 166+ 7B5F ~            Audio_MusicSheet:
 167+ 7B5F ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 7B5F ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 7B5F ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 7B5F ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 7B5F ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 7B5F ~                db 90, 10, 107, 20, 68, 65
 173+ 7B5F                  ELSE
 174+ 7B5F              Audio_UpdateMusic:
 175+ 7B5F C9               ret
 176+ 7B60                  ENDIF
