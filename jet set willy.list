1787+ 85D4              ; Items_CheckCollision
1788+ 85D4              ;
1789+ 85D4              ; Controlla se Willy entra in collisione con uno degli item
1790+ 85D4              ; attivi presenti nella stanza corrente.
1791+ 85D4              ;
1792+ 85D4              ; Per ogni item:
1793+ 85D4              ;   - verifica che appartenga alla stanza corrente
1794+ 85D4              ;   - verifica che non sia già stato raccolto
1795+ 85D4              ;   - esegue il test di collisione con Willy
1796+ 85D4              ;
1797+ 85D4              ; Se l'item viene raccolto:
1798+ 85D4              ;   - imposta il flag "collected"
1799+ 85D4              ;   - rimuove l'item dalla cache items_grid
1800+ 85D4              ;   - incrementa il contatore degli oggetti raccolti
1801+ 85D4              ;   - aggiorna l'HUD
1802+ 85D4              ;   - ripristina il tile di sfondo
1803+ 85D4              ;   - riproduce il suono di raccolta
1804+ 85D4              ;
1805+ 85D4              ; Formato record ItemsTable:
1806+ 85D4              ;   +0 RoomID
1807+ 85D4              ;   +1 X
1808+ 85D4              ;   +2 Y
1809+ 85D4              ;   +3 Color
1810+ 85D4              ;   +4 Collected
1811+ 85D4              ;
1812+ 85D4              ; Fine tabella:
1813+ 85D4              ;   RoomID = $FF
1814+ 85D4              ; -------------------------------------------------------------------
1815+ 85D4              Items_CheckCollision:
1816+ 85D4
1817+ 85D4                  ; Salva i registri utilizzati
1818+ 85D4 E5               push hl
1819+ 85D5 D5               push de
1820+ 85D6 C5               push bc
1821+ 85D7
1822+ 85D7                  ; Inizio scansione della tabella degli item
1823+ 85D7 21 24 7F         ld   hl, ItemsTable
1824+ 85DA
1825+ 85DA              .loop:
1826+ 85DA
1827+ 85DA                  ; ---------------------------------------------------------------
1828+ 85DA                  ; Legge il Room ID dell'item corrente
1829+ 85DA                  ; ---------------------------------------------------------------
1830+ 85DA 7E               ld   a, (hl)
1831+ 85DB
1832+ 85DB                  ; $FF indica fine tabella
1833+ 85DB FE FF            cp   $FF
1834+ 85DD 28 58            jr   z, .done
1835+ 85DF
1836+ 85DF                  ; ---------------------------------------------------------------
1837+ 85DF                  ; Verifica se l'item appartiene alla stanza corrente
1838+ 85DF                  ; ---------------------------------------------------------------
1839+ 85DF 57               ld   d, a              ; D = RoomID item
1840+ 85E0
1841+ 85E0 3A A2 EF         ld   a, (current_room)
1842+ 85E3 BA               cp   d
1843+ 85E4
1844+ 85E4                  ; Se appartiene a un'altra stanza salta il record
1845+ 85E4 20 4A            jr   nz, .next_item
1846+ 85E6
1847+ 85E6                  ; ---------------------------------------------------------------
1848+ 85E6                  ; Legge coordinate e stato dell'item
1849+ 85E6                  ; ---------------------------------------------------------------
1850+ 85E6
1851+ 85E6 23               inc  hl
1852+ 85E7 4E               ld   c, (hl)           ; C = X
1853+ 85E8
1854+ 85E8 23               inc  hl
1855+ 85E9 46               ld   b, (hl)           ; B = Y
1856+ 85EA
1857+ 85EA 23               inc  hl                ; salta Color
1858+ 85EB
1859+ 85EB 23               inc  hl                ; punta a Collected
1860+ 85EC
1861+ 85EC 7E               ld   a, (hl)
1862+ 85ED
1863+ 85ED                  ; ---------------------------------------------------------------
1864+ 85ED                  ; Item già raccolto?
1865+ 85ED                  ; ---------------------------------------------------------------
1866+ 85ED B7               or   a
1867+ 85EE 20 44            jr   nz, .next_no_inc
1868+ 85F0
1869+ 85F0                  ; ---------------------------------------------------------------
1870+ 85F0                  ; Test collisione Willy ↔ Item
1871+ 85F0                  ;
1872+ 85F0                  ; Input richiesto:
1873+ 85F0                  ;   A = ItemX
1874+ 85F0                  ;   H = ItemY
1875+ 85F0                  ; ---------------------------------------------------------------
1876+ 85F0 79               ld   a, c
1877+ 85F1
1878+ 85F1 E5               push hl                ; salva puntatore al flag Collected
1879+ 85F2
1880+ 85F2 60               ld   h, b
1881+ 85F3
1882+ 85F3 CD 8E 85         call CheckWillyItemCollision
1883+ 85F6
1884+ 85F6 E1               pop  hl
1885+ 85F7
1886+ 85F7                  ; Nessuna collisione
1887+ 85F7 30 3B            jr   nc, .next_no_inc
1888+ 85F9
1889+ 85F9                  ; ===============================================================
1890+ 85F9                  ; ITEM RACCOLTO
1891+ 85F9                  ; ===============================================================
1892+ 85F9
1893+ 85F9                  ; ---------------------------------------------------------------
1894+ 85F9                  ; Marca l'item come raccolto
1895+ 85F9                  ; ---------------------------------------------------------------
1896+ 85F9 36 01            ld   (hl), 1
1897+ 85FB
1898+ 85FB                  ; ---------------------------------------------------------------
1899+ 85FB                  ; Rimuove l'item dalla cache items_grid
1900+ 85FB                  ;
1901+ 85FB                  ; Calcolo:
1902+ 85FB                  ;   offset = Row * 32 + Col
1903+ 85FB                  ; ---------------------------------------------------------------
1904+ 85FB E5               push hl
1905+ 85FC D5               push de
1906+ 85FD
1907+ 85FD 26 00            ld   h, 0
1908+ 85FF 68               ld   l, b              ; HL = Row
1909+ 8600
1910+ 8600 29               add  hl, hl            ; *2
1911+ 8601 29               add  hl, hl            ; *4
1912+ 8602 29               add  hl, hl            ; *8
1913+ 8603 29               add  hl, hl            ; *16
1914+ 8604 29               add  hl, hl            ; *32
1915+ 8605
1916+ 8605 59               ld   e, c
1917+ 8606 16 00            ld   d, 0
1918+ 8608
1919+ 8608 19               add  hl, de            ; Row*32 + Col
1920+ 8609
1921+ 8609 11 7C EA         ld   de, items_grid
1922+ 860C 19               add  hl, de
1923+ 860D
1924+ 860D                  ; La cella non contiene più un item
1925+ 860D 36 00            ld   (hl), 0
1926+ 860F
1927+ 860F D1               pop  de
1928+ 8610 E1               pop  hl
1929+ 8611
1930+ 8611                  ; ---------------------------------------------------------------
1931+ 8611                  ; Conserva il puntatore all'entry corrente
1932+ 8611                  ; poiché le routine successive possono alterare HL.
1933+ 8611                  ; ---------------------------------------------------------------
1934+ 8611 E5               push hl
1935+ 8612
1936+ 8612                  ; ---------------------------------------------------------------
1937+ 8612                  ; Aggiorna il numero di oggetti raccolti
1938+ 8612                  ; ---------------------------------------------------------------
1939+ 8612 3A 86 EC         ld   a, (items_collected)
1940+ 8615
1941+ 8615 3C               inc  a
1942+ 8616
1943+ 8616 32 86 EC         ld   (items_collected), a
1944+ 8619
1945+ 8619 FE 4C            cp   TOTAL_ITEMS
1946+ 861B 38 07            jr   c, .objective_not_completed
1947+ 861D F5               push af
1948+ 861E 3E 01            ld   a, 1
1949+ 8620 32 8E F0         ld   (game_objective_completed), a
1950+ 8623 F1               pop  af
1951+ 8624              .objective_not_completed:
1952+ 8624
1953+ 8624                  ; ---------------------------------------------------------------
1954+ 8624                  ; Aggiorna il contatore visualizzato a schermo
1955+ 8624                  ; ---------------------------------------------------------------
1956+ 8624 CD A5 66         call Gfx_UpdateItemsCollectedDisplay
1957+ 8627
1958+ 8627                  ; ---------------------------------------------------------------
1959+ 8627                  ; Ripristina il tile originale della stanza
1960+ 8627                  ; eliminando la grafica dell'item.
1961+ 8627                  ;
1962+ 8627                  ; Input:
1963+ 8627                  ;   B = Row
1964+ 8627                  ;   C = Col
1965+ 8627                  ; ---------------------------------------------------------------
1966+ 8627 CD 4C 85         call RestoreBackgroundCell
1967+ 862A
1968+ 862A                  ; ---------------------------------------------------------------
1969+ 862A                  ; Riproduce il suono di raccolta
1970+ 862A                  ; ---------------------------------------------------------------
1971+ 862A CD A6 86         call Audio_PlayCollectSound
1972+ 862D
1973+ 862D                  ; Ripristina il puntatore alla tabella
1974+ 862D E1               pop  hl
1975+ 862E
1976+ 862E                  ; Continua con il record successivo
1977+ 862E 18 04            jr   .next_no_inc
1978+ 8630
1979+ 8630              .next_item:
1980+ 8630
1981+ 8630                  ; ---------------------------------------------------------------
1982+ 8630                  ; Salta i campi del record:
1983+ 8630                  ;   X
1984+ 8630                  ;   Y
1985+ 8630                  ;   Color
1986+ 8630                  ;   Collected
1987+ 8630                  ; ---------------------------------------------------------------
1988+ 8630 23               inc  hl
1989+ 8631 23               inc  hl
1990+ 8632 23               inc  hl
1991+ 8633 23               inc  hl
1992+ 8634
1993+ 8634              .next_no_inc:
1994+ 8634
1995+ 8634                  ; ---------------------------------------------------------------
1996+ 8634                  ; Avanza al record successivo.
1997+ 8634                  ;
1998+ 8634                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1999+ 8634                  ; ---------------------------------------------------------------
2000+ 8634 23               inc  hl
2001+ 8635
2002+ 8635 18 A3            jr   .loop
2003+ 8637
2004+ 8637              .done:
2005+ 8637
2006+ 8637                  ; Ripristina i registri
2007+ 8637 C1               pop  bc
2008+ 8638 D1               pop  de
2009+ 8639 E1               pop  hl
2010+ 863A
2011+ 863A C9               ret
2012+ 863B
2013+ 863B
2014+ 863B
2015+ 863B              ; -------------------------------------------------------------------
2016+ 863B              ; CheckActiveItemAtCell
2017+ 863B              ;
2018+ 863B              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2019+ 863B              ; nella cella specificata della griglia items_grid.
2020+ 863B              ;
2021+ 863B              ; Questa routine usa una lookup diretta su una mappa 32x16,
2022+ 863B              ; evitando la scansione della ItemsTable.
2023+ 863B              ;
2024+ 863B              ; Input:
2025+ 863B              ;   B = Colonna (0..31)
2026+ 863B              ;   C = Riga (0..15)
2027+ 863B              ;
2028+ 863B              ; Output:
2029+ 863B              ;   Carry Set   = item presente nella cella
2030+ 863B              ;   Carry Clear = nessun item
2031+ 863B              ;
2032+ 863B              ; Nota:
2033+ 863B              ;   HL NON è restituito valido (commento originale non corretto:
2034+ 863B              ;   la routine non punta a ItemsTable).
2035+ 863B              ; -------------------------------------------------------------------
2036+ 863B              CheckActiveItemAtCell:
2037+ 863B
2038+ 863B                  ; Salva registri usati
2039+ 863B D5               push de
2040+ 863C E5               push hl
2041+ 863D
2042+ 863D                  ; ---------------------------------------------------------------
2043+ 863D                  ; Calcolo indice lineare nella griglia 32x16:
2044+ 863D                  ;
2045+ 863D                  ; offset = Row * 32 + Col
2046+ 863D                  ; ---------------------------------------------------------------
2047+ 863D 26 00            ld   h, 0
2048+ 863F 69               ld   l, c              ; HL = Row
2049+ 8640
2050+ 8640 29               add  hl, hl            ; *2
2051+ 8641 29               add  hl, hl            ; *4
2052+ 8642 29               add  hl, hl            ; *8
2053+ 8643 29               add  hl, hl            ; *16
2054+ 8644 29               add  hl, hl            ; *32
2055+ 8645
2056+ 8645                  ; Aggiunge la colonna
2057+ 8645 58               ld   e, b
2058+ 8646 16 00            ld   d, 0
2059+ 8648 19               add  hl, de            ; HL = Row*32 + Col
2060+ 8649
2061+ 8649                  ; ---------------------------------------------------------------
2062+ 8649                  ; Accesso alla griglia degli item attivi
2063+ 8649                  ; ---------------------------------------------------------------
2064+ 8649 11 7C EA         ld   de, items_grid
2065+ 864C 19               add  hl, de            ; HL = address cella
2066+ 864D
2067+ 864D                  ; ---------------------------------------------------------------
2068+ 864D                  ; Controllo presenza item
2069+ 864D                  ;
2070+ 864D                  ; items_grid contiene:
2071+ 864D                  ;   0 = nessun item
2072+ 864D                  ;   >0 = item attivo (colore o flag)
2073+ 864D                  ; ---------------------------------------------------------------
2074+ 864D 7E               ld   a, (hl)
2075+ 864E B7               or   a
2076+ 864F 28 04            jr   z, .not_active
2077+ 8651
2078+ 8651                  ; ---------------------------------------------------------------
2079+ 8651                  ; Item trovato
2080+ 8651                  ; ---------------------------------------------------------------
2081+ 8651 E1               pop  hl
2082+ 8652 D1               pop  de
2083+ 8653
2084+ 8653 37               scf                    ; Carry = 1
2085+ 8654 C9               ret
2086+ 8655
2087+ 8655              .not_active:
2088+ 8655
2089+ 8655                  ; ---------------------------------------------------------------
2090+ 8655                  ; Nessun item nella cella
2091+ 8655                  ; ---------------------------------------------------------------
2092+ 8655 E1               pop  hl
2093+ 8656 D1               pop  de
2094+ 8657
2095+ 8657 B7               or   a                 ; Carry = 0
2096+ 8658 C9               ret
