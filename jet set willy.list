 276+ 7CC1 20 05            jr   nz, .not_foottree
 277+ 7CC3
 278+ 7CC3 3E 03            ld   a, 3               ; Room ID = 3
 279+ 7CC5 C3 5A 80         jp   .set_room
 280+ 7CC8
 281+ 7CC8              .not_foottree:
