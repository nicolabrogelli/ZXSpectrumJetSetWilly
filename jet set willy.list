1243+ 7761              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1244+ 7761              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1245+ 7761              ; -------------------------------------------------------------------
1246+ 7761              UnpackRoomLayout:
1247+ 7761 E5               push hl
1248+ 7762 D5               push de
1249+ 7763 C5               push bc
1250+ 7764
1251+ 7764 2A C4 FB         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1252+ 7767 11 6A F9         ld   de, unpacked_layout ; DE = buffer RAM
1253+ 776A 06 80            ld   b, 128             ; 128 byte
1254+ 776C              .byte_loop:
1255+ 776C 7E               ld   a, (hl)            ; Leggi byte compresso
1256+ 776D 23               inc  hl
1257+ 776E
1258+ 776E 4F               ld   c, a               ; C = salvataggio
1259+ 776F
1260+ 776F                  ; Cella 0: bit 7-6
1261+ 776F 07               rlca
1262+ 7770 07               rlca
1263+ 7771 E6 03            and  3
1264+ 7773 12               ld   (de), a
1265+ 7774 13               inc  de
1266+ 7775
1267+ 7775                  ; Cella 1: bit 5-4
1268+ 7775 79               ld   a, c
1269+ 7776 07               rlca
1270+ 7777 07               rlca
1271+ 7778 07               rlca
1272+ 7779 07               rlca
1273+ 777A E6 03            and  3
1274+ 777C 12               ld   (de), a
1275+ 777D 13               inc  de
1276+ 777E
1277+ 777E                  ; Cella 2: bit 3-2
1278+ 777E 79               ld   a, c
1279+ 777F 0F               rrca
1280+ 7780 0F               rrca
1281+ 7781 E6 03            and  3
1282+ 7783 12               ld   (de), a
1283+ 7784 13               inc  de
1284+ 7785
1285+ 7785                  ; Cella 3: bit 1-0
1286+ 7785 79               ld   a, c
1287+ 7786 E6 03            and  3
1288+ 7788 12               ld   (de), a
1289+ 7789 13               inc  de
1290+ 778A
1291+ 778A 10 E0            djnz .byte_loop
1292+ 778C
1293+ 778C C1               pop  bc
1294+ 778D D1               pop  de
1295+ 778E E1               pop  hl
1296+ 778F C9               ret
