 366+ 5F3A
 367+ 5F3A                  ; Esegui lo shift a destra se necessario
 368+ 5F3A 3A 5C 6F         ld   a, (sprite_shift)
 369+ 5F3D B7               or   a
 370+ 5F3E 28 1C            jr   z, .no_shift
 371+ 5F40
 372+ 5F40 C5               push bc            ; Salva il contatore delle linee (C) e lo shift (B)
 373+ 5F41 47               ld   b, a          ; B = contatore shift
 374+ 5F42 AF               xor  a             ; A = terzo byte (inizializzato a 0)
 375+ 5F43
 376+ 5F43              .shift_loop:
 377+ 5F43 CB 3A            srl  d
