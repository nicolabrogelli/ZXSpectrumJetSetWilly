1263+ 64D0 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
1264+ 64D2 3E 07            ld   a, $07
1265+ 64D4 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
