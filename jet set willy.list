  67+ 5E13 57               ld  d, a          ; D = high byte parziale
  68+ 5E14
  69+ 5E14 7C               ld  a, h
  70+ 5E15 E6 C0            and %11000000     ; A = y7 y6 000000 (third select)
  71+ 5E17 0F               rrca
  72+ 5E18 0F               rrca
  73+ 5E19 0F               rrca              ; Shift a destra di 3 -> 000 y7 y6 000
  74+ 5E1A B2               or  d
  75+ 5E1B 57               ld  d, a          ; D = high byte completo (010 y7 y6 y2 y1 y0)
  76+ 5E1C
  77+ 5E1C 7C               ld  a, h
  78+ 5E1D E6 38            and %00111000     ; A = 00 y5 y4 y3 000 (character row)
  79+ 5E1F 87               add a, a
  80+ 5E20 87               add a, a          ; Shift a sinistra di 2 -> y5 y4 y3 00000
  81+ 5E21 5F               ld  e, a          ; E = low byte parziale
  82+ 5E22
  83+ 5E22 7D               ld  a, l
  84+ 5E23 CB 3F            srl a
  85+ 5E25 CB 3F            srl a
  86+ 5E27 CB 3F            srl a              ; A = X / 8 (colonna)
  87+ 5E29 B3               or  e
  88+ 5E2A 5F               ld  e, a          ; E = low byte completo
  89+ 5E2B
  90+ 5E2B 62               ld  h, d
  91+ 5E2C 6B               ld  l, e          ; HL = indirizzo finale
  92+ 5E2D C9               ret
