 323+ 7590 ED 5B 24 7A      ld   de, (room_ptr)
 324+ 7594 B7               or   a
 325+ 7595 20 06            jr   nz, .not_bg
 326+ 7597 21 A0 00         ld   hl, OFFSET_BG
 327+ 759A 19               add  hl, de
 328+ 759B 18 16            jr   .draw_cell
 329+ 759D              .not_bg:
 330+ 759D 3D               dec  a
 331+ 759E 20 06            jr   nz, .not_floor
 332+ 75A0 21 A9 00         ld   hl, OFFSET_FLOOR
 333+ 75A3 19               add  hl, de
 334+ 75A4 18 0D            jr   .draw_cell
