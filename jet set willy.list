 218+ 64ED              ; LoadPositionPlayeinRoom
 219+ 64ED              ;
 220+ 64ED              ; Inizializza la posizione del player (Willy) quando entra
 221+ 64ED              ; in una nuova stanza.
 222+ 64ED              ;
 223+ 64ED              ; La posizione viene letta direttamente dai dati della stanza
 224+ 64ED              ; (layout/metadata) a partire da room_ptr.
 225+ 64ED              ;
 226+ 64ED              ; Output:
 227+ 64ED              ;   PlayerPos     = posizione iniziale (Y, X)
 228+ 64ED              ;   PlayerPosOld  = copia della posizione iniziale
 229+ 64ED              ;
 230+ 64ED              ; Struttura dati stanza:
 231+ 64ED              ;   OFFSET_POS_WILLY:
 232+ 64ED              ;       +0 = X
 233+ 64ED              ;       +1 = Y
 234+ 64ED              ; -------------------------------------------------------------------
 235+ 64ED              LoadPositionPlayeinRoom:
 236+ 64ED
 237+ 64ED                  ; ---------------------------------------------------------------
 238+ 64ED                  ; Accede alla struttura dati della stanza corrente
 239+ 64ED                  ; ---------------------------------------------------------------
 240+ 64ED 2A C5 7E         ld   hl, (room_ptr)
 241+ 64F0
 242+ 64F0                  ; ---------------------------------------------------------------
 243+ 64F0                  ; Salta all’offset dove è memorizzata la posizione iniziale
 244+ 64F0                  ; di Willy nella stanza
 245+ 64F0                  ; ---------------------------------------------------------------
 246+ 64F0 11 00 01         ld   de, OFFSET_POS_WILLY
 247+ 64F3 19               add  hl, de
 248+ 64F4
 249+ 64F4                  ; ---------------------------------------------------------------
 250+ 64F4                  ; Legge posizione iniziale del player
 251+ 64F4                  ; ---------------------------------------------------------------
 252+ 64F4
 253+ 64F4 4E               ld   c, (hl)           ; C = X iniziale
 254+ 64F5 23               inc  hl
 255+ 64F6 46               ld   b, (hl)           ; B = Y iniziale
 256+ 64F7
 257+ 64F7                  ; ---------------------------------------------------------------
 258+ 64F7                  ; Salva posizione corrente e posizione precedente
 259+ 64F7                  ; ---------------------------------------------------------------
 260+ 64F7 ED 43 57 7B      ld   (PlayerPos), bc
 261+ 64FB ED 43 59 7B      ld   (PlayerPosOld), bc
 262+ 64FF
 263+ 64FF C9               ret
