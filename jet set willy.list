 268  82BA              ; -------------------------------------------------------------------
 269  82BA              ; TriggerGameOver
 270  82BA              ; Scatena la schermata di Game Over per la stanza corrente.
 271  82BA              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 272  82BA              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 273  82BA              ; - Rimane in attesa della pressione del tasto ENTER.
 274  82BA              ; - Premendo ENTER, ripristina integralmente la partita ed avvia la nuova
 275  82BA              ;   sessione dal primo livello (Stanza 0: The Off Licence) alle 07:00 AM.
 276  82BA              ; -------------------------------------------------------------------
 277  82BA              TriggerGameOver:
 278  82BA                  ; 1. Disegna la schermata di Game Over per la stanza corrente
 279  82BA CD 24 61         call Gfx_DrawGameOverScreen
 280  82BD
 281  82BD                  ; 2. Attende il rilascio del tasto ENTER se era già premuto
 282  82BD              .wait_enter_release:
 283  82BD 76               halt
 284  82BE 3E BF            ld   a, $bf
 285  82C0 DB FE            in   a, ($fe)
 286  82C2 1F               rra
 287  82C3 30 F8            jr   nc, .wait_enter_release
 288  82C5
 289  82C5                  ; 3. Rimane completamente fermo in attesa della pressione del tasto ENTER
 290  82C5              .wait_enter_press:
 291  82C5 76               halt
 292  82C6 3E BF            ld   a, $bf
 293  82C8 DB FE            in   a, ($fe)
 294  82CA 1F               rra
 295  82CB 38 F8            jr   c, .wait_enter_press
 296  82CD
 297  82CD                  ; 4. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 298  82CD CD D3 82         call ResetFullGameState
 299  82D0
 300  82D0                  ; 5. Avvia la nuova partita dal primo livello (Stanza 0: The Off Licence)
 301  82D0 C3 A9 81         jp   LoadRoomAndRestart
