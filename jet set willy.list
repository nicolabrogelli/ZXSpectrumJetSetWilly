 179+ 881B              ; Audio_PlayCollectSound
 180+ 881B              ;
 181+ 881B              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 881B              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 881B              ; -------------------------------------------------------------------
