 345+ 6BC9              .draw_cell:
 346+ 6BC9 E5               push hl
 347+ 6BCA DD E1            pop  ix                ; IX = tile pointer
 348+ 6BCC
 349+ 6BCC FD E5            push iy
 350+ 6BCE C1               pop  bc                ; B = Row, C = Col
 351+ 6BCF
 352+ 6BCF CD 5F 61         call DrawTile
 353+ 6BD2
 354+ 6BD2 DD E1            pop  ix
 355+ 6BD4 E1               pop  hl
 356+ 6BD5 D1               pop  de
 357+ 6BD6 C1               pop  bc
 358+ 6BD7 FD E1            pop  iy                ; Ripristina IY
 359+ 6BD9 C9               ret
