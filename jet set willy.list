 996+ 6C2E              ; -------------------------------------------------------------------
 997+ 6C2E              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 998+ 6C2E              ; Input: C = X, B = Y
 999+ 6C2E              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
1000+ 6C2E              ; -------------------------------------------------------------------
1001+ 6C2E              CheckWallCell:
1002+ 6C2E E5               push hl
1003+ 6C2F D5               push de
1004+ 6C30 C5               push bc
1005+ 6C31
1006+ 6C31                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1007+ 6C31 78               ld   a, b
1008+ 6C32 FE 80            cp   128
1009+ 6C34 30 1F            jr   nc, .not_wall
1010+ 6C36
1011+ 6C36                  ; 2. Calcola riga di layout: r = Y / 8
1012+ 6C36 CB 3F            srl  a
1013+ 6C38 CB 3F            srl  a
1014+ 6C3A CB 3F            srl  a                 ; A = r (0..15)
1015+ 6C3C
1016+ 6C3C                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1017+ 6C3C 5F               ld   e, a              ; E = r (Row)
1018+ 6C3D 79               ld   a, c
1019+ 6C3E CB 3F            srl  a
1020+ 6C40 CB 3F            srl  a
1021+ 6C42 CB 3F            srl  a                 ; A = c (0..31)
1022+ 6C44 4F               ld   c, a              ; C = c (Col)
1023+ 6C45
1024+ 6C45                  ; Se la cella è sulla rampa, non considerarla un muro!
1025+ 6C45 53               ld   d, e              ; D = Row
1026+ 6C46 59               ld   e, c              ; E = Col
1027+ 6C47 CD B3 6B         call IsCellOnRamp
1028+ 6C4A 38 09            jr   c, .not_wall
1029+ 6C4C
1030+ 6C4C 7A               ld   a, d              ; A = Row
1031+ 6C4D 4B               ld   c, e              ; C = Col
1032+ 6C4E CD AE 6C         call GetCellFromUnpacked ; A = cell type
1033+ 6C51
1034+ 6C51                  ; Controlla se è Wall (2)
1035+ 6C51 FE 02            cp   2
1036+ 6C53 28 05            jr   z, .is_wall
1037+ 6C55
1038+ 6C55              .not_wall:
1039+ 6C55 C1               pop  bc
1040+ 6C56 D1               pop  de
1041+ 6C57 E1               pop  hl
