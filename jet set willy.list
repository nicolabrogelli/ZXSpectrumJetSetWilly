   8+ 8208              ; Audio_UpdateJumpSound
   9+ 8208              ;
  10+ 8208              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8208              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8208              ; -------------------------------------------------------------------
  13+ 8208              Audio_UpdateJumpSound:
  14+ 8208 F5               push af
  15+ 8209 C5               push bc
  16+ 820A D5               push de
  17+ 820B E5               push hl
  18+ 820C
  19+ 820C                  ; Controlla se il suono è attivo (note < 18)
  20+ 820C 3A F3 EA         ld   a, (Audio_jump_sound_note)
  21+ 820F FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8211 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8213
  24+ 8213                  ; Carica la nota corrente da suonare
  25+ 8213 5F               ld   e, a
  26+ 8214 16 00            ld   d, 0
  27+ 8216 21 42 82         ld   hl, Audio_JumpSoundDelays
  28+ 8219 19               add  hl, de
  29+ 821A 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 821B 57               ld   d, a                      ; D = delay della nota
  31+ 821C
  32+ 821C                  ; Suona la nota: 15 cicli
  33+ 821C 06 0F            ld   b, 15
  34+ 821E              .note_loop:
  35+ 821E                  ; Speaker ON
  36+ 821E 3A EC E6         ld   a, (room_border_color)
  37+ 8221 F6 10            or   $10
  38+ 8223 D3 FE            out  ($fe), a
  39+ 8225 4A               ld   c, d
  40+ 8226              .d1:
  41+ 8226 0D               dec  c
  42+ 8227 20 FD            jr   nz, .d1
  43+ 8229
  44+ 8229                  ; Speaker OFF
  45+ 8229 3A EC E6         ld   a, (room_border_color)
  46+ 822C E6 EF            and  $ef
  47+ 822E D3 FE            out  ($fe), a
  48+ 8230 4A               ld   c, d
  49+ 8231              .d2:
  50+ 8231 0D               dec  c
  51+ 8232 20 FD            jr   nz, .d2
  52+ 8234
  53+ 8234 10 E8            djnz .note_loop
  54+ 8236
  55+ 8236                  ; Passa alla nota successiva
  56+ 8236 3A F3 EA         ld   a, (Audio_jump_sound_note)
  57+ 8239 3C               inc  a
  58+ 823A 32 F3 EA         ld   (Audio_jump_sound_note), a
  59+ 823D
  60+ 823D              .done:
  61+ 823D E1               pop  hl
  62+ 823E D1               pop  de
  63+ 823F C1               pop  bc
  64+ 8240 F1               pop  af
  65+ 8241 C9               ret
  66+ 8242
  67+ 8242              Audio_JumpSoundDelays:
  68+ 8242 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 8246 19 13 0C 06
  68+ 824A 0C 13 19 20
  68+ 824E 26 2D 33 3A
  68+ 8252 40 47
  69+ 8254
  70+ 8254                  IF ENABLE_MUSIC != 0
  71+ 8254 ~            ; -------------------------------------------------------------------
  72+ 8254 ~            ; Audio_UpdateMusic
  73+ 8254 ~            ;
  74+ 8254 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8254 ~            ; Viene chiamata a ogni frame.
  76+ 8254 ~            ; -------------------------------------------------------------------
  77+ 8254 ~            Audio_UpdateMusic:
  78+ 8254 ~                push af
  79+ 8254 ~                push bc
  80+ 8254 ~                push de
  81+ 8254 ~                push hl
  82+ 8254 ~
  83+ 8254 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8254 ~                ld   a, (Audio_jump_sound_note)
  85+ 8254 ~                cp   18
  86+ 8254 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8254 ~
  88+ 8254 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8254 ~                ld   a, (Audio_music_frame_counter)
  90+ 8254 ~                dec  a
  91+ 8254 ~                ld   (Audio_music_frame_counter), a
  92+ 8254 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8254 ~
  94+ 8254 ~                ; Altrimenti carica la nota successiva
  95+ 8254 ~                ld   a, (Audio_music_note_idx)
  96+ 8254 ~                inc  a
  97+ 8254 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8254 ~                jr   c, .no_wrap
  99+ 8254 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8254 ~            .no_wrap:
 101+ 8254 ~                ld   (Audio_music_note_idx), a
 102+ 8254 ~
 103+ 8254 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8254 ~                ld   e, a
 105+ 8254 ~                ld   d, 0
 106+ 8254 ~                ld   hl, Audio_MusicSheet
 107+ 8254 ~                add  hl, de
 108+ 8254 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8254 ~
 110+ 8254 ~                ; Leggi durata (secondo byte)
 111+ 8254 ~                inc  hl
 112+ 8254 ~                ld   a, (hl)
 113+ 8254 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8254 ~                jr   nz, .dur_ok
 115+ 8254 ~                ld   a, 1
 116+ 8254 ~            .dur_ok:
 117+ 8254 ~                ld   (Audio_music_frame_counter), a
 118+ 8254 ~
 119+ 8254 ~            .play_current_note:
 120+ 8254 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8254 ~                ld   a, (Audio_music_note_idx)
 122+ 8254 ~                ld   e, a
 123+ 8254 ~                ld   d, 0
 124+ 8254 ~                ld   hl, Audio_MusicSheet
 125+ 8254 ~                add  hl, de
 126+ 8254 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8254 ~                ld   a, (hl)                  ; A = delay
 128+ 8254 ~                or   a
 129+ 8254 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8254 ~
 131+ 8254 ~                ; Suona la nota: 2 cicli
 132+ 8254 ~                ld   d, a                     ; D = delay
 133+ 8254 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8254 ~            .note_loop:
 135+ 8254 ~                ; Speaker ON
 136+ 8254 ~                ld   a, (room_border_color)
 137+ 8254 ~                or   $10
 138+ 8254 ~                out  ($fe), a
 139+ 8254 ~                ld   c, d
 140+ 8254 ~            .d1:
 141+ 8254 ~                push af
 142+ 8254 ~                pop  af
 143+ 8254 ~                dec  c
 144+ 8254 ~                jr   nz, .d1
 145+ 8254 ~
 146+ 8254 ~                ; Speaker OFF
 147+ 8254 ~                ld   a, (room_border_color)
 148+ 8254 ~                and  $ef
 149+ 8254 ~                out  ($fe), a
 150+ 8254 ~                ld   c, d
 151+ 8254 ~            .d2:
 152+ 8254 ~                push af
 153+ 8254 ~                pop  af
 154+ 8254 ~                dec  c
 155+ 8254 ~                jr   nz, .d2
 156+ 8254 ~
 157+ 8254 ~                djnz .note_loop
 158+ 8254 ~
 159+ 8254 ~            .done:
 160+ 8254 ~                pop  hl
 161+ 8254 ~                pop  de
 162+ 8254 ~                pop  bc
 163+ 8254 ~                pop  af
 164+ 8254 ~                ret
 165+ 8254 ~
 166+ 8254 ~            Audio_MusicSheet:
 167+ 8254 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8254 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8254 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8254 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8254 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8254 ~                db 90, 10, 107, 20, 68, 65
 173+ 8254                  ELSE
 174+ 8254              Audio_UpdateMusic:
 175+ 8254 C9               ret
 176+ 8255                  ENDIF
