  71+ 77D4              ; Audio_UpdateMusic
  72+ 77D4              ;
  73+ 77D4              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 77D4              ; Viene chiamata a ogni frame.
  75+ 77D4              ; -------------------------------------------------------------------
  76+ 77D4              Audio_UpdateMusic:
  77+ 77D4 F5               push af
  78+ 77D5 C5               push bc
  79+ 77D6 D5               push de
  80+ 77D7 E5               push hl
  81+ 77D8
  82+ 77D8                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 77D8 3A 1E 7C         ld   a, (Audio_jump_sound_note)
  84+ 77DB FE 12            cp   18
  85+ 77DD 38 56            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 77DF
  87+ 77DF                  ; Decrementa il contatore dei frame della nota corrente
  88+ 77DF 3A 21 7C         ld   a, (Audio_music_frame_counter)
  89+ 77E2 3D               dec  a
  90+ 77E3 32 21 7C         ld   (Audio_music_frame_counter), a
  91+ 77E6 20 1F            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 77E8
  93+ 77E8                  ; Altrimenti carica la nota successiva
  94+ 77E8 3A 20 7C         ld   a, (Audio_music_note_idx)
  95+ 77EB 3C               inc  a
  96+ 77EC FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 77EE 38 01            jr   c, .no_wrap
  98+ 77F0 AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 77F1              .no_wrap:
 100+ 77F1 32 20 7C         ld   (Audio_music_note_idx), a
 101+ 77F4
 102+ 77F4                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 77F4 5F               ld   e, a
 104+ 77F5 16 00            ld   d, 0
 105+ 77F7 21 3A 78         ld   hl, Audio_MusicSheet
 106+ 77FA 19               add  hl, de
 107+ 77FB 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 77FC
 109+ 77FC                  ; Leggi durata (secondo byte)
 110+ 77FC 23               inc  hl
 111+ 77FD 7E               ld   a, (hl)
 112+ 77FE CB 3F            srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 113+ 7800 20 02            jr   nz, .dur_ok
 114+ 7802 3E 01            ld   a, 1
 115+ 7804              .dur_ok:
 116+ 7804 32 21 7C         ld   (Audio_music_frame_counter), a
 117+ 7807
 118+ 7807              .play_current_note:
 119+ 7807                  ; Ottieni il delay della nota corrente (primo byte)
 120+ 7807 3A 20 7C         ld   a, (Audio_music_note_idx)
 121+ 780A 5F               ld   e, a
 122+ 780B 16 00            ld   d, 0
 123+ 780D 21 3A 78         ld   hl, Audio_MusicSheet
 124+ 7810 19               add  hl, de
 125+ 7811 19               add  hl, de                   ; hl punta al primo byte della nota
 126+ 7812 7E               ld   a, (hl)                  ; A = delay
 127+ 7813 B7               or   a
 128+ 7814 28 1F            jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 129+ 7816
 130+ 7816                  ; Suona la nota: 2 cicli
 131+ 7816 57               ld   d, a                     ; D = delay
 132+ 7817 06 02            ld   b, 2                     ; 2 cicli per frame
 133+ 7819              .note_loop:
 134+ 7819                  ; Speaker ON
 135+ 7819 3A AD 78         ld   a, (room_border_color)
 136+ 781C F6 10            or   $10
 137+ 781E D3 FE            out  ($fe), a
 138+ 7820 4A               ld   c, d
 139+ 7821              .d1:
 140+ 7821 F5               push af
 141+ 7822 F1               pop  af
 142+ 7823 0D               dec  c
 143+ 7824 20 FB            jr   nz, .d1
 144+ 7826
 145+ 7826                  ; Speaker OFF
 146+ 7826 3A AD 78         ld   a, (room_border_color)
 147+ 7829 E6 EF            and  $ef
 148+ 782B D3 FE            out  ($fe), a
 149+ 782D 4A               ld   c, d
 150+ 782E              .d2:
 151+ 782E F5               push af
 152+ 782F F1               pop  af
 153+ 7830 0D               dec  c
 154+ 7831 20 FB            jr   nz, .d2
 155+ 7833
 156+ 7833 10 E4            djnz .note_loop
 157+ 7835
 158+ 7835              .done:
 159+ 7835 E1               pop  hl
 160+ 7836 D1               pop  de
 161+ 7837 C1               pop  bc
 162+ 7838 F1               pop  af
 163+ 7839 C9               ret
