 190+ 80A6
 191+ 80A6              ; -------------------------------------------------------------------
 192+ 80A6              ; DetermineCurrentRoomID
 193+ 80A6              ;
 194+ 80A6              ; Determina l'ID numerico della stanza corrente confrontando
 195+ 80A6              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 196+ 80A6              ;
 197+ 80A6              ; Se viene trovata una corrispondenza:
 198+ 80A6              ;   A = ID della stanza
 199+ 80A6              ;   current_room = A
 200+ 80A6              ;
 201+ 80A6              ; Mappatura:
 202+ 80A6              ;    0 = The Off Licence
 203+ 80A6              ;    1 = The Bridge
 204+ 80A6              ;    2 = Under The Mega Tree
 205+ 80A6              ;    3 = Gfx_At The Foot Of The Mega Tree
 206+ 80A6              ;    4 = The Drive
 207+ 80A6              ;    5 = The Security Guard
 208+ 80A6              ;    6 = Entrance To Hades
 209+ 80A6              ;    7 = Cuckoo's Nest
 210+ 80A6              ;    8 = Inside The Mega Trunk
 211+ 80A6              ;    9 = On A Branch Over The Drive
 212+ 80A6              ;   10 = The Front Door
 213+ 80A6              ;   11 = The Hall
 214+ 80A6              ;   12 = Tree Top
 215+ 80A6              ;   27 = The Chapel
 216+ 80A6              ;   28 = First Landing
 217+ 80A6              ;   29 = The Nightmare Room
 218+ 80A6              ;   33 = The Bathroom
 219+ 80A6              ;   35 = Master Bedroom
 220+ 80A6              ;
 221+ 80A6              ; Se nessuna stanza corrisponde viene impostato:
 222+ 80A6              ;   current_room = 0
 223+ 80A6              ; -------------------------------------------------------------------
 224+ 80A6              DetermineCurrentRoomID:
 225+ 80A6
