 426+ 5F9A                  ; Scrive i 3 byte sullo schermo (OR trasparente)
 427+ 5F9A 47               ld   b, a          ; Salva il 3° byte dello sprite in B
 428+ 5F9B 7A               ld   a, d
 429+ 5F9C B6               or   (hl)
 430+ 5F9D 77               ld   (hl), a
 431+ 5F9E 23               inc  hl
 432+ 5F9F 7B               ld   a, e
 433+ 5FA0 B6               or   (hl)
 434+ 5FA1 77               ld   (hl), a
