1179+ 6C82 29               add  hl, hl
1180+ 6C83 29               add  hl, hl
1181+ 6C84 29               add  hl, hl
1182+ 6C85 29               add  hl, hl
1183+ 6C86 29               add  hl, hl            ; HL = Row * 32
1184+ 6C87 59               ld   e, c
1185+ 6C88 16 00            ld   d, 0
