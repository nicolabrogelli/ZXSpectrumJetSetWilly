1090+ 6CA5              ; -------------------------------------------------------------------
1091+ 6CA5              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1092+ 6CA5              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1093+ 6CA5              ; -------------------------------------------------------------------
1094+ 6CA5              UnpackRoomLayout:
1095+ 6CA5 E5               push hl
1096+ 6CA6 D5               push de
1097+ 6CA7 C5               push bc
1098+ 6CA8
1099+ 6CA8 2A FA 7E         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1100+ 6CAB 11 A0 7C         ld   de, unpacked_layout ; DE = buffer RAM
1101+ 6CAE 06 80            ld   b, 128             ; 128 byte
1102+ 6CB0              .byte_loop:
1103+ 6CB0 7E               ld   a, (hl)            ; Leggi byte compresso
1104+ 6CB1 23               inc  hl
1105+ 6CB2
1106+ 6CB2 4F               ld   c, a               ; C = salvataggio
1107+ 6CB3
1108+ 6CB3                  ; Cella 0: bit 7-6
1109+ 6CB3 07               rlca
1110+ 6CB4 07               rlca
1111+ 6CB5 E6 03            and  3
1112+ 6CB7 12               ld   (de), a
1113+ 6CB8 13               inc  de
1114+ 6CB9
1115+ 6CB9                  ; Cella 1: bit 5-4
1116+ 6CB9 79               ld   a, c
1117+ 6CBA 07               rlca
1118+ 6CBB 07               rlca
1119+ 6CBC 07               rlca
1120+ 6CBD 07               rlca
1121+ 6CBE E6 03            and  3
1122+ 6CC0 12               ld   (de), a
1123+ 6CC1 13               inc  de
1124+ 6CC2
1125+ 6CC2                  ; Cella 2: bit 3-2
1126+ 6CC2 79               ld   a, c
1127+ 6CC3 0F               rrca
1128+ 6CC4 0F               rrca
1129+ 6CC5 E6 03            and  3
1130+ 6CC7 12               ld   (de), a
1131+ 6CC8 13               inc  de
1132+ 6CC9
1133+ 6CC9                  ; Cella 3: bit 1-0
1134+ 6CC9 79               ld   a, c
1135+ 6CCA E6 03            and  3
1136+ 6CCC 12               ld   (de), a
1137+ 6CCD 13               inc  de
1138+ 6CCE
1139+ 6CCE 10 E0            djnz .byte_loop
1140+ 6CD0
1141+ 6CD0 C1               pop  bc
1142+ 6CD1 D1               pop  de
1143+ 6CD2 E1               pop  hl
1144+ 6CD3 C9               ret
1145+ 6CD4
1146+ 6CD4              ; -------------------------------------------------------------------
1147+ 6CD4              ; Legge il tipo di cella dal buffer decompresso in RAM
1148+ 6CD4              ; Input: A = Row (0..15), C = Col (0..31)
1149+ 6CD4              ; Output: A = tipo di cella (0..3)
1150+ 6CD4              ; Preserva tutti gli altri registri.
1151+ 6CD4              ; -------------------------------------------------------------------
1152+ 6CD4              GetCellFromUnpacked:
1153+ 6CD4 E5               push hl
1154+ 6CD5 D5               push de
1155+ 6CD6
1156+ 6CD6 6F               ld   l, a
1157+ 6CD7 26 00            ld   h, 0
1158+ 6CD9 29               add  hl, hl
1159+ 6CDA 29               add  hl, hl
1160+ 6CDB 29               add  hl, hl
1161+ 6CDC 29               add  hl, hl
1162+ 6CDD 29               add  hl, hl            ; HL = Row * 32
1163+ 6CDE 59               ld   e, c
1164+ 6CDF 16 00            ld   d, 0
1165+ 6CE1 19               add  hl, de            ; HL = Row * 32 + Col
1166+ 6CE2 11 A0 7C         ld   de, unpacked_layout
1167+ 6CE5 19               add  hl, de
1168+ 6CE6 7E               ld   a, (hl)           ; A = cell type
1169+ 6CE7
1170+ 6CE7 D1               pop  de
1171+ 6CE8 E1               pop  hl
1172+ 6CE9 C9               ret
