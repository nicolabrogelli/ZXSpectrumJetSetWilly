1070+ 7AC9
1071+ 7AC9              ; -------------------------------------------------------------------
1072+ 7AC9              ; Items_DrawRoom
1073+ 7AC9              ;
1074+ 7AC9              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1075+ 7AC9              ;
1076+ 7AC9              ; Operazioni eseguite:
1077+ 7AC9              ;   1. Azzera la griglia items_grid.
1078+ 7AC9              ;   2. Svuota la cache degli oggetti attivi.
1079+ 7AC9              ;   3. Scansiona ItemsTable.
1080+ 7AC9              ;   4. Per ogni item della stanza corrente:
1081+ 7AC9              ;        - verifica se è già stato raccolto
1082+ 7AC9              ;        - disegna la grafica
1083+ 7AC9              ;        - aggiorna items_grid
1084+ 7AC9              ;        - memorizza l'item nella cache current_room_items
1085+ 7AC9              ;   5. Aggiorna num_room_items.
1086+ 7AC9              ;
1087+ 7AC9              ; Record ItemsTable:
1088+ 7AC9              ;   +0  Room ID
1089+ 7AC9              ;   +1  X (colonna)
1090+ 7AC9              ;   +2  Y (riga)
1091+ 7AC9              ;   +3  Colore
1092+ 7AC9              ;   +4  Collected flag
1093+ 7AC9              ;
1094+ 7AC9              ; Cache current_room_items:
1095+ 7AC9              ;   +0  Colonna
1096+ 7AC9              ;   +1  Riga
1097+ 7AC9              ;   +2  Colore
1098+ 7AC9              ;   +3  Collected flag ptr (Low)
1099+ 7AC9              ;   +4  Collected flag ptr (High)
1100+ 7AC9              ;
1101+ 7AC9              ; Ogni record cache occupa 5 byte.
1102+ 7AC9              ; -------------------------------------------------------------------
1103+ 7AC9              Items_DrawRoom:
1104+ 7AC9
1105+ 7AC9                  ; Salva tutti i registri utilizzati
1106+ 7AC9 E5               push hl
1107+ 7ACA D5               push de
1108+ 7ACB C5               push bc
1109+ 7ACC DD E5            push ix
1110+ 7ACE FD E5            push iy
1111+ 7AD0
1112+ 7AD0                  ; ---------------------------------------------------------------
1113+ 7AD0                  ; Azzera items_grid (32 x 16 = 512 byte)
1114+ 7AD0                  ; ---------------------------------------------------------------
1115+ 7AD0 21 26 E4         ld   hl, items_grid
1116+ 7AD3 11 27 E4         ld   de, items_grid + 1
1117+ 7AD6 36 00            ld   (hl), 0
1118+ 7AD8 01 FF 01         ld   bc, 511
1119+ 7ADB ED B0            ldir
1120+ 7ADD
1121+ 7ADD                  ; ---------------------------------------------------------------
1122+ 7ADD                  ; Nessun item attivo nella stanza
1123+ 7ADD                  ; ---------------------------------------------------------------
1124+ 7ADD AF               xor  a
1125+ 7ADE 32 A4 E9         ld   (num_room_items), a
1126+ 7AE1
1127+ 7AE1                  ; IY punta alla cache degli item attivi
1128+ 7AE1 FD 21 54 E9      ld   iy, current_room_items
1129+ 7AE5
1130+ 7AE5                  ; ---------------------------------------------------------------
1131+ 7AE5                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1132+ 7AE5                  ; alla stanza corrente.
1133+ 7AE5                  ;
1134+ 7AE5                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1135+ 7AE5                  ; ---------------------------------------------------------------
1136+ 7AE5 2A A5 E9         ld   hl, (room_ptr)
1137+ 7AE8 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1138+ 7AEB 19               add  hl, de
1139+ 7AEC
1140+ 7AEC E5               push hl
1141+ 7AED DD E1            pop  ix                ; IX = bitmap item
1142+ 7AEF
1143+ 7AEF                  ; ---------------------------------------------------------------
1144+ 7AEF                  ; Inizio scansione della tabella degli item
1145+ 7AEF                  ; ---------------------------------------------------------------
1146+ 7AEF 21 7C 75         ld   hl, ItemsTable
1147+ 7AF2
1148+ 7AF2              .loop:
1149+ 7AF2
1150+ 7AF2                  ; ---------------------------------------------------------------
1151+ 7AF2                  ; Legge il Room ID del record corrente
1152+ 7AF2                  ; ---------------------------------------------------------------
1153+ 7AF2 7E               ld   a, (hl)
1154+ 7AF3
1155+ 7AF3                  ; $FF indica fine tabella
1156+ 7AF3 FE FF            cp   $FF
1157+ 7AF5 28 53            jr   z, .done
1158+ 7AF7
1159+ 7AF7                  ; ---------------------------------------------------------------
1160+ 7AF7                  ; Verifica se l'item appartiene alla stanza corrente
1161+ 7AF7                  ; ---------------------------------------------------------------
1162+ 7AF7 57               ld   d, a
1163+ 7AF8
1164+ 7AF8 3A 4B E9         ld   a, (current_room)
1165+ 7AFB BA               cp   d
1166+ 7AFC 20 45            jr   nz, .next_item
1167+ 7AFE
1168+ 7AFE                  ; ---------------------------------------------------------------
1169+ 7AFE                  ; Legge i dati dell'item
1170+ 7AFE                  ; ---------------------------------------------------------------
1171+ 7AFE
1172+ 7AFE 23               inc  hl
1173+ 7AFF 4E               ld   c, (hl)           ; X (colonna)
1174+ 7B00
1175+ 7B00 23               inc  hl
1176+ 7B01 46               ld   b, (hl)           ; Y (riga)
1177+ 7B02
1178+ 7B02 23               inc  hl
1179+ 7B03 5E               ld   e, (hl)           ; Colore
1180+ 7B04
1181+ 7B04 23               inc  hl
1182+ 7B05 7E               ld   a, (hl)           ; Collected flag
1183+ 7B06
1184+ 7B06                  ; Se diverso da zero l'item è già stato raccolto
1185+ 7B06 B7               or   a
1186+ 7B07 20 3E            jr   nz, .next_no_inc
1187+ 7B09
1188+ 7B09                  ; ---------------------------------------------------------------
1189+ 7B09                  ; Disegna l'item sullo schermo
1190+ 7B09                  ;
1191+ 7B09                  ; B = Row
1192+ 7B09                  ; C = Column
1193+ 7B09                  ; HL = bitmap pointer
1194+ 7B09                  ; E = Color
1195+ 7B09                  ; ---------------------------------------------------------------
1196+ 7B09 E5               push hl
1197+ 7B0A
1198+ 7B0A DD E5            push ix
1199+ 7B0C E1               pop  hl
1200+ 7B0D
1201+ 7B0D CD 52 7B         call DrawItemGraphic
1202+ 7B10
1203+ 7B10 E1               pop  hl                ; ritorna al flag collected
1204+ 7B11
1205+ 7B11                  ; ---------------------------------------------------------------
1206+ 7B11                  ; Aggiorna items_grid
1207+ 7B11                  ;
1208+ 7B11                  ; Calcolo:
1209+ 7B11                  ;   offset = Row * 32 + Col
1210+ 7B11                  ; ---------------------------------------------------------------
1211+ 7B11 E5               push hl
1212+ 7B12 D5               push de
1213+ 7B13
1214+ 7B13 26 00            ld   h, 0
1215+ 7B15 68               ld   l, b              ; HL = Row
1216+ 7B16
1217+ 7B16 29               add  hl, hl            ; *2
1218+ 7B17 29               add  hl, hl            ; *4
1219+ 7B18 29               add  hl, hl            ; *8
1220+ 7B19 29               add  hl, hl            ; *16
1221+ 7B1A 29               add  hl, hl            ; *32
1222+ 7B1B
1223+ 7B1B 16 00            ld   d, 0
1224+ 7B1D 59               ld   e, c              ; DE = Col
1225+ 7B1E
1226+ 7B1E 19               add  hl, de            ; Row*32 + Col
1227+ 7B1F
1228+ 7B1F 11 26 E4         ld   de, items_grid
1229+ 7B22 19               add  hl, de            ; puntatore nella griglia
1230+ 7B23
1231+ 7B23 D1               pop  de                ; ripristina colore
1232+ 7B24
1233+ 7B24 73               ld   (hl), e           ; salva colore cella
1234+ 7B25
1235+ 7B25 E1               pop  hl
1236+ 7B26
1237+ 7B26                  ; ---------------------------------------------------------------
1238+ 7B26                  ; Salva l'item nella cache della stanza
1239+ 7B26                  ;
1240+ 7B26                  ; Questo evita di dover scansionare tutta ItemsTable
1241+ 7B26                  ; durante il controllo delle collisioni.
1242+ 7B26                  ; ---------------------------------------------------------------
1243+ 7B26
1244+ 7B26 FD 71 00         ld   (iy+0), c         ; Colonna
1245+ 7B29 FD 70 01         ld   (iy+1), b         ; Riga
1246+ 7B2C FD 73 02         ld   (iy+2), e         ; Colore
1247+ 7B2F
1248+ 7B2F                  ; Salva il puntatore al flag "collected"
1249+ 7B2F FD 75 03         ld   (iy+3), l         ; Low byte
1250+ 7B32 FD 74 04         ld   (iy+4), h         ; High byte
1251+ 7B35
1252+ 7B35                  ; Passa al record successivo della cache
1253+ 7B35 01 05 00         ld   bc, 5
1254+ 7B38 FD 09            add  iy, bc
1255+ 7B3A
1256+ 7B3A                  ; Incrementa il numero di item attivi
1257+ 7B3A 3A A4 E9         ld   a, (num_room_items)
1258+ 7B3D 3C               inc  a
1259+ 7B3E 32 A4 E9         ld   (num_room_items), a
1260+ 7B41
1261+ 7B41 18 04            jr   .next_no_inc
1262+ 7B43
1263+ 7B43              .next_item:
1264+ 7B43
1265+ 7B43                  ; ---------------------------------------------------------------
1266+ 7B43                  ; L'item non appartiene alla stanza corrente.
1267+ 7B43                  ; Salta i campi del record:
1268+ 7B43                  ;   X
1269+ 7B43                  ;   Y
1270+ 7B43                  ;   Color
1271+ 7B43                  ;   Collected
1272+ 7B43                  ; ---------------------------------------------------------------
1273+ 7B43 23               inc  hl
1274+ 7B44 23               inc  hl
1275+ 7B45 23               inc  hl
1276+ 7B46 23               inc  hl
1277+ 7B47
1278+ 7B47              .next_no_inc:
1279+ 7B47
1280+ 7B47                  ; ---------------------------------------------------------------
1281+ 7B47                  ; Avanza al record successivo
1282+ 7B47                  ; (prossimo Room ID)
1283+ 7B47                  ; ---------------------------------------------------------------
1284+ 7B47 23               inc  hl
1285+ 7B48 18 A8            jr   .loop
1286+ 7B4A
1287+ 7B4A              .done:
1288+ 7B4A
1289+ 7B4A                  ; Ripristina i registri
1290+ 7B4A FD E1            pop  iy
1291+ 7B4C DD E1            pop  ix
1292+ 7B4E D1               pop  de
1293+ 7B4F C1               pop  bc
1294+ 7B50 E1               pop  hl
1295+ 7B51
1296+ 7B51 C9               ret
1297+ 7B52
1298+ 7B52              ; -------------------------------------------------------------------
1299+ 7B52              ; DrawItemGraphic
1300+ 7B52              ;
1301+ 7B52              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1302+ 7B52              ; utilizzando una bitmap di 8 byte e un attributo colore.
1303+ 7B52              ;
1304+ 7B52              ; Input:
1305+ 7B52              ;   B = Riga attributi (3..18)
1306+ 7B52              ;   C = Colonna attributi (0..31)
1307+ 7B52              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1308+ 7B52              ;   E = Attributo colore
1309+ 7B52              ;
1310+ 7B52              ; Output:
1311+ 7B52              ;   Nessuno
1312+ 7B52              ;
1313+ 7B52              ; Registri preservati:
1314+ 7B52              ;   BC, DE, HL
1315+ 7B52              ; -------------------------------------------------------------------
1316+ 7B52              DrawItemGraphic:
1317+ 7B52
1318+ 7B52                  ; Salva i registri originali
1319+ 7B52 C5               push bc
1320+ 7B53 D5               push de
1321+ 7B54 E5               push hl
1322+ 7B55
1323+ 7B55                  ; ---------------------------------------------------------------
1324+ 7B55                  ; Calcolo indirizzo bitmap dello Spectrum
1325+ 7B55                  ;
1326+ 7B55                  ; Ogni item occupa una cella attributi (8x8 pixel).
1327+ 7B55                  ;
1328+ 7B55                  ; Formula:
1329+ 7B55                  ;   High = $40 + (Row AND $18)
1330+ 7B55                  ;   Low  = (Row AND 7) * 32 + Col
1331+ 7B55                  ;
1332+ 7B55                  ; DE conterrà l'indirizzo della prima scanline.
1333+ 7B55                  ; ---------------------------------------------------------------
1334+ 7B55
1335+ 7B55 78               ld   a, b
1336+ 7B56 E6 18            and  $18
1337+ 7B58 C6 40            add  a, $40
1338+ 7B5A 57               ld   d, a              ; Byte alto indirizzo video
1339+ 7B5B
1340+ 7B5B 78               ld   a, b
1341+ 7B5C E6 07            and  7                 ; Riga interna al blocco da 8
1342+ 7B5E
1343+ 7B5E 87               add  a, a              ; *2
1344+ 7B5F 87               add  a, a              ; *4
1345+ 7B60 87               add  a, a              ; *8
1346+ 7B61 87               add  a, a              ; *16
1347+ 7B62 87               add  a, a              ; *32
1348+ 7B63
1349+ 7B63 81               add  a, c              ; + colonna
1350+ 7B64
1351+ 7B64 5F               ld   e, a              ; Byte basso indirizzo video
1352+ 7B65
1353+ 7B65                  ; ---------------------------------------------------------------
1354+ 7B65                  ; Disegno bitmap
1355+ 7B65                  ;
1356+ 7B65                  ; Copia 8 byte consecutivi nella memoria video.
1357+ 7B65                  ; Ogni byte rappresenta una scanline da 8 pixel.
1358+ 7B65                  ; ---------------------------------------------------------------
1359+ 7B65
1360+ 7B65 C5               push bc                ; Conserva Row e Col
1361+ 7B66
1362+ 7B66 06 08            ld   b, 8              ; Numero scanline
1363+ 7B68
1364+ 7B68              .line_loop:
1365+ 7B68
1366+ 7B68 7E               ld   a, (hl)           ; Legge scanline bitmap
1367+ 7B69 12               ld   (de), a           ; Scrive nella memoria video
1368+ 7B6A
1369+ 7B6A 14               inc  d                 ; Scanline successiva
1370+ 7B6B 23               inc  hl                ; Byte bitmap successivo
1371+ 7B6C
1372+ 7B6C 05               dec  b
1373+ 7B6D 20 F9            jr   nz, .line_loop
1374+ 7B6F
1375+ 7B6F C1               pop  bc                ; Ripristina Row e Col
1376+ 7B70
1377+ 7B70                  ; ---------------------------------------------------------------
1378+ 7B70                  ; Calcolo indirizzo attributo
1379+ 7B70                  ;
1380+ 7B70                  ; Formula:
1381+ 7B70                  ;   AttrAddr = $5800 + Row * 32 + Col
1382+ 7B70                  ;
1383+ 7B70                  ; HL conterrà l'indirizzo della cella attributi.
1384+ 7B70                  ; ---------------------------------------------------------------
1385+ 7B70
1386+ 7B70 26 00            ld   h, 0
1387+ 7B72 68               ld   l, b              ; HL = Row
1388+ 7B73
1389+ 7B73 29               add  hl, hl            ; *2
1390+ 7B74 29               add  hl, hl            ; *4
1391+ 7B75 29               add  hl, hl            ; *8
1392+ 7B76 29               add  hl, hl            ; *16
1393+ 7B77 29               add  hl, hl            ; *32
1394+ 7B78
1395+ 7B78 79               ld   a, c              ; A = Colonna
1396+ 7B79
1397+ 7B79 85               add  a, l
1398+ 7B7A 6F               ld   l, a
1399+ 7B7B
1400+ 7B7B 30 01            jr   nc, .no_carry
1401+ 7B7D 24               inc  h
1402+ 7B7E
1403+ 7B7E              .no_carry:
1404+ 7B7E
1405+ 7B7E                  ; HL = Row * 32 + Col
1406+ 7B7E
1407+ 7B7E 11 00 58         ld   de, $5800
1408+ 7B81 19               add  hl, de            ; HL = indirizzo attributi
1409+ 7B82
1410+ 7B82                  ; ---------------------------------------------------------------
1411+ 7B82                  ; Recupera il colore originale dallo stack.
1412+ 7B82                  ;
1413+ 7B82                  ; Layout stack:
1414+ 7B82                  ;   HL originale
1415+ 7B82                  ;   DE originale (E = colore)
1416+ 7B82                  ;   BC originale
1417+ 7B82                  ; ---------------------------------------------------------------
1418+ 7B82
1419+ 7B82 C1               pop  bc                ; Recupera HL originale
1420+ 7B83 D1               pop  de                ; Recupera DE originale
1421+ 7B84
1422+ 7B84                  ; ---------------------------------------------------------------
1423+ 7B84                  ; Scrive l'attributo colore
1424+ 7B84                  ; ---------------------------------------------------------------
1425+ 7B84
1426+ 7B84 7B               ld   a, e              ; A = colore
1427+ 7B85 77               ld   (hl), a           ; Scrive nella RAM attributi
1428+ 7B86
1429+ 7B86                  ; ---------------------------------------------------------------
1430+ 7B86                  ; Ripristina HL e BC originali
1431+ 7B86                  ; ---------------------------------------------------------------
1432+ 7B86
1433+ 7B86 C5               push bc
1434+ 7B87 E1               pop  hl                ; HL originale
1435+ 7B88
1436+ 7B88 C1               pop  bc                ; BC originale
1437+ 7B89
1438+ 7B89 C9               ret
1439+ 7B8A
1440+ 7B8A              ; -------------------------------------------------------------------
1441+ 7B8A              ; RestoreBackgroundCell
1442+ 7B8A              ;
1443+ 7B8A              ; Ripristina il contenuto originale di una cella della stanza.
1444+ 7B8A              ; Viene utilizzata principalmente quando un item viene raccolto:
1445+ 7B8A              ; invece di lasciare un "buco", la routine ridisegna il tile
1446+ 7B8A              ; originale presente nella mappa della stanza.
1447+ 7B8A              ;
1448+ 7B8A              ; Input:
1449+ 7B8A              ;   B = Row (3..18)
1450+ 7B8A              ;   C = Col (0..31)
1451+ 7B8A              ;
1452+ 7B8A              ; Utilizza:
1453+ 7B8A              ;   room_ptr -> struttura dati della stanza corrente
1454+ 7B8A              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1455+ 7B8A              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1456+ 7B8A              ;
1457+ 7B8A              ; Tipi di cella:
1458+ 7B8A              ;   0 = Background
1459+ 7B8A              ;   1 = Floor
1460+ 7B8A              ;   2 = Wall
1461+ 7B8A              ;   3 = Nasty
1462+ 7B8A              ; -------------------------------------------------------------------
1463+ 7B8A              RestoreBackgroundCell:
1464+ 7B8A
1465+ 7B8A                  ; Salva tutti i registri utilizzati
1466+ 7B8A FD E5            push iy
1467+ 7B8C C5               push bc
1468+ 7B8D D5               push de
1469+ 7B8E E5               push hl
1470+ 7B8F DD E5            push ix
1471+ 7B91
1472+ 7B91                  ; ---------------------------------------------------------------
1473+ 7B91                  ; Conserva Row e Col in IY.
1474+ 7B91                  ;
1475+ 7B91                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1476+ 7B91                  ; BC potrebbe essere modificato.
1477+ 7B91                  ; ---------------------------------------------------------------
1478+ 7B91 C5               push bc
1479+ 7B92 FD E1            pop  iy                ; IYH = Row, IYL = Col
1480+ 7B94
1481+ 7B94                  ; ---------------------------------------------------------------
1482+ 7B94                  ; Determina quale tipo di cella è presente nella posizione
1483+ 7B94                  ; specificata.
1484+ 7B94                  ;
1485+ 7B94                  ; Input:
1486+ 7B94                  ;   B = Row
1487+ 7B94                  ;   C = Col
1488+ 7B94                  ;
1489+ 7B94                  ; Output:
1490+ 7B94                  ;   A = tipo cella
1491+ 7B94                  ; ---------------------------------------------------------------
1492+ 7B94 78               ld   a, b
1493+ 7B95
1494+ 7B95 CD 68 6E         call GetCellFromUnpacked
1495+ 7B98
1496+ 7B98                  ; ---------------------------------------------------------------
1497+ 7B98                  ; Recupera il puntatore alla stanza corrente.
1498+ 7B98                  ;
1499+ 7B98                  ; DE = base della struttura stanza
1500+ 7B98                  ; ---------------------------------------------------------------
1501+ 7B98 ED 5B A5 E9      ld   de, (room_ptr)
1502+ 7B9C
1503+ 7B9C                  ; ---------------------------------------------------------------
1504+ 7B9C                  ; Seleziona il tile corretto in base al tipo di cella.
1505+ 7B9C                  ;
1506+ 7B9C                  ; A = 0 -> Background
1507+ 7B9C                  ; A = 1 -> Floor
1508+ 7B9C                  ; A = 2 -> Wall
1509+ 7B9C                  ; A = 3 -> Nasty
1510+ 7B9C                  ; ---------------------------------------------------------------
1511+ 7B9C
1512+ 7B9C B7               or   a
1513+ 7B9D 20 06            jr   nz, .not_bg
1514+ 7B9F
1515+ 7B9F                  ; Background
1516+ 7B9F 21 A0 00         ld   hl, OFFSET_BG
1517+ 7BA2 19               add  hl, de
1518+ 7BA3 18 16            jr   .draw_cell
1519+ 7BA5
1520+ 7BA5              .not_bg:
1521+ 7BA5
1522+ 7BA5 3D               dec  a
1523+ 7BA6 20 06            jr   nz, .not_floor
1524+ 7BA8
1525+ 7BA8                  ; Floor
1526+ 7BA8 21 A9 00         ld   hl, OFFSET_FLOOR
1527+ 7BAB 19               add  hl, de
1528+ 7BAC 18 0D            jr   .draw_cell
1529+ 7BAE
1530+ 7BAE              .not_floor:
1531+ 7BAE
1532+ 7BAE 3D               dec  a
1533+ 7BAF 20 06            jr   nz, .not_wall
1534+ 7BB1
1535+ 7BB1                  ; Wall
1536+ 7BB1 21 B2 00         ld   hl, OFFSET_WALL
1537+ 7BB4 19               add  hl, de
1538+ 7BB5 18 04            jr   .draw_cell
1539+ 7BB7
1540+ 7BB7              .not_wall:
1541+ 7BB7
1542+ 7BB7                  ; Nasty
1543+ 7BB7 21 BB 00         ld   hl, OFFSET_NASTY
1544+ 7BBA 19               add  hl, de
1545+ 7BBB
1546+ 7BBB              .draw_cell:
1547+ 7BBB
1548+ 7BBB                  ; ---------------------------------------------------------------
1549+ 7BBB                  ; HL punta ora alla grafica del tile da ridisegnare.
1550+ 7BBB                  ;
1551+ 7BBB                  ; Gfx_DrawTile si aspetta:
1552+ 7BBB                  ;   IX = puntatore tile
1553+ 7BBB                  ;   B  = Row
1554+ 7BBB                  ;   C  = Col
1555+ 7BBB                  ; ---------------------------------------------------------------
1556+ 7BBB E5               push hl
1557+ 7BBC DD E1            pop  ix
1558+ 7BBE
1559+ 7BBE                  ; Ripristina Row e Col salvati in IY
1560+ 7BBE FD E5            push iy
1561+ 7BC0 C1               pop  bc
1562+ 7BC1
1563+ 7BC1                  ; Disegna il tile originale
1564+ 7BC1 CD 47 62         call Gfx_DrawTile
1565+ 7BC4
1566+ 7BC4                  ; ---------------------------------------------------------------
1567+ 7BC4                  ; Ripristina i registri salvati
1568+ 7BC4                  ; ---------------------------------------------------------------
1569+ 7BC4 DD E1            pop  ix
1570+ 7BC6 E1               pop  hl
1571+ 7BC7 D1               pop  de
1572+ 7BC8 C1               pop  bc
1573+ 7BC9 FD E1            pop  iy
1574+ 7BCB
1575+ 7BCB C9               ret
1576+ 7BCC
1577+ 7BCC              ; -------------------------------------------------------------------
1578+ 7BCC              ; CheckWillyItemCollision
1579+ 7BCC              ;
1580+ 7BCC              ; Verifica se Willy collide con un item utilizzando il controllo
1581+ 7BCC              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1582+ 7BCC              ;
1583+ 7BCC              ; Input:
1584+ 7BCC              ;   A = ItemX (colonna attributi 0..31)
1585+ 7BCC              ;   H = ItemY (riga attributi 3..18)
1586+ 7BCC              ;
1587+ 7BCC              ; Coordinate item:
1588+ 7BCC              ;   Ogni item occupa una cella da 8x8 pixel.
1589+ 7BCC              ;
1590+ 7BCC              ; Coordinate Willy:
1591+ 7BCC              ;   Willy occupa un rettangolo di 16x16 pixel.
1592+ 7BCC              ;
1593+ 7BCC              ; Output:
1594+ 7BCC              ;   Carry Set   = collisione rilevata
1595+ 7BCC              ;   Carry Clear = nessuna collisione
1596+ 7BCC              ;
1597+ 7BCC              ; Registri preservati:
1598+ 7BCC              ;   BC, DE, HL
1599+ 7BCC              ; -------------------------------------------------------------------
1600+ 7BCC              CheckWillyItemCollision:
1601+ 7BCC
1602+ 7BCC                  ; Salva i registri utilizzati
1603+ 7BCC C5               push bc
1604+ 7BCD D5               push de
1605+ 7BCE E5               push hl
1606+ 7BCF
1607+ 7BCF                  ; ---------------------------------------------------------------
1608+ 7BCF                  ; Calcola il bounding box orizzontale dell'item
1609+ 7BCF                  ;
1610+ 7BCF                  ; ItemLeft  = ItemX * 8
1611+ 7BCF                  ; ItemRight = ItemLeft + 7
1612+ 7BCF                  ;
1613+ 7BCF                  ; E = ItemLeft
1614+ 7BCF                  ; D = ItemRight
1615+ 7BCF                  ; ---------------------------------------------------------------
1616+ 7BCF 6F               ld   l, a              ; L = ItemX
1617+ 7BD0
1618+ 7BD0 7D               ld   a, l
1619+ 7BD1 87               add  a, a              ; *2
1620+ 7BD2 87               add  a, a              ; *4
1621+ 7BD3 87               add  a, a              ; *8
1622+ 7BD4
1623+ 7BD4 5F               ld   e, a              ; E = ItemLeft
1624+ 7BD5
1625+ 7BD5 C6 07            add  a, 7
1626+ 7BD7 57               ld   d, a              ; D = ItemRight
1627+ 7BD8
1628+ 7BD8                  ; ---------------------------------------------------------------
1629+ 7BD8                  ; Recupera la posizione corrente di Willy
1630+ 7BD8                  ;
1631+ 7BD8                  ; B = WillyY
1632+ 7BD8                  ; C = WillyX
1633+ 7BD8                  ; ---------------------------------------------------------------
1634+ 7BD8 ED 4B 26 E6      ld   bc, (PlayerPos)
1635+ 7BDC
1636+ 7BDC                  ; ---------------------------------------------------------------
1637+ 7BDC                  ; Primo test:
1638+ 7BDC                  ;
1639+ 7BDC                  ; WillyLeft <= ItemRight
1640+ 7BDC                  ;
1641+ 7BDC                  ; Se Willy è completamente a destra dell'item
1642+ 7BDC                  ; non può esserci collisione.
1643+ 7BDC                  ; ---------------------------------------------------------------
1644+ 7BDC 79               ld   a, c              ; A = WillyLeft
1645+ 7BDD
1646+ 7BDD BA               cp   d                 ; WillyLeft vs ItemRight
1647+ 7BDE
1648+ 7BDE 28 04            jr   z, .x_ok
1649+ 7BE0 38 02            jr   c, .x_ok
1650+ 7BE2
1651+ 7BE2 18 29            jr   .no_collision
1652+ 7BE4
1653+ 7BE4              .x_ok:
1654+ 7BE4
1655+ 7BE4                  ; ---------------------------------------------------------------
1656+ 7BE4                  ; Secondo test:
1657+ 7BE4                  ;
1658+ 7BE4                  ; WillyRight >= ItemLeft
1659+ 7BE4                  ;
1660+ 7BE4                  ; WillyRight = WillyX + 7
1661+ 7BE4                  ; ---------------------------------------------------------------
1662+ 7BE4 C6 07            add  a, 7
1663+ 7BE6
1664+ 7BE6 BB               cp   e                 ; WillyRight vs ItemLeft
1665+ 7BE7
1666+ 7BE7 28 04            jr   z, .y_check
1667+ 7BE9 30 02            jr   nc, .y_check
1668+ 7BEB
1669+ 7BEB 18 20            jr   .no_collision
1670+ 7BED
1671+ 7BED              .y_check:
1672+ 7BED
1673+ 7BED                  ; ---------------------------------------------------------------
1674+ 7BED                  ; Recupera ItemY dal valore originale di HL
1675+ 7BED                  ;
1676+ 7BED                  ; H contiene la riga dell'item.
1677+ 7BED                  ; ---------------------------------------------------------------
1678+ 7BED E1               pop  hl
1679+ 7BEE E5               push hl
1680+ 7BEF
1681+ 7BEF                  ; ---------------------------------------------------------------
1682+ 7BEF                  ; Calcola il bounding box verticale dell'item
1683+ 7BEF                  ;
1684+ 7BEF                  ; ItemTop    = ItemY * 8
1685+ 7BEF                  ; ItemBottom = ItemTop + 7
1686+ 7BEF                  ;
1687+ 7BEF                  ; E = ItemTop
1688+ 7BEF                  ; D = ItemBottom
1689+ 7BEF                  ; ---------------------------------------------------------------
1690+ 7BEF 7C               ld   a, h
1691+ 7BF0
1692+ 7BF0 87               add  a, a              ; *2
1693+ 7BF1 87               add  a, a              ; *4
1694+ 7BF2 87               add  a, a              ; *8
1695+ 7BF3
1696+ 7BF3 5F               ld   e, a              ; ItemTop
1697+ 7BF4
1698+ 7BF4 C6 07            add  a, 7
1699+ 7BF6 57               ld   d, a              ; ItemBottom
1700+ 7BF7
1701+ 7BF7                  ; ---------------------------------------------------------------
1702+ 7BF7                  ; Primo test verticale:
1703+ 7BF7                  ;
1704+ 7BF7                  ; WillyTop <= ItemBottom
1705+ 7BF7                  ; ---------------------------------------------------------------
1706+ 7BF7 78               ld   a, b              ; WillyTop
1707+ 7BF8
1708+ 7BF8 BA               cp   d
1709+ 7BF9
1710+ 7BF9 28 04            jr   z, .y_ok
1711+ 7BFB 38 02            jr   c, .y_ok
1712+ 7BFD
1713+ 7BFD 18 0E            jr   .no_collision
1714+ 7BFF
1715+ 7BFF              .y_ok:
1716+ 7BFF
1717+ 7BFF                  ; ---------------------------------------------------------------
1718+ 7BFF                  ; Secondo test verticale:
1719+ 7BFF                  ;
1720+ 7BFF                  ; WillyBottom >= ItemTop
1721+ 7BFF                  ;
1722+ 7BFF                  ; WillyBottom = WillyY + 15
1723+ 7BFF                  ; ---------------------------------------------------------------
1724+ 7BFF C6 0F            add  a, 15
1725+ 7C01
1726+ 7C01 BB               cp   e
1727+ 7C02
1728+ 7C02 28 04            jr   z, .collision
1729+ 7C04 30 02            jr   nc, .collision
1730+ 7C06
1731+ 7C06 18 05            jr   .no_collision
1732+ 7C08
1733+ 7C08              .collision:
1734+ 7C08
1735+ 7C08                  ; ---------------------------------------------------------------
1736+ 7C08                  ; Collisione rilevata
1737+ 7C08                  ; ---------------------------------------------------------------
1738+ 7C08 E1               pop  hl
1739+ 7C09 D1               pop  de
1740+ 7C0A C1               pop  bc
1741+ 7C0B
1742+ 7C0B 37               scf                    ; Carry = 1
1743+ 7C0C
1744+ 7C0C C9               ret
1745+ 7C0D
1746+ 7C0D              .no_collision:
1747+ 7C0D
1748+ 7C0D                  ; ---------------------------------------------------------------
1749+ 7C0D                  ; Nessuna collisione
1750+ 7C0D                  ; ---------------------------------------------------------------
1751+ 7C0D E1               pop  hl
1752+ 7C0E D1               pop  de
1753+ 7C0F C1               pop  bc
1754+ 7C10
1755+ 7C10 B7               or   a                 ; Carry = 0
1756+ 7C11
1757+ 7C11 C9               ret
1758+ 7C12
1759+ 7C12              ; -------------------------------------------------------------------
1760+ 7C12              ; Items_CheckCollision
1761+ 7C12              ;
1762+ 7C12              ; Controlla se Willy entra in collisione con uno degli item
1763+ 7C12              ; attivi presenti nella stanza corrente.
1764+ 7C12              ;
1765+ 7C12              ; Per ogni item:
1766+ 7C12              ;   - verifica che appartenga alla stanza corrente
1767+ 7C12              ;   - verifica che non sia già stato raccolto
1768+ 7C12              ;   - esegue il test di collisione con Willy
1769+ 7C12              ;
1770+ 7C12              ; Se l'item viene raccolto:
1771+ 7C12              ;   - imposta il flag "collected"
1772+ 7C12              ;   - rimuove l'item dalla cache items_grid
1773+ 7C12              ;   - incrementa il contatore degli oggetti raccolti
1774+ 7C12              ;   - aggiorna l'HUD
1775+ 7C12              ;   - ripristina il tile di sfondo
1776+ 7C12              ;   - riproduce il suono di raccolta
1777+ 7C12              ;
1778+ 7C12              ; Formato record ItemsTable:
1779+ 7C12              ;   +0 RoomID
1780+ 7C12              ;   +1 X
1781+ 7C12              ;   +2 Y
1782+ 7C12              ;   +3 Color
1783+ 7C12              ;   +4 Collected
1784+ 7C12              ;
1785+ 7C12              ; Fine tabella:
1786+ 7C12              ;   RoomID = $FF
1787+ 7C12              ; -------------------------------------------------------------------
1788+ 7C12              Items_CheckCollision:
1789+ 7C12
1790+ 7C12                  ; Salva i registri utilizzati
1791+ 7C12 E5               push hl
1792+ 7C13 D5               push de
1793+ 7C14 C5               push bc
1794+ 7C15
1795+ 7C15                  ; Inizio scansione della tabella degli item
1796+ 7C15 21 7C 75         ld   hl, ItemsTable
1797+ 7C18
1798+ 7C18              .loop:
1799+ 7C18
1800+ 7C18                  ; ---------------------------------------------------------------
1801+ 7C18                  ; Legge il Room ID dell'item corrente
1802+ 7C18                  ; ---------------------------------------------------------------
1803+ 7C18 7E               ld   a, (hl)
1804+ 7C19
1805+ 7C19                  ; $FF indica fine tabella
1806+ 7C19 FE FF            cp   $FF
1807+ 7C1B 28 4D            jr   z, .done
1808+ 7C1D
1809+ 7C1D                  ; ---------------------------------------------------------------
1810+ 7C1D                  ; Verifica se l'item appartiene alla stanza corrente
1811+ 7C1D                  ; ---------------------------------------------------------------
1812+ 7C1D 57               ld   d, a              ; D = RoomID item
1813+ 7C1E
1814+ 7C1E 3A 4B E9         ld   a, (current_room)
1815+ 7C21 BA               cp   d
1816+ 7C22
1817+ 7C22                  ; Se appartiene a un'altra stanza salta il record
1818+ 7C22 20 3F            jr   nz, .next_item
1819+ 7C24
1820+ 7C24                  ; ---------------------------------------------------------------
1821+ 7C24                  ; Legge coordinate e stato dell'item
1822+ 7C24                  ; ---------------------------------------------------------------
1823+ 7C24
1824+ 7C24 23               inc  hl
1825+ 7C25 4E               ld   c, (hl)           ; C = X
1826+ 7C26
1827+ 7C26 23               inc  hl
1828+ 7C27 46               ld   b, (hl)           ; B = Y
1829+ 7C28
1830+ 7C28 23               inc  hl                ; salta Color
1831+ 7C29
1832+ 7C29 23               inc  hl                ; punta a Collected
1833+ 7C2A
1834+ 7C2A 7E               ld   a, (hl)
1835+ 7C2B
1836+ 7C2B                  ; ---------------------------------------------------------------
1837+ 7C2B                  ; Item già raccolto?
1838+ 7C2B                  ; ---------------------------------------------------------------
1839+ 7C2B B7               or   a
1840+ 7C2C 20 39            jr   nz, .next_no_inc
1841+ 7C2E
1842+ 7C2E                  ; ---------------------------------------------------------------
1843+ 7C2E                  ; Test collisione Willy ↔ Item
1844+ 7C2E                  ;
1845+ 7C2E                  ; Input richiesto:
1846+ 7C2E                  ;   A = ItemX
1847+ 7C2E                  ;   H = ItemY
1848+ 7C2E                  ; ---------------------------------------------------------------
1849+ 7C2E 79               ld   a, c
1850+ 7C2F
1851+ 7C2F E5               push hl                ; salva puntatore al flag Collected
1852+ 7C30
1853+ 7C30 60               ld   h, b
1854+ 7C31
1855+ 7C31 CD CC 7B         call CheckWillyItemCollision
1856+ 7C34
1857+ 7C34 E1               pop  hl
1858+ 7C35
1859+ 7C35                  ; Nessuna collisione
1860+ 7C35 30 30            jr   nc, .next_no_inc
1861+ 7C37
1862+ 7C37                  ; ===============================================================
1863+ 7C37                  ; ITEM RACCOLTO
1864+ 7C37                  ; ===============================================================
1865+ 7C37
1866+ 7C37                  ; ---------------------------------------------------------------
1867+ 7C37                  ; Marca l'item come raccolto
1868+ 7C37                  ; ---------------------------------------------------------------
1869+ 7C37 36 01            ld   (hl), 1
1870+ 7C39
1871+ 7C39                  ; ---------------------------------------------------------------
1872+ 7C39                  ; Rimuove l'item dalla cache items_grid
1873+ 7C39                  ;
1874+ 7C39                  ; Calcolo:
1875+ 7C39                  ;   offset = Row * 32 + Col
1876+ 7C39                  ; ---------------------------------------------------------------
1877+ 7C39 E5               push hl
1878+ 7C3A D5               push de
1879+ 7C3B
1880+ 7C3B 26 00            ld   h, 0
1881+ 7C3D 68               ld   l, b              ; HL = Row
1882+ 7C3E
1883+ 7C3E 29               add  hl, hl            ; *2
1884+ 7C3F 29               add  hl, hl            ; *4
1885+ 7C40 29               add  hl, hl            ; *8
1886+ 7C41 29               add  hl, hl            ; *16
1887+ 7C42 29               add  hl, hl            ; *32
1888+ 7C43
1889+ 7C43 59               ld   e, c
1890+ 7C44 16 00            ld   d, 0
1891+ 7C46
1892+ 7C46 19               add  hl, de            ; Row*32 + Col
1893+ 7C47
1894+ 7C47 11 26 E4         ld   de, items_grid
1895+ 7C4A 19               add  hl, de
1896+ 7C4B
1897+ 7C4B                  ; La cella non contiene più un item
1898+ 7C4B 36 00            ld   (hl), 0
1899+ 7C4D
1900+ 7C4D D1               pop  de
1901+ 7C4E E1               pop  hl
1902+ 7C4F
1903+ 7C4F                  ; ---------------------------------------------------------------
1904+ 7C4F                  ; Conserva il puntatore all'entry corrente
1905+ 7C4F                  ; poiché le routine successive possono alterare HL.
1906+ 7C4F                  ; ---------------------------------------------------------------
1907+ 7C4F E5               push hl
1908+ 7C50
1909+ 7C50                  ; ---------------------------------------------------------------
1910+ 7C50                  ; Aggiorna il numero di oggetti raccolti
1911+ 7C50                  ; ---------------------------------------------------------------
1912+ 7C50 3A 30 E6         ld   a, (items_collected)
1913+ 7C53
1914+ 7C53 3C               inc  a
1915+ 7C54
1916+ 7C54 32 30 E6         ld   (items_collected), a
1917+ 7C57
1918+ 7C57                  ; ---------------------------------------------------------------
1919+ 7C57                  ; Aggiorna il contatore visualizzato a schermo
1920+ 7C57                  ; ---------------------------------------------------------------
1921+ 7C57 CD 67 61         call Gfx_UpdateItemsCollectedDisplay
1922+ 7C5A
1923+ 7C5A                  ; ---------------------------------------------------------------
1924+ 7C5A                  ; Ripristina il tile originale della stanza
1925+ 7C5A                  ; eliminando la grafica dell'item.
1926+ 7C5A                  ;
1927+ 7C5A                  ; Input:
1928+ 7C5A                  ;   B = Row
1929+ 7C5A                  ;   C = Col
