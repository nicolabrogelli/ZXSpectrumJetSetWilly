  67+ 7B02
  68+ 7B02                  ; 1. Copia Flags (Byte 0), Type (Byte 1), StartX (Byte 2), StartY (Byte 3)
  69+ 7B02 7E               ld   a, (hl)           ; A = Flags
  70+ 7B03 CB 7F            bit  7, a              ; Il nemico è attivo?
  71+ 7B05 28 26            jr   z, .store_enemy_flags ; Se non è attivo, memorizza 0
  72+ 7B07
  73+ 7B07                  ; Controlla se siamo nella stanza Master Bedroom
  74+ 7B07 E5               push hl
  75+ 7B08 C5               push bc
  76+ 7B09 2A 62 F8         ld   hl, (room_ptr)
  77+ 7B0C 01 56 B4         ld   bc, MastreBedRoomLayout
  78+ 7B0F B7               or   a
