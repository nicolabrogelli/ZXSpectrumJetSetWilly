1086+ 6C34                  ; 2. Punto medio: (X, Y + 7)
1087+ 6C34 78               ld   a, b
1088+ 6C35 C6 07            add  a, 7
1089+ 6C37 47               ld   b, a
1090+ 6C38 CD FD 6B         call CheckWallCell
1091+ 6C3B 38 0E            jr   c, .collision
1092+ 6C3D
1093+ 6C3D                  ; 3. Punto inferiore: (X, Y + 15)
1094+ 6C3D C1               pop  bc
1095+ 6C3E C5               push bc
1096+ 6C3F 78               ld   a, b
1097+ 6C40 C6 0F            add  a, 15
1098+ 6C42 47               ld   b, a
1099+ 6C43 CD FD 6B         call CheckWallCell
