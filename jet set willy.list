1197+ 834D                  ; ---------------------------------------------------------------
1198+ 834D
1199+ 834D 23               inc  hl
1200+ 834E 4E               ld   c, (hl)           ; X (colonna)
1201+ 834F
1202+ 834F 23               inc  hl
1203+ 8350 46               ld   b, (hl)           ; Y (riga)
1204+ 8351
1205+ 8351 23               inc  hl
1206+ 8352 5E               ld   e, (hl)           ; Colore
1207+ 8353
1208+ 8353 23               inc  hl
1209+ 8354 7E               ld   a, (hl)           ; Collected flag
