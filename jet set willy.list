 233  89A6 CD 7D 82         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 234  89A9 21 1D FA         ld   hl, room_entry_positions
 235  89AC 5F               ld   e, a
 236  89AD 16 00            ld   d, 0
 237  89AF 19               add  hl, de
 238  89B0 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 239  89B1 4E               ld   c, (hl)                   ; C = X ingresso
 240  89B2 23               inc  hl
 241  89B3 46               ld   b, (hl)                   ; B = Y ingresso
 242  89B4 ED 43 96 F6      ld   (PlayerPos), bc           ; Imposta le coordinate di respawn al punto di ingresso
 243  89B8 ED 43 98 F6      ld   (PlayerPosOld), bc
