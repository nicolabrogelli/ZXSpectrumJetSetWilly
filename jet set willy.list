  71+ 759F              ; Audio_UpdateMusic
  72+ 759F              ;
  73+ 759F              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 759F              ; Viene chiamata a ogni frame.
  75+ 759F              ; -------------------------------------------------------------------
  76+ 759F              Audio_UpdateMusic:
  77+ 759F F5               push af
  78+ 75A0 C5               push bc
  79+ 75A1 D5               push de
  80+ 75A2 E5               push hl
  81+ 75A3
  82+ 75A3                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 75A3 3A EA 79         ld   a, (Audio_jump_sound_note)
  84+ 75A6 FE 12            cp   18
  85+ 75A8 38 5A            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 75AA
  87+ 75AA                  ; Decrementa il contatore dei frame della nota corrente
  88+ 75AA 3A ED 79         ld   a, (Audio_music_frame_counter)
  89+ 75AD 3D               dec  a
  90+ 75AE 32 ED 79         ld   (Audio_music_frame_counter), a
  91+ 75B1 20 23            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 75B3
  93+ 75B3                  ; Altrimenti carica la nota successiva
  94+ 75B3 3A EC 79         ld   a, (Audio_music_note_idx)
  95+ 75B6 3C               inc  a
  96+ 75B7 FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 75B9 38 01            jr   c, .no_wrap
  98+ 75BB AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 75BC              .no_wrap:
 100+ 75BC 32 EC 79         ld   (Audio_music_note_idx), a
 101+ 75BF
 102+ 75BF                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 75BF 5F               ld   e, a
 104+ 75C0 16 00            ld   d, 0
 105+ 75C2 21 09 76         ld   hl, Audio_MusicSheet
 106+ 75C5 19               add  hl, de
 107+ 75C6 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 75C7
 109+ 75C7                  ; Leggi durata (secondo byte)
 110+ 75C7 23               inc  hl
 111+ 75C8 7E               ld   a, (hl)
 112+ 75C9 CB 3F            srl  a                        ; Divide per 8 (velocizza 8x)
 113+ 75CB CB 3F            srl  a
 114+ 75CD CB 3F            srl  a
 115+ 75CF 20 02            jr   nz, .dur_ok
 116+ 75D1 3E 01            ld   a, 1
 117+ 75D3              .dur_ok:
 118+ 75D3 32 ED 79         ld   (Audio_music_frame_counter), a
