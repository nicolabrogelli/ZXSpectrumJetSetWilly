   8+ 85B7              ; Audio_UpdateJumpSound
   9+ 85B7              ;
  10+ 85B7              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 85B7              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 85B7              ; -------------------------------------------------------------------
  13+ 85B7              Audio_UpdateJumpSound:
  14+ 85B7 F5               push af
  15+ 85B8 C5               push bc
  16+ 85B9 D5               push de
  17+ 85BA E5               push hl
  18+ 85BB
  19+ 85BB                  ; Controlla se il suono è attivo (note < 18)
  20+ 85BB 3A FD EE         ld   a, (Audio_jump_sound_note)
  21+ 85BE FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 85C0 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 85C2
  24+ 85C2                  ; Carica la nota corrente da suonare
  25+ 85C2 5F               ld   e, a
  26+ 85C3 16 00            ld   d, 0
  27+ 85C5 21 F1 85         ld   hl, Audio_JumpSoundDelays
  28+ 85C8 19               add  hl, de
  29+ 85C9 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 85CA 57               ld   d, a                      ; D = delay della nota
  31+ 85CB
  32+ 85CB                  ; Suona la nota: 15 cicli
  33+ 85CB 06 0F            ld   b, 15
  34+ 85CD              .note_loop:
  35+ 85CD                  ; Speaker ON
  36+ 85CD 3A F6 EA         ld   a, (room_border_color)
  37+ 85D0 F6 10            or   $10
  38+ 85D2 D3 FE            out  ($fe), a
  39+ 85D4 4A               ld   c, d
  40+ 85D5              .d1:
  41+ 85D5 0D               dec  c
  42+ 85D6 20 FD            jr   nz, .d1
  43+ 85D8
  44+ 85D8                  ; Speaker OFF
  45+ 85D8 3A F6 EA         ld   a, (room_border_color)
  46+ 85DB E6 EF            and  $ef
  47+ 85DD D3 FE            out  ($fe), a
  48+ 85DF 4A               ld   c, d
  49+ 85E0              .d2:
  50+ 85E0 0D               dec  c
  51+ 85E1 20 FD            jr   nz, .d2
  52+ 85E3
  53+ 85E3 10 E8            djnz .note_loop
  54+ 85E5
  55+ 85E5                  ; Passa alla nota successiva
  56+ 85E5 3A FD EE         ld   a, (Audio_jump_sound_note)
  57+ 85E8 3C               inc  a
  58+ 85E9 32 FD EE         ld   (Audio_jump_sound_note), a
  59+ 85EC
  60+ 85EC              .done:
  61+ 85EC E1               pop  hl
  62+ 85ED D1               pop  de
  63+ 85EE C1               pop  bc
  64+ 85EF F1               pop  af
  65+ 85F0 C9               ret
  66+ 85F1
  67+ 85F1              Audio_JumpSoundDelays:
  68+ 85F1 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 85F5 19 13 0C 06
  68+ 85F9 0C 13 19 20
