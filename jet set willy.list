 685+ 60CA 78               ld   a, b
 686+ 60CB BA               cp   d
 687+ 60CC 20 1E            jr   nz, .player_moved
 688+ 60CE 79               ld   a, c
 689+ 60CF BB               cp   e
 690+ 60D0 20 1A            jr   nz, .player_moved
 691+ 60D2
 692+ 60D2 3A 36 F3         ld   a, (direction)
