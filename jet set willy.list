  71+ 7A6C              ; Audio_UpdateMusic
  72+ 7A6C              ;
  73+ 7A6C              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 7A6C              ; Viene chiamata a ogni frame.
  75+ 7A6C              ; -------------------------------------------------------------------
  76+ 7A6C              Audio_UpdateMusic:
  77+ 7A6C F5               push af
  78+ 7A6D C5               push bc
  79+ 7A6E D5               push de
  80+ 7A6F E5               push hl
  81+ 7A70
  82+ 7A70                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 7A70 3A BA 7E         ld   a, (Audio_jump_sound_note)
  84+ 7A73 FE 12            cp   18
  85+ 7A75 38 56            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 7A77
  87+ 7A77                  ; Decrementa il contatore dei frame della nota corrente
  88+ 7A77 3A BD 7E         ld   a, (Audio_music_frame_counter)
  89+ 7A7A 3D               dec  a
  90+ 7A7B 32 BD 7E         ld   (Audio_music_frame_counter), a
  91+ 7A7E 20 1F            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 7A80
  93+ 7A80                  ; Altrimenti carica la nota successiva
  94+ 7A80 3A BC 7E         ld   a, (Audio_music_note_idx)
  95+ 7A83 3C               inc  a
  96+ 7A84 FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 7A86 38 01            jr   c, .no_wrap
  98+ 7A88 AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 7A89              .no_wrap:
 100+ 7A89 32 BC 7E         ld   (Audio_music_note_idx), a
 101+ 7A8C
 102+ 7A8C                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 7A8C 5F               ld   e, a
 104+ 7A8D 16 00            ld   d, 0
 105+ 7A8F 21 D2 7A         ld   hl, Audio_MusicSheet
 106+ 7A92 19               add  hl, de
 107+ 7A93 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 7A94
 109+ 7A94                  ; Leggi durata (secondo byte)
 110+ 7A94 23               inc  hl
 111+ 7A95 7E               ld   a, (hl)
 112+ 7A96 CB 3F            srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 113+ 7A98 20 02            jr   nz, .dur_ok
 114+ 7A9A 3E 01            ld   a, 1
 115+ 7A9C              .dur_ok:
 116+ 7A9C 32 BD 7E         ld   (Audio_music_frame_counter), a
 117+ 7A9F
 118+ 7A9F              .play_current_note:
 119+ 7A9F                  ; Ottieni il delay della nota corrente (primo byte)
 120+ 7A9F 3A BC 7E         ld   a, (Audio_music_note_idx)
 121+ 7AA2 5F               ld   e, a
 122+ 7AA3 16 00            ld   d, 0
 123+ 7AA5 21 D2 7A         ld   hl, Audio_MusicSheet
 124+ 7AA8 19               add  hl, de
 125+ 7AA9 19               add  hl, de                   ; hl punta al primo byte della nota
 126+ 7AAA 7E               ld   a, (hl)                  ; A = delay
 127+ 7AAB B7               or   a
 128+ 7AAC 28 1F            jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 129+ 7AAE
 130+ 7AAE                  ; Suona la nota: 2 cicli
 131+ 7AAE 57               ld   d, a                     ; D = delay
 132+ 7AAF 06 02            ld   b, 2                     ; 2 cicli per frame
 133+ 7AB1              .note_loop:
 134+ 7AB1                  ; Speaker ON
 135+ 7AB1 3A 45 7B         ld   a, (room_border_color)
 136+ 7AB4 F6 10            or   $10
 137+ 7AB6 D3 FE            out  ($fe), a
