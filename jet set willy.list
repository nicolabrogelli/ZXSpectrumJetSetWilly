 187+ 7F2E
 188+ 7F2E              ; -------------------------------------------------------------------
 189+ 7F2E              ; DetermineCurrentRoomID
 190+ 7F2E              ;
 191+ 7F2E              ; Determina l'ID numerico della stanza corrente confrontando
 192+ 7F2E              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 193+ 7F2E              ;
 194+ 7F2E              ; Se viene trovata una corrispondenza:
 195+ 7F2E              ;   A = ID della stanza
 196+ 7F2E              ;   current_room = A
 197+ 7F2E              ;
 198+ 7F2E              ; Mappatura:
 199+ 7F2E              ;    0 = The Off Licence
 200+ 7F2E              ;    1 = The Bridge
 201+ 7F2E              ;    2 = Under The Mega Tree
 202+ 7F2E              ;    3 = Gfx_At The Foot Of The Mega Tree
 203+ 7F2E              ;    4 = The Drive
 204+ 7F2E              ;    5 = The Security Guard
 205+ 7F2E              ;    6 = Entrance To Hades
 206+ 7F2E              ;    7 = Cuckoo's Nest
 207+ 7F2E              ;    8 = Inside The Mega Trunk
 208+ 7F2E              ;    9 = On A Branch Over The Drive
 209+ 7F2E              ;   10 = The Front Door
 210+ 7F2E              ;   11 = The Hall
 211+ 7F2E              ;   12 = Tree Top
 212+ 7F2E              ;   27 = The Chapel
 213+ 7F2E              ;   28 = First Landing
 214+ 7F2E              ;   29 = The Nightmare Room
 215+ 7F2E              ;   33 = The Bathroom
 216+ 7F2E              ;   35 = Master Bedroom
 217+ 7F2E              ;
 218+ 7F2E              ; Se nessuna stanza corrisponde viene impostato:
 219+ 7F2E              ;   current_room = 0
 220+ 7F2E              ; -------------------------------------------------------------------
 221+ 7F2E              DetermineCurrentRoomID:
 222+ 7F2E
