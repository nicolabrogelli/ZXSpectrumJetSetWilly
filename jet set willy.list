 456+ 73E9
 457+ 73E9              ; -------------------------------------------------------------------
 458+ 73E9              ; Items_DrawRoom
 459+ 73E9              ;
 460+ 73E9              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 461+ 73E9              ;
 462+ 73E9              ; Operazioni eseguite:
 463+ 73E9              ;   1. Azzera la griglia items_grid.
 464+ 73E9              ;   2. Svuota la cache degli oggetti attivi.
 465+ 73E9              ;   3. Scansiona ItemsTable.
 466+ 73E9              ;   4. Per ogni item della stanza corrente:
 467+ 73E9              ;        - verifica se è già stato raccolto
 468+ 73E9              ;        - disegna la grafica
 469+ 73E9              ;        - aggiorna items_grid
 470+ 73E9              ;        - memorizza l'item nella cache current_room_items
 471+ 73E9              ;   5. Aggiorna num_room_items.
 472+ 73E9              ;
 473+ 73E9              ; Record ItemsTable:
 474+ 73E9              ;   +0  Room ID
 475+ 73E9              ;   +1  X (colonna)
 476+ 73E9              ;   +2  Y (riga)
 477+ 73E9              ;   +3  Colore
 478+ 73E9              ;   +4  Collected flag
 479+ 73E9              ;
 480+ 73E9              ; Cache current_room_items:
 481+ 73E9              ;   +0  Colonna
 482+ 73E9              ;   +1  Riga
 483+ 73E9              ;   +2  Colore
 484+ 73E9              ;   +3  Collected flag ptr (Low)
 485+ 73E9              ;   +4  Collected flag ptr (High)
 486+ 73E9              ;
 487+ 73E9              ; Ogni record cache occupa 5 byte.
 488+ 73E9              ; -------------------------------------------------------------------
 489+ 73E9              Items_DrawRoom:
 490+ 73E9
 491+ 73E9                  ; Salva tutti i registri utilizzati
 492+ 73E9 E5               push hl
 493+ 73EA D5               push de
 494+ 73EB C5               push bc
 495+ 73EC DD E5            push ix
 496+ 73EE FD E5            push iy
 497+ 73F0
 498+ 73F0                  ; ---------------------------------------------------------------
 499+ 73F0                  ; Azzera items_grid (32 x 16 = 512 byte)
 500+ 73F0                  ; ---------------------------------------------------------------
 501+ 73F0 21 00 B0         ld   hl, items_grid
 502+ 73F3 11 01 B0         ld   de, items_grid + 1
 503+ 73F6 36 00            ld   (hl), 0
 504+ 73F8 01 FF 01         ld   bc, 511
 505+ 73FB ED B0            ldir
 506+ 73FD
 507+ 73FD                  ; ---------------------------------------------------------------
 508+ 73FD                  ; Nessun item attivo nella stanza
 509+ 73FD                  ; ---------------------------------------------------------------
 510+ 73FD AF               xor  a
 511+ 73FE 32 3C 7A         ld   (num_room_items), a
 512+ 7401
 513+ 7401                  ; IY punta alla cache degli item attivi
 514+ 7401 FD 21 EC 79      ld   iy, current_room_items
 515+ 7405
 516+ 7405                  ; ---------------------------------------------------------------
 517+ 7405                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 518+ 7405                  ; alla stanza corrente.
 519+ 7405                  ;
 520+ 7405                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 521+ 7405                  ; ---------------------------------------------------------------
 522+ 7405 2A 3D 7A         ld   hl, (room_ptr)
 523+ 7408 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 524+ 740B 19               add  hl, de
 525+ 740C
 526+ 740C E5               push hl
 527+ 740D DD E1            pop  ix                ; IX = bitmap item
 528+ 740F
 529+ 740F                  ; ---------------------------------------------------------------
 530+ 740F                  ; Inizio scansione della tabella degli item
 531+ 740F                  ; ---------------------------------------------------------------
 532+ 740F 21 E7 71         ld   hl, ItemsTable
 533+ 7412
 534+ 7412              .loop:
 535+ 7412
 536+ 7412                  ; ---------------------------------------------------------------
 537+ 7412                  ; Legge il Room ID del record corrente
 538+ 7412                  ; ---------------------------------------------------------------
 539+ 7412 7E               ld   a, (hl)
 540+ 7413
 541+ 7413                  ; $FF indica fine tabella
 542+ 7413 FE FF            cp   $FF
 543+ 7415 28 53            jr   z, .done
 544+ 7417
 545+ 7417                  ; ---------------------------------------------------------------
 546+ 7417                  ; Verifica se l'item appartiene alla stanza corrente
 547+ 7417                  ; ---------------------------------------------------------------
 548+ 7417 57               ld   d, a
 549+ 7418
 550+ 7418 3A E3 79         ld   a, (current_room)
 551+ 741B BA               cp   d
 552+ 741C 20 45            jr   nz, .next_item
 553+ 741E
 554+ 741E                  ; ---------------------------------------------------------------
 555+ 741E                  ; Legge i dati dell'item
 556+ 741E                  ; ---------------------------------------------------------------
 557+ 741E
 558+ 741E 23               inc  hl
 559+ 741F 4E               ld   c, (hl)           ; X (colonna)
 560+ 7420
 561+ 7420 23               inc  hl
 562+ 7421 46               ld   b, (hl)           ; Y (riga)
 563+ 7422
 564+ 7422 23               inc  hl
 565+ 7423 5E               ld   e, (hl)           ; Colore
 566+ 7424
 567+ 7424 23               inc  hl
 568+ 7425 7E               ld   a, (hl)           ; Collected flag
 569+ 7426
 570+ 7426                  ; Se diverso da zero l'item è già stato raccolto
 571+ 7426 B7               or   a
 572+ 7427 20 3E            jr   nz, .next_no_inc
 573+ 7429
 574+ 7429                  ; ---------------------------------------------------------------
 575+ 7429                  ; Disegna l'item sullo schermo
 576+ 7429                  ;
 577+ 7429                  ; B = Row
 578+ 7429                  ; C = Column
 579+ 7429                  ; HL = bitmap pointer
 580+ 7429                  ; E = Color
 581+ 7429                  ; ---------------------------------------------------------------
 582+ 7429 E5               push hl
 583+ 742A
 584+ 742A DD E5            push ix
 585+ 742C E1               pop  hl
 586+ 742D
 587+ 742D CD 72 74         call DrawItemGraphic
 588+ 7430
 589+ 7430 E1               pop  hl                ; ritorna al flag collected
 590+ 7431
 591+ 7431                  ; ---------------------------------------------------------------
 592+ 7431                  ; Aggiorna items_grid
 593+ 7431                  ;
 594+ 7431                  ; Calcolo:
 595+ 7431                  ;   offset = Row * 32 + Col
 596+ 7431                  ; ---------------------------------------------------------------
 597+ 7431 E5               push hl
 598+ 7432 D5               push de
 599+ 7433
 600+ 7433 26 00            ld   h, 0
 601+ 7435 68               ld   l, b              ; HL = Row
 602+ 7436
 603+ 7436 29               add  hl, hl            ; *2
 604+ 7437 29               add  hl, hl            ; *4
 605+ 7438 29               add  hl, hl            ; *8
 606+ 7439 29               add  hl, hl            ; *16
 607+ 743A 29               add  hl, hl            ; *32
 608+ 743B
 609+ 743B 16 00            ld   d, 0
 610+ 743D 59               ld   e, c              ; DE = Col
 611+ 743E
 612+ 743E 19               add  hl, de            ; Row*32 + Col
 613+ 743F
 614+ 743F 11 00 B0         ld   de, items_grid
 615+ 7442 19               add  hl, de            ; puntatore nella griglia
 616+ 7443
 617+ 7443 D1               pop  de                ; ripristina colore
 618+ 7444
 619+ 7444 73               ld   (hl), e           ; salva colore cella
 620+ 7445
 621+ 7445 E1               pop  hl
 622+ 7446
 623+ 7446                  ; ---------------------------------------------------------------
 624+ 7446                  ; Salva l'item nella cache della stanza
 625+ 7446                  ;
 626+ 7446                  ; Questo evita di dover scansionare tutta ItemsTable
 627+ 7446                  ; durante il controllo delle collisioni.
 628+ 7446                  ; ---------------------------------------------------------------
 629+ 7446
 630+ 7446 FD 71 00         ld   (iy+0), c         ; Colonna
 631+ 7449 FD 70 01         ld   (iy+1), b         ; Riga
 632+ 744C FD 73 02         ld   (iy+2), e         ; Colore
 633+ 744F
 634+ 744F                  ; Salva il puntatore al flag "collected"
 635+ 744F FD 75 03         ld   (iy+3), l         ; Low byte
 636+ 7452 FD 74 04         ld   (iy+4), h         ; High byte
 637+ 7455
 638+ 7455                  ; Passa al record successivo della cache
 639+ 7455 01 05 00         ld   bc, 5
 640+ 7458 FD 09            add  iy, bc
 641+ 745A
 642+ 745A                  ; Incrementa il numero di item attivi
 643+ 745A 3A 3C 7A         ld   a, (num_room_items)
 644+ 745D 3C               inc  a
 645+ 745E 32 3C 7A         ld   (num_room_items), a
 646+ 7461
 647+ 7461 18 04            jr   .next_no_inc
 648+ 7463
 649+ 7463              .next_item:
 650+ 7463
 651+ 7463                  ; ---------------------------------------------------------------
 652+ 7463                  ; L'item non appartiene alla stanza corrente.
 653+ 7463                  ; Salta i campi del record:
 654+ 7463                  ;   X
 655+ 7463                  ;   Y
 656+ 7463                  ;   Color
 657+ 7463                  ;   Collected
 658+ 7463                  ; ---------------------------------------------------------------
 659+ 7463 23               inc  hl
 660+ 7464 23               inc  hl
 661+ 7465 23               inc  hl
 662+ 7466 23               inc  hl
 663+ 7467
 664+ 7467              .next_no_inc:
 665+ 7467
 666+ 7467                  ; ---------------------------------------------------------------
 667+ 7467                  ; Avanza al record successivo
 668+ 7467                  ; (prossimo Room ID)
 669+ 7467                  ; ---------------------------------------------------------------
 670+ 7467 23               inc  hl
 671+ 7468 18 A8            jr   .loop
 672+ 746A
 673+ 746A              .done:
 674+ 746A
 675+ 746A                  ; Ripristina i registri
 676+ 746A FD E1            pop  iy
 677+ 746C DD E1            pop  ix
 678+ 746E D1               pop  de
 679+ 746F C1               pop  bc
 680+ 7470 E1               pop  hl
 681+ 7471
 682+ 7471 C9               ret
 683+ 7472
 684+ 7472              ; -------------------------------------------------------------------
 685+ 7472              ; DrawItemGraphic
 686+ 7472              ;
 687+ 7472              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 688+ 7472              ; utilizzando una bitmap di 8 byte e un attributo colore.
 689+ 7472              ;
 690+ 7472              ; Input:
 691+ 7472              ;   B = Riga attributi (3..18)
 692+ 7472              ;   C = Colonna attributi (0..31)
 693+ 7472              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 694+ 7472              ;   E = Attributo colore
 695+ 7472              ;
 696+ 7472              ; Output:
 697+ 7472              ;   Nessuno
 698+ 7472              ;
 699+ 7472              ; Registri preservati:
 700+ 7472              ;   BC, DE, HL
 701+ 7472              ; -------------------------------------------------------------------
 702+ 7472              DrawItemGraphic:
 703+ 7472
 704+ 7472                  ; Salva i registri originali
 705+ 7472 C5               push bc
 706+ 7473 D5               push de
 707+ 7474 E5               push hl
 708+ 7475
 709+ 7475                  ; ---------------------------------------------------------------
 710+ 7475                  ; Calcolo indirizzo bitmap dello Spectrum
 711+ 7475                  ;
 712+ 7475                  ; Ogni item occupa una cella attributi (8x8 pixel).
 713+ 7475                  ;
 714+ 7475                  ; Formula:
 715+ 7475                  ;   High = $40 + (Row AND $18)
 716+ 7475                  ;   Low  = (Row AND 7) * 32 + Col
 717+ 7475                  ;
 718+ 7475                  ; DE conterrà l'indirizzo della prima scanline.
 719+ 7475                  ; ---------------------------------------------------------------
 720+ 7475
 721+ 7475 78               ld   a, b
 722+ 7476 E6 18            and  $18
 723+ 7478 C6 40            add  a, $40
 724+ 747A 57               ld   d, a              ; Byte alto indirizzo video
 725+ 747B
 726+ 747B 78               ld   a, b
 727+ 747C E6 07            and  7                 ; Riga interna al blocco da 8
 728+ 747E
 729+ 747E 87               add  a, a              ; *2
 730+ 747F 87               add  a, a              ; *4
 731+ 7480 87               add  a, a              ; *8
 732+ 7481 87               add  a, a              ; *16
 733+ 7482 87               add  a, a              ; *32
 734+ 7483
 735+ 7483 81               add  a, c              ; + colonna
 736+ 7484
 737+ 7484 5F               ld   e, a              ; Byte basso indirizzo video
 738+ 7485
 739+ 7485                  ; ---------------------------------------------------------------
 740+ 7485                  ; Disegno bitmap
 741+ 7485                  ;
 742+ 7485                  ; Copia 8 byte consecutivi nella memoria video.
 743+ 7485                  ; Ogni byte rappresenta una scanline da 8 pixel.
 744+ 7485                  ; ---------------------------------------------------------------
 745+ 7485
 746+ 7485 C5               push bc                ; Conserva Row e Col
 747+ 7486
 748+ 7486 06 08            ld   b, 8              ; Numero scanline
 749+ 7488
 750+ 7488              .line_loop:
 751+ 7488
 752+ 7488 7E               ld   a, (hl)           ; Legge scanline bitmap
 753+ 7489 12               ld   (de), a           ; Scrive nella memoria video
 754+ 748A
 755+ 748A 14               inc  d                 ; Scanline successiva
 756+ 748B 23               inc  hl                ; Byte bitmap successivo
 757+ 748C
 758+ 748C 05               dec  b
 759+ 748D 20 F9            jr   nz, .line_loop
 760+ 748F
 761+ 748F C1               pop  bc                ; Ripristina Row e Col
 762+ 7490
 763+ 7490                  ; ---------------------------------------------------------------
 764+ 7490                  ; Calcolo indirizzo attributo
 765+ 7490                  ;
 766+ 7490                  ; Formula:
 767+ 7490                  ;   AttrAddr = $5800 + Row * 32 + Col
 768+ 7490                  ;
 769+ 7490                  ; HL conterrà l'indirizzo della cella attributi.
 770+ 7490                  ; ---------------------------------------------------------------
 771+ 7490
 772+ 7490 26 00            ld   h, 0
 773+ 7492 68               ld   l, b              ; HL = Row
 774+ 7493
 775+ 7493 29               add  hl, hl            ; *2
 776+ 7494 29               add  hl, hl            ; *4
 777+ 7495 29               add  hl, hl            ; *8
 778+ 7496 29               add  hl, hl            ; *16
 779+ 7497 29               add  hl, hl            ; *32
 780+ 7498
 781+ 7498 79               ld   a, c              ; A = Colonna
 782+ 7499
 783+ 7499 85               add  a, l
 784+ 749A 6F               ld   l, a
 785+ 749B
 786+ 749B 30 01            jr   nc, .no_carry
 787+ 749D 24               inc  h
 788+ 749E
 789+ 749E              .no_carry:
 790+ 749E
 791+ 749E                  ; HL = Row * 32 + Col
 792+ 749E
 793+ 749E 11 00 58         ld   de, $5800
 794+ 74A1 19               add  hl, de            ; HL = indirizzo attributi
 795+ 74A2
 796+ 74A2                  ; ---------------------------------------------------------------
 797+ 74A2                  ; Recupera il colore originale dallo stack.
 798+ 74A2                  ;
 799+ 74A2                  ; Layout stack:
 800+ 74A2                  ;   HL originale
 801+ 74A2                  ;   DE originale (E = colore)
 802+ 74A2                  ;   BC originale
 803+ 74A2                  ; ---------------------------------------------------------------
 804+ 74A2
 805+ 74A2 C1               pop  bc                ; Recupera HL originale
 806+ 74A3 D1               pop  de                ; Recupera DE originale
 807+ 74A4
 808+ 74A4                  ; ---------------------------------------------------------------
 809+ 74A4                  ; Scrive l'attributo colore
 810+ 74A4                  ; ---------------------------------------------------------------
 811+ 74A4
 812+ 74A4 7B               ld   a, e              ; A = colore
 813+ 74A5 77               ld   (hl), a           ; Scrive nella RAM attributi
 814+ 74A6
 815+ 74A6                  ; ---------------------------------------------------------------
 816+ 74A6                  ; Ripristina HL e BC originali
 817+ 74A6                  ; ---------------------------------------------------------------
 818+ 74A6
 819+ 74A6 C5               push bc
 820+ 74A7 E1               pop  hl                ; HL originale
 821+ 74A8
 822+ 74A8 C1               pop  bc                ; BC originale
 823+ 74A9
 824+ 74A9 C9               ret
 825+ 74AA
 826+ 74AA              ; -------------------------------------------------------------------
 827+ 74AA              ; RestoreBackgroundCell
 828+ 74AA              ;
 829+ 74AA              ; Ripristina il contenuto originale di una cella della stanza.
 830+ 74AA              ; Viene utilizzata principalmente quando un item viene raccolto:
 831+ 74AA              ; invece di lasciare un "buco", la routine ridisegna il tile
 832+ 74AA              ; originale presente nella mappa della stanza.
 833+ 74AA              ;
 834+ 74AA              ; Input:
 835+ 74AA              ;   B = Row (3..18)
 836+ 74AA              ;   C = Col (0..31)
 837+ 74AA              ;
 838+ 74AA              ; Utilizza:
 839+ 74AA              ;   room_ptr -> struttura dati della stanza corrente
 840+ 74AA              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 841+ 74AA              ;   Gfx_DrawTile -> ridisegna il tile selezionato
 842+ 74AA              ;
 843+ 74AA              ; Tipi di cella:
 844+ 74AA              ;   0 = Background
 845+ 74AA              ;   1 = Floor
 846+ 74AA              ;   2 = Wall
 847+ 74AA              ;   3 = Nasty
 848+ 74AA              ; -------------------------------------------------------------------
 849+ 74AA              RestoreBackgroundCell:
 850+ 74AA
 851+ 74AA                  ; Salva tutti i registri utilizzati
 852+ 74AA FD E5            push iy
 853+ 74AC C5               push bc
 854+ 74AD D5               push de
 855+ 74AE E5               push hl
 856+ 74AF DD E5            push ix
 857+ 74B1
 858+ 74B1                  ; ---------------------------------------------------------------
 859+ 74B1                  ; Conserva Row e Col in IY.
 860+ 74B1                  ;
 861+ 74B1                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 862+ 74B1                  ; BC potrebbe essere modificato.
 863+ 74B1                  ; ---------------------------------------------------------------
 864+ 74B1 C5               push bc
 865+ 74B2 FD E1            pop  iy                ; IYH = Row, IYL = Col
 866+ 74B4
 867+ 74B4                  ; ---------------------------------------------------------------
 868+ 74B4                  ; Determina quale tipo di cella è presente nella posizione
 869+ 74B4                  ; specificata.
 870+ 74B4                  ;
 871+ 74B4                  ; Input:
 872+ 74B4                  ;   B = Row
 873+ 74B4                  ;   C = Col
 874+ 74B4                  ;
 875+ 74B4                  ; Output:
 876+ 74B4                  ;   A = tipo cella
 877+ 74B4                  ; ---------------------------------------------------------------
 878+ 74B4 78               ld   a, b
 879+ 74B5
 880+ 74B5 CD E5 6B         call GetCellFromUnpacked
 881+ 74B8
 882+ 74B8                  ; ---------------------------------------------------------------
 883+ 74B8                  ; Recupera il puntatore alla stanza corrente.
 884+ 74B8                  ;
 885+ 74B8                  ; DE = base della struttura stanza
 886+ 74B8                  ; ---------------------------------------------------------------
 887+ 74B8 ED 5B 3D 7A      ld   de, (room_ptr)
 888+ 74BC
 889+ 74BC                  ; ---------------------------------------------------------------
 890+ 74BC                  ; Seleziona il tile corretto in base al tipo di cella.
 891+ 74BC                  ;
 892+ 74BC                  ; A = 0 -> Background
 893+ 74BC                  ; A = 1 -> Floor
 894+ 74BC                  ; A = 2 -> Wall
 895+ 74BC                  ; A = 3 -> Nasty
 896+ 74BC                  ; ---------------------------------------------------------------
 897+ 74BC
 898+ 74BC B7               or   a
 899+ 74BD 20 06            jr   nz, .not_bg
 900+ 74BF
 901+ 74BF                  ; Background
 902+ 74BF 21 A0 00         ld   hl, OFFSET_BG
 903+ 74C2 19               add  hl, de
 904+ 74C3 18 16            jr   .draw_cell
 905+ 74C5
 906+ 74C5              .not_bg:
 907+ 74C5
 908+ 74C5 3D               dec  a
 909+ 74C6 20 06            jr   nz, .not_floor
 910+ 74C8
 911+ 74C8                  ; Floor
 912+ 74C8 21 A9 00         ld   hl, OFFSET_FLOOR
 913+ 74CB 19               add  hl, de
 914+ 74CC 18 0D            jr   .draw_cell
 915+ 74CE
 916+ 74CE              .not_floor:
 917+ 74CE
 918+ 74CE 3D               dec  a
 919+ 74CF 20 06            jr   nz, .not_wall
 920+ 74D1
 921+ 74D1                  ; Wall
 922+ 74D1 21 B2 00         ld   hl, OFFSET_WALL
 923+ 74D4 19               add  hl, de
 924+ 74D5 18 04            jr   .draw_cell
 925+ 74D7
 926+ 74D7              .not_wall:
 927+ 74D7
 928+ 74D7                  ; Nasty
 929+ 74D7 21 BB 00         ld   hl, OFFSET_NASTY
 930+ 74DA 19               add  hl, de
 931+ 74DB
 932+ 74DB              .draw_cell:
 933+ 74DB
 934+ 74DB                  ; ---------------------------------------------------------------
 935+ 74DB                  ; HL punta ora alla grafica del tile da ridisegnare.
 936+ 74DB                  ;
 937+ 74DB                  ; Gfx_DrawTile si aspetta:
 938+ 74DB                  ;   IX = puntatore tile
 939+ 74DB                  ;   B  = Row
 940+ 74DB                  ;   C  = Col
 941+ 74DB                  ; ---------------------------------------------------------------
 942+ 74DB E5               push hl
 943+ 74DC DD E1            pop  ix
 944+ 74DE
 945+ 74DE                  ; Ripristina Row e Col salvati in IY
 946+ 74DE FD E5            push iy
 947+ 74E0 C1               pop  bc
 948+ 74E1
 949+ 74E1                  ; Disegna il tile originale
 950+ 74E1 CD 8C 61         call Gfx_DrawTile
 951+ 74E4
 952+ 74E4                  ; ---------------------------------------------------------------
 953+ 74E4                  ; Ripristina i registri salvati
 954+ 74E4                  ; ---------------------------------------------------------------
 955+ 74E4 DD E1            pop  ix
 956+ 74E6 E1               pop  hl
 957+ 74E7 D1               pop  de
 958+ 74E8 C1               pop  bc
 959+ 74E9 FD E1            pop  iy
 960+ 74EB
 961+ 74EB C9               ret
 962+ 74EC
 963+ 74EC              ; -------------------------------------------------------------------
 964+ 74EC              ; CheckWillyItemCollision
 965+ 74EC              ;
 966+ 74EC              ; Verifica se Willy collide con un item utilizzando il controllo
 967+ 74EC              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 968+ 74EC              ;
 969+ 74EC              ; Input:
 970+ 74EC              ;   A = ItemX (colonna attributi 0..31)
 971+ 74EC              ;   H = ItemY (riga attributi 3..18)
 972+ 74EC              ;
 973+ 74EC              ; Coordinate item:
 974+ 74EC              ;   Ogni item occupa una cella da 8x8 pixel.
 975+ 74EC              ;
 976+ 74EC              ; Coordinate Willy:
 977+ 74EC              ;   Willy occupa un rettangolo di 16x16 pixel.
 978+ 74EC              ;
 979+ 74EC              ; Output:
 980+ 74EC              ;   Carry Set   = collisione rilevata
 981+ 74EC              ;   Carry Clear = nessuna collisione
 982+ 74EC              ;
 983+ 74EC              ; Registri preservati:
 984+ 74EC              ;   BC, DE, HL
 985+ 74EC              ; -------------------------------------------------------------------
 986+ 74EC              CheckWillyItemCollision:
 987+ 74EC
 988+ 74EC                  ; Salva i registri utilizzati
 989+ 74EC C5               push bc
 990+ 74ED D5               push de
 991+ 74EE E5               push hl
 992+ 74EF
 993+ 74EF                  ; ---------------------------------------------------------------
 994+ 74EF                  ; Calcola il bounding box orizzontale dell'item
 995+ 74EF                  ;
 996+ 74EF                  ; ItemLeft  = ItemX * 8
 997+ 74EF                  ; ItemRight = ItemLeft + 7
 998+ 74EF                  ;
 999+ 74EF                  ; E = ItemLeft
1000+ 74EF                  ; D = ItemRight
1001+ 74EF                  ; ---------------------------------------------------------------
1002+ 74EF 6F               ld   l, a              ; L = ItemX
1003+ 74F0
1004+ 74F0 7D               ld   a, l
1005+ 74F1 87               add  a, a              ; *2
1006+ 74F2 87               add  a, a              ; *4
1007+ 74F3 87               add  a, a              ; *8
1008+ 74F4
1009+ 74F4 5F               ld   e, a              ; E = ItemLeft
1010+ 74F5
1011+ 74F5 C6 07            add  a, 7
1012+ 74F7 57               ld   d, a              ; D = ItemRight
1013+ 74F8
1014+ 74F8                  ; ---------------------------------------------------------------
1015+ 74F8                  ; Recupera la posizione corrente di Willy
1016+ 74F8                  ;
1017+ 74F8                  ; B = WillyY
1018+ 74F8                  ; C = WillyX
1019+ 74F8                  ; ---------------------------------------------------------------
1020+ 74F8 ED 4B C9 76      ld   bc, (PlayerPos)
1021+ 74FC
1022+ 74FC                  ; ---------------------------------------------------------------
1023+ 74FC                  ; Primo test:
1024+ 74FC                  ;
1025+ 74FC                  ; WillyLeft <= ItemRight
1026+ 74FC                  ;
1027+ 74FC                  ; Se Willy è completamente a destra dell'item
1028+ 74FC                  ; non può esserci collisione.
1029+ 74FC                  ; ---------------------------------------------------------------
1030+ 74FC 79               ld   a, c              ; A = WillyLeft
1031+ 74FD
1032+ 74FD BA               cp   d                 ; WillyLeft vs ItemRight
1033+ 74FE
1034+ 74FE 28 04            jr   z, .x_ok
1035+ 7500 38 02            jr   c, .x_ok
1036+ 7502
1037+ 7502 18 29            jr   .no_collision
1038+ 7504
1039+ 7504              .x_ok:
1040+ 7504
1041+ 7504                  ; ---------------------------------------------------------------
1042+ 7504                  ; Secondo test:
1043+ 7504                  ;
1044+ 7504                  ; WillyRight >= ItemLeft
1045+ 7504                  ;
1046+ 7504                  ; WillyRight = WillyX + 7
1047+ 7504                  ; ---------------------------------------------------------------
1048+ 7504 C6 07            add  a, 7
1049+ 7506
1050+ 7506 BB               cp   e                 ; WillyRight vs ItemLeft
1051+ 7507
1052+ 7507 28 04            jr   z, .y_check
1053+ 7509 30 02            jr   nc, .y_check
1054+ 750B
1055+ 750B 18 20            jr   .no_collision
1056+ 750D
1057+ 750D              .y_check:
1058+ 750D
1059+ 750D                  ; ---------------------------------------------------------------
1060+ 750D                  ; Recupera ItemY dal valore originale di HL
1061+ 750D                  ;
1062+ 750D                  ; H contiene la riga dell'item.
1063+ 750D                  ; ---------------------------------------------------------------
1064+ 750D E1               pop  hl
1065+ 750E E5               push hl
1066+ 750F
1067+ 750F                  ; ---------------------------------------------------------------
1068+ 750F                  ; Calcola il bounding box verticale dell'item
1069+ 750F                  ;
1070+ 750F                  ; ItemTop    = ItemY * 8
1071+ 750F                  ; ItemBottom = ItemTop + 7
1072+ 750F                  ;
1073+ 750F                  ; E = ItemTop
1074+ 750F                  ; D = ItemBottom
1075+ 750F                  ; ---------------------------------------------------------------
1076+ 750F 7C               ld   a, h
1077+ 7510
1078+ 7510 87               add  a, a              ; *2
1079+ 7511 87               add  a, a              ; *4
1080+ 7512 87               add  a, a              ; *8
1081+ 7513
1082+ 7513 5F               ld   e, a              ; ItemTop
1083+ 7514
1084+ 7514 C6 07            add  a, 7
1085+ 7516 57               ld   d, a              ; ItemBottom
1086+ 7517
1087+ 7517                  ; ---------------------------------------------------------------
1088+ 7517                  ; Primo test verticale:
1089+ 7517                  ;
1090+ 7517                  ; WillyTop <= ItemBottom
1091+ 7517                  ; ---------------------------------------------------------------
1092+ 7517 78               ld   a, b              ; WillyTop
1093+ 7518
1094+ 7518 BA               cp   d
1095+ 7519
1096+ 7519 28 04            jr   z, .y_ok
1097+ 751B 38 02            jr   c, .y_ok
1098+ 751D
1099+ 751D 18 0E            jr   .no_collision
1100+ 751F
1101+ 751F              .y_ok:
1102+ 751F
1103+ 751F                  ; ---------------------------------------------------------------
1104+ 751F                  ; Secondo test verticale:
1105+ 751F                  ;
1106+ 751F                  ; WillyBottom >= ItemTop
1107+ 751F                  ;
1108+ 751F                  ; WillyBottom = WillyY + 15
1109+ 751F                  ; ---------------------------------------------------------------
1110+ 751F C6 0F            add  a, 15
1111+ 7521
1112+ 7521 BB               cp   e
1113+ 7522
1114+ 7522 28 04            jr   z, .collision
1115+ 7524 30 02            jr   nc, .collision
1116+ 7526
1117+ 7526 18 05            jr   .no_collision
1118+ 7528
1119+ 7528              .collision:
1120+ 7528
1121+ 7528                  ; ---------------------------------------------------------------
1122+ 7528                  ; Collisione rilevata
1123+ 7528                  ; ---------------------------------------------------------------
1124+ 7528 E1               pop  hl
1125+ 7529 D1               pop  de
1126+ 752A C1               pop  bc
1127+ 752B
1128+ 752B 37               scf                    ; Carry = 1
1129+ 752C
1130+ 752C C9               ret
1131+ 752D
1132+ 752D              .no_collision:
1133+ 752D
1134+ 752D                  ; ---------------------------------------------------------------
1135+ 752D                  ; Nessuna collisione
1136+ 752D                  ; ---------------------------------------------------------------
1137+ 752D E1               pop  hl
1138+ 752E D1               pop  de
1139+ 752F C1               pop  bc
1140+ 7530
1141+ 7530 B7               or   a                 ; Carry = 0
1142+ 7531
1143+ 7531 C9               ret
1144+ 7532
1145+ 7532              ; -------------------------------------------------------------------
1146+ 7532              ; Items_CheckCollision
1147+ 7532              ;
1148+ 7532              ; Controlla se Willy entra in collisione con uno degli item
1149+ 7532              ; attivi presenti nella stanza corrente.
1150+ 7532              ;
1151+ 7532              ; Per ogni item:
1152+ 7532              ;   - verifica che appartenga alla stanza corrente
1153+ 7532              ;   - verifica che non sia già stato raccolto
1154+ 7532              ;   - esegue il test di collisione con Willy
1155+ 7532              ;
1156+ 7532              ; Se l'item viene raccolto:
1157+ 7532              ;   - imposta il flag "collected"
1158+ 7532              ;   - rimuove l'item dalla cache items_grid
1159+ 7532              ;   - incrementa il contatore degli oggetti raccolti
1160+ 7532              ;   - aggiorna l'HUD
1161+ 7532              ;   - ripristina il tile di sfondo
1162+ 7532              ;   - riproduce il suono di raccolta
1163+ 7532              ;
1164+ 7532              ; Formato record ItemsTable:
1165+ 7532              ;   +0 RoomID
1166+ 7532              ;   +1 X
1167+ 7532              ;   +2 Y
1168+ 7532              ;   +3 Color
1169+ 7532              ;   +4 Collected
1170+ 7532              ;
1171+ 7532              ; Fine tabella:
1172+ 7532              ;   RoomID = $FF
1173+ 7532              ; -------------------------------------------------------------------
1174+ 7532              Items_CheckCollision:
1175+ 7532
1176+ 7532                  ; Salva i registri utilizzati
1177+ 7532 E5               push hl
1178+ 7533 D5               push de
1179+ 7534 C5               push bc
1180+ 7535
1181+ 7535                  ; Inizio scansione della tabella degli item
1182+ 7535 21 E7 71         ld   hl, ItemsTable
1183+ 7538
1184+ 7538              .loop:
1185+ 7538
1186+ 7538                  ; ---------------------------------------------------------------
1187+ 7538                  ; Legge il Room ID dell'item corrente
1188+ 7538                  ; ---------------------------------------------------------------
1189+ 7538 7E               ld   a, (hl)
1190+ 7539
1191+ 7539                  ; $FF indica fine tabella
1192+ 7539 FE FF            cp   $FF
1193+ 753B 28 4D            jr   z, .done
1194+ 753D
1195+ 753D                  ; ---------------------------------------------------------------
1196+ 753D                  ; Verifica se l'item appartiene alla stanza corrente
1197+ 753D                  ; ---------------------------------------------------------------
1198+ 753D 57               ld   d, a              ; D = RoomID item
1199+ 753E
1200+ 753E 3A E3 79         ld   a, (current_room)
1201+ 7541 BA               cp   d
1202+ 7542
1203+ 7542                  ; Se appartiene a un'altra stanza salta il record
1204+ 7542 20 3F            jr   nz, .next_item
1205+ 7544
1206+ 7544                  ; ---------------------------------------------------------------
1207+ 7544                  ; Legge coordinate e stato dell'item
1208+ 7544                  ; ---------------------------------------------------------------
1209+ 7544
1210+ 7544 23               inc  hl
1211+ 7545 4E               ld   c, (hl)           ; C = X
1212+ 7546
1213+ 7546 23               inc  hl
1214+ 7547 46               ld   b, (hl)           ; B = Y
1215+ 7548
1216+ 7548 23               inc  hl                ; salta Color
1217+ 7549
1218+ 7549 23               inc  hl                ; punta a Collected
1219+ 754A
1220+ 754A 7E               ld   a, (hl)
1221+ 754B
1222+ 754B                  ; ---------------------------------------------------------------
1223+ 754B                  ; Item già raccolto?
1224+ 754B                  ; ---------------------------------------------------------------
1225+ 754B B7               or   a
1226+ 754C 20 39            jr   nz, .next_no_inc
1227+ 754E
1228+ 754E                  ; ---------------------------------------------------------------
1229+ 754E                  ; Test collisione Willy ↔ Item
1230+ 754E                  ;
1231+ 754E                  ; Input richiesto:
1232+ 754E                  ;   A = ItemX
1233+ 754E                  ;   H = ItemY
1234+ 754E                  ; ---------------------------------------------------------------
1235+ 754E 79               ld   a, c
1236+ 754F
1237+ 754F E5               push hl                ; salva puntatore al flag Collected
1238+ 7550
1239+ 7550 60               ld   h, b
1240+ 7551
1241+ 7551 CD EC 74         call CheckWillyItemCollision
1242+ 7554
1243+ 7554 E1               pop  hl
1244+ 7555
1245+ 7555                  ; Nessuna collisione
1246+ 7555 30 30            jr   nc, .next_no_inc
1247+ 7557
1248+ 7557                  ; ===============================================================
1249+ 7557                  ; ITEM RACCOLTO
1250+ 7557                  ; ===============================================================
1251+ 7557
1252+ 7557                  ; ---------------------------------------------------------------
1253+ 7557                  ; Marca l'item come raccolto
1254+ 7557                  ; ---------------------------------------------------------------
1255+ 7557 36 01            ld   (hl), 1
1256+ 7559
1257+ 7559                  ; ---------------------------------------------------------------
1258+ 7559                  ; Rimuove l'item dalla cache items_grid
1259+ 7559                  ;
1260+ 7559                  ; Calcolo:
1261+ 7559                  ;   offset = Row * 32 + Col
1262+ 7559                  ; ---------------------------------------------------------------
1263+ 7559 E5               push hl
1264+ 755A D5               push de
1265+ 755B
1266+ 755B 26 00            ld   h, 0
1267+ 755D 68               ld   l, b              ; HL = Row
1268+ 755E
1269+ 755E 29               add  hl, hl            ; *2
1270+ 755F 29               add  hl, hl            ; *4
1271+ 7560 29               add  hl, hl            ; *8
1272+ 7561 29               add  hl, hl            ; *16
1273+ 7562 29               add  hl, hl            ; *32
