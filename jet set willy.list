  72+ 8830 ~            ; Audio_UpdateMusic
  73+ 8830 ~            ;
  74+ 8830 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8830 ~            ; Viene chiamata a ogni frame.
  76+ 8830 ~            ; -------------------------------------------------------------------
  77+ 8830 ~            Audio_UpdateMusic:
  78+ 8830 ~                push af
  79+ 8830 ~                push bc
  80+ 8830 ~                push de
  81+ 8830 ~                push hl
  82+ 8830 ~
  83+ 8830 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8830 ~                ld   a, (Audio_jump_sound_note)
  85+ 8830 ~                cp   18
  86+ 8830 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8830 ~
  88+ 8830 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8830 ~                ld   a, (Audio_music_frame_counter)
  90+ 8830 ~                dec  a
  91+ 8830 ~                ld   (Audio_music_frame_counter), a
  92+ 8830 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8830 ~
  94+ 8830 ~                ; Altrimenti carica la nota successiva
  95+ 8830 ~                ld   a, (Audio_music_note_idx)
  96+ 8830 ~                inc  a
  97+ 8830 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8830 ~                jr   c, .no_wrap
  99+ 8830 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8830 ~            .no_wrap:
 101+ 8830 ~                ld   (Audio_music_note_idx), a
 102+ 8830 ~
 103+ 8830 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8830 ~                ld   e, a
 105+ 8830 ~                ld   d, 0
 106+ 8830 ~                ld   hl, Audio_MusicSheet
 107+ 8830 ~                add  hl, de
 108+ 8830 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8830 ~
 110+ 8830 ~                ; Leggi durata (secondo byte)
 111+ 8830 ~                inc  hl
 112+ 8830 ~                ld   a, (hl)
 113+ 8830 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8830 ~                jr   nz, .dur_ok
 115+ 8830 ~                ld   a, 1
 116+ 8830 ~            .dur_ok:
 117+ 8830 ~                ld   (Audio_music_frame_counter), a
 118+ 8830 ~
 119+ 8830 ~            .play_current_note:
 120+ 8830 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8830 ~                ld   a, (Audio_music_note_idx)
 122+ 8830 ~                ld   e, a
 123+ 8830 ~                ld   d, 0
 124+ 8830 ~                ld   hl, Audio_MusicSheet
 125+ 8830 ~                add  hl, de
 126+ 8830 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8830 ~                ld   a, (hl)                  ; A = delay
 128+ 8830 ~                or   a
 129+ 8830 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8830 ~
 131+ 8830 ~                ; Suona la nota: 2 cicli
 132+ 8830 ~                ld   d, a                     ; D = delay
 133+ 8830 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8830 ~            .note_loop:
 135+ 8830 ~                ; Speaker ON
 136+ 8830 ~                ld   a, (room_border_color)
 137+ 8830 ~                or   $10
 138+ 8830 ~                out  ($fe), a
 139+ 8830 ~                ld   c, d
 140+ 8830 ~            .d1:
 141+ 8830 ~                push af
 142+ 8830 ~                pop  af
 143+ 8830 ~                dec  c
 144+ 8830 ~                jr   nz, .d1
 145+ 8830 ~
 146+ 8830 ~                ; Speaker OFF
 147+ 8830 ~                ld   a, (room_border_color)
 148+ 8830 ~                and  $ef
 149+ 8830 ~                out  ($fe), a
 150+ 8830 ~                ld   c, d
 151+ 8830 ~            .d2:
 152+ 8830 ~                push af
 153+ 8830 ~                pop  af
 154+ 8830 ~                dec  c
 155+ 8830 ~                jr   nz, .d2
 156+ 8830 ~
 157+ 8830 ~                djnz .note_loop
 158+ 8830 ~
 159+ 8830 ~            .done:
 160+ 8830 ~                pop  hl
 161+ 8830 ~                pop  de
 162+ 8830 ~                pop  bc
 163+ 8830 ~                pop  af
 164+ 8830 ~                ret
 165+ 8830 ~
 166+ 8830 ~            Audio_MusicSheet:
 167+ 8830 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8830 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8830 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8830 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8830 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8830 ~                db 90, 10, 107, 20, 68, 65
 173+ 8830                  ELSE
 174+ 8830              Audio_UpdateMusic:
 175+ 8830 C9               ret
 176+ 8831                  ENDIF
