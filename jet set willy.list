1070+ 847A
1071+ 847A              .set_room:
1072+ 847A
1073+ 847A                  ; Salva l'ID della stanza corrente
1074+ 847A 32 A7 EF         ld   (current_room), a
1075+ 847D
1076+ 847D                  ; Ripristina i registri
1077+ 847D D1               pop  de
1078+ 847E E1               pop  hl
1079+ 847F
1080+ 847F C9               ret
1081+ 8480
1082+ 8480              ; -------------------------------------------------------------------
1083+ 8480              ; Items_DrawRoom
1084+ 8480              ;
1085+ 8480              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1086+ 8480              ;
1087+ 8480              ; Operazioni eseguite:
1088+ 8480              ;   1. Azzera la griglia items_grid.
1089+ 8480              ;   2. Svuota la cache degli oggetti attivi.
1090+ 8480              ;   3. Scansiona ItemsTable.
1091+ 8480              ;   4. Per ogni item della stanza corrente:
1092+ 8480              ;        - verifica se è già stato raccolto
1093+ 8480              ;        - disegna la grafica
1094+ 8480              ;        - aggiorna items_grid
1095+ 8480              ;        - memorizza l'item nella cache current_room_items
1096+ 8480              ;   5. Aggiorna num_room_items.
1097+ 8480              ;
1098+ 8480              ; Record ItemsTable:
1099+ 8480              ;   +0  Room ID
1100+ 8480              ;   +1  X (colonna)
1101+ 8480              ;   +2  Y (riga)
1102+ 8480              ;   +3  Colore
1103+ 8480              ;   +4  Collected flag
1104+ 8480              ;
1105+ 8480              ; Cache current_room_items:
1106+ 8480              ;   +0  Colonna
1107+ 8480              ;   +1  Riga
1108+ 8480              ;   +2  Colore
1109+ 8480              ;   +3  Collected flag ptr (Low)
1110+ 8480              ;   +4  Collected flag ptr (High)
1111+ 8480              ;
1112+ 8480              ; Ogni record cache occupa 5 byte.
1113+ 8480              ; -------------------------------------------------------------------
1114+ 8480              ; ResetItemsTable
1115+ 8480              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1116+ 8480              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1117+ 8480              ; -------------------------------------------------------------------
1118+ 8480              ResetItemsTable:
1119+ 8480 21 24 7F         ld   hl, ItemsTable
1120+ 8483              .reset_loop:
1121+ 8483 7E               ld   a, (hl)
1122+ 8484 FE FF            cp   $FF
1123+ 8486 C8               ret  z
1124+ 8487 23               inc  hl                        ; +1 (X)
1125+ 8488 23               inc  hl                        ; +2 (Y)
1126+ 8489 23               inc  hl                        ; +3 (Color)
1127+ 848A 23               inc  hl                        ; +4 (Collected flag)
1128+ 848B 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1129+ 848D 23               inc  hl                        ; Prossimo record
1130+ 848E 18 F3            jr   .reset_loop
1131+ 8490
1132+ 8490              ; -------------------------------------------------------------------
1133+ 8490              Items_DrawRoom:
1134+ 8490
1135+ 8490                  ; Salva tutti i registri utilizzati
1136+ 8490 E5               push hl
1137+ 8491 D5               push de
1138+ 8492 C5               push bc
1139+ 8493 DD E5            push ix
1140+ 8495 FD E5            push iy
1141+ 8497
1142+ 8497                  ; ---------------------------------------------------------------
1143+ 8497                  ; Azzera items_grid (32 x 16 = 512 byte)
1144+ 8497                  ; ---------------------------------------------------------------
1145+ 8497 21 81 EA         ld   hl, items_grid
1146+ 849A 11 82 EA         ld   de, items_grid + 1
1147+ 849D 36 00            ld   (hl), 0
1148+ 849F 01 FF 01         ld   bc, 511
1149+ 84A2 ED B0            ldir
1150+ 84A4
1151+ 84A4                  ; ---------------------------------------------------------------
1152+ 84A4                  ; Nessun item attivo nella stanza
1153+ 84A4                  ; ---------------------------------------------------------------
1154+ 84A4 AF               xor  a
1155+ 84A5 32 00 F0         ld   (num_room_items), a
1156+ 84A8
1157+ 84A8                  ; IY punta alla cache degli item attivi
1158+ 84A8 FD 21 B0 EF      ld   iy, current_room_items
1159+ 84AC
1160+ 84AC                  ; ---------------------------------------------------------------
1161+ 84AC                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1162+ 84AC                  ; alla stanza corrente.
1163+ 84AC                  ;
1164+ 84AC                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1165+ 84AC                  ; ---------------------------------------------------------------
1166+ 84AC 2A 01 F0         ld   hl, (room_ptr)
