 307+ 7580 FD E5            push iy                ; Preserva IY
 308+ 7582 C5               push bc
 309+ 7583 D5               push de
 310+ 7584 E5               push hl
 311+ 7585 DD E5            push ix
 312+ 7587
 313+ 7587 C5               push bc
 314+ 7588 FD E1            pop  iy                ; IY = original BC (IYH = Row, IYL = Col)
 315+ 758A
 316+ 758A                  ; Riga di layout: r = B - 3
 317+ 758A 78               ld   a, b
 318+ 758B D6 03            sub  3                 ; A = r (0..15)
 319+ 758D
 320+ 758D                  ; Colonna: c = C (Col)
 321+ 758D CD 6D 71         call GetCellFromUnpacked ; A = cell type (0..3)
