 845+ 6A31 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 846+ 6A32 47               ld   b, a              ; B = limit_left
 847+ 6A33
 848+ 6A33 3A 24 76         ld   a, (ramp_col)
 849+ 6A36 3C               inc  a
 850+ 6A37 4F               ld   c, a              ; C = limit_right (exclusive)
 851+ 6A38
 852+ 6A38 7B               ld   a, e              ; A = Col
 853+ 6A39 B8               cp   b
 854+ 6A3A 38 15            jr   c, .check_platform_case
 855+ 6A3C B9               cp   c
 856+ 6A3D 30 12            jr   nc, .check_platform_case
 857+ 6A3F
 858+ 6A3F                  ; Calcola B = ramp_col - Col
 859+ 6A3F 3A 24 76         ld   a, (ramp_col)
 860+ 6A42 93               sub  e
 861+ 6A43 47               ld   b, a              ; B = offset
 862+ 6A44
 863+ 6A44                  ; SlopeRow = ramp_row - B
 864+ 6A44 3A 23 76         ld   a, (ramp_row)
