 856+ 6AB7 B7               or   a
 857+ 6AB8 28 1A            jr   z, .range_left
 858+ 6ABA              .range_right:
 859+ 6ABA 3A 92 79         ld   a, (ramp_col)
 860+ 6ABD 47               ld   b, a              ; B = ramp_col
 861+ 6ABE 3A 90 79         ld   a, (ramp_len)
 862+ 6AC1 80               add  a, b              ; A = ramp_col + ramp_len
 863+ 6AC2 4F               ld   c, a              ; C = limit_right (exclusive)
 864+ 6AC3
 865+ 6AC3 7B               ld   a, e              ; A = Col
 866+ 6AC4 B8               cp   b
 867+ 6AC5 38 34            jr   c, .check_platform_case ; Col < ramp_col
 868+ 6AC7 B9               cp   c
 869+ 6AC8 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 870+ 6ACA
 871+ 6ACA                  ; Calcola B = Col - ramp_col
 872+ 6ACA 7B               ld   a, e
 873+ 6ACB 90               sub  b
 874+ 6ACC 47               ld   b, a              ; B = offset (0..ramp_len-1)
 875+ 6ACD
 876+ 6ACD                  ; SlopeRow = ramp_row - B
 877+ 6ACD 3A 91 79         ld   a, (ramp_row)
 878+ 6AD0 90               sub  b
 879+ 6AD1 47               ld   b, a              ; B = SlopeRow
 880+ 6AD2 18 1F            jr   .check_row_match
 881+ 6AD4
 882+ 6AD4              .range_left:
 883+ 6AD4                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 884+ 6AD4 21 90 79         ld   hl, ramp_len
 885+ 6AD7 3A 92 79         ld   a, (ramp_col)
 886+ 6ADA 96               sub  (hl)
 887+ 6ADB 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 888+ 6ADC 47               ld   b, a              ; B = limit_left
 889+ 6ADD
 890+ 6ADD 3A 92 79         ld   a, (ramp_col)
 891+ 6AE0 3C               inc  a
 892+ 6AE1 4F               ld   c, a              ; C = limit_right (exclusive)
 893+ 6AE2
 894+ 6AE2 7B               ld   a, e              ; A = Col
 895+ 6AE3 B8               cp   b
 896+ 6AE4 38 15            jr   c, .check_platform_case
 897+ 6AE6 B9               cp   c
 898+ 6AE7 30 12            jr   nc, .check_platform_case
 899+ 6AE9
 900+ 6AE9                  ; Calcola B = ramp_col - Col
 901+ 6AE9 3A 92 79         ld   a, (ramp_col)
 902+ 6AEC 93               sub  e
 903+ 6AED 47               ld   b, a              ; B = offset
 904+ 6AEE
 905+ 6AEE                  ; SlopeRow = ramp_row - B
 906+ 6AEE 3A 91 79         ld   a, (ramp_row)
 907+ 6AF1 90               sub  b
 908+ 6AF2 47               ld   b, a              ; B = SlopeRow
