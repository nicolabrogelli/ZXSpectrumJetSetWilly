  17+ 79EC              ; Tabella dei colori, se aggiungiamo $C davanti al colore questo diventa lampeggiante
  18+ 79EC              ; 1 - BLUE
  19+ 79EC              ; 2 - RED
  20+ 79EC              ; 3 - MAGENTA
  21+ 79EC              ; 4 - GREEN
  22+ 79EC              ; 5 - CYAN
  23+ 79EC              ; 6 - YELLOW
  24+ 79EC              ; 7 - WHITE
