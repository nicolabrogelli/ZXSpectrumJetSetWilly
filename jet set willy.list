   7+ 8801              ; -------------------------------------------------------------------
   8+ 8801              ; Audio_UpdateJumpSound
   9+ 8801              ;
  10+ 8801              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8801              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8801              ; -------------------------------------------------------------------
  13+ 8801              Audio_UpdateJumpSound:
  14+ 8801 F5               push af
  15+ 8802 C5               push bc
  16+ 8803 D5               push de
  17+ 8804 E5               push hl
  18+ 8805
  19+ 8805                  ; Controlla se il suono è attivo (note < 18)
  20+ 8805 3A F5 F8         ld   a, (Audio_jump_sound_note)
  21+ 8808 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 880A 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 880C
  24+ 880C                  ; Carica la nota corrente da suonare
  25+ 880C 5F               ld   e, a
  26+ 880D 16 00            ld   d, 0
  27+ 880F 21 3B 88         ld   hl, Audio_JumpSoundDelays
  28+ 8812 19               add  hl, de
  29+ 8813 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8814 57               ld   d, a                      ; D = delay della nota
  31+ 8815
  32+ 8815                  ; Suona la nota: 15 cicli
  33+ 8815 06 0F            ld   b, 15
  34+ 8817              .note_loop:
  35+ 8817                  ; Speaker ON
  36+ 8817 3A EE F4         ld   a, (room_border_color)
  37+ 881A F6 10            or   $10
  38+ 881C D3 FE            out  ($fe), a
  39+ 881E 4A               ld   c, d
  40+ 881F              .d1:
  41+ 881F 0D               dec  c
  42+ 8820 20 FD            jr   nz, .d1
  43+ 8822
  44+ 8822                  ; Speaker OFF
  45+ 8822 3A EE F4         ld   a, (room_border_color)
  46+ 8825 E6 EF            and  $ef
  47+ 8827 D3 FE            out  ($fe), a
  48+ 8829 4A               ld   c, d
  49+ 882A              .d2:
  50+ 882A 0D               dec  c
  51+ 882B 20 FD            jr   nz, .d2
  52+ 882D
  53+ 882D 10 E8            djnz .note_loop
  54+ 882F
  55+ 882F                  ; Passa alla nota successiva
  56+ 882F 3A F5 F8         ld   a, (Audio_jump_sound_note)
  57+ 8832 3C               inc  a
  58+ 8833 32 F5 F8         ld   (Audio_jump_sound_note), a
  59+ 8836
  60+ 8836              .done:
  61+ 8836 E1               pop  hl
  62+ 8837 D1               pop  de
  63+ 8838 C1               pop  bc
  64+ 8839 F1               pop  af
  65+ 883A C9               ret
  66+ 883B
  67+ 883B              Audio_JumpSoundDelays:
  68+ 883B 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 883F 19 13 0C 06
  68+ 8843 0C 13 19 20
  68+ 8847 26 2D 33 3A
  68+ 884B 40 47
  69+ 884D
