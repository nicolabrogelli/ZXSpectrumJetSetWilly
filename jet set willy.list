 726  8DA6              ; -------------------------------------------------------------------
 727  8DA6              ; CheckAllItemsCollected
 728  8DA6              ; Verifica che tutti gli item del gioco siano stati raccolti.
 729  8DA6              ; - Controllo preliminare sul conteggio/flag globale
 730  8DA6              ; - Verifica puntuale che ogni record in ItemsTable abbia flag = 1 (raccolto)
 731  8DA6              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 732  8DA6              ; -------------------------------------------------------------------
 733  8DA6              CheckAllItemsCollected:
 734  8DA6 E5               push hl
 735  8DA7 3A 56 FC         ld   a, (game_objective_completed)
 736  8DAA B7               or   a
 737  8DAB 20 07            jr   nz, .verify_flags
 738  8DAD 3A 4E F8         ld   a, (items_collected)
 739  8DB0 FE 4D            cp   TOTAL_ITEMS
 740  8DB2 38 16            jr   c, .not_all
 741  8DB4
 742  8DB4              .verify_flags:
 743  8DB4 21 FD 80         ld   hl, ItemsTable
