1172+ 7410
1173+ 7410                  ; $FF indica fine tabella
1174+ 7410 FE FF            cp   $FF
1175+ 7412 28 4D            jr   z, .done
1176+ 7414
1177+ 7414                  ; ---------------------------------------------------------------
1178+ 7414                  ; Verifica se l'item appartiene alla stanza corrente
1179+ 7414                  ; ---------------------------------------------------------------
1180+ 7414 57               ld   d, a              ; D = RoomID item
1181+ 7415
1182+ 7415 3A BA 78         ld   a, (current_room)
1183+ 7418 BA               cp   d
1184+ 7419
1185+ 7419                  ; Se appartiene a un'altra stanza salta il record
1186+ 7419 20 3F            jr   nz, .next_item
1187+ 741B
1188+ 741B                  ; ---------------------------------------------------------------
1189+ 741B                  ; Legge coordinate e stato dell'item
1190+ 741B                  ; ---------------------------------------------------------------
1191+ 741B
1192+ 741B 23               inc  hl
1193+ 741C 4E               ld   c, (hl)           ; C = X
1194+ 741D
1195+ 741D 23               inc  hl
1196+ 741E 46               ld   b, (hl)           ; B = Y
1197+ 741F
1198+ 741F 23               inc  hl                ; salta Color
1199+ 7420
1200+ 7420 23               inc  hl                ; punta a Collected
1201+ 7421
1202+ 7421 7E               ld   a, (hl)
1203+ 7422
1204+ 7422                  ; ---------------------------------------------------------------
1205+ 7422                  ; Item già raccolto?
1206+ 7422                  ; ---------------------------------------------------------------
1207+ 7422 B7               or   a
1208+ 7423 20 39            jr   nz, .next_no_inc
1209+ 7425
1210+ 7425                  ; ---------------------------------------------------------------
1211+ 7425                  ; Test collisione Willy ↔ Item
1212+ 7425                  ;
1213+ 7425                  ; Input richiesto:
1214+ 7425                  ;   A = ItemX
1215+ 7425                  ;   H = ItemY
1216+ 7425                  ; ---------------------------------------------------------------
1217+ 7425 79               ld   a, c
1218+ 7426
1219+ 7426 E5               push hl                ; salva puntatore al flag Collected
1220+ 7427
1221+ 7427 60               ld   h, b
1222+ 7428
1223+ 7428 CD C3 73         call CheckWillyItemCollision
1224+ 742B
1225+ 742B E1               pop  hl
1226+ 742C
1227+ 742C                  ; Nessuna collisione
1228+ 742C 30 30            jr   nc, .next_no_inc
