 870+ 789D E5               push hl
 871+ 789E
 872+ 789E DD E5            push ix
 873+ 78A0 E1               pop  hl
 874+ 78A1
 875+ 78A1 CD E6 78         call DrawItemGraphic
 876+ 78A4
 877+ 78A4 E1               pop  hl                ; ritorna al flag collected
 878+ 78A5
 879+ 78A5                  ; ---------------------------------------------------------------
 880+ 78A5                  ; Aggiorna items_grid
 881+ 78A5                  ;
 882+ 78A5                  ; Calcolo:
 883+ 78A5                  ;   offset = Row * 32 + Col
 884+ 78A5                  ; ---------------------------------------------------------------
