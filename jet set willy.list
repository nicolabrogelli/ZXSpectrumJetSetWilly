  72+ 6C15              ; Mappatura:
  73+ 6C15              ;   0 = The Off Licence
  74+ 6C15              ;   1 = The Bridge
  75+ 6C15              ;   2 = Under The Mega Tree
  76+ 6C15              ;   4 = At The Foot Of The Mega Tree
  77+ 6C15              ;   5 = The Drive
  78+ 6C15              ;   6 = Entrance To Hades
  79+ 6C15              ;   33 = The Bathroom
  80+ 6C15              ;   35 = Master Bedroom
  81+ 6C15              ;
  82+ 6C15              ; Se nessuna stanza corrisponde viene impostato:
  83+ 6C15              ;   current_room = 0
  84+ 6C15              ; -------------------------------------------------------------------
