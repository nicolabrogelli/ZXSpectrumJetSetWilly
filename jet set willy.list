  71+ 7432              ; Audio_UpdateMusic
  72+ 7432              ;
  73+ 7432              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 7432              ; Viene chiamata a ogni frame.
  75+ 7432              ; -------------------------------------------------------------------
  76+ 7432              Audio_UpdateMusic:
  77+ 7432 F5               push af
  78+ 7433 C5               push bc
  79+ 7434 D5               push de
  80+ 7435 E5               push hl
  81+ 7436
  82+ 7436                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 7436 3A 7A 78         ld   a, (Audio_jump_sound_note)
  84+ 7439 FE 12            cp   18
  85+ 743B 38 5A            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 743D
  87+ 743D                  ; Decrementa il contatore dei frame della nota corrente
  88+ 743D 3A 7D 78         ld   a, (Audio_music_frame_counter)
  89+ 7440 3D               dec  a
  90+ 7441 32 7D 78         ld   (Audio_music_frame_counter), a
  91+ 7444 20 23            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 7446
  93+ 7446                  ; Altrimenti carica la nota successiva
  94+ 7446 3A 7C 78         ld   a, (Audio_music_note_idx)
  95+ 7449 3C               inc  a
  96+ 744A FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 744C 38 01            jr   c, .no_wrap
  98+ 744E AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 744F              .no_wrap:
 100+ 744F 32 7C 78         ld   (Audio_music_note_idx), a
 101+ 7452
 102+ 7452                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 7452 5F               ld   e, a
 104+ 7453 16 00            ld   d, 0
 105+ 7455 21 9C 74         ld   hl, Audio_MusicSheet
 106+ 7458 19               add  hl, de
 107+ 7459 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 745A
 109+ 745A                  ; Leggi durata (secondo byte)
 110+ 745A 23               inc  hl
 111+ 745B 7E               ld   a, (hl)
 112+ 745C CB 3F            srl  a                        ; Divide per 8 (velocizza 8x)
 113+ 745E CB 3F            srl  a
 114+ 7460 CB 3F            srl  a
 115+ 7462 20 02            jr   nz, .dur_ok
 116+ 7464 3E 01            ld   a, 1
