  10+ 6F2D              ;   Byte 2: Y riga dello schermo (3..18)
  11+ 6F2D              ;   Byte 3: Attributo colore (es. $C6 per Giallo Flashing, $C5 per Cyan Flashing)
  12+ 6F2D              ;   Byte 4: Stato (0 = Attivo/Non raccolto, 1 = Raccolto)
  13+ 6F2D              ; La tabella termina con $FF
  14+ 6F2D              ;
  15+ 6F2D              ; La tabella riposrta solamente le stanza in cui effettivamente ci sono degli oggetti le altre sono omesse
  16+ 6F2D              ;
  17+ 6F2D              ; Tabella dei colori, se aggiungiamo $C davanti al colore questo diventa lampeggiante
  18+ 6F2D              ; 1 - BLUE
  19+ 6F2D              ; 2 - RED
  20+ 6F2D              ; 3 - MAGENTA
  21+ 6F2D              ; 4 - GREEN
  22+ 6F2D              ; 5 - CYAN
  23+ 6F2D              ; 6 - YELLOW
  24+ 6F2D              ; 7 - WHITE
