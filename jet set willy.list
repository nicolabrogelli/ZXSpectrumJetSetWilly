 797+ 6131                  ; 4. HL = r * 8 + c / 4
 798+ 6131 78               ld   a, b              ; A = Col
 799+ 6132 CB 3F            srl  a
 800+ 6134 CB 3F            srl  a                 ; A = c / 4
 801+ 6136 85               add  a, l
 802+ 6137 6F               ld   l, a              ; HL = r * 8 + c / 4
 803+ 6138
 804+ 6138 ED 5B 82 79      ld   de, (room_ptr)
