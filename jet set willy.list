 277+ 6BC4              ; Verifica la collisione tra player e nemico (bounding box a livello di pixel)
 278+ 6BC4              ; Output: Carry flag impostato se collisione, altrimenti resettato
 279+ 6BC4              ; -------------------------------------------------------------------
 280+ 6BC4              CheckCollision:
 281+ 6BC4 E5               push hl
 282+ 6BC5 D5               push de
 283+ 6BC6 C5               push bc
 284+ 6BC7 DD E5            push ix
 285+ 6BC9
 286+ 6BC9 DD 21 9C 6C      ld   ix, ActiveEnemies
 287+ 6BCD 06 04            ld   b, 4              ; 4 slot
 288+ 6BCF              .loop:
 289+ 6BCF DD 7E 00         ld   a, (ix+0)         ; Flags
 290+ 6BD2 E6 80            and  $80               ; Active?
 291+ 6BD4 28 1F            jr   z, .next
 292+ 6BD6
 293+ 6BD6                  ; 1. Controllo orizzontale: PlayerX - EnemyX + 7 in [0, 22]
 294+ 6BD6 3A 52 6F         ld   a, (PlayerPos)    ; A = PlayerX
 295+ 6BD9 DD 96 01         sub  (ix+1)            ; A = PlayerX - EnemyX
 296+ 6BDC C6 07            add  a, 7              ; A = PlayerX - EnemyX + 7
 297+ 6BDE FE 17            cp   23                ; Se >= 23, nessuna collisione con questo
 298+ 6BE0 30 13            jr   nc, .next
 299+ 6BE2
 300+ 6BE2                  ; 2. Controllo verticale: PlayerY - EnemyY + 15 in [0, 30]
 301+ 6BE2 3A 53 6F         ld   a, (PlayerPos+1)  ; A = PlayerY
 302+ 6BE5 DD 96 02         sub  (ix+2)            ; A = PlayerY - EnemyY
 303+ 6BE8 C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 304+ 6BEA FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 305+ 6BEC 30 07            jr   nc, .next
 306+ 6BEE
 307+ 6BEE                  ; Collisione avvenuta!
 308+ 6BEE DD E1            pop  ix
 309+ 6BF0 C1               pop  bc
 310+ 6BF1 D1               pop  de
 311+ 6BF2 E1               pop  hl
 312+ 6BF3 37               scf                    ; Imposta carry flag
 313+ 6BF4 C9               ret
 314+ 6BF5
 315+ 6BF5              .next:
 316+ 6BF5 11 08 00         ld   de, 8
 317+ 6BF8 DD 19            add  ix, de            ; Prossimo slot
 318+ 6BFA 05               dec  b
 319+ 6BFB 20 D2            jr   nz, .loop
