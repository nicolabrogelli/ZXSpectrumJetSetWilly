  19+ 6880 CB 4A            bit  $01, d            ; Tasto Destra premuto?
  20+ 6882 20 11            jr   nz, movePlayer_right
  21+ 6884
  22+ 6884 CB 42            bit  $00, d            ; Tasto Sinistra premuto?
  23+ 6886 C8               ret  z
  24+ 6887
  25+ 6887              movePlayer_left:
  26+ 6887 79               ld   a, c
  27+ 6888 D6 02            sub  2                 ; Prova a muoverti di 2 pixel a sinistra
  28+ 688A FE 08            cp   PLAYER_MIN_X      ; Confronta con il limite sinistro
  29+ 688C 38 03            jr   c, .clamp_left    ; Se < PLAYER_MIN_X, clampa
  30+ 688E 4F               ld   c, a              ; Altrimenti memorizza la nuova posizione
  31+ 688F 18 12            jr   save_x
  32+ 6891
  33+ 6891              .clamp_left:
