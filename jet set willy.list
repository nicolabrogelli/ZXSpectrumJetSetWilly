 915+ 6AF3 3C               inc  a                 ; A = ramp_row - ramp_len + 1
 916+ 6AF4 BA               cp   d                 ; Compare with Row
 917+ 6AF5 28 04            jr   z, .yes
 918+ 6AF7
 919+ 6AF7              .no:
 920+ 6AF7 E1               pop  hl
 921+ 6AF8 C1               pop  bc
 922+ 6AF9 B7               or   a
 923+ 6AFA C9               ret
