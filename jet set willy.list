  72+ 7CD8 ~            ; Audio_UpdateMusic
  73+ 7CD8 ~            ;
  74+ 7CD8 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 7CD8 ~            ; Viene chiamata a ogni frame.
  76+ 7CD8 ~            ; -------------------------------------------------------------------
  77+ 7CD8 ~            Audio_UpdateMusic:
  78+ 7CD8 ~                push af
  79+ 7CD8 ~                push bc
  80+ 7CD8 ~                push de
  81+ 7CD8 ~                push hl
  82+ 7CD8 ~
  83+ 7CD8 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 7CD8 ~                ld   a, (Audio_jump_sound_note)
  85+ 7CD8 ~                cp   18
  86+ 7CD8 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 7CD8 ~
  88+ 7CD8 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 7CD8 ~                ld   a, (Audio_music_frame_counter)
  90+ 7CD8 ~                dec  a
  91+ 7CD8 ~                ld   (Audio_music_frame_counter), a
  92+ 7CD8 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 7CD8 ~
  94+ 7CD8 ~                ; Altrimenti carica la nota successiva
  95+ 7CD8 ~                ld   a, (Audio_music_note_idx)
  96+ 7CD8 ~                inc  a
  97+ 7CD8 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 7CD8 ~                jr   c, .no_wrap
  99+ 7CD8 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 7CD8 ~            .no_wrap:
 101+ 7CD8 ~                ld   (Audio_music_note_idx), a
 102+ 7CD8 ~
 103+ 7CD8 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 7CD8 ~                ld   e, a
 105+ 7CD8 ~                ld   d, 0
 106+ 7CD8 ~                ld   hl, Audio_MusicSheet
 107+ 7CD8 ~                add  hl, de
 108+ 7CD8 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 7CD8 ~
 110+ 7CD8 ~                ; Leggi durata (secondo byte)
 111+ 7CD8 ~                inc  hl
 112+ 7CD8 ~                ld   a, (hl)
 113+ 7CD8 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 7CD8 ~                jr   nz, .dur_ok
 115+ 7CD8 ~                ld   a, 1
 116+ 7CD8 ~            .dur_ok:
 117+ 7CD8 ~                ld   (Audio_music_frame_counter), a
 118+ 7CD8 ~
 119+ 7CD8 ~            .play_current_note:
 120+ 7CD8 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 7CD8 ~                ld   a, (Audio_music_note_idx)
 122+ 7CD8 ~                ld   e, a
 123+ 7CD8 ~                ld   d, 0
 124+ 7CD8 ~                ld   hl, Audio_MusicSheet
 125+ 7CD8 ~                add  hl, de
 126+ 7CD8 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 7CD8 ~                ld   a, (hl)                  ; A = delay
 128+ 7CD8 ~                or   a
 129+ 7CD8 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 7CD8 ~
 131+ 7CD8 ~                ; Suona la nota: 2 cicli
 132+ 7CD8 ~                ld   d, a                     ; D = delay
 133+ 7CD8 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 7CD8 ~            .note_loop:
 135+ 7CD8 ~                ; Speaker ON
 136+ 7CD8 ~                ld   a, (room_border_color)
 137+ 7CD8 ~                or   $10
 138+ 7CD8 ~                out  ($fe), a
 139+ 7CD8 ~                ld   c, d
 140+ 7CD8 ~            .d1:
 141+ 7CD8 ~                push af
 142+ 7CD8 ~                pop  af
 143+ 7CD8 ~                dec  c
 144+ 7CD8 ~                jr   nz, .d1
 145+ 7CD8 ~
 146+ 7CD8 ~                ; Speaker OFF
 147+ 7CD8 ~                ld   a, (room_border_color)
 148+ 7CD8 ~                and  $ef
 149+ 7CD8 ~                out  ($fe), a
 150+ 7CD8 ~                ld   c, d
 151+ 7CD8 ~            .d2:
 152+ 7CD8 ~                push af
 153+ 7CD8 ~                pop  af
 154+ 7CD8 ~                dec  c
 155+ 7CD8 ~                jr   nz, .d2
 156+ 7CD8 ~
 157+ 7CD8 ~                djnz .note_loop
 158+ 7CD8 ~
 159+ 7CD8 ~            .done:
 160+ 7CD8 ~                pop  hl
 161+ 7CD8 ~                pop  de
 162+ 7CD8 ~                pop  bc
 163+ 7CD8 ~                pop  af
 164+ 7CD8 ~                ret
 165+ 7CD8 ~
 166+ 7CD8 ~            Audio_MusicSheet:
 167+ 7CD8 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 7CD8 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 7CD8 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 7CD8 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 7CD8 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 7CD8 ~                db 90, 10, 107, 20, 68, 65
 173+ 7CD8                  ELSE
 174+ 7CD8              Audio_UpdateMusic:
 175+ 7CD8 C9               ret
 176+ 7CD9                  ENDIF
