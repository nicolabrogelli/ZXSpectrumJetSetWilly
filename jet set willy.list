1080+ 836E              ; Items_DrawRoom
1081+ 836E              ;
1082+ 836E              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1083+ 836E              ;
1084+ 836E              ; Operazioni eseguite:
1085+ 836E              ;   1. Azzera la griglia items_grid.
1086+ 836E              ;   2. Svuota la cache degli oggetti attivi.
1087+ 836E              ;   3. Scansiona ItemsTable.
1088+ 836E              ;   4. Per ogni item della stanza corrente:
1089+ 836E              ;        - verifica se è già stato raccolto
1090+ 836E              ;        - disegna la grafica
1091+ 836E              ;        - aggiorna items_grid
1092+ 836E              ;        - memorizza l'item nella cache current_room_items
1093+ 836E              ;   5. Aggiorna num_room_items.
1094+ 836E              ;
1095+ 836E              ; Record ItemsTable:
1096+ 836E              ;   +0  Room ID
1097+ 836E              ;   +1  X (colonna)
1098+ 836E              ;   +2  Y (riga)
1099+ 836E              ;   +3  Colore
1100+ 836E              ;   +4  Collected flag
1101+ 836E              ;
1102+ 836E              ; Cache current_room_items:
1103+ 836E              ;   +0  Colonna
1104+ 836E              ;   +1  Riga
1105+ 836E              ;   +2  Colore
1106+ 836E              ;   +3  Collected flag ptr (Low)
1107+ 836E              ;   +4  Collected flag ptr (High)
1108+ 836E              ;
1109+ 836E              ; Ogni record cache occupa 5 byte.
1110+ 836E              ; -------------------------------------------------------------------
1111+ 836E              ; ResetItemsTable
1112+ 836E              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1113+ 836E              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1114+ 836E              ; -------------------------------------------------------------------
1115+ 836E              ResetItemsTable:
1116+ 836E 21 17 7E         ld   hl, ItemsTable
1117+ 8371              .reset_loop:
1118+ 8371 7E               ld   a, (hl)
1119+ 8372 FE FF            cp   $FF
1120+ 8374 C8               ret  z
1121+ 8375 23               inc  hl                        ; +1 (X)
1122+ 8376 23               inc  hl                        ; +2 (Y)
1123+ 8377 23               inc  hl                        ; +3 (Color)
1124+ 8378 23               inc  hl                        ; +4 (Collected flag)
1125+ 8379 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1126+ 837B 23               inc  hl                        ; Prossimo record
1127+ 837C 18 F3            jr   .reset_loop
1128+ 837E
1129+ 837E              ; -------------------------------------------------------------------
1130+ 837E              Items_DrawRoom:
1131+ 837E
1132+ 837E                  ; Salva tutti i registri utilizzati
1133+ 837E E5               push hl
1134+ 837F D5               push de
1135+ 8380 C5               push bc
1136+ 8381 DD E5            push ix
1137+ 8383 FD E5            push iy
1138+ 8385
1139+ 8385                  ; ---------------------------------------------------------------
1140+ 8385                  ; Azzera items_grid (32 x 16 = 512 byte)
1141+ 8385                  ; ---------------------------------------------------------------
1142+ 8385 21 7F E8         ld   hl, items_grid
1143+ 8388 11 80 E8         ld   de, items_grid + 1
1144+ 838B 36 00            ld   (hl), 0
1145+ 838D 01 FF 01         ld   bc, 511
1146+ 8390 ED B0            ldir
1147+ 8392
1148+ 8392                  ; ---------------------------------------------------------------
1149+ 8392                  ; Nessun item attivo nella stanza
1150+ 8392                  ; ---------------------------------------------------------------
1151+ 8392 AF               xor  a
1152+ 8393 32 FE ED         ld   (num_room_items), a
1153+ 8396
1154+ 8396                  ; IY punta alla cache degli item attivi
1155+ 8396 FD 21 AE ED      ld   iy, current_room_items
1156+ 839A
1157+ 839A                  ; ---------------------------------------------------------------
1158+ 839A                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1159+ 839A                  ; alla stanza corrente.
1160+ 839A                  ;
1161+ 839A                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1162+ 839A                  ; ---------------------------------------------------------------
1163+ 839A 2A FF ED         ld   hl, (room_ptr)
1164+ 839D 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1165+ 83A0 19               add  hl, de
1166+ 83A1
1167+ 83A1 E5               push hl
1168+ 83A2 DD E1            pop  ix                ; IX = bitmap item
1169+ 83A4
1170+ 83A4                  ; ---------------------------------------------------------------
1171+ 83A4                  ; Inizio scansione della tabella degli item
1172+ 83A4                  ; ---------------------------------------------------------------
1173+ 83A4 21 17 7E         ld   hl, ItemsTable
1174+ 83A7
1175+ 83A7              .loop:
1176+ 83A7
1177+ 83A7                  ; ---------------------------------------------------------------
1178+ 83A7                  ; Legge il Room ID del record corrente
1179+ 83A7                  ; ---------------------------------------------------------------
1180+ 83A7 7E               ld   a, (hl)
1181+ 83A8
1182+ 83A8                  ; $FF indica fine tabella
1183+ 83A8 FE FF            cp   $FF
1184+ 83AA 28 53            jr   z, .done
1185+ 83AC
1186+ 83AC                  ; ---------------------------------------------------------------
1187+ 83AC                  ; Verifica se l'item appartiene alla stanza corrente
1188+ 83AC                  ; ---------------------------------------------------------------
1189+ 83AC 57               ld   d, a
1190+ 83AD
1191+ 83AD 3A A5 ED         ld   a, (current_room)
1192+ 83B0 BA               cp   d
1193+ 83B1 20 45            jr   nz, .next_item
1194+ 83B3
1195+ 83B3                  ; ---------------------------------------------------------------
1196+ 83B3                  ; Legge i dati dell'item
1197+ 83B3                  ; ---------------------------------------------------------------
1198+ 83B3
1199+ 83B3 23               inc  hl
1200+ 83B4 4E               ld   c, (hl)           ; X (colonna)
1201+ 83B5
1202+ 83B5 23               inc  hl
1203+ 83B6 46               ld   b, (hl)           ; Y (riga)
1204+ 83B7
1205+ 83B7 23               inc  hl
1206+ 83B8 5E               ld   e, (hl)           ; Colore
1207+ 83B9
1208+ 83B9 23               inc  hl
1209+ 83BA 7E               ld   a, (hl)           ; Collected flag
1210+ 83BB
1211+ 83BB                  ; Se diverso da zero l'item è già stato raccolto
1212+ 83BB B7               or   a
1213+ 83BC 20 3E            jr   nz, .next_no_inc
1214+ 83BE
1215+ 83BE                  ; ---------------------------------------------------------------
1216+ 83BE                  ; Disegna l'item sullo schermo
1217+ 83BE                  ;
1218+ 83BE                  ; B = Row
1219+ 83BE                  ; C = Column
1220+ 83BE                  ; HL = bitmap pointer
1221+ 83BE                  ; E = Color
1222+ 83BE                  ; ---------------------------------------------------------------
1223+ 83BE E5               push hl
1224+ 83BF
1225+ 83BF DD E5            push ix
1226+ 83C1 E1               pop  hl
1227+ 83C2
1228+ 83C2 CD 07 84         call DrawItemGraphic
1229+ 83C5
1230+ 83C5 E1               pop  hl                ; ritorna al flag collected
1231+ 83C6
1232+ 83C6                  ; ---------------------------------------------------------------
1233+ 83C6                  ; Aggiorna items_grid
1234+ 83C6                  ;
1235+ 83C6                  ; Calcolo:
1236+ 83C6                  ;   offset = Row * 32 + Col
1237+ 83C6                  ; ---------------------------------------------------------------
1238+ 83C6 E5               push hl
1239+ 83C7 D5               push de
1240+ 83C8
1241+ 83C8 26 00            ld   h, 0
1242+ 83CA 68               ld   l, b              ; HL = Row
1243+ 83CB
1244+ 83CB 29               add  hl, hl            ; *2
1245+ 83CC 29               add  hl, hl            ; *4
1246+ 83CD 29               add  hl, hl            ; *8
1247+ 83CE 29               add  hl, hl            ; *16
1248+ 83CF 29               add  hl, hl            ; *32
1249+ 83D0
1250+ 83D0 16 00            ld   d, 0
1251+ 83D2 59               ld   e, c              ; DE = Col
1252+ 83D3
1253+ 83D3 19               add  hl, de            ; Row*32 + Col
1254+ 83D4
1255+ 83D4 11 7F E8         ld   de, items_grid
1256+ 83D7 19               add  hl, de            ; puntatore nella griglia
1257+ 83D8
1258+ 83D8 D1               pop  de                ; ripristina colore
1259+ 83D9
1260+ 83D9 73               ld   (hl), e           ; salva colore cella
1261+ 83DA
1262+ 83DA E1               pop  hl
1263+ 83DB
1264+ 83DB                  ; ---------------------------------------------------------------
1265+ 83DB                  ; Salva l'item nella cache della stanza
1266+ 83DB                  ;
1267+ 83DB                  ; Questo evita di dover scansionare tutta ItemsTable
1268+ 83DB                  ; durante il controllo delle collisioni.
1269+ 83DB                  ; ---------------------------------------------------------------
1270+ 83DB
1271+ 83DB FD 71 00         ld   (iy+0), c         ; Colonna
1272+ 83DE FD 70 01         ld   (iy+1), b         ; Riga
1273+ 83E1 FD 73 02         ld   (iy+2), e         ; Colore
1274+ 83E4
1275+ 83E4                  ; Salva il puntatore al flag "collected"
1276+ 83E4 FD 75 03         ld   (iy+3), l         ; Low byte
1277+ 83E7 FD 74 04         ld   (iy+4), h         ; High byte
1278+ 83EA
1279+ 83EA                  ; Passa al record successivo della cache
1280+ 83EA 01 05 00         ld   bc, 5
1281+ 83ED FD 09            add  iy, bc
1282+ 83EF
1283+ 83EF                  ; Incrementa il numero di item attivi
1284+ 83EF 3A FE ED         ld   a, (num_room_items)
1285+ 83F2 3C               inc  a
1286+ 83F3 32 FE ED         ld   (num_room_items), a
1287+ 83F6
1288+ 83F6 18 04            jr   .next_no_inc
1289+ 83F8
1290+ 83F8              .next_item:
1291+ 83F8
1292+ 83F8                  ; ---------------------------------------------------------------
1293+ 83F8                  ; L'item non appartiene alla stanza corrente.
1294+ 83F8                  ; Salta i campi del record:
1295+ 83F8                  ;   X
1296+ 83F8                  ;   Y
1297+ 83F8                  ;   Color
1298+ 83F8                  ;   Collected
1299+ 83F8                  ; ---------------------------------------------------------------
1300+ 83F8 23               inc  hl
1301+ 83F9 23               inc  hl
1302+ 83FA 23               inc  hl
1303+ 83FB 23               inc  hl
1304+ 83FC
1305+ 83FC              .next_no_inc:
1306+ 83FC
1307+ 83FC                  ; ---------------------------------------------------------------
1308+ 83FC                  ; Avanza al record successivo
1309+ 83FC                  ; (prossimo Room ID)
1310+ 83FC                  ; ---------------------------------------------------------------
1311+ 83FC 23               inc  hl
1312+ 83FD 18 A8            jr   .loop
1313+ 83FF
1314+ 83FF              .done:
1315+ 83FF
1316+ 83FF                  ; Ripristina i registri
1317+ 83FF FD E1            pop  iy
1318+ 8401 DD E1            pop  ix
1319+ 8403 D1               pop  de
1320+ 8404 C1               pop  bc
1321+ 8405 E1               pop  hl
1322+ 8406
1323+ 8406 C9               ret
1324+ 8407
1325+ 8407              ; -------------------------------------------------------------------
1326+ 8407              ; DrawItemGraphic
1327+ 8407              ;
1328+ 8407              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1329+ 8407              ; utilizzando una bitmap di 8 byte e un attributo colore.
1330+ 8407              ;
1331+ 8407              ; Input:
1332+ 8407              ;   B = Riga attributi (3..18)
1333+ 8407              ;   C = Colonna attributi (0..31)
1334+ 8407              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1335+ 8407              ;   E = Attributo colore
1336+ 8407              ;
1337+ 8407              ; Output:
1338+ 8407              ;   Nessuno
1339+ 8407              ;
1340+ 8407              ; Registri preservati:
1341+ 8407              ;   BC, DE, HL
1342+ 8407              ; -------------------------------------------------------------------
1343+ 8407              DrawItemGraphic:
1344+ 8407
1345+ 8407                  ; Salva i registri originali
1346+ 8407 C5               push bc
1347+ 8408 D5               push de
1348+ 8409 E5               push hl
1349+ 840A
1350+ 840A                  ; ---------------------------------------------------------------
1351+ 840A                  ; Calcolo indirizzo bitmap dello Spectrum
1352+ 840A                  ;
1353+ 840A                  ; Ogni item occupa una cella attributi (8x8 pixel).
1354+ 840A                  ;
1355+ 840A                  ; Formula:
1356+ 840A                  ;   High = $40 + (Row AND $18)
1357+ 840A                  ;   Low  = (Row AND 7) * 32 + Col
1358+ 840A                  ;
1359+ 840A                  ; DE conterrà l'indirizzo della prima scanline.
1360+ 840A                  ; ---------------------------------------------------------------
1361+ 840A
1362+ 840A 78               ld   a, b
1363+ 840B E6 18            and  $18
1364+ 840D C6 40            add  a, $40
1365+ 840F 57               ld   d, a              ; Byte alto indirizzo video
1366+ 8410
1367+ 8410 78               ld   a, b
1368+ 8411 E6 07            and  7                 ; Riga interna al blocco da 8
1369+ 8413
1370+ 8413 87               add  a, a              ; *2
1371+ 8414 87               add  a, a              ; *4
1372+ 8415 87               add  a, a              ; *8
1373+ 8416 87               add  a, a              ; *16
1374+ 8417 87               add  a, a              ; *32
1375+ 8418
1376+ 8418 81               add  a, c              ; + colonna
1377+ 8419
1378+ 8419 5F               ld   e, a              ; Byte basso indirizzo video
1379+ 841A
1380+ 841A                  ; ---------------------------------------------------------------
1381+ 841A                  ; Disegno bitmap
1382+ 841A                  ;
1383+ 841A                  ; Copia 8 byte consecutivi nella memoria video.
1384+ 841A                  ; Ogni byte rappresenta una scanline da 8 pixel.
1385+ 841A                  ; ---------------------------------------------------------------
1386+ 841A
1387+ 841A C5               push bc                ; Conserva Row e Col
1388+ 841B
1389+ 841B 06 08            ld   b, 8              ; Numero scanline
1390+ 841D
1391+ 841D              .line_loop:
1392+ 841D
1393+ 841D 7E               ld   a, (hl)           ; Legge scanline bitmap
1394+ 841E 12               ld   (de), a           ; Scrive nella memoria video
1395+ 841F
1396+ 841F 14               inc  d                 ; Scanline successiva
1397+ 8420 23               inc  hl                ; Byte bitmap successivo
1398+ 8421
1399+ 8421 05               dec  b
1400+ 8422 20 F9            jr   nz, .line_loop
1401+ 8424
1402+ 8424 C1               pop  bc                ; Ripristina Row e Col
1403+ 8425
1404+ 8425                  ; ---------------------------------------------------------------
1405+ 8425                  ; Calcolo indirizzo attributo
1406+ 8425                  ;
1407+ 8425                  ; Formula:
1408+ 8425                  ;   AttrAddr = $5800 + Row * 32 + Col
1409+ 8425                  ;
1410+ 8425                  ; HL conterrà l'indirizzo della cella attributi.
1411+ 8425                  ; ---------------------------------------------------------------
1412+ 8425
1413+ 8425 26 00            ld   h, 0
1414+ 8427 68               ld   l, b              ; HL = Row
1415+ 8428
1416+ 8428 29               add  hl, hl            ; *2
1417+ 8429 29               add  hl, hl            ; *4
1418+ 842A 29               add  hl, hl            ; *8
1419+ 842B 29               add  hl, hl            ; *16
1420+ 842C 29               add  hl, hl            ; *32
1421+ 842D
1422+ 842D 79               ld   a, c              ; A = Colonna
1423+ 842E
1424+ 842E 85               add  a, l
1425+ 842F 6F               ld   l, a
1426+ 8430
1427+ 8430 30 01            jr   nc, .no_carry
1428+ 8432 24               inc  h
1429+ 8433
1430+ 8433              .no_carry:
1431+ 8433
1432+ 8433                  ; HL = Row * 32 + Col
1433+ 8433
1434+ 8433 11 00 58         ld   de, $5800
1435+ 8436 19               add  hl, de            ; HL = indirizzo attributi
1436+ 8437
1437+ 8437                  ; ---------------------------------------------------------------
1438+ 8437                  ; Recupera il colore originale dallo stack.
1439+ 8437                  ;
1440+ 8437                  ; Layout stack:
1441+ 8437                  ;   HL originale
1442+ 8437                  ;   DE originale (E = colore)
1443+ 8437                  ;   BC originale
1444+ 8437                  ; ---------------------------------------------------------------
1445+ 8437
1446+ 8437 C1               pop  bc                ; Recupera HL originale
1447+ 8438 D1               pop  de                ; Recupera DE originale
1448+ 8439
1449+ 8439                  ; ---------------------------------------------------------------
1450+ 8439                  ; Scrive l'attributo colore
1451+ 8439                  ; ---------------------------------------------------------------
1452+ 8439
1453+ 8439 7B               ld   a, e              ; A = colore
1454+ 843A 77               ld   (hl), a           ; Scrive nella RAM attributi
1455+ 843B
1456+ 843B                  ; ---------------------------------------------------------------
1457+ 843B                  ; Ripristina HL e BC originali
1458+ 843B                  ; ---------------------------------------------------------------
1459+ 843B
1460+ 843B C5               push bc
1461+ 843C E1               pop  hl                ; HL originale
1462+ 843D
1463+ 843D C1               pop  bc                ; BC originale
1464+ 843E
1465+ 843E C9               ret
1466+ 843F
1467+ 843F              ; -------------------------------------------------------------------
1468+ 843F              ; RestoreBackgroundCell
1469+ 843F              ;
1470+ 843F              ; Ripristina il contenuto originale di una cella della stanza.
1471+ 843F              ; Viene utilizzata principalmente quando un item viene raccolto:
1472+ 843F              ; invece di lasciare un "buco", la routine ridisegna il tile
1473+ 843F              ; originale presente nella mappa della stanza.
1474+ 843F              ;
1475+ 843F              ; Input:
1476+ 843F              ;   B = Row (3..18)
1477+ 843F              ;   C = Col (0..31)
1478+ 843F              ;
1479+ 843F              ; Utilizza:
1480+ 843F              ;   room_ptr -> struttura dati della stanza corrente
1481+ 843F              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1482+ 843F              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1483+ 843F              ;
1484+ 843F              ; Tipi di cella:
1485+ 843F              ;   0 = Background
1486+ 843F              ;   1 = Floor
1487+ 843F              ;   2 = Wall
1488+ 843F              ;   3 = Nasty
1489+ 843F              ; -------------------------------------------------------------------
1490+ 843F              RestoreBackgroundCell:
1491+ 843F
1492+ 843F                  ; Salva tutti i registri utilizzati
1493+ 843F FD E5            push iy
1494+ 8441 C5               push bc
1495+ 8442 D5               push de
1496+ 8443 E5               push hl
1497+ 8444 DD E5            push ix
1498+ 8446
1499+ 8446                  ; ---------------------------------------------------------------
1500+ 8446                  ; Conserva Row e Col in IY.
1501+ 8446                  ;
1502+ 8446                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1503+ 8446                  ; BC potrebbe essere modificato.
1504+ 8446                  ; ---------------------------------------------------------------
1505+ 8446 C5               push bc
1506+ 8447 FD E1            pop  iy                ; IYH = Row, IYL = Col
1507+ 8449
1508+ 8449                  ; ---------------------------------------------------------------
1509+ 8449                  ; Determina quale tipo di cella è presente nella posizione
1510+ 8449                  ; specificata.
1511+ 8449                  ;
1512+ 8449                  ; Input:
1513+ 8449                  ;   B = Row
1514+ 8449                  ;   C = Col
1515+ 8449                  ;
1516+ 8449                  ; Output:
1517+ 8449                  ;   A = tipo cella
1518+ 8449                  ; ---------------------------------------------------------------
1519+ 8449 78               ld   a, b
1520+ 844A
1521+ 844A CD 45 75         call GetCellFromUnpacked
1522+ 844D
1523+ 844D                  ; ---------------------------------------------------------------
1524+ 844D                  ; Recupera il puntatore alla stanza corrente.
1525+ 844D                  ;
1526+ 844D                  ; DE = base della struttura stanza
1527+ 844D                  ; ---------------------------------------------------------------
1528+ 844D ED 5B FF ED      ld   de, (room_ptr)
1529+ 8451
1530+ 8451                  ; ---------------------------------------------------------------
1531+ 8451                  ; Seleziona il tile corretto in base al tipo di cella.
1532+ 8451                  ;
1533+ 8451                  ; A = 0 -> Background
1534+ 8451                  ; A = 1 -> Floor
1535+ 8451                  ; A = 2 -> Wall
1536+ 8451                  ; A = 3 -> Nasty
1537+ 8451                  ; ---------------------------------------------------------------
1538+ 8451
1539+ 8451 B7               or   a
1540+ 8452 20 06            jr   nz, .not_bg
1541+ 8454
1542+ 8454                  ; Background
1543+ 8454 21 A0 00         ld   hl, OFFSET_BG
1544+ 8457 19               add  hl, de
1545+ 8458 18 16            jr   .draw_cell
1546+ 845A
1547+ 845A              .not_bg:
1548+ 845A
1549+ 845A 3D               dec  a
1550+ 845B 20 06            jr   nz, .not_floor
1551+ 845D
1552+ 845D                  ; Floor
1553+ 845D 21 A9 00         ld   hl, OFFSET_FLOOR
1554+ 8460 19               add  hl, de
1555+ 8461 18 0D            jr   .draw_cell
1556+ 8463
1557+ 8463              .not_floor:
1558+ 8463
1559+ 8463 3D               dec  a
1560+ 8464 20 06            jr   nz, .not_wall
1561+ 8466
1562+ 8466                  ; Wall
1563+ 8466 21 B2 00         ld   hl, OFFSET_WALL
1564+ 8469 19               add  hl, de
1565+ 846A 18 04            jr   .draw_cell
1566+ 846C
1567+ 846C              .not_wall:
1568+ 846C
1569+ 846C                  ; Nasty
1570+ 846C 21 BB 00         ld   hl, OFFSET_NASTY
1571+ 846F 19               add  hl, de
1572+ 8470
1573+ 8470              .draw_cell:
1574+ 8470
1575+ 8470                  ; ---------------------------------------------------------------
1576+ 8470                  ; HL punta ora alla grafica del tile da ridisegnare.
1577+ 8470                  ;
1578+ 8470                  ; Gfx_DrawTile si aspetta:
1579+ 8470                  ;   IX = puntatore tile
1580+ 8470                  ;   B  = Row
1581+ 8470                  ;   C  = Col
1582+ 8470                  ; ---------------------------------------------------------------
1583+ 8470 E5               push hl
1584+ 8471 DD E1            pop  ix
1585+ 8473
1586+ 8473                  ; Ripristina Row e Col salvati in IY
1587+ 8473 FD E5            push iy
1588+ 8475 C1               pop  bc
1589+ 8476
1590+ 8476                  ; Disegna il tile originale
1591+ 8476 CD 14 68         call Gfx_DrawTile
1592+ 8479
1593+ 8479                  ; ---------------------------------------------------------------
1594+ 8479                  ; Ripristina i registri salvati
1595+ 8479                  ; ---------------------------------------------------------------
1596+ 8479 DD E1            pop  ix
1597+ 847B E1               pop  hl
1598+ 847C D1               pop  de
1599+ 847D C1               pop  bc
1600+ 847E FD E1            pop  iy
1601+ 8480
1602+ 8480 C9               ret
1603+ 8481
1604+ 8481              ; -------------------------------------------------------------------
1605+ 8481              ; CheckWillyItemCollision
1606+ 8481              ;
1607+ 8481              ; Verifica se Willy collide con un item utilizzando il controllo
1608+ 8481              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1609+ 8481              ;
1610+ 8481              ; Input:
1611+ 8481              ;   A = ItemX (colonna attributi 0..31)
1612+ 8481              ;   H = ItemY (riga attributi 3..18)
1613+ 8481              ;
1614+ 8481              ; Coordinate item:
1615+ 8481              ;   Ogni item occupa una cella da 8x8 pixel.
1616+ 8481              ;
1617+ 8481              ; Coordinate Willy:
1618+ 8481              ;   Willy occupa un rettangolo di 16x16 pixel.
1619+ 8481              ;
1620+ 8481              ; Output:
1621+ 8481              ;   Carry Set   = collisione rilevata
1622+ 8481              ;   Carry Clear = nessuna collisione
1623+ 8481              ;
1624+ 8481              ; Registri preservati:
1625+ 8481              ;   BC, DE, HL
1626+ 8481              ; -------------------------------------------------------------------
1627+ 8481              CheckWillyItemCollision:
1628+ 8481
1629+ 8481                  ; Salva i registri utilizzati
1630+ 8481 C5               push bc
1631+ 8482 D5               push de
1632+ 8483 E5               push hl
1633+ 8484
1634+ 8484                  ; ---------------------------------------------------------------
1635+ 8484                  ; Calcola il bounding box orizzontale dell'item
1636+ 8484                  ;
1637+ 8484                  ; ItemLeft  = ItemX * 8
1638+ 8484                  ; ItemRight = ItemLeft + 7
1639+ 8484                  ;
1640+ 8484                  ; E = ItemLeft
1641+ 8484                  ; D = ItemRight
1642+ 8484                  ; ---------------------------------------------------------------
1643+ 8484 6F               ld   l, a              ; L = ItemX
1644+ 8485
1645+ 8485 7D               ld   a, l
1646+ 8486 87               add  a, a              ; *2
1647+ 8487 87               add  a, a              ; *4
1648+ 8488 87               add  a, a              ; *8
1649+ 8489
1650+ 8489 5F               ld   e, a              ; E = ItemLeft
1651+ 848A
1652+ 848A C6 07            add  a, 7
1653+ 848C 57               ld   d, a              ; D = ItemRight
1654+ 848D
1655+ 848D                  ; ---------------------------------------------------------------
1656+ 848D                  ; Recupera la posizione corrente di Willy
1657+ 848D                  ;
1658+ 848D                  ; B = WillyY
1659+ 848D                  ; C = WillyX
1660+ 848D                  ; ---------------------------------------------------------------
1661+ 848D ED 4B 7F EA      ld   bc, (PlayerPos)
1662+ 8491
1663+ 8491                  ; ---------------------------------------------------------------
1664+ 8491                  ; Primo test:
1665+ 8491                  ;
1666+ 8491                  ; WillyLeft <= ItemRight
1667+ 8491                  ;
1668+ 8491                  ; Se Willy è completamente a destra dell'item
1669+ 8491                  ; non può esserci collisione.
1670+ 8491                  ; ---------------------------------------------------------------
1671+ 8491 79               ld   a, c              ; A = WillyLeft
1672+ 8492
1673+ 8492 BA               cp   d                 ; WillyLeft vs ItemRight
1674+ 8493
1675+ 8493 28 04            jr   z, .x_ok
1676+ 8495 38 02            jr   c, .x_ok
1677+ 8497
1678+ 8497 18 29            jr   .no_collision
1679+ 8499
1680+ 8499              .x_ok:
1681+ 8499
1682+ 8499                  ; ---------------------------------------------------------------
1683+ 8499                  ; Secondo test:
1684+ 8499                  ;
1685+ 8499                  ; WillyRight >= ItemLeft
1686+ 8499                  ;
1687+ 8499                  ; WillyRight = WillyX + 7
1688+ 8499                  ; ---------------------------------------------------------------
1689+ 8499 C6 07            add  a, 7
1690+ 849B
1691+ 849B BB               cp   e                 ; WillyRight vs ItemLeft
1692+ 849C
1693+ 849C 28 04            jr   z, .y_check
1694+ 849E 30 02            jr   nc, .y_check
1695+ 84A0
1696+ 84A0 18 20            jr   .no_collision
1697+ 84A2
1698+ 84A2              .y_check:
1699+ 84A2
1700+ 84A2                  ; ---------------------------------------------------------------
1701+ 84A2                  ; Recupera ItemY dal valore originale di HL
1702+ 84A2                  ;
1703+ 84A2                  ; H contiene la riga dell'item.
1704+ 84A2                  ; ---------------------------------------------------------------
1705+ 84A2 E1               pop  hl
1706+ 84A3 E5               push hl
1707+ 84A4
1708+ 84A4                  ; ---------------------------------------------------------------
1709+ 84A4                  ; Calcola il bounding box verticale dell'item
1710+ 84A4                  ;
1711+ 84A4                  ; ItemTop    = ItemY * 8
1712+ 84A4                  ; ItemBottom = ItemTop + 7
1713+ 84A4                  ;
1714+ 84A4                  ; E = ItemTop
1715+ 84A4                  ; D = ItemBottom
1716+ 84A4                  ; ---------------------------------------------------------------
1717+ 84A4 7C               ld   a, h
1718+ 84A5
1719+ 84A5 87               add  a, a              ; *2
1720+ 84A6 87               add  a, a              ; *4
1721+ 84A7 87               add  a, a              ; *8
1722+ 84A8
1723+ 84A8 5F               ld   e, a              ; ItemTop
1724+ 84A9
1725+ 84A9 C6 07            add  a, 7
1726+ 84AB 57               ld   d, a              ; ItemBottom
1727+ 84AC
1728+ 84AC                  ; ---------------------------------------------------------------
1729+ 84AC                  ; Primo test verticale:
1730+ 84AC                  ;
1731+ 84AC                  ; WillyTop <= ItemBottom
1732+ 84AC                  ; ---------------------------------------------------------------
1733+ 84AC 78               ld   a, b              ; WillyTop
1734+ 84AD
1735+ 84AD BA               cp   d
1736+ 84AE
1737+ 84AE 28 04            jr   z, .y_ok
1738+ 84B0 38 02            jr   c, .y_ok
1739+ 84B2
1740+ 84B2 18 0E            jr   .no_collision
1741+ 84B4
1742+ 84B4              .y_ok:
1743+ 84B4
1744+ 84B4                  ; ---------------------------------------------------------------
1745+ 84B4                  ; Secondo test verticale:
1746+ 84B4                  ;
1747+ 84B4                  ; WillyBottom >= ItemTop
1748+ 84B4                  ;
1749+ 84B4                  ; WillyBottom = WillyY + 15
1750+ 84B4                  ; ---------------------------------------------------------------
1751+ 84B4 C6 0F            add  a, 15
1752+ 84B6
1753+ 84B6 BB               cp   e
1754+ 84B7
1755+ 84B7 28 04            jr   z, .collision
1756+ 84B9 30 02            jr   nc, .collision
1757+ 84BB
1758+ 84BB 18 05            jr   .no_collision
1759+ 84BD
1760+ 84BD              .collision:
1761+ 84BD
1762+ 84BD                  ; ---------------------------------------------------------------
1763+ 84BD                  ; Collisione rilevata
1764+ 84BD                  ; ---------------------------------------------------------------
1765+ 84BD E1               pop  hl
1766+ 84BE D1               pop  de
1767+ 84BF C1               pop  bc
1768+ 84C0
1769+ 84C0 37               scf                    ; Carry = 1
1770+ 84C1
1771+ 84C1 C9               ret
1772+ 84C2
1773+ 84C2              .no_collision:
1774+ 84C2
1775+ 84C2                  ; ---------------------------------------------------------------
1776+ 84C2                  ; Nessuna collisione
1777+ 84C2                  ; ---------------------------------------------------------------
1778+ 84C2 E1               pop  hl
1779+ 84C3 D1               pop  de
1780+ 84C4 C1               pop  bc
1781+ 84C5
1782+ 84C5 B7               or   a                 ; Carry = 0
1783+ 84C6
1784+ 84C6 C9               ret
1785+ 84C7
1786+ 84C7              ; -------------------------------------------------------------------
1787+ 84C7              ; Items_CheckCollision
1788+ 84C7              ;
1789+ 84C7              ; Controlla se Willy entra in collisione con uno degli item
1790+ 84C7              ; attivi presenti nella stanza corrente.
1791+ 84C7              ;
1792+ 84C7              ; Per ogni item:
1793+ 84C7              ;   - verifica che appartenga alla stanza corrente
1794+ 84C7              ;   - verifica che non sia già stato raccolto
1795+ 84C7              ;   - esegue il test di collisione con Willy
1796+ 84C7              ;
1797+ 84C7              ; Se l'item viene raccolto:
1798+ 84C7              ;   - imposta il flag "collected"
1799+ 84C7              ;   - rimuove l'item dalla cache items_grid
1800+ 84C7              ;   - incrementa il contatore degli oggetti raccolti
1801+ 84C7              ;   - aggiorna l'HUD
1802+ 84C7              ;   - ripristina il tile di sfondo
1803+ 84C7              ;   - riproduce il suono di raccolta
1804+ 84C7              ;
1805+ 84C7              ; Formato record ItemsTable:
1806+ 84C7              ;   +0 RoomID
1807+ 84C7              ;   +1 X
1808+ 84C7              ;   +2 Y
1809+ 84C7              ;   +3 Color
1810+ 84C7              ;   +4 Collected
1811+ 84C7              ;
1812+ 84C7              ; Fine tabella:
1813+ 84C7              ;   RoomID = $FF
1814+ 84C7              ; -------------------------------------------------------------------
1815+ 84C7              Items_CheckCollision:
1816+ 84C7
1817+ 84C7                  ; Salva i registri utilizzati
1818+ 84C7 E5               push hl
1819+ 84C8 D5               push de
1820+ 84C9 C5               push bc
1821+ 84CA
1822+ 84CA                  ; Inizio scansione della tabella degli item
1823+ 84CA 21 17 7E         ld   hl, ItemsTable
1824+ 84CD
1825+ 84CD              .loop:
1826+ 84CD
1827+ 84CD                  ; ---------------------------------------------------------------
1828+ 84CD                  ; Legge il Room ID dell'item corrente
1829+ 84CD                  ; ---------------------------------------------------------------
1830+ 84CD 7E               ld   a, (hl)
1831+ 84CE
1832+ 84CE                  ; $FF indica fine tabella
1833+ 84CE FE FF            cp   $FF
1834+ 84D0 28 58            jr   z, .done
1835+ 84D2
1836+ 84D2                  ; ---------------------------------------------------------------
1837+ 84D2                  ; Verifica se l'item appartiene alla stanza corrente
1838+ 84D2                  ; ---------------------------------------------------------------
1839+ 84D2 57               ld   d, a              ; D = RoomID item
1840+ 84D3
1841+ 84D3 3A A5 ED         ld   a, (current_room)
1842+ 84D6 BA               cp   d
1843+ 84D7
1844+ 84D7                  ; Se appartiene a un'altra stanza salta il record
1845+ 84D7 20 4A            jr   nz, .next_item
1846+ 84D9
1847+ 84D9                  ; ---------------------------------------------------------------
1848+ 84D9                  ; Legge coordinate e stato dell'item
1849+ 84D9                  ; ---------------------------------------------------------------
1850+ 84D9
1851+ 84D9 23               inc  hl
1852+ 84DA 4E               ld   c, (hl)           ; C = X
1853+ 84DB
1854+ 84DB 23               inc  hl
1855+ 84DC 46               ld   b, (hl)           ; B = Y
1856+ 84DD
1857+ 84DD 23               inc  hl                ; salta Color
1858+ 84DE
1859+ 84DE 23               inc  hl                ; punta a Collected
1860+ 84DF
1861+ 84DF 7E               ld   a, (hl)
1862+ 84E0
1863+ 84E0                  ; ---------------------------------------------------------------
1864+ 84E0                  ; Item già raccolto?
1865+ 84E0                  ; ---------------------------------------------------------------
1866+ 84E0 B7               or   a
1867+ 84E1 20 44            jr   nz, .next_no_inc
1868+ 84E3
1869+ 84E3                  ; ---------------------------------------------------------------
1870+ 84E3                  ; Test collisione Willy ↔ Item
1871+ 84E3                  ;
1872+ 84E3                  ; Input richiesto:
1873+ 84E3                  ;   A = ItemX
1874+ 84E3                  ;   H = ItemY
1875+ 84E3                  ; ---------------------------------------------------------------
1876+ 84E3 79               ld   a, c
1877+ 84E4
1878+ 84E4 E5               push hl                ; salva puntatore al flag Collected
1879+ 84E5
1880+ 84E5 60               ld   h, b
1881+ 84E6
1882+ 84E6 CD 81 84         call CheckWillyItemCollision
1883+ 84E9
1884+ 84E9 E1               pop  hl
1885+ 84EA
1886+ 84EA                  ; Nessuna collisione
1887+ 84EA 30 3B            jr   nc, .next_no_inc
1888+ 84EC
1889+ 84EC                  ; ===============================================================
1890+ 84EC                  ; ITEM RACCOLTO
1891+ 84EC                  ; ===============================================================
1892+ 84EC
1893+ 84EC                  ; ---------------------------------------------------------------
1894+ 84EC                  ; Marca l'item come raccolto
1895+ 84EC                  ; ---------------------------------------------------------------
1896+ 84EC 36 01            ld   (hl), 1
1897+ 84EE
1898+ 84EE                  ; ---------------------------------------------------------------
1899+ 84EE                  ; Rimuove l'item dalla cache items_grid
1900+ 84EE                  ;
1901+ 84EE                  ; Calcolo:
1902+ 84EE                  ;   offset = Row * 32 + Col
1903+ 84EE                  ; ---------------------------------------------------------------
1904+ 84EE E5               push hl
1905+ 84EF D5               push de
1906+ 84F0
1907+ 84F0 26 00            ld   h, 0
1908+ 84F2 68               ld   l, b              ; HL = Row
1909+ 84F3
1910+ 84F3 29               add  hl, hl            ; *2
1911+ 84F4 29               add  hl, hl            ; *4
1912+ 84F5 29               add  hl, hl            ; *8
1913+ 84F6 29               add  hl, hl            ; *16
1914+ 84F7 29               add  hl, hl            ; *32
1915+ 84F8
1916+ 84F8 59               ld   e, c
1917+ 84F9 16 00            ld   d, 0
1918+ 84FB
1919+ 84FB 19               add  hl, de            ; Row*32 + Col
1920+ 84FC
1921+ 84FC 11 7F E8         ld   de, items_grid
1922+ 84FF 19               add  hl, de
1923+ 8500
1924+ 8500                  ; La cella non contiene più un item
1925+ 8500 36 00            ld   (hl), 0
1926+ 8502
1927+ 8502 D1               pop  de
1928+ 8503 E1               pop  hl
1929+ 8504
1930+ 8504                  ; ---------------------------------------------------------------
1931+ 8504                  ; Conserva il puntatore all'entry corrente
1932+ 8504                  ; poiché le routine successive possono alterare HL.
1933+ 8504                  ; ---------------------------------------------------------------
1934+ 8504 E5               push hl
1935+ 8505
1936+ 8505                  ; ---------------------------------------------------------------
1937+ 8505                  ; Aggiorna il numero di oggetti raccolti
1938+ 8505                  ; ---------------------------------------------------------------
1939+ 8505 3A 89 EA         ld   a, (items_collected)
1940+ 8508
1941+ 8508 3C               inc  a
1942+ 8509
1943+ 8509 32 89 EA         ld   (items_collected), a
1944+ 850C
1945+ 850C FE 4C            cp   TOTAL_ITEMS
1946+ 850E 38 07            jr   c, .objective_not_completed
1947+ 8510 F5               push af
1948+ 8511 3E 01            ld   a, 1
1949+ 8513 32 91 EE         ld   (game_objective_completed), a
1950+ 8516 F1               pop  af
1951+ 8517              .objective_not_completed:
1952+ 8517
1953+ 8517                  ; ---------------------------------------------------------------
1954+ 8517                  ; Aggiorna il contatore visualizzato a schermo
1955+ 8517                  ; ---------------------------------------------------------------
1956+ 8517 CD 39 66         call Gfx_UpdateItemsCollectedDisplay
1957+ 851A
1958+ 851A                  ; ---------------------------------------------------------------
1959+ 851A                  ; Ripristina il tile originale della stanza
1960+ 851A                  ; eliminando la grafica dell'item.
1961+ 851A                  ;
1962+ 851A                  ; Input:
1963+ 851A                  ;   B = Row
1964+ 851A                  ;   C = Col
1965+ 851A                  ; ---------------------------------------------------------------
1966+ 851A CD 3F 84         call RestoreBackgroundCell
1967+ 851D
1968+ 851D                  ; ---------------------------------------------------------------
1969+ 851D                  ; Riproduce il suono di raccolta
1970+ 851D                  ; ---------------------------------------------------------------
1971+ 851D CD 99 85         call Audio_PlayCollectSound
1972+ 8520
1973+ 8520                  ; Ripristina il puntatore alla tabella
1974+ 8520 E1               pop  hl
1975+ 8521
1976+ 8521                  ; Continua con il record successivo
1977+ 8521 18 04            jr   .next_no_inc
1978+ 8523
1979+ 8523              .next_item:
1980+ 8523
1981+ 8523                  ; ---------------------------------------------------------------
1982+ 8523                  ; Salta i campi del record:
1983+ 8523                  ;   X
1984+ 8523                  ;   Y
1985+ 8523                  ;   Color
1986+ 8523                  ;   Collected
1987+ 8523                  ; ---------------------------------------------------------------
1988+ 8523 23               inc  hl
1989+ 8524 23               inc  hl
1990+ 8525 23               inc  hl
1991+ 8526 23               inc  hl
1992+ 8527
1993+ 8527              .next_no_inc:
1994+ 8527
1995+ 8527                  ; ---------------------------------------------------------------
1996+ 8527                  ; Avanza al record successivo.
1997+ 8527                  ;
1998+ 8527                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1999+ 8527                  ; ---------------------------------------------------------------
2000+ 8527 23               inc  hl
2001+ 8528
2002+ 8528 18 A3            jr   .loop
2003+ 852A
2004+ 852A              .done:
2005+ 852A
2006+ 852A                  ; Ripristina i registri
2007+ 852A C1               pop  bc
2008+ 852B D1               pop  de
2009+ 852C E1               pop  hl
2010+ 852D
2011+ 852D C9               ret
2012+ 852E
2013+ 852E
2014+ 852E
2015+ 852E              ; -------------------------------------------------------------------
2016+ 852E              ; CheckActiveItemAtCell
2017+ 852E              ;
2018+ 852E              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2019+ 852E              ; nella cella specificata della griglia items_grid.
2020+ 852E              ;
2021+ 852E              ; Questa routine usa una lookup diretta su una mappa 32x16,
2022+ 852E              ; evitando la scansione della ItemsTable.
2023+ 852E              ;
2024+ 852E              ; Input:
2025+ 852E              ;   B = Colonna (0..31)
2026+ 852E              ;   C = Riga (0..15)
2027+ 852E              ;
2028+ 852E              ; Output:
2029+ 852E              ;   Carry Set   = item presente nella cella
2030+ 852E              ;   Carry Clear = nessun item
