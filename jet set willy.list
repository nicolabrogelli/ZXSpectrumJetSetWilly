1005+ 7131
1006+ 7131 B7               or   a                 ; Carry = 0
1007+ 7132
1008+ 7132 C9               ret
1009+ 7133
1010+ 7133              ; -------------------------------------------------------------------
1011+ 7133              ; CheckRoomItemsCollision
1012+ 7133              ;
1013+ 7133              ; Controlla se Willy entra in collisione con uno degli item
1014+ 7133              ; attivi presenti nella stanza corrente.
1015+ 7133              ;
1016+ 7133              ; Per ogni item:
1017+ 7133              ;   - verifica che appartenga alla stanza corrente
1018+ 7133              ;   - verifica che non sia già stato raccolto
1019+ 7133              ;   - esegue il test di collisione con Willy
1020+ 7133              ;
1021+ 7133              ; Se l'item viene raccolto:
1022+ 7133              ;   - imposta il flag "collected"
1023+ 7133              ;   - rimuove l'item dalla cache items_grid
1024+ 7133              ;   - incrementa il contatore degli oggetti raccolti
1025+ 7133              ;   - aggiorna l'HUD
1026+ 7133              ;   - ripristina il tile di sfondo
1027+ 7133              ;   - riproduce il suono di raccolta
1028+ 7133              ;
1029+ 7133              ; Formato record ItemsTable:
1030+ 7133              ;   +0 RoomID
1031+ 7133              ;   +1 X
1032+ 7133              ;   +2 Y
1033+ 7133              ;   +3 Color
1034+ 7133              ;   +4 Collected
1035+ 7133              ;
1036+ 7133              ; Fine tabella:
1037+ 7133              ;   RoomID = $FF
1038+ 7133              ; -------------------------------------------------------------------
1039+ 7133              CheckRoomItemsCollision:
1040+ 7133
1041+ 7133                  ; Salva i registri utilizzati
1042+ 7133 E5               push hl
1043+ 7134 D5               push de
1044+ 7135 C5               push bc
1045+ 7136
1046+ 7136                  ; Inizio scansione della tabella degli item
1047+ 7136 21 9A 6E         ld   hl, ItemsTable
1048+ 7139
1049+ 7139              .loop:
1050+ 7139
1051+ 7139                  ; ---------------------------------------------------------------
1052+ 7139                  ; Legge il Room ID dell'item corrente
1053+ 7139                  ; ---------------------------------------------------------------
1054+ 7139 7E               ld   a, (hl)
1055+ 713A
1056+ 713A                  ; $FF indica fine tabella
1057+ 713A FE FF            cp   $FF
1058+ 713C 28 4D            jr   z, .done
1059+ 713E
1060+ 713E                  ; ---------------------------------------------------------------
1061+ 713E                  ; Verifica se l'item appartiene alla stanza corrente
1062+ 713E                  ; ---------------------------------------------------------------
1063+ 713E 57               ld   d, a              ; D = RoomID item
1064+ 713F
1065+ 713F 3A E4 74         ld   a, (current_room)
1066+ 7142 BA               cp   d
1067+ 7143
1068+ 7143                  ; Se appartiene a un'altra stanza salta il record
1069+ 7143 20 3F            jr   nz, .next_item
1070+ 7145
1071+ 7145                  ; ---------------------------------------------------------------
1072+ 7145                  ; Legge coordinate e stato dell'item
1073+ 7145                  ; ---------------------------------------------------------------
1074+ 7145
1075+ 7145 23               inc  hl
1076+ 7146 4E               ld   c, (hl)           ; C = X
1077+ 7147
1078+ 7147 23               inc  hl
1079+ 7148 46               ld   b, (hl)           ; B = Y
1080+ 7149
1081+ 7149 23               inc  hl                ; salta Color
1082+ 714A
1083+ 714A 23               inc  hl                ; punta a Collected
1084+ 714B
1085+ 714B 7E               ld   a, (hl)
1086+ 714C
1087+ 714C                  ; ---------------------------------------------------------------
1088+ 714C                  ; Item già raccolto?
1089+ 714C                  ; ---------------------------------------------------------------
1090+ 714C B7               or   a
1091+ 714D 20 39            jr   nz, .next_no_inc
1092+ 714F
1093+ 714F                  ; ---------------------------------------------------------------
1094+ 714F                  ; Test collisione Willy ↔ Item
1095+ 714F                  ;
1096+ 714F                  ; Input richiesto:
1097+ 714F                  ;   A = ItemX
1098+ 714F                  ;   H = ItemY
1099+ 714F                  ; ---------------------------------------------------------------
1100+ 714F 79               ld   a, c
1101+ 7150
1102+ 7150 E5               push hl                ; salva puntatore al flag Collected
1103+ 7151
1104+ 7151 60               ld   h, b
1105+ 7152
1106+ 7152 CD ED 70         call CheckWillyItemCollision
1107+ 7155
1108+ 7155 E1               pop  hl
1109+ 7156
1110+ 7156                  ; Nessuna collisione
1111+ 7156 30 30            jr   nc, .next_no_inc
1112+ 7158
1113+ 7158                  ; ===============================================================
1114+ 7158                  ; ITEM RACCOLTO
1115+ 7158                  ; ===============================================================
1116+ 7158
1117+ 7158                  ; ---------------------------------------------------------------
1118+ 7158                  ; Marca l'item come raccolto
1119+ 7158                  ; ---------------------------------------------------------------
1120+ 7158 36 01            ld   (hl), 1
1121+ 715A
1122+ 715A                  ; ---------------------------------------------------------------
1123+ 715A                  ; Rimuove l'item dalla cache items_grid
1124+ 715A                  ;
1125+ 715A                  ; Calcolo:
1126+ 715A                  ;   offset = Row * 32 + Col
1127+ 715A                  ; ---------------------------------------------------------------
1128+ 715A E5               push hl
1129+ 715B D5               push de
1130+ 715C
1131+ 715C 26 00            ld   h, 0
1132+ 715E 68               ld   l, b              ; HL = Row
1133+ 715F
1134+ 715F 29               add  hl, hl            ; *2
1135+ 7160 29               add  hl, hl            ; *4
1136+ 7161 29               add  hl, hl            ; *8
1137+ 7162 29               add  hl, hl            ; *16
1138+ 7163 29               add  hl, hl            ; *32
1139+ 7164
1140+ 7164 59               ld   e, c
1141+ 7165 16 00            ld   d, 0
1142+ 7167
1143+ 7167 19               add  hl, de            ; Row*32 + Col
1144+ 7168
1145+ 7168 11 00 90         ld   de, items_grid
1146+ 716B 19               add  hl, de
1147+ 716C
1148+ 716C                  ; La cella non contiene più un item
1149+ 716C 36 00            ld   (hl), 0
1150+ 716E
1151+ 716E D1               pop  de
1152+ 716F E1               pop  hl
1153+ 7170
1154+ 7170                  ; ---------------------------------------------------------------
1155+ 7170                  ; Conserva il puntatore all'entry corrente
1156+ 7170                  ; poiché le routine successive possono alterare HL.
1157+ 7170                  ; ---------------------------------------------------------------
1158+ 7170 E5               push hl
1159+ 7171
1160+ 7171                  ; ---------------------------------------------------------------
1161+ 7171                  ; Aggiorna il numero di oggetti raccolti
1162+ 7171                  ; ---------------------------------------------------------------
1163+ 7171 3A D8 71         ld   a, (items_collected)
1164+ 7174
1165+ 7174 3C               inc  a
1166+ 7175
1167+ 7175 32 D8 71         ld   (items_collected), a
1168+ 7178
1169+ 7178                  ; ---------------------------------------------------------------
1170+ 7178                  ; Aggiorna il contatore visualizzato a schermo
1171+ 7178                  ; ---------------------------------------------------------------
1172+ 7178 CD CB 60         call UpdateItemsCollectedDisplay
1173+ 717B
1174+ 717B                  ; ---------------------------------------------------------------
1175+ 717B                  ; Ripristina il tile originale della stanza
1176+ 717B                  ; eliminando la grafica dell'item.
1177+ 717B                  ;
1178+ 717B                  ; Input:
1179+ 717B                  ;   B = Row
1180+ 717B                  ;   C = Col
1181+ 717B                  ; ---------------------------------------------------------------
1182+ 717B CD AB 70         call RestoreBackgroundCell
1183+ 717E
1184+ 717E                  ; ---------------------------------------------------------------
1185+ 717E                  ; Riproduce il suono di raccolta
1186+ 717E                  ; ---------------------------------------------------------------
1187+ 717E CD 8F 71         call PlayCollectSound
1188+ 7181
1189+ 7181                  ; Ripristina il puntatore alla tabella
1190+ 7181 E1               pop  hl
1191+ 7182
1192+ 7182                  ; Continua con il record successivo
1193+ 7182 18 04            jr   .next_no_inc
1194+ 7184
1195+ 7184              .next_item:
1196+ 7184
1197+ 7184                  ; ---------------------------------------------------------------
1198+ 7184                  ; Salta i campi del record:
1199+ 7184                  ;   X
1200+ 7184                  ;   Y
1201+ 7184                  ;   Color
1202+ 7184                  ;   Collected
1203+ 7184                  ; ---------------------------------------------------------------
1204+ 7184 23               inc  hl
1205+ 7185 23               inc  hl
1206+ 7186 23               inc  hl
1207+ 7187 23               inc  hl
1208+ 7188
1209+ 7188              .next_no_inc:
1210+ 7188
1211+ 7188                  ; ---------------------------------------------------------------
1212+ 7188                  ; Avanza al record successivo.
1213+ 7188                  ;
1214+ 7188                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1215+ 7188                  ; ---------------------------------------------------------------
1216+ 7188 23               inc  hl
1217+ 7189
1218+ 7189 18 AE            jr   .loop
1219+ 718B
1220+ 718B              .done:
1221+ 718B
1222+ 718B                  ; Ripristina i registri
1223+ 718B C1               pop  bc
1224+ 718C D1               pop  de
1225+ 718D E1               pop  hl
1226+ 718E
1227+ 718E C9               ret
1228+ 718F
1229+ 718F              ; -------------------------------------------------------------------
1230+ 718F              ; PlayCollectSound
1231+ 718F              ;
1232+ 718F              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1233+ 718F              ; dello ZX Spectrum utilizzando il port $FE.
1234+ 718F              ;
1235+ 718F              ; Il suono viene prodotto alternando ON/OFF del bit 4
1236+ 718F              ; (speaker) con un semplice delay software.
1237+ 718F              ;
1238+ 718F              ; Effetto risultante:
1239+ 718F              ;   beep breve tipo "pickup item"
1240+ 718F              ; -------------------------------------------------------------------
1241+ 718F              PlayCollectSound:
1242+ 718F
1243+ 718F                  ; Salva registri utilizzati
1244+ 718F C5               push bc
1245+ 7190 D5               push de
1246+ 7191
1247+ 7191                  ; ---------------------------------------------------------------
1248+ 7191                  ; Numero di cicli del beep (durata complessiva del suono)
1249+ 7191                  ; ---------------------------------------------------------------
1250+ 7191 06 78            ld   b, 120
1251+ 7193
1252+ 7193              .sound_loop:
1253+ 7193
1254+ 7193                  ; ---------------------------------------------------------------
1255+ 7193                  ; SPEAKER ON
1256+ 7193                  ;
1257+ 7193                  ; Legge il colore del bordo corrente e attiva il bit 4
1258+ 7193                  ; per pilotare lo speaker.
1259+ 7193                  ; ---------------------------------------------------------------
1260+ 7193 3A DA 71         ld   a, (room_border_color)
1261+ 7196 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1262+ 7198
1263+ 7198 D3 FE            out  ($fe), a         ; scrive sul port ULA
1264+ 719A
1265+ 719A                  ; ---------------------------------------------------------------
1266+ 719A                  ; Delay (mezzo periodo)
1267+ 719A                  ; Loop software a consumo CPU
1268+ 719A                  ; ---------------------------------------------------------------
1269+ 719A 0E 3C            ld   c, 60
1270+ 719C
1271+ 719C              .d1:
1272+ 719C 0D               dec  c
1273+ 719D 20 FD            jr   nz, .d1
1274+ 719F
1275+ 719F                  ; ---------------------------------------------------------------
1276+ 719F                  ; SPEAKER OFF
1277+ 719F                  ;
1278+ 719F                  ; Mantiene il colore del bordo ma disattiva lo speaker
1279+ 719F                  ; ---------------------------------------------------------------
1280+ 719F 3A DA 71         ld   a, (room_border_color)
1281+ 71A2 E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1282+ 71A4
1283+ 71A4 D3 FE            out  ($fe), a
1284+ 71A6
1285+ 71A6                  ; ---------------------------------------------------------------
1286+ 71A6                  ; Secondo delay (mezzo periodo)
1287+ 71A6                  ; Completa l’onda quadra
1288+ 71A6                  ; ---------------------------------------------------------------
1289+ 71A6 0E 3C            ld   c, 60
1290+ 71A8
1291+ 71A8              .d2:
1292+ 71A8 0D               dec  c
1293+ 71A9 20 FD            jr   nz, .d2
1294+ 71AB
1295+ 71AB                  ; ---------------------------------------------------------------
1296+ 71AB                  ; Ripete fino a completare il numero di cicli
1297+ 71AB                  ; ---------------------------------------------------------------
1298+ 71AB 10 E6            djnz .sound_loop
1299+ 71AD
1300+ 71AD                  ; Ripristina registri salvati
1301+ 71AD D1               pop  de
1302+ 71AE C1               pop  bc
1303+ 71AF
1304+ 71AF C9               ret
1305+ 71B0
1306+ 71B0              ; -------------------------------------------------------------------
1307+ 71B0              ; CheckActiveItemAtCell
1308+ 71B0              ;
1309+ 71B0              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1310+ 71B0              ; nella cella specificata della griglia items_grid.
1311+ 71B0              ;
1312+ 71B0              ; Questa routine usa una lookup diretta su una mappa 32x16,
1313+ 71B0              ; evitando la scansione della ItemsTable.
1314+ 71B0              ;
1315+ 71B0              ; Input:
1316+ 71B0              ;   B = Colonna (0..31)
1317+ 71B0              ;   C = Riga (0..15)
1318+ 71B0              ;
1319+ 71B0              ; Output:
1320+ 71B0              ;   Carry Set   = item presente nella cella
1321+ 71B0              ;   Carry Clear = nessun item
1322+ 71B0              ;
1323+ 71B0              ; Nota:
1324+ 71B0              ;   HL NON è restituito valido (commento originale non corretto:
1325+ 71B0              ;   la routine non punta a ItemsTable).
1326+ 71B0              ; -------------------------------------------------------------------
1327+ 71B0              CheckActiveItemAtCell:
1328+ 71B0
1329+ 71B0                  ; Salva registri usati
1330+ 71B0 D5               push de
1331+ 71B1 E5               push hl
1332+ 71B2
1333+ 71B2                  ; ---------------------------------------------------------------
1334+ 71B2                  ; Calcolo indice lineare nella griglia 32x16:
1335+ 71B2                  ;
1336+ 71B2                  ; offset = Row * 32 + Col
1337+ 71B2                  ; ---------------------------------------------------------------
1338+ 71B2 26 00            ld   h, 0
1339+ 71B4 69               ld   l, c              ; HL = Row
1340+ 71B5
1341+ 71B5 29               add  hl, hl            ; *2
1342+ 71B6 29               add  hl, hl            ; *4
1343+ 71B7 29               add  hl, hl            ; *8
1344+ 71B8 29               add  hl, hl            ; *16
1345+ 71B9 29               add  hl, hl            ; *32
1346+ 71BA
1347+ 71BA                  ; Aggiunge la colonna
1348+ 71BA 58               ld   e, b
1349+ 71BB 16 00            ld   d, 0
1350+ 71BD 19               add  hl, de            ; HL = Row*32 + Col
1351+ 71BE
1352+ 71BE                  ; ---------------------------------------------------------------
1353+ 71BE                  ; Accesso alla griglia degli item attivi
1354+ 71BE                  ; ---------------------------------------------------------------
1355+ 71BE 11 00 90         ld   de, items_grid
1356+ 71C1 19               add  hl, de            ; HL = address cella
1357+ 71C2
1358+ 71C2                  ; ---------------------------------------------------------------
1359+ 71C2                  ; Controllo presenza item
1360+ 71C2                  ;
1361+ 71C2                  ; items_grid contiene:
1362+ 71C2                  ;   0 = nessun item
1363+ 71C2                  ;   >0 = item attivo (colore o flag)
1364+ 71C2                  ; ---------------------------------------------------------------
1365+ 71C2 7E               ld   a, (hl)
1366+ 71C3 B7               or   a
1367+ 71C4 28 04            jr   z, .not_active
1368+ 71C6
1369+ 71C6                  ; ---------------------------------------------------------------
1370+ 71C6                  ; Item trovato
1371+ 71C6                  ; ---------------------------------------------------------------
1372+ 71C6 E1               pop  hl
1373+ 71C7 D1               pop  de
1374+ 71C8
1375+ 71C8 37               scf                    ; Carry = 1
1376+ 71C9 C9               ret
1377+ 71CA
1378+ 71CA              .not_active:
1379+ 71CA
1380+ 71CA                  ; ---------------------------------------------------------------
1381+ 71CA                  ; Nessun item nella cella
1382+ 71CA                  ; ---------------------------------------------------------------
1383+ 71CA E1               pop  hl
1384+ 71CB D1               pop  de
1385+ 71CC
1386+ 71CC B7               or   a                 ; Carry = 0
1387+ 71CD C9               ret
1388+ 71CE
