2051+ 8534 29               add  hl, hl            ; *4
2052+ 8535 29               add  hl, hl            ; *8
2053+ 8536 29               add  hl, hl            ; *16
2054+ 8537 29               add  hl, hl            ; *32
2055+ 8538
2056+ 8538                  ; Aggiunge la colonna
2057+ 8538 58               ld   e, b
2058+ 8539 16 00            ld   d, 0
2059+ 853B 19               add  hl, de            ; HL = Row*32 + Col
