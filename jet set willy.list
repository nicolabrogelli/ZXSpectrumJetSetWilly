  21+ 5DED 01 48 00         ld bc, 72                   ; Numero di byte da copiare (9 caratteri * 8 byte)
  22+ 5DF0 ED B0            ldir                        ; Effettua la copia dei caratteri
  23+ 5DF2 21 00 7F         ld hl, $7F00                ; Indirizzo del nuovo set di caratteri in RAM (font start - 256)
  24+ 5DF5 22 36 5C         ld ($5C36), hl              ; Aggiornare la variabile di sistema CHARS
  25+ 5DF8 C9               ret
