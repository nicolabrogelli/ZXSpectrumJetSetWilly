1413+ 741F                  ; ---------------------------------------------------------------
1414+ 741F E1               pop  hl
1415+ 7420 D1               pop  de
1416+ 7421
1417+ 7421 37               scf                    ; Carry = 1
1418+ 7422 C9               ret
1419+ 7423
1420+ 7423              .not_active:
1421+ 7423
1422+ 7423                  ; ---------------------------------------------------------------
1423+ 7423                  ; Nessun item nella cella
1424+ 7423                  ; ---------------------------------------------------------------
1425+ 7423 E1               pop  hl
1426+ 7424 D1               pop  de
1427+ 7425
1428+ 7425 B7               or   a                 ; Carry = 0
1429+ 7426 C9               ret
