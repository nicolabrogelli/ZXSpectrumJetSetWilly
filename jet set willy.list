   4+ 68EA
   5+ 68EA
   6+ 68EA              ; -------------------------------------------------------------------
   7+ 68EA              ; Verifica se c'è una cella solida (Floor o Wall) alle coordinate pixel (X, Y)
   8+ 68EA              ; Input: C = X, B = Y
   9+ 68EA              ; Output: Carry flag impostato se solida, altrimenti resettato
  10+ 68EA              ; -------------------------------------------------------------------
  11+ 68EA              CheckSolidCell:
  12+ 68EA E5               push hl
  13+ 68EB D5               push de
  14+ 68EC C5               push bc
  15+ 68ED
  16+ 68ED                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout (Y < 24 o Y >= 152)
  17+ 68ED 78               ld   a, b
  18+ 68EE FE 18            cp   24
  19+ 68F0 38 4E            jr   c, .not_solid
  20+ 68F2 FE 98            cp   152
  21+ 68F4 30 4A            jr   nc, .not_solid
  22+ 68F6
  23+ 68F6                  ; 2. Calcola riga di layout: r = (Y - 24) / 8
  24+ 68F6 D6 18            sub  24
  25+ 68F8 CB 3F            srl  a
  26+ 68FA CB 3F            srl  a
  27+ 68FC CB 3F            srl  a                 ; A = r (0..15)
  28+ 68FE
  29+ 68FE                  ; 3. HL = r * 8
  30+ 68FE 6F               ld   l, a
  31+ 68FF 26 00            ld   h, 0
  32+ 6901 29               add  hl, hl
  33+ 6902 29               add  hl, hl
  34+ 6903 29               add  hl, hl            ; HL = r * 8
  35+ 6904
  36+ 6904                  ; 4. Calcola colonna di layout: c = X / 8 (in C)
  37+ 6904 79               ld   a, c
  38+ 6905 CB 3F            srl  a
  39+ 6907 CB 3F            srl  a
  40+ 6909 CB 3F            srl  a                 ; A = c (0..31)
  41+ 690B 4F               ld   c, a              ; C = c (salva colonna)
  42+ 690C
  43+ 690C                  ; HL = r * 8 + c / 4
  44+ 690C CB 3F            srl  a
  45+ 690E CB 3F            srl  a                 ; A = c / 4
  46+ 6910 85               add  a, l
  47+ 6911 6F               ld   l, a              ; HL = r * 8 + c / 4
  48+ 6912
  49+ 6912 ED 5B 7C 6E      ld   de, (room_ptr)
  50+ 6916 19               add  hl, de            ; HL = layout byte address
  51+ 6917 7E               ld   a, (hl)           ; A = layout byte
  52+ 6918
  53+ 6918                  ; Estrai il bit-pair corrispondente a c % 4
  54+ 6918 57               ld   d, a              ; D = layout byte
  55+ 6919 79               ld   a, c
  56+ 691A E6 03            and  3                 ; A = c % 4
  57+ 691C 28 15            jr   z, .shift_0
  58+ 691E 3D               dec  a
  59+ 691F 28 0B            jr   z, .shift_1
  60+ 6921 3D               dec  a
  61+ 6922 28 03            jr   z, .shift_2
  62+ 6924                  ; Case 3 (c % 4 = 3)
  63+ 6924 7A               ld   a, d
  64+ 6925 18 0F            jr   .got_type
  65+ 6927              .shift_2:
  66+ 6927 7A               ld   a, d
  67+ 6928 0F               rrca
  68+ 6929 0F               rrca
  69+ 692A 18 0A            jr   .got_type
  70+ 692C              .shift_1:
  71+ 692C 7A               ld   a, d
  72+ 692D 0F               rrca
  73+ 692E 0F               rrca
  74+ 692F 0F               rrca
  75+ 6930 0F               rrca
  76+ 6931 18 03            jr   .got_type
  77+ 6933              .shift_0:
  78+ 6933 7A               ld   a, d
  79+ 6934 07               rlca
  80+ 6935 07               rlca
  81+ 6936              .got_type:
  82+ 6936 E6 03            and  3                 ; A = cell type (0..3)
  83+ 6938
  84+ 6938                  ; 5. Controlla se è solida: Floor (1) o Wall (2)
  85+ 6938 FE 01            cp   1
  86+ 693A 28 09            jr   z, .solid
  87+ 693C FE 02            cp   2
  88+ 693E 28 05            jr   z, .solid
  89+ 6940
  90+ 6940              .not_solid:
  91+ 6940 C1               pop  bc
  92+ 6941 D1               pop  de
  93+ 6942 E1               pop  hl
  94+ 6943 B7               or   a                 ; Clear carry
  95+ 6944 C9               ret
  96+ 6945
  97+ 6945              .solid:
  98+ 6945 C1               pop  bc
  99+ 6946 D1               pop  de
 100+ 6947 E1               pop  hl
 101+ 6948 37               scf                    ; Set carry
 102+ 6949 C9               ret
 103+ 694A
 104+ 694A              ; -------------------------------------------------------------------
 105+ 694A              ; Applica gravità e gestisce salto
 106+ 694A              ; -------------------------------------------------------------------
 107+ 694A              ApplyGravity:
 108+ 694A ED 4B 6A 6D      ld  bc, (PlayerPos)
 109+ 694E 78               ld  a, b              ; B = PlayerY (pixel)
 110+ 694F
 111+ 694F                  ; Controlla se siamo a mezz'aria (on_ground == 0)
 112+ 694F 3A 76 6D         ld  a, (on_ground)
 113+ 6952 B7               or  a
 114+ 6953 CA 8C 69         jp  z, .in_air        ; Se siamo in volo, continua a volare
 115+ 6956
 116+ 6956                  ; Se on_ground == 1, controlliamo se siamo ancora su terreno solido
 117+ 6956                  ; Dobbiamo controllare i pixel direttamente sotto i piedi del player:
 118+ 6956                  ; (PlayerX, PlayerY + 16) e (PlayerX + 7, PlayerY + 16)
 119+ 6956 78               ld  a, b
 120+ 6957 C6 10            add  a, 16
 121+ 6959 47               ld  b, a              ; B = PlayerY + 16
 122+ 695A
 123+ 695A                  ; Controlla se la cella sotto il piede sinistro (PlayerX, PlayerY + 16) è solida
 124+ 695A CD EA 68         call CheckSolidCell
 125+ 695D 38 13            jr   c, .still_on_ground
 126+ 695F
 127+ 695F                  ; Controlla se la cella sotto il piede destro (PlayerX + 7, PlayerY + 16) è solida
 128+ 695F 79               ld   a, c
 129+ 6960 C6 07            add  a, 7
 130+ 6962 4F               ld   c, a              ; C = PlayerX + 7
 131+ 6963 CD EA 68         call CheckSolidCell
 132+ 6966 38 0A            jr   c, .still_on_ground
 133+ 6968
 134+ 6968                  ; Se nessuna delle due è solida, iniziamo a cadere!
 135+ 6968 AF               xor  a
 136+ 6969 32 76 6D         ld   (on_ground), a
 137+ 696C 32 75 6D         ld   (velocity_y), a   ; Inizia la caduta con velocità 0
 138+ 696F C3 8C 69         jp   .in_air
 139+ 6972
 140+ 6972              .still_on_ground:
 141+ 6972                  ; Siamo ancora sulla piattaforma o sul pavimento
 142+ 6972                  ; Ripristina bc originale (PlayerPos)
 143+ 6972 ED 4B 6A 6D      ld   bc, (PlayerPos)
 144+ 6976
 145+ 6976                  ; Gestisci il salto
 146+ 6976 3A 77 6D         ld   a, (jump_pressed)
 147+ 6979 B7               or   a
 148+ 697A CA 17 6A         jp   z, .end
 149+ 697D
 150+ 697D 3E 0C            ld   a, JUMP_STRENGTH
 151+ 697F 32 75 6D         ld   (velocity_y), a
 152+ 6982 AF               xor  a
 153+ 6983 32 76 6D         ld   (on_ground), a
 154+ 6986 32 77 6D         ld   (jump_pressed), a
 155+ 6989 C3 8C 69         jp   .in_air
 156+ 698C
 157+ 698C              .in_air:
 158+ 698C                  ; Applica gravità
 159+ 698C 3A 75 6D         ld  a, (velocity_y)
 160+ 698F D6 02            sub GRAVITY           ; gravity = 2
 161+ 6991
 162+ 6991                  ; Controlla se positivo per evitare bug con cp signed
 163+ 6991 CB 7F            bit 7, a
 164+ 6993 28 06            jr  z, .store_vel
 165+ 6995
 166+ 6995 FE F4            cp  -MAX_FALL_SPEED   ; -12
 167+ 6997 30 02            jr  nc, .store_vel
 168+ 6999 3E F4            ld  a, -MAX_FALL_SPEED
 169+ 699B
 170+ 699B              .store_vel:
 171+ 699B 32 75 6D         ld  (velocity_y), a
 172+ 699E
 173+ 699E                  ; Applica movimento verticale: PlayerY = PlayerY - velocity_y
 174+ 699E ED 4B 6A 6D      ld  bc, (PlayerPos)
 175+ 69A2 57               ld  d, a              ; D = velocity_y (signed)
 176+ 69A3 78               ld  a, b              ; A = PlayerY
 177+ 69A4 92               sub d                 ; A = PlayerY - velocity_y
 178+ 69A5 47               ld  b, a              ; B = new PlayerY
 179+ 69A6
 180+ 69A6                  ; Controlla se stiamo cadendo (velocity_y <= 0)
 181+ 69A6 3A 75 6D         ld  a, (velocity_y)
 182+ 69A9 CB 7F            bit 7, a              ; Se negativo, bit 7 = 1
 183+ 69AB 20 05            jr  nz, .falling_checks
 184+ 69AD B7               or  a                 ; Se zero
 185+ 69AE 28 02            jr  z, .falling_checks
 186+ 69B0 18 4B            jr  .no_collision_checks ; Se stiamo salendo, non controlliamo collisioni
 187+ 69B2
 188+ 69B2              .falling_checks:
 189+ 69B2                  ; --- CONTROLLO COLLISIONE CON IL TERRENO DURANTE LA CADUTA ---
 190+ 69B2 78               ld   a, b
 191+ 69B3 C6 10            add  a, 16
 192+ 69B5 47               ld   b, a              ; B = Nuovo Y + 16
 193+ 69B6
 194+ 69B6                  ; Controlla se il piede sinistro tocca solido
 195+ 69B6 CD EA 68         call CheckSolidCell
 196+ 69B9 38 0B            jr   c, .check_landing
 197+ 69BB
 198+ 69BB                  ; Controlla se il piede destro tocca solido
