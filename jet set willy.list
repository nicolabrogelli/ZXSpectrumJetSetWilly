 901+ 6BC5 3A F7 7D         ld   a, (ramp_len)
 902+ 6BC8 80               add  a, b              ; A = ramp_col + ramp_len
 903+ 6BC9 4F               ld   c, a              ; C = limit_right (exclusive)
 904+ 6BCA
 905+ 6BCA 7B               ld   a, e              ; A = Col
 906+ 6BCB B8               cp   b
 907+ 6BCC 38 34            jr   c, .check_platform_case ; Col < ramp_col
 908+ 6BCE B9               cp   c
 909+ 6BCF 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 910+ 6BD1
 911+ 6BD1                  ; Calcola B = Col - ramp_col
 912+ 6BD1 7B               ld   a, e
 913+ 6BD2 90               sub  b
 914+ 6BD3 47               ld   b, a              ; B = offset (0..ramp_len-1)
 915+ 6BD4
 916+ 6BD4                  ; SlopeRow = ramp_row - B
 917+ 6BD4 3A F8 7D         ld   a, (ramp_row)
 918+ 6BD7 90               sub  b
 919+ 6BD8 47               ld   b, a              ; B = SlopeRow
 920+ 6BD9 18 1F            jr   .check_row_match
 921+ 6BDB
 922+ 6BDB              .range_left:
 923+ 6BDB                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 924+ 6BDB 21 F7 7D         ld   hl, ramp_len
