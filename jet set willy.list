   8+ 87CE              ; Audio_UpdateJumpSound
   9+ 87CE              ;
  10+ 87CE              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 87CE              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 87CE              ; -------------------------------------------------------------------
  13+ 87CE              Audio_UpdateJumpSound:
  14+ 87CE F5               push af
  15+ 87CF C5               push bc
  16+ 87D0 D5               push de
  17+ 87D1 E5               push hl
  18+ 87D2
  19+ 87D2                  ; Controlla se il suono è attivo (note < 18)
  20+ 87D2 3A 42 F7         ld   a, (Audio_jump_sound_note)
  21+ 87D5 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 87D7 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 87D9
  24+ 87D9                  ; Carica la nota corrente da suonare
  25+ 87D9 5F               ld   e, a
  26+ 87DA 16 00            ld   d, 0
  27+ 87DC 21 08 88         ld   hl, Audio_JumpSoundDelays
  28+ 87DF 19               add  hl, de
  29+ 87E0 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 87E1 57               ld   d, a                      ; D = delay della nota
  31+ 87E2
  32+ 87E2                  ; Suona la nota: 15 cicli
  33+ 87E2 06 0F            ld   b, 15
  34+ 87E4              .note_loop:
  35+ 87E4                  ; Speaker ON
  36+ 87E4 3A 3B F3         ld   a, (room_border_color)
  37+ 87E7 F6 10            or   $10
  38+ 87E9 D3 FE            out  ($fe), a
  39+ 87EB 4A               ld   c, d
  40+ 87EC              .d1:
  41+ 87EC 0D               dec  c
  42+ 87ED 20 FD            jr   nz, .d1
  43+ 87EF
  44+ 87EF                  ; Speaker OFF
  45+ 87EF 3A 3B F3         ld   a, (room_border_color)
  46+ 87F2 E6 EF            and  $ef
  47+ 87F4 D3 FE            out  ($fe), a
  48+ 87F6 4A               ld   c, d
  49+ 87F7              .d2:
  50+ 87F7 0D               dec  c
  51+ 87F8 20 FD            jr   nz, .d2
  52+ 87FA
  53+ 87FA 10 E8            djnz .note_loop
  54+ 87FC
  55+ 87FC                  ; Passa alla nota successiva
  56+ 87FC 3A 42 F7         ld   a, (Audio_jump_sound_note)
  57+ 87FF 3C               inc  a
  58+ 8800 32 42 F7         ld   (Audio_jump_sound_note), a
  59+ 8803
  60+ 8803              .done:
  61+ 8803 E1               pop  hl
  62+ 8804 D1               pop  de
  63+ 8805 C1               pop  bc
  64+ 8806 F1               pop  af
  65+ 8807 C9               ret
  66+ 8808
  67+ 8808              Audio_JumpSoundDelays:
  68+ 8808 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 880C 19 13 0C 06
  68+ 8810 0C 13 19 20
  68+ 8814 26 2D 33 3A
  68+ 8818 40 47
