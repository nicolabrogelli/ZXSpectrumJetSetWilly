 589+ 6A22              ; -------------------------------------------------------------------
 590+ 6A22              ; Verifica la collisione tra player e nemico (bounding box a livello di pixel)
 591+ 6A22              ; Output: Carry flag impostato se collisione, altrimenti resettato
 592+ 6A22              ; -------------------------------------------------------------------
 593+ 6A22              CheckCollision:
 594+ 6A22 E5               push hl
 595+ 6A23 D5               push de
 596+ 6A24 C5               push bc
 597+ 6A25 DD E5            push ix
 598+ 6A27
 599+ 6A27 DD 21 E4 6D      ld   ix, ActiveEnemies
 600+ 6A2B 06 08            ld   b, 8              ; 8 slot
 601+ 6A2D              .loop:
 602+ 6A2D DD 7E 00         ld   a, (ix+0)         ; Flags
 603+ 6A30 E6 80            and  $80               ; Active?
 604+ 6A32 28 1F            jr   z, .next
 605+ 6A34
 606+ 6A34                  ; 1. Controllo orizzontale: PlayerX - EnemyX + 7 in [0, 22]
 607+ 6A34 3A 1B 7A         ld   a, (PlayerPos)    ; A = PlayerX
 608+ 6A37 DD 96 02         sub  (ix+2)            ; A = PlayerX - EnemyX (Offset 2: Current X)
 609+ 6A3A C6 07            add  a, 7              ; A = PlayerX - EnemyX + 7
 610+ 6A3C FE 17            cp   23                ; Se >= 23, nessuna collisione con questo
 611+ 6A3E 30 13            jr   nc, .next
 612+ 6A40
 613+ 6A40                  ; 2. Controllo verticale: PlayerY - EnemyY + 15 in [0, 30]
 614+ 6A40 3A 1C 7A         ld   a, (PlayerPos+1)  ; A = PlayerY
 615+ 6A43 DD 96 03         sub  (ix+3)            ; A = PlayerY - EnemyY (Offset 3: Current Y)
 616+ 6A46 C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 617+ 6A48 FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 618+ 6A4A 30 07            jr   nc, .next
 619+ 6A4C
 620+ 6A4C                  ; Collisione avvenuta!
 621+ 6A4C DD E1            pop  ix
 622+ 6A4E C1               pop  bc
 623+ 6A4F D1               pop  de
 624+ 6A50 E1               pop  hl
 625+ 6A51 37               scf                    ; Imposta carry flag
 626+ 6A52 C9               ret
 627+ 6A53
 628+ 6A53              .next:
 629+ 6A53 11 0B 00         ld   de, 11
 630+ 6A56 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 631+ 6A58 05               dec  b
 632+ 6A59 20 D2            jr   nz, .loop
 633+ 6A5B
 634+ 6A5B DD E1            pop  ix
 635+ 6A5D C1               pop  bc
 636+ 6A5E D1               pop  de
 637+ 6A5F E1               pop  hl
 638+ 6A60 B7               or   a                 ; Reset carry flag
 639+ 6A61 C9               ret
