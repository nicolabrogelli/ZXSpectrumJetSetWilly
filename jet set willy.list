 542  8B0E 21 8D 5C         ld   hl, ATTR_P
 543  8B11 77               ld   (hl), a
 544  8B12 CD AF 0D         call CLS
 545  8B15 36 07            ld   (hl), $07
 546  8B17 3E 07            ld   a, $07
 547  8B19 32 8F 5C         ld   (ATTR_T), a
 548  8B1C
 549  8B1C                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 550  8B1C C3 89 88         jp   LoadRoomAndRestart
 551  8B1F
 552  8B1F              ; -------------------------------------------------------------------
 553  8B1F              ; TriggerVictory
 554  8B1F              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 555  8B1F              ; - Pulisce gli elementi di gioco della stanza.
 556  8B1F              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 557  8B1F              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 558  8B1F              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 559  8B1F              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 560  8B1F              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 561  8B1F              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 562  8B1F              ; -------------------------------------------------------------------
 563  8B1F              TriggerVictory:
 564  8B1F                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 565  8B1F CD 15 66         call Gfx_DrawVictoryScreen
 566  8B22
 567  8B22                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 568  8B22              .wait_keys_release:
 569  8B22 76               halt
 570  8B23                  ; Controlla tasto Y (Porta $DF, bit 4)
 571  8B23 01 FE DF         ld   bc, $dffe
 572  8B26 ED 78            in   a, (c)
 573  8B28 CB 67            bit  4, a
 574  8B2A 28 F6            jr   z, .wait_keys_release
 575  8B2C
 576  8B2C                  ; Controlla tasto N (Porta $7F, bit 3)
 577  8B2C 01 FE 7F         ld   bc, $7ffe
 578  8B2F ED 78            in   a, (c)
 579  8B31 CB 5F            bit  3, a
 580  8B33 28 ED            jr   z, .wait_keys_release
 581  8B35
 582  8B35                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 583  8B35 01 FE BF         ld   bc, $bffe
 584  8B38 ED 78            in   a, (c)
 585  8B3A CB 47            bit  0, a
 586  8B3C 28 E4            jr   z, .wait_keys_release
 587  8B3E
 588  8B3E                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 589  8B3E 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 590  8B40              .wait_choice_loop:
 591  8B40 76               halt
 592  8B41
 593  8B41                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 594  8B41 0C               inc  c
 595  8B42 79               ld   a, c
 596  8B43 CB 3F            srl  a
 597  8B45 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 598  8B47 E6 07            and  7
 599  8B49 5F               ld   e, a
 600  8B4A 16 00            ld   d, 0
 601  8B4C 21 F4 64         ld   hl, victory_color_table
 602  8B4F 19               add  hl, de
 603  8B50 7E               ld   a, (hl)               ; A = nuovo colore attributo
 604  8B51 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 605  8B54 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 606  8B56              .color_cycle_loop:
 607  8B56 77               ld   (hl), a
 608  8B57 23               inc  hl
 609  8B58 10 FC            djnz .color_cycle_loop
 610  8B5A
 611  8B5A                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 612  8B5A 01 FE DF         ld   bc, $dffe
 613  8B5D ED 78            in   a, (c)
 614  8B5F CB 67            bit  4, a
 615  8B61 28 2A            jr   z, .play_again_chosen
 616  8B63
 617  8B63                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 618  8B63 01 FE 7F         ld   bc, $7ffe
 619  8B66 ED 78            in   a, (c)
 620  8B68 CB 5F            bit  3, a
 621  8B6A 28 0B            jr   z, .quit_chosen
 622  8B6C
 623  8B6C                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 624  8B6C 01 FE BF         ld   bc, $bffe
 625  8B6F ED 78            in   a, (c)
 626  8B71 CB 47            bit  0, a
 627  8B73 28 02            jr   z, .quit_chosen
 628  8B75
 629  8B75 18 C9            jr   .wait_choice_loop
 630  8B77
 631  8B77              .quit_chosen:
 632  8B77                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 633  8B77              .wait_quit_release:
 634  8B77 76               halt
 635  8B78 01 FE 7F         ld   bc, $7ffe
 636  8B7B ED 78            in   a, (c)
 637  8B7D CB 5F            bit  3, a
 638  8B7F 28 F6            jr   z, .wait_quit_release
 639  8B81 01 FE BF         ld   bc, $bffe
 640  8B84 ED 78            in   a, (c)
 641  8B86 CB 47            bit  0, a
 642  8B88 28 ED            jr   z, .wait_quit_release
 643  8B8A
 644  8B8A                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 645  8B8A C3 A7 89         jp   ShowTitleScreen
 646  8B8D
 647  8B8D              .play_again_chosen:
 648  8B8D                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 649  8B8D              .wait_play_again_release:
 650  8B8D 76               halt
 651  8B8E 01 FE DF         ld   bc, $dffe
 652  8B91 ED 78            in   a, (c)
 653  8B93 CB 67            bit  4, a
 654  8B95 28 F6            jr   z, .wait_play_again_release
 655  8B97
 656  8B97                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 657  8B97 CD 57 8C         call ResetFullGameState
 658  8B9A C3 89 88         jp   LoadRoomAndRestart
 659  8B9D
 660  8B9D              ; -------------------------------------------------------------------
 661  8B9D              ; CheckVictoryCondition
 662  8B9D              ; Verifica se si verificano contemporaneamente tutte le 3 condizioni di vittoria:
 663  8B9D              ; 1. Willy ha raccolto tutti gli oggetti collezionabili del gioco (tutti i flag in ItemsTable = 1);
 664  8B9D              ; 2. Willy si trova nella stanza Master Bedroom;
 665  8B9D              ; 3. Willy collide con un oggetto/tag di tipo Conveyor in quella stanza.
 666  8B9D              ;
 667  8B9D              ; Output:
 668  8B9D              ;   Carry Flag = 1 se la vittoria è attivata
 669  8B9D              ;   Carry Flag = 0 altrimenti
 670  8B9D              ; -------------------------------------------------------------------
 671  8B9D              CheckVictoryCondition:
 672  8B9D C5               push bc
 673  8B9E D5               push de
 674  8B9F E5               push hl
 675  8BA0
 676  8BA0                  ; 1. Condizione: tutti gli item raccolti?
 677  8BA0 CD B9 8B         call CheckAllItemsCollected
 678  8BA3 30 0F            jr   nc, .no_victory
 679  8BA5
 680  8BA5                  ; 2. Condizione: Willy è nella Master Bedroom?
 681  8BA5 CD E0 8B         call CheckInMasterBedroom
 682  8BA8 30 0A            jr   nc, .no_victory
 683  8BAA
 684  8BAA                  ; 3. Condizione: Willy collide con il conveyor?
 685  8BAA CD FC 8B         call CheckWillyConveyorCollision
 686  8BAD 30 05            jr   nc, .no_victory
 687  8BAF
 688  8BAF                  ; Tutte le condizioni sono soddisfatte contemporaneamente!
 689  8BAF E1               pop  hl
 690  8BB0 D1               pop  de
 691  8BB1 C1               pop  bc
 692  8BB2 37               scf
 693  8BB3 C9               ret
 694  8BB4
 695  8BB4              .no_victory:
 696  8BB4 E1               pop  hl
 697  8BB5 D1               pop  de
 698  8BB6 C1               pop  bc
 699  8BB7 B7               or   a
 700  8BB8 C9               ret
 701  8BB9
 702  8BB9              ; -------------------------------------------------------------------
 703  8BB9              ; CheckAllItemsCollected
 704  8BB9              ; Verifica che tutti gli item del gioco siano stati raccolti.
 705  8BB9              ; - Controllo preliminare sul conteggio/flag globale
 706  8BB9              ; - Verifica puntuale che ogni record in ItemsTable abbia flag = 1 (raccolto)
 707  8BB9              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 708  8BB9              ; -------------------------------------------------------------------
 709  8BB9              CheckAllItemsCollected:
 710  8BB9 E5               push hl
 711  8BBA 3A 69 F8         ld   a, (game_objective_completed)
 712  8BBD B7               or   a
 713  8BBE 20 07            jr   nz, .verify_flags
 714  8BC0 3A 61 F4         ld   a, (items_collected)
 715  8BC3 FE 4D            cp   TOTAL_ITEMS
 716  8BC5 38 16            jr   c, .not_all
 717  8BC7
 718  8BC7              .verify_flags:
 719  8BC7 21 BC 80         ld   hl, ItemsTable
 720  8BCA              .loop:
 721  8BCA 7E               ld   a, (hl)
 722  8BCB FE FF            cp   $FF
 723  8BCD 28 0B            jr   z, .done_all
 724  8BCF 23               inc  hl                    ; +1 X
 725  8BD0 23               inc  hl                    ; +2 Y
 726  8BD1 23               inc  hl                    ; +3 Color
 727  8BD2 23               inc  hl                    ; +4 Collected flag
 728  8BD3 7E               ld   a, (hl)
 729  8BD4 B7               or   a
 730  8BD5 28 06            jr   z, .not_all           ; Trovato un item non raccolto -> fail
 731  8BD7 23               inc  hl                    ; Prossimo record
 732  8BD8 18 F0            jr   .loop
 733  8BDA
 734  8BDA              .done_all:
 735  8BDA E1               pop  hl
 736  8BDB 37               scf
 737  8BDC C9               ret
 738  8BDD
 739  8BDD              .not_all:
 740  8BDD E1               pop  hl
 741  8BDE B7               or   a
 742  8BDF C9               ret
 743  8BE0
 744  8BE0              ; -------------------------------------------------------------------
 745  8BE0              ; CheckInMasterBedroom
 746  8BE0              ; Verifica se la stanza corrente è Master Bedroom (ID 35 / MastreBedRoomLayout)
 747  8BE0              ; Output: Carry = 1 se Master Bedroom, Carry = 0 altrimenti
 748  8BE0              ; -------------------------------------------------------------------
 749  8BE0              CheckInMasterBedroom:
 750  8BE0 E5               push hl
 751  8BE1 D5               push de
 752  8BE2 2A D7 F7         ld   hl, (room_ptr)
 753  8BE5 11 4B B4         ld   de, MastreBedRoomLayout
 754  8BE8 B7               or   a
 755  8BE9 ED 52            sbc  hl, de
 756  8BEB 28 0B            jr   z, .is_master
 757  8BED 3A 7D F7         ld   a, (current_room)
 758  8BF0 FE 23            cp   ROOM_MASTER_BEDROOM
 759  8BF2 28 04            jr   z, .is_master
 760  8BF4 D1               pop  de
 761  8BF5 E1               pop  hl
 762  8BF6 B7               or   a
 763  8BF7 C9               ret
 764  8BF8              .is_master:
 765  8BF8 D1               pop  de
 766  8BF9 E1               pop  hl
 767  8BFA 37               scf
 768  8BFB C9               ret
 769  8BFC
 770  8BFC              ; -------------------------------------------------------------------
 771  8BFC              ; CheckWillyConveyorCollision
 772  8BFC              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 773  8BFC              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 774  8BFC              ; -------------------------------------------------------------------
 775  8BFC              CheckWillyConveyorCollision:
 776  8BFC C5               push bc
 777  8BFD D5               push de
 778  8BFE E5               push hl
 779  8BFF
 780  8BFF                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 781  8BFF CD 41 76         call CheckWillyOnConveyor
 782  8C02 38 49            jr   c, .collision_detected
 783  8C04
 784  8C04                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 785  8C04 3A 7F F7         ld   a, (conveyor_len)
 786  8C07 B7               or   a
 787  8C08 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 788  8C0A
 789  8C0A                  ; B = WillyY, C = WillyX
 790  8C0A ED 4B 57 F4      ld   bc, (PlayerPos)
 791  8C0E
 792  8C0E                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 793  8C0E 3A 80 F7         ld   a, (conveyor_row)
 794  8C11 87               add  a, a                  ; *2
 795  8C12 87               add  a, a                  ; *4
 796  8C13 87               add  a, a                  ; *8
 797  8C14 5F               ld   e, a                  ; E = ConveyorTop
 798  8C15 C6 07            add  a, 7
 799  8C17 57               ld   d, a                  ; D = ConveyorBottom
 800  8C18
 801  8C18                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 802  8C18 78               ld   a, b                  ; WillyTop
 803  8C19 BA               cp   d
 804  8C1A 28 04            jr   z, .y_overlap
 805  8C1C 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 806  8C1E 18 32            jr   .no_conv_collision
 807  8C20
 808  8C20              .y_overlap:
 809  8C20 C6 0F            add  a, 15                 ; WillyBottom
 810  8C22 BB               cp   e
 811  8C23 28 04            jr   z, .x_check
 812  8C25 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 813  8C27 18 29            jr   .no_conv_collision
 814  8C29
 815  8C29              .x_check:
 816  8C29                  ; ConveyorLeft = conveyor_col * 8
 817  8C29 3A 81 F7         ld   a, (conveyor_col)
 818  8C2C 87               add  a, a                  ; *2
 819  8C2D 87               add  a, a                  ; *4
 820  8C2E 87               add  a, a                  ; *8
 821  8C2F 5F               ld   e, a                  ; E = ConveyorLeft
 822  8C30
 823  8C30                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 824  8C30 21 7F F7         ld   hl, conveyor_len
 825  8C33 3A 81 F7         ld   a, (conveyor_col)
 826  8C36 86               add  a, (hl)
 827  8C37 87               add  a, a                  ; *2
 828  8C38 87               add  a, a                  ; *4
 829  8C39 87               add  a, a                  ; *8
 830  8C3A 3D               dec  a                     ; ConveyorRight
 831  8C3B 57               ld   d, a                  ; D = ConveyorRight
 832  8C3C
 833  8C3C                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 834  8C3C 79               ld   a, c                  ; WillyLeft
 835  8C3D BA               cp   d
 836  8C3E 28 04            jr   z, .x_overlap
 837  8C40 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 838  8C42 18 0E            jr   .no_conv_collision
 839  8C44
 840  8C44              .x_overlap:
 841  8C44 C6 0F            add  a, 15                 ; WillyRight
 842  8C46 BB               cp   e
 843  8C47 28 04            jr   z, .collision_detected
 844  8C49 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 845  8C4B 18 05            jr   .no_conv_collision
 846  8C4D
 847  8C4D              .collision_detected:
 848  8C4D E1               pop  hl
 849  8C4E D1               pop  de
 850  8C4F C1               pop  bc
 851  8C50 37               scf
 852  8C51 C9               ret
 853  8C52
 854  8C52              .no_conv_collision:
 855  8C52 E1               pop  hl
 856  8C53 D1               pop  de
 857  8C54 C1               pop  bc
 858  8C55 B7               or   a
 859  8C56 C9               ret
 860  8C57
 861  8C57              ; -------------------------------------------------------------------
 862  8C57              ; ResetFullGameState
 863  8C57              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 864  8C57              ; per l'avvio di una nuova partita dopo il Game Over.
 865  8C57              ; -------------------------------------------------------------------
 866  8C57              ResetFullGameState:
 867  8C57                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 868  8C57 AF               xor  a
 869  8C58 D3 FE            out  ($fe), a              ; Bordo a nero
 870  8C5A 21 8D 5C         ld   hl, ATTR_P
 871  8C5D 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 872  8C5E CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 873  8C61 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 874  8C63 3E 07            ld   a, $07
 875  8C65 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 876  8C68
 877  8C68                  ; Ripristina il numero di vite iniziali
 878  8C68 3E 07            ld   a, INITIAL_LIVES
 879  8C6A 32 64 F4         ld   (willy_lives), a
 880  8C6D
 881  8C6D                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 882  8C6D AF               xor  a
 883  8C6E 32 61 F4         ld   (items_collected), a
 884  8C71 32 5D F4         ld   (body_state), a
 885  8C74 32 70 F4         ld   (w_warp_state), a
 886  8C77 32 73 F4         ld   (w_key_prev), a
 887  8C7A 32 74 F4         ld   (enter_key_prev), a
 888  8C7D 32 65 F4         ld   (velocity_y), a
 889  8C80 32 67 F4         ld   (jump_pressed), a
 890  8C83 32 69 F4         ld   (coyote_timer), a
 891  8C86 32 6C F4         ld   (jump_frame), a
 892  8C89 32 6B F4         ld   (jump_dir), a
 893  8C8C 32 DD F7         ld   (transition_active), a
 894  8C8F 32 61 F8         ld   (willy_safety_timer), a
 895  8C92 3E FF            ld   a, $ff
 896  8C94 32 75 F4         ld   (digit_key_prev), a
 897  8C97 3E 01            ld   a, 1
 898  8C99 32 6E F4         ld   (q_prev), a
 899  8C9C 32 6F F4         ld   (a_prev), a
 900  8C9F 32 66 F4         ld   (on_ground), a
 901  8CA2
 902  8CA2                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 903  8CA2 3E 30            ld   a, '0'
 904  8CA4 32 F9 68         ld   (status_line + 16), a
 905  8CA7 32 FA 68         ld   (status_line + 17), a
 906  8CAA 32 FB 68         ld   (status_line + 18), a
 907  8CAD
 908  8CAD                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 909  8CAD CD 18 86         call ResetItemsTable
 910  8CB0
 911  8CB0                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 912  8CB0 CD 21 6E         call InitRoomEntryPositions
 913  8CB3
 914  8CB3                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 915  8CB3 3E 07            ld   a, 7
 916  8CB5 32 64 F8         ld   (time_hours), a
 917  8CB8 AF               xor  a
 918  8CB9 32 65 F8         ld   (time_minutes), a
 919  8CBC 32 66 F8         ld   (time_period), a       ; 0 = AM
 920  8CBF 32 69 F8         ld   (game_objective_completed), a
 921  8CC2 2A 78 F4         ld   hl, (counter)
 922  8CC5 22 67 F8         ld   (time_last_counter), hl
 923  8CC8 CD 6B 68         call Gfx_UpdateTimeDisplay
 924  8CCB
 925  8CCB                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 926  8CCB 21 0F B2         ld   hl, TheBathroomLayout; TheOffLicenceLayout
 927  8CCE 22 D7 F7         ld   (room_ptr), hl
 928  8CD1
 929  8CD1 C9               ret
 930  8CD2
 931  8CD2              ; -------------------------------------------------------------------
 932  8CD2              ; Time_UpdateClock
 933  8CD2              ; Gestisce lo scorrimento del tempo durante il gioco.
 934  8CD2              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 935  8CD2              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 936  8CD2              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 937  8CD2              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 938  8CD2              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 939  8CD2              ; sia completato, scatena immediatamente il Game Over.
 940  8CD2              ; -------------------------------------------------------------------
 941  8CD2              Time_UpdateClock:
 942  8CD2                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 943  8CD2 2A 78 F4         ld   hl, (counter)
 944  8CD5 ED 5B 67 F8      ld   de, (time_last_counter)
 945  8CD9 B7               or   a
 946  8CDA ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 947  8CDC
 948  8CDC                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 949  8CDC 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 950  8CDF B7               or   a
 951  8CE0 ED 52            sbc  hl, de
 952  8CE2 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 953  8CE3
 954  8CE3                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 955  8CE3 2A 67 F8         ld   hl, (time_last_counter)
 956  8CE6 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 957  8CE9 19               add  hl, de
 958  8CEA 22 67 F8         ld   (time_last_counter), hl
 959  8CED
 960  8CED                  ; Incrementa di 1 minuto il tempo di gioco
 961  8CED 3A 65 F8         ld   a, (time_minutes)
 962  8CF0 3C               inc  a
 963  8CF1 FE 3C            cp   60
 964  8CF3 38 21            jr   c, .minutes_ok
 965  8CF5
 966  8CF5                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 967  8CF5 AF               xor  a
 968  8CF6 32 65 F8         ld   (time_minutes), a
 969  8CF9 3A 64 F8         ld   a, (time_hours)
 970  8CFC 3C               inc  a
 971  8CFD FE 0C            cp   12
 972  8CFF 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 973  8D01 FE 0D            cp   13
 974  8D03 38 0E            jr   c, .hours_ok
 975  8D05 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 976  8D07 18 0A            jr   .hours_ok
 977  8D09
 978  8D09              .toggle_period:
 979  8D09 F5               push af                     ; Salva A (valore 12)
 980  8D0A 3A 66 F8         ld   a, (time_period)
 981  8D0D EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 982  8D0F 32 66 F8         ld   (time_period), a
 983  8D12 F1               pop  af                     ; Ripristina A = 12
 984  8D13
 985  8D13              .hours_ok:
 986  8D13 32 64 F8         ld   (time_hours), a
 987  8D16
 988  8D16              .minutes_ok:
 989  8D16 32 65 F8         ld   (time_minutes), a
