   8+ 81E5              ; Audio_UpdateJumpSound
   9+ 81E5              ;
  10+ 81E5              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 81E5              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 81E5              ; -------------------------------------------------------------------
  13+ 81E5              Audio_UpdateJumpSound:
  14+ 81E5 F5               push af
  15+ 81E6 C5               push bc
  16+ 81E7 D5               push de
  17+ 81E8 E5               push hl
  18+ 81E9
  19+ 81E9                  ; Controlla se il suono è attivo (note < 18)
  20+ 81E9 3A D0 EA         ld   a, (Audio_jump_sound_note)
  21+ 81EC FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 81EE 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 81F0
  24+ 81F0                  ; Carica la nota corrente da suonare
  25+ 81F0 5F               ld   e, a
  26+ 81F1 16 00            ld   d, 0
  27+ 81F3 21 1F 82         ld   hl, Audio_JumpSoundDelays
  28+ 81F6 19               add  hl, de
  29+ 81F7 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 81F8 57               ld   d, a                      ; D = delay della nota
  31+ 81F9
  32+ 81F9                  ; Suona la nota: 15 cicli
  33+ 81F9 06 0F            ld   b, 15
  34+ 81FB              .note_loop:
  35+ 81FB                  ; Speaker ON
  36+ 81FB 3A C9 E6         ld   a, (room_border_color)
  37+ 81FE F6 10            or   $10
  38+ 8200 D3 FE            out  ($fe), a
  39+ 8202 4A               ld   c, d
  40+ 8203              .d1:
  41+ 8203 0D               dec  c
  42+ 8204 20 FD            jr   nz, .d1
  43+ 8206
  44+ 8206                  ; Speaker OFF
  45+ 8206 3A C9 E6         ld   a, (room_border_color)
  46+ 8209 E6 EF            and  $ef
  47+ 820B D3 FE            out  ($fe), a
  48+ 820D 4A               ld   c, d
  49+ 820E              .d2:
  50+ 820E 0D               dec  c
  51+ 820F 20 FD            jr   nz, .d2
  52+ 8211
  53+ 8211 10 E8            djnz .note_loop
  54+ 8213
  55+ 8213                  ; Passa alla nota successiva
  56+ 8213 3A D0 EA         ld   a, (Audio_jump_sound_note)
  57+ 8216 3C               inc  a
  58+ 8217 32 D0 EA         ld   (Audio_jump_sound_note), a
  59+ 821A
  60+ 821A              .done:
  61+ 821A E1               pop  hl
  62+ 821B D1               pop  de
  63+ 821C C1               pop  bc
  64+ 821D F1               pop  af
  65+ 821E C9               ret
