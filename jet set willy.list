1045+ 6AC2 0F               rrca
1046+ 6AC3 0F               rrca
1047+ 6AC4 E6 03            and  3
1048+ 6AC6 12               ld   (de), a
1049+ 6AC7 13               inc  de
1050+ 6AC8
1051+ 6AC8                  ; Cella 3: bit 1-0
1052+ 6AC8 79               ld   a, c
1053+ 6AC9 E6 03            and  3
1054+ 6ACB 12               ld   (de), a
1055+ 6ACC 13               inc  de
1056+ 6ACD
1057+ 6ACD 10 E0            djnz .byte_loop
