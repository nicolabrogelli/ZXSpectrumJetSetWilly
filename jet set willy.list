   8+ 87F6              ; Audio_UpdateJumpSound
   9+ 87F6              ;
  10+ 87F6              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 87F6              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 87F6              ; -------------------------------------------------------------------
  13+ 87F6              Audio_UpdateJumpSound:
  14+ 87F6 F5               push af
  15+ 87F7 C5               push bc
  16+ 87F8 D5               push de
  17+ 87F9 E5               push hl
  18+ 87FA
  19+ 87FA                  ; Controlla se il suono è attivo (note < 18)
  20+ 87FA 3A 6A F8         ld   a, (Audio_jump_sound_note)
  21+ 87FD FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 87FF 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8801
  24+ 8801                  ; Carica la nota corrente da suonare
  25+ 8801 5F               ld   e, a
  26+ 8802 16 00            ld   d, 0
  27+ 8804 21 30 88         ld   hl, Audio_JumpSoundDelays
  28+ 8807 19               add  hl, de
  29+ 8808 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8809 57               ld   d, a                      ; D = delay della nota
  31+ 880A
  32+ 880A                  ; Suona la nota: 15 cicli
  33+ 880A 06 0F            ld   b, 15
  34+ 880C              .note_loop:
  35+ 880C                  ; Speaker ON
  36+ 880C 3A 63 F4         ld   a, (room_border_color)
  37+ 880F F6 10            or   $10
  38+ 8811 D3 FE            out  ($fe), a
  39+ 8813 4A               ld   c, d
  40+ 8814              .d1:
  41+ 8814 0D               dec  c
  42+ 8815 20 FD            jr   nz, .d1
  43+ 8817
  44+ 8817                  ; Speaker OFF
  45+ 8817 3A 63 F4         ld   a, (room_border_color)
  46+ 881A E6 EF            and  $ef
  47+ 881C D3 FE            out  ($fe), a
  48+ 881E 4A               ld   c, d
  49+ 881F              .d2:
  50+ 881F 0D               dec  c
  51+ 8820 20 FD            jr   nz, .d2
  52+ 8822
  53+ 8822 10 E8            djnz .note_loop
  54+ 8824
  55+ 8824                  ; Passa alla nota successiva
  56+ 8824 3A 6A F8         ld   a, (Audio_jump_sound_note)
  57+ 8827 3C               inc  a
  58+ 8828 32 6A F8         ld   (Audio_jump_sound_note), a
  59+ 882B
  60+ 882B              .done:
  61+ 882B E1               pop  hl
  62+ 882C D1               pop  de
  63+ 882D C1               pop  bc
  64+ 882E F1               pop  af
  65+ 882F C9               ret
  66+ 8830
  67+ 8830              Audio_JumpSoundDelays:
  68+ 8830 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 8834 19 13 0C 06
  68+ 8838 0C 13 19 20
