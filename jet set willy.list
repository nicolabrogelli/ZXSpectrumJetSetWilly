 744+ 78AB
 745+ 78AB              ; -------------------------------------------------------------------
 746+ 78AB              ; Items_DrawRoom
 747+ 78AB              ;
 748+ 78AB              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 749+ 78AB              ;
 750+ 78AB              ; Operazioni eseguite:
 751+ 78AB              ;   1. Azzera la griglia items_grid.
 752+ 78AB              ;   2. Svuota la cache degli oggetti attivi.
 753+ 78AB              ;   3. Scansiona ItemsTable.
 754+ 78AB              ;   4. Per ogni item della stanza corrente:
 755+ 78AB              ;        - verifica se è già stato raccolto
 756+ 78AB              ;        - disegna la grafica
 757+ 78AB              ;        - aggiorna items_grid
 758+ 78AB              ;        - memorizza l'item nella cache current_room_items
 759+ 78AB              ;   5. Aggiorna num_room_items.
 760+ 78AB              ;
 761+ 78AB              ; Record ItemsTable:
 762+ 78AB              ;   +0  Room ID
 763+ 78AB              ;   +1  X (colonna)
 764+ 78AB              ;   +2  Y (riga)
 765+ 78AB              ;   +3  Colore
 766+ 78AB              ;   +4  Collected flag
 767+ 78AB              ;
 768+ 78AB              ; Cache current_room_items:
 769+ 78AB              ;   +0  Colonna
 770+ 78AB              ;   +1  Riga
 771+ 78AB              ;   +2  Colore
 772+ 78AB              ;   +3  Collected flag ptr (Low)
 773+ 78AB              ;   +4  Collected flag ptr (High)
 774+ 78AB              ;
 775+ 78AB              ; Ogni record cache occupa 5 byte.
 776+ 78AB              ; -------------------------------------------------------------------
 777+ 78AB              Items_DrawRoom:
 778+ 78AB
 779+ 78AB                  ; Salva tutti i registri utilizzati
 780+ 78AB E5               push hl
 781+ 78AC D5               push de
 782+ 78AD C5               push bc
 783+ 78AE DD E5            push ix
 784+ 78B0 FD E5            push iy
 785+ 78B2
 786+ 78B2                  ; ---------------------------------------------------------------
 787+ 78B2                  ; Azzera items_grid (32 x 16 = 512 byte)
 788+ 78B2                  ; ---------------------------------------------------------------
 789+ 78B2 21 EC CC         ld   hl, items_grid
 790+ 78B5 11 ED CC         ld   de, items_grid + 1
 791+ 78B8 36 00            ld   (hl), 0
 792+ 78BA 01 FF 01         ld   bc, 511
 793+ 78BD ED B0            ldir
 794+ 78BF
 795+ 78BF                  ; ---------------------------------------------------------------
 796+ 78BF                  ; Nessun item attivo nella stanza
 797+ 78BF                  ; ---------------------------------------------------------------
 798+ 78BF AF               xor  a
 799+ 78C0 32 54 7E         ld   (num_room_items), a
 800+ 78C3
 801+ 78C3                  ; IY punta alla cache degli item attivi
 802+ 78C3 FD 21 04 7E      ld   iy, current_room_items
 803+ 78C7
 804+ 78C7                  ; ---------------------------------------------------------------
 805+ 78C7                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 806+ 78C7                  ; alla stanza corrente.
 807+ 78C7                  ;
 808+ 78C7                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 809+ 78C7                  ; ---------------------------------------------------------------
 810+ 78C7 2A 55 7E         ld   hl, (room_ptr)
 811+ 78CA 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 812+ 78CD 19               add  hl, de
 813+ 78CE
 814+ 78CE E5               push hl
 815+ 78CF DD E1            pop  ix                ; IX = bitmap item
 816+ 78D1
 817+ 78D1                  ; ---------------------------------------------------------------
 818+ 78D1                  ; Inizio scansione della tabella degli item
 819+ 78D1                  ; ---------------------------------------------------------------
 820+ 78D1 21 2F 75         ld   hl, ItemsTable
 821+ 78D4
 822+ 78D4              .loop:
 823+ 78D4
 824+ 78D4                  ; ---------------------------------------------------------------
 825+ 78D4                  ; Legge il Room ID del record corrente
 826+ 78D4                  ; ---------------------------------------------------------------
 827+ 78D4 7E               ld   a, (hl)
 828+ 78D5
 829+ 78D5                  ; $FF indica fine tabella
 830+ 78D5 FE FF            cp   $FF
 831+ 78D7 28 53            jr   z, .done
 832+ 78D9
 833+ 78D9                  ; ---------------------------------------------------------------
 834+ 78D9                  ; Verifica se l'item appartiene alla stanza corrente
 835+ 78D9                  ; ---------------------------------------------------------------
 836+ 78D9 57               ld   d, a
 837+ 78DA
 838+ 78DA 3A FB 7D         ld   a, (current_room)
 839+ 78DD BA               cp   d
 840+ 78DE 20 45            jr   nz, .next_item
 841+ 78E0
 842+ 78E0                  ; ---------------------------------------------------------------
 843+ 78E0                  ; Legge i dati dell'item
 844+ 78E0                  ; ---------------------------------------------------------------
 845+ 78E0
 846+ 78E0 23               inc  hl
 847+ 78E1 4E               ld   c, (hl)           ; X (colonna)
 848+ 78E2
 849+ 78E2 23               inc  hl
 850+ 78E3 46               ld   b, (hl)           ; Y (riga)
 851+ 78E4
 852+ 78E4 23               inc  hl
 853+ 78E5 5E               ld   e, (hl)           ; Colore
 854+ 78E6
 855+ 78E6 23               inc  hl
 856+ 78E7 7E               ld   a, (hl)           ; Collected flag
 857+ 78E8
 858+ 78E8                  ; Se diverso da zero l'item è già stato raccolto
 859+ 78E8 B7               or   a
 860+ 78E9 20 3E            jr   nz, .next_no_inc
 861+ 78EB
 862+ 78EB                  ; ---------------------------------------------------------------
 863+ 78EB                  ; Disegna l'item sullo schermo
 864+ 78EB                  ;
 865+ 78EB                  ; B = Row
 866+ 78EB                  ; C = Column
 867+ 78EB                  ; HL = bitmap pointer
 868+ 78EB                  ; E = Color
 869+ 78EB                  ; ---------------------------------------------------------------
 870+ 78EB E5               push hl
 871+ 78EC
 872+ 78EC DD E5            push ix
 873+ 78EE E1               pop  hl
 874+ 78EF
 875+ 78EF CD 34 79         call DrawItemGraphic
 876+ 78F2
 877+ 78F2 E1               pop  hl                ; ritorna al flag collected
 878+ 78F3
 879+ 78F3                  ; ---------------------------------------------------------------
 880+ 78F3                  ; Aggiorna items_grid
 881+ 78F3                  ;
 882+ 78F3                  ; Calcolo:
 883+ 78F3                  ;   offset = Row * 32 + Col
 884+ 78F3                  ; ---------------------------------------------------------------
 885+ 78F3 E5               push hl
 886+ 78F4 D5               push de
 887+ 78F5
 888+ 78F5 26 00            ld   h, 0
 889+ 78F7 68               ld   l, b              ; HL = Row
 890+ 78F8
 891+ 78F8 29               add  hl, hl            ; *2
 892+ 78F9 29               add  hl, hl            ; *4
 893+ 78FA 29               add  hl, hl            ; *8
 894+ 78FB 29               add  hl, hl            ; *16
 895+ 78FC 29               add  hl, hl            ; *32
 896+ 78FD
 897+ 78FD 16 00            ld   d, 0
 898+ 78FF 59               ld   e, c              ; DE = Col
 899+ 7900
 900+ 7900 19               add  hl, de            ; Row*32 + Col
 901+ 7901
 902+ 7901 11 EC CC         ld   de, items_grid
 903+ 7904 19               add  hl, de            ; puntatore nella griglia
 904+ 7905
 905+ 7905 D1               pop  de                ; ripristina colore
 906+ 7906
 907+ 7906 73               ld   (hl), e           ; salva colore cella
 908+ 7907
 909+ 7907 E1               pop  hl
 910+ 7908
 911+ 7908                  ; ---------------------------------------------------------------
 912+ 7908                  ; Salva l'item nella cache della stanza
 913+ 7908                  ;
 914+ 7908                  ; Questo evita di dover scansionare tutta ItemsTable
 915+ 7908                  ; durante il controllo delle collisioni.
 916+ 7908                  ; ---------------------------------------------------------------
 917+ 7908
 918+ 7908 FD 71 00         ld   (iy+0), c         ; Colonna
 919+ 790B FD 70 01         ld   (iy+1), b         ; Riga
 920+ 790E FD 73 02         ld   (iy+2), e         ; Colore
 921+ 7911
 922+ 7911                  ; Salva il puntatore al flag "collected"
 923+ 7911 FD 75 03         ld   (iy+3), l         ; Low byte
 924+ 7914 FD 74 04         ld   (iy+4), h         ; High byte
 925+ 7917
 926+ 7917                  ; Passa al record successivo della cache
 927+ 7917 01 05 00         ld   bc, 5
 928+ 791A FD 09            add  iy, bc
 929+ 791C
 930+ 791C                  ; Incrementa il numero di item attivi
 931+ 791C 3A 54 7E         ld   a, (num_room_items)
 932+ 791F 3C               inc  a
 933+ 7920 32 54 7E         ld   (num_room_items), a
 934+ 7923
 935+ 7923 18 04            jr   .next_no_inc
 936+ 7925
 937+ 7925              .next_item:
 938+ 7925
 939+ 7925                  ; ---------------------------------------------------------------
 940+ 7925                  ; L'item non appartiene alla stanza corrente.
 941+ 7925                  ; Salta i campi del record:
 942+ 7925                  ;   X
 943+ 7925                  ;   Y
 944+ 7925                  ;   Color
 945+ 7925                  ;   Collected
 946+ 7925                  ; ---------------------------------------------------------------
 947+ 7925 23               inc  hl
 948+ 7926 23               inc  hl
 949+ 7927 23               inc  hl
 950+ 7928 23               inc  hl
 951+ 7929
 952+ 7929              .next_no_inc:
 953+ 7929
 954+ 7929                  ; ---------------------------------------------------------------
 955+ 7929                  ; Avanza al record successivo
 956+ 7929                  ; (prossimo Room ID)
 957+ 7929                  ; ---------------------------------------------------------------
 958+ 7929 23               inc  hl
 959+ 792A 18 A8            jr   .loop
 960+ 792C
 961+ 792C              .done:
 962+ 792C
 963+ 792C                  ; Ripristina i registri
 964+ 792C FD E1            pop  iy
 965+ 792E DD E1            pop  ix
 966+ 7930 D1               pop  de
 967+ 7931 C1               pop  bc
 968+ 7932 E1               pop  hl
 969+ 7933
 970+ 7933 C9               ret
 971+ 7934
 972+ 7934              ; -------------------------------------------------------------------
 973+ 7934              ; DrawItemGraphic
 974+ 7934              ;
 975+ 7934              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 976+ 7934              ; utilizzando una bitmap di 8 byte e un attributo colore.
 977+ 7934              ;
 978+ 7934              ; Input:
 979+ 7934              ;   B = Riga attributi (3..18)
 980+ 7934              ;   C = Colonna attributi (0..31)
 981+ 7934              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 982+ 7934              ;   E = Attributo colore
 983+ 7934              ;
 984+ 7934              ; Output:
 985+ 7934              ;   Nessuno
 986+ 7934              ;
 987+ 7934              ; Registri preservati:
 988+ 7934              ;   BC, DE, HL
 989+ 7934              ; -------------------------------------------------------------------
 990+ 7934              DrawItemGraphic:
 991+ 7934
 992+ 7934                  ; Salva i registri originali
 993+ 7934 C5               push bc
 994+ 7935 D5               push de
 995+ 7936 E5               push hl
 996+ 7937
 997+ 7937                  ; ---------------------------------------------------------------
 998+ 7937                  ; Calcolo indirizzo bitmap dello Spectrum
 999+ 7937                  ;
1000+ 7937                  ; Ogni item occupa una cella attributi (8x8 pixel).
1001+ 7937                  ;
1002+ 7937                  ; Formula:
1003+ 7937                  ;   High = $40 + (Row AND $18)
1004+ 7937                  ;   Low  = (Row AND 7) * 32 + Col
1005+ 7937                  ;
1006+ 7937                  ; DE conterrà l'indirizzo della prima scanline.
1007+ 7937                  ; ---------------------------------------------------------------
1008+ 7937
1009+ 7937 78               ld   a, b
1010+ 7938 E6 18            and  $18
1011+ 793A C6 40            add  a, $40
1012+ 793C 57               ld   d, a              ; Byte alto indirizzo video
1013+ 793D
1014+ 793D 78               ld   a, b
1015+ 793E E6 07            and  7                 ; Riga interna al blocco da 8
1016+ 7940
1017+ 7940 87               add  a, a              ; *2
1018+ 7941 87               add  a, a              ; *4
1019+ 7942 87               add  a, a              ; *8
1020+ 7943 87               add  a, a              ; *16
1021+ 7944 87               add  a, a              ; *32
1022+ 7945
1023+ 7945 81               add  a, c              ; + colonna
1024+ 7946
1025+ 7946 5F               ld   e, a              ; Byte basso indirizzo video
1026+ 7947
1027+ 7947                  ; ---------------------------------------------------------------
1028+ 7947                  ; Disegno bitmap
1029+ 7947                  ;
1030+ 7947                  ; Copia 8 byte consecutivi nella memoria video.
1031+ 7947                  ; Ogni byte rappresenta una scanline da 8 pixel.
1032+ 7947                  ; ---------------------------------------------------------------
1033+ 7947
1034+ 7947 C5               push bc                ; Conserva Row e Col
1035+ 7948
1036+ 7948 06 08            ld   b, 8              ; Numero scanline
1037+ 794A
1038+ 794A              .line_loop:
1039+ 794A
1040+ 794A 7E               ld   a, (hl)           ; Legge scanline bitmap
1041+ 794B 12               ld   (de), a           ; Scrive nella memoria video
1042+ 794C
1043+ 794C 14               inc  d                 ; Scanline successiva
1044+ 794D 23               inc  hl                ; Byte bitmap successivo
1045+ 794E
1046+ 794E 05               dec  b
1047+ 794F 20 F9            jr   nz, .line_loop
1048+ 7951
1049+ 7951 C1               pop  bc                ; Ripristina Row e Col
1050+ 7952
1051+ 7952                  ; ---------------------------------------------------------------
1052+ 7952                  ; Calcolo indirizzo attributo
1053+ 7952                  ;
1054+ 7952                  ; Formula:
1055+ 7952                  ;   AttrAddr = $5800 + Row * 32 + Col
1056+ 7952                  ;
1057+ 7952                  ; HL conterrà l'indirizzo della cella attributi.
1058+ 7952                  ; ---------------------------------------------------------------
1059+ 7952
1060+ 7952 26 00            ld   h, 0
1061+ 7954 68               ld   l, b              ; HL = Row
1062+ 7955
1063+ 7955 29               add  hl, hl            ; *2
1064+ 7956 29               add  hl, hl            ; *4
1065+ 7957 29               add  hl, hl            ; *8
1066+ 7958 29               add  hl, hl            ; *16
1067+ 7959 29               add  hl, hl            ; *32
1068+ 795A
1069+ 795A 79               ld   a, c              ; A = Colonna
1070+ 795B
1071+ 795B 85               add  a, l
1072+ 795C 6F               ld   l, a
1073+ 795D
1074+ 795D 30 01            jr   nc, .no_carry
1075+ 795F 24               inc  h
1076+ 7960
1077+ 7960              .no_carry:
1078+ 7960
1079+ 7960                  ; HL = Row * 32 + Col
1080+ 7960
1081+ 7960 11 00 58         ld   de, $5800
1082+ 7963 19               add  hl, de            ; HL = indirizzo attributi
1083+ 7964
1084+ 7964                  ; ---------------------------------------------------------------
1085+ 7964                  ; Recupera il colore originale dallo stack.
1086+ 7964                  ;
1087+ 7964                  ; Layout stack:
1088+ 7964                  ;   HL originale
1089+ 7964                  ;   DE originale (E = colore)
1090+ 7964                  ;   BC originale
1091+ 7964                  ; ---------------------------------------------------------------
1092+ 7964
1093+ 7964 C1               pop  bc                ; Recupera HL originale
1094+ 7965 D1               pop  de                ; Recupera DE originale
1095+ 7966
1096+ 7966                  ; ---------------------------------------------------------------
1097+ 7966                  ; Scrive l'attributo colore
1098+ 7966                  ; ---------------------------------------------------------------
1099+ 7966
1100+ 7966 7B               ld   a, e              ; A = colore
1101+ 7967 77               ld   (hl), a           ; Scrive nella RAM attributi
1102+ 7968
1103+ 7968                  ; ---------------------------------------------------------------
1104+ 7968                  ; Ripristina HL e BC originali
1105+ 7968                  ; ---------------------------------------------------------------
1106+ 7968
1107+ 7968 C5               push bc
1108+ 7969 E1               pop  hl                ; HL originale
1109+ 796A
1110+ 796A C1               pop  bc                ; BC originale
1111+ 796B
1112+ 796B C9               ret
1113+ 796C
1114+ 796C              ; -------------------------------------------------------------------
1115+ 796C              ; RestoreBackgroundCell
1116+ 796C              ;
1117+ 796C              ; Ripristina il contenuto originale di una cella della stanza.
1118+ 796C              ; Viene utilizzata principalmente quando un item viene raccolto:
1119+ 796C              ; invece di lasciare un "buco", la routine ridisegna il tile
1120+ 796C              ; originale presente nella mappa della stanza.
1121+ 796C              ;
1122+ 796C              ; Input:
1123+ 796C              ;   B = Row (3..18)
1124+ 796C              ;   C = Col (0..31)
1125+ 796C              ;
1126+ 796C              ; Utilizza:
1127+ 796C              ;   room_ptr -> struttura dati della stanza corrente
1128+ 796C              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1129+ 796C              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1130+ 796C              ;
1131+ 796C              ; Tipi di cella:
1132+ 796C              ;   0 = Background
1133+ 796C              ;   1 = Floor
1134+ 796C              ;   2 = Wall
1135+ 796C              ;   3 = Nasty
1136+ 796C              ; -------------------------------------------------------------------
1137+ 796C              RestoreBackgroundCell:
1138+ 796C
1139+ 796C                  ; Salva tutti i registri utilizzati
1140+ 796C FD E5            push iy
1141+ 796E C5               push bc
1142+ 796F D5               push de
1143+ 7970 E5               push hl
1144+ 7971 DD E5            push ix
1145+ 7973
1146+ 7973                  ; ---------------------------------------------------------------
1147+ 7973                  ; Conserva Row e Col in IY.
1148+ 7973                  ;
1149+ 7973                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1150+ 7973                  ; BC potrebbe essere modificato.
1151+ 7973                  ; ---------------------------------------------------------------
1152+ 7973 C5               push bc
1153+ 7974 FD E1            pop  iy                ; IYH = Row, IYL = Col
1154+ 7976
1155+ 7976                  ; ---------------------------------------------------------------
1156+ 7976                  ; Determina quale tipo di cella è presente nella posizione
1157+ 7976                  ; specificata.
1158+ 7976                  ;
1159+ 7976                  ; Input:
1160+ 7976                  ;   B = Row
1161+ 7976                  ;   C = Col
1162+ 7976                  ;
1163+ 7976                  ; Output:
1164+ 7976                  ;   A = tipo cella
1165+ 7976                  ; ---------------------------------------------------------------
1166+ 7976 78               ld   a, b
1167+ 7977
1168+ 7977 CD E3 6C         call GetCellFromUnpacked
1169+ 797A
1170+ 797A                  ; ---------------------------------------------------------------
1171+ 797A                  ; Recupera il puntatore alla stanza corrente.
1172+ 797A                  ;
1173+ 797A                  ; DE = base della struttura stanza
1174+ 797A                  ; ---------------------------------------------------------------
1175+ 797A ED 5B 55 7E      ld   de, (room_ptr)
1176+ 797E
1177+ 797E                  ; ---------------------------------------------------------------
1178+ 797E                  ; Seleziona il tile corretto in base al tipo di cella.
1179+ 797E                  ;
1180+ 797E                  ; A = 0 -> Background
1181+ 797E                  ; A = 1 -> Floor
1182+ 797E                  ; A = 2 -> Wall
1183+ 797E                  ; A = 3 -> Nasty
1184+ 797E                  ; ---------------------------------------------------------------
1185+ 797E
1186+ 797E B7               or   a
1187+ 797F 20 06            jr   nz, .not_bg
1188+ 7981
1189+ 7981                  ; Background
1190+ 7981 21 A0 00         ld   hl, OFFSET_BG
1191+ 7984 19               add  hl, de
1192+ 7985 18 16            jr   .draw_cell
1193+ 7987
1194+ 7987              .not_bg:
1195+ 7987
1196+ 7987 3D               dec  a
1197+ 7988 20 06            jr   nz, .not_floor
1198+ 798A
1199+ 798A                  ; Floor
1200+ 798A 21 A9 00         ld   hl, OFFSET_FLOOR
1201+ 798D 19               add  hl, de
1202+ 798E 18 0D            jr   .draw_cell
1203+ 7990
1204+ 7990              .not_floor:
1205+ 7990
1206+ 7990 3D               dec  a
1207+ 7991 20 06            jr   nz, .not_wall
1208+ 7993
1209+ 7993                  ; Wall
1210+ 7993 21 B2 00         ld   hl, OFFSET_WALL
1211+ 7996 19               add  hl, de
1212+ 7997 18 04            jr   .draw_cell
1213+ 7999
1214+ 7999              .not_wall:
1215+ 7999
1216+ 7999                  ; Nasty
1217+ 7999 21 BB 00         ld   hl, OFFSET_NASTY
1218+ 799C 19               add  hl, de
1219+ 799D
1220+ 799D              .draw_cell:
1221+ 799D
1222+ 799D                  ; ---------------------------------------------------------------
1223+ 799D                  ; HL punta ora alla grafica del tile da ridisegnare.
1224+ 799D                  ;
1225+ 799D                  ; Gfx_DrawTile si aspetta:
1226+ 799D                  ;   IX = puntatore tile
1227+ 799D                  ;   B  = Row
1228+ 799D                  ;   C  = Col
1229+ 799D                  ; ---------------------------------------------------------------
1230+ 799D E5               push hl
1231+ 799E DD E1            pop  ix
1232+ 79A0
1233+ 79A0                  ; Ripristina Row e Col salvati in IY
1234+ 79A0 FD E5            push iy
1235+ 79A2 C1               pop  bc
1236+ 79A3
1237+ 79A3                  ; Disegna il tile originale
1238+ 79A3 CD 56 62         call Gfx_DrawTile
1239+ 79A6
1240+ 79A6                  ; ---------------------------------------------------------------
1241+ 79A6                  ; Ripristina i registri salvati
1242+ 79A6                  ; ---------------------------------------------------------------
1243+ 79A6 DD E1            pop  ix
1244+ 79A8 E1               pop  hl
1245+ 79A9 D1               pop  de
1246+ 79AA C1               pop  bc
1247+ 79AB FD E1            pop  iy
1248+ 79AD
1249+ 79AD C9               ret
