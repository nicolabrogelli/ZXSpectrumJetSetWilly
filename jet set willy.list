 759+ 6A54 CB 3F            srl  a
 760+ 6A56 CB 3F            srl  a                 ; A = ColStart
 761+ 6A58 5F               ld   e, a              ; E = ColStart
 762+ 6A59
 763+ 6A59                  ; ColEnd = (WillyX + 7) / 8
 764+ 6A59 79               ld   a, c
 765+ 6A5A C6 07            add  a, 7
