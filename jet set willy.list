1655+ 7A02              ; CheckActiveItemAtCell
1656+ 7A02              ;
1657+ 7A02              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1658+ 7A02              ; nella cella specificata della griglia items_grid.
1659+ 7A02              ;
1660+ 7A02              ; Questa routine usa una lookup diretta su una mappa 32x16,
1661+ 7A02              ; evitando la scansione della ItemsTable.
1662+ 7A02              ;
1663+ 7A02              ; Input:
1664+ 7A02              ;   B = Colonna (0..31)
1665+ 7A02              ;   C = Riga (0..15)
1666+ 7A02              ;
1667+ 7A02              ; Output:
1668+ 7A02              ;   Carry Set   = item presente nella cella
1669+ 7A02              ;   Carry Clear = nessun item
1670+ 7A02              ;
1671+ 7A02              ; Nota:
1672+ 7A02              ;   HL NON è restituito valido (commento originale non corretto:
1673+ 7A02              ;   la routine non punta a ItemsTable).
1674+ 7A02              ; -------------------------------------------------------------------
1675+ 7A02              CheckActiveItemAtCell:
1676+ 7A02
1677+ 7A02                  ; Salva registri usati
1678+ 7A02 D5               push de
1679+ 7A03 E5               push hl
1680+ 7A04
1681+ 7A04                  ; ---------------------------------------------------------------
1682+ 7A04                  ; Calcolo indice lineare nella griglia 32x16:
1683+ 7A04                  ;
1684+ 7A04                  ; offset = Row * 32 + Col
1685+ 7A04                  ; ---------------------------------------------------------------
1686+ 7A04 26 00            ld   h, 0
1687+ 7A06 69               ld   l, c              ; HL = Row
1688+ 7A07
1689+ 7A07 29               add  hl, hl            ; *2
1690+ 7A08 29               add  hl, hl            ; *4
1691+ 7A09 29               add  hl, hl            ; *8
1692+ 7A0A 29               add  hl, hl            ; *16
1693+ 7A0B 29               add  hl, hl            ; *32
1694+ 7A0C
1695+ 7A0C                  ; Aggiunge la colonna
1696+ 7A0C 58               ld   e, b
1697+ 7A0D 16 00            ld   d, 0
1698+ 7A0F 19               add  hl, de            ; HL = Row*32 + Col
1699+ 7A10
1700+ 7A10                  ; ---------------------------------------------------------------
1701+ 7A10                  ; Accesso alla griglia degli item attivi
1702+ 7A10                  ; ---------------------------------------------------------------
1703+ 7A10 11 EC CC         ld   de, items_grid
1704+ 7A13 19               add  hl, de            ; HL = address cella
1705+ 7A14
1706+ 7A14                  ; ---------------------------------------------------------------
1707+ 7A14                  ; Controllo presenza item
1708+ 7A14                  ;
1709+ 7A14                  ; items_grid contiene:
1710+ 7A14                  ;   0 = nessun item
1711+ 7A14                  ;   >0 = item attivo (colore o flag)
1712+ 7A14                  ; ---------------------------------------------------------------
1713+ 7A14 7E               ld   a, (hl)
1714+ 7A15 B7               or   a
1715+ 7A16 28 04            jr   z, .not_active
1716+ 7A18
1717+ 7A18                  ; ---------------------------------------------------------------
1718+ 7A18                  ; Item trovato
1719+ 7A18                  ; ---------------------------------------------------------------
1720+ 7A18 E1               pop  hl
1721+ 7A19 D1               pop  de
1722+ 7A1A
1723+ 7A1A 37               scf                    ; Carry = 1
1724+ 7A1B C9               ret
1725+ 7A1C
1726+ 7A1C              .not_active:
1727+ 7A1C
1728+ 7A1C                  ; ---------------------------------------------------------------
1729+ 7A1C                  ; Nessun item nella cella
1730+ 7A1C                  ; ---------------------------------------------------------------
1731+ 7A1C E1               pop  hl
1732+ 7A1D D1               pop  de
1733+ 7A1E
1734+ 7A1E B7               or   a                 ; Carry = 0
1735+ 7A1F C9               ret
