 923+ 7E7F DD 77 07         ld   (ix+7), a
 924+ 7E82
 925+ 7E82              .anim_done:
 926+ 7E82
 927+ 7E82                  ; 3. Determina se orizzontale o verticale
 928+ 7E82 DD 7E 00         ld   a, (ix+0)         ; Flags
 929+ 7E85 E6 40            and  $40               ; Vertical? (Bit 6)
 930+ 7E87 C2 D1 7E         jp   nz, .vertical
 931+ 7E8A
 932+ 7E8A              .horizontal:
 933+ 7E8A DD 7E 06         ld   a, (ix+6)         ; Direction (1=Left, 2=Right) (Offset 6)
 934+ 7E8D FE 01            cp   1
 935+ 7E8F 20 20            jr   nz, .horiz_right
 936+ 7E91
 937+ 7E91              .horiz_left:
 938+ 7E91 DD 7E 02         ld   a, (ix+2)         ; Current X
 939+ 7E94 D6 02            sub  2                 ; Muovi a sinistra di 2 pixel
 940+ 7E96 DD BE 04         cp   (ix+4)            ; Min Limit (Offset 4)
 941+ 7E99 28 08            jr   z, .h_rev_right
 942+ 7E9B 38 06            jr   c, .h_rev_right
 943+ 7E9D DD 77 02         ld   (ix+2), a
 944+ 7EA0 C3 15 7F         jp   .next
 945+ 7EA3
 946+ 7EA3              .h_rev_right:
 947+ 7EA3 DD 7E 04         ld   a, (ix+4)         ; Min Limit
 948+ 7EA6 DD 77 02         ld   (ix+2), a
 949+ 7EA9 3E 02            ld   a, 2
 950+ 7EAB DD 77 06         ld   (ix+6), a         ; Cambia direzione a Destra (Offset 6)
 951+ 7EAE C3 15 7F         jp   .next
 952+ 7EB1
 953+ 7EB1              .horiz_right:
 954+ 7EB1 DD 7E 02         ld   a, (ix+2)         ; Current X
 955+ 7EB4 C6 02            add  a, 2              ; Muovi a destra di 2 pixel
 956+ 7EB6 DD BE 05         cp   (ix+5)            ; Max Limit (Offset 5)
 957+ 7EB9 28 08            jr   z, .h_rev_left
 958+ 7EBB 30 06            jr   nc, .h_rev_left
 959+ 7EBD DD 77 02         ld   (ix+2), a
 960+ 7EC0 C3 15 7F         jp   .next
 961+ 7EC3
 962+ 7EC3              .h_rev_left:
 963+ 7EC3 DD 7E 05         ld   a, (ix+5)         ; Max Limit
 964+ 7EC6 DD 77 02         ld   (ix+2), a
 965+ 7EC9 3E 01            ld   a, 1
 966+ 7ECB DD 77 06         ld   (ix+6), a         ; Cambia direzione a Sinistra
 967+ 7ECE C3 15 7F         jp   .next
