 184+ 7A6C              ; -------------------------------------------------------------------
 185+ 7A6C              ; DetermineCurrentRoomID
 186+ 7A6C              ;
 187+ 7A6C              ; Determina l'ID numerico della stanza corrente confrontando
 188+ 7A6C              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 189+ 7A6C              ;
 190+ 7A6C              ; Se viene trovata una corrispondenza:
 191+ 7A6C              ;   A = ID della stanza
 192+ 7A6C              ;   current_room = A
 193+ 7A6C              ;
 194+ 7A6C              ; Mappatura:
 195+ 7A6C              ;    0 = The Off Licence
 196+ 7A6C              ;    1 = The Bridge
 197+ 7A6C              ;    2 = Under The Mega Tree
 198+ 7A6C              ;    3 = Gfx_At The Foot Of The Mega Tree
 199+ 7A6C              ;    4 = The Drive
 200+ 7A6C              ;    5 = The Security Guard
 201+ 7A6C              ;    6 = Entrance To Hades
 202+ 7A6C              ;    7 = Cuckoo's Nest
 203+ 7A6C              ;    8 = Inside The Mega Trunk
 204+ 7A6C              ;    9 = On A Branch Over The Drive
 205+ 7A6C              ;   10 = The Front Door
 206+ 7A6C              ;   11 = The Hall
 207+ 7A6C              ;   12 = Tree Top
 208+ 7A6C              ;   27 = The Chapel
 209+ 7A6C              ;   28 = First Landing
 210+ 7A6C              ;   29 = The Nightmare Room
 211+ 7A6C              ;   33 = The Bathroom
 212+ 7A6C              ;   35 = Master Bedroom
 213+ 7A6C              ;
 214+ 7A6C              ; Se nessuna stanza corrisponde viene impostato:
 215+ 7A6C              ;   current_room = 0
 216+ 7A6C              ; -------------------------------------------------------------------
 217+ 7A6C              DetermineCurrentRoomID:
 218+ 7A6C
 219+ 7A6C                  ; Salva i registri utilizzati
 220+ 7A6C E5               push hl
 221+ 7A6D D5               push de
 222+ 7A6E
 223+ 7A6E                  ; ---------------------------------------------------------------
 224+ 7A6E                  ; Confronto con TheOffLicenceLayout
 225+ 7A6E                  ; ---------------------------------------------------------------
 226+ 7A6E 2A A6 E9         ld   hl, (room_ptr)
 227+ 7A71 11 00 84         ld   de, TheOffLicenceLayout
 228+ 7A74 B7               or   a
 229+ 7A75 ED 52            sbc  hl, de
 230+ 7A77 20 05            jr   nz, .not_office
 231+ 7A79
 232+ 7A79 3E 00            ld   a, 0               ; Room ID = 0
 233+ 7A7B C3 40 7E         jp   .set_room
 234+ 7A7E
 235+ 7A7E              .not_office:
 236+ 7A7E
 237+ 7A7E                  ; -------------------------------------------------q--------------
