 145+ 5E57              .shift_loop:
 146+ 5E57 CB 3A            srl  d
 147+ 5E59 CB 1B            rr   e
 148+ 5E5B 3D               dec  a
 149+ 5E5C 20 F9            jr   nz, .shift_loop
 150+ 5E5E
 151+ 5E5E              .no_shift:
