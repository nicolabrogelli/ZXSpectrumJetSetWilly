  57+ 5E0E
  58+ 5E0E              ; -------------------------------------------------------------------
  59+ 5E0E              ; Calcola indirizzo schermo da coordinate pixel (X, Y)
  60+ 5E0E              ; Input: H = Y (0..191), L = X (0..255)
  61+ 5E0E              ; Output: HL = indirizzo schermo
  62+ 5E0E              ; -------------------------------------------------------------------
  63+ 5E0E              GetScreenAddr:
  64+ 5E0E 7C               ld a, h
  65+ 5E0F E6 07            and %00000111     ; A = y2 y1 y0 (scanline offset)
  66+ 5E11 F6 40            or  %01000000     ; Base dello schermo ($40)
  67+ 5E13 57               ld  d, a          ; D = high byte parziale
  68+ 5E14
  69+ 5E14 7C               ld  a, h
  70+ 5E15 E6 C0            and %11000000     ; A = y7 y6 000000 (third select)
  71+ 5E17 0F               rrca
  72+ 5E18 0F               rrca
  73+ 5E19 0F               rrca              ; Shift a destra di 3 -> 000 y7 y6 000
  74+ 5E1A B2               or  d
  75+ 5E1B 57               ld  d, a          ; D = high byte completo (010 y7 y6 y2 y1 y0)
  76+ 5E1C
  77+ 5E1C 7C               ld  a, h
  78+ 5E1D E6 38            and %00111000     ; A = 00 y5 y4 y3 000 (character row)
  79+ 5E1F 87               add a, a
  80+ 5E20 87               add a, a          ; Shift a sinistra di 2 -> y5 y4 y3 00000
  81+ 5E21 5F               ld  e, a          ; E = low byte parziale
  82+ 5E22
  83+ 5E22 7D               ld  a, l
  84+ 5E23 CB 3F            srl a
  85+ 5E25 CB 3F            srl a
  86+ 5E27 CB 3F            srl a              ; A = X / 8 (colonna)
  87+ 5E29 B3               or  e
  88+ 5E2A 5F               ld  e, a          ; E = low byte completo
  89+ 5E2B
  90+ 5E2B 62               ld  h, d
  91+ 5E2C 6B               ld  l, e          ; HL = indirizzo finale
  92+ 5E2D C9               ret
  93+ 5E2E
  94+ 5E2E              ; -------------------------------------------------------------------
  95+ 5E2E              ; Incrementa indirizzo schermo alla riga (scanline) successiva
  96+ 5E2E              ; Input/Output: HL = indirizzo schermo
  97+ 5E2E              ; -------------------------------------------------------------------
  98+ 5E2E              IncScreenLine:
  99+ 5E2E 24               inc h             ; Vai alla riga successiva
 100+ 5E2F 7C               ld  a, h
 101+ 5E30 E6 07            and 7             ; Controlla se la scanline è tornata a 0 (wrap)
 102+ 5E32 C0               ret nz            ; Se non è 0, abbiamo finito!
 103+ 5E33
 104+ 5E33 7D               ld  a, l
 105+ 5E34 C6 20            add a, 32         ; Altrimenti passa alla riga di caratteri successiva
 106+ 5E36 6F               ld  l, a
 107+ 5E37 D8               ret c             ; Se c'è carry, abbiamo cambiato terzo e H è già corretto!
 108+ 5E38
 109+ 5E38                  ; Se non c'è carry, rimaniamo nello stesso terzo. Ripristina il terzo corretto in H.
 110+ 5E38 7C               ld  a, h
 111+ 5E39 D6 08            sub 8
 112+ 5E3B 67               ld  h, a
 113+ 5E3C C9               ret
