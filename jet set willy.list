 574+ 773E
 575+ 773E C9               ret
 576+ 773F
 577+ 773F              ; -------------------------------------------------------------------
 578+ 773F              ; Items_DrawRoom
 579+ 773F              ;
 580+ 773F              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 581+ 773F              ;
 582+ 773F              ; Operazioni eseguite:
 583+ 773F              ;   1. Azzera la griglia items_grid.
 584+ 773F              ;   2. Svuota la cache degli oggetti attivi.
 585+ 773F              ;   3. Scansiona ItemsTable.
 586+ 773F              ;   4. Per ogni item della stanza corrente:
 587+ 773F              ;        - verifica se è già stato raccolto
 588+ 773F              ;        - disegna la grafica
 589+ 773F              ;        - aggiorna items_grid
 590+ 773F              ;        - memorizza l'item nella cache current_room_items
 591+ 773F              ;   5. Aggiorna num_room_items.
 592+ 773F              ;
 593+ 773F              ; Record ItemsTable:
 594+ 773F              ;   +0  Room ID
 595+ 773F              ;   +1  X (colonna)
 596+ 773F              ;   +2  Y (riga)
 597+ 773F              ;   +3  Colore
 598+ 773F              ;   +4  Collected flag
 599+ 773F              ;
 600+ 773F              ; Cache current_room_items:
 601+ 773F              ;   +0  Colonna
 602+ 773F              ;   +1  Riga
 603+ 773F              ;   +2  Colore
 604+ 773F              ;   +3  Collected flag ptr (Low)
 605+ 773F              ;   +4  Collected flag ptr (High)
 606+ 773F              ;
 607+ 773F              ; Ogni record cache occupa 5 byte.
 608+ 773F              ; -------------------------------------------------------------------
 609+ 773F              Items_DrawRoom:
 610+ 773F
 611+ 773F                  ; Salva tutti i registri utilizzati
 612+ 773F E5               push hl
 613+ 7740 D5               push de
 614+ 7741 C5               push bc
 615+ 7742 DD E5            push ix
 616+ 7744 FD E5            push iy
 617+ 7746
 618+ 7746                  ; ---------------------------------------------------------------
 619+ 7746                  ; Azzera items_grid (32 x 16 = 512 byte)
 620+ 7746                  ; ---------------------------------------------------------------
 621+ 7746 21 00 B0         ld   hl, items_grid
 622+ 7749 11 01 B0         ld   de, items_grid + 1
 623+ 774C 36 00            ld   (hl), 0
 624+ 774E 01 FF 01         ld   bc, 511
 625+ 7751 ED B0            ldir
 626+ 7753
 627+ 7753                  ; ---------------------------------------------------------------
 628+ 7753                  ; Nessun item attivo nella stanza
 629+ 7753                  ; ---------------------------------------------------------------
 630+ 7753 AF               xor  a
 631+ 7754 32 94 7D         ld   (num_room_items), a
 632+ 7757
 633+ 7757                  ; IY punta alla cache degli item attivi
 634+ 7757 FD 21 44 7D      ld   iy, current_room_items
 635+ 775B
 636+ 775B                  ; ---------------------------------------------------------------
 637+ 775B                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 638+ 775B                  ; alla stanza corrente.
 639+ 775B                  ;
 640+ 775B                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 641+ 775B                  ; ---------------------------------------------------------------
 642+ 775B 2A 95 7D         ld   hl, (room_ptr)
 643+ 775E 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 644+ 7761 19               add  hl, de
 645+ 7762
 646+ 7762 E5               push hl
 647+ 7763 DD E1            pop  ix                ; IX = bitmap item
 648+ 7765
 649+ 7765                  ; ---------------------------------------------------------------
 650+ 7765                  ; Inizio scansione della tabella degli item
 651+ 7765                  ; ---------------------------------------------------------------
 652+ 7765 21 8C 74         ld   hl, ItemsTable
 653+ 7768
 654+ 7768              .loop:
 655+ 7768
 656+ 7768                  ; ---------------------------------------------------------------
 657+ 7768                  ; Legge il Room ID del record corrente
 658+ 7768                  ; ---------------------------------------------------------------
 659+ 7768 7E               ld   a, (hl)
 660+ 7769
 661+ 7769                  ; $FF indica fine tabella
 662+ 7769 FE FF            cp   $FF
 663+ 776B 28 53            jr   z, .done
 664+ 776D
 665+ 776D                  ; ---------------------------------------------------------------
 666+ 776D                  ; Verifica se l'item appartiene alla stanza corrente
 667+ 776D                  ; ---------------------------------------------------------------
 668+ 776D 57               ld   d, a
 669+ 776E
 670+ 776E 3A 3B 7D         ld   a, (current_room)
 671+ 7771 BA               cp   d
 672+ 7772 20 45            jr   nz, .next_item
 673+ 7774
 674+ 7774                  ; ---------------------------------------------------------------
 675+ 7774                  ; Legge i dati dell'item
 676+ 7774                  ; ---------------------------------------------------------------
 677+ 7774
 678+ 7774 23               inc  hl
 679+ 7775 4E               ld   c, (hl)           ; X (colonna)
 680+ 7776
 681+ 7776 23               inc  hl
 682+ 7777 46               ld   b, (hl)           ; Y (riga)
 683+ 7778
 684+ 7778 23               inc  hl
 685+ 7779 5E               ld   e, (hl)           ; Colore
 686+ 777A
 687+ 777A 23               inc  hl
 688+ 777B 7E               ld   a, (hl)           ; Collected flag
 689+ 777C
 690+ 777C                  ; Se diverso da zero l'item è già stato raccolto
 691+ 777C B7               or   a
 692+ 777D 20 3E            jr   nz, .next_no_inc
 693+ 777F
 694+ 777F                  ; ---------------------------------------------------------------
 695+ 777F                  ; Disegna l'item sullo schermo
 696+ 777F                  ;
 697+ 777F                  ; B = Row
 698+ 777F                  ; C = Column
 699+ 777F                  ; HL = bitmap pointer
 700+ 777F                  ; E = Color
 701+ 777F                  ; ---------------------------------------------------------------
 702+ 777F E5               push hl
 703+ 7780
 704+ 7780 DD E5            push ix
 705+ 7782 E1               pop  hl
 706+ 7783
 707+ 7783 CD C8 77         call DrawItemGraphic
 708+ 7786
 709+ 7786 E1               pop  hl                ; ritorna al flag collected
 710+ 7787
 711+ 7787                  ; ---------------------------------------------------------------
 712+ 7787                  ; Aggiorna items_grid
 713+ 7787                  ;
 714+ 7787                  ; Calcolo:
 715+ 7787                  ;   offset = Row * 32 + Col
 716+ 7787                  ; ---------------------------------------------------------------
 717+ 7787 E5               push hl
 718+ 7788 D5               push de
 719+ 7789
 720+ 7789 26 00            ld   h, 0
 721+ 778B 68               ld   l, b              ; HL = Row
 722+ 778C
 723+ 778C 29               add  hl, hl            ; *2
 724+ 778D 29               add  hl, hl            ; *4
 725+ 778E 29               add  hl, hl            ; *8
 726+ 778F 29               add  hl, hl            ; *16
 727+ 7790 29               add  hl, hl            ; *32
 728+ 7791
 729+ 7791 16 00            ld   d, 0
 730+ 7793 59               ld   e, c              ; DE = Col
 731+ 7794
 732+ 7794 19               add  hl, de            ; Row*32 + Col
 733+ 7795
 734+ 7795 11 00 B0         ld   de, items_grid
 735+ 7798 19               add  hl, de            ; puntatore nella griglia
 736+ 7799
 737+ 7799 D1               pop  de                ; ripristina colore
 738+ 779A
 739+ 779A 73               ld   (hl), e           ; salva colore cella
 740+ 779B
 741+ 779B E1               pop  hl
 742+ 779C
 743+ 779C                  ; ---------------------------------------------------------------
 744+ 779C                  ; Salva l'item nella cache della stanza
 745+ 779C                  ;
 746+ 779C                  ; Questo evita di dover scansionare tutta ItemsTable
 747+ 779C                  ; durante il controllo delle collisioni.
 748+ 779C                  ; ---------------------------------------------------------------
 749+ 779C
 750+ 779C FD 71 00         ld   (iy+0), c         ; Colonna
 751+ 779F FD 70 01         ld   (iy+1), b         ; Riga
 752+ 77A2 FD 73 02         ld   (iy+2), e         ; Colore
 753+ 77A5
 754+ 77A5                  ; Salva il puntatore al flag "collected"
 755+ 77A5 FD 75 03         ld   (iy+3), l         ; Low byte
 756+ 77A8 FD 74 04         ld   (iy+4), h         ; High byte
 757+ 77AB
 758+ 77AB                  ; Passa al record successivo della cache
 759+ 77AB 01 05 00         ld   bc, 5
 760+ 77AE FD 09            add  iy, bc
 761+ 77B0
 762+ 77B0                  ; Incrementa il numero di item attivi
 763+ 77B0 3A 94 7D         ld   a, (num_room_items)
 764+ 77B3 3C               inc  a
 765+ 77B4 32 94 7D         ld   (num_room_items), a
 766+ 77B7
 767+ 77B7 18 04            jr   .next_no_inc
 768+ 77B9
 769+ 77B9              .next_item:
 770+ 77B9
 771+ 77B9                  ; ---------------------------------------------------------------
 772+ 77B9                  ; L'item non appartiene alla stanza corrente.
 773+ 77B9                  ; Salta i campi del record:
 774+ 77B9                  ;   X
 775+ 77B9                  ;   Y
 776+ 77B9                  ;   Color
 777+ 77B9                  ;   Collected
 778+ 77B9                  ; ---------------------------------------------------------------
 779+ 77B9 23               inc  hl
 780+ 77BA 23               inc  hl
 781+ 77BB 23               inc  hl
 782+ 77BC 23               inc  hl
 783+ 77BD
 784+ 77BD              .next_no_inc:
 785+ 77BD
 786+ 77BD                  ; ---------------------------------------------------------------
 787+ 77BD                  ; Avanza al record successivo
 788+ 77BD                  ; (prossimo Room ID)
 789+ 77BD                  ; ---------------------------------------------------------------
 790+ 77BD 23               inc  hl
 791+ 77BE 18 A8            jr   .loop
 792+ 77C0
 793+ 77C0              .done:
 794+ 77C0
 795+ 77C0                  ; Ripristina i registri
 796+ 77C0 FD E1            pop  iy
 797+ 77C2 DD E1            pop  ix
 798+ 77C4 D1               pop  de
 799+ 77C5 C1               pop  bc
 800+ 77C6 E1               pop  hl
 801+ 77C7
 802+ 77C7 C9               ret
