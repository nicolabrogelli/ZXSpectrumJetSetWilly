 886+ 78A6 D5               push de
 887+ 78A7
 888+ 78A7 26 00            ld   h, 0
 889+ 78A9 68               ld   l, b              ; HL = Row
 890+ 78AA
 891+ 78AA 29               add  hl, hl            ; *2
 892+ 78AB 29               add  hl, hl            ; *4
 893+ 78AC 29               add  hl, hl            ; *8
 894+ 78AD 29               add  hl, hl            ; *16
 895+ 78AE 29               add  hl, hl            ; *32
 896+ 78AF
 897+ 78AF 16 00            ld   d, 0
 898+ 78B1 59               ld   e, c              ; DE = Col
 899+ 78B2
 900+ 78B2 19               add  hl, de            ; Row*32 + Col
 901+ 78B3
 902+ 78B3 11 EC CC         ld   de, items_grid
 903+ 78B6 19               add  hl, de            ; puntatore nella griglia
 904+ 78B7
 905+ 78B7 D1               pop  de                ; ripristina colore
 906+ 78B8
 907+ 78B8 73               ld   (hl), e           ; salva colore cella
 908+ 78B9
 909+ 78B9 E1               pop  hl
