1217+ 648C 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1218+ 648F DD 21 7F CC      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1219+ 6493 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1220+ 6496
