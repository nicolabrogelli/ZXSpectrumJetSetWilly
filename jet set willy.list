1376+ 77E8
1377+ 77E8 C1               pop  bc                ; BC ha C = PlayerX, B = PlayerY
1378+ 77E9 C5               push bc
1379+ 77EA
1380+ 77EA                  ; Calcola ramp_Y per PlayerX (in C) nella nuova stanza
1381+ 77EA CD C5 78         call GetRampY          ; Output: Carry SET se X è nel range rampa, A = ramp_Y
1382+ 77ED 38 6C            jr   c, .on_ramp_x_ok
