 483+ 6C06
 484+ 6C06 E1               pop  hl
 485+ 6C07
 486+ 6C07 18 04            jr   .next_no_inc
 487+ 6C09
 488+ 6C09              .next_item:
 489+ 6C09 23               inc  hl                ; salta X
 490+ 6C0A 23               inc  hl                ; salta Y
 491+ 6C0B 23               inc  hl                ; salta colore
 492+ 6C0C 23               inc  hl                ; salta collected
 493+ 6C0D              .next_no_inc:
 494+ 6C0D 23               inc  hl                ; vai al prossimo item
 495+ 6C0E 18 CE            jr   .loop
 496+ 6C10
 497+ 6C10              .done:
 498+ 6C10 C1               pop  bc
 499+ 6C11 D1               pop  de
 500+ 6C12 E1               pop  hl
 501+ 6C13 C9               ret
