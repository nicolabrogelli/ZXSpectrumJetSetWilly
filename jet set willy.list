 179+ 8671              ; Audio_PlayCollectSound
 180+ 8671              ;
 181+ 8671              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 8671              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 8671              ; -------------------------------------------------------------------
 184+ 8671              Audio_PlayCollectSound:
 185+ 8671 C5               push bc
 186+ 8672 D5               push de
 187+ 8673
 188+ 8673 06 78            ld   b, 120
 189+ 8675              .sound_loop:
 190+ 8675 3A 63 EB         ld   a, (room_border_color)
 191+ 8678 F6 10            or   $10               ; speaker ON
 192+ 867A D3 FE            out  ($fe), a
 193+ 867C
 194+ 867C 0E 3C            ld   c, 60
 195+ 867E              .d1:
 196+ 867E 0D               dec  c
 197+ 867F 20 FD            jr   nz, .d1
 198+ 8681
 199+ 8681 3A 63 EB         ld   a, (room_border_color)
 200+ 8684 E6 EF            and  $ef              ; speaker OFF
 201+ 8686 D3 FE            out  ($fe), a
 202+ 8688
 203+ 8688 0E 3C            ld   c, 60
 204+ 868A              .d2:
 205+ 868A 0D               dec  c
 206+ 868B 20 FD            jr   nz, .d2
 207+ 868D
 208+ 868D 10 E6            djnz .sound_loop
 209+ 868F
 210+ 868F D1               pop  de
 211+ 8690 C1               pop  bc
 212+ 8691 C9               ret
