1326+ 705E              ; -------------------------------------------------------------------
1327+ 705E              ; Phys_CheckRampOnRoomChange
1328+ 705E              ; Controlla se nella nuova stanza (DE = room layout ptr) c'è una rampa
1329+ 705E              ; allineata con la posizione d'ingresso di Willy (C = PlayerX, B = PlayerY).
1330+ 705E              ; Output: Se allineato, modifica B = ramp_Y e C = PlayerX e imposta on_ground = 1.
1331+ 705E              ; -------------------------------------------------------------------
1332+ 705E              Phys_CheckRampOnRoomChange:
1333+ 705E E5               push hl
1334+ 705F D5               push de
1335+ 7060 C5               push bc
1336+ 7061
1337+ 7061                  ; Offsets per RampData: DE + 218
1338+ 7061 21 DA 00         ld   hl, 218
1339+ 7064 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1340+ 7065
1341+ 7065 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1342+ 7066 32 51 E9         ld   (ramp_dir), a
1343+ 7069 23               inc  hl
1344+ 706A 5E               ld   e, (hl)
1345+ 706B 23               inc  hl
1346+ 706C 56               ld   d, (hl)           ; DE = Location
1347+ 706D 23               inc  hl
1348+ 706E 7E               ld   a, (hl)           ; A = Length
1349+ 706F 32 52 E9         ld   (ramp_len), a
1350+ 7072
1351+ 7072                  ; Controlla se DE (Location) è 0 o Length è 0
1352+ 7072 7A               ld   a, d
1353+ 7073 B3               or   e
1354+ 7074 CA 7B 71         jp   z, .no_ramp_change
1355+ 7077 3A 52 E9         ld   a, (ramp_len)
1356+ 707A B7               or   a
1357+ 707B CA 7B 71         jp   z, .no_ramp_change
1358+ 707E
1359+ 707E                  ; Calcola Row e Col: Offset = DE - 24064
1360+ 707E 21 00 A2         ld   hl, -24064
1361+ 7081 19               add  hl, de            ; HL = Offset
1362+ 7082 54               ld   d, h
1363+ 7083 5D               ld   e, l
1364+ 7084
1365+ 7084 7B               ld   a, e
1366+ 7085 E6 1F            and  31
1367+ 7087 32 54 E9         ld   (ramp_col), a     ; Col Start
1368+ 708A
1369+ 708A CB 3C            srl  h
1369+ 708C CB 1D          rr l
1370+ 708E CB 3C            srl  h
1370+ 7090 CB 1D          rr l
1371+ 7092 CB 3C            srl  h
1371+ 7094 CB 1D          rr l
