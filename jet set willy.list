 319+ 7C11              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 320+ 7C11              ; -------------------------------------------------------------------
 321+ 7C11              CheckEnemyWillyOverlap:
 322+ 7C11 3A 0B FC         ld   a, (player_drawn_pos+1)
 323+ 7C14 FE FF            cp   $FF
 324+ 7C16 C8               ret  z                  ; Se Willy non è disegnato, esci
 325+ 7C17
 326+ 7C17                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 327+ 7C17 3A 0A FC         ld   a, (player_drawn_pos)
 328+ 7C1A E6 F8            and  $F8
 329+ 7C1C 5F               ld   e, a               ; E = WillyX & $F8
 330+ 7C1D 79               ld   a, c
 331+ 7C1E E6 F8            and  $F8                ; A = EnemyX & $F8
 332+ 7C20 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 333+ 7C21 C6 10            add  a, 16
 334+ 7C23 FE 19            cp   25
 335+ 7C25 D0               ret  nc                 ; Fuori portata X
 336+ 7C26
 337+ 7C26                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 338+ 7C26 3A 0B FC         ld   a, (player_drawn_pos+1) ; A = WillyY
 339+ 7C29 90               sub  b                  ; A = WillyY - EnemyY
 340+ 7C2A C6 0F            add  a, 15
 341+ 7C2C FE 1F            cp   31
 342+ 7C2E D0               ret  nc                 ; Fuori portata Y
