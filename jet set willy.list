401+  5F5F
402+  5F5F                  ; 1. Determina sprite per la testa (sinistra o destra)
403+  5F5F 3A 91 6C         ld   a, (direction)
404+  5F62 FE 01            cp   1                 ; Sinistra?
405+  5F64 20 06            jr   nz, .right_head
406+  5F66
407+  5F66 DD 21 42 61      ld   ix, TilesDef + (4 * 8) ; 5° tile (HEAD_GRAPH_LEFT)
408+  5F6A 18 04            jr   .draw_head
409+  5F6C
410+  5F6C              .right_head:
411+  5F6C DD 21 22 61      ld   ix, TilesDef + (0 * 8) ; 1° tile (HEAD_GRAPH_RIGHT)
412+  5F70
413+  5F70              .draw_head:
