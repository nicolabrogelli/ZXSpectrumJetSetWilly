 822+ 781C 28 1B            jr   z, .soldato_anim
 823+ 781E FE 10            cp   16                ; Tipo 16 = Candelabro?
 824+ 7820 28 17            jr   z, .soldato_anim
 825+ 7822 FE 14            cp   20                ; Tipo 20 = Nonnino?
 826+ 7824 28 13            jr   z, .soldato_anim
 827+ 7826 FE 15            cp   21                ; Tipo 21 = Parrucca?
 828+ 7828 28 0F            jr   z, .soldato_anim
