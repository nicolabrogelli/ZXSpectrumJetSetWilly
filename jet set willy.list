 616  89FC              ; -------------------------------------------------------------------
 617  89FC              ; Time_UpdateClock
 618  89FC              ; Gestisce lo scorrimento del tempo durante il gioco.
 619  89FC              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 620  89FC              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 621  89FC              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 622  89FC              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 623  89FC              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 624  89FC              ; sia completato, scatena immediatamente il Game Over.
 625  89FC              ; -------------------------------------------------------------------
 626  89FC              Time_UpdateClock:
 627  89FC                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 628  89FC 2A A2 EC         ld   hl, (counter)
 629  89FF ED 5B 91 F0      ld   de, (time_last_counter)
 630  8A03 B7               or   a
 631  8A04 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 632  8A06
 633  8A06                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 634  8A06 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 635  8A09 B7               or   a
 636  8A0A ED 52            sbc  hl, de
 637  8A0C D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 638  8A0D
 639  8A0D                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 640  8A0D 2A 91 F0         ld   hl, (time_last_counter)
 641  8A10 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 642  8A13 19               add  hl, de
 643  8A14 22 91 F0         ld   (time_last_counter), hl
 644  8A17
 645  8A17                  ; Incrementa di 1 minuto il tempo di gioco
 646  8A17 3A 8F F0         ld   a, (time_minutes)
 647  8A1A 3C               inc  a
 648  8A1B FE 3C            cp   60
 649  8A1D 38 21            jr   c, .minutes_ok
 650  8A1F
 651  8A1F                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 652  8A1F AF               xor  a
 653  8A20 32 8F F0         ld   (time_minutes), a
 654  8A23 3A 8E F0         ld   a, (time_hours)
 655  8A26 3C               inc  a
 656  8A27 FE 0C            cp   12
 657  8A29 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 658  8A2B FE 0D            cp   13
 659  8A2D 38 0E            jr   c, .hours_ok
 660  8A2F 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 661  8A31 18 0A            jr   .hours_ok
 662  8A33
 663  8A33              .toggle_period:
 664  8A33 F5               push af                     ; Salva A (valore 12)
 665  8A34 3A 90 F0         ld   a, (time_period)
 666  8A37 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 667  8A39 32 90 F0         ld   (time_period), a
 668  8A3C F1               pop  af                     ; Ripristina A = 12
 669  8A3D
 670  8A3D              .hours_ok:
 671  8A3D 32 8E F0         ld   (time_hours), a
 672  8A40
 673  8A40              .minutes_ok:
 674  8A40 32 8F F0         ld   (time_minutes), a
 675  8A43
 676  8A43                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 677  8A43 CD FB 66         call Gfx_UpdateTimeDisplay
 678  8A46
 679  8A46                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 680  8A46 3A 93 F0         ld   a, (game_objective_completed)
 681  8A49 B7               or   a
 682  8A4A C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 683  8A4B
 684  8A4B                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 685  8A4B 3A 90 F0         ld   a, (time_period)
 686  8A4E B7               or   a
 687  8A4F C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 688  8A50
 689  8A50 3A 8E F0         ld   a, (time_hours)
 690  8A53 FE 0C            cp   12
 691  8A55 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
 692  8A57 C9               ret
 693  8A58
 694  8A58              .time_limit_reached:
 695  8A58                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
 696  8A58                  ; Scatena immediatamente il Game Over temporale!
 697  8A58 C3 58 88         jp   TriggerGameOver
