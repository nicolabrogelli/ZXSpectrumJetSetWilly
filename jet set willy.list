 191+ 827F              ; -------------------------------------------------------------------
 192+ 827F              ; DetermineCurrentRoomID
 193+ 827F              ;
 194+ 827F              ; Determina l'ID numerico della stanza corrente confrontando
 195+ 827F              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 196+ 827F              ;
 197+ 827F              ; Se viene trovata una corrispondenza:
 198+ 827F              ;   A = ID della stanza
 199+ 827F              ;   current_room = A
 200+ 827F              ;
 201+ 827F              ; Mappatura:
 202+ 827F              ;    0 = The Off Licence
 203+ 827F              ;    1 = The Bridge
 204+ 827F              ;    2 = Under The Mega Tree
 205+ 827F              ;    3 = Gfx_At The Foot Of The Mega Tree
 206+ 827F              ;    4 = The Drive
 207+ 827F              ;    5 = The Security Guard
 208+ 827F              ;    6 = Entrance To Hades
 209+ 827F              ;    7 = Cuckoo's Nest
 210+ 827F              ;    8 = Inside The Mega Trunk
 211+ 827F              ;    9 = On A Branch Over The Drive
 212+ 827F              ;   10 = The Front Door
 213+ 827F              ;   11 = The Hall
 214+ 827F              ;   12 = Tree Top
 215+ 827F              ;   27 = The Chapel
 216+ 827F              ;   28 = First Landing
 217+ 827F              ;   29 = The Nightmare Room
 218+ 827F              ;   33 = The Bathroom
 219+ 827F              ;   35 = Master Bedroom
 220+ 827F              ;
 221+ 827F              ; Se nessuna stanza corrisponde viene impostato:
 222+ 827F              ;   current_room = 0
 223+ 827F              ; -------------------------------------------------------------------
 224+ 827F              DetermineCurrentRoomID:
 225+ 827F
