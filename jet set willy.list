   4+ 7EEF
   5+ 7EEF              ; -------------------------------------------------------------------
   6+ 7EEF              ; Tabella Globale degli Oggetti (Items)
   7+ 7EEF              ; Ciascun item occupa 5 byte:
   8+ 7EEF              ;   Byte 0: ID della stanza (0 = Test Room, 1 = The Bridge, 2 = The Off Licence, 3 = Master Bedroom, 4 = Under the MegaTree, 5 = Gfx_At TheFoot The Mega Tree, 6 = The Drive, 7 = The Security Guard)
   9+ 7EEF              ;   Byte 1: X colonna dello schermo (0..31)
  10+ 7EEF              ;   Byte 2: Y riga dello schermo (3..18)
  11+ 7EEF              ;   Byte 3: Attributo colore (es. $C6 per Giallo Flashing, $C5 per Cyan Flashing)
  12+ 7EEF              ;   Byte 4: Stato (0 = Attivo/Non raccolto, 1 = Raccolto)
  13+ 7EEF              ; La tabella termina con $FF
  14+ 7EEF              ;
  15+ 7EEF              ; La tabella riposrta solamente le stanza in cui effettivamente ci sono degli oggetti le altre sono omesse
  16+ 7EEF              ;
  17+ 7EEF              ; Tabella dei colori, se aggiungiamo $C davanti al colore questo diventa lampeggiante
  18+ 7EEF              ; 1 - BLUE
  19+ 7EEF              ; 2 - RED
  20+ 7EEF              ; 3 - MAGENTA
  21+ 7EEF              ; 4 - GREEN
  22+ 7EEF              ; 5 - CYAN
  23+ 7EEF              ; 6 - YELLOW
  24+ 7EEF              ; 7 - WHITE
  25+ 7EEF              ; -------------------------------------------------------------------
  26+ 7EEF              ItemsTable:
  27+ 7EEF                  ; Stanza 0 (The Off Licence)
  28+ 7EEF                  ITEM RoomsListTable.TheOffLicenceLayout, 30, 4, YELLOW, 0              ; Oggetto 1 alla colonna X=30,  riga Y=4, YELLOW, (Stato: 0=attivo)
  28+ 7EEF 00 1E 04 06 >        db (RoomsListTable.TheOffLicenceLayout - RoomsListTable) / 2, 30, 4, YELLOW, 0
  28+ 7EF3 00          >
  29+ 7EF4                  ITEM RoomsListTable.TheOffLicenceLayout, 29, 4, CYAN, 0                ; Oggetto 2 alla colonna X=29,  riga Y=4, CYAN, (Stato: 0=attivo)
  29+ 7EF4 00 1D 04 05 >        db (RoomsListTable.TheOffLicenceLayout - RoomsListTable) / 2, 29, 4, CYAN, 0
  29+ 7EF8 00          >
  30+ 7EF9                  ITEM RoomsListTable.TheOffLicenceLayout, 28, 4, GREEN, 0               ; Oggetto 4 alla colonna X=28,  riga Y=4, GREEN, (Stato: 0=attivo)
  30+ 7EF9 00 1C 04 04 >        db (RoomsListTable.TheOffLicenceLayout - RoomsListTable) / 2, 28, 4, GREEN, 0
  30+ 7EFD 00          >
  31+ 7EFE                  ITEM RoomsListTable.TheOffLicenceLayout, 27, 4, MAGENTA, 0             ; Oggetto 5 alla colonna X=27,  riga Y=4, GREEN, (Stato: 0=attivo)
