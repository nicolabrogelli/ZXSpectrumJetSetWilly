  94+ 7487 3A BE 78         ld   a, (Audio_music_note_idx)
  95+ 748A 3C               inc  a
  96+ 748B FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 748D 38 01            jr   c, .no_wrap
  98+ 748F AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 7490              .no_wrap:
 100+ 7490 32 BE 78         ld   (Audio_music_note_idx), a
 101+ 7493
 102+ 7493                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 7493 5F               ld   e, a
 104+ 7494 16 00            ld   d, 0
 105+ 7496 21 DD 74         ld   hl, Audio_MusicSheet
 106+ 7499 19               add  hl, de
 107+ 749A 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 749B
 109+ 749B                  ; Leggi durata (secondo byte)
 110+ 749B 23               inc  hl
 111+ 749C 7E               ld   a, (hl)
 112+ 749D CB 3F            srl  a                        ; Divide per 8 (velocizza 8x)
 113+ 749F CB 3F            srl  a
 114+ 74A1 CB 3F            srl  a
 115+ 74A3 20 02            jr   nz, .dur_ok
 116+ 74A5 3E 01            ld   a, 1
