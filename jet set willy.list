 152  8923                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 153  8923 CD 31 7A         call Phys_CheckNastyCollision
 154  8926 38 0B            jr   c, .willy_dies
 155  8928                  ENDIF
 156  8928
