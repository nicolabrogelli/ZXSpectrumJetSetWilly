 268+ 5ED6 20 05            jr   nz, .not_wall
 269+ 5ED8 21 B2 00         ld   hl, OFFSET_WALL
 270+ 5EDB 18 03            jr   .load_tile
 271+ 5EDD              .not_wall:
 272+ 5EDD 21 BB 00         ld   hl, OFFSET_NASTY
 273+ 5EE0              .load_tile:
