  17+ 752F              ; Tabella dei colori, se aggiungiamo $C davanti al colore questo diventa lampeggiante
  18+ 752F              ; 1 - BLUE
  19+ 752F              ; 2 - RED
  20+ 752F              ; 3 - MAGENTA
  21+ 752F              ; 4 - GREEN
  22+ 752F              ; 5 - CYAN
