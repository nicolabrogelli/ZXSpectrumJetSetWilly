 320+ 7120 C9               ret
 321+ 7121
 322+ 7121              ; -------------------------------------------------------------------
 323+ 7121              ; DrawRoomItems
 324+ 7121              ;
 325+ 7121              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 326+ 7121              ;
 327+ 7121              ; Operazioni eseguite:
 328+ 7121              ;   1. Azzera la griglia items_grid.
 329+ 7121              ;   2. Svuota la cache degli oggetti attivi.
 330+ 7121              ;   3. Scansiona ItemsTable.
 331+ 7121              ;   4. Per ogni item della stanza corrente:
 332+ 7121              ;        - verifica se è già stato raccolto
 333+ 7121              ;        - disegna la grafica
 334+ 7121              ;        - aggiorna items_grid
 335+ 7121              ;        - memorizza l'item nella cache current_room_items
 336+ 7121              ;   5. Aggiorna num_room_items.
 337+ 7121              ;
 338+ 7121              ; Record ItemsTable:
 339+ 7121              ;   +0  Room ID
 340+ 7121              ;   +1  X (colonna)
 341+ 7121              ;   +2  Y (riga)
 342+ 7121              ;   +3  Colore
 343+ 7121              ;   +4  Collected flag
 344+ 7121              ;
 345+ 7121              ; Cache current_room_items:
 346+ 7121              ;   +0  Colonna
 347+ 7121              ;   +1  Riga
 348+ 7121              ;   +2  Colore
 349+ 7121              ;   +3  Collected flag ptr (Low)
 350+ 7121              ;   +4  Collected flag ptr (High)
 351+ 7121              ;
 352+ 7121              ; Ogni record cache occupa 5 byte.
 353+ 7121              ; -------------------------------------------------------------------
 354+ 7121              DrawRoomItems:
 355+ 7121
 356+ 7121                  ; Salva tutti i registri utilizzati
 357+ 7121 E5               push hl
 358+ 7122 D5               push de
 359+ 7123 C5               push bc
 360+ 7124 DD E5            push ix
 361+ 7126 FD E5            push iy
 362+ 7128
 363+ 7128                  ; ---------------------------------------------------------------
 364+ 7128                  ; Azzera items_grid (32 x 16 = 512 byte)
 365+ 7128                  ; ---------------------------------------------------------------
 366+ 7128 21 00 90         ld   hl, items_grid
 367+ 712B 11 01 90         ld   de, items_grid + 1
 368+ 712E 36 00            ld   (hl), 0
 369+ 7130 01 FF 01         ld   bc, 511
 370+ 7133 ED B0            ldir
 371+ 7135
 372+ 7135                  ; ---------------------------------------------------------------
 373+ 7135                  ; Nessun item attivo nella stanza
 374+ 7135                  ; ---------------------------------------------------------------
 375+ 7135 AF               xor  a
 376+ 7136 32 75 76         ld   (num_room_items), a
 377+ 7139
 378+ 7139                  ; IY punta alla cache degli item attivi
 379+ 7139 FD 21 25 76      ld   iy, current_room_items
 380+ 713D
 381+ 713D                  ; ---------------------------------------------------------------
 382+ 713D                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 383+ 713D                  ; alla stanza corrente.
 384+ 713D                  ;
 385+ 713D                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 386+ 713D                  ; ---------------------------------------------------------------
 387+ 713D 2A 76 76         ld   hl, (room_ptr)
 388+ 7140 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 389+ 7143 19               add  hl, de
 390+ 7144
 391+ 7144 E5               push hl
 392+ 7145 DD E1            pop  ix                ; IX = bitmap item
 393+ 7147
 394+ 7147                  ; ---------------------------------------------------------------
 395+ 7147                  ; Inizio scansione della tabella degli item
 396+ 7147                  ; ---------------------------------------------------------------
 397+ 7147 21 D1 6F         ld   hl, ItemsTable
 398+ 714A
 399+ 714A              .loop:
 400+ 714A
 401+ 714A                  ; ---------------------------------------------------------------
 402+ 714A                  ; Legge il Room ID del record corrente
 403+ 714A                  ; ---------------------------------------------------------------
 404+ 714A 7E               ld   a, (hl)
 405+ 714B
 406+ 714B                  ; $FF indica fine tabella
 407+ 714B FE FF            cp   $FF
 408+ 714D 28 53            jr   z, .done
 409+ 714F
 410+ 714F                  ; ---------------------------------------------------------------
 411+ 714F                  ; Verifica se l'item appartiene alla stanza corrente
 412+ 714F                  ; ---------------------------------------------------------------
 413+ 714F 57               ld   d, a
 414+ 7150
 415+ 7150 3A 1C 76         ld   a, (current_room)
 416+ 7153 BA               cp   d
 417+ 7154 20 45            jr   nz, .next_item
 418+ 7156
 419+ 7156                  ; ---------------------------------------------------------------
 420+ 7156                  ; Legge i dati dell'item
 421+ 7156                  ; ---------------------------------------------------------------
 422+ 7156
 423+ 7156 23               inc  hl
 424+ 7157 4E               ld   c, (hl)           ; X (colonna)
 425+ 7158
 426+ 7158 23               inc  hl
 427+ 7159 46               ld   b, (hl)           ; Y (riga)
 428+ 715A
 429+ 715A 23               inc  hl
 430+ 715B 5E               ld   e, (hl)           ; Colore
 431+ 715C
 432+ 715C 23               inc  hl
 433+ 715D 7E               ld   a, (hl)           ; Collected flag
 434+ 715E
 435+ 715E                  ; Se diverso da zero l'item è già stato raccolto
 436+ 715E B7               or   a
 437+ 715F 20 3E            jr   nz, .next_no_inc
 438+ 7161
 439+ 7161                  ; ---------------------------------------------------------------
 440+ 7161                  ; Disegna l'item sullo schermo
 441+ 7161                  ;
 442+ 7161                  ; B = Row
 443+ 7161                  ; C = Column
 444+ 7161                  ; HL = bitmap pointer
 445+ 7161                  ; E = Color
 446+ 7161                  ; ---------------------------------------------------------------
 447+ 7161 E5               push hl
 448+ 7162
 449+ 7162 DD E5            push ix
 450+ 7164 E1               pop  hl
 451+ 7165
 452+ 7165 CD AA 71         call DrawItemGraphic
 453+ 7168
 454+ 7168 E1               pop  hl                ; ritorna al flag collected
 455+ 7169
 456+ 7169                  ; ---------------------------------------------------------------
 457+ 7169                  ; Aggiorna items_grid
 458+ 7169                  ;
 459+ 7169                  ; Calcolo:
 460+ 7169                  ;   offset = Row * 32 + Col
 461+ 7169                  ; ---------------------------------------------------------------
 462+ 7169 E5               push hl
 463+ 716A D5               push de
 464+ 716B
 465+ 716B 26 00            ld   h, 0
 466+ 716D 68               ld   l, b              ; HL = Row
 467+ 716E
 468+ 716E 29               add  hl, hl            ; *2
 469+ 716F 29               add  hl, hl            ; *4
 470+ 7170 29               add  hl, hl            ; *8
 471+ 7171 29               add  hl, hl            ; *16
 472+ 7172 29               add  hl, hl            ; *32
 473+ 7173
 474+ 7173 16 00            ld   d, 0
 475+ 7175 59               ld   e, c              ; DE = Col
 476+ 7176
 477+ 7176 19               add  hl, de            ; Row*32 + Col
 478+ 7177
 479+ 7177 11 00 90         ld   de, items_grid
 480+ 717A 19               add  hl, de            ; puntatore nella griglia
 481+ 717B
 482+ 717B D1               pop  de                ; ripristina colore
 483+ 717C
 484+ 717C 73               ld   (hl), e           ; salva colore cella
 485+ 717D
 486+ 717D E1               pop  hl
 487+ 717E
 488+ 717E                  ; ---------------------------------------------------------------
 489+ 717E                  ; Salva l'item nella cache della stanza
 490+ 717E                  ;
 491+ 717E                  ; Questo evita di dover scansionare tutta ItemsTable
 492+ 717E                  ; durante il controllo delle collisioni.
 493+ 717E                  ; ---------------------------------------------------------------
 494+ 717E
 495+ 717E FD 71 00         ld   (iy+0), c         ; Colonna
 496+ 7181 FD 70 01         ld   (iy+1), b         ; Riga
 497+ 7184 FD 73 02         ld   (iy+2), e         ; Colore
 498+ 7187
 499+ 7187                  ; Salva il puntatore al flag "collected"
 500+ 7187 FD 75 03         ld   (iy+3), l         ; Low byte
 501+ 718A FD 74 04         ld   (iy+4), h         ; High byte
 502+ 718D
 503+ 718D                  ; Passa al record successivo della cache
 504+ 718D 01 05 00         ld   bc, 5
 505+ 7190 FD 09            add  iy, bc
 506+ 7192
 507+ 7192                  ; Incrementa il numero di item attivi
 508+ 7192 3A 75 76         ld   a, (num_room_items)
 509+ 7195 3C               inc  a
 510+ 7196 32 75 76         ld   (num_room_items), a
 511+ 7199
 512+ 7199 18 04            jr   .next_no_inc
 513+ 719B
 514+ 719B              .next_item:
 515+ 719B
 516+ 719B                  ; ---------------------------------------------------------------
 517+ 719B                  ; L'item non appartiene alla stanza corrente.
 518+ 719B                  ; Salta i campi del record:
 519+ 719B                  ;   X
 520+ 719B                  ;   Y
 521+ 719B                  ;   Color
 522+ 719B                  ;   Collected
 523+ 719B                  ; ---------------------------------------------------------------
 524+ 719B 23               inc  hl
 525+ 719C 23               inc  hl
 526+ 719D 23               inc  hl
 527+ 719E 23               inc  hl
 528+ 719F
 529+ 719F              .next_no_inc:
 530+ 719F
 531+ 719F                  ; ---------------------------------------------------------------
 532+ 719F                  ; Avanza al record successivo
 533+ 719F                  ; (prossimo Room ID)
 534+ 719F                  ; ---------------------------------------------------------------
 535+ 719F 23               inc  hl
 536+ 71A0 18 A8            jr   .loop
 537+ 71A2
 538+ 71A2              .done:
 539+ 71A2
 540+ 71A2                  ; Ripristina i registri
 541+ 71A2 FD E1            pop  iy
 542+ 71A4 DD E1            pop  ix
 543+ 71A6 D1               pop  de
 544+ 71A7 C1               pop  bc
 545+ 71A8 E1               pop  hl
 546+ 71A9
 547+ 71A9 C9               ret
 548+ 71AA
 549+ 71AA              ; -------------------------------------------------------------------
 550+ 71AA              ; DrawItemGraphic
 551+ 71AA              ;
 552+ 71AA              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 553+ 71AA              ; utilizzando una bitmap di 8 byte e un attributo colore.
 554+ 71AA              ;
 555+ 71AA              ; Input:
 556+ 71AA              ;   B = Riga attributi (3..18)
 557+ 71AA              ;   C = Colonna attributi (0..31)
 558+ 71AA              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 559+ 71AA              ;   E = Attributo colore
 560+ 71AA              ;
 561+ 71AA              ; Output:
 562+ 71AA              ;   Nessuno
 563+ 71AA              ;
 564+ 71AA              ; Registri preservati:
 565+ 71AA              ;   BC, DE, HL
 566+ 71AA              ; -------------------------------------------------------------------
 567+ 71AA              DrawItemGraphic:
 568+ 71AA
 569+ 71AA                  ; Salva i registri originali
 570+ 71AA C5               push bc
 571+ 71AB D5               push de
 572+ 71AC E5               push hl
 573+ 71AD
 574+ 71AD                  ; ---------------------------------------------------------------
 575+ 71AD                  ; Calcolo indirizzo bitmap dello Spectrum
 576+ 71AD                  ;
 577+ 71AD                  ; Ogni item occupa una cella attributi (8x8 pixel).
 578+ 71AD                  ;
 579+ 71AD                  ; Formula:
 580+ 71AD                  ;   High = $40 + (Row AND $18)
 581+ 71AD                  ;   Low  = (Row AND 7) * 32 + Col
 582+ 71AD                  ;
 583+ 71AD                  ; DE conterrà l'indirizzo della prima scanline.
 584+ 71AD                  ; ---------------------------------------------------------------
 585+ 71AD
 586+ 71AD 78               ld   a, b
 587+ 71AE E6 18            and  $18
 588+ 71B0 C6 40            add  a, $40
 589+ 71B2 57               ld   d, a              ; Byte alto indirizzo video
 590+ 71B3
 591+ 71B3 78               ld   a, b
 592+ 71B4 E6 07            and  7                 ; Riga interna al blocco da 8
 593+ 71B6
 594+ 71B6 87               add  a, a              ; *2
 595+ 71B7 87               add  a, a              ; *4
 596+ 71B8 87               add  a, a              ; *8
 597+ 71B9 87               add  a, a              ; *16
 598+ 71BA 87               add  a, a              ; *32
 599+ 71BB
 600+ 71BB 81               add  a, c              ; + colonna
 601+ 71BC
 602+ 71BC 5F               ld   e, a              ; Byte basso indirizzo video
 603+ 71BD
 604+ 71BD                  ; ---------------------------------------------------------------
 605+ 71BD                  ; Disegno bitmap
 606+ 71BD                  ;
 607+ 71BD                  ; Copia 8 byte consecutivi nella memoria video.
 608+ 71BD                  ; Ogni byte rappresenta una scanline da 8 pixel.
 609+ 71BD                  ; ---------------------------------------------------------------
 610+ 71BD
 611+ 71BD C5               push bc                ; Conserva Row e Col
 612+ 71BE
 613+ 71BE 06 08            ld   b, 8              ; Numero scanline
 614+ 71C0
 615+ 71C0              .line_loop:
 616+ 71C0
 617+ 71C0 7E               ld   a, (hl)           ; Legge scanline bitmap
 618+ 71C1 12               ld   (de), a           ; Scrive nella memoria video
 619+ 71C2
 620+ 71C2 14               inc  d                 ; Scanline successiva
 621+ 71C3 23               inc  hl                ; Byte bitmap successivo
 622+ 71C4
 623+ 71C4 05               dec  b
 624+ 71C5 20 F9            jr   nz, .line_loop
 625+ 71C7
 626+ 71C7 C1               pop  bc                ; Ripristina Row e Col
 627+ 71C8
 628+ 71C8                  ; ---------------------------------------------------------------
 629+ 71C8                  ; Calcolo indirizzo attributo
 630+ 71C8                  ;
 631+ 71C8                  ; Formula:
 632+ 71C8                  ;   AttrAddr = $5800 + Row * 32 + Col
 633+ 71C8                  ;
 634+ 71C8                  ; HL conterrà l'indirizzo della cella attributi.
 635+ 71C8                  ; ---------------------------------------------------------------
 636+ 71C8
 637+ 71C8 26 00            ld   h, 0
 638+ 71CA 68               ld   l, b              ; HL = Row
 639+ 71CB
 640+ 71CB 29               add  hl, hl            ; *2
 641+ 71CC 29               add  hl, hl            ; *4
 642+ 71CD 29               add  hl, hl            ; *8
 643+ 71CE 29               add  hl, hl            ; *16
 644+ 71CF 29               add  hl, hl            ; *32
 645+ 71D0
 646+ 71D0 79               ld   a, c              ; A = Colonna
 647+ 71D1
 648+ 71D1 85               add  a, l
 649+ 71D2 6F               ld   l, a
 650+ 71D3
 651+ 71D3 30 01            jr   nc, .no_carry
 652+ 71D5 24               inc  h
 653+ 71D6
 654+ 71D6              .no_carry:
 655+ 71D6
 656+ 71D6                  ; HL = Row * 32 + Col
 657+ 71D6
 658+ 71D6 11 00 58         ld   de, $5800
 659+ 71D9 19               add  hl, de            ; HL = indirizzo attributi
 660+ 71DA
 661+ 71DA                  ; ---------------------------------------------------------------
 662+ 71DA                  ; Recupera il colore originale dallo stack.
 663+ 71DA                  ;
 664+ 71DA                  ; Layout stack:
 665+ 71DA                  ;   HL originale
 666+ 71DA                  ;   DE originale (E = colore)
 667+ 71DA                  ;   BC originale
 668+ 71DA                  ; ---------------------------------------------------------------
 669+ 71DA
 670+ 71DA C1               pop  bc                ; Recupera HL originale
 671+ 71DB D1               pop  de                ; Recupera DE originale
 672+ 71DC
 673+ 71DC                  ; ---------------------------------------------------------------
 674+ 71DC                  ; Scrive l'attributo colore
 675+ 71DC                  ; ---------------------------------------------------------------
 676+ 71DC
 677+ 71DC 7B               ld   a, e              ; A = colore
 678+ 71DD 77               ld   (hl), a           ; Scrive nella RAM attributi
 679+ 71DE
 680+ 71DE                  ; ---------------------------------------------------------------
 681+ 71DE                  ; Ripristina HL e BC originali
 682+ 71DE                  ; ---------------------------------------------------------------
 683+ 71DE
 684+ 71DE C5               push bc
 685+ 71DF E1               pop  hl                ; HL originale
 686+ 71E0
 687+ 71E0 C1               pop  bc                ; BC originale
 688+ 71E1
 689+ 71E1 C9               ret
