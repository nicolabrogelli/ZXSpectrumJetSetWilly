# file opened: macro.asm
   1+ 5DAD              ; Macro per inserire un oggetto calcolando l'ID della stanza a tempo di compilazione dall'offset in RoomsListTable
   2+ 5DAD                  MACRO ITEM room_sublabel, x, y, color, state
   3+ 5DAD ~                    db (room_sublabel - RoomsListTable) / 2, x, y, color, state
   4+ 5DAD                  ENDM
   5+ 5DAD
   6+ 5DAD
   7+ 5DAD                  MACRO ROOM room_sublabel
   8+ 5DAD ~                    db (room_sublabel - RoomsListTable) / 2
   9+ 5DAD                  ENDM
# file closed: macro.asm
  15  5DAD                  include "interrupts.asm"
# file opened: interrupts.asm
   1+ 5DAD              ;===========================================================================
   2+ 5DAD              ; interrupts.asm
   3+ 5DAD              ;===========================================================================
   4+ 5DAD
   5+ 5DAD              ; -------------------------------------------------------------------
   6+ 5DAD              ; Setup interrupt IM2
   7+ 5DAD              ; -------------------------------------------------------------------
   8+ 5DAD              SetupIM2:
   9+ 5DAD F3               di
  10+ 5DAE 11 00 FE         ld de,IM2_TABLE
  11+ 5DB1 21 FD FD         ld hl,IM2_VECTOR
  12+ 5DB4 7A               ld a,d
  13+ 5DB5 ED 47            ld i,a
  14+ 5DB7 7D               ld a,l
  15+ 5DB8              .fill_loop:
  16+ 5DB8 12               ld (de),a
  17+ 5DB9 1C               inc e
  18+ 5DBA C2 B8 5D         jp nz,.fill_loop
  19+ 5DBD 14               inc d
  20+ 5DBE 12               ld (de),a
  21+ 5DBF 36 C3            ld (hl),$C3
  22+ 5DC1 2C               inc l
  23+ 5DC2 36 CB            ld (hl),low im2_handler
  24+ 5DC4 2C               inc l
  25+ 5DC5 36 5D            ld (hl),high im2_handler
  26+ 5DC7 ED 5E            im 2
  27+ 5DC9 FB               ei
  28+ 5DCA C9               ret
  29+ 5DCB
  30+ 5DCB              ; -------------------------------------------------------------------
  31+ 5DCB              ; Handler interrupt IM2
  32+ 5DCB              ; -------------------------------------------------------------------
  33+ 5DCB              im2_handler:
  34+ 5DCB F5               push af
  35+ 5DCC E5               push hl
  36+ 5DCD
  37+ 5DCD                  ; Reset interrupt ULA
  38+ 5DCD DB FE            in a, (0xFE)
  39+ 5DCF
  40+ 5DCF                  ; Incrementa il contatore (usato per animazioni/raster bars)
  41+ 5DCF 2A A0 EA         ld hl, (counter)
  42+ 5DD2 23               inc hl
  43+ 5DD3 22 A0 EA         ld (counter), hl
  44+ 5DD6
  45+ 5DD6                  ; Ripristina registri
  46+ 5DD6 E1               pop hl
  47+ 5DD7 F1               pop af
  48+ 5DD8 FB               ei
  49+ 5DD9 ED 4D            reti
# file closed: interrupts.asm
  16  5DDB                  include "graphics.asm"
# file opened: graphics.asm
   1+ 5DDB              ;===========================================================================
   2+ 5DDB              ; graphics.asm
   3+ 5DDB              ;===========================================================================
   4+ 5DDB
   5+ 5DDB              ; -------------------------------------------------------------------
   6+ 5DDB              ; Copia il set dei caratteri dalla ROM alla RAM
   7+ 5DDB              ; -------------------------------------------------------------------
   8+ 5DDB              Gfx_CopyChars:
   9+ 5DDB 21 00 3D         ld hl, $3D00  ; Indirizzo del set di caratteri originale in ROM (ASCII 32)
  10+ 5DDE 11 00 F1         ld de, $F100  ; Indirizzo in RAM per ASCII 32..127 ($F000 + 32*8)
  11+ 5DE1 01 00 03         ld bc, 768    ; Numero di byte da copiare (96 caratteri * 8 byte ciascuno)
  12+ 5DE4 ED B0            ldir          ; Copiare i dati
  13+ 5DE6 C9               ret
  14+ 5DE7
  15+ 5DE7              ; -------------------------------------------------------------------
  16+ 5DE7              ; Ridefinisci i caratteri (incluso quello per i bordi)
  17+ 5DE7              ; -------------------------------------------------------------------
  18+ 5DE7              Gfx_DefineChars:
  19+ 5DE7 21 7F CC         ld hl, Willy             ; Indirizzo dei dati del nuovo carattere
  20+ 5DEA 11 08 F0         ld de, $F008             ; Indirizzo di ASCII 1 nel nuovo set di caratteri ($F000 + 1*8)
  21+ 5DED 01 48 00         ld bc, 72                ; Numero di byte da copiare (9 caratteri * 8 byte)
  22+ 5DF0 ED B0            ldir                        ; Effettua la copia dei caratteri
  23+ 5DF2 21 00 F0         ld hl, $F000                ; Indirizzo del nuovo set di caratteri in RAM (font base ASCII 0)
  24+ 5DF5 22 36 5C         ld ($5C36), hl              ; Aggiornare la variabile di sistema CHARS
  25+ 5DF8 C9               ret
  26+ 5DF9
  27+ 5DF9              ; -------------------------------------------------------------------
  28+ 5DF9              ; Posiziona il cursore
  29+ 5DF9              ; Input: B = Y, C = X
  30+ 5DF9              ; -------------------------------------------------------------------
  31+ 5DF9              Gfx_At:
  32+ 5DF9 C5               push bc
  33+ 5DFA D9               exx
  34+ 5DFB C1               pop bc
  35+ 5DFC CD 23 0A         call $0a23
  36+ 5DFF D9               exx
  37+ 5E00 C9               ret
  38+ 5E01
  39+ 5E01              ; -------------------------------------------------------------------
  40+ 5E01              ; Cambia colore inchiostro
  41+ 5E01              ; Input: A = colore
  42+ 5E01              ; -------------------------------------------------------------------
  43+ 5E01              Gfx_Ink:
  44+ 5E01 D9               exx
  45+ 5E02 E6 07            and  $07               ; Garantisci colore 0..7
  46+ 5E04 47               ld   b, a
  47+ 5E05 3A 8F 5C         ld   a, (ATTR_T)
  48+ 5E08 E6 F8            and  $f8
  49+ 5E0A B0               or   b
  50+ 5E0B 32 8F 5C         ld   (ATTR_T), a
  51+ 5E0E D9               exx
  52+ 5E0F C9               ret
  53+ 5E10
  54+ 5E10              ; -------------------------------------------------------------------
  55+ 5E10              ; ===================================================================
  56+ 5E10              ; NUOVE ROUTINE DI RENDERING PIXEL-BY-PIXEL
  57+ 5E10              ; ===================================================================
  58+ 5E10
  59+ 5E10              ; -------------------------------------------------------------------
  60+ 5E10              ; Calcola indirizzo schermo da coordinate pixel (X, Y)
  61+ 5E10              ; Input: H = Y (0..191), L = X (0..255)
  62+ 5E10              ; Output: HL = indirizzo schermo
  63+ 5E10              ; -------------------------------------------------------------------
  64+ 5E10              Gfx_GetScreenAddr:
  65+ 5E10 7C               ld a, h
  66+ 5E11 E6 07            and %00000111     ; A = y2 y1 y0 (scanline offset)
  67+ 5E13 F6 40            or  %01000000     ; Base dello schermo ($40)
  68+ 5E15 57               ld  d, a          ; D = high byte parziale
  69+ 5E16
  70+ 5E16 7C               ld  a, h
  71+ 5E17 E6 C0            and %11000000     ; A = y7 y6 000000 (third select)
  72+ 5E19 0F               rrca
  73+ 5E1A 0F               rrca
  74+ 5E1B 0F               rrca              ; Shift a destra di 3 -> 000 y7 y6 000
  75+ 5E1C B2               or  d
  76+ 5E1D 57               ld  d, a          ; D = high byte completo (010 y7 y6 y2 y1 y0)
  77+ 5E1E
  78+ 5E1E 7C               ld  a, h
  79+ 5E1F E6 38            and %00111000     ; A = 00 y5 y4 y3 000 (character row)
  80+ 5E21 87               add a, a
  81+ 5E22 87               add a, a          ; Shift a sinistra di 2 -> y5 y4 y3 00000
  82+ 5E23 5F               ld  e, a          ; E = low byte parziale
  83+ 5E24
  84+ 5E24 7D               ld  a, l
  85+ 5E25 CB 3F            srl a
  86+ 5E27 CB 3F            srl a
  87+ 5E29 CB 3F            srl a              ; A = X / 8 (colonna)
  88+ 5E2B B3               or  e
  89+ 5E2C 5F               ld  e, a          ; E = low byte completo
  90+ 5E2D
  91+ 5E2D 62               ld  h, d
  92+ 5E2E 6B               ld  l, e          ; HL = indirizzo finale
  93+ 5E2F C9               ret
  94+ 5E30
  95+ 5E30              ; -------------------------------------------------------------------
  96+ 5E30              ; Incrementa indirizzo schermo alla riga (scanline) successiva
  97+ 5E30              ; Input/Output: HL = indirizzo schermo
  98+ 5E30              ; -------------------------------------------------------------------
  99+ 5E30              Gfx_IncScreenLine:
 100+ 5E30 24               inc h             ; Vai alla riga successiva
 101+ 5E31 7C               ld  a, h
 102+ 5E32 E6 07            and 7             ; Controlla se la scanline è tornata a 0 (wrap)
 103+ 5E34 C0               ret nz            ; Se non è 0, abbiamo finito!
 104+ 5E35
 105+ 5E35 7D               ld  a, l
 106+ 5E36 C6 20            add a, 32         ; Altrimenti passa alla riga di caratteri successiva
 107+ 5E38 6F               ld  l, a
 108+ 5E39 D8               ret c             ; Se c'è carry, abbiamo cambiato terzo e H è già corretto!
 109+ 5E3A
 110+ 5E3A                  ; Se non c'è carry, rimaniamo nello stesso terzo. Ripristina il terzo corretto in H.
 111+ 5E3A 7C               ld  a, h
 112+ 5E3B D6 08            sub 8
 113+ 5E3D 67               ld  h, a
 114+ 5E3E C9               ret
