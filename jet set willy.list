 723+ 60D5              ; Disegna la riga/pavimento sotto i piedi degli sprite (Riga 18, Y = 144)
 724+ 60D5              ; -------------------------------------------------------------------
 725+ 60D5              ; -------------------------------------------------------------------
 726+ 60D5              ; Disegna un tile 8x8 sullo schermo
 727+ 60D5              ; Input: B = Row (0..23), C = Col (0..31), IX = Puntatore al Tile (9 byte: 1 attr + 8 bitmap)
 728+ 60D5              ; -------------------------------------------------------------------
 729+ 60D5              DrawTile:
 730+ 60D5 C5               push bc
 731+ 60D6 D5               push de
 732+ 60D7 E5               push hl
 733+ 60D8
 734+ 60D8                  ; 1. Calcola indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 735+ 60D8                  ; HighByte = $40 + (B & $18)
 736+ 60D8 78               ld   a, b
 737+ 60D9 E6 18            and  $18
 738+ 60DB C6 40            add  a, $40
 739+ 60DD 67               ld   h, a              ; H = High byte
 740+ 60DE
 741+ 60DE                  ; LowByte = ((B & 7) * 32) + C
 742+ 60DE 78               ld   a, b
 743+ 60DF E6 07            and  7
 744+ 60E1 87               add  a, a              ; *2
 745+ 60E2 87               add  a, a              ; *4
 746+ 60E3 87               add  a, a              ; *8
 747+ 60E4 87               add  a, a              ; *16
 748+ 60E5 87               add  a, a              ; *32
 749+ 60E6 81               add  a, c              ; + Col C
 750+ 60E7 6F               ld   l, a              ; L = Low byte
 751+ 60E8
 752+ 60E8                  ; 2. Copia gli 8 byte del bitmap
 753+ 60E8 16 08            ld   d, 8              ; 8 scanline
 754+ 60EA DD E5            push ix
 755+ 60EC DD 23            inc  ix                ; Salta l'attributo, vai al bitmap
 756+ 60EE              .line_loop:
 757+ 60EE DD 7E 00         ld   a, (ix+0)
 758+ 60F1 77               ld   (hl), a
 759+ 60F2 24               inc  h                 ; Prossima scanline (stessa riga di caratteri)
 760+ 60F3 DD 23            inc  ix
 761+ 60F5 15               dec  d
 762+ 60F6 20 F6            jr   nz, .line_loop
 763+ 60F8 DD E1            pop  ix
 764+ 60FA
 765+ 60FA                  ; 3. Scrivi l'attributo
 766+ 60FA                  ; AttrAddr = $5800 + B * 32 + C
 767+ 60FA 26 00            ld   h, 0
 768+ 60FC 68               ld   l, b              ; HL = B (Row)
 769+ 60FD 29               add  hl, hl            ; *2
 770+ 60FE 29               add  hl, hl            ; *4
 771+ 60FF 29               add  hl, hl            ; *8
 772+ 6100 29               add  hl, hl            ; *16
 773+ 6101 29               add  hl, hl            ; *32
 774+ 6102 16 00            ld   d, 0
 775+ 6104 59               ld   e, c              ; DE = C (Col)
