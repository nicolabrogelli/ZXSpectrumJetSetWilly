   8+ 7407              ; UpdateJumpSound
   9+ 7407              ;
  10+ 7407              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7407              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7407              ; -------------------------------------------------------------------
  13+ 7407              UpdateJumpSound:
  14+ 7407 F5               push af
  15+ 7408 C5               push bc
  16+ 7409 D5               push de
  17+ 740A E5               push hl
  18+ 740B
  19+ 740B                  ; Controlla se il suono è attivo (note < 18)
  20+ 740B 3A 7A 78         ld   a, (jump_sound_note)
  21+ 740E FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7410 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7412
  24+ 7412                  ; Carica la nota corrente da suonare
  25+ 7412 5F               ld   e, a
  26+ 7413 16 00            ld   d, 0
  27+ 7415 21 41 74         ld   hl, JumpSoundDelays
  28+ 7418 19               add  hl, de
  29+ 7419 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 741A 57               ld   d, a                      ; D = delay della nota
  31+ 741B
  32+ 741B                  ; Suona la nota: 15 cicli
  33+ 741B 06 0F            ld   b, 15
  34+ 741D              .note_loop:
  35+ 741D                  ; Speaker ON
  36+ 741D 3A 0F 75         ld   a, (room_border_color)
  37+ 7420 F6 10            or   $10
  38+ 7422 D3 FE            out  ($fe), a
  39+ 7424 4A               ld   c, d
  40+ 7425              .d1:
  41+ 7425 0D               dec  c
  42+ 7426 20 FD            jr   nz, .d1
  43+ 7428
  44+ 7428                  ; Speaker OFF
  45+ 7428 3A 0F 75         ld   a, (room_border_color)
  46+ 742B E6 EF            and  $ef
  47+ 742D D3 FE            out  ($fe), a
  48+ 742F 4A               ld   c, d
  49+ 7430              .d2:
  50+ 7430 0D               dec  c
  51+ 7431 20 FD            jr   nz, .d2
  52+ 7433
  53+ 7433 10 E8            djnz .note_loop
  54+ 7435
  55+ 7435                  ; Passa alla nota successiva
  56+ 7435 3A 7A 78         ld   a, (jump_sound_note)
  57+ 7438 3C               inc  a
  58+ 7439 32 7A 78         ld   (jump_sound_note), a
  59+ 743C
  60+ 743C              .done:
  61+ 743C E1               pop  hl
  62+ 743D D1               pop  de
  63+ 743E C1               pop  bc
