 275+ 5EE1 ED 5B 2C 77      ld   de, (room_ptr)
 276+ 5EE5 19               add  hl, de            ; HL = tile pointer
 277+ 5EE6 D1               pop  de
 278+ 5EE7
 279+ 5EE7                  ; 6. Calcola offset scanline: s = Y % 8 (in D)
 280+ 5EE7 7A               ld   a, d
 281+ 5EE8 E6 07            and  7                 ; A = s (0..7)
 282+ 5EEA 3C               inc  a                 ; A = 1 + s
 283+ 5EEB 85               add  a, l
 284+ 5EEC 6F               ld   l, a
 285+ 5EED 30 01            jr   nc, .no_carry
 286+ 5EEF 24               inc  h
 287+ 5EF0              .no_carry:
 288+ 5EF0 7E               ld   a, (hl)           ; A = byte dello sfondo
 289+ 5EF1
 290+ 5EF1 C1               pop  bc
 291+ 5EF2 D1               pop  de
 292+ 5EF3 E1               pop  hl
 293+ 5EF4 C9               ret
 294+ 5EF5
 295+ 5EF5              .blank:
