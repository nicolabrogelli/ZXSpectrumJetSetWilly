 274  86F7              ; ShowTitleScreen
 275  86F7              ; Visualizza la schermata iniziale del gioco (Title Screen).
 276  86F7              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 277  86F7              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 278  86F7              ; -------------------------------------------------------------------
 279  86F7              ShowTitleScreen:
 280  86F7                  ; 1. Disegna la schermata iniziale
 281  86F7 CD E4 62         call Gfx_DrawTitleScreen
 282  86FA
 283  86FA                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 284  86FA              .wait_title_enter_release:
 285  86FA 76               halt
 286  86FB 3E BF            ld   a, $bf
 287  86FD DB FE            in   a, ($fe)
 288  86FF 1F               rra
 289  8700 30 F8            jr   nc, .wait_title_enter_release
 290  8702
 291  8702                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 292  8702 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 293  8704              .title_loop:
 294  8704 76               halt
 295  8705
 296  8705                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 297  8705 0C               inc  c
 298  8706 79               ld   a, c
 299  8707 CB 3F            srl  a
 300  8709 CB 3F            srl  a
 301  870B CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 302  870D E6 07            and  7
 303  870F 5F               ld   e, a
 304  8710 16 00            ld   d, 0
 305  8712 21 DC 62         ld   hl, title_color_table
 306  8715 19               add  hl, de
 307  8716 7E               ld   a, (hl)               ; A = nuovo colore
 308  8717 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 309  871A 06 20            ld   b, 32
 310  871C              .color_title_loop:
 311  871C 77               ld   (hl), a
 312  871D 23               inc  hl
 313  871E 10 FC            djnz .color_title_loop
 314  8720
 315  8720                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 316  8720 3E BF            ld   a, $bf
 317  8722 DB FE            in   a, ($fe)
 318  8724 1F               rra
 319  8725 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 320  8727
 321  8727                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 322  8727              .wait_title_enter_release_after:
 323  8727 76               halt
 324  8728 3E BF            ld   a, $bf
 325  872A DB FE            in   a, ($fe)
 326  872C 1F               rra
 327  872D 30 F8            jr   nc, .wait_title_enter_release_after
 328  872F
 329  872F                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 330  872F AF               xor  a
 331  8730 D3 FE            out  ($fe), a              ; Bordo a nero
 332  8732 21 8D 5C         ld   hl, ATTR_P
 333  8735 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 334  8736 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 335  8739 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 336  873B 3E 07            ld   a, $07
 337  873D 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 338  8740
 339  8740                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 340  8740 CD 7F 87         call ResetFullGameState
 341  8743
 342  8743                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 343  8743 C3 DF 85         jp   LoadRoomAndRestart
