 200+ 6C87              .unknown:
 201+ 6C87
 202+ 6C87                  ; Nessuna corrispondenza trovata.
 203+ 6C87                  ; Imposta la stanza di default.
 204+ 6C87 3E 00            ld   a, 0
 205+ 6C89
 206+ 6C89              .set_room:
 207+ 6C89
 208+ 6C89                  ; Salva l'ID della stanza corrente
 209+ 6C89 32 C7 7D         ld   (current_room), a
 210+ 6C8C
 211+ 6C8C                  ; Ripristina i registri
 212+ 6C8C D1               pop  de
 213+ 6C8D E1               pop  hl
 214+ 6C8E
 215+ 6C8E C9               ret
 216+ 6C8F
 217+ 6C8F              ; -------------------------------------------------------------------
 218+ 6C8F              ; DrawRoomItems
 219+ 6C8F              ;
 220+ 6C8F              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 221+ 6C8F              ;
 222+ 6C8F              ; Operazioni eseguite:
 223+ 6C8F              ;   1. Azzera la griglia items_grid.
 224+ 6C8F              ;   2. Svuota la cache degli oggetti attivi.
 225+ 6C8F              ;   3. Scansiona ItemsTable.
 226+ 6C8F              ;   4. Per ogni item della stanza corrente:
 227+ 6C8F              ;        - verifica se è già stato raccolto
 228+ 6C8F              ;        - disegna la grafica
 229+ 6C8F              ;        - aggiorna items_grid
 230+ 6C8F              ;        - memorizza l'item nella cache current_room_items
 231+ 6C8F              ;   5. Aggiorna num_room_items.
 232+ 6C8F              ;
 233+ 6C8F              ; Record ItemsTable:
 234+ 6C8F              ;   +0  Room ID
 235+ 6C8F              ;   +1  X (colonna)
 236+ 6C8F              ;   +2  Y (riga)
 237+ 6C8F              ;   +3  Colore
 238+ 6C8F              ;   +4  Collected flag
 239+ 6C8F              ;
 240+ 6C8F              ; Cache current_room_items:
 241+ 6C8F              ;   +0  Colonna
 242+ 6C8F              ;   +1  Riga
 243+ 6C8F              ;   +2  Colore
 244+ 6C8F              ;   +3  Collected flag ptr (Low)
 245+ 6C8F              ;   +4  Collected flag ptr (High)
 246+ 6C8F              ;
 247+ 6C8F              ; Ogni record cache occupa 5 byte.
 248+ 6C8F              ; -------------------------------------------------------------------
 249+ 6C8F              DrawRoomItems:
 250+ 6C8F
 251+ 6C8F                  ; Salva tutti i registri utilizzati
 252+ 6C8F E5               push hl
 253+ 6C90 D5               push de
 254+ 6C91 C5               push bc
 255+ 6C92 DD E5            push ix
 256+ 6C94 FD E5            push iy
 257+ 6C96
 258+ 6C96                  ; ---------------------------------------------------------------
 259+ 6C96                  ; Azzera items_grid (32 x 16 = 512 byte)
 260+ 6C96                  ; ---------------------------------------------------------------
 261+ 6C96 21 00 90         ld   hl, items_grid
 262+ 6C99 11 01 90         ld   de, items_grid + 1
 263+ 6C9C 36 00            ld   (hl), 0
 264+ 6C9E 01 FF 01         ld   bc, 511
 265+ 6CA1 ED B0            ldir
 266+ 6CA3
 267+ 6CA3                  ; ---------------------------------------------------------------
 268+ 6CA3                  ; Nessun item attivo nella stanza
 269+ 6CA3                  ; ---------------------------------------------------------------
 270+ 6CA3 AF               xor  a
 271+ 6CA4 32 20 7E         ld   (num_room_items), a
 272+ 6CA7
 273+ 6CA7                  ; IY punta alla cache degli item attivi
 274+ 6CA7 FD 21 D0 7D      ld   iy, current_room_items
 275+ 6CAB
 276+ 6CAB                  ; ---------------------------------------------------------------
 277+ 6CAB                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 278+ 6CAB                  ; alla stanza corrente.
 279+ 6CAB                  ;
 280+ 6CAB                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 281+ 6CAB                  ; ---------------------------------------------------------------
 282+ 6CAB 2A 21 7E         ld   hl, (room_ptr)
 283+ 6CAE 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 284+ 6CB1 19               add  hl, de
 285+ 6CB2
 286+ 6CB2 E5               push hl
 287+ 6CB3 DD E1            pop  ix                ; IX = bitmap item
 288+ 6CB5
 289+ 6CB5                  ; ---------------------------------------------------------------
 290+ 6CB5                  ; Inizio scansione della tabella degli item
 291+ 6CB5                  ; ---------------------------------------------------------------
 292+ 6CB5 21 B7 6B         ld   hl, ItemsTable
 293+ 6CB8
 294+ 6CB8              .loop:
 295+ 6CB8
 296+ 6CB8                  ; ---------------------------------------------------------------
 297+ 6CB8                  ; Legge il Room ID del record corrente
 298+ 6CB8                  ; ---------------------------------------------------------------
 299+ 6CB8 7E               ld   a, (hl)
 300+ 6CB9
 301+ 6CB9                  ; $FF indica fine tabella
 302+ 6CB9 FE FF            cp   $FF
 303+ 6CBB 28 53            jr   z, .done
 304+ 6CBD
 305+ 6CBD                  ; ---------------------------------------------------------------
 306+ 6CBD                  ; Verifica se l'item appartiene alla stanza corrente
 307+ 6CBD                  ; ---------------------------------------------------------------
 308+ 6CBD 57               ld   d, a
 309+ 6CBE
 310+ 6CBE 3A C7 7D         ld   a, (current_room)
 311+ 6CC1 BA               cp   d
 312+ 6CC2 20 45            jr   nz, .next_item
 313+ 6CC4
 314+ 6CC4                  ; ---------------------------------------------------------------
 315+ 6CC4                  ; Legge i dati dell'item
 316+ 6CC4                  ; ---------------------------------------------------------------
 317+ 6CC4
 318+ 6CC4 23               inc  hl
 319+ 6CC5 4E               ld   c, (hl)           ; X (colonna)
 320+ 6CC6
 321+ 6CC6 23               inc  hl
 322+ 6CC7 46               ld   b, (hl)           ; Y (riga)
 323+ 6CC8
 324+ 6CC8 23               inc  hl
 325+ 6CC9 5E               ld   e, (hl)           ; Colore
 326+ 6CCA
 327+ 6CCA 23               inc  hl
 328+ 6CCB 7E               ld   a, (hl)           ; Collected flag
 329+ 6CCC
 330+ 6CCC                  ; Se diverso da zero l'item è già stato raccolto
 331+ 6CCC B7               or   a
 332+ 6CCD 20 3E            jr   nz, .next_no_inc
 333+ 6CCF
 334+ 6CCF                  ; ---------------------------------------------------------------
 335+ 6CCF                  ; Disegna l'item sullo schermo
 336+ 6CCF                  ;
 337+ 6CCF                  ; B = Row
 338+ 6CCF                  ; C = Column
 339+ 6CCF                  ; HL = bitmap pointer
 340+ 6CCF                  ; E = Color
 341+ 6CCF                  ; ---------------------------------------------------------------
 342+ 6CCF E5               push hl
 343+ 6CD0
 344+ 6CD0 DD E5            push ix
 345+ 6CD2 E1               pop  hl
 346+ 6CD3
 347+ 6CD3 CD 18 6D         call DrawItemGraphic
 348+ 6CD6
 349+ 6CD6 E1               pop  hl                ; ritorna al flag collected
 350+ 6CD7
 351+ 6CD7                  ; ---------------------------------------------------------------
 352+ 6CD7                  ; Aggiorna items_grid
 353+ 6CD7                  ;
 354+ 6CD7                  ; Calcolo:
 355+ 6CD7                  ;   offset = Row * 32 + Col
 356+ 6CD7                  ; ---------------------------------------------------------------
 357+ 6CD7 E5               push hl
 358+ 6CD8 D5               push de
 359+ 6CD9
 360+ 6CD9 26 00            ld   h, 0
 361+ 6CDB 68               ld   l, b              ; HL = Row
 362+ 6CDC
 363+ 6CDC 29               add  hl, hl            ; *2
 364+ 6CDD 29               add  hl, hl            ; *4
 365+ 6CDE 29               add  hl, hl            ; *8
 366+ 6CDF 29               add  hl, hl            ; *16
 367+ 6CE0 29               add  hl, hl            ; *32
 368+ 6CE1
 369+ 6CE1 16 00            ld   d, 0
 370+ 6CE3 59               ld   e, c              ; DE = Col
 371+ 6CE4
 372+ 6CE4 19               add  hl, de            ; Row*32 + Col
 373+ 6CE5
 374+ 6CE5 11 00 90         ld   de, items_grid
 375+ 6CE8 19               add  hl, de            ; puntatore nella griglia
 376+ 6CE9
 377+ 6CE9 D1               pop  de                ; ripristina colore
 378+ 6CEA
 379+ 6CEA 73               ld   (hl), e           ; salva colore cella
 380+ 6CEB
 381+ 6CEB E1               pop  hl
 382+ 6CEC
 383+ 6CEC                  ; ---------------------------------------------------------------
 384+ 6CEC                  ; Salva l'item nella cache della stanza
 385+ 6CEC                  ;
 386+ 6CEC                  ; Questo evita di dover scansionare tutta ItemsTable
 387+ 6CEC                  ; durante il controllo delle collisioni.
 388+ 6CEC                  ; ---------------------------------------------------------------
 389+ 6CEC
 390+ 6CEC FD 71 00         ld   (iy+0), c         ; Colonna
 391+ 6CEF FD 70 01         ld   (iy+1), b         ; Riga
 392+ 6CF2 FD 73 02         ld   (iy+2), e         ; Colore
 393+ 6CF5
 394+ 6CF5                  ; Salva il puntatore al flag "collected"
 395+ 6CF5 FD 75 03         ld   (iy+3), l         ; Low byte
 396+ 6CF8 FD 74 04         ld   (iy+4), h         ; High byte
 397+ 6CFB
 398+ 6CFB                  ; Passa al record successivo della cache
 399+ 6CFB 01 05 00         ld   bc, 5
 400+ 6CFE FD 09            add  iy, bc
 401+ 6D00
 402+ 6D00                  ; Incrementa il numero di item attivi
 403+ 6D00 3A 20 7E         ld   a, (num_room_items)
 404+ 6D03 3C               inc  a
 405+ 6D04 32 20 7E         ld   (num_room_items), a
 406+ 6D07
 407+ 6D07 18 04            jr   .next_no_inc
 408+ 6D09
 409+ 6D09              .next_item:
 410+ 6D09
 411+ 6D09                  ; ---------------------------------------------------------------
 412+ 6D09                  ; L'item non appartiene alla stanza corrente.
 413+ 6D09                  ; Salta i campi del record:
 414+ 6D09                  ;   X
 415+ 6D09                  ;   Y
 416+ 6D09                  ;   Color
 417+ 6D09                  ;   Collected
 418+ 6D09                  ; ---------------------------------------------------------------
 419+ 6D09 23               inc  hl
 420+ 6D0A 23               inc  hl
 421+ 6D0B 23               inc  hl
 422+ 6D0C 23               inc  hl
 423+ 6D0D
 424+ 6D0D              .next_no_inc:
 425+ 6D0D
 426+ 6D0D                  ; ---------------------------------------------------------------
 427+ 6D0D                  ; Avanza al record successivo
 428+ 6D0D                  ; (prossimo Room ID)
 429+ 6D0D                  ; ---------------------------------------------------------------
 430+ 6D0D 23               inc  hl
 431+ 6D0E 18 A8            jr   .loop
 432+ 6D10
 433+ 6D10              .done:
 434+ 6D10
 435+ 6D10                  ; Ripristina i registri
 436+ 6D10 FD E1            pop  iy
 437+ 6D12 DD E1            pop  ix
 438+ 6D14 D1               pop  de
 439+ 6D15 C1               pop  bc
 440+ 6D16 E1               pop  hl
 441+ 6D17
 442+ 6D17 C9               ret
 443+ 6D18
 444+ 6D18              ; -------------------------------------------------------------------
 445+ 6D18              ; DrawItemGraphic
 446+ 6D18              ;
 447+ 6D18              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 448+ 6D18              ; utilizzando una bitmap di 8 byte e un attributo colore.
 449+ 6D18              ;
 450+ 6D18              ; Input:
 451+ 6D18              ;   B = Riga attributi (3..18)
 452+ 6D18              ;   C = Colonna attributi (0..31)
 453+ 6D18              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 454+ 6D18              ;   E = Attributo colore
 455+ 6D18              ;
 456+ 6D18              ; Output:
 457+ 6D18              ;   Nessuno
 458+ 6D18              ;
 459+ 6D18              ; Registri preservati:
 460+ 6D18              ;   BC, DE, HL
 461+ 6D18              ; -------------------------------------------------------------------
 462+ 6D18              DrawItemGraphic:
 463+ 6D18
 464+ 6D18                  ; Salva i registri originali
 465+ 6D18 C5               push bc
 466+ 6D19 D5               push de
 467+ 6D1A E5               push hl
 468+ 6D1B
 469+ 6D1B                  ; ---------------------------------------------------------------
 470+ 6D1B                  ; Calcolo indirizzo bitmap dello Spectrum
 471+ 6D1B                  ;
 472+ 6D1B                  ; Ogni item occupa una cella attributi (8x8 pixel).
 473+ 6D1B                  ;
 474+ 6D1B                  ; Formula:
 475+ 6D1B                  ;   High = $40 + (Row AND $18)
 476+ 6D1B                  ;   Low  = (Row AND 7) * 32 + Col
 477+ 6D1B                  ;
 478+ 6D1B                  ; DE conterrà l'indirizzo della prima scanline.
 479+ 6D1B                  ; ---------------------------------------------------------------
 480+ 6D1B
 481+ 6D1B 78               ld   a, b
 482+ 6D1C E6 18            and  $18
 483+ 6D1E C6 40            add  a, $40
 484+ 6D20 57               ld   d, a              ; Byte alto indirizzo video
 485+ 6D21
 486+ 6D21 78               ld   a, b
 487+ 6D22 E6 07            and  7                 ; Riga interna al blocco da 8
 488+ 6D24
 489+ 6D24 87               add  a, a              ; *2
 490+ 6D25 87               add  a, a              ; *4
 491+ 6D26 87               add  a, a              ; *8
 492+ 6D27 87               add  a, a              ; *16
 493+ 6D28 87               add  a, a              ; *32
 494+ 6D29
 495+ 6D29 81               add  a, c              ; + colonna
 496+ 6D2A
 497+ 6D2A 5F               ld   e, a              ; Byte basso indirizzo video
 498+ 6D2B
 499+ 6D2B                  ; ---------------------------------------------------------------
 500+ 6D2B                  ; Disegno bitmap
 501+ 6D2B                  ;
 502+ 6D2B                  ; Copia 8 byte consecutivi nella memoria video.
 503+ 6D2B                  ; Ogni byte rappresenta una scanline da 8 pixel.
 504+ 6D2B                  ; ---------------------------------------------------------------
 505+ 6D2B
 506+ 6D2B C5               push bc                ; Conserva Row e Col
 507+ 6D2C
 508+ 6D2C 06 08            ld   b, 8              ; Numero scanline
 509+ 6D2E
 510+ 6D2E              .line_loop:
 511+ 6D2E
 512+ 6D2E 7E               ld   a, (hl)           ; Legge scanline bitmap
 513+ 6D2F 12               ld   (de), a           ; Scrive nella memoria video
 514+ 6D30
 515+ 6D30 14               inc  d                 ; Scanline successiva
 516+ 6D31 23               inc  hl                ; Byte bitmap successivo
 517+ 6D32
 518+ 6D32 05               dec  b
 519+ 6D33 20 F9            jr   nz, .line_loop
 520+ 6D35
 521+ 6D35 C1               pop  bc                ; Ripristina Row e Col
 522+ 6D36
 523+ 6D36                  ; ---------------------------------------------------------------
 524+ 6D36                  ; Calcolo indirizzo attributo
 525+ 6D36                  ;
 526+ 6D36                  ; Formula:
 527+ 6D36                  ;   AttrAddr = $5800 + Row * 32 + Col
 528+ 6D36                  ;
 529+ 6D36                  ; HL conterrà l'indirizzo della cella attributi.
 530+ 6D36                  ; ---------------------------------------------------------------
 531+ 6D36
 532+ 6D36 26 00            ld   h, 0
 533+ 6D38 68               ld   l, b              ; HL = Row
 534+ 6D39
 535+ 6D39 29               add  hl, hl            ; *2
 536+ 6D3A 29               add  hl, hl            ; *4
 537+ 6D3B 29               add  hl, hl            ; *8
 538+ 6D3C 29               add  hl, hl            ; *16
 539+ 6D3D 29               add  hl, hl            ; *32
 540+ 6D3E
 541+ 6D3E 79               ld   a, c              ; A = Colonna
 542+ 6D3F
 543+ 6D3F 85               add  a, l
 544+ 6D40 6F               ld   l, a
 545+ 6D41
 546+ 6D41 30 01            jr   nc, .no_carry
 547+ 6D43 24               inc  h
 548+ 6D44
 549+ 6D44              .no_carry:
 550+ 6D44
 551+ 6D44                  ; HL = Row * 32 + Col
 552+ 6D44
 553+ 6D44 11 00 58         ld   de, $5800
 554+ 6D47 19               add  hl, de            ; HL = indirizzo attributi
 555+ 6D48
 556+ 6D48                  ; ---------------------------------------------------------------
 557+ 6D48                  ; Recupera il colore originale dallo stack.
 558+ 6D48                  ;
 559+ 6D48                  ; Layout stack:
 560+ 6D48                  ;   HL originale
 561+ 6D48                  ;   DE originale (E = colore)
 562+ 6D48                  ;   BC originale
 563+ 6D48                  ; ---------------------------------------------------------------
 564+ 6D48
 565+ 6D48 C1               pop  bc                ; Recupera HL originale
 566+ 6D49 D1               pop  de                ; Recupera DE originale
 567+ 6D4A
 568+ 6D4A                  ; ---------------------------------------------------------------
 569+ 6D4A                  ; Scrive l'attributo colore
 570+ 6D4A                  ; ---------------------------------------------------------------
 571+ 6D4A
 572+ 6D4A 7B               ld   a, e              ; A = colore
 573+ 6D4B 77               ld   (hl), a           ; Scrive nella RAM attributi
 574+ 6D4C
 575+ 6D4C                  ; ---------------------------------------------------------------
 576+ 6D4C                  ; Ripristina HL e BC originali
 577+ 6D4C                  ; ---------------------------------------------------------------
 578+ 6D4C
 579+ 6D4C C5               push bc
 580+ 6D4D E1               pop  hl                ; HL originale
 581+ 6D4E
 582+ 6D4E C1               pop  bc                ; BC originale
 583+ 6D4F
 584+ 6D4F C9               ret
 585+ 6D50
 586+ 6D50              ; -------------------------------------------------------------------
 587+ 6D50              ; RestoreBackgroundCell
 588+ 6D50              ;
 589+ 6D50              ; Ripristina il contenuto originale di una cella della stanza.
 590+ 6D50              ; Viene utilizzata principalmente quando un item viene raccolto:
 591+ 6D50              ; invece di lasciare un "buco", la routine ridisegna il tile
 592+ 6D50              ; originale presente nella mappa della stanza.
 593+ 6D50              ;
 594+ 6D50              ; Input:
 595+ 6D50              ;   B = Row (3..18)
 596+ 6D50              ;   C = Col (0..31)
 597+ 6D50              ;
 598+ 6D50              ; Utilizza:
 599+ 6D50              ;   room_ptr -> struttura dati della stanza corrente
 600+ 6D50              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 601+ 6D50              ;   DrawTile -> ridisegna il tile selezionato
 602+ 6D50              ;
 603+ 6D50              ; Tipi di cella:
 604+ 6D50              ;   0 = Background
 605+ 6D50              ;   1 = Floor
 606+ 6D50              ;   2 = Wall
 607+ 6D50              ;   3 = Nasty
 608+ 6D50              ; -------------------------------------------------------------------
 609+ 6D50              RestoreBackgroundCell:
 610+ 6D50
 611+ 6D50                  ; Salva tutti i registri utilizzati
 612+ 6D50 FD E5            push iy
 613+ 6D52 C5               push bc
 614+ 6D53 D5               push de
 615+ 6D54 E5               push hl
 616+ 6D55 DD E5            push ix
 617+ 6D57
 618+ 6D57                  ; ---------------------------------------------------------------
 619+ 6D57                  ; Conserva Row e Col in IY.
 620+ 6D57                  ;
 621+ 6D57                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 622+ 6D57                  ; BC potrebbe essere modificato.
 623+ 6D57                  ; ---------------------------------------------------------------
 624+ 6D57 C5               push bc
 625+ 6D58 FD E1            pop  iy                ; IYH = Row, IYL = Col
 626+ 6D5A
 627+ 6D5A                  ; ---------------------------------------------------------------
 628+ 6D5A                  ; Determina quale tipo di cella è presente nella posizione
 629+ 6D5A                  ; specificata.
 630+ 6D5A                  ;
 631+ 6D5A                  ; Input:
 632+ 6D5A                  ;   B = Row
 633+ 6D5A                  ;   C = Col
 634+ 6D5A                  ;
 635+ 6D5A                  ; Output:
 636+ 6D5A                  ;   A = tipo cella
 637+ 6D5A                  ; ---------------------------------------------------------------
 638+ 6D5A 78               ld   a, b
 639+ 6D5B
 640+ 6D5B CD A6 68         call GetCellFromUnpacked
 641+ 6D5E
 642+ 6D5E                  ; ---------------------------------------------------------------
 643+ 6D5E                  ; Recupera il puntatore alla stanza corrente.
 644+ 6D5E                  ;
 645+ 6D5E                  ; DE = base della struttura stanza
 646+ 6D5E                  ; ---------------------------------------------------------------
 647+ 6D5E ED 5B 21 7E      ld   de, (room_ptr)
 648+ 6D62
 649+ 6D62                  ; ---------------------------------------------------------------
 650+ 6D62                  ; Seleziona il tile corretto in base al tipo di cella.
 651+ 6D62                  ;
 652+ 6D62                  ; A = 0 -> Background
 653+ 6D62                  ; A = 1 -> Floor
 654+ 6D62                  ; A = 2 -> Wall
 655+ 6D62                  ; A = 3 -> Nasty
 656+ 6D62                  ; ---------------------------------------------------------------
 657+ 6D62
 658+ 6D62 B7               or   a
 659+ 6D63 20 06            jr   nz, .not_bg
 660+ 6D65
 661+ 6D65                  ; Background
 662+ 6D65 21 A0 00         ld   hl, OFFSET_BG
 663+ 6D68 19               add  hl, de
 664+ 6D69 18 16            jr   .draw_cell
 665+ 6D6B
 666+ 6D6B              .not_bg:
 667+ 6D6B
 668+ 6D6B 3D               dec  a
 669+ 6D6C 20 06            jr   nz, .not_floor
 670+ 6D6E
 671+ 6D6E                  ; Floor
 672+ 6D6E 21 A9 00         ld   hl, OFFSET_FLOOR
 673+ 6D71 19               add  hl, de
 674+ 6D72 18 0D            jr   .draw_cell
 675+ 6D74
 676+ 6D74              .not_floor:
 677+ 6D74
 678+ 6D74 3D               dec  a
 679+ 6D75 20 06            jr   nz, .not_wall
 680+ 6D77
 681+ 6D77                  ; Wall
 682+ 6D77 21 B2 00         ld   hl, OFFSET_WALL
 683+ 6D7A 19               add  hl, de
 684+ 6D7B 18 04            jr   .draw_cell
 685+ 6D7D
 686+ 6D7D              .not_wall:
 687+ 6D7D
 688+ 6D7D                  ; Nasty
 689+ 6D7D 21 BB 00         ld   hl, OFFSET_NASTY
 690+ 6D80 19               add  hl, de
 691+ 6D81
 692+ 6D81              .draw_cell:
 693+ 6D81
 694+ 6D81                  ; ---------------------------------------------------------------
 695+ 6D81                  ; HL punta ora alla grafica del tile da ridisegnare.
 696+ 6D81                  ;
 697+ 6D81                  ; DrawTile si aspetta:
 698+ 6D81                  ;   IX = puntatore tile
 699+ 6D81                  ;   B  = Row
 700+ 6D81                  ;   C  = Col
 701+ 6D81                  ; ---------------------------------------------------------------
 702+ 6D81 E5               push hl
 703+ 6D82 DD E1            pop  ix
 704+ 6D84
 705+ 6D84                  ; Ripristina Row e Col salvati in IY
 706+ 6D84 FD E5            push iy
 707+ 6D86 C1               pop  bc
 708+ 6D87
 709+ 6D87                  ; Disegna il tile originale
 710+ 6D87 CD 8C 61         call DrawTile
 711+ 6D8A
 712+ 6D8A                  ; ---------------------------------------------------------------
 713+ 6D8A                  ; Ripristina i registri salvati
 714+ 6D8A                  ; ---------------------------------------------------------------
 715+ 6D8A DD E1            pop  ix
 716+ 6D8C E1               pop  hl
 717+ 6D8D D1               pop  de
 718+ 6D8E C1               pop  bc
 719+ 6D8F FD E1            pop  iy
 720+ 6D91
 721+ 6D91 C9               ret
 722+ 6D92
 723+ 6D92              ; -------------------------------------------------------------------
 724+ 6D92              ; CheckWillyItemCollision
 725+ 6D92              ;
 726+ 6D92              ; Verifica se Willy collide con un item utilizzando il controllo
 727+ 6D92              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 728+ 6D92              ;
 729+ 6D92              ; Input:
 730+ 6D92              ;   A = ItemX (colonna attributi 0..31)
 731+ 6D92              ;   H = ItemY (riga attributi 3..18)
 732+ 6D92              ;
 733+ 6D92              ; Coordinate item:
 734+ 6D92              ;   Ogni item occupa una cella da 8x8 pixel.
 735+ 6D92              ;
 736+ 6D92              ; Coordinate Willy:
 737+ 6D92              ;   Willy occupa un rettangolo di 16x16 pixel.
 738+ 6D92              ;
 739+ 6D92              ; Output:
 740+ 6D92              ;   Carry Set   = collisione rilevata
 741+ 6D92              ;   Carry Clear = nessuna collisione
 742+ 6D92              ;
 743+ 6D92              ; Registri preservati:
 744+ 6D92              ;   BC, DE, HL
 745+ 6D92              ; -------------------------------------------------------------------
 746+ 6D92              CheckWillyItemCollision:
 747+ 6D92
 748+ 6D92                  ; Salva i registri utilizzati
 749+ 6D92 C5               push bc
 750+ 6D93 D5               push de
 751+ 6D94 E5               push hl
 752+ 6D95
 753+ 6D95                  ; ---------------------------------------------------------------
 754+ 6D95                  ; Calcola il bounding box orizzontale dell'item
 755+ 6D95                  ;
 756+ 6D95                  ; ItemLeft  = ItemX * 8
 757+ 6D95                  ; ItemRight = ItemLeft + 7
 758+ 6D95                  ;
 759+ 6D95                  ; E = ItemLeft
 760+ 6D95                  ; D = ItemRight
 761+ 6D95                  ; ---------------------------------------------------------------
 762+ 6D95 6F               ld   l, a              ; L = ItemX
 763+ 6D96
 764+ 6D96 7D               ld   a, l
 765+ 6D97 87               add  a, a              ; *2
 766+ 6D98 87               add  a, a              ; *4
 767+ 6D99 87               add  a, a              ; *8
 768+ 6D9A
 769+ 6D9A 5F               ld   e, a              ; E = ItemLeft
 770+ 6D9B
 771+ 6D9B C6 07            add  a, 7
 772+ 6D9D 57               ld   d, a              ; D = ItemRight
 773+ 6D9E
 774+ 6D9E                  ; ---------------------------------------------------------------
 775+ 6D9E                  ; Recupera la posizione corrente di Willy
 776+ 6D9E                  ;
 777+ 6D9E                  ; B = WillyY
 778+ 6D9E                  ; C = WillyX
 779+ 6D9E                  ; ---------------------------------------------------------------
 780+ 6D9E ED 4B B3 7A      ld   bc, (PlayerPos)
 781+ 6DA2
 782+ 6DA2                  ; ---------------------------------------------------------------
 783+ 6DA2                  ; Primo test:
 784+ 6DA2                  ;
 785+ 6DA2                  ; WillyLeft <= ItemRight
 786+ 6DA2                  ;
 787+ 6DA2                  ; Se Willy è completamente a destra dell'item
 788+ 6DA2                  ; non può esserci collisione.
 789+ 6DA2                  ; ---------------------------------------------------------------
 790+ 6DA2 79               ld   a, c              ; A = WillyLeft
 791+ 6DA3
 792+ 6DA3 BA               cp   d                 ; WillyLeft vs ItemRight
 793+ 6DA4
 794+ 6DA4 28 04            jr   z, .x_ok
 795+ 6DA6 38 02            jr   c, .x_ok
 796+ 6DA8
 797+ 6DA8 18 29            jr   .no_collision
 798+ 6DAA
 799+ 6DAA              .x_ok:
 800+ 6DAA
 801+ 6DAA                  ; ---------------------------------------------------------------
 802+ 6DAA                  ; Secondo test:
 803+ 6DAA                  ;
 804+ 6DAA                  ; WillyRight >= ItemLeft
 805+ 6DAA                  ;
 806+ 6DAA                  ; WillyRight = WillyX + 7
 807+ 6DAA                  ; ---------------------------------------------------------------
 808+ 6DAA C6 07            add  a, 7
 809+ 6DAC
 810+ 6DAC BB               cp   e                 ; WillyRight vs ItemLeft
 811+ 6DAD
 812+ 6DAD 28 04            jr   z, .y_check
 813+ 6DAF 30 02            jr   nc, .y_check
 814+ 6DB1
 815+ 6DB1 18 20            jr   .no_collision
 816+ 6DB3
 817+ 6DB3              .y_check:
 818+ 6DB3
 819+ 6DB3                  ; ---------------------------------------------------------------
 820+ 6DB3                  ; Recupera ItemY dal valore originale di HL
 821+ 6DB3                  ;
 822+ 6DB3                  ; H contiene la riga dell'item.
 823+ 6DB3                  ; ---------------------------------------------------------------
 824+ 6DB3 E1               pop  hl
 825+ 6DB4 E5               push hl
 826+ 6DB5
 827+ 6DB5                  ; ---------------------------------------------------------------
 828+ 6DB5                  ; Calcola il bounding box verticale dell'item
 829+ 6DB5                  ;
 830+ 6DB5                  ; ItemTop    = ItemY * 8
 831+ 6DB5                  ; ItemBottom = ItemTop + 7
 832+ 6DB5                  ;
 833+ 6DB5                  ; E = ItemTop
 834+ 6DB5                  ; D = ItemBottom
 835+ 6DB5                  ; ---------------------------------------------------------------
 836+ 6DB5 7C               ld   a, h
 837+ 6DB6
 838+ 6DB6 87               add  a, a              ; *2
 839+ 6DB7 87               add  a, a              ; *4
 840+ 6DB8 87               add  a, a              ; *8
 841+ 6DB9
 842+ 6DB9 5F               ld   e, a              ; ItemTop
 843+ 6DBA
 844+ 6DBA C6 07            add  a, 7
 845+ 6DBC 57               ld   d, a              ; ItemBottom
 846+ 6DBD
 847+ 6DBD                  ; ---------------------------------------------------------------
 848+ 6DBD                  ; Primo test verticale:
 849+ 6DBD                  ;
 850+ 6DBD                  ; WillyTop <= ItemBottom
 851+ 6DBD                  ; ---------------------------------------------------------------
 852+ 6DBD 78               ld   a, b              ; WillyTop
 853+ 6DBE
 854+ 6DBE BA               cp   d
 855+ 6DBF
 856+ 6DBF 28 04            jr   z, .y_ok
 857+ 6DC1 38 02            jr   c, .y_ok
 858+ 6DC3
 859+ 6DC3 18 0E            jr   .no_collision
 860+ 6DC5
 861+ 6DC5              .y_ok:
 862+ 6DC5
 863+ 6DC5                  ; ---------------------------------------------------------------
 864+ 6DC5                  ; Secondo test verticale:
 865+ 6DC5                  ;
 866+ 6DC5                  ; WillyBottom >= ItemTop
 867+ 6DC5                  ;
 868+ 6DC5                  ; WillyBottom = WillyY + 15
 869+ 6DC5                  ; ---------------------------------------------------------------
 870+ 6DC5 C6 0F            add  a, 15
 871+ 6DC7
 872+ 6DC7 BB               cp   e
 873+ 6DC8
 874+ 6DC8 28 04            jr   z, .collision
 875+ 6DCA 30 02            jr   nc, .collision
 876+ 6DCC
 877+ 6DCC 18 05            jr   .no_collision
 878+ 6DCE
 879+ 6DCE              .collision:
 880+ 6DCE
 881+ 6DCE                  ; ---------------------------------------------------------------
 882+ 6DCE                  ; Collisione rilevata
 883+ 6DCE                  ; ---------------------------------------------------------------
 884+ 6DCE E1               pop  hl
 885+ 6DCF D1               pop  de
 886+ 6DD0 C1               pop  bc
 887+ 6DD1
 888+ 6DD1 37               scf                    ; Carry = 1
 889+ 6DD2
 890+ 6DD2 C9               ret
 891+ 6DD3
 892+ 6DD3              .no_collision:
 893+ 6DD3
 894+ 6DD3                  ; ---------------------------------------------------------------
 895+ 6DD3                  ; Nessuna collisione
 896+ 6DD3                  ; ---------------------------------------------------------------
 897+ 6DD3 E1               pop  hl
 898+ 6DD4 D1               pop  de
 899+ 6DD5 C1               pop  bc
 900+ 6DD6
 901+ 6DD6 B7               or   a                 ; Carry = 0
 902+ 6DD7
 903+ 6DD7 C9               ret
 904+ 6DD8
 905+ 6DD8              ; -------------------------------------------------------------------
 906+ 6DD8              ; CheckRoomItemsCollision
 907+ 6DD8              ;
 908+ 6DD8              ; Controlla se Willy entra in collisione con uno degli item
 909+ 6DD8              ; attivi presenti nella stanza corrente.
 910+ 6DD8              ;
 911+ 6DD8              ; Per ogni item:
 912+ 6DD8              ;   - verifica che appartenga alla stanza corrente
 913+ 6DD8              ;   - verifica che non sia già stato raccolto
 914+ 6DD8              ;   - esegue il test di collisione con Willy
 915+ 6DD8              ;
 916+ 6DD8              ; Se l'item viene raccolto:
 917+ 6DD8              ;   - imposta il flag "collected"
 918+ 6DD8              ;   - rimuove l'item dalla cache items_grid
 919+ 6DD8              ;   - incrementa il contatore degli oggetti raccolti
 920+ 6DD8              ;   - aggiorna l'HUD
 921+ 6DD8              ;   - ripristina il tile di sfondo
 922+ 6DD8              ;   - riproduce il suono di raccolta
 923+ 6DD8              ;
 924+ 6DD8              ; Formato record ItemsTable:
 925+ 6DD8              ;   +0 RoomID
 926+ 6DD8              ;   +1 X
 927+ 6DD8              ;   +2 Y
 928+ 6DD8              ;   +3 Color
 929+ 6DD8              ;   +4 Collected
 930+ 6DD8              ;
 931+ 6DD8              ; Fine tabella:
 932+ 6DD8              ;   RoomID = $FF
 933+ 6DD8              ; -------------------------------------------------------------------
 934+ 6DD8              CheckRoomItemsCollision:
 935+ 6DD8
 936+ 6DD8                  ; Salva i registri utilizzati
 937+ 6DD8 E5               push hl
 938+ 6DD9 D5               push de
 939+ 6DDA C5               push bc
 940+ 6DDB
 941+ 6DDB                  ; Inizio scansione della tabella degli item
 942+ 6DDB 21 B7 6B         ld   hl, ItemsTable
 943+ 6DDE
 944+ 6DDE              .loop:
 945+ 6DDE
 946+ 6DDE                  ; ---------------------------------------------------------------
 947+ 6DDE                  ; Legge il Room ID dell'item corrente
 948+ 6DDE                  ; ---------------------------------------------------------------
 949+ 6DDE 7E               ld   a, (hl)
 950+ 6DDF
 951+ 6DDF                  ; $FF indica fine tabella
 952+ 6DDF FE FF            cp   $FF
 953+ 6DE1 28 4D            jr   z, .done
 954+ 6DE3
 955+ 6DE3                  ; ---------------------------------------------------------------
 956+ 6DE3                  ; Verifica se l'item appartiene alla stanza corrente
 957+ 6DE3                  ; ---------------------------------------------------------------
 958+ 6DE3 57               ld   d, a              ; D = RoomID item
 959+ 6DE4
 960+ 6DE4 3A C7 7D         ld   a, (current_room)
 961+ 6DE7 BA               cp   d
 962+ 6DE8
 963+ 6DE8                  ; Se appartiene a un'altra stanza salta il record
 964+ 6DE8 20 3F            jr   nz, .next_item
 965+ 6DEA
 966+ 6DEA                  ; ---------------------------------------------------------------
 967+ 6DEA                  ; Legge coordinate e stato dell'item
 968+ 6DEA                  ; ---------------------------------------------------------------
 969+ 6DEA
 970+ 6DEA 23               inc  hl
 971+ 6DEB 4E               ld   c, (hl)           ; C = X
 972+ 6DEC
 973+ 6DEC 23               inc  hl
 974+ 6DED 46               ld   b, (hl)           ; B = Y
 975+ 6DEE
 976+ 6DEE 23               inc  hl                ; salta Color
 977+ 6DEF
 978+ 6DEF 23               inc  hl                ; punta a Collected
 979+ 6DF0
 980+ 6DF0 7E               ld   a, (hl)
 981+ 6DF1
 982+ 6DF1                  ; ---------------------------------------------------------------
 983+ 6DF1                  ; Item già raccolto?
 984+ 6DF1                  ; ---------------------------------------------------------------
 985+ 6DF1 B7               or   a
 986+ 6DF2 20 39            jr   nz, .next_no_inc
 987+ 6DF4
 988+ 6DF4                  ; ---------------------------------------------------------------
 989+ 6DF4                  ; Test collisione Willy ↔ Item
 990+ 6DF4                  ;
 991+ 6DF4                  ; Input richiesto:
 992+ 6DF4                  ;   A = ItemX
 993+ 6DF4                  ;   H = ItemY
 994+ 6DF4                  ; ---------------------------------------------------------------
 995+ 6DF4 79               ld   a, c
 996+ 6DF5
 997+ 6DF5 E5               push hl                ; salva puntatore al flag Collected
 998+ 6DF6
 999+ 6DF6 60               ld   h, b
1000+ 6DF7
1001+ 6DF7 CD 92 6D         call CheckWillyItemCollision
1002+ 6DFA
1003+ 6DFA E1               pop  hl
1004+ 6DFB
1005+ 6DFB                  ; Nessuna collisione
1006+ 6DFB 30 30            jr   nc, .next_no_inc
1007+ 6DFD
1008+ 6DFD                  ; ===============================================================
1009+ 6DFD                  ; ITEM RACCOLTO
1010+ 6DFD                  ; ===============================================================
1011+ 6DFD
1012+ 6DFD                  ; ---------------------------------------------------------------
1013+ 6DFD                  ; Marca l'item come raccolto
1014+ 6DFD                  ; ---------------------------------------------------------------
1015+ 6DFD 36 01            ld   (hl), 1
1016+ 6DFF
1017+ 6DFF                  ; ---------------------------------------------------------------
1018+ 6DFF                  ; Rimuove l'item dalla cache items_grid
1019+ 6DFF                  ;
1020+ 6DFF                  ; Calcolo:
1021+ 6DFF                  ;   offset = Row * 32 + Col
1022+ 6DFF                  ; ---------------------------------------------------------------
1023+ 6DFF E5               push hl
1024+ 6E00 D5               push de
1025+ 6E01
1026+ 6E01 26 00            ld   h, 0
1027+ 6E03 68               ld   l, b              ; HL = Row
1028+ 6E04
1029+ 6E04 29               add  hl, hl            ; *2
1030+ 6E05 29               add  hl, hl            ; *4
1031+ 6E06 29               add  hl, hl            ; *8
1032+ 6E07 29               add  hl, hl            ; *16
1033+ 6E08 29               add  hl, hl            ; *32
1034+ 6E09
1035+ 6E09 59               ld   e, c
1036+ 6E0A 16 00            ld   d, 0
1037+ 6E0C
1038+ 6E0C 19               add  hl, de            ; Row*32 + Col
1039+ 6E0D
1040+ 6E0D 11 00 90         ld   de, items_grid
1041+ 6E10 19               add  hl, de
1042+ 6E11
1043+ 6E11                  ; La cella non contiene più un item
1044+ 6E11 36 00            ld   (hl), 0
1045+ 6E13
1046+ 6E13 D1               pop  de
1047+ 6E14 E1               pop  hl
1048+ 6E15
1049+ 6E15                  ; ---------------------------------------------------------------
1050+ 6E15                  ; Conserva il puntatore all'entry corrente
1051+ 6E15                  ; poiché le routine successive possono alterare HL.
1052+ 6E15                  ; ---------------------------------------------------------------
1053+ 6E15 E5               push hl
1054+ 6E16
1055+ 6E16                  ; ---------------------------------------------------------------
1056+ 6E16                  ; Aggiorna il numero di oggetti raccolti
1057+ 6E16                  ; ---------------------------------------------------------------
1058+ 6E16 3A BD 7A         ld   a, (items_collected)
1059+ 6E19
1060+ 6E19 3C               inc  a
1061+ 6E1A
1062+ 6E1A 32 BD 7A         ld   (items_collected), a
1063+ 6E1D
1064+ 6E1D                  ; ---------------------------------------------------------------
1065+ 6E1D                  ; Aggiorna il contatore visualizzato a schermo
1066+ 6E1D                  ; ---------------------------------------------------------------
1067+ 6E1D CD CB 60         call UpdateItemsCollectedDisplay
1068+ 6E20
1069+ 6E20                  ; ---------------------------------------------------------------
1070+ 6E20                  ; Ripristina il tile originale della stanza
1071+ 6E20                  ; eliminando la grafica dell'item.
1072+ 6E20                  ;
1073+ 6E20                  ; Input:
1074+ 6E20                  ;   B = Row
1075+ 6E20                  ;   C = Col
1076+ 6E20                  ; ---------------------------------------------------------------
1077+ 6E20 CD 50 6D         call RestoreBackgroundCell
1078+ 6E23
1079+ 6E23                  ; ---------------------------------------------------------------
1080+ 6E23                  ; Riproduce il suono di raccolta
1081+ 6E23                  ; ---------------------------------------------------------------
1082+ 6E23 CD 34 6E         call PlayCollectSound
1083+ 6E26
1084+ 6E26                  ; Ripristina il puntatore alla tabella
1085+ 6E26 E1               pop  hl
1086+ 6E27
1087+ 6E27                  ; Continua con il record successivo
1088+ 6E27 18 04            jr   .next_no_inc
1089+ 6E29
1090+ 6E29              .next_item:
1091+ 6E29
1092+ 6E29                  ; ---------------------------------------------------------------
1093+ 6E29                  ; Salta i campi del record:
1094+ 6E29                  ;   X
1095+ 6E29                  ;   Y
1096+ 6E29                  ;   Color
1097+ 6E29                  ;   Collected
1098+ 6E29                  ; ---------------------------------------------------------------
1099+ 6E29 23               inc  hl
1100+ 6E2A 23               inc  hl
1101+ 6E2B 23               inc  hl
1102+ 6E2C 23               inc  hl
1103+ 6E2D
1104+ 6E2D              .next_no_inc:
1105+ 6E2D
1106+ 6E2D                  ; ---------------------------------------------------------------
1107+ 6E2D                  ; Avanza al record successivo.
1108+ 6E2D                  ;
1109+ 6E2D                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1110+ 6E2D                  ; ---------------------------------------------------------------
1111+ 6E2D 23               inc  hl
1112+ 6E2E
1113+ 6E2E 18 AE            jr   .loop
1114+ 6E30
1115+ 6E30              .done:
1116+ 6E30
1117+ 6E30                  ; Ripristina i registri
1118+ 6E30 C1               pop  bc
1119+ 6E31 D1               pop  de
1120+ 6E32 E1               pop  hl
1121+ 6E33
1122+ 6E33 C9               ret
1123+ 6E34
1124+ 6E34              ; -------------------------------------------------------------------
1125+ 6E34              ; PlayCollectSound
1126+ 6E34              ;
1127+ 6E34              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1128+ 6E34              ; dello ZX Spectrum utilizzando il port $FE.
1129+ 6E34              ;
1130+ 6E34              ; Il suono viene prodotto alternando ON/OFF del bit 4
1131+ 6E34              ; (speaker) con un semplice delay software.
1132+ 6E34              ;
1133+ 6E34              ; Effetto risultante:
1134+ 6E34              ;   beep breve tipo "pickup item"
1135+ 6E34              ; -------------------------------------------------------------------
1136+ 6E34              PlayCollectSound:
1137+ 6E34
1138+ 6E34                  ; Salva registri utilizzati
1139+ 6E34 C5               push bc
1140+ 6E35 D5               push de
1141+ 6E36
1142+ 6E36                  ; ---------------------------------------------------------------
1143+ 6E36                  ; Numero di cicli del beep (durata complessiva del suono)
1144+ 6E36                  ; ---------------------------------------------------------------
1145+ 6E36 06 78            ld   b, 120
1146+ 6E38
1147+ 6E38              .sound_loop:
1148+ 6E38
1149+ 6E38                  ; ---------------------------------------------------------------
1150+ 6E38                  ; SPEAKER ON
1151+ 6E38                  ;
1152+ 6E38                  ; Legge il colore del bordo corrente e attiva il bit 4
1153+ 6E38                  ; per pilotare lo speaker.
1154+ 6E38                  ; ---------------------------------------------------------------
1155+ 6E38 3A BF 7A         ld   a, (room_border_color)
1156+ 6E3B F6 10            or   $10               ; bit 4 = 1 → speaker ON
1157+ 6E3D
1158+ 6E3D D3 FE            out  ($fe), a         ; scrive sul port ULA
1159+ 6E3F
1160+ 6E3F                  ; ---------------------------------------------------------------
1161+ 6E3F                  ; Delay (mezzo periodo)
1162+ 6E3F                  ; Loop software a consumo CPU
1163+ 6E3F                  ; ---------------------------------------------------------------
1164+ 6E3F 0E 3C            ld   c, 60
1165+ 6E41
1166+ 6E41              .d1:
1167+ 6E41 0D               dec  c
1168+ 6E42 20 FD            jr   nz, .d1
1169+ 6E44
1170+ 6E44                  ; ---------------------------------------------------------------
1171+ 6E44                  ; SPEAKER OFF
1172+ 6E44                  ;
1173+ 6E44                  ; Mantiene il colore del bordo ma disattiva lo speaker
1174+ 6E44                  ; ---------------------------------------------------------------
1175+ 6E44 3A BF 7A         ld   a, (room_border_color)
1176+ 6E47 E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1177+ 6E49
1178+ 6E49 D3 FE            out  ($fe), a
1179+ 6E4B
1180+ 6E4B                  ; ---------------------------------------------------------------
1181+ 6E4B                  ; Secondo delay (mezzo periodo)
1182+ 6E4B                  ; Completa l’onda quadra
1183+ 6E4B                  ; ---------------------------------------------------------------
1184+ 6E4B 0E 3C            ld   c, 60
1185+ 6E4D
1186+ 6E4D              .d2:
1187+ 6E4D 0D               dec  c
1188+ 6E4E 20 FD            jr   nz, .d2
1189+ 6E50
1190+ 6E50                  ; ---------------------------------------------------------------
1191+ 6E50                  ; Ripete fino a completare il numero di cicli
1192+ 6E50                  ; ---------------------------------------------------------------
1193+ 6E50 10 E6            djnz .sound_loop
1194+ 6E52
1195+ 6E52                  ; Ripristina registri salvati
1196+ 6E52 D1               pop  de
1197+ 6E53 C1               pop  bc
1198+ 6E54
1199+ 6E54 C9               ret
1200+ 6E55
1201+ 6E55              ; -------------------------------------------------------------------
1202+ 6E55              ; CheckActiveItemAtCell
1203+ 6E55              ;
1204+ 6E55              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1205+ 6E55              ; nella cella specificata della griglia items_grid.
1206+ 6E55              ;
1207+ 6E55              ; Questa routine usa una lookup diretta su una mappa 32x16,
1208+ 6E55              ; evitando la scansione della ItemsTable.
1209+ 6E55              ;
1210+ 6E55              ; Input:
1211+ 6E55              ;   B = Colonna (0..31)
1212+ 6E55              ;   C = Riga (0..15)
1213+ 6E55              ;
1214+ 6E55              ; Output:
1215+ 6E55              ;   Carry Set   = item presente nella cella
1216+ 6E55              ;   Carry Clear = nessun item
1217+ 6E55              ;
1218+ 6E55              ; Nota:
1219+ 6E55              ;   HL NON è restituito valido (commento originale non corretto:
1220+ 6E55              ;   la routine non punta a ItemsTable).
1221+ 6E55              ; -------------------------------------------------------------------
1222+ 6E55              CheckActiveItemAtCell:
1223+ 6E55
1224+ 6E55                  ; Salva registri usati
1225+ 6E55 D5               push de
1226+ 6E56 E5               push hl
1227+ 6E57
1228+ 6E57                  ; ---------------------------------------------------------------
1229+ 6E57                  ; Calcolo indice lineare nella griglia 32x16:
1230+ 6E57                  ;
1231+ 6E57                  ; offset = Row * 32 + Col
1232+ 6E57                  ; ---------------------------------------------------------------
1233+ 6E57 26 00            ld   h, 0
1234+ 6E59 69               ld   l, c              ; HL = Row
1235+ 6E5A
1236+ 6E5A 29               add  hl, hl            ; *2
1237+ 6E5B 29               add  hl, hl            ; *4
1238+ 6E5C 29               add  hl, hl            ; *8
1239+ 6E5D 29               add  hl, hl            ; *16
1240+ 6E5E 29               add  hl, hl            ; *32
1241+ 6E5F
1242+ 6E5F                  ; Aggiunge la colonna
1243+ 6E5F 58               ld   e, b
1244+ 6E60 16 00            ld   d, 0
1245+ 6E62 19               add  hl, de            ; HL = Row*32 + Col
1246+ 6E63
1247+ 6E63                  ; ---------------------------------------------------------------
1248+ 6E63                  ; Accesso alla griglia degli item attivi
1249+ 6E63                  ; ---------------------------------------------------------------
1250+ 6E63 11 00 90         ld   de, items_grid
1251+ 6E66 19               add  hl, de            ; HL = address cella
1252+ 6E67
1253+ 6E67                  ; ---------------------------------------------------------------
1254+ 6E67                  ; Controllo presenza item
