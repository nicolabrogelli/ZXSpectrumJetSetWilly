 966+ 6D9D 47               ld   b, a              ; B = limit_left
 967+ 6D9E
 968+ 6D9E 3A 53 E9         ld   a, (ramp_col)
 969+ 6DA1 3C               inc  a
 970+ 6DA2 4F               ld   c, a              ; C = limit_right (exclusive)
 971+ 6DA3
 972+ 6DA3 7B               ld   a, e              ; A = Col
 973+ 6DA4 B8               cp   b
 974+ 6DA5 38 15            jr   c, .check_platform_case
 975+ 6DA7 B9               cp   c
 976+ 6DA8 30 12            jr   nc, .check_platform_case
