 782+ 7DB6                  ; Disegna alla coordinata corrente
 783+ 7DB6 DD 4E 02         ld   c, (ix+2)         ; C = Current X (Offset 2)
 784+ 7DB9 DD 46 03         ld   b, (ix+3)         ; B = Current Y (Offset 3)
 785+ 7DBC
 786+ 7DBC DD E5            push ix                ; Salva slot pointer
 787+ 7DBE E5               push hl
 788+ 7DBF DD E1            pop  ix                ; IX = sprite data pointer
 789+ 7DC1 CD 89 5F         call Gfx_DrawPixelSprite16x16
 790+ 7DC4 DD E1            pop  ix                ; Ripristina slot pointer
