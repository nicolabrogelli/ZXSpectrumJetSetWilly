  76  7FA2 3A 48 5C         ld   a, (BORDCR)
  77  7FA5 E6 C7            and  $c7               ; Pulisce vecchi bit del bordo
  78  7FA7 B0               or   b                 ; Imposta nuovo colore bordo
  79  7FA8 F6 07            or   $07               ; Imposta ink a bianco
  80  7FAA 32 48 5C         ld   (BORDCR), a
  81  7FAD
  82  7FAD CD F3 5F         call PrintPlayer
  83  7FB0
  84  7FB0              Main_loop:
  85  7FB0 76               halt
  86  7FB1
  87  7FB1                  ; 1. Cancella e disegna i personaggi (back-to-back per minimizzare il flickering)
  88  7FB1 CD 46 60         call DeleteCharAtOldPos
  89  7FB4 CD F3 5F         call PrintPlayer
  90  7FB7
  91  7FB7 CD 7C 69         call EraseRoomEnemies
  92  7FBA CD B0 69         call DrawRoomEnemies
  93  7FBD
  94  7FBD                  ; 3. Salva le posizioni correnti del player per il prossimo frame
  95  7FBD ED 4B 44 7B      ld   bc, (PlayerPos)
  96  7FC1 ED 43 46 7B      ld   (PlayerPosOld), bc
  97  7FC5
  98  7FC5                  ; 4. Aggiorna le posizioni dei personaggi per il prossimo frame
  99  7FC5 CD FF 64         call CheckCtrl
 100  7FC8 CD 4C 64         call MovePlayer
 101  7FCB CD 31 66         call ApplyGravity
 102  7FCE CD E0 67         call ApplyConveyorForce
 103  7FD1 CD F2 6A         call UpdateRoomEnemies
 104  7FD4 CD 69 6E         call CheckRoomItemsCollision
 105  7FD7
 106  7FD7                  ; 5. Gestisci la collisione (disegna le raster bar se collide)
 107  7FD7 CD 34 67         call CheckCollision
 108  7FDA 30 1A            jr   nc, .no_collision
 109  7FDC
 110  7FDC                  ; Collisione attiva: disegna le raster bar nel bordo
 111  7FDC 3A 56 7B         ld   a, (counter)
 112  7FDF E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 113  7FE1 06 1E            ld   b, 30             ; Numero di righe della barra raster
 114  7FE3              .raster_loop:
 115  7FE3 D3 FE            out  ($fe), a
 116  7FE5 3C               inc  a
 117  7FE6 E6 07            and  7
 118  7FE8 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 119  7FEA              .delay:
 120  7FEA 0D               dec  c
 121  7FEB 20 FD            jr   nz, .delay
 122  7FED 10 F4            djnz .raster_loop
 123  7FEF
 124  7FEF                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 125  7FEF 3A 50 7B         ld   a, (room_border_color)
 126  7FF2 D3 FE            out  ($fe), a
 127  7FF4 18 05            jr   .no_collision_change
 128  7FF6
 129  7FF6              .no_collision:
 130  7FF6                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 131  7FF6 3A 50 7B         ld   a, (room_border_color)
 132  7FF9 D3 FE            out  ($fe), a
 133  7FFB
 134  7FFB              .no_collision_change:
 135  7FFB C3 B0 7F         jp   Main_loop
 136  7FFE
 137  7FFE
