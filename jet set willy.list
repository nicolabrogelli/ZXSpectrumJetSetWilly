1828+ 748A 19               add  hl, de
1829+ 748B 7E               ld   a, (hl)
1830+ 748C B7               or   a
1831+ 748D 20 0C            jr   nz, .custom_settings
1832+ 748F
1833+ 748F 3E 06            ld   a, DEFAULT_JUMP_STRENGTH
1834+ 7491 32 FF E6         ld   (room_jump_strength), a
1835+ 7494 3E 01            ld   a, DEFAULT_GRAVITY_PRESET
1836+ 7496 32 00 E7         ld   (room_gravity_preset), a
1837+ 7499 18 12            jr   .done
1838+ 749B
1839+ 749B              .custom_settings:
1840+ 749B F5               push af
1841+ 749C E6 0F            and  $0f                  ; Maschera i 4 bit inferiori (JJJJ)
1842+ 749E 32 FF E6         ld   (room_jump_strength), a
1843+ 74A1 F1               pop  af
1844+ 74A2 CB 3F            srl  a
1845+ 74A4 CB 3F            srl  a
1846+ 74A6 CB 3F            srl  a
1847+ 74A8 CB 3F            srl  a                  ; Sposta i 4 bit superiori in quelli inferiori (GGGG)
1848+ 74AA 32 00 E7         ld   (room_gravity_preset), a
1849+ 74AD
1850+ 74AD              .done:
1851+ 74AD F1               pop  af
1852+ 74AE D1               pop  de
1853+ 74AF E1               pop  hl
1854+ 74B0 C9               ret
