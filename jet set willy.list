 244+ 6CD8
 245+ 6CD8              ; -------------------------------------------------------------------
 246+ 6CD8              ; DrawRoomItems
 247+ 6CD8              ;
 248+ 6CD8              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 249+ 6CD8              ;
 250+ 6CD8              ; Operazioni eseguite:
 251+ 6CD8              ;   1. Azzera la griglia items_grid.
 252+ 6CD8              ;   2. Svuota la cache degli oggetti attivi.
 253+ 6CD8              ;   3. Scansiona ItemsTable.
 254+ 6CD8              ;   4. Per ogni item della stanza corrente:
 255+ 6CD8              ;        - verifica se è già stato raccolto
 256+ 6CD8              ;        - disegna la grafica
 257+ 6CD8              ;        - aggiorna items_grid
 258+ 6CD8              ;        - memorizza l'item nella cache current_room_items
 259+ 6CD8              ;   5. Aggiorna num_room_items.
 260+ 6CD8              ;
 261+ 6CD8              ; Record ItemsTable:
 262+ 6CD8              ;   +0  Room ID
 263+ 6CD8              ;   +1  X (colonna)
 264+ 6CD8              ;   +2  Y (riga)
 265+ 6CD8              ;   +3  Colore
 266+ 6CD8              ;   +4  Collected flag
 267+ 6CD8              ;
 268+ 6CD8              ; Cache current_room_items:
 269+ 6CD8              ;   +0  Colonna
 270+ 6CD8              ;   +1  Riga
 271+ 6CD8              ;   +2  Colore
 272+ 6CD8              ;   +3  Collected flag ptr (Low)
 273+ 6CD8              ;   +4  Collected flag ptr (High)
 274+ 6CD8              ;
 275+ 6CD8              ; Ogni record cache occupa 5 byte.
 276+ 6CD8              ; -------------------------------------------------------------------
 277+ 6CD8              DrawRoomItems:
 278+ 6CD8
 279+ 6CD8                  ; Salva tutti i registri utilizzati
 280+ 6CD8 E5               push hl
 281+ 6CD9 D5               push de
 282+ 6CDA C5               push bc
 283+ 6CDB DD E5            push ix
 284+ 6CDD FD E5            push iy
 285+ 6CDF
 286+ 6CDF                  ; ---------------------------------------------------------------
 287+ 6CDF                  ; Azzera items_grid (32 x 16 = 512 byte)
 288+ 6CDF                  ; ---------------------------------------------------------------
 289+ 6CDF 21 00 90         ld   hl, items_grid
 290+ 6CE2 11 01 90         ld   de, items_grid + 1
 291+ 6CE5 36 00            ld   (hl), 0
 292+ 6CE7 01 FF 01         ld   bc, 511
 293+ 6CEA ED B0            ldir
 294+ 6CEC
 295+ 6CEC                  ; ---------------------------------------------------------------
 296+ 6CEC                  ; Nessun item attivo nella stanza
 297+ 6CEC                  ; ---------------------------------------------------------------
 298+ 6CEC AF               xor  a
 299+ 6CED 32 69 7E         ld   (num_room_items), a
 300+ 6CF0
 301+ 6CF0                  ; IY punta alla cache degli item attivi
 302+ 6CF0 FD 21 19 7E      ld   iy, current_room_items
 303+ 6CF4
 304+ 6CF4                  ; ---------------------------------------------------------------
 305+ 6CF4                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 306+ 6CF4                  ; alla stanza corrente.
 307+ 6CF4                  ;
 308+ 6CF4                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 309+ 6CF4                  ; ---------------------------------------------------------------
 310+ 6CF4 2A 6A 7E         ld   hl, (room_ptr)
 311+ 6CF7 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 312+ 6CFA 19               add  hl, de
 313+ 6CFB
 314+ 6CFB E5               push hl
 315+ 6CFC DD E1            pop  ix                ; IX = bitmap item
 316+ 6CFE
 317+ 6CFE                  ; ---------------------------------------------------------------
 318+ 6CFE                  ; Inizio scansione della tabella degli item
 319+ 6CFE                  ; ---------------------------------------------------------------
 320+ 6CFE 21 D8 6B         ld   hl, ItemsTable
 321+ 6D01
 322+ 6D01              .loop:
 323+ 6D01
 324+ 6D01                  ; ---------------------------------------------------------------
 325+ 6D01                  ; Legge il Room ID del record corrente
 326+ 6D01                  ; ---------------------------------------------------------------
 327+ 6D01 7E               ld   a, (hl)
 328+ 6D02
 329+ 6D02                  ; $FF indica fine tabella
 330+ 6D02 FE FF            cp   $FF
 331+ 6D04 28 53            jr   z, .done
 332+ 6D06
 333+ 6D06                  ; ---------------------------------------------------------------
 334+ 6D06                  ; Verifica se l'item appartiene alla stanza corrente
 335+ 6D06                  ; ---------------------------------------------------------------
 336+ 6D06 57               ld   d, a
 337+ 6D07
 338+ 6D07 3A 10 7E         ld   a, (current_room)
 339+ 6D0A BA               cp   d
 340+ 6D0B 20 45            jr   nz, .next_item
 341+ 6D0D
 342+ 6D0D                  ; ---------------------------------------------------------------
 343+ 6D0D                  ; Legge i dati dell'item
 344+ 6D0D                  ; ---------------------------------------------------------------
 345+ 6D0D
 346+ 6D0D 23               inc  hl
 347+ 6D0E 4E               ld   c, (hl)           ; X (colonna)
 348+ 6D0F
 349+ 6D0F 23               inc  hl
 350+ 6D10 46               ld   b, (hl)           ; Y (riga)
 351+ 6D11
 352+ 6D11 23               inc  hl
 353+ 6D12 5E               ld   e, (hl)           ; Colore
 354+ 6D13
 355+ 6D13 23               inc  hl
 356+ 6D14 7E               ld   a, (hl)           ; Collected flag
 357+ 6D15
 358+ 6D15                  ; Se diverso da zero l'item è già stato raccolto
 359+ 6D15 B7               or   a
 360+ 6D16 20 3E            jr   nz, .next_no_inc
 361+ 6D18
 362+ 6D18                  ; ---------------------------------------------------------------
 363+ 6D18                  ; Disegna l'item sullo schermo
 364+ 6D18                  ;
 365+ 6D18                  ; B = Row
 366+ 6D18                  ; C = Column
 367+ 6D18                  ; HL = bitmap pointer
 368+ 6D18                  ; E = Color
 369+ 6D18                  ; ---------------------------------------------------------------
 370+ 6D18 E5               push hl
 371+ 6D19
 372+ 6D19 DD E5            push ix
 373+ 6D1B E1               pop  hl
 374+ 6D1C
 375+ 6D1C CD 61 6D         call DrawItemGraphic
 376+ 6D1F
 377+ 6D1F E1               pop  hl                ; ritorna al flag collected
 378+ 6D20
 379+ 6D20                  ; ---------------------------------------------------------------
 380+ 6D20                  ; Aggiorna items_grid
 381+ 6D20                  ;
 382+ 6D20                  ; Calcolo:
 383+ 6D20                  ;   offset = Row * 32 + Col
 384+ 6D20                  ; ---------------------------------------------------------------
 385+ 6D20 E5               push hl
 386+ 6D21 D5               push de
 387+ 6D22
 388+ 6D22 26 00            ld   h, 0
 389+ 6D24 68               ld   l, b              ; HL = Row
 390+ 6D25
 391+ 6D25 29               add  hl, hl            ; *2
 392+ 6D26 29               add  hl, hl            ; *4
 393+ 6D27 29               add  hl, hl            ; *8
 394+ 6D28 29               add  hl, hl            ; *16
 395+ 6D29 29               add  hl, hl            ; *32
 396+ 6D2A
 397+ 6D2A 16 00            ld   d, 0
 398+ 6D2C 59               ld   e, c              ; DE = Col
 399+ 6D2D
 400+ 6D2D 19               add  hl, de            ; Row*32 + Col
 401+ 6D2E
 402+ 6D2E 11 00 90         ld   de, items_grid
 403+ 6D31 19               add  hl, de            ; puntatore nella griglia
 404+ 6D32
 405+ 6D32 D1               pop  de                ; ripristina colore
 406+ 6D33
 407+ 6D33 73               ld   (hl), e           ; salva colore cella
 408+ 6D34
 409+ 6D34 E1               pop  hl
 410+ 6D35
 411+ 6D35                  ; ---------------------------------------------------------------
 412+ 6D35                  ; Salva l'item nella cache della stanza
 413+ 6D35                  ;
 414+ 6D35                  ; Questo evita di dover scansionare tutta ItemsTable
 415+ 6D35                  ; durante il controllo delle collisioni.
 416+ 6D35                  ; ---------------------------------------------------------------
 417+ 6D35
 418+ 6D35 FD 71 00         ld   (iy+0), c         ; Colonna
 419+ 6D38 FD 70 01         ld   (iy+1), b         ; Riga
 420+ 6D3B FD 73 02         ld   (iy+2), e         ; Colore
 421+ 6D3E
 422+ 6D3E                  ; Salva il puntatore al flag "collected"
 423+ 6D3E FD 75 03         ld   (iy+3), l         ; Low byte
 424+ 6D41 FD 74 04         ld   (iy+4), h         ; High byte
 425+ 6D44
 426+ 6D44                  ; Passa al record successivo della cache
 427+ 6D44 01 05 00         ld   bc, 5
 428+ 6D47 FD 09            add  iy, bc
 429+ 6D49
 430+ 6D49                  ; Incrementa il numero di item attivi
 431+ 6D49 3A 69 7E         ld   a, (num_room_items)
 432+ 6D4C 3C               inc  a
 433+ 6D4D 32 69 7E         ld   (num_room_items), a
 434+ 6D50
 435+ 6D50 18 04            jr   .next_no_inc
 436+ 6D52
 437+ 6D52              .next_item:
 438+ 6D52
 439+ 6D52                  ; ---------------------------------------------------------------
 440+ 6D52                  ; L'item non appartiene alla stanza corrente.
 441+ 6D52                  ; Salta i campi del record:
 442+ 6D52                  ;   X
 443+ 6D52                  ;   Y
 444+ 6D52                  ;   Color
 445+ 6D52                  ;   Collected
 446+ 6D52                  ; ---------------------------------------------------------------
 447+ 6D52 23               inc  hl
 448+ 6D53 23               inc  hl
 449+ 6D54 23               inc  hl
 450+ 6D55 23               inc  hl
 451+ 6D56
 452+ 6D56              .next_no_inc:
 453+ 6D56
 454+ 6D56                  ; ---------------------------------------------------------------
 455+ 6D56                  ; Avanza al record successivo
 456+ 6D56                  ; (prossimo Room ID)
 457+ 6D56                  ; ---------------------------------------------------------------
 458+ 6D56 23               inc  hl
 459+ 6D57 18 A8            jr   .loop
 460+ 6D59
 461+ 6D59              .done:
 462+ 6D59
 463+ 6D59                  ; Ripristina i registri
 464+ 6D59 FD E1            pop  iy
 465+ 6D5B DD E1            pop  ix
 466+ 6D5D D1               pop  de
 467+ 6D5E C1               pop  bc
 468+ 6D5F E1               pop  hl
 469+ 6D60
 470+ 6D60 C9               ret
 471+ 6D61
 472+ 6D61              ; -------------------------------------------------------------------
 473+ 6D61              ; DrawItemGraphic
 474+ 6D61              ;
 475+ 6D61              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 476+ 6D61              ; utilizzando una bitmap di 8 byte e un attributo colore.
 477+ 6D61              ;
 478+ 6D61              ; Input:
 479+ 6D61              ;   B = Riga attributi (3..18)
 480+ 6D61              ;   C = Colonna attributi (0..31)
 481+ 6D61              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 482+ 6D61              ;   E = Attributo colore
 483+ 6D61              ;
 484+ 6D61              ; Output:
 485+ 6D61              ;   Nessuno
 486+ 6D61              ;
 487+ 6D61              ; Registri preservati:
 488+ 6D61              ;   BC, DE, HL
 489+ 6D61              ; -------------------------------------------------------------------
 490+ 6D61              DrawItemGraphic:
 491+ 6D61
 492+ 6D61                  ; Salva i registri originali
 493+ 6D61 C5               push bc
 494+ 6D62 D5               push de
 495+ 6D63 E5               push hl
 496+ 6D64
 497+ 6D64                  ; ---------------------------------------------------------------
 498+ 6D64                  ; Calcolo indirizzo bitmap dello Spectrum
 499+ 6D64                  ;
 500+ 6D64                  ; Ogni item occupa una cella attributi (8x8 pixel).
 501+ 6D64                  ;
 502+ 6D64                  ; Formula:
 503+ 6D64                  ;   High = $40 + (Row AND $18)
 504+ 6D64                  ;   Low  = (Row AND 7) * 32 + Col
 505+ 6D64                  ;
 506+ 6D64                  ; DE conterrà l'indirizzo della prima scanline.
 507+ 6D64                  ; ---------------------------------------------------------------
 508+ 6D64
 509+ 6D64 78               ld   a, b
 510+ 6D65 E6 18            and  $18
 511+ 6D67 C6 40            add  a, $40
 512+ 6D69 57               ld   d, a              ; Byte alto indirizzo video
 513+ 6D6A
 514+ 6D6A 78               ld   a, b
 515+ 6D6B E6 07            and  7                 ; Riga interna al blocco da 8
 516+ 6D6D
 517+ 6D6D 87               add  a, a              ; *2
 518+ 6D6E 87               add  a, a              ; *4
 519+ 6D6F 87               add  a, a              ; *8
 520+ 6D70 87               add  a, a              ; *16
 521+ 6D71 87               add  a, a              ; *32
 522+ 6D72
 523+ 6D72 81               add  a, c              ; + colonna
 524+ 6D73
 525+ 6D73 5F               ld   e, a              ; Byte basso indirizzo video
 526+ 6D74
 527+ 6D74                  ; ---------------------------------------------------------------
 528+ 6D74                  ; Disegno bitmap
 529+ 6D74                  ;
 530+ 6D74                  ; Copia 8 byte consecutivi nella memoria video.
 531+ 6D74                  ; Ogni byte rappresenta una scanline da 8 pixel.
 532+ 6D74                  ; ---------------------------------------------------------------
 533+ 6D74
 534+ 6D74 C5               push bc                ; Conserva Row e Col
 535+ 6D75
 536+ 6D75 06 08            ld   b, 8              ; Numero scanline
 537+ 6D77
 538+ 6D77              .line_loop:
 539+ 6D77
 540+ 6D77 7E               ld   a, (hl)           ; Legge scanline bitmap
 541+ 6D78 12               ld   (de), a           ; Scrive nella memoria video
 542+ 6D79
 543+ 6D79 14               inc  d                 ; Scanline successiva
 544+ 6D7A 23               inc  hl                ; Byte bitmap successivo
 545+ 6D7B
 546+ 6D7B 05               dec  b
 547+ 6D7C 20 F9            jr   nz, .line_loop
 548+ 6D7E
 549+ 6D7E C1               pop  bc                ; Ripristina Row e Col
 550+ 6D7F
 551+ 6D7F                  ; ---------------------------------------------------------------
 552+ 6D7F                  ; Calcolo indirizzo attributo
 553+ 6D7F                  ;
 554+ 6D7F                  ; Formula:
 555+ 6D7F                  ;   AttrAddr = $5800 + Row * 32 + Col
 556+ 6D7F                  ;
 557+ 6D7F                  ; HL conterrà l'indirizzo della cella attributi.
 558+ 6D7F                  ; ---------------------------------------------------------------
 559+ 6D7F
 560+ 6D7F 26 00            ld   h, 0
 561+ 6D81 68               ld   l, b              ; HL = Row
 562+ 6D82
 563+ 6D82 29               add  hl, hl            ; *2
 564+ 6D83 29               add  hl, hl            ; *4
 565+ 6D84 29               add  hl, hl            ; *8
 566+ 6D85 29               add  hl, hl            ; *16
 567+ 6D86 29               add  hl, hl            ; *32
 568+ 6D87
 569+ 6D87 79               ld   a, c              ; A = Colonna
 570+ 6D88
 571+ 6D88 85               add  a, l
 572+ 6D89 6F               ld   l, a
 573+ 6D8A
 574+ 6D8A 30 01            jr   nc, .no_carry
 575+ 6D8C 24               inc  h
 576+ 6D8D
 577+ 6D8D              .no_carry:
 578+ 6D8D
 579+ 6D8D                  ; HL = Row * 32 + Col
 580+ 6D8D
 581+ 6D8D 11 00 58         ld   de, $5800
 582+ 6D90 19               add  hl, de            ; HL = indirizzo attributi
 583+ 6D91
 584+ 6D91                  ; ---------------------------------------------------------------
 585+ 6D91                  ; Recupera il colore originale dallo stack.
 586+ 6D91                  ;
 587+ 6D91                  ; Layout stack:
 588+ 6D91                  ;   HL originale
 589+ 6D91                  ;   DE originale (E = colore)
 590+ 6D91                  ;   BC originale
 591+ 6D91                  ; ---------------------------------------------------------------
 592+ 6D91
 593+ 6D91 C1               pop  bc                ; Recupera HL originale
 594+ 6D92 D1               pop  de                ; Recupera DE originale
 595+ 6D93
 596+ 6D93                  ; ---------------------------------------------------------------
 597+ 6D93                  ; Scrive l'attributo colore
 598+ 6D93                  ; ---------------------------------------------------------------
 599+ 6D93
 600+ 6D93 7B               ld   a, e              ; A = colore
 601+ 6D94 77               ld   (hl), a           ; Scrive nella RAM attributi
 602+ 6D95
 603+ 6D95                  ; ---------------------------------------------------------------
 604+ 6D95                  ; Ripristina HL e BC originali
 605+ 6D95                  ; ---------------------------------------------------------------
 606+ 6D95
 607+ 6D95 C5               push bc
 608+ 6D96 E1               pop  hl                ; HL originale
 609+ 6D97
 610+ 6D97 C1               pop  bc                ; BC originale
 611+ 6D98
 612+ 6D98 C9               ret
 613+ 6D99
 614+ 6D99              ; -------------------------------------------------------------------
 615+ 6D99              ; RestoreBackgroundCell
 616+ 6D99              ;
 617+ 6D99              ; Ripristina il contenuto originale di una cella della stanza.
 618+ 6D99              ; Viene utilizzata principalmente quando un item viene raccolto:
 619+ 6D99              ; invece di lasciare un "buco", la routine ridisegna il tile
 620+ 6D99              ; originale presente nella mappa della stanza.
 621+ 6D99              ;
 622+ 6D99              ; Input:
 623+ 6D99              ;   B = Row (3..18)
 624+ 6D99              ;   C = Col (0..31)
 625+ 6D99              ;
 626+ 6D99              ; Utilizza:
 627+ 6D99              ;   room_ptr -> struttura dati della stanza corrente
 628+ 6D99              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 629+ 6D99              ;   DrawTile -> ridisegna il tile selezionato
 630+ 6D99              ;
 631+ 6D99              ; Tipi di cella:
 632+ 6D99              ;   0 = Background
 633+ 6D99              ;   1 = Floor
 634+ 6D99              ;   2 = Wall
 635+ 6D99              ;   3 = Nasty
 636+ 6D99              ; -------------------------------------------------------------------
 637+ 6D99              RestoreBackgroundCell:
 638+ 6D99
 639+ 6D99                  ; Salva tutti i registri utilizzati
 640+ 6D99 FD E5            push iy
 641+ 6D9B C5               push bc
 642+ 6D9C D5               push de
 643+ 6D9D E5               push hl
 644+ 6D9E DD E5            push ix
 645+ 6DA0
 646+ 6DA0                  ; ---------------------------------------------------------------
 647+ 6DA0                  ; Conserva Row e Col in IY.
 648+ 6DA0                  ;
 649+ 6DA0                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 650+ 6DA0                  ; BC potrebbe essere modificato.
 651+ 6DA0                  ; ---------------------------------------------------------------
 652+ 6DA0 C5               push bc
 653+ 6DA1 FD E1            pop  iy                ; IYH = Row, IYL = Col
 654+ 6DA3
 655+ 6DA3                  ; ---------------------------------------------------------------
 656+ 6DA3                  ; Determina quale tipo di cella è presente nella posizione
 657+ 6DA3                  ; specificata.
 658+ 6DA3                  ;
 659+ 6DA3                  ; Input:
 660+ 6DA3                  ;   B = Row
 661+ 6DA3                  ;   C = Col
 662+ 6DA3                  ;
 663+ 6DA3                  ; Output:
 664+ 6DA3                  ;   A = tipo cella
 665+ 6DA3                  ; ---------------------------------------------------------------
 666+ 6DA3 78               ld   a, b
 667+ 6DA4
 668+ 6DA4 CD B0 68         call GetCellFromUnpacked
 669+ 6DA7
 670+ 6DA7                  ; ---------------------------------------------------------------
 671+ 6DA7                  ; Recupera il puntatore alla stanza corrente.
 672+ 6DA7                  ;
 673+ 6DA7                  ; DE = base della struttura stanza
 674+ 6DA7                  ; ---------------------------------------------------------------
 675+ 6DA7 ED 5B 6A 7E      ld   de, (room_ptr)
 676+ 6DAB
 677+ 6DAB                  ; ---------------------------------------------------------------
 678+ 6DAB                  ; Seleziona il tile corretto in base al tipo di cella.
 679+ 6DAB                  ;
 680+ 6DAB                  ; A = 0 -> Background
 681+ 6DAB                  ; A = 1 -> Floor
 682+ 6DAB                  ; A = 2 -> Wall
 683+ 6DAB                  ; A = 3 -> Nasty
 684+ 6DAB                  ; ---------------------------------------------------------------
 685+ 6DAB
 686+ 6DAB B7               or   a
 687+ 6DAC 20 06            jr   nz, .not_bg
 688+ 6DAE
 689+ 6DAE                  ; Background
 690+ 6DAE 21 A0 00         ld   hl, OFFSET_BG
 691+ 6DB1 19               add  hl, de
 692+ 6DB2 18 16            jr   .draw_cell
 693+ 6DB4
 694+ 6DB4              .not_bg:
 695+ 6DB4
 696+ 6DB4 3D               dec  a
 697+ 6DB5 20 06            jr   nz, .not_floor
 698+ 6DB7
 699+ 6DB7                  ; Floor
 700+ 6DB7 21 A9 00         ld   hl, OFFSET_FLOOR
 701+ 6DBA 19               add  hl, de
 702+ 6DBB 18 0D            jr   .draw_cell
 703+ 6DBD
 704+ 6DBD              .not_floor:
 705+ 6DBD
 706+ 6DBD 3D               dec  a
 707+ 6DBE 20 06            jr   nz, .not_wall
 708+ 6DC0
 709+ 6DC0                  ; Wall
 710+ 6DC0 21 B2 00         ld   hl, OFFSET_WALL
 711+ 6DC3 19               add  hl, de
 712+ 6DC4 18 04            jr   .draw_cell
 713+ 6DC6
 714+ 6DC6              .not_wall:
 715+ 6DC6
 716+ 6DC6                  ; Nasty
 717+ 6DC6 21 BB 00         ld   hl, OFFSET_NASTY
 718+ 6DC9 19               add  hl, de
 719+ 6DCA
 720+ 6DCA              .draw_cell:
 721+ 6DCA
 722+ 6DCA                  ; ---------------------------------------------------------------
 723+ 6DCA                  ; HL punta ora alla grafica del tile da ridisegnare.
 724+ 6DCA                  ;
 725+ 6DCA                  ; DrawTile si aspetta:
 726+ 6DCA                  ;   IX = puntatore tile
 727+ 6DCA                  ;   B  = Row
 728+ 6DCA                  ;   C  = Col
 729+ 6DCA                  ; ---------------------------------------------------------------
 730+ 6DCA E5               push hl
 731+ 6DCB DD E1            pop  ix
 732+ 6DCD
 733+ 6DCD                  ; Ripristina Row e Col salvati in IY
 734+ 6DCD FD E5            push iy
 735+ 6DCF C1               pop  bc
 736+ 6DD0
 737+ 6DD0                  ; Disegna il tile originale
 738+ 6DD0 CD 8C 61         call DrawTile
 739+ 6DD3
 740+ 6DD3                  ; ---------------------------------------------------------------
 741+ 6DD3                  ; Ripristina i registri salvati
 742+ 6DD3                  ; ---------------------------------------------------------------
 743+ 6DD3 DD E1            pop  ix
 744+ 6DD5 E1               pop  hl
 745+ 6DD6 D1               pop  de
 746+ 6DD7 C1               pop  bc
 747+ 6DD8 FD E1            pop  iy
 748+ 6DDA
 749+ 6DDA C9               ret
 750+ 6DDB
 751+ 6DDB              ; -------------------------------------------------------------------
 752+ 6DDB              ; CheckWillyItemCollision
 753+ 6DDB              ;
 754+ 6DDB              ; Verifica se Willy collide con un item utilizzando il controllo
 755+ 6DDB              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 756+ 6DDB              ;
 757+ 6DDB              ; Input:
 758+ 6DDB              ;   A = ItemX (colonna attributi 0..31)
 759+ 6DDB              ;   H = ItemY (riga attributi 3..18)
 760+ 6DDB              ;
 761+ 6DDB              ; Coordinate item:
 762+ 6DDB              ;   Ogni item occupa una cella da 8x8 pixel.
 763+ 6DDB              ;
 764+ 6DDB              ; Coordinate Willy:
 765+ 6DDB              ;   Willy occupa un rettangolo di 16x16 pixel.
 766+ 6DDB              ;
 767+ 6DDB              ; Output:
 768+ 6DDB              ;   Carry Set   = collisione rilevata
 769+ 6DDB              ;   Carry Clear = nessuna collisione
 770+ 6DDB              ;
 771+ 6DDB              ; Registri preservati:
 772+ 6DDB              ;   BC, DE, HL
 773+ 6DDB              ; -------------------------------------------------------------------
 774+ 6DDB              CheckWillyItemCollision:
 775+ 6DDB
 776+ 6DDB                  ; Salva i registri utilizzati
 777+ 6DDB C5               push bc
 778+ 6DDC D5               push de
 779+ 6DDD E5               push hl
 780+ 6DDE
 781+ 6DDE                  ; ---------------------------------------------------------------
 782+ 6DDE                  ; Calcola il bounding box orizzontale dell'item
 783+ 6DDE                  ;
 784+ 6DDE                  ; ItemLeft  = ItemX * 8
 785+ 6DDE                  ; ItemRight = ItemLeft + 7
 786+ 6DDE                  ;
 787+ 6DDE                  ; E = ItemLeft
 788+ 6DDE                  ; D = ItemRight
 789+ 6DDE                  ; ---------------------------------------------------------------
 790+ 6DDE 6F               ld   l, a              ; L = ItemX
 791+ 6DDF
 792+ 6DDF 7D               ld   a, l
 793+ 6DE0 87               add  a, a              ; *2
 794+ 6DE1 87               add  a, a              ; *4
 795+ 6DE2 87               add  a, a              ; *8
 796+ 6DE3
 797+ 6DE3 5F               ld   e, a              ; E = ItemLeft
 798+ 6DE4
 799+ 6DE4 C6 07            add  a, 7
 800+ 6DE6 57               ld   d, a              ; D = ItemRight
 801+ 6DE7
 802+ 6DE7                  ; ---------------------------------------------------------------
 803+ 6DE7                  ; Recupera la posizione corrente di Willy
 804+ 6DE7                  ;
 805+ 6DE7                  ; B = WillyY
 806+ 6DE7                  ; C = WillyX
 807+ 6DE7                  ; ---------------------------------------------------------------
 808+ 6DE7 ED 4B FC 7A      ld   bc, (PlayerPos)
 809+ 6DEB
 810+ 6DEB                  ; ---------------------------------------------------------------
 811+ 6DEB                  ; Primo test:
 812+ 6DEB                  ;
 813+ 6DEB                  ; WillyLeft <= ItemRight
 814+ 6DEB                  ;
 815+ 6DEB                  ; Se Willy è completamente a destra dell'item
 816+ 6DEB                  ; non può esserci collisione.
 817+ 6DEB                  ; ---------------------------------------------------------------
 818+ 6DEB 79               ld   a, c              ; A = WillyLeft
 819+ 6DEC
 820+ 6DEC BA               cp   d                 ; WillyLeft vs ItemRight
 821+ 6DED
 822+ 6DED 28 04            jr   z, .x_ok
 823+ 6DEF 38 02            jr   c, .x_ok
 824+ 6DF1
 825+ 6DF1 18 29            jr   .no_collision
 826+ 6DF3
 827+ 6DF3              .x_ok:
 828+ 6DF3
 829+ 6DF3                  ; ---------------------------------------------------------------
 830+ 6DF3                  ; Secondo test:
 831+ 6DF3                  ;
 832+ 6DF3                  ; WillyRight >= ItemLeft
 833+ 6DF3                  ;
 834+ 6DF3                  ; WillyRight = WillyX + 7
 835+ 6DF3                  ; ---------------------------------------------------------------
 836+ 6DF3 C6 07            add  a, 7
 837+ 6DF5
 838+ 6DF5 BB               cp   e                 ; WillyRight vs ItemLeft
 839+ 6DF6
 840+ 6DF6 28 04            jr   z, .y_check
 841+ 6DF8 30 02            jr   nc, .y_check
 842+ 6DFA
 843+ 6DFA 18 20            jr   .no_collision
 844+ 6DFC
 845+ 6DFC              .y_check:
 846+ 6DFC
 847+ 6DFC                  ; ---------------------------------------------------------------
 848+ 6DFC                  ; Recupera ItemY dal valore originale di HL
 849+ 6DFC                  ;
 850+ 6DFC                  ; H contiene la riga dell'item.
 851+ 6DFC                  ; ---------------------------------------------------------------
 852+ 6DFC E1               pop  hl
 853+ 6DFD E5               push hl
 854+ 6DFE
 855+ 6DFE                  ; ---------------------------------------------------------------
 856+ 6DFE                  ; Calcola il bounding box verticale dell'item
 857+ 6DFE                  ;
 858+ 6DFE                  ; ItemTop    = ItemY * 8
 859+ 6DFE                  ; ItemBottom = ItemTop + 7
 860+ 6DFE                  ;
 861+ 6DFE                  ; E = ItemTop
 862+ 6DFE                  ; D = ItemBottom
 863+ 6DFE                  ; ---------------------------------------------------------------
 864+ 6DFE 7C               ld   a, h
 865+ 6DFF
 866+ 6DFF 87               add  a, a              ; *2
 867+ 6E00 87               add  a, a              ; *4
 868+ 6E01 87               add  a, a              ; *8
 869+ 6E02
 870+ 6E02 5F               ld   e, a              ; ItemTop
 871+ 6E03
 872+ 6E03 C6 07            add  a, 7
 873+ 6E05 57               ld   d, a              ; ItemBottom
 874+ 6E06
 875+ 6E06                  ; ---------------------------------------------------------------
 876+ 6E06                  ; Primo test verticale:
 877+ 6E06                  ;
 878+ 6E06                  ; WillyTop <= ItemBottom
 879+ 6E06                  ; ---------------------------------------------------------------
 880+ 6E06 78               ld   a, b              ; WillyTop
 881+ 6E07
 882+ 6E07 BA               cp   d
 883+ 6E08
 884+ 6E08 28 04            jr   z, .y_ok
 885+ 6E0A 38 02            jr   c, .y_ok
 886+ 6E0C
 887+ 6E0C 18 0E            jr   .no_collision
 888+ 6E0E
 889+ 6E0E              .y_ok:
 890+ 6E0E
 891+ 6E0E                  ; ---------------------------------------------------------------
 892+ 6E0E                  ; Secondo test verticale:
 893+ 6E0E                  ;
 894+ 6E0E                  ; WillyBottom >= ItemTop
 895+ 6E0E                  ;
 896+ 6E0E                  ; WillyBottom = WillyY + 15
 897+ 6E0E                  ; ---------------------------------------------------------------
 898+ 6E0E C6 0F            add  a, 15
 899+ 6E10
 900+ 6E10 BB               cp   e
 901+ 6E11
 902+ 6E11 28 04            jr   z, .collision
 903+ 6E13 30 02            jr   nc, .collision
 904+ 6E15
 905+ 6E15 18 05            jr   .no_collision
 906+ 6E17
 907+ 6E17              .collision:
 908+ 6E17
 909+ 6E17                  ; ---------------------------------------------------------------
 910+ 6E17                  ; Collisione rilevata
 911+ 6E17                  ; ---------------------------------------------------------------
 912+ 6E17 E1               pop  hl
 913+ 6E18 D1               pop  de
 914+ 6E19 C1               pop  bc
 915+ 6E1A
 916+ 6E1A 37               scf                    ; Carry = 1
 917+ 6E1B
 918+ 6E1B C9               ret
 919+ 6E1C
 920+ 6E1C              .no_collision:
 921+ 6E1C
 922+ 6E1C                  ; ---------------------------------------------------------------
 923+ 6E1C                  ; Nessuna collisione
 924+ 6E1C                  ; ---------------------------------------------------------------
 925+ 6E1C E1               pop  hl
 926+ 6E1D D1               pop  de
 927+ 6E1E C1               pop  bc
 928+ 6E1F
 929+ 6E1F B7               or   a                 ; Carry = 0
 930+ 6E20
 931+ 6E20 C9               ret
 932+ 6E21
 933+ 6E21              ; -------------------------------------------------------------------
 934+ 6E21              ; CheckRoomItemsCollision
 935+ 6E21              ;
 936+ 6E21              ; Controlla se Willy entra in collisione con uno degli item
 937+ 6E21              ; attivi presenti nella stanza corrente.
 938+ 6E21              ;
 939+ 6E21              ; Per ogni item:
 940+ 6E21              ;   - verifica che appartenga alla stanza corrente
 941+ 6E21              ;   - verifica che non sia già stato raccolto
 942+ 6E21              ;   - esegue il test di collisione con Willy
 943+ 6E21              ;
 944+ 6E21              ; Se l'item viene raccolto:
 945+ 6E21              ;   - imposta il flag "collected"
 946+ 6E21              ;   - rimuove l'item dalla cache items_grid
 947+ 6E21              ;   - incrementa il contatore degli oggetti raccolti
 948+ 6E21              ;   - aggiorna l'HUD
 949+ 6E21              ;   - ripristina il tile di sfondo
 950+ 6E21              ;   - riproduce il suono di raccolta
 951+ 6E21              ;
 952+ 6E21              ; Formato record ItemsTable:
 953+ 6E21              ;   +0 RoomID
 954+ 6E21              ;   +1 X
 955+ 6E21              ;   +2 Y
 956+ 6E21              ;   +3 Color
 957+ 6E21              ;   +4 Collected
 958+ 6E21              ;
 959+ 6E21              ; Fine tabella:
 960+ 6E21              ;   RoomID = $FF
 961+ 6E21              ; -------------------------------------------------------------------
 962+ 6E21              CheckRoomItemsCollision:
 963+ 6E21
 964+ 6E21                  ; Salva i registri utilizzati
 965+ 6E21 E5               push hl
 966+ 6E22 D5               push de
 967+ 6E23 C5               push bc
 968+ 6E24
 969+ 6E24                  ; Inizio scansione della tabella degli item
 970+ 6E24 21 D8 6B         ld   hl, ItemsTable
 971+ 6E27
 972+ 6E27              .loop:
 973+ 6E27
 974+ 6E27                  ; ---------------------------------------------------------------
 975+ 6E27                  ; Legge il Room ID dell'item corrente
 976+ 6E27                  ; ---------------------------------------------------------------
 977+ 6E27 7E               ld   a, (hl)
 978+ 6E28
 979+ 6E28                  ; $FF indica fine tabella
 980+ 6E28 FE FF            cp   $FF
 981+ 6E2A 28 4D            jr   z, .done
 982+ 6E2C
 983+ 6E2C                  ; ---------------------------------------------------------------
 984+ 6E2C                  ; Verifica se l'item appartiene alla stanza corrente
 985+ 6E2C                  ; ---------------------------------------------------------------
 986+ 6E2C 57               ld   d, a              ; D = RoomID item
 987+ 6E2D
 988+ 6E2D 3A 10 7E         ld   a, (current_room)
 989+ 6E30 BA               cp   d
 990+ 6E31
 991+ 6E31                  ; Se appartiene a un'altra stanza salta il record
 992+ 6E31 20 3F            jr   nz, .next_item
 993+ 6E33
 994+ 6E33                  ; ---------------------------------------------------------------
 995+ 6E33                  ; Legge coordinate e stato dell'item
 996+ 6E33                  ; ---------------------------------------------------------------
 997+ 6E33
 998+ 6E33 23               inc  hl
 999+ 6E34 4E               ld   c, (hl)           ; C = X
1000+ 6E35
1001+ 6E35 23               inc  hl
1002+ 6E36 46               ld   b, (hl)           ; B = Y
1003+ 6E37
1004+ 6E37 23               inc  hl                ; salta Color
1005+ 6E38
1006+ 6E38 23               inc  hl                ; punta a Collected
1007+ 6E39
1008+ 6E39 7E               ld   a, (hl)
1009+ 6E3A
1010+ 6E3A                  ; ---------------------------------------------------------------
1011+ 6E3A                  ; Item già raccolto?
1012+ 6E3A                  ; ---------------------------------------------------------------
1013+ 6E3A B7               or   a
1014+ 6E3B 20 39            jr   nz, .next_no_inc
1015+ 6E3D
1016+ 6E3D                  ; ---------------------------------------------------------------
1017+ 6E3D                  ; Test collisione Willy ↔ Item
1018+ 6E3D                  ;
1019+ 6E3D                  ; Input richiesto:
1020+ 6E3D                  ;   A = ItemX
1021+ 6E3D                  ;   H = ItemY
1022+ 6E3D                  ; ---------------------------------------------------------------
1023+ 6E3D 79               ld   a, c
1024+ 6E3E
1025+ 6E3E E5               push hl                ; salva puntatore al flag Collected
1026+ 6E3F
1027+ 6E3F 60               ld   h, b
1028+ 6E40
1029+ 6E40 CD DB 6D         call CheckWillyItemCollision
1030+ 6E43
1031+ 6E43 E1               pop  hl
1032+ 6E44
1033+ 6E44                  ; Nessuna collisione
1034+ 6E44 30 30            jr   nc, .next_no_inc
1035+ 6E46
1036+ 6E46                  ; ===============================================================
1037+ 6E46                  ; ITEM RACCOLTO
1038+ 6E46                  ; ===============================================================
1039+ 6E46
1040+ 6E46                  ; ---------------------------------------------------------------
1041+ 6E46                  ; Marca l'item come raccolto
1042+ 6E46                  ; ---------------------------------------------------------------
1043+ 6E46 36 01            ld   (hl), 1
1044+ 6E48
1045+ 6E48                  ; ---------------------------------------------------------------
1046+ 6E48                  ; Rimuove l'item dalla cache items_grid
1047+ 6E48                  ;
1048+ 6E48                  ; Calcolo:
1049+ 6E48                  ;   offset = Row * 32 + Col
1050+ 6E48                  ; ---------------------------------------------------------------
1051+ 6E48 E5               push hl
1052+ 6E49 D5               push de
1053+ 6E4A
1054+ 6E4A 26 00            ld   h, 0
1055+ 6E4C 68               ld   l, b              ; HL = Row
1056+ 6E4D
1057+ 6E4D 29               add  hl, hl            ; *2
1058+ 6E4E 29               add  hl, hl            ; *4
1059+ 6E4F 29               add  hl, hl            ; *8
1060+ 6E50 29               add  hl, hl            ; *16
1061+ 6E51 29               add  hl, hl            ; *32
1062+ 6E52
1063+ 6E52 59               ld   e, c
1064+ 6E53 16 00            ld   d, 0
1065+ 6E55
1066+ 6E55 19               add  hl, de            ; Row*32 + Col
1067+ 6E56
1068+ 6E56 11 00 90         ld   de, items_grid
1069+ 6E59 19               add  hl, de
1070+ 6E5A
1071+ 6E5A                  ; La cella non contiene più un item
1072+ 6E5A 36 00            ld   (hl), 0
1073+ 6E5C
1074+ 6E5C D1               pop  de
1075+ 6E5D E1               pop  hl
1076+ 6E5E
1077+ 6E5E                  ; ---------------------------------------------------------------
1078+ 6E5E                  ; Conserva il puntatore all'entry corrente
1079+ 6E5E                  ; poiché le routine successive possono alterare HL.
1080+ 6E5E                  ; ---------------------------------------------------------------
1081+ 6E5E E5               push hl
1082+ 6E5F
1083+ 6E5F                  ; ---------------------------------------------------------------
1084+ 6E5F                  ; Aggiorna il numero di oggetti raccolti
1085+ 6E5F                  ; ---------------------------------------------------------------
1086+ 6E5F 3A 06 7B         ld   a, (items_collected)
1087+ 6E62
1088+ 6E62 3C               inc  a
1089+ 6E63
1090+ 6E63 32 06 7B         ld   (items_collected), a
1091+ 6E66
1092+ 6E66                  ; ---------------------------------------------------------------
1093+ 6E66                  ; Aggiorna il contatore visualizzato a schermo
1094+ 6E66                  ; ---------------------------------------------------------------
1095+ 6E66 CD CB 60         call UpdateItemsCollectedDisplay
1096+ 6E69
1097+ 6E69                  ; ---------------------------------------------------------------
1098+ 6E69                  ; Ripristina il tile originale della stanza
1099+ 6E69                  ; eliminando la grafica dell'item.
1100+ 6E69                  ;
1101+ 6E69                  ; Input:
1102+ 6E69                  ;   B = Row
1103+ 6E69                  ;   C = Col
1104+ 6E69                  ; ---------------------------------------------------------------
1105+ 6E69 CD 99 6D         call RestoreBackgroundCell
1106+ 6E6C
1107+ 6E6C                  ; ---------------------------------------------------------------
1108+ 6E6C                  ; Riproduce il suono di raccolta
1109+ 6E6C                  ; ---------------------------------------------------------------
1110+ 6E6C CD 7D 6E         call PlayCollectSound
1111+ 6E6F
1112+ 6E6F                  ; Ripristina il puntatore alla tabella
1113+ 6E6F E1               pop  hl
1114+ 6E70
1115+ 6E70                  ; Continua con il record successivo
1116+ 6E70 18 04            jr   .next_no_inc
1117+ 6E72
1118+ 6E72              .next_item:
1119+ 6E72
1120+ 6E72                  ; ---------------------------------------------------------------
1121+ 6E72                  ; Salta i campi del record:
1122+ 6E72                  ;   X
1123+ 6E72                  ;   Y
1124+ 6E72                  ;   Color
1125+ 6E72                  ;   Collected
1126+ 6E72                  ; ---------------------------------------------------------------
1127+ 6E72 23               inc  hl
1128+ 6E73 23               inc  hl
1129+ 6E74 23               inc  hl
1130+ 6E75 23               inc  hl
1131+ 6E76
1132+ 6E76              .next_no_inc:
1133+ 6E76
1134+ 6E76                  ; ---------------------------------------------------------------
1135+ 6E76                  ; Avanza al record successivo.
1136+ 6E76                  ;
1137+ 6E76                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1138+ 6E76                  ; ---------------------------------------------------------------
1139+ 6E76 23               inc  hl
1140+ 6E77
1141+ 6E77 18 AE            jr   .loop
1142+ 6E79
1143+ 6E79              .done:
1144+ 6E79
1145+ 6E79                  ; Ripristina i registri
1146+ 6E79 C1               pop  bc
1147+ 6E7A D1               pop  de
1148+ 6E7B E1               pop  hl
1149+ 6E7C
1150+ 6E7C C9               ret
1151+ 6E7D
1152+ 6E7D              ; -------------------------------------------------------------------
1153+ 6E7D              ; PlayCollectSound
1154+ 6E7D              ;
1155+ 6E7D              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1156+ 6E7D              ; dello ZX Spectrum utilizzando il port $FE.
1157+ 6E7D              ;
1158+ 6E7D              ; Il suono viene prodotto alternando ON/OFF del bit 4
1159+ 6E7D              ; (speaker) con un semplice delay software.
1160+ 6E7D              ;
1161+ 6E7D              ; Effetto risultante:
1162+ 6E7D              ;   beep breve tipo "pickup item"
1163+ 6E7D              ; -------------------------------------------------------------------
1164+ 6E7D              PlayCollectSound:
1165+ 6E7D
1166+ 6E7D                  ; Salva registri utilizzati
1167+ 6E7D C5               push bc
1168+ 6E7E D5               push de
1169+ 6E7F
1170+ 6E7F                  ; ---------------------------------------------------------------
1171+ 6E7F                  ; Numero di cicli del beep (durata complessiva del suono)
1172+ 6E7F                  ; ---------------------------------------------------------------
1173+ 6E7F 06 78            ld   b, 120
1174+ 6E81
1175+ 6E81              .sound_loop:
1176+ 6E81
1177+ 6E81                  ; ---------------------------------------------------------------
1178+ 6E81                  ; SPEAKER ON
1179+ 6E81                  ;
1180+ 6E81                  ; Legge il colore del bordo corrente e attiva il bit 4
1181+ 6E81                  ; per pilotare lo speaker.
1182+ 6E81                  ; ---------------------------------------------------------------
1183+ 6E81 3A 08 7B         ld   a, (room_border_color)
1184+ 6E84 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1185+ 6E86
1186+ 6E86 D3 FE            out  ($fe), a         ; scrive sul port ULA
1187+ 6E88
1188+ 6E88                  ; ---------------------------------------------------------------
1189+ 6E88                  ; Delay (mezzo periodo)
1190+ 6E88                  ; Loop software a consumo CPU
1191+ 6E88                  ; ---------------------------------------------------------------
1192+ 6E88 0E 3C            ld   c, 60
1193+ 6E8A
1194+ 6E8A              .d1:
1195+ 6E8A 0D               dec  c
1196+ 6E8B 20 FD            jr   nz, .d1
1197+ 6E8D
1198+ 6E8D                  ; ---------------------------------------------------------------
1199+ 6E8D                  ; SPEAKER OFF
1200+ 6E8D                  ;
1201+ 6E8D                  ; Mantiene il colore del bordo ma disattiva lo speaker
1202+ 6E8D                  ; ---------------------------------------------------------------
1203+ 6E8D 3A 08 7B         ld   a, (room_border_color)
1204+ 6E90 E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1205+ 6E92
1206+ 6E92 D3 FE            out  ($fe), a
1207+ 6E94
1208+ 6E94                  ; ---------------------------------------------------------------
1209+ 6E94                  ; Secondo delay (mezzo periodo)
1210+ 6E94                  ; Completa l’onda quadra
1211+ 6E94                  ; ---------------------------------------------------------------
1212+ 6E94 0E 3C            ld   c, 60
1213+ 6E96
1214+ 6E96              .d2:
1215+ 6E96 0D               dec  c
1216+ 6E97 20 FD            jr   nz, .d2
1217+ 6E99
1218+ 6E99                  ; ---------------------------------------------------------------
1219+ 6E99                  ; Ripete fino a completare il numero di cicli
1220+ 6E99                  ; ---------------------------------------------------------------
1221+ 6E99 10 E6            djnz .sound_loop
1222+ 6E9B
1223+ 6E9B                  ; Ripristina registri salvati
1224+ 6E9B D1               pop  de
1225+ 6E9C C1               pop  bc
1226+ 6E9D
1227+ 6E9D C9               ret
1228+ 6E9E
1229+ 6E9E              ; -------------------------------------------------------------------
1230+ 6E9E              ; CheckActiveItemAtCell
1231+ 6E9E              ;
1232+ 6E9E              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1233+ 6E9E              ; nella cella specificata della griglia items_grid.
1234+ 6E9E              ;
1235+ 6E9E              ; Questa routine usa una lookup diretta su una mappa 32x16,
1236+ 6E9E              ; evitando la scansione della ItemsTable.
1237+ 6E9E              ;
1238+ 6E9E              ; Input:
1239+ 6E9E              ;   B = Colonna (0..31)
1240+ 6E9E              ;   C = Riga (0..15)
1241+ 6E9E              ;
1242+ 6E9E              ; Output:
1243+ 6E9E              ;   Carry Set   = item presente nella cella
1244+ 6E9E              ;   Carry Clear = nessun item
1245+ 6E9E              ;
1246+ 6E9E              ; Nota:
1247+ 6E9E              ;   HL NON è restituito valido (commento originale non corretto:
1248+ 6E9E              ;   la routine non punta a ItemsTable).
1249+ 6E9E              ; -------------------------------------------------------------------
1250+ 6E9E              CheckActiveItemAtCell:
1251+ 6E9E
1252+ 6E9E                  ; Salva registri usati
1253+ 6E9E D5               push de
1254+ 6E9F E5               push hl
1255+ 6EA0
1256+ 6EA0                  ; ---------------------------------------------------------------
1257+ 6EA0                  ; Calcolo indice lineare nella griglia 32x16:
1258+ 6EA0                  ;
1259+ 6EA0                  ; offset = Row * 32 + Col
1260+ 6EA0                  ; ---------------------------------------------------------------
1261+ 6EA0 26 00            ld   h, 0
1262+ 6EA2 69               ld   l, c              ; HL = Row
1263+ 6EA3
1264+ 6EA3 29               add  hl, hl            ; *2
1265+ 6EA4 29               add  hl, hl            ; *4
1266+ 6EA5 29               add  hl, hl            ; *8
1267+ 6EA6 29               add  hl, hl            ; *16
1268+ 6EA7 29               add  hl, hl            ; *32
1269+ 6EA8
1270+ 6EA8                  ; Aggiunge la colonna
1271+ 6EA8 58               ld   e, b
1272+ 6EA9 16 00            ld   d, 0
1273+ 6EAB 19               add  hl, de            ; HL = Row*32 + Col
1274+ 6EAC
1275+ 6EAC                  ; ---------------------------------------------------------------
1276+ 6EAC                  ; Accesso alla griglia degli item attivi
1277+ 6EAC                  ; ---------------------------------------------------------------
1278+ 6EAC 11 00 90         ld   de, items_grid
1279+ 6EAF 19               add  hl, de            ; HL = address cella
1280+ 6EB0
1281+ 6EB0                  ; ---------------------------------------------------------------
1282+ 6EB0                  ; Controllo presenza item
1283+ 6EB0                  ;
1284+ 6EB0                  ; items_grid contiene:
1285+ 6EB0                  ;   0 = nessun item
1286+ 6EB0                  ;   >0 = item attivo (colore o flag)
1287+ 6EB0                  ; ---------------------------------------------------------------
1288+ 6EB0 7E               ld   a, (hl)
1289+ 6EB1 B7               or   a
1290+ 6EB2 28 04            jr   z, .not_active
1291+ 6EB4
1292+ 6EB4                  ; ---------------------------------------------------------------
1293+ 6EB4                  ; Item trovato
1294+ 6EB4                  ; ---------------------------------------------------------------
1295+ 6EB4 E1               pop  hl
1296+ 6EB5 D1               pop  de
1297+ 6EB6
1298+ 6EB6 37               scf                    ; Carry = 1
1299+ 6EB7 C9               ret
1300+ 6EB8
1301+ 6EB8              .not_active:
1302+ 6EB8
1303+ 6EB8                  ; ---------------------------------------------------------------
1304+ 6EB8                  ; Nessun item nella cella
1305+ 6EB8                  ; ---------------------------------------------------------------
1306+ 6EB8 E1               pop  hl
1307+ 6EB9 D1               pop  de
1308+ 6EBA
1309+ 6EBA B7               or   a                 ; Carry = 0
1310+ 6EBB C9               ret
1311+ 6EBC
# file closed: items.asm
