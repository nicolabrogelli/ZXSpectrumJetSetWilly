1939+ 7312 38 19            jr   c, .collision
1940+ 7314
1941+ 7314                  ; Punto 5: Bottom-Left (X, Y + 15)
1942+ 7314 ED 4B 26 E6      ld   bc, (PlayerPos)
1943+ 7318 78               ld   a, b
1944+ 7319 C6 0F            add  a, 15
1945+ 731B 47               ld   b, a
