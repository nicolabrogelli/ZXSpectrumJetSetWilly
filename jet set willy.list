  70+ 7ABA                  IF ENABLE_MUSIC != 0
  71+ 7ABA ~            ; -------------------------------------------------------------------
  72+ 7ABA ~            ; Audio_UpdateMusic
  73+ 7ABA ~            ;
  74+ 7ABA ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 7ABA ~            ; Viene chiamata a ogni frame.
  76+ 7ABA ~            ; -------------------------------------------------------------------
  77+ 7ABA ~            Audio_UpdateMusic:
  78+ 7ABA ~                push af
  79+ 7ABA ~                push bc
  80+ 7ABA ~                push de
  81+ 7ABA ~                push hl
  82+ 7ABA ~
  83+ 7ABA ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 7ABA ~                ld   a, (Audio_jump_sound_note)
  85+ 7ABA ~                cp   18
  86+ 7ABA ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 7ABA ~
  88+ 7ABA ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 7ABA ~                ld   a, (Audio_music_frame_counter)
  90+ 7ABA ~                dec  a
  91+ 7ABA ~                ld   (Audio_music_frame_counter), a
  92+ 7ABA ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 7ABA ~
  94+ 7ABA ~                ; Altrimenti carica la nota successiva
  95+ 7ABA ~                ld   a, (Audio_music_note_idx)
  96+ 7ABA ~                inc  a
  97+ 7ABA ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 7ABA ~                jr   c, .no_wrap
  99+ 7ABA ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 7ABA ~            .no_wrap:
 101+ 7ABA ~                ld   (Audio_music_note_idx), a
 102+ 7ABA ~
 103+ 7ABA ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 7ABA ~                ld   e, a
 105+ 7ABA ~                ld   d, 0
 106+ 7ABA ~                ld   hl, Audio_MusicSheet
 107+ 7ABA ~                add  hl, de
 108+ 7ABA ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 7ABA ~
 110+ 7ABA ~                ; Leggi durata (secondo byte)
 111+ 7ABA ~                inc  hl
 112+ 7ABA ~                ld   a, (hl)
 113+ 7ABA ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 7ABA ~                jr   nz, .dur_ok
 115+ 7ABA ~                ld   a, 1
 116+ 7ABA ~            .dur_ok:
 117+ 7ABA ~                ld   (Audio_music_frame_counter), a
 118+ 7ABA ~
 119+ 7ABA ~            .play_current_note:
 120+ 7ABA ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 7ABA ~                ld   a, (Audio_music_note_idx)
 122+ 7ABA ~                ld   e, a
 123+ 7ABA ~                ld   d, 0
 124+ 7ABA ~                ld   hl, Audio_MusicSheet
 125+ 7ABA ~                add  hl, de
 126+ 7ABA ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 7ABA ~                ld   a, (hl)                  ; A = delay
 128+ 7ABA ~                or   a
 129+ 7ABA ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 7ABA ~
 131+ 7ABA ~                ; Suona la nota: 2 cicli
 132+ 7ABA ~                ld   d, a                     ; D = delay
 133+ 7ABA ~                ld   b, 2                     ; 2 cicli per frame
 134+ 7ABA ~            .note_loop:
 135+ 7ABA ~                ; Speaker ON
 136+ 7ABA ~                ld   a, (room_border_color)
 137+ 7ABA ~                or   $10
 138+ 7ABA ~                out  ($fe), a
 139+ 7ABA ~                ld   c, d
 140+ 7ABA ~            .d1:
 141+ 7ABA ~                push af
 142+ 7ABA ~                pop  af
 143+ 7ABA ~                dec  c
 144+ 7ABA ~                jr   nz, .d1
 145+ 7ABA ~
 146+ 7ABA ~                ; Speaker OFF
 147+ 7ABA ~                ld   a, (room_border_color)
 148+ 7ABA ~                and  $ef
 149+ 7ABA ~                out  ($fe), a
 150+ 7ABA ~                ld   c, d
 151+ 7ABA ~            .d2:
 152+ 7ABA ~                push af
 153+ 7ABA ~                pop  af
 154+ 7ABA ~                dec  c
 155+ 7ABA ~                jr   nz, .d2
 156+ 7ABA ~
 157+ 7ABA ~                djnz .note_loop
 158+ 7ABA ~
 159+ 7ABA ~            .done:
 160+ 7ABA ~                pop  hl
 161+ 7ABA ~                pop  de
 162+ 7ABA ~                pop  bc
 163+ 7ABA ~                pop  af
 164+ 7ABA ~                ret
 165+ 7ABA ~
 166+ 7ABA ~            Audio_MusicSheet:
 167+ 7ABA ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 7ABA ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 7ABA ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 7ABA ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 7ABA ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 7ABA ~                db 90, 10, 107, 20, 68, 65
 173+ 7ABA                  ELSE
 174+ 7ABA              Audio_UpdateMusic:
 175+ 7ABA C9               ret
 176+ 7ABB                  ENDIF
 177+ 7ABB
 178+ 7ABB              ; -------------------------------------------------------------------
 179+ 7ABB              ; Audio_PlayCollectSound
 180+ 7ABB              ;
 181+ 7ABB              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 7ABB              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 7ABB              ; -------------------------------------------------------------------
 184+ 7ABB              Audio_PlayCollectSound:
 185+ 7ABB C5               push bc
 186+ 7ABC D5               push de
 187+ 7ABD
 188+ 7ABD 06 78            ld   b, 120
 189+ 7ABF              .sound_loop:
 190+ 7ABF 3A E8 7A         ld   a, (room_border_color)
 191+ 7AC2 F6 10            or   $10               ; speaker ON
 192+ 7AC4 D3 FE            out  ($fe), a
 193+ 7AC6
 194+ 7AC6 0E 3C            ld   c, 60
 195+ 7AC8              .d1:
 196+ 7AC8 0D               dec  c
 197+ 7AC9 20 FD            jr   nz, .d1
 198+ 7ACB
 199+ 7ACB 3A E8 7A         ld   a, (room_border_color)
 200+ 7ACE E6 EF            and  $ef              ; speaker OFF
 201+ 7AD0 D3 FE            out  ($fe), a
 202+ 7AD2
 203+ 7AD2 0E 3C            ld   c, 60
 204+ 7AD4              .d2:
 205+ 7AD4 0D               dec  c
 206+ 7AD5 20 FD            jr   nz, .d2
 207+ 7AD7
 208+ 7AD7 10 E6            djnz .sound_loop
 209+ 7AD9
 210+ 7AD9 D1               pop  de
 211+ 7ADA C1               pop  bc
 212+ 7ADB C9               ret
 213+ 7ADC
