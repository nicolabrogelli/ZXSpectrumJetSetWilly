 941+ 7DF7 28 08            jr   z, .h_rev_right
 942+ 7DF9 38 06            jr   c, .h_rev_right
 943+ 7DFB DD 77 02         ld   (ix+2), a
 944+ 7DFE C3 73 7E         jp   .next
 945+ 7E01
