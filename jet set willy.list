 539+ 7299
 540+ 7299 23               inc  hl
 541+ 729A 4E               ld   c, (hl)           ; X (colonna)
 542+ 729B
 543+ 729B 23               inc  hl
 544+ 729C 46               ld   b, (hl)           ; Y (riga)
 545+ 729D
 546+ 729D 23               inc  hl
 547+ 729E 5E               ld   e, (hl)           ; Colore
 548+ 729F
 549+ 729F 23               inc  hl
 550+ 72A0 7E               ld   a, (hl)           ; Collected flag
 551+ 72A1
 552+ 72A1                  ; Se diverso da zero l'item è già stato raccolto
 553+ 72A1 B7               or   a
 554+ 72A2 20 3E            jr   nz, .next_no_inc
 555+ 72A4
 556+ 72A4                  ; ---------------------------------------------------------------
 557+ 72A4                  ; Disegna l'item sullo schermo
 558+ 72A4                  ;
 559+ 72A4                  ; B = Row
 560+ 72A4                  ; C = Column
 561+ 72A4                  ; HL = bitmap pointer
 562+ 72A4                  ; E = Color
 563+ 72A4                  ; ---------------------------------------------------------------
 564+ 72A4 E5               push hl
 565+ 72A5
 566+ 72A5 DD E5            push ix
