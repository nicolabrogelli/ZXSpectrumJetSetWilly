 157+ 891A              ; Audio_PlayTitleNote
 158+ 891A              ;
 159+ 891A              ; Suona una nota della melodia del titolo (Moonlight Sonata).
 160+ 891A              ; HL = puntatore al byte della nota in Audio_TitleMusicSheet
 161+ 891A              ; Ritorna:
 162+ 891A              ;   Z flag SET   -> Tasto ENTER premuto (interrompi e avvia il gioco)
 163+ 891A              ;   Z flag RESET -> Nota completata regolarmente senza pressione di ENTER
 164+ 891A              ; -------------------------------------------------------------------
 165+ 891A              Audio_PlayTitleNote:
 166+ 891A C5               push bc
 167+ 891B D5               push de
 168+ 891C E5               push hl
 169+ 891D
 170+ 891D 5E               ld   e, (hl)               ; E = ritardo periodo nota
 171+ 891E 53               ld   d, e                  ; D = contatore ritardo
 172+ 891F 06 00            ld   b, 0                  ; B = 0 (256 iterazioni djnz)
 173+ 8921 0E 64            ld   c, 100                ; C = 100 passaggi di ciclo (50 alti, 50 bassi)
 174+ 8923 AF               xor  a                     ; Bordo nero, speaker off
 175+ 8924
 176+ 8924              .tone_loop:
 177+ 8924 D3 FE            out  ($fe), a              ; 11 T-states
 178+ 8926 15               dec  d                     ; 4 T-states
 179+ 8927 20 03            jr   nz, .no_toggle        ; 12 T-states
 180+ 8929 53               ld   d, e                  ; 4 T-states
 181+ 892A EE 18            xor  $18                   ; 7 T-states (toggle EAR bit 4 e MIC bit 3)
 182+ 892C              .no_toggle:
 183+ 892C 10 F6            djnz .tone_loop            ; 13 T-states
 184+ 892E
 185+ 892E                  ; A metà nota (C = 50), dimezza la frequenza (raddoppia E) e controlla ENTER
 186+ 892E 08               ex   af, af'
 187+ 892F 79               ld   a, c
 188+ 8930 FE 32            cp   50
 189+ 8932 20 09            jr   nz, .no_octave_drop
 190+ 8934 CB 13            rl   e                     ; Scala di un'ottava verso il basso
 191+ 8936
 192+ 8936                  ; Controllo reattivo di ENTER a metà nota (Porta $BFFE, Bit 0)
 193+ 8936 3E BF            ld   a, $bf
 194+ 8938 DB FE            in   a, ($fe)
 195+ 893A 1F               rra
 196+ 893B 30 14            jr   nc, .enter_hit        ; Carry = 0 -> tasto premuto!
 197+ 893D
 198+ 893D              .no_octave_drop:
 199+ 893D 08               ex   af, af'
 200+ 893E 0D               dec  c
 201+ 893F 20 E3            jr   nz, .tone_loop
 202+ 8941
 203+ 8941                  ; Controllo a fine nota
 204+ 8941 AF               xor  a
 205+ 8942 D3 FE            out  ($fe), a              ; Spegne lo speaker
 206+ 8944 3E BF            ld   a, $bf
 207+ 8946 DB FE            in   a, ($fe)
 208+ 8948 1F               rra
 209+ 8949 30 07            jr   nc, .enter_hit_clean
 210+ 894B
 211+ 894B                  ; Nota completata senza tasti premuti
 212+ 894B E1               pop  hl
 213+ 894C D1               pop  de
 214+ 894D C1               pop  bc
 215+ 894E F6 01            or   1                     ; Forza flag NZ (Zero = 0)
 216+ 8950 C9               ret
 217+ 8951
 218+ 8951              .enter_hit:
 219+ 8951 08               ex   af, af'
 220+ 8952              .enter_hit_clean:
 221+ 8952 AF               xor  a
 222+ 8953 D3 FE            out  ($fe), a              ; Spegne lo speaker
 223+ 8955 E1               pop  hl
 224+ 8956 D1               pop  de
 225+ 8957 C1               pop  bc
 226+ 8958 BF               cp   a                     ; Forza flag Z (Zero = 1)
 227+ 8959 C9               ret
