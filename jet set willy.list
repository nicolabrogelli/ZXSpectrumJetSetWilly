 600+ 6A70 06 08            ld   b, 8              ; 8 slot
 601+ 6A72              .loop:
 602+ 6A72 DD 7E 00         ld   a, (ix+0)         ; Flags
 603+ 6A75 E6 80            and  $80               ; Active?
 604+ 6A77 28 1F            jr   z, .next
 605+ 6A79
 606+ 6A79                  ; 1. Controllo orizzontale: PlayerX - EnemyX + 7 in [0, 22]
 607+ 6A79 3A 39 7B         ld   a, (PlayerPos)    ; A = PlayerX
 608+ 6A7C DD 96 02         sub  (ix+2)            ; A = PlayerX - EnemyX (Offset 2: Current X)
 609+ 6A7F C6 07            add  a, 7              ; A = PlayerX - EnemyX + 7
 610+ 6A81 FE 17            cp   23                ; Se >= 23, nessuna collisione con questo
 611+ 6A83 30 13            jr   nc, .next
