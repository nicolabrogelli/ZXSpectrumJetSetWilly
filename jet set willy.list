   8+ 7C8C              ; Audio_UpdateJumpSound
   9+ 7C8C              ;
  10+ 7C8C              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7C8C              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7C8C              ; -------------------------------------------------------------------
  13+ 7C8C              Audio_UpdateJumpSound:
  14+ 7C8C F5               push af
  15+ 7C8D C5               push bc
  16+ 7C8E D5               push de
  17+ 7C8F E5               push hl
  18+ 7C90
  19+ 7C90                  ; Controlla se il suono è attivo (note < 18)
  20+ 7C90 3A AC E9         ld   a, (Audio_jump_sound_note)
  21+ 7C93 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7C95 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7C97
  24+ 7C97                  ; Carica la nota corrente da suonare
  25+ 7C97 5F               ld   e, a
  26+ 7C98 16 00            ld   d, 0
  27+ 7C9A 21 C6 7C         ld   hl, Audio_JumpSoundDelays
  28+ 7C9D 19               add  hl, de
  29+ 7C9E 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7C9F 57               ld   d, a                      ; D = delay della nota
  31+ 7CA0
  32+ 7CA0                  ; Suona la nota: 15 cicli
  33+ 7CA0 06 0F            ld   b, 15
  34+ 7CA2              .note_loop:
  35+ 7CA2                  ; Speaker ON
  36+ 7CA2 3A 32 E6         ld   a, (room_border_color)
  37+ 7CA5 F6 10            or   $10
  38+ 7CA7 D3 FE            out  ($fe), a
  39+ 7CA9 4A               ld   c, d
  40+ 7CAA              .d1:
  41+ 7CAA 0D               dec  c
  42+ 7CAB 20 FD            jr   nz, .d1
  43+ 7CAD
  44+ 7CAD                  ; Speaker OFF
  45+ 7CAD 3A 32 E6         ld   a, (room_border_color)
  46+ 7CB0 E6 EF            and  $ef
  47+ 7CB2 D3 FE            out  ($fe), a
  48+ 7CB4 4A               ld   c, d
  49+ 7CB5              .d2:
  50+ 7CB5 0D               dec  c
  51+ 7CB6 20 FD            jr   nz, .d2
  52+ 7CB8
  53+ 7CB8 10 E8            djnz .note_loop
  54+ 7CBA
  55+ 7CBA                  ; Passa alla nota successiva
  56+ 7CBA 3A AC E9         ld   a, (Audio_jump_sound_note)
  57+ 7CBD 3C               inc  a
  58+ 7CBE 32 AC E9         ld   (Audio_jump_sound_note), a
  59+ 7CC1
  60+ 7CC1              .done:
  61+ 7CC1 E1               pop  hl
  62+ 7CC2 D1               pop  de
  63+ 7CC3 C1               pop  bc
  64+ 7CC4 F1               pop  af
  65+ 7CC5 C9               ret
  66+ 7CC6
  67+ 7CC6              Audio_JumpSoundDelays:
  68+ 7CC6 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7CCA 19 13 0C 06
  68+ 7CCE 0C 13 19 20
  68+ 7CD2 26 2D 33 3A
  68+ 7CD6 40 47
