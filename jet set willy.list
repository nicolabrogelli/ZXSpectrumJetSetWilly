491+  5FCE 06 08            ld   b, 8            ; B = coordinata Y pixel (inizia a Y=8, riga 1)
492+  5FD0 0E 10            ld   c, 16           ; C = numero di righe di caratteri (16)
493+  5FD2
494+  5FD2              .row_loop:
495+  5FD2 C5               push bc              ; Salva contatore riga e Y
496+  5FD3
497+  5FD3                  ; 1. Disegna bordo sinistro (X = 0)
498+  5FD3 60               ld   h, b            ; H = Y
499+  5FD4 2E 00            ld   l, 0            ; L = X (0)
500+  5FD6 CD 0E 5E         call GetScreenAddr   ; HL = indirizzo schermo
501+  5FD9 DD 21 62 61      ld   ix, TilesDef + 64 ; IX = grafica del bordo (9° carattere)
502+  5FDD 16 08            ld   d, 8            ; 8 scanline
503+  5FDF              .left_loop:
