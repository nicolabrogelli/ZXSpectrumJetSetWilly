 831+ 616A              ; -------------------------------------------------------------------
 832+ 616A              ; Disegna la riga/pavimento sotto i piedi degli sprite (Riga 18, Y = 144)
 833+ 616A              ; -------------------------------------------------------------------
 834+ 616A              ; -------------------------------------------------------------------
 835+ 616A              ; Disegna un tile 8x8 sullo schermo
 836+ 616A              ; Input: B = Row (0..23), C = Col (0..31), IX = Puntatore al Tile (9 byte: 1 attr + 8 bitmap)
 837+ 616A              ; -------------------------------------------------------------------
 838+ 616A              DrawTile:
 839+ 616A C5               push bc
 840+ 616B D5               push de
 841+ 616C E5               push hl
 842+ 616D
 843+ 616D                  ; 1. Calcola indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 844+ 616D                  ; HighByte = $40 + (B & $18)
 845+ 616D 78               ld   a, b
 846+ 616E E6 18            and  $18
 847+ 6170 C6 40            add  a, $40
 848+ 6172 67               ld   h, a              ; H = High byte
 849+ 6173
 850+ 6173                  ; LowByte = ((B & 7) * 32) + C
 851+ 6173 78               ld   a, b
 852+ 6174 E6 07            and  7
 853+ 6176 87               add  a, a              ; *2
 854+ 6177 87               add  a, a              ; *4
 855+ 6178 87               add  a, a              ; *8
 856+ 6179 87               add  a, a              ; *16
 857+ 617A 87               add  a, a              ; *32
 858+ 617B 81               add  a, c              ; + Col C
 859+ 617C 6F               ld   l, a              ; L = Low byte
 860+ 617D
 861+ 617D                  ; 2. Copia gli 8 byte del bitmap
 862+ 617D 16 08            ld   d, 8              ; 8 scanline
 863+ 617F DD E5            push ix
 864+ 6181 DD 23            inc  ix                ; Salta l'attributo, vai al bitmap
 865+ 6183              .line_loop:
 866+ 6183 DD 7E 00         ld   a, (ix+0)
 867+ 6186 77               ld   (hl), a
 868+ 6187 24               inc  h                 ; Prossima scanline (stessa riga di caratteri)
 869+ 6188 DD 23            inc  ix
 870+ 618A 15               dec  d
 871+ 618B 20 F6            jr   nz, .line_loop
 872+ 618D DD E1            pop  ix
 873+ 618F
 874+ 618F                  ; 3. Scrivi l'attributo
 875+ 618F                  ; AttrAddr = $5800 + B * 32 + C
 876+ 618F 26 00            ld   h, 0
 877+ 6191 68               ld   l, b              ; HL = B (Row)
 878+ 6192 29               add  hl, hl            ; *2
 879+ 6193 29               add  hl, hl            ; *4
 880+ 6194 29               add  hl, hl            ; *8
 881+ 6195 29               add  hl, hl            ; *16
 882+ 6196 29               add  hl, hl            ; *32
 883+ 6197 16 00            ld   d, 0
 884+ 6199 59               ld   e, c              ; DE = C (Col)
 885+ 619A 19               add  hl, de            ; HL = B * 32 + C
 886+ 619B 11 00 58         ld   de, $5800
 887+ 619E 19               add  hl, de            ; HL = AttrAddr
 888+ 619F
 889+ 619F DD 7E 00         ld   a, (ix+0)         ; A = attribute byte
 890+ 61A2 77               ld   (hl), a           ; Scrivi in memoria attributi
 891+ 61A3
 892+ 61A3 E1               pop  hl
 893+ 61A4 D1               pop  de
 894+ 61A5 C1               pop  bc
 895+ 61A6 C9               ret
 896+ 61A7
 897+ 61A7              ; -------------------------------------------------------------------
 898+ 61A7              ; Disegna la stanza corrente leggendola dalla struttura dati
 899+ 61A7              ; -------------------------------------------------------------------
 900+ 61A7              DrawRoom:
 901+ 61A7 C5               push bc
 902+ 61A8 D5               push de
 903+ 61A9 E5               push hl
 904+ 61AA DD E5            push ix
 905+ 61AC
 906+ 61AC 06 00            ld   b, 0              ; B = layout row (0..15)
 907+ 61AE              .row_loop:
 908+ 61AE 0E 00            ld   c, 0              ; C = layout column group (0..7 bytes)
 909+ 61B0              .col_byte_loop:
 910+ 61B0 26 00            ld   h, 0
 911+ 61B2 68               ld   l, b
 912+ 61B3 29               add  hl, hl
 913+ 61B4 29               add  hl, hl
 914+ 61B5 29               add  hl, hl            ; HL = B * 8
 915+ 61B6 16 00            ld   d, 0
 916+ 61B8 59               ld   e, c              ; DE = C
 917+ 61B9 19               add  hl, de            ; HL = B * 8 + C
 918+ 61BA ED 5B A6 77      ld   de, (room_ptr)
 919+ 61BE 19               add  hl, de            ; HL = layout byte address
 920+ 61BF 7E               ld   a, (hl)           ; A = layout byte
 921+ 61C0 57               ld   d, a              ; D = salva il byte di layout
 922+ 61C1
 923+ 61C1 1E 04            ld   e, 4              ; 4 celle per byte
 924+ 61C3              .cell_loop:
 925+ 61C3 7A               ld   a, d
 926+ 61C4 07               rlca
 927+ 61C5 07               rlca
 928+ 61C6 57               ld   d, a              ; D ruotato di 2
 929+ 61C7 E6 03            and  3                 ; A = cell type (0..3)
 930+ 61C9
 931+ 61C9 D5               push de
 932+ 61CA C5               push bc
 933+ 61CB
 934+ 61CB ED 5B A6 77      ld   de, (room_ptr)
 935+ 61CF B7               or   a
 936+ 61D0 20 06            jr   nz, .not_bg
 937+ 61D2 21 A0 00         ld   hl, OFFSET_BG
 938+ 61D5 19               add  hl, de
 939+ 61D6 18 16            jr   .draw_cell
 940+ 61D8              .not_bg:
 941+ 61D8 3D               dec  a
 942+ 61D9 20 06            jr   nz, .not_floor
 943+ 61DB 21 A9 00         ld   hl, OFFSET_FLOOR
 944+ 61DE 19               add  hl, de
 945+ 61DF 18 0D            jr   .draw_cell
 946+ 61E1              .not_floor:
 947+ 61E1 3D               dec  a
 948+ 61E2 20 06            jr   nz, .not_wall
 949+ 61E4 21 B2 00         ld   hl, OFFSET_WALL
 950+ 61E7 19               add  hl, de
 951+ 61E8 18 04            jr   .draw_cell
 952+ 61EA              .not_wall:
 953+ 61EA 21 BB 00         ld   hl, OFFSET_NASTY
 954+ 61ED 19               add  hl, de
 955+ 61EE
 956+ 61EE              .draw_cell:
 957+ 61EE E5               push hl
 958+ 61EF DD E1            pop  ix                ; IX = tile pointer
 959+ 61F1
 960+ 61F1 C1               pop  bc                ; BC = original BC
 961+ 61F2 D1               pop  de                ; DE = original DE
 962+ 61F3 D5               push de                ; Save for next iteration
 963+ 61F4 C5               push bc                ; Save for next iteration
 964+ 61F5
 965+ 61F5 78               ld   a, b
 966+ 61F6 C6 03            add  a, 3              ; A = screen Row (R = r + 3)
 967+ 61F8 67               ld   h, a
 968+ 61F9
 969+ 61F9 79               ld   a, c
 970+ 61FA 87               add  a, a              ; *2
 971+ 61FB 87               add  a, a              ; *4 (Col group * 4)
 972+ 61FC 6F               ld   l, a              ; L = Col group * 4
 973+ 61FD
 974+ 61FD 3E 04            ld   a, 4
 975+ 61FF 93               sub  e                 ; A = 4 - E (0..3)
 976+ 6200 85               add  a, l              ; A = Col group * 4 + (4 - E)
 977+ 6201 6F               ld   l, a              ; L = Col
 978+ 6202
 979+ 6202 44               ld   b, h
 980+ 6203 4D               ld   c, l
 981+ 6204 CD 6A 61         call DrawTile
 982+ 6207
 983+ 6207 C1               pop  bc
 984+ 6208 D1               pop  de
 985+ 6209 1D               dec  e
 986+ 620A C2 C3 61         jp   nz, .cell_loop
 987+ 620D
 988+ 620D 0C               inc  c
 989+ 620E 79               ld   a, c
 990+ 620F FE 08            cp   8
 991+ 6211 C2 B0 61         jp   nz, .col_byte_loop
 992+ 6214
 993+ 6214 04               inc  b
 994+ 6215 78               ld   a, b
 995+ 6216 FE 10            cp   16
 996+ 6218 C2 AE 61         jp   nz, .row_loop
 997+ 621B
 998+ 621B DD E1            pop  ix
 999+ 621D E1               pop  hl
1000+ 621E D1               pop  de
1001+ 621F C1               pop  bc
1002+ 6220 C9               ret
