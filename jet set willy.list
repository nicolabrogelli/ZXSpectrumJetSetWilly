  91  89A8 ED 5B 5E F7      ld   de, (last_frame_counter)
  92  89AC B7               or   a
  93  89AD ED 52            sbc  hl, de
  94  89AF 7D               ld   a, l
  95  89B0 FE 02            cp   2
  96  89B2 38 F0            jr   c, .sync_loop
  97  89B4
  98  89B4 2A 5B F7         ld   hl, (counter)
  99  89B7 22 5E F7         ld   (last_frame_counter), hl
 100  89BA
 101  89BA                  ; Aggiorna il timer di sicurezza (invulnerabilità post-morte)
 102  89BA 3A 44 FB         ld   a, (willy_safety_timer)
 103  89BD B7               or   a
 104  89BE 28 04            jr   z, .no_safety_dec
 105  89C0 3D               dec  a
 106  89C1 32 44 FB         ld   (willy_safety_timer), a
