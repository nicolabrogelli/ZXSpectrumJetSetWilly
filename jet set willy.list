   5+ 5DDB              ; -------------------------------------------------------------------
   6+ 5DDB              ; Copia il set dei caratteri dalla ROM alla RAM
   7+ 5DDB              ; -------------------------------------------------------------------
   8+ 5DDB              Gfx_CopyChars:
   9+ 5DDB 21 00 3D         ld hl, $3D00  ; Indirizzo del set di caratteri originale in ROM (ASCII 32)
  10+ 5DDE 11 00 81         ld de, $8100  ; Indirizzo in RAM per ASCII 32..127 ($8000 + 32*8)
  11+ 5DE1 01 00 03         ld bc, 768    ; Numero di byte da copiare (96 caratteri * 8 byte ciascuno)
  12+ 5DE4 ED B0            ldir          ; Copiare i dati
  13+ 5DE6 C9               ret
  14+ 5DE7
  15+ 5DE7              ; -------------------------------------------------------------------
  16+ 5DE7              ; Ridefinisci i caratteri (incluso quello per i bordi)
  17+ 5DE7              ; -------------------------------------------------------------------
  18+ 5DE7              Gfx_DefineChars:
  19+ 5DE7 21 EC B2         ld hl, Willy             ; Indirizzo dei dati del nuovo carattere
  20+ 5DEA 11 08 80         ld de, $8008             ; Indirizzo di ASCII 1 nel nuovo set di caratteri ($8000 + 1*8)
  21+ 5DED 01 48 00         ld bc, 72                ; Numero di byte da copiare (9 caratteri * 8 byte)
  22+ 5DF0 ED B0            ldir                        ; Effettua la copia dei caratteri
  23+ 5DF2 21 00 80         ld hl, $8000                ; Indirizzo del nuovo set di caratteri in RAM (font base ASCII 0)
  24+ 5DF5 22 36 5C         ld ($5C36), hl              ; Aggiornare la variabile di sistema CHARS
  25+ 5DF8 C9               ret
  26+ 5DF9
  27+ 5DF9              ; -------------------------------------------------------------------
  28+ 5DF9              ; Posiziona il cursore
  29+ 5DF9              ; Input: B = Y, C = X
  30+ 5DF9              ; -------------------------------------------------------------------
  31+ 5DF9              Gfx_At:
  32+ 5DF9 C5               push bc
  33+ 5DFA D9               exx
  34+ 5DFB C1               pop bc
  35+ 5DFC CD 23 0A         call $0a23
  36+ 5DFF D9               exx
  37+ 5E00 C9               ret
  38+ 5E01
  39+ 5E01              ; -------------------------------------------------------------------
  40+ 5E01              ; Cambia colore inchiostro
  41+ 5E01              ; Input: A = colore
  42+ 5E01              ; -------------------------------------------------------------------
  43+ 5E01              Gfx_Ink:
  44+ 5E01 D9               exx
  45+ 5E02 E6 07            and  $07               ; Garantisci colore 0..7
  46+ 5E04 47               ld   b, a
  47+ 5E05 3A 8F 5C         ld   a, (ATTR_T)
  48+ 5E08 E6 F8            and  $f8
  49+ 5E0A B0               or   b
  50+ 5E0B 32 8F 5C         ld   (ATTR_T), a
  51+ 5E0E D9               exx
  52+ 5E0F C9               ret
  53+ 5E10
  54+ 5E10              ; -------------------------------------------------------------------
  55+ 5E10              ; ===================================================================
  56+ 5E10              ; NUOVE ROUTINE DI RENDERING PIXEL-BY-PIXEL
  57+ 5E10              ; ===================================================================
  58+ 5E10
  59+ 5E10              ; -------------------------------------------------------------------
  60+ 5E10              ; Calcola indirizzo schermo da coordinate pixel (X, Y)
  61+ 5E10              ; Input: H = Y (0..191), L = X (0..255)
  62+ 5E10              ; Output: HL = indirizzo schermo
  63+ 5E10              ; -------------------------------------------------------------------
  64+ 5E10              Gfx_GetScreenAddr:
  65+ 5E10 7C               ld a, h
  66+ 5E11 E6 07            and %00000111     ; A = y2 y1 y0 (scanline offset)
  67+ 5E13 F6 40            or  %01000000     ; Base dello schermo ($40)
  68+ 5E15 57               ld  d, a          ; D = high byte parziale
  69+ 5E16
  70+ 5E16 7C               ld  a, h
  71+ 5E17 E6 C0            and %11000000     ; A = y7 y6 000000 (third select)
  72+ 5E19 0F               rrca
  73+ 5E1A 0F               rrca
  74+ 5E1B 0F               rrca              ; Shift a destra di 3 -> 000 y7 y6 000
  75+ 5E1C B2               or  d
  76+ 5E1D 57               ld  d, a          ; D = high byte completo (010 y7 y6 y2 y1 y0)
  77+ 5E1E
  78+ 5E1E 7C               ld  a, h
  79+ 5E1F E6 38            and %00111000     ; A = 00 y5 y4 y3 000 (character row)
  80+ 5E21 87               add a, a
  81+ 5E22 87               add a, a          ; Shift a sinistra di 2 -> y5 y4 y3 00000
  82+ 5E23 5F               ld  e, a          ; E = low byte parziale
  83+ 5E24
  84+ 5E24 7D               ld  a, l
  85+ 5E25 CB 3F            srl a
  86+ 5E27 CB 3F            srl a
  87+ 5E29 CB 3F            srl a              ; A = X / 8 (colonna)
  88+ 5E2B B3               or  e
  89+ 5E2C 5F               ld  e, a          ; E = low byte completo
  90+ 5E2D
  91+ 5E2D 62               ld  h, d
  92+ 5E2E 6B               ld  l, e          ; HL = indirizzo finale
  93+ 5E2F C9               ret
  94+ 5E30
  95+ 5E30              ; -------------------------------------------------------------------
  96+ 5E30              ; Incrementa indirizzo schermo alla riga (scanline) successiva
  97+ 5E30              ; Input/Output: HL = indirizzo schermo
  98+ 5E30              ; -------------------------------------------------------------------
  99+ 5E30              Gfx_IncScreenLine:
 100+ 5E30 24               inc h             ; Vai alla riga successiva
 101+ 5E31 7C               ld  a, h
 102+ 5E32 E6 07            and 7             ; Controlla se la scanline è tornata a 0 (wrap)
 103+ 5E34 C0               ret nz            ; Se non è 0, abbiamo finito!
 104+ 5E35
 105+ 5E35 7D               ld  a, l
 106+ 5E36 C6 20            add a, 32         ; Altrimenti passa alla riga di caratteri successiva
 107+ 5E38 6F               ld  l, a
 108+ 5E39 D8               ret c             ; Se c'è carry, abbiamo cambiato terzo e H è già corretto!
 109+ 5E3A
 110+ 5E3A                  ; Se non c'è carry, rimaniamo nello stesso terzo. Ripristina il terzo corretto in H.
 111+ 5E3A 7C               ld  a, h
 112+ 5E3B D6 08            sub 8
 113+ 5E3D 67               ld  h, a
 114+ 5E3E C9               ret
 115+ 5E3F
 116+ 5E3F              ; -------------------------------------------------------------------
 117+ 5E3F              ; Disegna uno sprite 8x8 a coordinate pixel (X, Y)
 118+ 5E3F              ; Input: C = X, B = Y, IX = puntatore dati sprite (8 byte)
 119+ 5E3F              ; -------------------------------------------------------------------
 120+ 5E3F              Gfx_DrawPixelSprite8x8:
 121+ 5E3F C5               push bc
 122+ 5E40 D5               push de
 123+ 5E41 E5               push hl
 124+ 5E42 DD E5            push ix
 125+ 5E44
 126+ 5E44                  ; 1. Calcola indirizzo schermo
 127+ 5E44 60               ld   h, b
 128+ 5E45 69               ld   l, c
 129+ 5E46 CD 10 5E         call Gfx_GetScreenAddr ; HL = indirizzo schermo
 130+ 5E49
 131+ 5E49                  ; 2. Calcola offset shift = X & 7
 132+ 5E49 79               ld   a, c
 133+ 5E4A E6 07            and  7
 134+ 5E4C 47               ld   b, a          ; B = shift offset (0..7)
 135+ 5E4D
 136+ 5E4D 0E 08            ld   c, 8          ; 8 linee
 137+ 5E4F              .line_loop:
 138+ 5E4F DD 7E 00         ld   a, (ix+0)     ; A = byte dello sprite
 139+ 5E52 57               ld   d, a
 140+ 5E53 1E 00            ld   e, 0
 141+ 5E55
 142+ 5E55 78               ld   a, b          ; Shift se necessario
 143+ 5E56 B7               or   a
 144+ 5E57 28 07            jr   z, .no_shift
 145+ 5E59
 146+ 5E59              .shift_loop:
 147+ 5E59 CB 3A            srl  d
 148+ 5E5B CB 1B            rr   e
 149+ 5E5D 3D               dec  a
 150+ 5E5E 20 F9            jr   nz, .shift_loop
 151+ 5E60
 152+ 5E60              .no_shift:
 153+ 5E60                  ; Scrivi sullo schermo (OR trasparente)
 154+ 5E60 7A               ld   a, d
 155+ 5E61 B6               or   (hl)
 156+ 5E62 77               ld   (hl), a
 157+ 5E63 23               inc  hl
 158+ 5E64 7B               ld   a, e
 159+ 5E65 B6               or   (hl)
 160+ 5E66 77               ld   (hl), a
 161+ 5E67 2B               dec  hl            ; Ritorna alla colonna iniziale
 162+ 5E68
 163+ 5E68 CD 30 5E         call Gfx_IncScreenLine ; Prossima scanline sullo schermo
 164+ 5E6B DD 23            inc  ix            ; Prossimo byte dello sprite
 165+ 5E6D 0D               dec  c
 166+ 5E6E 20 DF            jr   nz, .line_loop
 167+ 5E70
 168+ 5E70 DD E1            pop  ix
 169+ 5E72 E1               pop  hl
 170+ 5E73 D1               pop  de
 171+ 5E74 C1               pop  bc
 172+ 5E75 C9               ret
 173+ 5E76
 174+ 5E76              ; -------------------------------------------------------------------
 175+ 5E76              ; Ripristina un byte dello sfondo statico.
 176+ 5E76              ; Input: A = X del byte schermo in pixel (0, 8, 16...), D = Y pixel
 177+ 5E76              ; Output: A = byte di sfondo
 178+ 5E76              ; ---------------------------------------------------------------
 179+ 5E76              Gfx_GetBackgroundByte:
 180+ 5E76 E5               push hl
 181+ 5E77 D5               push de
 182+ 5E78 C5               push bc
 183+ 5E79
 184+ 5E79 47               ld   b, a              ; B = X (pixel)
 185+ 5E7A
 186+ 5E7A                  ; 1. Controlla se Y (in D) è fuori dalla griglia di layout (Y >= 128)
 187+ 5E7A 7A               ld   a, d
 188+ 5E7B FE 80            cp   128
 189+ 5E7D D2 45 5F         jp   nc, .blank
 190+ 5E80
 191+ 5E80                  ; Converti Y (in D) e X (in B) a cella
 192+ 5E80 CB 3F            srl  a
 193+ 5E82 CB 3F            srl  a
 194+ 5E84 CB 3F            srl  a                 ; A = layout row r (0..15)
 195+ 5E86 5F               ld   e, a              ; E = r (Row)
 196+ 5E87
 197+ 5E87 78               ld   a, b
 198+ 5E88 CB 3F            srl  a
 199+ 5E8A CB 3F            srl  a
 200+ 5E8C CB 3F            srl  a                 ; A = column c (0..31)
 201+ 5E8E 4F               ld   c, a              ; C = c (Col)
 202+ 5E8F
 203+ 5E8F                  ; --- Controlla se c'è un Item Attivo in questa cella ---
 204+ 5E8F D5               push de
 205+ 5E90 C5               push bc
 206+ 5E91 41               ld   b, c              ; B = Col
 207+ 5E92 4B               ld   c, e              ; C = Row
 208+ 5E93 CD 46 7A         call CheckActiveItemAtCell
 209+ 5E96 30 17            jr   nc, .no_item
 210+ 5E98
 211+ 5E98 C1               pop  bc
 212+ 5E99 D1               pop  de
 213+ 5E9A
 214+ 5E9A 7A               ld   a, d
 215+ 5E9B E6 07            and  7                 ; A = scanline (0..7)
 216+ 5E9D 5F               ld   e, a
 217+ 5E9E 16 00            ld   d, 0              ; DE = scanline offset
 218+ 5EA0 2A 4B 7E         ld   hl, (room_ptr)
 219+ 5EA3 C5               push bc
 220+ 5EA4 01 E3 00         ld   bc, OFFSET_ITEM_GRAPHIC
 221+ 5EA7 09               add  hl, bc
 222+ 5EA8 C1               pop  bc
 223+ 5EA9 19               add  hl, de            ; HL = indirizzo del byte dello sprite
 224+ 5EAA 7E               ld   a, (hl)           ; A = byte dello sprite dell'item
 225+ 5EAB
 226+ 5EAB C1               pop  bc
 227+ 5EAC D1               pop  de
 228+ 5EAD E1               pop  hl
 229+ 5EAE C9               ret
 230+ 5EAF
 231+ 5EAF              .no_item:
 232+ 5EAF C1               pop  bc
 233+ 5EB0 D1               pop  de
 234+ 5EB1
 235+ 5EB1                  ; --- Controlla Conveyor ---
 236+ 5EB1 3A F3 7D         ld   a, (conveyor_len)
 237+ 5EB4 B7               or   a
 238+ 5EB5 CA DD 5E         jp   z, .check_ramp
 239+ 5EB8
 240+ 5EB8 3A F4 7D         ld   a, (conveyor_row)
 241+ 5EBB BB               cp   e
 242+ 5EBC C2 DD 5E         jp   nz, .check_ramp
 243+ 5EBF
 244+ 5EBF 3A F5 7D         ld   a, (conveyor_col)
 245+ 5EC2 B9               cp   c
 246+ 5EC3 CA D7 5E         jp   z, .is_conveyor
 247+ 5EC6 DA CC 5E         jp   c, .c_greater
 248+ 5EC9 C3 DD 5E         jp   .check_ramp
 249+ 5ECC              .c_greater:
 250+ 5ECC 21 F3 7D         ld   hl, conveyor_len
 251+ 5ECF 86               add  a, (hl)
 252+ 5ED0 B9               cp   c
 253+ 5ED1 CA DD 5E         jp   z, .check_ramp
 254+ 5ED4 DA DD 5E         jp   c, .check_ramp
 255+ 5ED7              .is_conveyor:
 256+ 5ED7 21 CD 00         ld   hl, OFFSET_CONVEYOR
 257+ 5EDA C3 30 5F         jp   .load_tile
 258+ 5EDD
 259+ 5EDD              .check_ramp:
 260+ 5EDD 3A F7 7D         ld   a, (ramp_len)
 261+ 5EE0 B7               or   a
 262+ 5EE1 CA 11 5F         jp   z, .normal_grid
 263+ 5EE4
 264+ 5EE4 3A F8 7D         ld   a, (ramp_row)     ; A = RampRowStart
 265+ 5EE7 BB               cp   e                 ; compare with player row E
 266+ 5EE8 DA 11 5F         jp   c, .normal_grid   ; if RampRowStart < E, skip!
 267+ 5EEB
 268+ 5EEB 93               sub  e                 ; A = RampRowStart - E
 269+ 5EEC 47               ld   b, a              ; B = distance from start row (0..ramp_len-1)
 270+ 5EED 3A F7 7D         ld   a, (ramp_len)
 271+ 5EF0 B8               cp   b
 272+ 5EF1 CA 11 5F         jp   z, .normal_grid   ; if B == ramp_len, too high!
 273+ 5EF4 DA 11 5F         jp   c, .normal_grid   ; if B > ramp_len, too high!
 274+ 5EF7
 275+ 5EF7                  ; Calcola ExpectedCol:
 276+ 5EF7 3A F6 7D         ld   a, (ramp_dir)
 277+ 5EFA B7               or   a
 278+ 5EFB 28 06            jr   z, .r_left
 279+ 5EFD              .r_right:
 280+ 5EFD 3A F9 7D         ld   a, (ramp_col)
 281+ 5F00 80               add  a, b              ; A = ramp_col + B
 282+ 5F01 18 04            jr   .compare_col
 283+ 5F03              .r_left:
 284+ 5F03 3A F9 7D         ld   a, (ramp_col)
 285+ 5F06 90               sub  b                 ; A = ramp_col - B
