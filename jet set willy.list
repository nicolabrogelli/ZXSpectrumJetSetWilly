1080+ 6F7D 47               ld   b, a              ; B = limit_left
1081+ 6F7E
1082+ 6F7E 3A 54 E9         ld   a, (ramp_col)
1083+ 6F81 3C               inc  a
1084+ 6F82 4F               ld   c, a              ; C = limit_right (exclusive)
1085+ 6F83
1086+ 6F83 7B               ld   a, e              ; A = Col
1087+ 6F84 B8               cp   b
1088+ 6F85 38 15            jr   c, .check_platform_case
1089+ 6F87 B9               cp   c
1090+ 6F88 30 12            jr   nc, .check_platform_case
