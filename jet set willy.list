1111+ 6BB4              ; -------------------------------------------------------------------
1112+ 6BB4              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1113+ 6BB4              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1114+ 6BB4              ; -------------------------------------------------------------------
1115+ 6BB4              UnpackRoomLayout:
1116+ 6BB4 E5               push hl
1117+ 6BB5 D5               push de
1118+ 6BB6 C5               push bc
1119+ 6BB7
1120+ 6BB7 2A 64 7C         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1121+ 6BBA 11 0A 7A         ld   de, unpacked_layout ; DE = buffer RAM
1122+ 6BBD 06 80            ld   b, 128             ; 128 byte
1123+ 6BBF              .byte_loop:
1124+ 6BBF 7E               ld   a, (hl)            ; Leggi byte compresso
1125+ 6BC0 23               inc  hl
1126+ 6BC1
1127+ 6BC1 4F               ld   c, a               ; C = salvataggio
1128+ 6BC2
1129+ 6BC2                  ; Cella 0: bit 7-6
1130+ 6BC2 07               rlca
1131+ 6BC3 07               rlca
1132+ 6BC4 E6 03            and  3
1133+ 6BC6 12               ld   (de), a
1134+ 6BC7 13               inc  de
1135+ 6BC8
1136+ 6BC8                  ; Cella 1: bit 5-4
1137+ 6BC8 79               ld   a, c
1138+ 6BC9 07               rlca
1139+ 6BCA 07               rlca
1140+ 6BCB 07               rlca
1141+ 6BCC 07               rlca
1142+ 6BCD E6 03            and  3
1143+ 6BCF 12               ld   (de), a
1144+ 6BD0 13               inc  de
1145+ 6BD1
1146+ 6BD1                  ; Cella 2: bit 3-2
1147+ 6BD1 79               ld   a, c
1148+ 6BD2 0F               rrca
1149+ 6BD3 0F               rrca
1150+ 6BD4 E6 03            and  3
1151+ 6BD6 12               ld   (de), a
1152+ 6BD7 13               inc  de
1153+ 6BD8
1154+ 6BD8                  ; Cella 3: bit 1-0
