 180+ 76EF              ; -------------------------------------------------------------------
 181+ 76EF              ; DetermineCurrentRoomID
 182+ 76EF              ;
 183+ 76EF              ; Determina l'ID numerico della stanza corrente confrontando
 184+ 76EF              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 185+ 76EF              ;
 186+ 76EF              ; Se viene trovata una corrispondenza:
 187+ 76EF              ;   A = ID della stanza
 188+ 76EF              ;   current_room = A
 189+ 76EF              ;
 190+ 76EF              ; Mappatura:
 191+ 76EF              ;    0 = The Off Licence
 192+ 76EF              ;    1 = The Bridge
 193+ 76EF              ;    2 = Under The Mega Tree
 194+ 76EF              ;    3 = Gfx_At The Foot Of The Mega Tree
 195+ 76EF              ;    4 = The Drive
 196+ 76EF              ;    5 = The Security Guard
 197+ 76EF              ;    6 = Entrance To Hades
 198+ 76EF              ;    7 = Cuckoo's Nest
 199+ 76EF              ;    8 = Inside The Mega Trunk
 200+ 76EF              ;    9 = On A Branch Over The Drive
 201+ 76EF              ;   10 = The Front Door
 202+ 76EF              ;   11 = The Hall
 203+ 76EF              ;   12 = Tree Top
 204+ 76EF              ;   27 = The Chapel
 205+ 76EF              ;   28 = First Landing
 206+ 76EF              ;   29 = The Nightmare Room
 207+ 76EF              ;   33 = The Bathroom
 208+ 76EF              ;   35 = Master Bedroom
 209+ 76EF              ;
 210+ 76EF              ; Se nessuna stanza corrisponde viene impostato:
 211+ 76EF              ;   current_room = 0
 212+ 76EF              ; -------------------------------------------------------------------
 213+ 76EF              DetermineCurrentRoomID:
 214+ 76EF
 215+ 76EF                  ; Salva i registri utilizzati
 216+ 76EF E5               push hl
 217+ 76F0 D5               push de
