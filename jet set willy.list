 407  8A2D 77               ld   (hl), a
 408  8A2E 23               inc  hl
 409  8A2F 10 FC            djnz .color_cycle_loop
 410  8A31
 411  8A31                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 412  8A31 01 FE DF         ld   bc, $dffe
 413  8A34 ED 78            in   a, (c)
 414  8A36 CB 67            bit  4, a
 415  8A38 28 2A            jr   z, .continue_chosen
 416  8A3A
 417  8A3A                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 418  8A3A 01 FE 7F         ld   bc, $7ffe
 419  8A3D ED 78            in   a, (c)
 420  8A3F CB 5F            bit  3, a
