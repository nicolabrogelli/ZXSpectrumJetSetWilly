 256+ 6F97 C6 07            add  a, 7              ; A = PlayerX - EnemyX + 7
 257+ 6F99 FE 17            cp   23                ; Se >= 23, nessuna collisione con questo
 258+ 6F9B 30 13            jr   nc, .next
 259+ 6F9D
 260+ 6F9D                  ; 2. Controllo verticale: PlayerY - EnemyY + 15 in [0, 30]
 261+ 6F9D 3A B4 76         ld   a, (PlayerPos+1)  ; A = PlayerY
 262+ 6FA0 DD 96 02         sub  (ix+2)            ; A = PlayerY - EnemyY
 263+ 6FA3 C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 264+ 6FA5 FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 265+ 6FA7 30 07            jr   nc, .next
