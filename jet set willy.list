  92+ 7B1D 3A A8 FA         ld   a, (game_objective_completed)
  93+ 7B20 B7               or   a
  94+ 7B21 20 07            jr   nz, .disable_master_bedroom_vecchia
  95+ 7B23 3A A0 F6         ld   a, (items_collected)
  96+ 7B26 FE 4D            cp   TOTAL_ITEMS
