1127+ 73AD              ; -------------------------------------------------------------------
1128+ 73AD              ; Items_CheckCollision
1129+ 73AD              ;
1130+ 73AD              ; Controlla se Willy entra in collisione con uno degli item
1131+ 73AD              ; attivi presenti nella stanza corrente.
1132+ 73AD              ;
1133+ 73AD              ; Per ogni item:
1134+ 73AD              ;   - verifica che appartenga alla stanza corrente
1135+ 73AD              ;   - verifica che non sia già stato raccolto
1136+ 73AD              ;   - esegue il test di collisione con Willy
1137+ 73AD              ;
1138+ 73AD              ; Se l'item viene raccolto:
1139+ 73AD              ;   - imposta il flag "collected"
1140+ 73AD              ;   - rimuove l'item dalla cache items_grid
1141+ 73AD              ;   - incrementa il contatore degli oggetti raccolti
1142+ 73AD              ;   - aggiorna l'HUD
1143+ 73AD              ;   - ripristina il tile di sfondo
1144+ 73AD              ;   - riproduce il suono di raccolta
1145+ 73AD              ;
1146+ 73AD              ; Formato record ItemsTable:
1147+ 73AD              ;   +0 RoomID
1148+ 73AD              ;   +1 X
1149+ 73AD              ;   +2 Y
1150+ 73AD              ;   +3 Color
1151+ 73AD              ;   +4 Collected
1152+ 73AD              ;
1153+ 73AD              ; Fine tabella:
1154+ 73AD              ;   RoomID = $FF
1155+ 73AD              ; -------------------------------------------------------------------
1156+ 73AD              Items_CheckCollision:
1157+ 73AD
1158+ 73AD                  ; Salva i registri utilizzati
1159+ 73AD E5               push hl
1160+ 73AE D5               push de
1161+ 73AF C5               push bc
1162+ 73B0
1163+ 73B0                  ; Inizio scansione della tabella degli item
1164+ 73B0 21 8A 70         ld   hl, ItemsTable
1165+ 73B3
1166+ 73B3              .loop:
1167+ 73B3
1168+ 73B3                  ; ---------------------------------------------------------------
1169+ 73B3                  ; Legge il Room ID dell'item corrente
1170+ 73B3                  ; ---------------------------------------------------------------
1171+ 73B3 7E               ld   a, (hl)
1172+ 73B4
1173+ 73B4                  ; $FF indica fine tabella
1174+ 73B4 FE FF            cp   $FF
1175+ 73B6 28 4D            jr   z, .done
1176+ 73B8
1177+ 73B8                  ; ---------------------------------------------------------------
1178+ 73B8                  ; Verifica se l'item appartiene alla stanza corrente
1179+ 73B8                  ; ---------------------------------------------------------------
1180+ 73B8 57               ld   d, a              ; D = RoomID item
1181+ 73B9
1182+ 73B9 3A 5C 78         ld   a, (current_room)
1183+ 73BC BA               cp   d
1184+ 73BD
1185+ 73BD                  ; Se appartiene a un'altra stanza salta il record
1186+ 73BD 20 3F            jr   nz, .next_item
1187+ 73BF
1188+ 73BF                  ; ---------------------------------------------------------------
1189+ 73BF                  ; Legge coordinate e stato dell'item
1190+ 73BF                  ; ---------------------------------------------------------------
1191+ 73BF
1192+ 73BF 23               inc  hl
1193+ 73C0 4E               ld   c, (hl)           ; C = X
1194+ 73C1
1195+ 73C1 23               inc  hl
1196+ 73C2 46               ld   b, (hl)           ; B = Y
1197+ 73C3
1198+ 73C3 23               inc  hl                ; salta Color
1199+ 73C4
1200+ 73C4 23               inc  hl                ; punta a Collected
1201+ 73C5
1202+ 73C5 7E               ld   a, (hl)
1203+ 73C6
1204+ 73C6                  ; ---------------------------------------------------------------
1205+ 73C6                  ; Item già raccolto?
1206+ 73C6                  ; ---------------------------------------------------------------
1207+ 73C6 B7               or   a
1208+ 73C7 20 39            jr   nz, .next_no_inc
1209+ 73C9
1210+ 73C9                  ; ---------------------------------------------------------------
1211+ 73C9                  ; Test collisione Willy ↔ Item
1212+ 73C9                  ;
1213+ 73C9                  ; Input richiesto:
1214+ 73C9                  ;   A = ItemX
1215+ 73C9                  ;   H = ItemY
1216+ 73C9                  ; ---------------------------------------------------------------
1217+ 73C9 79               ld   a, c
1218+ 73CA
1219+ 73CA E5               push hl                ; salva puntatore al flag Collected
1220+ 73CB
1221+ 73CB 60               ld   h, b
1222+ 73CC
1223+ 73CC CD 67 73         call CheckWillyItemCollision
1224+ 73CF
1225+ 73CF E1               pop  hl
1226+ 73D0
1227+ 73D0                  ; Nessuna collisione
1228+ 73D0 30 30            jr   nc, .next_no_inc
1229+ 73D2
1230+ 73D2                  ; ===============================================================
1231+ 73D2                  ; ITEM RACCOLTO
1232+ 73D2                  ; ===============================================================
1233+ 73D2
1234+ 73D2                  ; ---------------------------------------------------------------
1235+ 73D2                  ; Marca l'item come raccolto
1236+ 73D2                  ; ---------------------------------------------------------------
1237+ 73D2 36 01            ld   (hl), 1
1238+ 73D4
1239+ 73D4                  ; ---------------------------------------------------------------
1240+ 73D4                  ; Rimuove l'item dalla cache items_grid
1241+ 73D4                  ;
1242+ 73D4                  ; Calcolo:
1243+ 73D4                  ;   offset = Row * 32 + Col
1244+ 73D4                  ; ---------------------------------------------------------------
1245+ 73D4 E5               push hl
1246+ 73D5 D5               push de
1247+ 73D6
1248+ 73D6 26 00            ld   h, 0
1249+ 73D8 68               ld   l, b              ; HL = Row
1250+ 73D9
1251+ 73D9 29               add  hl, hl            ; *2
1252+ 73DA 29               add  hl, hl            ; *4
1253+ 73DB 29               add  hl, hl            ; *8
1254+ 73DC 29               add  hl, hl            ; *16
1255+ 73DD 29               add  hl, hl            ; *32
1256+ 73DE
1257+ 73DE 59               ld   e, c
1258+ 73DF 16 00            ld   d, 0
1259+ 73E1
1260+ 73E1 19               add  hl, de            ; Row*32 + Col
1261+ 73E2
1262+ 73E2 11 00 B0         ld   de, items_grid
1263+ 73E5 19               add  hl, de
1264+ 73E6
1265+ 73E6                  ; La cella non contiene più un item
1266+ 73E6 36 00            ld   (hl), 0
1267+ 73E8
1268+ 73E8 D1               pop  de
1269+ 73E9 E1               pop  hl
1270+ 73EA
1271+ 73EA                  ; ---------------------------------------------------------------
1272+ 73EA                  ; Conserva il puntatore all'entry corrente
1273+ 73EA                  ; poiché le routine successive possono alterare HL.
1274+ 73EA                  ; ---------------------------------------------------------------
1275+ 73EA E5               push hl
1276+ 73EB
1277+ 73EB                  ; ---------------------------------------------------------------
1278+ 73EB                  ; Aggiorna il numero di oggetti raccolti
1279+ 73EB                  ; ---------------------------------------------------------------
1280+ 73EB 3A 4E 75         ld   a, (items_collected)
1281+ 73EE
1282+ 73EE 3C               inc  a
1283+ 73EF
1284+ 73EF 32 4E 75         ld   (items_collected), a
1285+ 73F2
1286+ 73F2                  ; ---------------------------------------------------------------
1287+ 73F2                  ; Aggiorna il contatore visualizzato a schermo
1288+ 73F2                  ; ---------------------------------------------------------------
1289+ 73F2 CD CB 60         call Gfx_UpdateItemsCollectedDisplay
1290+ 73F5
1291+ 73F5                  ; ---------------------------------------------------------------
1292+ 73F5                  ; Ripristina il tile originale della stanza
1293+ 73F5                  ; eliminando la grafica dell'item.
1294+ 73F5                  ;
1295+ 73F5                  ; Input:
1296+ 73F5                  ;   B = Row
1297+ 73F5                  ;   C = Col
1298+ 73F5                  ; ---------------------------------------------------------------
1299+ 73F5 CD 25 73         call RestoreBackgroundCell
1300+ 73F8
1301+ 73F8                  ; ---------------------------------------------------------------
1302+ 73F8                  ; Riproduce il suono di raccolta
1303+ 73F8                  ; ---------------------------------------------------------------
1304+ 73F8 CD 23 75         call Audio_PlayCollectSound
1305+ 73FB
1306+ 73FB                  ; Ripristina il puntatore alla tabella
1307+ 73FB E1               pop  hl
1308+ 73FC
1309+ 73FC                  ; Continua con il record successivo
1310+ 73FC 18 04            jr   .next_no_inc
1311+ 73FE
1312+ 73FE              .next_item:
1313+ 73FE
1314+ 73FE                  ; ---------------------------------------------------------------
1315+ 73FE                  ; Salta i campi del record:
1316+ 73FE                  ;   X
1317+ 73FE                  ;   Y
1318+ 73FE                  ;   Color
1319+ 73FE                  ;   Collected
1320+ 73FE                  ; ---------------------------------------------------------------
1321+ 73FE 23               inc  hl
1322+ 73FF 23               inc  hl
1323+ 7400 23               inc  hl
1324+ 7401 23               inc  hl
1325+ 7402
1326+ 7402              .next_no_inc:
1327+ 7402
