 771+ 7DAA                  ; Calcola il frame dell'animazione: Anim State * 32
 772+ 7DAA DD 7E 07         ld   a, (ix+7)         ; Anim State (0..3) (Offset 7)
 773+ 7DAD 87               add  a, a              ; *2
 774+ 7DAE 87               add  a, a              ; *4
 775+ 7DAF 87               add  a, a              ; *8
 776+ 7DB0 87               add  a, a              ; *16
 777+ 7DB1 87               add  a, a              ; *32
 778+ 7DB2 5F               ld   e, a
