1325+ 8472              ; -------------------------------------------------------------------
1326+ 8472              ; DrawItemGraphic
1327+ 8472              ;
1328+ 8472              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1329+ 8472              ; utilizzando una bitmap di 8 byte e un attributo colore.
1330+ 8472              ;
1331+ 8472              ; Input:
1332+ 8472              ;   B = Riga attributi (3..18)
1333+ 8472              ;   C = Colonna attributi (0..31)
1334+ 8472              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1335+ 8472              ;   E = Attributo colore
1336+ 8472              ;
1337+ 8472              ; Output:
1338+ 8472              ;   Nessuno
1339+ 8472              ;
1340+ 8472              ; Registri preservati:
1341+ 8472              ;   BC, DE, HL
1342+ 8472              ; -------------------------------------------------------------------
1343+ 8472              DrawItemGraphic:
1344+ 8472
1345+ 8472                  ; Salva i registri originali
1346+ 8472 C5               push bc
1347+ 8473 D5               push de
1348+ 8474 E5               push hl
1349+ 8475
1350+ 8475                  ; ---------------------------------------------------------------
1351+ 8475                  ; Calcolo indirizzo bitmap dello Spectrum
1352+ 8475                  ;
1353+ 8475                  ; Ogni item occupa una cella attributi (8x8 pixel).
1354+ 8475                  ;
1355+ 8475                  ; Formula:
1356+ 8475                  ;   High = $40 + (Row AND $18)
1357+ 8475                  ;   Low  = (Row AND 7) * 32 + Col
1358+ 8475                  ;
1359+ 8475                  ; DE conterrà l'indirizzo della prima scanline.
1360+ 8475                  ; ---------------------------------------------------------------
1361+ 8475
1362+ 8475 78               ld   a, b
1363+ 8476 E6 18            and  $18
1364+ 8478 C6 40            add  a, $40
1365+ 847A 57               ld   d, a              ; Byte alto indirizzo video
1366+ 847B
1367+ 847B 78               ld   a, b
1368+ 847C E6 07            and  7                 ; Riga interna al blocco da 8
1369+ 847E
1370+ 847E 87               add  a, a              ; *2
1371+ 847F 87               add  a, a              ; *4
1372+ 8480 87               add  a, a              ; *8
1373+ 8481 87               add  a, a              ; *16
1374+ 8482 87               add  a, a              ; *32
1375+ 8483
1376+ 8483 81               add  a, c              ; + colonna
1377+ 8484
1378+ 8484 5F               ld   e, a              ; Byte basso indirizzo video
1379+ 8485
1380+ 8485                  ; ---------------------------------------------------------------
1381+ 8485                  ; Disegno bitmap
1382+ 8485                  ;
1383+ 8485                  ; Copia 8 byte consecutivi nella memoria video.
1384+ 8485                  ; Ogni byte rappresenta una scanline da 8 pixel.
1385+ 8485                  ; ---------------------------------------------------------------
1386+ 8485
1387+ 8485 C5               push bc                ; Conserva Row e Col
1388+ 8486
1389+ 8486 06 08            ld   b, 8              ; Numero scanline
1390+ 8488
1391+ 8488              .line_loop:
1392+ 8488
1393+ 8488 7E               ld   a, (hl)           ; Legge scanline bitmap
1394+ 8489 12               ld   (de), a           ; Scrive nella memoria video
1395+ 848A
1396+ 848A 14               inc  d                 ; Scanline successiva
1397+ 848B 23               inc  hl                ; Byte bitmap successivo
1398+ 848C
1399+ 848C 05               dec  b
1400+ 848D 20 F9            jr   nz, .line_loop
1401+ 848F
1402+ 848F C1               pop  bc                ; Ripristina Row e Col
1403+ 8490
1404+ 8490                  ; ---------------------------------------------------------------
1405+ 8490                  ; Calcolo indirizzo attributo
1406+ 8490                  ;
1407+ 8490                  ; Formula:
1408+ 8490                  ;   AttrAddr = $5800 + Row * 32 + Col
1409+ 8490                  ;
1410+ 8490                  ; HL conterrà l'indirizzo della cella attributi.
1411+ 8490                  ; ---------------------------------------------------------------
1412+ 8490
1413+ 8490 26 00            ld   h, 0
1414+ 8492 68               ld   l, b              ; HL = Row
1415+ 8493
1416+ 8493 29               add  hl, hl            ; *2
1417+ 8494 29               add  hl, hl            ; *4
1418+ 8495 29               add  hl, hl            ; *8
1419+ 8496 29               add  hl, hl            ; *16
1420+ 8497 29               add  hl, hl            ; *32
1421+ 8498
1422+ 8498 79               ld   a, c              ; A = Colonna
1423+ 8499
1424+ 8499 85               add  a, l
1425+ 849A 6F               ld   l, a
1426+ 849B
1427+ 849B 30 01            jr   nc, .no_carry
1428+ 849D 24               inc  h
1429+ 849E
1430+ 849E              .no_carry:
1431+ 849E
1432+ 849E                  ; HL = Row * 32 + Col
1433+ 849E
1434+ 849E 11 00 58         ld   de, $5800
1435+ 84A1 19               add  hl, de            ; HL = indirizzo attributi
1436+ 84A2
1437+ 84A2                  ; ---------------------------------------------------------------
1438+ 84A2                  ; Recupera il colore originale dallo stack.
1439+ 84A2                  ;
1440+ 84A2                  ; Layout stack:
1441+ 84A2                  ;   HL originale
1442+ 84A2                  ;   DE originale (E = colore)
1443+ 84A2                  ;   BC originale
1444+ 84A2                  ; ---------------------------------------------------------------
1445+ 84A2
1446+ 84A2 C1               pop  bc                ; Recupera HL originale
1447+ 84A3 D1               pop  de                ; Recupera DE originale
1448+ 84A4
1449+ 84A4                  ; ---------------------------------------------------------------
1450+ 84A4                  ; Scrive l'attributo colore
1451+ 84A4                  ; ---------------------------------------------------------------
1452+ 84A4
1453+ 84A4 7B               ld   a, e              ; A = colore
1454+ 84A5 77               ld   (hl), a           ; Scrive nella RAM attributi
1455+ 84A6
1456+ 84A6                  ; ---------------------------------------------------------------
1457+ 84A6                  ; Ripristina HL e BC originali
1458+ 84A6                  ; ---------------------------------------------------------------
1459+ 84A6
1460+ 84A6 C5               push bc
1461+ 84A7 E1               pop  hl                ; HL originale
1462+ 84A8
1463+ 84A8 C1               pop  bc                ; BC originale
1464+ 84A9
1465+ 84A9 C9               ret
1466+ 84AA
1467+ 84AA              ; -------------------------------------------------------------------
1468+ 84AA              ; RestoreBackgroundCell
1469+ 84AA              ;
1470+ 84AA              ; Ripristina il contenuto originale di una cella della stanza.
1471+ 84AA              ; Viene utilizzata principalmente quando un item viene raccolto:
1472+ 84AA              ; invece di lasciare un "buco", la routine ridisegna il tile
1473+ 84AA              ; originale presente nella mappa della stanza.
1474+ 84AA              ;
1475+ 84AA              ; Input:
1476+ 84AA              ;   B = Row (3..18)
1477+ 84AA              ;   C = Col (0..31)
1478+ 84AA              ;
1479+ 84AA              ; Utilizza:
1480+ 84AA              ;   room_ptr -> struttura dati della stanza corrente
1481+ 84AA              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1482+ 84AA              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1483+ 84AA              ;
1484+ 84AA              ; Tipi di cella:
1485+ 84AA              ;   0 = Background
1486+ 84AA              ;   1 = Floor
1487+ 84AA              ;   2 = Wall
1488+ 84AA              ;   3 = Nasty
1489+ 84AA              ; -------------------------------------------------------------------
1490+ 84AA              RestoreBackgroundCell:
1491+ 84AA
1492+ 84AA                  ; Salva tutti i registri utilizzati
1493+ 84AA FD E5            push iy
1494+ 84AC C5               push bc
1495+ 84AD D5               push de
1496+ 84AE E5               push hl
1497+ 84AF DD E5            push ix
1498+ 84B1
1499+ 84B1                  ; ---------------------------------------------------------------
1500+ 84B1                  ; Conserva Row e Col in IY.
1501+ 84B1                  ;
1502+ 84B1                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1503+ 84B1                  ; BC potrebbe essere modificato.
1504+ 84B1                  ; ---------------------------------------------------------------
1505+ 84B1 C5               push bc
1506+ 84B2 FD E1            pop  iy                ; IYH = Row, IYL = Col
1507+ 84B4
1508+ 84B4                  ; ---------------------------------------------------------------
1509+ 84B4                  ; Determina quale tipo di cella è presente nella posizione
1510+ 84B4                  ; specificata.
1511+ 84B4                  ;
1512+ 84B4                  ; Input:
1513+ 84B4                  ;   B = Row
1514+ 84B4                  ;   C = Col
1515+ 84B4                  ;
1516+ 84B4                  ; Output:
1517+ 84B4                  ;   A = tipo cella
1518+ 84B4                  ; ---------------------------------------------------------------
1519+ 84B4 78               ld   a, b
1520+ 84B5
1521+ 84B5 CD 7C 75         call GetCellFromUnpacked
1522+ 84B8
1523+ 84B8                  ; ---------------------------------------------------------------
1524+ 84B8                  ; Recupera il puntatore alla stanza corrente.
1525+ 84B8                  ;
1526+ 84B8                  ; DE = base della struttura stanza
1527+ 84B8                  ; ---------------------------------------------------------------
1528+ 84B8 ED 5B 6A EE      ld   de, (room_ptr)
1529+ 84BC
1530+ 84BC                  ; ---------------------------------------------------------------
1531+ 84BC                  ; Seleziona il tile corretto in base al tipo di cella.
1532+ 84BC                  ;
1533+ 84BC                  ; A = 0 -> Background
1534+ 84BC                  ; A = 1 -> Floor
1535+ 84BC                  ; A = 2 -> Wall
1536+ 84BC                  ; A = 3 -> Nasty
1537+ 84BC                  ; ---------------------------------------------------------------
1538+ 84BC
1539+ 84BC B7               or   a
1540+ 84BD 20 06            jr   nz, .not_bg
1541+ 84BF
1542+ 84BF                  ; Background
1543+ 84BF 21 A0 00         ld   hl, OFFSET_BG
1544+ 84C2 19               add  hl, de
1545+ 84C3 18 16            jr   .draw_cell
1546+ 84C5
1547+ 84C5              .not_bg:
1548+ 84C5
1549+ 84C5 3D               dec  a
1550+ 84C6 20 06            jr   nz, .not_floor
1551+ 84C8
1552+ 84C8                  ; Floor
1553+ 84C8 21 A9 00         ld   hl, OFFSET_FLOOR
1554+ 84CB 19               add  hl, de
1555+ 84CC 18 0D            jr   .draw_cell
1556+ 84CE
1557+ 84CE              .not_floor:
1558+ 84CE
1559+ 84CE 3D               dec  a
1560+ 84CF 20 06            jr   nz, .not_wall
1561+ 84D1
1562+ 84D1                  ; Wall
1563+ 84D1 21 B2 00         ld   hl, OFFSET_WALL
1564+ 84D4 19               add  hl, de
1565+ 84D5 18 04            jr   .draw_cell
1566+ 84D7
1567+ 84D7              .not_wall:
1568+ 84D7
1569+ 84D7                  ; Nasty
1570+ 84D7 21 BB 00         ld   hl, OFFSET_NASTY
1571+ 84DA 19               add  hl, de
1572+ 84DB
1573+ 84DB              .draw_cell:
1574+ 84DB
1575+ 84DB                  ; ---------------------------------------------------------------
1576+ 84DB                  ; HL punta ora alla grafica del tile da ridisegnare.
1577+ 84DB                  ;
1578+ 84DB                  ; Gfx_DrawTile si aspetta:
1579+ 84DB                  ;   IX = puntatore tile
1580+ 84DB                  ;   B  = Row
1581+ 84DB                  ;   C  = Col
1582+ 84DB                  ; ---------------------------------------------------------------
1583+ 84DB E5               push hl
1584+ 84DC DD E1            pop  ix
1585+ 84DE
1586+ 84DE                  ; Ripristina Row e Col salvati in IY
1587+ 84DE FD E5            push iy
1588+ 84E0 C1               pop  bc
1589+ 84E1
1590+ 84E1                  ; Disegna il tile originale
1591+ 84E1 CD 4B 68         call Gfx_DrawTile
1592+ 84E4
1593+ 84E4                  ; ---------------------------------------------------------------
1594+ 84E4                  ; Ripristina i registri salvati
1595+ 84E4                  ; ---------------------------------------------------------------
1596+ 84E4 DD E1            pop  ix
1597+ 84E6 E1               pop  hl
1598+ 84E7 D1               pop  de
1599+ 84E8 C1               pop  bc
1600+ 84E9 FD E1            pop  iy
1601+ 84EB
1602+ 84EB C9               ret
1603+ 84EC
1604+ 84EC              ; -------------------------------------------------------------------
1605+ 84EC              ; CheckWillyItemCollision
1606+ 84EC              ;
1607+ 84EC              ; Verifica se Willy collide con un item utilizzando il controllo
1608+ 84EC              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1609+ 84EC              ;
1610+ 84EC              ; Input:
1611+ 84EC              ;   A = ItemX (colonna attributi 0..31)
1612+ 84EC              ;   H = ItemY (riga attributi 3..18)
1613+ 84EC              ;
1614+ 84EC              ; Coordinate item:
1615+ 84EC              ;   Ogni item occupa una cella da 8x8 pixel.
1616+ 84EC              ;
1617+ 84EC              ; Coordinate Willy:
1618+ 84EC              ;   Willy occupa un rettangolo di 16x16 pixel.
1619+ 84EC              ;
1620+ 84EC              ; Output:
1621+ 84EC              ;   Carry Set   = collisione rilevata
1622+ 84EC              ;   Carry Clear = nessuna collisione
1623+ 84EC              ;
1624+ 84EC              ; Registri preservati:
1625+ 84EC              ;   BC, DE, HL
1626+ 84EC              ; -------------------------------------------------------------------
1627+ 84EC              CheckWillyItemCollision:
1628+ 84EC
1629+ 84EC                  ; Salva i registri utilizzati
1630+ 84EC C5               push bc
1631+ 84ED D5               push de
1632+ 84EE E5               push hl
1633+ 84EF
1634+ 84EF                  ; ---------------------------------------------------------------
1635+ 84EF                  ; Calcola il bounding box orizzontale dell'item
1636+ 84EF                  ;
1637+ 84EF                  ; ItemLeft  = ItemX * 8
1638+ 84EF                  ; ItemRight = ItemLeft + 7
1639+ 84EF                  ;
1640+ 84EF                  ; E = ItemLeft
1641+ 84EF                  ; D = ItemRight
1642+ 84EF                  ; ---------------------------------------------------------------
1643+ 84EF 6F               ld   l, a              ; L = ItemX
1644+ 84F0
1645+ 84F0 7D               ld   a, l
1646+ 84F1 87               add  a, a              ; *2
1647+ 84F2 87               add  a, a              ; *4
1648+ 84F3 87               add  a, a              ; *8
1649+ 84F4
1650+ 84F4 5F               ld   e, a              ; E = ItemLeft
1651+ 84F5
1652+ 84F5 C6 07            add  a, 7
1653+ 84F7 57               ld   d, a              ; D = ItemRight
1654+ 84F8
1655+ 84F8                  ; ---------------------------------------------------------------
1656+ 84F8                  ; Recupera la posizione corrente di Willy
1657+ 84F8                  ;
1658+ 84F8                  ; B = WillyY
1659+ 84F8                  ; C = WillyX
1660+ 84F8                  ; ---------------------------------------------------------------
1661+ 84F8 ED 4B EA EA      ld   bc, (PlayerPos)
1662+ 84FC
1663+ 84FC                  ; ---------------------------------------------------------------
1664+ 84FC                  ; Primo test:
1665+ 84FC                  ;
1666+ 84FC                  ; WillyLeft <= ItemRight
1667+ 84FC                  ;
1668+ 84FC                  ; Se Willy è completamente a destra dell'item
1669+ 84FC                  ; non può esserci collisione.
1670+ 84FC                  ; ---------------------------------------------------------------
1671+ 84FC 79               ld   a, c              ; A = WillyLeft
1672+ 84FD
1673+ 84FD BA               cp   d                 ; WillyLeft vs ItemRight
1674+ 84FE
1675+ 84FE 28 04            jr   z, .x_ok
1676+ 8500 38 02            jr   c, .x_ok
1677+ 8502
1678+ 8502 18 29            jr   .no_collision
1679+ 8504
1680+ 8504              .x_ok:
1681+ 8504
1682+ 8504                  ; ---------------------------------------------------------------
1683+ 8504                  ; Secondo test:
1684+ 8504                  ;
1685+ 8504                  ; WillyRight >= ItemLeft
1686+ 8504                  ;
1687+ 8504                  ; WillyRight = WillyX + 7
1688+ 8504                  ; ---------------------------------------------------------------
1689+ 8504 C6 07            add  a, 7
1690+ 8506
1691+ 8506 BB               cp   e                 ; WillyRight vs ItemLeft
1692+ 8507
1693+ 8507 28 04            jr   z, .y_check
1694+ 8509 30 02            jr   nc, .y_check
1695+ 850B
1696+ 850B 18 20            jr   .no_collision
1697+ 850D
1698+ 850D              .y_check:
1699+ 850D
1700+ 850D                  ; ---------------------------------------------------------------
1701+ 850D                  ; Recupera ItemY dal valore originale di HL
1702+ 850D                  ;
1703+ 850D                  ; H contiene la riga dell'item.
1704+ 850D                  ; ---------------------------------------------------------------
1705+ 850D E1               pop  hl
1706+ 850E E5               push hl
1707+ 850F
1708+ 850F                  ; ---------------------------------------------------------------
1709+ 850F                  ; Calcola il bounding box verticale dell'item
1710+ 850F                  ;
1711+ 850F                  ; ItemTop    = ItemY * 8
1712+ 850F                  ; ItemBottom = ItemTop + 7
1713+ 850F                  ;
1714+ 850F                  ; E = ItemTop
1715+ 850F                  ; D = ItemBottom
1716+ 850F                  ; ---------------------------------------------------------------
1717+ 850F 7C               ld   a, h
1718+ 8510
1719+ 8510 87               add  a, a              ; *2
1720+ 8511 87               add  a, a              ; *4
1721+ 8512 87               add  a, a              ; *8
1722+ 8513
1723+ 8513 5F               ld   e, a              ; ItemTop
1724+ 8514
1725+ 8514 C6 07            add  a, 7
1726+ 8516 57               ld   d, a              ; ItemBottom
1727+ 8517
1728+ 8517                  ; ---------------------------------------------------------------
1729+ 8517                  ; Primo test verticale:
1730+ 8517                  ;
1731+ 8517                  ; WillyTop <= ItemBottom
1732+ 8517                  ; ---------------------------------------------------------------
1733+ 8517 78               ld   a, b              ; WillyTop
1734+ 8518
1735+ 8518 BA               cp   d
1736+ 8519
1737+ 8519 28 04            jr   z, .y_ok
1738+ 851B 38 02            jr   c, .y_ok
1739+ 851D
1740+ 851D 18 0E            jr   .no_collision
1741+ 851F
1742+ 851F              .y_ok:
1743+ 851F
1744+ 851F                  ; ---------------------------------------------------------------
1745+ 851F                  ; Secondo test verticale:
1746+ 851F                  ;
1747+ 851F                  ; WillyBottom >= ItemTop
1748+ 851F                  ;
1749+ 851F                  ; WillyBottom = WillyY + 15
1750+ 851F                  ; ---------------------------------------------------------------
1751+ 851F C6 0F            add  a, 15
1752+ 8521
1753+ 8521 BB               cp   e
1754+ 8522
1755+ 8522 28 04            jr   z, .collision
1756+ 8524 30 02            jr   nc, .collision
1757+ 8526
1758+ 8526 18 05            jr   .no_collision
1759+ 8528
1760+ 8528              .collision:
1761+ 8528
1762+ 8528                  ; ---------------------------------------------------------------
1763+ 8528                  ; Collisione rilevata
1764+ 8528                  ; ---------------------------------------------------------------
1765+ 8528 E1               pop  hl
1766+ 8529 D1               pop  de
1767+ 852A C1               pop  bc
1768+ 852B
1769+ 852B 37               scf                    ; Carry = 1
1770+ 852C
1771+ 852C C9               ret
1772+ 852D
1773+ 852D              .no_collision:
1774+ 852D
1775+ 852D                  ; ---------------------------------------------------------------
1776+ 852D                  ; Nessuna collisione
1777+ 852D                  ; ---------------------------------------------------------------
1778+ 852D E1               pop  hl
1779+ 852E D1               pop  de
1780+ 852F C1               pop  bc
1781+ 8530
1782+ 8530 B7               or   a                 ; Carry = 0
1783+ 8531
1784+ 8531 C9               ret
1785+ 8532
1786+ 8532              ; -------------------------------------------------------------------
1787+ 8532              ; Items_CheckCollision
1788+ 8532              ;
1789+ 8532              ; Controlla se Willy entra in collisione con uno degli item
1790+ 8532              ; attivi presenti nella stanza corrente.
1791+ 8532              ;
1792+ 8532              ; Per ogni item:
1793+ 8532              ;   - verifica che appartenga alla stanza corrente
1794+ 8532              ;   - verifica che non sia già stato raccolto
1795+ 8532              ;   - esegue il test di collisione con Willy
1796+ 8532              ;
1797+ 8532              ; Se l'item viene raccolto:
1798+ 8532              ;   - imposta il flag "collected"
1799+ 8532              ;   - rimuove l'item dalla cache items_grid
1800+ 8532              ;   - incrementa il contatore degli oggetti raccolti
1801+ 8532              ;   - aggiorna l'HUD
1802+ 8532              ;   - ripristina il tile di sfondo
1803+ 8532              ;   - riproduce il suono di raccolta
1804+ 8532              ;
1805+ 8532              ; Formato record ItemsTable:
1806+ 8532              ;   +0 RoomID
1807+ 8532              ;   +1 X
1808+ 8532              ;   +2 Y
1809+ 8532              ;   +3 Color
1810+ 8532              ;   +4 Collected
1811+ 8532              ;
1812+ 8532              ; Fine tabella:
1813+ 8532              ;   RoomID = $FF
1814+ 8532              ; -------------------------------------------------------------------
1815+ 8532              Items_CheckCollision:
1816+ 8532
1817+ 8532                  ; Salva i registri utilizzati
1818+ 8532 E5               push hl
1819+ 8533 D5               push de
1820+ 8534 C5               push bc
1821+ 8535
1822+ 8535                  ; Inizio scansione della tabella degli item
1823+ 8535 21 82 7E         ld   hl, ItemsTable
1824+ 8538
1825+ 8538              .loop:
1826+ 8538
1827+ 8538                  ; ---------------------------------------------------------------
1828+ 8538                  ; Legge il Room ID dell'item corrente
1829+ 8538                  ; ---------------------------------------------------------------
1830+ 8538 7E               ld   a, (hl)
1831+ 8539
1832+ 8539                  ; $FF indica fine tabella
1833+ 8539 FE FF            cp   $FF
1834+ 853B 28 58            jr   z, .done
1835+ 853D
1836+ 853D                  ; ---------------------------------------------------------------
1837+ 853D                  ; Verifica se l'item appartiene alla stanza corrente
1838+ 853D                  ; ---------------------------------------------------------------
1839+ 853D 57               ld   d, a              ; D = RoomID item
1840+ 853E
1841+ 853E 3A 10 EE         ld   a, (current_room)
1842+ 8541 BA               cp   d
1843+ 8542
1844+ 8542                  ; Se appartiene a un'altra stanza salta il record
1845+ 8542 20 4A            jr   nz, .next_item
1846+ 8544
1847+ 8544                  ; ---------------------------------------------------------------
1848+ 8544                  ; Legge coordinate e stato dell'item
1849+ 8544                  ; ---------------------------------------------------------------
1850+ 8544
1851+ 8544 23               inc  hl
1852+ 8545 4E               ld   c, (hl)           ; C = X
1853+ 8546
1854+ 8546 23               inc  hl
1855+ 8547 46               ld   b, (hl)           ; B = Y
1856+ 8548
1857+ 8548 23               inc  hl                ; salta Color
1858+ 8549
1859+ 8549 23               inc  hl                ; punta a Collected
1860+ 854A
1861+ 854A 7E               ld   a, (hl)
1862+ 854B
1863+ 854B                  ; ---------------------------------------------------------------
1864+ 854B                  ; Item già raccolto?
1865+ 854B                  ; ---------------------------------------------------------------
1866+ 854B B7               or   a
1867+ 854C 20 44            jr   nz, .next_no_inc
1868+ 854E
1869+ 854E                  ; ---------------------------------------------------------------
1870+ 854E                  ; Test collisione Willy ↔ Item
1871+ 854E                  ;
1872+ 854E                  ; Input richiesto:
1873+ 854E                  ;   A = ItemX
1874+ 854E                  ;   H = ItemY
1875+ 854E                  ; ---------------------------------------------------------------
1876+ 854E 79               ld   a, c
1877+ 854F
1878+ 854F E5               push hl                ; salva puntatore al flag Collected
1879+ 8550
1880+ 8550 60               ld   h, b
1881+ 8551
1882+ 8551 CD EC 84         call CheckWillyItemCollision
1883+ 8554
1884+ 8554 E1               pop  hl
1885+ 8555
1886+ 8555                  ; Nessuna collisione
1887+ 8555 30 3B            jr   nc, .next_no_inc
1888+ 8557
1889+ 8557                  ; ===============================================================
1890+ 8557                  ; ITEM RACCOLTO
1891+ 8557                  ; ===============================================================
1892+ 8557
1893+ 8557                  ; ---------------------------------------------------------------
1894+ 8557                  ; Marca l'item come raccolto
1895+ 8557                  ; ---------------------------------------------------------------
1896+ 8557 36 01            ld   (hl), 1
1897+ 8559
1898+ 8559                  ; ---------------------------------------------------------------
1899+ 8559                  ; Rimuove l'item dalla cache items_grid
1900+ 8559                  ;
1901+ 8559                  ; Calcolo:
1902+ 8559                  ;   offset = Row * 32 + Col
1903+ 8559                  ; ---------------------------------------------------------------
1904+ 8559 E5               push hl
1905+ 855A D5               push de
1906+ 855B
1907+ 855B 26 00            ld   h, 0
1908+ 855D 68               ld   l, b              ; HL = Row
1909+ 855E
1910+ 855E 29               add  hl, hl            ; *2
1911+ 855F 29               add  hl, hl            ; *4
1912+ 8560 29               add  hl, hl            ; *8
1913+ 8561 29               add  hl, hl            ; *16
