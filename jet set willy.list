 927+ 6C17 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 928+ 6C18 47               ld   b, a              ; B = limit_left
 929+ 6C19
 930+ 6C19 3A 03 7E         ld   a, (ramp_col)
 931+ 6C1C 3C               inc  a
 932+ 6C1D 4F               ld   c, a              ; C = limit_right (exclusive)
 933+ 6C1E
 934+ 6C1E 7B               ld   a, e              ; A = Col
 935+ 6C1F B8               cp   b
 936+ 6C20 38 15            jr   c, .check_platform_case
 937+ 6C22 B9               cp   c
 938+ 6C23 30 12            jr   nc, .check_platform_case
 939+ 6C25
 940+ 6C25                  ; Calcola B = ramp_col - Col
 941+ 6C25 3A 03 7E         ld   a, (ramp_col)
 942+ 6C28 93               sub  e
 943+ 6C29 47               ld   b, a              ; B = offset
 944+ 6C2A
 945+ 6C2A                  ; SlopeRow = ramp_row - B
 946+ 6C2A 3A 02 7E         ld   a, (ramp_row)
