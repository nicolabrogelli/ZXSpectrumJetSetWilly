 311  8829 77               ld   (hl), a
 312  882A 23               inc  hl
 313  882B 10 FC            djnz .color_title_loop
 314  882D
 315  882D                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 316  882D 3E BF            ld   a, $bf
 317  882F DB FE            in   a, ($fe)
 318  8831 1F               rra
 319  8832 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 320  8834
