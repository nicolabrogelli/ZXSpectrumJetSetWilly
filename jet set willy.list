 351  8A35              ; -------------------------------------------------------------------
 352  8A35              ; TriggerGameOver
 353  8A35              ; Scatena la schermata di Game Over per la stanza corrente.
 354  8A35              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 355  8A35              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 356  8A35              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 357  8A35              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 358  8A35              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 359  8A35              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 360  8A35              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 361  8A35              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 362  8A35              ; -------------------------------------------------------------------
 363  8A35              TriggerGameOver:
 364  8A35                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 365  8A35 CD FC 64         call Gfx_DrawGameOverScreen
 366  8A38
 367  8A38                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 368  8A38              .wait_keys_release:
 369  8A38 76               halt
 370  8A39                  ; Controlla tasto Y (Porta $DF, bit 4)
 371  8A39 01 FE DF         ld   bc, $dffe
 372  8A3C ED 78            in   a, (c)
 373  8A3E CB 67            bit  4, a
 374  8A40 28 F6            jr   z, .wait_keys_release
 375  8A42
 376  8A42                  ; Controlla tasto N (Porta $7F, bit 3)
 377  8A42 01 FE 7F         ld   bc, $7ffe
 378  8A45 ED 78            in   a, (c)
 379  8A47 CB 5F            bit  3, a
 380  8A49 28 ED            jr   z, .wait_keys_release
 381  8A4B
 382  8A4B                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 383  8A4B 01 FE BF         ld   bc, $bffe
 384  8A4E ED 78            in   a, (c)
 385  8A50 CB 47            bit  0, a
 386  8A52 28 E4            jr   z, .wait_keys_release
 387  8A54
 388  8A54                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 389  8A54 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
