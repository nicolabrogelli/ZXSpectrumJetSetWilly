 512  8B26                  ; - Ripristina lo stato audio
 513  8B26 3E 12            ld   a, 18
 514  8B28 32 A9 FA         ld   (Audio_jump_sound_note), a
 515  8B2B AF               xor  a
 516  8B2C 32 AA FA         ld   (Audio_jump_sound_timer), a
 517  8B2F                  IF ENABLE_MUSIC != 0
 518  8B2F ~                ld   (Audio_music_note_idx), a
 519  8B2F ~                ld   a, 1
 520  8B2F ~                ld   (Audio_music_frame_counter), a
 521  8B2F                  ENDIF
 522  8B2F
 523  8B2F                  ; - Riposiziona Willy nel punto di ingresso dell'ultima stanza raggiunta
 524  8B2F CD 7D 82         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 525  8B32 21 1D FA         ld   hl, room_entry_positions
 526  8B35 5F               ld   e, a
 527  8B36 16 00            ld   d, 0
 528  8B38 19               add  hl, de
 529  8B39 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 530  8B3A 4E               ld   c, (hl)                   ; C = X ingresso
 531  8B3B 23               inc  hl
 532  8B3C 46               ld   b, (hl)                   ; B = Y ingresso
 533  8B3D ED 43 96 F6      ld   (PlayerPos), bc           ; Imposta le coordinate al punto di ingresso
 534  8B41 ED 43 98 F6      ld   (PlayerPosOld), bc
 535  8B45
 536  8B45 3E 01            ld   a, 1
 537  8B47 32 1C FA         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 538  8B4A
 539  8B4A                  ; - Cancella lo schermo a nero prima del caricamento
 540  8B4A AF               xor  a
 541  8B4B D3 FE            out  ($fe), a
 542  8B4D 21 8D 5C         ld   hl, ATTR_P
 543  8B50 77               ld   (hl), a
 544  8B51 CD AF 0D         call CLS
 545  8B54 36 07            ld   (hl), $07
 546  8B56 3E 07            ld   a, $07
 547  8B58 32 8F 5C         ld   (ATTR_T), a
 548  8B5B
 549  8B5B                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 550  8B5B C3 C8 88         jp   LoadRoomAndRestart
 551  8B5E
 552  8B5E              ; -------------------------------------------------------------------
 553  8B5E              ; TriggerVictory
 554  8B5E              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 555  8B5E              ; - Pulisce gli elementi di gioco della stanza.
 556  8B5E              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 557  8B5E              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 558  8B5E              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 559  8B5E              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 560  8B5E              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 561  8B5E              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 562  8B5E              ; -------------------------------------------------------------------
 563  8B5E              TriggerVictory:
 564  8B5E                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 565  8B5E CD 15 66         call Gfx_DrawVictoryScreen
 566  8B61
 567  8B61                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 568  8B61              .wait_keys_release:
 569  8B61 76               halt
 570  8B62                  ; Controlla tasto Y (Porta $DF, bit 4)
 571  8B62 01 FE DF         ld   bc, $dffe
 572  8B65 ED 78            in   a, (c)
 573  8B67 CB 67            bit  4, a
 574  8B69 28 F6            jr   z, .wait_keys_release
 575  8B6B
 576  8B6B                  ; Controlla tasto N (Porta $7F, bit 3)
 577  8B6B 01 FE 7F         ld   bc, $7ffe
 578  8B6E ED 78            in   a, (c)
 579  8B70 CB 5F            bit  3, a
 580  8B72 28 ED            jr   z, .wait_keys_release
 581  8B74
 582  8B74                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 583  8B74 01 FE BF         ld   bc, $bffe
 584  8B77 ED 78            in   a, (c)
 585  8B79 CB 47            bit  0, a
 586  8B7B 28 E4            jr   z, .wait_keys_release
 587  8B7D
 588  8B7D                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 589  8B7D 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 590  8B7F              .wait_choice_loop:
 591  8B7F 76               halt
 592  8B80
 593  8B80                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 594  8B80 0C               inc  c
 595  8B81 79               ld   a, c
 596  8B82 CB 3F            srl  a
 597  8B84 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 598  8B86 E6 07            and  7
 599  8B88 5F               ld   e, a
 600  8B89 16 00            ld   d, 0
 601  8B8B 21 F4 64         ld   hl, victory_color_table
 602  8B8E 19               add  hl, de
 603  8B8F 7E               ld   a, (hl)               ; A = nuovo colore attributo
 604  8B90 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 605  8B93 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 606  8B95              .color_cycle_loop:
 607  8B95 77               ld   (hl), a
 608  8B96 23               inc  hl
 609  8B97 10 FC            djnz .color_cycle_loop
 610  8B99
 611  8B99                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 612  8B99 01 FE DF         ld   bc, $dffe
 613  8B9C ED 78            in   a, (c)
 614  8B9E CB 67            bit  4, a
 615  8BA0 28 2A            jr   z, .play_again_chosen
 616  8BA2
 617  8BA2                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 618  8BA2 01 FE 7F         ld   bc, $7ffe
 619  8BA5 ED 78            in   a, (c)
 620  8BA7 CB 5F            bit  3, a
 621  8BA9 28 0B            jr   z, .quit_chosen
 622  8BAB
 623  8BAB                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 624  8BAB 01 FE BF         ld   bc, $bffe
 625  8BAE ED 78            in   a, (c)
 626  8BB0 CB 47            bit  0, a
 627  8BB2 28 02            jr   z, .quit_chosen
 628  8BB4
 629  8BB4 18 C9            jr   .wait_choice_loop
 630  8BB6
 631  8BB6              .quit_chosen:
 632  8BB6                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 633  8BB6              .wait_quit_release:
 634  8BB6 76               halt
 635  8BB7 01 FE 7F         ld   bc, $7ffe
 636  8BBA ED 78            in   a, (c)
 637  8BBC CB 5F            bit  3, a
 638  8BBE 28 F6            jr   z, .wait_quit_release
 639  8BC0 01 FE BF         ld   bc, $bffe
 640  8BC3 ED 78            in   a, (c)
 641  8BC5 CB 47            bit  0, a
 642  8BC7 28 ED            jr   z, .wait_quit_release
 643  8BC9
 644  8BC9                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 645  8BC9 C3 E6 89         jp   ShowTitleScreen
 646  8BCC
 647  8BCC              .play_again_chosen:
 648  8BCC                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 649  8BCC              .wait_play_again_release:
 650  8BCC 76               halt
 651  8BCD 01 FE DF         ld   bc, $dffe
 652  8BD0 ED 78            in   a, (c)
 653  8BD2 CB 67            bit  4, a
 654  8BD4 28 F6            jr   z, .wait_play_again_release
 655  8BD6
 656  8BD6                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 657  8BD6 CD 96 8C         call ResetFullGameState
 658  8BD9 C3 C8 88         jp   LoadRoomAndRestart
 659  8BDC
 660  8BDC              ; -------------------------------------------------------------------
 661  8BDC              ; CheckVictoryCondition
 662  8BDC              ; Verifica se si verificano contemporaneamente tutte le 3 condizioni di vittoria:
 663  8BDC              ; 1. Willy ha raccolto tutti gli oggetti collezionabili del gioco (tutti i flag in ItemsTable = 1);
 664  8BDC              ; 2. Willy si trova nella stanza Master Bedroom;
 665  8BDC              ; 3. Willy collide con un oggetto/tag di tipo Conveyor in quella stanza.
 666  8BDC              ;
 667  8BDC              ; Output:
 668  8BDC              ;   Carry Flag = 1 se la vittoria è attivata
 669  8BDC              ;   Carry Flag = 0 altrimenti
 670  8BDC              ; -------------------------------------------------------------------
 671  8BDC              CheckVictoryCondition:
 672  8BDC C5               push bc
 673  8BDD D5               push de
 674  8BDE E5               push hl
 675  8BDF
 676  8BDF                  ; 1. Condizione: tutti gli item raccolti?
 677  8BDF CD F8 8B         call CheckAllItemsCollected
 678  8BE2 30 0F            jr   nc, .no_victory
 679  8BE4
 680  8BE4                  ; 2. Condizione: Willy è nella Master Bedroom?
 681  8BE4 CD 1F 8C         call CheckInMasterBedroom
 682  8BE7 30 0A            jr   nc, .no_victory
 683  8BE9
 684  8BE9                  ; 3. Condizione: Willy collide con il conveyor?
 685  8BE9 CD 3B 8C         call CheckWillyConveyorCollision
 686  8BEC 30 05            jr   nc, .no_victory
 687  8BEE
 688  8BEE                  ; Tutte le condizioni sono soddisfatte contemporaneamente!
 689  8BEE E1               pop  hl
 690  8BEF D1               pop  de
 691  8BF0 C1               pop  bc
 692  8BF1 37               scf
 693  8BF2 C9               ret
 694  8BF3
 695  8BF3              .no_victory:
 696  8BF3 E1               pop  hl
 697  8BF4 D1               pop  de
 698  8BF5 C1               pop  bc
 699  8BF6 B7               or   a
 700  8BF7 C9               ret
 701  8BF8
 702  8BF8              ; -------------------------------------------------------------------
 703  8BF8              ; CheckAllItemsCollected
 704  8BF8              ; Verifica che tutti gli item del gioco siano stati raccolti.
 705  8BF8              ; - Controllo preliminare sul conteggio/flag globale
 706  8BF8              ; - Verifica puntuale che ogni record in ItemsTable abbia flag = 1 (raccolto)
 707  8BF8              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 708  8BF8              ; -------------------------------------------------------------------
 709  8BF8              CheckAllItemsCollected:
 710  8BF8 E5               push hl
 711  8BF9 3A A8 FA         ld   a, (game_objective_completed)
 712  8BFC B7               or   a
 713  8BFD 20 07            jr   nz, .verify_flags
 714  8BFF 3A A0 F6         ld   a, (items_collected)
 715  8C02 FE 4D            cp   TOTAL_ITEMS
 716  8C04 38 16            jr   c, .not_all
 717  8C06
 718  8C06              .verify_flags:
 719  8C06 21 FB 80         ld   hl, ItemsTable
 720  8C09              .loop:
 721  8C09 7E               ld   a, (hl)
 722  8C0A FE FF            cp   $FF
 723  8C0C 28 0B            jr   z, .done_all
 724  8C0E 23               inc  hl                    ; +1 X
 725  8C0F 23               inc  hl                    ; +2 Y
 726  8C10 23               inc  hl                    ; +3 Color
 727  8C11 23               inc  hl                    ; +4 Collected flag
 728  8C12 7E               ld   a, (hl)
 729  8C13 B7               or   a
 730  8C14 28 06            jr   z, .not_all           ; Trovato un item non raccolto -> fail
 731  8C16 23               inc  hl                    ; Prossimo record
 732  8C17 18 F0            jr   .loop
 733  8C19
 734  8C19              .done_all:
 735  8C19 E1               pop  hl
 736  8C1A 37               scf
 737  8C1B C9               ret
 738  8C1C
 739  8C1C              .not_all:
 740  8C1C E1               pop  hl
 741  8C1D B7               or   a
 742  8C1E C9               ret
 743  8C1F
 744  8C1F              ; -------------------------------------------------------------------
 745  8C1F              ; CheckInMasterBedroom
 746  8C1F              ; Verifica se la stanza corrente è Master Bedroom (ID 35 / MastreBedRoomLayout)
 747  8C1F              ; Output: Carry = 1 se Master Bedroom, Carry = 0 altrimenti
 748  8C1F              ; -------------------------------------------------------------------
 749  8C1F              CheckInMasterBedroom:
 750  8C1F E5               push hl
 751  8C20 D5               push de
 752  8C21 2A 16 FA         ld   hl, (room_ptr)
 753  8C24 11 8A B4         ld   de, MastreBedRoomLayout
 754  8C27 B7               or   a
 755  8C28 ED 52            sbc  hl, de
 756  8C2A 28 0B            jr   z, .is_master
 757  8C2C 3A BC F9         ld   a, (current_room)
 758  8C2F FE 23            cp   ROOM_MASTER_BEDROOM
 759  8C31 28 04            jr   z, .is_master
 760  8C33 D1               pop  de
 761  8C34 E1               pop  hl
 762  8C35 B7               or   a
 763  8C36 C9               ret
 764  8C37              .is_master:
 765  8C37 D1               pop  de
 766  8C38 E1               pop  hl
 767  8C39 37               scf
 768  8C3A C9               ret
 769  8C3B
 770  8C3B              ; -------------------------------------------------------------------
 771  8C3B              ; CheckWillyConveyorCollision
 772  8C3B              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 773  8C3B              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 774  8C3B              ; -------------------------------------------------------------------
 775  8C3B              CheckWillyConveyorCollision:
 776  8C3B C5               push bc
 777  8C3C D5               push de
 778  8C3D E5               push hl
 779  8C3E
 780  8C3E                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 781  8C3E CD 41 76         call CheckWillyOnConveyor
 782  8C41 38 49            jr   c, .collision_detected
 783  8C43
 784  8C43                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 785  8C43 3A BE F9         ld   a, (conveyor_len)
 786  8C46 B7               or   a
 787  8C47 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 788  8C49
 789  8C49                  ; B = WillyY, C = WillyX
 790  8C49 ED 4B 96 F6      ld   bc, (PlayerPos)
 791  8C4D
 792  8C4D                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 793  8C4D 3A BF F9         ld   a, (conveyor_row)
 794  8C50 87               add  a, a                  ; *2
 795  8C51 87               add  a, a                  ; *4
 796  8C52 87               add  a, a                  ; *8
 797  8C53 5F               ld   e, a                  ; E = ConveyorTop
 798  8C54 C6 07            add  a, 7
 799  8C56 57               ld   d, a                  ; D = ConveyorBottom
 800  8C57
 801  8C57                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 802  8C57 78               ld   a, b                  ; WillyTop
 803  8C58 BA               cp   d
 804  8C59 28 04            jr   z, .y_overlap
 805  8C5B 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 806  8C5D 18 32            jr   .no_conv_collision
 807  8C5F
 808  8C5F              .y_overlap:
 809  8C5F C6 0F            add  a, 15                 ; WillyBottom
 810  8C61 BB               cp   e
 811  8C62 28 04            jr   z, .x_check
 812  8C64 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 813  8C66 18 29            jr   .no_conv_collision
 814  8C68
 815  8C68              .x_check:
 816  8C68                  ; ConveyorLeft = conveyor_col * 8
 817  8C68 3A C0 F9         ld   a, (conveyor_col)
 818  8C6B 87               add  a, a                  ; *2
 819  8C6C 87               add  a, a                  ; *4
 820  8C6D 87               add  a, a                  ; *8
 821  8C6E 5F               ld   e, a                  ; E = ConveyorLeft
 822  8C6F
 823  8C6F                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 824  8C6F 21 BE F9         ld   hl, conveyor_len
 825  8C72 3A C0 F9         ld   a, (conveyor_col)
 826  8C75 86               add  a, (hl)
 827  8C76 87               add  a, a                  ; *2
 828  8C77 87               add  a, a                  ; *4
 829  8C78 87               add  a, a                  ; *8
 830  8C79 3D               dec  a                     ; ConveyorRight
 831  8C7A 57               ld   d, a                  ; D = ConveyorRight
 832  8C7B
 833  8C7B                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 834  8C7B 79               ld   a, c                  ; WillyLeft
 835  8C7C BA               cp   d
 836  8C7D 28 04            jr   z, .x_overlap
 837  8C7F 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 838  8C81 18 0E            jr   .no_conv_collision
 839  8C83
 840  8C83              .x_overlap:
 841  8C83 C6 0F            add  a, 15                 ; WillyRight
 842  8C85 BB               cp   e
 843  8C86 28 04            jr   z, .collision_detected
 844  8C88 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 845  8C8A 18 05            jr   .no_conv_collision
 846  8C8C
 847  8C8C              .collision_detected:
 848  8C8C E1               pop  hl
 849  8C8D D1               pop  de
 850  8C8E C1               pop  bc
 851  8C8F 37               scf
 852  8C90 C9               ret
 853  8C91
 854  8C91              .no_conv_collision:
 855  8C91 E1               pop  hl
 856  8C92 D1               pop  de
 857  8C93 C1               pop  bc
 858  8C94 B7               or   a
 859  8C95 C9               ret
 860  8C96
 861  8C96              ; -------------------------------------------------------------------
 862  8C96              ; ResetFullGameState
 863  8C96              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 864  8C96              ; per l'avvio di una nuova partita dopo il Game Over.
 865  8C96              ; -------------------------------------------------------------------
 866  8C96              ResetFullGameState:
 867  8C96                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 868  8C96 AF               xor  a
 869  8C97 D3 FE            out  ($fe), a              ; Bordo a nero
 870  8C99 21 8D 5C         ld   hl, ATTR_P
 871  8C9C 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 872  8C9D CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 873  8CA0 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 874  8CA2 3E 07            ld   a, $07
 875  8CA4 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 876  8CA7
 877  8CA7                  ; Ripristina il numero di vite iniziali
 878  8CA7 3E 07            ld   a, INITIAL_LIVES
 879  8CA9 32 A3 F6         ld   (willy_lives), a
 880  8CAC
 881  8CAC                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 882  8CAC AF               xor  a
 883  8CAD 32 A0 F6         ld   (items_collected), a
 884  8CB0 32 9C F6         ld   (body_state), a
 885  8CB3 32 AF F6         ld   (w_warp_state), a
 886  8CB6 32 B2 F6         ld   (w_key_prev), a
 887  8CB9 32 B3 F6         ld   (enter_key_prev), a
 888  8CBC 32 A4 F6         ld   (velocity_y), a
 889  8CBF 32 A6 F6         ld   (jump_pressed), a
 890  8CC2 32 A8 F6         ld   (coyote_timer), a
 891  8CC5 32 AB F6         ld   (jump_frame), a
 892  8CC8 32 AA F6         ld   (jump_dir), a
 893  8CCB 32 1C FA         ld   (transition_active), a
 894  8CCE 32 A0 FA         ld   (willy_safety_timer), a
 895  8CD1 3E FF            ld   a, $ff
 896  8CD3 32 B4 F6         ld   (digit_key_prev), a
 897  8CD6 3E 01            ld   a, 1
 898  8CD8 32 AD F6         ld   (q_prev), a
 899  8CDB 32 AE F6         ld   (a_prev), a
 900  8CDE 32 A5 F6         ld   (on_ground), a
 901  8CE1
 902  8CE1                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 903  8CE1 3E 30            ld   a, '0'
 904  8CE3 32 F9 68         ld   (status_line + 16), a
 905  8CE6 32 FA 68         ld   (status_line + 17), a
 906  8CE9 32 FB 68         ld   (status_line + 18), a
 907  8CEC
 908  8CEC                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 909  8CEC CD 57 86         call ResetItemsTable
 910  8CEF
 911  8CEF                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 912  8CEF CD 21 6E         call InitRoomEntryPositions
 913  8CF2
 914  8CF2                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 915  8CF2 3E 07            ld   a, 7
 916  8CF4 32 A3 FA         ld   (time_hours), a
 917  8CF7 AF               xor  a
 918  8CF8 32 A4 FA         ld   (time_minutes), a
 919  8CFB 32 A5 FA         ld   (time_period), a       ; 0 = AM
 920  8CFE 32 A8 FA         ld   (game_objective_completed), a
 921  8D01 2A B7 F6         ld   hl, (counter)
 922  8D04 22 A6 FA         ld   (time_last_counter), hl
 923  8D07 CD 6B 68         call Gfx_UpdateTimeDisplay
 924  8D0A
 925  8D0A                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 926  8D0A 21 4E B2         ld   hl, TheBathroomLayout; TheOffLicenceLayout
 927  8D0D 22 16 FA         ld   (room_ptr), hl
 928  8D10
 929  8D10 C9               ret
 930  8D11
 931  8D11              ; -------------------------------------------------------------------
 932  8D11              ; Time_UpdateClock
 933  8D11              ; Gestisce lo scorrimento del tempo durante il gioco.
 934  8D11              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 935  8D11              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 936  8D11              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 937  8D11              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 938  8D11              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 939  8D11              ; sia completato, scatena immediatamente il Game Over.
 940  8D11              ; -------------------------------------------------------------------
 941  8D11              Time_UpdateClock:
 942  8D11                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 943  8D11 2A B7 F6         ld   hl, (counter)
 944  8D14 ED 5B A6 FA      ld   de, (time_last_counter)
 945  8D18 B7               or   a
 946  8D19 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 947  8D1B
 948  8D1B                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 949  8D1B 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 950  8D1E B7               or   a
 951  8D1F ED 52            sbc  hl, de
 952  8D21 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 953  8D22
 954  8D22                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 955  8D22 2A A6 FA         ld   hl, (time_last_counter)
 956  8D25 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 957  8D28 19               add  hl, de
 958  8D29 22 A6 FA         ld   (time_last_counter), hl
 959  8D2C
 960  8D2C                  ; Incrementa di 1 minuto il tempo di gioco
 961  8D2C 3A A4 FA         ld   a, (time_minutes)
 962  8D2F 3C               inc  a
 963  8D30 FE 3C            cp   60
 964  8D32 38 21            jr   c, .minutes_ok
 965  8D34
 966  8D34                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 967  8D34 AF               xor  a
 968  8D35 32 A4 FA         ld   (time_minutes), a
 969  8D38 3A A3 FA         ld   a, (time_hours)
 970  8D3B 3C               inc  a
 971  8D3C FE 0C            cp   12
 972  8D3E 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 973  8D40 FE 0D            cp   13
 974  8D42 38 0E            jr   c, .hours_ok
 975  8D44 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 976  8D46 18 0A            jr   .hours_ok
 977  8D48
 978  8D48              .toggle_period:
 979  8D48 F5               push af                     ; Salva A (valore 12)
 980  8D49 3A A5 FA         ld   a, (time_period)
 981  8D4C EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 982  8D4E 32 A5 FA         ld   (time_period), a
 983  8D51 F1               pop  af                     ; Ripristina A = 12
 984  8D52
 985  8D52              .hours_ok:
 986  8D52 32 A3 FA         ld   (time_hours), a
 987  8D55
 988  8D55              .minutes_ok:
 989  8D55 32 A4 FA         ld   (time_minutes), a
 990  8D58
 991  8D58                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 992  8D58 CD 6B 68         call Gfx_UpdateTimeDisplay
 993  8D5B
 994  8D5B                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 995  8D5B 3A A8 FA         ld   a, (game_objective_completed)
 996  8D5E B7               or   a
 997  8D5F C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 998  8D60
 999  8D60                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
1000  8D60 3A A5 FA         ld   a, (time_period)
1001  8D63 B7               or   a
1002  8D64 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
1003  8D65
1004  8D65 3A A3 FA         ld   a, (time_hours)
1005  8D68 FE 0C            cp   12
1006  8D6A 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1007  8D6C C9               ret
1008  8D6D
1009  8D6D              .time_limit_reached:
1010  8D6D                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
1011  8D6D                  ; Scatena immediatamente il Game Over temporale!
1012  8D6D C3 35 8A         jp   TriggerGameOver
1013  8D70
1014  8D70
1015  8D70
