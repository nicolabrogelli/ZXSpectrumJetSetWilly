 200+ 76BF 0E 3C            ld   c, 60
 201+ 76C1              .d2:
 202+ 76C1 0D               dec  c
 203+ 76C2 20 FD            jr   nz, .d2
 204+ 76C4
 205+ 76C4 10 E6            djnz .sound_loop
 206+ 76C6
 207+ 76C6 D1               pop  de
 208+ 76C7 C1               pop  bc
 209+ 76C8 C9               ret
