  26+ 6C22 CB 3F            srl  a
  27+ 6C24 CB 3F            srl  a                 ; A = r (0..15)
  28+ 6C26
  29+ 6C26                  ; 3. HL = r * 8
  30+ 6C26 6F               ld   l, a
  31+ 6C27 26 00            ld   h, 0
  32+ 6C29 29               add  hl, hl
  33+ 6C2A 29               add  hl, hl
  34+ 6C2B 29               add  hl, hl            ; HL = r * 8
  35+ 6C2C
  36+ 6C2C                  ; 4. Calcola colonna di layout: c = X / 8 (in C)
  37+ 6C2C 79               ld   a, c
  38+ 6C2D CB 3F            srl  a
  39+ 6C2F CB 3F            srl  a
  40+ 6C31 CB 3F            srl  a                 ; A = c (0..31)
  41+ 6C33 4F               ld   c, a              ; C = c (salva colonna)
  42+ 6C34
  43+ 6C34                  ; HL = r * 8 + c / 4
  44+ 6C34 CB 3F            srl  a
  45+ 6C36 CB 3F            srl  a                 ; A = c / 4
  46+ 6C38 85               add  a, l
  47+ 6C39 6F               ld   l, a              ; HL = r * 8 + c / 4
  48+ 6C3A
  49+ 6C3A ED 5B 15 72      ld   de, (room_ptr)
  50+ 6C3E 19               add  hl, de            ; HL = layout byte address
  51+ 6C3F 7E               ld   a, (hl)           ; A = layout byte
  52+ 6C40
  53+ 6C40                  ; Estrai il bit-pair corrispondente a c % 4
  54+ 6C40 57               ld   d, a              ; D = layout byte
  55+ 6C41 79               ld   a, c
  56+ 6C42 E6 03            and  3                 ; A = c % 4
  57+ 6C44 28 15            jr   z, .shift_0
  58+ 6C46 3D               dec  a
  59+ 6C47 28 0B            jr   z, .shift_1
  60+ 6C49 3D               dec  a
  61+ 6C4A 28 03            jr   z, .shift_2
