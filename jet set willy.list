 296+ 6D5C C6 07            add  a, 7              ; A = PlayerX - EnemyX + 7
 297+ 6D5E FE 17            cp   23                ; Se >= 23, nessuna collisione con questo
 298+ 6D60 30 13            jr   nc, .next
 299+ 6D62
 300+ 6D62                  ; 2. Controllo verticale: PlayerY - EnemyY + 15 in [0, 30]
 301+ 6D62 3A 03 71         ld   a, (PlayerPos+1)  ; A = PlayerY
 302+ 6D65 DD 96 02         sub  (ix+2)            ; A = PlayerY - EnemyY
 303+ 6D68 C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 304+ 6D6A FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 305+ 6D6C 30 07            jr   nc, .next
