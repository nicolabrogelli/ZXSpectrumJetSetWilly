1790+ 85D9              ; Items_CheckCollision
1791+ 85D9              ;
1792+ 85D9              ; Controlla se Willy entra in collisione con uno degli item
1793+ 85D9              ; attivi presenti nella stanza corrente.
1794+ 85D9              ;
1795+ 85D9              ; Per ogni item:
1796+ 85D9              ;   - verifica che appartenga alla stanza corrente
1797+ 85D9              ;   - verifica che non sia già stato raccolto
1798+ 85D9              ;   - esegue il test di collisione con Willy
1799+ 85D9              ;
1800+ 85D9              ; Se l'item viene raccolto:
1801+ 85D9              ;   - imposta il flag "collected"
1802+ 85D9              ;   - rimuove l'item dalla cache items_grid
1803+ 85D9              ;   - incrementa il contatore degli oggetti raccolti
1804+ 85D9              ;   - aggiorna l'HUD
1805+ 85D9              ;   - ripristina il tile di sfondo
1806+ 85D9              ;   - riproduce il suono di raccolta
1807+ 85D9              ;
1808+ 85D9              ; Formato record ItemsTable:
1809+ 85D9              ;   +0 RoomID
1810+ 85D9              ;   +1 X
1811+ 85D9              ;   +2 Y
1812+ 85D9              ;   +3 Color
1813+ 85D9              ;   +4 Collected
1814+ 85D9              ;
1815+ 85D9              ; Fine tabella:
1816+ 85D9              ;   RoomID = $FF
1817+ 85D9              ; -------------------------------------------------------------------
1818+ 85D9              Items_CheckCollision:
1819+ 85D9
1820+ 85D9                  ; Salva i registri utilizzati
1821+ 85D9 E5               push hl
1822+ 85DA D5               push de
1823+ 85DB C5               push bc
1824+ 85DC
1825+ 85DC                  ; Inizio scansione della tabella degli item
1826+ 85DC 21 24 7F         ld   hl, ItemsTable
1827+ 85DF
1828+ 85DF              .loop:
1829+ 85DF
1830+ 85DF                  ; ---------------------------------------------------------------
1831+ 85DF                  ; Legge il Room ID dell'item corrente
1832+ 85DF                  ; ---------------------------------------------------------------
1833+ 85DF 7E               ld   a, (hl)
1834+ 85E0
1835+ 85E0                  ; $FF indica fine tabella
1836+ 85E0 FE FF            cp   $FF
1837+ 85E2 28 58            jr   z, .done
1838+ 85E4
1839+ 85E4                  ; ---------------------------------------------------------------
1840+ 85E4                  ; Verifica se l'item appartiene alla stanza corrente
1841+ 85E4                  ; ---------------------------------------------------------------
1842+ 85E4 57               ld   d, a              ; D = RoomID item
1843+ 85E5
1844+ 85E5 3A A7 EF         ld   a, (current_room)
1845+ 85E8 BA               cp   d
1846+ 85E9
1847+ 85E9                  ; Se appartiene a un'altra stanza salta il record
1848+ 85E9 20 4A            jr   nz, .next_item
1849+ 85EB
1850+ 85EB                  ; ---------------------------------------------------------------
1851+ 85EB                  ; Legge coordinate e stato dell'item
1852+ 85EB                  ; ---------------------------------------------------------------
1853+ 85EB
1854+ 85EB 23               inc  hl
1855+ 85EC 4E               ld   c, (hl)           ; C = X
1856+ 85ED
1857+ 85ED 23               inc  hl
1858+ 85EE 46               ld   b, (hl)           ; B = Y
1859+ 85EF
1860+ 85EF 23               inc  hl                ; salta Color
1861+ 85F0
1862+ 85F0 23               inc  hl                ; punta a Collected
1863+ 85F1
1864+ 85F1 7E               ld   a, (hl)
1865+ 85F2
1866+ 85F2                  ; ---------------------------------------------------------------
1867+ 85F2                  ; Item già raccolto?
1868+ 85F2                  ; ---------------------------------------------------------------
1869+ 85F2 B7               or   a
1870+ 85F3 20 44            jr   nz, .next_no_inc
1871+ 85F5
1872+ 85F5                  ; ---------------------------------------------------------------
1873+ 85F5                  ; Test collisione Willy ↔ Item
1874+ 85F5                  ;
1875+ 85F5                  ; Input richiesto:
1876+ 85F5                  ;   A = ItemX
1877+ 85F5                  ;   H = ItemY
1878+ 85F5                  ; ---------------------------------------------------------------
1879+ 85F5 79               ld   a, c
1880+ 85F6
1881+ 85F6 E5               push hl                ; salva puntatore al flag Collected
1882+ 85F7
1883+ 85F7 60               ld   h, b
1884+ 85F8
1885+ 85F8 CD 93 85         call CheckWillyItemCollision
1886+ 85FB
1887+ 85FB E1               pop  hl
1888+ 85FC
1889+ 85FC                  ; Nessuna collisione
1890+ 85FC 30 3B            jr   nc, .next_no_inc
1891+ 85FE
1892+ 85FE                  ; ===============================================================
1893+ 85FE                  ; ITEM RACCOLTO
1894+ 85FE                  ; ===============================================================
1895+ 85FE
1896+ 85FE                  ; ---------------------------------------------------------------
1897+ 85FE                  ; Marca l'item come raccolto
1898+ 85FE                  ; ---------------------------------------------------------------
1899+ 85FE 36 01            ld   (hl), 1
1900+ 8600
1901+ 8600                  ; ---------------------------------------------------------------
1902+ 8600                  ; Rimuove l'item dalla cache items_grid
1903+ 8600                  ;
1904+ 8600                  ; Calcolo:
1905+ 8600                  ;   offset = Row * 32 + Col
1906+ 8600                  ; ---------------------------------------------------------------
1907+ 8600 E5               push hl
1908+ 8601 D5               push de
1909+ 8602
1910+ 8602 26 00            ld   h, 0
1911+ 8604 68               ld   l, b              ; HL = Row
1912+ 8605
1913+ 8605 29               add  hl, hl            ; *2
1914+ 8606 29               add  hl, hl            ; *4
1915+ 8607 29               add  hl, hl            ; *8
1916+ 8608 29               add  hl, hl            ; *16
1917+ 8609 29               add  hl, hl            ; *32
1918+ 860A
1919+ 860A 59               ld   e, c
1920+ 860B 16 00            ld   d, 0
1921+ 860D
1922+ 860D 19               add  hl, de            ; Row*32 + Col
1923+ 860E
1924+ 860E 11 81 EA         ld   de, items_grid
1925+ 8611 19               add  hl, de
1926+ 8612
1927+ 8612                  ; La cella non contiene più un item
1928+ 8612 36 00            ld   (hl), 0
1929+ 8614
1930+ 8614 D1               pop  de
1931+ 8615 E1               pop  hl
1932+ 8616
1933+ 8616                  ; ---------------------------------------------------------------
1934+ 8616                  ; Conserva il puntatore all'entry corrente
1935+ 8616                  ; poiché le routine successive possono alterare HL.
1936+ 8616                  ; ---------------------------------------------------------------
1937+ 8616 E5               push hl
1938+ 8617
1939+ 8617                  ; ---------------------------------------------------------------
1940+ 8617                  ; Aggiorna il numero di oggetti raccolti
1941+ 8617                  ; ---------------------------------------------------------------
1942+ 8617 3A 8B EC         ld   a, (items_collected)
1943+ 861A
1944+ 861A 3C               inc  a
1945+ 861B
1946+ 861B 32 8B EC         ld   (items_collected), a
1947+ 861E
1948+ 861E FE 4D            cp   TOTAL_ITEMS
1949+ 8620 38 07            jr   c, .objective_not_completed
1950+ 8622 F5               push af
1951+ 8623 3E 01            ld   a, 1
1952+ 8625 32 93 F0         ld   (game_objective_completed), a
1953+ 8628 F1               pop  af
1954+ 8629              .objective_not_completed:
1955+ 8629
1956+ 8629                  ; ---------------------------------------------------------------
1957+ 8629                  ; Aggiorna il contatore visualizzato a schermo
1958+ 8629                  ; ---------------------------------------------------------------
1959+ 8629 CD A5 66         call Gfx_UpdateItemsCollectedDisplay
1960+ 862C
1961+ 862C                  ; ---------------------------------------------------------------
1962+ 862C                  ; Ripristina il tile originale della stanza
1963+ 862C                  ; eliminando la grafica dell'item.
1964+ 862C                  ;
1965+ 862C                  ; Input:
1966+ 862C                  ;   B = Row
1967+ 862C                  ;   C = Col
1968+ 862C                  ; ---------------------------------------------------------------
1969+ 862C CD 51 85         call RestoreBackgroundCell
1970+ 862F
1971+ 862F                  ; ---------------------------------------------------------------
1972+ 862F                  ; Riproduce il suono di raccolta
1973+ 862F                  ; ---------------------------------------------------------------
1974+ 862F CD AB 86         call Audio_PlayCollectSound
1975+ 8632
1976+ 8632                  ; Ripristina il puntatore alla tabella
1977+ 8632 E1               pop  hl
1978+ 8633
1979+ 8633                  ; Continua con il record successivo
1980+ 8633 18 04            jr   .next_no_inc
1981+ 8635
1982+ 8635              .next_item:
1983+ 8635
1984+ 8635                  ; ---------------------------------------------------------------
1985+ 8635                  ; Salta i campi del record:
1986+ 8635                  ;   X
1987+ 8635                  ;   Y
1988+ 8635                  ;   Color
1989+ 8635                  ;   Collected
1990+ 8635                  ; ---------------------------------------------------------------
1991+ 8635 23               inc  hl
1992+ 8636 23               inc  hl
1993+ 8637 23               inc  hl
1994+ 8638 23               inc  hl
1995+ 8639
1996+ 8639              .next_no_inc:
1997+ 8639
1998+ 8639                  ; ---------------------------------------------------------------
1999+ 8639                  ; Avanza al record successivo.
2000+ 8639                  ;
2001+ 8639                  ; Dopo Collected troviamo il RoomID dell'item seguente.
2002+ 8639                  ; ---------------------------------------------------------------
2003+ 8639 23               inc  hl
2004+ 863A
2005+ 863A 18 A3            jr   .loop
2006+ 863C
2007+ 863C              .done:
2008+ 863C
2009+ 863C                  ; Ripristina i registri
2010+ 863C C1               pop  bc
2011+ 863D D1               pop  de
2012+ 863E E1               pop  hl
2013+ 863F
2014+ 863F C9               ret
2015+ 8640
2016+ 8640
2017+ 8640
