 175  8933                  ELSE
 176  8933 ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 177  8933 ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 178  8933 ~                    ELSE
 179  8933 ~                    jp   .no_collision
 180  8933 ~                    ENDIF
 181  8933                  ENDIF
