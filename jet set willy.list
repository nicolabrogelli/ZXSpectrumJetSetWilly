 173+ 5E74              ; -------------------------------------------------------------------
 174+ 5E74              ; Ripristina un byte dello sfondo statico.
 175+ 5E74              ; Input: A = X del byte schermo in pixel (0, 8, 16...), D = Y pixel
 176+ 5E74              ; Output: A = byte di sfondo
 177+ 5E74              ; ---------------------------------------------------------------
 178+ 5E74              GetBackgroundByte:
 179+ 5E74 E5               push hl
 180+ 5E75 D5               push de
 181+ 5E76 C5               push bc
 182+ 5E77
 183+ 5E77 47               ld   b, a              ; B = X (pixel)
 184+ 5E78
 185+ 5E78                  ; 1. Controlla se Y (in D) è fuori dalla griglia di layout (Y >= 128)
 186+ 5E78 7A               ld   a, d
 187+ 5E79 FE 80            cp   128
 188+ 5E7B D2 21 5F         jp   nc, .blank
 189+ 5E7E
 190+ 5E7E                  ; Converti Y (in D) e X (in B) a cella
 191+ 5E7E CB 3F            srl  a
 192+ 5E80 CB 3F            srl  a
 193+ 5E82 CB 3F            srl  a                 ; A = layout row r (0..15)
