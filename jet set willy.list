 577+ 6DB4              ; -------------------------------------------------------------------
 578+ 6DB4              ; Riproduce un breve segnale acustico all'altoparlante
 579+ 6DB4              ; -------------------------------------------------------------------
 580+ 6DB4              PlayCollectSound:
 581+ 6DB4 C5               push bc
 582+ 6DB5 D5               push de
 583+ 6DB6
 584+ 6DB6 06 78            ld   b, 120            ; Cicli della nota
 585+ 6DB8              .sound_loop:
 586+ 6DB8 3A 3F 7A         ld   a, (room_border_color)
 587+ 6DBB F6 10            or   $10               ; Speaker ON (bit 4 = 1)
 588+ 6DBD D3 FE            out  ($fe), a
 589+ 6DBF 0E 3C            ld   c, 60             ; Mezzo periodo delay
 590+ 6DC1 0D           .d1: dec  c
 591+ 6DC2 20 FD            jr   nz, .d1
 592+ 6DC4
 593+ 6DC4 3A 3F 7A         ld   a, (room_border_color)
 594+ 6DC7 E6 EF            and  $ef               ; Speaker OFF (bit 4 = 0)
 595+ 6DC9 D3 FE            out  ($fe), a
 596+ 6DCB 0E 3C            ld   c, 60             ; Mezzo periodo delay
 597+ 6DCD 0D           .d2: dec  c
 598+ 6DCE 20 FD            jr   nz, .d2
 599+ 6DD0
 600+ 6DD0 10 E6            djnz .sound_loop
 601+ 6DD2
 602+ 6DD2 D1               pop  de
 603+ 6DD3 C1               pop  bc
 604+ 6DD4 C9               ret
