 275+ 5EE4 D1               pop  de
 276+ 5EE5
 277+ 5EE5                  ; 6. Calcola offset scanline: s = Y % 8 (in D)
 278+ 5EE5 7A               ld   a, d
 279+ 5EE6 E6 07            and  7                 ; A = s (0..7)
 280+ 5EE8 3C               inc  a                 ; A = 1 + s
 281+ 5EE9 85               add  a, l
 282+ 5EEA 6F               ld   l, a
 283+ 5EEB 30 01            jr   nc, .no_carry
 284+ 5EED 24               inc  h
 285+ 5EEE              .no_carry:
 286+ 5EEE 7E               ld   a, (hl)           ; A = byte dello sfondo
 287+ 5EEF
 288+ 5EEF C1               pop  bc
 289+ 5EF0 D1               pop  de
 290+ 5EF1 E1               pop  hl
 291+ 5EF2 C9               ret
