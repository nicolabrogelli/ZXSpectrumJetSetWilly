2016+ 8599              ; CheckActiveItemAtCell
2017+ 8599              ;
2018+ 8599              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2019+ 8599              ; nella cella specificata della griglia items_grid.
2020+ 8599              ;
2021+ 8599              ; Questa routine usa una lookup diretta su una mappa 32x16,
2022+ 8599              ; evitando la scansione della ItemsTable.
2023+ 8599              ;
2024+ 8599              ; Input:
2025+ 8599              ;   B = Colonna (0..31)
2026+ 8599              ;   C = Riga (0..15)
2027+ 8599              ;
2028+ 8599              ; Output:
2029+ 8599              ;   Carry Set   = item presente nella cella
2030+ 8599              ;   Carry Clear = nessun item
2031+ 8599              ;
2032+ 8599              ; Nota:
2033+ 8599              ;   HL NON è restituito valido (commento originale non corretto:
2034+ 8599              ;   la routine non punta a ItemsTable).
2035+ 8599              ; -------------------------------------------------------------------
2036+ 8599              CheckActiveItemAtCell:
2037+ 8599
2038+ 8599                  ; Salva registri usati
2039+ 8599 D5               push de
2040+ 859A E5               push hl
2041+ 859B
2042+ 859B                  ; ---------------------------------------------------------------
2043+ 859B                  ; Calcolo indice lineare nella griglia 32x16:
2044+ 859B                  ;
2045+ 859B                  ; offset = Row * 32 + Col
2046+ 859B                  ; ---------------------------------------------------------------
2047+ 859B 26 00            ld   h, 0
2048+ 859D 69               ld   l, c              ; HL = Row
2049+ 859E
2050+ 859E 29               add  hl, hl            ; *2
2051+ 859F 29               add  hl, hl            ; *4
2052+ 85A0 29               add  hl, hl            ; *8
2053+ 85A1 29               add  hl, hl            ; *16
2054+ 85A2 29               add  hl, hl            ; *32
2055+ 85A3
2056+ 85A3                  ; Aggiunge la colonna
2057+ 85A3 58               ld   e, b
2058+ 85A4 16 00            ld   d, 0
2059+ 85A6 19               add  hl, de            ; HL = Row*32 + Col
2060+ 85A7
2061+ 85A7                  ; ---------------------------------------------------------------
2062+ 85A7                  ; Accesso alla griglia degli item attivi
2063+ 85A7                  ; ---------------------------------------------------------------
2064+ 85A7 11 EA E8         ld   de, items_grid
2065+ 85AA 19               add  hl, de            ; HL = address cella
2066+ 85AB
2067+ 85AB                  ; ---------------------------------------------------------------
2068+ 85AB                  ; Controllo presenza item
2069+ 85AB                  ;
2070+ 85AB                  ; items_grid contiene:
2071+ 85AB                  ;   0 = nessun item
2072+ 85AB                  ;   >0 = item attivo (colore o flag)
2073+ 85AB                  ; ---------------------------------------------------------------
2074+ 85AB 7E               ld   a, (hl)
2075+ 85AC B7               or   a
2076+ 85AD 28 04            jr   z, .not_active
2077+ 85AF
2078+ 85AF                  ; ---------------------------------------------------------------
2079+ 85AF                  ; Item trovato
2080+ 85AF                  ; ---------------------------------------------------------------
2081+ 85AF E1               pop  hl
2082+ 85B0 D1               pop  de
2083+ 85B1
2084+ 85B1 37               scf                    ; Carry = 1
2085+ 85B2 C9               ret
2086+ 85B3
2087+ 85B3              .not_active:
2088+ 85B3
2089+ 85B3                  ; ---------------------------------------------------------------
2090+ 85B3                  ; Nessun item nella cella
2091+ 85B3                  ; ---------------------------------------------------------------
2092+ 85B3 E1               pop  hl
2093+ 85B4 D1               pop  de
2094+ 85B5
2095+ 85B5 B7               or   a                 ; Carry = 0
2096+ 85B6 C9               ret
2097+ 85B7
