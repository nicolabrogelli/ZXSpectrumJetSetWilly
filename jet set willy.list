 158+ 6CB4                  ; Applica gravità
 159+ 6CB4 3A 0E 71         ld  a, (velocity_y)
 160+ 6CB7 D6 02            sub GRAVITY           ; gravity = 2
 161+ 6CB9
 162+ 6CB9                  ; Controlla se positivo per evitare bug con cp signed
 163+ 6CB9 CB 7F            bit 7, a
 164+ 6CBB 28 06            jr  z, .store_vel
 165+ 6CBD
 166+ 6CBD FE F4            cp  -MAX_FALL_SPEED   ; -12
 167+ 6CBF 30 02            jr  nc, .store_vel
 168+ 6CC1 3E F4            ld  a, -MAX_FALL_SPEED
 169+ 6CC3
 170+ 6CC3              .store_vel:
 171+ 6CC3 32 0E 71         ld  (velocity_y), a
 172+ 6CC6
 173+ 6CC6                  ; Applica movimento verticale: PlayerY = PlayerY - velocity_y
 174+ 6CC6 ED 4B 02 71      ld  bc, (PlayerPos)
 175+ 6CCA 57               ld  d, a              ; D = velocity_y (signed)
 176+ 6CCB 78               ld  a, b              ; A = PlayerY
 177+ 6CCC 92               sub d                 ; A = PlayerY - velocity_y
 178+ 6CCD 47               ld  b, a              ; B = new PlayerY
 179+ 6CCE
 180+ 6CCE                  ; Controlla se stiamo cadendo (velocity_y <= 0)
 181+ 6CCE 3A 0E 71         ld  a, (velocity_y)
 182+ 6CD1 CB 7F            bit 7, a              ; Se negativo, bit 7 = 1
 183+ 6CD3 20 05            jr  nz, .falling_checks
 184+ 6CD5 B7               or  a                 ; Se zero
 185+ 6CD6 28 02            jr  z, .falling_checks
 186+ 6CD8 18 4B            jr  .no_collision_checks ; Se stiamo salendo, non controlliamo collisioni
 187+ 6CDA
 188+ 6CDA              .falling_checks:
 189+ 6CDA                  ; --- CONTROLLO COLLISIONE CON IL TERRENO DURANTE LA CADUTA ---
 190+ 6CDA 78               ld   a, b
 191+ 6CDB C6 10            add  a, 16
 192+ 6CDD 47               ld   b, a              ; B = Nuovo Y + 16
 193+ 6CDE
 194+ 6CDE                  ; Controlla se il piede sinistro tocca solido
 195+ 6CDE CD 12 6C         call CheckSolidCell
 196+ 6CE1 38 0B            jr   c, .check_landing
 197+ 6CE3
 198+ 6CE3                  ; Controlla se il piede destro tocca solido
