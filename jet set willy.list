 782+ 610D 24               inc  h                 ; Prossima scanline (stessa riga di caratteri)
 783+ 610E DD 23            inc  ix
 784+ 6110 15               dec  d
 785+ 6111 20 F6            jr   nz, .line_loop
 786+ 6113 DD E1            pop  ix
 787+ 6115
 788+ 6115                  ; 3. Scrivi l'attributo
 789+ 6115                  ; AttrAddr = $5800 + B * 32 + C
 790+ 6115 26 00            ld   h, 0
 791+ 6117 68               ld   l, b              ; HL = B (Row)
 792+ 6118 29               add  hl, hl            ; *2
 793+ 6119 29               add  hl, hl            ; *4
 794+ 611A 29               add  hl, hl            ; *8
 795+ 611B 29               add  hl, hl            ; *16
 796+ 611C 29               add  hl, hl            ; *32
 797+ 611D 16 00            ld   d, 0
 798+ 611F 59               ld   e, c              ; DE = C (Col)
 799+ 6120 19               add  hl, de            ; HL = B * 32 + C
 800+ 6121 11 00 58         ld   de, $5800
 801+ 6124 19               add  hl, de            ; HL = AttrAddr
 802+ 6125
