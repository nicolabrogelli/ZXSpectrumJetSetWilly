  63+ 708D              ; DetermineCurrentRoomID
  64+ 708D              ;
  65+ 708D              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 708D              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 708D              ;
  68+ 708D              ; Se viene trovata una corrispondenza:
  69+ 708D              ;   A = ID della stanza
  70+ 708D              ;   current_room = A
  71+ 708D              ;
  72+ 708D              ; Mappatura:
  73+ 708D              ;    0 = The Off Licence
  74+ 708D              ;    1 = The Bridge
  75+ 708D              ;    2 = Under The Mega Tree
  76+ 708D              ;    3 = At The Foot Of The Mega Tree
  77+ 708D              ;    4 = The Drive
  78+ 708D              ;    5 = The Security Guard
  79+ 708D              ;    6 = Entrance To Hades
  80+ 708D              ;    7 = Cuckoo's Nest
  81+ 708D              ;    8 = Inside The Mega Trunk
  82+ 708D              ;    9 = On A Branch Over The Drive
  83+ 708D              ;   10 = The Front Door
  84+ 708D              ;   11 = The Hall
  85+ 708D              ;   12 = Tree Top
  86+ 708D              ;   33 = The Bathroom
  87+ 708D              ;   35 = Master Bedroom
  88+ 708D              ;
  89+ 708D              ; Se nessuna stanza corrisponde viene impostato:
  90+ 708D              ;   current_room = 0
  91+ 708D              ; -------------------------------------------------------------------
  92+ 708D              DetermineCurrentRoomID:
