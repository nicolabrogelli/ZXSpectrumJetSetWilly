 573  8CB0              ; -------------------------------------------------------------------
 574  8CB0              ; TriggerVictory
 575  8CB0              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 576  8CB0              ; - Pulisce gli elementi di gioco della stanza.
 577  8CB0              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 578  8CB0              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 579  8CB0              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 580  8CB0              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 581  8CB0              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 582  8CB0              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 583  8CB0              ; -------------------------------------------------------------------
 584  8CB0              TriggerVictory:
 585  8CB0                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 586  8CB0 CD 15 66         call Gfx_DrawVictoryScreen
 587  8CB3
 588  8CB3                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 589  8CB3              .wait_keys_release:
 590  8CB3 76               halt
 591  8CB4                  ; Controlla tasto Y (Porta $DF, bit 4)
 592  8CB4 01 FE DF         ld   bc, $dffe
 593  8CB7 ED 78            in   a, (c)
 594  8CB9 CB 67            bit  4, a
 595  8CBB 28 F6            jr   z, .wait_keys_release
 596  8CBD
 597  8CBD                  ; Controlla tasto N (Porta $7F, bit 3)
 598  8CBD 01 FE 7F         ld   bc, $7ffe
 599  8CC0 ED 78            in   a, (c)
 600  8CC2 CB 5F            bit  3, a
 601  8CC4 28 ED            jr   z, .wait_keys_release
 602  8CC6
 603  8CC6                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 604  8CC6 01 FE BF         ld   bc, $bffe
 605  8CC9 ED 78            in   a, (c)
 606  8CCB CB 47            bit  0, a
 607  8CCD 28 E4            jr   z, .wait_keys_release
 608  8CCF
 609  8CCF                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 610  8CCF 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 611  8CD1              .wait_choice_loop:
 612  8CD1 76               halt
 613  8CD2
 614  8CD2                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 615  8CD2 0C               inc  c
 616  8CD3 79               ld   a, c
 617  8CD4 CB 3F            srl  a
 618  8CD6 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 619  8CD8 E6 07            and  7
 620  8CDA 5F               ld   e, a
 621  8CDB 16 00            ld   d, 0
 622  8CDD 21 F4 64         ld   hl, victory_color_table
 623  8CE0 19               add  hl, de
 624  8CE1 7E               ld   a, (hl)               ; A = nuovo colore attributo
 625  8CE2 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 626  8CE5 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 627  8CE7              .color_cycle_loop:
 628  8CE7 77               ld   (hl), a
 629  8CE8 23               inc  hl
 630  8CE9 10 FC            djnz .color_cycle_loop
 631  8CEB
 632  8CEB                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 633  8CEB 01 FE DF         ld   bc, $dffe
 634  8CEE ED 78            in   a, (c)
 635  8CF0 CB 67            bit  4, a
 636  8CF2 28 2A            jr   z, .play_again_chosen
 637  8CF4
 638  8CF4                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
