 892+ 6AE1 4F               ld   c, a              ; C = limit_right (exclusive)
 893+ 6AE2
 894+ 6AE2 7B               ld   a, e              ; A = Col
 895+ 6AE3 B8               cp   b
 896+ 6AE4 38 15            jr   c, .check_platform_case
 897+ 6AE6 B9               cp   c
 898+ 6AE7 30 12            jr   nc, .check_platform_case
 899+ 6AE9
 900+ 6AE9                  ; Calcola B = ramp_col - Col
