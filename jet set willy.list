  39+ 687B C6 02            add  a, 2              ; Prova a muoverti di 2 pixel a destra
  40+ 687D FE F0            cp   PLAYER_MAX_X      ; Confronta con il limite destro
  41+ 687F 28 02            jr   z, .ok_right      ; Se == PLAYER_MAX_X, va bene
  42+ 6881 30 03            jr   nc, .clamp_right  ; Se > PLAYER_MAX_X (senza carry, cioè maggiore), clampa
  43+ 6883              .ok_right:
  44+ 6883 4F               ld   c, a              ; Altrimenti memorizza la nuova posizione
  45+ 6884 18 02            jr   save_x
  46+ 6886
  47+ 6886              .clamp_right:
