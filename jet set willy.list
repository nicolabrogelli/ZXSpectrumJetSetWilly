2042+ 8530                  ; ---------------------------------------------------------------
2043+ 8530                  ; Calcolo indice lineare nella griglia 32x16:
2044+ 8530                  ;
2045+ 8530                  ; offset = Row * 32 + Col
2046+ 8530                  ; ---------------------------------------------------------------
2047+ 8530 26 00            ld   h, 0
