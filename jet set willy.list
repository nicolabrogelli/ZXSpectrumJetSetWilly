 109  7FDC
 110  7FDC                  ; Collisione attiva: disegna le raster bar nel bordo
 111  7FDC 3A 69 72         ld   a, (counter)
 112  7FDF E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 113  7FE1 06 1E            ld   b, 30             ; Numero di righe della barra raster
 114  7FE3              .raster_loop:
 115  7FE3 D3 FE            out  ($fe), a
