 973+ 78E6              ; DrawItemGraphic
 974+ 78E6              ;
 975+ 78E6              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 976+ 78E6              ; utilizzando una bitmap di 8 byte e un attributo colore.
 977+ 78E6              ;
 978+ 78E6              ; Input:
 979+ 78E6              ;   B = Riga attributi (3..18)
 980+ 78E6              ;   C = Colonna attributi (0..31)
 981+ 78E6              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 982+ 78E6              ;   E = Attributo colore
 983+ 78E6              ;
 984+ 78E6              ; Output:
 985+ 78E6              ;   Nessuno
 986+ 78E6              ;
 987+ 78E6              ; Registri preservati:
 988+ 78E6              ;   BC, DE, HL
 989+ 78E6              ; -------------------------------------------------------------------
 990+ 78E6              DrawItemGraphic:
 991+ 78E6
 992+ 78E6                  ; Salva i registri originali
 993+ 78E6 C5               push bc
 994+ 78E7 D5               push de
 995+ 78E8 E5               push hl
 996+ 78E9
 997+ 78E9                  ; ---------------------------------------------------------------
 998+ 78E9                  ; Calcolo indirizzo bitmap dello Spectrum
 999+ 78E9                  ;
1000+ 78E9                  ; Ogni item occupa una cella attributi (8x8 pixel).
1001+ 78E9                  ;
1002+ 78E9                  ; Formula:
1003+ 78E9                  ;   High = $40 + (Row AND $18)
1004+ 78E9                  ;   Low  = (Row AND 7) * 32 + Col
1005+ 78E9                  ;
1006+ 78E9                  ; DE conterrà l'indirizzo della prima scanline.
1007+ 78E9                  ; ---------------------------------------------------------------
1008+ 78E9
1009+ 78E9 78               ld   a, b
1010+ 78EA E6 18            and  $18
1011+ 78EC C6 40            add  a, $40
1012+ 78EE 57               ld   d, a              ; Byte alto indirizzo video
1013+ 78EF
1014+ 78EF 78               ld   a, b
1015+ 78F0 E6 07            and  7                 ; Riga interna al blocco da 8
1016+ 78F2
1017+ 78F2 87               add  a, a              ; *2
1018+ 78F3 87               add  a, a              ; *4
1019+ 78F4 87               add  a, a              ; *8
1020+ 78F5 87               add  a, a              ; *16
1021+ 78F6 87               add  a, a              ; *32
1022+ 78F7
1023+ 78F7 81               add  a, c              ; + colonna
1024+ 78F8
1025+ 78F8 5F               ld   e, a              ; Byte basso indirizzo video
1026+ 78F9
1027+ 78F9                  ; ---------------------------------------------------------------
1028+ 78F9                  ; Disegno bitmap
1029+ 78F9                  ;
1030+ 78F9                  ; Copia 8 byte consecutivi nella memoria video.
1031+ 78F9                  ; Ogni byte rappresenta una scanline da 8 pixel.
1032+ 78F9                  ; ---------------------------------------------------------------
1033+ 78F9
1034+ 78F9 C5               push bc                ; Conserva Row e Col
1035+ 78FA
1036+ 78FA 06 08            ld   b, 8              ; Numero scanline
1037+ 78FC
1038+ 78FC              .line_loop:
1039+ 78FC
1040+ 78FC 7E               ld   a, (hl)           ; Legge scanline bitmap
1041+ 78FD 12               ld   (de), a           ; Scrive nella memoria video
1042+ 78FE
1043+ 78FE 14               inc  d                 ; Scanline successiva
1044+ 78FF 23               inc  hl                ; Byte bitmap successivo
1045+ 7900
1046+ 7900 05               dec  b
1047+ 7901 20 F9            jr   nz, .line_loop
1048+ 7903
1049+ 7903 C1               pop  bc                ; Ripristina Row e Col
1050+ 7904
1051+ 7904                  ; ---------------------------------------------------------------
1052+ 7904                  ; Calcolo indirizzo attributo
1053+ 7904                  ;
1054+ 7904                  ; Formula:
1055+ 7904                  ;   AttrAddr = $5800 + Row * 32 + Col
1056+ 7904                  ;
1057+ 7904                  ; HL conterrà l'indirizzo della cella attributi.
1058+ 7904                  ; ---------------------------------------------------------------
1059+ 7904
1060+ 7904 26 00            ld   h, 0
1061+ 7906 68               ld   l, b              ; HL = Row
1062+ 7907
1063+ 7907 29               add  hl, hl            ; *2
1064+ 7908 29               add  hl, hl            ; *4
1065+ 7909 29               add  hl, hl            ; *8
1066+ 790A 29               add  hl, hl            ; *16
1067+ 790B 29               add  hl, hl            ; *32
1068+ 790C
1069+ 790C 79               ld   a, c              ; A = Colonna
1070+ 790D
1071+ 790D 85               add  a, l
1072+ 790E 6F               ld   l, a
1073+ 790F
1074+ 790F 30 01            jr   nc, .no_carry
1075+ 7911 24               inc  h
1076+ 7912
1077+ 7912              .no_carry:
1078+ 7912
1079+ 7912                  ; HL = Row * 32 + Col
1080+ 7912
1081+ 7912 11 00 58         ld   de, $5800
1082+ 7915 19               add  hl, de            ; HL = indirizzo attributi
1083+ 7916
1084+ 7916                  ; ---------------------------------------------------------------
1085+ 7916                  ; Recupera il colore originale dallo stack.
1086+ 7916                  ;
1087+ 7916                  ; Layout stack:
1088+ 7916                  ;   HL originale
1089+ 7916                  ;   DE originale (E = colore)
1090+ 7916                  ;   BC originale
1091+ 7916                  ; ---------------------------------------------------------------
1092+ 7916
1093+ 7916 C1               pop  bc                ; Recupera HL originale
1094+ 7917 D1               pop  de                ; Recupera DE originale
1095+ 7918
1096+ 7918                  ; ---------------------------------------------------------------
1097+ 7918                  ; Scrive l'attributo colore
1098+ 7918                  ; ---------------------------------------------------------------
1099+ 7918
1100+ 7918 7B               ld   a, e              ; A = colore
1101+ 7919 77               ld   (hl), a           ; Scrive nella RAM attributi
1102+ 791A
1103+ 791A                  ; ---------------------------------------------------------------
1104+ 791A                  ; Ripristina HL e BC originali
1105+ 791A                  ; ---------------------------------------------------------------
1106+ 791A
1107+ 791A C5               push bc
1108+ 791B E1               pop  hl                ; HL originale
1109+ 791C
1110+ 791C C1               pop  bc                ; BC originale
1111+ 791D
1112+ 791D C9               ret
