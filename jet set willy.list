 996+ 6C54              ; -------------------------------------------------------------------
 997+ 6C54              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 998+ 6C54              ; Input: C = X, B = Y
 999+ 6C54              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
1000+ 6C54              ; -------------------------------------------------------------------
1001+ 6C54              CheckWallCell:
1002+ 6C54 E5               push hl
1003+ 6C55 D5               push de
1004+ 6C56 C5               push bc
1005+ 6C57
1006+ 6C57                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1007+ 6C57 78               ld   a, b
1008+ 6C58 FE 80            cp   128
1009+ 6C5A 30 1F            jr   nc, .not_wall
1010+ 6C5C
1011+ 6C5C                  ; 2. Calcola riga di layout: r = Y / 8
1012+ 6C5C CB 3F            srl  a
1013+ 6C5E CB 3F            srl  a
1014+ 6C60 CB 3F            srl  a                 ; A = r (0..15)
1015+ 6C62
1016+ 6C62                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1017+ 6C62 5F               ld   e, a              ; E = r (Row)
1018+ 6C63 79               ld   a, c
1019+ 6C64 CB 3F            srl  a
1020+ 6C66 CB 3F            srl  a
1021+ 6C68 CB 3F            srl  a                 ; A = c (0..31)
1022+ 6C6A 4F               ld   c, a              ; C = c (Col)
1023+ 6C6B
1024+ 6C6B                  ; Se la cella è sulla rampa, non considerarla un muro!
1025+ 6C6B 53               ld   d, e              ; D = Row
1026+ 6C6C 59               ld   e, c              ; E = Col
1027+ 6C6D CD D9 6B         call IsCellOnRamp
1028+ 6C70 38 09            jr   c, .not_wall
1029+ 6C72
1030+ 6C72 7A               ld   a, d              ; A = Row
1031+ 6C73 4B               ld   c, e              ; C = Col
1032+ 6C74 CD D4 6C         call GetCellFromUnpacked ; A = cell type
1033+ 6C77
1034+ 6C77                  ; Controlla se è Wall (2)
