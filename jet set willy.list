 279  8B26              ; -------------------------------------------------------------------
 280  8B26              ; ShowTitleScreen
 281  8B26              ; Visualizza la schermata iniziale del gioco (Title Screen).
 282  8B26              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 283  8B26              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 284  8B26              ; -------------------------------------------------------------------
 285  8B26              ShowTitleScreen:
 286  8B26                  ; 1. Disegna la schermata iniziale
 287  8B26 CD 1B 63         call Gfx_DrawTitleScreen
 288  8B29
 289  8B29                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 290  8B29              .wait_title_enter_release:
 291  8B29 76               halt
 292  8B2A 3E BF            ld   a, $bf
 293  8B2C DB FE            in   a, ($fe)
 294  8B2E 1F               rra
 295  8B2F 30 F8            jr   nc, .wait_title_enter_release
 296  8B31
 297  8B31                  ; 3. Ciclo di attesa pressione ENTER con animazione colore e musica (Moonlight Sonata)
 298  8B31                  IF ENABLE_MUSIC != 0
 299  8B31 21 58 89         ld   hl, Audio_TitleMusicSheet
 300  8B34                  ENDIF
 301  8B34 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 302  8B36              .title_loop:
 303  8B36                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 304  8B36 0C               inc  c
 305  8B37 79               ld   a, c
 306  8B38 E6 07            and  7
 307  8B3A 5F               ld   e, a
 308  8B3B 16 00            ld   d, 0
 309  8B3D                  IF ENABLE_MUSIC != 0
 310  8B3D E5               push hl
 311  8B3E                  ENDIF
 312  8B3E 21 13 63         ld   hl, title_color_table
 313  8B41 19               add  hl, de
 314  8B42 7E               ld   a, (hl)               ; A = nuovo colore
 315  8B43 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 316  8B46 06 20            ld   b, 32
 317  8B48              .color_title_loop:
 318  8B48 77               ld   (hl), a
 319  8B49 23               inc  hl
 320  8B4A 10 FC            djnz .color_title_loop
 321  8B4C                  IF ENABLE_MUSIC != 0
 322  8B4C E1               pop  hl
 323  8B4D
 324  8B4D                  ; Controlla se la melodia è finita (terminatore 255): se sì, ricomincia in loop
 325  8B4D 7E               ld   a, (hl)
 326  8B4E FE FF            cp   255
 327  8B50 20 03            jr   nz, .play_title_note
 328  8B52 21 58 89         ld   hl, Audio_TitleMusicSheet
 329  8B55              .play_title_note:
 330  8B55 CD 18 89         call Audio_PlayTitleNote   ; Suona una nota della melodia e controlla ENTER
 331  8B58 28 03            jr   z, .enter_pressed     ; Z flag = 1 -> ENTER premuto!
 332  8B5A 23               inc  hl
 333  8B5B 18 D9            jr   .title_loop
 334  8B5D                  ELSE
 335  8B5D ~                halt
 336  8B5D ~                ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 337  8B5D ~                ld   a, $bf
 338  8B5D ~                in   a, ($fe)
 339  8B5D ~                rra
 340  8B5D ~                jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 341  8B5D                  ENDIF
 342  8B5D
 343  8B5D              .enter_pressed:
