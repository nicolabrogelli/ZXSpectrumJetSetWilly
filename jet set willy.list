 799+ 6A68              ; -------------------------------------------------------------------
 800+ 6A68              ; Verifica se la cella (Col in E, Row in D) è sulla rampa, immediatamente sotto di essa,
 801+ 6A68              ; o sulla piattaforma adiacente in cima.
 802+ 6A68              ; Output: Carry flag impostato se è sulla rampa, altrimenti resettato
 803+ 6A68              ; -------------------------------------------------------------------
 804+ 6A68              IsCellOnRamp:
 805+ 6A68 C5               push bc
 806+ 6A69 E5               push hl
 807+ 6A6A
 808+ 6A6A 3A 08 77         ld   a, (ramp_len)
 809+ 6A6D B7               or   a
 810+ 6A6E 28 6B            jr   z, .no
 811+ 6A70
 812+ 6A70                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 813+ 6A70 3A 07 77         ld   a, (ramp_dir)
 814+ 6A73 B7               or   a
 815+ 6A74 28 1A            jr   z, .range_left
 816+ 6A76              .range_right:
 817+ 6A76 3A 0A 77         ld   a, (ramp_col)
 818+ 6A79 47               ld   b, a              ; B = ramp_col
 819+ 6A7A 3A 08 77         ld   a, (ramp_len)
 820+ 6A7D 80               add  a, b              ; A = ramp_col + ramp_len
 821+ 6A7E 4F               ld   c, a              ; C = limit_right (exclusive)
 822+ 6A7F
 823+ 6A7F 7B               ld   a, e              ; A = Col
 824+ 6A80 B8               cp   b
 825+ 6A81 38 34            jr   c, .check_platform_case ; Col < ramp_col
 826+ 6A83 B9               cp   c
 827+ 6A84 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 828+ 6A86
 829+ 6A86                  ; Calcola B = Col - ramp_col
 830+ 6A86 7B               ld   a, e
 831+ 6A87 90               sub  b
 832+ 6A88 47               ld   b, a              ; B = offset (0..ramp_len-1)
 833+ 6A89
 834+ 6A89                  ; SlopeRow = ramp_row - B
 835+ 6A89 3A 09 77         ld   a, (ramp_row)
 836+ 6A8C 90               sub  b
 837+ 6A8D 47               ld   b, a              ; B = SlopeRow
 838+ 6A8E 18 1F            jr   .check_row_match
 839+ 6A90
 840+ 6A90              .range_left:
 841+ 6A90                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 842+ 6A90 21 08 77         ld   hl, ramp_len
 843+ 6A93 3A 0A 77         ld   a, (ramp_col)
 844+ 6A96 96               sub  (hl)
 845+ 6A97 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 846+ 6A98 47               ld   b, a              ; B = limit_left
 847+ 6A99
 848+ 6A99 3A 0A 77         ld   a, (ramp_col)
 849+ 6A9C 3C               inc  a
 850+ 6A9D 4F               ld   c, a              ; C = limit_right (exclusive)
 851+ 6A9E
 852+ 6A9E 7B               ld   a, e              ; A = Col
 853+ 6A9F B8               cp   b
 854+ 6AA0 38 15            jr   c, .check_platform_case
 855+ 6AA2 B9               cp   c
 856+ 6AA3 30 12            jr   nc, .check_platform_case
 857+ 6AA5
 858+ 6AA5                  ; Calcola B = ramp_col - Col
 859+ 6AA5 3A 0A 77         ld   a, (ramp_col)
 860+ 6AA8 93               sub  e
 861+ 6AA9 47               ld   b, a              ; B = offset
 862+ 6AAA
 863+ 6AAA                  ; SlopeRow = ramp_row - B
 864+ 6AAA 3A 09 77         ld   a, (ramp_row)
 865+ 6AAD 90               sub  b
 866+ 6AAE 47               ld   b, a              ; B = SlopeRow
