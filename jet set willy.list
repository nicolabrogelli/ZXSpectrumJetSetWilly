 999+ 6BDD              ; -------------------------------------------------------------------
1000+ 6BDD              ; Ottiene l'attributo colore originale dello sfondo per una cella
1001+ 6BDD              ; Input: H = Row (0..23), B = Col (0..31)
1002+ 6BDD              ; Output: A = Attributo colore
1003+ 6BDD              ; -------------------------------------------------------------------
1004+ 6BDD              GetCellAttribute:
1005+ 6BDD E5               push hl
1006+ 6BDE D5               push de
1007+ 6BDF C5               push bc
1008+ 6BE0
1009+ 6BE0                  ; 1. Controlla se Row (H) è fuori dal layout (H < 3 o H >= 19)
1010+ 6BE0 7C               ld   a, h
1011+ 6BE1 FE 03            cp   3
1012+ 6BE3 38 5E            jr   c, .blank
1013+ 6BE5 FE 13            cp   19
1014+ 6BE7 30 5A            jr   nc, .blank
1015+ 6BE9
1016+ 6BE9                  ; 2. Calcola riga di layout: r = H - 3
1017+ 6BE9 D6 03            sub  3
1018+ 6BEB
1019+ 6BEB                  ; 3. HL = r * 8
1020+ 6BEB 6F               ld   l, a
1021+ 6BEC 26 00            ld   h, 0
1022+ 6BEE 29               add  hl, hl
1023+ 6BEF 29               add  hl, hl
1024+ 6BF0 29               add  hl, hl            ; HL = r * 8
1025+ 6BF1
1026+ 6BF1                  ; 4. HL = r * 8 + c / 4
1027+ 6BF1 78               ld   a, b              ; A = Col
1028+ 6BF2 CB 3F            srl  a
1029+ 6BF4 CB 3F            srl  a                 ; A = c / 4
1030+ 6BF6 85               add  a, l
1031+ 6BF7 6F               ld   l, a              ; HL = r * 8 + c / 4
1032+ 6BF8
1033+ 6BF8 ED 5B 24 7A      ld   de, (room_ptr)
1034+ 6BFC 19               add  hl, de            ; HL = layout byte address
1035+ 6BFD 7E               ld   a, (hl)           ; A = layout byte
1036+ 6BFE
1037+ 6BFE                  ; Estrai il bit-pair corrispondente a c % 4
1038+ 6BFE 4F               ld   c, a              ; C = layout byte
1039+ 6BFF 78               ld   a, b              ; A = Col
1040+ 6C00 E6 03            and  3                 ; A = c % 4
1041+ 6C02 28 15            jr   z, .shift_0
1042+ 6C04 3D               dec  a
1043+ 6C05 28 0B            jr   z, .shift_1
1044+ 6C07 3D               dec  a
1045+ 6C08 28 03            jr   z, .shift_2
1046+ 6C0A                  ; Case 3 (c % 4 = 3)
1047+ 6C0A 79               ld   a, c
1048+ 6C0B 18 0F            jr   .got_type
1049+ 6C0D              .shift_2:
1050+ 6C0D 79               ld   a, c
1051+ 6C0E 0F               rrca
1052+ 6C0F 0F               rrca
1053+ 6C10 18 0A            jr   .got_type
1054+ 6C12              .shift_1:
1055+ 6C12 79               ld   a, c
1056+ 6C13 0F               rrca
1057+ 6C14 0F               rrca
1058+ 6C15 0F               rrca
1059+ 6C16 0F               rrca
1060+ 6C17 18 03            jr   .got_type
1061+ 6C19              .shift_0:
1062+ 6C19 79               ld   a, c
1063+ 6C1A 07               rlca
1064+ 6C1B 07               rlca
1065+ 6C1C              .got_type:
1066+ 6C1C E6 03            and  3                 ; A = cell type (0..3)
1067+ 6C1E
1068+ 6C1E                  ; Ottieni l'offset del tile corrispondente e leggi l'attributo (il primo byte del tile)
1069+ 6C1E B7               or   a
1070+ 6C1F 20 05            jr   nz, .not_bg
1071+ 6C21 21 A0 00         ld   hl, OFFSET_BG
1072+ 6C24 18 13            jr   .load_attr
1073+ 6C26              .not_bg:
1074+ 6C26 3D               dec  a
1075+ 6C27 20 05            jr   nz, .not_floor
1076+ 6C29 21 A9 00         ld   hl, OFFSET_FLOOR
1077+ 6C2C 18 0B            jr   .load_attr
1078+ 6C2E              .not_floor:
1079+ 6C2E 3D               dec  a
1080+ 6C2F 20 05            jr   nz, .not_wall
1081+ 6C31 21 B2 00         ld   hl, OFFSET_WALL
1082+ 6C34 18 03            jr   .load_attr
1083+ 6C36              .not_wall:
1084+ 6C36 21 BB 00         ld   hl, OFFSET_NASTY
1085+ 6C39
1086+ 6C39              .load_attr:
1087+ 6C39 ED 5B 24 7A      ld   de, (room_ptr)
1088+ 6C3D 19               add  hl, de            ; HL = tile pointer
1089+ 6C3E 7E               ld   a, (hl)           ; A = primo byte del tile (l'attributo colore)
1090+ 6C3F
1091+ 6C3F C1               pop  bc
1092+ 6C40 D1               pop  de
1093+ 6C41 E1               pop  hl
1094+ 6C42 C9               ret
1095+ 6C43
1096+ 6C43              .blank:
1097+ 6C43 3E 07            ld   a, $07            ; Sfondo di default (bianco su nero)
1098+ 6C45 C1               pop  bc
1099+ 6C46 D1               pop  de
1100+ 6C47 E1               pop  hl
1101+ 6C48 C9               ret
1102+ 6C49
1103+ 6C49              ; -------------------------------------------------------------------
1104+ 6C49              ; Imposta gli attributi colore per la cella occupata da un nemico 16x16
1105+ 6C49              ; Input: C = X pixel, B = Y pixel, A = Colore Ink (0..7)
1106+ 6C49              ; -------------------------------------------------------------------
1107+ 6C49              SetEnemyColorAttributes:
1108+ 6C49 E5               push hl
1109+ 6C4A D5               push de
1110+ 6C4B C5               push bc
1111+ 6C4C
1112+ 6C4C 57               ld   d, a              ; D = Colore Ink (salvato)
