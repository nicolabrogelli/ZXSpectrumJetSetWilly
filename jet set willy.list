 147+ 749E              ; -------------------------------------------------------------------
 148+ 749E              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 149+ 749E              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 150+ 749E              ; -------------------------------------------------------------------
 151+ 749E              DrawItemGraphic:
 152+ 749E C5               push bc
 153+ 749F D5               push de
 154+ 74A0 E5               push hl
 155+ 74A1
 156+ 74A1                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 157+ 74A1 78               ld   a, b
 158+ 74A2 E6 18            and  $18
 159+ 74A4 C6 40            add  a, $40
 160+ 74A6 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 161+ 74A7
 162+ 74A7 78               ld   a, b
 163+ 74A8 E6 07            and  7
 164+ 74AA 87               add  a, a              ; *2
 165+ 74AB 87               add  a, a              ; *4
 166+ 74AC 87               add  a, a              ; *8
 167+ 74AD 87               add  a, a              ; *16
 168+ 74AE 87               add  a, a              ; *32
 169+ 74AF 81               add  a, c              ; + Col C
 170+ 74B0 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 171+ 74B1
 172+ 74B1                  ; 2. Copia gli 8 byte del bitmap dello sprite
 173+ 74B1 C5               push bc                ; Salva BC (contiene Row e Col)
 174+ 74B2 06 08            ld   b, 8              ; 8 scanline
 175+ 74B4              .line_loop:
 176+ 74B4 7E               ld   a, (hl)
 177+ 74B5 12               ld   (de), a
 178+ 74B6 14               inc  d                 ; Prossima scanline
 179+ 74B7 23               inc  hl
 180+ 74B8 05               dec  b
 181+ 74B9 20 F9            jr   nz, .line_loop
 182+ 74BB C1               pop  bc                ; Ripristina BC
 183+ 74BC
 184+ 74BC                  ; 3. Calcola l'indirizzo degli attributi dello schermo
 185+ 74BC                  ; HL = $5800 + B * 32 + C
 186+ 74BC 26 00            ld   h, 0
 187+ 74BE 68               ld   l, b              ; HL = B (Row)
 188+ 74BF 29               add  hl, hl            ; *2
 189+ 74C0 29               add  hl, hl            ; *4
 190+ 74C1 29               add  hl, hl            ; *8
 191+ 74C2 29               add  hl, hl            ; *16
 192+ 74C3 29               add  hl, hl            ; *32
 193+ 74C4
 194+ 74C4 79               ld   a, c              ; A = Col
 195+ 74C5 85               add  a, l
 196+ 74C6 6F               ld   l, a
 197+ 74C7 30 01            jr   nc, .no_carry
 198+ 74C9 24               inc  h
 199+ 74CA              .no_carry:
 200+ 74CA                  ; HL = B * 32 + C
 201+ 74CA 11 00 58         ld   de, $5800
 202+ 74CD 19               add  hl, de            ; HL = AttrAddr
 203+ 74CE
 204+ 74CE                  ; Ripristina i registri dallo stack per estrarre il colore in E
 205+ 74CE                  ; Lo stack ha: HL (originale), DE (originale con colore in E), BC (originale)
 206+ 74CE C1               pop  bc                ; BC = HL originale
 207+ 74CF D1               pop  de                ; DE = DE originale (colore in E)
 208+ 74D0
 209+ 74D0 7B               ld   a, e              ; A = Colore
 210+ 74D1 77               ld   (hl), a           ; Scrivi in memoria attributi (HL)
 211+ 74D2
 212+ 74D2                  ; Ripristina lo stack e i registri originari
 213+ 74D2 C5               push bc                ; Rimetti HL originale sulla pila
 214+ 74D3 E1               pop  hl                ; HL = HL originale
 215+ 74D4 C1               pop  bc                ; BC = BC originale
 216+ 74D5 C9               ret
 217+ 74D6
 218+ 74D6              ; -------------------------------------------------------------------
 219+ 74D6              ; Ripristina la cella dello sfondo originale per cancellare l'item
 220+ 74D6              ; Input: B = Row (3..18), C = Col (0..31)
 221+ 74D6              ; -------------------------------------------------------------------
 222+ 74D6              RestoreBackgroundCell:
 223+ 74D6 FD E5            push iy                ; Preserva IY
 224+ 74D8 C5               push bc
 225+ 74D9 D5               push de
 226+ 74DA E5               push hl
 227+ 74DB DD E5            push ix
 228+ 74DD
 229+ 74DD C5               push bc
 230+ 74DE FD E1            pop  iy                ; IY = original BC (IYH = Row, IYL = Col)
 231+ 74E0
 232+ 74E0                  ; Riga di layout: r = B - 3
 233+ 74E0 78               ld   a, b
 234+ 74E1 D6 03            sub  3
 235+ 74E3 47               ld   b, a              ; B = r (0..15)
 236+ 74E4
 237+ 74E4                  ; HL = r * 8
 238+ 74E4 68               ld   l, b
 239+ 74E5 26 00            ld   h, 0
 240+ 74E7 29               add  hl, hl
 241+ 74E8 29               add  hl, hl
 242+ 74E9 29               add  hl, hl            ; HL = r * 8
 243+ 74EA
 244+ 74EA                  ; HL = r * 8 + c / 4
 245+ 74EA 79               ld   a, c
 246+ 74EB CB 3F            srl  a
 247+ 74ED CB 3F            srl  a                 ; A = c / 4
 248+ 74EF 85               add  a, l
 249+ 74F0 6F               ld   l, a              ; HL = r * 8 + c / 4
 250+ 74F1
 251+ 74F1 ED 5B A6 77      ld   de, (room_ptr)
 252+ 74F5 19               add  hl, de            ; HL = layout byte address
 253+ 74F6 7E               ld   a, (hl)           ; A = layout byte
 254+ 74F7
 255+ 74F7                  ; Estrai il bit-pair corrispondente a c % 4
 256+ 74F7 57               ld   d, a              ; D = layout byte
 257+ 74F8 79               ld   a, c
 258+ 74F9 E6 03            and  3                 ; A = c % 4
 259+ 74FB 28 15            jr   z, .shift_0
 260+ 74FD 3D               dec  a
 261+ 74FE 28 0B            jr   z, .shift_1
 262+ 7500 3D               dec  a
 263+ 7501 28 03            jr   z, .shift_2
 264+ 7503 7A               ld   a, d
 265+ 7504 18 0F            jr   .got_type
 266+ 7506              .shift_2:
 267+ 7506 7A               ld   a, d
 268+ 7507 0F               rrca
 269+ 7508 0F               rrca
 270+ 7509 18 0A            jr   .got_type
 271+ 750B              .shift_1:
 272+ 750B 7A               ld   a, d
 273+ 750C 0F               rrca
 274+ 750D 0F               rrca
 275+ 750E 0F               rrca
 276+ 750F 0F               rrca
 277+ 7510 18 03            jr   .got_type
 278+ 7512              .shift_0:
 279+ 7512 7A               ld   a, d
 280+ 7513 07               rlca
 281+ 7514 07               rlca
 282+ 7515              .got_type:
 283+ 7515 E6 03            and  3                 ; A = cell type (0..3)
 284+ 7517
 285+ 7517 ED 5B A6 77      ld   de, (room_ptr)
 286+ 751B B7               or   a
 287+ 751C 20 06            jr   nz, .not_bg
 288+ 751E 21 A0 00         ld   hl, OFFSET_BG
 289+ 7521 19               add  hl, de
 290+ 7522 18 16            jr   .draw_cell
 291+ 7524              .not_bg:
 292+ 7524 3D               dec  a
 293+ 7525 20 06            jr   nz, .not_floor
 294+ 7527 21 A9 00         ld   hl, OFFSET_FLOOR
 295+ 752A 19               add  hl, de
 296+ 752B 18 0D            jr   .draw_cell
 297+ 752D              .not_floor:
 298+ 752D 3D               dec  a
 299+ 752E 20 06            jr   nz, .not_wall
 300+ 7530 21 B2 00         ld   hl, OFFSET_WALL
 301+ 7533 19               add  hl, de
 302+ 7534 18 04            jr   .draw_cell
 303+ 7536              .not_wall:
 304+ 7536 21 BB 00         ld   hl, OFFSET_NASTY
 305+ 7539 19               add  hl, de
 306+ 753A
 307+ 753A              .draw_cell:
 308+ 753A E5               push hl
 309+ 753B DD E1            pop  ix                ; IX = tile pointer
 310+ 753D
 311+ 753D FD E5            push iy
 312+ 753F C1               pop  bc                ; B = Row, C = Col
 313+ 7540
 314+ 7540 CD 6A 61         call DrawTile
 315+ 7543
 316+ 7543 DD E1            pop  ix
 317+ 7545 E1               pop  hl
 318+ 7546 D1               pop  de
 319+ 7547 C1               pop  bc
 320+ 7548 FD E1            pop  iy                ; Ripristina IY
 321+ 754A C9               ret
