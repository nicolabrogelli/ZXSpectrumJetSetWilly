1075+ 7F43              ; -------------------------------------------------------------------
1076+ 7F43              ; Items_DrawRoom
1077+ 7F43              ;
1078+ 7F43              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1079+ 7F43              ;
1080+ 7F43              ; Operazioni eseguite:
1081+ 7F43              ;   1. Azzera la griglia items_grid.
1082+ 7F43              ;   2. Svuota la cache degli oggetti attivi.
1083+ 7F43              ;   3. Scansiona ItemsTable.
1084+ 7F43              ;   4. Per ogni item della stanza corrente:
1085+ 7F43              ;        - verifica se è già stato raccolto
1086+ 7F43              ;        - disegna la grafica
1087+ 7F43              ;        - aggiorna items_grid
1088+ 7F43              ;        - memorizza l'item nella cache current_room_items
1089+ 7F43              ;   5. Aggiorna num_room_items.
1090+ 7F43              ;
1091+ 7F43              ; Record ItemsTable:
1092+ 7F43              ;   +0  Room ID
1093+ 7F43              ;   +1  X (colonna)
1094+ 7F43              ;   +2  Y (riga)
1095+ 7F43              ;   +3  Colore
1096+ 7F43              ;   +4  Collected flag
1097+ 7F43              ;
1098+ 7F43              ; Cache current_room_items:
1099+ 7F43              ;   +0  Colonna
1100+ 7F43              ;   +1  Riga
1101+ 7F43              ;   +2  Colore
1102+ 7F43              ;   +3  Collected flag ptr (Low)
1103+ 7F43              ;   +4  Collected flag ptr (High)
1104+ 7F43              ;
1105+ 7F43              ; Ogni record cache occupa 5 byte.
1106+ 7F43              ; -------------------------------------------------------------------
1107+ 7F43              ; ResetItemsTable
1108+ 7F43              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1109+ 7F43              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1110+ 7F43              ; -------------------------------------------------------------------
1111+ 7F43              ResetItemsTable:
1112+ 7F43 21 EC 79         ld   hl, ItemsTable
1113+ 7F46              .reset_loop:
1114+ 7F46 7E               ld   a, (hl)
1115+ 7F47 FE FF            cp   $FF
1116+ 7F49 C8               ret  z
1117+ 7F4A 23               inc  hl                        ; +1 (X)
1118+ 7F4B 23               inc  hl                        ; +2 (Y)
1119+ 7F4C 23               inc  hl                        ; +3 (Color)
1120+ 7F4D 23               inc  hl                        ; +4 (Collected flag)
1121+ 7F4E 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1122+ 7F50 23               inc  hl                        ; Prossimo record
1123+ 7F51 18 F3            jr   .reset_loop
1124+ 7F53
1125+ 7F53              ; -------------------------------------------------------------------
1126+ 7F53              Items_DrawRoom:
1127+ 7F53
1128+ 7F53                  ; Salva tutti i registri utilizzati
1129+ 7F53 E5               push hl
1130+ 7F54 D5               push de
1131+ 7F55 C5               push bc
1132+ 7F56 DD E5            push ix
1133+ 7F58 FD E5            push iy
1134+ 7F5A
1135+ 7F5A                  ; ---------------------------------------------------------------
1136+ 7F5A                  ; Azzera items_grid (32 x 16 = 512 byte)
1137+ 7F5A                  ; ---------------------------------------------------------------
1138+ 7F5A 21 26 E4         ld   hl, items_grid
1139+ 7F5D 11 27 E4         ld   de, items_grid + 1
1140+ 7F60 36 00            ld   (hl), 0
1141+ 7F62 01 FF 01         ld   bc, 511
1142+ 7F65 ED B0            ldir
1143+ 7F67
1144+ 7F67                  ; ---------------------------------------------------------------
1145+ 7F67                  ; Nessun item attivo nella stanza
1146+ 7F67                  ; ---------------------------------------------------------------
1147+ 7F67 AF               xor  a
1148+ 7F68 32 A5 E9         ld   (num_room_items), a
1149+ 7F6B
1150+ 7F6B                  ; IY punta alla cache degli item attivi
1151+ 7F6B FD 21 55 E9      ld   iy, current_room_items
1152+ 7F6F
1153+ 7F6F                  ; ---------------------------------------------------------------
1154+ 7F6F                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1155+ 7F6F                  ; alla stanza corrente.
1156+ 7F6F                  ;
1157+ 7F6F                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1158+ 7F6F                  ; ---------------------------------------------------------------
1159+ 7F6F 2A A6 E9         ld   hl, (room_ptr)
1160+ 7F72 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1161+ 7F75 19               add  hl, de
1162+ 7F76
1163+ 7F76 E5               push hl
1164+ 7F77 DD E1            pop  ix                ; IX = bitmap item
1165+ 7F79
1166+ 7F79                  ; ---------------------------------------------------------------
1167+ 7F79                  ; Inizio scansione della tabella degli item
1168+ 7F79                  ; ---------------------------------------------------------------
1169+ 7F79 21 EC 79         ld   hl, ItemsTable
1170+ 7F7C
1171+ 7F7C              .loop:
1172+ 7F7C
1173+ 7F7C                  ; ---------------------------------------------------------------
1174+ 7F7C                  ; Legge il Room ID del record corrente
1175+ 7F7C                  ; ---------------------------------------------------------------
1176+ 7F7C 7E               ld   a, (hl)
1177+ 7F7D
1178+ 7F7D                  ; $FF indica fine tabella
1179+ 7F7D FE FF            cp   $FF
1180+ 7F7F 28 53            jr   z, .done
1181+ 7F81
1182+ 7F81                  ; ---------------------------------------------------------------
1183+ 7F81                  ; Verifica se l'item appartiene alla stanza corrente
1184+ 7F81                  ; ---------------------------------------------------------------
1185+ 7F81 57               ld   d, a
1186+ 7F82
1187+ 7F82 3A 4C E9         ld   a, (current_room)
1188+ 7F85 BA               cp   d
1189+ 7F86 20 45            jr   nz, .next_item
1190+ 7F88
1191+ 7F88                  ; ---------------------------------------------------------------
1192+ 7F88                  ; Legge i dati dell'item
1193+ 7F88                  ; ---------------------------------------------------------------
1194+ 7F88
1195+ 7F88 23               inc  hl
1196+ 7F89 4E               ld   c, (hl)           ; X (colonna)
1197+ 7F8A
1198+ 7F8A 23               inc  hl
1199+ 7F8B 46               ld   b, (hl)           ; Y (riga)
1200+ 7F8C
1201+ 7F8C 23               inc  hl
1202+ 7F8D 5E               ld   e, (hl)           ; Colore
1203+ 7F8E
1204+ 7F8E 23               inc  hl
1205+ 7F8F 7E               ld   a, (hl)           ; Collected flag
1206+ 7F90
1207+ 7F90                  ; Se diverso da zero l'item è già stato raccolto
1208+ 7F90 B7               or   a
1209+ 7F91 20 3E            jr   nz, .next_no_inc
1210+ 7F93
1211+ 7F93                  ; ---------------------------------------------------------------
1212+ 7F93                  ; Disegna l'item sullo schermo
1213+ 7F93                  ;
1214+ 7F93                  ; B = Row
1215+ 7F93                  ; C = Column
1216+ 7F93                  ; HL = bitmap pointer
1217+ 7F93                  ; E = Color
1218+ 7F93                  ; ---------------------------------------------------------------
1219+ 7F93 E5               push hl
1220+ 7F94
1221+ 7F94 DD E5            push ix
1222+ 7F96 E1               pop  hl
1223+ 7F97
1224+ 7F97 CD DC 7F         call DrawItemGraphic
1225+ 7F9A
1226+ 7F9A E1               pop  hl                ; ritorna al flag collected
1227+ 7F9B
1228+ 7F9B                  ; ---------------------------------------------------------------
1229+ 7F9B                  ; Aggiorna items_grid
1230+ 7F9B                  ;
1231+ 7F9B                  ; Calcolo:
1232+ 7F9B                  ;   offset = Row * 32 + Col
1233+ 7F9B                  ; ---------------------------------------------------------------
1234+ 7F9B E5               push hl
1235+ 7F9C D5               push de
1236+ 7F9D
1237+ 7F9D 26 00            ld   h, 0
1238+ 7F9F 68               ld   l, b              ; HL = Row
1239+ 7FA0
1240+ 7FA0 29               add  hl, hl            ; *2
1241+ 7FA1 29               add  hl, hl            ; *4
1242+ 7FA2 29               add  hl, hl            ; *8
1243+ 7FA3 29               add  hl, hl            ; *16
1244+ 7FA4 29               add  hl, hl            ; *32
1245+ 7FA5
1246+ 7FA5 16 00            ld   d, 0
1247+ 7FA7 59               ld   e, c              ; DE = Col
1248+ 7FA8
1249+ 7FA8 19               add  hl, de            ; Row*32 + Col
1250+ 7FA9
1251+ 7FA9 11 26 E4         ld   de, items_grid
1252+ 7FAC 19               add  hl, de            ; puntatore nella griglia
1253+ 7FAD
1254+ 7FAD D1               pop  de                ; ripristina colore
1255+ 7FAE
1256+ 7FAE 73               ld   (hl), e           ; salva colore cella
1257+ 7FAF
1258+ 7FAF E1               pop  hl
1259+ 7FB0
1260+ 7FB0                  ; ---------------------------------------------------------------
1261+ 7FB0                  ; Salva l'item nella cache della stanza
1262+ 7FB0                  ;
1263+ 7FB0                  ; Questo evita di dover scansionare tutta ItemsTable
1264+ 7FB0                  ; durante il controllo delle collisioni.
1265+ 7FB0                  ; ---------------------------------------------------------------
1266+ 7FB0
1267+ 7FB0 FD 71 00         ld   (iy+0), c         ; Colonna
1268+ 7FB3 FD 70 01         ld   (iy+1), b         ; Riga
1269+ 7FB6 FD 73 02         ld   (iy+2), e         ; Colore
1270+ 7FB9
1271+ 7FB9                  ; Salva il puntatore al flag "collected"
1272+ 7FB9 FD 75 03         ld   (iy+3), l         ; Low byte
1273+ 7FBC FD 74 04         ld   (iy+4), h         ; High byte
1274+ 7FBF
1275+ 7FBF                  ; Passa al record successivo della cache
1276+ 7FBF 01 05 00         ld   bc, 5
1277+ 7FC2 FD 09            add  iy, bc
1278+ 7FC4
1279+ 7FC4                  ; Incrementa il numero di item attivi
1280+ 7FC4 3A A5 E9         ld   a, (num_room_items)
1281+ 7FC7 3C               inc  a
1282+ 7FC8 32 A5 E9         ld   (num_room_items), a
1283+ 7FCB
1284+ 7FCB 18 04            jr   .next_no_inc
1285+ 7FCD
1286+ 7FCD              .next_item:
1287+ 7FCD
1288+ 7FCD                  ; ---------------------------------------------------------------
1289+ 7FCD                  ; L'item non appartiene alla stanza corrente.
1290+ 7FCD                  ; Salta i campi del record:
1291+ 7FCD                  ;   X
1292+ 7FCD                  ;   Y
1293+ 7FCD                  ;   Color
1294+ 7FCD                  ;   Collected
1295+ 7FCD                  ; ---------------------------------------------------------------
1296+ 7FCD 23               inc  hl
1297+ 7FCE 23               inc  hl
1298+ 7FCF 23               inc  hl
1299+ 7FD0 23               inc  hl
1300+ 7FD1
1301+ 7FD1              .next_no_inc:
1302+ 7FD1
1303+ 7FD1                  ; ---------------------------------------------------------------
1304+ 7FD1                  ; Avanza al record successivo
1305+ 7FD1                  ; (prossimo Room ID)
1306+ 7FD1                  ; ---------------------------------------------------------------
1307+ 7FD1 23               inc  hl
1308+ 7FD2 18 A8            jr   .loop
1309+ 7FD4
1310+ 7FD4              .done:
1311+ 7FD4
1312+ 7FD4                  ; Ripristina i registri
1313+ 7FD4 FD E1            pop  iy
1314+ 7FD6 DD E1            pop  ix
1315+ 7FD8 D1               pop  de
1316+ 7FD9 C1               pop  bc
1317+ 7FDA E1               pop  hl
1318+ 7FDB
1319+ 7FDB C9               ret
