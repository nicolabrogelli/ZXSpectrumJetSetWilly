 876+ 7D8C 32 6D EE         ld   (enemy_update_timer), a
 877+ 7D8F 18 00            jr   .do_update
 878+ 7D91
 879+ 7D91              .do_update:
 880+ 7D91 3E 01            ld   a, 1
 881+ 7D93 32 F3 EE         ld   (enemy_was_updated), a
 882+ 7D96
 883+ 7D96 DD 21 64 78      ld   ix, ActiveEnemies
 884+ 7D9A 06 08            ld   b, 8              ; 8 slot
 885+ 7D9C              .loop:
 886+ 7D9C DD 7E 00         ld   a, (ix+0)         ; Flags
 887+ 7D9F E6 80            and  $80               ; Active?
 888+ 7DA1 CA 73 7E         jp   z, .next
 889+ 7DA4
 890+ 7DA4                  ; 1. Aggiorna Anim State
 891+ 7DA4 DD 7E 01         ld   a, (ix+1)         ; Sprite Type (Offset 1)
 892+ 7DA7 E6 3F            and  $3F               ; Tipo
 893+ 7DA9 FE 0D            cp   13                ; Tipo 13 = Canguro?
 894+ 7DAB 28 2A            jr   z, .canguro_anim
 895+ 7DAD FE 0B            cp   11                ; Tipo 11 = Soldato?
 896+ 7DAF 28 1B            jr   z, .soldato_anim
 897+ 7DB1 FE 10            cp   16                ; Tipo 16 = Candelabro?
 898+ 7DB3 28 17            jr   z, .soldato_anim
 899+ 7DB5 FE 14            cp   20                ; Tipo 20 = Nonnino?
 900+ 7DB7 28 13            jr   z, .soldato_anim
 901+ 7DB9 FE 15            cp   21                ; Tipo 21 = Parrucca?
 902+ 7DBB 28 0F            jr   z, .soldato_anim
 903+ 7DBD FE 1D            cp   29                ; Tipo 29 = Saliera?
 904+ 7DBF 28 0B            jr   z, .soldato_anim
 905+ 7DC1
 906+ 7DC1 DD 7E 07         ld   a, (ix+7)         ; Anim State (Offset 7)
 907+ 7DC4 3C               inc  a
 908+ 7DC5 E6 03            and  3                 ; Alterna 0..3
 909+ 7DC7 DD 77 07         ld   (ix+7), a
 910+ 7DCA 18 14            jr   .anim_done
 911+ 7DCC
 912+ 7DCC              .soldato_anim:
 913+ 7DCC DD 7E 07         ld   a, (ix+7)         ; Anim State
 914+ 7DCF 3C               inc  a
 915+ 7DD0 E6 01            and  1                 ; Alterna 0..1
 916+ 7DD2 DD 77 07         ld   (ix+7), a
 917+ 7DD5 18 09            jr   .anim_done
 918+ 7DD7
 919+ 7DD7              .canguro_anim:
