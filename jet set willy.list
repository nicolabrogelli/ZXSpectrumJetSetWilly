 672+ 6A7F                  ; Controlla se Row corrisponde
 673+ 6A7F 3A 3E 7D         ld   a, (conveyor_row)
 674+ 6A82 BA               cp   d
 675+ 6A83 20 16            jr   nz, .check_ramp   ; Row diversa, controlla rampa
 676+ 6A85
 677+ 6A85                  ; Controlla se Col è compresa: c >= conveyor_col e c < conveyor_col + conveyor_len
 678+ 6A85 3A 3F 7D         ld   a, (conveyor_col)
 679+ 6A88 BB               cp   e
 680+ 6A89 28 0E            jr   z, .is_conveyor   ; c == conveyor_col -> solido!
 681+ 6A8B 38 02            jr   c, .c_greater     ; c > conveyor_col -> controlla limite superiore
 682+ 6A8D 18 0C            jr   .check_ramp       ; c < conveyor_col
 683+ 6A8F              .c_greater:
 684+ 6A8F 47               ld   b, a              ; B = conveyor_col
 685+ 6A90 3A 3D 7D         ld   a, (conveyor_len)
