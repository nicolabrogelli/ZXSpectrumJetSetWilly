 610+ 77A6
 611+ 77A6              ; -------------------------------------------------------------------
 612+ 77A6              ; Items_DrawRoom
 613+ 77A6              ;
 614+ 77A6              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 615+ 77A6              ;
 616+ 77A6              ; Operazioni eseguite:
 617+ 77A6              ;   1. Azzera la griglia items_grid.
 618+ 77A6              ;   2. Svuota la cache degli oggetti attivi.
 619+ 77A6              ;   3. Scansiona ItemsTable.
 620+ 77A6              ;   4. Per ogni item della stanza corrente:
 621+ 77A6              ;        - verifica se è già stato raccolto
 622+ 77A6              ;        - disegna la grafica
 623+ 77A6              ;        - aggiorna items_grid
 624+ 77A6              ;        - memorizza l'item nella cache current_room_items
 625+ 77A6              ;   5. Aggiorna num_room_items.
 626+ 77A6              ;
 627+ 77A6              ; Record ItemsTable:
 628+ 77A6              ;   +0  Room ID
 629+ 77A6              ;   +1  X (colonna)
 630+ 77A6              ;   +2  Y (riga)
 631+ 77A6              ;   +3  Colore
 632+ 77A6              ;   +4  Collected flag
 633+ 77A6              ;
 634+ 77A6              ; Cache current_room_items:
 635+ 77A6              ;   +0  Colonna
 636+ 77A6              ;   +1  Riga
 637+ 77A6              ;   +2  Colore
 638+ 77A6              ;   +3  Collected flag ptr (Low)
 639+ 77A6              ;   +4  Collected flag ptr (High)
 640+ 77A6              ;
 641+ 77A6              ; Ogni record cache occupa 5 byte.
 642+ 77A6              ; -------------------------------------------------------------------
 643+ 77A6              Items_DrawRoom:
 644+ 77A6
 645+ 77A6                  ; Salva tutti i registri utilizzati
 646+ 77A6 E5               push hl
 647+ 77A7 D5               push de
 648+ 77A8 C5               push bc
 649+ 77A9 DD E5            push ix
 650+ 77AB FD E5            push iy
 651+ 77AD
 652+ 77AD                  ; ---------------------------------------------------------------
 653+ 77AD                  ; Azzera items_grid (32 x 16 = 512 byte)
 654+ 77AD                  ; ---------------------------------------------------------------
 655+ 77AD 21 00 B0         ld   hl, items_grid
 656+ 77B0 11 01 B0         ld   de, items_grid + 1
 657+ 77B3 36 00            ld   (hl), 0
 658+ 77B5 01 FF 01         ld   bc, 511
 659+ 77B8 ED B0            ldir
 660+ 77BA
 661+ 77BA                  ; ---------------------------------------------------------------
 662+ 77BA                  ; Nessun item attivo nella stanza
 663+ 77BA                  ; ---------------------------------------------------------------
 664+ 77BA AF               xor  a
 665+ 77BB 32 FC 7D         ld   (num_room_items), a
 666+ 77BE
 667+ 77BE                  ; IY punta alla cache degli item attivi
 668+ 77BE FD 21 AC 7D      ld   iy, current_room_items
 669+ 77C2
 670+ 77C2                  ; ---------------------------------------------------------------
 671+ 77C2                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 672+ 77C2                  ; alla stanza corrente.
 673+ 77C2                  ;
 674+ 77C2                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 675+ 77C2                  ; ---------------------------------------------------------------
 676+ 77C2 2A FD 7D         ld   hl, (room_ptr)
 677+ 77C5 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 678+ 77C8 19               add  hl, de
 679+ 77C9
 680+ 77C9 E5               push hl
 681+ 77CA DD E1            pop  ix                ; IX = bitmap item
 682+ 77CC
 683+ 77CC                  ; ---------------------------------------------------------------
 684+ 77CC                  ; Inizio scansione della tabella degli item
 685+ 77CC                  ; ---------------------------------------------------------------
 686+ 77CC 21 CE 74         ld   hl, ItemsTable
 687+ 77CF
 688+ 77CF              .loop:
 689+ 77CF
 690+ 77CF                  ; ---------------------------------------------------------------
 691+ 77CF                  ; Legge il Room ID del record corrente
 692+ 77CF                  ; ---------------------------------------------------------------
 693+ 77CF 7E               ld   a, (hl)
 694+ 77D0
 695+ 77D0                  ; $FF indica fine tabella
 696+ 77D0 FE FF            cp   $FF
 697+ 77D2 28 53            jr   z, .done
 698+ 77D4
 699+ 77D4                  ; ---------------------------------------------------------------
 700+ 77D4                  ; Verifica se l'item appartiene alla stanza corrente
 701+ 77D4                  ; ---------------------------------------------------------------
 702+ 77D4 57               ld   d, a
 703+ 77D5
 704+ 77D5 3A A3 7D         ld   a, (current_room)
 705+ 77D8 BA               cp   d
 706+ 77D9 20 45            jr   nz, .next_item
 707+ 77DB
 708+ 77DB                  ; ---------------------------------------------------------------
 709+ 77DB                  ; Legge i dati dell'item
 710+ 77DB                  ; ---------------------------------------------------------------
 711+ 77DB
 712+ 77DB 23               inc  hl
 713+ 77DC 4E               ld   c, (hl)           ; X (colonna)
 714+ 77DD
 715+ 77DD 23               inc  hl
 716+ 77DE 46               ld   b, (hl)           ; Y (riga)
 717+ 77DF
 718+ 77DF 23               inc  hl
 719+ 77E0 5E               ld   e, (hl)           ; Colore
 720+ 77E1
 721+ 77E1 23               inc  hl
 722+ 77E2 7E               ld   a, (hl)           ; Collected flag
 723+ 77E3
 724+ 77E3                  ; Se diverso da zero l'item è già stato raccolto
 725+ 77E3 B7               or   a
 726+ 77E4 20 3E            jr   nz, .next_no_inc
 727+ 77E6
 728+ 77E6                  ; ---------------------------------------------------------------
 729+ 77E6                  ; Disegna l'item sullo schermo
 730+ 77E6                  ;
 731+ 77E6                  ; B = Row
 732+ 77E6                  ; C = Column
 733+ 77E6                  ; HL = bitmap pointer
 734+ 77E6                  ; E = Color
 735+ 77E6                  ; ---------------------------------------------------------------
 736+ 77E6 E5               push hl
 737+ 77E7
 738+ 77E7 DD E5            push ix
 739+ 77E9 E1               pop  hl
 740+ 77EA
 741+ 77EA CD 2F 78         call DrawItemGraphic
 742+ 77ED
 743+ 77ED E1               pop  hl                ; ritorna al flag collected
 744+ 77EE
 745+ 77EE                  ; ---------------------------------------------------------------
 746+ 77EE                  ; Aggiorna items_grid
 747+ 77EE                  ;
 748+ 77EE                  ; Calcolo:
 749+ 77EE                  ;   offset = Row * 32 + Col
 750+ 77EE                  ; ---------------------------------------------------------------
 751+ 77EE E5               push hl
 752+ 77EF D5               push de
 753+ 77F0
 754+ 77F0 26 00            ld   h, 0
 755+ 77F2 68               ld   l, b              ; HL = Row
 756+ 77F3
 757+ 77F3 29               add  hl, hl            ; *2
 758+ 77F4 29               add  hl, hl            ; *4
 759+ 77F5 29               add  hl, hl            ; *8
 760+ 77F6 29               add  hl, hl            ; *16
 761+ 77F7 29               add  hl, hl            ; *32
 762+ 77F8
 763+ 77F8 16 00            ld   d, 0
 764+ 77FA 59               ld   e, c              ; DE = Col
 765+ 77FB
 766+ 77FB 19               add  hl, de            ; Row*32 + Col
 767+ 77FC
 768+ 77FC 11 00 B0         ld   de, items_grid
 769+ 77FF 19               add  hl, de            ; puntatore nella griglia
 770+ 7800
 771+ 7800 D1               pop  de                ; ripristina colore
 772+ 7801
 773+ 7801 73               ld   (hl), e           ; salva colore cella
 774+ 7802
 775+ 7802 E1               pop  hl
 776+ 7803
 777+ 7803                  ; ---------------------------------------------------------------
 778+ 7803                  ; Salva l'item nella cache della stanza
 779+ 7803                  ;
 780+ 7803                  ; Questo evita di dover scansionare tutta ItemsTable
 781+ 7803                  ; durante il controllo delle collisioni.
 782+ 7803                  ; ---------------------------------------------------------------
 783+ 7803
 784+ 7803 FD 71 00         ld   (iy+0), c         ; Colonna
 785+ 7806 FD 70 01         ld   (iy+1), b         ; Riga
 786+ 7809 FD 73 02         ld   (iy+2), e         ; Colore
 787+ 780C
 788+ 780C                  ; Salva il puntatore al flag "collected"
 789+ 780C FD 75 03         ld   (iy+3), l         ; Low byte
 790+ 780F FD 74 04         ld   (iy+4), h         ; High byte
 791+ 7812
 792+ 7812                  ; Passa al record successivo della cache
 793+ 7812 01 05 00         ld   bc, 5
 794+ 7815 FD 09            add  iy, bc
 795+ 7817
 796+ 7817                  ; Incrementa il numero di item attivi
 797+ 7817 3A FC 7D         ld   a, (num_room_items)
 798+ 781A 3C               inc  a
 799+ 781B 32 FC 7D         ld   (num_room_items), a
 800+ 781E
 801+ 781E 18 04            jr   .next_no_inc
 802+ 7820
 803+ 7820              .next_item:
 804+ 7820
 805+ 7820                  ; ---------------------------------------------------------------
 806+ 7820                  ; L'item non appartiene alla stanza corrente.
 807+ 7820                  ; Salta i campi del record:
 808+ 7820                  ;   X
 809+ 7820                  ;   Y
 810+ 7820                  ;   Color
 811+ 7820                  ;   Collected
 812+ 7820                  ; ---------------------------------------------------------------
 813+ 7820 23               inc  hl
 814+ 7821 23               inc  hl
 815+ 7822 23               inc  hl
 816+ 7823 23               inc  hl
 817+ 7824
 818+ 7824              .next_no_inc:
 819+ 7824
 820+ 7824                  ; ---------------------------------------------------------------
 821+ 7824                  ; Avanza al record successivo
 822+ 7824                  ; (prossimo Room ID)
 823+ 7824                  ; ---------------------------------------------------------------
 824+ 7824 23               inc  hl
 825+ 7825 18 A8            jr   .loop
 826+ 7827
 827+ 7827              .done:
 828+ 7827
 829+ 7827                  ; Ripristina i registri
 830+ 7827 FD E1            pop  iy
 831+ 7829 DD E1            pop  ix
 832+ 782B D1               pop  de
 833+ 782C C1               pop  bc
 834+ 782D E1               pop  hl
 835+ 782E
 836+ 782E C9               ret
 837+ 782F
 838+ 782F              ; -------------------------------------------------------------------
 839+ 782F              ; DrawItemGraphic
 840+ 782F              ;
 841+ 782F              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 842+ 782F              ; utilizzando una bitmap di 8 byte e un attributo colore.
 843+ 782F              ;
 844+ 782F              ; Input:
 845+ 782F              ;   B = Riga attributi (3..18)
 846+ 782F              ;   C = Colonna attributi (0..31)
 847+ 782F              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 848+ 782F              ;   E = Attributo colore
 849+ 782F              ;
 850+ 782F              ; Output:
 851+ 782F              ;   Nessuno
 852+ 782F              ;
 853+ 782F              ; Registri preservati:
 854+ 782F              ;   BC, DE, HL
 855+ 782F              ; -------------------------------------------------------------------
 856+ 782F              DrawItemGraphic:
 857+ 782F
 858+ 782F                  ; Salva i registri originali
 859+ 782F C5               push bc
 860+ 7830 D5               push de
 861+ 7831 E5               push hl
 862+ 7832
 863+ 7832                  ; ---------------------------------------------------------------
 864+ 7832                  ; Calcolo indirizzo bitmap dello Spectrum
 865+ 7832                  ;
 866+ 7832                  ; Ogni item occupa una cella attributi (8x8 pixel).
 867+ 7832                  ;
 868+ 7832                  ; Formula:
 869+ 7832                  ;   High = $40 + (Row AND $18)
 870+ 7832                  ;   Low  = (Row AND 7) * 32 + Col
 871+ 7832                  ;
 872+ 7832                  ; DE conterrà l'indirizzo della prima scanline.
 873+ 7832                  ; ---------------------------------------------------------------
 874+ 7832
 875+ 7832 78               ld   a, b
 876+ 7833 E6 18            and  $18
 877+ 7835 C6 40            add  a, $40
 878+ 7837 57               ld   d, a              ; Byte alto indirizzo video
 879+ 7838
 880+ 7838 78               ld   a, b
 881+ 7839 E6 07            and  7                 ; Riga interna al blocco da 8
 882+ 783B
 883+ 783B 87               add  a, a              ; *2
 884+ 783C 87               add  a, a              ; *4
 885+ 783D 87               add  a, a              ; *8
 886+ 783E 87               add  a, a              ; *16
 887+ 783F 87               add  a, a              ; *32
 888+ 7840
 889+ 7840 81               add  a, c              ; + colonna
 890+ 7841
 891+ 7841 5F               ld   e, a              ; Byte basso indirizzo video
 892+ 7842
 893+ 7842                  ; ---------------------------------------------------------------
 894+ 7842                  ; Disegno bitmap
 895+ 7842                  ;
 896+ 7842                  ; Copia 8 byte consecutivi nella memoria video.
 897+ 7842                  ; Ogni byte rappresenta una scanline da 8 pixel.
 898+ 7842                  ; ---------------------------------------------------------------
 899+ 7842
 900+ 7842 C5               push bc                ; Conserva Row e Col
 901+ 7843
 902+ 7843 06 08            ld   b, 8              ; Numero scanline
 903+ 7845
 904+ 7845              .line_loop:
 905+ 7845
 906+ 7845 7E               ld   a, (hl)           ; Legge scanline bitmap
 907+ 7846 12               ld   (de), a           ; Scrive nella memoria video
 908+ 7847
 909+ 7847 14               inc  d                 ; Scanline successiva
 910+ 7848 23               inc  hl                ; Byte bitmap successivo
 911+ 7849
 912+ 7849 05               dec  b
 913+ 784A 20 F9            jr   nz, .line_loop
 914+ 784C
 915+ 784C C1               pop  bc                ; Ripristina Row e Col
 916+ 784D
 917+ 784D                  ; ---------------------------------------------------------------
 918+ 784D                  ; Calcolo indirizzo attributo
 919+ 784D                  ;
 920+ 784D                  ; Formula:
 921+ 784D                  ;   AttrAddr = $5800 + Row * 32 + Col
 922+ 784D                  ;
 923+ 784D                  ; HL conterrà l'indirizzo della cella attributi.
 924+ 784D                  ; ---------------------------------------------------------------
 925+ 784D
 926+ 784D 26 00            ld   h, 0
 927+ 784F 68               ld   l, b              ; HL = Row
 928+ 7850
 929+ 7850 29               add  hl, hl            ; *2
 930+ 7851 29               add  hl, hl            ; *4
 931+ 7852 29               add  hl, hl            ; *8
 932+ 7853 29               add  hl, hl            ; *16
 933+ 7854 29               add  hl, hl            ; *32
 934+ 7855
 935+ 7855 79               ld   a, c              ; A = Colonna
 936+ 7856
 937+ 7856 85               add  a, l
 938+ 7857 6F               ld   l, a
 939+ 7858
 940+ 7858 30 01            jr   nc, .no_carry
 941+ 785A 24               inc  h
 942+ 785B
 943+ 785B              .no_carry:
 944+ 785B
 945+ 785B                  ; HL = Row * 32 + Col
 946+ 785B
 947+ 785B 11 00 58         ld   de, $5800
 948+ 785E 19               add  hl, de            ; HL = indirizzo attributi
 949+ 785F
 950+ 785F                  ; ---------------------------------------------------------------
 951+ 785F                  ; Recupera il colore originale dallo stack.
 952+ 785F                  ;
 953+ 785F                  ; Layout stack:
 954+ 785F                  ;   HL originale
 955+ 785F                  ;   DE originale (E = colore)
 956+ 785F                  ;   BC originale
 957+ 785F                  ; ---------------------------------------------------------------
 958+ 785F
 959+ 785F C1               pop  bc                ; Recupera HL originale
 960+ 7860 D1               pop  de                ; Recupera DE originale
 961+ 7861
 962+ 7861                  ; ---------------------------------------------------------------
 963+ 7861                  ; Scrive l'attributo colore
 964+ 7861                  ; ---------------------------------------------------------------
 965+ 7861
 966+ 7861 7B               ld   a, e              ; A = colore
 967+ 7862 77               ld   (hl), a           ; Scrive nella RAM attributi
 968+ 7863
 969+ 7863                  ; ---------------------------------------------------------------
 970+ 7863                  ; Ripristina HL e BC originali
 971+ 7863                  ; ---------------------------------------------------------------
 972+ 7863
 973+ 7863 C5               push bc
 974+ 7864 E1               pop  hl                ; HL originale
 975+ 7865
 976+ 7865 C1               pop  bc                ; BC originale
 977+ 7866
 978+ 7866 C9               ret
 979+ 7867
 980+ 7867              ; -------------------------------------------------------------------
 981+ 7867              ; RestoreBackgroundCell
 982+ 7867              ;
 983+ 7867              ; Ripristina il contenuto originale di una cella della stanza.
 984+ 7867              ; Viene utilizzata principalmente quando un item viene raccolto:
 985+ 7867              ; invece di lasciare un "buco", la routine ridisegna il tile
 986+ 7867              ; originale presente nella mappa della stanza.
 987+ 7867              ;
 988+ 7867              ; Input:
 989+ 7867              ;   B = Row (3..18)
 990+ 7867              ;   C = Col (0..31)
 991+ 7867              ;
 992+ 7867              ; Utilizza:
 993+ 7867              ;   room_ptr -> struttura dati della stanza corrente
 994+ 7867              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 995+ 7867              ;   Gfx_DrawTile -> ridisegna il tile selezionato
 996+ 7867              ;
 997+ 7867              ; Tipi di cella:
 998+ 7867              ;   0 = Background
 999+ 7867              ;   1 = Floor
1000+ 7867              ;   2 = Wall
1001+ 7867              ;   3 = Nasty
1002+ 7867              ; -------------------------------------------------------------------
1003+ 7867              RestoreBackgroundCell:
1004+ 7867
1005+ 7867                  ; Salva tutti i registri utilizzati
1006+ 7867 FD E5            push iy
1007+ 7869 C5               push bc
1008+ 786A D5               push de
1009+ 786B E5               push hl
1010+ 786C DD E5            push ix
1011+ 786E
1012+ 786E                  ; ---------------------------------------------------------------
1013+ 786E                  ; Conserva Row e Col in IY.
1014+ 786E                  ;
1015+ 786E                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1016+ 786E                  ; BC potrebbe essere modificato.
1017+ 786E                  ; ---------------------------------------------------------------
1018+ 786E C5               push bc
1019+ 786F FD E1            pop  iy                ; IYH = Row, IYL = Col
1020+ 7871
1021+ 7871                  ; ---------------------------------------------------------------
1022+ 7871                  ; Determina quale tipo di cella è presente nella posizione
1023+ 7871                  ; specificata.
1024+ 7871                  ;
1025+ 7871                  ; Input:
1026+ 7871                  ;   B = Row
1027+ 7871                  ;   C = Col
1028+ 7871                  ;
1029+ 7871                  ; Output:
1030+ 7871                  ;   A = tipo cella
1031+ 7871                  ; ---------------------------------------------------------------
1032+ 7871 78               ld   a, b
1033+ 7872
1034+ 7872 CD 86 6C         call GetCellFromUnpacked
1035+ 7875
1036+ 7875                  ; ---------------------------------------------------------------
1037+ 7875                  ; Recupera il puntatore alla stanza corrente.
1038+ 7875                  ;
1039+ 7875                  ; DE = base della struttura stanza
1040+ 7875                  ; ---------------------------------------------------------------
1041+ 7875 ED 5B FD 7D      ld   de, (room_ptr)
1042+ 7879
1043+ 7879                  ; ---------------------------------------------------------------
1044+ 7879                  ; Seleziona il tile corretto in base al tipo di cella.
1045+ 7879                  ;
1046+ 7879                  ; A = 0 -> Background
1047+ 7879                  ; A = 1 -> Floor
1048+ 7879                  ; A = 2 -> Wall
1049+ 7879                  ; A = 3 -> Nasty
1050+ 7879                  ; ---------------------------------------------------------------
1051+ 7879
1052+ 7879 B7               or   a
1053+ 787A 20 06            jr   nz, .not_bg
1054+ 787C
1055+ 787C                  ; Background
1056+ 787C 21 A0 00         ld   hl, OFFSET_BG
1057+ 787F 19               add  hl, de
1058+ 7880 18 16            jr   .draw_cell
1059+ 7882
1060+ 7882              .not_bg:
1061+ 7882
1062+ 7882 3D               dec  a
1063+ 7883 20 06            jr   nz, .not_floor
1064+ 7885
1065+ 7885                  ; Floor
1066+ 7885 21 A9 00         ld   hl, OFFSET_FLOOR
1067+ 7888 19               add  hl, de
1068+ 7889 18 0D            jr   .draw_cell
1069+ 788B
1070+ 788B              .not_floor:
1071+ 788B
1072+ 788B 3D               dec  a
1073+ 788C 20 06            jr   nz, .not_wall
1074+ 788E
1075+ 788E                  ; Wall
1076+ 788E 21 B2 00         ld   hl, OFFSET_WALL
1077+ 7891 19               add  hl, de
1078+ 7892 18 04            jr   .draw_cell
1079+ 7894
1080+ 7894              .not_wall:
1081+ 7894
1082+ 7894                  ; Nasty
1083+ 7894 21 BB 00         ld   hl, OFFSET_NASTY
1084+ 7897 19               add  hl, de
1085+ 7898
1086+ 7898              .draw_cell:
1087+ 7898
1088+ 7898                  ; ---------------------------------------------------------------
1089+ 7898                  ; HL punta ora alla grafica del tile da ridisegnare.
1090+ 7898                  ;
1091+ 7898                  ; Gfx_DrawTile si aspetta:
1092+ 7898                  ;   IX = puntatore tile
1093+ 7898                  ;   B  = Row
1094+ 7898                  ;   C  = Col
1095+ 7898                  ; ---------------------------------------------------------------
1096+ 7898 E5               push hl
1097+ 7899 DD E1            pop  ix
1098+ 789B
1099+ 789B                  ; Ripristina Row e Col salvati in IY
1100+ 789B FD E5            push iy
1101+ 789D C1               pop  bc
1102+ 789E
1103+ 789E                  ; Disegna il tile originale
1104+ 789E CD 5C 62         call Gfx_DrawTile
1105+ 78A1
1106+ 78A1                  ; ---------------------------------------------------------------
1107+ 78A1                  ; Ripristina i registri salvati
1108+ 78A1                  ; ---------------------------------------------------------------
1109+ 78A1 DD E1            pop  ix
1110+ 78A3 E1               pop  hl
1111+ 78A4 D1               pop  de
1112+ 78A5 C1               pop  bc
1113+ 78A6 FD E1            pop  iy
1114+ 78A8
1115+ 78A8 C9               ret
1116+ 78A9
1117+ 78A9              ; -------------------------------------------------------------------
1118+ 78A9              ; CheckWillyItemCollision
1119+ 78A9              ;
1120+ 78A9              ; Verifica se Willy collide con un item utilizzando il controllo
1121+ 78A9              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1122+ 78A9              ;
1123+ 78A9              ; Input:
1124+ 78A9              ;   A = ItemX (colonna attributi 0..31)
1125+ 78A9              ;   H = ItemY (riga attributi 3..18)
1126+ 78A9              ;
1127+ 78A9              ; Coordinate item:
1128+ 78A9              ;   Ogni item occupa una cella da 8x8 pixel.
1129+ 78A9              ;
1130+ 78A9              ; Coordinate Willy:
1131+ 78A9              ;   Willy occupa un rettangolo di 16x16 pixel.
1132+ 78A9              ;
1133+ 78A9              ; Output:
1134+ 78A9              ;   Carry Set   = collisione rilevata
1135+ 78A9              ;   Carry Clear = nessuna collisione
1136+ 78A9              ;
1137+ 78A9              ; Registri preservati:
1138+ 78A9              ;   BC, DE, HL
1139+ 78A9              ; -------------------------------------------------------------------
1140+ 78A9              CheckWillyItemCollision:
1141+ 78A9
1142+ 78A9                  ; Salva i registri utilizzati
1143+ 78A9 C5               push bc
1144+ 78AA D5               push de
1145+ 78AB E5               push hl
1146+ 78AC
1147+ 78AC                  ; ---------------------------------------------------------------
1148+ 78AC                  ; Calcola il bounding box orizzontale dell'item
1149+ 78AC                  ;
1150+ 78AC                  ; ItemLeft  = ItemX * 8
1151+ 78AC                  ; ItemRight = ItemLeft + 7
1152+ 78AC                  ;
1153+ 78AC                  ; E = ItemLeft
1154+ 78AC                  ; D = ItemRight
1155+ 78AC                  ; ---------------------------------------------------------------
1156+ 78AC 6F               ld   l, a              ; L = ItemX
1157+ 78AD
1158+ 78AD 7D               ld   a, l
1159+ 78AE 87               add  a, a              ; *2
1160+ 78AF 87               add  a, a              ; *4
1161+ 78B0 87               add  a, a              ; *8
1162+ 78B1
1163+ 78B1 5F               ld   e, a              ; E = ItemLeft
1164+ 78B2
1165+ 78B2 C6 07            add  a, 7
1166+ 78B4 57               ld   d, a              ; D = ItemRight
1167+ 78B5
1168+ 78B5                  ; ---------------------------------------------------------------
1169+ 78B5                  ; Recupera la posizione corrente di Willy
1170+ 78B5                  ;
1171+ 78B5                  ; B = WillyY
1172+ 78B5                  ; C = WillyX
1173+ 78B5                  ; ---------------------------------------------------------------
1174+ 78B5 ED 4B 82 7A      ld   bc, (PlayerPos)
1175+ 78B9
1176+ 78B9                  ; ---------------------------------------------------------------
1177+ 78B9                  ; Primo test:
1178+ 78B9                  ;
1179+ 78B9                  ; WillyLeft <= ItemRight
1180+ 78B9                  ;
1181+ 78B9                  ; Se Willy è completamente a destra dell'item
1182+ 78B9                  ; non può esserci collisione.
1183+ 78B9                  ; ---------------------------------------------------------------
1184+ 78B9 79               ld   a, c              ; A = WillyLeft
1185+ 78BA
1186+ 78BA BA               cp   d                 ; WillyLeft vs ItemRight
1187+ 78BB
1188+ 78BB 28 04            jr   z, .x_ok
1189+ 78BD 38 02            jr   c, .x_ok
1190+ 78BF
1191+ 78BF 18 29            jr   .no_collision
1192+ 78C1
1193+ 78C1              .x_ok:
1194+ 78C1
1195+ 78C1                  ; ---------------------------------------------------------------
1196+ 78C1                  ; Secondo test:
1197+ 78C1                  ;
1198+ 78C1                  ; WillyRight >= ItemLeft
1199+ 78C1                  ;
1200+ 78C1                  ; WillyRight = WillyX + 7
1201+ 78C1                  ; ---------------------------------------------------------------
1202+ 78C1 C6 07            add  a, 7
1203+ 78C3
1204+ 78C3 BB               cp   e                 ; WillyRight vs ItemLeft
1205+ 78C4
1206+ 78C4 28 04            jr   z, .y_check
1207+ 78C6 30 02            jr   nc, .y_check
1208+ 78C8
1209+ 78C8 18 20            jr   .no_collision
1210+ 78CA
1211+ 78CA              .y_check:
1212+ 78CA
1213+ 78CA                  ; ---------------------------------------------------------------
1214+ 78CA                  ; Recupera ItemY dal valore originale di HL
1215+ 78CA                  ;
1216+ 78CA                  ; H contiene la riga dell'item.
1217+ 78CA                  ; ---------------------------------------------------------------
1218+ 78CA E1               pop  hl
1219+ 78CB E5               push hl
1220+ 78CC
1221+ 78CC                  ; ---------------------------------------------------------------
1222+ 78CC                  ; Calcola il bounding box verticale dell'item
1223+ 78CC                  ;
1224+ 78CC                  ; ItemTop    = ItemY * 8
1225+ 78CC                  ; ItemBottom = ItemTop + 7
1226+ 78CC                  ;
1227+ 78CC                  ; E = ItemTop
1228+ 78CC                  ; D = ItemBottom
1229+ 78CC                  ; ---------------------------------------------------------------
1230+ 78CC 7C               ld   a, h
1231+ 78CD
1232+ 78CD 87               add  a, a              ; *2
1233+ 78CE 87               add  a, a              ; *4
1234+ 78CF 87               add  a, a              ; *8
1235+ 78D0
1236+ 78D0 5F               ld   e, a              ; ItemTop
1237+ 78D1
1238+ 78D1 C6 07            add  a, 7
1239+ 78D3 57               ld   d, a              ; ItemBottom
1240+ 78D4
1241+ 78D4                  ; ---------------------------------------------------------------
1242+ 78D4                  ; Primo test verticale:
1243+ 78D4                  ;
1244+ 78D4                  ; WillyTop <= ItemBottom
1245+ 78D4                  ; ---------------------------------------------------------------
1246+ 78D4 78               ld   a, b              ; WillyTop
1247+ 78D5
1248+ 78D5 BA               cp   d
1249+ 78D6
1250+ 78D6 28 04            jr   z, .y_ok
1251+ 78D8 38 02            jr   c, .y_ok
1252+ 78DA
1253+ 78DA 18 0E            jr   .no_collision
1254+ 78DC
1255+ 78DC              .y_ok:
1256+ 78DC
1257+ 78DC                  ; ---------------------------------------------------------------
1258+ 78DC                  ; Secondo test verticale:
1259+ 78DC                  ;
1260+ 78DC                  ; WillyBottom >= ItemTop
1261+ 78DC                  ;
1262+ 78DC                  ; WillyBottom = WillyY + 15
1263+ 78DC                  ; ---------------------------------------------------------------
1264+ 78DC C6 0F            add  a, 15
1265+ 78DE
1266+ 78DE BB               cp   e
1267+ 78DF
1268+ 78DF 28 04            jr   z, .collision
1269+ 78E1 30 02            jr   nc, .collision
1270+ 78E3
1271+ 78E3 18 05            jr   .no_collision
1272+ 78E5
1273+ 78E5              .collision:
1274+ 78E5
1275+ 78E5                  ; ---------------------------------------------------------------
1276+ 78E5                  ; Collisione rilevata
1277+ 78E5                  ; ---------------------------------------------------------------
1278+ 78E5 E1               pop  hl
1279+ 78E6 D1               pop  de
1280+ 78E7 C1               pop  bc
1281+ 78E8
1282+ 78E8 37               scf                    ; Carry = 1
1283+ 78E9
1284+ 78E9 C9               ret
1285+ 78EA
1286+ 78EA              .no_collision:
1287+ 78EA
1288+ 78EA                  ; ---------------------------------------------------------------
1289+ 78EA                  ; Nessuna collisione
1290+ 78EA                  ; ---------------------------------------------------------------
1291+ 78EA E1               pop  hl
1292+ 78EB D1               pop  de
1293+ 78EC C1               pop  bc
1294+ 78ED
1295+ 78ED B7               or   a                 ; Carry = 0
1296+ 78EE
1297+ 78EE C9               ret
1298+ 78EF
1299+ 78EF              ; -------------------------------------------------------------------
1300+ 78EF              ; Items_CheckCollision
1301+ 78EF              ;
1302+ 78EF              ; Controlla se Willy entra in collisione con uno degli item
1303+ 78EF              ; attivi presenti nella stanza corrente.
1304+ 78EF              ;
1305+ 78EF              ; Per ogni item:
1306+ 78EF              ;   - verifica che appartenga alla stanza corrente
1307+ 78EF              ;   - verifica che non sia già stato raccolto
1308+ 78EF              ;   - esegue il test di collisione con Willy
1309+ 78EF              ;
1310+ 78EF              ; Se l'item viene raccolto:
1311+ 78EF              ;   - imposta il flag "collected"
1312+ 78EF              ;   - rimuove l'item dalla cache items_grid
1313+ 78EF              ;   - incrementa il contatore degli oggetti raccolti
1314+ 78EF              ;   - aggiorna l'HUD
1315+ 78EF              ;   - ripristina il tile di sfondo
1316+ 78EF              ;   - riproduce il suono di raccolta
1317+ 78EF              ;
1318+ 78EF              ; Formato record ItemsTable:
1319+ 78EF              ;   +0 RoomID
1320+ 78EF              ;   +1 X
1321+ 78EF              ;   +2 Y
1322+ 78EF              ;   +3 Color
1323+ 78EF              ;   +4 Collected
1324+ 78EF              ;
1325+ 78EF              ; Fine tabella:
1326+ 78EF              ;   RoomID = $FF
1327+ 78EF              ; -------------------------------------------------------------------
1328+ 78EF              Items_CheckCollision:
1329+ 78EF
1330+ 78EF                  ; Salva i registri utilizzati
1331+ 78EF E5               push hl
1332+ 78F0 D5               push de
1333+ 78F1 C5               push bc
1334+ 78F2
1335+ 78F2                  ; Inizio scansione della tabella degli item
1336+ 78F2 21 CE 74         ld   hl, ItemsTable
1337+ 78F5
1338+ 78F5              .loop:
1339+ 78F5
1340+ 78F5                  ; ---------------------------------------------------------------
1341+ 78F5                  ; Legge il Room ID dell'item corrente
1342+ 78F5                  ; ---------------------------------------------------------------
1343+ 78F5 7E               ld   a, (hl)
1344+ 78F6
1345+ 78F6                  ; $FF indica fine tabella
1346+ 78F6 FE FF            cp   $FF
1347+ 78F8 28 4D            jr   z, .done
1348+ 78FA
1349+ 78FA                  ; ---------------------------------------------------------------
1350+ 78FA                  ; Verifica se l'item appartiene alla stanza corrente
1351+ 78FA                  ; ---------------------------------------------------------------
1352+ 78FA 57               ld   d, a              ; D = RoomID item
1353+ 78FB
1354+ 78FB 3A A3 7D         ld   a, (current_room)
1355+ 78FE BA               cp   d
1356+ 78FF
1357+ 78FF                  ; Se appartiene a un'altra stanza salta il record
1358+ 78FF 20 3F            jr   nz, .next_item
1359+ 7901
1360+ 7901                  ; ---------------------------------------------------------------
1361+ 7901                  ; Legge coordinate e stato dell'item
1362+ 7901                  ; ---------------------------------------------------------------
1363+ 7901
1364+ 7901 23               inc  hl
1365+ 7902 4E               ld   c, (hl)           ; C = X
1366+ 7903
1367+ 7903 23               inc  hl
1368+ 7904 46               ld   b, (hl)           ; B = Y
1369+ 7905
1370+ 7905 23               inc  hl                ; salta Color
1371+ 7906
1372+ 7906 23               inc  hl                ; punta a Collected
1373+ 7907
1374+ 7907 7E               ld   a, (hl)
1375+ 7908
1376+ 7908                  ; ---------------------------------------------------------------
1377+ 7908                  ; Item già raccolto?
1378+ 7908                  ; ---------------------------------------------------------------
1379+ 7908 B7               or   a
1380+ 7909 20 39            jr   nz, .next_no_inc
1381+ 790B
1382+ 790B                  ; ---------------------------------------------------------------
1383+ 790B                  ; Test collisione Willy ↔ Item
1384+ 790B                  ;
1385+ 790B                  ; Input richiesto:
1386+ 790B                  ;   A = ItemX
1387+ 790B                  ;   H = ItemY
1388+ 790B                  ; ---------------------------------------------------------------
1389+ 790B 79               ld   a, c
1390+ 790C
1391+ 790C E5               push hl                ; salva puntatore al flag Collected
1392+ 790D
1393+ 790D 60               ld   h, b
1394+ 790E
1395+ 790E CD A9 78         call CheckWillyItemCollision
1396+ 7911
1397+ 7911 E1               pop  hl
1398+ 7912
1399+ 7912                  ; Nessuna collisione
1400+ 7912 30 30            jr   nc, .next_no_inc
1401+ 7914
1402+ 7914                  ; ===============================================================
1403+ 7914                  ; ITEM RACCOLTO
1404+ 7914                  ; ===============================================================
1405+ 7914
1406+ 7914                  ; ---------------------------------------------------------------
1407+ 7914                  ; Marca l'item come raccolto
1408+ 7914                  ; ---------------------------------------------------------------
1409+ 7914 36 01            ld   (hl), 1
1410+ 7916
1411+ 7916                  ; ---------------------------------------------------------------
1412+ 7916                  ; Rimuove l'item dalla cache items_grid
1413+ 7916                  ;
1414+ 7916                  ; Calcolo:
1415+ 7916                  ;   offset = Row * 32 + Col
1416+ 7916                  ; ---------------------------------------------------------------
1417+ 7916 E5               push hl
1418+ 7917 D5               push de
1419+ 7918
1420+ 7918 26 00            ld   h, 0
1421+ 791A 68               ld   l, b              ; HL = Row
1422+ 791B
1423+ 791B 29               add  hl, hl            ; *2
1424+ 791C 29               add  hl, hl            ; *4
1425+ 791D 29               add  hl, hl            ; *8
1426+ 791E 29               add  hl, hl            ; *16
1427+ 791F 29               add  hl, hl            ; *32
1428+ 7920
1429+ 7920 59               ld   e, c
1430+ 7921 16 00            ld   d, 0
1431+ 7923
1432+ 7923 19               add  hl, de            ; Row*32 + Col
1433+ 7924
1434+ 7924 11 00 B0         ld   de, items_grid
1435+ 7927 19               add  hl, de
1436+ 7928
1437+ 7928                  ; La cella non contiene più un item
1438+ 7928 36 00            ld   (hl), 0
1439+ 792A
1440+ 792A D1               pop  de
1441+ 792B E1               pop  hl
