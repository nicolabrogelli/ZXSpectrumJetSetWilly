 882  8DE8              ; -------------------------------------------------------------------
 883  8DE8              ; ResetFullGameState
 884  8DE8              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 885  8DE8              ; per l'avvio di una nuova partita dopo il Game Over.
 886  8DE8              ; -------------------------------------------------------------------
 887  8DE8              ResetFullGameState:
 888  8DE8                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 889  8DE8 AF               xor  a
 890  8DE9 D3 FE            out  ($fe), a              ; Bordo a nero
 891  8DEB 21 8D 5C         ld   hl, ATTR_P
 892  8DEE 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 893  8DEF CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 894  8DF2 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 895  8DF4 3E 07            ld   a, $07
 896  8DF6 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 897  8DF9
 898  8DF9                  ; Ripristina il numero di vite iniziali
 899  8DF9 3E 07            ld   a, INITIAL_LIVES
 900  8DFB 32 F5 F7         ld   (willy_lives), a
 901  8DFE
 902  8DFE                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 903  8DFE AF               xor  a
 904  8DFF 32 F2 F7         ld   (items_collected), a
 905  8E02 32 EE F7         ld   (body_state), a
 906  8E05 32 01 F8         ld   (w_warp_state), a
 907  8E08 32 04 F8         ld   (w_key_prev), a
 908  8E0B 32 05 F8         ld   (enter_key_prev), a
 909  8E0E 32 F6 F7         ld   (velocity_y), a
 910  8E11 32 F8 F7         ld   (jump_pressed), a
 911  8E14 32 FA F7         ld   (coyote_timer), a
 912  8E17 32 FD F7         ld   (jump_frame), a
 913  8E1A 32 FC F7         ld   (jump_dir), a
 914  8E1D 32 6E FB         ld   (transition_active), a
 915  8E20 32 F2 FB         ld   (willy_safety_timer), a
 916  8E23 3E FF            ld   a, $ff
 917  8E25 32 06 F8         ld   (digit_key_prev), a
 918  8E28 3E 01            ld   a, 1
 919  8E2A 32 FF F7         ld   (q_prev), a
 920  8E2D 32 00 F8         ld   (a_prev), a
 921  8E30 32 F7 F7         ld   (on_ground), a
 922  8E33
 923  8E33                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 924  8E33 3E 30            ld   a, '0'
 925  8E35 32 F9 68         ld   (status_line + 16), a
 926  8E38 32 FA 68         ld   (status_line + 17), a
 927  8E3B 32 FB 68         ld   (status_line + 18), a
 928  8E3E
 929  8E3E                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 930  8E3E CD 57 86         call ResetItemsTable
 931  8E41
 932  8E41                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 933  8E41 CD 21 6E         call InitRoomEntryPositions
 934  8E44
 935  8E44                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 936  8E44 3E 07            ld   a, 7
 937  8E46 32 F5 FB         ld   (time_hours), a
 938  8E49 AF               xor  a
 939  8E4A 32 F6 FB         ld   (time_minutes), a
 940  8E4D 32 F7 FB         ld   (time_period), a       ; 0 = AM
 941  8E50 32 FA FB         ld   (game_objective_completed), a
 942  8E53 2A 09 F8         ld   hl, (counter)
 943  8E56 22 F8 FB         ld   (time_last_counter), hl
 944  8E59 CD 6B 68         call Gfx_UpdateTimeDisplay
 945  8E5C
 946  8E5C                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 947  8E5C 21 A0 B3         ld   hl, TheBathroomLayout; TheOffLicenceLayout
 948  8E5F 22 68 FB         ld   (room_ptr), hl
 949  8E62
 950  8E62 C9               ret
 951  8E63
 952  8E63              ; -------------------------------------------------------------------
 953  8E63              ; Time_UpdateClock
 954  8E63              ; Gestisce lo scorrimento del tempo durante il gioco.
 955  8E63              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 956  8E63              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 957  8E63              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 958  8E63              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 959  8E63              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 960  8E63              ; sia completato, scatena immediatamente il Game Over.
 961  8E63              ; -------------------------------------------------------------------
 962  8E63              Time_UpdateClock:
 963  8E63                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 964  8E63 2A 09 F8         ld   hl, (counter)
 965  8E66 ED 5B F8 FB      ld   de, (time_last_counter)
 966  8E6A B7               or   a
 967  8E6B ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 968  8E6D
 969  8E6D                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 970  8E6D 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 971  8E70 B7               or   a
 972  8E71 ED 52            sbc  hl, de
 973  8E73 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 974  8E74
 975  8E74                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 976  8E74 2A F8 FB         ld   hl, (time_last_counter)
 977  8E77 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 978  8E7A 19               add  hl, de
 979  8E7B 22 F8 FB         ld   (time_last_counter), hl
 980  8E7E
 981  8E7E                  ; Incrementa di 1 minuto il tempo di gioco
 982  8E7E 3A F6 FB         ld   a, (time_minutes)
 983  8E81 3C               inc  a
 984  8E82 FE 3C            cp   60
 985  8E84 38 21            jr   c, .minutes_ok
 986  8E86
 987  8E86                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 988  8E86 AF               xor  a
 989  8E87 32 F6 FB         ld   (time_minutes), a
 990  8E8A 3A F5 FB         ld   a, (time_hours)
 991  8E8D 3C               inc  a
 992  8E8E FE 0C            cp   12
 993  8E90 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 994  8E92 FE 0D            cp   13
 995  8E94 38 0E            jr   c, .hours_ok
 996  8E96 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 997  8E98 18 0A            jr   .hours_ok
 998  8E9A
 999  8E9A              .toggle_period:
1000  8E9A F5               push af                     ; Salva A (valore 12)
1001  8E9B 3A F7 FB         ld   a, (time_period)
1002  8E9E EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
1003  8EA0 32 F7 FB         ld   (time_period), a
1004  8EA3 F1               pop  af                     ; Ripristina A = 12
1005  8EA4
1006  8EA4              .hours_ok:
1007  8EA4 32 F5 FB         ld   (time_hours), a
1008  8EA7
1009  8EA7              .minutes_ok:
1010  8EA7 32 F6 FB         ld   (time_minutes), a
1011  8EAA
1012  8EAA                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
1013  8EAA CD 6B 68         call Gfx_UpdateTimeDisplay
1014  8EAD
1015  8EAD                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
1016  8EAD 3A FA FB         ld   a, (game_objective_completed)
1017  8EB0 B7               or   a
1018  8EB1 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
1019  8EB2
1020  8EB2                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
1021  8EB2 3A F7 FB         ld   a, (time_period)
1022  8EB5 B7               or   a
1023  8EB6 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
1024  8EB7
1025  8EB7 3A F5 FB         ld   a, (time_hours)
1026  8EBA FE 0C            cp   12
1027  8EBC 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1028  8EBE C9               ret
1029  8EBF
1030  8EBF              .time_limit_reached:
1031  8EBF                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
1032  8EBF                  ; Scatena immediatamente il Game Over temporale!
1033  8EBF C3 7F 8B         jp   TriggerGameOver
1034  8EC2
