   7+ 6E43              ; Input_CheckCtrl
   8+ 6E43              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 6E43              ;
  10+ 6E43              ; Output:
  11+ 6E43              ;   D = bitmask tasti attivi:
  12+ 6E43              ;       bit 0 → sinistra (O)
  13+ 6E43              ;       bit 1 → destra   (P)
  14+ 6E43              ;       bit 2 → salto    (Z)
