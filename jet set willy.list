 462  8B4E 3A 49 FB         ld   a, (time_period)
 463  8B51 B7               or   a
 464  8B52 20 19            jr   nz, .keep_current_time
 465  8B54 3A 47 FB         ld   a, (time_hours)
 466  8B57 FE 0C            cp   12
