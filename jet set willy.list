  72+ 8603 ~            ; Audio_UpdateMusic
  73+ 8603 ~            ;
  74+ 8603 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8603 ~            ; Viene chiamata a ogni frame.
  76+ 8603 ~            ; -------------------------------------------------------------------
  77+ 8603 ~            Audio_UpdateMusic:
  78+ 8603 ~                push af
  79+ 8603 ~                push bc
  80+ 8603 ~                push de
  81+ 8603 ~                push hl
  82+ 8603 ~
  83+ 8603 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8603 ~                ld   a, (Audio_jump_sound_note)
  85+ 8603 ~                cp   18
  86+ 8603 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8603 ~
  88+ 8603 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8603 ~                ld   a, (Audio_music_frame_counter)
  90+ 8603 ~                dec  a
  91+ 8603 ~                ld   (Audio_music_frame_counter), a
  92+ 8603 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8603 ~
  94+ 8603 ~                ; Altrimenti carica la nota successiva
  95+ 8603 ~                ld   a, (Audio_music_note_idx)
  96+ 8603 ~                inc  a
  97+ 8603 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8603 ~                jr   c, .no_wrap
  99+ 8603 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8603 ~            .no_wrap:
 101+ 8603 ~                ld   (Audio_music_note_idx), a
 102+ 8603 ~
 103+ 8603 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8603 ~                ld   e, a
 105+ 8603 ~                ld   d, 0
 106+ 8603 ~                ld   hl, Audio_MusicSheet
 107+ 8603 ~                add  hl, de
 108+ 8603 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8603 ~
 110+ 8603 ~                ; Leggi durata (secondo byte)
 111+ 8603 ~                inc  hl
 112+ 8603 ~                ld   a, (hl)
 113+ 8603 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8603 ~                jr   nz, .dur_ok
 115+ 8603 ~                ld   a, 1
 116+ 8603 ~            .dur_ok:
 117+ 8603 ~                ld   (Audio_music_frame_counter), a
 118+ 8603 ~
 119+ 8603 ~            .play_current_note:
 120+ 8603 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8603 ~                ld   a, (Audio_music_note_idx)
 122+ 8603 ~                ld   e, a
 123+ 8603 ~                ld   d, 0
 124+ 8603 ~                ld   hl, Audio_MusicSheet
 125+ 8603 ~                add  hl, de
 126+ 8603 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8603 ~                ld   a, (hl)                  ; A = delay
 128+ 8603 ~                or   a
 129+ 8603 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8603 ~
 131+ 8603 ~                ; Suona la nota: 2 cicli
 132+ 8603 ~                ld   d, a                     ; D = delay
 133+ 8603 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8603 ~            .note_loop:
 135+ 8603 ~                ; Speaker ON
 136+ 8603 ~                ld   a, (room_border_color)
 137+ 8603 ~                or   $10
 138+ 8603 ~                out  ($fe), a
 139+ 8603 ~                ld   c, d
 140+ 8603 ~            .d1:
 141+ 8603 ~                push af
 142+ 8603 ~                pop  af
 143+ 8603 ~                dec  c
 144+ 8603 ~                jr   nz, .d1
 145+ 8603 ~
 146+ 8603 ~                ; Speaker OFF
 147+ 8603 ~                ld   a, (room_border_color)
 148+ 8603 ~                and  $ef
 149+ 8603 ~                out  ($fe), a
 150+ 8603 ~                ld   c, d
 151+ 8603 ~            .d2:
 152+ 8603 ~                push af
 153+ 8603 ~                pop  af
 154+ 8603 ~                dec  c
 155+ 8603 ~                jr   nz, .d2
 156+ 8603 ~
 157+ 8603 ~                djnz .note_loop
 158+ 8603 ~
 159+ 8603 ~            .done:
 160+ 8603 ~                pop  hl
 161+ 8603 ~                pop  de
 162+ 8603 ~                pop  bc
 163+ 8603 ~                pop  af
 164+ 8603 ~                ret
 165+ 8603 ~
 166+ 8603 ~            Audio_MusicSheet:
 167+ 8603 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8603 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8603 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8603 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8603 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8603 ~                db 90, 10, 107, 20, 68, 65
