   5+ 6507              ; -------------------------------------------------------------------
   6+ 6507              ; MovePlayer
   7+ 6507              ;
   8+ 6507              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6507              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6507              ; con i muri.
  11+ 6507              ;
  12+ 6507              ; Input:
  13+ 6507              ;   D = stato dei controlli (bitfield)
  14+ 6507              ;
  15+ 6507              ; Strutture utilizzate:
  16+ 6507              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6507              ;   player_speed    -> velocità orizzontale
  18+ 6507              ;   flags           -> flag di stato input
  19+ 6507              ;
  20+ 6507              ; Bit controlli:
  21+ 6507              ;   bit 0 = sinistra
  22+ 6507              ;   bit 1 = destra
  23+ 6507              ;
  24+ 6507              ; Nota:
  25+ 6507              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6507              ;   ignorato per tutta la durata del salto.
  27+ 6507              ;
  28+ 6507              ; Output:
  29+ 6507              ;   aggiorna PlayerPos e body_state
  30+ 6507              ; -------------------------------------------------------------------
  31+ 6507              MovePlayer:
  32+ 6507
  33+ 6507                  ; ---------------------------------------------------------------
  34+ 6507                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6507                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6507                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6507                  ; ---------------------------------------------------------------
  38+ 6507 3A E1 7A         ld   a, (on_ground)
  39+ 650A B7               or   a
  40+ 650B 20 1A            jr   nz, .on_ground_check
  41+ 650D
  42+ 650D 3A E5 7A         ld   a, (jump_dir)
  43+ 6510 B7               or   a
  44+ 6511 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6512
  46+ 6512                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6512 DD 21 DA 7A      ld   ix, flags
  48+ 6516 DD CB 00 86      res  $00, (ix)
  49+ 651A
  50+ 651A ED 4B D2 7A      ld   bc, (PlayerPos)
  51+ 651E FE 01            cp   1
  52+ 6520 28 1D            jr   z, movePlayer_left
  53+ 6522 FE 02            cp   2
  54+ 6524 28 52            jr   z, movePlayer_right
  55+ 6526 C9               ret
  56+ 6527
  57+ 6527              .on_ground_check:
  58+ 6527                  ; ---------------------------------------------------------------
  59+ 6527                  ; Se siamo a terra, muoviti solo se c'è input (bit 0 di flags impostato)
  60+ 6527                  ; ---------------------------------------------------------------
  61+ 6527 DD 21 DA 7A      ld   ix, flags
  62+ 652B DD CB 00 46      bit  $00, (ix)
  63+ 652F C8               ret  z
  64+ 6530
  65+ 6530 DD CB 00 86      res  $00, (ix)
  66+ 6534
  67+ 6534 ED 4B D2 7A      ld   bc, (PlayerPos)
  68+ 6538
