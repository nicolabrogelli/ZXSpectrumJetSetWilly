1140+ 6B25 87               add  a, a              ; *2
1141+ 6B26 87               add  a, a              ; *4
1142+ 6B27 87               add  a, a              ; *8
1143+ 6B28 D6 10            sub  16                ; A = Row * 8 - 16
1144+ 6B2A 37               scf                    ; Set carry (dentro rampa/piattaforma)
1145+ 6B2B C9               ret
