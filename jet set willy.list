 888+ 6BE9 E5               push hl
 889+ 6BEA
 890+ 6BEA 3A 01 7E         ld   a, (ramp_len)
 891+ 6BED B7               or   a
 892+ 6BEE 28 6B            jr   z, .no
 893+ 6BF0
 894+ 6BF0                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 895+ 6BF0 3A 00 7E         ld   a, (ramp_dir)
 896+ 6BF3 B7               or   a
 897+ 6BF4 28 1A            jr   z, .range_left
 898+ 6BF6              .range_right:
 899+ 6BF6 3A 03 7E         ld   a, (ramp_col)
 900+ 6BF9 47               ld   b, a              ; B = ramp_col
 901+ 6BFA 3A 01 7E         ld   a, (ramp_len)
 902+ 6BFD 80               add  a, b              ; A = ramp_col + ramp_len
 903+ 6BFE 4F               ld   c, a              ; C = limit_right (exclusive)
 904+ 6BFF
 905+ 6BFF 7B               ld   a, e              ; A = Col
 906+ 6C00 B8               cp   b
 907+ 6C01 38 34            jr   c, .check_platform_case ; Col < ramp_col
 908+ 6C03 B9               cp   c
 909+ 6C04 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 910+ 6C06
 911+ 6C06                  ; Calcola B = Col - ramp_col
 912+ 6C06 7B               ld   a, e
 913+ 6C07 90               sub  b
 914+ 6C08 47               ld   b, a              ; B = offset (0..ramp_len-1)
 915+ 6C09
 916+ 6C09                  ; SlopeRow = ramp_row - B
 917+ 6C09 3A 02 7E         ld   a, (ramp_row)
 918+ 6C0C 90               sub  b
 919+ 6C0D 47               ld   b, a              ; B = SlopeRow
 920+ 6C0E 18 1F            jr   .check_row_match
