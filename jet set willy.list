 589+ 6A58              ; -------------------------------------------------------------------
 590+ 6A58              ; Verifica la collisione tra player e nemico (bounding box a livello di pixel)
 591+ 6A58              ; Output: Carry flag impostato se collisione, altrimenti resettato
 592+ 6A58              ; -------------------------------------------------------------------
 593+ 6A58              CheckCollision:
 594+ 6A58 E5               push hl
 595+ 6A59 D5               push de
 596+ 6A5A C5               push bc
 597+ 6A5B DD E5            push ix
 598+ 6A5D
 599+ 6A5D DD 21 05 6E      ld   ix, ActiveEnemies
 600+ 6A61 06 08            ld   b, 8              ; 8 slot
 601+ 6A63              .loop:
 602+ 6A63 DD 7E 00         ld   a, (ix+0)         ; Flags
 603+ 6A66 E6 80            and  $80               ; Active?
 604+ 6A68 28 1F            jr   z, .next
 605+ 6A6A
 606+ 6A6A                  ; 1. Controllo orizzontale: PlayerX - EnemyX + 7 in [0, 22]
 607+ 6A6A 3A 3C 7A         ld   a, (PlayerPos)    ; A = PlayerX
 608+ 6A6D DD 96 02         sub  (ix+2)            ; A = PlayerX - EnemyX (Offset 2: Current X)
 609+ 6A70 C6 07            add  a, 7              ; A = PlayerX - EnemyX + 7
 610+ 6A72 FE 17            cp   23                ; Se >= 23, nessuna collisione con questo
 611+ 6A74 30 13            jr   nc, .next
 612+ 6A76
 613+ 6A76                  ; 2. Controllo verticale: PlayerY - EnemyY + 15 in [0, 30]
 614+ 6A76 3A 3D 7A         ld   a, (PlayerPos+1)  ; A = PlayerY
 615+ 6A79 DD 96 03         sub  (ix+3)            ; A = PlayerY - EnemyY (Offset 3: Current Y)
 616+ 6A7C C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 617+ 6A7E FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 618+ 6A80 30 07            jr   nc, .next
