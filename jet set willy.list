 485+ 6E44 3A D3 75         ld   a, (enemy_update_rate)
 486+ 6E47 FE 01            cp   1
 487+ 6E49 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 488+ 6E4B
 489+ 6E4B 3A D4 75         ld   a, (enemy_update_timer)
 490+ 6E4E 3C               inc  a
 491+ 6E4F 47               ld   b, a                      ; B = timer + 1
 492+ 6E50 3A D3 75         ld   a, (enemy_update_rate)
 493+ 6E53 B8               cp   b
 494+ 6E54 28 0C            jr   z, .reset_timer
 495+ 6E56 38 0A            jr   c, .reset_timer
 496+ 6E58
 497+ 6E58                  ; Salva contatore incrementato e salta l'aggiornamento
 498+ 6E58 78               ld   a, b
 499+ 6E59 32 D4 75         ld   (enemy_update_timer), a
