 949  8E7F
 950  8E7F C9               ret
 951  8E80
 952  8E80              ; -------------------------------------------------------------------
 953  8E80              ; Time_UpdateClock
 954  8E80              ; Gestisce lo scorrimento del tempo durante il gioco.
 955  8E80              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 956  8E80              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 957  8E80              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 958  8E80              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 959  8E80              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 960  8E80              ; sia completato, scatena immediatamente il Game Over.
 961  8E80              ; -------------------------------------------------------------------
 962  8E80              Time_UpdateClock:
 963  8E80                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 964  8E80 2A 26 F8         ld   hl, (counter)
 965  8E83 ED 5B 15 FC      ld   de, (time_last_counter)
 966  8E87 B7               or   a
 967  8E88 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 968  8E8A
 969  8E8A                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 970  8E8A 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 971  8E8D B7               or   a
 972  8E8E ED 52            sbc  hl, de
 973  8E90 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 974  8E91
 975  8E91                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 976  8E91 2A 15 FC         ld   hl, (time_last_counter)
 977  8E94 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 978  8E97 19               add  hl, de
 979  8E98 22 15 FC         ld   (time_last_counter), hl
 980  8E9B
 981  8E9B                  ; Incrementa di 1 minuto il tempo di gioco
 982  8E9B 3A 13 FC         ld   a, (time_minutes)
 983  8E9E 3C               inc  a
 984  8E9F FE 3C            cp   60
 985  8EA1 38 21            jr   c, .minutes_ok
 986  8EA3
 987  8EA3                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 988  8EA3 AF               xor  a
 989  8EA4 32 13 FC         ld   (time_minutes), a
 990  8EA7 3A 12 FC         ld   a, (time_hours)
 991  8EAA 3C               inc  a
 992  8EAB FE 0C            cp   12
 993  8EAD 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 994  8EAF FE 0D            cp   13
 995  8EB1 38 0E            jr   c, .hours_ok
 996  8EB3 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 997  8EB5 18 0A            jr   .hours_ok
 998  8EB7
 999  8EB7              .toggle_period:
1000  8EB7 F5               push af                     ; Salva A (valore 12)
1001  8EB8 3A 14 FC         ld   a, (time_period)
1002  8EBB EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
1003  8EBD 32 14 FC         ld   (time_period), a
1004  8EC0 F1               pop  af                     ; Ripristina A = 12
1005  8EC1
1006  8EC1              .hours_ok:
1007  8EC1 32 12 FC         ld   (time_hours), a
1008  8EC4
1009  8EC4              .minutes_ok:
1010  8EC4 32 13 FC         ld   (time_minutes), a
1011  8EC7
1012  8EC7                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
1013  8EC7 CD 6D 68         call Gfx_UpdateTimeDisplay
1014  8ECA
1015  8ECA                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
1016  8ECA 3A 17 FC         ld   a, (game_objective_completed)
1017  8ECD B7               or   a
1018  8ECE C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
1019  8ECF
1020  8ECF                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
1021  8ECF 3A 14 FC         ld   a, (time_period)
1022  8ED2 B7               or   a
1023  8ED3 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
1024  8ED4
1025  8ED4 3A 12 FC         ld   a, (time_hours)
1026  8ED7 FE 0C            cp   12
1027  8ED9 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1028  8EDB C9               ret
1029  8EDC
1030  8EDC              .time_limit_reached:
1031  8EDC                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
1032  8EDC                  ; Scatena immediatamente il Game Over temporale!
1033  8EDC C3 9C 8B         jp   TriggerGameOver
1034  8EDF
1035  8EDF
1036  8EDF
