  87+ 726F              ; DetermineCurrentRoomID
  88+ 726F              ;
  89+ 726F              ; Determina l'ID numerico della stanza corrente confrontando
  90+ 726F              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  91+ 726F              ;
  92+ 726F              ; Se viene trovata una corrispondenza:
  93+ 726F              ;   A = ID della stanza
  94+ 726F              ;   current_room = A
  95+ 726F              ;
  96+ 726F              ; Mappatura:
  97+ 726F              ;    0 = The Off Licence
  98+ 726F              ;    1 = The Bridge
  99+ 726F              ;    2 = Under The Mega Tree
 100+ 726F              ;    3 = Gfx_At The Foot Of The Mega Tree
 101+ 726F              ;    4 = The Drive
 102+ 726F              ;    5 = The Security Guard
 103+ 726F              ;    6 = Entrance To Hades
 104+ 726F              ;    7 = Cuckoo's Nest
 105+ 726F              ;    8 = Inside The Mega Trunk
 106+ 726F              ;    9 = On A Branch Over The Drive
 107+ 726F              ;   10 = The Front Door
 108+ 726F              ;   11 = The Hall
 109+ 726F              ;   12 = Tree Top
 110+ 726F              ;   33 = The Bathroom
