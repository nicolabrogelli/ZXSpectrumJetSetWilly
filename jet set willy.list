 283+ 6D08
 284+ 6D08                  ; Salva l'ID della stanza corrente
 285+ 6D08 32 46 7E         ld   (current_room), a
 286+ 6D0B
 287+ 6D0B                  ; Ripristina i registri
 288+ 6D0B D1               pop  de
 289+ 6D0C E1               pop  hl
 290+ 6D0D
 291+ 6D0D C9               ret
 292+ 6D0E
 293+ 6D0E              ; -------------------------------------------------------------------
 294+ 6D0E              ; DrawRoomItems
 295+ 6D0E              ;
 296+ 6D0E              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 297+ 6D0E              ;
 298+ 6D0E              ; Operazioni eseguite:
 299+ 6D0E              ;   1. Azzera la griglia items_grid.
 300+ 6D0E              ;   2. Svuota la cache degli oggetti attivi.
 301+ 6D0E              ;   3. Scansiona ItemsTable.
 302+ 6D0E              ;   4. Per ogni item della stanza corrente:
 303+ 6D0E              ;        - verifica se è già stato raccolto
 304+ 6D0E              ;        - disegna la grafica
 305+ 6D0E              ;        - aggiorna items_grid
 306+ 6D0E              ;        - memorizza l'item nella cache current_room_items
 307+ 6D0E              ;   5. Aggiorna num_room_items.
 308+ 6D0E              ;
 309+ 6D0E              ; Record ItemsTable:
 310+ 6D0E              ;   +0  Room ID
 311+ 6D0E              ;   +1  X (colonna)
 312+ 6D0E              ;   +2  Y (riga)
 313+ 6D0E              ;   +3  Colore
 314+ 6D0E              ;   +4  Collected flag
 315+ 6D0E              ;
 316+ 6D0E              ; Cache current_room_items:
 317+ 6D0E              ;   +0  Colonna
 318+ 6D0E              ;   +1  Riga
 319+ 6D0E              ;   +2  Colore
 320+ 6D0E              ;   +3  Collected flag ptr (Low)
 321+ 6D0E              ;   +4  Collected flag ptr (High)
 322+ 6D0E              ;
 323+ 6D0E              ; Ogni record cache occupa 5 byte.
 324+ 6D0E              ; -------------------------------------------------------------------
 325+ 6D0E              DrawRoomItems:
 326+ 6D0E
 327+ 6D0E                  ; Salva tutti i registri utilizzati
 328+ 6D0E E5               push hl
 329+ 6D0F D5               push de
 330+ 6D10 C5               push bc
 331+ 6D11 DD E5            push ix
 332+ 6D13 FD E5            push iy
 333+ 6D15
 334+ 6D15                  ; ---------------------------------------------------------------
 335+ 6D15                  ; Azzera items_grid (32 x 16 = 512 byte)
 336+ 6D15                  ; ---------------------------------------------------------------
 337+ 6D15 21 00 90         ld   hl, items_grid
 338+ 6D18 11 01 90         ld   de, items_grid + 1
 339+ 6D1B 36 00            ld   (hl), 0
 340+ 6D1D 01 FF 01         ld   bc, 511
 341+ 6D20 ED B0            ldir
 342+ 6D22
 343+ 6D22                  ; ---------------------------------------------------------------
 344+ 6D22                  ; Nessun item attivo nella stanza
 345+ 6D22                  ; ---------------------------------------------------------------
 346+ 6D22 AF               xor  a
 347+ 6D23 32 9F 7E         ld   (num_room_items), a
 348+ 6D26
 349+ 6D26                  ; IY punta alla cache degli item attivi
 350+ 6D26 FD 21 4F 7E      ld   iy, current_room_items
 351+ 6D2A
 352+ 6D2A                  ; ---------------------------------------------------------------
 353+ 6D2A                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 354+ 6D2A                  ; alla stanza corrente.
 355+ 6D2A                  ;
 356+ 6D2A                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 357+ 6D2A                  ; ---------------------------------------------------------------
 358+ 6D2A 2A A0 7E         ld   hl, (room_ptr)
 359+ 6D2D 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 360+ 6D30 19               add  hl, de
 361+ 6D31
 362+ 6D31 E5               push hl
 363+ 6D32 DD E1            pop  ix                ; IX = bitmap item
 364+ 6D34
 365+ 6D34                  ; ---------------------------------------------------------------
 366+ 6D34                  ; Inizio scansione della tabella degli item
 367+ 6D34                  ; ---------------------------------------------------------------
 368+ 6D34 21 DE 6B         ld   hl, ItemsTable
 369+ 6D37
 370+ 6D37              .loop:
 371+ 6D37
 372+ 6D37                  ; ---------------------------------------------------------------
 373+ 6D37                  ; Legge il Room ID del record corrente
 374+ 6D37                  ; ---------------------------------------------------------------
 375+ 6D37 7E               ld   a, (hl)
 376+ 6D38
 377+ 6D38                  ; $FF indica fine tabella
 378+ 6D38 FE FF            cp   $FF
 379+ 6D3A 28 53            jr   z, .done
 380+ 6D3C
 381+ 6D3C                  ; ---------------------------------------------------------------
 382+ 6D3C                  ; Verifica se l'item appartiene alla stanza corrente
 383+ 6D3C                  ; ---------------------------------------------------------------
 384+ 6D3C 57               ld   d, a
 385+ 6D3D
 386+ 6D3D 3A 46 7E         ld   a, (current_room)
 387+ 6D40 BA               cp   d
 388+ 6D41 20 45            jr   nz, .next_item
 389+ 6D43
 390+ 6D43                  ; ---------------------------------------------------------------
 391+ 6D43                  ; Legge i dati dell'item
 392+ 6D43                  ; ---------------------------------------------------------------
 393+ 6D43
 394+ 6D43 23               inc  hl
 395+ 6D44 4E               ld   c, (hl)           ; X (colonna)
 396+ 6D45
 397+ 6D45 23               inc  hl
 398+ 6D46 46               ld   b, (hl)           ; Y (riga)
 399+ 6D47
 400+ 6D47 23               inc  hl
 401+ 6D48 5E               ld   e, (hl)           ; Colore
 402+ 6D49
 403+ 6D49 23               inc  hl
 404+ 6D4A 7E               ld   a, (hl)           ; Collected flag
 405+ 6D4B
 406+ 6D4B                  ; Se diverso da zero l'item è già stato raccolto
 407+ 6D4B B7               or   a
 408+ 6D4C 20 3E            jr   nz, .next_no_inc
 409+ 6D4E
 410+ 6D4E                  ; ---------------------------------------------------------------
 411+ 6D4E                  ; Disegna l'item sullo schermo
 412+ 6D4E                  ;
 413+ 6D4E                  ; B = Row
 414+ 6D4E                  ; C = Column
 415+ 6D4E                  ; HL = bitmap pointer
 416+ 6D4E                  ; E = Color
 417+ 6D4E                  ; ---------------------------------------------------------------
 418+ 6D4E E5               push hl
 419+ 6D4F
 420+ 6D4F DD E5            push ix
 421+ 6D51 E1               pop  hl
 422+ 6D52
 423+ 6D52 CD 97 6D         call DrawItemGraphic
 424+ 6D55
 425+ 6D55 E1               pop  hl                ; ritorna al flag collected
 426+ 6D56
 427+ 6D56                  ; ---------------------------------------------------------------
 428+ 6D56                  ; Aggiorna items_grid
 429+ 6D56                  ;
 430+ 6D56                  ; Calcolo:
 431+ 6D56                  ;   offset = Row * 32 + Col
 432+ 6D56                  ; ---------------------------------------------------------------
 433+ 6D56 E5               push hl
 434+ 6D57 D5               push de
 435+ 6D58
 436+ 6D58 26 00            ld   h, 0
 437+ 6D5A 68               ld   l, b              ; HL = Row
 438+ 6D5B
 439+ 6D5B 29               add  hl, hl            ; *2
 440+ 6D5C 29               add  hl, hl            ; *4
 441+ 6D5D 29               add  hl, hl            ; *8
 442+ 6D5E 29               add  hl, hl            ; *16
 443+ 6D5F 29               add  hl, hl            ; *32
 444+ 6D60
 445+ 6D60 16 00            ld   d, 0
 446+ 6D62 59               ld   e, c              ; DE = Col
 447+ 6D63
 448+ 6D63 19               add  hl, de            ; Row*32 + Col
 449+ 6D64
 450+ 6D64 11 00 90         ld   de, items_grid
 451+ 6D67 19               add  hl, de            ; puntatore nella griglia
 452+ 6D68
 453+ 6D68 D1               pop  de                ; ripristina colore
 454+ 6D69
 455+ 6D69 73               ld   (hl), e           ; salva colore cella
 456+ 6D6A
 457+ 6D6A E1               pop  hl
 458+ 6D6B
 459+ 6D6B                  ; ---------------------------------------------------------------
 460+ 6D6B                  ; Salva l'item nella cache della stanza
 461+ 6D6B                  ;
 462+ 6D6B                  ; Questo evita di dover scansionare tutta ItemsTable
 463+ 6D6B                  ; durante il controllo delle collisioni.
 464+ 6D6B                  ; ---------------------------------------------------------------
 465+ 6D6B
 466+ 6D6B FD 71 00         ld   (iy+0), c         ; Colonna
 467+ 6D6E FD 70 01         ld   (iy+1), b         ; Riga
 468+ 6D71 FD 73 02         ld   (iy+2), e         ; Colore
 469+ 6D74
 470+ 6D74                  ; Salva il puntatore al flag "collected"
 471+ 6D74 FD 75 03         ld   (iy+3), l         ; Low byte
 472+ 6D77 FD 74 04         ld   (iy+4), h         ; High byte
 473+ 6D7A
 474+ 6D7A                  ; Passa al record successivo della cache
 475+ 6D7A 01 05 00         ld   bc, 5
 476+ 6D7D FD 09            add  iy, bc
 477+ 6D7F
 478+ 6D7F                  ; Incrementa il numero di item attivi
 479+ 6D7F 3A 9F 7E         ld   a, (num_room_items)
 480+ 6D82 3C               inc  a
 481+ 6D83 32 9F 7E         ld   (num_room_items), a
 482+ 6D86
 483+ 6D86 18 04            jr   .next_no_inc
 484+ 6D88
 485+ 6D88              .next_item:
 486+ 6D88
 487+ 6D88                  ; ---------------------------------------------------------------
 488+ 6D88                  ; L'item non appartiene alla stanza corrente.
 489+ 6D88                  ; Salta i campi del record:
 490+ 6D88                  ;   X
 491+ 6D88                  ;   Y
 492+ 6D88                  ;   Color
 493+ 6D88                  ;   Collected
 494+ 6D88                  ; ---------------------------------------------------------------
 495+ 6D88 23               inc  hl
 496+ 6D89 23               inc  hl
 497+ 6D8A 23               inc  hl
 498+ 6D8B 23               inc  hl
 499+ 6D8C
 500+ 6D8C              .next_no_inc:
 501+ 6D8C
 502+ 6D8C                  ; ---------------------------------------------------------------
 503+ 6D8C                  ; Avanza al record successivo
 504+ 6D8C                  ; (prossimo Room ID)
 505+ 6D8C                  ; ---------------------------------------------------------------
 506+ 6D8C 23               inc  hl
 507+ 6D8D 18 A8            jr   .loop
 508+ 6D8F
 509+ 6D8F              .done:
 510+ 6D8F
 511+ 6D8F                  ; Ripristina i registri
 512+ 6D8F FD E1            pop  iy
 513+ 6D91 DD E1            pop  ix
 514+ 6D93 D1               pop  de
 515+ 6D94 C1               pop  bc
 516+ 6D95 E1               pop  hl
 517+ 6D96
 518+ 6D96 C9               ret
 519+ 6D97
 520+ 6D97              ; -------------------------------------------------------------------
 521+ 6D97              ; DrawItemGraphic
 522+ 6D97              ;
 523+ 6D97              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 524+ 6D97              ; utilizzando una bitmap di 8 byte e un attributo colore.
 525+ 6D97              ;
 526+ 6D97              ; Input:
 527+ 6D97              ;   B = Riga attributi (3..18)
 528+ 6D97              ;   C = Colonna attributi (0..31)
 529+ 6D97              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 530+ 6D97              ;   E = Attributo colore
 531+ 6D97              ;
 532+ 6D97              ; Output:
 533+ 6D97              ;   Nessuno
 534+ 6D97              ;
 535+ 6D97              ; Registri preservati:
 536+ 6D97              ;   BC, DE, HL
 537+ 6D97              ; -------------------------------------------------------------------
 538+ 6D97              DrawItemGraphic:
 539+ 6D97
 540+ 6D97                  ; Salva i registri originali
 541+ 6D97 C5               push bc
 542+ 6D98 D5               push de
 543+ 6D99 E5               push hl
 544+ 6D9A
 545+ 6D9A                  ; ---------------------------------------------------------------
 546+ 6D9A                  ; Calcolo indirizzo bitmap dello Spectrum
 547+ 6D9A                  ;
 548+ 6D9A                  ; Ogni item occupa una cella attributi (8x8 pixel).
 549+ 6D9A                  ;
 550+ 6D9A                  ; Formula:
 551+ 6D9A                  ;   High = $40 + (Row AND $18)
 552+ 6D9A                  ;   Low  = (Row AND 7) * 32 + Col
 553+ 6D9A                  ;
 554+ 6D9A                  ; DE conterrà l'indirizzo della prima scanline.
 555+ 6D9A                  ; ---------------------------------------------------------------
 556+ 6D9A
 557+ 6D9A 78               ld   a, b
 558+ 6D9B E6 18            and  $18
 559+ 6D9D C6 40            add  a, $40
 560+ 6D9F 57               ld   d, a              ; Byte alto indirizzo video
 561+ 6DA0
 562+ 6DA0 78               ld   a, b
 563+ 6DA1 E6 07            and  7                 ; Riga interna al blocco da 8
 564+ 6DA3
 565+ 6DA3 87               add  a, a              ; *2
 566+ 6DA4 87               add  a, a              ; *4
 567+ 6DA5 87               add  a, a              ; *8
 568+ 6DA6 87               add  a, a              ; *16
 569+ 6DA7 87               add  a, a              ; *32
 570+ 6DA8
 571+ 6DA8 81               add  a, c              ; + colonna
 572+ 6DA9
 573+ 6DA9 5F               ld   e, a              ; Byte basso indirizzo video
 574+ 6DAA
 575+ 6DAA                  ; ---------------------------------------------------------------
 576+ 6DAA                  ; Disegno bitmap
 577+ 6DAA                  ;
 578+ 6DAA                  ; Copia 8 byte consecutivi nella memoria video.
 579+ 6DAA                  ; Ogni byte rappresenta una scanline da 8 pixel.
 580+ 6DAA                  ; ---------------------------------------------------------------
 581+ 6DAA
 582+ 6DAA C5               push bc                ; Conserva Row e Col
 583+ 6DAB
 584+ 6DAB 06 08            ld   b, 8              ; Numero scanline
 585+ 6DAD
 586+ 6DAD              .line_loop:
 587+ 6DAD
 588+ 6DAD 7E               ld   a, (hl)           ; Legge scanline bitmap
 589+ 6DAE 12               ld   (de), a           ; Scrive nella memoria video
 590+ 6DAF
 591+ 6DAF 14               inc  d                 ; Scanline successiva
 592+ 6DB0 23               inc  hl                ; Byte bitmap successivo
 593+ 6DB1
 594+ 6DB1 05               dec  b
 595+ 6DB2 20 F9            jr   nz, .line_loop
 596+ 6DB4
 597+ 6DB4 C1               pop  bc                ; Ripristina Row e Col
 598+ 6DB5
 599+ 6DB5                  ; ---------------------------------------------------------------
 600+ 6DB5                  ; Calcolo indirizzo attributo
 601+ 6DB5                  ;
 602+ 6DB5                  ; Formula:
 603+ 6DB5                  ;   AttrAddr = $5800 + Row * 32 + Col
 604+ 6DB5                  ;
 605+ 6DB5                  ; HL conterrà l'indirizzo della cella attributi.
 606+ 6DB5                  ; ---------------------------------------------------------------
 607+ 6DB5
 608+ 6DB5 26 00            ld   h, 0
 609+ 6DB7 68               ld   l, b              ; HL = Row
 610+ 6DB8
 611+ 6DB8 29               add  hl, hl            ; *2
 612+ 6DB9 29               add  hl, hl            ; *4
 613+ 6DBA 29               add  hl, hl            ; *8
 614+ 6DBB 29               add  hl, hl            ; *16
 615+ 6DBC 29               add  hl, hl            ; *32
 616+ 6DBD
 617+ 6DBD 79               ld   a, c              ; A = Colonna
 618+ 6DBE
 619+ 6DBE 85               add  a, l
 620+ 6DBF 6F               ld   l, a
 621+ 6DC0
 622+ 6DC0 30 01            jr   nc, .no_carry
 623+ 6DC2 24               inc  h
 624+ 6DC3
 625+ 6DC3              .no_carry:
 626+ 6DC3
 627+ 6DC3                  ; HL = Row * 32 + Col
 628+ 6DC3
 629+ 6DC3 11 00 58         ld   de, $5800
 630+ 6DC6 19               add  hl, de            ; HL = indirizzo attributi
 631+ 6DC7
 632+ 6DC7                  ; ---------------------------------------------------------------
 633+ 6DC7                  ; Recupera il colore originale dallo stack.
 634+ 6DC7                  ;
 635+ 6DC7                  ; Layout stack:
 636+ 6DC7                  ;   HL originale
 637+ 6DC7                  ;   DE originale (E = colore)
 638+ 6DC7                  ;   BC originale
 639+ 6DC7                  ; ---------------------------------------------------------------
 640+ 6DC7
 641+ 6DC7 C1               pop  bc                ; Recupera HL originale
 642+ 6DC8 D1               pop  de                ; Recupera DE originale
 643+ 6DC9
 644+ 6DC9                  ; ---------------------------------------------------------------
 645+ 6DC9                  ; Scrive l'attributo colore
 646+ 6DC9                  ; ---------------------------------------------------------------
 647+ 6DC9
 648+ 6DC9 7B               ld   a, e              ; A = colore
 649+ 6DCA 77               ld   (hl), a           ; Scrive nella RAM attributi
 650+ 6DCB
 651+ 6DCB                  ; ---------------------------------------------------------------
 652+ 6DCB                  ; Ripristina HL e BC originali
 653+ 6DCB                  ; ---------------------------------------------------------------
 654+ 6DCB
 655+ 6DCB C5               push bc
 656+ 6DCC E1               pop  hl                ; HL originale
 657+ 6DCD
 658+ 6DCD C1               pop  bc                ; BC originale
 659+ 6DCE
 660+ 6DCE C9               ret
 661+ 6DCF
 662+ 6DCF              ; -------------------------------------------------------------------
 663+ 6DCF              ; RestoreBackgroundCell
 664+ 6DCF              ;
 665+ 6DCF              ; Ripristina il contenuto originale di una cella della stanza.
 666+ 6DCF              ; Viene utilizzata principalmente quando un item viene raccolto:
 667+ 6DCF              ; invece di lasciare un "buco", la routine ridisegna il tile
 668+ 6DCF              ; originale presente nella mappa della stanza.
 669+ 6DCF              ;
 670+ 6DCF              ; Input:
 671+ 6DCF              ;   B = Row (3..18)
 672+ 6DCF              ;   C = Col (0..31)
 673+ 6DCF              ;
 674+ 6DCF              ; Utilizza:
 675+ 6DCF              ;   room_ptr -> struttura dati della stanza corrente
 676+ 6DCF              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 677+ 6DCF              ;   DrawTile -> ridisegna il tile selezionato
 678+ 6DCF              ;
 679+ 6DCF              ; Tipi di cella:
 680+ 6DCF              ;   0 = Background
 681+ 6DCF              ;   1 = Floor
 682+ 6DCF              ;   2 = Wall
 683+ 6DCF              ;   3 = Nasty
 684+ 6DCF              ; -------------------------------------------------------------------
 685+ 6DCF              RestoreBackgroundCell:
 686+ 6DCF
 687+ 6DCF                  ; Salva tutti i registri utilizzati
 688+ 6DCF FD E5            push iy
 689+ 6DD1 C5               push bc
 690+ 6DD2 D5               push de
 691+ 6DD3 E5               push hl
 692+ 6DD4 DD E5            push ix
 693+ 6DD6
 694+ 6DD6                  ; ---------------------------------------------------------------
 695+ 6DD6                  ; Conserva Row e Col in IY.
 696+ 6DD6                  ;
 697+ 6DD6                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 698+ 6DD6                  ; BC potrebbe essere modificato.
 699+ 6DD6                  ; ---------------------------------------------------------------
 700+ 6DD6 C5               push bc
 701+ 6DD7 FD E1            pop  iy                ; IYH = Row, IYL = Col
 702+ 6DD9
 703+ 6DD9                  ; ---------------------------------------------------------------
 704+ 6DD9                  ; Determina quale tipo di cella è presente nella posizione
 705+ 6DD9                  ; specificata.
 706+ 6DD9                  ;
 707+ 6DD9                  ; Input:
 708+ 6DD9                  ;   B = Row
 709+ 6DD9                  ;   C = Col
 710+ 6DD9                  ;
 711+ 6DD9                  ; Output:
 712+ 6DD9                  ;   A = tipo cella
 713+ 6DD9                  ; ---------------------------------------------------------------
 714+ 6DD9 78               ld   a, b
 715+ 6DDA
 716+ 6DDA CD B6 68         call GetCellFromUnpacked
 717+ 6DDD
 718+ 6DDD                  ; ---------------------------------------------------------------
 719+ 6DDD                  ; Recupera il puntatore alla stanza corrente.
 720+ 6DDD                  ;
 721+ 6DDD                  ; DE = base della struttura stanza
 722+ 6DDD                  ; ---------------------------------------------------------------
 723+ 6DDD ED 5B A0 7E      ld   de, (room_ptr)
 724+ 6DE1
 725+ 6DE1                  ; ---------------------------------------------------------------
 726+ 6DE1                  ; Seleziona il tile corretto in base al tipo di cella.
 727+ 6DE1                  ;
 728+ 6DE1                  ; A = 0 -> Background
 729+ 6DE1                  ; A = 1 -> Floor
 730+ 6DE1                  ; A = 2 -> Wall
 731+ 6DE1                  ; A = 3 -> Nasty
 732+ 6DE1                  ; ---------------------------------------------------------------
 733+ 6DE1
 734+ 6DE1 B7               or   a
 735+ 6DE2 20 06            jr   nz, .not_bg
 736+ 6DE4
 737+ 6DE4                  ; Background
 738+ 6DE4 21 A0 00         ld   hl, OFFSET_BG
 739+ 6DE7 19               add  hl, de
 740+ 6DE8 18 16            jr   .draw_cell
 741+ 6DEA
 742+ 6DEA              .not_bg:
 743+ 6DEA
 744+ 6DEA 3D               dec  a
 745+ 6DEB 20 06            jr   nz, .not_floor
 746+ 6DED
 747+ 6DED                  ; Floor
 748+ 6DED 21 A9 00         ld   hl, OFFSET_FLOOR
 749+ 6DF0 19               add  hl, de
 750+ 6DF1 18 0D            jr   .draw_cell
 751+ 6DF3
 752+ 6DF3              .not_floor:
 753+ 6DF3
 754+ 6DF3 3D               dec  a
 755+ 6DF4 20 06            jr   nz, .not_wall
 756+ 6DF6
 757+ 6DF6                  ; Wall
 758+ 6DF6 21 B2 00         ld   hl, OFFSET_WALL
 759+ 6DF9 19               add  hl, de
 760+ 6DFA 18 04            jr   .draw_cell
 761+ 6DFC
 762+ 6DFC              .not_wall:
 763+ 6DFC
 764+ 6DFC                  ; Nasty
 765+ 6DFC 21 BB 00         ld   hl, OFFSET_NASTY
 766+ 6DFF 19               add  hl, de
 767+ 6E00
 768+ 6E00              .draw_cell:
 769+ 6E00
 770+ 6E00                  ; ---------------------------------------------------------------
 771+ 6E00                  ; HL punta ora alla grafica del tile da ridisegnare.
 772+ 6E00                  ;
 773+ 6E00                  ; DrawTile si aspetta:
 774+ 6E00                  ;   IX = puntatore tile
 775+ 6E00                  ;   B  = Row
 776+ 6E00                  ;   C  = Col
 777+ 6E00                  ; ---------------------------------------------------------------
 778+ 6E00 E5               push hl
 779+ 6E01 DD E1            pop  ix
 780+ 6E03
 781+ 6E03                  ; Ripristina Row e Col salvati in IY
 782+ 6E03 FD E5            push iy
 783+ 6E05 C1               pop  bc
 784+ 6E06
 785+ 6E06                  ; Disegna il tile originale
 786+ 6E06 CD 8C 61         call DrawTile
 787+ 6E09
 788+ 6E09                  ; ---------------------------------------------------------------
 789+ 6E09                  ; Ripristina i registri salvati
 790+ 6E09                  ; ---------------------------------------------------------------
 791+ 6E09 DD E1            pop  ix
 792+ 6E0B E1               pop  hl
 793+ 6E0C D1               pop  de
 794+ 6E0D C1               pop  bc
 795+ 6E0E FD E1            pop  iy
 796+ 6E10
 797+ 6E10 C9               ret
 798+ 6E11
 799+ 6E11              ; -------------------------------------------------------------------
 800+ 6E11              ; CheckWillyItemCollision
 801+ 6E11              ;
 802+ 6E11              ; Verifica se Willy collide con un item utilizzando il controllo
 803+ 6E11              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 804+ 6E11              ;
 805+ 6E11              ; Input:
 806+ 6E11              ;   A = ItemX (colonna attributi 0..31)
 807+ 6E11              ;   H = ItemY (riga attributi 3..18)
 808+ 6E11              ;
 809+ 6E11              ; Coordinate item:
 810+ 6E11              ;   Ogni item occupa una cella da 8x8 pixel.
 811+ 6E11              ;
 812+ 6E11              ; Coordinate Willy:
 813+ 6E11              ;   Willy occupa un rettangolo di 16x16 pixel.
 814+ 6E11              ;
 815+ 6E11              ; Output:
 816+ 6E11              ;   Carry Set   = collisione rilevata
 817+ 6E11              ;   Carry Clear = nessuna collisione
 818+ 6E11              ;
 819+ 6E11              ; Registri preservati:
 820+ 6E11              ;   BC, DE, HL
 821+ 6E11              ; -------------------------------------------------------------------
 822+ 6E11              CheckWillyItemCollision:
 823+ 6E11
 824+ 6E11                  ; Salva i registri utilizzati
 825+ 6E11 C5               push bc
 826+ 6E12 D5               push de
 827+ 6E13 E5               push hl
 828+ 6E14
 829+ 6E14                  ; ---------------------------------------------------------------
 830+ 6E14                  ; Calcola il bounding box orizzontale dell'item
 831+ 6E14                  ;
 832+ 6E14                  ; ItemLeft  = ItemX * 8
 833+ 6E14                  ; ItemRight = ItemLeft + 7
 834+ 6E14                  ;
 835+ 6E14                  ; E = ItemLeft
 836+ 6E14                  ; D = ItemRight
 837+ 6E14                  ; ---------------------------------------------------------------
 838+ 6E14 6F               ld   l, a              ; L = ItemX
 839+ 6E15
 840+ 6E15 7D               ld   a, l
 841+ 6E16 87               add  a, a              ; *2
 842+ 6E17 87               add  a, a              ; *4
 843+ 6E18 87               add  a, a              ; *8
 844+ 6E19
 845+ 6E19 5F               ld   e, a              ; E = ItemLeft
 846+ 6E1A
 847+ 6E1A C6 07            add  a, 7
 848+ 6E1C 57               ld   d, a              ; D = ItemRight
 849+ 6E1D
 850+ 6E1D                  ; ---------------------------------------------------------------
 851+ 6E1D                  ; Recupera la posizione corrente di Willy
 852+ 6E1D                  ;
 853+ 6E1D                  ; B = WillyY
 854+ 6E1D                  ; C = WillyX
 855+ 6E1D                  ; ---------------------------------------------------------------
 856+ 6E1D ED 4B 32 7B      ld   bc, (PlayerPos)
 857+ 6E21
 858+ 6E21                  ; ---------------------------------------------------------------
 859+ 6E21                  ; Primo test:
 860+ 6E21                  ;
 861+ 6E21                  ; WillyLeft <= ItemRight
 862+ 6E21                  ;
 863+ 6E21                  ; Se Willy è completamente a destra dell'item
 864+ 6E21                  ; non può esserci collisione.
 865+ 6E21                  ; ---------------------------------------------------------------
 866+ 6E21 79               ld   a, c              ; A = WillyLeft
 867+ 6E22
 868+ 6E22 BA               cp   d                 ; WillyLeft vs ItemRight
 869+ 6E23
 870+ 6E23 28 04            jr   z, .x_ok
 871+ 6E25 38 02            jr   c, .x_ok
 872+ 6E27
 873+ 6E27 18 29            jr   .no_collision
 874+ 6E29
 875+ 6E29              .x_ok:
 876+ 6E29
 877+ 6E29                  ; ---------------------------------------------------------------
 878+ 6E29                  ; Secondo test:
 879+ 6E29                  ;
 880+ 6E29                  ; WillyRight >= ItemLeft
 881+ 6E29                  ;
 882+ 6E29                  ; WillyRight = WillyX + 7
 883+ 6E29                  ; ---------------------------------------------------------------
 884+ 6E29 C6 07            add  a, 7
 885+ 6E2B
 886+ 6E2B BB               cp   e                 ; WillyRight vs ItemLeft
 887+ 6E2C
 888+ 6E2C 28 04            jr   z, .y_check
 889+ 6E2E 30 02            jr   nc, .y_check
 890+ 6E30
 891+ 6E30 18 20            jr   .no_collision
 892+ 6E32
 893+ 6E32              .y_check:
 894+ 6E32
 895+ 6E32                  ; ---------------------------------------------------------------
 896+ 6E32                  ; Recupera ItemY dal valore originale di HL
 897+ 6E32                  ;
 898+ 6E32                  ; H contiene la riga dell'item.
 899+ 6E32                  ; ---------------------------------------------------------------
 900+ 6E32 E1               pop  hl
 901+ 6E33 E5               push hl
 902+ 6E34
 903+ 6E34                  ; ---------------------------------------------------------------
 904+ 6E34                  ; Calcola il bounding box verticale dell'item
 905+ 6E34                  ;
 906+ 6E34                  ; ItemTop    = ItemY * 8
 907+ 6E34                  ; ItemBottom = ItemTop + 7
 908+ 6E34                  ;
 909+ 6E34                  ; E = ItemTop
 910+ 6E34                  ; D = ItemBottom
 911+ 6E34                  ; ---------------------------------------------------------------
 912+ 6E34 7C               ld   a, h
 913+ 6E35
 914+ 6E35 87               add  a, a              ; *2
 915+ 6E36 87               add  a, a              ; *4
 916+ 6E37 87               add  a, a              ; *8
 917+ 6E38
 918+ 6E38 5F               ld   e, a              ; ItemTop
 919+ 6E39
 920+ 6E39 C6 07            add  a, 7
 921+ 6E3B 57               ld   d, a              ; ItemBottom
 922+ 6E3C
 923+ 6E3C                  ; ---------------------------------------------------------------
 924+ 6E3C                  ; Primo test verticale:
 925+ 6E3C                  ;
 926+ 6E3C                  ; WillyTop <= ItemBottom
 927+ 6E3C                  ; ---------------------------------------------------------------
 928+ 6E3C 78               ld   a, b              ; WillyTop
 929+ 6E3D
 930+ 6E3D BA               cp   d
 931+ 6E3E
 932+ 6E3E 28 04            jr   z, .y_ok
 933+ 6E40 38 02            jr   c, .y_ok
 934+ 6E42
 935+ 6E42 18 0E            jr   .no_collision
 936+ 6E44
 937+ 6E44              .y_ok:
 938+ 6E44
 939+ 6E44                  ; ---------------------------------------------------------------
 940+ 6E44                  ; Secondo test verticale:
 941+ 6E44                  ;
 942+ 6E44                  ; WillyBottom >= ItemTop
 943+ 6E44                  ;
 944+ 6E44                  ; WillyBottom = WillyY + 15
 945+ 6E44                  ; ---------------------------------------------------------------
 946+ 6E44 C6 0F            add  a, 15
 947+ 6E46
 948+ 6E46 BB               cp   e
 949+ 6E47
 950+ 6E47 28 04            jr   z, .collision
 951+ 6E49 30 02            jr   nc, .collision
 952+ 6E4B
 953+ 6E4B 18 05            jr   .no_collision
 954+ 6E4D
 955+ 6E4D              .collision:
 956+ 6E4D
 957+ 6E4D                  ; ---------------------------------------------------------------
 958+ 6E4D                  ; Collisione rilevata
 959+ 6E4D                  ; ---------------------------------------------------------------
 960+ 6E4D E1               pop  hl
 961+ 6E4E D1               pop  de
 962+ 6E4F C1               pop  bc
 963+ 6E50
 964+ 6E50 37               scf                    ; Carry = 1
 965+ 6E51
 966+ 6E51 C9               ret
 967+ 6E52
 968+ 6E52              .no_collision:
 969+ 6E52
 970+ 6E52                  ; ---------------------------------------------------------------
 971+ 6E52                  ; Nessuna collisione
 972+ 6E52                  ; ---------------------------------------------------------------
 973+ 6E52 E1               pop  hl
 974+ 6E53 D1               pop  de
 975+ 6E54 C1               pop  bc
 976+ 6E55
 977+ 6E55 B7               or   a                 ; Carry = 0
 978+ 6E56
 979+ 6E56 C9               ret
 980+ 6E57
 981+ 6E57              ; -------------------------------------------------------------------
 982+ 6E57              ; CheckRoomItemsCollision
 983+ 6E57              ;
 984+ 6E57              ; Controlla se Willy entra in collisione con uno degli item
 985+ 6E57              ; attivi presenti nella stanza corrente.
 986+ 6E57              ;
 987+ 6E57              ; Per ogni item:
 988+ 6E57              ;   - verifica che appartenga alla stanza corrente
 989+ 6E57              ;   - verifica che non sia già stato raccolto
 990+ 6E57              ;   - esegue il test di collisione con Willy
 991+ 6E57              ;
 992+ 6E57              ; Se l'item viene raccolto:
 993+ 6E57              ;   - imposta il flag "collected"
 994+ 6E57              ;   - rimuove l'item dalla cache items_grid
 995+ 6E57              ;   - incrementa il contatore degli oggetti raccolti
 996+ 6E57              ;   - aggiorna l'HUD
 997+ 6E57              ;   - ripristina il tile di sfondo
 998+ 6E57              ;   - riproduce il suono di raccolta
 999+ 6E57              ;
1000+ 6E57              ; Formato record ItemsTable:
1001+ 6E57              ;   +0 RoomID
1002+ 6E57              ;   +1 X
1003+ 6E57              ;   +2 Y
1004+ 6E57              ;   +3 Color
1005+ 6E57              ;   +4 Collected
1006+ 6E57              ;
1007+ 6E57              ; Fine tabella:
1008+ 6E57              ;   RoomID = $FF
1009+ 6E57              ; -------------------------------------------------------------------
1010+ 6E57              CheckRoomItemsCollision:
1011+ 6E57
1012+ 6E57                  ; Salva i registri utilizzati
1013+ 6E57 E5               push hl
1014+ 6E58 D5               push de
1015+ 6E59 C5               push bc
1016+ 6E5A
1017+ 6E5A                  ; Inizio scansione della tabella degli item
1018+ 6E5A 21 DE 6B         ld   hl, ItemsTable
1019+ 6E5D
1020+ 6E5D              .loop:
1021+ 6E5D
1022+ 6E5D                  ; ---------------------------------------------------------------
1023+ 6E5D                  ; Legge il Room ID dell'item corrente
1024+ 6E5D                  ; ---------------------------------------------------------------
1025+ 6E5D 7E               ld   a, (hl)
1026+ 6E5E
1027+ 6E5E                  ; $FF indica fine tabella
1028+ 6E5E FE FF            cp   $FF
1029+ 6E60 28 4D            jr   z, .done
1030+ 6E62
1031+ 6E62                  ; ---------------------------------------------------------------
1032+ 6E62                  ; Verifica se l'item appartiene alla stanza corrente
1033+ 6E62                  ; ---------------------------------------------------------------
1034+ 6E62 57               ld   d, a              ; D = RoomID item
1035+ 6E63
1036+ 6E63 3A 46 7E         ld   a, (current_room)
1037+ 6E66 BA               cp   d
1038+ 6E67
1039+ 6E67                  ; Se appartiene a un'altra stanza salta il record
1040+ 6E67 20 3F            jr   nz, .next_item
1041+ 6E69
1042+ 6E69                  ; ---------------------------------------------------------------
1043+ 6E69                  ; Legge coordinate e stato dell'item
1044+ 6E69                  ; ---------------------------------------------------------------
1045+ 6E69
1046+ 6E69 23               inc  hl
1047+ 6E6A 4E               ld   c, (hl)           ; C = X
1048+ 6E6B
1049+ 6E6B 23               inc  hl
1050+ 6E6C 46               ld   b, (hl)           ; B = Y
1051+ 6E6D
1052+ 6E6D 23               inc  hl                ; salta Color
1053+ 6E6E
1054+ 6E6E 23               inc  hl                ; punta a Collected
1055+ 6E6F
1056+ 6E6F 7E               ld   a, (hl)
1057+ 6E70
1058+ 6E70                  ; ---------------------------------------------------------------
1059+ 6E70                  ; Item già raccolto?
1060+ 6E70                  ; ---------------------------------------------------------------
1061+ 6E70 B7               or   a
1062+ 6E71 20 39            jr   nz, .next_no_inc
1063+ 6E73
1064+ 6E73                  ; ---------------------------------------------------------------
1065+ 6E73                  ; Test collisione Willy ↔ Item
1066+ 6E73                  ;
1067+ 6E73                  ; Input richiesto:
1068+ 6E73                  ;   A = ItemX
1069+ 6E73                  ;   H = ItemY
1070+ 6E73                  ; ---------------------------------------------------------------
1071+ 6E73 79               ld   a, c
1072+ 6E74
1073+ 6E74 E5               push hl                ; salva puntatore al flag Collected
1074+ 6E75
1075+ 6E75 60               ld   h, b
1076+ 6E76
1077+ 6E76 CD 11 6E         call CheckWillyItemCollision
1078+ 6E79
1079+ 6E79 E1               pop  hl
1080+ 6E7A
1081+ 6E7A                  ; Nessuna collisione
1082+ 6E7A 30 30            jr   nc, .next_no_inc
1083+ 6E7C
1084+ 6E7C                  ; ===============================================================
1085+ 6E7C                  ; ITEM RACCOLTO
1086+ 6E7C                  ; ===============================================================
1087+ 6E7C
1088+ 6E7C                  ; ---------------------------------------------------------------
1089+ 6E7C                  ; Marca l'item come raccolto
1090+ 6E7C                  ; ---------------------------------------------------------------
1091+ 6E7C 36 01            ld   (hl), 1
1092+ 6E7E
1093+ 6E7E                  ; ---------------------------------------------------------------
1094+ 6E7E                  ; Rimuove l'item dalla cache items_grid
1095+ 6E7E                  ;
1096+ 6E7E                  ; Calcolo:
1097+ 6E7E                  ;   offset = Row * 32 + Col
1098+ 6E7E                  ; ---------------------------------------------------------------
1099+ 6E7E E5               push hl
1100+ 6E7F D5               push de
1101+ 6E80
1102+ 6E80 26 00            ld   h, 0
1103+ 6E82 68               ld   l, b              ; HL = Row
1104+ 6E83
1105+ 6E83 29               add  hl, hl            ; *2
1106+ 6E84 29               add  hl, hl            ; *4
1107+ 6E85 29               add  hl, hl            ; *8
1108+ 6E86 29               add  hl, hl            ; *16
1109+ 6E87 29               add  hl, hl            ; *32
1110+ 6E88
1111+ 6E88 59               ld   e, c
1112+ 6E89 16 00            ld   d, 0
1113+ 6E8B
1114+ 6E8B 19               add  hl, de            ; Row*32 + Col
1115+ 6E8C
1116+ 6E8C 11 00 90         ld   de, items_grid
1117+ 6E8F 19               add  hl, de
1118+ 6E90
1119+ 6E90                  ; La cella non contiene più un item
1120+ 6E90 36 00            ld   (hl), 0
1121+ 6E92
1122+ 6E92 D1               pop  de
1123+ 6E93 E1               pop  hl
1124+ 6E94
1125+ 6E94                  ; ---------------------------------------------------------------
1126+ 6E94                  ; Conserva il puntatore all'entry corrente
1127+ 6E94                  ; poiché le routine successive possono alterare HL.
1128+ 6E94                  ; ---------------------------------------------------------------
1129+ 6E94 E5               push hl
1130+ 6E95
1131+ 6E95                  ; ---------------------------------------------------------------
1132+ 6E95                  ; Aggiorna il numero di oggetti raccolti
1133+ 6E95                  ; ---------------------------------------------------------------
1134+ 6E95 3A 3C 7B         ld   a, (items_collected)
1135+ 6E98
1136+ 6E98 3C               inc  a
1137+ 6E99
1138+ 6E99 32 3C 7B         ld   (items_collected), a
1139+ 6E9C
1140+ 6E9C                  ; ---------------------------------------------------------------
1141+ 6E9C                  ; Aggiorna il contatore visualizzato a schermo
1142+ 6E9C                  ; ---------------------------------------------------------------
1143+ 6E9C CD CB 60         call UpdateItemsCollectedDisplay
1144+ 6E9F
1145+ 6E9F                  ; ---------------------------------------------------------------
1146+ 6E9F                  ; Ripristina il tile originale della stanza
1147+ 6E9F                  ; eliminando la grafica dell'item.
1148+ 6E9F                  ;
1149+ 6E9F                  ; Input:
1150+ 6E9F                  ;   B = Row
1151+ 6E9F                  ;   C = Col
1152+ 6E9F                  ; ---------------------------------------------------------------
1153+ 6E9F CD CF 6D         call RestoreBackgroundCell
1154+ 6EA2
1155+ 6EA2                  ; ---------------------------------------------------------------
1156+ 6EA2                  ; Riproduce il suono di raccolta
1157+ 6EA2                  ; ---------------------------------------------------------------
1158+ 6EA2 CD B3 6E         call PlayCollectSound
1159+ 6EA5
1160+ 6EA5                  ; Ripristina il puntatore alla tabella
1161+ 6EA5 E1               pop  hl
1162+ 6EA6
1163+ 6EA6                  ; Continua con il record successivo
1164+ 6EA6 18 04            jr   .next_no_inc
1165+ 6EA8
1166+ 6EA8              .next_item:
1167+ 6EA8
1168+ 6EA8                  ; ---------------------------------------------------------------
1169+ 6EA8                  ; Salta i campi del record:
1170+ 6EA8                  ;   X
1171+ 6EA8                  ;   Y
1172+ 6EA8                  ;   Color
1173+ 6EA8                  ;   Collected
1174+ 6EA8                  ; ---------------------------------------------------------------
1175+ 6EA8 23               inc  hl
1176+ 6EA9 23               inc  hl
1177+ 6EAA 23               inc  hl
1178+ 6EAB 23               inc  hl
1179+ 6EAC
1180+ 6EAC              .next_no_inc:
1181+ 6EAC
1182+ 6EAC                  ; ---------------------------------------------------------------
1183+ 6EAC                  ; Avanza al record successivo.
1184+ 6EAC                  ;
1185+ 6EAC                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1186+ 6EAC                  ; ---------------------------------------------------------------
1187+ 6EAC 23               inc  hl
1188+ 6EAD
1189+ 6EAD 18 AE            jr   .loop
1190+ 6EAF
1191+ 6EAF              .done:
1192+ 6EAF
1193+ 6EAF                  ; Ripristina i registri
1194+ 6EAF C1               pop  bc
1195+ 6EB0 D1               pop  de
1196+ 6EB1 E1               pop  hl
1197+ 6EB2
1198+ 6EB2 C9               ret
1199+ 6EB3
1200+ 6EB3              ; -------------------------------------------------------------------
1201+ 6EB3              ; PlayCollectSound
1202+ 6EB3              ;
1203+ 6EB3              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1204+ 6EB3              ; dello ZX Spectrum utilizzando il port $FE.
1205+ 6EB3              ;
1206+ 6EB3              ; Il suono viene prodotto alternando ON/OFF del bit 4
1207+ 6EB3              ; (speaker) con un semplice delay software.
1208+ 6EB3              ;
1209+ 6EB3              ; Effetto risultante:
1210+ 6EB3              ;   beep breve tipo "pickup item"
1211+ 6EB3              ; -------------------------------------------------------------------
1212+ 6EB3              PlayCollectSound:
1213+ 6EB3
1214+ 6EB3                  ; Salva registri utilizzati
1215+ 6EB3 C5               push bc
1216+ 6EB4 D5               push de
1217+ 6EB5
1218+ 6EB5                  ; ---------------------------------------------------------------
1219+ 6EB5                  ; Numero di cicli del beep (durata complessiva del suono)
1220+ 6EB5                  ; ---------------------------------------------------------------
1221+ 6EB5 06 78            ld   b, 120
1222+ 6EB7
1223+ 6EB7              .sound_loop:
1224+ 6EB7
1225+ 6EB7                  ; ---------------------------------------------------------------
1226+ 6EB7                  ; SPEAKER ON
1227+ 6EB7                  ;
1228+ 6EB7                  ; Legge il colore del bordo corrente e attiva il bit 4
1229+ 6EB7                  ; per pilotare lo speaker.
1230+ 6EB7                  ; ---------------------------------------------------------------
1231+ 6EB7 3A 3E 7B         ld   a, (room_border_color)
1232+ 6EBA F6 10            or   $10               ; bit 4 = 1 → speaker ON
1233+ 6EBC
1234+ 6EBC D3 FE            out  ($fe), a         ; scrive sul port ULA
1235+ 6EBE
1236+ 6EBE                  ; ---------------------------------------------------------------
1237+ 6EBE                  ; Delay (mezzo periodo)
1238+ 6EBE                  ; Loop software a consumo CPU
1239+ 6EBE                  ; ---------------------------------------------------------------
1240+ 6EBE 0E 3C            ld   c, 60
1241+ 6EC0
1242+ 6EC0              .d1:
1243+ 6EC0 0D               dec  c
1244+ 6EC1 20 FD            jr   nz, .d1
1245+ 6EC3
1246+ 6EC3                  ; ---------------------------------------------------------------
1247+ 6EC3                  ; SPEAKER OFF
1248+ 6EC3                  ;
1249+ 6EC3                  ; Mantiene il colore del bordo ma disattiva lo speaker
1250+ 6EC3                  ; ---------------------------------------------------------------
1251+ 6EC3 3A 3E 7B         ld   a, (room_border_color)
1252+ 6EC6 E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1253+ 6EC8
1254+ 6EC8 D3 FE            out  ($fe), a
1255+ 6ECA
1256+ 6ECA                  ; ---------------------------------------------------------------
1257+ 6ECA                  ; Secondo delay (mezzo periodo)
1258+ 6ECA                  ; Completa l’onda quadra
1259+ 6ECA                  ; ---------------------------------------------------------------
1260+ 6ECA 0E 3C            ld   c, 60
1261+ 6ECC
1262+ 6ECC              .d2:
1263+ 6ECC 0D               dec  c
1264+ 6ECD 20 FD            jr   nz, .d2
1265+ 6ECF
1266+ 6ECF                  ; ---------------------------------------------------------------
1267+ 6ECF                  ; Ripete fino a completare il numero di cicli
1268+ 6ECF                  ; ---------------------------------------------------------------
1269+ 6ECF 10 E6            djnz .sound_loop
1270+ 6ED1
1271+ 6ED1                  ; Ripristina registri salvati
1272+ 6ED1 D1               pop  de
1273+ 6ED2 C1               pop  bc
1274+ 6ED3
1275+ 6ED3 C9               ret
1276+ 6ED4
1277+ 6ED4              ; -------------------------------------------------------------------
1278+ 6ED4              ; CheckActiveItemAtCell
1279+ 6ED4              ;
1280+ 6ED4              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1281+ 6ED4              ; nella cella specificata della griglia items_grid.
1282+ 6ED4              ;
1283+ 6ED4              ; Questa routine usa una lookup diretta su una mappa 32x16,
1284+ 6ED4              ; evitando la scansione della ItemsTable.
1285+ 6ED4              ;
1286+ 6ED4              ; Input:
1287+ 6ED4              ;   B = Colonna (0..31)
1288+ 6ED4              ;   C = Riga (0..15)
1289+ 6ED4              ;
1290+ 6ED4              ; Output:
1291+ 6ED4              ;   Carry Set   = item presente nella cella
1292+ 6ED4              ;   Carry Clear = nessun item
1293+ 6ED4              ;
1294+ 6ED4              ; Nota:
1295+ 6ED4              ;   HL NON è restituito valido (commento originale non corretto:
1296+ 6ED4              ;   la routine non punta a ItemsTable).
1297+ 6ED4              ; -------------------------------------------------------------------
1298+ 6ED4              CheckActiveItemAtCell:
1299+ 6ED4
1300+ 6ED4                  ; Salva registri usati
1301+ 6ED4 D5               push de
1302+ 6ED5 E5               push hl
1303+ 6ED6
1304+ 6ED6                  ; ---------------------------------------------------------------
1305+ 6ED6                  ; Calcolo indice lineare nella griglia 32x16:
1306+ 6ED6                  ;
1307+ 6ED6                  ; offset = Row * 32 + Col
1308+ 6ED6                  ; ---------------------------------------------------------------
1309+ 6ED6 26 00            ld   h, 0
1310+ 6ED8 69               ld   l, c              ; HL = Row
1311+ 6ED9
1312+ 6ED9 29               add  hl, hl            ; *2
1313+ 6EDA 29               add  hl, hl            ; *4
1314+ 6EDB 29               add  hl, hl            ; *8
1315+ 6EDC 29               add  hl, hl            ; *16
1316+ 6EDD 29               add  hl, hl            ; *32
1317+ 6EDE
1318+ 6EDE                  ; Aggiunge la colonna
1319+ 6EDE 58               ld   e, b
1320+ 6EDF 16 00            ld   d, 0
1321+ 6EE1 19               add  hl, de            ; HL = Row*32 + Col
1322+ 6EE2
1323+ 6EE2                  ; ---------------------------------------------------------------
1324+ 6EE2                  ; Accesso alla griglia degli item attivi
1325+ 6EE2                  ; ---------------------------------------------------------------
1326+ 6EE2 11 00 90         ld   de, items_grid
1327+ 6EE5 19               add  hl, de            ; HL = address cella
1328+ 6EE6
1329+ 6EE6                  ; ---------------------------------------------------------------
1330+ 6EE6                  ; Controllo presenza item
1331+ 6EE6                  ;
1332+ 6EE6                  ; items_grid contiene:
1333+ 6EE6                  ;   0 = nessun item
1334+ 6EE6                  ;   >0 = item attivo (colore o flag)
1335+ 6EE6                  ; ---------------------------------------------------------------
1336+ 6EE6 7E               ld   a, (hl)
1337+ 6EE7 B7               or   a
1338+ 6EE8 28 04            jr   z, .not_active
1339+ 6EEA
1340+ 6EEA                  ; ---------------------------------------------------------------
1341+ 6EEA                  ; Item trovato
1342+ 6EEA                  ; ---------------------------------------------------------------
1343+ 6EEA E1               pop  hl
1344+ 6EEB D1               pop  de
1345+ 6EEC
1346+ 6EEC 37               scf                    ; Carry = 1
1347+ 6EED C9               ret
1348+ 6EEE
1349+ 6EEE              .not_active:
1350+ 6EEE
1351+ 6EEE                  ; ---------------------------------------------------------------
1352+ 6EEE                  ; Nessun item nella cella
1353+ 6EEE                  ; ---------------------------------------------------------------
1354+ 6EEE E1               pop  hl
1355+ 6EEF D1               pop  de
1356+ 6EF0
1357+ 6EF0 B7               or   a                 ; Carry = 0
1358+ 6EF1 C9               ret
1359+ 6EF2
