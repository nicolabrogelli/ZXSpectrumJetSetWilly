 251  8A60              .draw_raster_bars:
 252  8A60                  ; Collisione attiva: disegna le raster bar nel bordo
 253  8A60 3A 5B F7         ld   a, (counter)
 254  8A63 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 255  8A65 06 1E            ld   b, 30             ; Numero di righe della barra raster
 256  8A67              .raster_loop:
 257  8A67 D3 FE            out  ($fe), a
 258  8A69 3C               inc  a
 259  8A6A E6 07            and  7
 260  8A6C 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 261  8A6E              .delay:
 262  8A6E 0D               dec  c
 263  8A6F 20 FD            jr   nz, .delay
 264  8A71 10 F4            djnz .raster_loop
 265  8A73
 266  8A73                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 267  8A73 3A 46 F7         ld   a, (room_border_color)
