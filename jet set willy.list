1197+ 84C0                  ; ---------------------------------------------------------------
1198+ 84C0
1199+ 84C0 23               inc  hl
1200+ 84C1 4E               ld   c, (hl)           ; X (colonna)
1201+ 84C2
1202+ 84C2 23               inc  hl
1203+ 84C3 46               ld   b, (hl)           ; Y (riga)
1204+ 84C4
1205+ 84C4 23               inc  hl
1206+ 84C5 5E               ld   e, (hl)           ; Colore
1207+ 84C6
1208+ 84C6 23               inc  hl
1209+ 84C7 7E               ld   a, (hl)           ; Collected flag
