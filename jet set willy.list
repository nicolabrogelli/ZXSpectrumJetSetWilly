1018+ 6B65              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
1019+ 6B65              ; Input: C = X, B = Y
1020+ 6B65              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
1021+ 6B65              ; -------------------------------------------------------------------
1022+ 6B65              CheckWallCell:
1023+ 6B65 E5               push hl
1024+ 6B66 D5               push de
1025+ 6B67 C5               push bc
1026+ 6B68
1027+ 6B68                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1028+ 6B68 78               ld   a, b
1029+ 6B69 FE 80            cp   128
1030+ 6B6B 30 1F            jr   nc, .not_wall
1031+ 6B6D
1032+ 6B6D                  ; 2. Calcola riga di layout: r = Y / 8
1033+ 6B6D CB 3F            srl  a
1034+ 6B6F CB 3F            srl  a
1035+ 6B71 CB 3F            srl  a                 ; A = r (0..15)
1036+ 6B73
1037+ 6B73                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1038+ 6B73 5F               ld   e, a              ; E = r (Row)
1039+ 6B74 79               ld   a, c
1040+ 6B75 CB 3F            srl  a
1041+ 6B77 CB 3F            srl  a
1042+ 6B79 CB 3F            srl  a                 ; A = c (0..31)
1043+ 6B7B 4F               ld   c, a              ; C = c (Col)
1044+ 6B7C
1045+ 6B7C                  ; Se la cella è sulla rampa, non considerarla un muro!
1046+ 6B7C 53               ld   d, e              ; D = Row
1047+ 6B7D 59               ld   e, c              ; E = Col
1048+ 6B7E CD EA 6A         call IsCellOnRamp
1049+ 6B81 38 09            jr   c, .not_wall
1050+ 6B83
1051+ 6B83 7A               ld   a, d              ; A = Row
1052+ 6B84 4B               ld   c, e              ; C = Col
1053+ 6B85 CD E5 6B         call GetCellFromUnpacked ; A = cell type
1054+ 6B88
1055+ 6B88                  ; Controlla se è Wall (2)
