1170+ 750D 3D               dec  a
1171+ 750E 20 06            jr   nz, .not_wall
1172+ 7510 11 B2 00         ld   de, OFFSET_WALL
1173+ 7513 19               add  hl, de
1174+ 7514 18 04            jr   .got_tile_ptr
1175+ 7516              .not_wall:
1176+ 7516 11 BB 00         ld   de, OFFSET_NASTY
