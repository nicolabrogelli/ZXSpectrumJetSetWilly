 799+ 6A66              ; -------------------------------------------------------------------
 800+ 6A66              ; Verifica se la cella (Col in E, Row in D) è sulla rampa, immediatamente sotto di essa,
 801+ 6A66              ; o sulla piattaforma adiacente in cima.
 802+ 6A66              ; Output: Carry flag impostato se è sulla rampa, altrimenti resettato
 803+ 6A66              ; -------------------------------------------------------------------
 804+ 6A66              IsCellOnRamp:
 805+ 6A66 C5               push bc
 806+ 6A67 E5               push hl
 807+ 6A68
 808+ 6A68 3A C6 76         ld   a, (ramp_len)
 809+ 6A6B B7               or   a
 810+ 6A6C 28 6B            jr   z, .no
 811+ 6A6E
 812+ 6A6E                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 813+ 6A6E 3A C5 76         ld   a, (ramp_dir)
 814+ 6A71 B7               or   a
 815+ 6A72 28 1A            jr   z, .range_left
 816+ 6A74              .range_right:
 817+ 6A74 3A C8 76         ld   a, (ramp_col)
 818+ 6A77 47               ld   b, a              ; B = ramp_col
 819+ 6A78 3A C6 76         ld   a, (ramp_len)
 820+ 6A7B 80               add  a, b              ; A = ramp_col + ramp_len
 821+ 6A7C 4F               ld   c, a              ; C = limit_right (exclusive)
 822+ 6A7D
 823+ 6A7D 7B               ld   a, e              ; A = Col
 824+ 6A7E B8               cp   b
 825+ 6A7F 38 34            jr   c, .check_platform_case ; Col < ramp_col
 826+ 6A81 B9               cp   c
 827+ 6A82 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 828+ 6A84
 829+ 6A84                  ; Calcola B = Col - ramp_col
 830+ 6A84 7B               ld   a, e
 831+ 6A85 90               sub  b
 832+ 6A86 47               ld   b, a              ; B = offset (0..ramp_len-1)
 833+ 6A87
 834+ 6A87                  ; SlopeRow = ramp_row - B
 835+ 6A87 3A C7 76         ld   a, (ramp_row)
 836+ 6A8A 90               sub  b
 837+ 6A8B 47               ld   b, a              ; B = SlopeRow
 838+ 6A8C 18 1F            jr   .check_row_match
 839+ 6A8E
 840+ 6A8E              .range_left:
 841+ 6A8E                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 842+ 6A8E 21 C6 76         ld   hl, ramp_len
 843+ 6A91 3A C8 76         ld   a, (ramp_col)
 844+ 6A94 96               sub  (hl)
 845+ 6A95 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 846+ 6A96 47               ld   b, a              ; B = limit_left
 847+ 6A97
 848+ 6A97 3A C8 76         ld   a, (ramp_col)
 849+ 6A9A 3C               inc  a
 850+ 6A9B 4F               ld   c, a              ; C = limit_right (exclusive)
 851+ 6A9C
 852+ 6A9C 7B               ld   a, e              ; A = Col
 853+ 6A9D B8               cp   b
 854+ 6A9E 38 15            jr   c, .check_platform_case
 855+ 6AA0 B9               cp   c
 856+ 6AA1 30 12            jr   nc, .check_platform_case
 857+ 6AA3
 858+ 6AA3                  ; Calcola B = ramp_col - Col
 859+ 6AA3 3A C8 76         ld   a, (ramp_col)
 860+ 6AA6 93               sub  e
 861+ 6AA7 47               ld   b, a              ; B = offset
 862+ 6AA8
 863+ 6AA8                  ; SlopeRow = ramp_row - B
 864+ 6AA8 3A C7 76         ld   a, (ramp_row)
 865+ 6AAB 90               sub  b
 866+ 6AAC 47               ld   b, a              ; B = SlopeRow
 867+ 6AAD
 868+ 6AAD              .check_row_match:
 869+ 6AAD                  ; D (Row) deve essere uguale a SlopeRow (in B) o SlopeRow + 1 (immediatamente sotto)
 870+ 6AAD 7A               ld   a, d              ; A = Row
 871+ 6AAE B8               cp   b
 872+ 6AAF 28 2C            jr   z, .yes           ; Row == SlopeRow
 873+ 6AB1 04               inc  b                 ; B = SlopeRow + 1
 874+ 6AB2 B8               cp   b
 875+ 6AB3 28 28            jr   z, .yes           ; Row == SlopeRow + 1
 876+ 6AB5
 877+ 6AB5              .check_platform_case:
 878+ 6AB5                  ; 2. Controlla se è sulla piattaforma adiacente in cima
 879+ 6AB5 3A C5 76         ld   a, (ramp_dir)
 880+ 6AB8 B7               or   a
 881+ 6AB9 28 09            jr   z, .plat_left
 882+ 6ABB              .plat_right:
 883+ 6ABB 3A C8 76         ld   a, (ramp_col)
 884+ 6ABE 21 C6 76         ld   hl, ramp_len
 885+ 6AC1 86               add  a, (hl)           ; A = ramp_col + ramp_len
 886+ 6AC2 18 07            jr   .compare_plat
 887+ 6AC4              .plat_left:
 888+ 6AC4 3A C8 76         ld   a, (ramp_col)
 889+ 6AC7 21 C6 76         ld   hl, ramp_len
 890+ 6ACA 96               sub  (hl)              ; A = ramp_col - ramp_len
 891+ 6ACB              .compare_plat:
 892+ 6ACB BB               cp   e                 ; Compare with Col
 893+ 6ACC 20 0B            jr   nz, .no
 894+ 6ACE
 895+ 6ACE 3A C7 76         ld   a, (ramp_row)
 896+ 6AD1 21 C6 76         ld   hl, ramp_len
 897+ 6AD4 96               sub  (hl)
 898+ 6AD5 3C               inc  a                 ; A = ramp_row - ramp_len + 1
 899+ 6AD6 BA               cp   d                 ; Compare with Row
 900+ 6AD7 28 04            jr   z, .yes
 901+ 6AD9
 902+ 6AD9              .no:
 903+ 6AD9 E1               pop  hl
 904+ 6ADA C1               pop  bc
 905+ 6ADB B7               or   a
 906+ 6ADC C9               ret
 907+ 6ADD
 908+ 6ADD              .yes:
 909+ 6ADD E1               pop  hl
 910+ 6ADE C1               pop  bc
 911+ 6ADF 37               scf
 912+ 6AE0 C9               ret
