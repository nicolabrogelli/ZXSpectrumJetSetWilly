1227+ 84CF
1228+ 84CF CD 14 85         call DrawItemGraphic
1229+ 84D2
1230+ 84D2 E1               pop  hl                ; ritorna al flag collected
1231+ 84D3
1232+ 84D3                  ; ---------------------------------------------------------------
1233+ 84D3                  ; Aggiorna items_grid
1234+ 84D3                  ;
1235+ 84D3                  ; Calcolo:
1236+ 84D3                  ;   offset = Row * 32 + Col
1237+ 84D3                  ; ---------------------------------------------------------------
1238+ 84D3 E5               push hl
1239+ 84D4 D5               push de
1240+ 84D5
1241+ 84D5 26 00            ld   h, 0
1242+ 84D7 68               ld   l, b              ; HL = Row
1243+ 84D8
1244+ 84D8 29               add  hl, hl            ; *2
1245+ 84D9 29               add  hl, hl            ; *4
1246+ 84DA 29               add  hl, hl            ; *8
1247+ 84DB 29               add  hl, hl            ; *16
1248+ 84DC 29               add  hl, hl            ; *32
1249+ 84DD
1250+ 84DD 16 00            ld   d, 0
1251+ 84DF 59               ld   e, c              ; DE = Col
1252+ 84E0
1253+ 84E0 19               add  hl, de            ; Row*32 + Col
1254+ 84E1
1255+ 84E1 11 7C EA         ld   de, items_grid
1256+ 84E4 19               add  hl, de            ; puntatore nella griglia
1257+ 84E5
1258+ 84E5 D1               pop  de                ; ripristina colore
1259+ 84E6
1260+ 84E6 73               ld   (hl), e           ; salva colore cella
1261+ 84E7
1262+ 84E7 E1               pop  hl
