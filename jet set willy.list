 142+ 7666              ; -------------------------------------------------------------------
 143+ 7666              ; DetermineCurrentRoomID
 144+ 7666              ;
 145+ 7666              ; Determina l'ID numerico della stanza corrente confrontando
 146+ 7666              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 147+ 7666              ;
 148+ 7666              ; Se viene trovata una corrispondenza:
 149+ 7666              ;   A = ID della stanza
 150+ 7666              ;   current_room = A
 151+ 7666              ;
 152+ 7666              ; Mappatura:
 153+ 7666              ;    0 = The Off Licence
 154+ 7666              ;    1 = The Bridge
 155+ 7666              ;    2 = Under The Mega Tree
 156+ 7666              ;    3 = Gfx_At The Foot Of The Mega Tree
 157+ 7666              ;    4 = The Drive
 158+ 7666              ;    5 = The Security Guard
 159+ 7666              ;    6 = Entrance To Hades
 160+ 7666              ;    7 = Cuckoo's Nest
 161+ 7666              ;    8 = Inside The Mega Trunk
 162+ 7666              ;    9 = On A Branch Over The Drive
 163+ 7666              ;   10 = The Front Door
 164+ 7666              ;   11 = The Hall
 165+ 7666              ;   12 = Tree Top
 166+ 7666              ;   27 = The Chapel
 167+ 7666              ;   28 = First Landing
 168+ 7666              ;   29 = The Nightmare Room
 169+ 7666              ;   33 = The Bathroom
 170+ 7666              ;   35 = Master Bedroom
 171+ 7666              ;
 172+ 7666              ; Se nessuna stanza corrisponde viene impostato:
 173+ 7666              ;   current_room = 0
 174+ 7666              ; -------------------------------------------------------------------
 175+ 7666              DetermineCurrentRoomID:
 176+ 7666
