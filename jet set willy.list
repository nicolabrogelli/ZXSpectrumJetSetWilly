 121+ 6EF4
 122+ 6EF4                  ; Controlla se positivo per evitare bug con cp signed
 123+ 6EF4 CB 7F            bit 7, a
 124+ 6EF6 28 06            jr  z, .store_vel
 125+ 6EF8
 126+ 6EF8 FE F4            cp  -MAX_FALL_SPEED   ; -12
 127+ 6EFA 30 02            jr  nc, .store_vel
 128+ 6EFC 3E F4            ld  a, -MAX_FALL_SPEED
 129+ 6EFE
 130+ 6EFE              .store_vel:
 131+ 6EFE 32 BF 76         ld  (velocity_y), a
 132+ 6F01
 133+ 6F01                  ; Applica movimento verticale: PlayerY = PlayerY - velocity_y
 134+ 6F01 ED 4B B3 76      ld  bc, (PlayerPos)
 135+ 6F05 57               ld  d, a              ; D = velocity_y (signed)
 136+ 6F06 78               ld  a, b              ; A = PlayerY
 137+ 6F07 92               sub d                 ; A = PlayerY - velocity_y
 138+ 6F08 47               ld  b, a              ; B = new PlayerY
 139+ 6F09
 140+ 6F09                  ; Controlla se stiamo cadendo (velocity_y <= 0)
 141+ 6F09 3A BF 76         ld  a, (velocity_y)
 142+ 6F0C CB 7F            bit 7, a              ; Se negativo, bit 7 = 1
 143+ 6F0E 20 05            jr  nz, .falling_checks
 144+ 6F10 B7               or  a                 ; Se zero
 145+ 6F11 28 02            jr  z, .falling_checks
 146+ 6F13 18 4B            jr  .no_collision_checks ; Se stiamo salendo, non controlliamo collisioni
 147+ 6F15
 148+ 6F15              .falling_checks:
 149+ 6F15                  ; --- CONTROLLO COLLISIONE CON IL TERRENO DURANTE LA CADUTA ---
 150+ 6F15 78               ld   a, b
 151+ 6F16 C6 10            add  a, 16
 152+ 6F18 47               ld   b, a              ; B = Nuovo Y + 16
 153+ 6F19
 154+ 6F19                  ; Controlla se il piede sinistro tocca solido
 155+ 6F19 CD 75 6E         call CheckSolidCell
 156+ 6F1C 38 0B            jr   c, .check_landing
 157+ 6F1E
 158+ 6F1E                  ; Controlla se il piede destro tocca solido
 159+ 6F1E 79               ld   a, c
 160+ 6F1F C6 07            add  a, 7
 161+ 6F21 4F               ld   c, a              ; C = PlayerX + 7
 162+ 6F22 CD 75 6E         call CheckSolidCell
 163+ 6F25 38 02            jr   c, .check_landing
 164+ 6F27
 165+ 6F27                  ; Nessun atterraggio
 166+ 6F27 18 37            jr   .no_collision_checks
 167+ 6F29
 168+ 6F29              .check_landing:
 169+ 6F29                  ; Abbiamo toccato una cella solida!
 170+ 6F29 78               ld   a, b
 171+ 6F2A D6 18            sub  24
 172+ 6F2C CB 3F            srl  a
 173+ 6F2E CB 3F            srl  a
 174+ 6F30 CB 3F            srl  a                 ; A = r (0..15)
 175+ 6F32
 176+ 6F32                  ; Controlliamo se Vecchio Y + 16 <= r * 8 + 24
 177+ 6F32 5F               ld   e, a              ; E = r
 178+ 6F33 87               add  a, a              ; *2
 179+ 6F34 87               add  a, a              ; *4
 180+ 6F35 87               add  a, a              ; *8
 181+ 6F36 C6 18            add  a, 24             ; A = r * 8 + 24 (limite superiore della riga)
 182+ 6F38 57               ld   d, a              ; D = limite superiore
 183+ 6F39
 184+ 6F39                  ; Vecchio Y + 16
 185+ 6F39 3A B4 76         ld   a, (PlayerPos+1)  ; A = Vecchio Y
 186+ 6F3C C6 10            add  a, 16             ; A = Vecchio Y + 16
 187+ 6F3E
 188+ 6F3E BA               cp   d                 ; Confronta Vecchio Y + 16 con il limite
 189+ 6F3F 28 04            jr   z, .do_landing    ; Se ==, atterra
 190+ 6F41 38 02            jr   c, .do_landing    ; Se <, atterra (eravamo sopra)
 191+ 6F43
 192+ 6F43 18 1B            jr   .no_collision_checks
 193+ 6F45
 194+ 6F45              .do_landing:
 195+ 6F45                  ; Atterra sulla riga di layout E!
