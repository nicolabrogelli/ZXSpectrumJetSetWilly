1268+ 64D7                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1269+ 64D7 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1270+ 64DA DD 21 7C CE      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
