  85+ 7957 38 56            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 7959
  87+ 7959                  ; Decrementa il contatore dei frame della nota corrente
  88+ 7959 3A 9E 7D         ld   a, (Audio_music_frame_counter)
  89+ 795C 3D               dec  a
  90+ 795D 32 9E 7D         ld   (Audio_music_frame_counter), a
  91+ 7960 20 1F            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 7962
  93+ 7962                  ; Altrimenti carica la nota successiva
  94+ 7962 3A 9D 7D         ld   a, (Audio_music_note_idx)
  95+ 7965 3C               inc  a
  96+ 7966 FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 7968 38 01            jr   c, .no_wrap
  98+ 796A AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 796B              .no_wrap:
