 231+ 6B18              ; -------------------------------------------------------------------
 232+ 6B18              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 233+ 6B18              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 234+ 6B18              ; -------------------------------------------------------------------
 235+ 6B18              DrawItemGraphic:
 236+ 6B18 C5               push bc
 237+ 6B19 D5               push de
 238+ 6B1A E5               push hl
 239+ 6B1B
 240+ 6B1B                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 241+ 6B1B 78               ld   a, b
 242+ 6B1C E6 18            and  $18
 243+ 6B1E C6 40            add  a, $40
 244+ 6B20 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 245+ 6B21
 246+ 6B21 78               ld   a, b
 247+ 6B22 E6 07            and  7
 248+ 6B24 87               add  a, a              ; *2
 249+ 6B25 87               add  a, a              ; *4
 250+ 6B26 87               add  a, a              ; *8
 251+ 6B27 87               add  a, a              ; *16
 252+ 6B28 87               add  a, a              ; *32
 253+ 6B29 81               add  a, c              ; + Col C
 254+ 6B2A 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 255+ 6B2B
 256+ 6B2B                  ; 2. Copia gli 8 byte del bitmap dello sprite
 257+ 6B2B C5               push bc                ; Salva BC (contiene Row e Col)
 258+ 6B2C 06 08            ld   b, 8              ; 8 scanline
 259+ 6B2E              .line_loop:
 260+ 6B2E 7E               ld   a, (hl)
 261+ 6B2F 12               ld   (de), a
 262+ 6B30 14               inc  d                 ; Prossima scanline
 263+ 6B31 23               inc  hl
 264+ 6B32 05               dec  b
 265+ 6B33 20 F9            jr   nz, .line_loop
 266+ 6B35 C1               pop  bc                ; Ripristina BC
 267+ 6B36
 268+ 6B36                  ; 3. Calcola l'indirizzo degli attributi dello schermo
 269+ 6B36                  ; HL = $5800 + B * 32 + C
 270+ 6B36 26 00            ld   h, 0
 271+ 6B38 68               ld   l, b              ; HL = B (Row)
 272+ 6B39 29               add  hl, hl            ; *2
 273+ 6B3A 29               add  hl, hl            ; *4
 274+ 6B3B 29               add  hl, hl            ; *8
 275+ 6B3C 29               add  hl, hl            ; *16
 276+ 6B3D 29               add  hl, hl            ; *32
 277+ 6B3E
 278+ 6B3E 79               ld   a, c              ; A = Col
 279+ 6B3F 85               add  a, l
 280+ 6B40 6F               ld   l, a
 281+ 6B41 30 01            jr   nc, .no_carry
 282+ 6B43 24               inc  h
 283+ 6B44              .no_carry:
 284+ 6B44                  ; HL = B * 32 + C
 285+ 6B44 11 00 58         ld   de, $5800
 286+ 6B47 19               add  hl, de            ; HL = AttrAddr
 287+ 6B48
 288+ 6B48                  ; Ripristina i registri dallo stack per estrarre il colore in E
 289+ 6B48                  ; Lo stack ha: HL (originale), DE (originale con colore in E), BC (originale)
 290+ 6B48 C1               pop  bc                ; BC = HL originale
 291+ 6B49 D1               pop  de                ; DE = DE originale (colore in E)
 292+ 6B4A
 293+ 6B4A 7B               ld   a, e              ; A = Colore
 294+ 6B4B 77               ld   (hl), a           ; Scrivi in memoria attributi (HL)
 295+ 6B4C
 296+ 6B4C                  ; Ripristina lo stack e i registri originari
 297+ 6B4C C5               push bc                ; Rimetti HL originale sulla pila
 298+ 6B4D E1               pop  hl                ; HL = HL originale
 299+ 6B4E C1               pop  bc                ; BC = BC originale
 300+ 6B4F C9               ret
