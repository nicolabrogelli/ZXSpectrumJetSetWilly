 253+ 64F4 7E               ld   a, (hl)           ; A = X iniziale
 254+ 64F5
 255+ 64F5 23               inc  hl
 256+ 64F6
 257+ 64F6 66               ld   h, (hl)           ; H = Y iniziale
 258+ 64F7
 259+ 64F7 6F               ld   l, a              ; HL = (Y, X)
 260+ 64F8
 261+ 64F8                  ; ---------------------------------------------------------------
 262+ 64F8                  ; Salva posizione corrente e posizione precedente
 263+ 64F8                  ; ---------------------------------------------------------------
 264+ 64F8 22 44 7B         ld   (PlayerPos), hl
 265+ 64FB 22 46 7B         ld   (PlayerPosOld), hl
