1119+ 6B0C 87               add  a, a              ; *8
1120+ 6B0D 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1121+ 6B0E 67               ld   h, a              ; H = X_right_boundary
1122+ 6B0F
1123+ 6B0F 79               ld   a, c              ; A = PlayerX
1124+ 6B10 BB               cp   e
1125+ 6B11 DA A6 6B         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1126+ 6B14
1127+ 6B14 BC               cp   h
1128+ 6B15 38 15            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1129+ 6B17
1130+ 6B17                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1131+ 6B17 94               sub  h                 ; A = PlayerX - X_right_boundary
1132+ 6B18 FE 08            cp   8
1133+ 6B1A D2 A6 6B         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1134+ 6B1D
