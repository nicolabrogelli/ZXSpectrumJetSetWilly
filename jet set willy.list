 481+ 75C3 E1               pop  hl
 482+ 75C4
 483+ 75C4 C9               ret
 484+ 75C5
 485+ 75C5              ; -------------------------------------------------------------------
 486+ 75C5              ; Items_DrawRoom
 487+ 75C5              ;
 488+ 75C5              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 489+ 75C5              ;
 490+ 75C5              ; Operazioni eseguite:
 491+ 75C5              ;   1. Azzera la griglia items_grid.
 492+ 75C5              ;   2. Svuota la cache degli oggetti attivi.
 493+ 75C5              ;   3. Scansiona ItemsTable.
 494+ 75C5              ;   4. Per ogni item della stanza corrente:
 495+ 75C5              ;        - verifica se è già stato raccolto
 496+ 75C5              ;        - disegna la grafica
 497+ 75C5              ;        - aggiorna items_grid
 498+ 75C5              ;        - memorizza l'item nella cache current_room_items
 499+ 75C5              ;   5. Aggiorna num_room_items.
 500+ 75C5              ;
 501+ 75C5              ; Record ItemsTable:
 502+ 75C5              ;   +0  Room ID
 503+ 75C5              ;   +1  X (colonna)
 504+ 75C5              ;   +2  Y (riga)
 505+ 75C5              ;   +3  Colore
 506+ 75C5              ;   +4  Collected flag
 507+ 75C5              ;
 508+ 75C5              ; Cache current_room_items:
 509+ 75C5              ;   +0  Colonna
 510+ 75C5              ;   +1  Riga
 511+ 75C5              ;   +2  Colore
 512+ 75C5              ;   +3  Collected flag ptr (Low)
 513+ 75C5              ;   +4  Collected flag ptr (High)
 514+ 75C5              ;
 515+ 75C5              ; Ogni record cache occupa 5 byte.
 516+ 75C5              ; -------------------------------------------------------------------
 517+ 75C5              Items_DrawRoom:
 518+ 75C5
 519+ 75C5                  ; Salva tutti i registri utilizzati
 520+ 75C5 E5               push hl
 521+ 75C6 D5               push de
 522+ 75C7 C5               push bc
 523+ 75C8 DD E5            push ix
 524+ 75CA FD E5            push iy
 525+ 75CC
 526+ 75CC                  ; ---------------------------------------------------------------
 527+ 75CC                  ; Azzera items_grid (32 x 16 = 512 byte)
 528+ 75CC                  ; ---------------------------------------------------------------
 529+ 75CC 21 00 B0         ld   hl, items_grid
 530+ 75CF 11 01 B0         ld   de, items_grid + 1
 531+ 75D2 36 00            ld   (hl), 0
 532+ 75D4 01 FF 01         ld   bc, 511
 533+ 75D7 ED B0            ldir
 534+ 75D9
 535+ 75D9                  ; ---------------------------------------------------------------
 536+ 75D9                  ; Nessun item attivo nella stanza
 537+ 75D9                  ; ---------------------------------------------------------------
 538+ 75D9 AF               xor  a
 539+ 75DA 32 17 7C         ld   (num_room_items), a
 540+ 75DD
 541+ 75DD                  ; IY punta alla cache degli item attivi
 542+ 75DD FD 21 C7 7B      ld   iy, current_room_items
 543+ 75E1
 544+ 75E1                  ; ---------------------------------------------------------------
 545+ 75E1                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 546+ 75E1                  ; alla stanza corrente.
 547+ 75E1                  ;
 548+ 75E1                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 549+ 75E1                  ; ---------------------------------------------------------------
 550+ 75E1 2A 18 7C         ld   hl, (room_ptr)
 551+ 75E4 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 552+ 75E7 19               add  hl, de
 553+ 75E8
 554+ 75E8 E5               push hl
 555+ 75E9 DD E1            pop  ix                ; IX = bitmap item
 556+ 75EB
 557+ 75EB                  ; ---------------------------------------------------------------
 558+ 75EB                  ; Inizio scansione della tabella degli item
 559+ 75EB                  ; ---------------------------------------------------------------
 560+ 75EB 21 A3 73         ld   hl, ItemsTable
 561+ 75EE
 562+ 75EE              .loop:
 563+ 75EE
 564+ 75EE                  ; ---------------------------------------------------------------
 565+ 75EE                  ; Legge il Room ID del record corrente
 566+ 75EE                  ; ---------------------------------------------------------------
 567+ 75EE 7E               ld   a, (hl)
 568+ 75EF
 569+ 75EF                  ; $FF indica fine tabella
 570+ 75EF FE FF            cp   $FF
 571+ 75F1 28 53            jr   z, .done
 572+ 75F3
 573+ 75F3                  ; ---------------------------------------------------------------
 574+ 75F3                  ; Verifica se l'item appartiene alla stanza corrente
 575+ 75F3                  ; ---------------------------------------------------------------
 576+ 75F3 57               ld   d, a
 577+ 75F4
 578+ 75F4 3A BE 7B         ld   a, (current_room)
 579+ 75F7 BA               cp   d
 580+ 75F8 20 45            jr   nz, .next_item
 581+ 75FA
 582+ 75FA                  ; ---------------------------------------------------------------
 583+ 75FA                  ; Legge i dati dell'item
 584+ 75FA                  ; ---------------------------------------------------------------
 585+ 75FA
 586+ 75FA 23               inc  hl
 587+ 75FB 4E               ld   c, (hl)           ; X (colonna)
 588+ 75FC
 589+ 75FC 23               inc  hl
 590+ 75FD 46               ld   b, (hl)           ; Y (riga)
 591+ 75FE
 592+ 75FE 23               inc  hl
 593+ 75FF 5E               ld   e, (hl)           ; Colore
 594+ 7600
 595+ 7600 23               inc  hl
 596+ 7601 7E               ld   a, (hl)           ; Collected flag
 597+ 7602
 598+ 7602                  ; Se diverso da zero l'item è già stato raccolto
 599+ 7602 B7               or   a
 600+ 7603 20 3E            jr   nz, .next_no_inc
 601+ 7605
 602+ 7605                  ; ---------------------------------------------------------------
 603+ 7605                  ; Disegna l'item sullo schermo
 604+ 7605                  ;
 605+ 7605                  ; B = Row
 606+ 7605                  ; C = Column
 607+ 7605                  ; HL = bitmap pointer
 608+ 7605                  ; E = Color
 609+ 7605                  ; ---------------------------------------------------------------
 610+ 7605 E5               push hl
 611+ 7606
 612+ 7606 DD E5            push ix
 613+ 7608 E1               pop  hl
 614+ 7609
 615+ 7609 CD 4E 76         call DrawItemGraphic
 616+ 760C
 617+ 760C E1               pop  hl                ; ritorna al flag collected
 618+ 760D
 619+ 760D                  ; ---------------------------------------------------------------
 620+ 760D                  ; Aggiorna items_grid
 621+ 760D                  ;
 622+ 760D                  ; Calcolo:
 623+ 760D                  ;   offset = Row * 32 + Col
 624+ 760D                  ; ---------------------------------------------------------------
 625+ 760D E5               push hl
 626+ 760E D5               push de
 627+ 760F
 628+ 760F 26 00            ld   h, 0
 629+ 7611 68               ld   l, b              ; HL = Row
 630+ 7612
 631+ 7612 29               add  hl, hl            ; *2
 632+ 7613 29               add  hl, hl            ; *4
 633+ 7614 29               add  hl, hl            ; *8
 634+ 7615 29               add  hl, hl            ; *16
 635+ 7616 29               add  hl, hl            ; *32
 636+ 7617
 637+ 7617 16 00            ld   d, 0
 638+ 7619 59               ld   e, c              ; DE = Col
 639+ 761A
 640+ 761A 19               add  hl, de            ; Row*32 + Col
 641+ 761B
 642+ 761B 11 00 B0         ld   de, items_grid
 643+ 761E 19               add  hl, de            ; puntatore nella griglia
 644+ 761F
 645+ 761F D1               pop  de                ; ripristina colore
 646+ 7620
 647+ 7620 73               ld   (hl), e           ; salva colore cella
 648+ 7621
 649+ 7621 E1               pop  hl
 650+ 7622
 651+ 7622                  ; ---------------------------------------------------------------
 652+ 7622                  ; Salva l'item nella cache della stanza
 653+ 7622                  ;
 654+ 7622                  ; Questo evita di dover scansionare tutta ItemsTable
 655+ 7622                  ; durante il controllo delle collisioni.
 656+ 7622                  ; ---------------------------------------------------------------
 657+ 7622
 658+ 7622 FD 71 00         ld   (iy+0), c         ; Colonna
 659+ 7625 FD 70 01         ld   (iy+1), b         ; Riga
 660+ 7628 FD 73 02         ld   (iy+2), e         ; Colore
 661+ 762B
 662+ 762B                  ; Salva il puntatore al flag "collected"
 663+ 762B FD 75 03         ld   (iy+3), l         ; Low byte
 664+ 762E FD 74 04         ld   (iy+4), h         ; High byte
 665+ 7631
 666+ 7631                  ; Passa al record successivo della cache
 667+ 7631 01 05 00         ld   bc, 5
 668+ 7634 FD 09            add  iy, bc
 669+ 7636
 670+ 7636                  ; Incrementa il numero di item attivi
 671+ 7636 3A 17 7C         ld   a, (num_room_items)
 672+ 7639 3C               inc  a
 673+ 763A 32 17 7C         ld   (num_room_items), a
 674+ 763D
 675+ 763D 18 04            jr   .next_no_inc
 676+ 763F
 677+ 763F              .next_item:
 678+ 763F
 679+ 763F                  ; ---------------------------------------------------------------
 680+ 763F                  ; L'item non appartiene alla stanza corrente.
 681+ 763F                  ; Salta i campi del record:
 682+ 763F                  ;   X
 683+ 763F                  ;   Y
 684+ 763F                  ;   Color
 685+ 763F                  ;   Collected
 686+ 763F                  ; ---------------------------------------------------------------
 687+ 763F 23               inc  hl
 688+ 7640 23               inc  hl
 689+ 7641 23               inc  hl
 690+ 7642 23               inc  hl
 691+ 7643
 692+ 7643              .next_no_inc:
 693+ 7643
 694+ 7643                  ; ---------------------------------------------------------------
 695+ 7643                  ; Avanza al record successivo
 696+ 7643                  ; (prossimo Room ID)
 697+ 7643                  ; ---------------------------------------------------------------
 698+ 7643 23               inc  hl
 699+ 7644 18 A8            jr   .loop
 700+ 7646
 701+ 7646              .done:
 702+ 7646
 703+ 7646                  ; Ripristina i registri
 704+ 7646 FD E1            pop  iy
 705+ 7648 DD E1            pop  ix
 706+ 764A D1               pop  de
 707+ 764B C1               pop  bc
 708+ 764C E1               pop  hl
 709+ 764D
 710+ 764D C9               ret
 711+ 764E
 712+ 764E              ; -------------------------------------------------------------------
 713+ 764E              ; DrawItemGraphic
 714+ 764E              ;
 715+ 764E              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 716+ 764E              ; utilizzando una bitmap di 8 byte e un attributo colore.
 717+ 764E              ;
 718+ 764E              ; Input:
 719+ 764E              ;   B = Riga attributi (3..18)
 720+ 764E              ;   C = Colonna attributi (0..31)
 721+ 764E              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 722+ 764E              ;   E = Attributo colore
 723+ 764E              ;
 724+ 764E              ; Output:
 725+ 764E              ;   Nessuno
 726+ 764E              ;
 727+ 764E              ; Registri preservati:
 728+ 764E              ;   BC, DE, HL
 729+ 764E              ; -------------------------------------------------------------------
 730+ 764E              DrawItemGraphic:
 731+ 764E
 732+ 764E                  ; Salva i registri originali
 733+ 764E C5               push bc
 734+ 764F D5               push de
 735+ 7650 E5               push hl
 736+ 7651
 737+ 7651                  ; ---------------------------------------------------------------
 738+ 7651                  ; Calcolo indirizzo bitmap dello Spectrum
 739+ 7651                  ;
 740+ 7651                  ; Ogni item occupa una cella attributi (8x8 pixel).
 741+ 7651                  ;
 742+ 7651                  ; Formula:
 743+ 7651                  ;   High = $40 + (Row AND $18)
 744+ 7651                  ;   Low  = (Row AND 7) * 32 + Col
 745+ 7651                  ;
 746+ 7651                  ; DE conterrà l'indirizzo della prima scanline.
 747+ 7651                  ; ---------------------------------------------------------------
 748+ 7651
 749+ 7651 78               ld   a, b
 750+ 7652 E6 18            and  $18
 751+ 7654 C6 40            add  a, $40
 752+ 7656 57               ld   d, a              ; Byte alto indirizzo video
 753+ 7657
 754+ 7657 78               ld   a, b
 755+ 7658 E6 07            and  7                 ; Riga interna al blocco da 8
 756+ 765A
 757+ 765A 87               add  a, a              ; *2
 758+ 765B 87               add  a, a              ; *4
 759+ 765C 87               add  a, a              ; *8
 760+ 765D 87               add  a, a              ; *16
 761+ 765E 87               add  a, a              ; *32
 762+ 765F
 763+ 765F 81               add  a, c              ; + colonna
 764+ 7660
 765+ 7660 5F               ld   e, a              ; Byte basso indirizzo video
 766+ 7661
 767+ 7661                  ; ---------------------------------------------------------------
 768+ 7661                  ; Disegno bitmap
 769+ 7661                  ;
 770+ 7661                  ; Copia 8 byte consecutivi nella memoria video.
 771+ 7661                  ; Ogni byte rappresenta una scanline da 8 pixel.
 772+ 7661                  ; ---------------------------------------------------------------
 773+ 7661
 774+ 7661 C5               push bc                ; Conserva Row e Col
 775+ 7662
 776+ 7662 06 08            ld   b, 8              ; Numero scanline
 777+ 7664
 778+ 7664              .line_loop:
 779+ 7664
 780+ 7664 7E               ld   a, (hl)           ; Legge scanline bitmap
 781+ 7665 12               ld   (de), a           ; Scrive nella memoria video
 782+ 7666
 783+ 7666 14               inc  d                 ; Scanline successiva
 784+ 7667 23               inc  hl                ; Byte bitmap successivo
 785+ 7668
 786+ 7668 05               dec  b
 787+ 7669 20 F9            jr   nz, .line_loop
 788+ 766B
 789+ 766B C1               pop  bc                ; Ripristina Row e Col
 790+ 766C
 791+ 766C                  ; ---------------------------------------------------------------
 792+ 766C                  ; Calcolo indirizzo attributo
 793+ 766C                  ;
 794+ 766C                  ; Formula:
 795+ 766C                  ;   AttrAddr = $5800 + Row * 32 + Col
 796+ 766C                  ;
 797+ 766C                  ; HL conterrà l'indirizzo della cella attributi.
 798+ 766C                  ; ---------------------------------------------------------------
 799+ 766C
 800+ 766C 26 00            ld   h, 0
 801+ 766E 68               ld   l, b              ; HL = Row
 802+ 766F
 803+ 766F 29               add  hl, hl            ; *2
 804+ 7670 29               add  hl, hl            ; *4
 805+ 7671 29               add  hl, hl            ; *8
 806+ 7672 29               add  hl, hl            ; *16
 807+ 7673 29               add  hl, hl            ; *32
 808+ 7674
 809+ 7674 79               ld   a, c              ; A = Colonna
 810+ 7675
 811+ 7675 85               add  a, l
 812+ 7676 6F               ld   l, a
 813+ 7677
 814+ 7677 30 01            jr   nc, .no_carry
 815+ 7679 24               inc  h
 816+ 767A
 817+ 767A              .no_carry:
 818+ 767A
 819+ 767A                  ; HL = Row * 32 + Col
 820+ 767A
 821+ 767A 11 00 58         ld   de, $5800
 822+ 767D 19               add  hl, de            ; HL = indirizzo attributi
 823+ 767E
 824+ 767E                  ; ---------------------------------------------------------------
 825+ 767E                  ; Recupera il colore originale dallo stack.
 826+ 767E                  ;
 827+ 767E                  ; Layout stack:
 828+ 767E                  ;   HL originale
 829+ 767E                  ;   DE originale (E = colore)
 830+ 767E                  ;   BC originale
 831+ 767E                  ; ---------------------------------------------------------------
 832+ 767E
 833+ 767E C1               pop  bc                ; Recupera HL originale
 834+ 767F D1               pop  de                ; Recupera DE originale
 835+ 7680
 836+ 7680                  ; ---------------------------------------------------------------
 837+ 7680                  ; Scrive l'attributo colore
 838+ 7680                  ; ---------------------------------------------------------------
 839+ 7680
 840+ 7680 7B               ld   a, e              ; A = colore
 841+ 7681 77               ld   (hl), a           ; Scrive nella RAM attributi
 842+ 7682
 843+ 7682                  ; ---------------------------------------------------------------
 844+ 7682                  ; Ripristina HL e BC originali
 845+ 7682                  ; ---------------------------------------------------------------
 846+ 7682
 847+ 7682 C5               push bc
 848+ 7683 E1               pop  hl                ; HL originale
 849+ 7684
 850+ 7684 C1               pop  bc                ; BC originale
 851+ 7685
 852+ 7685 C9               ret
 853+ 7686
 854+ 7686              ; -------------------------------------------------------------------
 855+ 7686              ; RestoreBackgroundCell
 856+ 7686              ;
 857+ 7686              ; Ripristina il contenuto originale di una cella della stanza.
 858+ 7686              ; Viene utilizzata principalmente quando un item viene raccolto:
 859+ 7686              ; invece di lasciare un "buco", la routine ridisegna il tile
 860+ 7686              ; originale presente nella mappa della stanza.
 861+ 7686              ;
 862+ 7686              ; Input:
 863+ 7686              ;   B = Row (3..18)
 864+ 7686              ;   C = Col (0..31)
 865+ 7686              ;
 866+ 7686              ; Utilizza:
 867+ 7686              ;   room_ptr -> struttura dati della stanza corrente
 868+ 7686              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 869+ 7686              ;   Gfx_DrawTile -> ridisegna il tile selezionato
 870+ 7686              ;
 871+ 7686              ; Tipi di cella:
 872+ 7686              ;   0 = Background
 873+ 7686              ;   1 = Floor
 874+ 7686              ;   2 = Wall
 875+ 7686              ;   3 = Nasty
 876+ 7686              ; -------------------------------------------------------------------
 877+ 7686              RestoreBackgroundCell:
 878+ 7686
 879+ 7686                  ; Salva tutti i registri utilizzati
 880+ 7686 FD E5            push iy
 881+ 7688 C5               push bc
 882+ 7689 D5               push de
 883+ 768A E5               push hl
 884+ 768B DD E5            push ix
 885+ 768D
 886+ 768D                  ; ---------------------------------------------------------------
 887+ 768D                  ; Conserva Row e Col in IY.
 888+ 768D                  ;
 889+ 768D                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 890+ 768D                  ; BC potrebbe essere modificato.
 891+ 768D                  ; ---------------------------------------------------------------
 892+ 768D C5               push bc
 893+ 768E FD E1            pop  iy                ; IYH = Row, IYL = Col
 894+ 7690
 895+ 7690                  ; ---------------------------------------------------------------
 896+ 7690                  ; Determina quale tipo di cella è presente nella posizione
 897+ 7690                  ; specificata.
 898+ 7690                  ;
 899+ 7690                  ; Input:
 900+ 7690                  ;   B = Row
 901+ 7690                  ;   C = Col
 902+ 7690                  ;
 903+ 7690                  ; Output:
 904+ 7690                  ;   A = tipo cella
 905+ 7690                  ; ---------------------------------------------------------------
 906+ 7690 78               ld   a, b
 907+ 7691
 908+ 7691 CD E5 6B         call GetCellFromUnpacked
 909+ 7694
 910+ 7694                  ; ---------------------------------------------------------------
 911+ 7694                  ; Recupera il puntatore alla stanza corrente.
 912+ 7694                  ;
 913+ 7694                  ; DE = base della struttura stanza
 914+ 7694                  ; ---------------------------------------------------------------
 915+ 7694 ED 5B 18 7C      ld   de, (room_ptr)
 916+ 7698
 917+ 7698                  ; ---------------------------------------------------------------
 918+ 7698                  ; Seleziona il tile corretto in base al tipo di cella.
 919+ 7698                  ;
 920+ 7698                  ; A = 0 -> Background
 921+ 7698                  ; A = 1 -> Floor
 922+ 7698                  ; A = 2 -> Wall
 923+ 7698                  ; A = 3 -> Nasty
 924+ 7698                  ; ---------------------------------------------------------------
 925+ 7698
 926+ 7698 B7               or   a
 927+ 7699 20 06            jr   nz, .not_bg
 928+ 769B
 929+ 769B                  ; Background
 930+ 769B 21 A0 00         ld   hl, OFFSET_BG
 931+ 769E 19               add  hl, de
 932+ 769F 18 16            jr   .draw_cell
 933+ 76A1
 934+ 76A1              .not_bg:
 935+ 76A1
 936+ 76A1 3D               dec  a
 937+ 76A2 20 06            jr   nz, .not_floor
 938+ 76A4
 939+ 76A4                  ; Floor
 940+ 76A4 21 A9 00         ld   hl, OFFSET_FLOOR
 941+ 76A7 19               add  hl, de
 942+ 76A8 18 0D            jr   .draw_cell
 943+ 76AA
 944+ 76AA              .not_floor:
 945+ 76AA
 946+ 76AA 3D               dec  a
 947+ 76AB 20 06            jr   nz, .not_wall
 948+ 76AD
 949+ 76AD                  ; Wall
 950+ 76AD 21 B2 00         ld   hl, OFFSET_WALL
 951+ 76B0 19               add  hl, de
 952+ 76B1 18 04            jr   .draw_cell
 953+ 76B3
 954+ 76B3              .not_wall:
 955+ 76B3
 956+ 76B3                  ; Nasty
 957+ 76B3 21 BB 00         ld   hl, OFFSET_NASTY
 958+ 76B6 19               add  hl, de
 959+ 76B7
 960+ 76B7              .draw_cell:
 961+ 76B7
 962+ 76B7                  ; ---------------------------------------------------------------
 963+ 76B7                  ; HL punta ora alla grafica del tile da ridisegnare.
 964+ 76B7                  ;
 965+ 76B7                  ; Gfx_DrawTile si aspetta:
 966+ 76B7                  ;   IX = puntatore tile
 967+ 76B7                  ;   B  = Row
 968+ 76B7                  ;   C  = Col
 969+ 76B7                  ; ---------------------------------------------------------------
 970+ 76B7 E5               push hl
 971+ 76B8 DD E1            pop  ix
 972+ 76BA
 973+ 76BA                  ; Ripristina Row e Col salvati in IY
 974+ 76BA FD E5            push iy
 975+ 76BC C1               pop  bc
 976+ 76BD
 977+ 76BD                  ; Disegna il tile originale
 978+ 76BD CD 8C 61         call Gfx_DrawTile
 979+ 76C0
 980+ 76C0                  ; ---------------------------------------------------------------
 981+ 76C0                  ; Ripristina i registri salvati
 982+ 76C0                  ; ---------------------------------------------------------------
 983+ 76C0 DD E1            pop  ix
 984+ 76C2 E1               pop  hl
 985+ 76C3 D1               pop  de
 986+ 76C4 C1               pop  bc
 987+ 76C5 FD E1            pop  iy
 988+ 76C7
 989+ 76C7 C9               ret
 990+ 76C8
 991+ 76C8              ; -------------------------------------------------------------------
 992+ 76C8              ; CheckWillyItemCollision
 993+ 76C8              ;
 994+ 76C8              ; Verifica se Willy collide con un item utilizzando il controllo
 995+ 76C8              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 996+ 76C8              ;
 997+ 76C8              ; Input:
 998+ 76C8              ;   A = ItemX (colonna attributi 0..31)
 999+ 76C8              ;   H = ItemY (riga attributi 3..18)
1000+ 76C8              ;
1001+ 76C8              ; Coordinate item:
1002+ 76C8              ;   Ogni item occupa una cella da 8x8 pixel.
1003+ 76C8              ;
1004+ 76C8              ; Coordinate Willy:
1005+ 76C8              ;   Willy occupa un rettangolo di 16x16 pixel.
1006+ 76C8              ;
1007+ 76C8              ; Output:
1008+ 76C8              ;   Carry Set   = collisione rilevata
1009+ 76C8              ;   Carry Clear = nessuna collisione
1010+ 76C8              ;
1011+ 76C8              ; Registri preservati:
1012+ 76C8              ;   BC, DE, HL
1013+ 76C8              ; -------------------------------------------------------------------
1014+ 76C8              CheckWillyItemCollision:
1015+ 76C8
1016+ 76C8                  ; Salva i registri utilizzati
1017+ 76C8 C5               push bc
1018+ 76C9 D5               push de
1019+ 76CA E5               push hl
1020+ 76CB
1021+ 76CB                  ; ---------------------------------------------------------------
1022+ 76CB                  ; Calcola il bounding box orizzontale dell'item
1023+ 76CB                  ;
1024+ 76CB                  ; ItemLeft  = ItemX * 8
1025+ 76CB                  ; ItemRight = ItemLeft + 7
1026+ 76CB                  ;
1027+ 76CB                  ; E = ItemLeft
1028+ 76CB                  ; D = ItemRight
1029+ 76CB                  ; ---------------------------------------------------------------
1030+ 76CB 6F               ld   l, a              ; L = ItemX
1031+ 76CC
1032+ 76CC 7D               ld   a, l
1033+ 76CD 87               add  a, a              ; *2
1034+ 76CE 87               add  a, a              ; *4
1035+ 76CF 87               add  a, a              ; *8
1036+ 76D0
1037+ 76D0 5F               ld   e, a              ; E = ItemLeft
1038+ 76D1
1039+ 76D1 C6 07            add  a, 7
1040+ 76D3 57               ld   d, a              ; D = ItemRight
1041+ 76D4
1042+ 76D4                  ; ---------------------------------------------------------------
1043+ 76D4                  ; Recupera la posizione corrente di Willy
1044+ 76D4                  ;
1045+ 76D4                  ; B = WillyY
1046+ 76D4                  ; C = WillyX
1047+ 76D4                  ; ---------------------------------------------------------------
1048+ 76D4 ED 4B A1 78      ld   bc, (PlayerPos)
1049+ 76D8
1050+ 76D8                  ; ---------------------------------------------------------------
1051+ 76D8                  ; Primo test:
1052+ 76D8                  ;
1053+ 76D8                  ; WillyLeft <= ItemRight
1054+ 76D8                  ;
1055+ 76D8                  ; Se Willy è completamente a destra dell'item
1056+ 76D8                  ; non può esserci collisione.
1057+ 76D8                  ; ---------------------------------------------------------------
1058+ 76D8 79               ld   a, c              ; A = WillyLeft
1059+ 76D9
1060+ 76D9 BA               cp   d                 ; WillyLeft vs ItemRight
1061+ 76DA
1062+ 76DA 28 04            jr   z, .x_ok
1063+ 76DC 38 02            jr   c, .x_ok
1064+ 76DE
1065+ 76DE 18 29            jr   .no_collision
1066+ 76E0
1067+ 76E0              .x_ok:
1068+ 76E0
1069+ 76E0                  ; ---------------------------------------------------------------
1070+ 76E0                  ; Secondo test:
1071+ 76E0                  ;
1072+ 76E0                  ; WillyRight >= ItemLeft
1073+ 76E0                  ;
1074+ 76E0                  ; WillyRight = WillyX + 7
1075+ 76E0                  ; ---------------------------------------------------------------
1076+ 76E0 C6 07            add  a, 7
1077+ 76E2
1078+ 76E2 BB               cp   e                 ; WillyRight vs ItemLeft
1079+ 76E3
1080+ 76E3 28 04            jr   z, .y_check
1081+ 76E5 30 02            jr   nc, .y_check
1082+ 76E7
1083+ 76E7 18 20            jr   .no_collision
1084+ 76E9
1085+ 76E9              .y_check:
1086+ 76E9
1087+ 76E9                  ; ---------------------------------------------------------------
1088+ 76E9                  ; Recupera ItemY dal valore originale di HL
1089+ 76E9                  ;
1090+ 76E9                  ; H contiene la riga dell'item.
1091+ 76E9                  ; ---------------------------------------------------------------
1092+ 76E9 E1               pop  hl
1093+ 76EA E5               push hl
1094+ 76EB
1095+ 76EB                  ; ---------------------------------------------------------------
1096+ 76EB                  ; Calcola il bounding box verticale dell'item
1097+ 76EB                  ;
1098+ 76EB                  ; ItemTop    = ItemY * 8
1099+ 76EB                  ; ItemBottom = ItemTop + 7
1100+ 76EB                  ;
1101+ 76EB                  ; E = ItemTop
1102+ 76EB                  ; D = ItemBottom
1103+ 76EB                  ; ---------------------------------------------------------------
1104+ 76EB 7C               ld   a, h
1105+ 76EC
1106+ 76EC 87               add  a, a              ; *2
1107+ 76ED 87               add  a, a              ; *4
1108+ 76EE 87               add  a, a              ; *8
1109+ 76EF
1110+ 76EF 5F               ld   e, a              ; ItemTop
1111+ 76F0
1112+ 76F0 C6 07            add  a, 7
1113+ 76F2 57               ld   d, a              ; ItemBottom
1114+ 76F3
1115+ 76F3                  ; ---------------------------------------------------------------
1116+ 76F3                  ; Primo test verticale:
1117+ 76F3                  ;
1118+ 76F3                  ; WillyTop <= ItemBottom
1119+ 76F3                  ; ---------------------------------------------------------------
1120+ 76F3 78               ld   a, b              ; WillyTop
1121+ 76F4
1122+ 76F4 BA               cp   d
1123+ 76F5
1124+ 76F5 28 04            jr   z, .y_ok
1125+ 76F7 38 02            jr   c, .y_ok
1126+ 76F9
1127+ 76F9 18 0E            jr   .no_collision
1128+ 76FB
1129+ 76FB              .y_ok:
1130+ 76FB
1131+ 76FB                  ; ---------------------------------------------------------------
1132+ 76FB                  ; Secondo test verticale:
1133+ 76FB                  ;
1134+ 76FB                  ; WillyBottom >= ItemTop
1135+ 76FB                  ;
1136+ 76FB                  ; WillyBottom = WillyY + 15
1137+ 76FB                  ; ---------------------------------------------------------------
1138+ 76FB C6 0F            add  a, 15
1139+ 76FD
1140+ 76FD BB               cp   e
1141+ 76FE
1142+ 76FE 28 04            jr   z, .collision
1143+ 7700 30 02            jr   nc, .collision
1144+ 7702
1145+ 7702 18 05            jr   .no_collision
1146+ 7704
1147+ 7704              .collision:
1148+ 7704
1149+ 7704                  ; ---------------------------------------------------------------
1150+ 7704                  ; Collisione rilevata
1151+ 7704                  ; ---------------------------------------------------------------
1152+ 7704 E1               pop  hl
1153+ 7705 D1               pop  de
1154+ 7706 C1               pop  bc
1155+ 7707
1156+ 7707 37               scf                    ; Carry = 1
1157+ 7708
1158+ 7708 C9               ret
1159+ 7709
1160+ 7709              .no_collision:
1161+ 7709
1162+ 7709                  ; ---------------------------------------------------------------
1163+ 7709                  ; Nessuna collisione
1164+ 7709                  ; ---------------------------------------------------------------
1165+ 7709 E1               pop  hl
1166+ 770A D1               pop  de
1167+ 770B C1               pop  bc
1168+ 770C
1169+ 770C B7               or   a                 ; Carry = 0
1170+ 770D
1171+ 770D C9               ret
1172+ 770E
1173+ 770E              ; -------------------------------------------------------------------
1174+ 770E              ; Items_CheckCollision
1175+ 770E              ;
1176+ 770E              ; Controlla se Willy entra in collisione con uno degli item
1177+ 770E              ; attivi presenti nella stanza corrente.
1178+ 770E              ;
1179+ 770E              ; Per ogni item:
1180+ 770E              ;   - verifica che appartenga alla stanza corrente
1181+ 770E              ;   - verifica che non sia già stato raccolto
1182+ 770E              ;   - esegue il test di collisione con Willy
1183+ 770E              ;
1184+ 770E              ; Se l'item viene raccolto:
1185+ 770E              ;   - imposta il flag "collected"
1186+ 770E              ;   - rimuove l'item dalla cache items_grid
1187+ 770E              ;   - incrementa il contatore degli oggetti raccolti
1188+ 770E              ;   - aggiorna l'HUD
1189+ 770E              ;   - ripristina il tile di sfondo
1190+ 770E              ;   - riproduce il suono di raccolta
1191+ 770E              ;
1192+ 770E              ; Formato record ItemsTable:
1193+ 770E              ;   +0 RoomID
1194+ 770E              ;   +1 X
1195+ 770E              ;   +2 Y
1196+ 770E              ;   +3 Color
1197+ 770E              ;   +4 Collected
1198+ 770E              ;
1199+ 770E              ; Fine tabella:
1200+ 770E              ;   RoomID = $FF
1201+ 770E              ; -------------------------------------------------------------------
1202+ 770E              Items_CheckCollision:
1203+ 770E
1204+ 770E                  ; Salva i registri utilizzati
1205+ 770E E5               push hl
1206+ 770F D5               push de
1207+ 7710 C5               push bc
1208+ 7711
1209+ 7711                  ; Inizio scansione della tabella degli item
1210+ 7711 21 A3 73         ld   hl, ItemsTable
1211+ 7714
1212+ 7714              .loop:
1213+ 7714
1214+ 7714                  ; ---------------------------------------------------------------
1215+ 7714                  ; Legge il Room ID dell'item corrente
1216+ 7714                  ; ---------------------------------------------------------------
1217+ 7714 7E               ld   a, (hl)
1218+ 7715
1219+ 7715                  ; $FF indica fine tabella
1220+ 7715 FE FF            cp   $FF
1221+ 7717 28 4D            jr   z, .done
1222+ 7719
1223+ 7719                  ; ---------------------------------------------------------------
1224+ 7719                  ; Verifica se l'item appartiene alla stanza corrente
1225+ 7719                  ; ---------------------------------------------------------------
1226+ 7719 57               ld   d, a              ; D = RoomID item
1227+ 771A
1228+ 771A 3A BE 7B         ld   a, (current_room)
1229+ 771D BA               cp   d
1230+ 771E
1231+ 771E                  ; Se appartiene a un'altra stanza salta il record
1232+ 771E 20 3F            jr   nz, .next_item
1233+ 7720
1234+ 7720                  ; ---------------------------------------------------------------
1235+ 7720                  ; Legge coordinate e stato dell'item
1236+ 7720                  ; ---------------------------------------------------------------
1237+ 7720
1238+ 7720 23               inc  hl
1239+ 7721 4E               ld   c, (hl)           ; C = X
1240+ 7722
1241+ 7722 23               inc  hl
1242+ 7723 46               ld   b, (hl)           ; B = Y
1243+ 7724
1244+ 7724 23               inc  hl                ; salta Color
1245+ 7725
1246+ 7725 23               inc  hl                ; punta a Collected
1247+ 7726
1248+ 7726 7E               ld   a, (hl)
1249+ 7727
1250+ 7727                  ; ---------------------------------------------------------------
1251+ 7727                  ; Item già raccolto?
1252+ 7727                  ; ---------------------------------------------------------------
1253+ 7727 B7               or   a
1254+ 7728 20 39            jr   nz, .next_no_inc
1255+ 772A
1256+ 772A                  ; ---------------------------------------------------------------
1257+ 772A                  ; Test collisione Willy ↔ Item
1258+ 772A                  ;
1259+ 772A                  ; Input richiesto:
1260+ 772A                  ;   A = ItemX
1261+ 772A                  ;   H = ItemY
1262+ 772A                  ; ---------------------------------------------------------------
1263+ 772A 79               ld   a, c
1264+ 772B
1265+ 772B E5               push hl                ; salva puntatore al flag Collected
1266+ 772C
1267+ 772C 60               ld   h, b
1268+ 772D
1269+ 772D CD C8 76         call CheckWillyItemCollision
1270+ 7730
1271+ 7730 E1               pop  hl
1272+ 7731
1273+ 7731                  ; Nessuna collisione
1274+ 7731 30 30            jr   nc, .next_no_inc
1275+ 7733
1276+ 7733                  ; ===============================================================
1277+ 7733                  ; ITEM RACCOLTO
1278+ 7733                  ; ===============================================================
1279+ 7733
1280+ 7733                  ; ---------------------------------------------------------------
1281+ 7733                  ; Marca l'item come raccolto
1282+ 7733                  ; ---------------------------------------------------------------
1283+ 7733 36 01            ld   (hl), 1
1284+ 7735
1285+ 7735                  ; ---------------------------------------------------------------
1286+ 7735                  ; Rimuove l'item dalla cache items_grid
1287+ 7735                  ;
1288+ 7735                  ; Calcolo:
1289+ 7735                  ;   offset = Row * 32 + Col
1290+ 7735                  ; ---------------------------------------------------------------
1291+ 7735 E5               push hl
1292+ 7736 D5               push de
1293+ 7737
1294+ 7737 26 00            ld   h, 0
1295+ 7739 68               ld   l, b              ; HL = Row
1296+ 773A
1297+ 773A 29               add  hl, hl            ; *2
1298+ 773B 29               add  hl, hl            ; *4
1299+ 773C 29               add  hl, hl            ; *8
1300+ 773D 29               add  hl, hl            ; *16
1301+ 773E 29               add  hl, hl            ; *32
1302+ 773F
1303+ 773F 59               ld   e, c
1304+ 7740 16 00            ld   d, 0
1305+ 7742
1306+ 7742 19               add  hl, de            ; Row*32 + Col
1307+ 7743
1308+ 7743 11 00 B0         ld   de, items_grid
1309+ 7746 19               add  hl, de
1310+ 7747
1311+ 7747                  ; La cella non contiene più un item
1312+ 7747 36 00            ld   (hl), 0
1313+ 7749
1314+ 7749 D1               pop  de
1315+ 774A E1               pop  hl
1316+ 774B
1317+ 774B                  ; ---------------------------------------------------------------
1318+ 774B                  ; Conserva il puntatore all'entry corrente
1319+ 774B                  ; poiché le routine successive possono alterare HL.
1320+ 774B                  ; ---------------------------------------------------------------
1321+ 774B E5               push hl
1322+ 774C
1323+ 774C                  ; ---------------------------------------------------------------
1324+ 774C                  ; Aggiorna il numero di oggetti raccolti
1325+ 774C                  ; ---------------------------------------------------------------
1326+ 774C 3A AB 78         ld   a, (items_collected)
1327+ 774F
1328+ 774F 3C               inc  a
1329+ 7750
1330+ 7750 32 AB 78         ld   (items_collected), a
1331+ 7753
1332+ 7753                  ; ---------------------------------------------------------------
1333+ 7753                  ; Aggiorna il contatore visualizzato a schermo
1334+ 7753                  ; ---------------------------------------------------------------
1335+ 7753 CD CB 60         call Gfx_UpdateItemsCollectedDisplay
1336+ 7756
1337+ 7756                  ; ---------------------------------------------------------------
1338+ 7756                  ; Ripristina il tile originale della stanza
1339+ 7756                  ; eliminando la grafica dell'item.
1340+ 7756                  ;
1341+ 7756                  ; Input:
1342+ 7756                  ;   B = Row
1343+ 7756                  ;   C = Col
1344+ 7756                  ; ---------------------------------------------------------------
1345+ 7756 CD 86 76         call RestoreBackgroundCell
1346+ 7759
1347+ 7759                  ; ---------------------------------------------------------------
1348+ 7759                  ; Riproduce il suono di raccolta
1349+ 7759                  ; ---------------------------------------------------------------
1350+ 7759 CD 80 78         call Audio_PlayCollectSound
1351+ 775C
1352+ 775C                  ; Ripristina il puntatore alla tabella
1353+ 775C E1               pop  hl
1354+ 775D
1355+ 775D                  ; Continua con il record successivo
1356+ 775D 18 04            jr   .next_no_inc
1357+ 775F
1358+ 775F              .next_item:
1359+ 775F
1360+ 775F                  ; ---------------------------------------------------------------
1361+ 775F                  ; Salta i campi del record:
1362+ 775F                  ;   X
1363+ 775F                  ;   Y
1364+ 775F                  ;   Color
1365+ 775F                  ;   Collected
1366+ 775F                  ; ---------------------------------------------------------------
1367+ 775F 23               inc  hl
1368+ 7760 23               inc  hl
1369+ 7761 23               inc  hl
1370+ 7762 23               inc  hl
1371+ 7763
1372+ 7763              .next_no_inc:
1373+ 7763
1374+ 7763                  ; ---------------------------------------------------------------
1375+ 7763                  ; Avanza al record successivo.
1376+ 7763                  ;
1377+ 7763                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1378+ 7763                  ; ---------------------------------------------------------------
1379+ 7763 23               inc  hl
1380+ 7764
1381+ 7764 18 AE            jr   .loop
1382+ 7766
1383+ 7766              .done:
1384+ 7766
1385+ 7766                  ; Ripristina i registri
1386+ 7766 C1               pop  bc
1387+ 7767 D1               pop  de
1388+ 7768 E1               pop  hl
1389+ 7769
1390+ 7769 C9               ret
1391+ 776A
1392+ 776A
1393+ 776A
1394+ 776A              ; -------------------------------------------------------------------
1395+ 776A              ; CheckActiveItemAtCell
1396+ 776A              ;
1397+ 776A              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1398+ 776A              ; nella cella specificata della griglia items_grid.
1399+ 776A              ;
1400+ 776A              ; Questa routine usa una lookup diretta su una mappa 32x16,
1401+ 776A              ; evitando la scansione della ItemsTable.
1402+ 776A              ;
1403+ 776A              ; Input:
1404+ 776A              ;   B = Colonna (0..31)
1405+ 776A              ;   C = Riga (0..15)
1406+ 776A              ;
1407+ 776A              ; Output:
1408+ 776A              ;   Carry Set   = item presente nella cella
1409+ 776A              ;   Carry Clear = nessun item
1410+ 776A              ;
1411+ 776A              ; Nota:
1412+ 776A              ;   HL NON è restituito valido (commento originale non corretto:
1413+ 776A              ;   la routine non punta a ItemsTable).
1414+ 776A              ; -------------------------------------------------------------------
1415+ 776A              CheckActiveItemAtCell:
1416+ 776A
1417+ 776A                  ; Salva registri usati
1418+ 776A D5               push de
1419+ 776B E5               push hl
1420+ 776C
1421+ 776C                  ; ---------------------------------------------------------------
1422+ 776C                  ; Calcolo indice lineare nella griglia 32x16:
1423+ 776C                  ;
1424+ 776C                  ; offset = Row * 32 + Col
1425+ 776C                  ; ---------------------------------------------------------------
1426+ 776C 26 00            ld   h, 0
1427+ 776E 69               ld   l, c              ; HL = Row
1428+ 776F
1429+ 776F 29               add  hl, hl            ; *2
1430+ 7770 29               add  hl, hl            ; *4
1431+ 7771 29               add  hl, hl            ; *8
1432+ 7772 29               add  hl, hl            ; *16
1433+ 7773 29               add  hl, hl            ; *32
1434+ 7774
1435+ 7774                  ; Aggiunge la colonna
1436+ 7774 58               ld   e, b
1437+ 7775 16 00            ld   d, 0
1438+ 7777 19               add  hl, de            ; HL = Row*32 + Col
1439+ 7778
1440+ 7778                  ; ---------------------------------------------------------------
1441+ 7778                  ; Accesso alla griglia degli item attivi
1442+ 7778                  ; ---------------------------------------------------------------
1443+ 7778 11 00 B0         ld   de, items_grid
1444+ 777B 19               add  hl, de            ; HL = address cella
1445+ 777C
1446+ 777C                  ; ---------------------------------------------------------------
1447+ 777C                  ; Controllo presenza item
1448+ 777C                  ;
1449+ 777C                  ; items_grid contiene:
1450+ 777C                  ;   0 = nessun item
1451+ 777C                  ;   >0 = item attivo (colore o flag)
1452+ 777C                  ; ---------------------------------------------------------------
1453+ 777C 7E               ld   a, (hl)
1454+ 777D B7               or   a
1455+ 777E 28 04            jr   z, .not_active
1456+ 7780
1457+ 7780                  ; ---------------------------------------------------------------
1458+ 7780                  ; Item trovato
1459+ 7780                  ; ---------------------------------------------------------------
1460+ 7780 E1               pop  hl
1461+ 7781 D1               pop  de
1462+ 7782
1463+ 7782 37               scf                    ; Carry = 1
1464+ 7783 C9               ret
1465+ 7784
1466+ 7784              .not_active:
1467+ 7784
1468+ 7784                  ; ---------------------------------------------------------------
1469+ 7784                  ; Nessun item nella cella
1470+ 7784                  ; ---------------------------------------------------------------
1471+ 7784 E1               pop  hl
1472+ 7785 D1               pop  de
1473+ 7786
1474+ 7786 B7               or   a                 ; Carry = 0
1475+ 7787 C9               ret
1476+ 7788
