   7+ 6A35              ; Controlla input tastiera
   8+ 6A35              ; Output: D = tasti premuti
   9+ 6A35              ; -------------------------------------------------------------------
  10+ 6A35              CheckCtrl:
  11+ 6A35 16 00            ld  d, $00
  12+ 6A37 3E FE            ld  a, $fe
  13+ 6A39 DB FE            in  a, ($fe)
  14+ 6A3B DD 21 5A 6F      ld  ix,flags
  15+ 6A3F
  16+ 6A3F              checkCtrl_left:
  17+ 6A3F CB 4F            bit $01, a
  18+ 6A41 20 0D            jr  nz, checkCtrl_right
  19+ 6A43 CB C2            set $00, d
  20+ 6A45 DD CB 00 C6      set 0,(ix)
  21+ 6A49 5F               ld  e, a
  22+ 6A4A 3E 01            ld  a, 1
  23+ 6A4C 32 59 6F         ld  (direction), a
  24+ 6A4F 7B               ld  a, e
  25+ 6A50
  26+ 6A50              checkCtrl_right:
  27+ 6A50 CB 57            bit $02, a
  28+ 6A52 20 0D            jr  nz, checkCtrl_jump
  29+ 6A54 CB CA            set $01, d
  30+ 6A56 DD CB 00 C6      set 0,(ix)
  31+ 6A5A 5F               ld  e, a
  32+ 6A5B 3E 02            ld  a, 2
  33+ 6A5D 32 59 6F         ld  (direction), a
  34+ 6A60 7B               ld  a, e
  35+ 6A61
  36+ 6A61              checkCtrl_jump:
  37+ 6A61                  ; Controlla tasto P (Porta $DF, Bit 0)
  38+ 6A61 3E DF            ld  a, $df
  39+ 6A63 DB FE            in  a, ($fe)
  40+ 6A65 CB 47            bit 0, a
  41+ 6A67 28 0E            jr  z, .pressed   ; Se P è premuto (bit 0 = 0)
  42+ 6A69
  43+ 6A69                  ; Controlla tasto M (Porta $7F, Bit 2)
  44+ 6A69 3E 7F            ld  a, $7f
  45+ 6A6B DB FE            in  a, ($fe)
  46+ 6A6D CB 57            bit 2, a
  47+ 6A6F 28 06            jr  z, .pressed   ; Se M è premuto (bit 2 = 0)
  48+ 6A71
  49+ 6A71              .released:
  50+ 6A71 AF               xor a
  51+ 6A72 32 61 6F         ld  (jump_prev), a
  52+ 6A75 18 10            jr  .end
  53+ 6A77
  54+ 6A77              .pressed:
  55+ 6A77 3A 61 6F         ld  a, (jump_prev)
  56+ 6A7A B7               or  a
  57+ 6A7B 20 0A            jr  nz, .end
  58+ 6A7D 3E 01            ld  a, 1
  59+ 6A7F 32 60 6F         ld  (jump_pressed), a
  60+ 6A82 32 61 6F         ld  (jump_prev), a
  61+ 6A85 CB D2            set 2, d
  62+ 6A87
  63+ 6A87              .end:
  64+ 6A87 7A               ld   a, d
  65+ 6A88 E6 03            and  $03
  66+ 6A8A D6 03            sub  $03
  67+ 6A8C C0               ret  nz
  68+ 6A8D 7A               ld   a, d
  69+ 6A8E E6 04            and  $04
  70+ 6A90 57               ld   d, a
  71+ 6A91 C9               ret
