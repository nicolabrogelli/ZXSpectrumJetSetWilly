1421+ 77B6              ; CheckActiveItemAtCell
1422+ 77B6              ;
1423+ 77B6              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1424+ 77B6              ; nella cella specificata della griglia items_grid.
1425+ 77B6              ;
1426+ 77B6              ; Questa routine usa una lookup diretta su una mappa 32x16,
1427+ 77B6              ; evitando la scansione della ItemsTable.
1428+ 77B6              ;
1429+ 77B6              ; Input:
1430+ 77B6              ;   B = Colonna (0..31)
1431+ 77B6              ;   C = Riga (0..15)
1432+ 77B6              ;
1433+ 77B6              ; Output:
1434+ 77B6              ;   Carry Set   = item presente nella cella
1435+ 77B6              ;   Carry Clear = nessun item
1436+ 77B6              ;
1437+ 77B6              ; Nota:
1438+ 77B6              ;   HL NON è restituito valido (commento originale non corretto:
1439+ 77B6              ;   la routine non punta a ItemsTable).
1440+ 77B6              ; -------------------------------------------------------------------
1441+ 77B6              CheckActiveItemAtCell:
1442+ 77B6
1443+ 77B6                  ; Salva registri usati
1444+ 77B6 D5               push de
1445+ 77B7 E5               push hl
1446+ 77B8
1447+ 77B8                  ; ---------------------------------------------------------------
1448+ 77B8                  ; Calcolo indice lineare nella griglia 32x16:
1449+ 77B8                  ;
1450+ 77B8                  ; offset = Row * 32 + Col
1451+ 77B8                  ; ---------------------------------------------------------------
1452+ 77B8 26 00            ld   h, 0
1453+ 77BA 69               ld   l, c              ; HL = Row
1454+ 77BB
1455+ 77BB 29               add  hl, hl            ; *2
1456+ 77BC 29               add  hl, hl            ; *4
1457+ 77BD 29               add  hl, hl            ; *8
1458+ 77BE 29               add  hl, hl            ; *16
1459+ 77BF 29               add  hl, hl            ; *32
1460+ 77C0
1461+ 77C0                  ; Aggiunge la colonna
1462+ 77C0 58               ld   e, b
1463+ 77C1 16 00            ld   d, 0
1464+ 77C3 19               add  hl, de            ; HL = Row*32 + Col
1465+ 77C4
1466+ 77C4                  ; ---------------------------------------------------------------
1467+ 77C4                  ; Accesso alla griglia degli item attivi
1468+ 77C4                  ; ---------------------------------------------------------------
1469+ 77C4 11 00 B0         ld   de, items_grid
1470+ 77C7 19               add  hl, de            ; HL = address cella
1471+ 77C8
1472+ 77C8                  ; ---------------------------------------------------------------
1473+ 77C8                  ; Controllo presenza item
1474+ 77C8                  ;
1475+ 77C8                  ; items_grid contiene:
1476+ 77C8                  ;   0 = nessun item
1477+ 77C8                  ;   >0 = item attivo (colore o flag)
1478+ 77C8                  ; ---------------------------------------------------------------
1479+ 77C8 7E               ld   a, (hl)
1480+ 77C9 B7               or   a
1481+ 77CA 28 04            jr   z, .not_active
1482+ 77CC
1483+ 77CC                  ; ---------------------------------------------------------------
1484+ 77CC                  ; Item trovato
1485+ 77CC                  ; ---------------------------------------------------------------
1486+ 77CC E1               pop  hl
1487+ 77CD D1               pop  de
1488+ 77CE
1489+ 77CE 37               scf                    ; Carry = 1
1490+ 77CF C9               ret
1491+ 77D0
1492+ 77D0              .not_active:
1493+ 77D0
1494+ 77D0                  ; ---------------------------------------------------------------
1495+ 77D0                  ; Nessun item nella cella
1496+ 77D0                  ; ---------------------------------------------------------------
1497+ 77D0 E1               pop  hl
1498+ 77D1 D1               pop  de
1499+ 77D2
1500+ 77D2 B7               or   a                 ; Carry = 0
1501+ 77D3 C9               ret
1502+ 77D4
