1321+ 7FDC              ; -------------------------------------------------------------------
1322+ 7FDC              ; DrawItemGraphic
1323+ 7FDC              ;
1324+ 7FDC              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1325+ 7FDC              ; utilizzando una bitmap di 8 byte e un attributo colore.
1326+ 7FDC              ;
1327+ 7FDC              ; Input:
1328+ 7FDC              ;   B = Riga attributi (3..18)
1329+ 7FDC              ;   C = Colonna attributi (0..31)
1330+ 7FDC              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1331+ 7FDC              ;   E = Attributo colore
1332+ 7FDC              ;
1333+ 7FDC              ; Output:
1334+ 7FDC              ;   Nessuno
1335+ 7FDC              ;
1336+ 7FDC              ; Registri preservati:
1337+ 7FDC              ;   BC, DE, HL
1338+ 7FDC              ; -------------------------------------------------------------------
1339+ 7FDC              DrawItemGraphic:
1340+ 7FDC
1341+ 7FDC                  ; Salva i registri originali
1342+ 7FDC C5               push bc
1343+ 7FDD D5               push de
1344+ 7FDE E5               push hl
1345+ 7FDF
1346+ 7FDF                  ; ---------------------------------------------------------------
1347+ 7FDF                  ; Calcolo indirizzo bitmap dello Spectrum
1348+ 7FDF                  ;
1349+ 7FDF                  ; Ogni item occupa una cella attributi (8x8 pixel).
1350+ 7FDF                  ;
1351+ 7FDF                  ; Formula:
1352+ 7FDF                  ;   High = $40 + (Row AND $18)
1353+ 7FDF                  ;   Low  = (Row AND 7) * 32 + Col
1354+ 7FDF                  ;
1355+ 7FDF                  ; DE conterrà l'indirizzo della prima scanline.
1356+ 7FDF                  ; ---------------------------------------------------------------
1357+ 7FDF
1358+ 7FDF 78               ld   a, b
1359+ 7FE0 E6 18            and  $18
1360+ 7FE2 C6 40            add  a, $40
1361+ 7FE4 57               ld   d, a              ; Byte alto indirizzo video
1362+ 7FE5
1363+ 7FE5 78               ld   a, b
1364+ 7FE6 E6 07            and  7                 ; Riga interna al blocco da 8
1365+ 7FE8
1366+ 7FE8 87               add  a, a              ; *2
1367+ 7FE9 87               add  a, a              ; *4
1368+ 7FEA 87               add  a, a              ; *8
1369+ 7FEB 87               add  a, a              ; *16
1370+ 7FEC 87               add  a, a              ; *32
1371+ 7FED
1372+ 7FED 81               add  a, c              ; + colonna
1373+ 7FEE
1374+ 7FEE 5F               ld   e, a              ; Byte basso indirizzo video
1375+ 7FEF
1376+ 7FEF                  ; ---------------------------------------------------------------
1377+ 7FEF                  ; Disegno bitmap
1378+ 7FEF                  ;
1379+ 7FEF                  ; Copia 8 byte consecutivi nella memoria video.
1380+ 7FEF                  ; Ogni byte rappresenta una scanline da 8 pixel.
1381+ 7FEF                  ; ---------------------------------------------------------------
1382+ 7FEF
1383+ 7FEF C5               push bc                ; Conserva Row e Col
1384+ 7FF0
1385+ 7FF0 06 08            ld   b, 8              ; Numero scanline
1386+ 7FF2
1387+ 7FF2              .line_loop:
1388+ 7FF2
1389+ 7FF2 7E               ld   a, (hl)           ; Legge scanline bitmap
1390+ 7FF3 12               ld   (de), a           ; Scrive nella memoria video
1391+ 7FF4
1392+ 7FF4 14               inc  d                 ; Scanline successiva
1393+ 7FF5 23               inc  hl                ; Byte bitmap successivo
1394+ 7FF6
1395+ 7FF6 05               dec  b
1396+ 7FF7 20 F9            jr   nz, .line_loop
1397+ 7FF9
1398+ 7FF9 C1               pop  bc                ; Ripristina Row e Col
1399+ 7FFA
1400+ 7FFA                  ; ---------------------------------------------------------------
1401+ 7FFA                  ; Calcolo indirizzo attributo
1402+ 7FFA                  ;
1403+ 7FFA                  ; Formula:
1404+ 7FFA                  ;   AttrAddr = $5800 + Row * 32 + Col
1405+ 7FFA                  ;
1406+ 7FFA                  ; HL conterrà l'indirizzo della cella attributi.
1407+ 7FFA                  ; ---------------------------------------------------------------
1408+ 7FFA
1409+ 7FFA 26 00            ld   h, 0
1410+ 7FFC 68               ld   l, b              ; HL = Row
1411+ 7FFD
1412+ 7FFD 29               add  hl, hl            ; *2
1413+ 7FFE 29               add  hl, hl            ; *4
1414+ 7FFF 29               add  hl, hl            ; *8
1415+ 8000 29               add  hl, hl            ; *16
1416+ 8001 29               add  hl, hl            ; *32
1417+ 8002
1418+ 8002 79               ld   a, c              ; A = Colonna
1419+ 8003
1420+ 8003 85               add  a, l
1421+ 8004 6F               ld   l, a
1422+ 8005
1423+ 8005 30 01            jr   nc, .no_carry
1424+ 8007 24               inc  h
1425+ 8008
1426+ 8008              .no_carry:
1427+ 8008
1428+ 8008                  ; HL = Row * 32 + Col
1429+ 8008
1430+ 8008 11 00 58         ld   de, $5800
1431+ 800B 19               add  hl, de            ; HL = indirizzo attributi
1432+ 800C
1433+ 800C                  ; ---------------------------------------------------------------
1434+ 800C                  ; Recupera il colore originale dallo stack.
1435+ 800C                  ;
1436+ 800C                  ; Layout stack:
1437+ 800C                  ;   HL originale
1438+ 800C                  ;   DE originale (E = colore)
1439+ 800C                  ;   BC originale
1440+ 800C                  ; ---------------------------------------------------------------
1441+ 800C
1442+ 800C C1               pop  bc                ; Recupera HL originale
1443+ 800D D1               pop  de                ; Recupera DE originale
1444+ 800E
1445+ 800E                  ; ---------------------------------------------------------------
1446+ 800E                  ; Scrive l'attributo colore
1447+ 800E                  ; ---------------------------------------------------------------
1448+ 800E
1449+ 800E 7B               ld   a, e              ; A = colore
1450+ 800F 77               ld   (hl), a           ; Scrive nella RAM attributi
1451+ 8010
1452+ 8010                  ; ---------------------------------------------------------------
1453+ 8010                  ; Ripristina HL e BC originali
1454+ 8010                  ; ---------------------------------------------------------------
1455+ 8010
1456+ 8010 C5               push bc
1457+ 8011 E1               pop  hl                ; HL originale
1458+ 8012
1459+ 8012 C1               pop  bc                ; BC originale
1460+ 8013
1461+ 8013 C9               ret
1462+ 8014
1463+ 8014              ; -------------------------------------------------------------------
1464+ 8014              ; RestoreBackgroundCell
1465+ 8014              ;
1466+ 8014              ; Ripristina il contenuto originale di una cella della stanza.
1467+ 8014              ; Viene utilizzata principalmente quando un item viene raccolto:
1468+ 8014              ; invece di lasciare un "buco", la routine ridisegna il tile
1469+ 8014              ; originale presente nella mappa della stanza.
1470+ 8014              ;
1471+ 8014              ; Input:
1472+ 8014              ;   B = Row (3..18)
1473+ 8014              ;   C = Col (0..31)
1474+ 8014              ;
1475+ 8014              ; Utilizza:
1476+ 8014              ;   room_ptr -> struttura dati della stanza corrente
1477+ 8014              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1478+ 8014              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1479+ 8014              ;
1480+ 8014              ; Tipi di cella:
1481+ 8014              ;   0 = Background
1482+ 8014              ;   1 = Floor
1483+ 8014              ;   2 = Wall
1484+ 8014              ;   3 = Nasty
1485+ 8014              ; -------------------------------------------------------------------
1486+ 8014              RestoreBackgroundCell:
1487+ 8014
1488+ 8014                  ; Salva tutti i registri utilizzati
1489+ 8014 FD E5            push iy
1490+ 8016 C5               push bc
1491+ 8017 D5               push de
1492+ 8018 E5               push hl
1493+ 8019 DD E5            push ix
1494+ 801B
1495+ 801B                  ; ---------------------------------------------------------------
1496+ 801B                  ; Conserva Row e Col in IY.
1497+ 801B                  ;
1498+ 801B                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1499+ 801B                  ; BC potrebbe essere modificato.
1500+ 801B                  ; ---------------------------------------------------------------
1501+ 801B C5               push bc
1502+ 801C FD E1            pop  iy                ; IYH = Row, IYL = Col
1503+ 801E
1504+ 801E                  ; ---------------------------------------------------------------
1505+ 801E                  ; Determina quale tipo di cella è presente nella posizione
1506+ 801E                  ; specificata.
1507+ 801E                  ;
1508+ 801E                  ; Input:
1509+ 801E                  ;   B = Row
1510+ 801E                  ;   C = Col
1511+ 801E                  ;
1512+ 801E                  ; Output:
1513+ 801E                  ;   A = tipo cella
1514+ 801E                  ; ---------------------------------------------------------------
1515+ 801E 78               ld   a, b
1516+ 801F
1517+ 801F CD 45 71         call GetCellFromUnpacked
1518+ 8022
1519+ 8022                  ; ---------------------------------------------------------------
1520+ 8022                  ; Recupera il puntatore alla stanza corrente.
1521+ 8022                  ;
1522+ 8022                  ; DE = base della struttura stanza
1523+ 8022                  ; ---------------------------------------------------------------
1524+ 8022 ED 5B A6 E9      ld   de, (room_ptr)
1525+ 8026
1526+ 8026                  ; ---------------------------------------------------------------
1527+ 8026                  ; Seleziona il tile corretto in base al tipo di cella.
1528+ 8026                  ;
1529+ 8026                  ; A = 0 -> Background
1530+ 8026                  ; A = 1 -> Floor
1531+ 8026                  ; A = 2 -> Wall
1532+ 8026                  ; A = 3 -> Nasty
1533+ 8026                  ; ---------------------------------------------------------------
1534+ 8026
1535+ 8026 B7               or   a
1536+ 8027 20 06            jr   nz, .not_bg
1537+ 8029
1538+ 8029                  ; Background
1539+ 8029 21 A0 00         ld   hl, OFFSET_BG
1540+ 802C 19               add  hl, de
1541+ 802D 18 16            jr   .draw_cell
1542+ 802F
1543+ 802F              .not_bg:
1544+ 802F
1545+ 802F 3D               dec  a
1546+ 8030 20 06            jr   nz, .not_floor
1547+ 8032
1548+ 8032                  ; Floor
1549+ 8032 21 A9 00         ld   hl, OFFSET_FLOOR
1550+ 8035 19               add  hl, de
1551+ 8036 18 0D            jr   .draw_cell
1552+ 8038
1553+ 8038              .not_floor:
1554+ 8038
1555+ 8038 3D               dec  a
1556+ 8039 20 06            jr   nz, .not_wall
1557+ 803B
1558+ 803B                  ; Wall
1559+ 803B 21 B2 00         ld   hl, OFFSET_WALL
1560+ 803E 19               add  hl, de
1561+ 803F 18 04            jr   .draw_cell
1562+ 8041
1563+ 8041              .not_wall:
1564+ 8041
1565+ 8041                  ; Nasty
1566+ 8041 21 BB 00         ld   hl, OFFSET_NASTY
1567+ 8044 19               add  hl, de
1568+ 8045
1569+ 8045              .draw_cell:
1570+ 8045
1571+ 8045                  ; ---------------------------------------------------------------
1572+ 8045                  ; HL punta ora alla grafica del tile da ridisegnare.
1573+ 8045                  ;
1574+ 8045                  ; Gfx_DrawTile si aspetta:
1575+ 8045                  ;   IX = puntatore tile
1576+ 8045                  ;   B  = Row
1577+ 8045                  ;   C  = Col
1578+ 8045                  ; ---------------------------------------------------------------
1579+ 8045 E5               push hl
1580+ 8046 DD E1            pop  ix
1581+ 8048
1582+ 8048                  ; Ripristina Row e Col salvati in IY
1583+ 8048 FD E5            push iy
1584+ 804A C1               pop  bc
1585+ 804B
1586+ 804B                  ; Disegna il tile originale
1587+ 804B CD 14 64         call Gfx_DrawTile
1588+ 804E
1589+ 804E                  ; ---------------------------------------------------------------
1590+ 804E                  ; Ripristina i registri salvati
1591+ 804E                  ; ---------------------------------------------------------------
1592+ 804E DD E1            pop  ix
1593+ 8050 E1               pop  hl
1594+ 8051 D1               pop  de
1595+ 8052 C1               pop  bc
1596+ 8053 FD E1            pop  iy
1597+ 8055
1598+ 8055 C9               ret
1599+ 8056
1600+ 8056              ; -------------------------------------------------------------------
1601+ 8056              ; CheckWillyItemCollision
1602+ 8056              ;
1603+ 8056              ; Verifica se Willy collide con un item utilizzando il controllo
1604+ 8056              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1605+ 8056              ;
1606+ 8056              ; Input:
1607+ 8056              ;   A = ItemX (colonna attributi 0..31)
1608+ 8056              ;   H = ItemY (riga attributi 3..18)
1609+ 8056              ;
1610+ 8056              ; Coordinate item:
1611+ 8056              ;   Ogni item occupa una cella da 8x8 pixel.
1612+ 8056              ;
1613+ 8056              ; Coordinate Willy:
1614+ 8056              ;   Willy occupa un rettangolo di 16x16 pixel.
1615+ 8056              ;
1616+ 8056              ; Output:
1617+ 8056              ;   Carry Set   = collisione rilevata
1618+ 8056              ;   Carry Clear = nessuna collisione
1619+ 8056              ;
1620+ 8056              ; Registri preservati:
1621+ 8056              ;   BC, DE, HL
1622+ 8056              ; -------------------------------------------------------------------
1623+ 8056              CheckWillyItemCollision:
1624+ 8056
1625+ 8056                  ; Salva i registri utilizzati
1626+ 8056 C5               push bc
1627+ 8057 D5               push de
1628+ 8058 E5               push hl
1629+ 8059
1630+ 8059                  ; ---------------------------------------------------------------
1631+ 8059                  ; Calcola il bounding box orizzontale dell'item
1632+ 8059                  ;
1633+ 8059                  ; ItemLeft  = ItemX * 8
1634+ 8059                  ; ItemRight = ItemLeft + 7
1635+ 8059                  ;
1636+ 8059                  ; E = ItemLeft
1637+ 8059                  ; D = ItemRight
1638+ 8059                  ; ---------------------------------------------------------------
1639+ 8059 6F               ld   l, a              ; L = ItemX
1640+ 805A
1641+ 805A 7D               ld   a, l
1642+ 805B 87               add  a, a              ; *2
1643+ 805C 87               add  a, a              ; *4
1644+ 805D 87               add  a, a              ; *8
1645+ 805E
1646+ 805E 5F               ld   e, a              ; E = ItemLeft
