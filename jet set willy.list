 314+ 7462              ; -------------------------------------------------------------------
 315+ 7462              ; Controlla se Willy collide con un item (pixel-level check)
 316+ 7462              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 317+ 7462              ; Output: Carry set se collide, altrimenti clear
 318+ 7462              ; -------------------------------------------------------------------
 319+ 7462              CheckWillyItemCollision:
 320+ 7462 C5               push bc
 321+ 7463 D5               push de
 322+ 7464 E5               push hl
 323+ 7465
 324+ 7465                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 325+ 7465 6F               ld   l, a
 326+ 7466 7D               ld   a, l
 327+ 7467 87               add  a, a              ; *2
 328+ 7468 87               add  a, a              ; *4
 329+ 7469 87               add  a, a              ; *8
 330+ 746A 5F               ld   e, a              ; E = ItemLeft
 331+ 746B C6 07            add  a, 7
 332+ 746D 57               ld   d, a              ; D = ItemRight
 333+ 746E
 334+ 746E                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 335+ 746E ED 4B A5 75      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 336+ 7472
 337+ 7472                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 338+ 7472 79               ld   a, c
 339+ 7473 BA               cp   d
 340+ 7474 28 04            jr   z, .x_ok
 341+ 7476 38 02            jr   c, .x_ok
 342+ 7478 18 29            jr   .no_collision
 343+ 747A              .x_ok:
 344+ 747A C6 0F            add  a, 15
 345+ 747C BB               cp   e
 346+ 747D 28 04            jr   z, .y_check
 347+ 747F 30 02            jr   nc, .y_check
 348+ 7481 18 20            jr   .no_collision
 349+ 7483
 350+ 7483              .y_check:
 351+ 7483 E1               pop  hl                ; Recupera HL originale (H = ItemY)
 352+ 7484 E5               push hl
 353+ 7485 7C               ld   a, h
 354+ 7486 87               add  a, a              ; *2
 355+ 7487 87               add  a, a              ; *4
 356+ 7488 87               add  a, a              ; *8
 357+ 7489 5F               ld   e, a              ; E = ItemTop
 358+ 748A C6 07            add  a, 7
 359+ 748C 57               ld   d, a              ; D = ItemBottom
 360+ 748D
 361+ 748D                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 362+ 748D 78               ld   a, b
 363+ 748E BA               cp   d
 364+ 748F 28 04            jr   z, .y_ok
 365+ 7491 38 02            jr   c, .y_ok
 366+ 7493 18 0E            jr   .no_collision
 367+ 7495              .y_ok:
 368+ 7495 C6 0F            add  a, 15
 369+ 7497 BB               cp   e
 370+ 7498 28 04            jr   z, .collision
 371+ 749A 30 02            jr   nc, .collision
 372+ 749C 18 05            jr   .no_collision
 373+ 749E
 374+ 749E              .collision:
 375+ 749E E1               pop  hl
 376+ 749F D1               pop  de
 377+ 74A0 C1               pop  bc
 378+ 74A1 37               scf                    ; Set carry (collisione!)
 379+ 74A2 C9               ret
 380+ 74A3
 381+ 74A3              .no_collision:
 382+ 74A3 E1               pop  hl
 383+ 74A4 D1               pop  de
 384+ 74A5 C1               pop  bc
 385+ 74A6 B7               or   a                 ; Clear carry
 386+ 74A7 C9               ret
 387+ 74A8
 388+ 74A8              ; -------------------------------------------------------------------
 389+ 74A8              ; Controlla se Willy tocca un item attivo nella stanza corrente
 390+ 74A8              ; -------------------------------------------------------------------
 391+ 74A8              CheckRoomItemsCollision:
 392+ 74A8 E5               push hl
 393+ 74A9 D5               push de
 394+ 74AA C5               push bc
 395+ 74AB
 396+ 74AB 21 EC 72         ld   hl, ItemsTable
 397+ 74AE              .loop:
 398+ 74AE 7E               ld   a, (hl)           ; A = Room ID
 399+ 74AF FE FF            cp   $FF               ; Fine tabella?
 400+ 74B1 28 2B            jr   z, .done
 401+ 74B3
 402+ 74B3                  ; Stanza corrente?
 403+ 74B3 57               ld   d, a              ; D = Room ID
 404+ 74B4 3A B7 78         ld   a, (current_room)
 405+ 74B7 BA               cp   d
 406+ 74B8 20 1D            jr   nz, .next_item
 407+ 74BA
 408+ 74BA 23               inc  hl                ; HL punta a X
 409+ 74BB 4E               ld   c, (hl)           ; C = X
 410+ 74BC 23               inc  hl                ; HL punta a Y
 411+ 74BD 46               ld   b, (hl)           ; B = Y
 412+ 74BE 23               inc  hl                ; HL punta al colore (lo saltiamo per il controllo collisione)
 413+ 74BF 23               inc  hl                ; HL punta a collected
 414+ 74C0 7E               ld   a, (hl)           ; A = collected
 415+ 74C1 B7               or   a
 416+ 74C2 20 17            jr   nz, .next_no_inc  ; Già raccolto, salta
 417+ 74C4
 418+ 74C4                  ; Controlla collisione
 419+ 74C4 79               ld   a, c
 420+ 74C5 60               ld   h, b
 421+ 74C6 CD 62 74         call CheckWillyItemCollision
 422+ 74C9 30 10            jr   nc, .next_no_inc
 423+ 74CB
 424+ 74CB                  ; RACCOLTO!
 425+ 74CB 36 01            ld   (hl), 1           ; Imposta collected = 1
 426+ 74CD
 427+ 74CD E5               push hl
 428+ 74CE
 429+ 74CE                  ; Cancella item dallo schermo
 430+ 74CE CD 1E 74         call RestoreBackgroundCell
 431+ 74D1
 432+ 74D1                  ; Suono di raccolta
 433+ 74D1 CD E2 74         call PlayCollectSound
 434+ 74D4
 435+ 74D4 E1               pop  hl
 436+ 74D5
 437+ 74D5 18 04            jr   .next_no_inc
 438+ 74D7
 439+ 74D7              .next_item:
 440+ 74D7 23               inc  hl                ; salta X
 441+ 74D8 23               inc  hl                ; salta Y
 442+ 74D9 23               inc  hl                ; salta colore
 443+ 74DA 23               inc  hl                ; salta collected
 444+ 74DB              .next_no_inc:
 445+ 74DB 23               inc  hl                ; vai al prossimo item
 446+ 74DC 18 D0            jr   .loop
 447+ 74DE
 448+ 74DE              .done:
 449+ 74DE C1               pop  bc
 450+ 74DF D1               pop  de
 451+ 74E0 E1               pop  hl
 452+ 74E1 C9               ret
 453+ 74E2
 454+ 74E2              ; -------------------------------------------------------------------
 455+ 74E2              ; Riproduce un breve segnale acustico all'altoparlante
 456+ 74E2              ; -------------------------------------------------------------------
 457+ 74E2              PlayCollectSound:
 458+ 74E2 C5               push bc
 459+ 74E3 D5               push de
 460+ 74E4
 461+ 74E4 06 78            ld   b, 120            ; Cicli della nota
 462+ 74E6              .sound_loop:
 463+ 74E6 3A B0 75         ld   a, (room_border_color)
 464+ 74E9 F6 10            or   $10               ; Speaker ON (bit 4 = 1)
 465+ 74EB D3 FE            out  ($fe), a
 466+ 74ED 0E 3C            ld   c, 60             ; Mezzo periodo delay
 467+ 74EF 0D           .d1: dec  c
 468+ 74F0 20 FD            jr   nz, .d1
 469+ 74F2
 470+ 74F2 3A B0 75         ld   a, (room_border_color)
 471+ 74F5 E6 EF            and  $ef               ; Speaker OFF (bit 4 = 0)
 472+ 74F7 D3 FE            out  ($fe), a
 473+ 74F9 0E 3C            ld   c, 60             ; Mezzo periodo delay
 474+ 74FB 0D           .d2: dec  c
 475+ 74FC 20 FD            jr   nz, .d2
 476+ 74FE
 477+ 74FE 10 E6            djnz .sound_loop
 478+ 7500
 479+ 7500 D1               pop  de
 480+ 7501 C1               pop  bc
 481+ 7502 C9               ret
