 208+ 6CEE              .check_landing:
 209+ 6CEE                  ; Abbiamo toccato una cella solida!
 210+ 6CEE 78               ld   a, b
 211+ 6CEF D6 18            sub  24
 212+ 6CF1 CB 3F            srl  a
 213+ 6CF3 CB 3F            srl  a
 214+ 6CF5 CB 3F            srl  a                 ; A = r (0..15)
 215+ 6CF7
 216+ 6CF7                  ; Controlliamo se Vecchio Y + 16 <= r * 8 + 24
 217+ 6CF7 5F               ld   e, a              ; E = r
 218+ 6CF8 87               add  a, a              ; *2
