 239+ 89BE              ; -------------------------------------------------------------------
 240+ 89BE              ; Audio_PlayGameOverFootSound
 241+ 89BE              ;
 242+ 89BE              ; Genera l'effetto sonoro originale a frequenza crescente durante la
 243+ 89BE              ; discesa del Piede nella schermata di Game Over (come in music/game-over.ogg).
 244+ 89BE              ; Input: B = coordinata Y del Piede (0..96)
 245+ 89BE              ; -------------------------------------------------------------------
 246+ 89BE              Audio_PlayGameOverFootSound:
 247+ 89BE F5               push af
 248+ 89BF C5               push bc
 249+ 89C0 D5               push de
 250+ 89C1
 251+ 89C1                  ; Calcola il ritardo del semionda E = 255 - (2 * Y)
 252+ 89C1 78               ld   a, b                  ; A = Y (0..96)
 253+ 89C2 87               add  a, a                  ; A = 2 * Y (0..192)
 254+ 89C3 2F               cpl                        ; A = 255 - (2 * Y) -> da 255 (tono grave) a 63 (tono acuto)
 255+ 89C4 5F               ld   e, a                  ; E = periodo delay semionda
 256+ 89C5
 257+ 89C5 AF               xor  a                     ; A = 0 (bordo nero, speaker low)
 258+ 89C6 0E 40            ld   c, 64                 ; C = 64 semicicli di commutazione beeper
 259+ 89C8
 260+ 89C8              .sound_loop:
 261+ 89C8 D3 FE            out  ($fe), a              ; Output beeper
 262+ 89CA EE 18            xor  $18                   ; Toggle EAR (bit 4) e MIC (bit 3)
 263+ 89CC 43               ld   b, e                  ; B = delay semionda
 264+ 89CD              .d1:
 265+ 89CD 10 FE            djnz .d1
 266+ 89CF 0D               dec  c
 267+ 89D0 20 F6            jr   nz, .sound_loop
 268+ 89D2
 269+ 89D2                  ; Spegne lo speaker
 270+ 89D2 AF               xor  a
 271+ 89D3 D3 FE            out  ($fe), a
 272+ 89D5
 273+ 89D5 D1               pop  de
 274+ 89D6 C1               pop  bc
 275+ 89D7 F1               pop  af
 276+ 89D8 C9               ret
 277+ 89D9                  ELSE
 278+ 89D9 ~            Audio_UpdateMusic:
 279+ 89D9 ~                ret
 280+ 89D9 ~            Audio_PlayTitleNote:
 281+ 89D9 ~                or   1
 282+ 89D9 ~                ret
 283+ 89D9 ~            Audio_PlayGameOverFootSound:
 284+ 89D9 ~                halt
 285+ 89D9 ~                ret
 286+ 89D9                  ENDIF
 287+ 89D9
 288+ 89D9              ; -------------------------------------------------------------------
 289+ 89D9              ; Audio_PlayCollectSound
 290+ 89D9              ;
 291+ 89D9              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 292+ 89D9              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 293+ 89D9              ; -------------------------------------------------------------------
 294+ 89D9              Audio_PlayCollectSound:
 295+ 89D9 C5               push bc
 296+ 89DA D5               push de
 297+ 89DB
 298+ 89DB 06 78            ld   b, 120
 299+ 89DD              .sound_loop:
 300+ 89DD 3A 11 F8         ld   a, (room_border_color)
 301+ 89E0 F6 10            or   $10               ; speaker ON
 302+ 89E2 D3 FE            out  ($fe), a
 303+ 89E4
 304+ 89E4 0E 3C            ld   c, 60
 305+ 89E6              .d1:
 306+ 89E6 0D               dec  c
 307+ 89E7 20 FD            jr   nz, .d1
 308+ 89E9
 309+ 89E9 3A 11 F8         ld   a, (room_border_color)
 310+ 89EC E6 EF            and  $ef              ; speaker OFF
 311+ 89EE D3 FE            out  ($fe), a
 312+ 89F0
 313+ 89F0 0E 3C            ld   c, 60
 314+ 89F2              .d2:
 315+ 89F2 0D               dec  c
 316+ 89F3 20 FD            jr   nz, .d2
 317+ 89F5
 318+ 89F5 10 E6            djnz .sound_loop
 319+ 89F7
 320+ 89F7 D1               pop  de
 321+ 89F8 C1               pop  bc
 322+ 89F9 C9               ret
 323+ 89FA
