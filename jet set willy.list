 457  8772 CD 72 6B         call InitRoomEntryPositions
 458  8775
 459  8775                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 460  8775 3E 07            ld   a, 7
 461  8777 32 26 EE         ld   (time_hours), a
 462  877A AF               xor  a
 463  877B 32 27 EE         ld   (time_minutes), a
 464  877E 32 28 EE         ld   (time_period), a       ; 0 = AM
 465  8781 32 2B EE         ld   (game_objective_completed), a
 466  8784 2A 3A EA         ld   hl, (counter)
 467  8787 22 29 EE         ld   (time_last_counter), hl
 468  878A CD 26 66         call Gfx_UpdateTimeDisplay
 469  878D
 470  878D                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 471  878D 21 D1 AC         ld   hl, TheBathroomLayout; TheOffLicenceLayout
 472  8790 22 99 ED         ld   (room_ptr), hl
 473  8793
 474  8793 C9               ret
 475  8794
 476  8794              ; -------------------------------------------------------------------
 477  8794              ; Time_UpdateClock
 478  8794              ; Gestisce lo scorrimento del tempo durante il gioco.
 479  8794              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 480  8794              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 481  8794              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 482  8794              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 483  8794              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 484  8794              ; sia completato, scatena immediatamente il Game Over.
 485  8794              ; -------------------------------------------------------------------
 486  8794              Time_UpdateClock:
 487  8794                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 488  8794 2A 3A EA         ld   hl, (counter)
 489  8797 ED 5B 29 EE      ld   de, (time_last_counter)
 490  879B B7               or   a
 491  879C ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 492  879E
 493  879E                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 494  879E 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 495  87A1 B7               or   a
 496  87A2 ED 52            sbc  hl, de
 497  87A4 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 498  87A5
 499  87A5                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 500  87A5 2A 29 EE         ld   hl, (time_last_counter)
 501  87A8 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 502  87AB 19               add  hl, de
 503  87AC 22 29 EE         ld   (time_last_counter), hl
 504  87AF
 505  87AF                  ; Incrementa di 1 minuto il tempo di gioco
 506  87AF 3A 27 EE         ld   a, (time_minutes)
 507  87B2 3C               inc  a
 508  87B3 FE 3C            cp   60
 509  87B5 38 21            jr   c, .minutes_ok
 510  87B7
 511  87B7                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 512  87B7 AF               xor  a
 513  87B8 32 27 EE         ld   (time_minutes), a
 514  87BB 3A 26 EE         ld   a, (time_hours)
 515  87BE 3C               inc  a
 516  87BF FE 0C            cp   12
 517  87C1 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 518  87C3 FE 0D            cp   13
 519  87C5 38 0E            jr   c, .hours_ok
 520  87C7 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 521  87C9 18 0A            jr   .hours_ok
 522  87CB
 523  87CB              .toggle_period:
 524  87CB F5               push af                     ; Salva A (valore 12)
 525  87CC 3A 28 EE         ld   a, (time_period)
 526  87CF EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 527  87D1 32 28 EE         ld   (time_period), a
 528  87D4 F1               pop  af                     ; Ripristina A = 12
 529  87D5
 530  87D5              .hours_ok:
 531  87D5 32 26 EE         ld   (time_hours), a
 532  87D8
 533  87D8              .minutes_ok:
 534  87D8 32 27 EE         ld   (time_minutes), a
 535  87DB
 536  87DB                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 537  87DB CD 26 66         call Gfx_UpdateTimeDisplay
 538  87DE
 539  87DE                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 540  87DE 3A 2B EE         ld   a, (game_objective_completed)
 541  87E1 B7               or   a
 542  87E2 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 543  87E3
 544  87E3                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 545  87E3 3A 28 EE         ld   a, (time_period)
 546  87E6 B7               or   a
 547  87E7 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 548  87E8
 549  87E8 3A 26 EE         ld   a, (time_hours)
 550  87EB FE 0C            cp   12
 551  87ED 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
 552  87EF C9               ret
 553  87F0
 554  87F0              .time_limit_reached:
 555  87F0                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
 556  87F0                  ; Scatena immediatamente il Game Over temporale!
 557  87F0 C3 E0 86         jp   TriggerGameOver
