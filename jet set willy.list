 276+ 6CFC
 277+ 6CFC              ; -------------------------------------------------------------------
 278+ 6CFC              ; DrawRoomItems
 279+ 6CFC              ;
 280+ 6CFC              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 281+ 6CFC              ;
 282+ 6CFC              ; Operazioni eseguite:
 283+ 6CFC              ;   1. Azzera la griglia items_grid.
 284+ 6CFC              ;   2. Svuota la cache degli oggetti attivi.
 285+ 6CFC              ;   3. Scansiona ItemsTable.
 286+ 6CFC              ;   4. Per ogni item della stanza corrente:
 287+ 6CFC              ;        - verifica se è già stato raccolto
 288+ 6CFC              ;        - disegna la grafica
 289+ 6CFC              ;        - aggiorna items_grid
 290+ 6CFC              ;        - memorizza l'item nella cache current_room_items
 291+ 6CFC              ;   5. Aggiorna num_room_items.
 292+ 6CFC              ;
 293+ 6CFC              ; Record ItemsTable:
 294+ 6CFC              ;   +0  Room ID
 295+ 6CFC              ;   +1  X (colonna)
 296+ 6CFC              ;   +2  Y (riga)
 297+ 6CFC              ;   +3  Colore
 298+ 6CFC              ;   +4  Collected flag
 299+ 6CFC              ;
 300+ 6CFC              ; Cache current_room_items:
 301+ 6CFC              ;   +0  Colonna
 302+ 6CFC              ;   +1  Riga
 303+ 6CFC              ;   +2  Colore
 304+ 6CFC              ;   +3  Collected flag ptr (Low)
 305+ 6CFC              ;   +4  Collected flag ptr (High)
 306+ 6CFC              ;
 307+ 6CFC              ; Ogni record cache occupa 5 byte.
 308+ 6CFC              ; -------------------------------------------------------------------
 309+ 6CFC              DrawRoomItems:
 310+ 6CFC
 311+ 6CFC                  ; Salva tutti i registri utilizzati
 312+ 6CFC E5               push hl
 313+ 6CFD D5               push de
 314+ 6CFE C5               push bc
 315+ 6CFF DD E5            push ix
 316+ 6D01 FD E5            push iy
 317+ 6D03
 318+ 6D03                  ; ---------------------------------------------------------------
 319+ 6D03                  ; Azzera items_grid (32 x 16 = 512 byte)
 320+ 6D03                  ; ---------------------------------------------------------------
 321+ 6D03 21 00 90         ld   hl, items_grid
 322+ 6D06 11 01 90         ld   de, items_grid + 1
 323+ 6D09 36 00            ld   (hl), 0
 324+ 6D0B 01 FF 01         ld   bc, 511
 325+ 6D0E ED B0            ldir
 326+ 6D10
 327+ 6D10                  ; ---------------------------------------------------------------
 328+ 6D10                  ; Nessun item attivo nella stanza
 329+ 6D10                  ; ---------------------------------------------------------------
 330+ 6D10 AF               xor  a
 331+ 6D11 32 8D 7E         ld   (num_room_items), a
 332+ 6D14
 333+ 6D14                  ; IY punta alla cache degli item attivi
 334+ 6D14 FD 21 3D 7E      ld   iy, current_room_items
 335+ 6D18
 336+ 6D18                  ; ---------------------------------------------------------------
 337+ 6D18                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 338+ 6D18                  ; alla stanza corrente.
 339+ 6D18                  ;
 340+ 6D18                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 341+ 6D18                  ; ---------------------------------------------------------------
 342+ 6D18 2A 8E 7E         ld   hl, (room_ptr)
 343+ 6D1B 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 344+ 6D1E 19               add  hl, de
 345+ 6D1F
 346+ 6D1F E5               push hl
 347+ 6D20 DD E1            pop  ix                ; IX = bitmap item
 348+ 6D22
 349+ 6D22                  ; ---------------------------------------------------------------
 350+ 6D22                  ; Inizio scansione della tabella degli item
 351+ 6D22                  ; ---------------------------------------------------------------
 352+ 6D22 21 DC 6B         ld   hl, ItemsTable
 353+ 6D25
 354+ 6D25              .loop:
 355+ 6D25
 356+ 6D25                  ; ---------------------------------------------------------------
 357+ 6D25                  ; Legge il Room ID del record corrente
 358+ 6D25                  ; ---------------------------------------------------------------
 359+ 6D25 7E               ld   a, (hl)
 360+ 6D26
 361+ 6D26                  ; $FF indica fine tabella
 362+ 6D26 FE FF            cp   $FF
 363+ 6D28 28 53            jr   z, .done
 364+ 6D2A
 365+ 6D2A                  ; ---------------------------------------------------------------
 366+ 6D2A                  ; Verifica se l'item appartiene alla stanza corrente
 367+ 6D2A                  ; ---------------------------------------------------------------
 368+ 6D2A 57               ld   d, a
 369+ 6D2B
 370+ 6D2B 3A 34 7E         ld   a, (current_room)
 371+ 6D2E BA               cp   d
 372+ 6D2F 20 45            jr   nz, .next_item
 373+ 6D31
 374+ 6D31                  ; ---------------------------------------------------------------
 375+ 6D31                  ; Legge i dati dell'item
 376+ 6D31                  ; ---------------------------------------------------------------
 377+ 6D31
 378+ 6D31 23               inc  hl
 379+ 6D32 4E               ld   c, (hl)           ; X (colonna)
 380+ 6D33
 381+ 6D33 23               inc  hl
 382+ 6D34 46               ld   b, (hl)           ; Y (riga)
 383+ 6D35
 384+ 6D35 23               inc  hl
 385+ 6D36 5E               ld   e, (hl)           ; Colore
 386+ 6D37
 387+ 6D37 23               inc  hl
 388+ 6D38 7E               ld   a, (hl)           ; Collected flag
 389+ 6D39
 390+ 6D39                  ; Se diverso da zero l'item è già stato raccolto
 391+ 6D39 B7               or   a
 392+ 6D3A 20 3E            jr   nz, .next_no_inc
 393+ 6D3C
 394+ 6D3C                  ; ---------------------------------------------------------------
 395+ 6D3C                  ; Disegna l'item sullo schermo
 396+ 6D3C                  ;
 397+ 6D3C                  ; B = Row
 398+ 6D3C                  ; C = Column
 399+ 6D3C                  ; HL = bitmap pointer
 400+ 6D3C                  ; E = Color
 401+ 6D3C                  ; ---------------------------------------------------------------
 402+ 6D3C E5               push hl
 403+ 6D3D
 404+ 6D3D DD E5            push ix
 405+ 6D3F E1               pop  hl
 406+ 6D40
 407+ 6D40 CD 85 6D         call DrawItemGraphic
 408+ 6D43
 409+ 6D43 E1               pop  hl                ; ritorna al flag collected
 410+ 6D44
 411+ 6D44                  ; ---------------------------------------------------------------
 412+ 6D44                  ; Aggiorna items_grid
 413+ 6D44                  ;
 414+ 6D44                  ; Calcolo:
 415+ 6D44                  ;   offset = Row * 32 + Col
 416+ 6D44                  ; ---------------------------------------------------------------
 417+ 6D44 E5               push hl
 418+ 6D45 D5               push de
 419+ 6D46
 420+ 6D46 26 00            ld   h, 0
 421+ 6D48 68               ld   l, b              ; HL = Row
 422+ 6D49
 423+ 6D49 29               add  hl, hl            ; *2
 424+ 6D4A 29               add  hl, hl            ; *4
 425+ 6D4B 29               add  hl, hl            ; *8
 426+ 6D4C 29               add  hl, hl            ; *16
 427+ 6D4D 29               add  hl, hl            ; *32
 428+ 6D4E
 429+ 6D4E 16 00            ld   d, 0
 430+ 6D50 59               ld   e, c              ; DE = Col
 431+ 6D51
 432+ 6D51 19               add  hl, de            ; Row*32 + Col
 433+ 6D52
 434+ 6D52 11 00 90         ld   de, items_grid
 435+ 6D55 19               add  hl, de            ; puntatore nella griglia
 436+ 6D56
 437+ 6D56 D1               pop  de                ; ripristina colore
 438+ 6D57
 439+ 6D57 73               ld   (hl), e           ; salva colore cella
 440+ 6D58
 441+ 6D58 E1               pop  hl
 442+ 6D59
 443+ 6D59                  ; ---------------------------------------------------------------
 444+ 6D59                  ; Salva l'item nella cache della stanza
 445+ 6D59                  ;
 446+ 6D59                  ; Questo evita di dover scansionare tutta ItemsTable
 447+ 6D59                  ; durante il controllo delle collisioni.
 448+ 6D59                  ; ---------------------------------------------------------------
 449+ 6D59
 450+ 6D59 FD 71 00         ld   (iy+0), c         ; Colonna
 451+ 6D5C FD 70 01         ld   (iy+1), b         ; Riga
 452+ 6D5F FD 73 02         ld   (iy+2), e         ; Colore
 453+ 6D62
 454+ 6D62                  ; Salva il puntatore al flag "collected"
 455+ 6D62 FD 75 03         ld   (iy+3), l         ; Low byte
 456+ 6D65 FD 74 04         ld   (iy+4), h         ; High byte
 457+ 6D68
 458+ 6D68                  ; Passa al record successivo della cache
 459+ 6D68 01 05 00         ld   bc, 5
 460+ 6D6B FD 09            add  iy, bc
 461+ 6D6D
 462+ 6D6D                  ; Incrementa il numero di item attivi
 463+ 6D6D 3A 8D 7E         ld   a, (num_room_items)
 464+ 6D70 3C               inc  a
 465+ 6D71 32 8D 7E         ld   (num_room_items), a
 466+ 6D74
 467+ 6D74 18 04            jr   .next_no_inc
 468+ 6D76
 469+ 6D76              .next_item:
 470+ 6D76
 471+ 6D76                  ; ---------------------------------------------------------------
 472+ 6D76                  ; L'item non appartiene alla stanza corrente.
 473+ 6D76                  ; Salta i campi del record:
 474+ 6D76                  ;   X
 475+ 6D76                  ;   Y
 476+ 6D76                  ;   Color
 477+ 6D76                  ;   Collected
 478+ 6D76                  ; ---------------------------------------------------------------
 479+ 6D76 23               inc  hl
 480+ 6D77 23               inc  hl
 481+ 6D78 23               inc  hl
 482+ 6D79 23               inc  hl
 483+ 6D7A
 484+ 6D7A              .next_no_inc:
 485+ 6D7A
 486+ 6D7A                  ; ---------------------------------------------------------------
 487+ 6D7A                  ; Avanza al record successivo
 488+ 6D7A                  ; (prossimo Room ID)
 489+ 6D7A                  ; ---------------------------------------------------------------
 490+ 6D7A 23               inc  hl
 491+ 6D7B 18 A8            jr   .loop
 492+ 6D7D
 493+ 6D7D              .done:
 494+ 6D7D
 495+ 6D7D                  ; Ripristina i registri
 496+ 6D7D FD E1            pop  iy
 497+ 6D7F DD E1            pop  ix
 498+ 6D81 D1               pop  de
 499+ 6D82 C1               pop  bc
 500+ 6D83 E1               pop  hl
 501+ 6D84
 502+ 6D84 C9               ret
 503+ 6D85
 504+ 6D85              ; -------------------------------------------------------------------
 505+ 6D85              ; DrawItemGraphic
 506+ 6D85              ;
 507+ 6D85              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 508+ 6D85              ; utilizzando una bitmap di 8 byte e un attributo colore.
 509+ 6D85              ;
 510+ 6D85              ; Input:
 511+ 6D85              ;   B = Riga attributi (3..18)
 512+ 6D85              ;   C = Colonna attributi (0..31)
 513+ 6D85              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 514+ 6D85              ;   E = Attributo colore
 515+ 6D85              ;
 516+ 6D85              ; Output:
 517+ 6D85              ;   Nessuno
 518+ 6D85              ;
 519+ 6D85              ; Registri preservati:
 520+ 6D85              ;   BC, DE, HL
 521+ 6D85              ; -------------------------------------------------------------------
 522+ 6D85              DrawItemGraphic:
 523+ 6D85
 524+ 6D85                  ; Salva i registri originali
 525+ 6D85 C5               push bc
 526+ 6D86 D5               push de
 527+ 6D87 E5               push hl
 528+ 6D88
 529+ 6D88                  ; ---------------------------------------------------------------
 530+ 6D88                  ; Calcolo indirizzo bitmap dello Spectrum
 531+ 6D88                  ;
 532+ 6D88                  ; Ogni item occupa una cella attributi (8x8 pixel).
 533+ 6D88                  ;
 534+ 6D88                  ; Formula:
 535+ 6D88                  ;   High = $40 + (Row AND $18)
 536+ 6D88                  ;   Low  = (Row AND 7) * 32 + Col
 537+ 6D88                  ;
 538+ 6D88                  ; DE conterrà l'indirizzo della prima scanline.
 539+ 6D88                  ; ---------------------------------------------------------------
 540+ 6D88
 541+ 6D88 78               ld   a, b
 542+ 6D89 E6 18            and  $18
 543+ 6D8B C6 40            add  a, $40
 544+ 6D8D 57               ld   d, a              ; Byte alto indirizzo video
 545+ 6D8E
 546+ 6D8E 78               ld   a, b
 547+ 6D8F E6 07            and  7                 ; Riga interna al blocco da 8
 548+ 6D91
 549+ 6D91 87               add  a, a              ; *2
 550+ 6D92 87               add  a, a              ; *4
 551+ 6D93 87               add  a, a              ; *8
 552+ 6D94 87               add  a, a              ; *16
 553+ 6D95 87               add  a, a              ; *32
 554+ 6D96
 555+ 6D96 81               add  a, c              ; + colonna
 556+ 6D97
 557+ 6D97 5F               ld   e, a              ; Byte basso indirizzo video
 558+ 6D98
 559+ 6D98                  ; ---------------------------------------------------------------
 560+ 6D98                  ; Disegno bitmap
 561+ 6D98                  ;
 562+ 6D98                  ; Copia 8 byte consecutivi nella memoria video.
 563+ 6D98                  ; Ogni byte rappresenta una scanline da 8 pixel.
 564+ 6D98                  ; ---------------------------------------------------------------
 565+ 6D98
 566+ 6D98 C5               push bc                ; Conserva Row e Col
 567+ 6D99
 568+ 6D99 06 08            ld   b, 8              ; Numero scanline
 569+ 6D9B
 570+ 6D9B              .line_loop:
 571+ 6D9B
 572+ 6D9B 7E               ld   a, (hl)           ; Legge scanline bitmap
 573+ 6D9C 12               ld   (de), a           ; Scrive nella memoria video
 574+ 6D9D
 575+ 6D9D 14               inc  d                 ; Scanline successiva
 576+ 6D9E 23               inc  hl                ; Byte bitmap successivo
 577+ 6D9F
 578+ 6D9F 05               dec  b
 579+ 6DA0 20 F9            jr   nz, .line_loop
 580+ 6DA2
 581+ 6DA2 C1               pop  bc                ; Ripristina Row e Col
 582+ 6DA3
 583+ 6DA3                  ; ---------------------------------------------------------------
 584+ 6DA3                  ; Calcolo indirizzo attributo
 585+ 6DA3                  ;
 586+ 6DA3                  ; Formula:
 587+ 6DA3                  ;   AttrAddr = $5800 + Row * 32 + Col
 588+ 6DA3                  ;
 589+ 6DA3                  ; HL conterrà l'indirizzo della cella attributi.
 590+ 6DA3                  ; ---------------------------------------------------------------
 591+ 6DA3
 592+ 6DA3 26 00            ld   h, 0
 593+ 6DA5 68               ld   l, b              ; HL = Row
 594+ 6DA6
 595+ 6DA6 29               add  hl, hl            ; *2
 596+ 6DA7 29               add  hl, hl            ; *4
 597+ 6DA8 29               add  hl, hl            ; *8
 598+ 6DA9 29               add  hl, hl            ; *16
 599+ 6DAA 29               add  hl, hl            ; *32
 600+ 6DAB
 601+ 6DAB 79               ld   a, c              ; A = Colonna
 602+ 6DAC
 603+ 6DAC 85               add  a, l
 604+ 6DAD 6F               ld   l, a
 605+ 6DAE
 606+ 6DAE 30 01            jr   nc, .no_carry
 607+ 6DB0 24               inc  h
 608+ 6DB1
 609+ 6DB1              .no_carry:
 610+ 6DB1
 611+ 6DB1                  ; HL = Row * 32 + Col
 612+ 6DB1
 613+ 6DB1 11 00 58         ld   de, $5800
 614+ 6DB4 19               add  hl, de            ; HL = indirizzo attributi
 615+ 6DB5
 616+ 6DB5                  ; ---------------------------------------------------------------
 617+ 6DB5                  ; Recupera il colore originale dallo stack.
 618+ 6DB5                  ;
 619+ 6DB5                  ; Layout stack:
 620+ 6DB5                  ;   HL originale
 621+ 6DB5                  ;   DE originale (E = colore)
 622+ 6DB5                  ;   BC originale
 623+ 6DB5                  ; ---------------------------------------------------------------
 624+ 6DB5
 625+ 6DB5 C1               pop  bc                ; Recupera HL originale
 626+ 6DB6 D1               pop  de                ; Recupera DE originale
 627+ 6DB7
 628+ 6DB7                  ; ---------------------------------------------------------------
 629+ 6DB7                  ; Scrive l'attributo colore
 630+ 6DB7                  ; ---------------------------------------------------------------
 631+ 6DB7
 632+ 6DB7 7B               ld   a, e              ; A = colore
 633+ 6DB8 77               ld   (hl), a           ; Scrive nella RAM attributi
 634+ 6DB9
 635+ 6DB9                  ; ---------------------------------------------------------------
 636+ 6DB9                  ; Ripristina HL e BC originali
 637+ 6DB9                  ; ---------------------------------------------------------------
 638+ 6DB9
 639+ 6DB9 C5               push bc
 640+ 6DBA E1               pop  hl                ; HL originale
 641+ 6DBB
 642+ 6DBB C1               pop  bc                ; BC originale
 643+ 6DBC
 644+ 6DBC C9               ret
 645+ 6DBD
 646+ 6DBD              ; -------------------------------------------------------------------
 647+ 6DBD              ; RestoreBackgroundCell
 648+ 6DBD              ;
 649+ 6DBD              ; Ripristina il contenuto originale di una cella della stanza.
 650+ 6DBD              ; Viene utilizzata principalmente quando un item viene raccolto:
 651+ 6DBD              ; invece di lasciare un "buco", la routine ridisegna il tile
 652+ 6DBD              ; originale presente nella mappa della stanza.
 653+ 6DBD              ;
 654+ 6DBD              ; Input:
 655+ 6DBD              ;   B = Row (3..18)
 656+ 6DBD              ;   C = Col (0..31)
 657+ 6DBD              ;
 658+ 6DBD              ; Utilizza:
 659+ 6DBD              ;   room_ptr -> struttura dati della stanza corrente
 660+ 6DBD              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 661+ 6DBD              ;   DrawTile -> ridisegna il tile selezionato
 662+ 6DBD              ;
 663+ 6DBD              ; Tipi di cella:
 664+ 6DBD              ;   0 = Background
 665+ 6DBD              ;   1 = Floor
 666+ 6DBD              ;   2 = Wall
 667+ 6DBD              ;   3 = Nasty
 668+ 6DBD              ; -------------------------------------------------------------------
 669+ 6DBD              RestoreBackgroundCell:
 670+ 6DBD
 671+ 6DBD                  ; Salva tutti i registri utilizzati
 672+ 6DBD FD E5            push iy
 673+ 6DBF C5               push bc
 674+ 6DC0 D5               push de
 675+ 6DC1 E5               push hl
 676+ 6DC2 DD E5            push ix
 677+ 6DC4
 678+ 6DC4                  ; ---------------------------------------------------------------
 679+ 6DC4                  ; Conserva Row e Col in IY.
 680+ 6DC4                  ;
 681+ 6DC4                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 682+ 6DC4                  ; BC potrebbe essere modificato.
 683+ 6DC4                  ; ---------------------------------------------------------------
 684+ 6DC4 C5               push bc
 685+ 6DC5 FD E1            pop  iy                ; IYH = Row, IYL = Col
 686+ 6DC7
 687+ 6DC7                  ; ---------------------------------------------------------------
 688+ 6DC7                  ; Determina quale tipo di cella è presente nella posizione
 689+ 6DC7                  ; specificata.
 690+ 6DC7                  ;
 691+ 6DC7                  ; Input:
 692+ 6DC7                  ;   B = Row
 693+ 6DC7                  ;   C = Col
 694+ 6DC7                  ;
 695+ 6DC7                  ; Output:
 696+ 6DC7                  ;   A = tipo cella
 697+ 6DC7                  ; ---------------------------------------------------------------
 698+ 6DC7 78               ld   a, b
 699+ 6DC8
 700+ 6DC8 CD B4 68         call GetCellFromUnpacked
 701+ 6DCB
 702+ 6DCB                  ; ---------------------------------------------------------------
 703+ 6DCB                  ; Recupera il puntatore alla stanza corrente.
 704+ 6DCB                  ;
 705+ 6DCB                  ; DE = base della struttura stanza
 706+ 6DCB                  ; ---------------------------------------------------------------
 707+ 6DCB ED 5B 8E 7E      ld   de, (room_ptr)
 708+ 6DCF
 709+ 6DCF                  ; ---------------------------------------------------------------
 710+ 6DCF                  ; Seleziona il tile corretto in base al tipo di cella.
 711+ 6DCF                  ;
 712+ 6DCF                  ; A = 0 -> Background
 713+ 6DCF                  ; A = 1 -> Floor
 714+ 6DCF                  ; A = 2 -> Wall
 715+ 6DCF                  ; A = 3 -> Nasty
 716+ 6DCF                  ; ---------------------------------------------------------------
 717+ 6DCF
 718+ 6DCF B7               or   a
 719+ 6DD0 20 06            jr   nz, .not_bg
 720+ 6DD2
 721+ 6DD2                  ; Background
 722+ 6DD2 21 A0 00         ld   hl, OFFSET_BG
 723+ 6DD5 19               add  hl, de
 724+ 6DD6 18 16            jr   .draw_cell
 725+ 6DD8
 726+ 6DD8              .not_bg:
 727+ 6DD8
 728+ 6DD8 3D               dec  a
 729+ 6DD9 20 06            jr   nz, .not_floor
 730+ 6DDB
 731+ 6DDB                  ; Floor
 732+ 6DDB 21 A9 00         ld   hl, OFFSET_FLOOR
 733+ 6DDE 19               add  hl, de
 734+ 6DDF 18 0D            jr   .draw_cell
 735+ 6DE1
 736+ 6DE1              .not_floor:
 737+ 6DE1
 738+ 6DE1 3D               dec  a
 739+ 6DE2 20 06            jr   nz, .not_wall
 740+ 6DE4
 741+ 6DE4                  ; Wall
 742+ 6DE4 21 B2 00         ld   hl, OFFSET_WALL
 743+ 6DE7 19               add  hl, de
 744+ 6DE8 18 04            jr   .draw_cell
 745+ 6DEA
 746+ 6DEA              .not_wall:
 747+ 6DEA
 748+ 6DEA                  ; Nasty
 749+ 6DEA 21 BB 00         ld   hl, OFFSET_NASTY
 750+ 6DED 19               add  hl, de
 751+ 6DEE
 752+ 6DEE              .draw_cell:
 753+ 6DEE
 754+ 6DEE                  ; ---------------------------------------------------------------
 755+ 6DEE                  ; HL punta ora alla grafica del tile da ridisegnare.
 756+ 6DEE                  ;
 757+ 6DEE                  ; DrawTile si aspetta:
 758+ 6DEE                  ;   IX = puntatore tile
 759+ 6DEE                  ;   B  = Row
 760+ 6DEE                  ;   C  = Col
 761+ 6DEE                  ; ---------------------------------------------------------------
 762+ 6DEE E5               push hl
 763+ 6DEF DD E1            pop  ix
 764+ 6DF1
 765+ 6DF1                  ; Ripristina Row e Col salvati in IY
 766+ 6DF1 FD E5            push iy
 767+ 6DF3 C1               pop  bc
 768+ 6DF4
 769+ 6DF4                  ; Disegna il tile originale
 770+ 6DF4 CD 8C 61         call DrawTile
 771+ 6DF7
 772+ 6DF7                  ; ---------------------------------------------------------------
 773+ 6DF7                  ; Ripristina i registri salvati
 774+ 6DF7                  ; ---------------------------------------------------------------
 775+ 6DF7 DD E1            pop  ix
 776+ 6DF9 E1               pop  hl
 777+ 6DFA D1               pop  de
 778+ 6DFB C1               pop  bc
 779+ 6DFC FD E1            pop  iy
 780+ 6DFE
 781+ 6DFE C9               ret
 782+ 6DFF
 783+ 6DFF              ; -------------------------------------------------------------------
 784+ 6DFF              ; CheckWillyItemCollision
 785+ 6DFF              ;
 786+ 6DFF              ; Verifica se Willy collide con un item utilizzando il controllo
 787+ 6DFF              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 788+ 6DFF              ;
 789+ 6DFF              ; Input:
 790+ 6DFF              ;   A = ItemX (colonna attributi 0..31)
 791+ 6DFF              ;   H = ItemY (riga attributi 3..18)
 792+ 6DFF              ;
 793+ 6DFF              ; Coordinate item:
 794+ 6DFF              ;   Ogni item occupa una cella da 8x8 pixel.
 795+ 6DFF              ;
 796+ 6DFF              ; Coordinate Willy:
 797+ 6DFF              ;   Willy occupa un rettangolo di 16x16 pixel.
 798+ 6DFF              ;
 799+ 6DFF              ; Output:
 800+ 6DFF              ;   Carry Set   = collisione rilevata
 801+ 6DFF              ;   Carry Clear = nessuna collisione
 802+ 6DFF              ;
 803+ 6DFF              ; Registri preservati:
 804+ 6DFF              ;   BC, DE, HL
 805+ 6DFF              ; -------------------------------------------------------------------
 806+ 6DFF              CheckWillyItemCollision:
 807+ 6DFF
 808+ 6DFF                  ; Salva i registri utilizzati
 809+ 6DFF C5               push bc
 810+ 6E00 D5               push de
 811+ 6E01 E5               push hl
 812+ 6E02
 813+ 6E02                  ; ---------------------------------------------------------------
 814+ 6E02                  ; Calcola il bounding box orizzontale dell'item
 815+ 6E02                  ;
 816+ 6E02                  ; ItemLeft  = ItemX * 8
 817+ 6E02                  ; ItemRight = ItemLeft + 7
 818+ 6E02                  ;
 819+ 6E02                  ; E = ItemLeft
 820+ 6E02                  ; D = ItemRight
 821+ 6E02                  ; ---------------------------------------------------------------
 822+ 6E02 6F               ld   l, a              ; L = ItemX
 823+ 6E03
 824+ 6E03 7D               ld   a, l
 825+ 6E04 87               add  a, a              ; *2
 826+ 6E05 87               add  a, a              ; *4
 827+ 6E06 87               add  a, a              ; *8
 828+ 6E07
 829+ 6E07 5F               ld   e, a              ; E = ItemLeft
 830+ 6E08
 831+ 6E08 C6 07            add  a, 7
 832+ 6E0A 57               ld   d, a              ; D = ItemRight
 833+ 6E0B
 834+ 6E0B                  ; ---------------------------------------------------------------
 835+ 6E0B                  ; Recupera la posizione corrente di Willy
 836+ 6E0B                  ;
 837+ 6E0B                  ; B = WillyY
 838+ 6E0B                  ; C = WillyX
 839+ 6E0B                  ; ---------------------------------------------------------------
 840+ 6E0B ED 4B 20 7B      ld   bc, (PlayerPos)
 841+ 6E0F
 842+ 6E0F                  ; ---------------------------------------------------------------
 843+ 6E0F                  ; Primo test:
 844+ 6E0F                  ;
 845+ 6E0F                  ; WillyLeft <= ItemRight
 846+ 6E0F                  ;
 847+ 6E0F                  ; Se Willy è completamente a destra dell'item
 848+ 6E0F                  ; non può esserci collisione.
 849+ 6E0F                  ; ---------------------------------------------------------------
 850+ 6E0F 79               ld   a, c              ; A = WillyLeft
 851+ 6E10
 852+ 6E10 BA               cp   d                 ; WillyLeft vs ItemRight
 853+ 6E11
 854+ 6E11 28 04            jr   z, .x_ok
 855+ 6E13 38 02            jr   c, .x_ok
 856+ 6E15
 857+ 6E15 18 29            jr   .no_collision
 858+ 6E17
 859+ 6E17              .x_ok:
 860+ 6E17
 861+ 6E17                  ; ---------------------------------------------------------------
 862+ 6E17                  ; Secondo test:
 863+ 6E17                  ;
 864+ 6E17                  ; WillyRight >= ItemLeft
 865+ 6E17                  ;
 866+ 6E17                  ; WillyRight = WillyX + 7
 867+ 6E17                  ; ---------------------------------------------------------------
 868+ 6E17 C6 07            add  a, 7
 869+ 6E19
 870+ 6E19 BB               cp   e                 ; WillyRight vs ItemLeft
 871+ 6E1A
 872+ 6E1A 28 04            jr   z, .y_check
 873+ 6E1C 30 02            jr   nc, .y_check
 874+ 6E1E
 875+ 6E1E 18 20            jr   .no_collision
 876+ 6E20
 877+ 6E20              .y_check:
 878+ 6E20
 879+ 6E20                  ; ---------------------------------------------------------------
 880+ 6E20                  ; Recupera ItemY dal valore originale di HL
 881+ 6E20                  ;
 882+ 6E20                  ; H contiene la riga dell'item.
 883+ 6E20                  ; ---------------------------------------------------------------
 884+ 6E20 E1               pop  hl
 885+ 6E21 E5               push hl
 886+ 6E22
 887+ 6E22                  ; ---------------------------------------------------------------
 888+ 6E22                  ; Calcola il bounding box verticale dell'item
 889+ 6E22                  ;
 890+ 6E22                  ; ItemTop    = ItemY * 8
 891+ 6E22                  ; ItemBottom = ItemTop + 7
 892+ 6E22                  ;
 893+ 6E22                  ; E = ItemTop
 894+ 6E22                  ; D = ItemBottom
 895+ 6E22                  ; ---------------------------------------------------------------
 896+ 6E22 7C               ld   a, h
 897+ 6E23
 898+ 6E23 87               add  a, a              ; *2
 899+ 6E24 87               add  a, a              ; *4
 900+ 6E25 87               add  a, a              ; *8
 901+ 6E26
 902+ 6E26 5F               ld   e, a              ; ItemTop
 903+ 6E27
 904+ 6E27 C6 07            add  a, 7
 905+ 6E29 57               ld   d, a              ; ItemBottom
 906+ 6E2A
 907+ 6E2A                  ; ---------------------------------------------------------------
 908+ 6E2A                  ; Primo test verticale:
 909+ 6E2A                  ;
 910+ 6E2A                  ; WillyTop <= ItemBottom
 911+ 6E2A                  ; ---------------------------------------------------------------
 912+ 6E2A 78               ld   a, b              ; WillyTop
 913+ 6E2B
 914+ 6E2B BA               cp   d
 915+ 6E2C
 916+ 6E2C 28 04            jr   z, .y_ok
 917+ 6E2E 38 02            jr   c, .y_ok
 918+ 6E30
 919+ 6E30 18 0E            jr   .no_collision
 920+ 6E32
 921+ 6E32              .y_ok:
 922+ 6E32
 923+ 6E32                  ; ---------------------------------------------------------------
 924+ 6E32                  ; Secondo test verticale:
 925+ 6E32                  ;
 926+ 6E32                  ; WillyBottom >= ItemTop
 927+ 6E32                  ;
 928+ 6E32                  ; WillyBottom = WillyY + 15
 929+ 6E32                  ; ---------------------------------------------------------------
 930+ 6E32 C6 0F            add  a, 15
 931+ 6E34
 932+ 6E34 BB               cp   e
 933+ 6E35
 934+ 6E35 28 04            jr   z, .collision
 935+ 6E37 30 02            jr   nc, .collision
 936+ 6E39
 937+ 6E39 18 05            jr   .no_collision
 938+ 6E3B
 939+ 6E3B              .collision:
 940+ 6E3B
 941+ 6E3B                  ; ---------------------------------------------------------------
 942+ 6E3B                  ; Collisione rilevata
 943+ 6E3B                  ; ---------------------------------------------------------------
 944+ 6E3B E1               pop  hl
 945+ 6E3C D1               pop  de
 946+ 6E3D C1               pop  bc
 947+ 6E3E
 948+ 6E3E 37               scf                    ; Carry = 1
 949+ 6E3F
 950+ 6E3F C9               ret
 951+ 6E40
 952+ 6E40              .no_collision:
 953+ 6E40
 954+ 6E40                  ; ---------------------------------------------------------------
 955+ 6E40                  ; Nessuna collisione
 956+ 6E40                  ; ---------------------------------------------------------------
 957+ 6E40 E1               pop  hl
 958+ 6E41 D1               pop  de
 959+ 6E42 C1               pop  bc
 960+ 6E43
 961+ 6E43 B7               or   a                 ; Carry = 0
 962+ 6E44
 963+ 6E44 C9               ret
 964+ 6E45
 965+ 6E45              ; -------------------------------------------------------------------
 966+ 6E45              ; CheckRoomItemsCollision
 967+ 6E45              ;
 968+ 6E45              ; Controlla se Willy entra in collisione con uno degli item
 969+ 6E45              ; attivi presenti nella stanza corrente.
 970+ 6E45              ;
 971+ 6E45              ; Per ogni item:
 972+ 6E45              ;   - verifica che appartenga alla stanza corrente
 973+ 6E45              ;   - verifica che non sia già stato raccolto
 974+ 6E45              ;   - esegue il test di collisione con Willy
 975+ 6E45              ;
 976+ 6E45              ; Se l'item viene raccolto:
 977+ 6E45              ;   - imposta il flag "collected"
 978+ 6E45              ;   - rimuove l'item dalla cache items_grid
 979+ 6E45              ;   - incrementa il contatore degli oggetti raccolti
 980+ 6E45              ;   - aggiorna l'HUD
 981+ 6E45              ;   - ripristina il tile di sfondo
 982+ 6E45              ;   - riproduce il suono di raccolta
 983+ 6E45              ;
 984+ 6E45              ; Formato record ItemsTable:
 985+ 6E45              ;   +0 RoomID
 986+ 6E45              ;   +1 X
 987+ 6E45              ;   +2 Y
 988+ 6E45              ;   +3 Color
 989+ 6E45              ;   +4 Collected
 990+ 6E45              ;
 991+ 6E45              ; Fine tabella:
 992+ 6E45              ;   RoomID = $FF
 993+ 6E45              ; -------------------------------------------------------------------
 994+ 6E45              CheckRoomItemsCollision:
 995+ 6E45
 996+ 6E45                  ; Salva i registri utilizzati
 997+ 6E45 E5               push hl
 998+ 6E46 D5               push de
 999+ 6E47 C5               push bc
1000+ 6E48
1001+ 6E48                  ; Inizio scansione della tabella degli item
1002+ 6E48 21 DC 6B         ld   hl, ItemsTable
1003+ 6E4B
1004+ 6E4B              .loop:
1005+ 6E4B
1006+ 6E4B                  ; ---------------------------------------------------------------
1007+ 6E4B                  ; Legge il Room ID dell'item corrente
1008+ 6E4B                  ; ---------------------------------------------------------------
1009+ 6E4B 7E               ld   a, (hl)
1010+ 6E4C
1011+ 6E4C                  ; $FF indica fine tabella
1012+ 6E4C FE FF            cp   $FF
1013+ 6E4E 28 4D            jr   z, .done
1014+ 6E50
1015+ 6E50                  ; ---------------------------------------------------------------
1016+ 6E50                  ; Verifica se l'item appartiene alla stanza corrente
1017+ 6E50                  ; ---------------------------------------------------------------
1018+ 6E50 57               ld   d, a              ; D = RoomID item
1019+ 6E51
1020+ 6E51 3A 34 7E         ld   a, (current_room)
1021+ 6E54 BA               cp   d
1022+ 6E55
1023+ 6E55                  ; Se appartiene a un'altra stanza salta il record
1024+ 6E55 20 3F            jr   nz, .next_item
1025+ 6E57
1026+ 6E57                  ; ---------------------------------------------------------------
1027+ 6E57                  ; Legge coordinate e stato dell'item
1028+ 6E57                  ; ---------------------------------------------------------------
1029+ 6E57
1030+ 6E57 23               inc  hl
1031+ 6E58 4E               ld   c, (hl)           ; C = X
1032+ 6E59
1033+ 6E59 23               inc  hl
1034+ 6E5A 46               ld   b, (hl)           ; B = Y
1035+ 6E5B
1036+ 6E5B 23               inc  hl                ; salta Color
1037+ 6E5C
1038+ 6E5C 23               inc  hl                ; punta a Collected
1039+ 6E5D
1040+ 6E5D 7E               ld   a, (hl)
1041+ 6E5E
1042+ 6E5E                  ; ---------------------------------------------------------------
1043+ 6E5E                  ; Item già raccolto?
1044+ 6E5E                  ; ---------------------------------------------------------------
1045+ 6E5E B7               or   a
1046+ 6E5F 20 39            jr   nz, .next_no_inc
1047+ 6E61
1048+ 6E61                  ; ---------------------------------------------------------------
1049+ 6E61                  ; Test collisione Willy ↔ Item
1050+ 6E61                  ;
1051+ 6E61                  ; Input richiesto:
1052+ 6E61                  ;   A = ItemX
1053+ 6E61                  ;   H = ItemY
1054+ 6E61                  ; ---------------------------------------------------------------
1055+ 6E61 79               ld   a, c
1056+ 6E62
1057+ 6E62 E5               push hl                ; salva puntatore al flag Collected
1058+ 6E63
1059+ 6E63 60               ld   h, b
1060+ 6E64
1061+ 6E64 CD FF 6D         call CheckWillyItemCollision
1062+ 6E67
1063+ 6E67 E1               pop  hl
1064+ 6E68
1065+ 6E68                  ; Nessuna collisione
1066+ 6E68 30 30            jr   nc, .next_no_inc
1067+ 6E6A
1068+ 6E6A                  ; ===============================================================
1069+ 6E6A                  ; ITEM RACCOLTO
1070+ 6E6A                  ; ===============================================================
1071+ 6E6A
1072+ 6E6A                  ; ---------------------------------------------------------------
1073+ 6E6A                  ; Marca l'item come raccolto
1074+ 6E6A                  ; ---------------------------------------------------------------
1075+ 6E6A 36 01            ld   (hl), 1
1076+ 6E6C
1077+ 6E6C                  ; ---------------------------------------------------------------
1078+ 6E6C                  ; Rimuove l'item dalla cache items_grid
1079+ 6E6C                  ;
1080+ 6E6C                  ; Calcolo:
1081+ 6E6C                  ;   offset = Row * 32 + Col
1082+ 6E6C                  ; ---------------------------------------------------------------
1083+ 6E6C E5               push hl
1084+ 6E6D D5               push de
1085+ 6E6E
1086+ 6E6E 26 00            ld   h, 0
1087+ 6E70 68               ld   l, b              ; HL = Row
1088+ 6E71
1089+ 6E71 29               add  hl, hl            ; *2
1090+ 6E72 29               add  hl, hl            ; *4
1091+ 6E73 29               add  hl, hl            ; *8
1092+ 6E74 29               add  hl, hl            ; *16
1093+ 6E75 29               add  hl, hl            ; *32
1094+ 6E76
1095+ 6E76 59               ld   e, c
1096+ 6E77 16 00            ld   d, 0
1097+ 6E79
1098+ 6E79 19               add  hl, de            ; Row*32 + Col
1099+ 6E7A
1100+ 6E7A 11 00 90         ld   de, items_grid
1101+ 6E7D 19               add  hl, de
1102+ 6E7E
1103+ 6E7E                  ; La cella non contiene più un item
1104+ 6E7E 36 00            ld   (hl), 0
1105+ 6E80
1106+ 6E80 D1               pop  de
1107+ 6E81 E1               pop  hl
1108+ 6E82
1109+ 6E82                  ; ---------------------------------------------------------------
1110+ 6E82                  ; Conserva il puntatore all'entry corrente
1111+ 6E82                  ; poiché le routine successive possono alterare HL.
1112+ 6E82                  ; ---------------------------------------------------------------
1113+ 6E82 E5               push hl
1114+ 6E83
1115+ 6E83                  ; ---------------------------------------------------------------
1116+ 6E83                  ; Aggiorna il numero di oggetti raccolti
1117+ 6E83                  ; ---------------------------------------------------------------
1118+ 6E83 3A 2A 7B         ld   a, (items_collected)
1119+ 6E86
1120+ 6E86 3C               inc  a
1121+ 6E87
1122+ 6E87 32 2A 7B         ld   (items_collected), a
1123+ 6E8A
1124+ 6E8A                  ; ---------------------------------------------------------------
1125+ 6E8A                  ; Aggiorna il contatore visualizzato a schermo
1126+ 6E8A                  ; ---------------------------------------------------------------
1127+ 6E8A CD CB 60         call UpdateItemsCollectedDisplay
1128+ 6E8D
1129+ 6E8D                  ; ---------------------------------------------------------------
1130+ 6E8D                  ; Ripristina il tile originale della stanza
1131+ 6E8D                  ; eliminando la grafica dell'item.
1132+ 6E8D                  ;
1133+ 6E8D                  ; Input:
1134+ 6E8D                  ;   B = Row
1135+ 6E8D                  ;   C = Col
1136+ 6E8D                  ; ---------------------------------------------------------------
1137+ 6E8D CD BD 6D         call RestoreBackgroundCell
1138+ 6E90
1139+ 6E90                  ; ---------------------------------------------------------------
1140+ 6E90                  ; Riproduce il suono di raccolta
1141+ 6E90                  ; ---------------------------------------------------------------
1142+ 6E90 CD A1 6E         call PlayCollectSound
1143+ 6E93
1144+ 6E93                  ; Ripristina il puntatore alla tabella
1145+ 6E93 E1               pop  hl
1146+ 6E94
1147+ 6E94                  ; Continua con il record successivo
1148+ 6E94 18 04            jr   .next_no_inc
1149+ 6E96
1150+ 6E96              .next_item:
1151+ 6E96
1152+ 6E96                  ; ---------------------------------------------------------------
1153+ 6E96                  ; Salta i campi del record:
1154+ 6E96                  ;   X
1155+ 6E96                  ;   Y
1156+ 6E96                  ;   Color
1157+ 6E96                  ;   Collected
1158+ 6E96                  ; ---------------------------------------------------------------
1159+ 6E96 23               inc  hl
1160+ 6E97 23               inc  hl
1161+ 6E98 23               inc  hl
1162+ 6E99 23               inc  hl
1163+ 6E9A
1164+ 6E9A              .next_no_inc:
1165+ 6E9A
1166+ 6E9A                  ; ---------------------------------------------------------------
1167+ 6E9A                  ; Avanza al record successivo.
1168+ 6E9A                  ;
1169+ 6E9A                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1170+ 6E9A                  ; ---------------------------------------------------------------
1171+ 6E9A 23               inc  hl
1172+ 6E9B
1173+ 6E9B 18 AE            jr   .loop
1174+ 6E9D
1175+ 6E9D              .done:
1176+ 6E9D
1177+ 6E9D                  ; Ripristina i registri
1178+ 6E9D C1               pop  bc
1179+ 6E9E D1               pop  de
1180+ 6E9F E1               pop  hl
1181+ 6EA0
1182+ 6EA0 C9               ret
1183+ 6EA1
1184+ 6EA1              ; -------------------------------------------------------------------
1185+ 6EA1              ; PlayCollectSound
1186+ 6EA1              ;
1187+ 6EA1              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1188+ 6EA1              ; dello ZX Spectrum utilizzando il port $FE.
1189+ 6EA1              ;
1190+ 6EA1              ; Il suono viene prodotto alternando ON/OFF del bit 4
1191+ 6EA1              ; (speaker) con un semplice delay software.
1192+ 6EA1              ;
1193+ 6EA1              ; Effetto risultante:
1194+ 6EA1              ;   beep breve tipo "pickup item"
1195+ 6EA1              ; -------------------------------------------------------------------
1196+ 6EA1              PlayCollectSound:
1197+ 6EA1
1198+ 6EA1                  ; Salva registri utilizzati
1199+ 6EA1 C5               push bc
1200+ 6EA2 D5               push de
1201+ 6EA3
1202+ 6EA3                  ; ---------------------------------------------------------------
1203+ 6EA3                  ; Numero di cicli del beep (durata complessiva del suono)
1204+ 6EA3                  ; ---------------------------------------------------------------
1205+ 6EA3 06 78            ld   b, 120
1206+ 6EA5
1207+ 6EA5              .sound_loop:
1208+ 6EA5
1209+ 6EA5                  ; ---------------------------------------------------------------
1210+ 6EA5                  ; SPEAKER ON
1211+ 6EA5                  ;
1212+ 6EA5                  ; Legge il colore del bordo corrente e attiva il bit 4
1213+ 6EA5                  ; per pilotare lo speaker.
1214+ 6EA5                  ; ---------------------------------------------------------------
1215+ 6EA5 3A 2C 7B         ld   a, (room_border_color)
1216+ 6EA8 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1217+ 6EAA
1218+ 6EAA D3 FE            out  ($fe), a         ; scrive sul port ULA
1219+ 6EAC
1220+ 6EAC                  ; ---------------------------------------------------------------
1221+ 6EAC                  ; Delay (mezzo periodo)
1222+ 6EAC                  ; Loop software a consumo CPU
1223+ 6EAC                  ; ---------------------------------------------------------------
1224+ 6EAC 0E 3C            ld   c, 60
1225+ 6EAE
1226+ 6EAE              .d1:
1227+ 6EAE 0D               dec  c
1228+ 6EAF 20 FD            jr   nz, .d1
1229+ 6EB1
1230+ 6EB1                  ; ---------------------------------------------------------------
1231+ 6EB1                  ; SPEAKER OFF
1232+ 6EB1                  ;
1233+ 6EB1                  ; Mantiene il colore del bordo ma disattiva lo speaker
1234+ 6EB1                  ; ---------------------------------------------------------------
1235+ 6EB1 3A 2C 7B         ld   a, (room_border_color)
1236+ 6EB4 E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1237+ 6EB6
1238+ 6EB6 D3 FE            out  ($fe), a
1239+ 6EB8
1240+ 6EB8                  ; ---------------------------------------------------------------
1241+ 6EB8                  ; Secondo delay (mezzo periodo)
1242+ 6EB8                  ; Completa l’onda quadra
1243+ 6EB8                  ; ---------------------------------------------------------------
1244+ 6EB8 0E 3C            ld   c, 60
1245+ 6EBA
1246+ 6EBA              .d2:
1247+ 6EBA 0D               dec  c
1248+ 6EBB 20 FD            jr   nz, .d2
1249+ 6EBD
1250+ 6EBD                  ; ---------------------------------------------------------------
1251+ 6EBD                  ; Ripete fino a completare il numero di cicli
1252+ 6EBD                  ; ---------------------------------------------------------------
1253+ 6EBD 10 E6            djnz .sound_loop
1254+ 6EBF
1255+ 6EBF                  ; Ripristina registri salvati
1256+ 6EBF D1               pop  de
1257+ 6EC0 C1               pop  bc
1258+ 6EC1
1259+ 6EC1 C9               ret
1260+ 6EC2
1261+ 6EC2              ; -------------------------------------------------------------------
1262+ 6EC2              ; CheckActiveItemAtCell
1263+ 6EC2              ;
1264+ 6EC2              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1265+ 6EC2              ; nella cella specificata della griglia items_grid.
1266+ 6EC2              ;
1267+ 6EC2              ; Questa routine usa una lookup diretta su una mappa 32x16,
1268+ 6EC2              ; evitando la scansione della ItemsTable.
1269+ 6EC2              ;
1270+ 6EC2              ; Input:
1271+ 6EC2              ;   B = Colonna (0..31)
1272+ 6EC2              ;   C = Riga (0..15)
1273+ 6EC2              ;
1274+ 6EC2              ; Output:
1275+ 6EC2              ;   Carry Set   = item presente nella cella
1276+ 6EC2              ;   Carry Clear = nessun item
1277+ 6EC2              ;
1278+ 6EC2              ; Nota:
1279+ 6EC2              ;   HL NON è restituito valido (commento originale non corretto:
1280+ 6EC2              ;   la routine non punta a ItemsTable).
1281+ 6EC2              ; -------------------------------------------------------------------
1282+ 6EC2              CheckActiveItemAtCell:
1283+ 6EC2
1284+ 6EC2                  ; Salva registri usati
1285+ 6EC2 D5               push de
1286+ 6EC3 E5               push hl
1287+ 6EC4
1288+ 6EC4                  ; ---------------------------------------------------------------
1289+ 6EC4                  ; Calcolo indice lineare nella griglia 32x16:
1290+ 6EC4                  ;
1291+ 6EC4                  ; offset = Row * 32 + Col
1292+ 6EC4                  ; ---------------------------------------------------------------
1293+ 6EC4 26 00            ld   h, 0
1294+ 6EC6 69               ld   l, c              ; HL = Row
1295+ 6EC7
1296+ 6EC7 29               add  hl, hl            ; *2
1297+ 6EC8 29               add  hl, hl            ; *4
1298+ 6EC9 29               add  hl, hl            ; *8
1299+ 6ECA 29               add  hl, hl            ; *16
1300+ 6ECB 29               add  hl, hl            ; *32
1301+ 6ECC
1302+ 6ECC                  ; Aggiunge la colonna
1303+ 6ECC 58               ld   e, b
1304+ 6ECD 16 00            ld   d, 0
1305+ 6ECF 19               add  hl, de            ; HL = Row*32 + Col
1306+ 6ED0
1307+ 6ED0                  ; ---------------------------------------------------------------
1308+ 6ED0                  ; Accesso alla griglia degli item attivi
1309+ 6ED0                  ; ---------------------------------------------------------------
1310+ 6ED0 11 00 90         ld   de, items_grid
1311+ 6ED3 19               add  hl, de            ; HL = address cella
1312+ 6ED4
1313+ 6ED4                  ; ---------------------------------------------------------------
1314+ 6ED4                  ; Controllo presenza item
1315+ 6ED4                  ;
1316+ 6ED4                  ; items_grid contiene:
1317+ 6ED4                  ;   0 = nessun item
1318+ 6ED4                  ;   >0 = item attivo (colore o flag)
1319+ 6ED4                  ; ---------------------------------------------------------------
1320+ 6ED4 7E               ld   a, (hl)
1321+ 6ED5 B7               or   a
1322+ 6ED6 28 04            jr   z, .not_active
1323+ 6ED8
1324+ 6ED8                  ; ---------------------------------------------------------------
1325+ 6ED8                  ; Item trovato
1326+ 6ED8                  ; ---------------------------------------------------------------
1327+ 6ED8 E1               pop  hl
1328+ 6ED9 D1               pop  de
1329+ 6EDA
1330+ 6EDA 37               scf                    ; Carry = 1
1331+ 6EDB C9               ret
1332+ 6EDC
1333+ 6EDC              .not_active:
1334+ 6EDC
1335+ 6EDC                  ; ---------------------------------------------------------------
1336+ 6EDC                  ; Nessun item nella cella
1337+ 6EDC                  ; ---------------------------------------------------------------
1338+ 6EDC E1               pop  hl
1339+ 6EDD D1               pop  de
1340+ 6EDE
1341+ 6EDE B7               or   a                 ; Carry = 0
1342+ 6EDF C9               ret
1343+ 6EE0
