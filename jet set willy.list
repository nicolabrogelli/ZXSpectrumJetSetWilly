1839+ 79F2              .custom_settings:
1840+ 79F2 F5               push af
1841+ 79F3 E6 0F            and  $0f                  ; Maschera i 4 bit inferiori (JJJJ)
1842+ 79F5 32 01 F5         ld   (room_jump_strength), a
1843+ 79F8 F1               pop  af
1844+ 79F9 CB 3F            srl  a
1845+ 79FB CB 3F            srl  a
1846+ 79FD CB 3F            srl  a
1847+ 79FF CB 3F            srl  a                  ; Sposta i 4 bit superiori in quelli inferiori (GGGG)
1848+ 7A01 32 02 F5         ld   (room_gravity_preset), a
