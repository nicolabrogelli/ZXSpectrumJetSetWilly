 290  8814
 291  8814                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 292  8814 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 293  8816              .title_loop:
 294  8816 76               halt
 295  8817
 296  8817                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 297  8817 0C               inc  c
 298  8818 79               ld   a, c
 299  8819 CB 3F            srl  a
 300  881B CB 3F            srl  a
 301  881D CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 302  881F E6 07            and  7
 303  8821 5F               ld   e, a
 304  8822 16 00            ld   d, 0
 305  8824 21 13 63         ld   hl, title_color_table
 306  8827 19               add  hl, de
 307  8828 7E               ld   a, (hl)               ; A = nuovo colore
 308  8829 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 309  882C 06 20            ld   b, 32
 310  882E              .color_title_loop:
 311  882E 77               ld   (hl), a
 312  882F 23               inc  hl
 313  8830 10 FC            djnz .color_title_loop
 314  8832
 315  8832                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 316  8832 3E BF            ld   a, $bf
 317  8834 DB FE            in   a, ($fe)
 318  8836 1F               rra
 319  8837 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 320  8839
 321  8839                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
