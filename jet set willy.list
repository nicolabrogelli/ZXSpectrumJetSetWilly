 161+ 8918              ; Audio_PlayCollectSound
 162+ 8918              ;
 163+ 8918              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 164+ 8918              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 165+ 8918              ; -------------------------------------------------------------------
 166+ 8918              Audio_PlayCollectSound:
 167+ 8918 C5               push bc
 168+ 8919 D5               push de
 169+ 891A
 170+ 891A 06 78            ld   b, 120
 171+ 891C              .sound_loop:
 172+ 891C 3A 46 F7         ld   a, (room_border_color)
 173+ 891F F6 10            or   $10               ; speaker ON
 174+ 8921 D3 FE            out  ($fe), a
 175+ 8923
 176+ 8923 0E 3C            ld   c, 60
 177+ 8925              .d1:
 178+ 8925 0D               dec  c
 179+ 8926 20 FD            jr   nz, .d1
 180+ 8928
 181+ 8928 3A 46 F7         ld   a, (room_border_color)
 182+ 892B E6 EF            and  $ef              ; speaker OFF
 183+ 892D D3 FE            out  ($fe), a
 184+ 892F
 185+ 892F 0E 3C            ld   c, 60
 186+ 8931              .d2:
 187+ 8931 0D               dec  c
 188+ 8932 20 FD            jr   nz, .d2
 189+ 8934
 190+ 8934 10 E6            djnz .sound_loop
 191+ 8936
 192+ 8936 D1               pop  de
 193+ 8937 C1               pop  bc
 194+ 8938 C9               ret
