 482+ 6D58              ; -------------------------------------------------------------------
 483+ 6D58              ; Controlla se Willy tocca un item attivo nella stanza corrente
 484+ 6D58              ; -------------------------------------------------------------------
 485+ 6D58              CheckRoomItemsCollision:
 486+ 6D58 E5               push hl
 487+ 6D59 D5               push de
 488+ 6D5A C5               push bc
 489+ 6D5B
 490+ 6D5B 21 23 6B         ld   hl, ItemsTable
 491+ 6D5E              .loop:
 492+ 6D5E 7E               ld   a, (hl)           ; A = Room ID
 493+ 6D5F FE FF            cp   $FF               ; Fine tabella?
 494+ 6D61 28 4D            jr   z, .done
 495+ 6D63
 496+ 6D63                  ; Stanza corrente?
 497+ 6D63 57               ld   d, a              ; D = Room ID
 498+ 6D64 3A 47 7D         ld   a, (current_room)
 499+ 6D67 BA               cp   d
 500+ 6D68 20 3F            jr   nz, .next_item
 501+ 6D6A
 502+ 6D6A 23               inc  hl                ; HL punta a X
 503+ 6D6B 4E               ld   c, (hl)           ; C = X
 504+ 6D6C 23               inc  hl                ; HL punta a Y
 505+ 6D6D 46               ld   b, (hl)           ; B = Y
 506+ 6D6E 23               inc  hl                ; HL punta al colore (lo saltiamo per il controllo collisione)
 507+ 6D6F 23               inc  hl                ; HL punta a collected
 508+ 6D70 7E               ld   a, (hl)           ; A = collected
 509+ 6D71 B7               or   a
 510+ 6D72 20 39            jr   nz, .next_no_inc  ; Già raccolto, salta
 511+ 6D74
 512+ 6D74                  ; Controlla collisione
 513+ 6D74 79               ld   a, c
 514+ 6D75 E5               push hl
 515+ 6D76 60               ld   h, b
 516+ 6D77 CD 12 6D         call CheckWillyItemCollision
 517+ 6D7A E1               pop  hl
 518+ 6D7B 30 30            jr   nc, .next_no_inc
 519+ 6D7D
 520+ 6D7D                  ; RACCOLTO!
 521+ 6D7D 36 01            ld   (hl), 1           ; Imposta collected = 1
 522+ 6D7F
 523+ 6D7F                  ; Clear items_grid[b * 32 + c]
 524+ 6D7F E5               push hl
 525+ 6D80 D5               push de
 526+ 6D81 26 00            ld   h, 0
 527+ 6D83 68               ld   l, b              ; HL = Row
 528+ 6D84 29               add  hl, hl
 529+ 6D85 29               add  hl, hl
 530+ 6D86 29               add  hl, hl
 531+ 6D87 29               add  hl, hl
 532+ 6D88 29               add  hl, hl            ; HL = Row * 32
 533+ 6D89 59               ld   e, c
 534+ 6D8A 16 00            ld   d, 0
 535+ 6D8C 19               add  hl, de            ; HL = Row * 32 + Col
 536+ 6D8D 11 00 90         ld   de, items_grid
 537+ 6D90 19               add  hl, de
 538+ 6D91 36 00            ld   (hl), 0           ; Clear grid cell
 539+ 6D93 D1               pop  de
 540+ 6D94 E1               pop  hl
 541+ 6D95
 542+ 6D95 E5               push hl
 543+ 6D96
 544+ 6D96                  ; Incrementa contatore oggetti raccolti
 545+ 6D96 3A 3D 7A         ld   a, (items_collected)
 546+ 6D99 3C               inc  a
 547+ 6D9A 32 3D 7A         ld   (items_collected), a
 548+ 6D9D
 549+ 6D9D                  ; Aggiorna stringa e visualizzazione a schermo
 550+ 6D9D CD CB 60         call UpdateItemsCollectedDisplay
 551+ 6DA0
 552+ 6DA0                  ; Cancella item dallo schermo
 553+ 6DA0 CD D0 6C         call RestoreBackgroundCell
 554+ 6DA3
 555+ 6DA3                  ; Suono di raccolta
 556+ 6DA3 CD B4 6D         call PlayCollectSound
 557+ 6DA6
 558+ 6DA6 E1               pop  hl
 559+ 6DA7
 560+ 6DA7 18 04            jr   .next_no_inc
 561+ 6DA9
 562+ 6DA9              .next_item:
 563+ 6DA9 23               inc  hl                ; salta X
 564+ 6DAA 23               inc  hl                ; salta Y
 565+ 6DAB 23               inc  hl                ; salta colore
 566+ 6DAC 23               inc  hl                ; salta collected
 567+ 6DAD              .next_no_inc:
 568+ 6DAD 23               inc  hl                ; vai al prossimo item
 569+ 6DAE 18 AE            jr   .loop
