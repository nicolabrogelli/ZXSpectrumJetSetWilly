1125+ 6B6F
1126+ 6B6F              ; -------------------------------------------------------------------
1127+ 6B6F              ; Ottiene l'attributo colore originale dello sfondo per una cella
1128+ 6B6F              ; Input: H = Row (0..23), B = Col (0..31)
1129+ 6B6F              ; Output: A = Attributo colore
1130+ 6B6F              ; -------------------------------------------------------------------
1131+ 6B6F              GetCellAttribute:
1132+ 6B6F E5               push hl
1133+ 6B70 D5               push de
1134+ 6B71 C5               push bc
1135+ 6B72
1136+ 6B72                  ; 1. Controlla se Row (H) è fuori dal layout (H < 3 o H >= 19)
1137+ 6B72 7C               ld   a, h
1138+ 6B73 FE 03            cp   3
1139+ 6B75 38 5E            jr   c, .blank
1140+ 6B77 FE 13            cp   19
1141+ 6B79 30 5A            jr   nc, .blank
1142+ 6B7B
1143+ 6B7B                  ; 2. Calcola riga di layout: r = H - 3
1144+ 6B7B D6 03            sub  3
1145+ 6B7D
1146+ 6B7D                  ; 3. HL = r * 8
1147+ 6B7D 6F               ld   l, a
1148+ 6B7E 26 00            ld   h, 0
