  71+ 7820              ; Audio_UpdateMusic
  72+ 7820              ;
  73+ 7820              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 7820              ; Viene chiamata a ogni frame.
  75+ 7820              ; -------------------------------------------------------------------
  76+ 7820              Audio_UpdateMusic:
  77+ 7820 F5               push af
  78+ 7821 C5               push bc
  79+ 7822 D5               push de
  80+ 7823 E5               push hl
  81+ 7824
  82+ 7824                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 7824 3A 6A 7C         ld   a, (Audio_jump_sound_note)
  84+ 7827 FE 12            cp   18
  85+ 7829 38 56            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 782B
  87+ 782B                  ; Decrementa il contatore dei frame della nota corrente
  88+ 782B 3A 6D 7C         ld   a, (Audio_music_frame_counter)
  89+ 782E 3D               dec  a
  90+ 782F 32 6D 7C         ld   (Audio_music_frame_counter), a
  91+ 7832 20 1F            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 7834
  93+ 7834                  ; Altrimenti carica la nota successiva
  94+ 7834 3A 6C 7C         ld   a, (Audio_music_note_idx)
  95+ 7837 3C               inc  a
  96+ 7838 FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 783A 38 01            jr   c, .no_wrap
  98+ 783C AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 783D              .no_wrap:
 100+ 783D 32 6C 7C         ld   (Audio_music_note_idx), a
 101+ 7840
 102+ 7840                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 7840 5F               ld   e, a
 104+ 7841 16 00            ld   d, 0
 105+ 7843 21 86 78         ld   hl, Audio_MusicSheet
 106+ 7846 19               add  hl, de
 107+ 7847 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 7848
 109+ 7848                  ; Leggi durata (secondo byte)
 110+ 7848 23               inc  hl
 111+ 7849 7E               ld   a, (hl)
 112+ 784A CB 3F            srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 113+ 784C 20 02            jr   nz, .dur_ok
 114+ 784E 3E 01            ld   a, 1
 115+ 7850              .dur_ok:
 116+ 7850 32 6D 7C         ld   (Audio_music_frame_counter), a
 117+ 7853
 118+ 7853              .play_current_note:
 119+ 7853                  ; Ottieni il delay della nota corrente (primo byte)
 120+ 7853 3A 6C 7C         ld   a, (Audio_music_note_idx)
 121+ 7856 5F               ld   e, a
 122+ 7857 16 00            ld   d, 0
 123+ 7859 21 86 78         ld   hl, Audio_MusicSheet
 124+ 785C 19               add  hl, de
 125+ 785D 19               add  hl, de                   ; hl punta al primo byte della nota
 126+ 785E 7E               ld   a, (hl)                  ; A = delay
 127+ 785F B7               or   a
 128+ 7860 28 1F            jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 129+ 7862
 130+ 7862                  ; Suona la nota: 2 cicli
 131+ 7862 57               ld   d, a                     ; D = delay
 132+ 7863 06 02            ld   b, 2                     ; 2 cicli per frame
 133+ 7865              .note_loop:
 134+ 7865                  ; Speaker ON
 135+ 7865 3A F9 78         ld   a, (room_border_color)
 136+ 7868 F6 10            or   $10
 137+ 786A D3 FE            out  ($fe), a
 138+ 786C 4A               ld   c, d
 139+ 786D              .d1:
 140+ 786D F5               push af
 141+ 786E F1               pop  af
 142+ 786F 0D               dec  c
 143+ 7870 20 FB            jr   nz, .d1
 144+ 7872
 145+ 7872                  ; Speaker OFF
 146+ 7872 3A F9 78         ld   a, (room_border_color)
 147+ 7875 E6 EF            and  $ef
 148+ 7877 D3 FE            out  ($fe), a
 149+ 7879 4A               ld   c, d
 150+ 787A              .d2:
 151+ 787A F5               push af
 152+ 787B F1               pop  af
 153+ 787C 0D               dec  c
 154+ 787D 20 FB            jr   nz, .d2
 155+ 787F
 156+ 787F 10 E4            djnz .note_loop
 157+ 7881
 158+ 7881              .done:
 159+ 7881 E1               pop  hl
 160+ 7882 D1               pop  de
 161+ 7883 C1               pop  bc
 162+ 7884 F1               pop  af
 163+ 7885 C9               ret
