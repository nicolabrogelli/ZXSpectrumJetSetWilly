1242+ 7019              ; -------------------------------------------------------------------
1243+ 7019              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1244+ 7019              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1245+ 7019              ; -------------------------------------------------------------------
1246+ 7019              UnpackRoomLayout:
1247+ 7019 E5               push hl
1248+ 701A D5               push de
1249+ 701B C5               push bc
1250+ 701C
1251+ 701C 2A A6 E9         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1252+ 701F 11 4C E7         ld   de, unpacked_layout ; DE = buffer RAM
1253+ 7022 06 80            ld   b, 128             ; 128 byte
1254+ 7024              .byte_loop:
1255+ 7024 7E               ld   a, (hl)            ; Leggi byte compresso
1256+ 7025 23               inc  hl
1257+ 7026
1258+ 7026 4F               ld   c, a               ; C = salvataggio
1259+ 7027
1260+ 7027                  ; Cella 0: bit 7-6
1261+ 7027 07               rlca
1262+ 7028 07               rlca
1263+ 7029 E6 03            and  3
1264+ 702B 12               ld   (de), a
1265+ 702C 13               inc  de
1266+ 702D
1267+ 702D                  ; Cella 1: bit 5-4
1268+ 702D 79               ld   a, c
1269+ 702E 07               rlca
1270+ 702F 07               rlca
1271+ 7030 07               rlca
1272+ 7031 07               rlca
1273+ 7032 E6 03            and  3
1274+ 7034 12               ld   (de), a
1275+ 7035 13               inc  de
1276+ 7036
1277+ 7036                  ; Cella 2: bit 3-2
1278+ 7036 79               ld   a, c
1279+ 7037 0F               rrca
1280+ 7038 0F               rrca
1281+ 7039 E6 03            and  3
1282+ 703B 12               ld   (de), a
1283+ 703C 13               inc  de
1284+ 703D
1285+ 703D                  ; Cella 3: bit 1-0
1286+ 703D 79               ld   a, c
1287+ 703E E6 03            and  3
1288+ 7040 12               ld   (de), a
1289+ 7041 13               inc  de
1290+ 7042
1291+ 7042 10 E0            djnz .byte_loop
1292+ 7044
1293+ 7044 C1               pop  bc
1294+ 7045 D1               pop  de
1295+ 7046 E1               pop  hl
1296+ 7047 C9               ret
