 408+ 6D12              ; -------------------------------------------------------------------
 409+ 6D12              ; Controlla se Willy collide con un item (pixel-level check)
 410+ 6D12              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 411+ 6D12              ; Output: Carry set se collide, altrimenti clear
 412+ 6D12              ; -------------------------------------------------------------------
 413+ 6D12              CheckWillyItemCollision:
 414+ 6D12 C5               push bc
 415+ 6D13 D5               push de
 416+ 6D14 E5               push hl
 417+ 6D15
 418+ 6D15                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 419+ 6D15 6F               ld   l, a
 420+ 6D16 7D               ld   a, l
 421+ 6D17 87               add  a, a              ; *2
 422+ 6D18 87               add  a, a              ; *4
 423+ 6D19 87               add  a, a              ; *8
 424+ 6D1A 5F               ld   e, a              ; E = ItemLeft
 425+ 6D1B C6 07            add  a, 7
 426+ 6D1D 57               ld   d, a              ; D = ItemRight
 427+ 6D1E
 428+ 6D1E                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 429+ 6D1E ED 4B 33 7A      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 430+ 6D22
 431+ 6D22                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 432+ 6D22 79               ld   a, c
 433+ 6D23 BA               cp   d
 434+ 6D24 28 04            jr   z, .x_ok
 435+ 6D26 38 02            jr   c, .x_ok
 436+ 6D28 18 29            jr   .no_collision
 437+ 6D2A              .x_ok:
 438+ 6D2A C6 0F            add  a, 15
 439+ 6D2C BB               cp   e
 440+ 6D2D 28 04            jr   z, .y_check
 441+ 6D2F 30 02            jr   nc, .y_check
 442+ 6D31 18 20            jr   .no_collision
 443+ 6D33
 444+ 6D33              .y_check:
 445+ 6D33 E1               pop  hl                ; Recupera HL originale (H = ItemY)
 446+ 6D34 E5               push hl
 447+ 6D35 7C               ld   a, h
 448+ 6D36 87               add  a, a              ; *2
 449+ 6D37 87               add  a, a              ; *4
 450+ 6D38 87               add  a, a              ; *8
 451+ 6D39 5F               ld   e, a              ; E = ItemTop
 452+ 6D3A C6 07            add  a, 7
 453+ 6D3C 57               ld   d, a              ; D = ItemBottom
 454+ 6D3D
 455+ 6D3D                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 456+ 6D3D 78               ld   a, b
 457+ 6D3E BA               cp   d
 458+ 6D3F 28 04            jr   z, .y_ok
 459+ 6D41 38 02            jr   c, .y_ok
 460+ 6D43 18 0E            jr   .no_collision
 461+ 6D45              .y_ok:
 462+ 6D45 C6 0F            add  a, 15
 463+ 6D47 BB               cp   e
 464+ 6D48 28 04            jr   z, .collision
 465+ 6D4A 30 02            jr   nc, .collision
 466+ 6D4C 18 05            jr   .no_collision
 467+ 6D4E
 468+ 6D4E              .collision:
 469+ 6D4E E1               pop  hl
 470+ 6D4F D1               pop  de
 471+ 6D50 C1               pop  bc
 472+ 6D51 37               scf                    ; Set carry (collisione!)
 473+ 6D52 C9               ret
 474+ 6D53
 475+ 6D53              .no_collision:
 476+ 6D53 E1               pop  hl
 477+ 6D54 D1               pop  de
 478+ 6D55 C1               pop  bc
 479+ 6D56 B7               or   a                 ; Clear carry
 480+ 6D57 C9               ret
