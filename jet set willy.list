523+  6000 DD 23            inc  ix
524+  6002 15               dec  d
525+  6003 20 F4            jr   nz, .right_loop
526+  6005
527+  6005 C1               pop  bc              ; Ripristina Y e contatore righe
528+  6006 78               ld   a, b
529+  6007 C6 08            add  a, 8
530+  6009 47               ld   b, a            ; Y = Y + 8
531+  600A 0D               dec  c
532+  600B 20 C5            jr   nz, .row_loop
533+  600D
534+  600D                  ; Imposta gli attributi a ROSSO per le colonne 0 e 31 (righe 1..16)
535+  600D 21 20 58         ld   hl, $5800 + (1 * 32)      ; Riga 1, Colonna 0
536+  6010 11 3F 58         ld   de, $5800 + (1 * 32) + 31 ; Riga 1, Colonna 31
537+  6013 06 10            ld   b, 16                     ; 16 righe
538+  6015              .attr_loop:
