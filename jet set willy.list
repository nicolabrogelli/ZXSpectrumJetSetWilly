  72+ 8055 ~            ; Audio_UpdateMusic
  73+ 8055 ~            ;
  74+ 8055 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8055 ~            ; Viene chiamata a ogni frame.
  76+ 8055 ~            ; -------------------------------------------------------------------
  77+ 8055 ~            Audio_UpdateMusic:
  78+ 8055 ~                push af
  79+ 8055 ~                push bc
  80+ 8055 ~                push de
  81+ 8055 ~                push hl
  82+ 8055 ~
  83+ 8055 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8055 ~                ld   a, (Audio_jump_sound_note)
  85+ 8055 ~                cp   18
  86+ 8055 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8055 ~
  88+ 8055 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8055 ~                ld   a, (Audio_music_frame_counter)
  90+ 8055 ~                dec  a
  91+ 8055 ~                ld   (Audio_music_frame_counter), a
  92+ 8055 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8055 ~
  94+ 8055 ~                ; Altrimenti carica la nota successiva
  95+ 8055 ~                ld   a, (Audio_music_note_idx)
  96+ 8055 ~                inc  a
  97+ 8055 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8055 ~                jr   c, .no_wrap
  99+ 8055 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8055 ~            .no_wrap:
 101+ 8055 ~                ld   (Audio_music_note_idx), a
 102+ 8055 ~
 103+ 8055 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8055 ~                ld   e, a
 105+ 8055 ~                ld   d, 0
 106+ 8055 ~                ld   hl, Audio_MusicSheet
 107+ 8055 ~                add  hl, de
 108+ 8055 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8055 ~
 110+ 8055 ~                ; Leggi durata (secondo byte)
 111+ 8055 ~                inc  hl
 112+ 8055 ~                ld   a, (hl)
 113+ 8055 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8055 ~                jr   nz, .dur_ok
 115+ 8055 ~                ld   a, 1
 116+ 8055 ~            .dur_ok:
 117+ 8055 ~                ld   (Audio_music_frame_counter), a
 118+ 8055 ~
 119+ 8055 ~            .play_current_note:
 120+ 8055 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8055 ~                ld   a, (Audio_music_note_idx)
 122+ 8055 ~                ld   e, a
 123+ 8055 ~                ld   d, 0
 124+ 8055 ~                ld   hl, Audio_MusicSheet
 125+ 8055 ~                add  hl, de
 126+ 8055 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8055 ~                ld   a, (hl)                  ; A = delay
 128+ 8055 ~                or   a
 129+ 8055 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8055 ~
 131+ 8055 ~                ; Suona la nota: 2 cicli
 132+ 8055 ~                ld   d, a                     ; D = delay
 133+ 8055 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8055 ~            .note_loop:
 135+ 8055 ~                ; Speaker ON
 136+ 8055 ~                ld   a, (room_border_color)
 137+ 8055 ~                or   $10
 138+ 8055 ~                out  ($fe), a
 139+ 8055 ~                ld   c, d
 140+ 8055 ~            .d1:
 141+ 8055 ~                push af
 142+ 8055 ~                pop  af
 143+ 8055 ~                dec  c
 144+ 8055 ~                jr   nz, .d1
 145+ 8055 ~
 146+ 8055 ~                ; Speaker OFF
 147+ 8055 ~                ld   a, (room_border_color)
 148+ 8055 ~                and  $ef
 149+ 8055 ~                out  ($fe), a
 150+ 8055 ~                ld   c, d
 151+ 8055 ~            .d2:
 152+ 8055 ~                push af
 153+ 8055 ~                pop  af
 154+ 8055 ~                dec  c
 155+ 8055 ~                jr   nz, .d2
 156+ 8055 ~
 157+ 8055 ~                djnz .note_loop
 158+ 8055 ~
 159+ 8055 ~            .done:
 160+ 8055 ~                pop  hl
 161+ 8055 ~                pop  de
 162+ 8055 ~                pop  bc
 163+ 8055 ~                pop  af
 164+ 8055 ~                ret
 165+ 8055 ~
 166+ 8055 ~            Audio_MusicSheet:
 167+ 8055 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8055 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8055 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8055 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8055 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8055 ~                db 90, 10, 107, 20, 68, 65
 173+ 8055                  ELSE
 174+ 8055              Audio_UpdateMusic:
 175+ 8055 C9               ret
 176+ 8056                  ENDIF
