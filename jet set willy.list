 107+ 7555              ; -------------------------------------------------------------------
 108+ 7555              ; DetermineCurrentRoomID
 109+ 7555              ;
 110+ 7555              ; Determina l'ID numerico della stanza corrente confrontando
 111+ 7555              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 112+ 7555              ;
 113+ 7555              ; Se viene trovata una corrispondenza:
 114+ 7555              ;   A = ID della stanza
 115+ 7555              ;   current_room = A
 116+ 7555              ;
 117+ 7555              ; Mappatura:
 118+ 7555              ;    0 = The Off Licence
 119+ 7555              ;    1 = The Bridge
 120+ 7555              ;    2 = Under The Mega Tree
 121+ 7555              ;    3 = Gfx_At The Foot Of The Mega Tree
 122+ 7555              ;    4 = The Drive
 123+ 7555              ;    5 = The Security Guard
 124+ 7555              ;    6 = Entrance To Hades
 125+ 7555              ;    7 = Cuckoo's Nest
 126+ 7555              ;    8 = Inside The Mega Trunk
 127+ 7555              ;    9 = On A Branch Over The Drive
 128+ 7555              ;   10 = The Front Door
 129+ 7555              ;   11 = The Hall
 130+ 7555              ;   12 = Tree Top
 131+ 7555              ;   27 = The Chapel
 132+ 7555              ;   33 = The Bathroom
 133+ 7555              ;   35 = Master Bedroom
 134+ 7555              ;
 135+ 7555              ; Se nessuna stanza corrisponde viene impostato:
 136+ 7555              ;   current_room = 0
 137+ 7555              ; -------------------------------------------------------------------
 138+ 7555              DetermineCurrentRoomID:
 139+ 7555
