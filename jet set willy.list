   7+ 8116              ; -------------------------------------------------------------------
   8+ 8116              ; Audio_UpdateJumpSound
   9+ 8116              ;
  10+ 8116              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8116              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8116              ; -------------------------------------------------------------------
  13+ 8116              Audio_UpdateJumpSound:
  14+ 8116 F5               push af
  15+ 8117 C5               push bc
  16+ 8118 D5               push de
  17+ 8119 E5               push hl
  18+ 811A
  19+ 811A                  ; Controlla se il suono è attivo (note < 18)
  20+ 811A 3A 39 EA         ld   a, (Audio_jump_sound_note)
  21+ 811D FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 811F 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8121
  24+ 8121                  ; Carica la nota corrente da suonare
  25+ 8121 5F               ld   e, a
  26+ 8122 16 00            ld   d, 0
  27+ 8124 21 50 81         ld   hl, Audio_JumpSoundDelays
  28+ 8127 19               add  hl, de
  29+ 8128 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8129 57               ld   d, a                      ; D = delay della nota
  31+ 812A
  32+ 812A                  ; Suona la nota: 15 cicli
  33+ 812A 06 0F            ld   b, 15
  34+ 812C              .note_loop:
  35+ 812C                  ; Speaker ON
  36+ 812C 3A 32 E6         ld   a, (room_border_color)
  37+ 812F F6 10            or   $10
  38+ 8131 D3 FE            out  ($fe), a
  39+ 8133 4A               ld   c, d
  40+ 8134              .d1:
  41+ 8134 0D               dec  c
  42+ 8135 20 FD            jr   nz, .d1
  43+ 8137
  44+ 8137                  ; Speaker OFF
  45+ 8137 3A 32 E6         ld   a, (room_border_color)
  46+ 813A E6 EF            and  $ef
  47+ 813C D3 FE            out  ($fe), a
  48+ 813E 4A               ld   c, d
  49+ 813F              .d2:
  50+ 813F 0D               dec  c
  51+ 8140 20 FD            jr   nz, .d2
  52+ 8142
  53+ 8142 10 E8            djnz .note_loop
  54+ 8144
  55+ 8144                  ; Passa alla nota successiva
  56+ 8144 3A 39 EA         ld   a, (Audio_jump_sound_note)
  57+ 8147 3C               inc  a
  58+ 8148 32 39 EA         ld   (Audio_jump_sound_note), a
  59+ 814B
  60+ 814B              .done:
  61+ 814B E1               pop  hl
  62+ 814C D1               pop  de
  63+ 814D C1               pop  bc
  64+ 814E F1               pop  af
  65+ 814F C9               ret
  66+ 8150
  67+ 8150              Audio_JumpSoundDelays:
  68+ 8150 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 8154 19 13 0C 06
  68+ 8158 0C 13 19 20
  68+ 815C 26 2D 33 3A
  68+ 8160 40 47
  69+ 8162
  70+ 8162                  IF ENABLE_MUSIC != 0
  71+ 8162 ~            ; -------------------------------------------------------------------
  72+ 8162 ~            ; Audio_UpdateMusic
  73+ 8162 ~            ;
  74+ 8162 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8162 ~            ; Viene chiamata a ogni frame.
  76+ 8162 ~            ; -------------------------------------------------------------------
  77+ 8162 ~            Audio_UpdateMusic:
  78+ 8162 ~                push af
  79+ 8162 ~                push bc
  80+ 8162 ~                push de
  81+ 8162 ~                push hl
  82+ 8162 ~
  83+ 8162 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8162 ~                ld   a, (Audio_jump_sound_note)
  85+ 8162 ~                cp   18
  86+ 8162 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8162 ~
  88+ 8162 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8162 ~                ld   a, (Audio_music_frame_counter)
  90+ 8162 ~                dec  a
  91+ 8162 ~                ld   (Audio_music_frame_counter), a
  92+ 8162 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8162 ~
  94+ 8162 ~                ; Altrimenti carica la nota successiva
  95+ 8162 ~                ld   a, (Audio_music_note_idx)
  96+ 8162 ~                inc  a
  97+ 8162 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8162 ~                jr   c, .no_wrap
  99+ 8162 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8162 ~            .no_wrap:
 101+ 8162 ~                ld   (Audio_music_note_idx), a
 102+ 8162 ~
 103+ 8162 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8162 ~                ld   e, a
 105+ 8162 ~                ld   d, 0
 106+ 8162 ~                ld   hl, Audio_MusicSheet
 107+ 8162 ~                add  hl, de
 108+ 8162 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8162 ~
 110+ 8162 ~                ; Leggi durata (secondo byte)
 111+ 8162 ~                inc  hl
 112+ 8162 ~                ld   a, (hl)
 113+ 8162 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8162 ~                jr   nz, .dur_ok
 115+ 8162 ~                ld   a, 1
 116+ 8162 ~            .dur_ok:
 117+ 8162 ~                ld   (Audio_music_frame_counter), a
 118+ 8162 ~
 119+ 8162 ~            .play_current_note:
 120+ 8162 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8162 ~                ld   a, (Audio_music_note_idx)
 122+ 8162 ~                ld   e, a
 123+ 8162 ~                ld   d, 0
 124+ 8162 ~                ld   hl, Audio_MusicSheet
 125+ 8162 ~                add  hl, de
 126+ 8162 ~                add  hl, de                   ; hl punta al primo byte della nota
