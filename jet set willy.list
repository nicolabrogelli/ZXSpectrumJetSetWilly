 767+ 79C4              ; -------------------------------------------------------------------
 768+ 79C4              ; Aggiorna le posizioni dei nemici attivi per il prossimo frame
 769+ 79C4              ; -------------------------------------------------------------------
 770+ 79C4              Enemy_Update:
 771+ 79C4 E5               push hl
 772+ 79C5 D5               push de
 773+ 79C6 C5               push bc
 774+ 79C7 DD E5            push ix
 775+ 79C9
 776+ 79C9                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 777+ 79C9 3A 62 EA         ld   a, (enemy_update_rate)
 778+ 79CC FE 01            cp   1
 779+ 79CE 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 780+ 79D0
 781+ 79D0 3A 63 EA         ld   a, (enemy_update_timer)
 782+ 79D3 3C               inc  a
 783+ 79D4 47               ld   b, a                      ; B = timer + 1
 784+ 79D5 3A 62 EA         ld   a, (enemy_update_rate)
 785+ 79D8 B8               cp   b
 786+ 79D9 28 0C            jr   z, .reset_timer
 787+ 79DB 38 0A            jr   c, .reset_timer
 788+ 79DD
 789+ 79DD                  ; Salva contatore incrementato e salta l'aggiornamento
 790+ 79DD 78               ld   a, b
 791+ 79DE 32 63 EA         ld   (enemy_update_timer), a
 792+ 79E1
 793+ 79E1              .skip_update:
 794+ 79E1 DD E1            pop  ix
 795+ 79E3 C1               pop  bc
 796+ 79E4 D1               pop  de
 797+ 79E5 E1               pop  hl
 798+ 79E6 C9               ret
 799+ 79E7
 800+ 79E7              .reset_timer:
 801+ 79E7 AF               xor  a
 802+ 79E8 32 63 EA         ld   (enemy_update_timer), a
 803+ 79EB 18 00            jr   .do_update
 804+ 79ED
 805+ 79ED              .do_update:
 806+ 79ED 3E 01            ld   a, 1
 807+ 79EF 32 E9 EA         ld   (enemy_was_updated), a
 808+ 79F2
 809+ 79F2 DD 21 1F 75      ld   ix, ActiveEnemies
 810+ 79F6 06 08            ld   b, 8              ; 8 slot
 811+ 79F8              .loop:
 812+ 79F8 DD 7E 00         ld   a, (ix+0)         ; Flags
 813+ 79FB E6 80            and  $80               ; Active?
 814+ 79FD CA CF 7A         jp   z, .next
 815+ 7A00
 816+ 7A00                  ; 1. Aggiorna Anim State
 817+ 7A00 DD 7E 01         ld   a, (ix+1)         ; Sprite Type (Offset 1)
 818+ 7A03 E6 3F            and  $3F               ; Tipo
 819+ 7A05 FE 0D            cp   13                ; Tipo 13 = Canguro?
 820+ 7A07 28 2A            jr   z, .canguro_anim
 821+ 7A09 FE 0B            cp   11                ; Tipo 11 = Soldato?
 822+ 7A0B 28 1B            jr   z, .soldato_anim
 823+ 7A0D FE 10            cp   16                ; Tipo 16 = Candelabro?
 824+ 7A0F 28 17            jr   z, .soldato_anim
 825+ 7A11 FE 14            cp   20                ; Tipo 20 = Nonnino?
 826+ 7A13 28 13            jr   z, .soldato_anim
 827+ 7A15 FE 15            cp   21                ; Tipo 21 = Parrucca?
 828+ 7A17 28 0F            jr   z, .soldato_anim
 829+ 7A19 FE 1D            cp   29                ; Tipo 29 = Saliera?
 830+ 7A1B 28 0B            jr   z, .soldato_anim
 831+ 7A1D
 832+ 7A1D DD 7E 07         ld   a, (ix+7)         ; Anim State (Offset 7)
 833+ 7A20 3C               inc  a
 834+ 7A21 E6 03            and  3                 ; Alterna 0..3
 835+ 7A23 DD 77 07         ld   (ix+7), a
 836+ 7A26 18 14            jr   .anim_done
 837+ 7A28
 838+ 7A28              .soldato_anim:
 839+ 7A28 DD 7E 07         ld   a, (ix+7)         ; Anim State
 840+ 7A2B 3C               inc  a
 841+ 7A2C E6 01            and  1                 ; Alterna 0..1
 842+ 7A2E DD 77 07         ld   (ix+7), a
 843+ 7A31 18 09            jr   .anim_done
 844+ 7A33
 845+ 7A33              .canguro_anim:
 846+ 7A33 DD 7E 07         ld   a, (ix+7)         ; Anim State
 847+ 7A36 3C               inc  a
 848+ 7A37 E6 07            and  7                 ; Alterna 0..7
 849+ 7A39 DD 77 07         ld   (ix+7), a
 850+ 7A3C
 851+ 7A3C              .anim_done:
 852+ 7A3C
 853+ 7A3C                  ; 3. Determina se orizzontale o verticale
 854+ 7A3C DD 7E 00         ld   a, (ix+0)         ; Flags
 855+ 7A3F E6 40            and  $40               ; Vertical? (Bit 6)
 856+ 7A41 C2 8B 7A         jp   nz, .vertical
 857+ 7A44
 858+ 7A44              .horizontal:
 859+ 7A44 DD 7E 06         ld   a, (ix+6)         ; Direction (1=Left, 2=Right) (Offset 6)
 860+ 7A47 FE 01            cp   1
 861+ 7A49 20 20            jr   nz, .horiz_right
 862+ 7A4B
 863+ 7A4B              .horiz_left:
 864+ 7A4B DD 7E 02         ld   a, (ix+2)         ; Current X
 865+ 7A4E D6 02            sub  2                 ; Muovi a sinistra di 2 pixel
 866+ 7A50 DD BE 04         cp   (ix+4)            ; Min Limit (Offset 4)
 867+ 7A53 28 08            jr   z, .h_rev_right
 868+ 7A55 38 06            jr   c, .h_rev_right
 869+ 7A57 DD 77 02         ld   (ix+2), a
 870+ 7A5A C3 CF 7A         jp   .next
 871+ 7A5D
 872+ 7A5D              .h_rev_right:
 873+ 7A5D DD 7E 04         ld   a, (ix+4)         ; Min Limit
 874+ 7A60 DD 77 02         ld   (ix+2), a
 875+ 7A63 3E 02            ld   a, 2
 876+ 7A65 DD 77 06         ld   (ix+6), a         ; Cambia direzione a Destra (Offset 6)
 877+ 7A68 C3 CF 7A         jp   .next
 878+ 7A6B
 879+ 7A6B              .horiz_right:
 880+ 7A6B DD 7E 02         ld   a, (ix+2)         ; Current X
 881+ 7A6E C6 02            add  a, 2              ; Muovi a destra di 2 pixel
 882+ 7A70 DD BE 05         cp   (ix+5)            ; Max Limit (Offset 5)
 883+ 7A73 28 08            jr   z, .h_rev_left
 884+ 7A75 30 06            jr   nc, .h_rev_left
 885+ 7A77 DD 77 02         ld   (ix+2), a
 886+ 7A7A C3 CF 7A         jp   .next
 887+ 7A7D
 888+ 7A7D              .h_rev_left:
 889+ 7A7D DD 7E 05         ld   a, (ix+5)         ; Max Limit
 890+ 7A80 DD 77 02         ld   (ix+2), a
 891+ 7A83 3E 01            ld   a, 1
 892+ 7A85 DD 77 06         ld   (ix+6), a         ; Cambia direzione a Sinistra
 893+ 7A88 C3 CF 7A         jp   .next
 894+ 7A8B
 895+ 7A8B              .vertical:
 896+ 7A8B DD 7E 06         ld   a, (ix+6)         ; Direction (1=Up, 2=Down)
 897+ 7A8E FE 01            cp   1
 898+ 7A90 20 20            jr   nz, .vert_down
 899+ 7A92
 900+ 7A92              .vert_up:
 901+ 7A92 DD 7E 03         ld   a, (ix+3)         ; Current Y
 902+ 7A95 D6 02            sub  2                 ; Muovi in alto di 2 pixel
 903+ 7A97 DD BE 04         cp   (ix+4)            ; Min Limit (Top)
 904+ 7A9A 28 08            jr   z, .v_rev_down
 905+ 7A9C 38 06            jr   c, .v_rev_down
 906+ 7A9E DD 77 03         ld   (ix+3), a
 907+ 7AA1 C3 CF 7A         jp   .next
 908+ 7AA4
 909+ 7AA4              .v_rev_down:
 910+ 7AA4 DD 7E 04         ld   a, (ix+4)         ; Min Limit
 911+ 7AA7 DD 77 03         ld   (ix+3), a
 912+ 7AAA 3E 02            ld   a, 2
 913+ 7AAC DD 77 06         ld   (ix+6), a         ; Cambia direzione in Basso
 914+ 7AAF C3 CF 7A         jp   .next
 915+ 7AB2
 916+ 7AB2              .vert_down:
 917+ 7AB2 DD 7E 03         ld   a, (ix+3)         ; Current Y
 918+ 7AB5 C6 02            add  a, 2              ; Muovi in basso di 2 pixel
 919+ 7AB7 DD BE 05         cp   (ix+5)            ; Max Limit (Bottom)
 920+ 7ABA 28 08            jr   z, .v_rev_up
 921+ 7ABC 30 06            jr   nc, .v_rev_up
 922+ 7ABE DD 77 03         ld   (ix+3), a
 923+ 7AC1 C3 CF 7A         jp   .next
 924+ 7AC4
 925+ 7AC4              .v_rev_up:
 926+ 7AC4 DD 7E 05         ld   a, (ix+5)         ; Max Limit
 927+ 7AC7 DD 77 03         ld   (ix+3), a
 928+ 7ACA 3E 01            ld   a, 1
 929+ 7ACC DD 77 06         ld   (ix+6), a         ; Cambia direzione in Alto
