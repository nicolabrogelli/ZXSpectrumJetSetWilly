1139+ 74E7                  ; 1. Calcola l'indice della cella: Row * 32 + Col
1140+ 74E7 26 00            ld   h, 0
1141+ 74E9 68               ld   l, b          ; HL = Row
1142+ 74EA 29               add  hl, hl
1143+ 74EB 29               add  hl, hl
1144+ 74EC 29               add  hl, hl
1145+ 74ED 29               add  hl, hl
1146+ 74EE 29               add  hl, hl        ; HL = Row * 32
1147+ 74EF 16 00            ld   d, 0
1148+ 74F1 59               ld   e, c          ; DE = Col
1149+ 74F2 19               add  hl, de        ; HL = Row * 32 + Col
1150+ 74F3
1151+ 74F3                  ; 2. Leggi il tipo di cella (0..3) da unpacked_layout + HL
1152+ 74F3 11 FB 7B         ld   de, unpacked_layout
1153+ 74F6 19               add  hl, de        ; HL = unpacked_layout + index
1154+ 74F7 7E               ld   a, (hl)       ; A = cell type (0..3)
