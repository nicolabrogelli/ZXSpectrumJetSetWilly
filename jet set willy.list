 257+ 5EDB
 258+ 5EDB              .check_ramp:
 259+ 5EDB 3A 4D 7D         ld   a, (ramp_len)
 260+ 5EDE B7               or   a
 261+ 5EDF CA 0F 5F         jp   z, .normal_grid
 262+ 5EE2
