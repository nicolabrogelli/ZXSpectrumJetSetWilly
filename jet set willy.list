1079+ 751D 3C               inc  a                 ; A = ramp_col - ramp_len + 1
1080+ 751E 47               ld   b, a              ; B = limit_left
1081+ 751F
1082+ 751F 3A 85 EE         ld   a, (ramp_col)
1083+ 7522 3C               inc  a
1084+ 7523 4F               ld   c, a              ; C = limit_right (exclusive)
1085+ 7524
1086+ 7524 7B               ld   a, e              ; A = Col
1087+ 7525 B8               cp   b
1088+ 7526 38 15            jr   c, .check_platform_case
1089+ 7528 B9               cp   c
1090+ 7529 30 12            jr   nc, .check_platform_case
