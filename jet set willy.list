  83+ 653F              ; MOVIMENTO SINISTRA
  84+ 653F              ; ===============================================================
  85+ 653F              movePlayer_left:
  86+ 653F
  87+ 653F                  ; Calcola nuova posizione: X - speed
  88+ 653F 3A FE 7E         ld   a, (player_speed)
  89+ 6542 5F               ld   e, a
  90+ 6543
  91+ 6543 79               ld   a, c
  92+ 6544 93               sub  e
  93+ 6545
  94+ 6545                  ; Controllo limite sinistro schermo
  95+ 6545 FE 05            cp   PLAYER_MIN_X
  96+ 6547 38 11            jr   c, .clamp_left
  97+ 6549
  98+ 6549                  ; -----------------------------------------------------------
  99+ 6549                  ; Collisione con muro (pre-check)
 100+ 6549                  ; -----------------------------------------------------------
 101+ 6549 C5               push bc
 102+ 654A 4F               ld   c, a
 103+ 654B CD 85 6C         call CheckWillyWallCollision
 104+ 654E C1               pop  bc
