1206+ 7388                  ;
1207+ 7388                  ; Input richiesto:
1208+ 7388                  ;   A = ItemX
1209+ 7388                  ;   H = ItemY
1210+ 7388                  ; ---------------------------------------------------------------
1211+ 7388 79               ld   a, c
1212+ 7389
1213+ 7389 E5               push hl                ; salva puntatore al flag Collected
1214+ 738A
1215+ 738A 60               ld   h, b
1216+ 738B
1217+ 738B CD 26 73         call CheckWillyItemCollision
1218+ 738E
1219+ 738E E1               pop  hl
1220+ 738F
1221+ 738F                  ; Nessuna collisione
1222+ 738F 30 30            jr   nc, .next_no_inc
1223+ 7391
1224+ 7391                  ; ===============================================================
1225+ 7391                  ; ITEM RACCOLTO
1226+ 7391                  ; ===============================================================
1227+ 7391
1228+ 7391                  ; ---------------------------------------------------------------
1229+ 7391                  ; Marca l'item come raccolto
1230+ 7391                  ; ---------------------------------------------------------------
1231+ 7391 36 01            ld   (hl), 1
1232+ 7393
1233+ 7393                  ; ---------------------------------------------------------------
1234+ 7393                  ; Rimuove l'item dalla cache items_grid
1235+ 7393                  ;
1236+ 7393                  ; Calcolo:
1237+ 7393                  ;   offset = Row * 32 + Col
1238+ 7393                  ; ---------------------------------------------------------------
1239+ 7393 E5               push hl
1240+ 7394 D5               push de
1241+ 7395
1242+ 7395 26 00            ld   h, 0
1243+ 7397 68               ld   l, b              ; HL = Row
1244+ 7398
1245+ 7398 29               add  hl, hl            ; *2
1246+ 7399 29               add  hl, hl            ; *4
1247+ 739A 29               add  hl, hl            ; *8
1248+ 739B 29               add  hl, hl            ; *16
1249+ 739C 29               add  hl, hl            ; *32
1250+ 739D
1251+ 739D 59               ld   e, c
1252+ 739E 16 00            ld   d, 0
1253+ 73A0
1254+ 73A0 19               add  hl, de            ; Row*32 + Col
1255+ 73A1
1256+ 73A1 11 00 B0         ld   de, items_grid
1257+ 73A4 19               add  hl, de
1258+ 73A5
1259+ 73A5                  ; La cella non contiene più un item
1260+ 73A5 36 00            ld   (hl), 0
1261+ 73A7
1262+ 73A7 D1               pop  de
1263+ 73A8 E1               pop  hl
1264+ 73A9
1265+ 73A9                  ; ---------------------------------------------------------------
1266+ 73A9                  ; Conserva il puntatore all'entry corrente
1267+ 73A9                  ; poiché le routine successive possono alterare HL.
1268+ 73A9                  ; ---------------------------------------------------------------
1269+ 73A9 E5               push hl
1270+ 73AA
1271+ 73AA                  ; ---------------------------------------------------------------
1272+ 73AA                  ; Aggiorna il numero di oggetti raccolti
