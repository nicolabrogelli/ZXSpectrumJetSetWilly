 187+ 7FFF
 188+ 7FFF              ; -------------------------------------------------------------------
 189+ 7FFF              ; DetermineCurrentRoomID
 190+ 7FFF              ;
 191+ 7FFF              ; Determina l'ID numerico della stanza corrente confrontando
 192+ 7FFF              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 193+ 7FFF              ;
 194+ 7FFF              ; Se viene trovata una corrispondenza:
 195+ 7FFF              ;   A = ID della stanza
 196+ 7FFF              ;   current_room = A
 197+ 7FFF              ;
 198+ 7FFF              ; Mappatura:
 199+ 7FFF              ;    0 = The Off Licence
 200+ 7FFF              ;    1 = The Bridge
 201+ 7FFF              ;    2 = Under The Mega Tree
 202+ 7FFF              ;    3 = Gfx_At The Foot Of The Mega Tree
 203+ 7FFF              ;    4 = The Drive
 204+ 7FFF              ;    5 = The Security Guard
 205+ 7FFF              ;    6 = Entrance To Hades
 206+ 7FFF              ;    7 = Cuckoo's Nest
 207+ 7FFF              ;    8 = Inside The Mega Trunk
 208+ 7FFF              ;    9 = On A Branch Over The Drive
 209+ 7FFF              ;   10 = The Front Door
 210+ 7FFF              ;   11 = The Hall
 211+ 7FFF              ;   12 = Tree Top
 212+ 7FFF              ;   27 = The Chapel
 213+ 7FFF              ;   28 = First Landing
 214+ 7FFF              ;   29 = The Nightmare Room
 215+ 7FFF              ;   33 = The Bathroom
 216+ 7FFF              ;   35 = Master Bedroom
 217+ 7FFF              ;
 218+ 7FFF              ; Se nessuna stanza corrisponde viene impostato:
 219+ 7FFF              ;   current_room = 0
 220+ 7FFF              ; -------------------------------------------------------------------
 221+ 7FFF              DetermineCurrentRoomID:
 222+ 7FFF
 223+ 7FFF                  ; Salva i registri utilizzati
 224+ 7FFF E5               push hl
 225+ 8000 D5               push de
 226+ 8001
 227+ 8001                  ; ---------------------------------------------------------------
 228+ 8001                  ; Confronto con TheOffLicenceLayout
 229+ 8001                  ; ---------------------------------------------------------------
 230+ 8001 2A 6A EE         ld   hl, (room_ptr)
 231+ 8004 11 C4 88         ld   de, TheOffLicenceLayout
 232+ 8007 B7               or   a
 233+ 8008 ED 52            sbc  hl, de
 234+ 800A 20 05            jr   nz, .not_office
 235+ 800C
 236+ 800C 3E 00            ld   a, 0               ; Room ID = 0
 237+ 800E C3 D3 83         jp   .set_room
 238+ 8011
 239+ 8011              .not_office:
 240+ 8011
 241+ 8011                  ; -------------------------------------------------q--------------
 242+ 8011                  ; Confronto con TheBridgeLayout
