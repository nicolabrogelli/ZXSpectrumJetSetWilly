  77+ EE25 00           willy_on_ramp:         db 0 ; 1 = Willy posizionato su rampa (debug)
  78+ EE26
  79+ EE26              ; Gestione Tempo di Gioco (Orologio)
  80+ EE26 07           time_hours:                 db 7     ; Ora iniziale: 07:00 AM
  81+ EE27 00           time_minutes:               db 0     ; Minuti iniziali: 0
  82+ EE28 00           time_period:                db 0     ; 0 = AM, 1 = PM
  83+ EE29 00 00        time_last_counter:          dw 0     ; Tick hardware IM2 (50Hz) dell'ultimo scatto minuto
  84+ EE2B 00           game_objective_completed:   db 0     ; 1 = Obiettivo completato, 0 = Non completato
  85+ EE2C
  86+ EE2C 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
  87+ EE2D 00           Audio_jump_sound_timer:   db 0
  88+ EE2E                  IF ENABLE_MUSIC != 0
  89+ EE2E ~            Audio_music_note_idx:      db 0
  90+ EE2E ~            Audio_music_frame_counter: db 1
  91+ EE2E                  ENDIF
  92+ EE2E
