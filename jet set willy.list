  10+ 689A              CheckCtrl:
  11+ 689A 16 00            ld  d, $00
  12+ 689C 3E FE            ld  a, $fe
  13+ 689E DB FE            in  a, ($fe)
  14+ 68A0 DD 21 7F 6D      ld  ix,flags
  15+ 68A4
  16+ 68A4              checkCtrl_left:
  17+ 68A4 CB 4F            bit $01, a
  18+ 68A6 20 0D            jr  nz, checkCtrl_right
  19+ 68A8 CB C2            set $00, d
  20+ 68AA DD CB 00 C6      set 0,(ix)
  21+ 68AE 5F               ld  e, a
  22+ 68AF 3E 01            ld  a, 1
  23+ 68B1 32 7E 6D         ld  (direction), a
  24+ 68B4 7B               ld  a, e
  25+ 68B5
  26+ 68B5              checkCtrl_right:
  27+ 68B5 CB 57            bit $02, a
  28+ 68B7 20 0D            jr  nz, checkCtrl_jump
  29+ 68B9 CB CA            set $01, d
  30+ 68BB DD CB 00 C6      set 0,(ix)
  31+ 68BF 5F               ld  e, a
  32+ 68C0 3E 02            ld  a, 2
  33+ 68C2 32 7E 6D         ld  (direction), a
  34+ 68C5 7B               ld  a, e
  35+ 68C6
  36+ 68C6              checkCtrl_jump:
