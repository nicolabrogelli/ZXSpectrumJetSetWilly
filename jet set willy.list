1815+ 79D8              ; -------------------------------------------------------------------
1816+ 79D8              ; Carica le impostazioni di salto e gravità specifiche per la stanza corrente
1817+ 79D8              ; Legge il byte di configurazione ad offset OFFSET_PHYSICS_SETTINGS (239).
1818+ 79D8              ; Se è 0, applica le impostazioni di default (Jump = 6, Gravity = 1).
1819+ 79D8              ; Altrimenti, decodifica il formato %GGGGJJJJ (Jump = JJJJ, Gravity Preset = GGGG).
1820+ 79D8              ; -------------------------------------------------------------------
1821+ 79D8              Phys_LoadRoomSettings:
1822+ 79D8 E5               push hl
1823+ 79D9 D5               push de
1824+ 79DA F5               push af
1825+ 79DB
1826+ 79DB 2A 62 F8         ld   hl, (room_ptr)
1827+ 79DE 11 EF 00         ld   de, OFFSET_PHYSICS_SETTINGS
