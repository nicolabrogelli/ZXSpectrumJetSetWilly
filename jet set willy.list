 428+ 5F9B 7A               ld   a, d
 429+ 5F9C B6               or   (hl)
 430+ 5F9D 77               ld   (hl), a
 431+ 5F9E 23               inc  hl
 432+ 5F9F 7B               ld   a, e
 433+ 5FA0 B6               or   (hl)
