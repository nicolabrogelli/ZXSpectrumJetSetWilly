 231+ 7548              ; -------------------------------------------------------------------
 232+ 7548              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 233+ 7548              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 234+ 7548              ; -------------------------------------------------------------------
 235+ 7548              DrawItemGraphic:
 236+ 7548 C5               push bc
 237+ 7549 D5               push de
 238+ 754A E5               push hl
 239+ 754B
 240+ 754B                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 241+ 754B 78               ld   a, b
 242+ 754C E6 18            and  $18
 243+ 754E C6 40            add  a, $40
 244+ 7550 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 245+ 7551
 246+ 7551 78               ld   a, b
 247+ 7552 E6 07            and  7
 248+ 7554 87               add  a, a              ; *2
 249+ 7555 87               add  a, a              ; *4
 250+ 7556 87               add  a, a              ; *8
 251+ 7557 87               add  a, a              ; *16
 252+ 7558 87               add  a, a              ; *32
 253+ 7559 81               add  a, c              ; + Col C
 254+ 755A 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 255+ 755B
 256+ 755B                  ; 2. Copia gli 8 byte del bitmap dello sprite
 257+ 755B C5               push bc                ; Salva BC (contiene Row e Col)
 258+ 755C 06 08            ld   b, 8              ; 8 scanline
 259+ 755E              .line_loop:
 260+ 755E 7E               ld   a, (hl)
 261+ 755F 12               ld   (de), a
 262+ 7560 14               inc  d                 ; Prossima scanline
 263+ 7561 23               inc  hl
 264+ 7562 05               dec  b
 265+ 7563 20 F9            jr   nz, .line_loop
 266+ 7565 C1               pop  bc                ; Ripristina BC
 267+ 7566
 268+ 7566                  ; 3. Calcola l'indirizzo degli attributi dello schermo
 269+ 7566                  ; HL = $5800 + B * 32 + C
 270+ 7566 26 00            ld   h, 0
 271+ 7568 68               ld   l, b              ; HL = B (Row)
 272+ 7569 29               add  hl, hl            ; *2
 273+ 756A 29               add  hl, hl            ; *4
 274+ 756B 29               add  hl, hl            ; *8
 275+ 756C 29               add  hl, hl            ; *16
 276+ 756D 29               add  hl, hl            ; *32
 277+ 756E
 278+ 756E 79               ld   a, c              ; A = Col
 279+ 756F 85               add  a, l
 280+ 7570 6F               ld   l, a
 281+ 7571 30 01            jr   nc, .no_carry
 282+ 7573 24               inc  h
 283+ 7574              .no_carry:
 284+ 7574                  ; HL = B * 32 + C
 285+ 7574 11 00 58         ld   de, $5800
 286+ 7577 19               add  hl, de            ; HL = AttrAddr
 287+ 7578
 288+ 7578                  ; Ripristina i registri dallo stack per estrarre il colore in E
 289+ 7578                  ; Lo stack ha: HL (originale), DE (originale con colore in E), BC (originale)
 290+ 7578 C1               pop  bc                ; BC = HL originale
 291+ 7579 D1               pop  de                ; DE = DE originale (colore in E)
 292+ 757A
 293+ 757A 7B               ld   a, e              ; A = Colore
 294+ 757B 77               ld   (hl), a           ; Scrivi in memoria attributi (HL)
 295+ 757C
 296+ 757C                  ; Ripristina lo stack e i registri originari
 297+ 757C C5               push bc                ; Rimetti HL originale sulla pila
 298+ 757D E1               pop  hl                ; HL = HL originale
 299+ 757E C1               pop  bc                ; BC = BC originale
 300+ 757F C9               ret
