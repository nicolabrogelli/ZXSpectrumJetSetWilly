696+  60C1              ; -------------------------------------------------------------------
697+  60C1              ; Disegna la piattaforma a riga 15 (Y = 120), colonne da 8 a 23 (CYAN)
698+  60C1              ; e la seconda piattaforma a riga 12 (Y = 96), colonne da 20 a 29 (GREEN)
699+  60C1              ; -------------------------------------------------------------------
700+  60C1              DrawPlatform:
701+  60C1 C5               push bc
702+  60C2 D5               push de
703+  60C3 E5               push hl
704+  60C4 DD E5            push ix
705+  60C6
706+  60C6                  ; --- PIATTAFORMA 1 ---
707+  60C6                  ; Disegniamo le 7 scanline della riga 15
708+  60C6 DD 21 62 61      ld   ix, TilesDef + 64 ; Puntatore alla grafica del bordo/pavimento (9° carattere)
709+  60CA 16 00            ld   d, 0              ; D = offset scanline (0..6)
710+  60CC
711+  60CC              .scanline_loop1:
712+  60CC 3E 48            ld   a, $48            ; Base del secondo terzo (Third 1) per scanline 0, riga 15
713+  60CE 82               add  a, d              ; A = $48 + scanline offset (D)
714+  60CF 67               ld   h, a              ; HL high byte = $48 + D
715+  60D0 2E E8            ld   l, $E0 + 8        ; HL low byte = $E0 (riga 15) + 8 (colonna 8)
716+  60D2
717+  60D2 DD 5E 00         ld   e, (ix+0)         ; E = byte grafico per questa scanline
718+  60D5 0E 10            ld   c, 16             ; 16 colonne (da colonna 8 a 23 incluse)
719+  60D7
720+  60D7              .col_loop1:
721+  60D7 7E               ld   a, (hl)           ; Leggi byte dallo schermo
722+  60D8 B3               or   e                 ; Combina con la grafica della piattaforma (OR)
723+  60D9 77               ld   (hl), a           ; Scrivi il byte combinato sullo schermo
724+  60DA 2C               inc  l                 ; Vai alla colonna successiva
725+  60DB 0D               dec  c
726+  60DC 20 F9            jr   nz, .col_loop1
727+  60DE
728+  60DE DD 23            inc  ix                ; Prossimo byte grafico
729+  60E0 14               inc  d                 ; Prossima scanline
730+  60E1 7A               ld   a, d
