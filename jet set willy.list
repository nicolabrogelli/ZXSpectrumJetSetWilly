 931+ 6AFF              ; -------------------------------------------------------------------
 932+ 6AFF              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 933+ 6AFF              ; Input: C = X, B = Y
 934+ 6AFF              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 935+ 6AFF              ; -------------------------------------------------------------------
 936+ 6AFF              CheckWallCell:
 937+ 6AFF E5               push hl
 938+ 6B00 D5               push de
 939+ 6B01 C5               push bc
 940+ 6B02
 941+ 6B02                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 942+ 6B02 78               ld   a, b
 943+ 6B03 FE 80            cp   128
 944+ 6B05 30 1F            jr   nc, .not_wall
 945+ 6B07
 946+ 6B07                  ; 2. Calcola riga di layout: r = Y / 8
 947+ 6B07 CB 3F            srl  a
 948+ 6B09 CB 3F            srl  a
 949+ 6B0B CB 3F            srl  a                 ; A = r (0..15)
 950+ 6B0D
 951+ 6B0D                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 952+ 6B0D 5F               ld   e, a              ; E = r (Row)
 953+ 6B0E 79               ld   a, c
 954+ 6B0F CB 3F            srl  a
 955+ 6B11 CB 3F            srl  a
 956+ 6B13 CB 3F            srl  a                 ; A = c (0..31)
 957+ 6B15 4F               ld   c, a              ; C = c (Col)
 958+ 6B16
 959+ 6B16                  ; Se la cella è sulla rampa, non considerarla un muro!
 960+ 6B16 53               ld   d, e              ; D = Row
 961+ 6B17 59               ld   e, c              ; E = Col
 962+ 6B18 CD 84 6A         call IsCellOnRamp
 963+ 6B1B 38 09            jr   c, .not_wall
 964+ 6B1D
 965+ 6B1D 7A               ld   a, d              ; A = Row
 966+ 6B1E 4B               ld   c, e              ; C = Col
 967+ 6B1F CD 7F 6B         call GetCellFromUnpacked ; A = cell type
 968+ 6B22
 969+ 6B22                  ; Controlla se è Wall (2)
 970+ 6B22 FE 02            cp   2
 971+ 6B24 28 05            jr   z, .is_wall
 972+ 6B26
 973+ 6B26              .not_wall:
 974+ 6B26 C1               pop  bc
 975+ 6B27 D1               pop  de
 976+ 6B28 E1               pop  hl
