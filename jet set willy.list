 601+ 70CC FE 01            cp   1
 602+ 70CE 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 603+ 70D0
 604+ 70D0 3A 40 7A         ld   a, (enemy_update_timer)
 605+ 70D3 3C               inc  a
 606+ 70D4 47               ld   b, a                      ; B = timer + 1
 607+ 70D5 3A 3F 7A         ld   a, (enemy_update_rate)
 608+ 70D8 B8               cp   b
 609+ 70D9 28 0C            jr   z, .reset_timer
 610+ 70DB 38 0A            jr   c, .reset_timer
 611+ 70DD
 612+ 70DD                  ; Salva contatore incrementato e salta l'aggiornamento
 613+ 70DD 78               ld   a, b
 614+ 70DE 32 40 7A         ld   (enemy_update_timer), a
