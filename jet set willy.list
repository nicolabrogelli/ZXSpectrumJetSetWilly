1280+ 7447 3A AA 75         ld   a, (items_collected)
1281+ 744A
1282+ 744A 3C               inc  a
1283+ 744B
1284+ 744B 32 AA 75         ld   (items_collected), a
1285+ 744E
1286+ 744E                  ; ---------------------------------------------------------------
