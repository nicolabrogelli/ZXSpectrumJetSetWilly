 322+ 7071              ; -------------------------------------------------------------------
 323+ 7071              ; DrawRoomItems
 324+ 7071              ;
 325+ 7071              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 326+ 7071              ;
 327+ 7071              ; Operazioni eseguite:
 328+ 7071              ;   1. Azzera la griglia items_grid.
 329+ 7071              ;   2. Svuota la cache degli oggetti attivi.
 330+ 7071              ;   3. Scansiona ItemsTable.
 331+ 7071              ;   4. Per ogni item della stanza corrente:
 332+ 7071              ;        - verifica se è già stato raccolto
 333+ 7071              ;        - disegna la grafica
 334+ 7071              ;        - aggiorna items_grid
 335+ 7071              ;        - memorizza l'item nella cache current_room_items
 336+ 7071              ;   5. Aggiorna num_room_items.
 337+ 7071              ;
 338+ 7071              ; Record ItemsTable:
 339+ 7071              ;   +0  Room ID
 340+ 7071              ;   +1  X (colonna)
 341+ 7071              ;   +2  Y (riga)
 342+ 7071              ;   +3  Colore
 343+ 7071              ;   +4  Collected flag
 344+ 7071              ;
 345+ 7071              ; Cache current_room_items:
 346+ 7071              ;   +0  Colonna
 347+ 7071              ;   +1  Riga
 348+ 7071              ;   +2  Colore
 349+ 7071              ;   +3  Collected flag ptr (Low)
 350+ 7071              ;   +4  Collected flag ptr (High)
 351+ 7071              ;
 352+ 7071              ; Ogni record cache occupa 5 byte.
 353+ 7071              ; -------------------------------------------------------------------
 354+ 7071              DrawRoomItems:
 355+ 7071
 356+ 7071                  ; Salva tutti i registri utilizzati
 357+ 7071 E5               push hl
 358+ 7072 D5               push de
 359+ 7073 C5               push bc
 360+ 7074 DD E5            push ix
 361+ 7076 FD E5            push iy
 362+ 7078
 363+ 7078                  ; ---------------------------------------------------------------
 364+ 7078                  ; Azzera items_grid (32 x 16 = 512 byte)
 365+ 7078                  ; ---------------------------------------------------------------
 366+ 7078 21 00 90         ld   hl, items_grid
 367+ 707B 11 01 90         ld   de, items_grid + 1
 368+ 707E 36 00            ld   (hl), 0
 369+ 7080 01 FF 01         ld   bc, 511
 370+ 7083 ED B0            ldir
 371+ 7085
 372+ 7085                  ; ---------------------------------------------------------------
 373+ 7085                  ; Nessun item attivo nella stanza
 374+ 7085                  ; ---------------------------------------------------------------
 375+ 7085 AF               xor  a
 376+ 7086 32 C4 75         ld   (num_room_items), a
 377+ 7089
 378+ 7089                  ; IY punta alla cache degli item attivi
 379+ 7089 FD 21 74 75      ld   iy, current_room_items
 380+ 708D
 381+ 708D                  ; ---------------------------------------------------------------
 382+ 708D                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 383+ 708D                  ; alla stanza corrente.
 384+ 708D                  ;
 385+ 708D                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 386+ 708D                  ; ---------------------------------------------------------------
 387+ 708D 2A C5 75         ld   hl, (room_ptr)
 388+ 7090 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 389+ 7093 19               add  hl, de
 390+ 7094
 391+ 7094 E5               push hl
 392+ 7095 DD E1            pop  ix                ; IX = bitmap item
 393+ 7097
 394+ 7097                  ; ---------------------------------------------------------------
 395+ 7097                  ; Inizio scansione della tabella degli item
 396+ 7097                  ; ---------------------------------------------------------------
 397+ 7097 21 21 6F         ld   hl, ItemsTable
 398+ 709A
 399+ 709A              .loop:
 400+ 709A
 401+ 709A                  ; ---------------------------------------------------------------
 402+ 709A                  ; Legge il Room ID del record corrente
 403+ 709A                  ; ---------------------------------------------------------------
 404+ 709A 7E               ld   a, (hl)
 405+ 709B
 406+ 709B                  ; $FF indica fine tabella
 407+ 709B FE FF            cp   $FF
 408+ 709D 28 53            jr   z, .done
 409+ 709F
 410+ 709F                  ; ---------------------------------------------------------------
 411+ 709F                  ; Verifica se l'item appartiene alla stanza corrente
 412+ 709F                  ; ---------------------------------------------------------------
 413+ 709F 57               ld   d, a
 414+ 70A0
 415+ 70A0 3A 6B 75         ld   a, (current_room)
 416+ 70A3 BA               cp   d
 417+ 70A4 20 45            jr   nz, .next_item
 418+ 70A6
 419+ 70A6                  ; ---------------------------------------------------------------
 420+ 70A6                  ; Legge i dati dell'item
 421+ 70A6                  ; ---------------------------------------------------------------
 422+ 70A6
 423+ 70A6 23               inc  hl
 424+ 70A7 4E               ld   c, (hl)           ; X (colonna)
 425+ 70A8
 426+ 70A8 23               inc  hl
 427+ 70A9 46               ld   b, (hl)           ; Y (riga)
 428+ 70AA
 429+ 70AA 23               inc  hl
 430+ 70AB 5E               ld   e, (hl)           ; Colore
 431+ 70AC
 432+ 70AC 23               inc  hl
 433+ 70AD 7E               ld   a, (hl)           ; Collected flag
 434+ 70AE
 435+ 70AE                  ; Se diverso da zero l'item è già stato raccolto
 436+ 70AE B7               or   a
 437+ 70AF 20 3E            jr   nz, .next_no_inc
 438+ 70B1
 439+ 70B1                  ; ---------------------------------------------------------------
 440+ 70B1                  ; Disegna l'item sullo schermo
 441+ 70B1                  ;
 442+ 70B1                  ; B = Row
 443+ 70B1                  ; C = Column
 444+ 70B1                  ; HL = bitmap pointer
 445+ 70B1                  ; E = Color
 446+ 70B1                  ; ---------------------------------------------------------------
 447+ 70B1 E5               push hl
 448+ 70B2
 449+ 70B2 DD E5            push ix
 450+ 70B4 E1               pop  hl
 451+ 70B5
 452+ 70B5 CD FA 70         call DrawItemGraphic
 453+ 70B8
 454+ 70B8 E1               pop  hl                ; ritorna al flag collected
 455+ 70B9
 456+ 70B9                  ; ---------------------------------------------------------------
 457+ 70B9                  ; Aggiorna items_grid
 458+ 70B9                  ;
 459+ 70B9                  ; Calcolo:
 460+ 70B9                  ;   offset = Row * 32 + Col
 461+ 70B9                  ; ---------------------------------------------------------------
 462+ 70B9 E5               push hl
 463+ 70BA D5               push de
 464+ 70BB
 465+ 70BB 26 00            ld   h, 0
 466+ 70BD 68               ld   l, b              ; HL = Row
 467+ 70BE
 468+ 70BE 29               add  hl, hl            ; *2
 469+ 70BF 29               add  hl, hl            ; *4
 470+ 70C0 29               add  hl, hl            ; *8
 471+ 70C1 29               add  hl, hl            ; *16
 472+ 70C2 29               add  hl, hl            ; *32
 473+ 70C3
 474+ 70C3 16 00            ld   d, 0
 475+ 70C5 59               ld   e, c              ; DE = Col
 476+ 70C6
 477+ 70C6 19               add  hl, de            ; Row*32 + Col
 478+ 70C7
 479+ 70C7 11 00 90         ld   de, items_grid
 480+ 70CA 19               add  hl, de            ; puntatore nella griglia
 481+ 70CB
 482+ 70CB D1               pop  de                ; ripristina colore
 483+ 70CC
 484+ 70CC 73               ld   (hl), e           ; salva colore cella
 485+ 70CD
 486+ 70CD E1               pop  hl
 487+ 70CE
 488+ 70CE                  ; ---------------------------------------------------------------
 489+ 70CE                  ; Salva l'item nella cache della stanza
 490+ 70CE                  ;
 491+ 70CE                  ; Questo evita di dover scansionare tutta ItemsTable
 492+ 70CE                  ; durante il controllo delle collisioni.
 493+ 70CE                  ; ---------------------------------------------------------------
 494+ 70CE
 495+ 70CE FD 71 00         ld   (iy+0), c         ; Colonna
 496+ 70D1 FD 70 01         ld   (iy+1), b         ; Riga
 497+ 70D4 FD 73 02         ld   (iy+2), e         ; Colore
 498+ 70D7
 499+ 70D7                  ; Salva il puntatore al flag "collected"
 500+ 70D7 FD 75 03         ld   (iy+3), l         ; Low byte
 501+ 70DA FD 74 04         ld   (iy+4), h         ; High byte
 502+ 70DD
 503+ 70DD                  ; Passa al record successivo della cache
 504+ 70DD 01 05 00         ld   bc, 5
 505+ 70E0 FD 09            add  iy, bc
 506+ 70E2
 507+ 70E2                  ; Incrementa il numero di item attivi
 508+ 70E2 3A C4 75         ld   a, (num_room_items)
 509+ 70E5 3C               inc  a
 510+ 70E6 32 C4 75         ld   (num_room_items), a
 511+ 70E9
 512+ 70E9 18 04            jr   .next_no_inc
 513+ 70EB
 514+ 70EB              .next_item:
 515+ 70EB
 516+ 70EB                  ; ---------------------------------------------------------------
 517+ 70EB                  ; L'item non appartiene alla stanza corrente.
 518+ 70EB                  ; Salta i campi del record:
 519+ 70EB                  ;   X
 520+ 70EB                  ;   Y
 521+ 70EB                  ;   Color
 522+ 70EB                  ;   Collected
 523+ 70EB                  ; ---------------------------------------------------------------
 524+ 70EB 23               inc  hl
 525+ 70EC 23               inc  hl
 526+ 70ED 23               inc  hl
 527+ 70EE 23               inc  hl
 528+ 70EF
 529+ 70EF              .next_no_inc:
 530+ 70EF
 531+ 70EF                  ; ---------------------------------------------------------------
 532+ 70EF                  ; Avanza al record successivo
 533+ 70EF                  ; (prossimo Room ID)
 534+ 70EF                  ; ---------------------------------------------------------------
 535+ 70EF 23               inc  hl
 536+ 70F0 18 A8            jr   .loop
 537+ 70F2
 538+ 70F2              .done:
 539+ 70F2
 540+ 70F2                  ; Ripristina i registri
 541+ 70F2 FD E1            pop  iy
 542+ 70F4 DD E1            pop  ix
 543+ 70F6 D1               pop  de
 544+ 70F7 C1               pop  bc
 545+ 70F8 E1               pop  hl
 546+ 70F9
 547+ 70F9 C9               ret
 548+ 70FA
 549+ 70FA              ; -------------------------------------------------------------------
 550+ 70FA              ; DrawItemGraphic
 551+ 70FA              ;
 552+ 70FA              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 553+ 70FA              ; utilizzando una bitmap di 8 byte e un attributo colore.
 554+ 70FA              ;
 555+ 70FA              ; Input:
 556+ 70FA              ;   B = Riga attributi (3..18)
 557+ 70FA              ;   C = Colonna attributi (0..31)
 558+ 70FA              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 559+ 70FA              ;   E = Attributo colore
 560+ 70FA              ;
 561+ 70FA              ; Output:
 562+ 70FA              ;   Nessuno
 563+ 70FA              ;
 564+ 70FA              ; Registri preservati:
 565+ 70FA              ;   BC, DE, HL
 566+ 70FA              ; -------------------------------------------------------------------
 567+ 70FA              DrawItemGraphic:
 568+ 70FA
 569+ 70FA                  ; Salva i registri originali
 570+ 70FA C5               push bc
 571+ 70FB D5               push de
 572+ 70FC E5               push hl
 573+ 70FD
 574+ 70FD                  ; ---------------------------------------------------------------
 575+ 70FD                  ; Calcolo indirizzo bitmap dello Spectrum
 576+ 70FD                  ;
 577+ 70FD                  ; Ogni item occupa una cella attributi (8x8 pixel).
 578+ 70FD                  ;
 579+ 70FD                  ; Formula:
 580+ 70FD                  ;   High = $40 + (Row AND $18)
 581+ 70FD                  ;   Low  = (Row AND 7) * 32 + Col
 582+ 70FD                  ;
 583+ 70FD                  ; DE conterrà l'indirizzo della prima scanline.
 584+ 70FD                  ; ---------------------------------------------------------------
 585+ 70FD
 586+ 70FD 78               ld   a, b
 587+ 70FE E6 18            and  $18
 588+ 7100 C6 40            add  a, $40
 589+ 7102 57               ld   d, a              ; Byte alto indirizzo video
 590+ 7103
 591+ 7103 78               ld   a, b
 592+ 7104 E6 07            and  7                 ; Riga interna al blocco da 8
 593+ 7106
 594+ 7106 87               add  a, a              ; *2
 595+ 7107 87               add  a, a              ; *4
 596+ 7108 87               add  a, a              ; *8
 597+ 7109 87               add  a, a              ; *16
 598+ 710A 87               add  a, a              ; *32
 599+ 710B
 600+ 710B 81               add  a, c              ; + colonna
 601+ 710C
 602+ 710C 5F               ld   e, a              ; Byte basso indirizzo video
 603+ 710D
 604+ 710D                  ; ---------------------------------------------------------------
 605+ 710D                  ; Disegno bitmap
 606+ 710D                  ;
 607+ 710D                  ; Copia 8 byte consecutivi nella memoria video.
 608+ 710D                  ; Ogni byte rappresenta una scanline da 8 pixel.
 609+ 710D                  ; ---------------------------------------------------------------
 610+ 710D
 611+ 710D C5               push bc                ; Conserva Row e Col
 612+ 710E
 613+ 710E 06 08            ld   b, 8              ; Numero scanline
 614+ 7110
 615+ 7110              .line_loop:
 616+ 7110
 617+ 7110 7E               ld   a, (hl)           ; Legge scanline bitmap
 618+ 7111 12               ld   (de), a           ; Scrive nella memoria video
 619+ 7112
 620+ 7112 14               inc  d                 ; Scanline successiva
 621+ 7113 23               inc  hl                ; Byte bitmap successivo
 622+ 7114
 623+ 7114 05               dec  b
 624+ 7115 20 F9            jr   nz, .line_loop
 625+ 7117
 626+ 7117 C1               pop  bc                ; Ripristina Row e Col
 627+ 7118
 628+ 7118                  ; ---------------------------------------------------------------
 629+ 7118                  ; Calcolo indirizzo attributo
 630+ 7118                  ;
 631+ 7118                  ; Formula:
 632+ 7118                  ;   AttrAddr = $5800 + Row * 32 + Col
 633+ 7118                  ;
 634+ 7118                  ; HL conterrà l'indirizzo della cella attributi.
 635+ 7118                  ; ---------------------------------------------------------------
 636+ 7118
 637+ 7118 26 00            ld   h, 0
 638+ 711A 68               ld   l, b              ; HL = Row
 639+ 711B
 640+ 711B 29               add  hl, hl            ; *2
 641+ 711C 29               add  hl, hl            ; *4
 642+ 711D 29               add  hl, hl            ; *8
 643+ 711E 29               add  hl, hl            ; *16
 644+ 711F 29               add  hl, hl            ; *32
 645+ 7120
 646+ 7120 79               ld   a, c              ; A = Colonna
 647+ 7121
 648+ 7121 85               add  a, l
 649+ 7122 6F               ld   l, a
 650+ 7123
 651+ 7123 30 01            jr   nc, .no_carry
 652+ 7125 24               inc  h
 653+ 7126
 654+ 7126              .no_carry:
 655+ 7126
 656+ 7126                  ; HL = Row * 32 + Col
 657+ 7126
 658+ 7126 11 00 58         ld   de, $5800
 659+ 7129 19               add  hl, de            ; HL = indirizzo attributi
 660+ 712A
 661+ 712A                  ; ---------------------------------------------------------------
 662+ 712A                  ; Recupera il colore originale dallo stack.
 663+ 712A                  ;
 664+ 712A                  ; Layout stack:
 665+ 712A                  ;   HL originale
 666+ 712A                  ;   DE originale (E = colore)
 667+ 712A                  ;   BC originale
 668+ 712A                  ; ---------------------------------------------------------------
 669+ 712A
 670+ 712A C1               pop  bc                ; Recupera HL originale
 671+ 712B D1               pop  de                ; Recupera DE originale
 672+ 712C
 673+ 712C                  ; ---------------------------------------------------------------
 674+ 712C                  ; Scrive l'attributo colore
 675+ 712C                  ; ---------------------------------------------------------------
 676+ 712C
 677+ 712C 7B               ld   a, e              ; A = colore
 678+ 712D 77               ld   (hl), a           ; Scrive nella RAM attributi
 679+ 712E
 680+ 712E                  ; ---------------------------------------------------------------
 681+ 712E                  ; Ripristina HL e BC originali
 682+ 712E                  ; ---------------------------------------------------------------
 683+ 712E
 684+ 712E C5               push bc
 685+ 712F E1               pop  hl                ; HL originale
 686+ 7130
 687+ 7130 C1               pop  bc                ; BC originale
 688+ 7131
 689+ 7131 C9               ret
 690+ 7132
 691+ 7132              ; -------------------------------------------------------------------
 692+ 7132              ; RestoreBackgroundCell
 693+ 7132              ;
 694+ 7132              ; Ripristina il contenuto originale di una cella della stanza.
 695+ 7132              ; Viene utilizzata principalmente quando un item viene raccolto:
 696+ 7132              ; invece di lasciare un "buco", la routine ridisegna il tile
 697+ 7132              ; originale presente nella mappa della stanza.
 698+ 7132              ;
 699+ 7132              ; Input:
 700+ 7132              ;   B = Row (3..18)
 701+ 7132              ;   C = Col (0..31)
 702+ 7132              ;
 703+ 7132              ; Utilizza:
 704+ 7132              ;   room_ptr -> struttura dati della stanza corrente
 705+ 7132              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 706+ 7132              ;   DrawTile -> ridisegna il tile selezionato
 707+ 7132              ;
 708+ 7132              ; Tipi di cella:
 709+ 7132              ;   0 = Background
 710+ 7132              ;   1 = Floor
 711+ 7132              ;   2 = Wall
 712+ 7132              ;   3 = Nasty
 713+ 7132              ; -------------------------------------------------------------------
 714+ 7132              RestoreBackgroundCell:
 715+ 7132
 716+ 7132                  ; Salva tutti i registri utilizzati
 717+ 7132 FD E5            push iy
 718+ 7134 C5               push bc
 719+ 7135 D5               push de
 720+ 7136 E5               push hl
 721+ 7137 DD E5            push ix
 722+ 7139
 723+ 7139                  ; ---------------------------------------------------------------
 724+ 7139                  ; Conserva Row e Col in IY.
 725+ 7139                  ;
 726+ 7139                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 727+ 7139                  ; BC potrebbe essere modificato.
 728+ 7139                  ; ---------------------------------------------------------------
 729+ 7139 C5               push bc
 730+ 713A FD E1            pop  iy                ; IYH = Row, IYL = Col
 731+ 713C
 732+ 713C                  ; ---------------------------------------------------------------
 733+ 713C                  ; Determina quale tipo di cella è presente nella posizione
 734+ 713C                  ; specificata.
 735+ 713C                  ;
 736+ 713C                  ; Input:
 737+ 713C                  ;   B = Row
 738+ 713C                  ;   C = Col
 739+ 713C                  ;
 740+ 713C                  ; Output:
 741+ 713C                  ;   A = tipo cella
 742+ 713C                  ; ---------------------------------------------------------------
 743+ 713C 78               ld   a, b
 744+ 713D
 745+ 713D CD D3 6A         call GetCellFromUnpacked
 746+ 7140
 747+ 7140                  ; ---------------------------------------------------------------
 748+ 7140                  ; Recupera il puntatore alla stanza corrente.
 749+ 7140                  ;
 750+ 7140                  ; DE = base della struttura stanza
 751+ 7140                  ; ---------------------------------------------------------------
 752+ 7140 ED 5B C5 75      ld   de, (room_ptr)
 753+ 7144
 754+ 7144                  ; ---------------------------------------------------------------
 755+ 7144                  ; Seleziona il tile corretto in base al tipo di cella.
 756+ 7144                  ;
 757+ 7144                  ; A = 0 -> Background
 758+ 7144                  ; A = 1 -> Floor
 759+ 7144                  ; A = 2 -> Wall
 760+ 7144                  ; A = 3 -> Nasty
 761+ 7144                  ; ---------------------------------------------------------------
 762+ 7144
 763+ 7144 B7               or   a
 764+ 7145 20 06            jr   nz, .not_bg
 765+ 7147
 766+ 7147                  ; Background
 767+ 7147 21 A0 00         ld   hl, OFFSET_BG
 768+ 714A 19               add  hl, de
 769+ 714B 18 16            jr   .draw_cell
 770+ 714D
 771+ 714D              .not_bg:
 772+ 714D
 773+ 714D 3D               dec  a
 774+ 714E 20 06            jr   nz, .not_floor
 775+ 7150
 776+ 7150                  ; Floor
 777+ 7150 21 A9 00         ld   hl, OFFSET_FLOOR
 778+ 7153 19               add  hl, de
 779+ 7154 18 0D            jr   .draw_cell
 780+ 7156
 781+ 7156              .not_floor:
 782+ 7156
 783+ 7156 3D               dec  a
 784+ 7157 20 06            jr   nz, .not_wall
 785+ 7159
 786+ 7159                  ; Wall
 787+ 7159 21 B2 00         ld   hl, OFFSET_WALL
 788+ 715C 19               add  hl, de
 789+ 715D 18 04            jr   .draw_cell
 790+ 715F
 791+ 715F              .not_wall:
 792+ 715F
 793+ 715F                  ; Nasty
 794+ 715F 21 BB 00         ld   hl, OFFSET_NASTY
 795+ 7162 19               add  hl, de
 796+ 7163
 797+ 7163              .draw_cell:
 798+ 7163
 799+ 7163                  ; ---------------------------------------------------------------
 800+ 7163                  ; HL punta ora alla grafica del tile da ridisegnare.
 801+ 7163                  ;
 802+ 7163                  ; DrawTile si aspetta:
 803+ 7163                  ;   IX = puntatore tile
 804+ 7163                  ;   B  = Row
 805+ 7163                  ;   C  = Col
 806+ 7163                  ; ---------------------------------------------------------------
 807+ 7163 E5               push hl
 808+ 7164 DD E1            pop  ix
 809+ 7166
 810+ 7166                  ; Ripristina Row e Col salvati in IY
 811+ 7166 FD E5            push iy
 812+ 7168 C1               pop  bc
 813+ 7169
 814+ 7169                  ; Disegna il tile originale
 815+ 7169 CD 8C 61         call DrawTile
 816+ 716C
 817+ 716C                  ; ---------------------------------------------------------------
 818+ 716C                  ; Ripristina i registri salvati
 819+ 716C                  ; ---------------------------------------------------------------
 820+ 716C DD E1            pop  ix
 821+ 716E E1               pop  hl
 822+ 716F D1               pop  de
 823+ 7170 C1               pop  bc
 824+ 7171 FD E1            pop  iy
 825+ 7173
 826+ 7173 C9               ret
 827+ 7174
 828+ 7174              ; -------------------------------------------------------------------
 829+ 7174              ; CheckWillyItemCollision
 830+ 7174              ;
 831+ 7174              ; Verifica se Willy collide con un item utilizzando il controllo
 832+ 7174              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 833+ 7174              ;
 834+ 7174              ; Input:
 835+ 7174              ;   A = ItemX (colonna attributi 0..31)
 836+ 7174              ;   H = ItemY (riga attributi 3..18)
 837+ 7174              ;
 838+ 7174              ; Coordinate item:
 839+ 7174              ;   Ogni item occupa una cella da 8x8 pixel.
 840+ 7174              ;
 841+ 7174              ; Coordinate Willy:
 842+ 7174              ;   Willy occupa un rettangolo di 16x16 pixel.
 843+ 7174              ;
 844+ 7174              ; Output:
 845+ 7174              ;   Carry Set   = collisione rilevata
 846+ 7174              ;   Carry Clear = nessuna collisione
 847+ 7174              ;
 848+ 7174              ; Registri preservati:
 849+ 7174              ;   BC, DE, HL
 850+ 7174              ; -------------------------------------------------------------------
 851+ 7174              CheckWillyItemCollision:
 852+ 7174
 853+ 7174                  ; Salva i registri utilizzati
 854+ 7174 C5               push bc
 855+ 7175 D5               push de
 856+ 7176 E5               push hl
 857+ 7177
 858+ 7177                  ; ---------------------------------------------------------------
 859+ 7177                  ; Calcola il bounding box orizzontale dell'item
 860+ 7177                  ;
 861+ 7177                  ; ItemLeft  = ItemX * 8
 862+ 7177                  ; ItemRight = ItemLeft + 7
 863+ 7177                  ;
 864+ 7177                  ; E = ItemLeft
 865+ 7177                  ; D = ItemRight
 866+ 7177                  ; ---------------------------------------------------------------
 867+ 7177 6F               ld   l, a              ; L = ItemX
 868+ 7178
 869+ 7178 7D               ld   a, l
 870+ 7179 87               add  a, a              ; *2
 871+ 717A 87               add  a, a              ; *4
 872+ 717B 87               add  a, a              ; *8
 873+ 717C
 874+ 717C 5F               ld   e, a              ; E = ItemLeft
 875+ 717D
 876+ 717D C6 07            add  a, 7
 877+ 717F 57               ld   d, a              ; D = ItemRight
 878+ 7180
 879+ 7180                  ; ---------------------------------------------------------------
 880+ 7180                  ; Recupera la posizione corrente di Willy
 881+ 7180                  ;
 882+ 7180                  ; B = WillyY
 883+ 7180                  ; C = WillyX
 884+ 7180                  ; ---------------------------------------------------------------
 885+ 7180 ED 4B 55 72      ld   bc, (PlayerPos)
 886+ 7184
 887+ 7184                  ; ---------------------------------------------------------------
 888+ 7184                  ; Primo test:
 889+ 7184                  ;
 890+ 7184                  ; WillyLeft <= ItemRight
 891+ 7184                  ;
 892+ 7184                  ; Se Willy è completamente a destra dell'item
 893+ 7184                  ; non può esserci collisione.
 894+ 7184                  ; ---------------------------------------------------------------
 895+ 7184 79               ld   a, c              ; A = WillyLeft
 896+ 7185
 897+ 7185 BA               cp   d                 ; WillyLeft vs ItemRight
 898+ 7186
 899+ 7186 28 04            jr   z, .x_ok
 900+ 7188 38 02            jr   c, .x_ok
 901+ 718A
 902+ 718A 18 29            jr   .no_collision
 903+ 718C
 904+ 718C              .x_ok:
 905+ 718C
 906+ 718C                  ; ---------------------------------------------------------------
 907+ 718C                  ; Secondo test:
 908+ 718C                  ;
 909+ 718C                  ; WillyRight >= ItemLeft
 910+ 718C                  ;
 911+ 718C                  ; WillyRight = WillyX + 7
 912+ 718C                  ; ---------------------------------------------------------------
 913+ 718C C6 07            add  a, 7
 914+ 718E
 915+ 718E BB               cp   e                 ; WillyRight vs ItemLeft
 916+ 718F
 917+ 718F 28 04            jr   z, .y_check
 918+ 7191 30 02            jr   nc, .y_check
 919+ 7193
 920+ 7193 18 20            jr   .no_collision
 921+ 7195
 922+ 7195              .y_check:
 923+ 7195
 924+ 7195                  ; ---------------------------------------------------------------
 925+ 7195                  ; Recupera ItemY dal valore originale di HL
 926+ 7195                  ;
 927+ 7195                  ; H contiene la riga dell'item.
 928+ 7195                  ; ---------------------------------------------------------------
 929+ 7195 E1               pop  hl
 930+ 7196 E5               push hl
 931+ 7197
 932+ 7197                  ; ---------------------------------------------------------------
 933+ 7197                  ; Calcola il bounding box verticale dell'item
 934+ 7197                  ;
 935+ 7197                  ; ItemTop    = ItemY * 8
 936+ 7197                  ; ItemBottom = ItemTop + 7
 937+ 7197                  ;
 938+ 7197                  ; E = ItemTop
 939+ 7197                  ; D = ItemBottom
 940+ 7197                  ; ---------------------------------------------------------------
 941+ 7197 7C               ld   a, h
 942+ 7198
 943+ 7198 87               add  a, a              ; *2
 944+ 7199 87               add  a, a              ; *4
 945+ 719A 87               add  a, a              ; *8
 946+ 719B
 947+ 719B 5F               ld   e, a              ; ItemTop
 948+ 719C
 949+ 719C C6 07            add  a, 7
 950+ 719E 57               ld   d, a              ; ItemBottom
 951+ 719F
 952+ 719F                  ; ---------------------------------------------------------------
 953+ 719F                  ; Primo test verticale:
 954+ 719F                  ;
 955+ 719F                  ; WillyTop <= ItemBottom
 956+ 719F                  ; ---------------------------------------------------------------
 957+ 719F 78               ld   a, b              ; WillyTop
 958+ 71A0
 959+ 71A0 BA               cp   d
 960+ 71A1
 961+ 71A1 28 04            jr   z, .y_ok
 962+ 71A3 38 02            jr   c, .y_ok
 963+ 71A5
 964+ 71A5 18 0E            jr   .no_collision
 965+ 71A7
 966+ 71A7              .y_ok:
 967+ 71A7
 968+ 71A7                  ; ---------------------------------------------------------------
 969+ 71A7                  ; Secondo test verticale:
 970+ 71A7                  ;
 971+ 71A7                  ; WillyBottom >= ItemTop
 972+ 71A7                  ;
 973+ 71A7                  ; WillyBottom = WillyY + 15
 974+ 71A7                  ; ---------------------------------------------------------------
 975+ 71A7 C6 0F            add  a, 15
 976+ 71A9
 977+ 71A9 BB               cp   e
 978+ 71AA
 979+ 71AA 28 04            jr   z, .collision
 980+ 71AC 30 02            jr   nc, .collision
 981+ 71AE
 982+ 71AE 18 05            jr   .no_collision
 983+ 71B0
 984+ 71B0              .collision:
 985+ 71B0
 986+ 71B0                  ; ---------------------------------------------------------------
 987+ 71B0                  ; Collisione rilevata
 988+ 71B0                  ; ---------------------------------------------------------------
 989+ 71B0 E1               pop  hl
 990+ 71B1 D1               pop  de
 991+ 71B2 C1               pop  bc
 992+ 71B3
 993+ 71B3 37               scf                    ; Carry = 1
 994+ 71B4
 995+ 71B4 C9               ret
 996+ 71B5
 997+ 71B5              .no_collision:
 998+ 71B5
 999+ 71B5                  ; ---------------------------------------------------------------
1000+ 71B5                  ; Nessuna collisione
1001+ 71B5                  ; ---------------------------------------------------------------
1002+ 71B5 E1               pop  hl
1003+ 71B6 D1               pop  de
1004+ 71B7 C1               pop  bc
1005+ 71B8
1006+ 71B8 B7               or   a                 ; Carry = 0
1007+ 71B9
1008+ 71B9 C9               ret
1009+ 71BA
1010+ 71BA              ; -------------------------------------------------------------------
1011+ 71BA              ; CheckRoomItemsCollision
1012+ 71BA              ;
1013+ 71BA              ; Controlla se Willy entra in collisione con uno degli item
1014+ 71BA              ; attivi presenti nella stanza corrente.
1015+ 71BA              ;
1016+ 71BA              ; Per ogni item:
1017+ 71BA              ;   - verifica che appartenga alla stanza corrente
1018+ 71BA              ;   - verifica che non sia già stato raccolto
1019+ 71BA              ;   - esegue il test di collisione con Willy
1020+ 71BA              ;
1021+ 71BA              ; Se l'item viene raccolto:
1022+ 71BA              ;   - imposta il flag "collected"
1023+ 71BA              ;   - rimuove l'item dalla cache items_grid
1024+ 71BA              ;   - incrementa il contatore degli oggetti raccolti
1025+ 71BA              ;   - aggiorna l'HUD
1026+ 71BA              ;   - ripristina il tile di sfondo
1027+ 71BA              ;   - riproduce il suono di raccolta
1028+ 71BA              ;
1029+ 71BA              ; Formato record ItemsTable:
1030+ 71BA              ;   +0 RoomID
1031+ 71BA              ;   +1 X
1032+ 71BA              ;   +2 Y
1033+ 71BA              ;   +3 Color
1034+ 71BA              ;   +4 Collected
1035+ 71BA              ;
1036+ 71BA              ; Fine tabella:
1037+ 71BA              ;   RoomID = $FF
1038+ 71BA              ; -------------------------------------------------------------------
1039+ 71BA              CheckRoomItemsCollision:
1040+ 71BA
1041+ 71BA                  ; Salva i registri utilizzati
1042+ 71BA E5               push hl
1043+ 71BB D5               push de
1044+ 71BC C5               push bc
1045+ 71BD
1046+ 71BD                  ; Inizio scansione della tabella degli item
1047+ 71BD 21 21 6F         ld   hl, ItemsTable
1048+ 71C0
1049+ 71C0              .loop:
1050+ 71C0
1051+ 71C0                  ; ---------------------------------------------------------------
1052+ 71C0                  ; Legge il Room ID dell'item corrente
1053+ 71C0                  ; ---------------------------------------------------------------
1054+ 71C0 7E               ld   a, (hl)
1055+ 71C1
1056+ 71C1                  ; $FF indica fine tabella
1057+ 71C1 FE FF            cp   $FF
1058+ 71C3 28 4D            jr   z, .done
1059+ 71C5
1060+ 71C5                  ; ---------------------------------------------------------------
1061+ 71C5                  ; Verifica se l'item appartiene alla stanza corrente
1062+ 71C5                  ; ---------------------------------------------------------------
1063+ 71C5 57               ld   d, a              ; D = RoomID item
1064+ 71C6
1065+ 71C6 3A 6B 75         ld   a, (current_room)
1066+ 71C9 BA               cp   d
1067+ 71CA
1068+ 71CA                  ; Se appartiene a un'altra stanza salta il record
1069+ 71CA 20 3F            jr   nz, .next_item
1070+ 71CC
1071+ 71CC                  ; ---------------------------------------------------------------
1072+ 71CC                  ; Legge coordinate e stato dell'item
1073+ 71CC                  ; ---------------------------------------------------------------
1074+ 71CC
1075+ 71CC 23               inc  hl
1076+ 71CD 4E               ld   c, (hl)           ; C = X
1077+ 71CE
1078+ 71CE 23               inc  hl
1079+ 71CF 46               ld   b, (hl)           ; B = Y
1080+ 71D0
1081+ 71D0 23               inc  hl                ; salta Color
1082+ 71D1
1083+ 71D1 23               inc  hl                ; punta a Collected
1084+ 71D2
1085+ 71D2 7E               ld   a, (hl)
1086+ 71D3
1087+ 71D3                  ; ---------------------------------------------------------------
1088+ 71D3                  ; Item già raccolto?
1089+ 71D3                  ; ---------------------------------------------------------------
1090+ 71D3 B7               or   a
1091+ 71D4 20 39            jr   nz, .next_no_inc
1092+ 71D6
1093+ 71D6                  ; ---------------------------------------------------------------
1094+ 71D6                  ; Test collisione Willy ↔ Item
1095+ 71D6                  ;
1096+ 71D6                  ; Input richiesto:
1097+ 71D6                  ;   A = ItemX
1098+ 71D6                  ;   H = ItemY
1099+ 71D6                  ; ---------------------------------------------------------------
1100+ 71D6 79               ld   a, c
1101+ 71D7
1102+ 71D7 E5               push hl                ; salva puntatore al flag Collected
1103+ 71D8
1104+ 71D8 60               ld   h, b
1105+ 71D9
1106+ 71D9 CD 74 71         call CheckWillyItemCollision
1107+ 71DC
1108+ 71DC E1               pop  hl
1109+ 71DD
1110+ 71DD                  ; Nessuna collisione
1111+ 71DD 30 30            jr   nc, .next_no_inc
1112+ 71DF
1113+ 71DF                  ; ===============================================================
1114+ 71DF                  ; ITEM RACCOLTO
1115+ 71DF                  ; ===============================================================
1116+ 71DF
1117+ 71DF                  ; ---------------------------------------------------------------
1118+ 71DF                  ; Marca l'item come raccolto
1119+ 71DF                  ; ---------------------------------------------------------------
1120+ 71DF 36 01            ld   (hl), 1
1121+ 71E1
1122+ 71E1                  ; ---------------------------------------------------------------
1123+ 71E1                  ; Rimuove l'item dalla cache items_grid
1124+ 71E1                  ;
1125+ 71E1                  ; Calcolo:
1126+ 71E1                  ;   offset = Row * 32 + Col
1127+ 71E1                  ; ---------------------------------------------------------------
1128+ 71E1 E5               push hl
1129+ 71E2 D5               push de
1130+ 71E3
1131+ 71E3 26 00            ld   h, 0
1132+ 71E5 68               ld   l, b              ; HL = Row
1133+ 71E6
1134+ 71E6 29               add  hl, hl            ; *2
1135+ 71E7 29               add  hl, hl            ; *4
1136+ 71E8 29               add  hl, hl            ; *8
1137+ 71E9 29               add  hl, hl            ; *16
1138+ 71EA 29               add  hl, hl            ; *32
1139+ 71EB
1140+ 71EB 59               ld   e, c
1141+ 71EC 16 00            ld   d, 0
1142+ 71EE
1143+ 71EE 19               add  hl, de            ; Row*32 + Col
1144+ 71EF
1145+ 71EF 11 00 90         ld   de, items_grid
1146+ 71F2 19               add  hl, de
1147+ 71F3
1148+ 71F3                  ; La cella non contiene più un item
1149+ 71F3 36 00            ld   (hl), 0
1150+ 71F5
1151+ 71F5 D1               pop  de
1152+ 71F6 E1               pop  hl
1153+ 71F7
1154+ 71F7                  ; ---------------------------------------------------------------
1155+ 71F7                  ; Conserva il puntatore all'entry corrente
1156+ 71F7                  ; poiché le routine successive possono alterare HL.
1157+ 71F7                  ; ---------------------------------------------------------------
1158+ 71F7 E5               push hl
1159+ 71F8
1160+ 71F8                  ; ---------------------------------------------------------------
1161+ 71F8                  ; Aggiorna il numero di oggetti raccolti
1162+ 71F8                  ; ---------------------------------------------------------------
1163+ 71F8 3A 5F 72         ld   a, (items_collected)
1164+ 71FB
1165+ 71FB 3C               inc  a
1166+ 71FC
1167+ 71FC 32 5F 72         ld   (items_collected), a
1168+ 71FF
1169+ 71FF                  ; ---------------------------------------------------------------
1170+ 71FF                  ; Aggiorna il contatore visualizzato a schermo
1171+ 71FF                  ; ---------------------------------------------------------------
1172+ 71FF CD CB 60         call UpdateItemsCollectedDisplay
1173+ 7202
1174+ 7202                  ; ---------------------------------------------------------------
1175+ 7202                  ; Ripristina il tile originale della stanza
1176+ 7202                  ; eliminando la grafica dell'item.
1177+ 7202                  ;
1178+ 7202                  ; Input:
1179+ 7202                  ;   B = Row
1180+ 7202                  ;   C = Col
1181+ 7202                  ; ---------------------------------------------------------------
1182+ 7202 CD 32 71         call RestoreBackgroundCell
1183+ 7205
1184+ 7205                  ; ---------------------------------------------------------------
1185+ 7205                  ; Riproduce il suono di raccolta
1186+ 7205                  ; ---------------------------------------------------------------
1187+ 7205 CD 16 72         call PlayCollectSound
1188+ 7208
1189+ 7208                  ; Ripristina il puntatore alla tabella
1190+ 7208 E1               pop  hl
1191+ 7209
1192+ 7209                  ; Continua con il record successivo
1193+ 7209 18 04            jr   .next_no_inc
1194+ 720B
1195+ 720B              .next_item:
1196+ 720B
1197+ 720B                  ; ---------------------------------------------------------------
1198+ 720B                  ; Salta i campi del record:
1199+ 720B                  ;   X
1200+ 720B                  ;   Y
1201+ 720B                  ;   Color
1202+ 720B                  ;   Collected
1203+ 720B                  ; ---------------------------------------------------------------
1204+ 720B 23               inc  hl
1205+ 720C 23               inc  hl
1206+ 720D 23               inc  hl
1207+ 720E 23               inc  hl
1208+ 720F
1209+ 720F              .next_no_inc:
1210+ 720F
1211+ 720F                  ; ---------------------------------------------------------------
1212+ 720F                  ; Avanza al record successivo.
1213+ 720F                  ;
1214+ 720F                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1215+ 720F                  ; ---------------------------------------------------------------
1216+ 720F 23               inc  hl
1217+ 7210
1218+ 7210 18 AE            jr   .loop
1219+ 7212
1220+ 7212              .done:
1221+ 7212
1222+ 7212                  ; Ripristina i registri
1223+ 7212 C1               pop  bc
1224+ 7213 D1               pop  de
1225+ 7214 E1               pop  hl
1226+ 7215
1227+ 7215 C9               ret
1228+ 7216
1229+ 7216              ; -------------------------------------------------------------------
1230+ 7216              ; PlayCollectSound
1231+ 7216              ;
1232+ 7216              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1233+ 7216              ; dello ZX Spectrum utilizzando il port $FE.
1234+ 7216              ;
1235+ 7216              ; Il suono viene prodotto alternando ON/OFF del bit 4
1236+ 7216              ; (speaker) con un semplice delay software.
1237+ 7216              ;
1238+ 7216              ; Effetto risultante:
1239+ 7216              ;   beep breve tipo "pickup item"
1240+ 7216              ; -------------------------------------------------------------------
1241+ 7216              PlayCollectSound:
1242+ 7216
1243+ 7216                  ; Salva registri utilizzati
1244+ 7216 C5               push bc
1245+ 7217 D5               push de
1246+ 7218
1247+ 7218                  ; ---------------------------------------------------------------
1248+ 7218                  ; Numero di cicli del beep (durata complessiva del suono)
1249+ 7218                  ; ---------------------------------------------------------------
1250+ 7218 06 78            ld   b, 120
1251+ 721A
1252+ 721A              .sound_loop:
1253+ 721A
1254+ 721A                  ; ---------------------------------------------------------------
1255+ 721A                  ; SPEAKER ON
1256+ 721A                  ;
1257+ 721A                  ; Legge il colore del bordo corrente e attiva il bit 4
1258+ 721A                  ; per pilotare lo speaker.
1259+ 721A                  ; ---------------------------------------------------------------
1260+ 721A 3A 61 72         ld   a, (room_border_color)
1261+ 721D F6 10            or   $10               ; bit 4 = 1 → speaker ON
1262+ 721F
1263+ 721F D3 FE            out  ($fe), a         ; scrive sul port ULA
1264+ 7221
1265+ 7221                  ; ---------------------------------------------------------------
1266+ 7221                  ; Delay (mezzo periodo)
1267+ 7221                  ; Loop software a consumo CPU
1268+ 7221                  ; ---------------------------------------------------------------
1269+ 7221 0E 3C            ld   c, 60
1270+ 7223
1271+ 7223              .d1:
1272+ 7223 0D               dec  c
1273+ 7224 20 FD            jr   nz, .d1
1274+ 7226
1275+ 7226                  ; ---------------------------------------------------------------
1276+ 7226                  ; SPEAKER OFF
1277+ 7226                  ;
1278+ 7226                  ; Mantiene il colore del bordo ma disattiva lo speaker
1279+ 7226                  ; ---------------------------------------------------------------
1280+ 7226 3A 61 72         ld   a, (room_border_color)
1281+ 7229 E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1282+ 722B
1283+ 722B D3 FE            out  ($fe), a
1284+ 722D
1285+ 722D                  ; ---------------------------------------------------------------
1286+ 722D                  ; Secondo delay (mezzo periodo)
1287+ 722D                  ; Completa l’onda quadra
1288+ 722D                  ; ---------------------------------------------------------------
1289+ 722D 0E 3C            ld   c, 60
1290+ 722F
1291+ 722F              .d2:
1292+ 722F 0D               dec  c
1293+ 7230 20 FD            jr   nz, .d2
1294+ 7232
1295+ 7232                  ; ---------------------------------------------------------------
1296+ 7232                  ; Ripete fino a completare il numero di cicli
1297+ 7232                  ; ---------------------------------------------------------------
1298+ 7232 10 E6            djnz .sound_loop
1299+ 7234
1300+ 7234                  ; Ripristina registri salvati
1301+ 7234 D1               pop  de
1302+ 7235 C1               pop  bc
1303+ 7236
1304+ 7236 C9               ret
1305+ 7237
1306+ 7237              ; -------------------------------------------------------------------
1307+ 7237              ; CheckActiveItemAtCell
1308+ 7237              ;
1309+ 7237              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1310+ 7237              ; nella cella specificata della griglia items_grid.
1311+ 7237              ;
1312+ 7237              ; Questa routine usa una lookup diretta su una mappa 32x16,
1313+ 7237              ; evitando la scansione della ItemsTable.
1314+ 7237              ;
1315+ 7237              ; Input:
1316+ 7237              ;   B = Colonna (0..31)
1317+ 7237              ;   C = Riga (0..15)
1318+ 7237              ;
1319+ 7237              ; Output:
1320+ 7237              ;   Carry Set   = item presente nella cella
1321+ 7237              ;   Carry Clear = nessun item
1322+ 7237              ;
1323+ 7237              ; Nota:
1324+ 7237              ;   HL NON è restituito valido (commento originale non corretto:
1325+ 7237              ;   la routine non punta a ItemsTable).
1326+ 7237              ; -------------------------------------------------------------------
1327+ 7237              CheckActiveItemAtCell:
1328+ 7237
1329+ 7237                  ; Salva registri usati
1330+ 7237 D5               push de
1331+ 7238 E5               push hl
1332+ 7239
1333+ 7239                  ; ---------------------------------------------------------------
1334+ 7239                  ; Calcolo indice lineare nella griglia 32x16:
1335+ 7239                  ;
1336+ 7239                  ; offset = Row * 32 + Col
1337+ 7239                  ; ---------------------------------------------------------------
1338+ 7239 26 00            ld   h, 0
1339+ 723B 69               ld   l, c              ; HL = Row
1340+ 723C
1341+ 723C 29               add  hl, hl            ; *2
1342+ 723D 29               add  hl, hl            ; *4
1343+ 723E 29               add  hl, hl            ; *8
1344+ 723F 29               add  hl, hl            ; *16
1345+ 7240 29               add  hl, hl            ; *32
1346+ 7241
1347+ 7241                  ; Aggiunge la colonna
1348+ 7241 58               ld   e, b
1349+ 7242 16 00            ld   d, 0
1350+ 7244 19               add  hl, de            ; HL = Row*32 + Col
1351+ 7245
1352+ 7245                  ; ---------------------------------------------------------------
1353+ 7245                  ; Accesso alla griglia degli item attivi
1354+ 7245                  ; ---------------------------------------------------------------
1355+ 7245 11 00 90         ld   de, items_grid
1356+ 7248 19               add  hl, de            ; HL = address cella
1357+ 7249
1358+ 7249                  ; ---------------------------------------------------------------
1359+ 7249                  ; Controllo presenza item
1360+ 7249                  ;
1361+ 7249                  ; items_grid contiene:
1362+ 7249                  ;   0 = nessun item
1363+ 7249                  ;   >0 = item attivo (colore o flag)
1364+ 7249                  ; ---------------------------------------------------------------
1365+ 7249 7E               ld   a, (hl)
1366+ 724A B7               or   a
1367+ 724B 28 04            jr   z, .not_active
1368+ 724D
1369+ 724D                  ; ---------------------------------------------------------------
1370+ 724D                  ; Item trovato
1371+ 724D                  ; ---------------------------------------------------------------
1372+ 724D E1               pop  hl
1373+ 724E D1               pop  de
1374+ 724F
1375+ 724F 37               scf                    ; Carry = 1
1376+ 7250 C9               ret
1377+ 7251
1378+ 7251              .not_active:
1379+ 7251
1380+ 7251                  ; ---------------------------------------------------------------
1381+ 7251                  ; Nessun item nella cella
1382+ 7251                  ; ---------------------------------------------------------------
1383+ 7251 E1               pop  hl
1384+ 7252 D1               pop  de
1385+ 7253
1386+ 7253 B7               or   a                 ; Carry = 0
1387+ 7254 C9               ret
1388+ 7255
# file closed: items.asm
  19  7255                  include "data/datavariable.asm"
