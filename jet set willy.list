 655+ 6A6A CB 3F            srl  a
 656+ 6A6C CB 3F            srl  a
 657+ 6A6E CB 3F            srl  a                 ; A = r (0..15)
 658+ 6A70 57               ld   d, a              ; D = r (layout row)
 659+ 6A71
 660+ 6A71                  ; 2. Converti X pixel in C a column: c = X / 8
 661+ 6A71 79               ld   a, c
 662+ 6A72 CB 3F            srl  a
 663+ 6A74 CB 3F            srl  a
 664+ 6A76 CB 3F            srl  a                 ; A = c (0..31)
 665+ 6A78 5F               ld   e, a              ; E = c (column)
