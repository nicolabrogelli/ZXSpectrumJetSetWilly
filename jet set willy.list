 204+ 6B6C
 205+ 6B6C                  ; Nessun atterraggio
 206+ 6B6C 18 37            jr   .no_collision_checks
 207+ 6B6E
 208+ 6B6E              .check_landing:
 209+ 6B6E                  ; Abbiamo toccato una cella solida!
 210+ 6B6E 78               ld   a, b
 211+ 6B6F D6 18            sub  24
 212+ 6B71 CB 3F            srl  a
 213+ 6B73 CB 3F            srl  a
 214+ 6B75 CB 3F            srl  a                 ; A = r (0..15)
 215+ 6B77
 216+ 6B77                  ; Controlliamo se Vecchio Y + 16 <= r * 8 + 24
 217+ 6B77 5F               ld   e, a              ; E = r
 218+ 6B78 87               add  a, a              ; *2
 219+ 6B79 87               add  a, a              ; *4
 220+ 6B7A 87               add  a, a              ; *8
 221+ 6B7B C6 18            add  a, 24             ; A = r * 8 + 24 (limite superiore della riga)
 222+ 6B7D 57               ld   d, a              ; D = limite superiore
 223+ 6B7E
 224+ 6B7E                  ; Vecchio Y + 16
 225+ 6B7E 3A 53 6F         ld   a, (PlayerPos+1)  ; A = Vecchio Y
 226+ 6B81 C6 10            add  a, 16             ; A = Vecchio Y + 16
 227+ 6B83
 228+ 6B83 BA               cp   d                 ; Confronta Vecchio Y + 16 con il limite
 229+ 6B84 28 04            jr   z, .do_landing    ; Se ==, atterra
 230+ 6B86 38 02            jr   c, .do_landing    ; Se <, atterra (eravamo sopra)
 231+ 6B88
 232+ 6B88 18 1B            jr   .no_collision_checks
 233+ 6B8A
 234+ 6B8A              .do_landing:
 235+ 6B8A                  ; Atterra sulla riga di layout E!
 236+ 6B8A 7B               ld   a, e
 237+ 6B8B 87               add  a, a              ; *2
 238+ 6B8C 87               add  a, a              ; *4
 239+ 6B8D 87               add  a, a              ; *8
 240+ 6B8E C6 08            add  a, 8              ; A = PlayerY di atterraggio
