 359+ 5F59              ; Disegna uno sprite 16x16 a coordinate pixel (X, Y)
 360+ 5F59              ; Input: C = X, B = Y, IX = puntatore dati sprite (32 byte)
 361+ 5F59              ; -------------------------------------------------------------------
 362+ 5F59              DrawPixelSprite16x16:
 363+ 5F59 C5               push bc
 364+ 5F5A D5               push de
 365+ 5F5B E5               push hl
 366+ 5F5C DD E5            push ix
 367+ 5F5E
 368+ 5F5E                  ; 1. Salva la coordinata X per calcolare lo shift
 369+ 5F5E 79               ld   a, c
 370+ 5F5F E6 07            and  7
 371+ 5F61 32 13 77         ld   (sprite_shift), a
 372+ 5F64
 373+ 5F64                  ; 2. Calcola indirizzo schermo
 374+ 5F64 60               ld   h, b
 375+ 5F65 69               ld   l, c
 376+ 5F66 CD 0E 5E         call GetScreenAddr ; HL = indirizzo schermo
 377+ 5F69
 378+ 5F69 0E 10            ld   c, 16          ; 16 linee/scanline
 379+ 5F6B              .line_loop:
 380+ 5F6B DD 56 00         ld   d, (ix+0)     ; D = primo byte dello sprite
 381+ 5F6E DD 5E 01         ld   e, (ix+1)     ; E = secondo byte dello sprite
 382+ 5F71
 383+ 5F71                  ; Esegui lo shift a destra se necessario
 384+ 5F71 3A 13 77         ld   a, (sprite_shift)
 385+ 5F74 B7               or   a
 386+ 5F75 28 1C            jr   z, .no_shift
 387+ 5F77
 388+ 5F77 C5               push bc            ; Salva il contatore delle linee (C) e lo shift (B)
 389+ 5F78 47               ld   b, a          ; B = contatore shift
 390+ 5F79 AF               xor  a             ; A = terzo byte (inizializzato a 0)
 391+ 5F7A
 392+ 5F7A              .shift_loop:
 393+ 5F7A CB 3A            srl  d
 394+ 5F7C CB 1B            rr   e
 395+ 5F7E CB 1F            rr   a
 396+ 5F80 10 F8            djnz .shift_loop
 397+ 5F82
 398+ 5F82 C1               pop  bc            ; Ripristina C (contatore linee)
 399+ 5F83
 400+ 5F83                  ; Scrive i 3 byte sullo schermo (OR trasparente)
 401+ 5F83 47               ld   b, a          ; Salva il 3° byte dello sprite in B
 402+ 5F84 7A               ld   a, d
 403+ 5F85 B6               or   (hl)
 404+ 5F86 77               ld   (hl), a
 405+ 5F87 23               inc  hl
 406+ 5F88 7B               ld   a, e
 407+ 5F89 B6               or   (hl)
 408+ 5F8A 77               ld   (hl), a
 409+ 5F8B 23               inc  hl
 410+ 5F8C 78               ld   a, b          ; Recupera il 3° byte dello sprite
 411+ 5F8D B6               or   (hl)
 412+ 5F8E 77               ld   (hl), a
 413+ 5F8F 2B               dec  hl
 414+ 5F90 2B               dec  hl            ; Ripristina HL alla colonna iniziale
 415+ 5F91 18 08            jr   .next_line
