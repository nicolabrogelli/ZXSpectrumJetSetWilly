1856+ 7759              ; -------------------------------------------------------------------
1857+ 7759              ; Verifica se c'è una cella Nasty (tipo 3) alle coordinate pixel (X, Y)
1858+ 7759              ; Input: C = X, B = Y
1859+ 7759              ; Output: Carry flag impostato se è Nasty, altrimenti resettato
1860+ 7759              ; -------------------------------------------------------------------
1861+ 7759              CheckNastyCell:
1862+ 7759 E5               push hl
1863+ 775A D5               push de
1864+ 775B C5               push bc
1865+ 775C
1866+ 775C                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1867+ 775C 78               ld   a, b
1868+ 775D FE 80            cp   128
1869+ 775F 30 17            jr   nc, .not_nasty
1870+ 7761
1871+ 7761                  ; 2. Calcola riga di layout: r = Y / 8
1872+ 7761 CB 3F            srl  a
1873+ 7763 CB 3F            srl  a
1874+ 7765 CB 3F            srl  a                 ; A = r (0..15)
1875+ 7767
1876+ 7767                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1877+ 7767 5F               ld   e, a              ; E = r
1878+ 7768 79               ld   a, c
1879+ 7769 CB 3F            srl  a
1880+ 776B CB 3F            srl  a
1881+ 776D CB 3F            srl  a                 ; A = c (0..31)
1882+ 776F 4F               ld   c, a              ; C = c
1883+ 7770 7B               ld   a, e              ; A = r
1884+ 7771
1885+ 7771 CD DF 74         call GetCellFromUnpacked ; A = cell type
1886+ 7774
1887+ 7774                  ; Controlla se è Nasty (3)
1888+ 7774 FE 03            cp   3
1889+ 7776 28 05            jr   z, .is_nasty
