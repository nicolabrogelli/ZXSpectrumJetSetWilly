1773+ 6797
1774+ 6797                  ; 1. Indirizzo del font in RAM ($F100 + (ASCII - 32) * 8)
1775+ 6797 D6 20            sub  32                ; A = ASCII - 32
1776+ 6799 6F               ld   l, a
1777+ 679A 26 00            ld   h, 0
1778+ 679C 29               add  hl, hl            ; *2
1779+ 679D 29               add  hl, hl            ; *4
1780+ 679E 29               add  hl, hl            ; *8
