 179+ 7CD9              ; Audio_PlayCollectSound
 180+ 7CD9              ;
 181+ 7CD9              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 7CD9              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 7CD9              ; -------------------------------------------------------------------
 184+ 7CD9              Audio_PlayCollectSound:
 185+ 7CD9 C5               push bc
 186+ 7CDA D5               push de
 187+ 7CDB
 188+ 7CDB 06 78            ld   b, 120
 189+ 7CDD              .sound_loop:
 190+ 7CDD 3A 32 E6         ld   a, (room_border_color)
 191+ 7CE0 F6 10            or   $10               ; speaker ON
 192+ 7CE2 D3 FE            out  ($fe), a
 193+ 7CE4
 194+ 7CE4 0E 3C            ld   c, 60
 195+ 7CE6              .d1:
 196+ 7CE6 0D               dec  c
 197+ 7CE7 20 FD            jr   nz, .d1
 198+ 7CE9
 199+ 7CE9 3A 32 E6         ld   a, (room_border_color)
 200+ 7CEC E6 EF            and  $ef              ; speaker OFF
 201+ 7CEE D3 FE            out  ($fe), a
 202+ 7CF0
 203+ 7CF0 0E 3C            ld   c, 60
 204+ 7CF2              .d2:
 205+ 7CF2 0D               dec  c
 206+ 7CF3 20 FD            jr   nz, .d2
 207+ 7CF5
 208+ 7CF5 10 E6            djnz .sound_loop
 209+ 7CF7
 210+ 7CF7 D1               pop  de
 211+ 7CF8 C1               pop  bc
 212+ 7CF9 C9               ret
