 748+ 60F0              ; -------------------------------------------------------------------
 749+ 60F0              ; Disegna un tile 8x8 sullo schermo
 750+ 60F0              ; Input: B = Row (0..23), C = Col (0..31), IX = Puntatore al Tile (9 byte: 1 attr + 8 bitmap)
 751+ 60F0              ; -------------------------------------------------------------------
 752+ 60F0              DrawTile:
 753+ 60F0 C5               push bc
 754+ 60F1 D5               push de
 755+ 60F2 E5               push hl
 756+ 60F3
 757+ 60F3                  ; 1. Calcola indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 758+ 60F3                  ; HighByte = $40 + (B & $18)
 759+ 60F3 78               ld   a, b
 760+ 60F4 E6 18            and  $18
 761+ 60F6 C6 40            add  a, $40
 762+ 60F8 67               ld   h, a              ; H = High byte
 763+ 60F9
 764+ 60F9                  ; LowByte = ((B & 7) * 32) + C
 765+ 60F9 78               ld   a, b
 766+ 60FA E6 07            and  7
 767+ 60FC 87               add  a, a              ; *2
 768+ 60FD 87               add  a, a              ; *4
 769+ 60FE 87               add  a, a              ; *8
 770+ 60FF 87               add  a, a              ; *16
 771+ 6100 87               add  a, a              ; *32
 772+ 6101 81               add  a, c              ; + Col C
 773+ 6102 6F               ld   l, a              ; L = Low byte
 774+ 6103
 775+ 6103                  ; 2. Copia gli 8 byte del bitmap
 776+ 6103 16 08            ld   d, 8              ; 8 scanline
 777+ 6105 DD E5            push ix
 778+ 6107 DD 23            inc  ix                ; Salta l'attributo, vai al bitmap
 779+ 6109              .line_loop:
 780+ 6109 DD 7E 00         ld   a, (ix+0)
