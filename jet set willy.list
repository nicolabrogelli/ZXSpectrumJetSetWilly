 345+ 6AF3              .draw_cell:
 346+ 6AF3 E5               push hl
 347+ 6AF4 DD E1            pop  ix                ; IX = tile pointer
 348+ 6AF6
 349+ 6AF6 FD E5            push iy
 350+ 6AF8 C1               pop  bc                ; B = Row, C = Col
 351+ 6AF9
 352+ 6AF9 CD 63 60         call DrawTile
 353+ 6AFC
 354+ 6AFC DD E1            pop  ix
 355+ 6AFE E1               pop  hl
 356+ 6AFF D1               pop  de
 357+ 6B00 C1               pop  bc
 358+ 6B01 FD E1            pop  iy                ; Ripristina IY
 359+ 6B03 C9               ret
