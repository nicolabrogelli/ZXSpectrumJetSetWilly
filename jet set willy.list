1880+ 73D1 CB 3F            srl  a
1881+ 73D3 CB 3F            srl  a                 ; A = c (0..31)
1882+ 73D5 4F               ld   c, a              ; C = c
1883+ 73D6 7B               ld   a, e              ; A = r
1884+ 73D7
1885+ 73D7 CD 45 71         call GetCellFromUnpacked ; A = cell type
1886+ 73DA
1887+ 73DA                  ; Controlla se è Nasty (3)
1888+ 73DA FE 03            cp   3
1889+ 73DC 28 05            jr   z, .is_nasty
