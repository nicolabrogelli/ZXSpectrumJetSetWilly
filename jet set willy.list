  66+ 6BF7              ; DetermineCurrentRoomID
  67+ 6BF7              ;
  68+ 6BF7              ; Determina l'ID numerico della stanza corrente confrontando
  69+ 6BF7              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  70+ 6BF7              ;
  71+ 6BF7              ; Se viene trovata una corrispondenza:
  72+ 6BF7              ;   A = ID della stanza
  73+ 6BF7              ;   current_room = A
  74+ 6BF7              ;
  75+ 6BF7              ; Mappatura:
  76+ 6BF7              ;   0 = Test Room
  77+ 6BF7              ;   1 = The Bridge
  78+ 6BF7              ;   2 = The Off Licence
  79+ 6BF7              ;   3 = Master Bedroom
  80+ 6BF7              ;   4 = Under The Mega Tree
  81+ 6BF7              ;   5 = At The Foot Of The Mega Tree
  82+ 6BF7              ;   6 = The Drive
  83+ 6BF7              ;   7 = The Security Guard
  84+ 6BF7              ;   8 = The Bathroom
  85+ 6BF7              ;
  86+ 6BF7              ; Se nessuna stanza corrisponde viene impostato:
  87+ 6BF7              ;   current_room = 0
  88+ 6BF7              ; -------------------------------------------------------------------
  89+ 6BF7              DetermineCurrentRoomID:
  90+ 6BF7
  91+ 6BF7                  ; Salva i registri utilizzati
