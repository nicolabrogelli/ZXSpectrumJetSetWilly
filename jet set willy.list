 497  8A9E 3E FF            ld   a, $ff
 498  8AA0 32 4D F3         ld   (digit_key_prev), a
 499  8AA3 32 35 F7         ld   (player_drawn_pos+1), a
 500  8AA6 32 36 F7         ld   (player_old_dir), a
