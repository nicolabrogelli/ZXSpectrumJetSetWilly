 622+ 6AB4 E6 80            and  $80               ; Active?
 623+ 6AB6 28 1F            jr   z, .next
 624+ 6AB8
 625+ 6AB8                  ; 1. Controllo orizzontale: PlayerX - EnemyX + 7 in [0, 22]
 626+ 6AB8 3A 81 7B         ld   a, (PlayerPos)    ; A = PlayerX
 627+ 6ABB DD 96 02         sub  (ix+2)            ; A = PlayerX - EnemyX (Offset 2: Current X)
 628+ 6ABE C6 07            add  a, 7              ; A = PlayerX - EnemyX + 7
 629+ 6AC0 FE 17            cp   23                ; Se >= 23, nessuna collisione con questo
 630+ 6AC2 30 13            jr   nc, .next
 631+ 6AC4
 632+ 6AC4                  ; 2. Controllo verticale: PlayerY - EnemyY + 15 in [0, 30]
 633+ 6AC4 3A 82 7B         ld   a, (PlayerPos+1)  ; A = PlayerY
 634+ 6AC7 DD 96 03         sub  (ix+3)            ; A = PlayerY - EnemyY (Offset 3: Current Y)
 635+ 6ACA C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 636+ 6ACC FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 637+ 6ACE 30 07            jr   nc, .next
