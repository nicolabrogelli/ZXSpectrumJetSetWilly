 111+ 759C              ; -------------------------------------------------------------------
 112+ 759C              ; DetermineCurrentRoomID
 113+ 759C              ;
 114+ 759C              ; Determina l'ID numerico della stanza corrente confrontando
 115+ 759C              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 116+ 759C              ;
 117+ 759C              ; Se viene trovata una corrispondenza:
 118+ 759C              ;   A = ID della stanza
 119+ 759C              ;   current_room = A
 120+ 759C              ;
 121+ 759C              ; Mappatura:
 122+ 759C              ;    0 = The Off Licence
 123+ 759C              ;    1 = The Bridge
 124+ 759C              ;    2 = Under The Mega Tree
 125+ 759C              ;    3 = Gfx_At The Foot Of The Mega Tree
 126+ 759C              ;    4 = The Drive
 127+ 759C              ;    5 = The Security Guard
 128+ 759C              ;    6 = Entrance To Hades
 129+ 759C              ;    7 = Cuckoo's Nest
 130+ 759C              ;    8 = Inside The Mega Trunk
 131+ 759C              ;    9 = On A Branch Over The Drive
 132+ 759C              ;   10 = The Front Door
 133+ 759C              ;   11 = The Hall
 134+ 759C              ;   12 = Tree Top
 135+ 759C              ;   27 = The Chapel
 136+ 759C              ;   28 = First Landing
 137+ 759C              ;   29 = The Nightmare Room
 138+ 759C              ;   33 = The Bathroom
 139+ 759C              ;   35 = Master Bedroom
 140+ 759C              ;
 141+ 759C              ; Se nessuna stanza corrisponde viene impostato:
 142+ 759C              ;   current_room = 0
 143+ 759C              ; -------------------------------------------------------------------
 144+ 759C              DetermineCurrentRoomID:
 145+ 759C
 146+ 759C                  ; Salva i registri utilizzati
