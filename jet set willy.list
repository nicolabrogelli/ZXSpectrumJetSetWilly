1180+ 737C 20 3F            jr   nz, .next_item
1181+ 737E
1182+ 737E                  ; ---------------------------------------------------------------
1183+ 737E                  ; Legge coordinate e stato dell'item
1184+ 737E                  ; ---------------------------------------------------------------
1185+ 737E
1186+ 737E 23               inc  hl
1187+ 737F 4E               ld   c, (hl)           ; C = X
1188+ 7380
1189+ 7380 23               inc  hl
1190+ 7381 46               ld   b, (hl)           ; B = Y
1191+ 7382
1192+ 7382 23               inc  hl                ; salta Color
1193+ 7383
1194+ 7383 23               inc  hl                ; punta a Collected
1195+ 7384
1196+ 7384 7E               ld   a, (hl)
1197+ 7385
1198+ 7385                  ; ---------------------------------------------------------------
1199+ 7385                  ; Item già raccolto?
1200+ 7385                  ; ---------------------------------------------------------------
1201+ 7385 B7               or   a
1202+ 7386 20 39            jr   nz, .next_no_inc
1203+ 7388
1204+ 7388                  ; ---------------------------------------------------------------
