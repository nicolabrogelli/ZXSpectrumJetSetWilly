 185+ 7C86              TOTAL_ITEMS: EQU 5;(ItemsTableEnd - ItemsTable) / 5
 186+ 7C86
 187+ 7C86
 188+ 7C86              ; -------------------------------------------------------------------
 189+ 7C86              ; DetermineCurrentRoomID
 190+ 7C86              ;
 191+ 7C86              ; Determina l'ID numerico della stanza corrente confrontando
 192+ 7C86              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 193+ 7C86              ;
 194+ 7C86              ; Se viene trovata una corrispondenza:
 195+ 7C86              ;   A = ID della stanza
 196+ 7C86              ;   current_room = A
 197+ 7C86              ;
 198+ 7C86              ; Mappatura:
 199+ 7C86              ;    0 = The Off Licence
 200+ 7C86              ;    1 = The Bridge
 201+ 7C86              ;    2 = Under The Mega Tree
 202+ 7C86              ;    3 = Gfx_At The Foot Of The Mega Tree
 203+ 7C86              ;    4 = The Drive
 204+ 7C86              ;    5 = The Security Guard
 205+ 7C86              ;    6 = Entrance To Hades
 206+ 7C86              ;    7 = Cuckoo's Nest
 207+ 7C86              ;    8 = Inside The Mega Trunk
 208+ 7C86              ;    9 = On A Branch Over The Drive
 209+ 7C86              ;   10 = The Front Door
 210+ 7C86              ;   11 = The Hall
 211+ 7C86              ;   12 = Tree Top
 212+ 7C86              ;   27 = The Chapel
 213+ 7C86              ;   28 = First Landing
 214+ 7C86              ;   29 = The Nightmare Room
 215+ 7C86              ;   33 = The Bathroom
 216+ 7C86              ;   35 = Master Bedroom
 217+ 7C86              ;
 218+ 7C86              ; Se nessuna stanza corrisponde viene impostato:
 219+ 7C86              ;   current_room = 0
 220+ 7C86              ; -------------------------------------------------------------------
 221+ 7C86              DetermineCurrentRoomID:
 222+ 7C86
 223+ 7C86                  ; Salva i registri utilizzati
 224+ 7C86 E5               push hl
 225+ 7C87 D5               push de
 226+ 7C88
 227+ 7C88                  ; ---------------------------------------------------------------
 228+ 7C88                  ; Confronto con TheOffLicenceLayout
 229+ 7C88                  ; ---------------------------------------------------------------
 230+ 7C88 2A 96 EA         ld   hl, (room_ptr)
 231+ 7C8B 11 F0 84         ld   de, TheOffLicenceLayout
 232+ 7C8E B7               or   a
 233+ 7C8F ED 52            sbc  hl, de
 234+ 7C91 20 05            jr   nz, .not_office
 235+ 7C93
 236+ 7C93 3E 00            ld   a, 0               ; Room ID = 0
 237+ 7C95 C3 5A 80         jp   .set_room
 238+ 7C98
 239+ 7C98              .not_office:
 240+ 7C98
 241+ 7C98                  ; -------------------------------------------------q--------------
 242+ 7C98                  ; Confronto con TheBridgeLayout
 243+ 7C98                  ; ---------------------------------------------------------------
 244+ 7C98 2A 96 EA         ld   hl, (room_ptr)
 245+ 7C9B 11 0E 86         ld   de, TheBridgeLayout
 246+ 7C9E B7               or   a
 247+ 7C9F ED 52            sbc  hl, de
 248+ 7CA1 20 05            jr   nz, .not_bridge
 249+ 7CA3
 250+ 7CA3 3E 01            ld   a, 1               ; Room ID = 1
 251+ 7CA5 C3 5A 80         jp   .set_room
 252+ 7CA8
 253+ 7CA8              .not_bridge:
 254+ 7CA8
 255+ 7CA8                  ; ---------------------------------------------------------------
 256+ 7CA8                  ; Confronto con UnderTheMegaTreeLayout
 257+ 7CA8                  ; ---------------------------------------------------------------
 258+ 7CA8 2A 96 EA         ld   hl, (room_ptr)
 259+ 7CAB 11 2C 87         ld   de, UnderTheMegaTreeLayout
 260+ 7CAE B7               or   a
 261+ 7CAF ED 52            sbc  hl, de
 262+ 7CB1 20 05            jr   nz, .not_undertree
 263+ 7CB3
 264+ 7CB3 3E 02            ld   a, 2               ; Room ID = 2
 265+ 7CB5 C3 5A 80         jp   .set_room
 266+ 7CB8
 267+ 7CB8              .not_undertree:
 268+ 7CB8
 269+ 7CB8                  ; ---------------------------------------------------------------
 270+ 7CB8                  ; Confronto con AtTheFootTheMegaTreeLayout
 271+ 7CB8                  ; ---------------------------------------------------------------
 272+ 7CB8 2A 96 EA         ld   hl, (room_ptr)
 273+ 7CBB 11 4A 88         ld   de, AtTheFootTheMegaTreeLayout
 274+ 7CBE B7               or   a
