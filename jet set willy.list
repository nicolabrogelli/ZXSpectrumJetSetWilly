 872+ 6AB1 28 2C            jr   z, .yes           ; Row == SlopeRow
 873+ 6AB3 04               inc  b                 ; B = SlopeRow + 1
 874+ 6AB4 B8               cp   b
 875+ 6AB5 28 28            jr   z, .yes           ; Row == SlopeRow + 1
 876+ 6AB7
 877+ 6AB7              .check_platform_case:
 878+ 6AB7                  ; 2. Controlla se è sulla piattaforma adiacente in cima
 879+ 6AB7 3A 07 77         ld   a, (ramp_dir)
 880+ 6ABA B7               or   a
 881+ 6ABB 28 09            jr   z, .plat_left
 882+ 6ABD              .plat_right:
