 518+ 6B96
 519+ 6B96 3A 72 76         ld   a, (room_border_color)
 520+ 6B99 E6 EF            and  $ef               ; Speaker OFF (bit 4 = 0)
 521+ 6B9B D3 FE            out  ($fe), a
 522+ 6B9D 0E 3C            ld   c, 60             ; Mezzo periodo delay
 523+ 6B9F 0D           .d2: dec  c
 524+ 6BA0 20 FD            jr   nz, .d2
 525+ 6BA2
 526+ 6BA2 10 E6            djnz .sound_loop
 527+ 6BA4
 528+ 6BA4 D1               pop  de
 529+ 6BA5 C1               pop  bc
 530+ 6BA6 C9               ret
