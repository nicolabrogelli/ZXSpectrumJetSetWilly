 442+ 6DD0 32 41 75         ld   (enemy_update_timer), a
 443+ 6DD3 18 00            jr   .do_update
 444+ 6DD5
 445+ 6DD5              .do_update:
 446+ 6DD5 DD 21 88 6B      ld   ix, ActiveEnemies
 447+ 6DD9 06 04            ld   b, 4              ; 4 slot
 448+ 6DDB              .loop:
 449+ 6DDB DD 7E 00         ld   a, (ix+0)         ; Flags
 450+ 6DDE E6 80            and  $80               ; Active?
 451+ 6DE0 CA 8B 6E         jp   z, .next
 452+ 6DE3
 453+ 6DE3                  ; 1. Salva la posizione corrente in Old X/Y per la cancellazione nel prossimo frame
 454+ 6DE3 DD 7E 01         ld   a, (ix+1)
 455+ 6DE6 DD 77 07         ld   (ix+7), a         ; Old X = Current X
 456+ 6DE9 DD 7E 02         ld   a, (ix+2)
 457+ 6DEC DD 77 08         ld   (ix+8), a         ; Old Y = Current Y
 458+ 6DEF
 459+ 6DEF                  ; 2. Aggiorna Anim State
 460+ 6DEF DD 7E 06         ld   a, (ix+6)         ; Anim State (0..3)
 461+ 6DF2 3C               inc  a
 462+ 6DF3 E6 03            and  3                 ; Alterna 0..3
 463+ 6DF5 DD 77 06         ld   (ix+6), a
 464+ 6DF8
 465+ 6DF8                  ; 3. Determina se orizzontale o verticale
 466+ 6DF8 DD 7E 00         ld   a, (ix+0)         ; Flags
 467+ 6DFB E6 40            and  $40               ; Vertical? (Bit 6)
 468+ 6DFD C2 47 6E         jp   nz, .vertical
 469+ 6E00
 470+ 6E00              .horizontal:
 471+ 6E00 DD 7E 05         ld   a, (ix+5)         ; Direction (1=Left, 2=Right)
 472+ 6E03 FE 01            cp   1
 473+ 6E05 20 20            jr   nz, .horiz_right
 474+ 6E07
 475+ 6E07              .horiz_left:
 476+ 6E07 DD 7E 01         ld   a, (ix+1)         ; Current X
 477+ 6E0A D6 02            sub  2                 ; Muovi a sinistra di 2 pixel
 478+ 6E0C DD BE 03         cp   (ix+3)            ; Min Limit
 479+ 6E0F 28 08            jr   z, .h_rev_right
 480+ 6E11 38 06            jr   c, .h_rev_right
 481+ 6E13 DD 77 01         ld   (ix+1), a
 482+ 6E16 C3 8B 6E         jp   .next
 483+ 6E19
 484+ 6E19              .h_rev_right:
 485+ 6E19 DD 7E 03         ld   a, (ix+3)         ; Min Limit
 486+ 6E1C DD 77 01         ld   (ix+1), a
 487+ 6E1F 3E 02            ld   a, 2
 488+ 6E21 DD 77 05         ld   (ix+5), a         ; Cambia direzione a Destra
 489+ 6E24 C3 8B 6E         jp   .next
 490+ 6E27
 491+ 6E27              .horiz_right:
 492+ 6E27 DD 7E 01         ld   a, (ix+1)         ; Current X
 493+ 6E2A C6 02            add  a, 2              ; Muovi a destra di 2 pixel
 494+ 6E2C DD BE 04         cp   (ix+4)            ; Max Limit
 495+ 6E2F 28 08            jr   z, .h_rev_left
 496+ 6E31 30 06            jr   nc, .h_rev_left
 497+ 6E33 DD 77 01         ld   (ix+1), a
 498+ 6E36 C3 8B 6E         jp   .next
 499+ 6E39
 500+ 6E39              .h_rev_left:
 501+ 6E39 DD 7E 04         ld   a, (ix+4)         ; Max Limit
 502+ 6E3C DD 77 01         ld   (ix+1), a
 503+ 6E3F 3E 01            ld   a, 1
 504+ 6E41 DD 77 05         ld   (ix+5), a         ; Cambia direzione a Sinistra
 505+ 6E44 C3 8B 6E         jp   .next
 506+ 6E47
 507+ 6E47              .vertical:
 508+ 6E47 DD 7E 05         ld   a, (ix+5)         ; Direction (1=Up, 2=Down)
 509+ 6E4A FE 01            cp   1
 510+ 6E4C 20 20            jr   nz, .vert_down
 511+ 6E4E
 512+ 6E4E              .vert_up:
 513+ 6E4E DD 7E 02         ld   a, (ix+2)         ; Current Y
 514+ 6E51 D6 02            sub  2                 ; Muovi in alto di 2 pixel
 515+ 6E53 DD BE 03         cp   (ix+3)            ; Min Limit (Top)
 516+ 6E56 28 08            jr   z, .v_rev_down
 517+ 6E58 38 06            jr   c, .v_rev_down
 518+ 6E5A DD 77 02         ld   (ix+2), a
 519+ 6E5D C3 8B 6E         jp   .next
 520+ 6E60
 521+ 6E60              .v_rev_down:
 522+ 6E60 DD 7E 03         ld   a, (ix+3)         ; Min Limit
 523+ 6E63 DD 77 02         ld   (ix+2), a
 524+ 6E66 3E 02            ld   a, 2
 525+ 6E68 DD 77 05         ld   (ix+5), a         ; Cambia direzione in Basso
 526+ 6E6B C3 8B 6E         jp   .next
 527+ 6E6E
 528+ 6E6E              .vert_down:
 529+ 6E6E DD 7E 02         ld   a, (ix+2)         ; Current Y
 530+ 6E71 C6 02            add  a, 2              ; Muovi in basso di 2 pixel
 531+ 6E73 DD BE 04         cp   (ix+4)            ; Max Limit (Bottom)
 532+ 6E76 28 08            jr   z, .v_rev_up
 533+ 6E78 30 06            jr   nc, .v_rev_up
 534+ 6E7A DD 77 02         ld   (ix+2), a
 535+ 6E7D C3 8B 6E         jp   .next
 536+ 6E80
 537+ 6E80              .v_rev_up:
 538+ 6E80 DD 7E 04         ld   a, (ix+4)         ; Max Limit
 539+ 6E83 DD 77 02         ld   (ix+2), a
 540+ 6E86 3E 01            ld   a, 1
 541+ 6E88 DD 77 05         ld   (ix+5), a         ; Cambia direzione in Alto
 542+ 6E8B
 543+ 6E8B              .next:
