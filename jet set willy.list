  72+ 828A ~            ; Audio_UpdateMusic
  73+ 828A ~            ;
  74+ 828A ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 828A ~            ; Viene chiamata a ogni frame.
  76+ 828A ~            ; -------------------------------------------------------------------
  77+ 828A ~            Audio_UpdateMusic:
  78+ 828A ~                push af
  79+ 828A ~                push bc
  80+ 828A ~                push de
  81+ 828A ~                push hl
  82+ 828A ~
  83+ 828A ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 828A ~                ld   a, (Audio_jump_sound_note)
  85+ 828A ~                cp   18
  86+ 828A ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 828A ~
  88+ 828A ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 828A ~                ld   a, (Audio_music_frame_counter)
  90+ 828A ~                dec  a
  91+ 828A ~                ld   (Audio_music_frame_counter), a
  92+ 828A ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 828A ~
  94+ 828A ~                ; Altrimenti carica la nota successiva
  95+ 828A ~                ld   a, (Audio_music_note_idx)
  96+ 828A ~                inc  a
  97+ 828A ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 828A ~                jr   c, .no_wrap
  99+ 828A ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 828A ~            .no_wrap:
 101+ 828A ~                ld   (Audio_music_note_idx), a
 102+ 828A ~
 103+ 828A ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 828A ~                ld   e, a
 105+ 828A ~                ld   d, 0
 106+ 828A ~                ld   hl, Audio_MusicSheet
 107+ 828A ~                add  hl, de
 108+ 828A ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 828A ~
 110+ 828A ~                ; Leggi durata (secondo byte)
 111+ 828A ~                inc  hl
 112+ 828A ~                ld   a, (hl)
 113+ 828A ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 828A ~                jr   nz, .dur_ok
 115+ 828A ~                ld   a, 1
 116+ 828A ~            .dur_ok:
 117+ 828A ~                ld   (Audio_music_frame_counter), a
 118+ 828A ~
 119+ 828A ~            .play_current_note:
 120+ 828A ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 828A ~                ld   a, (Audio_music_note_idx)
 122+ 828A ~                ld   e, a
 123+ 828A ~                ld   d, 0
 124+ 828A ~                ld   hl, Audio_MusicSheet
 125+ 828A ~                add  hl, de
 126+ 828A ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 828A ~                ld   a, (hl)                  ; A = delay
 128+ 828A ~                or   a
 129+ 828A ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 828A ~
 131+ 828A ~                ; Suona la nota: 2 cicli
 132+ 828A ~                ld   d, a                     ; D = delay
 133+ 828A ~                ld   b, 2                     ; 2 cicli per frame
 134+ 828A ~            .note_loop:
 135+ 828A ~                ; Speaker ON
 136+ 828A ~                ld   a, (room_border_color)
 137+ 828A ~                or   $10
 138+ 828A ~                out  ($fe), a
 139+ 828A ~                ld   c, d
 140+ 828A ~            .d1:
 141+ 828A ~                push af
 142+ 828A ~                pop  af
 143+ 828A ~                dec  c
 144+ 828A ~                jr   nz, .d1
 145+ 828A ~
 146+ 828A ~                ; Speaker OFF
 147+ 828A ~                ld   a, (room_border_color)
 148+ 828A ~                and  $ef
 149+ 828A ~                out  ($fe), a
 150+ 828A ~                ld   c, d
 151+ 828A ~            .d2:
 152+ 828A ~                push af
 153+ 828A ~                pop  af
 154+ 828A ~                dec  c
 155+ 828A ~                jr   nz, .d2
 156+ 828A ~
 157+ 828A ~                djnz .note_loop
 158+ 828A ~
 159+ 828A ~            .done:
 160+ 828A ~                pop  hl
 161+ 828A ~                pop  de
 162+ 828A ~                pop  bc
 163+ 828A ~                pop  af
 164+ 828A ~                ret
 165+ 828A ~
 166+ 828A ~            Audio_MusicSheet:
 167+ 828A ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 828A ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 828A ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 828A ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 828A ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 828A ~                db 90, 10, 107, 20, 68, 65
 173+ 828A                  ELSE
 174+ 828A              Audio_UpdateMusic:
