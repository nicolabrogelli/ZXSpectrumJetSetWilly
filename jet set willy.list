  55+ 5E0E              ; ===================================================================
  56+ 5E0E              ; NUOVE ROUTINE DI RENDERING PIXEL-BY-PIXEL
  57+ 5E0E              ; ===================================================================
  58+ 5E0E
  59+ 5E0E              ; -------------------------------------------------------------------
  60+ 5E0E              ; Calcola indirizzo schermo da coordinate pixel (X, Y)
  61+ 5E0E              ; Input: H = Y (0..191), L = X (0..255)
  62+ 5E0E              ; Output: HL = indirizzo schermo
  63+ 5E0E              ; -------------------------------------------------------------------
  64+ 5E0E              GetScreenAddr:
  65+ 5E0E 7C               ld a, h
  66+ 5E0F E6 07            and %00000111     ; A = y2 y1 y0 (scanline offset)
  67+ 5E11 F6 40            or  %01000000     ; Base dello schermo ($40)
  68+ 5E13 57               ld  d, a          ; D = high byte parziale
  69+ 5E14
  70+ 5E14 7C               ld  a, h
  71+ 5E15 E6 C0            and %11000000     ; A = y7 y6 000000 (third select)
  72+ 5E17 0F               rrca
  73+ 5E18 0F               rrca
  74+ 5E19 0F               rrca              ; Shift a destra di 3 -> 000 y7 y6 000
  75+ 5E1A B2               or  d
  76+ 5E1B 57               ld  d, a          ; D = high byte completo (010 y7 y6 y2 y1 y0)
  77+ 5E1C
  78+ 5E1C 7C               ld  a, h
  79+ 5E1D E6 38            and %00111000     ; A = 00 y5 y4 y3 000 (character row)
  80+ 5E1F 87               add a, a
  81+ 5E20 87               add a, a          ; Shift a sinistra di 2 -> y5 y4 y3 00000
  82+ 5E21 5F               ld  e, a          ; E = low byte parziale
  83+ 5E22
  84+ 5E22 7D               ld  a, l
  85+ 5E23 CB 3F            srl a
  86+ 5E25 CB 3F            srl a
  87+ 5E27 CB 3F            srl a              ; A = X / 8 (colonna)
  88+ 5E29 B3               or  e
  89+ 5E2A 5F               ld  e, a          ; E = low byte completo
  90+ 5E2B
  91+ 5E2B 62               ld  h, d
  92+ 5E2C 6B               ld  l, e          ; HL = indirizzo finale
  93+ 5E2D C9               ret
  94+ 5E2E
  95+ 5E2E              ; -------------------------------------------------------------------
  96+ 5E2E              ; Incrementa indirizzo schermo alla riga (scanline) successiva
  97+ 5E2E              ; Input/Output: HL = indirizzo schermo
  98+ 5E2E              ; -------------------------------------------------------------------
  99+ 5E2E              IncScreenLine:
 100+ 5E2E 24               inc h             ; Vai alla riga successiva
 101+ 5E2F 7C               ld  a, h
 102+ 5E30 E6 07            and 7             ; Controlla se la scanline è tornata a 0 (wrap)
 103+ 5E32 C0               ret nz            ; Se non è 0, abbiamo finito!
 104+ 5E33
 105+ 5E33 7D               ld  a, l
 106+ 5E34 C6 20            add a, 32         ; Altrimenti passa alla riga di caratteri successiva
 107+ 5E36 6F               ld  l, a
 108+ 5E37 D8               ret c             ; Se c'è carry, abbiamo cambiato terzo e H è già corretto!
 109+ 5E38
 110+ 5E38                  ; Se non c'è carry, rimaniamo nello stesso terzo. Ripristina il terzo corretto in H.
 111+ 5E38 7C               ld  a, h
 112+ 5E39 D6 08            sub 8
 113+ 5E3B 67               ld  h, a
 114+ 5E3C C9               ret
 115+ 5E3D
 116+ 5E3D              ; -------------------------------------------------------------------
 117+ 5E3D              ; Disegna uno sprite 8x8 a coordinate pixel (X, Y)
 118+ 5E3D              ; Input: C = X, B = Y, IX = puntatore dati sprite (8 byte)
 119+ 5E3D              ; -------------------------------------------------------------------
 120+ 5E3D              DrawPixelSprite8x8:
 121+ 5E3D C5               push bc
 122+ 5E3E D5               push de
 123+ 5E3F E5               push hl
 124+ 5E40 DD E5            push ix
 125+ 5E42
 126+ 5E42                  ; 1. Calcola indirizzo schermo
 127+ 5E42 60               ld   h, b
 128+ 5E43 69               ld   l, c
 129+ 5E44 CD 0E 5E         call GetScreenAddr ; HL = indirizzo schermo
 130+ 5E47
 131+ 5E47                  ; 2. Calcola offset shift = X & 7
 132+ 5E47 79               ld   a, c
 133+ 5E48 E6 07            and  7
 134+ 5E4A 47               ld   b, a          ; B = shift offset (0..7)
 135+ 5E4B
 136+ 5E4B 0E 08            ld   c, 8          ; 8 linee
 137+ 5E4D              .line_loop:
 138+ 5E4D DD 7E 00         ld   a, (ix+0)     ; A = byte dello sprite
 139+ 5E50 57               ld   d, a
 140+ 5E51 1E 00            ld   e, 0
 141+ 5E53
 142+ 5E53 78               ld   a, b          ; Shift se necessario
 143+ 5E54 B7               or   a
 144+ 5E55 28 07            jr   z, .no_shift
 145+ 5E57
 146+ 5E57              .shift_loop:
 147+ 5E57 CB 3A            srl  d
 148+ 5E59 CB 1B            rr   e
 149+ 5E5B 3D               dec  a
 150+ 5E5C 20 F9            jr   nz, .shift_loop
 151+ 5E5E
 152+ 5E5E              .no_shift:
 153+ 5E5E                  ; Scrivi sullo schermo (sovrascrittura diretta)
 154+ 5E5E 7A               ld   a, d
 155+ 5E5F 77               ld   (hl), a
 156+ 5E60 23               inc  hl
 157+ 5E61 7B               ld   a, e
 158+ 5E62 77               ld   (hl), a
 159+ 5E63 2B               dec  hl            ; Ritorna alla colonna iniziale
 160+ 5E64
 161+ 5E64 CD 2E 5E         call IncScreenLine ; Prossima scanline sullo schermo
 162+ 5E67 DD 23            inc  ix            ; Prossimo byte dello sprite
 163+ 5E69 0D               dec  c
 164+ 5E6A 20 E1            jr   nz, .line_loop
 165+ 5E6C
 166+ 5E6C DD E1            pop  ix
 167+ 5E6E E1               pop  hl
 168+ 5E6F D1               pop  de
 169+ 5E70 C1               pop  bc
 170+ 5E71 C9               ret
 171+ 5E72
 172+ 5E72              ; -------------------------------------------------------------------
 173+ 5E72              ; Ripristina un byte dello sfondo statico.
 174+ 5E72              ; Input: A = X del byte schermo in pixel (0, 8, 16...), D = Y pixel
 175+ 5E72              ; Output: A = byte di sfondo
 176+ 5E72              ; ---------------------------------------------------------------
 177+ 5E72              GetBackgroundByte:
 178+ 5E72 E5               push hl
 179+ 5E73 D5               push de
 180+ 5E74 C5               push bc
 181+ 5E75
 182+ 5E75 47               ld   b, a              ; B = X (pixel)
 183+ 5E76
 184+ 5E76                  ; 1. Controlla se Y (in D) è fuori dalla griglia di layout (Y < 24 o Y >= 152)
 185+ 5E76 7A               ld   a, d
 186+ 5E77 FE 18            cp   24
 187+ 5E79 38 78            jr   c, .blank
 188+ 5E7B FE 98            cp   152
 189+ 5E7D 30 74            jr   nc, .blank
 190+ 5E7F
 191+ 5E7F                  ; 2. Calcola riga di layout: r = (Y - 24) / 8
 192+ 5E7F D6 18            sub  24
 193+ 5E81 CB 3F            srl  a
 194+ 5E83 CB 3F            srl  a
 195+ 5E85 CB 3F            srl  a                 ; A = r (0..15)
 196+ 5E87
 197+ 5E87                  ; 3. HL = r * 8
 198+ 5E87 6F               ld   l, a
 199+ 5E88 26 00            ld   h, 0
 200+ 5E8A 29               add  hl, hl
 201+ 5E8B 29               add  hl, hl
 202+ 5E8C 29               add  hl, hl            ; HL = r * 8
 203+ 5E8D
 204+ 5E8D                  ; 4. Calcola colonna di layout: c = X / 8 (in B)
 205+ 5E8D 78               ld   a, b
 206+ 5E8E CB 3F            srl  a
 207+ 5E90 CB 3F            srl  a
 208+ 5E92 CB 3F            srl  a                 ; A = c (0..31)
 209+ 5E94 47               ld   b, a              ; B = c
 210+ 5E95
 211+ 5E95                  ; HL = r * 8 + c / 4
 212+ 5E95 CB 3F            srl  a
 213+ 5E97 CB 3F            srl  a                 ; A = c / 4 (0..7)
 214+ 5E99 85               add  a, l
 215+ 5E9A 6F               ld   l, a              ; HL = r * 8 + (c / 4)
 216+ 5E9B
 217+ 5E9B D5               push de
 218+ 5E9C ED 5B 7C 6E      ld   de, (room_ptr)
 219+ 5EA0 19               add  hl, de            ; HL = layout byte address
 220+ 5EA1 D1               pop  de
 221+ 5EA2 7E               ld   a, (hl)           ; A = layout byte
 222+ 5EA3
 223+ 5EA3                  ; Estrai il bit-pair corrispondente a c % 4
 224+ 5EA3 4F               ld   c, a              ; C = layout byte
 225+ 5EA4 78               ld   a, b
 226+ 5EA5 E6 03            and  3                 ; A = c % 4
 227+ 5EA7 28 15            jr   z, .shift_0
 228+ 5EA9 3D               dec  a
 229+ 5EAA 28 0B            jr   z, .shift_1
 230+ 5EAC 3D               dec  a
 231+ 5EAD 28 03            jr   z, .shift_2
 232+ 5EAF                  ; Case 3 (c % 4 = 3)
 233+ 5EAF 79               ld   a, c
 234+ 5EB0 18 0F            jr   .got_type
 235+ 5EB2              .shift_2:
 236+ 5EB2 79               ld   a, c
 237+ 5EB3 0F               rrca
 238+ 5EB4 0F               rrca
 239+ 5EB5 18 0A            jr   .got_type
 240+ 5EB7              .shift_1:
 241+ 5EB7 79               ld   a, c
 242+ 5EB8 0F               rrca
 243+ 5EB9 0F               rrca
 244+ 5EBA 0F               rrca
 245+ 5EBB 0F               rrca
 246+ 5EBC 18 03            jr   .got_type
 247+ 5EBE              .shift_0:
 248+ 5EBE 79               ld   a, c
 249+ 5EBF 07               rlca
 250+ 5EC0 07               rlca
 251+ 5EC1              .got_type:
 252+ 5EC1 E6 03            and  3                 ; A = cell type (0..3)
 253+ 5EC3
 254+ 5EC3                  ; 5. Ottieni il puntatore al tile corrispondente
 255+ 5EC3 B7               or   a
 256+ 5EC4 20 05            jr   nz, .not_bg
 257+ 5EC6 21 A0 00         ld   hl, OFFSET_BG
 258+ 5EC9 18 13            jr   .load_tile
 259+ 5ECB              .not_bg:
 260+ 5ECB 3D               dec  a
 261+ 5ECC 20 05            jr   nz, .not_floor
 262+ 5ECE 21 A9 00         ld   hl, OFFSET_FLOOR
 263+ 5ED1 18 0B            jr   .load_tile
 264+ 5ED3              .not_floor:
