 385  87D4 77               ld   (hl), a
 386  87D5 23               inc  hl
 387  87D6 10 FC            djnz .color_cycle_loop
 388  87D8
 389  87D8                  ; Controlla se il tasto ENTER è premuto
 390  87D8 3E BF            ld   a, $bf
 391  87DA DB FE            in   a, ($fe)
 392  87DC 1F               rra
 393  87DD 38 DF            jr   c, .wait_enter_press
