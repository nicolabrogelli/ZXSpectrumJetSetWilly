1075+ 8012              ; -------------------------------------------------------------------
1076+ 8012              ; Items_DrawRoom
1077+ 8012              ;
1078+ 8012              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1079+ 8012              ;
1080+ 8012              ; Operazioni eseguite:
1081+ 8012              ;   1. Azzera la griglia items_grid.
1082+ 8012              ;   2. Svuota la cache degli oggetti attivi.
1083+ 8012              ;   3. Scansiona ItemsTable.
1084+ 8012              ;   4. Per ogni item della stanza corrente:
1085+ 8012              ;        - verifica se è già stato raccolto
1086+ 8012              ;        - disegna la grafica
1087+ 8012              ;        - aggiorna items_grid
1088+ 8012              ;        - memorizza l'item nella cache current_room_items
1089+ 8012              ;   5. Aggiorna num_room_items.
1090+ 8012              ;
1091+ 8012              ; Record ItemsTable:
1092+ 8012              ;   +0  Room ID
1093+ 8012              ;   +1  X (colonna)
1094+ 8012              ;   +2  Y (riga)
1095+ 8012              ;   +3  Colore
1096+ 8012              ;   +4  Collected flag
1097+ 8012              ;
1098+ 8012              ; Cache current_room_items:
1099+ 8012              ;   +0  Colonna
1100+ 8012              ;   +1  Riga
1101+ 8012              ;   +2  Colore
1102+ 8012              ;   +3  Collected flag ptr (Low)
1103+ 8012              ;   +4  Collected flag ptr (High)
1104+ 8012              ;
1105+ 8012              ; Ogni record cache occupa 5 byte.
1106+ 8012              ; -------------------------------------------------------------------
1107+ 8012              ; ResetItemsTable
1108+ 8012              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1109+ 8012              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1110+ 8012              ; -------------------------------------------------------------------
1111+ 8012              ResetItemsTable:
1112+ 8012 21 BB 7A         ld   hl, ItemsTable
1113+ 8015              .reset_loop:
1114+ 8015 7E               ld   a, (hl)
1115+ 8016 FE FF            cp   $FF
1116+ 8018 C8               ret  z
1117+ 8019 23               inc  hl                        ; +1 (X)
1118+ 801A 23               inc  hl                        ; +2 (Y)
1119+ 801B 23               inc  hl                        ; +3 (Color)
1120+ 801C 23               inc  hl                        ; +4 (Collected flag)
1121+ 801D 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1122+ 801F 23               inc  hl                        ; Prossimo record
1123+ 8020 18 F3            jr   .reset_loop
1124+ 8022
1125+ 8022              ; -------------------------------------------------------------------
1126+ 8022              Items_DrawRoom:
1127+ 8022
1128+ 8022                  ; Salva tutti i registri utilizzati
1129+ 8022 E5               push hl
1130+ 8023 D5               push de
1131+ 8024 C5               push bc
1132+ 8025 DD E5            push ix
1133+ 8027 FD E5            push iy
1134+ 8029
1135+ 8029                  ; ---------------------------------------------------------------
1136+ 8029                  ; Azzera items_grid (32 x 16 = 512 byte)
1137+ 8029                  ; ---------------------------------------------------------------
1138+ 8029 21 BD E4         ld   hl, items_grid
1139+ 802C 11 BE E4         ld   de, items_grid + 1
1140+ 802F 36 00            ld   (hl), 0
1141+ 8031 01 FF 01         ld   bc, 511
1142+ 8034 ED B0            ldir
1143+ 8036
1144+ 8036                  ; ---------------------------------------------------------------
1145+ 8036                  ; Nessun item attivo nella stanza
1146+ 8036                  ; ---------------------------------------------------------------
1147+ 8036 AF               xor  a
1148+ 8037 32 3C EA         ld   (num_room_items), a
1149+ 803A
1150+ 803A                  ; IY punta alla cache degli item attivi
1151+ 803A FD 21 EC E9      ld   iy, current_room_items
1152+ 803E
1153+ 803E                  ; ---------------------------------------------------------------
1154+ 803E                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1155+ 803E                  ; alla stanza corrente.
1156+ 803E                  ;
1157+ 803E                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1158+ 803E                  ; ---------------------------------------------------------------
1159+ 803E 2A 3D EA         ld   hl, (room_ptr)
1160+ 8041 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1161+ 8044 19               add  hl, de
1162+ 8045
1163+ 8045 E5               push hl
1164+ 8046 DD E1            pop  ix                ; IX = bitmap item
1165+ 8048
1166+ 8048                  ; ---------------------------------------------------------------
1167+ 8048                  ; Inizio scansione della tabella degli item
1168+ 8048                  ; ---------------------------------------------------------------
1169+ 8048 21 BB 7A         ld   hl, ItemsTable
1170+ 804B
1171+ 804B              .loop:
1172+ 804B
1173+ 804B                  ; ---------------------------------------------------------------
1174+ 804B                  ; Legge il Room ID del record corrente
1175+ 804B                  ; ---------------------------------------------------------------
1176+ 804B 7E               ld   a, (hl)
1177+ 804C
1178+ 804C                  ; $FF indica fine tabella
1179+ 804C FE FF            cp   $FF
1180+ 804E 28 53            jr   z, .done
1181+ 8050
1182+ 8050                  ; ---------------------------------------------------------------
1183+ 8050                  ; Verifica se l'item appartiene alla stanza corrente
1184+ 8050                  ; ---------------------------------------------------------------
1185+ 8050 57               ld   d, a
1186+ 8051
1187+ 8051 3A E3 E9         ld   a, (current_room)
1188+ 8054 BA               cp   d
1189+ 8055 20 45            jr   nz, .next_item
1190+ 8057
1191+ 8057                  ; ---------------------------------------------------------------
1192+ 8057                  ; Legge i dati dell'item
1193+ 8057                  ; ---------------------------------------------------------------
1194+ 8057
1195+ 8057 23               inc  hl
1196+ 8058 4E               ld   c, (hl)           ; X (colonna)
1197+ 8059
1198+ 8059 23               inc  hl
1199+ 805A 46               ld   b, (hl)           ; Y (riga)
1200+ 805B
1201+ 805B 23               inc  hl
1202+ 805C 5E               ld   e, (hl)           ; Colore
1203+ 805D
1204+ 805D 23               inc  hl
1205+ 805E 7E               ld   a, (hl)           ; Collected flag
1206+ 805F
1207+ 805F                  ; Se diverso da zero l'item è già stato raccolto
1208+ 805F B7               or   a
1209+ 8060 20 3E            jr   nz, .next_no_inc
1210+ 8062
1211+ 8062                  ; ---------------------------------------------------------------
1212+ 8062                  ; Disegna l'item sullo schermo
1213+ 8062                  ;
1214+ 8062                  ; B = Row
1215+ 8062                  ; C = Column
1216+ 8062                  ; HL = bitmap pointer
1217+ 8062                  ; E = Color
1218+ 8062                  ; ---------------------------------------------------------------
1219+ 8062 E5               push hl
1220+ 8063
1221+ 8063 DD E5            push ix
1222+ 8065 E1               pop  hl
1223+ 8066
1224+ 8066 CD AB 80         call DrawItemGraphic
1225+ 8069
1226+ 8069 E1               pop  hl                ; ritorna al flag collected
1227+ 806A
1228+ 806A                  ; ---------------------------------------------------------------
1229+ 806A                  ; Aggiorna items_grid
1230+ 806A                  ;
1231+ 806A                  ; Calcolo:
1232+ 806A                  ;   offset = Row * 32 + Col
1233+ 806A                  ; ---------------------------------------------------------------
1234+ 806A E5               push hl
1235+ 806B D5               push de
1236+ 806C
1237+ 806C 26 00            ld   h, 0
1238+ 806E 68               ld   l, b              ; HL = Row
1239+ 806F
1240+ 806F 29               add  hl, hl            ; *2
1241+ 8070 29               add  hl, hl            ; *4
1242+ 8071 29               add  hl, hl            ; *8
1243+ 8072 29               add  hl, hl            ; *16
1244+ 8073 29               add  hl, hl            ; *32
1245+ 8074
1246+ 8074 16 00            ld   d, 0
1247+ 8076 59               ld   e, c              ; DE = Col
1248+ 8077
1249+ 8077 19               add  hl, de            ; Row*32 + Col
1250+ 8078
1251+ 8078 11 BD E4         ld   de, items_grid
1252+ 807B 19               add  hl, de            ; puntatore nella griglia
1253+ 807C
1254+ 807C D1               pop  de                ; ripristina colore
1255+ 807D
1256+ 807D 73               ld   (hl), e           ; salva colore cella
1257+ 807E
1258+ 807E E1               pop  hl
1259+ 807F
1260+ 807F                  ; ---------------------------------------------------------------
1261+ 807F                  ; Salva l'item nella cache della stanza
1262+ 807F                  ;
1263+ 807F                  ; Questo evita di dover scansionare tutta ItemsTable
1264+ 807F                  ; durante il controllo delle collisioni.
1265+ 807F                  ; ---------------------------------------------------------------
1266+ 807F
1267+ 807F FD 71 00         ld   (iy+0), c         ; Colonna
1268+ 8082 FD 70 01         ld   (iy+1), b         ; Riga
1269+ 8085 FD 73 02         ld   (iy+2), e         ; Colore
1270+ 8088
1271+ 8088                  ; Salva il puntatore al flag "collected"
1272+ 8088 FD 75 03         ld   (iy+3), l         ; Low byte
1273+ 808B FD 74 04         ld   (iy+4), h         ; High byte
1274+ 808E
1275+ 808E                  ; Passa al record successivo della cache
1276+ 808E 01 05 00         ld   bc, 5
1277+ 8091 FD 09            add  iy, bc
1278+ 8093
1279+ 8093                  ; Incrementa il numero di item attivi
1280+ 8093 3A 3C EA         ld   a, (num_room_items)
1281+ 8096 3C               inc  a
1282+ 8097 32 3C EA         ld   (num_room_items), a
1283+ 809A
1284+ 809A 18 04            jr   .next_no_inc
1285+ 809C
1286+ 809C              .next_item:
1287+ 809C
1288+ 809C                  ; ---------------------------------------------------------------
1289+ 809C                  ; L'item non appartiene alla stanza corrente.
1290+ 809C                  ; Salta i campi del record:
1291+ 809C                  ;   X
1292+ 809C                  ;   Y
1293+ 809C                  ;   Color
1294+ 809C                  ;   Collected
1295+ 809C                  ; ---------------------------------------------------------------
1296+ 809C 23               inc  hl
1297+ 809D 23               inc  hl
1298+ 809E 23               inc  hl
1299+ 809F 23               inc  hl
1300+ 80A0
1301+ 80A0              .next_no_inc:
1302+ 80A0
1303+ 80A0                  ; ---------------------------------------------------------------
1304+ 80A0                  ; Avanza al record successivo
1305+ 80A0                  ; (prossimo Room ID)
1306+ 80A0                  ; ---------------------------------------------------------------
1307+ 80A0 23               inc  hl
1308+ 80A1 18 A8            jr   .loop
1309+ 80A3
1310+ 80A3              .done:
1311+ 80A3
1312+ 80A3                  ; Ripristina i registri
1313+ 80A3 FD E1            pop  iy
1314+ 80A5 DD E1            pop  ix
1315+ 80A7 D1               pop  de
1316+ 80A8 C1               pop  bc
1317+ 80A9 E1               pop  hl
1318+ 80AA
1319+ 80AA C9               ret
1320+ 80AB
1321+ 80AB              ; -------------------------------------------------------------------
1322+ 80AB              ; DrawItemGraphic
1323+ 80AB              ;
1324+ 80AB              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1325+ 80AB              ; utilizzando una bitmap di 8 byte e un attributo colore.
1326+ 80AB              ;
1327+ 80AB              ; Input:
1328+ 80AB              ;   B = Riga attributi (3..18)
1329+ 80AB              ;   C = Colonna attributi (0..31)
1330+ 80AB              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1331+ 80AB              ;   E = Attributo colore
1332+ 80AB              ;
1333+ 80AB              ; Output:
1334+ 80AB              ;   Nessuno
1335+ 80AB              ;
1336+ 80AB              ; Registri preservati:
1337+ 80AB              ;   BC, DE, HL
1338+ 80AB              ; -------------------------------------------------------------------
1339+ 80AB              DrawItemGraphic:
1340+ 80AB
1341+ 80AB                  ; Salva i registri originali
1342+ 80AB C5               push bc
1343+ 80AC D5               push de
1344+ 80AD E5               push hl
1345+ 80AE
1346+ 80AE                  ; ---------------------------------------------------------------
1347+ 80AE                  ; Calcolo indirizzo bitmap dello Spectrum
1348+ 80AE                  ;
1349+ 80AE                  ; Ogni item occupa una cella attributi (8x8 pixel).
1350+ 80AE                  ;
1351+ 80AE                  ; Formula:
1352+ 80AE                  ;   High = $40 + (Row AND $18)
1353+ 80AE                  ;   Low  = (Row AND 7) * 32 + Col
1354+ 80AE                  ;
1355+ 80AE                  ; DE conterrà l'indirizzo della prima scanline.
1356+ 80AE                  ; ---------------------------------------------------------------
1357+ 80AE
1358+ 80AE 78               ld   a, b
1359+ 80AF E6 18            and  $18
1360+ 80B1 C6 40            add  a, $40
1361+ 80B3 57               ld   d, a              ; Byte alto indirizzo video
1362+ 80B4
1363+ 80B4 78               ld   a, b
1364+ 80B5 E6 07            and  7                 ; Riga interna al blocco da 8
1365+ 80B7
1366+ 80B7 87               add  a, a              ; *2
1367+ 80B8 87               add  a, a              ; *4
1368+ 80B9 87               add  a, a              ; *8
1369+ 80BA 87               add  a, a              ; *16
1370+ 80BB 87               add  a, a              ; *32
1371+ 80BC
1372+ 80BC 81               add  a, c              ; + colonna
1373+ 80BD
1374+ 80BD 5F               ld   e, a              ; Byte basso indirizzo video
1375+ 80BE
1376+ 80BE                  ; ---------------------------------------------------------------
1377+ 80BE                  ; Disegno bitmap
1378+ 80BE                  ;
1379+ 80BE                  ; Copia 8 byte consecutivi nella memoria video.
1380+ 80BE                  ; Ogni byte rappresenta una scanline da 8 pixel.
1381+ 80BE                  ; ---------------------------------------------------------------
1382+ 80BE
1383+ 80BE C5               push bc                ; Conserva Row e Col
1384+ 80BF
1385+ 80BF 06 08            ld   b, 8              ; Numero scanline
1386+ 80C1
1387+ 80C1              .line_loop:
1388+ 80C1
1389+ 80C1 7E               ld   a, (hl)           ; Legge scanline bitmap
1390+ 80C2 12               ld   (de), a           ; Scrive nella memoria video
1391+ 80C3
1392+ 80C3 14               inc  d                 ; Scanline successiva
1393+ 80C4 23               inc  hl                ; Byte bitmap successivo
1394+ 80C5
1395+ 80C5 05               dec  b
1396+ 80C6 20 F9            jr   nz, .line_loop
1397+ 80C8
1398+ 80C8 C1               pop  bc                ; Ripristina Row e Col
1399+ 80C9
1400+ 80C9                  ; ---------------------------------------------------------------
1401+ 80C9                  ; Calcolo indirizzo attributo
1402+ 80C9                  ;
1403+ 80C9                  ; Formula:
1404+ 80C9                  ;   AttrAddr = $5800 + Row * 32 + Col
1405+ 80C9                  ;
1406+ 80C9                  ; HL conterrà l'indirizzo della cella attributi.
1407+ 80C9                  ; ---------------------------------------------------------------
1408+ 80C9
1409+ 80C9 26 00            ld   h, 0
1410+ 80CB 68               ld   l, b              ; HL = Row
1411+ 80CC
1412+ 80CC 29               add  hl, hl            ; *2
1413+ 80CD 29               add  hl, hl            ; *4
1414+ 80CE 29               add  hl, hl            ; *8
1415+ 80CF 29               add  hl, hl            ; *16
1416+ 80D0 29               add  hl, hl            ; *32
1417+ 80D1
1418+ 80D1 79               ld   a, c              ; A = Colonna
1419+ 80D2
1420+ 80D2 85               add  a, l
1421+ 80D3 6F               ld   l, a
1422+ 80D4
1423+ 80D4 30 01            jr   nc, .no_carry
1424+ 80D6 24               inc  h
1425+ 80D7
1426+ 80D7              .no_carry:
1427+ 80D7
1428+ 80D7                  ; HL = Row * 32 + Col
1429+ 80D7
1430+ 80D7 11 00 58         ld   de, $5800
1431+ 80DA 19               add  hl, de            ; HL = indirizzo attributi
1432+ 80DB
1433+ 80DB                  ; ---------------------------------------------------------------
1434+ 80DB                  ; Recupera il colore originale dallo stack.
1435+ 80DB                  ;
1436+ 80DB                  ; Layout stack:
1437+ 80DB                  ;   HL originale
1438+ 80DB                  ;   DE originale (E = colore)
1439+ 80DB                  ;   BC originale
1440+ 80DB                  ; ---------------------------------------------------------------
1441+ 80DB
1442+ 80DB C1               pop  bc                ; Recupera HL originale
1443+ 80DC D1               pop  de                ; Recupera DE originale
1444+ 80DD
1445+ 80DD                  ; ---------------------------------------------------------------
1446+ 80DD                  ; Scrive l'attributo colore
1447+ 80DD                  ; ---------------------------------------------------------------
1448+ 80DD
1449+ 80DD 7B               ld   a, e              ; A = colore
1450+ 80DE 77               ld   (hl), a           ; Scrive nella RAM attributi
1451+ 80DF
1452+ 80DF                  ; ---------------------------------------------------------------
1453+ 80DF                  ; Ripristina HL e BC originali
1454+ 80DF                  ; ---------------------------------------------------------------
1455+ 80DF
1456+ 80DF C5               push bc
1457+ 80E0 E1               pop  hl                ; HL originale
1458+ 80E1
1459+ 80E1 C1               pop  bc                ; BC originale
1460+ 80E2
1461+ 80E2 C9               ret
1462+ 80E3
1463+ 80E3              ; -------------------------------------------------------------------
1464+ 80E3              ; RestoreBackgroundCell
1465+ 80E3              ;
1466+ 80E3              ; Ripristina il contenuto originale di una cella della stanza.
1467+ 80E3              ; Viene utilizzata principalmente quando un item viene raccolto:
1468+ 80E3              ; invece di lasciare un "buco", la routine ridisegna il tile
1469+ 80E3              ; originale presente nella mappa della stanza.
1470+ 80E3              ;
1471+ 80E3              ; Input:
1472+ 80E3              ;   B = Row (3..18)
1473+ 80E3              ;   C = Col (0..31)
1474+ 80E3              ;
1475+ 80E3              ; Utilizza:
1476+ 80E3              ;   room_ptr -> struttura dati della stanza corrente
1477+ 80E3              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1478+ 80E3              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1479+ 80E3              ;
1480+ 80E3              ; Tipi di cella:
1481+ 80E3              ;   0 = Background
1482+ 80E3              ;   1 = Floor
1483+ 80E3              ;   2 = Wall
1484+ 80E3              ;   3 = Nasty
1485+ 80E3              ; -------------------------------------------------------------------
1486+ 80E3              RestoreBackgroundCell:
1487+ 80E3
1488+ 80E3                  ; Salva tutti i registri utilizzati
1489+ 80E3 FD E5            push iy
1490+ 80E5 C5               push bc
1491+ 80E6 D5               push de
1492+ 80E7 E5               push hl
1493+ 80E8 DD E5            push ix
1494+ 80EA
1495+ 80EA                  ; ---------------------------------------------------------------
1496+ 80EA                  ; Conserva Row e Col in IY.
1497+ 80EA                  ;
1498+ 80EA                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1499+ 80EA                  ; BC potrebbe essere modificato.
1500+ 80EA                  ; ---------------------------------------------------------------
1501+ 80EA C5               push bc
1502+ 80EB FD E1            pop  iy                ; IYH = Row, IYL = Col
1503+ 80ED
1504+ 80ED                  ; ---------------------------------------------------------------
1505+ 80ED                  ; Determina quale tipo di cella è presente nella posizione
1506+ 80ED                  ; specificata.
1507+ 80ED                  ;
1508+ 80ED                  ; Input:
1509+ 80ED                  ;   B = Row
1510+ 80ED                  ;   C = Col
1511+ 80ED                  ;
1512+ 80ED                  ; Output:
1513+ 80ED                  ;   A = tipo cella
1514+ 80ED                  ; ---------------------------------------------------------------
1515+ 80ED 78               ld   a, b
1516+ 80EE
1517+ 80EE CD 14 72         call GetCellFromUnpacked
1518+ 80F1
1519+ 80F1                  ; ---------------------------------------------------------------
1520+ 80F1                  ; Recupera il puntatore alla stanza corrente.
1521+ 80F1                  ;
1522+ 80F1                  ; DE = base della struttura stanza
1523+ 80F1                  ; ---------------------------------------------------------------
1524+ 80F1 ED 5B 3D EA      ld   de, (room_ptr)
1525+ 80F5
1526+ 80F5                  ; ---------------------------------------------------------------
1527+ 80F5                  ; Seleziona il tile corretto in base al tipo di cella.
1528+ 80F5                  ;
1529+ 80F5                  ; A = 0 -> Background
1530+ 80F5                  ; A = 1 -> Floor
1531+ 80F5                  ; A = 2 -> Wall
1532+ 80F5                  ; A = 3 -> Nasty
1533+ 80F5                  ; ---------------------------------------------------------------
1534+ 80F5
1535+ 80F5 B7               or   a
1536+ 80F6 20 06            jr   nz, .not_bg
1537+ 80F8
1538+ 80F8                  ; Background
1539+ 80F8 21 A0 00         ld   hl, OFFSET_BG
1540+ 80FB 19               add  hl, de
1541+ 80FC 18 16            jr   .draw_cell
1542+ 80FE
1543+ 80FE              .not_bg:
1544+ 80FE
1545+ 80FE 3D               dec  a
1546+ 80FF 20 06            jr   nz, .not_floor
1547+ 8101
1548+ 8101                  ; Floor
1549+ 8101 21 A9 00         ld   hl, OFFSET_FLOOR
1550+ 8104 19               add  hl, de
1551+ 8105 18 0D            jr   .draw_cell
1552+ 8107
1553+ 8107              .not_floor:
1554+ 8107
1555+ 8107 3D               dec  a
1556+ 8108 20 06            jr   nz, .not_wall
1557+ 810A
1558+ 810A                  ; Wall
1559+ 810A 21 B2 00         ld   hl, OFFSET_WALL
1560+ 810D 19               add  hl, de
1561+ 810E 18 04            jr   .draw_cell
1562+ 8110
1563+ 8110              .not_wall:
1564+ 8110
1565+ 8110                  ; Nasty
1566+ 8110 21 BB 00         ld   hl, OFFSET_NASTY
1567+ 8113 19               add  hl, de
1568+ 8114
1569+ 8114              .draw_cell:
1570+ 8114
1571+ 8114                  ; ---------------------------------------------------------------
1572+ 8114                  ; HL punta ora alla grafica del tile da ridisegnare.
1573+ 8114                  ;
1574+ 8114                  ; Gfx_DrawTile si aspetta:
1575+ 8114                  ;   IX = puntatore tile
1576+ 8114                  ;   B  = Row
1577+ 8114                  ;   C  = Col
1578+ 8114                  ; ---------------------------------------------------------------
1579+ 8114 E5               push hl
1580+ 8115 DD E1            pop  ix
1581+ 8117
1582+ 8117                  ; Ripristina Row e Col salvati in IY
1583+ 8117 FD E5            push iy
1584+ 8119 C1               pop  bc
1585+ 811A
1586+ 811A                  ; Disegna il tile originale
1587+ 811A CD E3 64         call Gfx_DrawTile
1588+ 811D
1589+ 811D                  ; ---------------------------------------------------------------
1590+ 811D                  ; Ripristina i registri salvati
1591+ 811D                  ; ---------------------------------------------------------------
1592+ 811D DD E1            pop  ix
1593+ 811F E1               pop  hl
1594+ 8120 D1               pop  de
1595+ 8121 C1               pop  bc
1596+ 8122 FD E1            pop  iy
1597+ 8124
1598+ 8124 C9               ret
1599+ 8125
1600+ 8125              ; -------------------------------------------------------------------
1601+ 8125              ; CheckWillyItemCollision
1602+ 8125              ;
1603+ 8125              ; Verifica se Willy collide con un item utilizzando il controllo
1604+ 8125              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1605+ 8125              ;
1606+ 8125              ; Input:
1607+ 8125              ;   A = ItemX (colonna attributi 0..31)
1608+ 8125              ;   H = ItemY (riga attributi 3..18)
1609+ 8125              ;
1610+ 8125              ; Coordinate item:
1611+ 8125              ;   Ogni item occupa una cella da 8x8 pixel.
1612+ 8125              ;
1613+ 8125              ; Coordinate Willy:
1614+ 8125              ;   Willy occupa un rettangolo di 16x16 pixel.
1615+ 8125              ;
1616+ 8125              ; Output:
1617+ 8125              ;   Carry Set   = collisione rilevata
1618+ 8125              ;   Carry Clear = nessuna collisione
1619+ 8125              ;
1620+ 8125              ; Registri preservati:
1621+ 8125              ;   BC, DE, HL
1622+ 8125              ; -------------------------------------------------------------------
1623+ 8125              CheckWillyItemCollision:
1624+ 8125
1625+ 8125                  ; Salva i registri utilizzati
1626+ 8125 C5               push bc
1627+ 8126 D5               push de
1628+ 8127 E5               push hl
1629+ 8128
1630+ 8128                  ; ---------------------------------------------------------------
1631+ 8128                  ; Calcola il bounding box orizzontale dell'item
1632+ 8128                  ;
1633+ 8128                  ; ItemLeft  = ItemX * 8
1634+ 8128                  ; ItemRight = ItemLeft + 7
1635+ 8128                  ;
1636+ 8128                  ; E = ItemLeft
1637+ 8128                  ; D = ItemRight
1638+ 8128                  ; ---------------------------------------------------------------
1639+ 8128 6F               ld   l, a              ; L = ItemX
1640+ 8129
1641+ 8129 7D               ld   a, l
1642+ 812A 87               add  a, a              ; *2
1643+ 812B 87               add  a, a              ; *4
1644+ 812C 87               add  a, a              ; *8
1645+ 812D
1646+ 812D 5F               ld   e, a              ; E = ItemLeft
1647+ 812E
1648+ 812E C6 07            add  a, 7
1649+ 8130 57               ld   d, a              ; D = ItemRight
1650+ 8131
1651+ 8131                  ; ---------------------------------------------------------------
1652+ 8131                  ; Recupera la posizione corrente di Willy
1653+ 8131                  ;
1654+ 8131                  ; B = WillyY
1655+ 8131                  ; C = WillyX
1656+ 8131                  ; ---------------------------------------------------------------
1657+ 8131 ED 4B BD E6      ld   bc, (PlayerPos)
1658+ 8135
1659+ 8135                  ; ---------------------------------------------------------------
1660+ 8135                  ; Primo test:
1661+ 8135                  ;
1662+ 8135                  ; WillyLeft <= ItemRight
1663+ 8135                  ;
1664+ 8135                  ; Se Willy è completamente a destra dell'item
1665+ 8135                  ; non può esserci collisione.
1666+ 8135                  ; ---------------------------------------------------------------
1667+ 8135 79               ld   a, c              ; A = WillyLeft
1668+ 8136
1669+ 8136 BA               cp   d                 ; WillyLeft vs ItemRight
1670+ 8137
1671+ 8137 28 04            jr   z, .x_ok
1672+ 8139 38 02            jr   c, .x_ok
1673+ 813B
1674+ 813B 18 29            jr   .no_collision
1675+ 813D
1676+ 813D              .x_ok:
1677+ 813D
1678+ 813D                  ; ---------------------------------------------------------------
1679+ 813D                  ; Secondo test:
1680+ 813D                  ;
1681+ 813D                  ; WillyRight >= ItemLeft
1682+ 813D                  ;
1683+ 813D                  ; WillyRight = WillyX + 7
1684+ 813D                  ; ---------------------------------------------------------------
1685+ 813D C6 07            add  a, 7
1686+ 813F
1687+ 813F BB               cp   e                 ; WillyRight vs ItemLeft
1688+ 8140
1689+ 8140 28 04            jr   z, .y_check
1690+ 8142 30 02            jr   nc, .y_check
1691+ 8144
1692+ 8144 18 20            jr   .no_collision
1693+ 8146
1694+ 8146              .y_check:
1695+ 8146
1696+ 8146                  ; ---------------------------------------------------------------
1697+ 8146                  ; Recupera ItemY dal valore originale di HL
1698+ 8146                  ;
1699+ 8146                  ; H contiene la riga dell'item.
1700+ 8146                  ; ---------------------------------------------------------------
1701+ 8146 E1               pop  hl
1702+ 8147 E5               push hl
1703+ 8148
1704+ 8148                  ; ---------------------------------------------------------------
1705+ 8148                  ; Calcola il bounding box verticale dell'item
1706+ 8148                  ;
1707+ 8148                  ; ItemTop    = ItemY * 8
1708+ 8148                  ; ItemBottom = ItemTop + 7
1709+ 8148                  ;
1710+ 8148                  ; E = ItemTop
1711+ 8148                  ; D = ItemBottom
1712+ 8148                  ; ---------------------------------------------------------------
1713+ 8148 7C               ld   a, h
1714+ 8149
1715+ 8149 87               add  a, a              ; *2
1716+ 814A 87               add  a, a              ; *4
1717+ 814B 87               add  a, a              ; *8
1718+ 814C
1719+ 814C 5F               ld   e, a              ; ItemTop
1720+ 814D
1721+ 814D C6 07            add  a, 7
1722+ 814F 57               ld   d, a              ; ItemBottom
1723+ 8150
1724+ 8150                  ; ---------------------------------------------------------------
1725+ 8150                  ; Primo test verticale:
1726+ 8150                  ;
1727+ 8150                  ; WillyTop <= ItemBottom
1728+ 8150                  ; ---------------------------------------------------------------
1729+ 8150 78               ld   a, b              ; WillyTop
1730+ 8151
1731+ 8151 BA               cp   d
1732+ 8152
1733+ 8152 28 04            jr   z, .y_ok
1734+ 8154 38 02            jr   c, .y_ok
1735+ 8156
1736+ 8156 18 0E            jr   .no_collision
1737+ 8158
1738+ 8158              .y_ok:
1739+ 8158
1740+ 8158                  ; ---------------------------------------------------------------
1741+ 8158                  ; Secondo test verticale:
1742+ 8158                  ;
1743+ 8158                  ; WillyBottom >= ItemTop
1744+ 8158                  ;
1745+ 8158                  ; WillyBottom = WillyY + 15
1746+ 8158                  ; ---------------------------------------------------------------
1747+ 8158 C6 0F            add  a, 15
1748+ 815A
1749+ 815A BB               cp   e
1750+ 815B
1751+ 815B 28 04            jr   z, .collision
1752+ 815D 30 02            jr   nc, .collision
1753+ 815F
1754+ 815F 18 05            jr   .no_collision
1755+ 8161
1756+ 8161              .collision:
1757+ 8161
1758+ 8161                  ; ---------------------------------------------------------------
1759+ 8161                  ; Collisione rilevata
1760+ 8161                  ; ---------------------------------------------------------------
1761+ 8161 E1               pop  hl
1762+ 8162 D1               pop  de
1763+ 8163 C1               pop  bc
1764+ 8164
1765+ 8164 37               scf                    ; Carry = 1
1766+ 8165
1767+ 8165 C9               ret
1768+ 8166
1769+ 8166              .no_collision:
1770+ 8166
1771+ 8166                  ; ---------------------------------------------------------------
1772+ 8166                  ; Nessuna collisione
1773+ 8166                  ; ---------------------------------------------------------------
1774+ 8166 E1               pop  hl
1775+ 8167 D1               pop  de
1776+ 8168 C1               pop  bc
1777+ 8169
1778+ 8169 B7               or   a                 ; Carry = 0
1779+ 816A
1780+ 816A C9               ret
1781+ 816B
1782+ 816B              ; -------------------------------------------------------------------
1783+ 816B              ; Items_CheckCollision
1784+ 816B              ;
1785+ 816B              ; Controlla se Willy entra in collisione con uno degli item
1786+ 816B              ; attivi presenti nella stanza corrente.
1787+ 816B              ;
1788+ 816B              ; Per ogni item:
1789+ 816B              ;   - verifica che appartenga alla stanza corrente
1790+ 816B              ;   - verifica che non sia già stato raccolto
1791+ 816B              ;   - esegue il test di collisione con Willy
1792+ 816B              ;
1793+ 816B              ; Se l'item viene raccolto:
1794+ 816B              ;   - imposta il flag "collected"
1795+ 816B              ;   - rimuove l'item dalla cache items_grid
1796+ 816B              ;   - incrementa il contatore degli oggetti raccolti
1797+ 816B              ;   - aggiorna l'HUD
1798+ 816B              ;   - ripristina il tile di sfondo
1799+ 816B              ;   - riproduce il suono di raccolta
1800+ 816B              ;
1801+ 816B              ; Formato record ItemsTable:
1802+ 816B              ;   +0 RoomID
1803+ 816B              ;   +1 X
1804+ 816B              ;   +2 Y
1805+ 816B              ;   +3 Color
1806+ 816B              ;   +4 Collected
1807+ 816B              ;
1808+ 816B              ; Fine tabella:
1809+ 816B              ;   RoomID = $FF
1810+ 816B              ; -------------------------------------------------------------------
1811+ 816B              Items_CheckCollision:
1812+ 816B
1813+ 816B                  ; Salva i registri utilizzati
1814+ 816B E5               push hl
1815+ 816C D5               push de
1816+ 816D C5               push bc
1817+ 816E
1818+ 816E                  ; Inizio scansione della tabella degli item
1819+ 816E 21 BB 7A         ld   hl, ItemsTable
1820+ 8171
1821+ 8171              .loop:
1822+ 8171
1823+ 8171                  ; ---------------------------------------------------------------
1824+ 8171                  ; Legge il Room ID dell'item corrente
1825+ 8171                  ; ---------------------------------------------------------------
1826+ 8171 7E               ld   a, (hl)
1827+ 8172
1828+ 8172                  ; $FF indica fine tabella
1829+ 8172 FE FF            cp   $FF
1830+ 8174 28 4D            jr   z, .done
1831+ 8176
1832+ 8176                  ; ---------------------------------------------------------------
1833+ 8176                  ; Verifica se l'item appartiene alla stanza corrente
1834+ 8176                  ; ---------------------------------------------------------------
1835+ 8176 57               ld   d, a              ; D = RoomID item
1836+ 8177
1837+ 8177 3A E3 E9         ld   a, (current_room)
1838+ 817A BA               cp   d
1839+ 817B
1840+ 817B                  ; Se appartiene a un'altra stanza salta il record
1841+ 817B 20 3F            jr   nz, .next_item
1842+ 817D
1843+ 817D                  ; ---------------------------------------------------------------
1844+ 817D                  ; Legge coordinate e stato dell'item
1845+ 817D                  ; ---------------------------------------------------------------
1846+ 817D
1847+ 817D 23               inc  hl
1848+ 817E 4E               ld   c, (hl)           ; C = X
1849+ 817F
1850+ 817F 23               inc  hl
1851+ 8180 46               ld   b, (hl)           ; B = Y
1852+ 8181
1853+ 8181 23               inc  hl                ; salta Color
1854+ 8182
1855+ 8182 23               inc  hl                ; punta a Collected
1856+ 8183
1857+ 8183 7E               ld   a, (hl)
1858+ 8184
1859+ 8184                  ; ---------------------------------------------------------------
1860+ 8184                  ; Item già raccolto?
1861+ 8184                  ; ---------------------------------------------------------------
1862+ 8184 B7               or   a
1863+ 8185 20 39            jr   nz, .next_no_inc
1864+ 8187
1865+ 8187                  ; ---------------------------------------------------------------
1866+ 8187                  ; Test collisione Willy ↔ Item
1867+ 8187                  ;
1868+ 8187                  ; Input richiesto:
1869+ 8187                  ;   A = ItemX
1870+ 8187                  ;   H = ItemY
1871+ 8187                  ; ---------------------------------------------------------------
1872+ 8187 79               ld   a, c
1873+ 8188
1874+ 8188 E5               push hl                ; salva puntatore al flag Collected
1875+ 8189
1876+ 8189 60               ld   h, b
1877+ 818A
1878+ 818A CD 25 81         call CheckWillyItemCollision
1879+ 818D
1880+ 818D E1               pop  hl
1881+ 818E
1882+ 818E                  ; Nessuna collisione
1883+ 818E 30 30            jr   nc, .next_no_inc
1884+ 8190
1885+ 8190                  ; ===============================================================
1886+ 8190                  ; ITEM RACCOLTO
1887+ 8190                  ; ===============================================================
1888+ 8190
1889+ 8190                  ; ---------------------------------------------------------------
1890+ 8190                  ; Marca l'item come raccolto
1891+ 8190                  ; ---------------------------------------------------------------
1892+ 8190 36 01            ld   (hl), 1
1893+ 8192
1894+ 8192                  ; ---------------------------------------------------------------
1895+ 8192                  ; Rimuove l'item dalla cache items_grid
1896+ 8192                  ;
1897+ 8192                  ; Calcolo:
1898+ 8192                  ;   offset = Row * 32 + Col
1899+ 8192                  ; ---------------------------------------------------------------
1900+ 8192 E5               push hl
1901+ 8193 D5               push de
1902+ 8194
1903+ 8194 26 00            ld   h, 0
1904+ 8196 68               ld   l, b              ; HL = Row
1905+ 8197
1906+ 8197 29               add  hl, hl            ; *2
1907+ 8198 29               add  hl, hl            ; *4
1908+ 8199 29               add  hl, hl            ; *8
1909+ 819A 29               add  hl, hl            ; *16
1910+ 819B 29               add  hl, hl            ; *32
1911+ 819C
1912+ 819C 59               ld   e, c
1913+ 819D 16 00            ld   d, 0
1914+ 819F
1915+ 819F 19               add  hl, de            ; Row*32 + Col
1916+ 81A0
1917+ 81A0 11 BD E4         ld   de, items_grid
1918+ 81A3 19               add  hl, de
1919+ 81A4
1920+ 81A4                  ; La cella non contiene più un item
1921+ 81A4 36 00            ld   (hl), 0
1922+ 81A6
1923+ 81A6 D1               pop  de
1924+ 81A7 E1               pop  hl
1925+ 81A8
1926+ 81A8                  ; ---------------------------------------------------------------
1927+ 81A8                  ; Conserva il puntatore all'entry corrente
1928+ 81A8                  ; poiché le routine successive possono alterare HL.
1929+ 81A8                  ; ---------------------------------------------------------------
1930+ 81A8 E5               push hl
1931+ 81A9
1932+ 81A9                  ; ---------------------------------------------------------------
1933+ 81A9                  ; Aggiorna il numero di oggetti raccolti
1934+ 81A9                  ; ---------------------------------------------------------------
1935+ 81A9 3A C7 E6         ld   a, (items_collected)
1936+ 81AC
1937+ 81AC 3C               inc  a
1938+ 81AD
1939+ 81AD 32 C7 E6         ld   (items_collected), a
1940+ 81B0
1941+ 81B0                  ; ---------------------------------------------------------------
1942+ 81B0                  ; Aggiorna il contatore visualizzato a schermo
1943+ 81B0                  ; ---------------------------------------------------------------
1944+ 81B0 CD 08 63         call Gfx_UpdateItemsCollectedDisplay
1945+ 81B3
1946+ 81B3                  ; ---------------------------------------------------------------
1947+ 81B3                  ; Ripristina il tile originale della stanza
1948+ 81B3                  ; eliminando la grafica dell'item.
1949+ 81B3                  ;
1950+ 81B3                  ; Input:
1951+ 81B3                  ;   B = Row
1952+ 81B3                  ;   C = Col
1953+ 81B3                  ; ---------------------------------------------------------------
1954+ 81B3 CD E3 80         call RestoreBackgroundCell
1955+ 81B6
1956+ 81B6                  ; ---------------------------------------------------------------
1957+ 81B6                  ; Riproduce il suono di raccolta
1958+ 81B6                  ; ---------------------------------------------------------------
1959+ 81B6 CD 32 82         call Audio_PlayCollectSound
1960+ 81B9
1961+ 81B9                  ; Ripristina il puntatore alla tabella
1962+ 81B9 E1               pop  hl
1963+ 81BA
1964+ 81BA                  ; Continua con il record successivo
1965+ 81BA 18 04            jr   .next_no_inc
1966+ 81BC
1967+ 81BC              .next_item:
1968+ 81BC
1969+ 81BC                  ; ---------------------------------------------------------------
1970+ 81BC                  ; Salta i campi del record:
1971+ 81BC                  ;   X
1972+ 81BC                  ;   Y
1973+ 81BC                  ;   Color
1974+ 81BC                  ;   Collected
1975+ 81BC                  ; ---------------------------------------------------------------
1976+ 81BC 23               inc  hl
1977+ 81BD 23               inc  hl
1978+ 81BE 23               inc  hl
1979+ 81BF 23               inc  hl
1980+ 81C0
1981+ 81C0              .next_no_inc:
1982+ 81C0
1983+ 81C0                  ; ---------------------------------------------------------------
1984+ 81C0                  ; Avanza al record successivo.
1985+ 81C0                  ;
1986+ 81C0                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1987+ 81C0                  ; ---------------------------------------------------------------
1988+ 81C0 23               inc  hl
1989+ 81C1
1990+ 81C1 18 AE            jr   .loop
1991+ 81C3
1992+ 81C3              .done:
1993+ 81C3
1994+ 81C3                  ; Ripristina i registri
1995+ 81C3 C1               pop  bc
1996+ 81C4 D1               pop  de
1997+ 81C5 E1               pop  hl
1998+ 81C6
1999+ 81C6 C9               ret
2000+ 81C7
2001+ 81C7
2002+ 81C7
2003+ 81C7              ; -------------------------------------------------------------------
2004+ 81C7              ; CheckActiveItemAtCell
2005+ 81C7              ;
2006+ 81C7              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2007+ 81C7              ; nella cella specificata della griglia items_grid.
2008+ 81C7              ;
2009+ 81C7              ; Questa routine usa una lookup diretta su una mappa 32x16,
2010+ 81C7              ; evitando la scansione della ItemsTable.
2011+ 81C7              ;
2012+ 81C7              ; Input:
2013+ 81C7              ;   B = Colonna (0..31)
2014+ 81C7              ;   C = Riga (0..15)
2015+ 81C7              ;
2016+ 81C7              ; Output:
2017+ 81C7              ;   Carry Set   = item presente nella cella
2018+ 81C7              ;   Carry Clear = nessun item
2019+ 81C7              ;
2020+ 81C7              ; Nota:
2021+ 81C7              ;   HL NON è restituito valido (commento originale non corretto:
2022+ 81C7              ;   la routine non punta a ItemsTable).
2023+ 81C7              ; -------------------------------------------------------------------
2024+ 81C7              CheckActiveItemAtCell:
2025+ 81C7
2026+ 81C7                  ; Salva registri usati
2027+ 81C7 D5               push de
2028+ 81C8 E5               push hl
2029+ 81C9
2030+ 81C9                  ; ---------------------------------------------------------------
2031+ 81C9                  ; Calcolo indice lineare nella griglia 32x16:
2032+ 81C9                  ;
2033+ 81C9                  ; offset = Row * 32 + Col
2034+ 81C9                  ; ---------------------------------------------------------------
2035+ 81C9 26 00            ld   h, 0
2036+ 81CB 69               ld   l, c              ; HL = Row
2037+ 81CC
