 126+ 7611              ; DetermineCurrentRoomID
 127+ 7611              ;
 128+ 7611              ; Determina l'ID numerico della stanza corrente confrontando
 129+ 7611              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 130+ 7611              ;
 131+ 7611              ; Se viene trovata una corrispondenza:
 132+ 7611              ;   A = ID della stanza
 133+ 7611              ;   current_room = A
 134+ 7611              ;
 135+ 7611              ; Mappatura:
 136+ 7611              ;    0 = The Off Licence
 137+ 7611              ;    1 = The Bridge
 138+ 7611              ;    2 = Under The Mega Tree
 139+ 7611              ;    3 = Gfx_At The Foot Of The Mega Tree
 140+ 7611              ;    4 = The Drive
 141+ 7611              ;    5 = The Security Guard
 142+ 7611              ;    6 = Entrance To Hades
 143+ 7611              ;    7 = Cuckoo's Nest
 144+ 7611              ;    8 = Inside The Mega Trunk
 145+ 7611              ;    9 = On A Branch Over The Drive
 146+ 7611              ;   10 = The Front Door
 147+ 7611              ;   11 = The Hall
 148+ 7611              ;   12 = Tree Top
 149+ 7611              ;   27 = The Chapel
 150+ 7611              ;   28 = First Landing
 151+ 7611              ;   29 = The Nightmare Room
 152+ 7611              ;   33 = The Bathroom
 153+ 7611              ;   35 = Master Bedroom
 154+ 7611              ;
 155+ 7611              ; Se nessuna stanza corrisponde viene impostato:
 156+ 7611              ;   current_room = 0
 157+ 7611              ; -------------------------------------------------------------------
 158+ 7611              DetermineCurrentRoomID:
