 447+ 5FAC 77               ld   (hl), a
 448+ 5FAD 23               inc  hl
 449+ 5FAE 7B               ld   a, e
 450+ 5FAF B6               or   (hl)
 451+ 5FB0 77               ld   (hl), a
 452+ 5FB1 2B               dec  hl            ; Ripristina HL alla colonna iniziale
