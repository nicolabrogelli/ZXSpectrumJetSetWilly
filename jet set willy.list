 271  83B3              ; -------------------------------------------------------------------
 272  83B3              ; TriggerGameOver
 273  83B3              ; Scatena la schermata di Game Over per la stanza corrente.
 274  83B3              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 275  83B3              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 276  83B3              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 277  83B3              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 278  83B3              ; - Premendo ENTER, ripristina integralmente la partita ed avvia la nuova
 279  83B3              ;   sessione dal primo livello (Stanza 0: The Off Licence) alle 07:00 AM.
 280  83B3              ; -------------------------------------------------------------------
 281  83B3              TriggerGameOver:
 282  83B3                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede e della scritta GAME OVER
 283  83B3 CD 67 61         call Gfx_DrawGameOverScreen
 284  83B6
 285  83B6                  ; 2. Attende il rilascio del tasto ENTER se era già premuto
 286  83B6              .wait_enter_release:
 287  83B6 76               halt
 288  83B7 3E BF            ld   a, $bf
 289  83B9 DB FE            in   a, ($fe)
 290  83BB 1F               rra
 291  83BC 30 F8            jr   nc, .wait_enter_release
 292  83BE
 293  83BE                  ; 3. Attesa della pressione del tasto ENTER con animazione ciclo colore su GAME OVER (Riga 5, Col 11)
 294  83BE 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 295  83C0              .wait_enter_press:
 296  83C0 76               halt
 297  83C1
 298  83C1                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 299  83C1 0C               inc  c
 300  83C2 79               ld   a, c
 301  83C3 CB 3F            srl  a
 302  83C5 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 303  83C7 E6 07            and  7
 304  83C9 5F               ld   e, a
 305  83CA 16 00            ld   d, 0
 306  83CC 21 5F 61         ld   hl, game_over_color_table
 307  83CF 19               add  hl, de
 308  83D0 7E               ld   a, (hl)               ; A = nuovo colore attributo
 309  83D1 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 310  83D4 06 09            ld   b, 9
 311  83D6              .color_cycle_loop:
 312  83D6 77               ld   (hl), a
 313  83D7 23               inc  hl
 314  83D8 10 FC            djnz .color_cycle_loop
 315  83DA
 316  83DA                  ; Controlla se il tasto ENTER è premuto
 317  83DA 3E BF            ld   a, $bf
 318  83DC DB FE            in   a, ($fe)
 319  83DE 1F               rra
 320  83DF 38 DF            jr   c, .wait_enter_press
 321  83E1
 322  83E1                  ; 4. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 323  83E1 CD E7 83         call ResetFullGameState
 324  83E4
 325  83E4                  ; 5. Avvia la nuova partita dal primo livello (Stanza 0: The Off Licence)
 326  83E4 C3 9B 82         jp   LoadRoomAndRestart
 327  83E7
 328  83E7              ; -------------------------------------------------------------------
 329  83E7              ; ResetFullGameState
 330  83E7              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 331  83E7              ; per l'avvio di una nuova partita dopo il Game Over.
 332  83E7              ; -------------------------------------------------------------------
 333  83E7              ResetFullGameState:
 334  83E7                  ; Ripristina gli attributi schermo di default (Inchiostro Bianco, Sfondo Nero)
 335  83E7 21 8D 5C         ld   hl, ATTR_P
 336  83EA 36 07            ld   (hl), $07
 337  83EC 3E 07            ld   a, $07
 338  83EE 32 8F 5C         ld   (ATTR_T), a
 339  83F1
 340  83F1                  ; Ripristina il numero di vite iniziali
 341  83F1 3E 07            ld   a, INITIAL_LIVES
 342  83F3 32 ED E6         ld   (willy_lives), a
 343  83F6
 344  83F6                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 345  83F6 AF               xor  a
 346  83F7 32 EA E6         ld   (items_collected), a
 347  83FA 32 E6 E6         ld   (body_state), a
 348  83FD 32 F9 E6         ld   (w_warp_state), a
 349  8400 32 FC E6         ld   (w_key_prev), a
 350  8403 32 FD E6         ld   (enter_key_prev), a
 351  8406 32 EE E6         ld   (velocity_y), a
 352  8409 32 F0 E6         ld   (jump_pressed), a
 353  840C 32 F2 E6         ld   (coyote_timer), a
 354  840F 32 F5 E6         ld   (jump_frame), a
 355  8412 32 F4 E6         ld   (jump_dir), a
 356  8415 32 66 EA         ld   (transition_active), a
 357  8418 32 EA EA         ld   (willy_safety_timer), a
 358  841B 3E FF            ld   a, $ff
 359  841D 32 FE E6         ld   (digit_key_prev), a
 360  8420 3E 01            ld   a, 1
 361  8422 32 F7 E6         ld   (q_prev), a
 362  8425 32 F8 E6         ld   (a_prev), a
 363  8428 32 EF E6         ld   (on_ground), a
 364  842B
 365  842B                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 366  842B 3E 30            ld   a, '0'
 367  842D 32 0C 64         ld   (status_line + 16), a
 368  8430 32 0D 64         ld   (status_line + 17), a
 369  8433 32 0E 64         ld   (status_line + 18), a
 370  8436
 371  8436                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 372  8436 CD 35 80         call ResetItemsTable
 373  8439
 374  8439                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 375  8439 CD CA 68         call InitRoomEntryPositions
 376  843C
 377  843C                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 378  843C 3E 07            ld   a, 7
 379  843E 32 ED EA         ld   (time_hours), a
 380  8441 AF               xor  a
 381  8442 32 EE EA         ld   (time_minutes), a
 382  8445 32 EF EA         ld   (time_period), a       ; 0 = AM
 383  8448 32 F2 EA         ld   (game_objective_completed), a
 384  844B 2A 01 E7         ld   hl, (counter)
 385  844E 22 F0 EA         ld   (time_last_counter), hl
 386  8451 CD 7E 63         call Gfx_UpdateTimeDisplay
 387  8454
 388  8454                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 389  8454 21 BA 84         ld   hl, TheOffLicenceLayout
 390  8457 22 60 EA         ld   (room_ptr), hl
 391  845A
 392  845A C9               ret
 393  845B
 394  845B              ; -------------------------------------------------------------------
 395  845B              ; Time_UpdateClock
 396  845B              ; Gestisce lo scorrimento del tempo durante il gioco.
 397  845B              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 398  845B              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 399  845B              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 400  845B              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 401  845B              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 402  845B              ; sia completato, scatena immediatamente il Game Over.
 403  845B              ; -------------------------------------------------------------------
 404  845B              Time_UpdateClock:
 405  845B                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 406  845B 2A 01 E7         ld   hl, (counter)
 407  845E ED 5B F0 EA      ld   de, (time_last_counter)
 408  8462 B7               or   a
 409  8463 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 410  8465
 411  8465                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 412  8465 11 32 00         ld   de, CLOCK_TICKS_PER_MINUTE
 413  8468 B7               or   a
 414  8469 ED 52            sbc  hl, de
 415  846B D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 416  846C
 417  846C                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 418  846C 2A F0 EA         ld   hl, (time_last_counter)
 419  846F 11 32 00         ld   de, CLOCK_TICKS_PER_MINUTE
 420  8472 19               add  hl, de
 421  8473 22 F0 EA         ld   (time_last_counter), hl
 422  8476
 423  8476                  ; Incrementa di 1 minuto il tempo di gioco
 424  8476 3A EE EA         ld   a, (time_minutes)
 425  8479 3C               inc  a
 426  847A FE 3C            cp   60
 427  847C 38 21            jr   c, .minutes_ok
 428  847E
 429  847E                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 430  847E AF               xor  a
 431  847F 32 EE EA         ld   (time_minutes), a
 432  8482 3A ED EA         ld   a, (time_hours)
 433  8485 3C               inc  a
 434  8486 FE 0C            cp   12
 435  8488 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 436  848A FE 0D            cp   13
 437  848C 38 0E            jr   c, .hours_ok
 438  848E 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 439  8490 18 0A            jr   .hours_ok
 440  8492
 441  8492              .toggle_period:
 442  8492 F5               push af                     ; Salva A (valore 12)
 443  8493 3A EF EA         ld   a, (time_period)
 444  8496 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 445  8498 32 EF EA         ld   (time_period), a
 446  849B F1               pop  af                     ; Ripristina A = 12
 447  849C
 448  849C              .hours_ok:
 449  849C 32 ED EA         ld   (time_hours), a
 450  849F
 451  849F              .minutes_ok:
 452  849F 32 EE EA         ld   (time_minutes), a
 453  84A2
 454  84A2                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 455  84A2 CD 7E 63         call Gfx_UpdateTimeDisplay
 456  84A5
 457  84A5                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 458  84A5 3A F2 EA         ld   a, (game_objective_completed)
 459  84A8 B7               or   a
 460  84A9 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 461  84AA
 462  84AA                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 463  84AA 3A EF EA         ld   a, (time_period)
 464  84AD B7               or   a
 465  84AE C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 466  84AF
 467  84AF 3A ED EA         ld   a, (time_hours)
 468  84B2 FE 0C            cp   12
 469  84B4 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
 470  84B6 C9               ret
 471  84B7
 472  84B7              .time_limit_reached:
 473  84B7                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
 474  84B7                  ; Scatena immediatamente il Game Over temporale!
 475  84B7 C3 B3 83         jp   TriggerGameOver
