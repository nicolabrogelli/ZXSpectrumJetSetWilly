 510+ 7611
 511+ 7611              ; -------------------------------------------------------------------
 512+ 7611              ; Items_DrawRoom
 513+ 7611              ;
 514+ 7611              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 515+ 7611              ;
 516+ 7611              ; Operazioni eseguite:
 517+ 7611              ;   1. Azzera la griglia items_grid.
 518+ 7611              ;   2. Svuota la cache degli oggetti attivi.
 519+ 7611              ;   3. Scansiona ItemsTable.
 520+ 7611              ;   4. Per ogni item della stanza corrente:
 521+ 7611              ;        - verifica se è già stato raccolto
 522+ 7611              ;        - disegna la grafica
 523+ 7611              ;        - aggiorna items_grid
 524+ 7611              ;        - memorizza l'item nella cache current_room_items
 525+ 7611              ;   5. Aggiorna num_room_items.
 526+ 7611              ;
 527+ 7611              ; Record ItemsTable:
 528+ 7611              ;   +0  Room ID
 529+ 7611              ;   +1  X (colonna)
 530+ 7611              ;   +2  Y (riga)
 531+ 7611              ;   +3  Colore
 532+ 7611              ;   +4  Collected flag
 533+ 7611              ;
 534+ 7611              ; Cache current_room_items:
 535+ 7611              ;   +0  Colonna
 536+ 7611              ;   +1  Riga
 537+ 7611              ;   +2  Colore
 538+ 7611              ;   +3  Collected flag ptr (Low)
 539+ 7611              ;   +4  Collected flag ptr (High)
 540+ 7611              ;
 541+ 7611              ; Ogni record cache occupa 5 byte.
 542+ 7611              ; -------------------------------------------------------------------
 543+ 7611              Items_DrawRoom:
 544+ 7611
 545+ 7611                  ; Salva tutti i registri utilizzati
 546+ 7611 E5               push hl
 547+ 7612 D5               push de
 548+ 7613 C5               push bc
 549+ 7614 DD E5            push ix
 550+ 7616 FD E5            push iy
 551+ 7618
 552+ 7618                  ; ---------------------------------------------------------------
 553+ 7618                  ; Azzera items_grid (32 x 16 = 512 byte)
 554+ 7618                  ; ---------------------------------------------------------------
 555+ 7618 21 00 B0         ld   hl, items_grid
 556+ 761B 11 01 B0         ld   de, items_grid + 1
 557+ 761E 36 00            ld   (hl), 0
 558+ 7620 01 FF 01         ld   bc, 511
 559+ 7623 ED B0            ldir
 560+ 7625
 561+ 7625                  ; ---------------------------------------------------------------
 562+ 7625                  ; Nessun item attivo nella stanza
 563+ 7625                  ; ---------------------------------------------------------------
 564+ 7625 AF               xor  a
 565+ 7626 32 63 7C         ld   (num_room_items), a
 566+ 7629
 567+ 7629                  ; IY punta alla cache degli item attivi
 568+ 7629 FD 21 13 7C      ld   iy, current_room_items
 569+ 762D
 570+ 762D                  ; ---------------------------------------------------------------
 571+ 762D                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 572+ 762D                  ; alla stanza corrente.
 573+ 762D                  ;
 574+ 762D                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 575+ 762D                  ; ---------------------------------------------------------------
 576+ 762D 2A 64 7C         ld   hl, (room_ptr)
 577+ 7630 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 578+ 7633 19               add  hl, de
 579+ 7634
 580+ 7634 E5               push hl
 581+ 7635 DD E1            pop  ix                ; IX = bitmap item
 582+ 7637
 583+ 7637                  ; ---------------------------------------------------------------
 584+ 7637                  ; Inizio scansione della tabella degli item
 585+ 7637                  ; ---------------------------------------------------------------
 586+ 7637 21 B7 73         ld   hl, ItemsTable
 587+ 763A
 588+ 763A              .loop:
 589+ 763A
 590+ 763A                  ; ---------------------------------------------------------------
 591+ 763A                  ; Legge il Room ID del record corrente
 592+ 763A                  ; ---------------------------------------------------------------
 593+ 763A 7E               ld   a, (hl)
 594+ 763B
 595+ 763B                  ; $FF indica fine tabella
 596+ 763B FE FF            cp   $FF
 597+ 763D 28 53            jr   z, .done
 598+ 763F
 599+ 763F                  ; ---------------------------------------------------------------
 600+ 763F                  ; Verifica se l'item appartiene alla stanza corrente
 601+ 763F                  ; ---------------------------------------------------------------
 602+ 763F 57               ld   d, a
 603+ 7640
 604+ 7640 3A 0A 7C         ld   a, (current_room)
 605+ 7643 BA               cp   d
 606+ 7644 20 45            jr   nz, .next_item
 607+ 7646
 608+ 7646                  ; ---------------------------------------------------------------
 609+ 7646                  ; Legge i dati dell'item
 610+ 7646                  ; ---------------------------------------------------------------
 611+ 7646
 612+ 7646 23               inc  hl
 613+ 7647 4E               ld   c, (hl)           ; X (colonna)
 614+ 7648
 615+ 7648 23               inc  hl
 616+ 7649 46               ld   b, (hl)           ; Y (riga)
 617+ 764A
 618+ 764A 23               inc  hl
 619+ 764B 5E               ld   e, (hl)           ; Colore
 620+ 764C
 621+ 764C 23               inc  hl
 622+ 764D 7E               ld   a, (hl)           ; Collected flag
 623+ 764E
 624+ 764E                  ; Se diverso da zero l'item è già stato raccolto
 625+ 764E B7               or   a
 626+ 764F 20 3E            jr   nz, .next_no_inc
 627+ 7651
 628+ 7651                  ; ---------------------------------------------------------------
 629+ 7651                  ; Disegna l'item sullo schermo
 630+ 7651                  ;
 631+ 7651                  ; B = Row
 632+ 7651                  ; C = Column
 633+ 7651                  ; HL = bitmap pointer
 634+ 7651                  ; E = Color
 635+ 7651                  ; ---------------------------------------------------------------
 636+ 7651 E5               push hl
 637+ 7652
 638+ 7652 DD E5            push ix
 639+ 7654 E1               pop  hl
 640+ 7655
 641+ 7655 CD 9A 76         call DrawItemGraphic
 642+ 7658
 643+ 7658 E1               pop  hl                ; ritorna al flag collected
 644+ 7659
 645+ 7659                  ; ---------------------------------------------------------------
 646+ 7659                  ; Aggiorna items_grid
 647+ 7659                  ;
 648+ 7659                  ; Calcolo:
 649+ 7659                  ;   offset = Row * 32 + Col
 650+ 7659                  ; ---------------------------------------------------------------
 651+ 7659 E5               push hl
 652+ 765A D5               push de
 653+ 765B
 654+ 765B 26 00            ld   h, 0
 655+ 765D 68               ld   l, b              ; HL = Row
 656+ 765E
 657+ 765E 29               add  hl, hl            ; *2
 658+ 765F 29               add  hl, hl            ; *4
 659+ 7660 29               add  hl, hl            ; *8
 660+ 7661 29               add  hl, hl            ; *16
 661+ 7662 29               add  hl, hl            ; *32
 662+ 7663
 663+ 7663 16 00            ld   d, 0
 664+ 7665 59               ld   e, c              ; DE = Col
 665+ 7666
 666+ 7666 19               add  hl, de            ; Row*32 + Col
 667+ 7667
 668+ 7667 11 00 B0         ld   de, items_grid
 669+ 766A 19               add  hl, de            ; puntatore nella griglia
 670+ 766B
 671+ 766B D1               pop  de                ; ripristina colore
 672+ 766C
 673+ 766C 73               ld   (hl), e           ; salva colore cella
 674+ 766D
 675+ 766D E1               pop  hl
 676+ 766E
 677+ 766E                  ; ---------------------------------------------------------------
 678+ 766E                  ; Salva l'item nella cache della stanza
 679+ 766E                  ;
 680+ 766E                  ; Questo evita di dover scansionare tutta ItemsTable
 681+ 766E                  ; durante il controllo delle collisioni.
 682+ 766E                  ; ---------------------------------------------------------------
 683+ 766E
 684+ 766E FD 71 00         ld   (iy+0), c         ; Colonna
 685+ 7671 FD 70 01         ld   (iy+1), b         ; Riga
 686+ 7674 FD 73 02         ld   (iy+2), e         ; Colore
 687+ 7677
 688+ 7677                  ; Salva il puntatore al flag "collected"
 689+ 7677 FD 75 03         ld   (iy+3), l         ; Low byte
 690+ 767A FD 74 04         ld   (iy+4), h         ; High byte
 691+ 767D
 692+ 767D                  ; Passa al record successivo della cache
 693+ 767D 01 05 00         ld   bc, 5
 694+ 7680 FD 09            add  iy, bc
 695+ 7682
 696+ 7682                  ; Incrementa il numero di item attivi
 697+ 7682 3A 63 7C         ld   a, (num_room_items)
 698+ 7685 3C               inc  a
 699+ 7686 32 63 7C         ld   (num_room_items), a
 700+ 7689
 701+ 7689 18 04            jr   .next_no_inc
 702+ 768B
 703+ 768B              .next_item:
 704+ 768B
 705+ 768B                  ; ---------------------------------------------------------------
 706+ 768B                  ; L'item non appartiene alla stanza corrente.
 707+ 768B                  ; Salta i campi del record:
 708+ 768B                  ;   X
 709+ 768B                  ;   Y
 710+ 768B                  ;   Color
 711+ 768B                  ;   Collected
 712+ 768B                  ; ---------------------------------------------------------------
 713+ 768B 23               inc  hl
 714+ 768C 23               inc  hl
 715+ 768D 23               inc  hl
 716+ 768E 23               inc  hl
 717+ 768F
 718+ 768F              .next_no_inc:
 719+ 768F
 720+ 768F                  ; ---------------------------------------------------------------
 721+ 768F                  ; Avanza al record successivo
 722+ 768F                  ; (prossimo Room ID)
 723+ 768F                  ; ---------------------------------------------------------------
 724+ 768F 23               inc  hl
 725+ 7690 18 A8            jr   .loop
 726+ 7692
 727+ 7692              .done:
 728+ 7692
 729+ 7692                  ; Ripristina i registri
 730+ 7692 FD E1            pop  iy
 731+ 7694 DD E1            pop  ix
 732+ 7696 D1               pop  de
 733+ 7697 C1               pop  bc
 734+ 7698 E1               pop  hl
 735+ 7699
 736+ 7699 C9               ret
 737+ 769A
 738+ 769A              ; -------------------------------------------------------------------
 739+ 769A              ; DrawItemGraphic
 740+ 769A              ;
 741+ 769A              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 742+ 769A              ; utilizzando una bitmap di 8 byte e un attributo colore.
 743+ 769A              ;
 744+ 769A              ; Input:
 745+ 769A              ;   B = Riga attributi (3..18)
 746+ 769A              ;   C = Colonna attributi (0..31)
 747+ 769A              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 748+ 769A              ;   E = Attributo colore
 749+ 769A              ;
 750+ 769A              ; Output:
 751+ 769A              ;   Nessuno
 752+ 769A              ;
 753+ 769A              ; Registri preservati:
 754+ 769A              ;   BC, DE, HL
 755+ 769A              ; -------------------------------------------------------------------
 756+ 769A              DrawItemGraphic:
 757+ 769A
 758+ 769A                  ; Salva i registri originali
 759+ 769A C5               push bc
 760+ 769B D5               push de
 761+ 769C E5               push hl
 762+ 769D
 763+ 769D                  ; ---------------------------------------------------------------
 764+ 769D                  ; Calcolo indirizzo bitmap dello Spectrum
 765+ 769D                  ;
 766+ 769D                  ; Ogni item occupa una cella attributi (8x8 pixel).
 767+ 769D                  ;
 768+ 769D                  ; Formula:
 769+ 769D                  ;   High = $40 + (Row AND $18)
 770+ 769D                  ;   Low  = (Row AND 7) * 32 + Col
 771+ 769D                  ;
 772+ 769D                  ; DE conterrà l'indirizzo della prima scanline.
 773+ 769D                  ; ---------------------------------------------------------------
 774+ 769D
 775+ 769D 78               ld   a, b
 776+ 769E E6 18            and  $18
 777+ 76A0 C6 40            add  a, $40
 778+ 76A2 57               ld   d, a              ; Byte alto indirizzo video
 779+ 76A3
 780+ 76A3 78               ld   a, b
 781+ 76A4 E6 07            and  7                 ; Riga interna al blocco da 8
 782+ 76A6
 783+ 76A6 87               add  a, a              ; *2
 784+ 76A7 87               add  a, a              ; *4
 785+ 76A8 87               add  a, a              ; *8
 786+ 76A9 87               add  a, a              ; *16
 787+ 76AA 87               add  a, a              ; *32
 788+ 76AB
 789+ 76AB 81               add  a, c              ; + colonna
 790+ 76AC
 791+ 76AC 5F               ld   e, a              ; Byte basso indirizzo video
 792+ 76AD
 793+ 76AD                  ; ---------------------------------------------------------------
 794+ 76AD                  ; Disegno bitmap
 795+ 76AD                  ;
 796+ 76AD                  ; Copia 8 byte consecutivi nella memoria video.
 797+ 76AD                  ; Ogni byte rappresenta una scanline da 8 pixel.
 798+ 76AD                  ; ---------------------------------------------------------------
 799+ 76AD
 800+ 76AD C5               push bc                ; Conserva Row e Col
 801+ 76AE
 802+ 76AE 06 08            ld   b, 8              ; Numero scanline
 803+ 76B0
 804+ 76B0              .line_loop:
 805+ 76B0
 806+ 76B0 7E               ld   a, (hl)           ; Legge scanline bitmap
 807+ 76B1 12               ld   (de), a           ; Scrive nella memoria video
 808+ 76B2
 809+ 76B2 14               inc  d                 ; Scanline successiva
 810+ 76B3 23               inc  hl                ; Byte bitmap successivo
 811+ 76B4
 812+ 76B4 05               dec  b
 813+ 76B5 20 F9            jr   nz, .line_loop
 814+ 76B7
 815+ 76B7 C1               pop  bc                ; Ripristina Row e Col
 816+ 76B8
 817+ 76B8                  ; ---------------------------------------------------------------
 818+ 76B8                  ; Calcolo indirizzo attributo
 819+ 76B8                  ;
 820+ 76B8                  ; Formula:
 821+ 76B8                  ;   AttrAddr = $5800 + Row * 32 + Col
 822+ 76B8                  ;
 823+ 76B8                  ; HL conterrà l'indirizzo della cella attributi.
 824+ 76B8                  ; ---------------------------------------------------------------
 825+ 76B8
 826+ 76B8 26 00            ld   h, 0
 827+ 76BA 68               ld   l, b              ; HL = Row
 828+ 76BB
 829+ 76BB 29               add  hl, hl            ; *2
 830+ 76BC 29               add  hl, hl            ; *4
 831+ 76BD 29               add  hl, hl            ; *8
 832+ 76BE 29               add  hl, hl            ; *16
 833+ 76BF 29               add  hl, hl            ; *32
 834+ 76C0
 835+ 76C0 79               ld   a, c              ; A = Colonna
 836+ 76C1
 837+ 76C1 85               add  a, l
 838+ 76C2 6F               ld   l, a
 839+ 76C3
 840+ 76C3 30 01            jr   nc, .no_carry
 841+ 76C5 24               inc  h
 842+ 76C6
 843+ 76C6              .no_carry:
 844+ 76C6
 845+ 76C6                  ; HL = Row * 32 + Col
 846+ 76C6
 847+ 76C6 11 00 58         ld   de, $5800
 848+ 76C9 19               add  hl, de            ; HL = indirizzo attributi
 849+ 76CA
 850+ 76CA                  ; ---------------------------------------------------------------
 851+ 76CA                  ; Recupera il colore originale dallo stack.
 852+ 76CA                  ;
 853+ 76CA                  ; Layout stack:
 854+ 76CA                  ;   HL originale
 855+ 76CA                  ;   DE originale (E = colore)
 856+ 76CA                  ;   BC originale
 857+ 76CA                  ; ---------------------------------------------------------------
 858+ 76CA
 859+ 76CA C1               pop  bc                ; Recupera HL originale
 860+ 76CB D1               pop  de                ; Recupera DE originale
 861+ 76CC
 862+ 76CC                  ; ---------------------------------------------------------------
 863+ 76CC                  ; Scrive l'attributo colore
 864+ 76CC                  ; ---------------------------------------------------------------
 865+ 76CC
 866+ 76CC 7B               ld   a, e              ; A = colore
 867+ 76CD 77               ld   (hl), a           ; Scrive nella RAM attributi
 868+ 76CE
 869+ 76CE                  ; ---------------------------------------------------------------
 870+ 76CE                  ; Ripristina HL e BC originali
 871+ 76CE                  ; ---------------------------------------------------------------
 872+ 76CE
 873+ 76CE C5               push bc
 874+ 76CF E1               pop  hl                ; HL originale
 875+ 76D0
 876+ 76D0 C1               pop  bc                ; BC originale
 877+ 76D1
 878+ 76D1 C9               ret
 879+ 76D2
 880+ 76D2              ; -------------------------------------------------------------------
 881+ 76D2              ; RestoreBackgroundCell
 882+ 76D2              ;
 883+ 76D2              ; Ripristina il contenuto originale di una cella della stanza.
 884+ 76D2              ; Viene utilizzata principalmente quando un item viene raccolto:
 885+ 76D2              ; invece di lasciare un "buco", la routine ridisegna il tile
 886+ 76D2              ; originale presente nella mappa della stanza.
 887+ 76D2              ;
 888+ 76D2              ; Input:
 889+ 76D2              ;   B = Row (3..18)
 890+ 76D2              ;   C = Col (0..31)
 891+ 76D2              ;
 892+ 76D2              ; Utilizza:
 893+ 76D2              ;   room_ptr -> struttura dati della stanza corrente
 894+ 76D2              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 895+ 76D2              ;   Gfx_DrawTile -> ridisegna il tile selezionato
 896+ 76D2              ;
 897+ 76D2              ; Tipi di cella:
 898+ 76D2              ;   0 = Background
 899+ 76D2              ;   1 = Floor
 900+ 76D2              ;   2 = Wall
 901+ 76D2              ;   3 = Nasty
 902+ 76D2              ; -------------------------------------------------------------------
 903+ 76D2              RestoreBackgroundCell:
 904+ 76D2
 905+ 76D2                  ; Salva tutti i registri utilizzati
 906+ 76D2 FD E5            push iy
 907+ 76D4 C5               push bc
 908+ 76D5 D5               push de
 909+ 76D6 E5               push hl
 910+ 76D7 DD E5            push ix
 911+ 76D9
 912+ 76D9                  ; ---------------------------------------------------------------
 913+ 76D9                  ; Conserva Row e Col in IY.
 914+ 76D9                  ;
 915+ 76D9                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 916+ 76D9                  ; BC potrebbe essere modificato.
 917+ 76D9                  ; ---------------------------------------------------------------
 918+ 76D9 C5               push bc
 919+ 76DA FD E1            pop  iy                ; IYH = Row, IYL = Col
 920+ 76DC
 921+ 76DC                  ; ---------------------------------------------------------------
 922+ 76DC                  ; Determina quale tipo di cella è presente nella posizione
 923+ 76DC                  ; specificata.
 924+ 76DC                  ;
 925+ 76DC                  ; Input:
 926+ 76DC                  ;   B = Row
 927+ 76DC                  ;   C = Col
 928+ 76DC                  ;
 929+ 76DC                  ; Output:
 930+ 76DC                  ;   A = tipo cella
 931+ 76DC                  ; ---------------------------------------------------------------
 932+ 76DC 78               ld   a, b
 933+ 76DD
 934+ 76DD CD E3 6B         call GetCellFromUnpacked
 935+ 76E0
 936+ 76E0                  ; ---------------------------------------------------------------
 937+ 76E0                  ; Recupera il puntatore alla stanza corrente.
 938+ 76E0                  ;
 939+ 76E0                  ; DE = base della struttura stanza
 940+ 76E0                  ; ---------------------------------------------------------------
 941+ 76E0 ED 5B 64 7C      ld   de, (room_ptr)
 942+ 76E4
 943+ 76E4                  ; ---------------------------------------------------------------
 944+ 76E4                  ; Seleziona il tile corretto in base al tipo di cella.
 945+ 76E4                  ;
 946+ 76E4                  ; A = 0 -> Background
 947+ 76E4                  ; A = 1 -> Floor
 948+ 76E4                  ; A = 2 -> Wall
 949+ 76E4                  ; A = 3 -> Nasty
 950+ 76E4                  ; ---------------------------------------------------------------
 951+ 76E4
 952+ 76E4 B7               or   a
 953+ 76E5 20 06            jr   nz, .not_bg
 954+ 76E7
 955+ 76E7                  ; Background
 956+ 76E7 21 A0 00         ld   hl, OFFSET_BG
 957+ 76EA 19               add  hl, de
 958+ 76EB 18 16            jr   .draw_cell
 959+ 76ED
 960+ 76ED              .not_bg:
 961+ 76ED
 962+ 76ED 3D               dec  a
 963+ 76EE 20 06            jr   nz, .not_floor
 964+ 76F0
 965+ 76F0                  ; Floor
 966+ 76F0 21 A9 00         ld   hl, OFFSET_FLOOR
 967+ 76F3 19               add  hl, de
 968+ 76F4 18 0D            jr   .draw_cell
 969+ 76F6
 970+ 76F6              .not_floor:
 971+ 76F6
 972+ 76F6 3D               dec  a
 973+ 76F7 20 06            jr   nz, .not_wall
 974+ 76F9
 975+ 76F9                  ; Wall
 976+ 76F9 21 B2 00         ld   hl, OFFSET_WALL
 977+ 76FC 19               add  hl, de
 978+ 76FD 18 04            jr   .draw_cell
 979+ 76FF
 980+ 76FF              .not_wall:
 981+ 76FF
 982+ 76FF                  ; Nasty
 983+ 76FF 21 BB 00         ld   hl, OFFSET_NASTY
 984+ 7702 19               add  hl, de
 985+ 7703
 986+ 7703              .draw_cell:
 987+ 7703
 988+ 7703                  ; ---------------------------------------------------------------
 989+ 7703                  ; HL punta ora alla grafica del tile da ridisegnare.
 990+ 7703                  ;
 991+ 7703                  ; Gfx_DrawTile si aspetta:
 992+ 7703                  ;   IX = puntatore tile
 993+ 7703                  ;   B  = Row
 994+ 7703                  ;   C  = Col
 995+ 7703                  ; ---------------------------------------------------------------
 996+ 7703 E5               push hl
 997+ 7704 DD E1            pop  ix
 998+ 7706
 999+ 7706                  ; Ripristina Row e Col salvati in IY
1000+ 7706 FD E5            push iy
1001+ 7708 C1               pop  bc
1002+ 7709
1003+ 7709                  ; Disegna il tile originale
1004+ 7709 CD 8C 61         call Gfx_DrawTile
1005+ 770C
1006+ 770C                  ; ---------------------------------------------------------------
1007+ 770C                  ; Ripristina i registri salvati
1008+ 770C                  ; ---------------------------------------------------------------
1009+ 770C DD E1            pop  ix
1010+ 770E E1               pop  hl
1011+ 770F D1               pop  de
1012+ 7710 C1               pop  bc
1013+ 7711 FD E1            pop  iy
1014+ 7713
1015+ 7713 C9               ret
1016+ 7714
1017+ 7714              ; -------------------------------------------------------------------
1018+ 7714              ; CheckWillyItemCollision
1019+ 7714              ;
1020+ 7714              ; Verifica se Willy collide con un item utilizzando il controllo
1021+ 7714              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1022+ 7714              ;
1023+ 7714              ; Input:
1024+ 7714              ;   A = ItemX (colonna attributi 0..31)
1025+ 7714              ;   H = ItemY (riga attributi 3..18)
1026+ 7714              ;
1027+ 7714              ; Coordinate item:
1028+ 7714              ;   Ogni item occupa una cella da 8x8 pixel.
1029+ 7714              ;
1030+ 7714              ; Coordinate Willy:
1031+ 7714              ;   Willy occupa un rettangolo di 16x16 pixel.
1032+ 7714              ;
1033+ 7714              ; Output:
1034+ 7714              ;   Carry Set   = collisione rilevata
1035+ 7714              ;   Carry Clear = nessuna collisione
1036+ 7714              ;
1037+ 7714              ; Registri preservati:
1038+ 7714              ;   BC, DE, HL
1039+ 7714              ; -------------------------------------------------------------------
1040+ 7714              CheckWillyItemCollision:
1041+ 7714
1042+ 7714                  ; Salva i registri utilizzati
1043+ 7714 C5               push bc
1044+ 7715 D5               push de
1045+ 7716 E5               push hl
1046+ 7717
1047+ 7717                  ; ---------------------------------------------------------------
1048+ 7717                  ; Calcola il bounding box orizzontale dell'item
1049+ 7717                  ;
1050+ 7717                  ; ItemLeft  = ItemX * 8
1051+ 7717                  ; ItemRight = ItemLeft + 7
1052+ 7717                  ;
1053+ 7717                  ; E = ItemLeft
1054+ 7717                  ; D = ItemRight
1055+ 7717                  ; ---------------------------------------------------------------
1056+ 7717 6F               ld   l, a              ; L = ItemX
1057+ 7718
1058+ 7718 7D               ld   a, l
1059+ 7719 87               add  a, a              ; *2
1060+ 771A 87               add  a, a              ; *4
1061+ 771B 87               add  a, a              ; *8
1062+ 771C
1063+ 771C 5F               ld   e, a              ; E = ItemLeft
1064+ 771D
1065+ 771D C6 07            add  a, 7
1066+ 771F 57               ld   d, a              ; D = ItemRight
1067+ 7720
1068+ 7720                  ; ---------------------------------------------------------------
1069+ 7720                  ; Recupera la posizione corrente di Willy
1070+ 7720                  ;
1071+ 7720                  ; B = WillyY
1072+ 7720                  ; C = WillyX
1073+ 7720                  ; ---------------------------------------------------------------
1074+ 7720 ED 4B ED 78      ld   bc, (PlayerPos)
1075+ 7724
1076+ 7724                  ; ---------------------------------------------------------------
1077+ 7724                  ; Primo test:
1078+ 7724                  ;
1079+ 7724                  ; WillyLeft <= ItemRight
1080+ 7724                  ;
1081+ 7724                  ; Se Willy è completamente a destra dell'item
1082+ 7724                  ; non può esserci collisione.
1083+ 7724                  ; ---------------------------------------------------------------
1084+ 7724 79               ld   a, c              ; A = WillyLeft
1085+ 7725
1086+ 7725 BA               cp   d                 ; WillyLeft vs ItemRight
1087+ 7726
1088+ 7726 28 04            jr   z, .x_ok
1089+ 7728 38 02            jr   c, .x_ok
1090+ 772A
1091+ 772A 18 29            jr   .no_collision
1092+ 772C
1093+ 772C              .x_ok:
1094+ 772C
1095+ 772C                  ; ---------------------------------------------------------------
1096+ 772C                  ; Secondo test:
1097+ 772C                  ;
1098+ 772C                  ; WillyRight >= ItemLeft
1099+ 772C                  ;
1100+ 772C                  ; WillyRight = WillyX + 7
1101+ 772C                  ; ---------------------------------------------------------------
1102+ 772C C6 07            add  a, 7
1103+ 772E
1104+ 772E BB               cp   e                 ; WillyRight vs ItemLeft
1105+ 772F
1106+ 772F 28 04            jr   z, .y_check
1107+ 7731 30 02            jr   nc, .y_check
1108+ 7733
1109+ 7733 18 20            jr   .no_collision
1110+ 7735
1111+ 7735              .y_check:
1112+ 7735
1113+ 7735                  ; ---------------------------------------------------------------
1114+ 7735                  ; Recupera ItemY dal valore originale di HL
1115+ 7735                  ;
1116+ 7735                  ; H contiene la riga dell'item.
1117+ 7735                  ; ---------------------------------------------------------------
1118+ 7735 E1               pop  hl
1119+ 7736 E5               push hl
1120+ 7737
1121+ 7737                  ; ---------------------------------------------------------------
1122+ 7737                  ; Calcola il bounding box verticale dell'item
1123+ 7737                  ;
1124+ 7737                  ; ItemTop    = ItemY * 8
1125+ 7737                  ; ItemBottom = ItemTop + 7
1126+ 7737                  ;
1127+ 7737                  ; E = ItemTop
1128+ 7737                  ; D = ItemBottom
1129+ 7737                  ; ---------------------------------------------------------------
1130+ 7737 7C               ld   a, h
1131+ 7738
1132+ 7738 87               add  a, a              ; *2
1133+ 7739 87               add  a, a              ; *4
1134+ 773A 87               add  a, a              ; *8
1135+ 773B
1136+ 773B 5F               ld   e, a              ; ItemTop
1137+ 773C
1138+ 773C C6 07            add  a, 7
1139+ 773E 57               ld   d, a              ; ItemBottom
1140+ 773F
1141+ 773F                  ; ---------------------------------------------------------------
1142+ 773F                  ; Primo test verticale:
1143+ 773F                  ;
1144+ 773F                  ; WillyTop <= ItemBottom
1145+ 773F                  ; ---------------------------------------------------------------
1146+ 773F 78               ld   a, b              ; WillyTop
1147+ 7740
1148+ 7740 BA               cp   d
1149+ 7741
1150+ 7741 28 04            jr   z, .y_ok
1151+ 7743 38 02            jr   c, .y_ok
1152+ 7745
1153+ 7745 18 0E            jr   .no_collision
1154+ 7747
1155+ 7747              .y_ok:
1156+ 7747
1157+ 7747                  ; ---------------------------------------------------------------
1158+ 7747                  ; Secondo test verticale:
1159+ 7747                  ;
1160+ 7747                  ; WillyBottom >= ItemTop
1161+ 7747                  ;
1162+ 7747                  ; WillyBottom = WillyY + 15
1163+ 7747                  ; ---------------------------------------------------------------
1164+ 7747 C6 0F            add  a, 15
1165+ 7749
1166+ 7749 BB               cp   e
1167+ 774A
1168+ 774A 28 04            jr   z, .collision
1169+ 774C 30 02            jr   nc, .collision
1170+ 774E
1171+ 774E 18 05            jr   .no_collision
1172+ 7750
1173+ 7750              .collision:
1174+ 7750
1175+ 7750                  ; ---------------------------------------------------------------
1176+ 7750                  ; Collisione rilevata
1177+ 7750                  ; ---------------------------------------------------------------
1178+ 7750 E1               pop  hl
1179+ 7751 D1               pop  de
1180+ 7752 C1               pop  bc
1181+ 7753
1182+ 7753 37               scf                    ; Carry = 1
1183+ 7754
1184+ 7754 C9               ret
1185+ 7755
1186+ 7755              .no_collision:
1187+ 7755
1188+ 7755                  ; ---------------------------------------------------------------
1189+ 7755                  ; Nessuna collisione
1190+ 7755                  ; ---------------------------------------------------------------
1191+ 7755 E1               pop  hl
1192+ 7756 D1               pop  de
1193+ 7757 C1               pop  bc
1194+ 7758
1195+ 7758 B7               or   a                 ; Carry = 0
1196+ 7759
1197+ 7759 C9               ret
1198+ 775A
1199+ 775A              ; -------------------------------------------------------------------
1200+ 775A              ; Items_CheckCollision
1201+ 775A              ;
1202+ 775A              ; Controlla se Willy entra in collisione con uno degli item
1203+ 775A              ; attivi presenti nella stanza corrente.
1204+ 775A              ;
1205+ 775A              ; Per ogni item:
1206+ 775A              ;   - verifica che appartenga alla stanza corrente
1207+ 775A              ;   - verifica che non sia già stato raccolto
1208+ 775A              ;   - esegue il test di collisione con Willy
1209+ 775A              ;
1210+ 775A              ; Se l'item viene raccolto:
1211+ 775A              ;   - imposta il flag "collected"
1212+ 775A              ;   - rimuove l'item dalla cache items_grid
1213+ 775A              ;   - incrementa il contatore degli oggetti raccolti
1214+ 775A              ;   - aggiorna l'HUD
1215+ 775A              ;   - ripristina il tile di sfondo
1216+ 775A              ;   - riproduce il suono di raccolta
1217+ 775A              ;
1218+ 775A              ; Formato record ItemsTable:
1219+ 775A              ;   +0 RoomID
1220+ 775A              ;   +1 X
1221+ 775A              ;   +2 Y
1222+ 775A              ;   +3 Color
1223+ 775A              ;   +4 Collected
1224+ 775A              ;
1225+ 775A              ; Fine tabella:
1226+ 775A              ;   RoomID = $FF
1227+ 775A              ; -------------------------------------------------------------------
1228+ 775A              Items_CheckCollision:
1229+ 775A
1230+ 775A                  ; Salva i registri utilizzati
1231+ 775A E5               push hl
1232+ 775B D5               push de
1233+ 775C C5               push bc
1234+ 775D
1235+ 775D                  ; Inizio scansione della tabella degli item
1236+ 775D 21 B7 73         ld   hl, ItemsTable
1237+ 7760
1238+ 7760              .loop:
1239+ 7760
1240+ 7760                  ; ---------------------------------------------------------------
1241+ 7760                  ; Legge il Room ID dell'item corrente
1242+ 7760                  ; ---------------------------------------------------------------
1243+ 7760 7E               ld   a, (hl)
1244+ 7761
1245+ 7761                  ; $FF indica fine tabella
1246+ 7761 FE FF            cp   $FF
1247+ 7763 28 4D            jr   z, .done
1248+ 7765
1249+ 7765                  ; ---------------------------------------------------------------
1250+ 7765                  ; Verifica se l'item appartiene alla stanza corrente
1251+ 7765                  ; ---------------------------------------------------------------
1252+ 7765 57               ld   d, a              ; D = RoomID item
1253+ 7766
1254+ 7766 3A 0A 7C         ld   a, (current_room)
1255+ 7769 BA               cp   d
1256+ 776A
1257+ 776A                  ; Se appartiene a un'altra stanza salta il record
1258+ 776A 20 3F            jr   nz, .next_item
1259+ 776C
1260+ 776C                  ; ---------------------------------------------------------------
1261+ 776C                  ; Legge coordinate e stato dell'item
1262+ 776C                  ; ---------------------------------------------------------------
1263+ 776C
1264+ 776C 23               inc  hl
1265+ 776D 4E               ld   c, (hl)           ; C = X
1266+ 776E
1267+ 776E 23               inc  hl
1268+ 776F 46               ld   b, (hl)           ; B = Y
1269+ 7770
1270+ 7770 23               inc  hl                ; salta Color
1271+ 7771
1272+ 7771 23               inc  hl                ; punta a Collected
1273+ 7772
1274+ 7772 7E               ld   a, (hl)
1275+ 7773
1276+ 7773                  ; ---------------------------------------------------------------
1277+ 7773                  ; Item già raccolto?
1278+ 7773                  ; ---------------------------------------------------------------
1279+ 7773 B7               or   a
1280+ 7774 20 39            jr   nz, .next_no_inc
1281+ 7776
1282+ 7776                  ; ---------------------------------------------------------------
1283+ 7776                  ; Test collisione Willy ↔ Item
1284+ 7776                  ;
1285+ 7776                  ; Input richiesto:
1286+ 7776                  ;   A = ItemX
1287+ 7776                  ;   H = ItemY
1288+ 7776                  ; ---------------------------------------------------------------
1289+ 7776 79               ld   a, c
1290+ 7777
1291+ 7777 E5               push hl                ; salva puntatore al flag Collected
1292+ 7778
1293+ 7778 60               ld   h, b
1294+ 7779
1295+ 7779 CD 14 77         call CheckWillyItemCollision
1296+ 777C
1297+ 777C E1               pop  hl
1298+ 777D
1299+ 777D                  ; Nessuna collisione
1300+ 777D 30 30            jr   nc, .next_no_inc
1301+ 777F
1302+ 777F                  ; ===============================================================
1303+ 777F                  ; ITEM RACCOLTO
1304+ 777F                  ; ===============================================================
1305+ 777F
1306+ 777F                  ; ---------------------------------------------------------------
1307+ 777F                  ; Marca l'item come raccolto
1308+ 777F                  ; ---------------------------------------------------------------
1309+ 777F 36 01            ld   (hl), 1
1310+ 7781
1311+ 7781                  ; ---------------------------------------------------------------
1312+ 7781                  ; Rimuove l'item dalla cache items_grid
1313+ 7781                  ;
1314+ 7781                  ; Calcolo:
1315+ 7781                  ;   offset = Row * 32 + Col
1316+ 7781                  ; ---------------------------------------------------------------
1317+ 7781 E5               push hl
1318+ 7782 D5               push de
1319+ 7783
1320+ 7783 26 00            ld   h, 0
1321+ 7785 68               ld   l, b              ; HL = Row
1322+ 7786
1323+ 7786 29               add  hl, hl            ; *2
1324+ 7787 29               add  hl, hl            ; *4
1325+ 7788 29               add  hl, hl            ; *8
1326+ 7789 29               add  hl, hl            ; *16
1327+ 778A 29               add  hl, hl            ; *32
1328+ 778B
1329+ 778B 59               ld   e, c
1330+ 778C 16 00            ld   d, 0
1331+ 778E
1332+ 778E 19               add  hl, de            ; Row*32 + Col
1333+ 778F
1334+ 778F 11 00 B0         ld   de, items_grid
1335+ 7792 19               add  hl, de
1336+ 7793
1337+ 7793                  ; La cella non contiene più un item
1338+ 7793 36 00            ld   (hl), 0
1339+ 7795
1340+ 7795 D1               pop  de
1341+ 7796 E1               pop  hl
1342+ 7797
1343+ 7797                  ; ---------------------------------------------------------------
1344+ 7797                  ; Conserva il puntatore all'entry corrente
1345+ 7797                  ; poiché le routine successive possono alterare HL.
1346+ 7797                  ; ---------------------------------------------------------------
1347+ 7797 E5               push hl
1348+ 7798
1349+ 7798                  ; ---------------------------------------------------------------
1350+ 7798                  ; Aggiorna il numero di oggetti raccolti
1351+ 7798                  ; ---------------------------------------------------------------
1352+ 7798 3A F7 78         ld   a, (items_collected)
1353+ 779B
1354+ 779B 3C               inc  a
1355+ 779C
1356+ 779C 32 F7 78         ld   (items_collected), a
1357+ 779F
1358+ 779F                  ; ---------------------------------------------------------------
1359+ 779F                  ; Aggiorna il contatore visualizzato a schermo
1360+ 779F                  ; ---------------------------------------------------------------
1361+ 779F CD CB 60         call Gfx_UpdateItemsCollectedDisplay
1362+ 77A2
1363+ 77A2                  ; ---------------------------------------------------------------
1364+ 77A2                  ; Ripristina il tile originale della stanza
