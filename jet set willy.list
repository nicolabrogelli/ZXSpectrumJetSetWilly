 434+ 6DFB                  ; Calcola il frame dell'animazione: Anim State * 32
 435+ 6DFB DD 7E 06         ld   a, (ix+6)         ; Anim State (0..3)
 436+ 6DFE 87               add  a, a              ; *2
 437+ 6DFF 87               add  a, a              ; *4
 438+ 6E00 87               add  a, a              ; *8
 439+ 6E01 87               add  a, a              ; *16
 440+ 6E02 87               add  a, a              ; *32
 441+ 6E03 5F               ld   e, a
 442+ 6E04 16 00            ld   d, 0              ; DE = offset del frame
 443+ 6E06 19               add  hl, de            ; HL = indirizzo del frame corretto
 444+ 6E07
 445+ 6E07                  ; Disegna alla coordinata corrente
 446+ 6E07 DD 4E 01         ld   c, (ix+1)         ; C = Current X
 447+ 6E0A DD 46 02         ld   b, (ix+2)         ; B = Current Y
 448+ 6E0D
 449+ 6E0D DD E5            push ix                ; Salva slot pointer
 450+ 6E0F E5               push hl
 451+ 6E10 DD E1            pop  ix                ; IX = sprite data pointer
 452+ 6E12 CD 70 5F         call DrawPixelSprite16x16
 453+ 6E15 DD E1            pop  ix                ; Ripristina slot pointer
 454+ 6E17
 455+ 6E17                  ; Applica gli attributi colore per la posizione corrente
 456+ 6E17 DD 4E 01         ld   c, (ix+1)         ; C = Current X
 457+ 6E1A DD 46 02         ld   b, (ix+2)         ; B = Current Y
 458+ 6E1D DD 7E 09         ld   a, (ix+9)         ; A = Color
 459+ 6E20 CD BE 62         call SetEnemyColorAttributes
 460+ 6E23
 461+ 6E23 C1               pop  bc                ; Ripristina contatore ciclo
 462+ 6E24
 463+ 6E24              .next:
 464+ 6E24 11 0A 00         ld   de, 10
 465+ 6E27 DD 19            add  ix, de            ; Prossimo slot
 466+ 6E29 05               dec  b
 467+ 6E2A C2 3B 6D         jp   nz, .loop
 468+ 6E2D
 469+ 6E2D DD E1            pop  ix
 470+ 6E2F C1               pop  bc
 471+ 6E30 D1               pop  de
 472+ 6E31 E1               pop  hl
 473+ 6E32 C9               ret
