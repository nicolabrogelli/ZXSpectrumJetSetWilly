1424+ 6CE4 30 17            jr   nc, .not_nasty
1425+ 6CE6
1426+ 6CE6                  ; 2. Calcola riga di layout: r = Y / 8
1427+ 6CE6 CB 3F            srl  a
1428+ 6CE8 CB 3F            srl  a
1429+ 6CEA CB 3F            srl  a                 ; A = r (0..15)
1430+ 6CEC
1431+ 6CEC                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1432+ 6CEC 5F               ld   e, a              ; E = r
1433+ 6CED 79               ld   a, c
