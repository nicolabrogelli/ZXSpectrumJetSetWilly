 140  7E5E 3A 28 7A         ld   a, (flag_guardian_collision_death)
 141  7E61 B7               or   a
 142  7E62 28 25            jr   z, .draw_raster_bars ; se disabilitato, disegna le raster bar per debug
 143  7E64
 144  7E64              .willy_dies:
 145  7E64                  ; Decrementa le vite e aggiorna la visualizzazione
 146  7E64 21 2A 7A         ld   hl, willy_lives
 147  7E67 7E               ld   a, (hl)
 148  7E68 B7               or   a
 149  7E69 28 01            jr   z, .no_lives_dec
 150  7E6B 35               dec  (hl)
 151  7E6C              .no_lives_dec:
 152  7E6C CD 99 60         call Gfx_PrintWillyLives
 153  7E6F
 154  7E6F                  ; Gestisci la morte di Willy:
 155  7E6F                  ; 1. Cancella la sprite del player dalla sua posizione attuale a schermo
 156  7E6F CD 46 60         call Gfx_DeleteCharAtOldPos
 157  7E72
 158  7E72                  ; 2. Ripristina la posizione iniziale nella stanza
 159  7E72 CD B1 65         call LoadPositionPlayeinRoom
 160  7E75
 161  7E75                  ; 3. Reimposta la fisica di Willy
 162  7E75 AF               xor  a
 163  7E76 32 2B 7A         ld   (velocity_y), a
 164  7E79 32 2D 7A         ld   (jump_pressed), a
 165  7E7C 32 31 7A         ld   (jump_frame), a
 166  7E7F 32 30 7A         ld   (jump_dir), a
 167  7E82 3E 01            ld   a, 1
 168  7E84 32 2C 7A         ld   (on_ground), a
 169  7E87 18 1A            jr   .no_collision ; Salta il disegno delle raster bar poiché Willy è morto
 170  7E89
 171  7E89              .draw_raster_bars:
 172  7E89                  ; Collisione attiva: disegna le raster bar nel bordo
 173  7E89 3A 36 7A         ld   a, (counter)
 174  7E8C E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 175  7E8E 06 1E            ld   b, 30             ; Numero di righe della barra raster
 176  7E90              .raster_loop:
 177  7E90 D3 FE            out  ($fe), a
 178  7E92 3C               inc  a
 179  7E93 E6 07            and  7
 180  7E95 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 181  7E97              .delay:
 182  7E97 0D               dec  c
 183  7E98 20 FD            jr   nz, .delay
 184  7E9A 10 F4            djnz .raster_loop
 185  7E9C
 186  7E9C                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 187  7E9C 3A 27 7A         ld   a, (room_border_color)
 188  7E9F D3 FE            out  ($fe), a
 189  7EA1 18 05            jr   .no_collision_change
 190  7EA3
 191  7EA3              .no_collision:
 192  7EA3                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 193  7EA3 3A 27 7A         ld   a, (room_border_color)
 194  7EA6 D3 FE            out  ($fe), a
