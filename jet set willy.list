   7+ 6E75              ; Verifica se c'è una cella solida (Floor o Wall) alle coordinate pixel (X, Y)
   8+ 6E75              ; Input: C = X, B = Y
   9+ 6E75              ; Output: Carry flag impostato se solida, altrimenti resettato
  10+ 6E75              ; -------------------------------------------------------------------
  11+ 6E75              CheckSolidCell:
  12+ 6E75 E5               push hl
  13+ 6E76 D5               push de
  14+ 6E77 C5               push bc
  15+ 6E78
  16+ 6E78 CD BF 6F         call CheckConveyorOrRampCell
  17+ 6E7B 38 2B            jr   c, .solid
  18+ 6E7D
  19+ 6E7D                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout (Y < 24 o Y >= 152)
  20+ 6E7D 78               ld   a, b
  21+ 6E7E FE 18            cp   24
  22+ 6E80 38 21            jr   c, .not_solid
  23+ 6E82 FE 98            cp   152
  24+ 6E84 30 1D            jr   nc, .not_solid
  25+ 6E86
  26+ 6E86                  ; 2. Calcola riga di layout: r = (Y - 24) / 8
  27+ 6E86 D6 18            sub  24
  28+ 6E88 CB 3F            srl  a
  29+ 6E8A CB 3F            srl  a
  30+ 6E8C CB 3F            srl  a                 ; A = r (0..15)
  31+ 6E8E
  32+ 6E8E                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
  33+ 6E8E 5F               ld   e, a              ; E = r
  34+ 6E8F 79               ld   a, c
  35+ 6E90 CB 3F            srl  a
  36+ 6E92 CB 3F            srl  a
  37+ 6E94 CB 3F            srl  a                 ; A = c (0..31)
  38+ 6E96 4F               ld   c, a              ; C = c
  39+ 6E97 7B               ld   a, e              ; A = r
  40+ 6E98
  41+ 6E98 CD 11 71         call GetCellFromUnpacked ; A = cell type
  42+ 6E9B
  43+ 6E9B                  ; 5. Controlla se è solida: Floor (1) o Wall (2)
  44+ 6E9B FE 01            cp   1
  45+ 6E9D 28 09            jr   z, .solid
  46+ 6E9F FE 02            cp   2
  47+ 6EA1 28 05            jr   z, .solid
  48+ 6EA3
  49+ 6EA3              .not_solid:
  50+ 6EA3 C1               pop  bc
  51+ 6EA4 D1               pop  de
  52+ 6EA5 E1               pop  hl
