1521+ 794B              ; CheckActiveItemAtCell
1522+ 794B              ;
1523+ 794B              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1524+ 794B              ; nella cella specificata della griglia items_grid.
1525+ 794B              ;
1526+ 794B              ; Questa routine usa una lookup diretta su una mappa 32x16,
1527+ 794B              ; evitando la scansione della ItemsTable.
1528+ 794B              ;
1529+ 794B              ; Input:
1530+ 794B              ;   B = Colonna (0..31)
1531+ 794B              ;   C = Riga (0..15)
1532+ 794B              ;
1533+ 794B              ; Output:
1534+ 794B              ;   Carry Set   = item presente nella cella
1535+ 794B              ;   Carry Clear = nessun item
1536+ 794B              ;
1537+ 794B              ; Nota:
1538+ 794B              ;   HL NON è restituito valido (commento originale non corretto:
1539+ 794B              ;   la routine non punta a ItemsTable).
1540+ 794B              ; -------------------------------------------------------------------
1541+ 794B              CheckActiveItemAtCell:
1542+ 794B
1543+ 794B                  ; Salva registri usati
1544+ 794B D5               push de
1545+ 794C E5               push hl
1546+ 794D
1547+ 794D                  ; ---------------------------------------------------------------
1548+ 794D                  ; Calcolo indice lineare nella griglia 32x16:
1549+ 794D                  ;
1550+ 794D                  ; offset = Row * 32 + Col
1551+ 794D                  ; ---------------------------------------------------------------
1552+ 794D 26 00            ld   h, 0
1553+ 794F 69               ld   l, c              ; HL = Row
1554+ 7950
1555+ 7950 29               add  hl, hl            ; *2
1556+ 7951 29               add  hl, hl            ; *4
1557+ 7952 29               add  hl, hl            ; *8
1558+ 7953 29               add  hl, hl            ; *16
1559+ 7954 29               add  hl, hl            ; *32
1560+ 7955
1561+ 7955                  ; Aggiunge la colonna
1562+ 7955 58               ld   e, b
1563+ 7956 16 00            ld   d, 0
1564+ 7958 19               add  hl, de            ; HL = Row*32 + Col
1565+ 7959
1566+ 7959                  ; ---------------------------------------------------------------
1567+ 7959                  ; Accesso alla griglia degli item attivi
1568+ 7959                  ; ---------------------------------------------------------------
1569+ 7959 11 00 B0         ld   de, items_grid
1570+ 795C 19               add  hl, de            ; HL = address cella
1571+ 795D
1572+ 795D                  ; ---------------------------------------------------------------
1573+ 795D                  ; Controllo presenza item
1574+ 795D                  ;
1575+ 795D                  ; items_grid contiene:
1576+ 795D                  ;   0 = nessun item
1577+ 795D                  ;   >0 = item attivo (colore o flag)
1578+ 795D                  ; ---------------------------------------------------------------
1579+ 795D 7E               ld   a, (hl)
1580+ 795E B7               or   a
1581+ 795F 28 04            jr   z, .not_active
1582+ 7961
1583+ 7961                  ; ---------------------------------------------------------------
1584+ 7961                  ; Item trovato
1585+ 7961                  ; ---------------------------------------------------------------
1586+ 7961 E1               pop  hl
1587+ 7962 D1               pop  de
1588+ 7963
1589+ 7963 37               scf                    ; Carry = 1
1590+ 7964 C9               ret
1591+ 7965
1592+ 7965              .not_active:
1593+ 7965
1594+ 7965                  ; ---------------------------------------------------------------
1595+ 7965                  ; Nessun item nella cella
1596+ 7965                  ; ---------------------------------------------------------------
1597+ 7965 E1               pop  hl
1598+ 7966 D1               pop  de
1599+ 7967
1600+ 7967 B7               or   a                 ; Carry = 0
1601+ 7968 C9               ret
