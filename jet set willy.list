 187+ 78D5 D3 FE            out  ($fe), a
 188+ 78D7
 189+ 78D7 0E 3C            ld   c, 60
 190+ 78D9              .d1:
 191+ 78D9 0D               dec  c
 192+ 78DA 20 FD            jr   nz, .d1
 193+ 78DC
 194+ 78DC 3A F9 78         ld   a, (room_border_color)
 195+ 78DF E6 EF            and  $ef              ; speaker OFF
 196+ 78E1 D3 FE            out  ($fe), a
 197+ 78E3
 198+ 78E3 0E 3C            ld   c, 60
 199+ 78E5              .d2:
 200+ 78E5 0D               dec  c
 201+ 78E6 20 FD            jr   nz, .d2
 202+ 78E8
 203+ 78E8 10 E6            djnz .sound_loop
 204+ 78EA
 205+ 78EA D1               pop  de
 206+ 78EB C1               pop  bc
 207+ 78EC C9               ret
