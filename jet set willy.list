1197+ 84C5
1198+ 84C5                  ; ---------------------------------------------------------------
1199+ 84C5                  ; Legge i dati dell'item
1200+ 84C5                  ; ---------------------------------------------------------------
1201+ 84C5
1202+ 84C5 23               inc  hl
1203+ 84C6 4E               ld   c, (hl)           ; X (colonna)
1204+ 84C7
1205+ 84C7 23               inc  hl
1206+ 84C8 46               ld   b, (hl)           ; Y (riga)
1207+ 84C9
1208+ 84C9 23               inc  hl
1209+ 84CA 5E               ld   e, (hl)           ; Colore
1210+ 84CB
1211+ 84CB 23               inc  hl
1212+ 84CC 7E               ld   a, (hl)           ; Collected flag
1213+ 84CD
1214+ 84CD                  ; Se diverso da zero l'item è già stato raccolto
1215+ 84CD B7               or   a
1216+ 84CE 20 3E            jr   nz, .next_no_inc
1217+ 84D0
1218+ 84D0                  ; ---------------------------------------------------------------
1219+ 84D0                  ; Disegna l'item sullo schermo
1220+ 84D0                  ;
1221+ 84D0                  ; B = Row
1222+ 84D0                  ; C = Column
1223+ 84D0                  ; HL = bitmap pointer
1224+ 84D0                  ; E = Color
1225+ 84D0                  ; ---------------------------------------------------------------
1226+ 84D0 E5               push hl
1227+ 84D1
1228+ 84D1 DD E5            push ix
1229+ 84D3 E1               pop  hl
1230+ 84D4
1231+ 84D4 CD 19 85         call DrawItemGraphic
1232+ 84D7
1233+ 84D7 E1               pop  hl                ; ritorna al flag collected
1234+ 84D8
1235+ 84D8                  ; ---------------------------------------------------------------
