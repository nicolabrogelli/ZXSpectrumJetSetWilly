 119  79C1 06 1E            ld   b, 30             ; Numero di righe della barra raster
 120  79C3              .raster_loop:
 121  79C3 D3 FE            out  ($fe), a
 122  79C5 3C               inc  a
 123  79C6 E6 07            and  7
 124  79C8 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 125  79CA              .delay:
 126  79CA 0D               dec  c
 127  79CB 20 FD            jr   nz, .delay
 128  79CD 10 F4            djnz .raster_loop
 129  79CF
 130  79CF                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
