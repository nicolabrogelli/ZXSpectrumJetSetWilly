 407  87EA              ; ResetFullGameState
 408  87EA              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 409  87EA              ; per l'avvio di una nuova partita dopo il Game Over.
 410  87EA              ; -------------------------------------------------------------------
 411  87EA              ResetFullGameState:
 412  87EA                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 413  87EA AF               xor  a
 414  87EB D3 FE            out  ($fe), a              ; Bordo a nero
 415  87ED 21 8D 5C         ld   hl, ATTR_P
 416  87F0 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 417  87F1 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 418  87F4 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 419  87F6 3E 07            ld   a, $07
 420  87F8 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 421  87FB
 422  87FB                  ; Ripristina il numero di vite iniziali
 423  87FB 3E 07            ld   a, INITIAL_LIVES
 424  87FD 32 F7 EA         ld   (willy_lives), a
 425  8800
 426  8800                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 427  8800 AF               xor  a
 428  8801 32 F4 EA         ld   (items_collected), a
 429  8804 32 F0 EA         ld   (body_state), a
 430  8807 32 03 EB         ld   (w_warp_state), a
 431  880A 32 06 EB         ld   (w_key_prev), a
 432  880D 32 07 EB         ld   (enter_key_prev), a
 433  8810 32 F8 EA         ld   (velocity_y), a
 434  8813 32 FA EA         ld   (jump_pressed), a
 435  8816 32 FC EA         ld   (coyote_timer), a
 436  8819 32 FF EA         ld   (jump_frame), a
 437  881C 32 FE EA         ld   (jump_dir), a
 438  881F 32 70 EE         ld   (transition_active), a
 439  8822 32 F4 EE         ld   (willy_safety_timer), a
 440  8825 3E FF            ld   a, $ff
 441  8827 32 08 EB         ld   (digit_key_prev), a
 442  882A 3E 01            ld   a, 1
 443  882C 32 01 EB         ld   (q_prev), a
 444  882F 32 02 EB         ld   (a_prev), a
 445  8832 32 F9 EA         ld   (on_ground), a
 446  8835
 447  8835                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 448  8835 3E 30            ld   a, '0'
 449  8837 32 51 67         ld   (status_line + 16), a
 450  883A 32 52 67         ld   (status_line + 17), a
 451  883D 32 53 67         ld   (status_line + 18), a
 452  8840
 453  8840                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 454  8840 CD D9 83         call ResetItemsTable
 455  8843
 456  8843                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 457  8843 CD 0F 6C         call InitRoomEntryPositions
 458  8846
 459  8846                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 460  8846 3E 07            ld   a, 7
 461  8848 32 F7 EE         ld   (time_hours), a
 462  884B AF               xor  a
 463  884C 32 F8 EE         ld   (time_minutes), a
 464  884F 32 F9 EE         ld   (time_period), a       ; 0 = AM
 465  8852 32 FC EE         ld   (game_objective_completed), a
