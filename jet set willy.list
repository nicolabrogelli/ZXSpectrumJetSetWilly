1129+ 6C5C                  ; Cella 0: bit 7-6
1130+ 6C5C 07               rlca
1131+ 6C5D 07               rlca
1132+ 6C5E E6 03            and  3
1133+ 6C60 12               ld   (de), a
1134+ 6C61 13               inc  de
1135+ 6C62
1136+ 6C62                  ; Cella 1: bit 5-4
1137+ 6C62 79               ld   a, c
1138+ 6C63 07               rlca
1139+ 6C64 07               rlca
1140+ 6C65 07               rlca
1141+ 6C66 07               rlca
1142+ 6C67 E6 03            and  3
1143+ 6C69 12               ld   (de), a
1144+ 6C6A 13               inc  de
1145+ 6C6B
1146+ 6C6B                  ; Cella 2: bit 3-2
1147+ 6C6B 79               ld   a, c
1148+ 6C6C 0F               rrca
1149+ 6C6D 0F               rrca
1150+ 6C6E E6 03            and  3
1151+ 6C70 12               ld   (de), a
1152+ 6C71 13               inc  de
1153+ 6C72
1154+ 6C72                  ; Cella 3: bit 1-0
1155+ 6C72 79               ld   a, c
1156+ 6C73 E6 03            and  3
1157+ 6C75 12               ld   (de), a
1158+ 6C76 13               inc  de
1159+ 6C77
1160+ 6C77 10 E0            djnz .byte_loop
1161+ 6C79
1162+ 6C79 C1               pop  bc
1163+ 6C7A D1               pop  de
1164+ 6C7B E1               pop  hl
