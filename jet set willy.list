 113  89C7 CD B9 60         call Gfx_UpdatePlayer
 114  89CA
 115  89CA                  ; 3. Scorrimento dell'orologio di gioco (1 min di gioco = 40 sec reali)
 116  89CA CD B5 8D         call Time_UpdateClock
 117  89CD
 118  89CD                  ; 2. Aggiornamento audio
 119  89CD                  IF ENABLE_EFFECTS != 0
 120  89CD CD 35 88         call Audio_UpdateJumpSound    ; Aggiorna l'effetto sonoro del salto
 121  89D0                  ENDIF
 122  89D0
 123  89D0                  IF ENABLE_MUSIC != 0
 124  89D0 CD 81 88         call Audio_UpdateMusic        ; Aggiorna la musica
 125  89D3                  ENDIF
 126  89D3
 127  89D3                  ; Se l'animazione delle vite è abilitata, aggiorna la visualizzazione delle icone camminanti
 128  89D3                  IF ENABLE_ANIMATE_LIVES != 0
 129  89D3 ~                call Gfx_PrintWillyLives
 130  89D3                  ENDIF
 131  89D3
 132  89D3
 133  89D3                  ; 3. Salva le posizioni correnti del player per il prossimo frame
 134  89D3 ED 4B 3A F7      ld   bc, (PlayerPos)
 135  89D7 ED 43 3C F7      ld   (PlayerPosOld), bc
 136  89DB
 137  89DB                  ; 4. Aggiorna le posizioni dei personaggi per il prossimo frame
 138  89DB CD 43 6E         call Input_CheckCtrl
 139  89DE CD 1D 6D         call MovePlayer
 140  89E1 CD E4 71         call Phys_ApplyGravity
 141  89E4 CD B3 75         call Phys_ApplyConveyor
 142  89E7 CD C7 7F         call Enemy_Update
 143  89EA CD B0 87         call Items_CheckCollision
 144  89ED
 145  89ED                  ; Controlla condizione di vittoria (Tutti gli item + Master Bedroom + Conveyor)
 146  89ED                  IF ENABLE_VICTORY_SCREEN != 0
 147  89ED CD 80 8C         call CheckVictoryCondition
 148  89F0 DA 02 8C         jp   c, TriggerVictory
 149  89F3                  ENDIF
 150  89F3
 151  89F3                  ; Controlla collisione con Nasties (morte di Willy)
 152  89F3                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 153  89F3 CD 31 7A         call Phys_CheckNastyCollision
 154  89F6 38 0B            jr   c, .willy_dies
 155  89F8                  ENDIF
 156  89F8
 157  89F8                  ; Controlla collisione con guardiani
 158  89F8 CD 2A 75         call CheckCollision
 159  89FB 38 03            jr   c, .guardian_collision_found
 160  89FD
 161  89FD                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 162  89FD                  IF ENABLE_RAMP_DEBUG_BARS != 0
 163  89FD ~                ld   a, (willy_on_ramp)
 164  89FD ~                or   a
 165  89FD ~                jp   nz, .draw_raster_bars
 166  89FD                  ENDIF
 167  89FD
 168  89FD C3 7A 8A         jp   .no_collision
 169  8A00
 170  8A00              .guardian_collision_found:
 171  8A00                  ; C'è collisione con un guardiano!
 172  8A00                  ; Controlla se la morte per collisione con i guardiani è abilitata
 173  8A00                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 174  8A00 C3 03 8A         jp   .willy_dies
 175  8A03                  ELSE
 176  8A03 ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 177  8A03 ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 178  8A03 ~                    ELSE
 179  8A03 ~                    jp   .no_collision
 180  8A03 ~                    ENDIF
 181  8A03                  ENDIF
 182  8A03
 183  8A03              .willy_dies:
 184  8A03                  ; 1. Decrementa le vite
 185  8A03 21 47 F7         ld   hl, willy_lives
 186  8A06 7E               ld   a, (hl)
 187  8A07 B7               or   a
 188  8A08 28 05            jr   z, .check_game_over
 189  8A0A 35               dec  (hl)
 190  8A0B 28 02            jr   z, .check_game_over
 191  8A0D 18 03            jr   .normal_respawn
 192  8A0F
 193  8A0F              .check_game_over:
 194  8A0F                  IF ENABLE_GAME_OVER_RESTART != 0
 195  8A0F C3 D1 8A         jp   TriggerGameOver
 196  8A12                  ELSE
 197  8A12 ~                ld   a, 1
 198  8A12 ~                ld   (willy_lives), a
 199  8A12 ~                jr   .normal_respawn
 200  8A12                  ENDIF
 201  8A12
 202  8A12              .normal_respawn:
 203  8A12                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 204  8A12 AF               xor  a
 205  8A13 D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 206  8A15 21 8D 5C         ld   hl, ATTR_P
 207  8A18 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 208  8A19 CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 209  8A1C 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 210  8A1E 3E 07            ld   a, $07
 211  8A20 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 212  8A23
 213  8A23                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 214  8A23 06 19            ld   b, 25
 215  8A25              .death_pause:
 216  8A25 76               halt
 217  8A26 10 FD            djnz .death_pause
 218  8A28
 219  8A28                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 220  8A28 AF               xor  a
 221  8A29 32 48 F7         ld   (velocity_y), a
 222  8A2C 32 4A F7         ld   (jump_pressed), a
 223  8A2F 32 4C F7         ld   (coyote_timer), a
 224  8A32 32 4F F7         ld   (jump_frame), a
 225  8A35 32 4E F7         ld   (jump_dir), a
 226  8A38 3E 01            ld   a, 1
 227  8A3A 32 49 F7         ld   (on_ground), a
 228  8A3D
 229  8A3D 3E 00            ld   a, RESPAWN_SAFETY_TIME
 230  8A3F 32 44 FB         ld   (willy_safety_timer), a
 231  8A42
 232  8A42                  ; 5. Riposiziona Willy nel punto di ingresso dell'ultima stanza raggiunta
 233  8A42 CD 7D 82         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 234  8A45 21 C1 FA         ld   hl, room_entry_positions
 235  8A48 5F               ld   e, a
 236  8A49 16 00            ld   d, 0
 237  8A4B 19               add  hl, de
 238  8A4C 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 239  8A4D 4E               ld   c, (hl)                   ; C = X ingresso
 240  8A4E 23               inc  hl
 241  8A4F 46               ld   b, (hl)                   ; B = Y ingresso
 242  8A50 ED 43 3A F7      ld   (PlayerPos), bc           ; Imposta le coordinate di respawn al punto di ingresso
 243  8A54 ED 43 3C F7      ld   (PlayerPosOld), bc
 244  8A58
 245  8A58 3E 01            ld   a, 1
 246  8A5A 32 C0 FA         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 247  8A5D
 248  8A5D                  ; 6. Ridisegna completamente la stanza e riposiziona Willy nel punto di ingresso
 249  8A5D C3 5E 89         jp   LoadRoomAndRestart
