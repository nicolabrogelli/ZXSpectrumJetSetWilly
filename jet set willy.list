 316  82DC 32 2C E6         ld   (body_state), a
 317  82DF 32 3F E6         ld   (w_warp_state), a
 318  82E2 32 42 E6         ld   (w_key_prev), a
 319  82E5 32 43 E6         ld   (enter_key_prev), a
 320  82E8 32 34 E6         ld   (velocity_y), a
 321  82EB 32 36 E6         ld   (jump_pressed), a
 322  82EE 32 38 E6         ld   (coyote_timer), a
 323  82F1 32 3B E6         ld   (jump_frame), a
 324  82F4 32 3A E6         ld   (jump_dir), a
 325  82F7 32 AC E9         ld   (transition_active), a
 326  82FA 32 30 EA         ld   (willy_safety_timer), a
 327  82FD 3E FF            ld   a, $ff
 328  82FF 32 44 E6         ld   (digit_key_prev), a
 329  8302 3E 01            ld   a, 1
 330  8304 32 3D E6         ld   (q_prev), a
 331  8307 32 3E E6         ld   (a_prev), a
 332  830A 32 35 E6         ld   (on_ground), a
 333  830D
 334  830D                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 335  830D 3E 30            ld   a, '0'
 336  830F 32 1A 63         ld   (status_line + 16), a
 337  8312 32 1B 63         ld   (status_line + 17), a
 338  8315 32 1C 63         ld   (status_line + 18), a
 339  8318
