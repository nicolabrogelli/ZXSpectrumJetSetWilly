 319+ 79C6              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 320+ 79C6              ; -------------------------------------------------------------------
 321+ 79C6              CheckEnemyWillyOverlap:
 322+ 79C6 3A 85 EE         ld   a, (player_drawn_pos+1)
 323+ 79C9 FE FF            cp   $FF
 324+ 79CB C8               ret  z                  ; Se Willy non è disegnato, esci
 325+ 79CC
 326+ 79CC                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 327+ 79CC 3A 84 EE         ld   a, (player_drawn_pos)
 328+ 79CF E6 F8            and  $F8
 329+ 79D1 5F               ld   e, a               ; E = WillyX & $F8
 330+ 79D2 79               ld   a, c
 331+ 79D3 E6 F8            and  $F8                ; A = EnemyX & $F8
 332+ 79D5 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 333+ 79D6 C6 10            add  a, 16
 334+ 79D8 FE 19            cp   25
 335+ 79DA D0               ret  nc                 ; Fuori portata X
 336+ 79DB
 337+ 79DB                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 338+ 79DB 3A 85 EE         ld   a, (player_drawn_pos+1) ; A = WillyY
 339+ 79DE 90               sub  b                  ; A = WillyY - EnemyY
 340+ 79DF C6 0F            add  a, 15
 341+ 79E1 FE 1F            cp   31
 342+ 79E3 D0               ret  nc                 ; Fuori portata Y
 343+ 79E4
 344+ 79E4                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 345+ 79E4 3E 01            ld   a, 1
 346+ 79E6 32 8A EE         ld   (willy_needs_redraw), a
 347+ 79E9 C9               ret
