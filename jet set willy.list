 840+ 7950
 841+ 7950              ; -------------------------------------------------------------------
 842+ 7950              ; Items_DrawRoom
 843+ 7950              ;
 844+ 7950              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 845+ 7950              ;
 846+ 7950              ; Operazioni eseguite:
 847+ 7950              ;   1. Azzera la griglia items_grid.
 848+ 7950              ;   2. Svuota la cache degli oggetti attivi.
 849+ 7950              ;   3. Scansiona ItemsTable.
 850+ 7950              ;   4. Per ogni item della stanza corrente:
 851+ 7950              ;        - verifica se è già stato raccolto
 852+ 7950              ;        - disegna la grafica
 853+ 7950              ;        - aggiorna items_grid
 854+ 7950              ;        - memorizza l'item nella cache current_room_items
 855+ 7950              ;   5. Aggiorna num_room_items.
 856+ 7950              ;
 857+ 7950              ; Record ItemsTable:
 858+ 7950              ;   +0  Room ID
 859+ 7950              ;   +1  X (colonna)
 860+ 7950              ;   +2  Y (riga)
 861+ 7950              ;   +3  Colore
 862+ 7950              ;   +4  Collected flag
 863+ 7950              ;
 864+ 7950              ; Cache current_room_items:
 865+ 7950              ;   +0  Colonna
 866+ 7950              ;   +1  Riga
 867+ 7950              ;   +2  Colore
 868+ 7950              ;   +3  Collected flag ptr (Low)
 869+ 7950              ;   +4  Collected flag ptr (High)
 870+ 7950              ;
 871+ 7950              ; Ogni record cache occupa 5 byte.
 872+ 7950              ; -------------------------------------------------------------------
 873+ 7950              Items_DrawRoom:
 874+ 7950
 875+ 7950                  ; Salva tutti i registri utilizzati
 876+ 7950 E5               push hl
 877+ 7951 D5               push de
 878+ 7952 C5               push bc
 879+ 7953 DD E5            push ix
 880+ 7955 FD E5            push iy
 881+ 7957
 882+ 7957                  ; ---------------------------------------------------------------
 883+ 7957                  ; Azzera items_grid (32 x 16 = 512 byte)
 884+ 7957                  ; ---------------------------------------------------------------
 885+ 7957 21 A0 D5         ld   hl, items_grid
 886+ 795A 11 A1 D5         ld   de, items_grid + 1
 887+ 795D 36 00            ld   (hl), 0
 888+ 795F 01 FF 01         ld   bc, 511
 889+ 7962 ED B0            ldir
 890+ 7964
 891+ 7964                  ; ---------------------------------------------------------------
 892+ 7964                  ; Nessun item attivo nella stanza
 893+ 7964                  ; ---------------------------------------------------------------
 894+ 7964 AF               xor  a
 895+ 7965 32 F9 7E         ld   (num_room_items), a
 896+ 7968
 897+ 7968                  ; IY punta alla cache degli item attivi
 898+ 7968 FD 21 A9 7E      ld   iy, current_room_items
 899+ 796C
 900+ 796C                  ; ---------------------------------------------------------------
 901+ 796C                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 902+ 796C                  ; alla stanza corrente.
 903+ 796C                  ;
 904+ 796C                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 905+ 796C                  ; ---------------------------------------------------------------
 906+ 796C 2A FA 7E         ld   hl, (room_ptr)
 907+ 796F 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 908+ 7972 19               add  hl, de
 909+ 7973
 910+ 7973 E5               push hl
 911+ 7974 DD E1            pop  ix                ; IX = bitmap item
 912+ 7976
 913+ 7976                  ; ---------------------------------------------------------------
 914+ 7976                  ; Inizio scansione della tabella degli item
 915+ 7976                  ; ---------------------------------------------------------------
 916+ 7976 21 57 75         ld   hl, ItemsTable
 917+ 7979
 918+ 7979              .loop:
 919+ 7979
 920+ 7979                  ; ---------------------------------------------------------------
 921+ 7979                  ; Legge il Room ID del record corrente
 922+ 7979                  ; ---------------------------------------------------------------
 923+ 7979 7E               ld   a, (hl)
 924+ 797A
 925+ 797A                  ; $FF indica fine tabella
 926+ 797A FE FF            cp   $FF
 927+ 797C 28 53            jr   z, .done
 928+ 797E
 929+ 797E                  ; ---------------------------------------------------------------
 930+ 797E                  ; Verifica se l'item appartiene alla stanza corrente
 931+ 797E                  ; ---------------------------------------------------------------
 932+ 797E 57               ld   d, a
 933+ 797F
 934+ 797F 3A A0 7E         ld   a, (current_room)
 935+ 7982 BA               cp   d
 936+ 7983 20 45            jr   nz, .next_item
 937+ 7985
 938+ 7985                  ; ---------------------------------------------------------------
 939+ 7985                  ; Legge i dati dell'item
 940+ 7985                  ; ---------------------------------------------------------------
 941+ 7985
 942+ 7985 23               inc  hl
 943+ 7986 4E               ld   c, (hl)           ; X (colonna)
 944+ 7987
 945+ 7987 23               inc  hl
 946+ 7988 46               ld   b, (hl)           ; Y (riga)
 947+ 7989
 948+ 7989 23               inc  hl
 949+ 798A 5E               ld   e, (hl)           ; Colore
 950+ 798B
 951+ 798B 23               inc  hl
 952+ 798C 7E               ld   a, (hl)           ; Collected flag
 953+ 798D
 954+ 798D                  ; Se diverso da zero l'item è già stato raccolto
 955+ 798D B7               or   a
 956+ 798E 20 3E            jr   nz, .next_no_inc
 957+ 7990
 958+ 7990                  ; ---------------------------------------------------------------
 959+ 7990                  ; Disegna l'item sullo schermo
 960+ 7990                  ;
 961+ 7990                  ; B = Row
 962+ 7990                  ; C = Column
 963+ 7990                  ; HL = bitmap pointer
 964+ 7990                  ; E = Color
 965+ 7990                  ; ---------------------------------------------------------------
 966+ 7990 E5               push hl
 967+ 7991
 968+ 7991 DD E5            push ix
 969+ 7993 E1               pop  hl
 970+ 7994
 971+ 7994 CD D9 79         call DrawItemGraphic
 972+ 7997
 973+ 7997 E1               pop  hl                ; ritorna al flag collected
 974+ 7998
 975+ 7998                  ; ---------------------------------------------------------------
 976+ 7998                  ; Aggiorna items_grid
 977+ 7998                  ;
 978+ 7998                  ; Calcolo:
 979+ 7998                  ;   offset = Row * 32 + Col
 980+ 7998                  ; ---------------------------------------------------------------
 981+ 7998 E5               push hl
 982+ 7999 D5               push de
 983+ 799A
 984+ 799A 26 00            ld   h, 0
 985+ 799C 68               ld   l, b              ; HL = Row
 986+ 799D
 987+ 799D 29               add  hl, hl            ; *2
 988+ 799E 29               add  hl, hl            ; *4
 989+ 799F 29               add  hl, hl            ; *8
 990+ 79A0 29               add  hl, hl            ; *16
 991+ 79A1 29               add  hl, hl            ; *32
 992+ 79A2
 993+ 79A2 16 00            ld   d, 0
 994+ 79A4 59               ld   e, c              ; DE = Col
 995+ 79A5
 996+ 79A5 19               add  hl, de            ; Row*32 + Col
 997+ 79A6
 998+ 79A6 11 A0 D5         ld   de, items_grid
 999+ 79A9 19               add  hl, de            ; puntatore nella griglia
1000+ 79AA
1001+ 79AA D1               pop  de                ; ripristina colore
1002+ 79AB
1003+ 79AB 73               ld   (hl), e           ; salva colore cella
1004+ 79AC
1005+ 79AC E1               pop  hl
1006+ 79AD
1007+ 79AD                  ; ---------------------------------------------------------------
1008+ 79AD                  ; Salva l'item nella cache della stanza
1009+ 79AD                  ;
1010+ 79AD                  ; Questo evita di dover scansionare tutta ItemsTable
1011+ 79AD                  ; durante il controllo delle collisioni.
1012+ 79AD                  ; ---------------------------------------------------------------
1013+ 79AD
1014+ 79AD FD 71 00         ld   (iy+0), c         ; Colonna
1015+ 79B0 FD 70 01         ld   (iy+1), b         ; Riga
1016+ 79B3 FD 73 02         ld   (iy+2), e         ; Colore
1017+ 79B6
1018+ 79B6                  ; Salva il puntatore al flag "collected"
1019+ 79B6 FD 75 03         ld   (iy+3), l         ; Low byte
1020+ 79B9 FD 74 04         ld   (iy+4), h         ; High byte
1021+ 79BC
1022+ 79BC                  ; Passa al record successivo della cache
1023+ 79BC 01 05 00         ld   bc, 5
1024+ 79BF FD 09            add  iy, bc
1025+ 79C1
1026+ 79C1                  ; Incrementa il numero di item attivi
1027+ 79C1 3A F9 7E         ld   a, (num_room_items)
1028+ 79C4 3C               inc  a
1029+ 79C5 32 F9 7E         ld   (num_room_items), a
1030+ 79C8
1031+ 79C8 18 04            jr   .next_no_inc
1032+ 79CA
1033+ 79CA              .next_item:
1034+ 79CA
1035+ 79CA                  ; ---------------------------------------------------------------
1036+ 79CA                  ; L'item non appartiene alla stanza corrente.
1037+ 79CA                  ; Salta i campi del record:
1038+ 79CA                  ;   X
1039+ 79CA                  ;   Y
1040+ 79CA                  ;   Color
1041+ 79CA                  ;   Collected
1042+ 79CA                  ; ---------------------------------------------------------------
1043+ 79CA 23               inc  hl
1044+ 79CB 23               inc  hl
1045+ 79CC 23               inc  hl
1046+ 79CD 23               inc  hl
1047+ 79CE
1048+ 79CE              .next_no_inc:
1049+ 79CE
1050+ 79CE                  ; ---------------------------------------------------------------
1051+ 79CE                  ; Avanza al record successivo
1052+ 79CE                  ; (prossimo Room ID)
1053+ 79CE                  ; ---------------------------------------------------------------
1054+ 79CE 23               inc  hl
1055+ 79CF 18 A8            jr   .loop
1056+ 79D1
1057+ 79D1              .done:
1058+ 79D1
1059+ 79D1                  ; Ripristina i registri
1060+ 79D1 FD E1            pop  iy
1061+ 79D3 DD E1            pop  ix
1062+ 79D5 D1               pop  de
1063+ 79D6 C1               pop  bc
1064+ 79D7 E1               pop  hl
1065+ 79D8
1066+ 79D8 C9               ret
1067+ 79D9
1068+ 79D9              ; -------------------------------------------------------------------
1069+ 79D9              ; DrawItemGraphic
1070+ 79D9              ;
1071+ 79D9              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1072+ 79D9              ; utilizzando una bitmap di 8 byte e un attributo colore.
1073+ 79D9              ;
1074+ 79D9              ; Input:
1075+ 79D9              ;   B = Riga attributi (3..18)
1076+ 79D9              ;   C = Colonna attributi (0..31)
1077+ 79D9              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1078+ 79D9              ;   E = Attributo colore
1079+ 79D9              ;
1080+ 79D9              ; Output:
1081+ 79D9              ;   Nessuno
1082+ 79D9              ;
1083+ 79D9              ; Registri preservati:
1084+ 79D9              ;   BC, DE, HL
1085+ 79D9              ; -------------------------------------------------------------------
1086+ 79D9              DrawItemGraphic:
1087+ 79D9
1088+ 79D9                  ; Salva i registri originali
1089+ 79D9 C5               push bc
1090+ 79DA D5               push de
1091+ 79DB E5               push hl
1092+ 79DC
1093+ 79DC                  ; ---------------------------------------------------------------
1094+ 79DC                  ; Calcolo indirizzo bitmap dello Spectrum
1095+ 79DC                  ;
1096+ 79DC                  ; Ogni item occupa una cella attributi (8x8 pixel).
1097+ 79DC                  ;
1098+ 79DC                  ; Formula:
1099+ 79DC                  ;   High = $40 + (Row AND $18)
1100+ 79DC                  ;   Low  = (Row AND 7) * 32 + Col
1101+ 79DC                  ;
1102+ 79DC                  ; DE conterrà l'indirizzo della prima scanline.
1103+ 79DC                  ; ---------------------------------------------------------------
1104+ 79DC
1105+ 79DC 78               ld   a, b
1106+ 79DD E6 18            and  $18
1107+ 79DF C6 40            add  a, $40
1108+ 79E1 57               ld   d, a              ; Byte alto indirizzo video
1109+ 79E2
1110+ 79E2 78               ld   a, b
1111+ 79E3 E6 07            and  7                 ; Riga interna al blocco da 8
1112+ 79E5
1113+ 79E5 87               add  a, a              ; *2
1114+ 79E6 87               add  a, a              ; *4
1115+ 79E7 87               add  a, a              ; *8
1116+ 79E8 87               add  a, a              ; *16
1117+ 79E9 87               add  a, a              ; *32
1118+ 79EA
1119+ 79EA 81               add  a, c              ; + colonna
1120+ 79EB
1121+ 79EB 5F               ld   e, a              ; Byte basso indirizzo video
1122+ 79EC
1123+ 79EC                  ; ---------------------------------------------------------------
1124+ 79EC                  ; Disegno bitmap
1125+ 79EC                  ;
1126+ 79EC                  ; Copia 8 byte consecutivi nella memoria video.
1127+ 79EC                  ; Ogni byte rappresenta una scanline da 8 pixel.
1128+ 79EC                  ; ---------------------------------------------------------------
1129+ 79EC
1130+ 79EC C5               push bc                ; Conserva Row e Col
1131+ 79ED
1132+ 79ED 06 08            ld   b, 8              ; Numero scanline
1133+ 79EF
1134+ 79EF              .line_loop:
1135+ 79EF
1136+ 79EF 7E               ld   a, (hl)           ; Legge scanline bitmap
1137+ 79F0 12               ld   (de), a           ; Scrive nella memoria video
1138+ 79F1
1139+ 79F1 14               inc  d                 ; Scanline successiva
1140+ 79F2 23               inc  hl                ; Byte bitmap successivo
1141+ 79F3
1142+ 79F3 05               dec  b
1143+ 79F4 20 F9            jr   nz, .line_loop
1144+ 79F6
1145+ 79F6 C1               pop  bc                ; Ripristina Row e Col
1146+ 79F7
1147+ 79F7                  ; ---------------------------------------------------------------
1148+ 79F7                  ; Calcolo indirizzo attributo
1149+ 79F7                  ;
1150+ 79F7                  ; Formula:
1151+ 79F7                  ;   AttrAddr = $5800 + Row * 32 + Col
1152+ 79F7                  ;
1153+ 79F7                  ; HL conterrà l'indirizzo della cella attributi.
1154+ 79F7                  ; ---------------------------------------------------------------
1155+ 79F7
1156+ 79F7 26 00            ld   h, 0
1157+ 79F9 68               ld   l, b              ; HL = Row
1158+ 79FA
1159+ 79FA 29               add  hl, hl            ; *2
1160+ 79FB 29               add  hl, hl            ; *4
1161+ 79FC 29               add  hl, hl            ; *8
1162+ 79FD 29               add  hl, hl            ; *16
1163+ 79FE 29               add  hl, hl            ; *32
1164+ 79FF
1165+ 79FF 79               ld   a, c              ; A = Colonna
1166+ 7A00
1167+ 7A00 85               add  a, l
1168+ 7A01 6F               ld   l, a
1169+ 7A02
1170+ 7A02 30 01            jr   nc, .no_carry
1171+ 7A04 24               inc  h
1172+ 7A05
1173+ 7A05              .no_carry:
1174+ 7A05
1175+ 7A05                  ; HL = Row * 32 + Col
1176+ 7A05
1177+ 7A05 11 00 58         ld   de, $5800
1178+ 7A08 19               add  hl, de            ; HL = indirizzo attributi
1179+ 7A09
1180+ 7A09                  ; ---------------------------------------------------------------
1181+ 7A09                  ; Recupera il colore originale dallo stack.
1182+ 7A09                  ;
1183+ 7A09                  ; Layout stack:
1184+ 7A09                  ;   HL originale
1185+ 7A09                  ;   DE originale (E = colore)
1186+ 7A09                  ;   BC originale
1187+ 7A09                  ; ---------------------------------------------------------------
1188+ 7A09
1189+ 7A09 C1               pop  bc                ; Recupera HL originale
1190+ 7A0A D1               pop  de                ; Recupera DE originale
1191+ 7A0B
1192+ 7A0B                  ; ---------------------------------------------------------------
1193+ 7A0B                  ; Scrive l'attributo colore
1194+ 7A0B                  ; ---------------------------------------------------------------
