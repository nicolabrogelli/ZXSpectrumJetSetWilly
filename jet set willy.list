1075+ 8035              ; -------------------------------------------------------------------
1076+ 8035              ; Items_DrawRoom
1077+ 8035              ;
1078+ 8035              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1079+ 8035              ;
1080+ 8035              ; Operazioni eseguite:
1081+ 8035              ;   1. Azzera la griglia items_grid.
1082+ 8035              ;   2. Svuota la cache degli oggetti attivi.
1083+ 8035              ;   3. Scansiona ItemsTable.
1084+ 8035              ;   4. Per ogni item della stanza corrente:
1085+ 8035              ;        - verifica se è già stato raccolto
1086+ 8035              ;        - disegna la grafica
1087+ 8035              ;        - aggiorna items_grid
1088+ 8035              ;        - memorizza l'item nella cache current_room_items
1089+ 8035              ;   5. Aggiorna num_room_items.
1090+ 8035              ;
1091+ 8035              ; Record ItemsTable:
1092+ 8035              ;   +0  Room ID
1093+ 8035              ;   +1  X (colonna)
1094+ 8035              ;   +2  Y (riga)
1095+ 8035              ;   +3  Colore
1096+ 8035              ;   +4  Collected flag
1097+ 8035              ;
1098+ 8035              ; Cache current_room_items:
1099+ 8035              ;   +0  Colonna
1100+ 8035              ;   +1  Riga
1101+ 8035              ;   +2  Colore
1102+ 8035              ;   +3  Collected flag ptr (Low)
1103+ 8035              ;   +4  Collected flag ptr (High)
1104+ 8035              ;
1105+ 8035              ; Ogni record cache occupa 5 byte.
1106+ 8035              ; -------------------------------------------------------------------
1107+ 8035              ; ResetItemsTable
1108+ 8035              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1109+ 8035              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1110+ 8035              ; -------------------------------------------------------------------
1111+ 8035              ResetItemsTable:
1112+ 8035 21 DE 7A         ld   hl, ItemsTable
1113+ 8038              .reset_loop:
1114+ 8038 7E               ld   a, (hl)
1115+ 8039 FE FF            cp   $FF
1116+ 803B C8               ret  z
1117+ 803C 23               inc  hl                        ; +1 (X)
1118+ 803D 23               inc  hl                        ; +2 (Y)
1119+ 803E 23               inc  hl                        ; +3 (Color)
1120+ 803F 23               inc  hl                        ; +4 (Collected flag)
1121+ 8040 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1122+ 8042 23               inc  hl                        ; Prossimo record
1123+ 8043 18 F3            jr   .reset_loop
1124+ 8045
1125+ 8045              ; -------------------------------------------------------------------
1126+ 8045              Items_DrawRoom:
1127+ 8045
1128+ 8045                  ; Salva tutti i registri utilizzati
1129+ 8045 E5               push hl
1130+ 8046 D5               push de
1131+ 8047 C5               push bc
1132+ 8048 DD E5            push ix
1133+ 804A FD E5            push iy
1134+ 804C
1135+ 804C                  ; ---------------------------------------------------------------
1136+ 804C                  ; Azzera items_grid (32 x 16 = 512 byte)
1137+ 804C                  ; ---------------------------------------------------------------
1138+ 804C 21 E0 E4         ld   hl, items_grid
1139+ 804F 11 E1 E4         ld   de, items_grid + 1
1140+ 8052 36 00            ld   (hl), 0
1141+ 8054 01 FF 01         ld   bc, 511
1142+ 8057 ED B0            ldir
1143+ 8059
1144+ 8059                  ; ---------------------------------------------------------------
1145+ 8059                  ; Nessun item attivo nella stanza
1146+ 8059                  ; ---------------------------------------------------------------
1147+ 8059 AF               xor  a
1148+ 805A 32 5F EA         ld   (num_room_items), a
1149+ 805D
1150+ 805D                  ; IY punta alla cache degli item attivi
1151+ 805D FD 21 0F EA      ld   iy, current_room_items
1152+ 8061
1153+ 8061                  ; ---------------------------------------------------------------
1154+ 8061                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1155+ 8061                  ; alla stanza corrente.
1156+ 8061                  ;
1157+ 8061                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1158+ 8061                  ; ---------------------------------------------------------------
1159+ 8061 2A 60 EA         ld   hl, (room_ptr)
1160+ 8064 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1161+ 8067 19               add  hl, de
1162+ 8068
1163+ 8068 E5               push hl
1164+ 8069 DD E1            pop  ix                ; IX = bitmap item
1165+ 806B
1166+ 806B                  ; ---------------------------------------------------------------
1167+ 806B                  ; Inizio scansione della tabella degli item
1168+ 806B                  ; ---------------------------------------------------------------
1169+ 806B 21 DE 7A         ld   hl, ItemsTable
1170+ 806E
1171+ 806E              .loop:
1172+ 806E
1173+ 806E                  ; ---------------------------------------------------------------
1174+ 806E                  ; Legge il Room ID del record corrente
1175+ 806E                  ; ---------------------------------------------------------------
1176+ 806E 7E               ld   a, (hl)
1177+ 806F
1178+ 806F                  ; $FF indica fine tabella
1179+ 806F FE FF            cp   $FF
1180+ 8071 28 53            jr   z, .done
1181+ 8073
1182+ 8073                  ; ---------------------------------------------------------------
1183+ 8073                  ; Verifica se l'item appartiene alla stanza corrente
1184+ 8073                  ; ---------------------------------------------------------------
1185+ 8073 57               ld   d, a
1186+ 8074
1187+ 8074 3A 06 EA         ld   a, (current_room)
1188+ 8077 BA               cp   d
1189+ 8078 20 45            jr   nz, .next_item
1190+ 807A
1191+ 807A                  ; ---------------------------------------------------------------
1192+ 807A                  ; Legge i dati dell'item
1193+ 807A                  ; ---------------------------------------------------------------
1194+ 807A
1195+ 807A 23               inc  hl
1196+ 807B 4E               ld   c, (hl)           ; X (colonna)
1197+ 807C
1198+ 807C 23               inc  hl
1199+ 807D 46               ld   b, (hl)           ; Y (riga)
1200+ 807E
1201+ 807E 23               inc  hl
1202+ 807F 5E               ld   e, (hl)           ; Colore
1203+ 8080
1204+ 8080 23               inc  hl
1205+ 8081 7E               ld   a, (hl)           ; Collected flag
1206+ 8082
1207+ 8082                  ; Se diverso da zero l'item è già stato raccolto
1208+ 8082 B7               or   a
1209+ 8083 20 3E            jr   nz, .next_no_inc
1210+ 8085
1211+ 8085                  ; ---------------------------------------------------------------
1212+ 8085                  ; Disegna l'item sullo schermo
1213+ 8085                  ;
1214+ 8085                  ; B = Row
1215+ 8085                  ; C = Column
1216+ 8085                  ; HL = bitmap pointer
1217+ 8085                  ; E = Color
1218+ 8085                  ; ---------------------------------------------------------------
1219+ 8085 E5               push hl
1220+ 8086
1221+ 8086 DD E5            push ix
1222+ 8088 E1               pop  hl
1223+ 8089
1224+ 8089 CD CE 80         call DrawItemGraphic
1225+ 808C
1226+ 808C E1               pop  hl                ; ritorna al flag collected
1227+ 808D
1228+ 808D                  ; ---------------------------------------------------------------
1229+ 808D                  ; Aggiorna items_grid
1230+ 808D                  ;
1231+ 808D                  ; Calcolo:
1232+ 808D                  ;   offset = Row * 32 + Col
1233+ 808D                  ; ---------------------------------------------------------------
1234+ 808D E5               push hl
1235+ 808E D5               push de
1236+ 808F
1237+ 808F 26 00            ld   h, 0
1238+ 8091 68               ld   l, b              ; HL = Row
1239+ 8092
1240+ 8092 29               add  hl, hl            ; *2
1241+ 8093 29               add  hl, hl            ; *4
1242+ 8094 29               add  hl, hl            ; *8
1243+ 8095 29               add  hl, hl            ; *16
1244+ 8096 29               add  hl, hl            ; *32
1245+ 8097
1246+ 8097 16 00            ld   d, 0
1247+ 8099 59               ld   e, c              ; DE = Col
1248+ 809A
1249+ 809A 19               add  hl, de            ; Row*32 + Col
1250+ 809B
1251+ 809B 11 E0 E4         ld   de, items_grid
1252+ 809E 19               add  hl, de            ; puntatore nella griglia
1253+ 809F
1254+ 809F D1               pop  de                ; ripristina colore
1255+ 80A0
1256+ 80A0 73               ld   (hl), e           ; salva colore cella
1257+ 80A1
1258+ 80A1 E1               pop  hl
1259+ 80A2
1260+ 80A2                  ; ---------------------------------------------------------------
1261+ 80A2                  ; Salva l'item nella cache della stanza
1262+ 80A2                  ;
1263+ 80A2                  ; Questo evita di dover scansionare tutta ItemsTable
1264+ 80A2                  ; durante il controllo delle collisioni.
1265+ 80A2                  ; ---------------------------------------------------------------
1266+ 80A2
1267+ 80A2 FD 71 00         ld   (iy+0), c         ; Colonna
1268+ 80A5 FD 70 01         ld   (iy+1), b         ; Riga
1269+ 80A8 FD 73 02         ld   (iy+2), e         ; Colore
1270+ 80AB
1271+ 80AB                  ; Salva il puntatore al flag "collected"
1272+ 80AB FD 75 03         ld   (iy+3), l         ; Low byte
1273+ 80AE FD 74 04         ld   (iy+4), h         ; High byte
1274+ 80B1
1275+ 80B1                  ; Passa al record successivo della cache
1276+ 80B1 01 05 00         ld   bc, 5
1277+ 80B4 FD 09            add  iy, bc
1278+ 80B6
1279+ 80B6                  ; Incrementa il numero di item attivi
1280+ 80B6 3A 5F EA         ld   a, (num_room_items)
1281+ 80B9 3C               inc  a
1282+ 80BA 32 5F EA         ld   (num_room_items), a
1283+ 80BD
1284+ 80BD 18 04            jr   .next_no_inc
1285+ 80BF
1286+ 80BF              .next_item:
1287+ 80BF
1288+ 80BF                  ; ---------------------------------------------------------------
1289+ 80BF                  ; L'item non appartiene alla stanza corrente.
1290+ 80BF                  ; Salta i campi del record:
1291+ 80BF                  ;   X
1292+ 80BF                  ;   Y
1293+ 80BF                  ;   Color
1294+ 80BF                  ;   Collected
1295+ 80BF                  ; ---------------------------------------------------------------
1296+ 80BF 23               inc  hl
1297+ 80C0 23               inc  hl
1298+ 80C1 23               inc  hl
1299+ 80C2 23               inc  hl
1300+ 80C3
1301+ 80C3              .next_no_inc:
1302+ 80C3
1303+ 80C3                  ; ---------------------------------------------------------------
1304+ 80C3                  ; Avanza al record successivo
1305+ 80C3                  ; (prossimo Room ID)
1306+ 80C3                  ; ---------------------------------------------------------------
1307+ 80C3 23               inc  hl
1308+ 80C4 18 A8            jr   .loop
1309+ 80C6
1310+ 80C6              .done:
1311+ 80C6
1312+ 80C6                  ; Ripristina i registri
1313+ 80C6 FD E1            pop  iy
1314+ 80C8 DD E1            pop  ix
1315+ 80CA D1               pop  de
1316+ 80CB C1               pop  bc
1317+ 80CC E1               pop  hl
1318+ 80CD
1319+ 80CD C9               ret
1320+ 80CE
1321+ 80CE              ; -------------------------------------------------------------------
1322+ 80CE              ; DrawItemGraphic
1323+ 80CE              ;
1324+ 80CE              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1325+ 80CE              ; utilizzando una bitmap di 8 byte e un attributo colore.
1326+ 80CE              ;
1327+ 80CE              ; Input:
1328+ 80CE              ;   B = Riga attributi (3..18)
1329+ 80CE              ;   C = Colonna attributi (0..31)
1330+ 80CE              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1331+ 80CE              ;   E = Attributo colore
1332+ 80CE              ;
1333+ 80CE              ; Output:
1334+ 80CE              ;   Nessuno
1335+ 80CE              ;
1336+ 80CE              ; Registri preservati:
1337+ 80CE              ;   BC, DE, HL
1338+ 80CE              ; -------------------------------------------------------------------
1339+ 80CE              DrawItemGraphic:
1340+ 80CE
1341+ 80CE                  ; Salva i registri originali
1342+ 80CE C5               push bc
1343+ 80CF D5               push de
1344+ 80D0 E5               push hl
1345+ 80D1
1346+ 80D1                  ; ---------------------------------------------------------------
1347+ 80D1                  ; Calcolo indirizzo bitmap dello Spectrum
1348+ 80D1                  ;
1349+ 80D1                  ; Ogni item occupa una cella attributi (8x8 pixel).
1350+ 80D1                  ;
1351+ 80D1                  ; Formula:
1352+ 80D1                  ;   High = $40 + (Row AND $18)
1353+ 80D1                  ;   Low  = (Row AND 7) * 32 + Col
1354+ 80D1                  ;
1355+ 80D1                  ; DE conterrà l'indirizzo della prima scanline.
1356+ 80D1                  ; ---------------------------------------------------------------
1357+ 80D1
1358+ 80D1 78               ld   a, b
1359+ 80D2 E6 18            and  $18
1360+ 80D4 C6 40            add  a, $40
1361+ 80D6 57               ld   d, a              ; Byte alto indirizzo video
1362+ 80D7
1363+ 80D7 78               ld   a, b
1364+ 80D8 E6 07            and  7                 ; Riga interna al blocco da 8
1365+ 80DA
1366+ 80DA 87               add  a, a              ; *2
1367+ 80DB 87               add  a, a              ; *4
1368+ 80DC 87               add  a, a              ; *8
1369+ 80DD 87               add  a, a              ; *16
1370+ 80DE 87               add  a, a              ; *32
1371+ 80DF
1372+ 80DF 81               add  a, c              ; + colonna
1373+ 80E0
1374+ 80E0 5F               ld   e, a              ; Byte basso indirizzo video
1375+ 80E1
1376+ 80E1                  ; ---------------------------------------------------------------
1377+ 80E1                  ; Disegno bitmap
1378+ 80E1                  ;
1379+ 80E1                  ; Copia 8 byte consecutivi nella memoria video.
1380+ 80E1                  ; Ogni byte rappresenta una scanline da 8 pixel.
1381+ 80E1                  ; ---------------------------------------------------------------
1382+ 80E1
1383+ 80E1 C5               push bc                ; Conserva Row e Col
1384+ 80E2
1385+ 80E2 06 08            ld   b, 8              ; Numero scanline
1386+ 80E4
1387+ 80E4              .line_loop:
1388+ 80E4
1389+ 80E4 7E               ld   a, (hl)           ; Legge scanline bitmap
1390+ 80E5 12               ld   (de), a           ; Scrive nella memoria video
1391+ 80E6
1392+ 80E6 14               inc  d                 ; Scanline successiva
1393+ 80E7 23               inc  hl                ; Byte bitmap successivo
1394+ 80E8
1395+ 80E8 05               dec  b
1396+ 80E9 20 F9            jr   nz, .line_loop
1397+ 80EB
1398+ 80EB C1               pop  bc                ; Ripristina Row e Col
1399+ 80EC
1400+ 80EC                  ; ---------------------------------------------------------------
1401+ 80EC                  ; Calcolo indirizzo attributo
1402+ 80EC                  ;
1403+ 80EC                  ; Formula:
1404+ 80EC                  ;   AttrAddr = $5800 + Row * 32 + Col
1405+ 80EC                  ;
1406+ 80EC                  ; HL conterrà l'indirizzo della cella attributi.
1407+ 80EC                  ; ---------------------------------------------------------------
1408+ 80EC
1409+ 80EC 26 00            ld   h, 0
1410+ 80EE 68               ld   l, b              ; HL = Row
1411+ 80EF
1412+ 80EF 29               add  hl, hl            ; *2
1413+ 80F0 29               add  hl, hl            ; *4
1414+ 80F1 29               add  hl, hl            ; *8
1415+ 80F2 29               add  hl, hl            ; *16
1416+ 80F3 29               add  hl, hl            ; *32
1417+ 80F4
1418+ 80F4 79               ld   a, c              ; A = Colonna
1419+ 80F5
1420+ 80F5 85               add  a, l
1421+ 80F6 6F               ld   l, a
1422+ 80F7
1423+ 80F7 30 01            jr   nc, .no_carry
1424+ 80F9 24               inc  h
1425+ 80FA
1426+ 80FA              .no_carry:
1427+ 80FA
1428+ 80FA                  ; HL = Row * 32 + Col
1429+ 80FA
1430+ 80FA 11 00 58         ld   de, $5800
1431+ 80FD 19               add  hl, de            ; HL = indirizzo attributi
1432+ 80FE
1433+ 80FE                  ; ---------------------------------------------------------------
1434+ 80FE                  ; Recupera il colore originale dallo stack.
1435+ 80FE                  ;
1436+ 80FE                  ; Layout stack:
1437+ 80FE                  ;   HL originale
1438+ 80FE                  ;   DE originale (E = colore)
1439+ 80FE                  ;   BC originale
1440+ 80FE                  ; ---------------------------------------------------------------
1441+ 80FE
1442+ 80FE C1               pop  bc                ; Recupera HL originale
1443+ 80FF D1               pop  de                ; Recupera DE originale
1444+ 8100
1445+ 8100                  ; ---------------------------------------------------------------
1446+ 8100                  ; Scrive l'attributo colore
1447+ 8100                  ; ---------------------------------------------------------------
1448+ 8100
1449+ 8100 7B               ld   a, e              ; A = colore
1450+ 8101 77               ld   (hl), a           ; Scrive nella RAM attributi
1451+ 8102
1452+ 8102                  ; ---------------------------------------------------------------
1453+ 8102                  ; Ripristina HL e BC originali
1454+ 8102                  ; ---------------------------------------------------------------
1455+ 8102
1456+ 8102 C5               push bc
1457+ 8103 E1               pop  hl                ; HL originale
1458+ 8104
1459+ 8104 C1               pop  bc                ; BC originale
1460+ 8105
1461+ 8105 C9               ret
1462+ 8106
1463+ 8106              ; -------------------------------------------------------------------
1464+ 8106              ; RestoreBackgroundCell
1465+ 8106              ;
1466+ 8106              ; Ripristina il contenuto originale di una cella della stanza.
1467+ 8106              ; Viene utilizzata principalmente quando un item viene raccolto:
1468+ 8106              ; invece di lasciare un "buco", la routine ridisegna il tile
1469+ 8106              ; originale presente nella mappa della stanza.
1470+ 8106              ;
1471+ 8106              ; Input:
1472+ 8106              ;   B = Row (3..18)
1473+ 8106              ;   C = Col (0..31)
1474+ 8106              ;
1475+ 8106              ; Utilizza:
1476+ 8106              ;   room_ptr -> struttura dati della stanza corrente
1477+ 8106              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1478+ 8106              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1479+ 8106              ;
1480+ 8106              ; Tipi di cella:
1481+ 8106              ;   0 = Background
1482+ 8106              ;   1 = Floor
1483+ 8106              ;   2 = Wall
1484+ 8106              ;   3 = Nasty
1485+ 8106              ; -------------------------------------------------------------------
1486+ 8106              RestoreBackgroundCell:
1487+ 8106
1488+ 8106                  ; Salva tutti i registri utilizzati
1489+ 8106 FD E5            push iy
1490+ 8108 C5               push bc
1491+ 8109 D5               push de
1492+ 810A E5               push hl
1493+ 810B DD E5            push ix
1494+ 810D
1495+ 810D                  ; ---------------------------------------------------------------
1496+ 810D                  ; Conserva Row e Col in IY.
1497+ 810D                  ;
1498+ 810D                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1499+ 810D                  ; BC potrebbe essere modificato.
1500+ 810D                  ; ---------------------------------------------------------------
1501+ 810D C5               push bc
1502+ 810E FD E1            pop  iy                ; IYH = Row, IYL = Col
1503+ 8110
1504+ 8110                  ; ---------------------------------------------------------------
1505+ 8110                  ; Determina quale tipo di cella è presente nella posizione
1506+ 8110                  ; specificata.
1507+ 8110                  ;
1508+ 8110                  ; Input:
1509+ 8110                  ;   B = Row
1510+ 8110                  ;   C = Col
1511+ 8110                  ;
1512+ 8110                  ; Output:
1513+ 8110                  ;   A = tipo cella
1514+ 8110                  ; ---------------------------------------------------------------
1515+ 8110 78               ld   a, b
1516+ 8111
1517+ 8111 CD 37 72         call GetCellFromUnpacked
1518+ 8114
1519+ 8114                  ; ---------------------------------------------------------------
1520+ 8114                  ; Recupera il puntatore alla stanza corrente.
1521+ 8114                  ;
1522+ 8114                  ; DE = base della struttura stanza
1523+ 8114                  ; ---------------------------------------------------------------
1524+ 8114 ED 5B 60 EA      ld   de, (room_ptr)
1525+ 8118
1526+ 8118                  ; ---------------------------------------------------------------
1527+ 8118                  ; Seleziona il tile corretto in base al tipo di cella.
1528+ 8118                  ;
1529+ 8118                  ; A = 0 -> Background
1530+ 8118                  ; A = 1 -> Floor
1531+ 8118                  ; A = 2 -> Wall
1532+ 8118                  ; A = 3 -> Nasty
1533+ 8118                  ; ---------------------------------------------------------------
1534+ 8118
1535+ 8118 B7               or   a
1536+ 8119 20 06            jr   nz, .not_bg
1537+ 811B
1538+ 811B                  ; Background
1539+ 811B 21 A0 00         ld   hl, OFFSET_BG
1540+ 811E 19               add  hl, de
1541+ 811F 18 16            jr   .draw_cell
1542+ 8121
1543+ 8121              .not_bg:
1544+ 8121
1545+ 8121 3D               dec  a
1546+ 8122 20 06            jr   nz, .not_floor
1547+ 8124
1548+ 8124                  ; Floor
1549+ 8124 21 A9 00         ld   hl, OFFSET_FLOOR
1550+ 8127 19               add  hl, de
1551+ 8128 18 0D            jr   .draw_cell
1552+ 812A
1553+ 812A              .not_floor:
1554+ 812A
1555+ 812A 3D               dec  a
1556+ 812B 20 06            jr   nz, .not_wall
1557+ 812D
1558+ 812D                  ; Wall
1559+ 812D 21 B2 00         ld   hl, OFFSET_WALL
1560+ 8130 19               add  hl, de
1561+ 8131 18 04            jr   .draw_cell
1562+ 8133
1563+ 8133              .not_wall:
1564+ 8133
1565+ 8133                  ; Nasty
1566+ 8133 21 BB 00         ld   hl, OFFSET_NASTY
1567+ 8136 19               add  hl, de
1568+ 8137
1569+ 8137              .draw_cell:
1570+ 8137
1571+ 8137                  ; ---------------------------------------------------------------
1572+ 8137                  ; HL punta ora alla grafica del tile da ridisegnare.
1573+ 8137                  ;
1574+ 8137                  ; Gfx_DrawTile si aspetta:
1575+ 8137                  ;   IX = puntatore tile
1576+ 8137                  ;   B  = Row
1577+ 8137                  ;   C  = Col
1578+ 8137                  ; ---------------------------------------------------------------
1579+ 8137 E5               push hl
1580+ 8138 DD E1            pop  ix
1581+ 813A
1582+ 813A                  ; Ripristina Row e Col salvati in IY
1583+ 813A FD E5            push iy
1584+ 813C C1               pop  bc
1585+ 813D
1586+ 813D                  ; Disegna il tile originale
1587+ 813D CD 06 65         call Gfx_DrawTile
1588+ 8140
1589+ 8140                  ; ---------------------------------------------------------------
1590+ 8140                  ; Ripristina i registri salvati
1591+ 8140                  ; ---------------------------------------------------------------
1592+ 8140 DD E1            pop  ix
1593+ 8142 E1               pop  hl
1594+ 8143 D1               pop  de
1595+ 8144 C1               pop  bc
1596+ 8145 FD E1            pop  iy
1597+ 8147
1598+ 8147 C9               ret
1599+ 8148
1600+ 8148              ; -------------------------------------------------------------------
1601+ 8148              ; CheckWillyItemCollision
1602+ 8148              ;
1603+ 8148              ; Verifica se Willy collide con un item utilizzando il controllo
1604+ 8148              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1605+ 8148              ;
1606+ 8148              ; Input:
1607+ 8148              ;   A = ItemX (colonna attributi 0..31)
1608+ 8148              ;   H = ItemY (riga attributi 3..18)
1609+ 8148              ;
1610+ 8148              ; Coordinate item:
1611+ 8148              ;   Ogni item occupa una cella da 8x8 pixel.
1612+ 8148              ;
1613+ 8148              ; Coordinate Willy:
1614+ 8148              ;   Willy occupa un rettangolo di 16x16 pixel.
1615+ 8148              ;
1616+ 8148              ; Output:
1617+ 8148              ;   Carry Set   = collisione rilevata
1618+ 8148              ;   Carry Clear = nessuna collisione
1619+ 8148              ;
1620+ 8148              ; Registri preservati:
1621+ 8148              ;   BC, DE, HL
1622+ 8148              ; -------------------------------------------------------------------
1623+ 8148              CheckWillyItemCollision:
1624+ 8148
1625+ 8148                  ; Salva i registri utilizzati
1626+ 8148 C5               push bc
1627+ 8149 D5               push de
1628+ 814A E5               push hl
1629+ 814B
1630+ 814B                  ; ---------------------------------------------------------------
1631+ 814B                  ; Calcola il bounding box orizzontale dell'item
1632+ 814B                  ;
1633+ 814B                  ; ItemLeft  = ItemX * 8
1634+ 814B                  ; ItemRight = ItemLeft + 7
1635+ 814B                  ;
1636+ 814B                  ; E = ItemLeft
1637+ 814B                  ; D = ItemRight
1638+ 814B                  ; ---------------------------------------------------------------
1639+ 814B 6F               ld   l, a              ; L = ItemX
1640+ 814C
1641+ 814C 7D               ld   a, l
1642+ 814D 87               add  a, a              ; *2
1643+ 814E 87               add  a, a              ; *4
1644+ 814F 87               add  a, a              ; *8
1645+ 8150
1646+ 8150 5F               ld   e, a              ; E = ItemLeft
1647+ 8151
1648+ 8151 C6 07            add  a, 7
1649+ 8153 57               ld   d, a              ; D = ItemRight
1650+ 8154
1651+ 8154                  ; ---------------------------------------------------------------
1652+ 8154                  ; Recupera la posizione corrente di Willy
1653+ 8154                  ;
1654+ 8154                  ; B = WillyY
1655+ 8154                  ; C = WillyX
1656+ 8154                  ; ---------------------------------------------------------------
1657+ 8154 ED 4B E0 E6      ld   bc, (PlayerPos)
1658+ 8158
1659+ 8158                  ; ---------------------------------------------------------------
1660+ 8158                  ; Primo test:
1661+ 8158                  ;
1662+ 8158                  ; WillyLeft <= ItemRight
1663+ 8158                  ;
1664+ 8158                  ; Se Willy è completamente a destra dell'item
1665+ 8158                  ; non può esserci collisione.
1666+ 8158                  ; ---------------------------------------------------------------
1667+ 8158 79               ld   a, c              ; A = WillyLeft
1668+ 8159
1669+ 8159 BA               cp   d                 ; WillyLeft vs ItemRight
1670+ 815A
1671+ 815A 28 04            jr   z, .x_ok
1672+ 815C 38 02            jr   c, .x_ok
1673+ 815E
1674+ 815E 18 29            jr   .no_collision
1675+ 8160
1676+ 8160              .x_ok:
1677+ 8160
1678+ 8160                  ; ---------------------------------------------------------------
1679+ 8160                  ; Secondo test:
1680+ 8160                  ;
1681+ 8160                  ; WillyRight >= ItemLeft
1682+ 8160                  ;
1683+ 8160                  ; WillyRight = WillyX + 7
1684+ 8160                  ; ---------------------------------------------------------------
1685+ 8160 C6 07            add  a, 7
1686+ 8162
1687+ 8162 BB               cp   e                 ; WillyRight vs ItemLeft
1688+ 8163
1689+ 8163 28 04            jr   z, .y_check
1690+ 8165 30 02            jr   nc, .y_check
1691+ 8167
1692+ 8167 18 20            jr   .no_collision
1693+ 8169
1694+ 8169              .y_check:
1695+ 8169
1696+ 8169                  ; ---------------------------------------------------------------
1697+ 8169                  ; Recupera ItemY dal valore originale di HL
1698+ 8169                  ;
1699+ 8169                  ; H contiene la riga dell'item.
1700+ 8169                  ; ---------------------------------------------------------------
1701+ 8169 E1               pop  hl
1702+ 816A E5               push hl
1703+ 816B
1704+ 816B                  ; ---------------------------------------------------------------
1705+ 816B                  ; Calcola il bounding box verticale dell'item
1706+ 816B                  ;
1707+ 816B                  ; ItemTop    = ItemY * 8
1708+ 816B                  ; ItemBottom = ItemTop + 7
1709+ 816B                  ;
1710+ 816B                  ; E = ItemTop
1711+ 816B                  ; D = ItemBottom
1712+ 816B                  ; ---------------------------------------------------------------
1713+ 816B 7C               ld   a, h
1714+ 816C
1715+ 816C 87               add  a, a              ; *2
1716+ 816D 87               add  a, a              ; *4
1717+ 816E 87               add  a, a              ; *8
1718+ 816F
1719+ 816F 5F               ld   e, a              ; ItemTop
1720+ 8170
1721+ 8170 C6 07            add  a, 7
1722+ 8172 57               ld   d, a              ; ItemBottom
1723+ 8173
1724+ 8173                  ; ---------------------------------------------------------------
1725+ 8173                  ; Primo test verticale:
1726+ 8173                  ;
1727+ 8173                  ; WillyTop <= ItemBottom
1728+ 8173                  ; ---------------------------------------------------------------
1729+ 8173 78               ld   a, b              ; WillyTop
1730+ 8174
1731+ 8174 BA               cp   d
1732+ 8175
1733+ 8175 28 04            jr   z, .y_ok
1734+ 8177 38 02            jr   c, .y_ok
1735+ 8179
1736+ 8179 18 0E            jr   .no_collision
1737+ 817B
1738+ 817B              .y_ok:
1739+ 817B
1740+ 817B                  ; ---------------------------------------------------------------
1741+ 817B                  ; Secondo test verticale:
1742+ 817B                  ;
1743+ 817B                  ; WillyBottom >= ItemTop
1744+ 817B                  ;
1745+ 817B                  ; WillyBottom = WillyY + 15
1746+ 817B                  ; ---------------------------------------------------------------
1747+ 817B C6 0F            add  a, 15
1748+ 817D
1749+ 817D BB               cp   e
1750+ 817E
1751+ 817E 28 04            jr   z, .collision
1752+ 8180 30 02            jr   nc, .collision
1753+ 8182
1754+ 8182 18 05            jr   .no_collision
1755+ 8184
1756+ 8184              .collision:
1757+ 8184
1758+ 8184                  ; ---------------------------------------------------------------
1759+ 8184                  ; Collisione rilevata
1760+ 8184                  ; ---------------------------------------------------------------
1761+ 8184 E1               pop  hl
1762+ 8185 D1               pop  de
1763+ 8186 C1               pop  bc
1764+ 8187
1765+ 8187 37               scf                    ; Carry = 1
1766+ 8188
1767+ 8188 C9               ret
1768+ 8189
1769+ 8189              .no_collision:
1770+ 8189
1771+ 8189                  ; ---------------------------------------------------------------
1772+ 8189                  ; Nessuna collisione
1773+ 8189                  ; ---------------------------------------------------------------
1774+ 8189 E1               pop  hl
1775+ 818A D1               pop  de
1776+ 818B C1               pop  bc
1777+ 818C
1778+ 818C B7               or   a                 ; Carry = 0
1779+ 818D
1780+ 818D C9               ret
1781+ 818E
1782+ 818E              ; -------------------------------------------------------------------
1783+ 818E              ; Items_CheckCollision
1784+ 818E              ;
1785+ 818E              ; Controlla se Willy entra in collisione con uno degli item
1786+ 818E              ; attivi presenti nella stanza corrente.
1787+ 818E              ;
1788+ 818E              ; Per ogni item:
1789+ 818E              ;   - verifica che appartenga alla stanza corrente
1790+ 818E              ;   - verifica che non sia già stato raccolto
1791+ 818E              ;   - esegue il test di collisione con Willy
1792+ 818E              ;
1793+ 818E              ; Se l'item viene raccolto:
1794+ 818E              ;   - imposta il flag "collected"
1795+ 818E              ;   - rimuove l'item dalla cache items_grid
1796+ 818E              ;   - incrementa il contatore degli oggetti raccolti
1797+ 818E              ;   - aggiorna l'HUD
1798+ 818E              ;   - ripristina il tile di sfondo
1799+ 818E              ;   - riproduce il suono di raccolta
1800+ 818E              ;
1801+ 818E              ; Formato record ItemsTable:
1802+ 818E              ;   +0 RoomID
1803+ 818E              ;   +1 X
1804+ 818E              ;   +2 Y
1805+ 818E              ;   +3 Color
1806+ 818E              ;   +4 Collected
1807+ 818E              ;
1808+ 818E              ; Fine tabella:
1809+ 818E              ;   RoomID = $FF
1810+ 818E              ; -------------------------------------------------------------------
1811+ 818E              Items_CheckCollision:
1812+ 818E
1813+ 818E                  ; Salva i registri utilizzati
1814+ 818E E5               push hl
1815+ 818F D5               push de
1816+ 8190 C5               push bc
1817+ 8191
1818+ 8191                  ; Inizio scansione della tabella degli item
1819+ 8191 21 DE 7A         ld   hl, ItemsTable
1820+ 8194
1821+ 8194              .loop:
1822+ 8194
1823+ 8194                  ; ---------------------------------------------------------------
1824+ 8194                  ; Legge il Room ID dell'item corrente
1825+ 8194                  ; ---------------------------------------------------------------
1826+ 8194 7E               ld   a, (hl)
1827+ 8195
1828+ 8195                  ; $FF indica fine tabella
1829+ 8195 FE FF            cp   $FF
1830+ 8197 28 4D            jr   z, .done
1831+ 8199
1832+ 8199                  ; ---------------------------------------------------------------
1833+ 8199                  ; Verifica se l'item appartiene alla stanza corrente
1834+ 8199                  ; ---------------------------------------------------------------
1835+ 8199 57               ld   d, a              ; D = RoomID item
1836+ 819A
1837+ 819A 3A 06 EA         ld   a, (current_room)
1838+ 819D BA               cp   d
1839+ 819E
1840+ 819E                  ; Se appartiene a un'altra stanza salta il record
1841+ 819E 20 3F            jr   nz, .next_item
1842+ 81A0
1843+ 81A0                  ; ---------------------------------------------------------------
1844+ 81A0                  ; Legge coordinate e stato dell'item
1845+ 81A0                  ; ---------------------------------------------------------------
1846+ 81A0
1847+ 81A0 23               inc  hl
1848+ 81A1 4E               ld   c, (hl)           ; C = X
1849+ 81A2
1850+ 81A2 23               inc  hl
1851+ 81A3 46               ld   b, (hl)           ; B = Y
1852+ 81A4
1853+ 81A4 23               inc  hl                ; salta Color
1854+ 81A5
1855+ 81A5 23               inc  hl                ; punta a Collected
1856+ 81A6
1857+ 81A6 7E               ld   a, (hl)
1858+ 81A7
1859+ 81A7                  ; ---------------------------------------------------------------
1860+ 81A7                  ; Item già raccolto?
1861+ 81A7                  ; ---------------------------------------------------------------
1862+ 81A7 B7               or   a
1863+ 81A8 20 39            jr   nz, .next_no_inc
1864+ 81AA
1865+ 81AA                  ; ---------------------------------------------------------------
1866+ 81AA                  ; Test collisione Willy ↔ Item
1867+ 81AA                  ;
1868+ 81AA                  ; Input richiesto:
1869+ 81AA                  ;   A = ItemX
1870+ 81AA                  ;   H = ItemY
1871+ 81AA                  ; ---------------------------------------------------------------
1872+ 81AA 79               ld   a, c
1873+ 81AB
1874+ 81AB E5               push hl                ; salva puntatore al flag Collected
1875+ 81AC
1876+ 81AC 60               ld   h, b
1877+ 81AD
1878+ 81AD CD 48 81         call CheckWillyItemCollision
1879+ 81B0
1880+ 81B0 E1               pop  hl
1881+ 81B1
1882+ 81B1                  ; Nessuna collisione
1883+ 81B1 30 30            jr   nc, .next_no_inc
1884+ 81B3
1885+ 81B3                  ; ===============================================================
1886+ 81B3                  ; ITEM RACCOLTO
1887+ 81B3                  ; ===============================================================
1888+ 81B3
1889+ 81B3                  ; ---------------------------------------------------------------
1890+ 81B3                  ; Marca l'item come raccolto
1891+ 81B3                  ; ---------------------------------------------------------------
1892+ 81B3 36 01            ld   (hl), 1
1893+ 81B5
1894+ 81B5                  ; ---------------------------------------------------------------
1895+ 81B5                  ; Rimuove l'item dalla cache items_grid
1896+ 81B5                  ;
1897+ 81B5                  ; Calcolo:
1898+ 81B5                  ;   offset = Row * 32 + Col
1899+ 81B5                  ; ---------------------------------------------------------------
1900+ 81B5 E5               push hl
1901+ 81B6 D5               push de
1902+ 81B7
1903+ 81B7 26 00            ld   h, 0
1904+ 81B9 68               ld   l, b              ; HL = Row
1905+ 81BA
1906+ 81BA 29               add  hl, hl            ; *2
1907+ 81BB 29               add  hl, hl            ; *4
1908+ 81BC 29               add  hl, hl            ; *8
1909+ 81BD 29               add  hl, hl            ; *16
1910+ 81BE 29               add  hl, hl            ; *32
1911+ 81BF
1912+ 81BF 59               ld   e, c
1913+ 81C0 16 00            ld   d, 0
1914+ 81C2
1915+ 81C2 19               add  hl, de            ; Row*32 + Col
1916+ 81C3
1917+ 81C3 11 E0 E4         ld   de, items_grid
1918+ 81C6 19               add  hl, de
1919+ 81C7
1920+ 81C7                  ; La cella non contiene più un item
1921+ 81C7 36 00            ld   (hl), 0
1922+ 81C9
1923+ 81C9 D1               pop  de
1924+ 81CA E1               pop  hl
1925+ 81CB
1926+ 81CB                  ; ---------------------------------------------------------------
1927+ 81CB                  ; Conserva il puntatore all'entry corrente
1928+ 81CB                  ; poiché le routine successive possono alterare HL.
1929+ 81CB                  ; ---------------------------------------------------------------
1930+ 81CB E5               push hl
1931+ 81CC
1932+ 81CC                  ; ---------------------------------------------------------------
1933+ 81CC                  ; Aggiorna il numero di oggetti raccolti
1934+ 81CC                  ; ---------------------------------------------------------------
1935+ 81CC 3A EA E6         ld   a, (items_collected)
1936+ 81CF
1937+ 81CF 3C               inc  a
1938+ 81D0
1939+ 81D0 32 EA E6         ld   (items_collected), a
1940+ 81D3
1941+ 81D3                  ; ---------------------------------------------------------------
1942+ 81D3                  ; Aggiorna il contatore visualizzato a schermo
1943+ 81D3                  ; ---------------------------------------------------------------
1944+ 81D3 CD 2B 63         call Gfx_UpdateItemsCollectedDisplay
1945+ 81D6
1946+ 81D6                  ; ---------------------------------------------------------------
1947+ 81D6                  ; Ripristina il tile originale della stanza
1948+ 81D6                  ; eliminando la grafica dell'item.
1949+ 81D6                  ;
1950+ 81D6                  ; Input:
1951+ 81D6                  ;   B = Row
1952+ 81D6                  ;   C = Col
1953+ 81D6                  ; ---------------------------------------------------------------
1954+ 81D6 CD 06 81         call RestoreBackgroundCell
1955+ 81D9
1956+ 81D9                  ; ---------------------------------------------------------------
1957+ 81D9                  ; Riproduce il suono di raccolta
1958+ 81D9                  ; ---------------------------------------------------------------
1959+ 81D9 CD 55 82         call Audio_PlayCollectSound
1960+ 81DC
1961+ 81DC                  ; Ripristina il puntatore alla tabella
1962+ 81DC E1               pop  hl
1963+ 81DD
1964+ 81DD                  ; Continua con il record successivo
1965+ 81DD 18 04            jr   .next_no_inc
1966+ 81DF
1967+ 81DF              .next_item:
1968+ 81DF
1969+ 81DF                  ; ---------------------------------------------------------------
1970+ 81DF                  ; Salta i campi del record:
1971+ 81DF                  ;   X
1972+ 81DF                  ;   Y
1973+ 81DF                  ;   Color
1974+ 81DF                  ;   Collected
1975+ 81DF                  ; ---------------------------------------------------------------
1976+ 81DF 23               inc  hl
1977+ 81E0 23               inc  hl
1978+ 81E1 23               inc  hl
1979+ 81E2 23               inc  hl
1980+ 81E3
1981+ 81E3              .next_no_inc:
1982+ 81E3
1983+ 81E3                  ; ---------------------------------------------------------------
1984+ 81E3                  ; Avanza al record successivo.
1985+ 81E3                  ;
1986+ 81E3                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1987+ 81E3                  ; ---------------------------------------------------------------
1988+ 81E3 23               inc  hl
1989+ 81E4
1990+ 81E4 18 AE            jr   .loop
1991+ 81E6
1992+ 81E6              .done:
1993+ 81E6
1994+ 81E6                  ; Ripristina i registri
1995+ 81E6 C1               pop  bc
1996+ 81E7 D1               pop  de
1997+ 81E8 E1               pop  hl
1998+ 81E9
1999+ 81E9 C9               ret
2000+ 81EA
2001+ 81EA
2002+ 81EA
2003+ 81EA              ; -------------------------------------------------------------------
2004+ 81EA              ; CheckActiveItemAtCell
2005+ 81EA              ;
2006+ 81EA              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2007+ 81EA              ; nella cella specificata della griglia items_grid.
2008+ 81EA              ;
2009+ 81EA              ; Questa routine usa una lookup diretta su una mappa 32x16,
2010+ 81EA              ; evitando la scansione della ItemsTable.
2011+ 81EA              ;
2012+ 81EA              ; Input:
2013+ 81EA              ;   B = Colonna (0..31)
2014+ 81EA              ;   C = Riga (0..15)
2015+ 81EA              ;
2016+ 81EA              ; Output:
2017+ 81EA              ;   Carry Set   = item presente nella cella
2018+ 81EA              ;   Carry Clear = nessun item
2019+ 81EA              ;
2020+ 81EA              ; Nota:
2021+ 81EA              ;   HL NON è restituito valido (commento originale non corretto:
2022+ 81EA              ;   la routine non punta a ItemsTable).
2023+ 81EA              ; -------------------------------------------------------------------
2024+ 81EA              CheckActiveItemAtCell:
2025+ 81EA
2026+ 81EA                  ; Salva registri usati
2027+ 81EA D5               push de
2028+ 81EB E5               push hl
2029+ 81EC
2030+ 81EC                  ; ---------------------------------------------------------------
2031+ 81EC                  ; Calcolo indice lineare nella griglia 32x16:
2032+ 81EC                  ;
2033+ 81EC                  ; offset = Row * 32 + Col
2034+ 81EC                  ; ---------------------------------------------------------------
2035+ 81EC 26 00            ld   h, 0
2036+ 81EE 69               ld   l, c              ; HL = Row
2037+ 81EF
2038+ 81EF 29               add  hl, hl            ; *2
2039+ 81F0 29               add  hl, hl            ; *4
2040+ 81F1 29               add  hl, hl            ; *8
2041+ 81F2 29               add  hl, hl            ; *16
2042+ 81F3 29               add  hl, hl            ; *32
2043+ 81F4
2044+ 81F4                  ; Aggiunge la colonna
2045+ 81F4 58               ld   e, b
2046+ 81F5 16 00            ld   d, 0
2047+ 81F7 19               add  hl, de            ; HL = Row*32 + Col
2048+ 81F8
2049+ 81F8                  ; ---------------------------------------------------------------
2050+ 81F8                  ; Accesso alla griglia degli item attivi
2051+ 81F8                  ; ---------------------------------------------------------------
2052+ 81F8 11 E0 E4         ld   de, items_grid
2053+ 81FB 19               add  hl, de            ; HL = address cella
2054+ 81FC
2055+ 81FC                  ; ---------------------------------------------------------------
2056+ 81FC                  ; Controllo presenza item
2057+ 81FC                  ;
2058+ 81FC                  ; items_grid contiene:
2059+ 81FC                  ;   0 = nessun item
2060+ 81FC                  ;   >0 = item attivo (colore o flag)
2061+ 81FC                  ; ---------------------------------------------------------------
2062+ 81FC 7E               ld   a, (hl)
2063+ 81FD B7               or   a
2064+ 81FE 28 04            jr   z, .not_active
2065+ 8200
2066+ 8200                  ; ---------------------------------------------------------------
2067+ 8200                  ; Item trovato
2068+ 8200                  ; ---------------------------------------------------------------
2069+ 8200 E1               pop  hl
2070+ 8201 D1               pop  de
2071+ 8202
2072+ 8202 37               scf                    ; Carry = 1
2073+ 8203 C9               ret
2074+ 8204
2075+ 8204              .not_active:
2076+ 8204
2077+ 8204                  ; ---------------------------------------------------------------
2078+ 8204                  ; Nessun item nella cella
2079+ 8204                  ; ---------------------------------------------------------------
2080+ 8204 E1               pop  hl
2081+ 8205 D1               pop  de
2082+ 8206
2083+ 8206 B7               or   a                 ; Carry = 0
2084+ 8207 C9               ret
2085+ 8208
# file closed: items.asm
