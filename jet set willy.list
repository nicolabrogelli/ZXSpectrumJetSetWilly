 361+ 6B92              ; -------------------------------------------------------------------
 362+ 6B92              ; Controlla se Willy collide con un item (pixel-level check)
 363+ 6B92              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 364+ 6B92              ; Output: Carry set se collide, altrimenti clear
 365+ 6B92              ; -------------------------------------------------------------------
 366+ 6B92              CheckWillyItemCollision:
 367+ 6B92 C5               push bc
 368+ 6B93 D5               push de
 369+ 6B94 E5               push hl
 370+ 6B95
 371+ 6B95                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 372+ 6B95 6F               ld   l, a
 373+ 6B96 7D               ld   a, l
 374+ 6B97 87               add  a, a              ; *2
 375+ 6B98 87               add  a, a              ; *4
 376+ 6B99 87               add  a, a              ; *8
 377+ 6B9A 5F               ld   e, a              ; E = ItemLeft
 378+ 6B9B C6 07            add  a, 7
 379+ 6B9D 57               ld   d, a              ; D = ItemRight
 380+ 6B9E
 381+ 6B9E                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 382+ 6B9E ED 4B F5 76      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 383+ 6BA2
 384+ 6BA2                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 385+ 6BA2 79               ld   a, c
 386+ 6BA3 BA               cp   d
 387+ 6BA4 28 04            jr   z, .x_ok
 388+ 6BA6 38 02            jr   c, .x_ok
 389+ 6BA8 18 29            jr   .no_collision
 390+ 6BAA              .x_ok:
 391+ 6BAA C6 0F            add  a, 15
 392+ 6BAC BB               cp   e
 393+ 6BAD 28 04            jr   z, .y_check
 394+ 6BAF 30 02            jr   nc, .y_check
 395+ 6BB1 18 20            jr   .no_collision
 396+ 6BB3
 397+ 6BB3              .y_check:
 398+ 6BB3 E1               pop  hl                ; Recupera HL originale (H = ItemY)
 399+ 6BB4 E5               push hl
 400+ 6BB5 7C               ld   a, h
 401+ 6BB6 87               add  a, a              ; *2
 402+ 6BB7 87               add  a, a              ; *4
 403+ 6BB8 87               add  a, a              ; *8
 404+ 6BB9 5F               ld   e, a              ; E = ItemTop
 405+ 6BBA C6 07            add  a, 7
 406+ 6BBC 57               ld   d, a              ; D = ItemBottom
 407+ 6BBD
 408+ 6BBD                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 409+ 6BBD 78               ld   a, b
 410+ 6BBE BA               cp   d
 411+ 6BBF 28 04            jr   z, .y_ok
 412+ 6BC1 38 02            jr   c, .y_ok
 413+ 6BC3 18 0E            jr   .no_collision
 414+ 6BC5              .y_ok:
 415+ 6BC5 C6 0F            add  a, 15
 416+ 6BC7 BB               cp   e
 417+ 6BC8 28 04            jr   z, .collision
 418+ 6BCA 30 02            jr   nc, .collision
 419+ 6BCC 18 05            jr   .no_collision
 420+ 6BCE
 421+ 6BCE              .collision:
 422+ 6BCE E1               pop  hl
 423+ 6BCF D1               pop  de
 424+ 6BD0 C1               pop  bc
 425+ 6BD1 37               scf                    ; Set carry (collisione!)
 426+ 6BD2 C9               ret
 427+ 6BD3
 428+ 6BD3              .no_collision:
 429+ 6BD3 E1               pop  hl
 430+ 6BD4 D1               pop  de
 431+ 6BD5 C1               pop  bc
