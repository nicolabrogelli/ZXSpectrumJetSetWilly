1753+ 6784              ; Disegna un carattere ASCII A alla colonna C (0..31) di Riga 23 direttamente in VRAM
1754+ 6784              ; -------------------------------------------------------------------
1755+ 6784              Gfx_DrawCharVRAM_Row23:
1756+ 6784 F5               push af
1757+ 6785 C5               push bc
1758+ 6786 D5               push de
1759+ 6787 E5               push hl
1760+ 6788
1761+ 6788                  ; C = colonna (0..31), A = carattere ASCII
1762+ 6788 47               ld   b, a              ; B = salva carattere ASCII
1763+ 6789 79               ld   a, c
1764+ 678A FE 20            cp   32
1765+ 678C 30 2E            jr   nc, .exit_draw_char ; Se C >= 32, ignora per sicurezza!
1766+ 678E
1767+ 678E                  ; Check dei limiti ASCII (32..127) per non accedere a RAM fuori dal font
1768+ 678E 78               ld   a, b              ; A = carattere ASCII
1769+ 678F FE 20            cp   32
1770+ 6791 38 29            jr   c, .exit_draw_char ; Se CHAR < 32 (non stampabile), ignora!
1771+ 6793 FE 80            cp   128
