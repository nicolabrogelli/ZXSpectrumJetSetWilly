2016+ 8606              ; CheckActiveItemAtCell
2017+ 8606              ;
2018+ 8606              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2019+ 8606              ; nella cella specificata della griglia items_grid.
2020+ 8606              ;
2021+ 8606              ; Questa routine usa una lookup diretta su una mappa 32x16,
2022+ 8606              ; evitando la scansione della ItemsTable.
2023+ 8606              ;
2024+ 8606              ; Input:
2025+ 8606              ;   B = Colonna (0..31)
2026+ 8606              ;   C = Riga (0..15)
2027+ 8606              ;
2028+ 8606              ; Output:
2029+ 8606              ;   Carry Set   = item presente nella cella
2030+ 8606              ;   Carry Clear = nessun item
2031+ 8606              ;
2032+ 8606              ; Nota:
2033+ 8606              ;   HL NON è restituito valido (commento originale non corretto:
2034+ 8606              ;   la routine non punta a ItemsTable).
2035+ 8606              ; -------------------------------------------------------------------
2036+ 8606              CheckActiveItemAtCell:
2037+ 8606
2038+ 8606                  ; Salva registri usati
2039+ 8606 D5               push de
2040+ 8607 E5               push hl
2041+ 8608
2042+ 8608                  ; ---------------------------------------------------------------
2043+ 8608                  ; Calcolo indice lineare nella griglia 32x16:
2044+ 8608                  ;
2045+ 8608                  ; offset = Row * 32 + Col
2046+ 8608                  ; ---------------------------------------------------------------
2047+ 8608 26 00            ld   h, 0
2048+ 860A 69               ld   l, c              ; HL = Row
2049+ 860B
2050+ 860B 29               add  hl, hl            ; *2
2051+ 860C 29               add  hl, hl            ; *4
2052+ 860D 29               add  hl, hl            ; *8
2053+ 860E 29               add  hl, hl            ; *16
2054+ 860F 29               add  hl, hl            ; *32
2055+ 8610
2056+ 8610                  ; Aggiunge la colonna
2057+ 8610 58               ld   e, b
2058+ 8611 16 00            ld   d, 0
2059+ 8613 19               add  hl, de            ; HL = Row*32 + Col
2060+ 8614
2061+ 8614                  ; ---------------------------------------------------------------
2062+ 8614                  ; Accesso alla griglia degli item attivi
2063+ 8614                  ; ---------------------------------------------------------------
2064+ 8614 11 57 E9         ld   de, items_grid
2065+ 8617 19               add  hl, de            ; HL = address cella
2066+ 8618
2067+ 8618                  ; ---------------------------------------------------------------
2068+ 8618                  ; Controllo presenza item
2069+ 8618                  ;
2070+ 8618                  ; items_grid contiene:
2071+ 8618                  ;   0 = nessun item
2072+ 8618                  ;   >0 = item attivo (colore o flag)
2073+ 8618                  ; ---------------------------------------------------------------
2074+ 8618 7E               ld   a, (hl)
2075+ 8619 B7               or   a
2076+ 861A 28 04            jr   z, .not_active
2077+ 861C
2078+ 861C                  ; ---------------------------------------------------------------
2079+ 861C                  ; Item trovato
2080+ 861C                  ; ---------------------------------------------------------------
2081+ 861C E1               pop  hl
2082+ 861D D1               pop  de
2083+ 861E
2084+ 861E 37               scf                    ; Carry = 1
2085+ 861F C9               ret
2086+ 8620
2087+ 8620              .not_active:
2088+ 8620
2089+ 8620                  ; ---------------------------------------------------------------
2090+ 8620                  ; Nessun item nella cella
2091+ 8620                  ; ---------------------------------------------------------------
2092+ 8620 E1               pop  hl
2093+ 8621 D1               pop  de
2094+ 8622
2095+ 8622 B7               or   a                 ; Carry = 0
2096+ 8623 C9               ret
