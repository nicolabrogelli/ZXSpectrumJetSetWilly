 938+ 6A71 CB 3F            srl  a
 939+ 6A73 CB 3F            srl  a                 ; A = c (0..31)
 940+ 6A75 4F               ld   c, a              ; C = c (Col)
 941+ 6A76
 942+ 6A76                  ; Se la cella è sulla rampa, non considerarla un muro!
 943+ 6A76 53               ld   d, e              ; D = Row
