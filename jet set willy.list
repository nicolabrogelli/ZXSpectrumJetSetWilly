 328+ 7A06 E6 F8            and  $F8
 329+ 7A08 5F               ld   e, a               ; E = WillyX & $F8
 330+ 7A09 79               ld   a, c
 331+ 7A0A E6 F8            and  $F8                ; A = EnemyX & $F8
 332+ 7A0C 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 333+ 7A0D C6 10            add  a, 16
 334+ 7A0F FE 19            cp   25
 335+ 7A11 D0               ret  nc                 ; Fuori portata X
 336+ 7A12
 337+ 7A12                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 338+ 7A12 3A F0 EE         ld   a, (player_drawn_pos+1) ; A = WillyY
 339+ 7A15 90               sub  b                  ; A = WillyY - EnemyY
 340+ 7A16 C6 0F            add  a, 15
 341+ 7A18 FE 1F            cp   31
 342+ 7A1A D0               ret  nc                 ; Fuori portata Y
