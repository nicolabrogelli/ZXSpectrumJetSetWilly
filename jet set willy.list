 951+ 7E0C C3 73 7E         jp   .next
 952+ 7E0F
 953+ 7E0F              .horiz_right:
 954+ 7E0F DD 7E 02         ld   a, (ix+2)         ; Current X
 955+ 7E12 C6 02            add  a, 2              ; Muovi a destra di 2 pixel
 956+ 7E14 DD BE 05         cp   (ix+5)            ; Max Limit (Offset 5)
 957+ 7E17 28 08            jr   z, .h_rev_left
 958+ 7E19 30 06            jr   nc, .h_rev_left
 959+ 7E1B DD 77 02         ld   (ix+2), a
 960+ 7E1E C3 73 7E         jp   .next
