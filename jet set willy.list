 123+ 746C 5F               ld   e, a
 124+ 746D 16 00            ld   d, 0
 125+ 746F 21 9C 74         ld   hl, Audio_MusicSheet
 126+ 7472 19               add  hl, de
 127+ 7473 19               add  hl, de                   ; hl punta al primo byte della nota
 128+ 7474 7E               ld   a, (hl)                  ; A = delay
 129+ 7475 B7               or   a
 130+ 7476 28 1F            jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 131+ 7478
 132+ 7478                  ; Suona la nota: 2 cicli
 133+ 7478 57               ld   d, a                     ; D = delay
 134+ 7479 06 02            ld   b, 2                     ; 2 cicli per frame
 135+ 747B              .note_loop:
 136+ 747B                  ; Speaker ON
 137+ 747B 3A 0F 75         ld   a, (room_border_color)
 138+ 747E F6 10            or   $10
 139+ 7480 D3 FE            out  ($fe), a
 140+ 7482 4A               ld   c, d
