  63+ 708B              ; DetermineCurrentRoomID
  64+ 708B              ;
  65+ 708B              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 708B              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 708B              ;
  68+ 708B              ; Se viene trovata una corrispondenza:
  69+ 708B              ;   A = ID della stanza
  70+ 708B              ;   current_room = A
  71+ 708B              ;
  72+ 708B              ; Mappatura:
  73+ 708B              ;    0 = The Off Licence
  74+ 708B              ;    1 = The Bridge
  75+ 708B              ;    2 = Under The Mega Tree
  76+ 708B              ;    3 = At The Foot Of The Mega Tree
  77+ 708B              ;    4 = The Drive
  78+ 708B              ;    5 = The Security Guard
  79+ 708B              ;    6 = Entrance To Hades
  80+ 708B              ;    7 = Cuckoo's Nest
  81+ 708B              ;    8 = Inside The Mega Trunk
  82+ 708B              ;    9 = On A Branch Over The Drive
  83+ 708B              ;   10 = The Front Door
  84+ 708B              ;   11 = The Hall
  85+ 708B              ;   12 = Tree Top
  86+ 708B              ;   33 = The Bathroom
  87+ 708B              ;   35 = Master Bedroom
  88+ 708B              ;
  89+ 708B              ; Se nessuna stanza corrisponde viene impostato:
  90+ 708B              ;   current_room = 0
  91+ 708B              ; -------------------------------------------------------------------
  92+ 708B              DetermineCurrentRoomID:
