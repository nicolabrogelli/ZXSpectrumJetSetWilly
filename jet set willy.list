 707+ 6AAD 28 17            jr   z, .not_solid     ; if B == ramp_len, too high!
 708+ 6AAF 38 15            jr   c, .not_solid     ; if B > ramp_len, too high!
 709+ 6AB1
 710+ 6AB1                  ; Calcola ExpectedCol:
