1872+ 78A0 CB 3F            srl  a
1873+ 78A2 CB 3F            srl  a
1874+ 78A4 CB 3F            srl  a                 ; A = r (0..15)
1875+ 78A6
1876+ 78A6                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1877+ 78A6 5F               ld   e, a              ; E = r
1878+ 78A7 79               ld   a, c
1879+ 78A8 CB 3F            srl  a
1880+ 78AA CB 3F            srl  a
1881+ 78AC CB 3F            srl  a                 ; A = c (0..31)
1882+ 78AE 4F               ld   c, a              ; C = c
1883+ 78AF 7B               ld   a, e              ; A = r
