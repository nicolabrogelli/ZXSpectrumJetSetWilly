1242+ 775F              ; -------------------------------------------------------------------
1243+ 775F              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1244+ 775F              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1245+ 775F              ; -------------------------------------------------------------------
1246+ 775F              UnpackRoomLayout:
1247+ 775F E5               push hl
1248+ 7760 D5               push de
1249+ 7761 C5               push bc
1250+ 7762
1251+ 7762 2A 62 F8         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1252+ 7765 11 08 F6         ld   de, unpacked_layout ; DE = buffer RAM
1253+ 7768 06 80            ld   b, 128             ; 128 byte
1254+ 776A              .byte_loop:
1255+ 776A 7E               ld   a, (hl)            ; Leggi byte compresso
1256+ 776B 23               inc  hl
1257+ 776C
1258+ 776C 4F               ld   c, a               ; C = salvataggio
1259+ 776D
1260+ 776D                  ; Cella 0: bit 7-6
1261+ 776D 07               rlca
1262+ 776E 07               rlca
1263+ 776F E6 03            and  3
1264+ 7771 12               ld   (de), a
1265+ 7772 13               inc  de
1266+ 7773
1267+ 7773                  ; Cella 1: bit 5-4
1268+ 7773 79               ld   a, c
1269+ 7774 07               rlca
1270+ 7775 07               rlca
1271+ 7776 07               rlca
1272+ 7777 07               rlca
1273+ 7778 E6 03            and  3
1274+ 777A 12               ld   (de), a
1275+ 777B 13               inc  de
1276+ 777C
1277+ 777C                  ; Cella 2: bit 3-2
1278+ 777C 79               ld   a, c
1279+ 777D 0F               rrca
1280+ 777E 0F               rrca
1281+ 777F E6 03            and  3
1282+ 7781 12               ld   (de), a
1283+ 7782 13               inc  de
1284+ 7783
1285+ 7783                  ; Cella 3: bit 1-0
1286+ 7783 79               ld   a, c
1287+ 7784 E6 03            and  3
1288+ 7786 12               ld   (de), a
1289+ 7787 13               inc  de
1290+ 7788
1291+ 7788 10 E0            djnz .byte_loop
1292+ 778A
1293+ 778A C1               pop  bc
1294+ 778B D1               pop  de
1295+ 778C E1               pop  hl
1296+ 778D C9               ret
