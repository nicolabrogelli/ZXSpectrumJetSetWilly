1148+ 7569              ; -------------------------------------------------------------------
1149+ 7569              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
1150+ 7569              ; Input: C = X, B = Y
1151+ 7569              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
1152+ 7569              ; -------------------------------------------------------------------
1153+ 7569              CheckWallCell:
1154+ 7569 E5               push hl
1155+ 756A D5               push de
1156+ 756B C5               push bc
1157+ 756C
1158+ 756C                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1159+ 756C 78               ld   a, b
1160+ 756D FE 80            cp   128
1161+ 756F 30 1F            jr   nc, .not_wall
1162+ 7571
1163+ 7571                  ; 2. Calcola riga di layout: r = Y / 8
1164+ 7571 CB 3F            srl  a
1165+ 7573 CB 3F            srl  a
1166+ 7575 CB 3F            srl  a                 ; A = r (0..15)
1167+ 7577
1168+ 7577                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1169+ 7577 5F               ld   e, a              ; E = r (Row)
1170+ 7578 79               ld   a, c
1171+ 7579 CB 3F            srl  a
1172+ 757B CB 3F            srl  a
1173+ 757D CB 3F            srl  a                 ; A = c (0..31)
1174+ 757F 4F               ld   c, a              ; C = c (Col)
1175+ 7580
1176+ 7580                  ; Se la cella è sulla rampa, non considerarla un muro!
1177+ 7580 53               ld   d, e              ; D = Row
1178+ 7581 59               ld   e, c              ; E = Col
1179+ 7582 CD EE 74         call IsCellOnRamp
1180+ 7585 38 09            jr   c, .not_wall
1181+ 7587
1182+ 7587 7A               ld   a, d              ; A = Row
1183+ 7588 4B               ld   c, e              ; C = Col
1184+ 7589 CD E9 75         call GetCellFromUnpacked ; A = cell type
1185+ 758C
1186+ 758C                  ; Controlla se è Wall (2)
1187+ 758C FE 02            cp   2
1188+ 758E 28 05            jr   z, .is_wall
