 842+ 7F7A              ; Aggiorna le posizioni dei nemici attivi per il prossimo frame
 843+ 7F7A              ; -------------------------------------------------------------------
 844+ 7F7A              Enemy_Update:
 845+ 7F7A E5               push hl
 846+ 7F7B D5               push de
 847+ 7F7C C5               push bc
 848+ 7F7D DD E5            push ix
 849+ 7F7F
 850+ 7F7F                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 851+ 7F7F 3A B1 F6         ld   a, (enemy_update_rate)
 852+ 7F82 FE 01            cp   1
 853+ 7F84 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 854+ 7F86
 855+ 7F86 3A B2 F6         ld   a, (enemy_update_timer)
 856+ 7F89 3C               inc  a
 857+ 7F8A 47               ld   b, a                      ; B = timer + 1
 858+ 7F8B 3A B1 F6         ld   a, (enemy_update_rate)
 859+ 7F8E B8               cp   b
 860+ 7F8F 28 0C            jr   z, .reset_timer
 861+ 7F91 38 0A            jr   c, .reset_timer
 862+ 7F93
 863+ 7F93                  ; Salva contatore incrementato e salta l'aggiornamento
 864+ 7F93 78               ld   a, b
 865+ 7F94 32 B2 F6         ld   (enemy_update_timer), a
 866+ 7F97
 867+ 7F97              .skip_update:
 868+ 7F97 DD E1            pop  ix
 869+ 7F99 C1               pop  bc
 870+ 7F9A D1               pop  de
 871+ 7F9B E1               pop  hl
 872+ 7F9C C9               ret
 873+ 7F9D
 874+ 7F9D              .reset_timer:
 875+ 7F9D AF               xor  a
 876+ 7F9E 32 B2 F6         ld   (enemy_update_timer), a
 877+ 7FA1 18 00            jr   .do_update
 878+ 7FA3
 879+ 7FA3              .do_update:
 880+ 7FA3 3E 01            ld   a, 1
 881+ 7FA5 32 38 F7         ld   (enemy_was_updated), a
 882+ 7FA8
 883+ 7FA8 DD 21 76 7A      ld   ix, ActiveEnemies
 884+ 7FAC 06 08            ld   b, 8              ; 8 slot
 885+ 7FAE              .loop:
 886+ 7FAE DD 7E 00         ld   a, (ix+0)         ; Flags
 887+ 7FB1 E6 80            and  $80               ; Active?
 888+ 7FB3 CA 85 80         jp   z, .next
 889+ 7FB6
 890+ 7FB6                  ; 1. Aggiorna Anim State
 891+ 7FB6 DD 7E 01         ld   a, (ix+1)         ; Sprite Type (Offset 1)
 892+ 7FB9 E6 3F            and  $3F               ; Tipo
 893+ 7FBB FE 0D            cp   13                ; Tipo 13 = Canguro?
 894+ 7FBD 28 2A            jr   z, .canguro_anim
 895+ 7FBF FE 0B            cp   11                ; Tipo 11 = Soldato?
 896+ 7FC1 28 1B            jr   z, .soldato_anim
 897+ 7FC3 FE 10            cp   16                ; Tipo 16 = Candelabro?
 898+ 7FC5 28 17            jr   z, .soldato_anim
 899+ 7FC7 FE 14            cp   20                ; Tipo 20 = Nonnino?
 900+ 7FC9 28 13            jr   z, .soldato_anim
 901+ 7FCB FE 15            cp   21                ; Tipo 21 = Parrucca?
 902+ 7FCD 28 0F            jr   z, .soldato_anim
 903+ 7FCF FE 1D            cp   29                ; Tipo 29 = Saliera?
 904+ 7FD1 28 0B            jr   z, .soldato_anim
 905+ 7FD3
 906+ 7FD3 DD 7E 07         ld   a, (ix+7)         ; Anim State (Offset 7)
 907+ 7FD6 3C               inc  a
 908+ 7FD7 E6 03            and  3                 ; Alterna 0..3
 909+ 7FD9 DD 77 07         ld   (ix+7), a
 910+ 7FDC 18 14            jr   .anim_done
 911+ 7FDE
 912+ 7FDE              .soldato_anim:
 913+ 7FDE DD 7E 07         ld   a, (ix+7)         ; Anim State
 914+ 7FE1 3C               inc  a
 915+ 7FE2 E6 01            and  1                 ; Alterna 0..1
 916+ 7FE4 DD 77 07         ld   (ix+7), a
 917+ 7FE7 18 09            jr   .anim_done
 918+ 7FE9
