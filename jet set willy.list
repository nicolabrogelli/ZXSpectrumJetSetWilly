   8+ 7553              ; Audio_UpdateJumpSound
   9+ 7553              ;
  10+ 7553              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7553              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7553              ; -------------------------------------------------------------------
  13+ 7553              Audio_UpdateJumpSound:
  14+ 7553 F5               push af
  15+ 7554 C5               push bc
  16+ 7555 D5               push de
  17+ 7556 E5               push hl
  18+ 7557
  19+ 7557                  ; Controlla se il suono è attivo (note < 18)
  20+ 7557 3A EA 79         ld   a, (Audio_jump_sound_note)
  21+ 755A FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 755C 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 755E
  24+ 755E                  ; Carica la nota corrente da suonare
  25+ 755E 5F               ld   e, a
  26+ 755F 16 00            ld   d, 0
  27+ 7561 21 8D 75         ld   hl, Audio_JumpSoundDelays
  28+ 7564 19               add  hl, de
  29+ 7565 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7566 57               ld   d, a                      ; D = delay della nota
  31+ 7567
  32+ 7567                  ; Suona la nota: 15 cicli
  33+ 7567 06 0F            ld   b, 15
  34+ 7569              .note_loop:
  35+ 7569                  ; Speaker ON
  36+ 7569 3A 7C 76         ld   a, (room_border_color)
  37+ 756C F6 10            or   $10
  38+ 756E D3 FE            out  ($fe), a
  39+ 7570 4A               ld   c, d
  40+ 7571              .d1:
  41+ 7571 0D               dec  c
  42+ 7572 20 FD            jr   nz, .d1
  43+ 7574
  44+ 7574                  ; Speaker OFF
  45+ 7574 3A 7C 76         ld   a, (room_border_color)
  46+ 7577 E6 EF            and  $ef
  47+ 7579 D3 FE            out  ($fe), a
  48+ 757B 4A               ld   c, d
  49+ 757C              .d2:
  50+ 757C 0D               dec  c
  51+ 757D 20 FD            jr   nz, .d2
  52+ 757F
  53+ 757F 10 E8            djnz .note_loop
  54+ 7581
  55+ 7581                  ; Passa alla nota successiva
  56+ 7581 3A EA 79         ld   a, (Audio_jump_sound_note)
  57+ 7584 3C               inc  a
  58+ 7585 32 EA 79         ld   (Audio_jump_sound_note), a
  59+ 7588
  60+ 7588              .done:
  61+ 7588 E1               pop  hl
  62+ 7589 D1               pop  de
  63+ 758A C1               pop  bc
  64+ 758B F1               pop  af
  65+ 758C C9               ret
