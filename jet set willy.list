1079+ 83D9              ; -------------------------------------------------------------------
1080+ 83D9              ; Items_DrawRoom
1081+ 83D9              ;
1082+ 83D9              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1083+ 83D9              ;
1084+ 83D9              ; Operazioni eseguite:
1085+ 83D9              ;   1. Azzera la griglia items_grid.
1086+ 83D9              ;   2. Svuota la cache degli oggetti attivi.
1087+ 83D9              ;   3. Scansiona ItemsTable.
1088+ 83D9              ;   4. Per ogni item della stanza corrente:
1089+ 83D9              ;        - verifica se è già stato raccolto
1090+ 83D9              ;        - disegna la grafica
1091+ 83D9              ;        - aggiorna items_grid
1092+ 83D9              ;        - memorizza l'item nella cache current_room_items
1093+ 83D9              ;   5. Aggiorna num_room_items.
1094+ 83D9              ;
1095+ 83D9              ; Record ItemsTable:
1096+ 83D9              ;   +0  Room ID
1097+ 83D9              ;   +1  X (colonna)
1098+ 83D9              ;   +2  Y (riga)
1099+ 83D9              ;   +3  Colore
1100+ 83D9              ;   +4  Collected flag
1101+ 83D9              ;
1102+ 83D9              ; Cache current_room_items:
1103+ 83D9              ;   +0  Colonna
1104+ 83D9              ;   +1  Riga
1105+ 83D9              ;   +2  Colore
1106+ 83D9              ;   +3  Collected flag ptr (Low)
1107+ 83D9              ;   +4  Collected flag ptr (High)
1108+ 83D9              ;
1109+ 83D9              ; Ogni record cache occupa 5 byte.
1110+ 83D9              ; -------------------------------------------------------------------
1111+ 83D9              ; ResetItemsTable
1112+ 83D9              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1113+ 83D9              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1114+ 83D9              ; -------------------------------------------------------------------
1115+ 83D9              ResetItemsTable:
1116+ 83D9 21 82 7E         ld   hl, ItemsTable
1117+ 83DC              .reset_loop:
1118+ 83DC 7E               ld   a, (hl)
1119+ 83DD FE FF            cp   $FF
1120+ 83DF C8               ret  z
1121+ 83E0 23               inc  hl                        ; +1 (X)
1122+ 83E1 23               inc  hl                        ; +2 (Y)
1123+ 83E2 23               inc  hl                        ; +3 (Color)
1124+ 83E3 23               inc  hl                        ; +4 (Collected flag)
1125+ 83E4 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1126+ 83E6 23               inc  hl                        ; Prossimo record
1127+ 83E7 18 F3            jr   .reset_loop
1128+ 83E9
1129+ 83E9              ; -------------------------------------------------------------------
1130+ 83E9              Items_DrawRoom:
1131+ 83E9
1132+ 83E9                  ; Salva tutti i registri utilizzati
1133+ 83E9 E5               push hl
1134+ 83EA D5               push de
1135+ 83EB C5               push bc
1136+ 83EC DD E5            push ix
1137+ 83EE FD E5            push iy
1138+ 83F0
1139+ 83F0                  ; ---------------------------------------------------------------
1140+ 83F0                  ; Azzera items_grid (32 x 16 = 512 byte)
1141+ 83F0                  ; ---------------------------------------------------------------
1142+ 83F0 21 EA E8         ld   hl, items_grid
1143+ 83F3 11 EB E8         ld   de, items_grid + 1
1144+ 83F6 36 00            ld   (hl), 0
1145+ 83F8 01 FF 01         ld   bc, 511
1146+ 83FB ED B0            ldir
1147+ 83FD
1148+ 83FD                  ; ---------------------------------------------------------------
1149+ 83FD                  ; Nessun item attivo nella stanza
1150+ 83FD                  ; ---------------------------------------------------------------
1151+ 83FD AF               xor  a
1152+ 83FE 32 69 EE         ld   (num_room_items), a
1153+ 8401
1154+ 8401                  ; IY punta alla cache degli item attivi
1155+ 8401 FD 21 19 EE      ld   iy, current_room_items
1156+ 8405
1157+ 8405                  ; ---------------------------------------------------------------
1158+ 8405                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1159+ 8405                  ; alla stanza corrente.
1160+ 8405                  ;
1161+ 8405                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1162+ 8405                  ; ---------------------------------------------------------------
1163+ 8405 2A 6A EE         ld   hl, (room_ptr)
1164+ 8408 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1165+ 840B 19               add  hl, de
1166+ 840C
1167+ 840C E5               push hl
1168+ 840D DD E1            pop  ix                ; IX = bitmap item
1169+ 840F
1170+ 840F                  ; ---------------------------------------------------------------
1171+ 840F                  ; Inizio scansione della tabella degli item
1172+ 840F                  ; ---------------------------------------------------------------
1173+ 840F 21 82 7E         ld   hl, ItemsTable
1174+ 8412
1175+ 8412              .loop:
1176+ 8412
1177+ 8412                  ; ---------------------------------------------------------------
1178+ 8412                  ; Legge il Room ID del record corrente
1179+ 8412                  ; ---------------------------------------------------------------
1180+ 8412 7E               ld   a, (hl)
1181+ 8413
1182+ 8413                  ; $FF indica fine tabella
1183+ 8413 FE FF            cp   $FF
1184+ 8415 28 53            jr   z, .done
1185+ 8417
1186+ 8417                  ; ---------------------------------------------------------------
1187+ 8417                  ; Verifica se l'item appartiene alla stanza corrente
1188+ 8417                  ; ---------------------------------------------------------------
1189+ 8417 57               ld   d, a
1190+ 8418
1191+ 8418 3A 10 EE         ld   a, (current_room)
1192+ 841B BA               cp   d
1193+ 841C 20 45            jr   nz, .next_item
1194+ 841E
1195+ 841E                  ; ---------------------------------------------------------------
1196+ 841E                  ; Legge i dati dell'item
1197+ 841E                  ; ---------------------------------------------------------------
1198+ 841E
1199+ 841E 23               inc  hl
1200+ 841F 4E               ld   c, (hl)           ; X (colonna)
1201+ 8420
1202+ 8420 23               inc  hl
1203+ 8421 46               ld   b, (hl)           ; Y (riga)
1204+ 8422
1205+ 8422 23               inc  hl
1206+ 8423 5E               ld   e, (hl)           ; Colore
1207+ 8424
1208+ 8424 23               inc  hl
1209+ 8425 7E               ld   a, (hl)           ; Collected flag
1210+ 8426
1211+ 8426                  ; Se diverso da zero l'item è già stato raccolto
1212+ 8426 B7               or   a
1213+ 8427 20 3E            jr   nz, .next_no_inc
1214+ 8429
1215+ 8429                  ; ---------------------------------------------------------------
1216+ 8429                  ; Disegna l'item sullo schermo
1217+ 8429                  ;
1218+ 8429                  ; B = Row
1219+ 8429                  ; C = Column
1220+ 8429                  ; HL = bitmap pointer
1221+ 8429                  ; E = Color
1222+ 8429                  ; ---------------------------------------------------------------
1223+ 8429 E5               push hl
1224+ 842A
1225+ 842A DD E5            push ix
1226+ 842C E1               pop  hl
1227+ 842D
1228+ 842D CD 72 84         call DrawItemGraphic
1229+ 8430
1230+ 8430 E1               pop  hl                ; ritorna al flag collected
1231+ 8431
1232+ 8431                  ; ---------------------------------------------------------------
1233+ 8431                  ; Aggiorna items_grid
1234+ 8431                  ;
1235+ 8431                  ; Calcolo:
1236+ 8431                  ;   offset = Row * 32 + Col
1237+ 8431                  ; ---------------------------------------------------------------
1238+ 8431 E5               push hl
1239+ 8432 D5               push de
1240+ 8433
1241+ 8433 26 00            ld   h, 0
1242+ 8435 68               ld   l, b              ; HL = Row
1243+ 8436
1244+ 8436 29               add  hl, hl            ; *2
1245+ 8437 29               add  hl, hl            ; *4
1246+ 8438 29               add  hl, hl            ; *8
1247+ 8439 29               add  hl, hl            ; *16
1248+ 843A 29               add  hl, hl            ; *32
1249+ 843B
1250+ 843B 16 00            ld   d, 0
1251+ 843D 59               ld   e, c              ; DE = Col
1252+ 843E
1253+ 843E 19               add  hl, de            ; Row*32 + Col
1254+ 843F
1255+ 843F 11 EA E8         ld   de, items_grid
1256+ 8442 19               add  hl, de            ; puntatore nella griglia
1257+ 8443
1258+ 8443 D1               pop  de                ; ripristina colore
1259+ 8444
1260+ 8444 73               ld   (hl), e           ; salva colore cella
1261+ 8445
1262+ 8445 E1               pop  hl
1263+ 8446
1264+ 8446                  ; ---------------------------------------------------------------
1265+ 8446                  ; Salva l'item nella cache della stanza
1266+ 8446                  ;
1267+ 8446                  ; Questo evita di dover scansionare tutta ItemsTable
1268+ 8446                  ; durante il controllo delle collisioni.
1269+ 8446                  ; ---------------------------------------------------------------
1270+ 8446
1271+ 8446 FD 71 00         ld   (iy+0), c         ; Colonna
1272+ 8449 FD 70 01         ld   (iy+1), b         ; Riga
1273+ 844C FD 73 02         ld   (iy+2), e         ; Colore
1274+ 844F
1275+ 844F                  ; Salva il puntatore al flag "collected"
1276+ 844F FD 75 03         ld   (iy+3), l         ; Low byte
1277+ 8452 FD 74 04         ld   (iy+4), h         ; High byte
1278+ 8455
1279+ 8455                  ; Passa al record successivo della cache
1280+ 8455 01 05 00         ld   bc, 5
1281+ 8458 FD 09            add  iy, bc
1282+ 845A
1283+ 845A                  ; Incrementa il numero di item attivi
1284+ 845A 3A 69 EE         ld   a, (num_room_items)
1285+ 845D 3C               inc  a
1286+ 845E 32 69 EE         ld   (num_room_items), a
1287+ 8461
1288+ 8461 18 04            jr   .next_no_inc
1289+ 8463
1290+ 8463              .next_item:
1291+ 8463
1292+ 8463                  ; ---------------------------------------------------------------
1293+ 8463                  ; L'item non appartiene alla stanza corrente.
1294+ 8463                  ; Salta i campi del record:
1295+ 8463                  ;   X
1296+ 8463                  ;   Y
1297+ 8463                  ;   Color
1298+ 8463                  ;   Collected
1299+ 8463                  ; ---------------------------------------------------------------
1300+ 8463 23               inc  hl
1301+ 8464 23               inc  hl
1302+ 8465 23               inc  hl
1303+ 8466 23               inc  hl
1304+ 8467
1305+ 8467              .next_no_inc:
1306+ 8467
1307+ 8467                  ; ---------------------------------------------------------------
1308+ 8467                  ; Avanza al record successivo
1309+ 8467                  ; (prossimo Room ID)
1310+ 8467                  ; ---------------------------------------------------------------
1311+ 8467 23               inc  hl
1312+ 8468 18 A8            jr   .loop
1313+ 846A
1314+ 846A              .done:
1315+ 846A
1316+ 846A                  ; Ripristina i registri
1317+ 846A FD E1            pop  iy
1318+ 846C DD E1            pop  ix
1319+ 846E D1               pop  de
1320+ 846F C1               pop  bc
1321+ 8470 E1               pop  hl
1322+ 8471
1323+ 8471 C9               ret
