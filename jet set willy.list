1109+ 6B95              ; -------------------------------------------------------------------
1110+ 6B95              ; GetRampY
1111+ 6B95              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1112+ 6B95              ; Input: C = PlayerX
1113+ 6B95              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1114+ 6B95              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1115+ 6B95              ; -------------------------------------------------------------------
1116+ 6B95              GetRampY:
1117+ 6B95 3A 20 78         ld   a, (ramp_len)
1118+ 6B98 B7               or   a
1119+ 6B99 C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1120+ 6B9A
1121+ 6B9A 3A 1F 78         ld   a, (ramp_dir)
1122+ 6B9D B7               or   a
1123+ 6B9E 28 4C            jr   z, .dir_left
1124+ 6BA0
1125+ 6BA0              .dir_right:
1126+ 6BA0                  ; Rampa sale a destra (up-right)
1127+ 6BA0 3A 22 78         ld   a, (ramp_col)
1128+ 6BA3 87               add  a, a              ; *2
1129+ 6BA4 87               add  a, a              ; *4
1130+ 6BA5 87               add  a, a              ; *8 (X start in pixel)
1131+ 6BA6 5F               ld   e, a              ; E = X_left
1132+ 6BA7
1133+ 6BA7 3A 20 78         ld   a, (ramp_len)
1134+ 6BAA 87               add  a, a              ; *2
1135+ 6BAB 87               add  a, a              ; *4
1136+ 6BAC 87               add  a, a              ; *8
1137+ 6BAD 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1138+ 6BAE 67               ld   h, a              ; H = X_right_boundary
1139+ 6BAF
1140+ 6BAF 79               ld   a, c              ; A = PlayerX
1141+ 6BB0 BB               cp   e
1142+ 6BB1 DA 46 6C         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1143+ 6BB4
1144+ 6BB4 BC               cp   h
1145+ 6BB5 38 15            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1146+ 6BB7
1147+ 6BB7                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1148+ 6BB7 94               sub  h                 ; A = PlayerX - X_right_boundary
1149+ 6BB8 FE 08            cp   8
1150+ 6BBA D2 46 6C         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1151+ 6BBD
1152+ 6BBD                  ; Piattaforma adiacente! Restituisci PlayerY = (ramp_row - ramp_len + 1) * 8 - 16
1153+ 6BBD 3A 21 78         ld   a, (ramp_row)
1154+ 6BC0 21 20 78         ld   hl, ramp_len
1155+ 6BC3 96               sub  (hl)
1156+ 6BC4 3C               inc  a                 ; A = Row
1157+ 6BC5 87               add  a, a              ; *2
1158+ 6BC6 87               add  a, a              ; *4
1159+ 6BC7 87               add  a, a              ; *8
1160+ 6BC8 D6 10            sub  16                ; A = Row * 8 - 16
1161+ 6BCA 37               scf                    ; Set carry (dentro rampa/piattaforma)
1162+ 6BCB C9               ret
1163+ 6BCC
1164+ 6BCC              .on_ramp_slope:
1165+ 6BCC 3A 21 78         ld   a, (ramp_row)
1166+ 6BCF 87               add  a, a              ; *2
1167+ 6BD0 87               add  a, a              ; *4
1168+ 6BD1 87               add  a, a              ; *8
1169+ 6BD2 D6 10            sub  16                ; A = ramp_row * 8 - 16
1170+ 6BD4 83               add  a, e              ; A = ramp_row * 8 - 16 + X_left
1171+ 6BD5 91               sub  c                 ; A = A - PlayerX
1172+ 6BD6
1173+ 6BD6                  ; Calcola la quota della piattaforma:
1174+ 6BD6                  ; platform_Y = (ramp_row - ramp_len + 1) * 8 - 16
1175+ 6BD6 57               ld   d, a              ; D = calculated Y
1176+ 6BD7
1177+ 6BD7 3A 21 78         ld   a, (ramp_row)
1178+ 6BDA 21 20 78         ld   hl, ramp_len
1179+ 6BDD 96               sub  (hl)
1180+ 6BDE 3C               inc  a                 ; A = Row
1181+ 6BDF 87               add  a, a              ; *2
