  66  796B                  ; Leggi il colore del bordo dalla stanza corrente e impostalo
  67  796B 2A 14 79         ld   hl, (room_ptr)
  68  796E 11 DE 00         ld   de, OFFSET_BORDER_COLOR
  69  7971 19               add  hl, de
