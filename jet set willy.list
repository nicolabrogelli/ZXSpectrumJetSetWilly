 613+ 6A85                  ; 2. Controllo verticale: PlayerY - EnemyY + 15 in [0, 30]
 614+ 6A85 3A 3A 7B         ld   a, (PlayerPos+1)  ; A = PlayerY
 615+ 6A88 DD 96 03         sub  (ix+3)            ; A = PlayerY - EnemyY (Offset 3: Current Y)
 616+ 6A8B C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 617+ 6A8D FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 618+ 6A8F 30 07            jr   nc, .next
