 842+ 7E0A              ; Aggiorna le posizioni dei nemici attivi per il prossimo frame
 843+ 7E0A              ; -------------------------------------------------------------------
 844+ 7E0A              Enemy_Update:
 845+ 7E0A E5               push hl
 846+ 7E0B D5               push de
 847+ 7E0C C5               push bc
 848+ 7E0D DD E5            push ix
 849+ 7E0F
 850+ 7E0F                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 851+ 7E0F 3A 03 F0         ld   a, (enemy_update_rate)
 852+ 7E12 FE 01            cp   1
 853+ 7E14 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 854+ 7E16
 855+ 7E16 3A 04 F0         ld   a, (enemy_update_timer)
 856+ 7E19 3C               inc  a
 857+ 7E1A 47               ld   b, a                      ; B = timer + 1
 858+ 7E1B 3A 03 F0         ld   a, (enemy_update_rate)
 859+ 7E1E B8               cp   b
 860+ 7E1F 28 0C            jr   z, .reset_timer
 861+ 7E21 38 0A            jr   c, .reset_timer
 862+ 7E23
 863+ 7E23                  ; Salva contatore incrementato e salta l'aggiornamento
 864+ 7E23 78               ld   a, b
 865+ 7E24 32 04 F0         ld   (enemy_update_timer), a
 866+ 7E27
 867+ 7E27              .skip_update:
 868+ 7E27 DD E1            pop  ix
 869+ 7E29 C1               pop  bc
 870+ 7E2A D1               pop  de
 871+ 7E2B E1               pop  hl
 872+ 7E2C C9               ret
 873+ 7E2D
 874+ 7E2D              .reset_timer:
 875+ 7E2D AF               xor  a
 876+ 7E2E 32 04 F0         ld   (enemy_update_timer), a
 877+ 7E31 18 00            jr   .do_update
 878+ 7E33
 879+ 7E33              .do_update:
 880+ 7E33 3E 01            ld   a, 1
 881+ 7E35 32 8A F0         ld   (enemy_was_updated), a
 882+ 7E38
 883+ 7E38 DD 21 06 79      ld   ix, ActiveEnemies
 884+ 7E3C 06 08            ld   b, 8              ; 8 slot
 885+ 7E3E              .loop:
 886+ 7E3E DD 7E 00         ld   a, (ix+0)         ; Flags
 887+ 7E41 E6 80            and  $80               ; Active?
 888+ 7E43 CA 15 7F         jp   z, .next
 889+ 7E46
 890+ 7E46                  ; 1. Aggiorna Anim State
 891+ 7E46 DD 7E 01         ld   a, (ix+1)         ; Sprite Type (Offset 1)
 892+ 7E49 E6 3F            and  $3F               ; Tipo
 893+ 7E4B FE 0D            cp   13                ; Tipo 13 = Canguro?
 894+ 7E4D 28 2A            jr   z, .canguro_anim
 895+ 7E4F FE 0B            cp   11                ; Tipo 11 = Soldato?
 896+ 7E51 28 1B            jr   z, .soldato_anim
 897+ 7E53 FE 10            cp   16                ; Tipo 16 = Candelabro?
 898+ 7E55 28 17            jr   z, .soldato_anim
 899+ 7E57 FE 14            cp   20                ; Tipo 20 = Nonnino?
 900+ 7E59 28 13            jr   z, .soldato_anim
 901+ 7E5B FE 15            cp   21                ; Tipo 21 = Parrucca?
 902+ 7E5D 28 0F            jr   z, .soldato_anim
 903+ 7E5F FE 1D            cp   29                ; Tipo 29 = Saliera?
 904+ 7E61 28 0B            jr   z, .soldato_anim
 905+ 7E63
 906+ 7E63 DD 7E 07         ld   a, (ix+7)         ; Anim State (Offset 7)
 907+ 7E66 3C               inc  a
 908+ 7E67 E6 03            and  3                 ; Alterna 0..3
 909+ 7E69 DD 77 07         ld   (ix+7), a
 910+ 7E6C 18 14            jr   .anim_done
 911+ 7E6E
 912+ 7E6E              .soldato_anim:
 913+ 7E6E DD 7E 07         ld   a, (ix+7)         ; Anim State
 914+ 7E71 3C               inc  a
 915+ 7E72 E6 01            and  1                 ; Alterna 0..1
 916+ 7E74 DD 77 07         ld   (ix+7), a
 917+ 7E77 18 09            jr   .anim_done
 918+ 7E79
 919+ 7E79              .canguro_anim:
 920+ 7E79 DD 7E 07         ld   a, (ix+7)         ; Anim State
 921+ 7E7C 3C               inc  a
 922+ 7E7D E6 07            and  7                 ; Alterna 0..7
 923+ 7E7F DD 77 07         ld   (ix+7), a
 924+ 7E82
 925+ 7E82              .anim_done:
 926+ 7E82
 927+ 7E82                  ; 3. Determina se orizzontale o verticale
 928+ 7E82 DD 7E 00         ld   a, (ix+0)         ; Flags
 929+ 7E85 E6 40            and  $40               ; Vertical? (Bit 6)
 930+ 7E87 C2 D1 7E         jp   nz, .vertical
 931+ 7E8A
 932+ 7E8A              .horizontal:
 933+ 7E8A DD 7E 06         ld   a, (ix+6)         ; Direction (1=Left, 2=Right) (Offset 6)
 934+ 7E8D FE 01            cp   1
 935+ 7E8F 20 20            jr   nz, .horiz_right
 936+ 7E91
 937+ 7E91              .horiz_left:
 938+ 7E91 DD 7E 02         ld   a, (ix+2)         ; Current X
 939+ 7E94 D6 02            sub  2                 ; Muovi a sinistra di 2 pixel
 940+ 7E96 DD BE 04         cp   (ix+4)            ; Min Limit (Offset 4)
 941+ 7E99 28 08            jr   z, .h_rev_right
 942+ 7E9B 38 06            jr   c, .h_rev_right
 943+ 7E9D DD 77 02         ld   (ix+2), a
 944+ 7EA0 C3 15 7F         jp   .next
 945+ 7EA3
 946+ 7EA3              .h_rev_right:
 947+ 7EA3 DD 7E 04         ld   a, (ix+4)         ; Min Limit
 948+ 7EA6 DD 77 02         ld   (ix+2), a
 949+ 7EA9 3E 02            ld   a, 2
 950+ 7EAB DD 77 06         ld   (ix+6), a         ; Cambia direzione a Destra (Offset 6)
 951+ 7EAE C3 15 7F         jp   .next
 952+ 7EB1
 953+ 7EB1              .horiz_right:
 954+ 7EB1 DD 7E 02         ld   a, (ix+2)         ; Current X
 955+ 7EB4 C6 02            add  a, 2              ; Muovi a destra di 2 pixel
 956+ 7EB6 DD BE 05         cp   (ix+5)            ; Max Limit (Offset 5)
 957+ 7EB9 28 08            jr   z, .h_rev_left
 958+ 7EBB 30 06            jr   nc, .h_rev_left
 959+ 7EBD DD 77 02         ld   (ix+2), a
 960+ 7EC0 C3 15 7F         jp   .next
 961+ 7EC3
 962+ 7EC3              .h_rev_left:
 963+ 7EC3 DD 7E 05         ld   a, (ix+5)         ; Max Limit
 964+ 7EC6 DD 77 02         ld   (ix+2), a
 965+ 7EC9 3E 01            ld   a, 1
 966+ 7ECB DD 77 06         ld   (ix+6), a         ; Cambia direzione a Sinistra
 967+ 7ECE C3 15 7F         jp   .next
 968+ 7ED1
 969+ 7ED1              .vertical:
 970+ 7ED1 DD 7E 06         ld   a, (ix+6)         ; Direction (1=Up, 2=Down)
 971+ 7ED4 FE 01            cp   1
 972+ 7ED6 20 20            jr   nz, .vert_down
 973+ 7ED8
 974+ 7ED8              .vert_up:
 975+ 7ED8 DD 7E 03         ld   a, (ix+3)         ; Current Y
 976+ 7EDB D6 02            sub  2                 ; Muovi in alto di 2 pixel
 977+ 7EDD DD BE 04         cp   (ix+4)            ; Min Limit (Top)
 978+ 7EE0 28 08            jr   z, .v_rev_down
 979+ 7EE2 38 06            jr   c, .v_rev_down
 980+ 7EE4 DD 77 03         ld   (ix+3), a
 981+ 7EE7 C3 15 7F         jp   .next
 982+ 7EEA
 983+ 7EEA              .v_rev_down:
 984+ 7EEA DD 7E 04         ld   a, (ix+4)         ; Min Limit
 985+ 7EED DD 77 03         ld   (ix+3), a
 986+ 7EF0 3E 02            ld   a, 2
 987+ 7EF2 DD 77 06         ld   (ix+6), a         ; Cambia direzione in Basso
 988+ 7EF5 C3 15 7F         jp   .next
 989+ 7EF8
 990+ 7EF8              .vert_down:
 991+ 7EF8 DD 7E 03         ld   a, (ix+3)         ; Current Y
 992+ 7EFB C6 02            add  a, 2              ; Muovi in basso di 2 pixel
 993+ 7EFD DD BE 05         cp   (ix+5)            ; Max Limit (Bottom)
 994+ 7F00 28 08            jr   z, .v_rev_up
 995+ 7F02 30 06            jr   nc, .v_rev_up
 996+ 7F04 DD 77 03         ld   (ix+3), a
 997+ 7F07 C3 15 7F         jp   .next
 998+ 7F0A
 999+ 7F0A              .v_rev_up:
1000+ 7F0A DD 7E 05         ld   a, (ix+5)         ; Max Limit
1001+ 7F0D DD 77 03         ld   (ix+3), a
1002+ 7F10 3E 01            ld   a, 1
1003+ 7F12 DD 77 06         ld   (ix+6), a         ; Cambia direzione in Alto
1004+ 7F15
1005+ 7F15              .next:
1006+ 7F15 11 0B 00         ld   de, 11
1007+ 7F18 DD 19            add  ix, de            ; Prossimo slot (11 byte)
1008+ 7F1A 05               dec  b
1009+ 7F1B C2 3E 7E         jp   nz, .loop
1010+ 7F1E
1011+ 7F1E DD E1            pop  ix
1012+ 7F20 C1               pop  bc
1013+ 7F21 D1               pop  de
1014+ 7F22 E1               pop  hl
1015+ 7F23 C9               ret
