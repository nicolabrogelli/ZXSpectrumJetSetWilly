1834+ 77D6 32 09 EB         ld   (room_jump_strength), a
1835+ 77D9 3E 01            ld   a, DEFAULT_GRAVITY_PRESET
1836+ 77DB 32 0A EB         ld   (room_gravity_preset), a
1837+ 77DE 18 12            jr   .done
