 664+ 6AAF 3A 5F 7D         ld   a, (conveyor_len)
 665+ 6AB2 B7               or   a
 666+ 6AB3 28 1F            jr   z, .not_solid     ; Se non c'è conveyor, fine
 667+ 6AB5
 668+ 6AB5                  ; Controlla se Row corrisponde
 669+ 6AB5 3A 60 7D         ld   a, (conveyor_row)
 670+ 6AB8 BA               cp   d
 671+ 6AB9 20 19            jr   nz, .not_solid    ; Row diversa
