732+  60E4 20 E6            jr   nz, .scanline_loop1
733+  60E6
734+  60E6                  ; Imposta gli attributi di colore per la riga 15, colonne 8..23
735+  60E6 21 E8 59         ld   hl, $5800 + (15 * 32) + 8
736+  60E9 06 10            ld   b, 16
737+  60EB              .attr_loop1:
738+  60EB 36 05            ld   (hl), CYAN        ; Colore della piattaforma = CYAN
739+  60ED 23               inc  hl
740+  60EE 05               dec  b
741+  60EF 20 FA            jr   nz, .attr_loop1
742+  60F1
743+  60F1                  ; --- PIATTAFORMA 2 ---
744+  60F1                  ; Disegniamo le 7 scanline della riga 12
745+  60F1 DD 21 62 61      ld   ix, TilesDef + 64 ; Puntatore alla grafica del bordo/pavimento
746+  60F5 16 00            ld   d, 0              ; D = offset scanline (0..6)
747+  60F7
748+  60F7              .scanline_loop2:
749+  60F7 3E 48            ld   a, $48            ; Base del secondo terzo (Third 1) per scanline 0, riga 12
750+  60F9 82               add  a, d              ; A = $48 + scanline offset (D)
751+  60FA 67               ld   h, a              ; HL high byte = $48 + D
752+  60FB 2E 94            ld   l, $80 + 20       ; HL low byte = $80 (riga 12) + 20 (colonna 20)
753+  60FD
754+  60FD DD 5E 00         ld   e, (ix+0)         ; E = byte grafico per questa scanline
755+  6100 0E 0A            ld   c, 10             ; 10 colonne (da colonna 20 a 29 incluse)
756+  6102
757+  6102              .col_loop2:
758+  6102 7E               ld   a, (hl)           ; Leggi byte dallo schermo
759+  6103 B3               or   e                 ; Combina con la grafica (OR)
760+  6104 77               ld   (hl), a           ; Scrivi il byte combinato
761+  6105 2C               inc  l                 ; Vai alla colonna successiva
762+  6106 0D               dec  c
763+  6107 20 F9            jr   nz, .col_loop2
764+  6109
765+  6109 DD 23            inc  ix                ; Prossimo byte grafico
766+  610B 14               inc  d                 ; Prossima scanline
767+  610C 7A               ld   a, d
768+  610D FE 07            cp   7
769+  610F 20 E6            jr   nz, .scanline_loop2
770+  6111
771+  6111                  ; Imposta gli attributi di colore per la riga 12, colonne 20..29
772+  6111 21 94 59         ld   hl, $5800 + (12 * 32) + 20
773+  6114 06 0A            ld   b, 10
774+  6116              .attr_loop2:
