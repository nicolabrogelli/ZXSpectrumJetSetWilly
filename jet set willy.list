1053+ 6C5F              ; -------------------------------------------------------------------
1054+ 6C5F              ; Controlla se Willy collide orizzontalmente con un Wall alle coordinate specificate
1055+ 6C5F              ; Input: C = X pixel (da controllare), B = Y pixel (attuale)
1056+ 6C5F              ; Output: Carry flag impostato se c'è collisione, altrimenti resettato
1057+ 6C5F              ; -------------------------------------------------------------------
1058+ 6C5F              CheckWillyWallCollision:
1059+ 6C5F C5               push bc
1060+ 6C60
1061+ 6C60                  ; 1. Punto superiore: (X, Y)
1062+ 6C60 CD 2E 6C         call CheckWallCell
1063+ 6C63 38 17            jr   c, .collision
1064+ 6C65
1065+ 6C65                  ; 2. Punto medio: (X, Y + 7)
1066+ 6C65 78               ld   a, b
1067+ 6C66 C6 07            add  a, 7
1068+ 6C68 47               ld   b, a
1069+ 6C69 CD 2E 6C         call CheckWallCell
1070+ 6C6C 38 0E            jr   c, .collision
1071+ 6C6E
1072+ 6C6E                  ; 3. Punto inferiore: (X, Y + 15)
1073+ 6C6E C1               pop  bc
1074+ 6C6F C5               push bc
1075+ 6C70 78               ld   a, b
1076+ 6C71 C6 0F            add  a, 15
1077+ 6C73 47               ld   b, a
1078+ 6C74 CD 2E 6C         call CheckWallCell
1079+ 6C77 38 03            jr   c, .collision
1080+ 6C79
1081+ 6C79 C1               pop  bc
1082+ 6C7A B7               or   a                 ; Reset carry (nessuna collisione)
1083+ 6C7B C9               ret
1084+ 6C7C
1085+ 6C7C              .collision:
1086+ 6C7C C1               pop  bc
1087+ 6C7D 37               scf                    ; Set carry (collisione avvenuta)
1088+ 6C7E C9               ret
1089+ 6C7F
1090+ 6C7F              ; -------------------------------------------------------------------
1091+ 6C7F              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1092+ 6C7F              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1093+ 6C7F              ; -------------------------------------------------------------------
1094+ 6C7F              UnpackRoomLayout:
1095+ 6C7F E5               push hl
1096+ 6C80 D5               push de
1097+ 6C81 C5               push bc
1098+ 6C82
1099+ 6C82 2A 4B 7E         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1100+ 6C85 11 F1 7B         ld   de, unpacked_layout ; DE = buffer RAM
1101+ 6C88 06 80            ld   b, 128             ; 128 byte
1102+ 6C8A              .byte_loop:
1103+ 6C8A 7E               ld   a, (hl)            ; Leggi byte compresso
1104+ 6C8B 23               inc  hl
1105+ 6C8C
1106+ 6C8C 4F               ld   c, a               ; C = salvataggio
1107+ 6C8D
1108+ 6C8D                  ; Cella 0: bit 7-6
1109+ 6C8D 07               rlca
1110+ 6C8E 07               rlca
1111+ 6C8F E6 03            and  3
1112+ 6C91 12               ld   (de), a
1113+ 6C92 13               inc  de
1114+ 6C93
1115+ 6C93                  ; Cella 1: bit 5-4
1116+ 6C93 79               ld   a, c
1117+ 6C94 07               rlca
1118+ 6C95 07               rlca
1119+ 6C96 07               rlca
1120+ 6C97 07               rlca
1121+ 6C98 E6 03            and  3
1122+ 6C9A 12               ld   (de), a
1123+ 6C9B 13               inc  de
1124+ 6C9C
1125+ 6C9C                  ; Cella 2: bit 3-2
1126+ 6C9C 79               ld   a, c
1127+ 6C9D 0F               rrca
1128+ 6C9E 0F               rrca
1129+ 6C9F E6 03            and  3
1130+ 6CA1 12               ld   (de), a
1131+ 6CA2 13               inc  de
1132+ 6CA3
1133+ 6CA3                  ; Cella 3: bit 1-0
1134+ 6CA3 79               ld   a, c
1135+ 6CA4 E6 03            and  3
1136+ 6CA6 12               ld   (de), a
1137+ 6CA7 13               inc  de
1138+ 6CA8
1139+ 6CA8 10 E0            djnz .byte_loop
1140+ 6CAA
1141+ 6CAA C1               pop  bc
1142+ 6CAB D1               pop  de
1143+ 6CAC E1               pop  hl
1144+ 6CAD C9               ret
1145+ 6CAE
1146+ 6CAE              ; -------------------------------------------------------------------
1147+ 6CAE              ; Legge il tipo di cella dal buffer decompresso in RAM
1148+ 6CAE              ; Input: A = Row (0..15), C = Col (0..31)
1149+ 6CAE              ; Output: A = tipo di cella (0..3)
1150+ 6CAE              ; Preserva tutti gli altri registri.
1151+ 6CAE              ; -------------------------------------------------------------------
1152+ 6CAE              GetCellFromUnpacked:
1153+ 6CAE E5               push hl
1154+ 6CAF D5               push de
1155+ 6CB0
1156+ 6CB0 6F               ld   l, a
1157+ 6CB1 26 00            ld   h, 0
1158+ 6CB3 29               add  hl, hl
1159+ 6CB4 29               add  hl, hl
1160+ 6CB5 29               add  hl, hl
1161+ 6CB6 29               add  hl, hl
1162+ 6CB7 29               add  hl, hl            ; HL = Row * 32
1163+ 6CB8 59               ld   e, c
1164+ 6CB9 16 00            ld   d, 0
1165+ 6CBB 19               add  hl, de            ; HL = Row * 32 + Col
1166+ 6CBC 11 F1 7B         ld   de, unpacked_layout
1167+ 6CBF 19               add  hl, de
1168+ 6CC0 7E               ld   a, (hl)           ; A = cell type
1169+ 6CC1
1170+ 6CC1 D1               pop  de
1171+ 6CC2 E1               pop  hl
1172+ 6CC3 C9               ret
1173+ 6CC4
1174+ 6CC4              ; -------------------------------------------------------------------
1175+ 6CC4              ; GetRampY
1176+ 6CC4              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1177+ 6CC4              ; Input: C = PlayerX
1178+ 6CC4              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1179+ 6CC4              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1180+ 6CC4              ; -------------------------------------------------------------------
1181+ 6CC4              GetRampY:
1182+ 6CC4 3A F7 7D         ld   a, (ramp_len)
1183+ 6CC7 B7               or   a
1184+ 6CC8 C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1185+ 6CC9
1186+ 6CC9 3A F6 7D         ld   a, (ramp_dir)
1187+ 6CCC B7               or   a
1188+ 6CCD 28 5C            jr   z, .dir_left
1189+ 6CCF
1190+ 6CCF              .dir_right:
1191+ 6CCF                  ; Rampa sale a destra (up-right)
1192+ 6CCF 3A F9 7D         ld   a, (ramp_col)
1193+ 6CD2 87               add  a, a              ; *2
1194+ 6CD3 87               add  a, a              ; *4
1195+ 6CD4 87               add  a, a              ; *8 (X start in pixel)
1196+ 6CD5 5F               ld   e, a              ; E = X_left
1197+ 6CD6
1198+ 6CD6 3A F7 7D         ld   a, (ramp_len)
1199+ 6CD9 87               add  a, a              ; *2
1200+ 6CDA 87               add  a, a              ; *4
1201+ 6CDB 87               add  a, a              ; *8
1202+ 6CDC 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1203+ 6CDD 67               ld   h, a              ; H = X_right_boundary
1204+ 6CDE 38 10            jr   c, .no_right_bound_check_right
1205+ 6CE0
1206+ 6CE0 79               ld   a, c              ; A = PlayerX
1207+ 6CE1 BB               cp   e
1208+ 6CE2 DA 91 6D         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1209+ 6CE5
1210+ 6CE5 BC               cp   h
1211+ 6CE6 38 1E            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1212+ 6CE8
1213+ 6CE8                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1214+ 6CE8 94               sub  h                 ; A = PlayerX - X_right_boundary
1215+ 6CE9 FE 08            cp   8
1216+ 6CEB D2 91 6D         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1217+ 6CEE 18 07            jr   .on_platform_right
1218+ 6CF0
1219+ 6CF0              .no_right_bound_check_right:
1220+ 6CF0 79               ld   a, c              ; A = PlayerX
1221+ 6CF1 BB               cp   e
1222+ 6CF2 DA 91 6D         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1223+ 6CF5 18 0F            jr   .on_ramp_slope    ; Se >= X_left, è sicuramente sulla pendenza rampa (non può superare 256)
1224+ 6CF7
1225+ 6CF7              .on_platform_right:
1226+ 6CF7                  ; Piattaforma adiacente! Restituisci PlayerY = (ramp_row - ramp_len + 1) * 8 - 16
1227+ 6CF7 3A F8 7D         ld   a, (ramp_row)
1228+ 6CFA 21 F7 7D         ld   hl, ramp_len
1229+ 6CFD 96               sub  (hl)
1230+ 6CFE 3C               inc  a                 ; A = Row
1231+ 6CFF 87               add  a, a              ; *2
1232+ 6D00 87               add  a, a              ; *4
1233+ 6D01 87               add  a, a              ; *8
1234+ 6D02 D6 10            sub  16                ; A = Row * 8 - 16
1235+ 6D04 37               scf                    ; Set carry (dentro rampa/piattaforma)
1236+ 6D05 C9               ret
1237+ 6D06
1238+ 6D06              .on_ramp_slope:
1239+ 6D06 3A F8 7D         ld   a, (ramp_row)
1240+ 6D09 87               add  a, a              ; *2
1241+ 6D0A 87               add  a, a              ; *4
1242+ 6D0B 87               add  a, a              ; *8
1243+ 6D0C D6 10            sub  16                ; A = ramp_row * 8 - 16
1244+ 6D0E 83               add  a, e              ; A = ramp_row * 8 - 16 + X_left
1245+ 6D0F 91               sub  c                 ; A = A - PlayerX
1246+ 6D10 57               ld   d, a              ; D = calculated Y
1247+ 6D11
1248+ 6D11                  ; H = platform_Y + 16 (confronto sicuro con offset +16)
1249+ 6D11 3A F8 7D         ld   a, (ramp_row)
1250+ 6D14 21 F7 7D         ld   hl, ramp_len
1251+ 6D17 96               sub  (hl)
1252+ 6D18 3C               inc  a                 ; A = Row
1253+ 6D19 87               add  a, a              ; *2
1254+ 6D1A 87               add  a, a              ; *4
1255+ 6D1B 87               add  a, a              ; *8
1256+ 6D1C 67               ld   h, a              ; H = platform_Y + 16
1257+ 6D1D
1258+ 6D1D 7A               ld   a, d              ; A = calculated Y
1259+ 6D1E C6 10            add  a, 16             ; A = calculated Y + 16
1260+ 6D20 BC               cp   h                 ; Compare (calculated Y + 16) con (platform_Y + 16)
1261+ 6D21 30 05            jr   nc, .no_clamp     ; Se calculated Y >= platform_Y, non limitare
