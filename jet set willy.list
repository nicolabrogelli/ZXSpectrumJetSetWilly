 956+ 8026 DD BE 05         cp   (ix+5)            ; Max Limit (Offset 5)
 957+ 8029 28 08            jr   z, .h_rev_left
 958+ 802B 30 06            jr   nc, .h_rev_left
 959+ 802D DD 77 02         ld   (ix+2), a
 960+ 8030 C3 85 80         jp   .next
