1434+ 79A6              ; Items_CheckCollision
1435+ 79A6              ;
1436+ 79A6              ; Controlla se Willy entra in collisione con uno degli item
1437+ 79A6              ; attivi presenti nella stanza corrente.
1438+ 79A6              ;
1439+ 79A6              ; Per ogni item:
1440+ 79A6              ;   - verifica che appartenga alla stanza corrente
1441+ 79A6              ;   - verifica che non sia già stato raccolto
1442+ 79A6              ;   - esegue il test di collisione con Willy
1443+ 79A6              ;
1444+ 79A6              ; Se l'item viene raccolto:
1445+ 79A6              ;   - imposta il flag "collected"
1446+ 79A6              ;   - rimuove l'item dalla cache items_grid
1447+ 79A6              ;   - incrementa il contatore degli oggetti raccolti
1448+ 79A6              ;   - aggiorna l'HUD
1449+ 79A6              ;   - ripristina il tile di sfondo
1450+ 79A6              ;   - riproduce il suono di raccolta
1451+ 79A6              ;
1452+ 79A6              ; Formato record ItemsTable:
1453+ 79A6              ;   +0 RoomID
1454+ 79A6              ;   +1 X
1455+ 79A6              ;   +2 Y
1456+ 79A6              ;   +3 Color
1457+ 79A6              ;   +4 Collected
1458+ 79A6              ;
1459+ 79A6              ; Fine tabella:
1460+ 79A6              ;   RoomID = $FF
1461+ 79A6              ; -------------------------------------------------------------------
1462+ 79A6              Items_CheckCollision:
1463+ 79A6
1464+ 79A6                  ; Salva i registri utilizzati
1465+ 79A6 E5               push hl
1466+ 79A7 D5               push de
1467+ 79A8 C5               push bc
1468+ 79A9
1469+ 79A9                  ; Inizio scansione della tabella degli item
1470+ 79A9 21 E1 74         ld   hl, ItemsTable
1471+ 79AC
1472+ 79AC              .loop:
1473+ 79AC
1474+ 79AC                  ; ---------------------------------------------------------------
1475+ 79AC                  ; Legge il Room ID dell'item corrente
1476+ 79AC                  ; ---------------------------------------------------------------
1477+ 79AC 7E               ld   a, (hl)
1478+ 79AD
1479+ 79AD                  ; $FF indica fine tabella
1480+ 79AD FE FF            cp   $FF
1481+ 79AF 28 4D            jr   z, .done
1482+ 79B1
1483+ 79B1                  ; ---------------------------------------------------------------
1484+ 79B1                  ; Verifica se l'item appartiene alla stanza corrente
1485+ 79B1                  ; ---------------------------------------------------------------
1486+ 79B1 57               ld   d, a              ; D = RoomID item
1487+ 79B2
1488+ 79B2 3A 5A 7E         ld   a, (current_room)
1489+ 79B5 BA               cp   d
1490+ 79B6
1491+ 79B6                  ; Se appartiene a un'altra stanza salta il record
1492+ 79B6 20 3F            jr   nz, .next_item
1493+ 79B8
1494+ 79B8                  ; ---------------------------------------------------------------
1495+ 79B8                  ; Legge coordinate e stato dell'item
1496+ 79B8                  ; ---------------------------------------------------------------
1497+ 79B8
1498+ 79B8 23               inc  hl
1499+ 79B9 4E               ld   c, (hl)           ; C = X
1500+ 79BA
1501+ 79BA 23               inc  hl
1502+ 79BB 46               ld   b, (hl)           ; B = Y
1503+ 79BC
1504+ 79BC 23               inc  hl                ; salta Color
1505+ 79BD
1506+ 79BD 23               inc  hl                ; punta a Collected
1507+ 79BE
1508+ 79BE 7E               ld   a, (hl)
1509+ 79BF
1510+ 79BF                  ; ---------------------------------------------------------------
1511+ 79BF                  ; Item già raccolto?
1512+ 79BF                  ; ---------------------------------------------------------------
1513+ 79BF B7               or   a
1514+ 79C0 20 39            jr   nz, .next_no_inc
1515+ 79C2
1516+ 79C2                  ; ---------------------------------------------------------------
1517+ 79C2                  ; Test collisione Willy ↔ Item
1518+ 79C2                  ;
1519+ 79C2                  ; Input richiesto:
1520+ 79C2                  ;   A = ItemX
1521+ 79C2                  ;   H = ItemY
1522+ 79C2                  ; ---------------------------------------------------------------
1523+ 79C2 79               ld   a, c
1524+ 79C3
1525+ 79C3 E5               push hl                ; salva puntatore al flag Collected
1526+ 79C4
1527+ 79C4 60               ld   h, b
1528+ 79C5
1529+ 79C5 CD 60 79         call CheckWillyItemCollision
1530+ 79C8
1531+ 79C8 E1               pop  hl
1532+ 79C9
1533+ 79C9                  ; Nessuna collisione
1534+ 79C9 30 30            jr   nc, .next_no_inc
1535+ 79CB
