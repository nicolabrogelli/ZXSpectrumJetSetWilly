 305+ 6D20
 306+ 6D20              ; -------------------------------------------------------------------
 307+ 6D20              ; DrawRoomItems
 308+ 6D20              ;
 309+ 6D20              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 310+ 6D20              ;
 311+ 6D20              ; Operazioni eseguite:
 312+ 6D20              ;   1. Azzera la griglia items_grid.
 313+ 6D20              ;   2. Svuota la cache degli oggetti attivi.
 314+ 6D20              ;   3. Scansiona ItemsTable.
 315+ 6D20              ;   4. Per ogni item della stanza corrente:
 316+ 6D20              ;        - verifica se è già stato raccolto
 317+ 6D20              ;        - disegna la grafica
 318+ 6D20              ;        - aggiorna items_grid
 319+ 6D20              ;        - memorizza l'item nella cache current_room_items
 320+ 6D20              ;   5. Aggiorna num_room_items.
 321+ 6D20              ;
 322+ 6D20              ; Record ItemsTable:
 323+ 6D20              ;   +0  Room ID
 324+ 6D20              ;   +1  X (colonna)
 325+ 6D20              ;   +2  Y (riga)
 326+ 6D20              ;   +3  Colore
 327+ 6D20              ;   +4  Collected flag
 328+ 6D20              ;
 329+ 6D20              ; Cache current_room_items:
 330+ 6D20              ;   +0  Colonna
 331+ 6D20              ;   +1  Riga
 332+ 6D20              ;   +2  Colore
 333+ 6D20              ;   +3  Collected flag ptr (Low)
 334+ 6D20              ;   +4  Collected flag ptr (High)
 335+ 6D20              ;
 336+ 6D20              ; Ogni record cache occupa 5 byte.
 337+ 6D20              ; -------------------------------------------------------------------
 338+ 6D20              DrawRoomItems:
 339+ 6D20
 340+ 6D20                  ; Salva tutti i registri utilizzati
 341+ 6D20 E5               push hl
 342+ 6D21 D5               push de
 343+ 6D22 C5               push bc
 344+ 6D23 DD E5            push ix
 345+ 6D25 FD E5            push iy
 346+ 6D27
 347+ 6D27                  ; ---------------------------------------------------------------
 348+ 6D27                  ; Azzera items_grid (32 x 16 = 512 byte)
 349+ 6D27                  ; ---------------------------------------------------------------
 350+ 6D27 21 00 90         ld   hl, items_grid
 351+ 6D2A 11 01 90         ld   de, items_grid + 1
 352+ 6D2D 36 00            ld   (hl), 0
 353+ 6D2F 01 FF 01         ld   bc, 511
 354+ 6D32 ED B0            ldir
 355+ 6D34
 356+ 6D34                  ; ---------------------------------------------------------------
 357+ 6D34                  ; Nessun item attivo nella stanza
 358+ 6D34                  ; ---------------------------------------------------------------
 359+ 6D34 AF               xor  a
 360+ 6D35 32 B1 7E         ld   (num_room_items), a
 361+ 6D38
 362+ 6D38                  ; IY punta alla cache degli item attivi
 363+ 6D38 FD 21 61 7E      ld   iy, current_room_items
 364+ 6D3C
 365+ 6D3C                  ; ---------------------------------------------------------------
 366+ 6D3C                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 367+ 6D3C                  ; alla stanza corrente.
 368+ 6D3C                  ;
 369+ 6D3C                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 370+ 6D3C                  ; ---------------------------------------------------------------
 371+ 6D3C 2A B2 7E         ld   hl, (room_ptr)
 372+ 6D3F 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 373+ 6D42 19               add  hl, de
 374+ 6D43
 375+ 6D43 E5               push hl
 376+ 6D44 DD E1            pop  ix                ; IX = bitmap item
 377+ 6D46
 378+ 6D46                  ; ---------------------------------------------------------------
 379+ 6D46                  ; Inizio scansione della tabella degli item
 380+ 6D46                  ; ---------------------------------------------------------------
 381+ 6D46 21 E0 6B         ld   hl, ItemsTable
 382+ 6D49
 383+ 6D49              .loop:
 384+ 6D49
 385+ 6D49                  ; ---------------------------------------------------------------
 386+ 6D49                  ; Legge il Room ID del record corrente
 387+ 6D49                  ; ---------------------------------------------------------------
 388+ 6D49 7E               ld   a, (hl)
 389+ 6D4A
 390+ 6D4A                  ; $FF indica fine tabella
 391+ 6D4A FE FF            cp   $FF
 392+ 6D4C 28 53            jr   z, .done
 393+ 6D4E
 394+ 6D4E                  ; ---------------------------------------------------------------
 395+ 6D4E                  ; Verifica se l'item appartiene alla stanza corrente
 396+ 6D4E                  ; ---------------------------------------------------------------
 397+ 6D4E 57               ld   d, a
 398+ 6D4F
 399+ 6D4F 3A 58 7E         ld   a, (current_room)
 400+ 6D52 BA               cp   d
 401+ 6D53 20 45            jr   nz, .next_item
 402+ 6D55
 403+ 6D55                  ; ---------------------------------------------------------------
 404+ 6D55                  ; Legge i dati dell'item
 405+ 6D55                  ; ---------------------------------------------------------------
 406+ 6D55
 407+ 6D55 23               inc  hl
 408+ 6D56 4E               ld   c, (hl)           ; X (colonna)
 409+ 6D57
 410+ 6D57 23               inc  hl
 411+ 6D58 46               ld   b, (hl)           ; Y (riga)
 412+ 6D59
 413+ 6D59 23               inc  hl
 414+ 6D5A 5E               ld   e, (hl)           ; Colore
 415+ 6D5B
 416+ 6D5B 23               inc  hl
 417+ 6D5C 7E               ld   a, (hl)           ; Collected flag
 418+ 6D5D
 419+ 6D5D                  ; Se diverso da zero l'item è già stato raccolto
 420+ 6D5D B7               or   a
 421+ 6D5E 20 3E            jr   nz, .next_no_inc
 422+ 6D60
 423+ 6D60                  ; ---------------------------------------------------------------
 424+ 6D60                  ; Disegna l'item sullo schermo
 425+ 6D60                  ;
 426+ 6D60                  ; B = Row
 427+ 6D60                  ; C = Column
 428+ 6D60                  ; HL = bitmap pointer
 429+ 6D60                  ; E = Color
 430+ 6D60                  ; ---------------------------------------------------------------
 431+ 6D60 E5               push hl
 432+ 6D61
 433+ 6D61 DD E5            push ix
 434+ 6D63 E1               pop  hl
 435+ 6D64
 436+ 6D64 CD A9 6D         call DrawItemGraphic
 437+ 6D67
 438+ 6D67 E1               pop  hl                ; ritorna al flag collected
 439+ 6D68
 440+ 6D68                  ; ---------------------------------------------------------------
 441+ 6D68                  ; Aggiorna items_grid
 442+ 6D68                  ;
 443+ 6D68                  ; Calcolo:
 444+ 6D68                  ;   offset = Row * 32 + Col
 445+ 6D68                  ; ---------------------------------------------------------------
 446+ 6D68 E5               push hl
 447+ 6D69 D5               push de
 448+ 6D6A
 449+ 6D6A 26 00            ld   h, 0
 450+ 6D6C 68               ld   l, b              ; HL = Row
 451+ 6D6D
 452+ 6D6D 29               add  hl, hl            ; *2
 453+ 6D6E 29               add  hl, hl            ; *4
 454+ 6D6F 29               add  hl, hl            ; *8
 455+ 6D70 29               add  hl, hl            ; *16
 456+ 6D71 29               add  hl, hl            ; *32
 457+ 6D72
 458+ 6D72 16 00            ld   d, 0
 459+ 6D74 59               ld   e, c              ; DE = Col
 460+ 6D75
 461+ 6D75 19               add  hl, de            ; Row*32 + Col
 462+ 6D76
 463+ 6D76 11 00 90         ld   de, items_grid
 464+ 6D79 19               add  hl, de            ; puntatore nella griglia
 465+ 6D7A
 466+ 6D7A D1               pop  de                ; ripristina colore
 467+ 6D7B
 468+ 6D7B 73               ld   (hl), e           ; salva colore cella
 469+ 6D7C
 470+ 6D7C E1               pop  hl
 471+ 6D7D
 472+ 6D7D                  ; ---------------------------------------------------------------
 473+ 6D7D                  ; Salva l'item nella cache della stanza
 474+ 6D7D                  ;
 475+ 6D7D                  ; Questo evita di dover scansionare tutta ItemsTable
 476+ 6D7D                  ; durante il controllo delle collisioni.
 477+ 6D7D                  ; ---------------------------------------------------------------
 478+ 6D7D
 479+ 6D7D FD 71 00         ld   (iy+0), c         ; Colonna
 480+ 6D80 FD 70 01         ld   (iy+1), b         ; Riga
 481+ 6D83 FD 73 02         ld   (iy+2), e         ; Colore
 482+ 6D86
 483+ 6D86                  ; Salva il puntatore al flag "collected"
 484+ 6D86 FD 75 03         ld   (iy+3), l         ; Low byte
 485+ 6D89 FD 74 04         ld   (iy+4), h         ; High byte
 486+ 6D8C
 487+ 6D8C                  ; Passa al record successivo della cache
 488+ 6D8C 01 05 00         ld   bc, 5
 489+ 6D8F FD 09            add  iy, bc
 490+ 6D91
 491+ 6D91                  ; Incrementa il numero di item attivi
 492+ 6D91 3A B1 7E         ld   a, (num_room_items)
 493+ 6D94 3C               inc  a
 494+ 6D95 32 B1 7E         ld   (num_room_items), a
 495+ 6D98
 496+ 6D98 18 04            jr   .next_no_inc
 497+ 6D9A
 498+ 6D9A              .next_item:
 499+ 6D9A
 500+ 6D9A                  ; ---------------------------------------------------------------
 501+ 6D9A                  ; L'item non appartiene alla stanza corrente.
 502+ 6D9A                  ; Salta i campi del record:
 503+ 6D9A                  ;   X
 504+ 6D9A                  ;   Y
 505+ 6D9A                  ;   Color
 506+ 6D9A                  ;   Collected
 507+ 6D9A                  ; ---------------------------------------------------------------
 508+ 6D9A 23               inc  hl
 509+ 6D9B 23               inc  hl
 510+ 6D9C 23               inc  hl
 511+ 6D9D 23               inc  hl
 512+ 6D9E
 513+ 6D9E              .next_no_inc:
 514+ 6D9E
 515+ 6D9E                  ; ---------------------------------------------------------------
 516+ 6D9E                  ; Avanza al record successivo
 517+ 6D9E                  ; (prossimo Room ID)
 518+ 6D9E                  ; ---------------------------------------------------------------
 519+ 6D9E 23               inc  hl
 520+ 6D9F 18 A8            jr   .loop
 521+ 6DA1
 522+ 6DA1              .done:
 523+ 6DA1
 524+ 6DA1                  ; Ripristina i registri
 525+ 6DA1 FD E1            pop  iy
 526+ 6DA3 DD E1            pop  ix
 527+ 6DA5 D1               pop  de
 528+ 6DA6 C1               pop  bc
 529+ 6DA7 E1               pop  hl
 530+ 6DA8
 531+ 6DA8 C9               ret
 532+ 6DA9
 533+ 6DA9              ; -------------------------------------------------------------------
 534+ 6DA9              ; DrawItemGraphic
 535+ 6DA9              ;
 536+ 6DA9              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 537+ 6DA9              ; utilizzando una bitmap di 8 byte e un attributo colore.
 538+ 6DA9              ;
 539+ 6DA9              ; Input:
 540+ 6DA9              ;   B = Riga attributi (3..18)
 541+ 6DA9              ;   C = Colonna attributi (0..31)
 542+ 6DA9              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 543+ 6DA9              ;   E = Attributo colore
 544+ 6DA9              ;
 545+ 6DA9              ; Output:
 546+ 6DA9              ;   Nessuno
 547+ 6DA9              ;
 548+ 6DA9              ; Registri preservati:
 549+ 6DA9              ;   BC, DE, HL
 550+ 6DA9              ; -------------------------------------------------------------------
 551+ 6DA9              DrawItemGraphic:
 552+ 6DA9
 553+ 6DA9                  ; Salva i registri originali
 554+ 6DA9 C5               push bc
 555+ 6DAA D5               push de
 556+ 6DAB E5               push hl
 557+ 6DAC
 558+ 6DAC                  ; ---------------------------------------------------------------
 559+ 6DAC                  ; Calcolo indirizzo bitmap dello Spectrum
 560+ 6DAC                  ;
 561+ 6DAC                  ; Ogni item occupa una cella attributi (8x8 pixel).
 562+ 6DAC                  ;
 563+ 6DAC                  ; Formula:
 564+ 6DAC                  ;   High = $40 + (Row AND $18)
 565+ 6DAC                  ;   Low  = (Row AND 7) * 32 + Col
 566+ 6DAC                  ;
 567+ 6DAC                  ; DE conterrà l'indirizzo della prima scanline.
 568+ 6DAC                  ; ---------------------------------------------------------------
 569+ 6DAC
 570+ 6DAC 78               ld   a, b
 571+ 6DAD E6 18            and  $18
 572+ 6DAF C6 40            add  a, $40
 573+ 6DB1 57               ld   d, a              ; Byte alto indirizzo video
 574+ 6DB2
 575+ 6DB2 78               ld   a, b
 576+ 6DB3 E6 07            and  7                 ; Riga interna al blocco da 8
 577+ 6DB5
 578+ 6DB5 87               add  a, a              ; *2
 579+ 6DB6 87               add  a, a              ; *4
 580+ 6DB7 87               add  a, a              ; *8
 581+ 6DB8 87               add  a, a              ; *16
 582+ 6DB9 87               add  a, a              ; *32
 583+ 6DBA
 584+ 6DBA 81               add  a, c              ; + colonna
 585+ 6DBB
 586+ 6DBB 5F               ld   e, a              ; Byte basso indirizzo video
 587+ 6DBC
 588+ 6DBC                  ; ---------------------------------------------------------------
 589+ 6DBC                  ; Disegno bitmap
 590+ 6DBC                  ;
 591+ 6DBC                  ; Copia 8 byte consecutivi nella memoria video.
 592+ 6DBC                  ; Ogni byte rappresenta una scanline da 8 pixel.
 593+ 6DBC                  ; ---------------------------------------------------------------
 594+ 6DBC
 595+ 6DBC C5               push bc                ; Conserva Row e Col
 596+ 6DBD
 597+ 6DBD 06 08            ld   b, 8              ; Numero scanline
 598+ 6DBF
 599+ 6DBF              .line_loop:
 600+ 6DBF
 601+ 6DBF 7E               ld   a, (hl)           ; Legge scanline bitmap
 602+ 6DC0 12               ld   (de), a           ; Scrive nella memoria video
 603+ 6DC1
 604+ 6DC1 14               inc  d                 ; Scanline successiva
 605+ 6DC2 23               inc  hl                ; Byte bitmap successivo
 606+ 6DC3
 607+ 6DC3 05               dec  b
 608+ 6DC4 20 F9            jr   nz, .line_loop
 609+ 6DC6
 610+ 6DC6 C1               pop  bc                ; Ripristina Row e Col
 611+ 6DC7
 612+ 6DC7                  ; ---------------------------------------------------------------
 613+ 6DC7                  ; Calcolo indirizzo attributo
 614+ 6DC7                  ;
 615+ 6DC7                  ; Formula:
 616+ 6DC7                  ;   AttrAddr = $5800 + Row * 32 + Col
 617+ 6DC7                  ;
 618+ 6DC7                  ; HL conterrà l'indirizzo della cella attributi.
 619+ 6DC7                  ; ---------------------------------------------------------------
 620+ 6DC7
 621+ 6DC7 26 00            ld   h, 0
 622+ 6DC9 68               ld   l, b              ; HL = Row
 623+ 6DCA
 624+ 6DCA 29               add  hl, hl            ; *2
 625+ 6DCB 29               add  hl, hl            ; *4
 626+ 6DCC 29               add  hl, hl            ; *8
 627+ 6DCD 29               add  hl, hl            ; *16
 628+ 6DCE 29               add  hl, hl            ; *32
 629+ 6DCF
 630+ 6DCF 79               ld   a, c              ; A = Colonna
 631+ 6DD0
 632+ 6DD0 85               add  a, l
 633+ 6DD1 6F               ld   l, a
 634+ 6DD2
 635+ 6DD2 30 01            jr   nc, .no_carry
 636+ 6DD4 24               inc  h
 637+ 6DD5
 638+ 6DD5              .no_carry:
 639+ 6DD5
 640+ 6DD5                  ; HL = Row * 32 + Col
 641+ 6DD5
 642+ 6DD5 11 00 58         ld   de, $5800
 643+ 6DD8 19               add  hl, de            ; HL = indirizzo attributi
 644+ 6DD9
 645+ 6DD9                  ; ---------------------------------------------------------------
 646+ 6DD9                  ; Recupera il colore originale dallo stack.
 647+ 6DD9                  ;
 648+ 6DD9                  ; Layout stack:
 649+ 6DD9                  ;   HL originale
 650+ 6DD9                  ;   DE originale (E = colore)
 651+ 6DD9                  ;   BC originale
 652+ 6DD9                  ; ---------------------------------------------------------------
 653+ 6DD9
 654+ 6DD9 C1               pop  bc                ; Recupera HL originale
 655+ 6DDA D1               pop  de                ; Recupera DE originale
 656+ 6DDB
 657+ 6DDB                  ; ---------------------------------------------------------------
 658+ 6DDB                  ; Scrive l'attributo colore
 659+ 6DDB                  ; ---------------------------------------------------------------
 660+ 6DDB
 661+ 6DDB 7B               ld   a, e              ; A = colore
 662+ 6DDC 77               ld   (hl), a           ; Scrive nella RAM attributi
 663+ 6DDD
 664+ 6DDD                  ; ---------------------------------------------------------------
 665+ 6DDD                  ; Ripristina HL e BC originali
 666+ 6DDD                  ; ---------------------------------------------------------------
 667+ 6DDD
 668+ 6DDD C5               push bc
 669+ 6DDE E1               pop  hl                ; HL originale
 670+ 6DDF
 671+ 6DDF C1               pop  bc                ; BC originale
 672+ 6DE0
 673+ 6DE0 C9               ret
 674+ 6DE1
 675+ 6DE1              ; -------------------------------------------------------------------
 676+ 6DE1              ; RestoreBackgroundCell
 677+ 6DE1              ;
 678+ 6DE1              ; Ripristina il contenuto originale di una cella della stanza.
 679+ 6DE1              ; Viene utilizzata principalmente quando un item viene raccolto:
 680+ 6DE1              ; invece di lasciare un "buco", la routine ridisegna il tile
 681+ 6DE1              ; originale presente nella mappa della stanza.
 682+ 6DE1              ;
 683+ 6DE1              ; Input:
 684+ 6DE1              ;   B = Row (3..18)
 685+ 6DE1              ;   C = Col (0..31)
 686+ 6DE1              ;
 687+ 6DE1              ; Utilizza:
 688+ 6DE1              ;   room_ptr -> struttura dati della stanza corrente
 689+ 6DE1              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 690+ 6DE1              ;   DrawTile -> ridisegna il tile selezionato
 691+ 6DE1              ;
 692+ 6DE1              ; Tipi di cella:
 693+ 6DE1              ;   0 = Background
 694+ 6DE1              ;   1 = Floor
 695+ 6DE1              ;   2 = Wall
 696+ 6DE1              ;   3 = Nasty
 697+ 6DE1              ; -------------------------------------------------------------------
 698+ 6DE1              RestoreBackgroundCell:
 699+ 6DE1
 700+ 6DE1                  ; Salva tutti i registri utilizzati
 701+ 6DE1 FD E5            push iy
 702+ 6DE3 C5               push bc
 703+ 6DE4 D5               push de
 704+ 6DE5 E5               push hl
 705+ 6DE6 DD E5            push ix
 706+ 6DE8
 707+ 6DE8                  ; ---------------------------------------------------------------
 708+ 6DE8                  ; Conserva Row e Col in IY.
 709+ 6DE8                  ;
 710+ 6DE8                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 711+ 6DE8                  ; BC potrebbe essere modificato.
 712+ 6DE8                  ; ---------------------------------------------------------------
 713+ 6DE8 C5               push bc
 714+ 6DE9 FD E1            pop  iy                ; IYH = Row, IYL = Col
 715+ 6DEB
 716+ 6DEB                  ; ---------------------------------------------------------------
 717+ 6DEB                  ; Determina quale tipo di cella è presente nella posizione
 718+ 6DEB                  ; specificata.
 719+ 6DEB                  ;
 720+ 6DEB                  ; Input:
 721+ 6DEB                  ;   B = Row
 722+ 6DEB                  ;   C = Col
 723+ 6DEB                  ;
 724+ 6DEB                  ; Output:
 725+ 6DEB                  ;   A = tipo cella
 726+ 6DEB                  ; ---------------------------------------------------------------
 727+ 6DEB 78               ld   a, b
 728+ 6DEC
 729+ 6DEC CD B8 68         call GetCellFromUnpacked
 730+ 6DEF
 731+ 6DEF                  ; ---------------------------------------------------------------
 732+ 6DEF                  ; Recupera il puntatore alla stanza corrente.
 733+ 6DEF                  ;
 734+ 6DEF                  ; DE = base della struttura stanza
 735+ 6DEF                  ; ---------------------------------------------------------------
 736+ 6DEF ED 5B B2 7E      ld   de, (room_ptr)
 737+ 6DF3
 738+ 6DF3                  ; ---------------------------------------------------------------
 739+ 6DF3                  ; Seleziona il tile corretto in base al tipo di cella.
 740+ 6DF3                  ;
 741+ 6DF3                  ; A = 0 -> Background
 742+ 6DF3                  ; A = 1 -> Floor
 743+ 6DF3                  ; A = 2 -> Wall
 744+ 6DF3                  ; A = 3 -> Nasty
 745+ 6DF3                  ; ---------------------------------------------------------------
 746+ 6DF3
 747+ 6DF3 B7               or   a
 748+ 6DF4 20 06            jr   nz, .not_bg
 749+ 6DF6
 750+ 6DF6                  ; Background
 751+ 6DF6 21 A0 00         ld   hl, OFFSET_BG
 752+ 6DF9 19               add  hl, de
 753+ 6DFA 18 16            jr   .draw_cell
 754+ 6DFC
 755+ 6DFC              .not_bg:
 756+ 6DFC
 757+ 6DFC 3D               dec  a
 758+ 6DFD 20 06            jr   nz, .not_floor
 759+ 6DFF
 760+ 6DFF                  ; Floor
 761+ 6DFF 21 A9 00         ld   hl, OFFSET_FLOOR
 762+ 6E02 19               add  hl, de
 763+ 6E03 18 0D            jr   .draw_cell
 764+ 6E05
 765+ 6E05              .not_floor:
 766+ 6E05
 767+ 6E05 3D               dec  a
 768+ 6E06 20 06            jr   nz, .not_wall
 769+ 6E08
 770+ 6E08                  ; Wall
 771+ 6E08 21 B2 00         ld   hl, OFFSET_WALL
 772+ 6E0B 19               add  hl, de
 773+ 6E0C 18 04            jr   .draw_cell
 774+ 6E0E
 775+ 6E0E              .not_wall:
 776+ 6E0E
 777+ 6E0E                  ; Nasty
 778+ 6E0E 21 BB 00         ld   hl, OFFSET_NASTY
 779+ 6E11 19               add  hl, de
 780+ 6E12
 781+ 6E12              .draw_cell:
 782+ 6E12
 783+ 6E12                  ; ---------------------------------------------------------------
 784+ 6E12                  ; HL punta ora alla grafica del tile da ridisegnare.
 785+ 6E12                  ;
 786+ 6E12                  ; DrawTile si aspetta:
 787+ 6E12                  ;   IX = puntatore tile
 788+ 6E12                  ;   B  = Row
 789+ 6E12                  ;   C  = Col
 790+ 6E12                  ; ---------------------------------------------------------------
 791+ 6E12 E5               push hl
 792+ 6E13 DD E1            pop  ix
 793+ 6E15
 794+ 6E15                  ; Ripristina Row e Col salvati in IY
 795+ 6E15 FD E5            push iy
 796+ 6E17 C1               pop  bc
 797+ 6E18
 798+ 6E18                  ; Disegna il tile originale
 799+ 6E18 CD 8C 61         call DrawTile
 800+ 6E1B
 801+ 6E1B                  ; ---------------------------------------------------------------
 802+ 6E1B                  ; Ripristina i registri salvati
 803+ 6E1B                  ; ---------------------------------------------------------------
 804+ 6E1B DD E1            pop  ix
 805+ 6E1D E1               pop  hl
 806+ 6E1E D1               pop  de
 807+ 6E1F C1               pop  bc
 808+ 6E20 FD E1            pop  iy
 809+ 6E22
 810+ 6E22 C9               ret
 811+ 6E23
 812+ 6E23              ; -------------------------------------------------------------------
 813+ 6E23              ; CheckWillyItemCollision
 814+ 6E23              ;
 815+ 6E23              ; Verifica se Willy collide con un item utilizzando il controllo
 816+ 6E23              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 817+ 6E23              ;
 818+ 6E23              ; Input:
 819+ 6E23              ;   A = ItemX (colonna attributi 0..31)
 820+ 6E23              ;   H = ItemY (riga attributi 3..18)
 821+ 6E23              ;
 822+ 6E23              ; Coordinate item:
 823+ 6E23              ;   Ogni item occupa una cella da 8x8 pixel.
 824+ 6E23              ;
 825+ 6E23              ; Coordinate Willy:
 826+ 6E23              ;   Willy occupa un rettangolo di 16x16 pixel.
 827+ 6E23              ;
 828+ 6E23              ; Output:
 829+ 6E23              ;   Carry Set   = collisione rilevata
 830+ 6E23              ;   Carry Clear = nessuna collisione
 831+ 6E23              ;
 832+ 6E23              ; Registri preservati:
 833+ 6E23              ;   BC, DE, HL
 834+ 6E23              ; -------------------------------------------------------------------
 835+ 6E23              CheckWillyItemCollision:
 836+ 6E23
 837+ 6E23                  ; Salva i registri utilizzati
 838+ 6E23 C5               push bc
 839+ 6E24 D5               push de
 840+ 6E25 E5               push hl
 841+ 6E26
 842+ 6E26                  ; ---------------------------------------------------------------
 843+ 6E26                  ; Calcola il bounding box orizzontale dell'item
 844+ 6E26                  ;
 845+ 6E26                  ; ItemLeft  = ItemX * 8
 846+ 6E26                  ; ItemRight = ItemLeft + 7
 847+ 6E26                  ;
 848+ 6E26                  ; E = ItemLeft
 849+ 6E26                  ; D = ItemRight
 850+ 6E26                  ; ---------------------------------------------------------------
 851+ 6E26 6F               ld   l, a              ; L = ItemX
 852+ 6E27
 853+ 6E27 7D               ld   a, l
 854+ 6E28 87               add  a, a              ; *2
 855+ 6E29 87               add  a, a              ; *4
 856+ 6E2A 87               add  a, a              ; *8
 857+ 6E2B
 858+ 6E2B 5F               ld   e, a              ; E = ItemLeft
 859+ 6E2C
 860+ 6E2C C6 07            add  a, 7
 861+ 6E2E 57               ld   d, a              ; D = ItemRight
 862+ 6E2F
 863+ 6E2F                  ; ---------------------------------------------------------------
 864+ 6E2F                  ; Recupera la posizione corrente di Willy
 865+ 6E2F                  ;
 866+ 6E2F                  ; B = WillyY
 867+ 6E2F                  ; C = WillyX
 868+ 6E2F                  ; ---------------------------------------------------------------
 869+ 6E2F ED 4B 44 7B      ld   bc, (PlayerPos)
 870+ 6E33
 871+ 6E33                  ; ---------------------------------------------------------------
 872+ 6E33                  ; Primo test:
 873+ 6E33                  ;
 874+ 6E33                  ; WillyLeft <= ItemRight
 875+ 6E33                  ;
 876+ 6E33                  ; Se Willy è completamente a destra dell'item
 877+ 6E33                  ; non può esserci collisione.
 878+ 6E33                  ; ---------------------------------------------------------------
 879+ 6E33 79               ld   a, c              ; A = WillyLeft
 880+ 6E34
 881+ 6E34 BA               cp   d                 ; WillyLeft vs ItemRight
 882+ 6E35
 883+ 6E35 28 04            jr   z, .x_ok
 884+ 6E37 38 02            jr   c, .x_ok
 885+ 6E39
 886+ 6E39 18 29            jr   .no_collision
 887+ 6E3B
 888+ 6E3B              .x_ok:
 889+ 6E3B
 890+ 6E3B                  ; ---------------------------------------------------------------
 891+ 6E3B                  ; Secondo test:
 892+ 6E3B                  ;
 893+ 6E3B                  ; WillyRight >= ItemLeft
 894+ 6E3B                  ;
 895+ 6E3B                  ; WillyRight = WillyX + 7
 896+ 6E3B                  ; ---------------------------------------------------------------
 897+ 6E3B C6 07            add  a, 7
 898+ 6E3D
 899+ 6E3D BB               cp   e                 ; WillyRight vs ItemLeft
 900+ 6E3E
 901+ 6E3E 28 04            jr   z, .y_check
 902+ 6E40 30 02            jr   nc, .y_check
 903+ 6E42
 904+ 6E42 18 20            jr   .no_collision
 905+ 6E44
 906+ 6E44              .y_check:
 907+ 6E44
 908+ 6E44                  ; ---------------------------------------------------------------
 909+ 6E44                  ; Recupera ItemY dal valore originale di HL
 910+ 6E44                  ;
 911+ 6E44                  ; H contiene la riga dell'item.
 912+ 6E44                  ; ---------------------------------------------------------------
 913+ 6E44 E1               pop  hl
 914+ 6E45 E5               push hl
 915+ 6E46
 916+ 6E46                  ; ---------------------------------------------------------------
 917+ 6E46                  ; Calcola il bounding box verticale dell'item
 918+ 6E46                  ;
 919+ 6E46                  ; ItemTop    = ItemY * 8
 920+ 6E46                  ; ItemBottom = ItemTop + 7
 921+ 6E46                  ;
 922+ 6E46                  ; E = ItemTop
 923+ 6E46                  ; D = ItemBottom
 924+ 6E46                  ; ---------------------------------------------------------------
 925+ 6E46 7C               ld   a, h
 926+ 6E47
 927+ 6E47 87               add  a, a              ; *2
 928+ 6E48 87               add  a, a              ; *4
 929+ 6E49 87               add  a, a              ; *8
 930+ 6E4A
 931+ 6E4A 5F               ld   e, a              ; ItemTop
 932+ 6E4B
 933+ 6E4B C6 07            add  a, 7
 934+ 6E4D 57               ld   d, a              ; ItemBottom
 935+ 6E4E
 936+ 6E4E                  ; ---------------------------------------------------------------
 937+ 6E4E                  ; Primo test verticale:
 938+ 6E4E                  ;
 939+ 6E4E                  ; WillyTop <= ItemBottom
 940+ 6E4E                  ; ---------------------------------------------------------------
 941+ 6E4E 78               ld   a, b              ; WillyTop
 942+ 6E4F
 943+ 6E4F BA               cp   d
 944+ 6E50
 945+ 6E50 28 04            jr   z, .y_ok
 946+ 6E52 38 02            jr   c, .y_ok
 947+ 6E54
 948+ 6E54 18 0E            jr   .no_collision
 949+ 6E56
 950+ 6E56              .y_ok:
 951+ 6E56
 952+ 6E56                  ; ---------------------------------------------------------------
 953+ 6E56                  ; Secondo test verticale:
 954+ 6E56                  ;
 955+ 6E56                  ; WillyBottom >= ItemTop
 956+ 6E56                  ;
 957+ 6E56                  ; WillyBottom = WillyY + 15
 958+ 6E56                  ; ---------------------------------------------------------------
 959+ 6E56 C6 0F            add  a, 15
 960+ 6E58
 961+ 6E58 BB               cp   e
 962+ 6E59
 963+ 6E59 28 04            jr   z, .collision
 964+ 6E5B 30 02            jr   nc, .collision
 965+ 6E5D
 966+ 6E5D 18 05            jr   .no_collision
 967+ 6E5F
 968+ 6E5F              .collision:
 969+ 6E5F
 970+ 6E5F                  ; ---------------------------------------------------------------
 971+ 6E5F                  ; Collisione rilevata
 972+ 6E5F                  ; ---------------------------------------------------------------
 973+ 6E5F E1               pop  hl
 974+ 6E60 D1               pop  de
 975+ 6E61 C1               pop  bc
 976+ 6E62
 977+ 6E62 37               scf                    ; Carry = 1
 978+ 6E63
 979+ 6E63 C9               ret
 980+ 6E64
 981+ 6E64              .no_collision:
 982+ 6E64
 983+ 6E64                  ; ---------------------------------------------------------------
 984+ 6E64                  ; Nessuna collisione
 985+ 6E64                  ; ---------------------------------------------------------------
 986+ 6E64 E1               pop  hl
 987+ 6E65 D1               pop  de
 988+ 6E66 C1               pop  bc
 989+ 6E67
 990+ 6E67 B7               or   a                 ; Carry = 0
 991+ 6E68
 992+ 6E68 C9               ret
 993+ 6E69
 994+ 6E69              ; -------------------------------------------------------------------
 995+ 6E69              ; CheckRoomItemsCollision
 996+ 6E69              ;
 997+ 6E69              ; Controlla se Willy entra in collisione con uno degli item
 998+ 6E69              ; attivi presenti nella stanza corrente.
 999+ 6E69              ;
1000+ 6E69              ; Per ogni item:
1001+ 6E69              ;   - verifica che appartenga alla stanza corrente
1002+ 6E69              ;   - verifica che non sia già stato raccolto
1003+ 6E69              ;   - esegue il test di collisione con Willy
1004+ 6E69              ;
1005+ 6E69              ; Se l'item viene raccolto:
1006+ 6E69              ;   - imposta il flag "collected"
1007+ 6E69              ;   - rimuove l'item dalla cache items_grid
1008+ 6E69              ;   - incrementa il contatore degli oggetti raccolti
1009+ 6E69              ;   - aggiorna l'HUD
1010+ 6E69              ;   - ripristina il tile di sfondo
1011+ 6E69              ;   - riproduce il suono di raccolta
1012+ 6E69              ;
1013+ 6E69              ; Formato record ItemsTable:
1014+ 6E69              ;   +0 RoomID
1015+ 6E69              ;   +1 X
1016+ 6E69              ;   +2 Y
1017+ 6E69              ;   +3 Color
1018+ 6E69              ;   +4 Collected
1019+ 6E69              ;
1020+ 6E69              ; Fine tabella:
1021+ 6E69              ;   RoomID = $FF
1022+ 6E69              ; -------------------------------------------------------------------
1023+ 6E69              CheckRoomItemsCollision:
1024+ 6E69
1025+ 6E69                  ; Salva i registri utilizzati
1026+ 6E69 E5               push hl
1027+ 6E6A D5               push de
1028+ 6E6B C5               push bc
1029+ 6E6C
1030+ 6E6C                  ; Inizio scansione della tabella degli item
1031+ 6E6C 21 E0 6B         ld   hl, ItemsTable
1032+ 6E6F
1033+ 6E6F              .loop:
1034+ 6E6F
1035+ 6E6F                  ; ---------------------------------------------------------------
1036+ 6E6F                  ; Legge il Room ID dell'item corrente
1037+ 6E6F                  ; ---------------------------------------------------------------
1038+ 6E6F 7E               ld   a, (hl)
1039+ 6E70
1040+ 6E70                  ; $FF indica fine tabella
1041+ 6E70 FE FF            cp   $FF
1042+ 6E72 28 4D            jr   z, .done
1043+ 6E74
1044+ 6E74                  ; ---------------------------------------------------------------
1045+ 6E74                  ; Verifica se l'item appartiene alla stanza corrente
1046+ 6E74                  ; ---------------------------------------------------------------
1047+ 6E74 57               ld   d, a              ; D = RoomID item
1048+ 6E75
1049+ 6E75 3A 58 7E         ld   a, (current_room)
1050+ 6E78 BA               cp   d
1051+ 6E79
1052+ 6E79                  ; Se appartiene a un'altra stanza salta il record
1053+ 6E79 20 3F            jr   nz, .next_item
1054+ 6E7B
1055+ 6E7B                  ; ---------------------------------------------------------------
1056+ 6E7B                  ; Legge coordinate e stato dell'item
1057+ 6E7B                  ; ---------------------------------------------------------------
1058+ 6E7B
1059+ 6E7B 23               inc  hl
1060+ 6E7C 4E               ld   c, (hl)           ; C = X
1061+ 6E7D
1062+ 6E7D 23               inc  hl
1063+ 6E7E 46               ld   b, (hl)           ; B = Y
1064+ 6E7F
1065+ 6E7F 23               inc  hl                ; salta Color
1066+ 6E80
1067+ 6E80 23               inc  hl                ; punta a Collected
1068+ 6E81
1069+ 6E81 7E               ld   a, (hl)
1070+ 6E82
1071+ 6E82                  ; ---------------------------------------------------------------
1072+ 6E82                  ; Item già raccolto?
1073+ 6E82                  ; ---------------------------------------------------------------
1074+ 6E82 B7               or   a
1075+ 6E83 20 39            jr   nz, .next_no_inc
1076+ 6E85
1077+ 6E85                  ; ---------------------------------------------------------------
1078+ 6E85                  ; Test collisione Willy ↔ Item
1079+ 6E85                  ;
1080+ 6E85                  ; Input richiesto:
1081+ 6E85                  ;   A = ItemX
1082+ 6E85                  ;   H = ItemY
1083+ 6E85                  ; ---------------------------------------------------------------
1084+ 6E85 79               ld   a, c
1085+ 6E86
1086+ 6E86 E5               push hl                ; salva puntatore al flag Collected
1087+ 6E87
1088+ 6E87 60               ld   h, b
1089+ 6E88
1090+ 6E88 CD 23 6E         call CheckWillyItemCollision
1091+ 6E8B
1092+ 6E8B E1               pop  hl
1093+ 6E8C
1094+ 6E8C                  ; Nessuna collisione
1095+ 6E8C 30 30            jr   nc, .next_no_inc
1096+ 6E8E
1097+ 6E8E                  ; ===============================================================
1098+ 6E8E                  ; ITEM RACCOLTO
1099+ 6E8E                  ; ===============================================================
1100+ 6E8E
1101+ 6E8E                  ; ---------------------------------------------------------------
1102+ 6E8E                  ; Marca l'item come raccolto
1103+ 6E8E                  ; ---------------------------------------------------------------
1104+ 6E8E 36 01            ld   (hl), 1
1105+ 6E90
1106+ 6E90                  ; ---------------------------------------------------------------
1107+ 6E90                  ; Rimuove l'item dalla cache items_grid
1108+ 6E90                  ;
1109+ 6E90                  ; Calcolo:
1110+ 6E90                  ;   offset = Row * 32 + Col
1111+ 6E90                  ; ---------------------------------------------------------------
1112+ 6E90 E5               push hl
1113+ 6E91 D5               push de
1114+ 6E92
1115+ 6E92 26 00            ld   h, 0
1116+ 6E94 68               ld   l, b              ; HL = Row
1117+ 6E95
1118+ 6E95 29               add  hl, hl            ; *2
1119+ 6E96 29               add  hl, hl            ; *4
1120+ 6E97 29               add  hl, hl            ; *8
1121+ 6E98 29               add  hl, hl            ; *16
1122+ 6E99 29               add  hl, hl            ; *32
1123+ 6E9A
1124+ 6E9A 59               ld   e, c
1125+ 6E9B 16 00            ld   d, 0
1126+ 6E9D
1127+ 6E9D 19               add  hl, de            ; Row*32 + Col
1128+ 6E9E
1129+ 6E9E 11 00 90         ld   de, items_grid
1130+ 6EA1 19               add  hl, de
1131+ 6EA2
1132+ 6EA2                  ; La cella non contiene più un item
1133+ 6EA2 36 00            ld   (hl), 0
1134+ 6EA4
1135+ 6EA4 D1               pop  de
1136+ 6EA5 E1               pop  hl
1137+ 6EA6
1138+ 6EA6                  ; ---------------------------------------------------------------
1139+ 6EA6                  ; Conserva il puntatore all'entry corrente
1140+ 6EA6                  ; poiché le routine successive possono alterare HL.
1141+ 6EA6                  ; ---------------------------------------------------------------
1142+ 6EA6 E5               push hl
1143+ 6EA7
1144+ 6EA7                  ; ---------------------------------------------------------------
1145+ 6EA7                  ; Aggiorna il numero di oggetti raccolti
1146+ 6EA7                  ; ---------------------------------------------------------------
1147+ 6EA7 3A 4E 7B         ld   a, (items_collected)
1148+ 6EAA
1149+ 6EAA 3C               inc  a
1150+ 6EAB
1151+ 6EAB 32 4E 7B         ld   (items_collected), a
1152+ 6EAE
1153+ 6EAE                  ; ---------------------------------------------------------------
1154+ 6EAE                  ; Aggiorna il contatore visualizzato a schermo
1155+ 6EAE                  ; ---------------------------------------------------------------
1156+ 6EAE CD CB 60         call UpdateItemsCollectedDisplay
1157+ 6EB1
1158+ 6EB1                  ; ---------------------------------------------------------------
1159+ 6EB1                  ; Ripristina il tile originale della stanza
1160+ 6EB1                  ; eliminando la grafica dell'item.
1161+ 6EB1                  ;
1162+ 6EB1                  ; Input:
1163+ 6EB1                  ;   B = Row
1164+ 6EB1                  ;   C = Col
1165+ 6EB1                  ; ---------------------------------------------------------------
1166+ 6EB1 CD E1 6D         call RestoreBackgroundCell
1167+ 6EB4
1168+ 6EB4                  ; ---------------------------------------------------------------
1169+ 6EB4                  ; Riproduce il suono di raccolta
1170+ 6EB4                  ; ---------------------------------------------------------------
1171+ 6EB4 CD C5 6E         call PlayCollectSound
1172+ 6EB7
1173+ 6EB7                  ; Ripristina il puntatore alla tabella
1174+ 6EB7 E1               pop  hl
1175+ 6EB8
1176+ 6EB8                  ; Continua con il record successivo
1177+ 6EB8 18 04            jr   .next_no_inc
1178+ 6EBA
1179+ 6EBA              .next_item:
1180+ 6EBA
1181+ 6EBA                  ; ---------------------------------------------------------------
1182+ 6EBA                  ; Salta i campi del record:
1183+ 6EBA                  ;   X
1184+ 6EBA                  ;   Y
1185+ 6EBA                  ;   Color
1186+ 6EBA                  ;   Collected
1187+ 6EBA                  ; ---------------------------------------------------------------
1188+ 6EBA 23               inc  hl
1189+ 6EBB 23               inc  hl
1190+ 6EBC 23               inc  hl
1191+ 6EBD 23               inc  hl
1192+ 6EBE
1193+ 6EBE              .next_no_inc:
1194+ 6EBE
1195+ 6EBE                  ; ---------------------------------------------------------------
1196+ 6EBE                  ; Avanza al record successivo.
1197+ 6EBE                  ;
1198+ 6EBE                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1199+ 6EBE                  ; ---------------------------------------------------------------
1200+ 6EBE 23               inc  hl
1201+ 6EBF
1202+ 6EBF 18 AE            jr   .loop
1203+ 6EC1
1204+ 6EC1              .done:
1205+ 6EC1
1206+ 6EC1                  ; Ripristina i registri
1207+ 6EC1 C1               pop  bc
1208+ 6EC2 D1               pop  de
1209+ 6EC3 E1               pop  hl
1210+ 6EC4
1211+ 6EC4 C9               ret
1212+ 6EC5
1213+ 6EC5              ; -------------------------------------------------------------------
1214+ 6EC5              ; PlayCollectSound
1215+ 6EC5              ;
1216+ 6EC5              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1217+ 6EC5              ; dello ZX Spectrum utilizzando il port $FE.
1218+ 6EC5              ;
1219+ 6EC5              ; Il suono viene prodotto alternando ON/OFF del bit 4
1220+ 6EC5              ; (speaker) con un semplice delay software.
1221+ 6EC5              ;
1222+ 6EC5              ; Effetto risultante:
1223+ 6EC5              ;   beep breve tipo "pickup item"
1224+ 6EC5              ; -------------------------------------------------------------------
1225+ 6EC5              PlayCollectSound:
1226+ 6EC5
1227+ 6EC5                  ; Salva registri utilizzati
1228+ 6EC5 C5               push bc
1229+ 6EC6 D5               push de
1230+ 6EC7
1231+ 6EC7                  ; ---------------------------------------------------------------
1232+ 6EC7                  ; Numero di cicli del beep (durata complessiva del suono)
1233+ 6EC7                  ; ---------------------------------------------------------------
1234+ 6EC7 06 78            ld   b, 120
1235+ 6EC9
1236+ 6EC9              .sound_loop:
1237+ 6EC9
1238+ 6EC9                  ; ---------------------------------------------------------------
1239+ 6EC9                  ; SPEAKER ON
1240+ 6EC9                  ;
1241+ 6EC9                  ; Legge il colore del bordo corrente e attiva il bit 4
1242+ 6EC9                  ; per pilotare lo speaker.
1243+ 6EC9                  ; ---------------------------------------------------------------
1244+ 6EC9 3A 50 7B         ld   a, (room_border_color)
1245+ 6ECC F6 10            or   $10               ; bit 4 = 1 → speaker ON
1246+ 6ECE
1247+ 6ECE D3 FE            out  ($fe), a         ; scrive sul port ULA
1248+ 6ED0
1249+ 6ED0                  ; ---------------------------------------------------------------
1250+ 6ED0                  ; Delay (mezzo periodo)
1251+ 6ED0                  ; Loop software a consumo CPU
1252+ 6ED0                  ; ---------------------------------------------------------------
1253+ 6ED0 0E 3C            ld   c, 60
1254+ 6ED2
1255+ 6ED2              .d1:
1256+ 6ED2 0D               dec  c
1257+ 6ED3 20 FD            jr   nz, .d1
1258+ 6ED5
1259+ 6ED5                  ; ---------------------------------------------------------------
1260+ 6ED5                  ; SPEAKER OFF
1261+ 6ED5                  ;
1262+ 6ED5                  ; Mantiene il colore del bordo ma disattiva lo speaker
1263+ 6ED5                  ; ---------------------------------------------------------------
1264+ 6ED5 3A 50 7B         ld   a, (room_border_color)
1265+ 6ED8 E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1266+ 6EDA
1267+ 6EDA D3 FE            out  ($fe), a
1268+ 6EDC
1269+ 6EDC                  ; ---------------------------------------------------------------
1270+ 6EDC                  ; Secondo delay (mezzo periodo)
1271+ 6EDC                  ; Completa l’onda quadra
1272+ 6EDC                  ; ---------------------------------------------------------------
1273+ 6EDC 0E 3C            ld   c, 60
1274+ 6EDE
1275+ 6EDE              .d2:
1276+ 6EDE 0D               dec  c
1277+ 6EDF 20 FD            jr   nz, .d2
1278+ 6EE1
1279+ 6EE1                  ; ---------------------------------------------------------------
1280+ 6EE1                  ; Ripete fino a completare il numero di cicli
1281+ 6EE1                  ; ---------------------------------------------------------------
1282+ 6EE1 10 E6            djnz .sound_loop
1283+ 6EE3
1284+ 6EE3                  ; Ripristina registri salvati
1285+ 6EE3 D1               pop  de
1286+ 6EE4 C1               pop  bc
1287+ 6EE5
1288+ 6EE5 C9               ret
1289+ 6EE6
1290+ 6EE6              ; -------------------------------------------------------------------
1291+ 6EE6              ; CheckActiveItemAtCell
1292+ 6EE6              ;
1293+ 6EE6              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1294+ 6EE6              ; nella cella specificata della griglia items_grid.
1295+ 6EE6              ;
1296+ 6EE6              ; Questa routine usa una lookup diretta su una mappa 32x16,
1297+ 6EE6              ; evitando la scansione della ItemsTable.
1298+ 6EE6              ;
1299+ 6EE6              ; Input:
1300+ 6EE6              ;   B = Colonna (0..31)
1301+ 6EE6              ;   C = Riga (0..15)
1302+ 6EE6              ;
1303+ 6EE6              ; Output:
1304+ 6EE6              ;   Carry Set   = item presente nella cella
1305+ 6EE6              ;   Carry Clear = nessun item
1306+ 6EE6              ;
1307+ 6EE6              ; Nota:
1308+ 6EE6              ;   HL NON è restituito valido (commento originale non corretto:
1309+ 6EE6              ;   la routine non punta a ItemsTable).
1310+ 6EE6              ; -------------------------------------------------------------------
1311+ 6EE6              CheckActiveItemAtCell:
1312+ 6EE6
1313+ 6EE6                  ; Salva registri usati
1314+ 6EE6 D5               push de
1315+ 6EE7 E5               push hl
1316+ 6EE8
1317+ 6EE8                  ; ---------------------------------------------------------------
1318+ 6EE8                  ; Calcolo indice lineare nella griglia 32x16:
1319+ 6EE8                  ;
1320+ 6EE8                  ; offset = Row * 32 + Col
1321+ 6EE8                  ; ---------------------------------------------------------------
1322+ 6EE8 26 00            ld   h, 0
1323+ 6EEA 69               ld   l, c              ; HL = Row
1324+ 6EEB
1325+ 6EEB 29               add  hl, hl            ; *2
1326+ 6EEC 29               add  hl, hl            ; *4
1327+ 6EED 29               add  hl, hl            ; *8
1328+ 6EEE 29               add  hl, hl            ; *16
1329+ 6EEF 29               add  hl, hl            ; *32
1330+ 6EF0
1331+ 6EF0                  ; Aggiunge la colonna
1332+ 6EF0 58               ld   e, b
1333+ 6EF1 16 00            ld   d, 0
1334+ 6EF3 19               add  hl, de            ; HL = Row*32 + Col
1335+ 6EF4
1336+ 6EF4                  ; ---------------------------------------------------------------
1337+ 6EF4                  ; Accesso alla griglia degli item attivi
1338+ 6EF4                  ; ---------------------------------------------------------------
1339+ 6EF4 11 00 90         ld   de, items_grid
1340+ 6EF7 19               add  hl, de            ; HL = address cella
1341+ 6EF8
1342+ 6EF8                  ; ---------------------------------------------------------------
1343+ 6EF8                  ; Controllo presenza item
1344+ 6EF8                  ;
1345+ 6EF8                  ; items_grid contiene:
1346+ 6EF8                  ;   0 = nessun item
1347+ 6EF8                  ;   >0 = item attivo (colore o flag)
1348+ 6EF8                  ; ---------------------------------------------------------------
1349+ 6EF8 7E               ld   a, (hl)
1350+ 6EF9 B7               or   a
1351+ 6EFA 28 04            jr   z, .not_active
1352+ 6EFC
1353+ 6EFC                  ; ---------------------------------------------------------------
1354+ 6EFC                  ; Item trovato
1355+ 6EFC                  ; ---------------------------------------------------------------
1356+ 6EFC E1               pop  hl
1357+ 6EFD D1               pop  de
1358+ 6EFE
1359+ 6EFE 37               scf                    ; Carry = 1
1360+ 6EFF C9               ret
1361+ 6F00
1362+ 6F00              .not_active:
1363+ 6F00
1364+ 6F00                  ; ---------------------------------------------------------------
1365+ 6F00                  ; Nessun item nella cella
1366+ 6F00                  ; ---------------------------------------------------------------
1367+ 6F00 E1               pop  hl
1368+ 6F01 D1               pop  de
1369+ 6F02
1370+ 6F02 B7               or   a                 ; Carry = 0
1371+ 6F03 C9               ret
1372+ 6F04
