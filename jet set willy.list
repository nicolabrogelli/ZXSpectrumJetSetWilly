 406  8719              ; -------------------------------------------------------------------
 407  8719              ; ResetFullGameState
 408  8719              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 409  8719              ; per l'avvio di una nuova partita dopo il Game Over.
 410  8719              ; -------------------------------------------------------------------
 411  8719              ResetFullGameState:
 412  8719                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 413  8719 AF               xor  a
 414  871A D3 FE            out  ($fe), a              ; Bordo a nero
 415  871C 21 8D 5C         ld   hl, ATTR_P
 416  871F 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 417  8720 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 418  8723 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 419  8725 3E 07            ld   a, $07
 420  8727 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 421  872A
 422  872A                  ; Ripristina il numero di vite iniziali
 423  872A 3E 07            ld   a, INITIAL_LIVES
 424  872C 32 26 EA         ld   (willy_lives), a
 425  872F
 426  872F                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 427  872F AF               xor  a
 428  8730 32 23 EA         ld   (items_collected), a
 429  8733 32 1F EA         ld   (body_state), a
 430  8736 32 32 EA         ld   (w_warp_state), a
 431  8739 32 35 EA         ld   (w_key_prev), a
 432  873C 32 36 EA         ld   (enter_key_prev), a
 433  873F 32 27 EA         ld   (velocity_y), a
 434  8742 32 29 EA         ld   (jump_pressed), a
 435  8745 32 2B EA         ld   (coyote_timer), a
 436  8748 32 2E EA         ld   (jump_frame), a
 437  874B 32 2D EA         ld   (jump_dir), a
 438  874E 32 9F ED         ld   (transition_active), a
 439  8751 32 23 EE         ld   (willy_safety_timer), a
 440  8754 3E FF            ld   a, $ff
 441  8756 32 37 EA         ld   (digit_key_prev), a
 442  8759 3E 01            ld   a, 1
 443  875B 32 30 EA         ld   (q_prev), a
 444  875E 32 31 EA         ld   (a_prev), a
 445  8761 32 28 EA         ld   (on_ground), a
 446  8764
 447  8764                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 448  8764 3E 30            ld   a, '0'
 449  8766 32 B4 66         ld   (status_line + 16), a
 450  8769 32 B5 66         ld   (status_line + 17), a
 451  876C 32 B6 66         ld   (status_line + 18), a
 452  876F
