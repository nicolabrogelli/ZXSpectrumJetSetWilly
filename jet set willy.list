 842+ 7E0A              ; Aggiorna le posizioni dei nemici attivi per il prossimo frame
 843+ 7E0A              ; -------------------------------------------------------------------
 844+ 7E0A              Enemy_Update:
 845+ 7E0A E5               push hl
 846+ 7E0B D5               push de
 847+ 7E0C C5               push bc
 848+ 7E0D DD E5            push ix
 849+ 7E0F
 850+ 7E0F                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 851+ 7E0F 3A FE EF         ld   a, (enemy_update_rate)
 852+ 7E12 FE 01            cp   1
 853+ 7E14 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 854+ 7E16
 855+ 7E16 3A FF EF         ld   a, (enemy_update_timer)
 856+ 7E19 3C               inc  a
 857+ 7E1A 47               ld   b, a                      ; B = timer + 1
 858+ 7E1B 3A FE EF         ld   a, (enemy_update_rate)
 859+ 7E1E B8               cp   b
 860+ 7E1F 28 0C            jr   z, .reset_timer
 861+ 7E21 38 0A            jr   c, .reset_timer
 862+ 7E23
 863+ 7E23                  ; Salva contatore incrementato e salta l'aggiornamento
 864+ 7E23 78               ld   a, b
 865+ 7E24 32 FF EF         ld   (enemy_update_timer), a
 866+ 7E27
 867+ 7E27              .skip_update:
