 273  8804              ; -------------------------------------------------------------------
 274  8804              ; ShowTitleScreen
 275  8804              ; Visualizza la schermata iniziale del gioco (Title Screen).
 276  8804              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 277  8804              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 278  8804              ; -------------------------------------------------------------------
 279  8804              ShowTitleScreen:
 280  8804                  ; 1. Disegna la schermata iniziale
 281  8804 CD 1B 63         call Gfx_DrawTitleScreen
 282  8807
 283  8807                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 284  8807              .wait_title_enter_release:
 285  8807 76               halt
 286  8808 3E BF            ld   a, $bf
 287  880A DB FE            in   a, ($fe)
 288  880C 1F               rra
 289  880D 30 F8            jr   nc, .wait_title_enter_release
 290  880F
 291  880F                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 292  880F 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 293  8811              .title_loop:
 294  8811 76               halt
 295  8812
 296  8812                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
