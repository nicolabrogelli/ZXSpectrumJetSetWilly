 443+ 6D24                  ; ---------------------------------------------------------------
 444+ 6D24 23               inc  hl
 445+ 6D25 18 A8            jr   .loop
 446+ 6D27
 447+ 6D27              .done:
 448+ 6D27
 449+ 6D27                  ; Ripristina i registri
 450+ 6D27 FD E1            pop  iy
 451+ 6D29 DD E1            pop  ix
 452+ 6D2B D1               pop  de
 453+ 6D2C C1               pop  bc
 454+ 6D2D E1               pop  hl
 455+ 6D2E
 456+ 6D2E C9               ret
 457+ 6D2F
 458+ 6D2F              ; -------------------------------------------------------------------
 459+ 6D2F              ; DrawItemGraphic
 460+ 6D2F              ;
 461+ 6D2F              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 462+ 6D2F              ; utilizzando una bitmap di 8 byte e un attributo colore.
 463+ 6D2F              ;
 464+ 6D2F              ; Input:
 465+ 6D2F              ;   B = Riga attributi (3..18)
 466+ 6D2F              ;   C = Colonna attributi (0..31)
 467+ 6D2F              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 468+ 6D2F              ;   E = Attributo colore
 469+ 6D2F              ;
 470+ 6D2F              ; Output:
 471+ 6D2F              ;   Nessuno
 472+ 6D2F              ;
 473+ 6D2F              ; Registri preservati:
 474+ 6D2F              ;   BC, DE, HL
 475+ 6D2F              ; -------------------------------------------------------------------
 476+ 6D2F              DrawItemGraphic:
 477+ 6D2F
 478+ 6D2F                  ; Salva i registri originali
 479+ 6D2F C5               push bc
 480+ 6D30 D5               push de
 481+ 6D31 E5               push hl
 482+ 6D32
 483+ 6D32                  ; ---------------------------------------------------------------
 484+ 6D32                  ; Calcolo indirizzo bitmap dello Spectrum
 485+ 6D32                  ;
 486+ 6D32                  ; Ogni item occupa una cella attributi (8x8 pixel).
 487+ 6D32                  ;
 488+ 6D32                  ; Formula:
 489+ 6D32                  ;   High = $40 + (Row AND $18)
 490+ 6D32                  ;   Low  = (Row AND 7) * 32 + Col
 491+ 6D32                  ;
 492+ 6D32                  ; DE conterrà l'indirizzo della prima scanline.
 493+ 6D32                  ; ---------------------------------------------------------------
 494+ 6D32
 495+ 6D32 78               ld   a, b
 496+ 6D33 E6 18            and  $18
 497+ 6D35 C6 40            add  a, $40
 498+ 6D37 57               ld   d, a              ; Byte alto indirizzo video
 499+ 6D38
 500+ 6D38 78               ld   a, b
 501+ 6D39 E6 07            and  7                 ; Riga interna al blocco da 8
 502+ 6D3B
 503+ 6D3B 87               add  a, a              ; *2
 504+ 6D3C 87               add  a, a              ; *4
 505+ 6D3D 87               add  a, a              ; *8
 506+ 6D3E 87               add  a, a              ; *16
 507+ 6D3F 87               add  a, a              ; *32
 508+ 6D40
 509+ 6D40 81               add  a, c              ; + colonna
 510+ 6D41
 511+ 6D41 5F               ld   e, a              ; Byte basso indirizzo video
 512+ 6D42
 513+ 6D42                  ; ---------------------------------------------------------------
 514+ 6D42                  ; Disegno bitmap
 515+ 6D42                  ;
 516+ 6D42                  ; Copia 8 byte consecutivi nella memoria video.
 517+ 6D42                  ; Ogni byte rappresenta una scanline da 8 pixel.
 518+ 6D42                  ; ---------------------------------------------------------------
 519+ 6D42
 520+ 6D42 C5               push bc                ; Conserva Row e Col
 521+ 6D43
 522+ 6D43 06 08            ld   b, 8              ; Numero scanline
 523+ 6D45
 524+ 6D45              .line_loop:
 525+ 6D45
 526+ 6D45 7E               ld   a, (hl)           ; Legge scanline bitmap
 527+ 6D46 12               ld   (de), a           ; Scrive nella memoria video
 528+ 6D47
 529+ 6D47 14               inc  d                 ; Scanline successiva
 530+ 6D48 23               inc  hl                ; Byte bitmap successivo
 531+ 6D49
 532+ 6D49 05               dec  b
 533+ 6D4A 20 F9            jr   nz, .line_loop
 534+ 6D4C
 535+ 6D4C C1               pop  bc                ; Ripristina Row e Col
 536+ 6D4D
 537+ 6D4D                  ; ---------------------------------------------------------------
 538+ 6D4D                  ; Calcolo indirizzo attributo
 539+ 6D4D                  ;
 540+ 6D4D                  ; Formula:
 541+ 6D4D                  ;   AttrAddr = $5800 + Row * 32 + Col
 542+ 6D4D                  ;
 543+ 6D4D                  ; HL conterrà l'indirizzo della cella attributi.
 544+ 6D4D                  ; ---------------------------------------------------------------
 545+ 6D4D
 546+ 6D4D 26 00            ld   h, 0
 547+ 6D4F 68               ld   l, b              ; HL = Row
 548+ 6D50
 549+ 6D50 29               add  hl, hl            ; *2
 550+ 6D51 29               add  hl, hl            ; *4
 551+ 6D52 29               add  hl, hl            ; *8
 552+ 6D53 29               add  hl, hl            ; *16
 553+ 6D54 29               add  hl, hl            ; *32
 554+ 6D55
 555+ 6D55 79               ld   a, c              ; A = Colonna
 556+ 6D56
 557+ 6D56 85               add  a, l
 558+ 6D57 6F               ld   l, a
 559+ 6D58
 560+ 6D58 30 01            jr   nc, .no_carry
 561+ 6D5A 24               inc  h
 562+ 6D5B
 563+ 6D5B              .no_carry:
 564+ 6D5B
 565+ 6D5B                  ; HL = Row * 32 + Col
 566+ 6D5B
 567+ 6D5B 11 00 58         ld   de, $5800
 568+ 6D5E 19               add  hl, de            ; HL = indirizzo attributi
 569+ 6D5F
 570+ 6D5F                  ; ---------------------------------------------------------------
 571+ 6D5F                  ; Recupera il colore originale dallo stack.
 572+ 6D5F                  ;
 573+ 6D5F                  ; Layout stack:
 574+ 6D5F                  ;   HL originale
 575+ 6D5F                  ;   DE originale (E = colore)
 576+ 6D5F                  ;   BC originale
 577+ 6D5F                  ; ---------------------------------------------------------------
 578+ 6D5F
 579+ 6D5F C1               pop  bc                ; Recupera HL originale
 580+ 6D60 D1               pop  de                ; Recupera DE originale
 581+ 6D61
 582+ 6D61                  ; ---------------------------------------------------------------
 583+ 6D61                  ; Scrive l'attributo colore
 584+ 6D61                  ; ---------------------------------------------------------------
 585+ 6D61
 586+ 6D61 7B               ld   a, e              ; A = colore
 587+ 6D62 77               ld   (hl), a           ; Scrive nella RAM attributi
 588+ 6D63
 589+ 6D63                  ; ---------------------------------------------------------------
 590+ 6D63                  ; Ripristina HL e BC originali
 591+ 6D63                  ; ---------------------------------------------------------------
 592+ 6D63
 593+ 6D63 C5               push bc
 594+ 6D64 E1               pop  hl                ; HL originale
 595+ 6D65
 596+ 6D65 C1               pop  bc                ; BC originale
 597+ 6D66
 598+ 6D66 C9               ret
 599+ 6D67
 600+ 6D67              ; -------------------------------------------------------------------
 601+ 6D67              ; RestoreBackgroundCell
 602+ 6D67              ;
 603+ 6D67              ; Ripristina il contenuto originale di una cella della stanza.
 604+ 6D67              ; Viene utilizzata principalmente quando un item viene raccolto:
 605+ 6D67              ; invece di lasciare un "buco", la routine ridisegna il tile
 606+ 6D67              ; originale presente nella mappa della stanza.
 607+ 6D67              ;
 608+ 6D67              ; Input:
 609+ 6D67              ;   B = Row (3..18)
 610+ 6D67              ;   C = Col (0..31)
 611+ 6D67              ;
 612+ 6D67              ; Utilizza:
 613+ 6D67              ;   room_ptr -> struttura dati della stanza corrente
 614+ 6D67              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 615+ 6D67              ;   DrawTile -> ridisegna il tile selezionato
 616+ 6D67              ;
 617+ 6D67              ; Tipi di cella:
 618+ 6D67              ;   0 = Background
 619+ 6D67              ;   1 = Floor
 620+ 6D67              ;   2 = Wall
 621+ 6D67              ;   3 = Nasty
 622+ 6D67              ; -------------------------------------------------------------------
 623+ 6D67              RestoreBackgroundCell:
 624+ 6D67
 625+ 6D67                  ; Salva tutti i registri utilizzati
 626+ 6D67 FD E5            push iy
 627+ 6D69 C5               push bc
 628+ 6D6A D5               push de
 629+ 6D6B E5               push hl
 630+ 6D6C DD E5            push ix
 631+ 6D6E
 632+ 6D6E                  ; ---------------------------------------------------------------
 633+ 6D6E                  ; Conserva Row e Col in IY.
 634+ 6D6E                  ;
 635+ 6D6E                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 636+ 6D6E                  ; BC potrebbe essere modificato.
 637+ 6D6E                  ; ---------------------------------------------------------------
 638+ 6D6E C5               push bc
 639+ 6D6F FD E1            pop  iy                ; IYH = Row, IYL = Col
 640+ 6D71
 641+ 6D71                  ; ---------------------------------------------------------------
 642+ 6D71                  ; Determina quale tipo di cella è presente nella posizione
 643+ 6D71                  ; specificata.
 644+ 6D71                  ;
 645+ 6D71                  ; Input:
 646+ 6D71                  ;   B = Row
 647+ 6D71                  ;   C = Col
 648+ 6D71                  ;
 649+ 6D71                  ; Output:
 650+ 6D71                  ;   A = tipo cella
 651+ 6D71                  ; ---------------------------------------------------------------
 652+ 6D71 78               ld   a, b
 653+ 6D72
 654+ 6D72 CD AE 68         call GetCellFromUnpacked
 655+ 6D75
 656+ 6D75                  ; ---------------------------------------------------------------
 657+ 6D75                  ; Recupera il puntatore alla stanza corrente.
 658+ 6D75                  ;
 659+ 6D75                  ; DE = base della struttura stanza
 660+ 6D75                  ; ---------------------------------------------------------------
 661+ 6D75 ED 5B 38 7E      ld   de, (room_ptr)
 662+ 6D79
 663+ 6D79                  ; ---------------------------------------------------------------
 664+ 6D79                  ; Seleziona il tile corretto in base al tipo di cella.
 665+ 6D79                  ;
 666+ 6D79                  ; A = 0 -> Background
 667+ 6D79                  ; A = 1 -> Floor
 668+ 6D79                  ; A = 2 -> Wall
 669+ 6D79                  ; A = 3 -> Nasty
 670+ 6D79                  ; ---------------------------------------------------------------
 671+ 6D79
 672+ 6D79 B7               or   a
 673+ 6D7A 20 06            jr   nz, .not_bg
 674+ 6D7C
 675+ 6D7C                  ; Background
 676+ 6D7C 21 A0 00         ld   hl, OFFSET_BG
 677+ 6D7F 19               add  hl, de
 678+ 6D80 18 16            jr   .draw_cell
 679+ 6D82
 680+ 6D82              .not_bg:
 681+ 6D82
 682+ 6D82 3D               dec  a
 683+ 6D83 20 06            jr   nz, .not_floor
 684+ 6D85
 685+ 6D85                  ; Floor
 686+ 6D85 21 A9 00         ld   hl, OFFSET_FLOOR
 687+ 6D88 19               add  hl, de
 688+ 6D89 18 0D            jr   .draw_cell
 689+ 6D8B
 690+ 6D8B              .not_floor:
 691+ 6D8B
 692+ 6D8B 3D               dec  a
 693+ 6D8C 20 06            jr   nz, .not_wall
 694+ 6D8E
 695+ 6D8E                  ; Wall
 696+ 6D8E 21 B2 00         ld   hl, OFFSET_WALL
 697+ 6D91 19               add  hl, de
 698+ 6D92 18 04            jr   .draw_cell
 699+ 6D94
 700+ 6D94              .not_wall:
 701+ 6D94
 702+ 6D94                  ; Nasty
 703+ 6D94 21 BB 00         ld   hl, OFFSET_NASTY
 704+ 6D97 19               add  hl, de
 705+ 6D98
 706+ 6D98              .draw_cell:
 707+ 6D98
 708+ 6D98                  ; ---------------------------------------------------------------
 709+ 6D98                  ; HL punta ora alla grafica del tile da ridisegnare.
 710+ 6D98                  ;
 711+ 6D98                  ; DrawTile si aspetta:
 712+ 6D98                  ;   IX = puntatore tile
 713+ 6D98                  ;   B  = Row
 714+ 6D98                  ;   C  = Col
 715+ 6D98                  ; ---------------------------------------------------------------
 716+ 6D98 E5               push hl
 717+ 6D99 DD E1            pop  ix
 718+ 6D9B
 719+ 6D9B                  ; Ripristina Row e Col salvati in IY
 720+ 6D9B FD E5            push iy
 721+ 6D9D C1               pop  bc
 722+ 6D9E
 723+ 6D9E                  ; Disegna il tile originale
 724+ 6D9E CD 8C 61         call DrawTile
 725+ 6DA1
 726+ 6DA1                  ; ---------------------------------------------------------------
 727+ 6DA1                  ; Ripristina i registri salvati
 728+ 6DA1                  ; ---------------------------------------------------------------
 729+ 6DA1 DD E1            pop  ix
 730+ 6DA3 E1               pop  hl
 731+ 6DA4 D1               pop  de
 732+ 6DA5 C1               pop  bc
 733+ 6DA6 FD E1            pop  iy
 734+ 6DA8
 735+ 6DA8 C9               ret
 736+ 6DA9
 737+ 6DA9              ; -------------------------------------------------------------------
 738+ 6DA9              ; CheckWillyItemCollision
 739+ 6DA9              ;
 740+ 6DA9              ; Verifica se Willy collide con un item utilizzando il controllo
 741+ 6DA9              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 742+ 6DA9              ;
 743+ 6DA9              ; Input:
 744+ 6DA9              ;   A = ItemX (colonna attributi 0..31)
 745+ 6DA9              ;   H = ItemY (riga attributi 3..18)
 746+ 6DA9              ;
 747+ 6DA9              ; Coordinate item:
 748+ 6DA9              ;   Ogni item occupa una cella da 8x8 pixel.
 749+ 6DA9              ;
 750+ 6DA9              ; Coordinate Willy:
 751+ 6DA9              ;   Willy occupa un rettangolo di 16x16 pixel.
 752+ 6DA9              ;
 753+ 6DA9              ; Output:
 754+ 6DA9              ;   Carry Set   = collisione rilevata
 755+ 6DA9              ;   Carry Clear = nessuna collisione
 756+ 6DA9              ;
 757+ 6DA9              ; Registri preservati:
 758+ 6DA9              ;   BC, DE, HL
 759+ 6DA9              ; -------------------------------------------------------------------
 760+ 6DA9              CheckWillyItemCollision:
 761+ 6DA9
 762+ 6DA9                  ; Salva i registri utilizzati
 763+ 6DA9 C5               push bc
 764+ 6DAA D5               push de
 765+ 6DAB E5               push hl
 766+ 6DAC
 767+ 6DAC                  ; ---------------------------------------------------------------
 768+ 6DAC                  ; Calcola il bounding box orizzontale dell'item
 769+ 6DAC                  ;
 770+ 6DAC                  ; ItemLeft  = ItemX * 8
 771+ 6DAC                  ; ItemRight = ItemLeft + 7
 772+ 6DAC                  ;
 773+ 6DAC                  ; E = ItemLeft
 774+ 6DAC                  ; D = ItemRight
 775+ 6DAC                  ; ---------------------------------------------------------------
 776+ 6DAC 6F               ld   l, a              ; L = ItemX
 777+ 6DAD
 778+ 6DAD 7D               ld   a, l
 779+ 6DAE 87               add  a, a              ; *2
 780+ 6DAF 87               add  a, a              ; *4
 781+ 6DB0 87               add  a, a              ; *8
 782+ 6DB1
 783+ 6DB1 5F               ld   e, a              ; E = ItemLeft
 784+ 6DB2
 785+ 6DB2 C6 07            add  a, 7
 786+ 6DB4 57               ld   d, a              ; D = ItemRight
 787+ 6DB5
 788+ 6DB5                  ; ---------------------------------------------------------------
 789+ 6DB5                  ; Recupera la posizione corrente di Willy
 790+ 6DB5                  ;
 791+ 6DB5                  ; B = WillyY
 792+ 6DB5                  ; C = WillyX
 793+ 6DB5                  ; ---------------------------------------------------------------
 794+ 6DB5 ED 4B CA 7A      ld   bc, (PlayerPos)
 795+ 6DB9
 796+ 6DB9                  ; ---------------------------------------------------------------
 797+ 6DB9                  ; Primo test:
 798+ 6DB9                  ;
 799+ 6DB9                  ; WillyLeft <= ItemRight
 800+ 6DB9                  ;
 801+ 6DB9                  ; Se Willy è completamente a destra dell'item
 802+ 6DB9                  ; non può esserci collisione.
 803+ 6DB9                  ; ---------------------------------------------------------------
 804+ 6DB9 79               ld   a, c              ; A = WillyLeft
 805+ 6DBA
 806+ 6DBA BA               cp   d                 ; WillyLeft vs ItemRight
 807+ 6DBB
 808+ 6DBB 28 04            jr   z, .x_ok
 809+ 6DBD 38 02            jr   c, .x_ok
 810+ 6DBF
 811+ 6DBF 18 29            jr   .no_collision
 812+ 6DC1
 813+ 6DC1              .x_ok:
 814+ 6DC1
 815+ 6DC1                  ; ---------------------------------------------------------------
 816+ 6DC1                  ; Secondo test:
 817+ 6DC1                  ;
 818+ 6DC1                  ; WillyRight >= ItemLeft
 819+ 6DC1                  ;
 820+ 6DC1                  ; WillyRight = WillyX + 7
 821+ 6DC1                  ; ---------------------------------------------------------------
 822+ 6DC1 C6 07            add  a, 7
 823+ 6DC3
 824+ 6DC3 BB               cp   e                 ; WillyRight vs ItemLeft
 825+ 6DC4
 826+ 6DC4 28 04            jr   z, .y_check
 827+ 6DC6 30 02            jr   nc, .y_check
 828+ 6DC8
 829+ 6DC8 18 20            jr   .no_collision
 830+ 6DCA
 831+ 6DCA              .y_check:
 832+ 6DCA
 833+ 6DCA                  ; ---------------------------------------------------------------
 834+ 6DCA                  ; Recupera ItemY dal valore originale di HL
 835+ 6DCA                  ;
 836+ 6DCA                  ; H contiene la riga dell'item.
 837+ 6DCA                  ; ---------------------------------------------------------------
 838+ 6DCA E1               pop  hl
 839+ 6DCB E5               push hl
 840+ 6DCC
 841+ 6DCC                  ; ---------------------------------------------------------------
 842+ 6DCC                  ; Calcola il bounding box verticale dell'item
 843+ 6DCC                  ;
 844+ 6DCC                  ; ItemTop    = ItemY * 8
 845+ 6DCC                  ; ItemBottom = ItemTop + 7
 846+ 6DCC                  ;
 847+ 6DCC                  ; E = ItemTop
 848+ 6DCC                  ; D = ItemBottom
 849+ 6DCC                  ; ---------------------------------------------------------------
 850+ 6DCC 7C               ld   a, h
 851+ 6DCD
 852+ 6DCD 87               add  a, a              ; *2
 853+ 6DCE 87               add  a, a              ; *4
 854+ 6DCF 87               add  a, a              ; *8
 855+ 6DD0
 856+ 6DD0 5F               ld   e, a              ; ItemTop
 857+ 6DD1
 858+ 6DD1 C6 07            add  a, 7
 859+ 6DD3 57               ld   d, a              ; ItemBottom
 860+ 6DD4
 861+ 6DD4                  ; ---------------------------------------------------------------
 862+ 6DD4                  ; Primo test verticale:
 863+ 6DD4                  ;
 864+ 6DD4                  ; WillyTop <= ItemBottom
 865+ 6DD4                  ; ---------------------------------------------------------------
 866+ 6DD4 78               ld   a, b              ; WillyTop
 867+ 6DD5
 868+ 6DD5 BA               cp   d
 869+ 6DD6
 870+ 6DD6 28 04            jr   z, .y_ok
 871+ 6DD8 38 02            jr   c, .y_ok
 872+ 6DDA
 873+ 6DDA 18 0E            jr   .no_collision
 874+ 6DDC
 875+ 6DDC              .y_ok:
 876+ 6DDC
 877+ 6DDC                  ; ---------------------------------------------------------------
 878+ 6DDC                  ; Secondo test verticale:
 879+ 6DDC                  ;
 880+ 6DDC                  ; WillyBottom >= ItemTop
 881+ 6DDC                  ;
 882+ 6DDC                  ; WillyBottom = WillyY + 15
 883+ 6DDC                  ; ---------------------------------------------------------------
 884+ 6DDC C6 0F            add  a, 15
 885+ 6DDE
 886+ 6DDE BB               cp   e
 887+ 6DDF
 888+ 6DDF 28 04            jr   z, .collision
 889+ 6DE1 30 02            jr   nc, .collision
 890+ 6DE3
 891+ 6DE3 18 05            jr   .no_collision
 892+ 6DE5
 893+ 6DE5              .collision:
 894+ 6DE5
 895+ 6DE5                  ; ---------------------------------------------------------------
 896+ 6DE5                  ; Collisione rilevata
 897+ 6DE5                  ; ---------------------------------------------------------------
 898+ 6DE5 E1               pop  hl
 899+ 6DE6 D1               pop  de
 900+ 6DE7 C1               pop  bc
 901+ 6DE8
 902+ 6DE8 37               scf                    ; Carry = 1
 903+ 6DE9
 904+ 6DE9 C9               ret
 905+ 6DEA
 906+ 6DEA              .no_collision:
 907+ 6DEA
 908+ 6DEA                  ; ---------------------------------------------------------------
 909+ 6DEA                  ; Nessuna collisione
 910+ 6DEA                  ; ---------------------------------------------------------------
 911+ 6DEA E1               pop  hl
 912+ 6DEB D1               pop  de
 913+ 6DEC C1               pop  bc
 914+ 6DED
 915+ 6DED B7               or   a                 ; Carry = 0
 916+ 6DEE
 917+ 6DEE C9               ret
 918+ 6DEF
 919+ 6DEF              ; -------------------------------------------------------------------
 920+ 6DEF              ; CheckRoomItemsCollision
 921+ 6DEF              ;
 922+ 6DEF              ; Controlla se Willy entra in collisione con uno degli item
 923+ 6DEF              ; attivi presenti nella stanza corrente.
 924+ 6DEF              ;
 925+ 6DEF              ; Per ogni item:
 926+ 6DEF              ;   - verifica che appartenga alla stanza corrente
 927+ 6DEF              ;   - verifica che non sia già stato raccolto
 928+ 6DEF              ;   - esegue il test di collisione con Willy
 929+ 6DEF              ;
 930+ 6DEF              ; Se l'item viene raccolto:
 931+ 6DEF              ;   - imposta il flag "collected"
 932+ 6DEF              ;   - rimuove l'item dalla cache items_grid
 933+ 6DEF              ;   - incrementa il contatore degli oggetti raccolti
 934+ 6DEF              ;   - aggiorna l'HUD
 935+ 6DEF              ;   - ripristina il tile di sfondo
 936+ 6DEF              ;   - riproduce il suono di raccolta
 937+ 6DEF              ;
 938+ 6DEF              ; Formato record ItemsTable:
 939+ 6DEF              ;   +0 RoomID
 940+ 6DEF              ;   +1 X
 941+ 6DEF              ;   +2 Y
 942+ 6DEF              ;   +3 Color
 943+ 6DEF              ;   +4 Collected
 944+ 6DEF              ;
 945+ 6DEF              ; Fine tabella:
 946+ 6DEF              ;   RoomID = $FF
 947+ 6DEF              ; -------------------------------------------------------------------
 948+ 6DEF              CheckRoomItemsCollision:
 949+ 6DEF
 950+ 6DEF                  ; Salva i registri utilizzati
 951+ 6DEF E5               push hl
 952+ 6DF0 D5               push de
 953+ 6DF1 C5               push bc
 954+ 6DF2
 955+ 6DF2                  ; Inizio scansione della tabella degli item
 956+ 6DF2 21 BF 6B         ld   hl, ItemsTable
 957+ 6DF5
 958+ 6DF5              .loop:
 959+ 6DF5
 960+ 6DF5                  ; ---------------------------------------------------------------
 961+ 6DF5                  ; Legge il Room ID dell'item corrente
 962+ 6DF5                  ; ---------------------------------------------------------------
 963+ 6DF5 7E               ld   a, (hl)
 964+ 6DF6
 965+ 6DF6                  ; $FF indica fine tabella
 966+ 6DF6 FE FF            cp   $FF
 967+ 6DF8 28 4D            jr   z, .done
 968+ 6DFA
 969+ 6DFA                  ; ---------------------------------------------------------------
 970+ 6DFA                  ; Verifica se l'item appartiene alla stanza corrente
 971+ 6DFA                  ; ---------------------------------------------------------------
 972+ 6DFA 57               ld   d, a              ; D = RoomID item
 973+ 6DFB
 974+ 6DFB 3A DE 7D         ld   a, (current_room)
 975+ 6DFE BA               cp   d
 976+ 6DFF
 977+ 6DFF                  ; Se appartiene a un'altra stanza salta il record
 978+ 6DFF 20 3F            jr   nz, .next_item
 979+ 6E01
 980+ 6E01                  ; ---------------------------------------------------------------
 981+ 6E01                  ; Legge coordinate e stato dell'item
 982+ 6E01                  ; ---------------------------------------------------------------
 983+ 6E01
 984+ 6E01 23               inc  hl
 985+ 6E02 4E               ld   c, (hl)           ; C = X
 986+ 6E03
 987+ 6E03 23               inc  hl
 988+ 6E04 46               ld   b, (hl)           ; B = Y
 989+ 6E05
 990+ 6E05 23               inc  hl                ; salta Color
 991+ 6E06
 992+ 6E06 23               inc  hl                ; punta a Collected
 993+ 6E07
 994+ 6E07 7E               ld   a, (hl)
 995+ 6E08
 996+ 6E08                  ; ---------------------------------------------------------------
 997+ 6E08                  ; Item già raccolto?
 998+ 6E08                  ; ---------------------------------------------------------------
 999+ 6E08 B7               or   a
1000+ 6E09 20 39            jr   nz, .next_no_inc
1001+ 6E0B
1002+ 6E0B                  ; ---------------------------------------------------------------
1003+ 6E0B                  ; Test collisione Willy ↔ Item
1004+ 6E0B                  ;
1005+ 6E0B                  ; Input richiesto:
1006+ 6E0B                  ;   A = ItemX
1007+ 6E0B                  ;   H = ItemY
1008+ 6E0B                  ; ---------------------------------------------------------------
1009+ 6E0B 79               ld   a, c
1010+ 6E0C
1011+ 6E0C E5               push hl                ; salva puntatore al flag Collected
1012+ 6E0D
1013+ 6E0D 60               ld   h, b
1014+ 6E0E
1015+ 6E0E CD A9 6D         call CheckWillyItemCollision
1016+ 6E11
1017+ 6E11 E1               pop  hl
1018+ 6E12
1019+ 6E12                  ; Nessuna collisione
1020+ 6E12 30 30            jr   nc, .next_no_inc
1021+ 6E14
1022+ 6E14                  ; ===============================================================
1023+ 6E14                  ; ITEM RACCOLTO
1024+ 6E14                  ; ===============================================================
1025+ 6E14
1026+ 6E14                  ; ---------------------------------------------------------------
1027+ 6E14                  ; Marca l'item come raccolto
1028+ 6E14                  ; ---------------------------------------------------------------
1029+ 6E14 36 01            ld   (hl), 1
1030+ 6E16
1031+ 6E16                  ; ---------------------------------------------------------------
1032+ 6E16                  ; Rimuove l'item dalla cache items_grid
1033+ 6E16                  ;
1034+ 6E16                  ; Calcolo:
1035+ 6E16                  ;   offset = Row * 32 + Col
1036+ 6E16                  ; ---------------------------------------------------------------
1037+ 6E16 E5               push hl
1038+ 6E17 D5               push de
1039+ 6E18
1040+ 6E18 26 00            ld   h, 0
1041+ 6E1A 68               ld   l, b              ; HL = Row
1042+ 6E1B
1043+ 6E1B 29               add  hl, hl            ; *2
1044+ 6E1C 29               add  hl, hl            ; *4
1045+ 6E1D 29               add  hl, hl            ; *8
1046+ 6E1E 29               add  hl, hl            ; *16
1047+ 6E1F 29               add  hl, hl            ; *32
1048+ 6E20
1049+ 6E20 59               ld   e, c
1050+ 6E21 16 00            ld   d, 0
1051+ 6E23
1052+ 6E23 19               add  hl, de            ; Row*32 + Col
1053+ 6E24
1054+ 6E24 11 00 90         ld   de, items_grid
1055+ 6E27 19               add  hl, de
1056+ 6E28
1057+ 6E28                  ; La cella non contiene più un item
1058+ 6E28 36 00            ld   (hl), 0
1059+ 6E2A
1060+ 6E2A D1               pop  de
1061+ 6E2B E1               pop  hl
1062+ 6E2C
1063+ 6E2C                  ; ---------------------------------------------------------------
1064+ 6E2C                  ; Conserva il puntatore all'entry corrente
1065+ 6E2C                  ; poiché le routine successive possono alterare HL.
1066+ 6E2C                  ; ---------------------------------------------------------------
1067+ 6E2C E5               push hl
1068+ 6E2D
1069+ 6E2D                  ; ---------------------------------------------------------------
1070+ 6E2D                  ; Aggiorna il numero di oggetti raccolti
1071+ 6E2D                  ; ---------------------------------------------------------------
1072+ 6E2D 3A D4 7A         ld   a, (items_collected)
1073+ 6E30
1074+ 6E30 3C               inc  a
1075+ 6E31
1076+ 6E31 32 D4 7A         ld   (items_collected), a
1077+ 6E34
1078+ 6E34                  ; ---------------------------------------------------------------
1079+ 6E34                  ; Aggiorna il contatore visualizzato a schermo
1080+ 6E34                  ; ---------------------------------------------------------------
1081+ 6E34 CD CB 60         call UpdateItemsCollectedDisplay
1082+ 6E37
1083+ 6E37                  ; ---------------------------------------------------------------
1084+ 6E37                  ; Ripristina il tile originale della stanza
1085+ 6E37                  ; eliminando la grafica dell'item.
1086+ 6E37                  ;
1087+ 6E37                  ; Input:
1088+ 6E37                  ;   B = Row
1089+ 6E37                  ;   C = Col
1090+ 6E37                  ; ---------------------------------------------------------------
1091+ 6E37 CD 67 6D         call RestoreBackgroundCell
1092+ 6E3A
1093+ 6E3A                  ; ---------------------------------------------------------------
1094+ 6E3A                  ; Riproduce il suono di raccolta
1095+ 6E3A                  ; ---------------------------------------------------------------
1096+ 6E3A CD 4B 6E         call PlayCollectSound
1097+ 6E3D
1098+ 6E3D                  ; Ripristina il puntatore alla tabella
1099+ 6E3D E1               pop  hl
1100+ 6E3E
1101+ 6E3E                  ; Continua con il record successivo
1102+ 6E3E 18 04            jr   .next_no_inc
1103+ 6E40
1104+ 6E40              .next_item:
1105+ 6E40
1106+ 6E40                  ; ---------------------------------------------------------------
1107+ 6E40                  ; Salta i campi del record:
1108+ 6E40                  ;   X
1109+ 6E40                  ;   Y
1110+ 6E40                  ;   Color
1111+ 6E40                  ;   Collected
1112+ 6E40                  ; ---------------------------------------------------------------
1113+ 6E40 23               inc  hl
1114+ 6E41 23               inc  hl
1115+ 6E42 23               inc  hl
1116+ 6E43 23               inc  hl
1117+ 6E44
1118+ 6E44              .next_no_inc:
1119+ 6E44
1120+ 6E44                  ; ---------------------------------------------------------------
1121+ 6E44                  ; Avanza al record successivo.
1122+ 6E44                  ;
1123+ 6E44                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1124+ 6E44                  ; ---------------------------------------------------------------
1125+ 6E44 23               inc  hl
1126+ 6E45
1127+ 6E45 18 AE            jr   .loop
1128+ 6E47
1129+ 6E47              .done:
1130+ 6E47
1131+ 6E47                  ; Ripristina i registri
1132+ 6E47 C1               pop  bc
1133+ 6E48 D1               pop  de
1134+ 6E49 E1               pop  hl
1135+ 6E4A
1136+ 6E4A C9               ret
1137+ 6E4B
1138+ 6E4B              ; -------------------------------------------------------------------
1139+ 6E4B              ; PlayCollectSound
1140+ 6E4B              ;
1141+ 6E4B              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1142+ 6E4B              ; dello ZX Spectrum utilizzando il port $FE.
1143+ 6E4B              ;
1144+ 6E4B              ; Il suono viene prodotto alternando ON/OFF del bit 4
1145+ 6E4B              ; (speaker) con un semplice delay software.
1146+ 6E4B              ;
1147+ 6E4B              ; Effetto risultante:
1148+ 6E4B              ;   beep breve tipo "pickup item"
1149+ 6E4B              ; -------------------------------------------------------------------
1150+ 6E4B              PlayCollectSound:
1151+ 6E4B
1152+ 6E4B                  ; Salva registri utilizzati
1153+ 6E4B C5               push bc
1154+ 6E4C D5               push de
1155+ 6E4D
1156+ 6E4D                  ; ---------------------------------------------------------------
1157+ 6E4D                  ; Numero di cicli del beep (durata complessiva del suono)
1158+ 6E4D                  ; ---------------------------------------------------------------
1159+ 6E4D 06 78            ld   b, 120
1160+ 6E4F
1161+ 6E4F              .sound_loop:
1162+ 6E4F
1163+ 6E4F                  ; ---------------------------------------------------------------
1164+ 6E4F                  ; SPEAKER ON
1165+ 6E4F                  ;
1166+ 6E4F                  ; Legge il colore del bordo corrente e attiva il bit 4
1167+ 6E4F                  ; per pilotare lo speaker.
1168+ 6E4F                  ; ---------------------------------------------------------------
1169+ 6E4F 3A D6 7A         ld   a, (room_border_color)
1170+ 6E52 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1171+ 6E54
1172+ 6E54 D3 FE            out  ($fe), a         ; scrive sul port ULA
1173+ 6E56
1174+ 6E56                  ; ---------------------------------------------------------------
1175+ 6E56                  ; Delay (mezzo periodo)
1176+ 6E56                  ; Loop software a consumo CPU
1177+ 6E56                  ; ---------------------------------------------------------------
1178+ 6E56 0E 3C            ld   c, 60
1179+ 6E58
1180+ 6E58              .d1:
1181+ 6E58 0D               dec  c
1182+ 6E59 20 FD            jr   nz, .d1
1183+ 6E5B
1184+ 6E5B                  ; ---------------------------------------------------------------
1185+ 6E5B                  ; SPEAKER OFF
1186+ 6E5B                  ;
1187+ 6E5B                  ; Mantiene il colore del bordo ma disattiva lo speaker
1188+ 6E5B                  ; ---------------------------------------------------------------
1189+ 6E5B 3A D6 7A         ld   a, (room_border_color)
1190+ 6E5E E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1191+ 6E60
1192+ 6E60 D3 FE            out  ($fe), a
1193+ 6E62
1194+ 6E62                  ; ---------------------------------------------------------------
1195+ 6E62                  ; Secondo delay (mezzo periodo)
1196+ 6E62                  ; Completa l’onda quadra
1197+ 6E62                  ; ---------------------------------------------------------------
1198+ 6E62 0E 3C            ld   c, 60
1199+ 6E64
1200+ 6E64              .d2:
1201+ 6E64 0D               dec  c
1202+ 6E65 20 FD            jr   nz, .d2
1203+ 6E67
1204+ 6E67                  ; ---------------------------------------------------------------
1205+ 6E67                  ; Ripete fino a completare il numero di cicli
1206+ 6E67                  ; ---------------------------------------------------------------
1207+ 6E67 10 E6            djnz .sound_loop
1208+ 6E69
1209+ 6E69                  ; Ripristina registri salvati
1210+ 6E69 D1               pop  de
1211+ 6E6A C1               pop  bc
1212+ 6E6B
1213+ 6E6B C9               ret
1214+ 6E6C
1215+ 6E6C              ; -------------------------------------------------------------------
1216+ 6E6C              ; CheckActiveItemAtCell
1217+ 6E6C              ;
1218+ 6E6C              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1219+ 6E6C              ; nella cella specificata della griglia items_grid.
1220+ 6E6C              ;
1221+ 6E6C              ; Questa routine usa una lookup diretta su una mappa 32x16,
1222+ 6E6C              ; evitando la scansione della ItemsTable.
1223+ 6E6C              ;
1224+ 6E6C              ; Input:
1225+ 6E6C              ;   B = Colonna (0..31)
1226+ 6E6C              ;   C = Riga (0..15)
1227+ 6E6C              ;
1228+ 6E6C              ; Output:
1229+ 6E6C              ;   Carry Set   = item presente nella cella
1230+ 6E6C              ;   Carry Clear = nessun item
1231+ 6E6C              ;
1232+ 6E6C              ; Nota:
1233+ 6E6C              ;   HL NON è restituito valido (commento originale non corretto:
1234+ 6E6C              ;   la routine non punta a ItemsTable).
1235+ 6E6C              ; -------------------------------------------------------------------
1236+ 6E6C              CheckActiveItemAtCell:
1237+ 6E6C
1238+ 6E6C                  ; Salva registri usati
1239+ 6E6C D5               push de
1240+ 6E6D E5               push hl
1241+ 6E6E
1242+ 6E6E                  ; ---------------------------------------------------------------
1243+ 6E6E                  ; Calcolo indice lineare nella griglia 32x16:
1244+ 6E6E                  ;
1245+ 6E6E                  ; offset = Row * 32 + Col
1246+ 6E6E                  ; ---------------------------------------------------------------
1247+ 6E6E 26 00            ld   h, 0
1248+ 6E70 69               ld   l, c              ; HL = Row
