 318+ 7C0F              ; -------------------------------------------------------------------
 319+ 7C0F              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 320+ 7C0F              ; -------------------------------------------------------------------
 321+ 7C0F              CheckEnemyWillyOverlap:
 322+ 7C0F 3A 35 F7         ld   a, (player_drawn_pos+1)
 323+ 7C12 FE FF            cp   $FF
 324+ 7C14 C8               ret  z                  ; Se Willy non è disegnato, esci
 325+ 7C15
 326+ 7C15                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 327+ 7C15 3A 34 F7         ld   a, (player_drawn_pos)
 328+ 7C18 E6 F8            and  $F8
 329+ 7C1A 5F               ld   e, a               ; E = WillyX & $F8
 330+ 7C1B 79               ld   a, c
 331+ 7C1C E6 F8            and  $F8                ; A = EnemyX & $F8
 332+ 7C1E 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 333+ 7C1F C6 10            add  a, 16
 334+ 7C21 FE 19            cp   25
 335+ 7C23 D0               ret  nc                 ; Fuori portata X
 336+ 7C24
 337+ 7C24                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 338+ 7C24 3A 35 F7         ld   a, (player_drawn_pos+1) ; A = WillyY
 339+ 7C27 90               sub  b                  ; A = WillyY - EnemyY
 340+ 7C28 C6 0F            add  a, 15
 341+ 7C2A FE 1F            cp   31
 342+ 7C2C D0               ret  nc                 ; Fuori portata Y
