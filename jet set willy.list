 161  892D                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 162  892D                  IF ENABLE_RAMP_DEBUG_BARS != 0
 163  892D ~                ld   a, (willy_on_ramp)
 164  892D ~                or   a
 165  892D ~                jp   nz, .draw_raster_bars
 166  892D                  ENDIF
