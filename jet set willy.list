  79+ 6D02 3E 01            ld   a, 1
  80+ 6D04 32 94 EC         ld   (a_prev), a            ; marca "A era premuto"
  81+ 6D07
  82+ 6D07 E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  83+ 6D08 C3 A2 6D         jp   PerformRoomChangePrev  ; salta al cambio stanza indietro (non torna qui)
  84+ 6D0B
  85+ 6D0B              .a_not_pressed:
