 346+ 71A4
 347+ 71A4 C9               ret
 348+ 71A5
 349+ 71A5              ; -------------------------------------------------------------------
 350+ 71A5              ; DrawRoomItems
 351+ 71A5              ;
 352+ 71A5              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 353+ 71A5              ;
 354+ 71A5              ; Operazioni eseguite:
 355+ 71A5              ;   1. Azzera la griglia items_grid.
 356+ 71A5              ;   2. Svuota la cache degli oggetti attivi.
 357+ 71A5              ;   3. Scansiona ItemsTable.
 358+ 71A5              ;   4. Per ogni item della stanza corrente:
 359+ 71A5              ;        - verifica se è già stato raccolto
 360+ 71A5              ;        - disegna la grafica
 361+ 71A5              ;        - aggiorna items_grid
 362+ 71A5              ;        - memorizza l'item nella cache current_room_items
 363+ 71A5              ;   5. Aggiorna num_room_items.
 364+ 71A5              ;
 365+ 71A5              ; Record ItemsTable:
 366+ 71A5              ;   +0  Room ID
 367+ 71A5              ;   +1  X (colonna)
 368+ 71A5              ;   +2  Y (riga)
 369+ 71A5              ;   +3  Colore
 370+ 71A5              ;   +4  Collected flag
 371+ 71A5              ;
 372+ 71A5              ; Cache current_room_items:
 373+ 71A5              ;   +0  Colonna
 374+ 71A5              ;   +1  Riga
 375+ 71A5              ;   +2  Colore
 376+ 71A5              ;   +3  Collected flag ptr (Low)
 377+ 71A5              ;   +4  Collected flag ptr (High)
 378+ 71A5              ;
 379+ 71A5              ; Ogni record cache occupa 5 byte.
 380+ 71A5              ; -------------------------------------------------------------------
 381+ 71A5              DrawRoomItems:
 382+ 71A5
 383+ 71A5                  ; Salva tutti i registri utilizzati
 384+ 71A5 E5               push hl
 385+ 71A6 D5               push de
 386+ 71A7 C5               push bc
 387+ 71A8 DD E5            push ix
 388+ 71AA FD E5            push iy
 389+ 71AC
 390+ 71AC                  ; ---------------------------------------------------------------
 391+ 71AC                  ; Azzera items_grid (32 x 16 = 512 byte)
 392+ 71AC                  ; ---------------------------------------------------------------
 393+ 71AC 21 00 A5         ld   hl, items_grid
 394+ 71AF 11 01 A5         ld   de, items_grid + 1
 395+ 71B2 36 00            ld   (hl), 0
 396+ 71B4 01 FF 01         ld   bc, 511
 397+ 71B7 ED B0            ldir
 398+ 71B9
 399+ 71B9                  ; ---------------------------------------------------------------
 400+ 71B9                  ; Nessun item attivo nella stanza
 401+ 71B9                  ; ---------------------------------------------------------------
 402+ 71B9 AF               xor  a
 403+ 71BA 32 F9 76         ld   (num_room_items), a
 404+ 71BD
 405+ 71BD                  ; IY punta alla cache degli item attivi
 406+ 71BD FD 21 A9 76      ld   iy, current_room_items
 407+ 71C1
 408+ 71C1                  ; ---------------------------------------------------------------
 409+ 71C1                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 410+ 71C1                  ; alla stanza corrente.
 411+ 71C1                  ;
 412+ 71C1                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 413+ 71C1                  ; ---------------------------------------------------------------
 414+ 71C1 2A FA 76         ld   hl, (room_ptr)
 415+ 71C4 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 416+ 71C7 19               add  hl, de
 417+ 71C8
 418+ 71C8 E5               push hl
 419+ 71C9 DD E1            pop  ix                ; IX = bitmap item
 420+ 71CB
 421+ 71CB                  ; ---------------------------------------------------------------
 422+ 71CB                  ; Inizio scansione della tabella degli item
 423+ 71CB                  ; ---------------------------------------------------------------
 424+ 71CB 21 35 70         ld   hl, ItemsTable
 425+ 71CE
 426+ 71CE              .loop:
 427+ 71CE
 428+ 71CE                  ; ---------------------------------------------------------------
 429+ 71CE                  ; Legge il Room ID del record corrente
 430+ 71CE                  ; ---------------------------------------------------------------
 431+ 71CE 7E               ld   a, (hl)
 432+ 71CF
 433+ 71CF                  ; $FF indica fine tabella
 434+ 71CF FE FF            cp   $FF
 435+ 71D1 28 53            jr   z, .done
 436+ 71D3
 437+ 71D3                  ; ---------------------------------------------------------------
 438+ 71D3                  ; Verifica se l'item appartiene alla stanza corrente
 439+ 71D3                  ; ---------------------------------------------------------------
 440+ 71D3 57               ld   d, a
 441+ 71D4
 442+ 71D4 3A A0 76         ld   a, (current_room)
 443+ 71D7 BA               cp   d
 444+ 71D8 20 45            jr   nz, .next_item
 445+ 71DA
 446+ 71DA                  ; ---------------------------------------------------------------
 447+ 71DA                  ; Legge i dati dell'item
 448+ 71DA                  ; ---------------------------------------------------------------
 449+ 71DA
 450+ 71DA 23               inc  hl
 451+ 71DB 4E               ld   c, (hl)           ; X (colonna)
 452+ 71DC
 453+ 71DC 23               inc  hl
 454+ 71DD 46               ld   b, (hl)           ; Y (riga)
 455+ 71DE
 456+ 71DE 23               inc  hl
 457+ 71DF 5E               ld   e, (hl)           ; Colore
 458+ 71E0
 459+ 71E0 23               inc  hl
 460+ 71E1 7E               ld   a, (hl)           ; Collected flag
 461+ 71E2
 462+ 71E2                  ; Se diverso da zero l'item è già stato raccolto
 463+ 71E2 B7               or   a
 464+ 71E3 20 3E            jr   nz, .next_no_inc
 465+ 71E5
 466+ 71E5                  ; ---------------------------------------------------------------
 467+ 71E5                  ; Disegna l'item sullo schermo
 468+ 71E5                  ;
 469+ 71E5                  ; B = Row
 470+ 71E5                  ; C = Column
 471+ 71E5                  ; HL = bitmap pointer
 472+ 71E5                  ; E = Color
 473+ 71E5                  ; ---------------------------------------------------------------
 474+ 71E5 E5               push hl
 475+ 71E6
 476+ 71E6 DD E5            push ix
 477+ 71E8 E1               pop  hl
 478+ 71E9
 479+ 71E9 CD 2E 72         call DrawItemGraphic
 480+ 71EC
 481+ 71EC E1               pop  hl                ; ritorna al flag collected
 482+ 71ED
 483+ 71ED                  ; ---------------------------------------------------------------
 484+ 71ED                  ; Aggiorna items_grid
 485+ 71ED                  ;
 486+ 71ED                  ; Calcolo:
 487+ 71ED                  ;   offset = Row * 32 + Col
 488+ 71ED                  ; ---------------------------------------------------------------
 489+ 71ED E5               push hl
 490+ 71EE D5               push de
 491+ 71EF
 492+ 71EF 26 00            ld   h, 0
 493+ 71F1 68               ld   l, b              ; HL = Row
 494+ 71F2
 495+ 71F2 29               add  hl, hl            ; *2
 496+ 71F3 29               add  hl, hl            ; *4
 497+ 71F4 29               add  hl, hl            ; *8
 498+ 71F5 29               add  hl, hl            ; *16
 499+ 71F6 29               add  hl, hl            ; *32
 500+ 71F7
 501+ 71F7 16 00            ld   d, 0
 502+ 71F9 59               ld   e, c              ; DE = Col
 503+ 71FA
 504+ 71FA 19               add  hl, de            ; Row*32 + Col
 505+ 71FB
 506+ 71FB 11 00 A5         ld   de, items_grid
 507+ 71FE 19               add  hl, de            ; puntatore nella griglia
 508+ 71FF
 509+ 71FF D1               pop  de                ; ripristina colore
 510+ 7200
 511+ 7200 73               ld   (hl), e           ; salva colore cella
 512+ 7201
 513+ 7201 E1               pop  hl
 514+ 7202
 515+ 7202                  ; ---------------------------------------------------------------
 516+ 7202                  ; Salva l'item nella cache della stanza
 517+ 7202                  ;
 518+ 7202                  ; Questo evita di dover scansionare tutta ItemsTable
 519+ 7202                  ; durante il controllo delle collisioni.
 520+ 7202                  ; ---------------------------------------------------------------
 521+ 7202
 522+ 7202 FD 71 00         ld   (iy+0), c         ; Colonna
 523+ 7205 FD 70 01         ld   (iy+1), b         ; Riga
 524+ 7208 FD 73 02         ld   (iy+2), e         ; Colore
 525+ 720B
 526+ 720B                  ; Salva il puntatore al flag "collected"
 527+ 720B FD 75 03         ld   (iy+3), l         ; Low byte
 528+ 720E FD 74 04         ld   (iy+4), h         ; High byte
 529+ 7211
 530+ 7211                  ; Passa al record successivo della cache
 531+ 7211 01 05 00         ld   bc, 5
 532+ 7214 FD 09            add  iy, bc
 533+ 7216
 534+ 7216                  ; Incrementa il numero di item attivi
 535+ 7216 3A F9 76         ld   a, (num_room_items)
 536+ 7219 3C               inc  a
 537+ 721A 32 F9 76         ld   (num_room_items), a
 538+ 721D
 539+ 721D 18 04            jr   .next_no_inc
 540+ 721F
 541+ 721F              .next_item:
 542+ 721F
 543+ 721F                  ; ---------------------------------------------------------------
 544+ 721F                  ; L'item non appartiene alla stanza corrente.
 545+ 721F                  ; Salta i campi del record:
 546+ 721F                  ;   X
 547+ 721F                  ;   Y
 548+ 721F                  ;   Color
 549+ 721F                  ;   Collected
 550+ 721F                  ; ---------------------------------------------------------------
 551+ 721F 23               inc  hl
 552+ 7220 23               inc  hl
 553+ 7221 23               inc  hl
 554+ 7222 23               inc  hl
 555+ 7223
 556+ 7223              .next_no_inc:
 557+ 7223
 558+ 7223                  ; ---------------------------------------------------------------
 559+ 7223                  ; Avanza al record successivo
 560+ 7223                  ; (prossimo Room ID)
 561+ 7223                  ; ---------------------------------------------------------------
 562+ 7223 23               inc  hl
 563+ 7224 18 A8            jr   .loop
 564+ 7226
 565+ 7226              .done:
 566+ 7226
 567+ 7226                  ; Ripristina i registri
 568+ 7226 FD E1            pop  iy
 569+ 7228 DD E1            pop  ix
 570+ 722A D1               pop  de
 571+ 722B C1               pop  bc
 572+ 722C E1               pop  hl
 573+ 722D
 574+ 722D C9               ret
 575+ 722E
 576+ 722E              ; -------------------------------------------------------------------
 577+ 722E              ; DrawItemGraphic
 578+ 722E              ;
 579+ 722E              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 580+ 722E              ; utilizzando una bitmap di 8 byte e un attributo colore.
 581+ 722E              ;
 582+ 722E              ; Input:
 583+ 722E              ;   B = Riga attributi (3..18)
 584+ 722E              ;   C = Colonna attributi (0..31)
 585+ 722E              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 586+ 722E              ;   E = Attributo colore
 587+ 722E              ;
 588+ 722E              ; Output:
 589+ 722E              ;   Nessuno
 590+ 722E              ;
 591+ 722E              ; Registri preservati:
 592+ 722E              ;   BC, DE, HL
 593+ 722E              ; -------------------------------------------------------------------
 594+ 722E              DrawItemGraphic:
 595+ 722E
 596+ 722E                  ; Salva i registri originali
 597+ 722E C5               push bc
 598+ 722F D5               push de
 599+ 7230 E5               push hl
 600+ 7231
 601+ 7231                  ; ---------------------------------------------------------------
 602+ 7231                  ; Calcolo indirizzo bitmap dello Spectrum
 603+ 7231                  ;
 604+ 7231                  ; Ogni item occupa una cella attributi (8x8 pixel).
 605+ 7231                  ;
 606+ 7231                  ; Formula:
 607+ 7231                  ;   High = $40 + (Row AND $18)
 608+ 7231                  ;   Low  = (Row AND 7) * 32 + Col
 609+ 7231                  ;
 610+ 7231                  ; DE conterrà l'indirizzo della prima scanline.
 611+ 7231                  ; ---------------------------------------------------------------
 612+ 7231
 613+ 7231 78               ld   a, b
 614+ 7232 E6 18            and  $18
 615+ 7234 C6 40            add  a, $40
 616+ 7236 57               ld   d, a              ; Byte alto indirizzo video
 617+ 7237
 618+ 7237 78               ld   a, b
 619+ 7238 E6 07            and  7                 ; Riga interna al blocco da 8
 620+ 723A
 621+ 723A 87               add  a, a              ; *2
 622+ 723B 87               add  a, a              ; *4
 623+ 723C 87               add  a, a              ; *8
 624+ 723D 87               add  a, a              ; *16
 625+ 723E 87               add  a, a              ; *32
 626+ 723F
 627+ 723F 81               add  a, c              ; + colonna
 628+ 7240
 629+ 7240 5F               ld   e, a              ; Byte basso indirizzo video
 630+ 7241
 631+ 7241                  ; ---------------------------------------------------------------
 632+ 7241                  ; Disegno bitmap
 633+ 7241                  ;
 634+ 7241                  ; Copia 8 byte consecutivi nella memoria video.
 635+ 7241                  ; Ogni byte rappresenta una scanline da 8 pixel.
 636+ 7241                  ; ---------------------------------------------------------------
 637+ 7241
 638+ 7241 C5               push bc                ; Conserva Row e Col
 639+ 7242
 640+ 7242 06 08            ld   b, 8              ; Numero scanline
 641+ 7244
 642+ 7244              .line_loop:
 643+ 7244
 644+ 7244 7E               ld   a, (hl)           ; Legge scanline bitmap
 645+ 7245 12               ld   (de), a           ; Scrive nella memoria video
 646+ 7246
 647+ 7246 14               inc  d                 ; Scanline successiva
 648+ 7247 23               inc  hl                ; Byte bitmap successivo
 649+ 7248
 650+ 7248 05               dec  b
 651+ 7249 20 F9            jr   nz, .line_loop
 652+ 724B
 653+ 724B C1               pop  bc                ; Ripristina Row e Col
 654+ 724C
 655+ 724C                  ; ---------------------------------------------------------------
 656+ 724C                  ; Calcolo indirizzo attributo
 657+ 724C                  ;
 658+ 724C                  ; Formula:
 659+ 724C                  ;   AttrAddr = $5800 + Row * 32 + Col
 660+ 724C                  ;
 661+ 724C                  ; HL conterrà l'indirizzo della cella attributi.
 662+ 724C                  ; ---------------------------------------------------------------
 663+ 724C
 664+ 724C 26 00            ld   h, 0
 665+ 724E 68               ld   l, b              ; HL = Row
 666+ 724F
 667+ 724F 29               add  hl, hl            ; *2
 668+ 7250 29               add  hl, hl            ; *4
 669+ 7251 29               add  hl, hl            ; *8
 670+ 7252 29               add  hl, hl            ; *16
 671+ 7253 29               add  hl, hl            ; *32
 672+ 7254
 673+ 7254 79               ld   a, c              ; A = Colonna
 674+ 7255
 675+ 7255 85               add  a, l
 676+ 7256 6F               ld   l, a
 677+ 7257
 678+ 7257 30 01            jr   nc, .no_carry
 679+ 7259 24               inc  h
 680+ 725A
 681+ 725A              .no_carry:
 682+ 725A
 683+ 725A                  ; HL = Row * 32 + Col
 684+ 725A
 685+ 725A 11 00 58         ld   de, $5800
 686+ 725D 19               add  hl, de            ; HL = indirizzo attributi
 687+ 725E
 688+ 725E                  ; ---------------------------------------------------------------
 689+ 725E                  ; Recupera il colore originale dallo stack.
 690+ 725E                  ;
 691+ 725E                  ; Layout stack:
 692+ 725E                  ;   HL originale
 693+ 725E                  ;   DE originale (E = colore)
 694+ 725E                  ;   BC originale
 695+ 725E                  ; ---------------------------------------------------------------
 696+ 725E
 697+ 725E C1               pop  bc                ; Recupera HL originale
 698+ 725F D1               pop  de                ; Recupera DE originale
 699+ 7260
 700+ 7260                  ; ---------------------------------------------------------------
 701+ 7260                  ; Scrive l'attributo colore
 702+ 7260                  ; ---------------------------------------------------------------
 703+ 7260
 704+ 7260 7B               ld   a, e              ; A = colore
 705+ 7261 77               ld   (hl), a           ; Scrive nella RAM attributi
 706+ 7262
 707+ 7262                  ; ---------------------------------------------------------------
 708+ 7262                  ; Ripristina HL e BC originali
 709+ 7262                  ; ---------------------------------------------------------------
 710+ 7262
 711+ 7262 C5               push bc
 712+ 7263 E1               pop  hl                ; HL originale
 713+ 7264
 714+ 7264 C1               pop  bc                ; BC originale
 715+ 7265
 716+ 7265 C9               ret
 717+ 7266
 718+ 7266              ; -------------------------------------------------------------------
 719+ 7266              ; RestoreBackgroundCell
 720+ 7266              ;
 721+ 7266              ; Ripristina il contenuto originale di una cella della stanza.
 722+ 7266              ; Viene utilizzata principalmente quando un item viene raccolto:
 723+ 7266              ; invece di lasciare un "buco", la routine ridisegna il tile
 724+ 7266              ; originale presente nella mappa della stanza.
 725+ 7266              ;
 726+ 7266              ; Input:
 727+ 7266              ;   B = Row (3..18)
 728+ 7266              ;   C = Col (0..31)
 729+ 7266              ;
 730+ 7266              ; Utilizza:
 731+ 7266              ;   room_ptr -> struttura dati della stanza corrente
 732+ 7266              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 733+ 7266              ;   DrawTile -> ridisegna il tile selezionato
 734+ 7266              ;
 735+ 7266              ; Tipi di cella:
 736+ 7266              ;   0 = Background
 737+ 7266              ;   1 = Floor
 738+ 7266              ;   2 = Wall
 739+ 7266              ;   3 = Nasty
 740+ 7266              ; -------------------------------------------------------------------
 741+ 7266              RestoreBackgroundCell:
 742+ 7266
 743+ 7266                  ; Salva tutti i registri utilizzati
 744+ 7266 FD E5            push iy
 745+ 7268 C5               push bc
 746+ 7269 D5               push de
 747+ 726A E5               push hl
 748+ 726B DD E5            push ix
 749+ 726D
 750+ 726D                  ; ---------------------------------------------------------------
 751+ 726D                  ; Conserva Row e Col in IY.
 752+ 726D                  ;
 753+ 726D                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 754+ 726D                  ; BC potrebbe essere modificato.
 755+ 726D                  ; ---------------------------------------------------------------
 756+ 726D C5               push bc
 757+ 726E FD E1            pop  iy                ; IYH = Row, IYL = Col
 758+ 7270
 759+ 7270                  ; ---------------------------------------------------------------
 760+ 7270                  ; Determina quale tipo di cella è presente nella posizione
 761+ 7270                  ; specificata.
 762+ 7270                  ;
 763+ 7270                  ; Input:
 764+ 7270                  ;   B = Row
 765+ 7270                  ;   C = Col
 766+ 7270                  ;
 767+ 7270                  ; Output:
 768+ 7270                  ;   A = tipo cella
 769+ 7270                  ; ---------------------------------------------------------------
 770+ 7270 78               ld   a, b
 771+ 7271
 772+ 7271 CD 61 6B         call GetCellFromUnpacked
 773+ 7274
 774+ 7274                  ; ---------------------------------------------------------------
 775+ 7274                  ; Recupera il puntatore alla stanza corrente.
 776+ 7274                  ;
 777+ 7274                  ; DE = base della struttura stanza
 778+ 7274                  ; ---------------------------------------------------------------
 779+ 7274 ED 5B FA 76      ld   de, (room_ptr)
 780+ 7278
 781+ 7278                  ; ---------------------------------------------------------------
 782+ 7278                  ; Seleziona il tile corretto in base al tipo di cella.
 783+ 7278                  ;
 784+ 7278                  ; A = 0 -> Background
 785+ 7278                  ; A = 1 -> Floor
 786+ 7278                  ; A = 2 -> Wall
 787+ 7278                  ; A = 3 -> Nasty
 788+ 7278                  ; ---------------------------------------------------------------
 789+ 7278
 790+ 7278 B7               or   a
 791+ 7279 20 06            jr   nz, .not_bg
 792+ 727B
 793+ 727B                  ; Background
 794+ 727B 21 A0 00         ld   hl, OFFSET_BG
 795+ 727E 19               add  hl, de
 796+ 727F 18 16            jr   .draw_cell
 797+ 7281
 798+ 7281              .not_bg:
 799+ 7281
 800+ 7281 3D               dec  a
 801+ 7282 20 06            jr   nz, .not_floor
 802+ 7284
 803+ 7284                  ; Floor
 804+ 7284 21 A9 00         ld   hl, OFFSET_FLOOR
 805+ 7287 19               add  hl, de
 806+ 7288 18 0D            jr   .draw_cell
 807+ 728A
 808+ 728A              .not_floor:
 809+ 728A
 810+ 728A 3D               dec  a
 811+ 728B 20 06            jr   nz, .not_wall
 812+ 728D
 813+ 728D                  ; Wall
 814+ 728D 21 B2 00         ld   hl, OFFSET_WALL
 815+ 7290 19               add  hl, de
 816+ 7291 18 04            jr   .draw_cell
 817+ 7293
 818+ 7293              .not_wall:
 819+ 7293
 820+ 7293                  ; Nasty
 821+ 7293 21 BB 00         ld   hl, OFFSET_NASTY
 822+ 7296 19               add  hl, de
 823+ 7297
 824+ 7297              .draw_cell:
 825+ 7297
 826+ 7297                  ; ---------------------------------------------------------------
 827+ 7297                  ; HL punta ora alla grafica del tile da ridisegnare.
 828+ 7297                  ;
 829+ 7297                  ; DrawTile si aspetta:
 830+ 7297                  ;   IX = puntatore tile
 831+ 7297                  ;   B  = Row
 832+ 7297                  ;   C  = Col
 833+ 7297                  ; ---------------------------------------------------------------
 834+ 7297 E5               push hl
 835+ 7298 DD E1            pop  ix
 836+ 729A
 837+ 729A                  ; Ripristina Row e Col salvati in IY
 838+ 729A FD E5            push iy
 839+ 729C C1               pop  bc
 840+ 729D
 841+ 729D                  ; Disegna il tile originale
 842+ 729D CD 8C 61         call DrawTile
 843+ 72A0
 844+ 72A0                  ; ---------------------------------------------------------------
 845+ 72A0                  ; Ripristina i registri salvati
 846+ 72A0                  ; ---------------------------------------------------------------
 847+ 72A0 DD E1            pop  ix
 848+ 72A2 E1               pop  hl
 849+ 72A3 D1               pop  de
 850+ 72A4 C1               pop  bc
 851+ 72A5 FD E1            pop  iy
 852+ 72A7
 853+ 72A7 C9               ret
 854+ 72A8
 855+ 72A8              ; -------------------------------------------------------------------
 856+ 72A8              ; CheckWillyItemCollision
 857+ 72A8              ;
 858+ 72A8              ; Verifica se Willy collide con un item utilizzando il controllo
 859+ 72A8              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 860+ 72A8              ;
 861+ 72A8              ; Input:
 862+ 72A8              ;   A = ItemX (colonna attributi 0..31)
 863+ 72A8              ;   H = ItemY (riga attributi 3..18)
 864+ 72A8              ;
 865+ 72A8              ; Coordinate item:
 866+ 72A8              ;   Ogni item occupa una cella da 8x8 pixel.
 867+ 72A8              ;
 868+ 72A8              ; Coordinate Willy:
 869+ 72A8              ;   Willy occupa un rettangolo di 16x16 pixel.
 870+ 72A8              ;
 871+ 72A8              ; Output:
 872+ 72A8              ;   Carry Set   = collisione rilevata
 873+ 72A8              ;   Carry Clear = nessuna collisione
 874+ 72A8              ;
 875+ 72A8              ; Registri preservati:
 876+ 72A8              ;   BC, DE, HL
 877+ 72A8              ; -------------------------------------------------------------------
 878+ 72A8              CheckWillyItemCollision:
 879+ 72A8
 880+ 72A8                  ; Salva i registri utilizzati
 881+ 72A8 C5               push bc
 882+ 72A9 D5               push de
 883+ 72AA E5               push hl
 884+ 72AB
 885+ 72AB                  ; ---------------------------------------------------------------
 886+ 72AB                  ; Calcola il bounding box orizzontale dell'item
 887+ 72AB                  ;
 888+ 72AB                  ; ItemLeft  = ItemX * 8
 889+ 72AB                  ; ItemRight = ItemLeft + 7
 890+ 72AB                  ;
 891+ 72AB                  ; E = ItemLeft
 892+ 72AB                  ; D = ItemRight
 893+ 72AB                  ; ---------------------------------------------------------------
 894+ 72AB 6F               ld   l, a              ; L = ItemX
 895+ 72AC
 896+ 72AC 7D               ld   a, l
 897+ 72AD 87               add  a, a              ; *2
 898+ 72AE 87               add  a, a              ; *4
 899+ 72AF 87               add  a, a              ; *8
 900+ 72B0
 901+ 72B0 5F               ld   e, a              ; E = ItemLeft
 902+ 72B1
 903+ 72B1 C6 07            add  a, 7
 904+ 72B3 57               ld   d, a              ; D = ItemRight
 905+ 72B4
 906+ 72B4                  ; ---------------------------------------------------------------
 907+ 72B4                  ; Recupera la posizione corrente di Willy
 908+ 72B4                  ;
 909+ 72B4                  ; B = WillyY
 910+ 72B4                  ; C = WillyX
 911+ 72B4                  ; ---------------------------------------------------------------
 912+ 72B4 ED 4B 89 73      ld   bc, (PlayerPos)
 913+ 72B8
 914+ 72B8                  ; ---------------------------------------------------------------
 915+ 72B8                  ; Primo test:
 916+ 72B8                  ;
 917+ 72B8                  ; WillyLeft <= ItemRight
 918+ 72B8                  ;
 919+ 72B8                  ; Se Willy è completamente a destra dell'item
 920+ 72B8                  ; non può esserci collisione.
 921+ 72B8                  ; ---------------------------------------------------------------
 922+ 72B8 79               ld   a, c              ; A = WillyLeft
 923+ 72B9
 924+ 72B9 BA               cp   d                 ; WillyLeft vs ItemRight
 925+ 72BA
 926+ 72BA 28 04            jr   z, .x_ok
 927+ 72BC 38 02            jr   c, .x_ok
 928+ 72BE
 929+ 72BE 18 29            jr   .no_collision
 930+ 72C0
 931+ 72C0              .x_ok:
 932+ 72C0
 933+ 72C0                  ; ---------------------------------------------------------------
 934+ 72C0                  ; Secondo test:
 935+ 72C0                  ;
 936+ 72C0                  ; WillyRight >= ItemLeft
 937+ 72C0                  ;
 938+ 72C0                  ; WillyRight = WillyX + 7
 939+ 72C0                  ; ---------------------------------------------------------------
 940+ 72C0 C6 07            add  a, 7
 941+ 72C2
 942+ 72C2 BB               cp   e                 ; WillyRight vs ItemLeft
 943+ 72C3
 944+ 72C3 28 04            jr   z, .y_check
 945+ 72C5 30 02            jr   nc, .y_check
 946+ 72C7
 947+ 72C7 18 20            jr   .no_collision
 948+ 72C9
 949+ 72C9              .y_check:
 950+ 72C9
 951+ 72C9                  ; ---------------------------------------------------------------
 952+ 72C9                  ; Recupera ItemY dal valore originale di HL
 953+ 72C9                  ;
 954+ 72C9                  ; H contiene la riga dell'item.
 955+ 72C9                  ; ---------------------------------------------------------------
 956+ 72C9 E1               pop  hl
 957+ 72CA E5               push hl
 958+ 72CB
 959+ 72CB                  ; ---------------------------------------------------------------
 960+ 72CB                  ; Calcola il bounding box verticale dell'item
 961+ 72CB                  ;
 962+ 72CB                  ; ItemTop    = ItemY * 8
 963+ 72CB                  ; ItemBottom = ItemTop + 7
 964+ 72CB                  ;
 965+ 72CB                  ; E = ItemTop
 966+ 72CB                  ; D = ItemBottom
 967+ 72CB                  ; ---------------------------------------------------------------
 968+ 72CB 7C               ld   a, h
 969+ 72CC
 970+ 72CC 87               add  a, a              ; *2
 971+ 72CD 87               add  a, a              ; *4
 972+ 72CE 87               add  a, a              ; *8
 973+ 72CF
 974+ 72CF 5F               ld   e, a              ; ItemTop
 975+ 72D0
 976+ 72D0 C6 07            add  a, 7
 977+ 72D2 57               ld   d, a              ; ItemBottom
 978+ 72D3
 979+ 72D3                  ; ---------------------------------------------------------------
 980+ 72D3                  ; Primo test verticale:
 981+ 72D3                  ;
 982+ 72D3                  ; WillyTop <= ItemBottom
 983+ 72D3                  ; ---------------------------------------------------------------
 984+ 72D3 78               ld   a, b              ; WillyTop
 985+ 72D4
 986+ 72D4 BA               cp   d
 987+ 72D5
 988+ 72D5 28 04            jr   z, .y_ok
 989+ 72D7 38 02            jr   c, .y_ok
 990+ 72D9
 991+ 72D9 18 0E            jr   .no_collision
 992+ 72DB
 993+ 72DB              .y_ok:
 994+ 72DB
 995+ 72DB                  ; ---------------------------------------------------------------
 996+ 72DB                  ; Secondo test verticale:
 997+ 72DB                  ;
 998+ 72DB                  ; WillyBottom >= ItemTop
 999+ 72DB                  ;
1000+ 72DB                  ; WillyBottom = WillyY + 15
1001+ 72DB                  ; ---------------------------------------------------------------
1002+ 72DB C6 0F            add  a, 15
1003+ 72DD
1004+ 72DD BB               cp   e
1005+ 72DE
1006+ 72DE 28 04            jr   z, .collision
1007+ 72E0 30 02            jr   nc, .collision
1008+ 72E2
1009+ 72E2 18 05            jr   .no_collision
1010+ 72E4
1011+ 72E4              .collision:
1012+ 72E4
1013+ 72E4                  ; ---------------------------------------------------------------
1014+ 72E4                  ; Collisione rilevata
1015+ 72E4                  ; ---------------------------------------------------------------
1016+ 72E4 E1               pop  hl
1017+ 72E5 D1               pop  de
1018+ 72E6 C1               pop  bc
1019+ 72E7
1020+ 72E7 37               scf                    ; Carry = 1
1021+ 72E8
1022+ 72E8 C9               ret
1023+ 72E9
1024+ 72E9              .no_collision:
1025+ 72E9
1026+ 72E9                  ; ---------------------------------------------------------------
1027+ 72E9                  ; Nessuna collisione
1028+ 72E9                  ; ---------------------------------------------------------------
1029+ 72E9 E1               pop  hl
1030+ 72EA D1               pop  de
1031+ 72EB C1               pop  bc
1032+ 72EC
1033+ 72EC B7               or   a                 ; Carry = 0
1034+ 72ED
1035+ 72ED C9               ret
1036+ 72EE
1037+ 72EE              ; -------------------------------------------------------------------
1038+ 72EE              ; CheckRoomItemsCollision
1039+ 72EE              ;
1040+ 72EE              ; Controlla se Willy entra in collisione con uno degli item
1041+ 72EE              ; attivi presenti nella stanza corrente.
1042+ 72EE              ;
1043+ 72EE              ; Per ogni item:
1044+ 72EE              ;   - verifica che appartenga alla stanza corrente
1045+ 72EE              ;   - verifica che non sia già stato raccolto
1046+ 72EE              ;   - esegue il test di collisione con Willy
1047+ 72EE              ;
1048+ 72EE              ; Se l'item viene raccolto:
1049+ 72EE              ;   - imposta il flag "collected"
1050+ 72EE              ;   - rimuove l'item dalla cache items_grid
1051+ 72EE              ;   - incrementa il contatore degli oggetti raccolti
1052+ 72EE              ;   - aggiorna l'HUD
1053+ 72EE              ;   - ripristina il tile di sfondo
1054+ 72EE              ;   - riproduce il suono di raccolta
1055+ 72EE              ;
1056+ 72EE              ; Formato record ItemsTable:
1057+ 72EE              ;   +0 RoomID
1058+ 72EE              ;   +1 X
1059+ 72EE              ;   +2 Y
1060+ 72EE              ;   +3 Color
1061+ 72EE              ;   +4 Collected
1062+ 72EE              ;
1063+ 72EE              ; Fine tabella:
1064+ 72EE              ;   RoomID = $FF
1065+ 72EE              ; -------------------------------------------------------------------
1066+ 72EE              CheckRoomItemsCollision:
1067+ 72EE
1068+ 72EE                  ; Salva i registri utilizzati
1069+ 72EE E5               push hl
1070+ 72EF D5               push de
1071+ 72F0 C5               push bc
1072+ 72F1
1073+ 72F1                  ; Inizio scansione della tabella degli item
1074+ 72F1 21 35 70         ld   hl, ItemsTable
1075+ 72F4
1076+ 72F4              .loop:
1077+ 72F4
1078+ 72F4                  ; ---------------------------------------------------------------
1079+ 72F4                  ; Legge il Room ID dell'item corrente
1080+ 72F4                  ; ---------------------------------------------------------------
1081+ 72F4 7E               ld   a, (hl)
1082+ 72F5
1083+ 72F5                  ; $FF indica fine tabella
1084+ 72F5 FE FF            cp   $FF
1085+ 72F7 28 4D            jr   z, .done
1086+ 72F9
1087+ 72F9                  ; ---------------------------------------------------------------
1088+ 72F9                  ; Verifica se l'item appartiene alla stanza corrente
1089+ 72F9                  ; ---------------------------------------------------------------
1090+ 72F9 57               ld   d, a              ; D = RoomID item
1091+ 72FA
1092+ 72FA 3A A0 76         ld   a, (current_room)
1093+ 72FD BA               cp   d
1094+ 72FE
1095+ 72FE                  ; Se appartiene a un'altra stanza salta il record
1096+ 72FE 20 3F            jr   nz, .next_item
1097+ 7300
1098+ 7300                  ; ---------------------------------------------------------------
1099+ 7300                  ; Legge coordinate e stato dell'item
1100+ 7300                  ; ---------------------------------------------------------------
1101+ 7300
1102+ 7300 23               inc  hl
1103+ 7301 4E               ld   c, (hl)           ; C = X
1104+ 7302
1105+ 7302 23               inc  hl
1106+ 7303 46               ld   b, (hl)           ; B = Y
1107+ 7304
1108+ 7304 23               inc  hl                ; salta Color
1109+ 7305
1110+ 7305 23               inc  hl                ; punta a Collected
1111+ 7306
1112+ 7306 7E               ld   a, (hl)
1113+ 7307
1114+ 7307                  ; ---------------------------------------------------------------
1115+ 7307                  ; Item già raccolto?
1116+ 7307                  ; ---------------------------------------------------------------
1117+ 7307 B7               or   a
1118+ 7308 20 39            jr   nz, .next_no_inc
1119+ 730A
1120+ 730A                  ; ---------------------------------------------------------------
1121+ 730A                  ; Test collisione Willy ↔ Item
1122+ 730A                  ;
1123+ 730A                  ; Input richiesto:
1124+ 730A                  ;   A = ItemX
1125+ 730A                  ;   H = ItemY
1126+ 730A                  ; ---------------------------------------------------------------
1127+ 730A 79               ld   a, c
1128+ 730B
1129+ 730B E5               push hl                ; salva puntatore al flag Collected
1130+ 730C
1131+ 730C 60               ld   h, b
1132+ 730D
1133+ 730D CD A8 72         call CheckWillyItemCollision
1134+ 7310
1135+ 7310 E1               pop  hl
1136+ 7311
1137+ 7311                  ; Nessuna collisione
1138+ 7311 30 30            jr   nc, .next_no_inc
1139+ 7313
1140+ 7313                  ; ===============================================================
1141+ 7313                  ; ITEM RACCOLTO
1142+ 7313                  ; ===============================================================
1143+ 7313
1144+ 7313                  ; ---------------------------------------------------------------
1145+ 7313                  ; Marca l'item come raccolto
1146+ 7313                  ; ---------------------------------------------------------------
1147+ 7313 36 01            ld   (hl), 1
1148+ 7315
1149+ 7315                  ; ---------------------------------------------------------------
1150+ 7315                  ; Rimuove l'item dalla cache items_grid
1151+ 7315                  ;
1152+ 7315                  ; Calcolo:
1153+ 7315                  ;   offset = Row * 32 + Col
1154+ 7315                  ; ---------------------------------------------------------------
1155+ 7315 E5               push hl
1156+ 7316 D5               push de
1157+ 7317
1158+ 7317 26 00            ld   h, 0
1159+ 7319 68               ld   l, b              ; HL = Row
1160+ 731A
1161+ 731A 29               add  hl, hl            ; *2
1162+ 731B 29               add  hl, hl            ; *4
1163+ 731C 29               add  hl, hl            ; *8
1164+ 731D 29               add  hl, hl            ; *16
1165+ 731E 29               add  hl, hl            ; *32
1166+ 731F
1167+ 731F 59               ld   e, c
1168+ 7320 16 00            ld   d, 0
1169+ 7322
1170+ 7322 19               add  hl, de            ; Row*32 + Col
1171+ 7323
1172+ 7323 11 00 A5         ld   de, items_grid
1173+ 7326 19               add  hl, de
1174+ 7327
1175+ 7327                  ; La cella non contiene più un item
1176+ 7327 36 00            ld   (hl), 0
1177+ 7329
1178+ 7329 D1               pop  de
1179+ 732A E1               pop  hl
1180+ 732B
1181+ 732B                  ; ---------------------------------------------------------------
1182+ 732B                  ; Conserva il puntatore all'entry corrente
1183+ 732B                  ; poiché le routine successive possono alterare HL.
1184+ 732B                  ; ---------------------------------------------------------------
1185+ 732B E5               push hl
1186+ 732C
1187+ 732C                  ; ---------------------------------------------------------------
1188+ 732C                  ; Aggiorna il numero di oggetti raccolti
1189+ 732C                  ; ---------------------------------------------------------------
1190+ 732C 3A 93 73         ld   a, (items_collected)
1191+ 732F
1192+ 732F 3C               inc  a
1193+ 7330
1194+ 7330 32 93 73         ld   (items_collected), a
1195+ 7333
1196+ 7333                  ; ---------------------------------------------------------------
1197+ 7333                  ; Aggiorna il contatore visualizzato a schermo
1198+ 7333                  ; ---------------------------------------------------------------
1199+ 7333 CD CB 60         call UpdateItemsCollectedDisplay
1200+ 7336
1201+ 7336                  ; ---------------------------------------------------------------
1202+ 7336                  ; Ripristina il tile originale della stanza
1203+ 7336                  ; eliminando la grafica dell'item.
1204+ 7336                  ;
1205+ 7336                  ; Input:
1206+ 7336                  ;   B = Row
1207+ 7336                  ;   C = Col
1208+ 7336                  ; ---------------------------------------------------------------
1209+ 7336 CD 66 72         call RestoreBackgroundCell
1210+ 7339
1211+ 7339                  ; ---------------------------------------------------------------
1212+ 7339                  ; Riproduce il suono di raccolta
1213+ 7339                  ; ---------------------------------------------------------------
1214+ 7339 CD 4A 73         call PlayCollectSound
1215+ 733C
1216+ 733C                  ; Ripristina il puntatore alla tabella
1217+ 733C E1               pop  hl
1218+ 733D
1219+ 733D                  ; Continua con il record successivo
1220+ 733D 18 04            jr   .next_no_inc
1221+ 733F
1222+ 733F              .next_item:
1223+ 733F
1224+ 733F                  ; ---------------------------------------------------------------
1225+ 733F                  ; Salta i campi del record:
1226+ 733F                  ;   X
1227+ 733F                  ;   Y
1228+ 733F                  ;   Color
1229+ 733F                  ;   Collected
1230+ 733F                  ; ---------------------------------------------------------------
1231+ 733F 23               inc  hl
1232+ 7340 23               inc  hl
1233+ 7341 23               inc  hl
1234+ 7342 23               inc  hl
1235+ 7343
1236+ 7343              .next_no_inc:
1237+ 7343
1238+ 7343                  ; ---------------------------------------------------------------
1239+ 7343                  ; Avanza al record successivo.
1240+ 7343                  ;
1241+ 7343                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1242+ 7343                  ; ---------------------------------------------------------------
1243+ 7343 23               inc  hl
1244+ 7344
1245+ 7344 18 AE            jr   .loop
1246+ 7346
1247+ 7346              .done:
1248+ 7346
1249+ 7346                  ; Ripristina i registri
1250+ 7346 C1               pop  bc
1251+ 7347 D1               pop  de
1252+ 7348 E1               pop  hl
1253+ 7349
1254+ 7349 C9               ret
1255+ 734A
1256+ 734A              ; -------------------------------------------------------------------
1257+ 734A              ; PlayCollectSound
1258+ 734A              ;
1259+ 734A              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1260+ 734A              ; dello ZX Spectrum utilizzando il port $FE.
1261+ 734A              ;
1262+ 734A              ; Il suono viene prodotto alternando ON/OFF del bit 4
1263+ 734A              ; (speaker) con un semplice delay software.
1264+ 734A              ;
1265+ 734A              ; Effetto risultante:
1266+ 734A              ;   beep breve tipo "pickup item"
1267+ 734A              ; -------------------------------------------------------------------
1268+ 734A              PlayCollectSound:
1269+ 734A
1270+ 734A                  ; Salva registri utilizzati
1271+ 734A C5               push bc
1272+ 734B D5               push de
1273+ 734C
1274+ 734C                  ; ---------------------------------------------------------------
1275+ 734C                  ; Numero di cicli del beep (durata complessiva del suono)
1276+ 734C                  ; ---------------------------------------------------------------
1277+ 734C 06 78            ld   b, 120
1278+ 734E
1279+ 734E              .sound_loop:
1280+ 734E
1281+ 734E                  ; ---------------------------------------------------------------
1282+ 734E                  ; SPEAKER ON
1283+ 734E                  ;
1284+ 734E                  ; Legge il colore del bordo corrente e attiva il bit 4
1285+ 734E                  ; per pilotare lo speaker.
1286+ 734E                  ; ---------------------------------------------------------------
1287+ 734E 3A 95 73         ld   a, (room_border_color)
1288+ 7351 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1289+ 7353
1290+ 7353 D3 FE            out  ($fe), a         ; scrive sul port ULA
1291+ 7355
1292+ 7355                  ; ---------------------------------------------------------------
1293+ 7355                  ; Delay (mezzo periodo)
1294+ 7355                  ; Loop software a consumo CPU
1295+ 7355                  ; ---------------------------------------------------------------
1296+ 7355 0E 3C            ld   c, 60
1297+ 7357
1298+ 7357              .d1:
1299+ 7357 0D               dec  c
1300+ 7358 20 FD            jr   nz, .d1
1301+ 735A
1302+ 735A                  ; ---------------------------------------------------------------
1303+ 735A                  ; SPEAKER OFF
1304+ 735A                  ;
1305+ 735A                  ; Mantiene il colore del bordo ma disattiva lo speaker
1306+ 735A                  ; ---------------------------------------------------------------
1307+ 735A 3A 95 73         ld   a, (room_border_color)
1308+ 735D E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1309+ 735F
1310+ 735F D3 FE            out  ($fe), a
1311+ 7361
1312+ 7361                  ; ---------------------------------------------------------------
1313+ 7361                  ; Secondo delay (mezzo periodo)
1314+ 7361                  ; Completa l’onda quadra
1315+ 7361                  ; ---------------------------------------------------------------
1316+ 7361 0E 3C            ld   c, 60
1317+ 7363
1318+ 7363              .d2:
1319+ 7363 0D               dec  c
1320+ 7364 20 FD            jr   nz, .d2
1321+ 7366
1322+ 7366                  ; ---------------------------------------------------------------
1323+ 7366                  ; Ripete fino a completare il numero di cicli
1324+ 7366                  ; ---------------------------------------------------------------
1325+ 7366 10 E6            djnz .sound_loop
1326+ 7368
1327+ 7368                  ; Ripristina registri salvati
1328+ 7368 D1               pop  de
1329+ 7369 C1               pop  bc
1330+ 736A
1331+ 736A C9               ret
1332+ 736B
1333+ 736B              ; -------------------------------------------------------------------
1334+ 736B              ; CheckActiveItemAtCell
1335+ 736B              ;
1336+ 736B              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1337+ 736B              ; nella cella specificata della griglia items_grid.
1338+ 736B              ;
1339+ 736B              ; Questa routine usa una lookup diretta su una mappa 32x16,
1340+ 736B              ; evitando la scansione della ItemsTable.
1341+ 736B              ;
1342+ 736B              ; Input:
1343+ 736B              ;   B = Colonna (0..31)
1344+ 736B              ;   C = Riga (0..15)
1345+ 736B              ;
1346+ 736B              ; Output:
1347+ 736B              ;   Carry Set   = item presente nella cella
1348+ 736B              ;   Carry Clear = nessun item
1349+ 736B              ;
1350+ 736B              ; Nota:
1351+ 736B              ;   HL NON è restituito valido (commento originale non corretto:
1352+ 736B              ;   la routine non punta a ItemsTable).
1353+ 736B              ; -------------------------------------------------------------------
1354+ 736B              CheckActiveItemAtCell:
1355+ 736B
1356+ 736B                  ; Salva registri usati
1357+ 736B D5               push de
1358+ 736C E5               push hl
1359+ 736D
1360+ 736D                  ; ---------------------------------------------------------------
1361+ 736D                  ; Calcolo indice lineare nella griglia 32x16:
1362+ 736D                  ;
1363+ 736D                  ; offset = Row * 32 + Col
1364+ 736D                  ; ---------------------------------------------------------------
1365+ 736D 26 00            ld   h, 0
1366+ 736F 69               ld   l, c              ; HL = Row
1367+ 7370
1368+ 7370 29               add  hl, hl            ; *2
1369+ 7371 29               add  hl, hl            ; *4
1370+ 7372 29               add  hl, hl            ; *8
1371+ 7373 29               add  hl, hl            ; *16
1372+ 7374 29               add  hl, hl            ; *32
1373+ 7375
1374+ 7375                  ; Aggiunge la colonna
1375+ 7375 58               ld   e, b
1376+ 7376 16 00            ld   d, 0
1377+ 7378 19               add  hl, de            ; HL = Row*32 + Col
1378+ 7379
1379+ 7379                  ; ---------------------------------------------------------------
1380+ 7379                  ; Accesso alla griglia degli item attivi
1381+ 7379                  ; ---------------------------------------------------------------
1382+ 7379 11 00 A5         ld   de, items_grid
1383+ 737C 19               add  hl, de            ; HL = address cella
1384+ 737D
1385+ 737D                  ; ---------------------------------------------------------------
1386+ 737D                  ; Controllo presenza item
1387+ 737D                  ;
1388+ 737D                  ; items_grid contiene:
1389+ 737D                  ;   0 = nessun item
1390+ 737D                  ;   >0 = item attivo (colore o flag)
1391+ 737D                  ; ---------------------------------------------------------------
1392+ 737D 7E               ld   a, (hl)
1393+ 737E B7               or   a
1394+ 737F 28 04            jr   z, .not_active
1395+ 7381
1396+ 7381                  ; ---------------------------------------------------------------
1397+ 7381                  ; Item trovato
1398+ 7381                  ; ---------------------------------------------------------------
1399+ 7381 E1               pop  hl
1400+ 7382 D1               pop  de
1401+ 7383
1402+ 7383 37               scf                    ; Carry = 1
1403+ 7384 C9               ret
1404+ 7385
1405+ 7385              .not_active:
1406+ 7385
1407+ 7385                  ; ---------------------------------------------------------------
1408+ 7385                  ; Nessun item nella cella
1409+ 7385                  ; ---------------------------------------------------------------
1410+ 7385 E1               pop  hl
1411+ 7386 D1               pop  de
1412+ 7387
1413+ 7387 B7               or   a                 ; Carry = 0
1414+ 7388 C9               ret
1415+ 7389
