 131+ 7499
 132+ 7499                  ; Suona la nota: 2 cicli
 133+ 7499 57               ld   d, a                     ; D = delay
 134+ 749A 06 02            ld   b, 2                     ; 2 cicli per frame
 135+ 749C              .note_loop:
