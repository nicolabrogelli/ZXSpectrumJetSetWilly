 474+ 75BF              .set_room:
 475+ 75BF
 476+ 75BF                  ; Salva l'ID della stanza corrente
 477+ 75BF 32 BE 7B         ld   (current_room), a
 478+ 75C2
 479+ 75C2                  ; Ripristina i registri
