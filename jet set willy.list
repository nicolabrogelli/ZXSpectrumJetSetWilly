   1+ 7923              ;===========================================================================
   2+ 7923              ; audio.asm
   3+ 7923              ;
   4+ 7923              ; Gestione degli effetti sonori e della musica di sottofondo per il beeper.
   5+ 7923              ;===========================================================================
   6+ 7923
   7+ 7923              ; -------------------------------------------------------------------
   8+ 7923              ; Audio_UpdateJumpSound
   9+ 7923              ;
  10+ 7923              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7923              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7923              ; -------------------------------------------------------------------
  13+ 7923              Audio_UpdateJumpSound:
  14+ 7923 F5               push af
  15+ 7924 C5               push bc
  16+ 7925 D5               push de
  17+ 7926 E5               push hl
  18+ 7927
  19+ 7927                  ; Controlla se il suono è attivo (note < 18)
  20+ 7927 3A BD 7D         ld   a, (Audio_jump_sound_note)
  21+ 792A FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 792C 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 792E
  24+ 792E                  ; Carica la nota corrente da suonare
  25+ 792E 5F               ld   e, a
  26+ 792F 16 00            ld   d, 0
  27+ 7931 21 5D 79         ld   hl, Audio_JumpSoundDelays
  28+ 7934 19               add  hl, de
  29+ 7935 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7936 57               ld   d, a                      ; D = delay della nota
  31+ 7937
  32+ 7937                  ; Suona la nota: 15 cicli
  33+ 7937 06 0F            ld   b, 15
  34+ 7939              .note_loop:
  35+ 7939                  ; Speaker ON
  36+ 7939 3A 48 7A         ld   a, (room_border_color)
  37+ 793C F6 10            or   $10
  38+ 793E D3 FE            out  ($fe), a
  39+ 7940 4A               ld   c, d
  40+ 7941              .d1:
  41+ 7941 0D               dec  c
  42+ 7942 20 FD            jr   nz, .d1
  43+ 7944
  44+ 7944                  ; Speaker OFF
  45+ 7944 3A 48 7A         ld   a, (room_border_color)
  46+ 7947 E6 EF            and  $ef
  47+ 7949 D3 FE            out  ($fe), a
  48+ 794B 4A               ld   c, d
  49+ 794C              .d2:
  50+ 794C 0D               dec  c
  51+ 794D 20 FD            jr   nz, .d2
  52+ 794F
  53+ 794F 10 E8            djnz .note_loop
  54+ 7951
  55+ 7951                  ; Passa alla nota successiva
  56+ 7951 3A BD 7D         ld   a, (Audio_jump_sound_note)
  57+ 7954 3C               inc  a
  58+ 7955 32 BD 7D         ld   (Audio_jump_sound_note), a
  59+ 7958
  60+ 7958              .done:
  61+ 7958 E1               pop  hl
  62+ 7959 D1               pop  de
  63+ 795A C1               pop  bc
  64+ 795B F1               pop  af
  65+ 795C C9               ret
  66+ 795D
  67+ 795D              Audio_JumpSoundDelays:
  68+ 795D 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7961 19 13 0C 06
  68+ 7965 0C 13 19 20
  68+ 7969 26 2D 33 3A
  68+ 796D 40 47
  69+ 796F
