 887+ 7FCC                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 888+ 7FCC 3A 6A FB         ld   a, (enemy_update_rate)
 889+ 7FCF FE 01            cp   1
 890+ 7FD1 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 891+ 7FD3
 892+ 7FD3 3A 6B FB         ld   a, (enemy_update_timer)
 893+ 7FD6 3C               inc  a
 894+ 7FD7 47               ld   b, a                      ; B = timer + 1
 895+ 7FD8 3A 6A FB         ld   a, (enemy_update_rate)
 896+ 7FDB B8               cp   b
 897+ 7FDC 28 0C            jr   z, .reset_timer
 898+ 7FDE 38 0A            jr   c, .reset_timer
 899+ 7FE0
 900+ 7FE0                  ; Salva contatore incrementato e salta l'aggiornamento
