1829+ 79E2 7E               ld   a, (hl)
1830+ 79E3 B7               or   a
1831+ 79E4 20 0C            jr   nz, .custom_settings
1832+ 79E6
1833+ 79E6 3E 06            ld   a, DEFAULT_JUMP_STRENGTH
1834+ 79E8 32 01 F5         ld   (room_jump_strength), a
1835+ 79EB 3E 01            ld   a, DEFAULT_GRAVITY_PRESET
1836+ 79ED 32 02 F5         ld   (room_gravity_preset), a
1837+ 79F0 18 12            jr   .done
