 118  8903                  ; 2. Aggiornamento audio
 119  8903                  IF ENABLE_EFFECTS != 0
 120  8903 ~                call Audio_UpdateJumpSound    ; Aggiorna l'effetto sonoro del salto
 121  8903                  ENDIF
 122  8903
