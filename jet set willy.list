 202+ 5E8D                  ; --- Controlla Conveyor ---
 203+ 5E8D 3A F7 7A         ld   a, (conveyor_len)
 204+ 5E90 B7               or   a
 205+ 5E91 CA B9 5E         jp   z, .check_ramp
 206+ 5E94
 207+ 5E94 3A F8 7A         ld   a, (conveyor_row)
 208+ 5E97 BB               cp   e
 209+ 5E98 C2 B9 5E         jp   nz, .check_ramp
 210+ 5E9B
 211+ 5E9B 3A F9 7A         ld   a, (conveyor_col)
 212+ 5E9E B9               cp   c
 213+ 5E9F CA B3 5E         jp   z, .is_conveyor
 214+ 5EA2 DA A8 5E         jp   c, .c_greater
 215+ 5EA5 C3 B9 5E         jp   .check_ramp
 216+ 5EA8              .c_greater:
 217+ 5EA8 21 F7 7A         ld   hl, conveyor_len
 218+ 5EAB 86               add  a, (hl)
