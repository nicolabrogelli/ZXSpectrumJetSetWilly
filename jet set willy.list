1273+ 6505 21 8D 5C         ld   hl, ATTR_P
1274+ 6508 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
1275+ 6509 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
1276+ 650C 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
1277+ 650E 3E 07            ld   a, $07
1278+ 6510 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
1279+ 6513
