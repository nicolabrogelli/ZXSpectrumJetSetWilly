 206  8945 21 8D 5C         ld   hl, ATTR_P
 207  8948 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 208  8949 CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 209  894C 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 210  894E 3E 07            ld   a, $07
 211  8950 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
