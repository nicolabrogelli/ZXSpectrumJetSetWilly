  83+ 6BB0              ; MOVIMENTO SINISTRA
  84+ 6BB0              ; ===============================================================
  85+ 6BB0              movePlayer_left:
  86+ 6BB0                  ; Impedisci lo spostamento a sinistra se Willy è sul conveyor ed il conveyor va a destra.
  87+ 6BB0 CD 9C 74         call CheckWillyOnConveyor
  88+ 6BB3 30 05            jr   nc, .continue_left
  89+ 6BB5 3A 7E EE         ld   a, (conveyor_dir)
  90+ 6BB8 B7               or   a
  91+ 6BB9 C0               ret  nz                     ; Se è sul conveyor e va a destra, ritorna senza muovere
  92+ 6BBA
  93+ 6BBA              .continue_left:
  94+ 6BBA                  ; Calcola nuova posizione: X - speed
  95+ 6BBA 3A 66 EB         ld   a, (on_ground)
  96+ 6BBD B7               or   a
  97+ 6BBE 28 05            jr   z, .air_left
  98+ 6BC0 3A DB EE         ld   a, (player_speed)
  99+ 6BC3 18 0A            jr   .speed_left_ok
 100+ 6BC5              .air_left:
 101+ 6BC5 3E 02            ld   a, 2
 102+ 6BC7 21 6C EB         ld   hl, jump_frame
 103+ 6BCA CB 46            bit  0, (hl)
 104+ 6BCC 28 01            jr   z, .speed_left_ok
 105+ 6BCE 3C               inc  a                      ; Alterna 2 e 3 px per frame (Media = 2.5 px/frame)
 106+ 6BCF              .speed_left_ok:
 107+ 6BCF 5F               ld   e, a
 108+ 6BD0
 109+ 6BD0 79               ld   a, c
 110+ 6BD1 93               sub  e
 111+ 6BD2
 112+ 6BD2                  ; Controllo limite sinistro schermo
 113+ 6BD2 FE 05            cp   PLAYER_MIN_X
 114+ 6BD4 38 0D            jr   c, .clamp_left
