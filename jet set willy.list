 187+ 80A1
 188+ 80A1              ; -------------------------------------------------------------------
 189+ 80A1              ; DetermineCurrentRoomID
 190+ 80A1              ;
 191+ 80A1              ; Determina l'ID numerico della stanza corrente confrontando
 192+ 80A1              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 193+ 80A1              ;
 194+ 80A1              ; Se viene trovata una corrispondenza:
 195+ 80A1              ;   A = ID della stanza
 196+ 80A1              ;   current_room = A
 197+ 80A1              ;
 198+ 80A1              ; Mappatura:
 199+ 80A1              ;    0 = The Off Licence
 200+ 80A1              ;    1 = The Bridge
 201+ 80A1              ;    2 = Under The Mega Tree
 202+ 80A1              ;    3 = Gfx_At The Foot Of The Mega Tree
 203+ 80A1              ;    4 = The Drive
 204+ 80A1              ;    5 = The Security Guard
 205+ 80A1              ;    6 = Entrance To Hades
 206+ 80A1              ;    7 = Cuckoo's Nest
 207+ 80A1              ;    8 = Inside The Mega Trunk
 208+ 80A1              ;    9 = On A Branch Over The Drive
 209+ 80A1              ;   10 = The Front Door
 210+ 80A1              ;   11 = The Hall
 211+ 80A1              ;   12 = Tree Top
 212+ 80A1              ;   27 = The Chapel
 213+ 80A1              ;   28 = First Landing
 214+ 80A1              ;   29 = The Nightmare Room
 215+ 80A1              ;   33 = The Bathroom
 216+ 80A1              ;   35 = Master Bedroom
 217+ 80A1              ;
 218+ 80A1              ; Se nessuna stanza corrisponde viene impostato:
 219+ 80A1              ;   current_room = 0
 220+ 80A1              ; -------------------------------------------------------------------
 221+ 80A1              DetermineCurrentRoomID:
 222+ 80A1
