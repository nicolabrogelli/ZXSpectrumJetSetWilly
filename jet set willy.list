   7+ 660B              ; Input_CheckCtrl
   8+ 660B              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 660B              ;
  10+ 660B              ; Output:
  11+ 660B              ;   D = bitmask tasti attivi:
  12+ 660B              ;       bit 0 → sinistra (O)
  13+ 660B              ;       bit 1 → destra   (P)
  14+ 660B              ;       bit 2 → salto    (Z)
  15+ 660B              ;
  16+ 660B              ; Effetti collaterali in RAM:
  17+ 660B              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 660B              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 660B              ;   (jump_prev)     → debounce tasto salto
  20+ 660B              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 660B              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 660B              ; -------------------------------------------------------------------
  23+ 660B
  24+ 660B              Input_CheckCtrl:
  25+ 660B AF               xor  a
  26+ 660C 32 3B E6         ld   (current_input_dir), a
  27+ 660F
  28+ 660F                  IF ENABLE_ROOM_SKIP_KEYS != 0
  29+ 660F                  ; ── Sezione 1a: tasto Q (cambio stanza AVANTI) ─────────────────────
  30+ 660F                  ;
  31+ 660F                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  32+ 660F                  ; Se bit 0 = 0, Q è premuto.
  33+ 660F
  34+ 660F 01 FE FB         ld   bc, $fbfe
  35+ 6612 ED 78            in   a, (c)
  36+ 6614 CB 47            bit  0, a
  37+ 6616 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 6618
  39+ 6618                  ; Q è premuto: debounce tramite (q_prev).
  40+ 6618                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 6618 3A 3C E6         ld   a, (q_prev)
  42+ 661B B7               or   a
  43+ 661C 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 661E
  45+ 661E                  ; ── Primo frame di pressione di Q ──
  46+ 661E 3E 01            ld   a, 1
  47+ 6620 32 3C E6         ld   (q_prev), a            ; marca "Q era premuto"
  48+ 6623
  49+ 6623                  ; NOTA sullo stack:
  50+ 6623                  ; Input_CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  51+ 6623                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChangeNext senza
  52+ 6623                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  53+ 6623                  ; poi JP salta direttamente.
  54+ 6623 E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  55+ 6624 C3 D4 66         jp   PerformRoomChangeNext  ; salta al cambio stanza avanti (non torna qui)
  56+ 6627
  57+ 6627              .q_not_pressed:
  58+ 6627 AF               xor  a
  59+ 6628 32 3C E6         ld   (q_prev), a            ; Q rilasciato → azzera debounce
  60+ 662B
  61+ 662B              .q_handled:
  62+ 662B
  63+ 662B                  ; ── Sezione 1b: tasto A (cambio stanza INDIETRO) ────────────────────
  64+ 662B                  ;
  65+ 662B                  ; Porta $FD → riga A, S, D, F, G. Bit 0 = A.
  66+ 662B                  ; Se bit 0 = 0, A è premuto.
  67+ 662B
  68+ 662B 01 FE FD         ld   bc, $fdfe
  69+ 662E ED 78            in   a, (c)
  70+ 6630 CB 47            bit  0, a
  71+ 6632 20 0F            jr   nz, .a_not_pressed     ; bit 0 = 1 → A non premuto, salta
  72+ 6634
  73+ 6634                  ; A è premuto: debounce tramite (a_prev).
  74+ 6634 3A 3D E6         ld   a, (a_prev)
  75+ 6637 B7               or   a
  76+ 6638 20 0D            jr   nz, .a_handled         ; era già premuto, niente da fare
  77+ 663A
  78+ 663A                  ; ── Primo frame di pressione di A ──
  79+ 663A 3E 01            ld   a, 1
  80+ 663C 32 3D E6         ld   (a_prev), a            ; marca "A era premuto"
  81+ 663F
  82+ 663F E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  83+ 6640 C3 D8 66         jp   PerformRoomChangePrev  ; salta al cambio stanza indietro (non torna qui)
  84+ 6643
  85+ 6643              .a_not_pressed:
  86+ 6643 AF               xor  a
  87+ 6644 32 3D E6         ld   (a_prev), a            ; A rilasciato → azzera debounce
  88+ 6647
  89+ 6647              .a_handled:
  90+ 6647 CD 39 67         call Input_CheckWarpKeys
