 630+ 6DE9 28 04            jr   z, .not_active
 631+ 6DEB
 632+ 6DEB E1               pop  hl
 633+ 6DEC D1               pop  de
 634+ 6DED 37               scf                    ; Set carry
 635+ 6DEE C9               ret
 636+ 6DEF
 637+ 6DEF              .not_active:
 638+ 6DEF E1               pop  hl
 639+ 6DF0 D1               pop  de
 640+ 6DF1 B7               or   a                 ; Clear carry
 641+ 6DF2 C9               ret
