1157+ 6B36                  ; platform_Y = (ramp_row - ramp_len + 1) * 8 - 16
1158+ 6B36 57               ld   d, a              ; D = calculated Y
1159+ 6B37
1160+ 6B37 3A 7E 75         ld   a, (ramp_row)
1161+ 6B3A 21 7D 75         ld   hl, ramp_len
1162+ 6B3D 96               sub  (hl)
1163+ 6B3E 3C               inc  a                 ; A = Row
1164+ 6B3F 87               add  a, a              ; *2
1165+ 6B40 87               add  a, a              ; *4
1166+ 6B41 87               add  a, a              ; *8
