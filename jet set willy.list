  14  5DAD                  include "macro.asm"
# file opened: macro.asm
   1+ 5DAD              ; Macro per inserire un oggetto calcolando l'ID della stanza a tempo di compilazione dall'offset in RoomsListTable
   2+ 5DAD                  MACRO ITEM room_sublabel, x, y, color, state
   3+ 5DAD ~                    db (room_sublabel - RoomsListTable) / 2, x, y, color, state
   4+ 5DAD                  ENDM
   5+ 5DAD
   6+ 5DAD
   7+ 5DAD                  MACRO ROOM room_sublabel
   8+ 5DAD ~                    db (room_sublabel - RoomsListTable) / 2
   9+ 5DAD                  ENDM
# file closed: macro.asm
  15  5DAD                  include "interrupts.asm"
# file opened: interrupts.asm
   1+ 5DAD              ;===========================================================================
   2+ 5DAD              ; interrupts.asm
   3+ 5DAD              ;===========================================================================
   4+ 5DAD
   5+ 5DAD              ; -------------------------------------------------------------------
   6+ 5DAD              ; Setup interrupt IM2
   7+ 5DAD              ; -------------------------------------------------------------------
   8+ 5DAD              SetupIM2:
   9+ 5DAD F3               di
  10+ 5DAE 11 00 FE         ld de,IM2_TABLE
  11+ 5DB1 21 FD FD         ld hl,IM2_VECTOR
  12+ 5DB4 7A               ld a,d
  13+ 5DB5 ED 47            ld i,a
  14+ 5DB7 7D               ld a,l
  15+ 5DB8              .fill_loop:
  16+ 5DB8 12               ld (de),a
  17+ 5DB9 1C               inc e
  18+ 5DBA C2 B8 5D         jp nz,.fill_loop
  19+ 5DBD 14               inc d
  20+ 5DBE 12               ld (de),a
  21+ 5DBF 36 C3            ld (hl),$C3
  22+ 5DC1 2C               inc l
  23+ 5DC2 36 CB            ld (hl),low im2_handler
  24+ 5DC4 2C               inc l
  25+ 5DC5 36 5D            ld (hl),high im2_handler
  26+ 5DC7 ED 5E            im 2
  27+ 5DC9 FB               ei
  28+ 5DCA C9               ret
  29+ 5DCB
  30+ 5DCB              ; -------------------------------------------------------------------
  31+ 5DCB              ; Handler interrupt IM2
  32+ 5DCB              ; -------------------------------------------------------------------
  33+ 5DCB              im2_handler:
  34+ 5DCB F5               push af
  35+ 5DCC E5               push hl
  36+ 5DCD
  37+ 5DCD                  ; Reset interrupt ULA
  38+ 5DCD DB FE            in a, (0xFE)
  39+ 5DCF
  40+ 5DCF                  ; Incrementa il contatore (usato per animazioni/raster bars)
  41+ 5DCF 2A 5B F7         ld hl, (counter)
  42+ 5DD2 23               inc hl
  43+ 5DD3 22 5B F7         ld (counter), hl
  44+ 5DD6
  45+ 5DD6                  ; Ripristina registri
  46+ 5DD6 E1               pop hl
  47+ 5DD7 F1               pop af
  48+ 5DD8 FB               ei
  49+ 5DD9 ED 4D            reti
# file closed: interrupts.asm
  16  5DDB                  include "graphics.asm"
# file opened: graphics.asm
   1+ 5DDB              ;===========================================================================
   2+ 5DDB              ; graphics.asm
   3+ 5DDB              ;===========================================================================
   4+ 5DDB
   5+ 5DDB              ; -------------------------------------------------------------------
   6+ 5DDB              ; Copia il set dei caratteri dalla ROM alla RAM
   7+ 5DDB              ; -------------------------------------------------------------------
   8+ 5DDB              Gfx_CopyChars:
   9+ 5DDB 21 00 3D         ld   hl, $3D00             ; Indirizzo del set di caratteri originale in ROM (ASCII 32)
  10+ 5DDE 11 3A F2         ld   de, font_buffer + 256 ; Indirizzo in RAM per ASCII 32..127 (font_buffer + 32*8)
  11+ 5DE1 01 00 03         ld   bc, 768               ; Numero di byte da copiare (96 caratteri * 8 byte ciascuno)
  12+ 5DE4 ED B0            ldir                       ; Copiare i dati
  13+ 5DE6 C9               ret
  14+ 5DE7
  15+ 5DE7              ; -------------------------------------------------------------------
  16+ 5DE7              ; Ridefinisci i caratteri (incluso quello per i bordi)
  17+ 5DE7              ; -------------------------------------------------------------------
  18+ 5DE7              Gfx_DefineChars:
  19+ 5DE7 21 3A D2         ld   hl, Willy             ; Indirizzo dei dati del nuovo carattere
  20+ 5DEA 11 42 F1         ld   de, font_buffer + 8   ; Indirizzo di ASCII 1 nel nuovo set di caratteri (font_buffer + 1*8)
  21+ 5DED 01 48 00         ld   bc, 72                ; Numero di byte da copiare (9 caratteri * 8 byte)
  22+ 5DF0 ED B0            ldir                       ; Effettua la copia dei caratteri
  23+ 5DF2 21 3A F1         ld   hl, font_buffer       ; Indirizzo del nuovo set di caratteri in RAM (font base ASCII 0)
