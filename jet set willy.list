 110+ 6C77
 111+ 6C77                  ; Controlla se siamo a mezz'aria (on_ground == 0)
 112+ 6C77 3A 0F 71         ld  a, (on_ground)
 113+ 6C7A B7               or  a
 114+ 6C7B CA B4 6C         jp  z, .in_air        ; Se siamo in volo, continua a volare
 115+ 6C7E
 116+ 6C7E                  ; Se on_ground == 1, controlliamo se siamo ancora su terreno solido
 117+ 6C7E                  ; Dobbiamo controllare i pixel direttamente sotto i piedi del player:
 118+ 6C7E                  ; (PlayerX, PlayerY + 16) e (PlayerX + 7, PlayerY + 16)
 119+ 6C7E 78               ld  a, b
 120+ 6C7F C6 10            add  a, 16
 121+ 6C81 47               ld  b, a              ; B = PlayerY + 16
 122+ 6C82
 123+ 6C82                  ; Controlla se la cella sotto il piede sinistro (PlayerX, PlayerY + 16) è solida
 124+ 6C82 CD 12 6C         call CheckSolidCell
 125+ 6C85 38 13            jr   c, .still_on_ground
 126+ 6C87
 127+ 6C87                  ; Controlla se la cella sotto il piede destro (PlayerX + 7, PlayerY + 16) è solida
 128+ 6C87 79               ld   a, c
 129+ 6C88 C6 07            add  a, 7
 130+ 6C8A 4F               ld   c, a              ; C = PlayerX + 7
 131+ 6C8B CD 12 6C         call CheckSolidCell
 132+ 6C8E 38 0A            jr   c, .still_on_ground
 133+ 6C90
 134+ 6C90                  ; Se nessuna delle due è solida, iniziamo a cadere!
 135+ 6C90 AF               xor  a
 136+ 6C91 32 0F 71         ld   (on_ground), a
 137+ 6C94 32 0E 71         ld   (velocity_y), a   ; Inizia la caduta con velocità 0
