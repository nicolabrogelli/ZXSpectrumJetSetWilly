1435+ 79EA              ; -------------------------------------------------------------------
1436+ 79EA              ; Items_CheckCollision
1437+ 79EA              ;
1438+ 79EA              ; Controlla se Willy entra in collisione con uno degli item
1439+ 79EA              ; attivi presenti nella stanza corrente.
1440+ 79EA              ;
1441+ 79EA              ; Per ogni item:
1442+ 79EA              ;   - verifica che appartenga alla stanza corrente
1443+ 79EA              ;   - verifica che non sia già stato raccolto
1444+ 79EA              ;   - esegue il test di collisione con Willy
1445+ 79EA              ;
1446+ 79EA              ; Se l'item viene raccolto:
1447+ 79EA              ;   - imposta il flag "collected"
1448+ 79EA              ;   - rimuove l'item dalla cache items_grid
1449+ 79EA              ;   - incrementa il contatore degli oggetti raccolti
1450+ 79EA              ;   - aggiorna l'HUD
1451+ 79EA              ;   - ripristina il tile di sfondo
1452+ 79EA              ;   - riproduce il suono di raccolta
1453+ 79EA              ;
1454+ 79EA              ; Formato record ItemsTable:
1455+ 79EA              ;   +0 RoomID
1456+ 79EA              ;   +1 X
1457+ 79EA              ;   +2 Y
1458+ 79EA              ;   +3 Color
1459+ 79EA              ;   +4 Collected
1460+ 79EA              ;
1461+ 79EA              ; Fine tabella:
1462+ 79EA              ;   RoomID = $FF
1463+ 79EA              ; -------------------------------------------------------------------
1464+ 79EA              Items_CheckCollision:
1465+ 79EA
1466+ 79EA                  ; Salva i registri utilizzati
1467+ 79EA E5               push hl
1468+ 79EB D5               push de
1469+ 79EC C5               push bc
1470+ 79ED
1471+ 79ED                  ; Inizio scansione della tabella degli item
1472+ 79ED 21 1B 75         ld   hl, ItemsTable
1473+ 79F0
1474+ 79F0              .loop:
1475+ 79F0
1476+ 79F0                  ; ---------------------------------------------------------------
1477+ 79F0                  ; Legge il Room ID dell'item corrente
1478+ 79F0                  ; ---------------------------------------------------------------
1479+ 79F0 7E               ld   a, (hl)
1480+ 79F1
1481+ 79F1                  ; $FF indica fine tabella
1482+ 79F1 FE FF            cp   $FF
1483+ 79F3 28 4D            jr   z, .done
1484+ 79F5
1485+ 79F5                  ; ---------------------------------------------------------------
1486+ 79F5                  ; Verifica se l'item appartiene alla stanza corrente
1487+ 79F5                  ; ---------------------------------------------------------------
1488+ 79F5 57               ld   d, a              ; D = RoomID item
1489+ 79F6
1490+ 79F6 3A F1 7D         ld   a, (current_room)
1491+ 79F9 BA               cp   d
1492+ 79FA
1493+ 79FA                  ; Se appartiene a un'altra stanza salta il record
1494+ 79FA 20 3F            jr   nz, .next_item
1495+ 79FC
1496+ 79FC                  ; ---------------------------------------------------------------
1497+ 79FC                  ; Legge coordinate e stato dell'item
1498+ 79FC                  ; ---------------------------------------------------------------
1499+ 79FC
1500+ 79FC 23               inc  hl
1501+ 79FD 4E               ld   c, (hl)           ; C = X
1502+ 79FE
1503+ 79FE 23               inc  hl
1504+ 79FF 46               ld   b, (hl)           ; B = Y
1505+ 7A00
1506+ 7A00 23               inc  hl                ; salta Color
1507+ 7A01
1508+ 7A01 23               inc  hl                ; punta a Collected
1509+ 7A02
1510+ 7A02 7E               ld   a, (hl)
1511+ 7A03
1512+ 7A03                  ; ---------------------------------------------------------------
1513+ 7A03                  ; Item già raccolto?
1514+ 7A03                  ; ---------------------------------------------------------------
1515+ 7A03 B7               or   a
1516+ 7A04 20 39            jr   nz, .next_no_inc
1517+ 7A06
1518+ 7A06                  ; ---------------------------------------------------------------
1519+ 7A06                  ; Test collisione Willy ↔ Item
1520+ 7A06                  ;
1521+ 7A06                  ; Input richiesto:
1522+ 7A06                  ;   A = ItemX
1523+ 7A06                  ;   H = ItemY
1524+ 7A06                  ; ---------------------------------------------------------------
1525+ 7A06 79               ld   a, c
1526+ 7A07
1527+ 7A07 E5               push hl                ; salva puntatore al flag Collected
1528+ 7A08
1529+ 7A08 60               ld   h, b
1530+ 7A09
1531+ 7A09 CD A4 79         call CheckWillyItemCollision
1532+ 7A0C
1533+ 7A0C E1               pop  hl
1534+ 7A0D
1535+ 7A0D                  ; Nessuna collisione
1536+ 7A0D 30 30            jr   nc, .next_no_inc
1537+ 7A0F
1538+ 7A0F                  ; ===============================================================
1539+ 7A0F                  ; ITEM RACCOLTO
1540+ 7A0F                  ; ===============================================================
1541+ 7A0F
1542+ 7A0F                  ; ---------------------------------------------------------------
1543+ 7A0F                  ; Marca l'item come raccolto
1544+ 7A0F                  ; ---------------------------------------------------------------
1545+ 7A0F 36 01            ld   (hl), 1
1546+ 7A11
1547+ 7A11                  ; ---------------------------------------------------------------
1548+ 7A11                  ; Rimuove l'item dalla cache items_grid
1549+ 7A11                  ;
1550+ 7A11                  ; Calcolo:
1551+ 7A11                  ;   offset = Row * 32 + Col
1552+ 7A11                  ; ---------------------------------------------------------------
1553+ 7A11 E5               push hl
1554+ 7A12 D5               push de
1555+ 7A13
1556+ 7A13 26 00            ld   h, 0
1557+ 7A15 68               ld   l, b              ; HL = Row
1558+ 7A16
1559+ 7A16 29               add  hl, hl            ; *2
1560+ 7A17 29               add  hl, hl            ; *4
1561+ 7A18 29               add  hl, hl            ; *8
1562+ 7A19 29               add  hl, hl            ; *16
1563+ 7A1A 29               add  hl, hl            ; *32
1564+ 7A1B
1565+ 7A1B 59               ld   e, c
1566+ 7A1C 16 00            ld   d, 0
1567+ 7A1E
1568+ 7A1E 19               add  hl, de            ; Row*32 + Col
1569+ 7A1F
1570+ 7A1F 11 6C CD         ld   de, items_grid
1571+ 7A22 19               add  hl, de
1572+ 7A23
1573+ 7A23                  ; La cella non contiene più un item
1574+ 7A23 36 00            ld   (hl), 0
1575+ 7A25
1576+ 7A25 D1               pop  de
1577+ 7A26 E1               pop  hl
1578+ 7A27
1579+ 7A27                  ; ---------------------------------------------------------------
1580+ 7A27                  ; Conserva il puntatore all'entry corrente
1581+ 7A27                  ; poiché le routine successive possono alterare HL.
1582+ 7A27                  ; ---------------------------------------------------------------
1583+ 7A27 E5               push hl
1584+ 7A28
1585+ 7A28                  ; ---------------------------------------------------------------
1586+ 7A28                  ; Aggiorna il numero di oggetti raccolti
1587+ 7A28                  ; ---------------------------------------------------------------
1588+ 7A28 3A DC 7A         ld   a, (items_collected)
1589+ 7A2B
1590+ 7A2B 3C               inc  a
1591+ 7A2C
1592+ 7A2C 32 DC 7A         ld   (items_collected), a
1593+ 7A2F
1594+ 7A2F                  ; ---------------------------------------------------------------
1595+ 7A2F                  ; Aggiorna il contatore visualizzato a schermo
1596+ 7A2F                  ; ---------------------------------------------------------------
1597+ 7A2F CD 67 61         call Gfx_UpdateItemsCollectedDisplay
1598+ 7A32
1599+ 7A32                  ; ---------------------------------------------------------------
1600+ 7A32                  ; Ripristina il tile originale della stanza
1601+ 7A32                  ; eliminando la grafica dell'item.
1602+ 7A32                  ;
1603+ 7A32                  ; Input:
1604+ 7A32                  ;   B = Row
1605+ 7A32                  ;   C = Col
1606+ 7A32                  ; ---------------------------------------------------------------
1607+ 7A32 CD 62 79         call RestoreBackgroundCell
1608+ 7A35
1609+ 7A35                  ; ---------------------------------------------------------------
1610+ 7A35                  ; Riproduce il suono di raccolta
1611+ 7A35                  ; ---------------------------------------------------------------
1612+ 7A35 CD B1 7A         call Audio_PlayCollectSound
1613+ 7A38
1614+ 7A38                  ; Ripristina il puntatore alla tabella
1615+ 7A38 E1               pop  hl
1616+ 7A39
1617+ 7A39                  ; Continua con il record successivo
1618+ 7A39 18 04            jr   .next_no_inc
1619+ 7A3B
1620+ 7A3B              .next_item:
1621+ 7A3B
1622+ 7A3B                  ; ---------------------------------------------------------------
1623+ 7A3B                  ; Salta i campi del record:
1624+ 7A3B                  ;   X
1625+ 7A3B                  ;   Y
1626+ 7A3B                  ;   Color
1627+ 7A3B                  ;   Collected
1628+ 7A3B                  ; ---------------------------------------------------------------
1629+ 7A3B 23               inc  hl
1630+ 7A3C 23               inc  hl
1631+ 7A3D 23               inc  hl
1632+ 7A3E 23               inc  hl
1633+ 7A3F
1634+ 7A3F              .next_no_inc:
1635+ 7A3F
1636+ 7A3F                  ; ---------------------------------------------------------------
1637+ 7A3F                  ; Avanza al record successivo.
1638+ 7A3F                  ;
1639+ 7A3F                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1640+ 7A3F                  ; ---------------------------------------------------------------
1641+ 7A3F 23               inc  hl
1642+ 7A40
1643+ 7A40 18 AE            jr   .loop
1644+ 7A42
1645+ 7A42              .done:
1646+ 7A42
1647+ 7A42                  ; Ripristina i registri
1648+ 7A42 C1               pop  bc
1649+ 7A43 D1               pop  de
1650+ 7A44 E1               pop  hl
1651+ 7A45
1652+ 7A45 C9               ret
1653+ 7A46
1654+ 7A46
1655+ 7A46
1656+ 7A46              ; -------------------------------------------------------------------
1657+ 7A46              ; CheckActiveItemAtCell
1658+ 7A46              ;
1659+ 7A46              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1660+ 7A46              ; nella cella specificata della griglia items_grid.
1661+ 7A46              ;
1662+ 7A46              ; Questa routine usa una lookup diretta su una mappa 32x16,
1663+ 7A46              ; evitando la scansione della ItemsTable.
1664+ 7A46              ;
1665+ 7A46              ; Input:
1666+ 7A46              ;   B = Colonna (0..31)
1667+ 7A46              ;   C = Riga (0..15)
1668+ 7A46              ;
1669+ 7A46              ; Output:
1670+ 7A46              ;   Carry Set   = item presente nella cella
1671+ 7A46              ;   Carry Clear = nessun item
1672+ 7A46              ;
1673+ 7A46              ; Nota:
1674+ 7A46              ;   HL NON è restituito valido (commento originale non corretto:
1675+ 7A46              ;   la routine non punta a ItemsTable).
1676+ 7A46              ; -------------------------------------------------------------------
1677+ 7A46              CheckActiveItemAtCell:
1678+ 7A46
1679+ 7A46                  ; Salva registri usati
1680+ 7A46 D5               push de
1681+ 7A47 E5               push hl
1682+ 7A48
1683+ 7A48                  ; ---------------------------------------------------------------
1684+ 7A48                  ; Calcolo indice lineare nella griglia 32x16:
1685+ 7A48                  ;
1686+ 7A48                  ; offset = Row * 32 + Col
1687+ 7A48                  ; ---------------------------------------------------------------
1688+ 7A48 26 00            ld   h, 0
1689+ 7A4A 69               ld   l, c              ; HL = Row
1690+ 7A4B
1691+ 7A4B 29               add  hl, hl            ; *2
1692+ 7A4C 29               add  hl, hl            ; *4
1693+ 7A4D 29               add  hl, hl            ; *8
1694+ 7A4E 29               add  hl, hl            ; *16
1695+ 7A4F 29               add  hl, hl            ; *32
1696+ 7A50
1697+ 7A50                  ; Aggiunge la colonna
1698+ 7A50 58               ld   e, b
1699+ 7A51 16 00            ld   d, 0
1700+ 7A53 19               add  hl, de            ; HL = Row*32 + Col
1701+ 7A54
1702+ 7A54                  ; ---------------------------------------------------------------
1703+ 7A54                  ; Accesso alla griglia degli item attivi
1704+ 7A54                  ; ---------------------------------------------------------------
1705+ 7A54 11 6C CD         ld   de, items_grid
1706+ 7A57 19               add  hl, de            ; HL = address cella
1707+ 7A58
1708+ 7A58                  ; ---------------------------------------------------------------
1709+ 7A58                  ; Controllo presenza item
1710+ 7A58                  ;
1711+ 7A58                  ; items_grid contiene:
1712+ 7A58                  ;   0 = nessun item
1713+ 7A58                  ;   >0 = item attivo (colore o flag)
1714+ 7A58                  ; ---------------------------------------------------------------
1715+ 7A58 7E               ld   a, (hl)
1716+ 7A59 B7               or   a
1717+ 7A5A 28 04            jr   z, .not_active
1718+ 7A5C
1719+ 7A5C                  ; ---------------------------------------------------------------
1720+ 7A5C                  ; Item trovato
1721+ 7A5C                  ; ---------------------------------------------------------------
1722+ 7A5C E1               pop  hl
1723+ 7A5D D1               pop  de
1724+ 7A5E
1725+ 7A5E 37               scf                    ; Carry = 1
1726+ 7A5F C9               ret
1727+ 7A60
1728+ 7A60              .not_active:
1729+ 7A60
1730+ 7A60                  ; ---------------------------------------------------------------
1731+ 7A60                  ; Nessun item nella cella
1732+ 7A60                  ; ---------------------------------------------------------------
1733+ 7A60 E1               pop  hl
1734+ 7A61 D1               pop  de
1735+ 7A62
1736+ 7A62 B7               or   a                 ; Carry = 0
1737+ 7A63 C9               ret
1738+ 7A64
