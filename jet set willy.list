 214+ 6F63 57               ld   d, a                  ; Ripristina D = velocity_y (evita corruzione se proveniamo da .check_landing)
 215+ 6F64 ED 4B B3 76      ld   bc, (PlayerPos)
 216+ 6F68 78               ld   a, b
 217+ 6F69 92               sub  d                 ; A = Nuovo Y (calcolato in .store_vel)
