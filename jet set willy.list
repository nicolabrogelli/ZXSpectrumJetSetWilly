 122+ 748A 3A 7C 78         ld   a, (music_note_idx)
 123+ 748D 5F               ld   e, a
 124+ 748E 16 00            ld   d, 0
 125+ 7490 21 BD 74         ld   hl, MusicSheet
 126+ 7493 19               add  hl, de
