 159  7E9A                  ; Gestisci la morte di Willy:
 160  7E9A                  ; 1. Cancella la sprite del player dalla sua posizione attuale a schermo
 161  7E9A CD 46 60         call Gfx_DeleteCharAtOldPos
 162  7E9D
 163  7E9D                  ; 2. Ripristina la posizione iniziale nella stanza
 164  7E9D CD E7 65         call LoadPositionPlayeinRoom
 165  7EA0
 166  7EA0                  ; 3. Reimposta la fisica di Willy
 167  7EA0 AF               xor  a
 168  7EA1 32 4D 7A         ld   (velocity_y), a
 169  7EA4 32 4F 7A         ld   (jump_pressed), a
 170  7EA7 32 53 7A         ld   (jump_frame), a
 171  7EAA 32 52 7A         ld   (jump_dir), a
 172  7EAD 3E 01            ld   a, 1
 173  7EAF 32 4E 7A         ld   (on_ground), a
 174  7EB2 18 1A            jr   .no_collision ; Salta il disegno delle raster bar poiché Willy è morto
 175  7EB4
 176  7EB4              .draw_raster_bars:
 177  7EB4                  ; Collisione attiva: disegna le raster bar nel bordo
 178  7EB4 3A 58 7A         ld   a, (counter)
 179  7EB7 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 180  7EB9 06 1E            ld   b, 30             ; Numero di righe della barra raster
 181  7EBB              .raster_loop:
 182  7EBB D3 FE            out  ($fe), a
 183  7EBD 3C               inc  a
 184  7EBE E6 07            and  7
 185  7EC0 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 186  7EC2              .delay:
 187  7EC2 0D               dec  c
 188  7EC3 20 FD            jr   nz, .delay
 189  7EC5 10 F4            djnz .raster_loop
 190  7EC7
 191  7EC7                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 192  7EC7 3A 48 7A         ld   a, (room_border_color)
 193  7ECA D3 FE            out  ($fe), a
 194  7ECC 18 05            jr   .no_collision_change
