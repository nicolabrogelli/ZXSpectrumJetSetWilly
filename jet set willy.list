 255+ 741E              ; -------------------------------------------------------------------
 256+ 741E              ; Ripristina la cella dello sfondo originale per cancellare l'item
 257+ 741E              ; Input: B = Row (3..18), C = Col (0..31)
 258+ 741E              ; -------------------------------------------------------------------
 259+ 741E              RestoreBackgroundCell:
 260+ 741E FD E5            push iy                ; Preserva IY
 261+ 7420 C5               push bc
 262+ 7421 D5               push de
 263+ 7422 E5               push hl
 264+ 7423 DD E5            push ix
 265+ 7425
 266+ 7425 C5               push bc
 267+ 7426 FD E1            pop  iy                ; IY = original BC (IYH = Row, IYL = Col)
 268+ 7428
 269+ 7428                  ; Riga di layout: r = B - 3
 270+ 7428 78               ld   a, b
 271+ 7429 D6 03            sub  3                 ; A = r (0..15)
 272+ 742B
 273+ 742B                  ; Colonna: c = C (Col)
 274+ 742B CD 57 70         call GetCellFromUnpacked ; A = cell type (0..3)
 275+ 742E
 276+ 742E ED 5B C0 78      ld   de, (room_ptr)
 277+ 7432 B7               or   a
 278+ 7433 20 06            jr   nz, .not_bg
 279+ 7435 21 A0 00         ld   hl, OFFSET_BG
 280+ 7438 19               add  hl, de
 281+ 7439 18 16            jr   .draw_cell
 282+ 743B              .not_bg:
 283+ 743B 3D               dec  a
 284+ 743C 20 06            jr   nz, .not_floor
 285+ 743E 21 A9 00         ld   hl, OFFSET_FLOOR
 286+ 7441 19               add  hl, de
 287+ 7442 18 0D            jr   .draw_cell
 288+ 7444              .not_floor:
 289+ 7444 3D               dec  a
 290+ 7445 20 06            jr   nz, .not_wall
 291+ 7447 21 B2 00         ld   hl, OFFSET_WALL
 292+ 744A 19               add  hl, de
 293+ 744B 18 04            jr   .draw_cell
 294+ 744D              .not_wall:
 295+ 744D 21 BB 00         ld   hl, OFFSET_NASTY
 296+ 7450 19               add  hl, de
 297+ 7451
 298+ 7451              .draw_cell:
 299+ 7451 E5               push hl
 300+ 7452 DD E1            pop  ix                ; IX = tile pointer
 301+ 7454
 302+ 7454 FD E5            push iy
 303+ 7456 C1               pop  bc                ; B = Row, C = Col
 304+ 7457
 305+ 7457 CD 63 60         call DrawTile
 306+ 745A
 307+ 745A DD E1            pop  ix
 308+ 745C E1               pop  hl
 309+ 745D D1               pop  de
 310+ 745E C1               pop  bc
 311+ 745F FD E1            pop  iy                ; Ripristina IY
 312+ 7461 C9               ret
