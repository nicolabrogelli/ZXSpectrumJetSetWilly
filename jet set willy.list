 394  8A23 0C               inc  c
 395  8A24 79               ld   a, c
 396  8A25 CB 3F            srl  a
 397  8A27 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 398  8A29 E6 07            and  7
 399  8A2B 5F               ld   e, a
