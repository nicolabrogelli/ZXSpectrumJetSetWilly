  82+ 6645              ; ===============================================================
  83+ 6645              ; MOVIMENTO SINISTRA
  84+ 6645              ; ===============================================================
  85+ 6645              movePlayer_left:
  86+ 6645                  ; Impedisci lo spostamento a sinistra se Willy è sul conveyor ed il conveyor va a destra.
  87+ 6645 CD FB 6E         call CheckWillyOnConveyor
  88+ 6648 30 05            jr   nc, .continue_left
  89+ 664A 3A 4D E9         ld   a, (conveyor_dir)
  90+ 664D B7               or   a
  91+ 664E C0               ret  nz                     ; Se è sul conveyor e va a destra, ritorna senza muovere
  92+ 664F
  93+ 664F              .continue_left:
  94+ 664F                  ; Calcola nuova posizione: X - speed
  95+ 664F 3A 35 E6         ld   a, (on_ground)
  96+ 6652 B7               or   a
  97+ 6653 28 05            jr   z, .air_left
  98+ 6655 3A AA E9         ld   a, (player_speed)
  99+ 6658 18 0A            jr   .speed_left_ok
