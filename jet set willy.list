1367+ 758E              ; CheckActiveItemAtCell
1368+ 758E              ;
1369+ 758E              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1370+ 758E              ; nella cella specificata della griglia items_grid.
1371+ 758E              ;
1372+ 758E              ; Questa routine usa una lookup diretta su una mappa 32x16,
1373+ 758E              ; evitando la scansione della ItemsTable.
1374+ 758E              ;
1375+ 758E              ; Input:
1376+ 758E              ;   B = Colonna (0..31)
1377+ 758E              ;   C = Riga (0..15)
1378+ 758E              ;
1379+ 758E              ; Output:
1380+ 758E              ;   Carry Set   = item presente nella cella
1381+ 758E              ;   Carry Clear = nessun item
1382+ 758E              ;
1383+ 758E              ; Nota:
1384+ 758E              ;   HL NON è restituito valido (commento originale non corretto:
1385+ 758E              ;   la routine non punta a ItemsTable).
1386+ 758E              ; -------------------------------------------------------------------
1387+ 758E              CheckActiveItemAtCell:
1388+ 758E
1389+ 758E                  ; Salva registri usati
1390+ 758E D5               push de
1391+ 758F E5               push hl
1392+ 7590
1393+ 7590                  ; ---------------------------------------------------------------
1394+ 7590                  ; Calcolo indice lineare nella griglia 32x16:
1395+ 7590                  ;
1396+ 7590                  ; offset = Row * 32 + Col
1397+ 7590                  ; ---------------------------------------------------------------
1398+ 7590 26 00            ld   h, 0
1399+ 7592 69               ld   l, c              ; HL = Row
1400+ 7593
1401+ 7593 29               add  hl, hl            ; *2
1402+ 7594 29               add  hl, hl            ; *4
1403+ 7595 29               add  hl, hl            ; *8
1404+ 7596 29               add  hl, hl            ; *16
1405+ 7597 29               add  hl, hl            ; *32
1406+ 7598
1407+ 7598                  ; Aggiunge la colonna
1408+ 7598 58               ld   e, b
1409+ 7599 16 00            ld   d, 0
1410+ 759B 19               add  hl, de            ; HL = Row*32 + Col
1411+ 759C
1412+ 759C                  ; ---------------------------------------------------------------
1413+ 759C                  ; Accesso alla griglia degli item attivi
1414+ 759C                  ; ---------------------------------------------------------------
1415+ 759C 11 00 B0         ld   de, items_grid
1416+ 759F 19               add  hl, de            ; HL = address cella
1417+ 75A0
1418+ 75A0                  ; ---------------------------------------------------------------
1419+ 75A0                  ; Controllo presenza item
1420+ 75A0                  ;
1421+ 75A0                  ; items_grid contiene:
1422+ 75A0                  ;   0 = nessun item
1423+ 75A0                  ;   >0 = item attivo (colore o flag)
1424+ 75A0                  ; ---------------------------------------------------------------
1425+ 75A0 7E               ld   a, (hl)
1426+ 75A1 B7               or   a
1427+ 75A2 28 04            jr   z, .not_active
1428+ 75A4
1429+ 75A4                  ; ---------------------------------------------------------------
1430+ 75A4                  ; Item trovato
1431+ 75A4                  ; ---------------------------------------------------------------
1432+ 75A4 E1               pop  hl
1433+ 75A5 D1               pop  de
1434+ 75A6
1435+ 75A6 37               scf                    ; Carry = 1
1436+ 75A7 C9               ret
1437+ 75A8
1438+ 75A8              .not_active:
1439+ 75A8
1440+ 75A8                  ; ---------------------------------------------------------------
1441+ 75A8                  ; Nessun item nella cella
1442+ 75A8                  ; ---------------------------------------------------------------
1443+ 75A8 E1               pop  hl
1444+ 75A9 D1               pop  de
1445+ 75AA
1446+ 75AA B7               or   a                 ; Carry = 0
1447+ 75AB C9               ret
