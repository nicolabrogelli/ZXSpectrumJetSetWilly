415+  5F74 CD 3D 5E         call DrawPixelSprite8x8 ; Disegna testa
416+  5F77
417+  5F77                  ; 2. Determina sprite per il corpo (sinistra o destra con frame animazione)
418+  5F77 3A 91 6C         ld   a, (direction)
419+  5F7A FE 01            cp   1                 ; Sinistra?
420+  5F7C 20 13            jr   nz, .right_body
421+  5F7E
422+  5F7E                  ; Corpo a sinistra
423+  5F7E 3A 90 6C         ld   a, (body_state)   ; 0, 1, 2
424+  5F81 C6 05            add  a, 5              ; offset del tile per il corpo sinistro (5, 6, 7)
425+  5F83 87               add  a, a              ; *2
426+  5F84 87               add  a, a              ; *4
427+  5F85 87               add  a, a              ; *8
428+  5F86 5F               ld   e, a
429+  5F87 16 00            ld   d, 0
430+  5F89 DD 21 22 61      ld   ix, TilesDef
431+  5F8D DD 19            add  ix, de
432+  5F8F 18 11            jr   .draw_body
433+  5F91
434+  5F91              .right_body:
435+  5F91                  ; Corpo a destra
436+  5F91 3A 90 6C         ld   a, (body_state)   ; 0, 1, 2
437+  5F94 C6 01            add  a, 1              ; offset del tile per il corpo destro (1, 2, 3)
438+  5F96 87               add  a, a              ; *2
439+  5F97 87               add  a, a              ; *4
440+  5F98 87               add  a, a              ; *8
441+  5F99 5F               ld   e, a
442+  5F9A 16 00            ld   d, 0
443+  5F9C DD 21 22 61      ld   ix, TilesDef
444+  5FA0 DD 19            add  ix, de
