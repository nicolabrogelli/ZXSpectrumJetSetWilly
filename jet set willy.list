 705+ 60D2 18 16            jr   .draw_cell
 706+ 60D4              .not_bg:
 707+ 60D4 3D               dec  a
 708+ 60D5 20 06            jr   nz, .not_floor
 709+ 60D7 21 A9 00         ld   hl, OFFSET_FLOOR
