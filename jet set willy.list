1129+ 6E39              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1130+ 6E39              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1131+ 6E39              ; -------------------------------------------------------------------
1132+ 6E39              UnpackRoomLayout:
1133+ 6E39 E5               push hl
1134+ 6E3A D5               push de
1135+ 6E3B C5               push bc
1136+ 6E3C
1137+ 6E3C 2A A5 E9         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1138+ 6E3F 11 4B E7         ld   de, unpacked_layout ; DE = buffer RAM
1139+ 6E42 06 80            ld   b, 128             ; 128 byte
1140+ 6E44              .byte_loop:
1141+ 6E44 7E               ld   a, (hl)            ; Leggi byte compresso
1142+ 6E45 23               inc  hl
1143+ 6E46
1144+ 6E46 4F               ld   c, a               ; C = salvataggio
1145+ 6E47
1146+ 6E47                  ; Cella 0: bit 7-6
1147+ 6E47 07               rlca
1148+ 6E48 07               rlca
1149+ 6E49 E6 03            and  3
1150+ 6E4B 12               ld   (de), a
1151+ 6E4C 13               inc  de
1152+ 6E4D
1153+ 6E4D                  ; Cella 1: bit 5-4
1154+ 6E4D 79               ld   a, c
1155+ 6E4E 07               rlca
1156+ 6E4F 07               rlca
1157+ 6E50 07               rlca
1158+ 6E51 07               rlca
1159+ 6E52 E6 03            and  3
1160+ 6E54 12               ld   (de), a
1161+ 6E55 13               inc  de
1162+ 6E56
1163+ 6E56                  ; Cella 2: bit 3-2
1164+ 6E56 79               ld   a, c
1165+ 6E57 0F               rrca
1166+ 6E58 0F               rrca
1167+ 6E59 E6 03            and  3
1168+ 6E5B 12               ld   (de), a
1169+ 6E5C 13               inc  de
1170+ 6E5D
1171+ 6E5D                  ; Cella 3: bit 1-0
1172+ 6E5D 79               ld   a, c
1173+ 6E5E E6 03            and  3
1174+ 6E60 12               ld   (de), a
1175+ 6E61 13               inc  de
1176+ 6E62
1177+ 6E62 10 E0            djnz .byte_loop
1178+ 6E64
1179+ 6E64 C1               pop  bc
1180+ 6E65 D1               pop  de
1181+ 6E66 E1               pop  hl
1182+ 6E67 C9               ret
