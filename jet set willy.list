 162+ 6B39                  ; Controlla se positivo per evitare bug con cp signed
 163+ 6B39 CB 7F            bit 7, a
 164+ 6B3B 28 06            jr  z, .store_vel
 165+ 6B3D
 166+ 6B3D FE F4            cp  -MAX_FALL_SPEED   ; -12
 167+ 6B3F 30 02            jr  nc, .store_vel
 168+ 6B41 3E F4            ld  a, -MAX_FALL_SPEED
 169+ 6B43
 170+ 6B43              .store_vel:
 171+ 6B43 32 5E 6F         ld  (velocity_y), a
 172+ 6B46
 173+ 6B46                  ; Applica movimento verticale: PlayerY = PlayerY - velocity_y
 174+ 6B46 ED 4B 52 6F      ld  bc, (PlayerPos)
 175+ 6B4A 57               ld  d, a              ; D = velocity_y (signed)
 176+ 6B4B 78               ld  a, b              ; A = PlayerY
 177+ 6B4C 92               sub d                 ; A = PlayerY - velocity_y
 178+ 6B4D 47               ld  b, a              ; B = new PlayerY
 179+ 6B4E
 180+ 6B4E                  ; Controlla se stiamo cadendo (velocity_y <= 0)
 181+ 6B4E 3A 5E 6F         ld  a, (velocity_y)
 182+ 6B51 CB 7F            bit 7, a              ; Se negativo, bit 7 = 1
 183+ 6B53 20 05            jr  nz, .falling_checks
