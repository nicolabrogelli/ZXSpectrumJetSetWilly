2019+ 8817              ; CheckActiveItemAtCell
2020+ 8817              ;
2021+ 8817              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2022+ 8817              ; nella cella specificata della griglia items_grid.
2023+ 8817              ;
2024+ 8817              ; Questa routine usa una lookup diretta su una mappa 32x16,
2025+ 8817              ; evitando la scansione della ItemsTable.
2026+ 8817              ;
2027+ 8817              ; Input:
2028+ 8817              ;   B = Colonna (0..31)
2029+ 8817              ;   C = Riga (0..15)
2030+ 8817              ;
2031+ 8817              ; Output:
2032+ 8817              ;   Carry Set   = item presente nella cella
2033+ 8817              ;   Carry Clear = nessun item
2034+ 8817              ;
2035+ 8817              ; Nota:
2036+ 8817              ;   HL NON è restituito valido (commento originale non corretto:
2037+ 8817              ;   la routine non punta a ItemsTable).
2038+ 8817              ; -------------------------------------------------------------------
2039+ 8817              CheckActiveItemAtCell:
2040+ 8817
2041+ 8817                  ; Salva registri usati
2042+ 8817 D5               push de
2043+ 8818 E5               push hl
2044+ 8819
2045+ 8819                  ; ---------------------------------------------------------------
2046+ 8819                  ; Calcolo indice lineare nella griglia 32x16:
2047+ 8819                  ;
2048+ 8819                  ; offset = Row * 32 + Col
2049+ 8819                  ; ---------------------------------------------------------------
2050+ 8819 26 00            ld   h, 0
2051+ 881B 69               ld   l, c              ; HL = Row
2052+ 881C
2053+ 881C 29               add  hl, hl            ; *2
2054+ 881D 29               add  hl, hl            ; *4
2055+ 881E 29               add  hl, hl            ; *8
2056+ 881F 29               add  hl, hl            ; *16
2057+ 8820 29               add  hl, hl            ; *32
2058+ 8821
2059+ 8821                  ; Aggiunge la colonna
2060+ 8821 58               ld   e, b
2061+ 8822 16 00            ld   d, 0
2062+ 8824 19               add  hl, de            ; HL = Row*32 + Col
2063+ 8825
2064+ 8825                  ; ---------------------------------------------------------------
2065+ 8825                  ; Accesso alla griglia degli item attivi
2066+ 8825                  ; ---------------------------------------------------------------
2067+ 8825 11 E8 F5         ld   de, items_grid
2068+ 8828 19               add  hl, de            ; HL = address cella
2069+ 8829
2070+ 8829                  ; ---------------------------------------------------------------
2071+ 8829                  ; Controllo presenza item
2072+ 8829                  ;
2073+ 8829                  ; items_grid contiene:
2074+ 8829                  ;   0 = nessun item
2075+ 8829                  ;   >0 = item attivo (colore o flag)
2076+ 8829                  ; ---------------------------------------------------------------
2077+ 8829 7E               ld   a, (hl)
2078+ 882A B7               or   a
2079+ 882B 28 04            jr   z, .not_active
2080+ 882D
2081+ 882D                  ; ---------------------------------------------------------------
2082+ 882D                  ; Item trovato
2083+ 882D                  ; ---------------------------------------------------------------
2084+ 882D E1               pop  hl
2085+ 882E D1               pop  de
2086+ 882F
2087+ 882F 37               scf                    ; Carry = 1
2088+ 8830 C9               ret
2089+ 8831
2090+ 8831              .not_active:
2091+ 8831
2092+ 8831                  ; ---------------------------------------------------------------
2093+ 8831                  ; Nessun item nella cella
2094+ 8831                  ; ---------------------------------------------------------------
2095+ 8831 E1               pop  hl
2096+ 8832 D1               pop  de
2097+ 8833
2098+ 8833 B7               or   a                 ; Carry = 0
2099+ 8834 C9               ret
