 191+ 805D F6 10            or   $10               ; speaker ON
 192+ 805F D3 FE            out  ($fe), a
 193+ 8061
 194+ 8061 0E 3C            ld   c, 60
 195+ 8063              .d1:
 196+ 8063 0D               dec  c
 197+ 8064 20 FD            jr   nz, .d1
 198+ 8066
 199+ 8066 3A 32 E6         ld   a, (room_border_color)
 200+ 8069 E6 EF            and  $ef              ; speaker OFF
 201+ 806B D3 FE            out  ($fe), a
 202+ 806D
 203+ 806D 0E 3C            ld   c, 60
 204+ 806F              .d2:
 205+ 806F 0D               dec  c
 206+ 8070 20 FD            jr   nz, .d2
 207+ 8072
 208+ 8072 10 E6            djnz .sound_loop
 209+ 8074
 210+ 8074 D1               pop  de
 211+ 8075 C1               pop  bc
 212+ 8076 C9               ret
