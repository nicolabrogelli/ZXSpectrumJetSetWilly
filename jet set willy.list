 397+ 7591              ; -------------------------------------------------------------------
 398+ 7591              ; Controlla se Willy tocca un item attivo nella stanza corrente
 399+ 7591              ; -------------------------------------------------------------------
 400+ 7591              CheckRoomItemsCollision:
 401+ 7591 E5               push hl
 402+ 7592 D5               push de
 403+ 7593 C5               push bc
 404+ 7594
 405+ 7594 21 E5 73         ld   hl, ItemsTable
 406+ 7597              .loop:
 407+ 7597 7E               ld   a, (hl)           ; A = Room ID
 408+ 7598 FE FF            cp   $FF               ; Fine tabella?
 409+ 759A 28 2B            jr   z, .done
 410+ 759C
 411+ 759C                  ; Stanza corrente?
 412+ 759C 57               ld   d, a              ; D = Room ID
 413+ 759D 3A 9D 77         ld   a, (current_room)
 414+ 75A0 BA               cp   d
 415+ 75A1 20 1D            jr   nz, .next_item
 416+ 75A3
 417+ 75A3 23               inc  hl                ; HL punta a X
 418+ 75A4 4E               ld   c, (hl)           ; C = X
 419+ 75A5 23               inc  hl                ; HL punta a Y
 420+ 75A6 46               ld   b, (hl)           ; B = Y
 421+ 75A7 23               inc  hl                ; HL punta al colore (lo saltiamo per il controllo collisione)
 422+ 75A8 23               inc  hl                ; HL punta a collected
 423+ 75A9 7E               ld   a, (hl)           ; A = collected
 424+ 75AA B7               or   a
 425+ 75AB 20 17            jr   nz, .next_no_inc  ; Già raccolto, salta
 426+ 75AD
 427+ 75AD                  ; Controlla collisione
 428+ 75AD 79               ld   a, c
 429+ 75AE 60               ld   h, b
 430+ 75AF CD 4B 75         call CheckWillyItemCollision
 431+ 75B2 30 10            jr   nc, .next_no_inc
 432+ 75B4
 433+ 75B4                  ; RACCOLTO!
 434+ 75B4 36 01            ld   (hl), 1           ; Imposta collected = 1
 435+ 75B6
 436+ 75B6 E5               push hl
 437+ 75B7
 438+ 75B7                  ; Cancella item dallo schermo
 439+ 75B7 CD D6 74         call RestoreBackgroundCell
 440+ 75BA
 441+ 75BA                  ; Suono di raccolta
 442+ 75BA CD CB 75         call PlayCollectSound
 443+ 75BD
 444+ 75BD E1               pop  hl
 445+ 75BE
 446+ 75BE 18 04            jr   .next_no_inc
 447+ 75C0
 448+ 75C0              .next_item:
 449+ 75C0 23               inc  hl                ; salta X
 450+ 75C1 23               inc  hl                ; salta Y
 451+ 75C2 23               inc  hl                ; salta colore
 452+ 75C3 23               inc  hl                ; salta collected
 453+ 75C4              .next_no_inc:
 454+ 75C4 23               inc  hl                ; vai al prossimo item
 455+ 75C5 18 D0            jr   .loop
 456+ 75C7
 457+ 75C7              .done:
 458+ 75C7 C1               pop  bc
 459+ 75C8 D1               pop  de
 460+ 75C9 E1               pop  hl
 461+ 75CA C9               ret
 462+ 75CB
 463+ 75CB              ; -------------------------------------------------------------------
 464+ 75CB              ; Riproduce un breve segnale acustico all'altoparlante
 465+ 75CB              ; -------------------------------------------------------------------
 466+ 75CB              PlayCollectSound:
 467+ 75CB C5               push bc
 468+ 75CC D5               push de
 469+ 75CD
 470+ 75CD 06 78            ld   b, 120            ; Cicli della nota
 471+ 75CF              .sound_loop:
 472+ 75CF 3A 96 76         ld   a, (room_border_color)
 473+ 75D2 F6 10            or   $10               ; Speaker ON (bit 4 = 1)
 474+ 75D4 D3 FE            out  ($fe), a
 475+ 75D6 0E 3C            ld   c, 60             ; Mezzo periodo delay
 476+ 75D8 0D           .d1: dec  c
 477+ 75D9 20 FD            jr   nz, .d1
 478+ 75DB
 479+ 75DB 3A 96 76         ld   a, (room_border_color)
 480+ 75DE E6 EF            and  $ef               ; Speaker OFF (bit 4 = 0)
 481+ 75E0 D3 FE            out  ($fe), a
 482+ 75E2 0E 3C            ld   c, 60             ; Mezzo periodo delay
 483+ 75E4 0D           .d2: dec  c
 484+ 75E5 20 FD            jr   nz, .d2
 485+ 75E7
 486+ 75E7 10 E6            djnz .sound_loop
 487+ 75E9
 488+ 75E9 D1               pop  de
 489+ 75EA C1               pop  bc
 490+ 75EB C9               ret
