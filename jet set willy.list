 177+ 73E0              .done:
 178+ 73E0 DD E1            pop  ix
 179+ 73E2 D1               pop  de
 180+ 73E3 C1               pop  bc
 181+ 73E4 E1               pop  hl
 182+ 73E5 C9               ret
 183+ 73E6
 184+ 73E6              ; -------------------------------------------------------------------
 185+ 73E6              ; Disegna un singolo item (8x8 pixel) a schermo con colore personalizzato
 186+ 73E6              ; Input: B = Row (3..18), C = Col (0..31), HL = Puntatore al bitmap (8 byte), E = Colore
 187+ 73E6              ; -------------------------------------------------------------------
 188+ 73E6              DrawItemGraphic:
 189+ 73E6 C5               push bc
 190+ 73E7 D5               push de
 191+ 73E8 E5               push hl
 192+ 73E9
 193+ 73E9                  ; 1. Calcola l'indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 194+ 73E9 78               ld   a, b
 195+ 73EA E6 18            and  $18
 196+ 73EC C6 40            add  a, $40
 197+ 73EE 57               ld   d, a              ; D = High byte dell'indirizzo dello schermo
 198+ 73EF
 199+ 73EF 78               ld   a, b
 200+ 73F0 E6 07            and  7
 201+ 73F2 87               add  a, a              ; *2
 202+ 73F3 87               add  a, a              ; *4
 203+ 73F4 87               add  a, a              ; *8
 204+ 73F5 87               add  a, a              ; *16
 205+ 73F6 87               add  a, a              ; *32
 206+ 73F7 81               add  a, c              ; + Col C
 207+ 73F8 5F               ld   e, a              ; E = Low byte dell'indirizzo dello schermo
 208+ 73F9
 209+ 73F9                  ; 2. Copia gli 8 byte del bitmap dello sprite
 210+ 73F9 C5               push bc                ; Salva BC (contiene Row e Col)
 211+ 73FA 06 08            ld   b, 8              ; 8 scanline
 212+ 73FC              .line_loop:
 213+ 73FC 7E               ld   a, (hl)
 214+ 73FD 12               ld   (de), a
 215+ 73FE 14               inc  d                 ; Prossima scanline
 216+ 73FF 23               inc  hl
 217+ 7400 05               dec  b
 218+ 7401 20 F9            jr   nz, .line_loop
 219+ 7403 C1               pop  bc                ; Ripristina BC
 220+ 7404
 221+ 7404                  ; 3. Calcola l'indirizzo degli attributi dello schermo
 222+ 7404                  ; HL = $5800 + B * 32 + C
 223+ 7404 26 00            ld   h, 0
 224+ 7406 68               ld   l, b              ; HL = B (Row)
 225+ 7407 29               add  hl, hl            ; *2
 226+ 7408 29               add  hl, hl            ; *4
 227+ 7409 29               add  hl, hl            ; *8
 228+ 740A 29               add  hl, hl            ; *16
 229+ 740B 29               add  hl, hl            ; *32
 230+ 740C
 231+ 740C 79               ld   a, c              ; A = Col
 232+ 740D 85               add  a, l
 233+ 740E 6F               ld   l, a
 234+ 740F 30 01            jr   nc, .no_carry
 235+ 7411 24               inc  h
 236+ 7412              .no_carry:
 237+ 7412                  ; HL = B * 32 + C
 238+ 7412 11 00 58         ld   de, $5800
 239+ 7415 19               add  hl, de            ; HL = AttrAddr
 240+ 7416
 241+ 7416                  ; Ripristina i registri dallo stack per estrarre il colore in E
 242+ 7416                  ; Lo stack ha: HL (originale), DE (originale con colore in E), BC (originale)
 243+ 7416 C1               pop  bc                ; BC = HL originale
 244+ 7417 D1               pop  de                ; DE = DE originale (colore in E)
 245+ 7418
 246+ 7418 7B               ld   a, e              ; A = Colore
 247+ 7419 77               ld   (hl), a           ; Scrivi in memoria attributi (HL)
 248+ 741A
 249+ 741A                  ; Ripristina lo stack e i registri originari
 250+ 741A C5               push bc                ; Rimetti HL originale sulla pila
 251+ 741B E1               pop  hl                ; HL = HL originale
 252+ 741C C1               pop  bc                ; BC = BC originale
 253+ 741D C9               ret
