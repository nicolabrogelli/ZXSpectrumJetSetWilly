 512+ 6E68
 513+ 6E68              .do_update:
 514+ 6E68 DD 21 A8 6B      ld   ix, ActiveEnemies
 515+ 6E6C 06 08            ld   b, 8              ; 8 slot
 516+ 6E6E              .loop:
 517+ 6E6E DD 7E 00         ld   a, (ix+0)         ; Flags
 518+ 6E71 E6 80            and  $80               ; Active?
 519+ 6E73 CA 1E 6F         jp   z, .next
 520+ 6E76
 521+ 6E76                  ; 1. Salva la posizione corrente in Old X/Y per la cancellazione nel prossimo frame
 522+ 6E76 DD 7E 01         ld   a, (ix+1)
 523+ 6E79 DD 77 07         ld   (ix+7), a         ; Old X = Current X
 524+ 6E7C DD 7E 02         ld   a, (ix+2)
 525+ 6E7F DD 77 08         ld   (ix+8), a         ; Old Y = Current Y
 526+ 6E82
