  17+ 7193              ; Tabella dei colori, se aggiungiamo $C davanti al colore questo diventa lampeggiante
  18+ 7193              ; 1 - BLUE
  19+ 7193              ; 2 - RED
  20+ 7193              ; 3 - MAGENTA
  21+ 7193              ; 4 - GREEN
  22+ 7193              ; 5 - CYAN
  23+ 7193              ; 6 - YELLOW
  24+ 7193              ; 7 - WHITE
