 179+ 86A6              ; Audio_PlayCollectSound
 180+ 86A6              ;
 181+ 86A6              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 86A6              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 86A6              ; -------------------------------------------------------------------
 184+ 86A6              Audio_PlayCollectSound:
 185+ 86A6 C5               push bc
 186+ 86A7 D5               push de
 187+ 86A8
 188+ 86A8 06 78            ld   b, 120
 189+ 86AA              .sound_loop:
 190+ 86AA 3A 88 EC         ld   a, (room_border_color)
 191+ 86AD F6 10            or   $10               ; speaker ON
 192+ 86AF D3 FE            out  ($fe), a
 193+ 86B1
 194+ 86B1 0E 3C            ld   c, 60
 195+ 86B3              .d1:
 196+ 86B3 0D               dec  c
 197+ 86B4 20 FD            jr   nz, .d1
 198+ 86B6
 199+ 86B6 3A 88 EC         ld   a, (room_border_color)
 200+ 86B9 E6 EF            and  $ef              ; speaker OFF
 201+ 86BB D3 FE            out  ($fe), a
 202+ 86BD
 203+ 86BD 0E 3C            ld   c, 60
 204+ 86BF              .d2:
 205+ 86BF 0D               dec  c
 206+ 86C0 20 FD            jr   nz, .d2
 207+ 86C2
 208+ 86C2 10 E6            djnz .sound_loop
