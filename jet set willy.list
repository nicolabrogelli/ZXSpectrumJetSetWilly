1857+ 7A08              ; Verifica se c'è una cella Nasty (tipo 3) alle coordinate pixel (X, Y)
1858+ 7A08              ; Input: C = X, B = Y
1859+ 7A08              ; Output: Carry flag impostato se è Nasty, altrimenti resettato
1860+ 7A08              ; -------------------------------------------------------------------
1861+ 7A08              CheckNastyCell:
1862+ 7A08 E5               push hl
1863+ 7A09 D5               push de
1864+ 7A0A C5               push bc
1865+ 7A0B
1866+ 7A0B                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1867+ 7A0B 78               ld   a, b
1868+ 7A0C FE 80            cp   128
1869+ 7A0E 30 17            jr   nc, .not_nasty
1870+ 7A10
1871+ 7A10                  ; 2. Calcola riga di layout: r = Y / 8
1872+ 7A10 CB 3F            srl  a
1873+ 7A12 CB 3F            srl  a
1874+ 7A14 CB 3F            srl  a                 ; A = r (0..15)
1875+ 7A16
1876+ 7A16                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1877+ 7A16 5F               ld   e, a              ; E = r
1878+ 7A17 79               ld   a, c
1879+ 7A18 CB 3F            srl  a
1880+ 7A1A CB 3F            srl  a
1881+ 7A1C CB 3F            srl  a                 ; A = c (0..31)
1882+ 7A1E 4F               ld   c, a              ; C = c
1883+ 7A1F 7B               ld   a, e              ; A = r
1884+ 7A20
1885+ 7A20 CD 8E 77         call GetCellFromUnpacked ; A = cell type
1886+ 7A23
1887+ 7A23                  ; Controlla se è Nasty (3)
1888+ 7A23 FE 03            cp   3
1889+ 7A25 28 05            jr   z, .is_nasty
1890+ 7A27
1891+ 7A27              .not_nasty:
1892+ 7A27 C1               pop  bc
1893+ 7A28 D1               pop  de
1894+ 7A29 E1               pop  hl
1895+ 7A2A B7               or   a                 ; Clear carry
1896+ 7A2B C9               ret
1897+ 7A2C
1898+ 7A2C              .is_nasty:
1899+ 7A2C C1               pop  bc
1900+ 7A2D D1               pop  de
1901+ 7A2E E1               pop  hl
1902+ 7A2F 37               scf                    ; Set carry
1903+ 7A30 C9               ret
