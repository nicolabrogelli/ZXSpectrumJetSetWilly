 733+ 7857
 734+ 7857              .set_room:
 735+ 7857
 736+ 7857                  ; Salva l'ID della stanza corrente
 737+ 7857 32 5A 7E         ld   (current_room), a
 738+ 785A
 739+ 785A                  ; Ripristina i registri
 740+ 785A D1               pop  de
 741+ 785B E1               pop  hl
 742+ 785C
 743+ 785C C9               ret
 744+ 785D
 745+ 785D              ; -------------------------------------------------------------------
 746+ 785D              ; Items_DrawRoom
 747+ 785D              ;
 748+ 785D              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 749+ 785D              ;
 750+ 785D              ; Operazioni eseguite:
 751+ 785D              ;   1. Azzera la griglia items_grid.
 752+ 785D              ;   2. Svuota la cache degli oggetti attivi.
 753+ 785D              ;   3. Scansiona ItemsTable.
 754+ 785D              ;   4. Per ogni item della stanza corrente:
 755+ 785D              ;        - verifica se è già stato raccolto
 756+ 785D              ;        - disegna la grafica
 757+ 785D              ;        - aggiorna items_grid
 758+ 785D              ;        - memorizza l'item nella cache current_room_items
 759+ 785D              ;   5. Aggiorna num_room_items.
 760+ 785D              ;
 761+ 785D              ; Record ItemsTable:
 762+ 785D              ;   +0  Room ID
 763+ 785D              ;   +1  X (colonna)
 764+ 785D              ;   +2  Y (riga)
 765+ 785D              ;   +3  Colore
 766+ 785D              ;   +4  Collected flag
 767+ 785D              ;
 768+ 785D              ; Cache current_room_items:
 769+ 785D              ;   +0  Colonna
 770+ 785D              ;   +1  Riga
 771+ 785D              ;   +2  Colore
 772+ 785D              ;   +3  Collected flag ptr (Low)
 773+ 785D              ;   +4  Collected flag ptr (High)
 774+ 785D              ;
 775+ 785D              ; Ogni record cache occupa 5 byte.
 776+ 785D              ; -------------------------------------------------------------------
 777+ 785D              Items_DrawRoom:
 778+ 785D
 779+ 785D                  ; Salva tutti i registri utilizzati
 780+ 785D E5               push hl
 781+ 785E D5               push de
 782+ 785F C5               push bc
 783+ 7860 DD E5            push ix
 784+ 7862 FD E5            push iy
