   8+ 854C              ; Audio_UpdateJumpSound
   9+ 854C              ;
  10+ 854C              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 854C              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 854C              ; -------------------------------------------------------------------
  13+ 854C              Audio_UpdateJumpSound:
  14+ 854C F5               push af
  15+ 854D C5               push bc
  16+ 854E D5               push de
  17+ 854F E5               push hl
  18+ 8550
  19+ 8550                  ; Controlla se il suono è attivo (note < 18)
  20+ 8550 3A 92 EE         ld   a, (Audio_jump_sound_note)
  21+ 8553 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8555 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8557
  24+ 8557                  ; Carica la nota corrente da suonare
  25+ 8557 5F               ld   e, a
  26+ 8558 16 00            ld   d, 0
  27+ 855A 21 86 85         ld   hl, Audio_JumpSoundDelays
  28+ 855D 19               add  hl, de
  29+ 855E 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 855F 57               ld   d, a                      ; D = delay della nota
  31+ 8560
  32+ 8560                  ; Suona la nota: 15 cicli
  33+ 8560 06 0F            ld   b, 15
  34+ 8562              .note_loop:
  35+ 8562                  ; Speaker ON
  36+ 8562 3A 8B EA         ld   a, (room_border_color)
  37+ 8565 F6 10            or   $10
  38+ 8567 D3 FE            out  ($fe), a
  39+ 8569 4A               ld   c, d
  40+ 856A              .d1:
  41+ 856A 0D               dec  c
  42+ 856B 20 FD            jr   nz, .d1
  43+ 856D
  44+ 856D                  ; Speaker OFF
  45+ 856D 3A 8B EA         ld   a, (room_border_color)
  46+ 8570 E6 EF            and  $ef
  47+ 8572 D3 FE            out  ($fe), a
  48+ 8574 4A               ld   c, d
  49+ 8575              .d2:
  50+ 8575 0D               dec  c
  51+ 8576 20 FD            jr   nz, .d2
  52+ 8578
  53+ 8578 10 E8            djnz .note_loop
  54+ 857A
  55+ 857A                  ; Passa alla nota successiva
  56+ 857A 3A 92 EE         ld   a, (Audio_jump_sound_note)
  57+ 857D 3C               inc  a
  58+ 857E 32 92 EE         ld   (Audio_jump_sound_note), a
