 911+ 78BA                  ; ---------------------------------------------------------------
 912+ 78BA                  ; Salva l'item nella cache della stanza
 913+ 78BA                  ;
 914+ 78BA                  ; Questo evita di dover scansionare tutta ItemsTable
 915+ 78BA                  ; durante il controllo delle collisioni.
 916+ 78BA                  ; ---------------------------------------------------------------
 917+ 78BA
 918+ 78BA FD 71 00         ld   (iy+0), c         ; Colonna
 919+ 78BD FD 70 01         ld   (iy+1), b         ; Riga
 920+ 78C0 FD 73 02         ld   (iy+2), e         ; Colore
