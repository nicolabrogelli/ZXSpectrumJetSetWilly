1253+ 79A4              ; -------------------------------------------------------------------
1254+ 79A4              ; CheckWillyItemCollision
1255+ 79A4              ;
1256+ 79A4              ; Verifica se Willy collide con un item utilizzando il controllo
1257+ 79A4              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1258+ 79A4              ;
1259+ 79A4              ; Input:
1260+ 79A4              ;   A = ItemX (colonna attributi 0..31)
1261+ 79A4              ;   H = ItemY (riga attributi 3..18)
1262+ 79A4              ;
1263+ 79A4              ; Coordinate item:
1264+ 79A4              ;   Ogni item occupa una cella da 8x8 pixel.
1265+ 79A4              ;
1266+ 79A4              ; Coordinate Willy:
1267+ 79A4              ;   Willy occupa un rettangolo di 16x16 pixel.
1268+ 79A4              ;
1269+ 79A4              ; Output:
1270+ 79A4              ;   Carry Set   = collisione rilevata
1271+ 79A4              ;   Carry Clear = nessuna collisione
1272+ 79A4              ;
1273+ 79A4              ; Registri preservati:
1274+ 79A4              ;   BC, DE, HL
1275+ 79A4              ; -------------------------------------------------------------------
1276+ 79A4              CheckWillyItemCollision:
1277+ 79A4
1278+ 79A4                  ; Salva i registri utilizzati
1279+ 79A4 C5               push bc
1280+ 79A5 D5               push de
1281+ 79A6 E5               push hl
1282+ 79A7
1283+ 79A7                  ; ---------------------------------------------------------------
1284+ 79A7                  ; Calcola il bounding box orizzontale dell'item
1285+ 79A7                  ;
1286+ 79A7                  ; ItemLeft  = ItemX * 8
1287+ 79A7                  ; ItemRight = ItemLeft + 7
1288+ 79A7                  ;
1289+ 79A7                  ; E = ItemLeft
1290+ 79A7                  ; D = ItemRight
1291+ 79A7                  ; ---------------------------------------------------------------
1292+ 79A7 6F               ld   l, a              ; L = ItemX
1293+ 79A8
1294+ 79A8 7D               ld   a, l
1295+ 79A9 87               add  a, a              ; *2
1296+ 79AA 87               add  a, a              ; *4
1297+ 79AB 87               add  a, a              ; *8
1298+ 79AC
1299+ 79AC 5F               ld   e, a              ; E = ItemLeft
1300+ 79AD
1301+ 79AD C6 07            add  a, 7
1302+ 79AF 57               ld   d, a              ; D = ItemRight
1303+ 79B0
1304+ 79B0                  ; ---------------------------------------------------------------
1305+ 79B0                  ; Recupera la posizione corrente di Willy
1306+ 79B0                  ;
1307+ 79B0                  ; B = WillyY
1308+ 79B0                  ; C = WillyX
1309+ 79B0                  ; ---------------------------------------------------------------
1310+ 79B0 ED 4B D2 7A      ld   bc, (PlayerPos)
1311+ 79B4
1312+ 79B4                  ; ---------------------------------------------------------------
1313+ 79B4                  ; Primo test:
1314+ 79B4                  ;
1315+ 79B4                  ; WillyLeft <= ItemRight
1316+ 79B4                  ;
1317+ 79B4                  ; Se Willy è completamente a destra dell'item
1318+ 79B4                  ; non può esserci collisione.
1319+ 79B4                  ; ---------------------------------------------------------------
1320+ 79B4 79               ld   a, c              ; A = WillyLeft
1321+ 79B5
1322+ 79B5 BA               cp   d                 ; WillyLeft vs ItemRight
1323+ 79B6
1324+ 79B6 28 04            jr   z, .x_ok
1325+ 79B8 38 02            jr   c, .x_ok
1326+ 79BA
1327+ 79BA 18 29            jr   .no_collision
1328+ 79BC
1329+ 79BC              .x_ok:
1330+ 79BC
1331+ 79BC                  ; ---------------------------------------------------------------
1332+ 79BC                  ; Secondo test:
1333+ 79BC                  ;
1334+ 79BC                  ; WillyRight >= ItemLeft
1335+ 79BC                  ;
1336+ 79BC                  ; WillyRight = WillyX + 7
1337+ 79BC                  ; ---------------------------------------------------------------
1338+ 79BC C6 07            add  a, 7
1339+ 79BE
1340+ 79BE BB               cp   e                 ; WillyRight vs ItemLeft
1341+ 79BF
1342+ 79BF 28 04            jr   z, .y_check
1343+ 79C1 30 02            jr   nc, .y_check
1344+ 79C3
1345+ 79C3 18 20            jr   .no_collision
1346+ 79C5
1347+ 79C5              .y_check:
1348+ 79C5
1349+ 79C5                  ; ---------------------------------------------------------------
1350+ 79C5                  ; Recupera ItemY dal valore originale di HL
1351+ 79C5                  ;
1352+ 79C5                  ; H contiene la riga dell'item.
1353+ 79C5                  ; ---------------------------------------------------------------
1354+ 79C5 E1               pop  hl
1355+ 79C6 E5               push hl
1356+ 79C7
1357+ 79C7                  ; ---------------------------------------------------------------
1358+ 79C7                  ; Calcola il bounding box verticale dell'item
1359+ 79C7                  ;
1360+ 79C7                  ; ItemTop    = ItemY * 8
1361+ 79C7                  ; ItemBottom = ItemTop + 7
1362+ 79C7                  ;
1363+ 79C7                  ; E = ItemTop
1364+ 79C7                  ; D = ItemBottom
1365+ 79C7                  ; ---------------------------------------------------------------
1366+ 79C7 7C               ld   a, h
1367+ 79C8
1368+ 79C8 87               add  a, a              ; *2
1369+ 79C9 87               add  a, a              ; *4
1370+ 79CA 87               add  a, a              ; *8
1371+ 79CB
1372+ 79CB 5F               ld   e, a              ; ItemTop
1373+ 79CC
1374+ 79CC C6 07            add  a, 7
1375+ 79CE 57               ld   d, a              ; ItemBottom
1376+ 79CF
1377+ 79CF                  ; ---------------------------------------------------------------
1378+ 79CF                  ; Primo test verticale:
1379+ 79CF                  ;
1380+ 79CF                  ; WillyTop <= ItemBottom
1381+ 79CF                  ; ---------------------------------------------------------------
1382+ 79CF 78               ld   a, b              ; WillyTop
1383+ 79D0
1384+ 79D0 BA               cp   d
1385+ 79D1
1386+ 79D1 28 04            jr   z, .y_ok
1387+ 79D3 38 02            jr   c, .y_ok
1388+ 79D5
1389+ 79D5 18 0E            jr   .no_collision
1390+ 79D7
1391+ 79D7              .y_ok:
1392+ 79D7
1393+ 79D7                  ; ---------------------------------------------------------------
1394+ 79D7                  ; Secondo test verticale:
1395+ 79D7                  ;
1396+ 79D7                  ; WillyBottom >= ItemTop
1397+ 79D7                  ;
1398+ 79D7                  ; WillyBottom = WillyY + 15
1399+ 79D7                  ; ---------------------------------------------------------------
1400+ 79D7 C6 0F            add  a, 15
1401+ 79D9
1402+ 79D9 BB               cp   e
1403+ 79DA
1404+ 79DA 28 04            jr   z, .collision
1405+ 79DC 30 02            jr   nc, .collision
1406+ 79DE
1407+ 79DE 18 05            jr   .no_collision
1408+ 79E0
1409+ 79E0              .collision:
1410+ 79E0
1411+ 79E0                  ; ---------------------------------------------------------------
1412+ 79E0                  ; Collisione rilevata
1413+ 79E0                  ; ---------------------------------------------------------------
1414+ 79E0 E1               pop  hl
1415+ 79E1 D1               pop  de
1416+ 79E2 C1               pop  bc
1417+ 79E3
1418+ 79E3 37               scf                    ; Carry = 1
1419+ 79E4
1420+ 79E4 C9               ret
1421+ 79E5
1422+ 79E5              .no_collision:
1423+ 79E5
1424+ 79E5                  ; ---------------------------------------------------------------
1425+ 79E5                  ; Nessuna collisione
1426+ 79E5                  ; ---------------------------------------------------------------
1427+ 79E5 E1               pop  hl
1428+ 79E6 D1               pop  de
1429+ 79E7 C1               pop  bc
1430+ 79E8
1431+ 79E8 B7               or   a                 ; Carry = 0
1432+ 79E9
1433+ 79E9 C9               ret
