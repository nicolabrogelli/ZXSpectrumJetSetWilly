 100+ 5E2F 7C               ld  a, h
 101+ 5E30 E6 07            and 7             ; Controlla se la scanline è tornata a 0 (wrap)
 102+ 5E32 C0               ret nz            ; Se non è 0, abbiamo finito!
 103+ 5E33
