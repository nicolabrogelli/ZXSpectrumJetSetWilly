 435+ 6BD8              ; -------------------------------------------------------------------
 436+ 6BD8              ; Controlla se Willy tocca un item attivo nella stanza corrente
 437+ 6BD8              ; -------------------------------------------------------------------
 438+ 6BD8              CheckRoomItemsCollision:
 439+ 6BD8 E5               push hl
 440+ 6BD9 D5               push de
 441+ 6BDA C5               push bc
 442+ 6BDB
 443+ 6BDB 21 EC 69         ld   hl, ItemsTable
 444+ 6BDE              .loop:
 445+ 6BDE 7E               ld   a, (hl)           ; A = Room ID
 446+ 6BDF FE FF            cp   $FF               ; Fine tabella?
 447+ 6BE1 28 2D            jr   z, .done
 448+ 6BE3
 449+ 6BE3                  ; Stanza corrente?
 450+ 6BE3 57               ld   d, a              ; D = Room ID
 451+ 6BE4 3A 07 7A         ld   a, (current_room)
 452+ 6BE7 BA               cp   d
 453+ 6BE8 20 1F            jr   nz, .next_item
 454+ 6BEA
 455+ 6BEA 23               inc  hl                ; HL punta a X
 456+ 6BEB 4E               ld   c, (hl)           ; C = X
 457+ 6BEC 23               inc  hl                ; HL punta a Y
 458+ 6BED 46               ld   b, (hl)           ; B = Y
 459+ 6BEE 23               inc  hl                ; HL punta al colore (lo saltiamo per il controllo collisione)
 460+ 6BEF 23               inc  hl                ; HL punta a collected
 461+ 6BF0 7E               ld   a, (hl)           ; A = collected
 462+ 6BF1 B7               or   a
 463+ 6BF2 20 19            jr   nz, .next_no_inc  ; Già raccolto, salta
 464+ 6BF4
 465+ 6BF4                  ; Controlla collisione
 466+ 6BF4 79               ld   a, c
 467+ 6BF5 E5               push hl
 468+ 6BF6 60               ld   h, b
 469+ 6BF7 CD 92 6B         call CheckWillyItemCollision
 470+ 6BFA E1               pop  hl
 471+ 6BFB 30 10            jr   nc, .next_no_inc
