 336+ 6C50                  ; Legge i dati dell'item
 337+ 6C50                  ; ---------------------------------------------------------------
 338+ 6C50
 339+ 6C50 23               inc  hl
 340+ 6C51 4E               ld   c, (hl)           ; X (colonna)
 341+ 6C52
 342+ 6C52 23               inc  hl
 343+ 6C53 46               ld   b, (hl)           ; Y (riga)
 344+ 6C54
 345+ 6C54 23               inc  hl
 346+ 6C55 5E               ld   e, (hl)           ; Colore
 347+ 6C56
 348+ 6C56 23               inc  hl
 349+ 6C57 7E               ld   a, (hl)           ; Collected flag
 350+ 6C58
 351+ 6C58                  ; Se diverso da zero l'item è già stato raccolto
 352+ 6C58 B7               or   a
 353+ 6C59 20 3E            jr   nz, .next_no_inc
 354+ 6C5B
 355+ 6C5B                  ; ---------------------------------------------------------------
 356+ 6C5B                  ; Disegna l'item sullo schermo
 357+ 6C5B                  ;
 358+ 6C5B                  ; B = Row
 359+ 6C5B                  ; C = Column
 360+ 6C5B                  ; HL = bitmap pointer
 361+ 6C5B                  ; E = Color
 362+ 6C5B                  ; ---------------------------------------------------------------
 363+ 6C5B E5               push hl
 364+ 6C5C
 365+ 6C5C DD E5            push ix
 366+ 6C5E E1               pop  hl
 367+ 6C5F
 368+ 6C5F CD A4 6C         call DrawItemGraphic
 369+ 6C62
 370+ 6C62 E1               pop  hl                ; ritorna al flag collected
 371+ 6C63
 372+ 6C63                  ; ---------------------------------------------------------------
 373+ 6C63                  ; Aggiorna items_grid
 374+ 6C63                  ;
 375+ 6C63                  ; Calcolo:
 376+ 6C63                  ;   offset = Row * 32 + Col
 377+ 6C63                  ; ---------------------------------------------------------------
 378+ 6C63 E5               push hl
 379+ 6C64 D5               push de
 380+ 6C65
 381+ 6C65 26 00            ld   h, 0
 382+ 6C67 68               ld   l, b              ; HL = Row
 383+ 6C68
 384+ 6C68 29               add  hl, hl            ; *2
 385+ 6C69 29               add  hl, hl            ; *4
 386+ 6C6A 29               add  hl, hl            ; *8
 387+ 6C6B 29               add  hl, hl            ; *16
 388+ 6C6C 29               add  hl, hl            ; *32
 389+ 6C6D
 390+ 6C6D 16 00            ld   d, 0
 391+ 6C6F 59               ld   e, c              ; DE = Col
 392+ 6C70
 393+ 6C70 19               add  hl, de            ; Row*32 + Col
 394+ 6C71
 395+ 6C71 11 00 90         ld   de, items_grid
 396+ 6C74 19               add  hl, de            ; puntatore nella griglia
 397+ 6C75
 398+ 6C75 D1               pop  de                ; ripristina colore
 399+ 6C76
 400+ 6C76 73               ld   (hl), e           ; salva colore cella
 401+ 6C77
 402+ 6C77 E1               pop  hl
 403+ 6C78
 404+ 6C78                  ; ---------------------------------------------------------------
 405+ 6C78                  ; Salva l'item nella cache della stanza
 406+ 6C78                  ;
 407+ 6C78                  ; Questo evita di dover scansionare tutta ItemsTable
 408+ 6C78                  ; durante il controllo delle collisioni.
 409+ 6C78                  ; ---------------------------------------------------------------
 410+ 6C78
 411+ 6C78 FD 71 00         ld   (iy+0), c         ; Colonna
 412+ 6C7B FD 70 01         ld   (iy+1), b         ; Riga
 413+ 6C7E FD 73 02         ld   (iy+2), e         ; Colore
 414+ 6C81
 415+ 6C81                  ; Salva il puntatore al flag "collected"
 416+ 6C81 FD 75 03         ld   (iy+3), l         ; Low byte
 417+ 6C84 FD 74 04         ld   (iy+4), h         ; High byte
 418+ 6C87
 419+ 6C87                  ; Passa al record successivo della cache
 420+ 6C87 01 05 00         ld   bc, 5
 421+ 6C8A FD 09            add  iy, bc
 422+ 6C8C
 423+ 6C8C                  ; Incrementa il numero di item attivi
 424+ 6C8C 3A AC 7D         ld   a, (num_room_items)
 425+ 6C8F 3C               inc  a
 426+ 6C90 32 AC 7D         ld   (num_room_items), a
 427+ 6C93
 428+ 6C93 18 04            jr   .next_no_inc
 429+ 6C95
 430+ 6C95              .next_item:
 431+ 6C95
 432+ 6C95                  ; ---------------------------------------------------------------
 433+ 6C95                  ; L'item non appartiene alla stanza corrente.
 434+ 6C95                  ; Salta i campi del record:
 435+ 6C95                  ;   X
 436+ 6C95                  ;   Y
 437+ 6C95                  ;   Color
 438+ 6C95                  ;   Collected
 439+ 6C95                  ; ---------------------------------------------------------------
 440+ 6C95 23               inc  hl
 441+ 6C96 23               inc  hl
 442+ 6C97 23               inc  hl
 443+ 6C98 23               inc  hl
 444+ 6C99
 445+ 6C99              .next_no_inc:
 446+ 6C99
 447+ 6C99                  ; ---------------------------------------------------------------
 448+ 6C99                  ; Avanza al record successivo
 449+ 6C99                  ; (prossimo Room ID)
 450+ 6C99                  ; ---------------------------------------------------------------
 451+ 6C99 23               inc  hl
 452+ 6C9A 18 A8            jr   .loop
 453+ 6C9C
 454+ 6C9C              .done:
 455+ 6C9C
 456+ 6C9C                  ; Ripristina i registri
 457+ 6C9C FD E1            pop  iy
 458+ 6C9E DD E1            pop  ix
 459+ 6CA0 D1               pop  de
 460+ 6CA1 C1               pop  bc
 461+ 6CA2 E1               pop  hl
 462+ 6CA3
 463+ 6CA3 C9               ret
 464+ 6CA4
 465+ 6CA4              ; -------------------------------------------------------------------
 466+ 6CA4              ; DrawItemGraphic
 467+ 6CA4              ;
 468+ 6CA4              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 469+ 6CA4              ; utilizzando una bitmap di 8 byte e un attributo colore.
 470+ 6CA4              ;
 471+ 6CA4              ; Input:
 472+ 6CA4              ;   B = Riga attributi (3..18)
 473+ 6CA4              ;   C = Colonna attributi (0..31)
 474+ 6CA4              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 475+ 6CA4              ;   E = Attributo colore
 476+ 6CA4              ;
 477+ 6CA4              ; Output:
 478+ 6CA4              ;   Nessuno
 479+ 6CA4              ;
 480+ 6CA4              ; Registri preservati:
 481+ 6CA4              ;   BC, DE, HL
 482+ 6CA4              ; -------------------------------------------------------------------
 483+ 6CA4              DrawItemGraphic:
 484+ 6CA4
 485+ 6CA4                  ; Salva i registri originali
 486+ 6CA4 C5               push bc
 487+ 6CA5 D5               push de
 488+ 6CA6 E5               push hl
 489+ 6CA7
 490+ 6CA7                  ; ---------------------------------------------------------------
 491+ 6CA7                  ; Calcolo indirizzo bitmap dello Spectrum
 492+ 6CA7                  ;
 493+ 6CA7                  ; Ogni item occupa una cella attributi (8x8 pixel).
 494+ 6CA7                  ;
 495+ 6CA7                  ; Formula:
 496+ 6CA7                  ;   High = $40 + (Row AND $18)
 497+ 6CA7                  ;   Low  = (Row AND 7) * 32 + Col
 498+ 6CA7                  ;
 499+ 6CA7                  ; DE conterrà l'indirizzo della prima scanline.
 500+ 6CA7                  ; ---------------------------------------------------------------
 501+ 6CA7
 502+ 6CA7 78               ld   a, b
 503+ 6CA8 E6 18            and  $18
 504+ 6CAA C6 40            add  a, $40
 505+ 6CAC 57               ld   d, a              ; Byte alto indirizzo video
 506+ 6CAD
 507+ 6CAD 78               ld   a, b
 508+ 6CAE E6 07            and  7                 ; Riga interna al blocco da 8
 509+ 6CB0
 510+ 6CB0 87               add  a, a              ; *2
 511+ 6CB1 87               add  a, a              ; *4
 512+ 6CB2 87               add  a, a              ; *8
 513+ 6CB3 87               add  a, a              ; *16
 514+ 6CB4 87               add  a, a              ; *32
 515+ 6CB5
 516+ 6CB5 81               add  a, c              ; + colonna
 517+ 6CB6
 518+ 6CB6 5F               ld   e, a              ; Byte basso indirizzo video
 519+ 6CB7
 520+ 6CB7                  ; ---------------------------------------------------------------
 521+ 6CB7                  ; Disegno bitmap
 522+ 6CB7                  ;
 523+ 6CB7                  ; Copia 8 byte consecutivi nella memoria video.
 524+ 6CB7                  ; Ogni byte rappresenta una scanline da 8 pixel.
 525+ 6CB7                  ; ---------------------------------------------------------------
 526+ 6CB7
 527+ 6CB7 C5               push bc                ; Conserva Row e Col
 528+ 6CB8
 529+ 6CB8 06 08            ld   b, 8              ; Numero scanline
 530+ 6CBA
 531+ 6CBA              .line_loop:
 532+ 6CBA
 533+ 6CBA 7E               ld   a, (hl)           ; Legge scanline bitmap
 534+ 6CBB 12               ld   (de), a           ; Scrive nella memoria video
 535+ 6CBC
 536+ 6CBC 14               inc  d                 ; Scanline successiva
 537+ 6CBD 23               inc  hl                ; Byte bitmap successivo
 538+ 6CBE
 539+ 6CBE 05               dec  b
 540+ 6CBF 20 F9            jr   nz, .line_loop
 541+ 6CC1
 542+ 6CC1 C1               pop  bc                ; Ripristina Row e Col
 543+ 6CC2
 544+ 6CC2                  ; ---------------------------------------------------------------
 545+ 6CC2                  ; Calcolo indirizzo attributo
 546+ 6CC2                  ;
 547+ 6CC2                  ; Formula:
 548+ 6CC2                  ;   AttrAddr = $5800 + Row * 32 + Col
 549+ 6CC2                  ;
 550+ 6CC2                  ; HL conterrà l'indirizzo della cella attributi.
 551+ 6CC2                  ; ---------------------------------------------------------------
 552+ 6CC2
 553+ 6CC2 26 00            ld   h, 0
 554+ 6CC4 68               ld   l, b              ; HL = Row
 555+ 6CC5
 556+ 6CC5 29               add  hl, hl            ; *2
 557+ 6CC6 29               add  hl, hl            ; *4
 558+ 6CC7 29               add  hl, hl            ; *8
 559+ 6CC8 29               add  hl, hl            ; *16
 560+ 6CC9 29               add  hl, hl            ; *32
 561+ 6CCA
 562+ 6CCA 79               ld   a, c              ; A = Colonna
 563+ 6CCB
 564+ 6CCB 85               add  a, l
 565+ 6CCC 6F               ld   l, a
 566+ 6CCD
 567+ 6CCD 30 01            jr   nc, .no_carry
 568+ 6CCF 24               inc  h
 569+ 6CD0
 570+ 6CD0              .no_carry:
 571+ 6CD0
 572+ 6CD0                  ; HL = Row * 32 + Col
 573+ 6CD0
 574+ 6CD0 11 00 58         ld   de, $5800
 575+ 6CD3 19               add  hl, de            ; HL = indirizzo attributi
 576+ 6CD4
 577+ 6CD4                  ; ---------------------------------------------------------------
 578+ 6CD4                  ; Recupera il colore originale dallo stack.
 579+ 6CD4                  ;
 580+ 6CD4                  ; Layout stack:
 581+ 6CD4                  ;   HL originale
 582+ 6CD4                  ;   DE originale (E = colore)
 583+ 6CD4                  ;   BC originale
 584+ 6CD4                  ; ---------------------------------------------------------------
 585+ 6CD4
 586+ 6CD4 C1               pop  bc                ; Recupera HL originale
 587+ 6CD5 D1               pop  de                ; Recupera DE originale
 588+ 6CD6
 589+ 6CD6                  ; ---------------------------------------------------------------
 590+ 6CD6                  ; Scrive l'attributo colore
 591+ 6CD6                  ; ---------------------------------------------------------------
 592+ 6CD6
 593+ 6CD6 7B               ld   a, e              ; A = colore
 594+ 6CD7 77               ld   (hl), a           ; Scrive nella RAM attributi
 595+ 6CD8
 596+ 6CD8                  ; ---------------------------------------------------------------
 597+ 6CD8                  ; Ripristina HL e BC originali
 598+ 6CD8                  ; ---------------------------------------------------------------
 599+ 6CD8
 600+ 6CD8 C5               push bc
 601+ 6CD9 E1               pop  hl                ; HL originale
 602+ 6CDA
 603+ 6CDA C1               pop  bc                ; BC originale
 604+ 6CDB
 605+ 6CDB C9               ret
 606+ 6CDC
 607+ 6CDC              ; -------------------------------------------------------------------
 608+ 6CDC              ; RestoreBackgroundCell
 609+ 6CDC              ;
 610+ 6CDC              ; Ripristina il contenuto originale di una cella della stanza.
 611+ 6CDC              ; Viene utilizzata principalmente quando un item viene raccolto:
 612+ 6CDC              ; invece di lasciare un "buco", la routine ridisegna il tile
 613+ 6CDC              ; originale presente nella mappa della stanza.
 614+ 6CDC              ;
 615+ 6CDC              ; Input:
 616+ 6CDC              ;   B = Row (3..18)
 617+ 6CDC              ;   C = Col (0..31)
 618+ 6CDC              ;
 619+ 6CDC              ; Utilizza:
 620+ 6CDC              ;   room_ptr -> struttura dati della stanza corrente
 621+ 6CDC              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 622+ 6CDC              ;   DrawTile -> ridisegna il tile selezionato
 623+ 6CDC              ;
 624+ 6CDC              ; Tipi di cella:
 625+ 6CDC              ;   0 = Background
 626+ 6CDC              ;   1 = Floor
 627+ 6CDC              ;   2 = Wall
 628+ 6CDC              ;   3 = Nasty
 629+ 6CDC              ; -------------------------------------------------------------------
 630+ 6CDC              RestoreBackgroundCell:
 631+ 6CDC
 632+ 6CDC                  ; Salva tutti i registri utilizzati
 633+ 6CDC FD E5            push iy
 634+ 6CDE C5               push bc
 635+ 6CDF D5               push de
 636+ 6CE0 E5               push hl
 637+ 6CE1 DD E5            push ix
 638+ 6CE3
 639+ 6CE3                  ; ---------------------------------------------------------------
 640+ 6CE3                  ; Conserva Row e Col in IY.
 641+ 6CE3                  ;
 642+ 6CE3                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 643+ 6CE3                  ; BC potrebbe essere modificato.
 644+ 6CE3                  ; ---------------------------------------------------------------
 645+ 6CE3 C5               push bc
 646+ 6CE4 FD E1            pop  iy                ; IYH = Row, IYL = Col
 647+ 6CE6
 648+ 6CE6                  ; ---------------------------------------------------------------
 649+ 6CE6                  ; Determina quale tipo di cella è presente nella posizione
 650+ 6CE6                  ; specificata.
 651+ 6CE6                  ;
 652+ 6CE6                  ; Input:
 653+ 6CE6                  ;   B = Row
 654+ 6CE6                  ;   C = Col
 655+ 6CE6                  ;
 656+ 6CE6                  ; Output:
 657+ 6CE6                  ;   A = tipo cella
 658+ 6CE6                  ; ---------------------------------------------------------------
 659+ 6CE6 78               ld   a, b
 660+ 6CE7
 661+ 6CE7 CD 1E 68         call GetCellFromUnpacked
 662+ 6CEA
 663+ 6CEA                  ; ---------------------------------------------------------------
 664+ 6CEA                  ; Recupera il puntatore alla stanza corrente.
 665+ 6CEA                  ;
 666+ 6CEA                  ; DE = base della struttura stanza
 667+ 6CEA                  ; ---------------------------------------------------------------
 668+ 6CEA ED 5B AD 7D      ld   de, (room_ptr)
 669+ 6CEE
 670+ 6CEE                  ; ---------------------------------------------------------------
 671+ 6CEE                  ; Seleziona il tile corretto in base al tipo di cella.
 672+ 6CEE                  ;
 673+ 6CEE                  ; A = 0 -> Background
 674+ 6CEE                  ; A = 1 -> Floor
 675+ 6CEE                  ; A = 2 -> Wall
 676+ 6CEE                  ; A = 3 -> Nasty
 677+ 6CEE                  ; ---------------------------------------------------------------
 678+ 6CEE
 679+ 6CEE B7               or   a
 680+ 6CEF 20 06            jr   nz, .not_bg
 681+ 6CF1
 682+ 6CF1                  ; Background
 683+ 6CF1 21 A0 00         ld   hl, OFFSET_BG
 684+ 6CF4 19               add  hl, de
 685+ 6CF5 18 16            jr   .draw_cell
 686+ 6CF7
 687+ 6CF7              .not_bg:
 688+ 6CF7
 689+ 6CF7 3D               dec  a
 690+ 6CF8 20 06            jr   nz, .not_floor
 691+ 6CFA
 692+ 6CFA                  ; Floor
 693+ 6CFA 21 A9 00         ld   hl, OFFSET_FLOOR
 694+ 6CFD 19               add  hl, de
 695+ 6CFE 18 0D            jr   .draw_cell
 696+ 6D00
 697+ 6D00              .not_floor:
 698+ 6D00
 699+ 6D00 3D               dec  a
 700+ 6D01 20 06            jr   nz, .not_wall
 701+ 6D03
 702+ 6D03                  ; Wall
 703+ 6D03 21 B2 00         ld   hl, OFFSET_WALL
 704+ 6D06 19               add  hl, de
 705+ 6D07 18 04            jr   .draw_cell
 706+ 6D09
 707+ 6D09              .not_wall:
 708+ 6D09
 709+ 6D09                  ; Nasty
 710+ 6D09 21 BB 00         ld   hl, OFFSET_NASTY
 711+ 6D0C 19               add  hl, de
 712+ 6D0D
 713+ 6D0D              .draw_cell:
 714+ 6D0D
 715+ 6D0D                  ; ---------------------------------------------------------------
 716+ 6D0D                  ; HL punta ora alla grafica del tile da ridisegnare.
 717+ 6D0D                  ;
 718+ 6D0D                  ; DrawTile si aspetta:
 719+ 6D0D                  ;   IX = puntatore tile
 720+ 6D0D                  ;   B  = Row
 721+ 6D0D                  ;   C  = Col
 722+ 6D0D                  ; ---------------------------------------------------------------
 723+ 6D0D E5               push hl
 724+ 6D0E DD E1            pop  ix
 725+ 6D10
 726+ 6D10                  ; Ripristina Row e Col salvati in IY
 727+ 6D10 FD E5            push iy
 728+ 6D12 C1               pop  bc
 729+ 6D13
 730+ 6D13                  ; Disegna il tile originale
 731+ 6D13 CD 8C 61         call DrawTile
 732+ 6D16
 733+ 6D16                  ; ---------------------------------------------------------------
 734+ 6D16                  ; Ripristina i registri salvati
 735+ 6D16                  ; ---------------------------------------------------------------
 736+ 6D16 DD E1            pop  ix
 737+ 6D18 E1               pop  hl
 738+ 6D19 D1               pop  de
 739+ 6D1A C1               pop  bc
 740+ 6D1B FD E1            pop  iy
 741+ 6D1D
 742+ 6D1D C9               ret
 743+ 6D1E
 744+ 6D1E              ; -------------------------------------------------------------------
 745+ 6D1E              ; CheckWillyItemCollision
 746+ 6D1E              ;
 747+ 6D1E              ; Verifica se Willy collide con un item utilizzando il controllo
 748+ 6D1E              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 749+ 6D1E              ;
 750+ 6D1E              ; Input:
 751+ 6D1E              ;   A = ItemX (colonna attributi 0..31)
 752+ 6D1E              ;   H = ItemY (riga attributi 3..18)
 753+ 6D1E              ;
 754+ 6D1E              ; Coordinate item:
 755+ 6D1E              ;   Ogni item occupa una cella da 8x8 pixel.
 756+ 6D1E              ;
 757+ 6D1E              ; Coordinate Willy:
 758+ 6D1E              ;   Willy occupa un rettangolo di 16x16 pixel.
 759+ 6D1E              ;
 760+ 6D1E              ; Output:
 761+ 6D1E              ;   Carry Set   = collisione rilevata
 762+ 6D1E              ;   Carry Clear = nessuna collisione
 763+ 6D1E              ;
 764+ 6D1E              ; Registri preservati:
 765+ 6D1E              ;   BC, DE, HL
 766+ 6D1E              ; -------------------------------------------------------------------
 767+ 6D1E              CheckWillyItemCollision:
 768+ 6D1E
 769+ 6D1E                  ; Salva i registri utilizzati
 770+ 6D1E C5               push bc
 771+ 6D1F D5               push de
 772+ 6D20 E5               push hl
 773+ 6D21
 774+ 6D21                  ; ---------------------------------------------------------------
 775+ 6D21                  ; Calcola il bounding box orizzontale dell'item
 776+ 6D21                  ;
 777+ 6D21                  ; ItemLeft  = ItemX * 8
 778+ 6D21                  ; ItemRight = ItemLeft + 7
 779+ 6D21                  ;
 780+ 6D21                  ; E = ItemLeft
 781+ 6D21                  ; D = ItemRight
 782+ 6D21                  ; ---------------------------------------------------------------
 783+ 6D21 6F               ld   l, a              ; L = ItemX
 784+ 6D22
 785+ 6D22 7D               ld   a, l
 786+ 6D23 87               add  a, a              ; *2
 787+ 6D24 87               add  a, a              ; *4
 788+ 6D25 87               add  a, a              ; *8
 789+ 6D26
 790+ 6D26 5F               ld   e, a              ; E = ItemLeft
 791+ 6D27
 792+ 6D27 C6 07            add  a, 7
 793+ 6D29 57               ld   d, a              ; D = ItemRight
 794+ 6D2A
 795+ 6D2A                  ; ---------------------------------------------------------------
 796+ 6D2A                  ; Recupera la posizione corrente di Willy
 797+ 6D2A                  ;
 798+ 6D2A                  ; B = WillyY
 799+ 6D2A                  ; C = WillyX
 800+ 6D2A                  ; ---------------------------------------------------------------
 801+ 6D2A ED 4B 3F 7A      ld   bc, (PlayerPos)
 802+ 6D2E
 803+ 6D2E                  ; ---------------------------------------------------------------
 804+ 6D2E                  ; Primo test:
 805+ 6D2E                  ;
 806+ 6D2E                  ; WillyLeft <= ItemRight
 807+ 6D2E                  ;
 808+ 6D2E                  ; Se Willy è completamente a destra dell'item
 809+ 6D2E                  ; non può esserci collisione.
 810+ 6D2E                  ; ---------------------------------------------------------------
 811+ 6D2E 79               ld   a, c              ; A = WillyLeft
 812+ 6D2F
 813+ 6D2F BA               cp   d                 ; WillyLeft vs ItemRight
 814+ 6D30
 815+ 6D30 28 04            jr   z, .x_ok
 816+ 6D32 38 02            jr   c, .x_ok
 817+ 6D34
 818+ 6D34 18 29            jr   .no_collision
 819+ 6D36
 820+ 6D36              .x_ok:
 821+ 6D36
 822+ 6D36                  ; ---------------------------------------------------------------
 823+ 6D36                  ; Secondo test:
 824+ 6D36                  ;
 825+ 6D36                  ; WillyRight >= ItemLeft
 826+ 6D36                  ;
 827+ 6D36                  ; WillyRight = WillyX + 7
 828+ 6D36                  ; ---------------------------------------------------------------
 829+ 6D36 C6 07            add  a, 7
 830+ 6D38
 831+ 6D38 BB               cp   e                 ; WillyRight vs ItemLeft
 832+ 6D39
 833+ 6D39 28 04            jr   z, .y_check
 834+ 6D3B 30 02            jr   nc, .y_check
 835+ 6D3D
 836+ 6D3D 18 20            jr   .no_collision
 837+ 6D3F
 838+ 6D3F              .y_check:
 839+ 6D3F
 840+ 6D3F                  ; ---------------------------------------------------------------
 841+ 6D3F                  ; Recupera ItemY dal valore originale di HL
 842+ 6D3F                  ;
 843+ 6D3F                  ; H contiene la riga dell'item.
 844+ 6D3F                  ; ---------------------------------------------------------------
 845+ 6D3F E1               pop  hl
 846+ 6D40 E5               push hl
 847+ 6D41
 848+ 6D41                  ; ---------------------------------------------------------------
 849+ 6D41                  ; Calcola il bounding box verticale dell'item
 850+ 6D41                  ;
 851+ 6D41                  ; ItemTop    = ItemY * 8
 852+ 6D41                  ; ItemBottom = ItemTop + 7
 853+ 6D41                  ;
 854+ 6D41                  ; E = ItemTop
 855+ 6D41                  ; D = ItemBottom
 856+ 6D41                  ; ---------------------------------------------------------------
 857+ 6D41 7C               ld   a, h
 858+ 6D42
 859+ 6D42 87               add  a, a              ; *2
 860+ 6D43 87               add  a, a              ; *4
 861+ 6D44 87               add  a, a              ; *8
 862+ 6D45
 863+ 6D45 5F               ld   e, a              ; ItemTop
 864+ 6D46
 865+ 6D46 C6 07            add  a, 7
 866+ 6D48 57               ld   d, a              ; ItemBottom
 867+ 6D49
 868+ 6D49                  ; ---------------------------------------------------------------
 869+ 6D49                  ; Primo test verticale:
 870+ 6D49                  ;
 871+ 6D49                  ; WillyTop <= ItemBottom
 872+ 6D49                  ; ---------------------------------------------------------------
 873+ 6D49 78               ld   a, b              ; WillyTop
 874+ 6D4A
 875+ 6D4A BA               cp   d
 876+ 6D4B
 877+ 6D4B 28 04            jr   z, .y_ok
 878+ 6D4D 38 02            jr   c, .y_ok
 879+ 6D4F
 880+ 6D4F 18 0E            jr   .no_collision
 881+ 6D51
 882+ 6D51              .y_ok:
 883+ 6D51
 884+ 6D51                  ; ---------------------------------------------------------------
 885+ 6D51                  ; Secondo test verticale:
 886+ 6D51                  ;
 887+ 6D51                  ; WillyBottom >= ItemTop
 888+ 6D51                  ;
 889+ 6D51                  ; WillyBottom = WillyY + 15
 890+ 6D51                  ; ---------------------------------------------------------------
 891+ 6D51 C6 0F            add  a, 15
 892+ 6D53
 893+ 6D53 BB               cp   e
 894+ 6D54
 895+ 6D54 28 04            jr   z, .collision
 896+ 6D56 30 02            jr   nc, .collision
 897+ 6D58
 898+ 6D58 18 05            jr   .no_collision
 899+ 6D5A
 900+ 6D5A              .collision:
 901+ 6D5A
 902+ 6D5A                  ; ---------------------------------------------------------------
 903+ 6D5A                  ; Collisione rilevata
 904+ 6D5A                  ; ---------------------------------------------------------------
 905+ 6D5A E1               pop  hl
 906+ 6D5B D1               pop  de
 907+ 6D5C C1               pop  bc
 908+ 6D5D
 909+ 6D5D 37               scf                    ; Carry = 1
 910+ 6D5E
 911+ 6D5E C9               ret
 912+ 6D5F
 913+ 6D5F              .no_collision:
 914+ 6D5F
 915+ 6D5F                  ; ---------------------------------------------------------------
 916+ 6D5F                  ; Nessuna collisione
 917+ 6D5F                  ; ---------------------------------------------------------------
 918+ 6D5F E1               pop  hl
 919+ 6D60 D1               pop  de
 920+ 6D61 C1               pop  bc
 921+ 6D62
 922+ 6D62 B7               or   a                 ; Carry = 0
 923+ 6D63
 924+ 6D63 C9               ret
 925+ 6D64
 926+ 6D64              ; -------------------------------------------------------------------
 927+ 6D64              ; CheckRoomItemsCollision
 928+ 6D64              ;
 929+ 6D64              ; Controlla se Willy entra in collisione con uno degli item
 930+ 6D64              ; attivi presenti nella stanza corrente.
 931+ 6D64              ;
 932+ 6D64              ; Per ogni item:
 933+ 6D64              ;   - verifica che appartenga alla stanza corrente
 934+ 6D64              ;   - verifica che non sia già stato raccolto
 935+ 6D64              ;   - esegue il test di collisione con Willy
 936+ 6D64              ;
 937+ 6D64              ; Se l'item viene raccolto:
 938+ 6D64              ;   - imposta il flag "collected"
 939+ 6D64              ;   - rimuove l'item dalla cache items_grid
 940+ 6D64              ;   - incrementa il contatore degli oggetti raccolti
 941+ 6D64              ;   - aggiorna l'HUD
 942+ 6D64              ;   - ripristina il tile di sfondo
 943+ 6D64              ;   - riproduce il suono di raccolta
 944+ 6D64              ;
 945+ 6D64              ; Formato record ItemsTable:
 946+ 6D64              ;   +0 RoomID
 947+ 6D64              ;   +1 X
 948+ 6D64              ;   +2 Y
 949+ 6D64              ;   +3 Color
 950+ 6D64              ;   +4 Collected
 951+ 6D64              ;
 952+ 6D64              ; Fine tabella:
 953+ 6D64              ;   RoomID = $FF
 954+ 6D64              ; -------------------------------------------------------------------
 955+ 6D64              CheckRoomItemsCollision:
 956+ 6D64
 957+ 6D64                  ; Salva i registri utilizzati
 958+ 6D64 E5               push hl
 959+ 6D65 D5               push de
 960+ 6D66 C5               push bc
 961+ 6D67
 962+ 6D67                  ; Inizio scansione della tabella degli item
 963+ 6D67 21 2F 6B         ld   hl, ItemsTable
 964+ 6D6A
 965+ 6D6A              .loop:
 966+ 6D6A
 967+ 6D6A                  ; ---------------------------------------------------------------
 968+ 6D6A                  ; Legge il Room ID dell'item corrente
 969+ 6D6A                  ; ---------------------------------------------------------------
 970+ 6D6A 7E               ld   a, (hl)
 971+ 6D6B
 972+ 6D6B                  ; $FF indica fine tabella
 973+ 6D6B FE FF            cp   $FF
 974+ 6D6D 28 4D            jr   z, .done
 975+ 6D6F
 976+ 6D6F                  ; ---------------------------------------------------------------
 977+ 6D6F                  ; Verifica se l'item appartiene alla stanza corrente
 978+ 6D6F                  ; ---------------------------------------------------------------
 979+ 6D6F 57               ld   d, a              ; D = RoomID item
 980+ 6D70
 981+ 6D70 3A 53 7D         ld   a, (current_room)
 982+ 6D73 BA               cp   d
 983+ 6D74
 984+ 6D74                  ; Se appartiene a un'altra stanza salta il record
 985+ 6D74 20 3F            jr   nz, .next_item
 986+ 6D76
 987+ 6D76                  ; ---------------------------------------------------------------
 988+ 6D76                  ; Legge coordinate e stato dell'item
 989+ 6D76                  ; ---------------------------------------------------------------
 990+ 6D76
 991+ 6D76 23               inc  hl
 992+ 6D77 4E               ld   c, (hl)           ; C = X
 993+ 6D78
 994+ 6D78 23               inc  hl
 995+ 6D79 46               ld   b, (hl)           ; B = Y
 996+ 6D7A
 997+ 6D7A 23               inc  hl                ; salta Color
 998+ 6D7B
 999+ 6D7B 23               inc  hl                ; punta a Collected
1000+ 6D7C
1001+ 6D7C 7E               ld   a, (hl)
1002+ 6D7D
1003+ 6D7D                  ; ---------------------------------------------------------------
1004+ 6D7D                  ; Item già raccolto?
1005+ 6D7D                  ; ---------------------------------------------------------------
1006+ 6D7D B7               or   a
1007+ 6D7E 20 39            jr   nz, .next_no_inc
1008+ 6D80
1009+ 6D80                  ; ---------------------------------------------------------------
1010+ 6D80                  ; Test collisione Willy ↔ Item
1011+ 6D80                  ;
1012+ 6D80                  ; Input richiesto:
1013+ 6D80                  ;   A = ItemX
1014+ 6D80                  ;   H = ItemY
1015+ 6D80                  ; ---------------------------------------------------------------
1016+ 6D80 79               ld   a, c
1017+ 6D81
1018+ 6D81 E5               push hl                ; salva puntatore al flag Collected
1019+ 6D82
1020+ 6D82 60               ld   h, b
1021+ 6D83
1022+ 6D83 CD 1E 6D         call CheckWillyItemCollision
1023+ 6D86
1024+ 6D86 E1               pop  hl
1025+ 6D87
1026+ 6D87                  ; Nessuna collisione
1027+ 6D87 30 30            jr   nc, .next_no_inc
1028+ 6D89
1029+ 6D89                  ; ===============================================================
1030+ 6D89                  ; ITEM RACCOLTO
1031+ 6D89                  ; ===============================================================
1032+ 6D89
1033+ 6D89                  ; ---------------------------------------------------------------
1034+ 6D89                  ; Marca l'item come raccolto
1035+ 6D89                  ; ---------------------------------------------------------------
1036+ 6D89 36 01            ld   (hl), 1
1037+ 6D8B
1038+ 6D8B                  ; ---------------------------------------------------------------
1039+ 6D8B                  ; Rimuove l'item dalla cache items_grid
1040+ 6D8B                  ;
1041+ 6D8B                  ; Calcolo:
1042+ 6D8B                  ;   offset = Row * 32 + Col
1043+ 6D8B                  ; ---------------------------------------------------------------
1044+ 6D8B E5               push hl
1045+ 6D8C D5               push de
1046+ 6D8D
1047+ 6D8D 26 00            ld   h, 0
1048+ 6D8F 68               ld   l, b              ; HL = Row
1049+ 6D90
1050+ 6D90 29               add  hl, hl            ; *2
1051+ 6D91 29               add  hl, hl            ; *4
1052+ 6D92 29               add  hl, hl            ; *8
1053+ 6D93 29               add  hl, hl            ; *16
1054+ 6D94 29               add  hl, hl            ; *32
1055+ 6D95
1056+ 6D95 59               ld   e, c
1057+ 6D96 16 00            ld   d, 0
1058+ 6D98
1059+ 6D98 19               add  hl, de            ; Row*32 + Col
1060+ 6D99
1061+ 6D99 11 00 90         ld   de, items_grid
1062+ 6D9C 19               add  hl, de
1063+ 6D9D
1064+ 6D9D                  ; La cella non contiene più un item
1065+ 6D9D 36 00            ld   (hl), 0
1066+ 6D9F
1067+ 6D9F D1               pop  de
1068+ 6DA0 E1               pop  hl
1069+ 6DA1
1070+ 6DA1                  ; ---------------------------------------------------------------
1071+ 6DA1                  ; Conserva il puntatore all'entry corrente
1072+ 6DA1                  ; poiché le routine successive possono alterare HL.
1073+ 6DA1                  ; ---------------------------------------------------------------
1074+ 6DA1 E5               push hl
1075+ 6DA2
1076+ 6DA2                  ; ---------------------------------------------------------------
1077+ 6DA2                  ; Aggiorna il numero di oggetti raccolti
1078+ 6DA2                  ; ---------------------------------------------------------------
1079+ 6DA2 3A 49 7A         ld   a, (items_collected)
1080+ 6DA5
1081+ 6DA5 3C               inc  a
1082+ 6DA6
1083+ 6DA6 32 49 7A         ld   (items_collected), a
1084+ 6DA9
1085+ 6DA9                  ; ---------------------------------------------------------------
1086+ 6DA9                  ; Aggiorna il contatore visualizzato a schermo
1087+ 6DA9                  ; ---------------------------------------------------------------
1088+ 6DA9 CD CB 60         call UpdateItemsCollectedDisplay
1089+ 6DAC
1090+ 6DAC                  ; ---------------------------------------------------------------
1091+ 6DAC                  ; Ripristina il tile originale della stanza
1092+ 6DAC                  ; eliminando la grafica dell'item.
1093+ 6DAC                  ;
1094+ 6DAC                  ; Input:
1095+ 6DAC                  ;   B = Row
1096+ 6DAC                  ;   C = Col
1097+ 6DAC                  ; ---------------------------------------------------------------
1098+ 6DAC CD DC 6C         call RestoreBackgroundCell
1099+ 6DAF
1100+ 6DAF                  ; ---------------------------------------------------------------
1101+ 6DAF                  ; Riproduce il suono di raccolta
1102+ 6DAF                  ; ---------------------------------------------------------------
1103+ 6DAF CD C0 6D         call PlayCollectSound
1104+ 6DB2
1105+ 6DB2                  ; Ripristina il puntatore alla tabella
1106+ 6DB2 E1               pop  hl
1107+ 6DB3
1108+ 6DB3                  ; Continua con il record successivo
1109+ 6DB3 18 04            jr   .next_no_inc
1110+ 6DB5
1111+ 6DB5              .next_item:
1112+ 6DB5
1113+ 6DB5                  ; ---------------------------------------------------------------
1114+ 6DB5                  ; Salta i campi del record:
1115+ 6DB5                  ;   X
1116+ 6DB5                  ;   Y
1117+ 6DB5                  ;   Color
1118+ 6DB5                  ;   Collected
1119+ 6DB5                  ; ---------------------------------------------------------------
1120+ 6DB5 23               inc  hl
1121+ 6DB6 23               inc  hl
1122+ 6DB7 23               inc  hl
1123+ 6DB8 23               inc  hl
1124+ 6DB9
1125+ 6DB9              .next_no_inc:
1126+ 6DB9
1127+ 6DB9                  ; ---------------------------------------------------------------
1128+ 6DB9                  ; Avanza al record successivo.
1129+ 6DB9                  ;
1130+ 6DB9                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1131+ 6DB9                  ; ---------------------------------------------------------------
1132+ 6DB9 23               inc  hl
1133+ 6DBA
1134+ 6DBA 18 AE            jr   .loop
1135+ 6DBC
1136+ 6DBC              .done:
1137+ 6DBC
1138+ 6DBC                  ; Ripristina i registri
1139+ 6DBC C1               pop  bc
1140+ 6DBD D1               pop  de
1141+ 6DBE E1               pop  hl
1142+ 6DBF
1143+ 6DBF C9               ret
1144+ 6DC0
1145+ 6DC0              ; -------------------------------------------------------------------
1146+ 6DC0              ; PlayCollectSound
1147+ 6DC0              ;
1148+ 6DC0              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1149+ 6DC0              ; dello ZX Spectrum utilizzando il port $FE.
1150+ 6DC0              ;
1151+ 6DC0              ; Il suono viene prodotto alternando ON/OFF del bit 4
1152+ 6DC0              ; (speaker) con un semplice delay software.
1153+ 6DC0              ;
1154+ 6DC0              ; Effetto risultante:
1155+ 6DC0              ;   beep breve tipo "pickup item"
1156+ 6DC0              ; -------------------------------------------------------------------
1157+ 6DC0              PlayCollectSound:
1158+ 6DC0
1159+ 6DC0                  ; Salva registri utilizzati
1160+ 6DC0 C5               push bc
1161+ 6DC1 D5               push de
1162+ 6DC2
1163+ 6DC2                  ; ---------------------------------------------------------------
1164+ 6DC2                  ; Numero di cicli del beep (durata complessiva del suono)
1165+ 6DC2                  ; ---------------------------------------------------------------
1166+ 6DC2 06 78            ld   b, 120
1167+ 6DC4
1168+ 6DC4              .sound_loop:
1169+ 6DC4
1170+ 6DC4                  ; ---------------------------------------------------------------
1171+ 6DC4                  ; SPEAKER ON
1172+ 6DC4                  ;
1173+ 6DC4                  ; Legge il colore del bordo corrente e attiva il bit 4
1174+ 6DC4                  ; per pilotare lo speaker.
1175+ 6DC4                  ; ---------------------------------------------------------------
1176+ 6DC4 3A 4B 7A         ld   a, (room_border_color)
1177+ 6DC7 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1178+ 6DC9
1179+ 6DC9 D3 FE            out  ($fe), a         ; scrive sul port ULA
1180+ 6DCB
1181+ 6DCB                  ; ---------------------------------------------------------------
1182+ 6DCB                  ; Delay (mezzo periodo)
1183+ 6DCB                  ; Loop software a consumo CPU
1184+ 6DCB                  ; ---------------------------------------------------------------
1185+ 6DCB 0E 3C            ld   c, 60
1186+ 6DCD
1187+ 6DCD              .d1:
1188+ 6DCD 0D               dec  c
1189+ 6DCE 20 FD            jr   nz, .d1
1190+ 6DD0
1191+ 6DD0                  ; ---------------------------------------------------------------
1192+ 6DD0                  ; SPEAKER OFF
1193+ 6DD0                  ;
1194+ 6DD0                  ; Mantiene il colore del bordo ma disattiva lo speaker
1195+ 6DD0                  ; ---------------------------------------------------------------
1196+ 6DD0 3A 4B 7A         ld   a, (room_border_color)
1197+ 6DD3 E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1198+ 6DD5
1199+ 6DD5 D3 FE            out  ($fe), a
1200+ 6DD7
1201+ 6DD7                  ; ---------------------------------------------------------------
1202+ 6DD7                  ; Secondo delay (mezzo periodo)
1203+ 6DD7                  ; Completa l’onda quadra
1204+ 6DD7                  ; ---------------------------------------------------------------
1205+ 6DD7 0E 3C            ld   c, 60
1206+ 6DD9
1207+ 6DD9              .d2:
1208+ 6DD9 0D               dec  c
1209+ 6DDA 20 FD            jr   nz, .d2
1210+ 6DDC
1211+ 6DDC                  ; ---------------------------------------------------------------
1212+ 6DDC                  ; Ripete fino a completare il numero di cicli
1213+ 6DDC                  ; ---------------------------------------------------------------
1214+ 6DDC 10 E6            djnz .sound_loop
1215+ 6DDE
1216+ 6DDE                  ; Ripristina registri salvati
1217+ 6DDE D1               pop  de
1218+ 6DDF C1               pop  bc
1219+ 6DE0
1220+ 6DE0 C9               ret
1221+ 6DE1
1222+ 6DE1              ; -------------------------------------------------------------------
1223+ 6DE1              ; CheckActiveItemAtCell
1224+ 6DE1              ;
1225+ 6DE1              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1226+ 6DE1              ; nella cella specificata della griglia items_grid.
1227+ 6DE1              ;
1228+ 6DE1              ; Questa routine usa una lookup diretta su una mappa 32x16,
1229+ 6DE1              ; evitando la scansione della ItemsTable.
1230+ 6DE1              ;
1231+ 6DE1              ; Input:
1232+ 6DE1              ;   B = Colonna (0..31)
1233+ 6DE1              ;   C = Riga (0..15)
1234+ 6DE1              ;
1235+ 6DE1              ; Output:
1236+ 6DE1              ;   Carry Set   = item presente nella cella
1237+ 6DE1              ;   Carry Clear = nessun item
1238+ 6DE1              ;
1239+ 6DE1              ; Nota:
1240+ 6DE1              ;   HL NON è restituito valido (commento originale non corretto:
1241+ 6DE1              ;   la routine non punta a ItemsTable).
1242+ 6DE1              ; -------------------------------------------------------------------
1243+ 6DE1              CheckActiveItemAtCell:
1244+ 6DE1
1245+ 6DE1                  ; Salva registri usati
1246+ 6DE1 D5               push de
1247+ 6DE2 E5               push hl
1248+ 6DE3
1249+ 6DE3                  ; ---------------------------------------------------------------
1250+ 6DE3                  ; Calcolo indice lineare nella griglia 32x16:
1251+ 6DE3                  ;
1252+ 6DE3                  ; offset = Row * 32 + Col
1253+ 6DE3                  ; ---------------------------------------------------------------
1254+ 6DE3 26 00            ld   h, 0
1255+ 6DE5 69               ld   l, c              ; HL = Row
1256+ 6DE6
1257+ 6DE6 29               add  hl, hl            ; *2
1258+ 6DE7 29               add  hl, hl            ; *4
1259+ 6DE8 29               add  hl, hl            ; *8
1260+ 6DE9 29               add  hl, hl            ; *16
1261+ 6DEA 29               add  hl, hl            ; *32
1262+ 6DEB
1263+ 6DEB                  ; Aggiunge la colonna
1264+ 6DEB 58               ld   e, b
1265+ 6DEC 16 00            ld   d, 0
1266+ 6DEE 19               add  hl, de            ; HL = Row*32 + Col
1267+ 6DEF
1268+ 6DEF                  ; ---------------------------------------------------------------
1269+ 6DEF                  ; Accesso alla griglia degli item attivi
1270+ 6DEF                  ; ---------------------------------------------------------------
1271+ 6DEF 11 00 90         ld   de, items_grid
1272+ 6DF2 19               add  hl, de            ; HL = address cella
1273+ 6DF3
1274+ 6DF3                  ; ---------------------------------------------------------------
1275+ 6DF3                  ; Controllo presenza item
1276+ 6DF3                  ;
1277+ 6DF3                  ; items_grid contiene:
1278+ 6DF3                  ;   0 = nessun item
1279+ 6DF3                  ;   >0 = item attivo (colore o flag)
1280+ 6DF3                  ; ---------------------------------------------------------------
1281+ 6DF3 7E               ld   a, (hl)
1282+ 6DF4 B7               or   a
1283+ 6DF5 28 04            jr   z, .not_active
1284+ 6DF7
1285+ 6DF7                  ; ---------------------------------------------------------------
1286+ 6DF7                  ; Item trovato
1287+ 6DF7                  ; ---------------------------------------------------------------
1288+ 6DF7 E1               pop  hl
1289+ 6DF8 D1               pop  de
1290+ 6DF9
1291+ 6DF9 37               scf                    ; Carry = 1
1292+ 6DFA C9               ret
1293+ 6DFB
1294+ 6DFB              .not_active:
1295+ 6DFB
1296+ 6DFB                  ; ---------------------------------------------------------------
1297+ 6DFB                  ; Nessun item nella cella
1298+ 6DFB                  ; ---------------------------------------------------------------
1299+ 6DFB E1               pop  hl
1300+ 6DFC D1               pop  de
1301+ 6DFD
1302+ 6DFD B7               or   a                 ; Carry = 0
1303+ 6DFE C9               ret
1304+ 6DFF
