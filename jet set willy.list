1108+ 6B00              .dir_right:
1109+ 6B00                  ; Rampa sale a destra (up-right)
1110+ 6B00 3A 05 76         ld   a, (ramp_col)
1111+ 6B03 87               add  a, a              ; *2
1112+ 6B04 87               add  a, a              ; *4
1113+ 6B05 87               add  a, a              ; *8 (X start in pixel)
1114+ 6B06 5F               ld   e, a              ; E = X_left
1115+ 6B07
1116+ 6B07 3A 03 76         ld   a, (ramp_len)
