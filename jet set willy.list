   7+ 6B94              ; Input_CheckCtrl
   8+ 6B94              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 6B94              ;
  10+ 6B94              ; Output:
  11+ 6B94              ;   D = bitmask tasti attivi:
  12+ 6B94              ;       bit 0 → sinistra (O)
  13+ 6B94              ;       bit 1 → destra   (P)
  14+ 6B94              ;       bit 2 → salto    (Z)
  15+ 6B94              ;
  16+ 6B94              ; Effetti collaterali in RAM:
  17+ 6B94              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 6B94              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 6B94              ;   (jump_prev)     → debounce tasto salto
  20+ 6B94              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 6B94              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 6B94              ; -------------------------------------------------------------------
  23+ 6B94
  24+ 6B94              Input_CheckCtrl:
  25+ 6B94 AF               xor  a
  26+ 6B95 32 2F EA         ld   (current_input_dir), a
  27+ 6B98
  28+ 6B98                  IF ENABLE_ROOM_SKIP_KEYS != 0
  29+ 6B98                  ; ── Sezione 1a: tasto Q (cambio stanza AVANTI) ─────────────────────
  30+ 6B98                  ;
  31+ 6B98                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  32+ 6B98                  ; Se bit 0 = 0, Q è premuto.
  33+ 6B98
  34+ 6B98 01 FE FB         ld   bc, $fbfe
  35+ 6B9B ED 78            in   a, (c)
  36+ 6B9D CB 47            bit  0, a
  37+ 6B9F 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 6BA1
  39+ 6BA1                  ; Q è premuto: debounce tramite (q_prev).
  40+ 6BA1                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 6BA1 3A 30 EA         ld   a, (q_prev)
  42+ 6BA4 B7               or   a
  43+ 6BA5 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 6BA7
  45+ 6BA7                  ; ── Primo frame di pressione di Q ──
  46+ 6BA7 3E 01            ld   a, 1
  47+ 6BA9 32 30 EA         ld   (q_prev), a            ; marca "Q era premuto"
  48+ 6BAC
  49+ 6BAC                  ; NOTA sullo stack:
  50+ 6BAC                  ; Input_CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  51+ 6BAC                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChangeNext senza
  52+ 6BAC                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  53+ 6BAC                  ; poi JP salta direttamente.
  54+ 6BAC E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  55+ 6BAD C3 5F 6C         jp   PerformRoomChangeNext  ; salta al cambio stanza avanti (non torna qui)
  56+ 6BB0
