1355+ 75AB 3A 16 EE         ld   a, (ramp_len)
1356+ 75AE B7               or   a
1357+ 75AF CA AF 76         jp   z, .no_ramp_change
1358+ 75B2
1359+ 75B2                  ; Calcola Row e Col: Offset = DE - 24064
1360+ 75B2 21 00 A2         ld   hl, -24064
1361+ 75B5 19               add  hl, de            ; HL = Offset
1362+ 75B6 54               ld   d, h
1363+ 75B7 5D               ld   e, l
1364+ 75B8
1365+ 75B8 7B               ld   a, e
1366+ 75B9 E6 1F            and  31
1367+ 75BB 32 18 EE         ld   (ramp_col), a     ; Col Start
1368+ 75BE
1369+ 75BE CB 3C            srl  h
