 885  8E44              ; -------------------------------------------------------------------
 886  8E44              ; ResetFullGameState
 887  8E44              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 888  8E44              ; per l'avvio di una nuova partita dopo il Game Over.
 889  8E44              ; -------------------------------------------------------------------
 890  8E44              ResetFullGameState:
 891  8E44                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 892  8E44 AF               xor  a
 893  8E45 D3 FE            out  ($fe), a              ; Bordo a nero
 894  8E47 21 8D 5C         ld   hl, ATTR_P
 895  8E4A 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 896  8E4B CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 897  8E4E 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 898  8E50 3E 07            ld   a, $07
 899  8E52 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 900  8E55
 901  8E55                  ; Ripristina il numero di vite iniziali
 902  8E55 3E 07            ld   a, INITIAL_LIVES
 903  8E57 32 51 F8         ld   (willy_lives), a
 904  8E5A
 905  8E5A                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 906  8E5A AF               xor  a
 907  8E5B 32 4E F8         ld   (items_collected), a
 908  8E5E 32 4A F8         ld   (body_state), a
 909  8E61 32 5D F8         ld   (w_warp_state), a
 910  8E64 32 60 F8         ld   (w_key_prev), a
 911  8E67 32 61 F8         ld   (enter_key_prev), a
 912  8E6A 32 52 F8         ld   (velocity_y), a
 913  8E6D 32 54 F8         ld   (jump_pressed), a
 914  8E70 32 56 F8         ld   (coyote_timer), a
 915  8E73 32 59 F8         ld   (jump_frame), a
 916  8E76 32 58 F8         ld   (jump_dir), a
 917  8E79 32 CA FB         ld   (transition_active), a
 918  8E7C 32 4E FC         ld   (willy_safety_timer), a
 919  8E7F 3E FF            ld   a, $ff
 920  8E81 32 62 F8         ld   (digit_key_prev), a
 921  8E84 3E 01            ld   a, 1
 922  8E86 32 5B F8         ld   (q_prev), a
 923  8E89 32 5C F8         ld   (a_prev), a
 924  8E8C 32 53 F8         ld   (on_ground), a
 925  8E8F
 926  8E8F                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 927  8E8F 3E 30            ld   a, '0'
 928  8E91 32 FB 68         ld   (status_line + 16), a
 929  8E94 32 FC 68         ld   (status_line + 17), a
 930  8E97 32 FD 68         ld   (status_line + 18), a
 931  8E9A
 932  8E9A                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 933  8E9A CD 59 86         call ResetItemsTable
 934  8E9D
 935  8E9D                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 936  8E9D CD 23 6E         call InitRoomEntryPositions
 937  8EA0
 938  8EA0                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 939  8EA0 3E 07            ld   a, 7
 940  8EA2 32 51 FC         ld   (time_hours), a
 941  8EA5 AF               xor  a
 942  8EA6 32 52 FC         ld   (time_minutes), a
 943  8EA9 32 53 FC         ld   (time_period), a       ; 0 = AM
 944  8EAC 32 56 FC         ld   (game_objective_completed), a
 945  8EAF 2A 65 F8         ld   hl, (counter)
 946  8EB2 22 54 FC         ld   (time_last_counter), hl
 947  8EB5 CD 6D 68         call Gfx_UpdateTimeDisplay
 948  8EB8
 949  8EB8                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 950  8EB8 21 FC B3         ld   hl, TheBathroomLayout; TheOffLicenceLayout
 951  8EBB 22 C4 FB         ld   (room_ptr), hl
 952  8EBE
 953  8EBE C9               ret
 954  8EBF
 955  8EBF              ; -------------------------------------------------------------------
 956  8EBF              ; Time_UpdateClock
 957  8EBF              ; Gestisce lo scorrimento del tempo durante il gioco.
 958  8EBF              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 959  8EBF              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 960  8EBF              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 961  8EBF              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 962  8EBF              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 963  8EBF              ; sia completato, scatena immediatamente il Game Over.
 964  8EBF              ; -------------------------------------------------------------------
 965  8EBF              Time_UpdateClock:
 966  8EBF                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 967  8EBF 2A 65 F8         ld   hl, (counter)
 968  8EC2 ED 5B 54 FC      ld   de, (time_last_counter)
 969  8EC6 B7               or   a
 970  8EC7 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 971  8EC9
 972  8EC9                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 973  8EC9 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 974  8ECC B7               or   a
 975  8ECD ED 52            sbc  hl, de
 976  8ECF D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 977  8ED0
 978  8ED0                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 979  8ED0 2A 54 FC         ld   hl, (time_last_counter)
 980  8ED3 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 981  8ED6 19               add  hl, de
 982  8ED7 22 54 FC         ld   (time_last_counter), hl
 983  8EDA
 984  8EDA                  ; Incrementa di 1 minuto il tempo di gioco
 985  8EDA 3A 52 FC         ld   a, (time_minutes)
 986  8EDD 3C               inc  a
 987  8EDE FE 3C            cp   60
 988  8EE0 38 21            jr   c, .minutes_ok
 989  8EE2
 990  8EE2                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 991  8EE2 AF               xor  a
 992  8EE3 32 52 FC         ld   (time_minutes), a
 993  8EE6 3A 51 FC         ld   a, (time_hours)
 994  8EE9 3C               inc  a
 995  8EEA FE 0C            cp   12
 996  8EEC 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 997  8EEE FE 0D            cp   13
 998  8EF0 38 0E            jr   c, .hours_ok
 999  8EF2 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
1000  8EF4 18 0A            jr   .hours_ok
1001  8EF6
1002  8EF6              .toggle_period:
1003  8EF6 F5               push af                     ; Salva A (valore 12)
1004  8EF7 3A 53 FC         ld   a, (time_period)
1005  8EFA EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
1006  8EFC 32 53 FC         ld   (time_period), a
1007  8EFF F1               pop  af                     ; Ripristina A = 12
1008  8F00
1009  8F00              .hours_ok:
1010  8F00 32 51 FC         ld   (time_hours), a
1011  8F03
1012  8F03              .minutes_ok:
1013  8F03 32 52 FC         ld   (time_minutes), a
1014  8F06
1015  8F06                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
1016  8F06 CD 6D 68         call Gfx_UpdateTimeDisplay
1017  8F09
1018  8F09                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
1019  8F09 3A 56 FC         ld   a, (game_objective_completed)
1020  8F0C B7               or   a
1021  8F0D C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
1022  8F0E
1023  8F0E                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
1024  8F0E 3A 53 FC         ld   a, (time_period)
1025  8F11 B7               or   a
1026  8F12 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
1027  8F13
1028  8F13 3A 51 FC         ld   a, (time_hours)
1029  8F16 FE 0C            cp   12
1030  8F18 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1031  8F1A C9               ret
1032  8F1B
1033  8F1B              .time_limit_reached:
1034  8F1B                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
1035  8F1B                  ; Scatena immediatamente il Game Over temporale!
1036  8F1B C3 DB 8B         jp   TriggerGameOver
1037  8F1E
