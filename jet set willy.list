1070+ 8651
1071+ 8651              .set_room:
1072+ 8651
1073+ 8651                  ; Salva l'ID della stanza corrente
1074+ 8651 32 BC F9         ld   (current_room), a
1075+ 8654
1076+ 8654                  ; Ripristina i registri
1077+ 8654 D1               pop  de
1078+ 8655 E1               pop  hl
1079+ 8656
1080+ 8656 C9               ret
1081+ 8657
1082+ 8657              ; -------------------------------------------------------------------
1083+ 8657              ; Items_DrawRoom
1084+ 8657              ;
1085+ 8657              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1086+ 8657              ;
1087+ 8657              ; Operazioni eseguite:
1088+ 8657              ;   1. Azzera la griglia items_grid.
1089+ 8657              ;   2. Svuota la cache degli oggetti attivi.
1090+ 8657              ;   3. Scansiona ItemsTable.
1091+ 8657              ;   4. Per ogni item della stanza corrente:
1092+ 8657              ;        - verifica se è già stato raccolto
1093+ 8657              ;        - disegna la grafica
1094+ 8657              ;        - aggiorna items_grid
1095+ 8657              ;        - memorizza l'item nella cache current_room_items
1096+ 8657              ;   5. Aggiorna num_room_items.
1097+ 8657              ;
1098+ 8657              ; Record ItemsTable:
1099+ 8657              ;   +0  Room ID
1100+ 8657              ;   +1  X (colonna)
1101+ 8657              ;   +2  Y (riga)
1102+ 8657              ;   +3  Colore
1103+ 8657              ;   +4  Collected flag
1104+ 8657              ;
1105+ 8657              ; Cache current_room_items:
1106+ 8657              ;   +0  Colonna
1107+ 8657              ;   +1  Riga
1108+ 8657              ;   +2  Colore
1109+ 8657              ;   +3  Collected flag ptr (Low)
1110+ 8657              ;   +4  Collected flag ptr (High)
1111+ 8657              ;
1112+ 8657              ; Ogni record cache occupa 5 byte.
1113+ 8657              ; -------------------------------------------------------------------
1114+ 8657              ; ResetItemsTable
1115+ 8657              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1116+ 8657              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1117+ 8657              ; -------------------------------------------------------------------
1118+ 8657              ResetItemsTable:
1119+ 8657 21 FB 80         ld   hl, ItemsTable
1120+ 865A              .reset_loop:
1121+ 865A 7E               ld   a, (hl)
1122+ 865B FE FF            cp   $FF
1123+ 865D C8               ret  z
1124+ 865E 23               inc  hl                        ; +1 (X)
1125+ 865F 23               inc  hl                        ; +2 (Y)
1126+ 8660 23               inc  hl                        ; +3 (Color)
1127+ 8661 23               inc  hl                        ; +4 (Collected flag)
1128+ 8662 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1129+ 8664 23               inc  hl                        ; Prossimo record
1130+ 8665 18 F3            jr   .reset_loop
1131+ 8667
1132+ 8667              ; -------------------------------------------------------------------
1133+ 8667              Items_DrawRoom:
1134+ 8667
1135+ 8667                  ; Salva tutti i registri utilizzati
1136+ 8667 E5               push hl
1137+ 8668 D5               push de
1138+ 8669 C5               push bc
1139+ 866A DD E5            push ix
1140+ 866C FD E5            push iy
1141+ 866E
1142+ 866E                  ; ---------------------------------------------------------------
1143+ 866E                  ; Azzera items_grid (32 x 16 = 512 byte)
1144+ 866E                  ; ---------------------------------------------------------------
1145+ 866E 21 96 F4         ld   hl, items_grid
1146+ 8671 11 97 F4         ld   de, items_grid + 1
1147+ 8674 36 00            ld   (hl), 0
1148+ 8676 01 FF 01         ld   bc, 511
1149+ 8679 ED B0            ldir
1150+ 867B
1151+ 867B                  ; ---------------------------------------------------------------
1152+ 867B                  ; Nessun item attivo nella stanza
1153+ 867B                  ; ---------------------------------------------------------------
1154+ 867B AF               xor  a
1155+ 867C 32 15 FA         ld   (num_room_items), a
1156+ 867F
1157+ 867F                  ; IY punta alla cache degli item attivi
1158+ 867F FD 21 C5 F9      ld   iy, current_room_items
1159+ 8683
1160+ 8683                  ; ---------------------------------------------------------------
1161+ 8683                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1162+ 8683                  ; alla stanza corrente.
1163+ 8683                  ;
1164+ 8683                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1165+ 8683                  ; ---------------------------------------------------------------
1166+ 8683 2A 16 FA         ld   hl, (room_ptr)
1167+ 8686 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1168+ 8689 19               add  hl, de
1169+ 868A
1170+ 868A E5               push hl
1171+ 868B DD E1            pop  ix                ; IX = bitmap item
1172+ 868D
1173+ 868D                  ; ---------------------------------------------------------------
1174+ 868D                  ; Inizio scansione della tabella degli item
1175+ 868D                  ; ---------------------------------------------------------------
1176+ 868D 21 FB 80         ld   hl, ItemsTable
1177+ 8690
1178+ 8690              .loop:
1179+ 8690
1180+ 8690                  ; ---------------------------------------------------------------
1181+ 8690                  ; Legge il Room ID del record corrente
1182+ 8690                  ; ---------------------------------------------------------------
1183+ 8690 7E               ld   a, (hl)
1184+ 8691
1185+ 8691                  ; $FF indica fine tabella
1186+ 8691 FE FF            cp   $FF
1187+ 8693 28 53            jr   z, .done
1188+ 8695
1189+ 8695                  ; ---------------------------------------------------------------
1190+ 8695                  ; Verifica se l'item appartiene alla stanza corrente
1191+ 8695                  ; ---------------------------------------------------------------
1192+ 8695 57               ld   d, a
1193+ 8696
1194+ 8696 3A BC F9         ld   a, (current_room)
1195+ 8699 BA               cp   d
1196+ 869A 20 45            jr   nz, .next_item
1197+ 869C
1198+ 869C                  ; ---------------------------------------------------------------
1199+ 869C                  ; Legge i dati dell'item
1200+ 869C                  ; ---------------------------------------------------------------
1201+ 869C
1202+ 869C 23               inc  hl
1203+ 869D 4E               ld   c, (hl)           ; X (colonna)
1204+ 869E
1205+ 869E 23               inc  hl
1206+ 869F 46               ld   b, (hl)           ; Y (riga)
1207+ 86A0
1208+ 86A0 23               inc  hl
1209+ 86A1 5E               ld   e, (hl)           ; Colore
1210+ 86A2
1211+ 86A2 23               inc  hl
1212+ 86A3 7E               ld   a, (hl)           ; Collected flag
1213+ 86A4
1214+ 86A4                  ; Se diverso da zero l'item è già stato raccolto
1215+ 86A4 B7               or   a
1216+ 86A5 20 3E            jr   nz, .next_no_inc
1217+ 86A7
1218+ 86A7                  ; ---------------------------------------------------------------
1219+ 86A7                  ; Disegna l'item sullo schermo
1220+ 86A7                  ;
1221+ 86A7                  ; B = Row
1222+ 86A7                  ; C = Column
1223+ 86A7                  ; HL = bitmap pointer
1224+ 86A7                  ; E = Color
1225+ 86A7                  ; ---------------------------------------------------------------
1226+ 86A7 E5               push hl
1227+ 86A8
1228+ 86A8 DD E5            push ix
1229+ 86AA E1               pop  hl
1230+ 86AB
1231+ 86AB CD F0 86         call DrawItemGraphic
1232+ 86AE
1233+ 86AE E1               pop  hl                ; ritorna al flag collected
1234+ 86AF
1235+ 86AF                  ; ---------------------------------------------------------------
1236+ 86AF                  ; Aggiorna items_grid
1237+ 86AF                  ;
1238+ 86AF                  ; Calcolo:
1239+ 86AF                  ;   offset = Row * 32 + Col
1240+ 86AF                  ; ---------------------------------------------------------------
1241+ 86AF E5               push hl
1242+ 86B0 D5               push de
1243+ 86B1
1244+ 86B1 26 00            ld   h, 0
1245+ 86B3 68               ld   l, b              ; HL = Row
1246+ 86B4
1247+ 86B4 29               add  hl, hl            ; *2
1248+ 86B5 29               add  hl, hl            ; *4
1249+ 86B6 29               add  hl, hl            ; *8
1250+ 86B7 29               add  hl, hl            ; *16
1251+ 86B8 29               add  hl, hl            ; *32
1252+ 86B9
1253+ 86B9 16 00            ld   d, 0
1254+ 86BB 59               ld   e, c              ; DE = Col
1255+ 86BC
1256+ 86BC 19               add  hl, de            ; Row*32 + Col
1257+ 86BD
1258+ 86BD 11 96 F4         ld   de, items_grid
1259+ 86C0 19               add  hl, de            ; puntatore nella griglia
1260+ 86C1
1261+ 86C1 D1               pop  de                ; ripristina colore
1262+ 86C2
1263+ 86C2 73               ld   (hl), e           ; salva colore cella
1264+ 86C3
1265+ 86C3 E1               pop  hl
1266+ 86C4
1267+ 86C4                  ; ---------------------------------------------------------------
1268+ 86C4                  ; Salva l'item nella cache della stanza
1269+ 86C4                  ;
1270+ 86C4                  ; Questo evita di dover scansionare tutta ItemsTable
1271+ 86C4                  ; durante il controllo delle collisioni.
1272+ 86C4                  ; ---------------------------------------------------------------
1273+ 86C4
1274+ 86C4 FD 71 00         ld   (iy+0), c         ; Colonna
1275+ 86C7 FD 70 01         ld   (iy+1), b         ; Riga
1276+ 86CA FD 73 02         ld   (iy+2), e         ; Colore
1277+ 86CD
1278+ 86CD                  ; Salva il puntatore al flag "collected"
1279+ 86CD FD 75 03         ld   (iy+3), l         ; Low byte
1280+ 86D0 FD 74 04         ld   (iy+4), h         ; High byte
1281+ 86D3
1282+ 86D3                  ; Passa al record successivo della cache
1283+ 86D3 01 05 00         ld   bc, 5
1284+ 86D6 FD 09            add  iy, bc
1285+ 86D8
1286+ 86D8                  ; Incrementa il numero di item attivi
1287+ 86D8 3A 15 FA         ld   a, (num_room_items)
1288+ 86DB 3C               inc  a
1289+ 86DC 32 15 FA         ld   (num_room_items), a
1290+ 86DF
1291+ 86DF 18 04            jr   .next_no_inc
1292+ 86E1
1293+ 86E1              .next_item:
1294+ 86E1
1295+ 86E1                  ; ---------------------------------------------------------------
1296+ 86E1                  ; L'item non appartiene alla stanza corrente.
1297+ 86E1                  ; Salta i campi del record:
1298+ 86E1                  ;   X
1299+ 86E1                  ;   Y
1300+ 86E1                  ;   Color
1301+ 86E1                  ;   Collected
1302+ 86E1                  ; ---------------------------------------------------------------
1303+ 86E1 23               inc  hl
1304+ 86E2 23               inc  hl
1305+ 86E3 23               inc  hl
1306+ 86E4 23               inc  hl
1307+ 86E5
1308+ 86E5              .next_no_inc:
1309+ 86E5
1310+ 86E5                  ; ---------------------------------------------------------------
1311+ 86E5                  ; Avanza al record successivo
1312+ 86E5                  ; (prossimo Room ID)
1313+ 86E5                  ; ---------------------------------------------------------------
1314+ 86E5 23               inc  hl
1315+ 86E6 18 A8            jr   .loop
1316+ 86E8
1317+ 86E8              .done:
1318+ 86E8
1319+ 86E8                  ; Ripristina i registri
1320+ 86E8 FD E1            pop  iy
1321+ 86EA DD E1            pop  ix
1322+ 86EC D1               pop  de
1323+ 86ED C1               pop  bc
1324+ 86EE E1               pop  hl
1325+ 86EF
1326+ 86EF C9               ret
1327+ 86F0
1328+ 86F0              ; -------------------------------------------------------------------
1329+ 86F0              ; DrawItemGraphic
1330+ 86F0              ;
1331+ 86F0              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1332+ 86F0              ; utilizzando una bitmap di 8 byte e un attributo colore.
1333+ 86F0              ;
1334+ 86F0              ; Input:
1335+ 86F0              ;   B = Riga attributi (3..18)
1336+ 86F0              ;   C = Colonna attributi (0..31)
1337+ 86F0              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1338+ 86F0              ;   E = Attributo colore
1339+ 86F0              ;
1340+ 86F0              ; Output:
1341+ 86F0              ;   Nessuno
1342+ 86F0              ;
1343+ 86F0              ; Registri preservati:
1344+ 86F0              ;   BC, DE, HL
1345+ 86F0              ; -------------------------------------------------------------------
1346+ 86F0              DrawItemGraphic:
1347+ 86F0
1348+ 86F0                  ; Salva i registri originali
1349+ 86F0 C5               push bc
1350+ 86F1 D5               push de
1351+ 86F2 E5               push hl
1352+ 86F3
1353+ 86F3                  ; ---------------------------------------------------------------
1354+ 86F3                  ; Calcolo indirizzo bitmap dello Spectrum
1355+ 86F3                  ;
1356+ 86F3                  ; Ogni item occupa una cella attributi (8x8 pixel).
1357+ 86F3                  ;
1358+ 86F3                  ; Formula:
1359+ 86F3                  ;   High = $40 + (Row AND $18)
1360+ 86F3                  ;   Low  = (Row AND 7) * 32 + Col
1361+ 86F3                  ;
1362+ 86F3                  ; DE conterrà l'indirizzo della prima scanline.
1363+ 86F3                  ; ---------------------------------------------------------------
1364+ 86F3
1365+ 86F3 78               ld   a, b
1366+ 86F4 E6 18            and  $18
1367+ 86F6 C6 40            add  a, $40
1368+ 86F8 57               ld   d, a              ; Byte alto indirizzo video
1369+ 86F9
1370+ 86F9 78               ld   a, b
1371+ 86FA E6 07            and  7                 ; Riga interna al blocco da 8
1372+ 86FC
1373+ 86FC 87               add  a, a              ; *2
1374+ 86FD 87               add  a, a              ; *4
1375+ 86FE 87               add  a, a              ; *8
1376+ 86FF 87               add  a, a              ; *16
1377+ 8700 87               add  a, a              ; *32
1378+ 8701
1379+ 8701 81               add  a, c              ; + colonna
1380+ 8702
1381+ 8702 5F               ld   e, a              ; Byte basso indirizzo video
1382+ 8703
1383+ 8703                  ; ---------------------------------------------------------------
1384+ 8703                  ; Disegno bitmap
1385+ 8703                  ;
1386+ 8703                  ; Copia 8 byte consecutivi nella memoria video.
1387+ 8703                  ; Ogni byte rappresenta una scanline da 8 pixel.
1388+ 8703                  ; ---------------------------------------------------------------
1389+ 8703
1390+ 8703 C5               push bc                ; Conserva Row e Col
1391+ 8704
1392+ 8704 06 08            ld   b, 8              ; Numero scanline
1393+ 8706
1394+ 8706              .line_loop:
1395+ 8706
1396+ 8706 7E               ld   a, (hl)           ; Legge scanline bitmap
1397+ 8707 12               ld   (de), a           ; Scrive nella memoria video
1398+ 8708
1399+ 8708 14               inc  d                 ; Scanline successiva
1400+ 8709 23               inc  hl                ; Byte bitmap successivo
1401+ 870A
1402+ 870A 05               dec  b
1403+ 870B 20 F9            jr   nz, .line_loop
1404+ 870D
1405+ 870D C1               pop  bc                ; Ripristina Row e Col
1406+ 870E
1407+ 870E                  ; ---------------------------------------------------------------
1408+ 870E                  ; Calcolo indirizzo attributo
1409+ 870E                  ;
1410+ 870E                  ; Formula:
1411+ 870E                  ;   AttrAddr = $5800 + Row * 32 + Col
1412+ 870E                  ;
1413+ 870E                  ; HL conterrà l'indirizzo della cella attributi.
1414+ 870E                  ; ---------------------------------------------------------------
1415+ 870E
1416+ 870E 26 00            ld   h, 0
1417+ 8710 68               ld   l, b              ; HL = Row
1418+ 8711
1419+ 8711 29               add  hl, hl            ; *2
1420+ 8712 29               add  hl, hl            ; *4
1421+ 8713 29               add  hl, hl            ; *8
1422+ 8714 29               add  hl, hl            ; *16
1423+ 8715 29               add  hl, hl            ; *32
1424+ 8716
1425+ 8716 79               ld   a, c              ; A = Colonna
1426+ 8717
1427+ 8717 85               add  a, l
1428+ 8718 6F               ld   l, a
1429+ 8719
1430+ 8719 30 01            jr   nc, .no_carry
1431+ 871B 24               inc  h
1432+ 871C
1433+ 871C              .no_carry:
1434+ 871C
1435+ 871C                  ; HL = Row * 32 + Col
1436+ 871C
1437+ 871C 11 00 58         ld   de, $5800
1438+ 871F 19               add  hl, de            ; HL = indirizzo attributi
1439+ 8720
1440+ 8720                  ; ---------------------------------------------------------------
1441+ 8720                  ; Recupera il colore originale dallo stack.
1442+ 8720                  ;
1443+ 8720                  ; Layout stack:
1444+ 8720                  ;   HL originale
1445+ 8720                  ;   DE originale (E = colore)
1446+ 8720                  ;   BC originale
1447+ 8720                  ; ---------------------------------------------------------------
1448+ 8720
1449+ 8720 C1               pop  bc                ; Recupera HL originale
1450+ 8721 D1               pop  de                ; Recupera DE originale
1451+ 8722
1452+ 8722                  ; ---------------------------------------------------------------
1453+ 8722                  ; Scrive l'attributo colore
1454+ 8722                  ; ---------------------------------------------------------------
1455+ 8722
1456+ 8722 7B               ld   a, e              ; A = colore
1457+ 8723 77               ld   (hl), a           ; Scrive nella RAM attributi
1458+ 8724
1459+ 8724                  ; ---------------------------------------------------------------
1460+ 8724                  ; Ripristina HL e BC originali
1461+ 8724                  ; ---------------------------------------------------------------
1462+ 8724
1463+ 8724 C5               push bc
1464+ 8725 E1               pop  hl                ; HL originale
1465+ 8726
1466+ 8726 C1               pop  bc                ; BC originale
1467+ 8727
1468+ 8727 C9               ret
1469+ 8728
1470+ 8728              ; -------------------------------------------------------------------
1471+ 8728              ; RestoreBackgroundCell
1472+ 8728              ;
1473+ 8728              ; Ripristina il contenuto originale di una cella della stanza.
1474+ 8728              ; Viene utilizzata principalmente quando un item viene raccolto:
1475+ 8728              ; invece di lasciare un "buco", la routine ridisegna il tile
1476+ 8728              ; originale presente nella mappa della stanza.
1477+ 8728              ;
1478+ 8728              ; Input:
1479+ 8728              ;   B = Row (3..18)
1480+ 8728              ;   C = Col (0..31)
1481+ 8728              ;
1482+ 8728              ; Utilizza:
1483+ 8728              ;   room_ptr -> struttura dati della stanza corrente
1484+ 8728              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1485+ 8728              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1486+ 8728              ;
1487+ 8728              ; Tipi di cella:
1488+ 8728              ;   0 = Background
1489+ 8728              ;   1 = Floor
1490+ 8728              ;   2 = Wall
1491+ 8728              ;   3 = Nasty
1492+ 8728              ; -------------------------------------------------------------------
1493+ 8728              RestoreBackgroundCell:
1494+ 8728
1495+ 8728                  ; Salva tutti i registri utilizzati
1496+ 8728 FD E5            push iy
1497+ 872A C5               push bc
1498+ 872B D5               push de
1499+ 872C E5               push hl
1500+ 872D DD E5            push ix
1501+ 872F
1502+ 872F                  ; ---------------------------------------------------------------
1503+ 872F                  ; Conserva Row e Col in IY.
1504+ 872F                  ;
1505+ 872F                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1506+ 872F                  ; BC potrebbe essere modificato.
1507+ 872F                  ; ---------------------------------------------------------------
1508+ 872F C5               push bc
1509+ 8730 FD E1            pop  iy                ; IYH = Row, IYL = Col
1510+ 8732
1511+ 8732                  ; ---------------------------------------------------------------
1512+ 8732                  ; Determina quale tipo di cella è presente nella posizione
1513+ 8732                  ; specificata.
1514+ 8732                  ;
1515+ 8732                  ; Input:
1516+ 8732                  ;   B = Row
1517+ 8732                  ;   C = Col
1518+ 8732                  ;
1519+ 8732                  ; Output:
1520+ 8732                  ;   A = tipo cella
1521+ 8732                  ; ---------------------------------------------------------------
1522+ 8732 78               ld   a, b
1523+ 8733
1524+ 8733 CD 8E 77         call GetCellFromUnpacked
1525+ 8736
1526+ 8736                  ; ---------------------------------------------------------------
1527+ 8736                  ; Recupera il puntatore alla stanza corrente.
1528+ 8736                  ;
1529+ 8736                  ; DE = base della struttura stanza
1530+ 8736                  ; ---------------------------------------------------------------
1531+ 8736 ED 5B 16 FA      ld   de, (room_ptr)
1532+ 873A
1533+ 873A                  ; ---------------------------------------------------------------
1534+ 873A                  ; Seleziona il tile corretto in base al tipo di cella.
1535+ 873A                  ;
1536+ 873A                  ; A = 0 -> Background
1537+ 873A                  ; A = 1 -> Floor
1538+ 873A                  ; A = 2 -> Wall
1539+ 873A                  ; A = 3 -> Nasty
1540+ 873A                  ; ---------------------------------------------------------------
1541+ 873A
1542+ 873A B7               or   a
1543+ 873B 20 06            jr   nz, .not_bg
1544+ 873D
1545+ 873D                  ; Background
1546+ 873D 21 A0 00         ld   hl, OFFSET_BG
1547+ 8740 19               add  hl, de
1548+ 8741 18 16            jr   .draw_cell
1549+ 8743
1550+ 8743              .not_bg:
1551+ 8743
1552+ 8743 3D               dec  a
1553+ 8744 20 06            jr   nz, .not_floor
1554+ 8746
1555+ 8746                  ; Floor
1556+ 8746 21 A9 00         ld   hl, OFFSET_FLOOR
1557+ 8749 19               add  hl, de
1558+ 874A 18 0D            jr   .draw_cell
1559+ 874C
1560+ 874C              .not_floor:
1561+ 874C
1562+ 874C 3D               dec  a
1563+ 874D 20 06            jr   nz, .not_wall
1564+ 874F
1565+ 874F                  ; Wall
1566+ 874F 21 B2 00         ld   hl, OFFSET_WALL
1567+ 8752 19               add  hl, de
1568+ 8753 18 04            jr   .draw_cell
1569+ 8755
1570+ 8755              .not_wall:
1571+ 8755
1572+ 8755                  ; Nasty
1573+ 8755 21 BB 00         ld   hl, OFFSET_NASTY
1574+ 8758 19               add  hl, de
1575+ 8759
1576+ 8759              .draw_cell:
1577+ 8759
1578+ 8759                  ; ---------------------------------------------------------------
1579+ 8759                  ; HL punta ora alla grafica del tile da ridisegnare.
1580+ 8759                  ;
1581+ 8759                  ; Gfx_DrawTile si aspetta:
1582+ 8759                  ;   IX = puntatore tile
1583+ 8759                  ;   B  = Row
1584+ 8759                  ;   C  = Col
1585+ 8759                  ; ---------------------------------------------------------------
1586+ 8759 E5               push hl
1587+ 875A DD E1            pop  ix
1588+ 875C
1589+ 875C                  ; Ripristina Row e Col salvati in IY
1590+ 875C FD E5            push iy
1591+ 875E C1               pop  bc
1592+ 875F
1593+ 875F                  ; Disegna il tile originale
1594+ 875F CD 5D 6A         call Gfx_DrawTile
1595+ 8762
1596+ 8762                  ; ---------------------------------------------------------------
1597+ 8762                  ; Ripristina i registri salvati
1598+ 8762                  ; ---------------------------------------------------------------
1599+ 8762 DD E1            pop  ix
1600+ 8764 E1               pop  hl
1601+ 8765 D1               pop  de
1602+ 8766 C1               pop  bc
1603+ 8767 FD E1            pop  iy
1604+ 8769
1605+ 8769 C9               ret
1606+ 876A
1607+ 876A              ; -------------------------------------------------------------------
1608+ 876A              ; CheckWillyItemCollision
1609+ 876A              ;
1610+ 876A              ; Verifica se Willy collide con un item utilizzando il controllo
1611+ 876A              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1612+ 876A              ;
1613+ 876A              ; Input:
1614+ 876A              ;   A = ItemX (colonna attributi 0..31)
1615+ 876A              ;   H = ItemY (riga attributi 3..18)
1616+ 876A              ;
1617+ 876A              ; Coordinate item:
1618+ 876A              ;   Ogni item occupa una cella da 8x8 pixel.
1619+ 876A              ;
1620+ 876A              ; Coordinate Willy:
1621+ 876A              ;   Willy occupa un rettangolo di 16x16 pixel.
1622+ 876A              ;
1623+ 876A              ; Output:
1624+ 876A              ;   Carry Set   = collisione rilevata
1625+ 876A              ;   Carry Clear = nessuna collisione
1626+ 876A              ;
1627+ 876A              ; Registri preservati:
1628+ 876A              ;   BC, DE, HL
1629+ 876A              ; -------------------------------------------------------------------
1630+ 876A              CheckWillyItemCollision:
1631+ 876A
1632+ 876A                  ; Salva i registri utilizzati
1633+ 876A C5               push bc
1634+ 876B D5               push de
1635+ 876C E5               push hl
1636+ 876D
1637+ 876D                  ; ---------------------------------------------------------------
1638+ 876D                  ; Calcola il bounding box orizzontale dell'item
1639+ 876D                  ;
1640+ 876D                  ; ItemLeft  = ItemX * 8
1641+ 876D                  ; ItemRight = ItemLeft + 7
1642+ 876D                  ;
1643+ 876D                  ; E = ItemLeft
1644+ 876D                  ; D = ItemRight
1645+ 876D                  ; ---------------------------------------------------------------
1646+ 876D 6F               ld   l, a              ; L = ItemX
1647+ 876E
1648+ 876E 7D               ld   a, l
1649+ 876F 87               add  a, a              ; *2
1650+ 8770 87               add  a, a              ; *4
1651+ 8771 87               add  a, a              ; *8
1652+ 8772
1653+ 8772 5F               ld   e, a              ; E = ItemLeft
1654+ 8773
1655+ 8773 C6 07            add  a, 7
1656+ 8775 57               ld   d, a              ; D = ItemRight
1657+ 8776
1658+ 8776                  ; ---------------------------------------------------------------
1659+ 8776                  ; Recupera la posizione corrente di Willy
1660+ 8776                  ;
1661+ 8776                  ; B = WillyY
1662+ 8776                  ; C = WillyX
1663+ 8776                  ; ---------------------------------------------------------------
1664+ 8776 ED 4B 96 F6      ld   bc, (PlayerPos)
1665+ 877A
1666+ 877A                  ; ---------------------------------------------------------------
1667+ 877A                  ; Primo test:
1668+ 877A                  ;
1669+ 877A                  ; WillyLeft <= ItemRight
1670+ 877A                  ;
1671+ 877A                  ; Se Willy è completamente a destra dell'item
1672+ 877A                  ; non può esserci collisione.
1673+ 877A                  ; ---------------------------------------------------------------
1674+ 877A 79               ld   a, c              ; A = WillyLeft
1675+ 877B
1676+ 877B BA               cp   d                 ; WillyLeft vs ItemRight
1677+ 877C
1678+ 877C 28 04            jr   z, .x_ok
1679+ 877E 38 02            jr   c, .x_ok
1680+ 8780
1681+ 8780 18 29            jr   .no_collision
1682+ 8782
1683+ 8782              .x_ok:
1684+ 8782
1685+ 8782                  ; ---------------------------------------------------------------
1686+ 8782                  ; Secondo test:
1687+ 8782                  ;
1688+ 8782                  ; WillyRight >= ItemLeft
1689+ 8782                  ;
1690+ 8782                  ; WillyRight = WillyX + 7
1691+ 8782                  ; ---------------------------------------------------------------
1692+ 8782 C6 07            add  a, 7
1693+ 8784
1694+ 8784 BB               cp   e                 ; WillyRight vs ItemLeft
1695+ 8785
1696+ 8785 28 04            jr   z, .y_check
1697+ 8787 30 02            jr   nc, .y_check
1698+ 8789
1699+ 8789 18 20            jr   .no_collision
1700+ 878B
1701+ 878B              .y_check:
1702+ 878B
1703+ 878B                  ; ---------------------------------------------------------------
1704+ 878B                  ; Recupera ItemY dal valore originale di HL
1705+ 878B                  ;
1706+ 878B                  ; H contiene la riga dell'item.
1707+ 878B                  ; ---------------------------------------------------------------
1708+ 878B E1               pop  hl
1709+ 878C E5               push hl
1710+ 878D
1711+ 878D                  ; ---------------------------------------------------------------
1712+ 878D                  ; Calcola il bounding box verticale dell'item
1713+ 878D                  ;
1714+ 878D                  ; ItemTop    = ItemY * 8
1715+ 878D                  ; ItemBottom = ItemTop + 7
1716+ 878D                  ;
1717+ 878D                  ; E = ItemTop
1718+ 878D                  ; D = ItemBottom
1719+ 878D                  ; ---------------------------------------------------------------
1720+ 878D 7C               ld   a, h
1721+ 878E
1722+ 878E 87               add  a, a              ; *2
1723+ 878F 87               add  a, a              ; *4
1724+ 8790 87               add  a, a              ; *8
1725+ 8791
1726+ 8791 5F               ld   e, a              ; ItemTop
1727+ 8792
1728+ 8792 C6 07            add  a, 7
1729+ 8794 57               ld   d, a              ; ItemBottom
1730+ 8795
1731+ 8795                  ; ---------------------------------------------------------------
1732+ 8795                  ; Primo test verticale:
1733+ 8795                  ;
1734+ 8795                  ; WillyTop <= ItemBottom
1735+ 8795                  ; ---------------------------------------------------------------
1736+ 8795 78               ld   a, b              ; WillyTop
1737+ 8796
1738+ 8796 BA               cp   d
1739+ 8797
1740+ 8797 28 04            jr   z, .y_ok
1741+ 8799 38 02            jr   c, .y_ok
1742+ 879B
1743+ 879B 18 0E            jr   .no_collision
1744+ 879D
1745+ 879D              .y_ok:
1746+ 879D
1747+ 879D                  ; ---------------------------------------------------------------
1748+ 879D                  ; Secondo test verticale:
1749+ 879D                  ;
1750+ 879D                  ; WillyBottom >= ItemTop
1751+ 879D                  ;
1752+ 879D                  ; WillyBottom = WillyY + 15
1753+ 879D                  ; ---------------------------------------------------------------
1754+ 879D C6 0F            add  a, 15
1755+ 879F
1756+ 879F BB               cp   e
1757+ 87A0
1758+ 87A0 28 04            jr   z, .collision
1759+ 87A2 30 02            jr   nc, .collision
1760+ 87A4
1761+ 87A4 18 05            jr   .no_collision
1762+ 87A6
1763+ 87A6              .collision:
1764+ 87A6
1765+ 87A6                  ; ---------------------------------------------------------------
1766+ 87A6                  ; Collisione rilevata
1767+ 87A6                  ; ---------------------------------------------------------------
1768+ 87A6 E1               pop  hl
1769+ 87A7 D1               pop  de
1770+ 87A8 C1               pop  bc
1771+ 87A9
1772+ 87A9 37               scf                    ; Carry = 1
1773+ 87AA
1774+ 87AA C9               ret
1775+ 87AB
1776+ 87AB              .no_collision:
1777+ 87AB
1778+ 87AB                  ; ---------------------------------------------------------------
1779+ 87AB                  ; Nessuna collisione
1780+ 87AB                  ; ---------------------------------------------------------------
1781+ 87AB E1               pop  hl
1782+ 87AC D1               pop  de
1783+ 87AD C1               pop  bc
1784+ 87AE
1785+ 87AE B7               or   a                 ; Carry = 0
1786+ 87AF
1787+ 87AF C9               ret
1788+ 87B0
1789+ 87B0              ; -------------------------------------------------------------------
1790+ 87B0              ; Items_CheckCollision
1791+ 87B0              ;
1792+ 87B0              ; Controlla se Willy entra in collisione con uno degli item
1793+ 87B0              ; attivi presenti nella stanza corrente.
1794+ 87B0              ;
1795+ 87B0              ; Per ogni item:
1796+ 87B0              ;   - verifica che appartenga alla stanza corrente
1797+ 87B0              ;   - verifica che non sia già stato raccolto
1798+ 87B0              ;   - esegue il test di collisione con Willy
1799+ 87B0              ;
1800+ 87B0              ; Se l'item viene raccolto:
1801+ 87B0              ;   - imposta il flag "collected"
1802+ 87B0              ;   - rimuove l'item dalla cache items_grid
1803+ 87B0              ;   - incrementa il contatore degli oggetti raccolti
1804+ 87B0              ;   - aggiorna l'HUD
1805+ 87B0              ;   - ripristina il tile di sfondo
1806+ 87B0              ;   - riproduce il suono di raccolta
1807+ 87B0              ;
1808+ 87B0              ; Formato record ItemsTable:
1809+ 87B0              ;   +0 RoomID
1810+ 87B0              ;   +1 X
1811+ 87B0              ;   +2 Y
1812+ 87B0              ;   +3 Color
1813+ 87B0              ;   +4 Collected
1814+ 87B0              ;
1815+ 87B0              ; Fine tabella:
1816+ 87B0              ;   RoomID = $FF
1817+ 87B0              ; -------------------------------------------------------------------
1818+ 87B0              Items_CheckCollision:
1819+ 87B0
1820+ 87B0                  ; Salva i registri utilizzati
