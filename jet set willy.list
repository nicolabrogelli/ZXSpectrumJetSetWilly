 212+ 5E9E B9               cp   c
 213+ 5E9F CA B3 5E         jp   z, .is_conveyor
 214+ 5EA2 DA A8 5E         jp   c, .c_greater
 215+ 5EA5 C3 B9 5E         jp   .check_ramp
 216+ 5EA8              .c_greater:
