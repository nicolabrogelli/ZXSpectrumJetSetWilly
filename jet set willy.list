 256+ 5ED8 C3 2E 5F         jp   .load_tile
 257+ 5EDB
 258+ 5EDB              .check_ramp:
 259+ 5EDB 3A 71 7E         ld   a, (ramp_len)
 260+ 5EDE B7               or   a
 261+ 5EDF CA 0F 5F         jp   z, .normal_grid
 262+ 5EE2
