   8+ 7902              ; Audio_UpdateJumpSound
   9+ 7902              ;
  10+ 7902              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7902              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7902              ; -------------------------------------------------------------------
  13+ 7902              Audio_UpdateJumpSound:
  14+ 7902 F5               push af
  15+ 7903 C5               push bc
  16+ 7904 D5               push de
  17+ 7905 E5               push hl
  18+ 7906
  19+ 7906                  ; Controlla se il suono è attivo (note < 18)
  20+ 7906 3A 9B 7D         ld   a, (Audio_jump_sound_note)
  21+ 7909 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 790B 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 790D
  24+ 790D                  ; Carica la nota corrente da suonare
  25+ 790D 5F               ld   e, a
  26+ 790E 16 00            ld   d, 0
  27+ 7910 21 3C 79         ld   hl, Audio_JumpSoundDelays
  28+ 7913 19               add  hl, de
  29+ 7914 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7915 57               ld   d, a                      ; D = delay della nota
  31+ 7916
  32+ 7916                  ; Suona la nota: 15 cicli
  33+ 7916 06 0F            ld   b, 15
  34+ 7918              .note_loop:
  35+ 7918                  ; Speaker ON
  36+ 7918 3A 27 7A         ld   a, (room_border_color)
  37+ 791B F6 10            or   $10
  38+ 791D D3 FE            out  ($fe), a
  39+ 791F 4A               ld   c, d
  40+ 7920              .d1:
  41+ 7920 0D               dec  c
  42+ 7921 20 FD            jr   nz, .d1
  43+ 7923
  44+ 7923                  ; Speaker OFF
  45+ 7923 3A 27 7A         ld   a, (room_border_color)
  46+ 7926 E6 EF            and  $ef
  47+ 7928 D3 FE            out  ($fe), a
  48+ 792A 4A               ld   c, d
  49+ 792B              .d2:
  50+ 792B 0D               dec  c
  51+ 792C 20 FD            jr   nz, .d2
  52+ 792E
  53+ 792E 10 E8            djnz .note_loop
  54+ 7930
  55+ 7930                  ; Passa alla nota successiva
  56+ 7930 3A 9B 7D         ld   a, (Audio_jump_sound_note)
  57+ 7933 3C               inc  a
  58+ 7934 32 9B 7D         ld   (Audio_jump_sound_note), a
