  30+ 6A78                  ; 2. Calcola riga di layout: r = Y / 8
  31+ 6A78 78               ld   a, b
  32+ 6A79 CB 3F            srl  a
  33+ 6A7B CB 3F            srl  a
  34+ 6A7D CB 3F            srl  a                 ; A = r (0..15)
  35+ 6A7F
  36+ 6A7F                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
  37+ 6A7F 5F               ld   e, a              ; E = r
  38+ 6A80 79               ld   a, c
