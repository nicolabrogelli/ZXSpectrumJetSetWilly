 992  8D19 CD 6B 68         call Gfx_UpdateTimeDisplay
 993  8D1C
 994  8D1C                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 995  8D1C 3A 69 F8         ld   a, (game_objective_completed)
 996  8D1F B7               or   a
 997  8D20 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 998  8D21
 999  8D21                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
1000  8D21 3A 66 F8         ld   a, (time_period)
1001  8D24 B7               or   a
1002  8D25 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
1003  8D26
1004  8D26 3A 64 F8         ld   a, (time_hours)
1005  8D29 FE 0C            cp   12
1006  8D2B 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1007  8D2D C9               ret
1008  8D2E
