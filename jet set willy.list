 409+ 72A8              .not_masterbed
 410+ 72A8                  ; ---------------------------------------------------------------
 411+ 72A8                  ; Confronto con UnderTheDrive
 412+ 72A8                  ; ---------------------------------------------------------------
 413+ 72A8 2A 14 79         ld   hl, (room_ptr)
 414+ 72AB 11 94 9B         ld   de, UnderTheDriveLayout
 415+ 72AE B7               or   a
 416+ 72AF ED 52            sbc  hl, de
 417+ 72B1 20 05            jr   nz, .unknown
 418+ 72B3
 419+ 72B3 3E 2D            ld   a, 45               ; Room ID = 45
 420+ 72B5 C3 BA 72         jp   .set_room
 421+ 72B8
 422+ 72B8              .unknown:
 423+ 72B8
 424+ 72B8                  ; Nessuna corrispondenza trovata.
 425+ 72B8                  ; Imposta la stanza di default.
 426+ 72B8 3E 00            ld   a, 0
 427+ 72BA
 428+ 72BA              .set_room:
 429+ 72BA
 430+ 72BA                  ; Salva l'ID della stanza corrente
 431+ 72BA 32 BA 78         ld   (current_room), a
 432+ 72BD
 433+ 72BD                  ; Ripristina i registri
 434+ 72BD D1               pop  de
 435+ 72BE E1               pop  hl
 436+ 72BF
 437+ 72BF C9               ret
 438+ 72C0
 439+ 72C0              ; -------------------------------------------------------------------
 440+ 72C0              ; Items_DrawRoom
 441+ 72C0              ;
 442+ 72C0              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 443+ 72C0              ;
 444+ 72C0              ; Operazioni eseguite:
 445+ 72C0              ;   1. Azzera la griglia items_grid.
 446+ 72C0              ;   2. Svuota la cache degli oggetti attivi.
 447+ 72C0              ;   3. Scansiona ItemsTable.
 448+ 72C0              ;   4. Per ogni item della stanza corrente:
 449+ 72C0              ;        - verifica se è già stato raccolto
 450+ 72C0              ;        - disegna la grafica
 451+ 72C0              ;        - aggiorna items_grid
 452+ 72C0              ;        - memorizza l'item nella cache current_room_items
 453+ 72C0              ;   5. Aggiorna num_room_items.
 454+ 72C0              ;
 455+ 72C0              ; Record ItemsTable:
 456+ 72C0              ;   +0  Room ID
 457+ 72C0              ;   +1  X (colonna)
 458+ 72C0              ;   +2  Y (riga)
 459+ 72C0              ;   +3  Colore
 460+ 72C0              ;   +4  Collected flag
 461+ 72C0              ;
 462+ 72C0              ; Cache current_room_items:
 463+ 72C0              ;   +0  Colonna
 464+ 72C0              ;   +1  Riga
 465+ 72C0              ;   +2  Colore
 466+ 72C0              ;   +3  Collected flag ptr (Low)
 467+ 72C0              ;   +4  Collected flag ptr (High)
 468+ 72C0              ;
 469+ 72C0              ; Ogni record cache occupa 5 byte.
 470+ 72C0              ; -------------------------------------------------------------------
 471+ 72C0              Items_DrawRoom:
 472+ 72C0
 473+ 72C0                  ; Salva tutti i registri utilizzati
 474+ 72C0 E5               push hl
 475+ 72C1 D5               push de
 476+ 72C2 C5               push bc
 477+ 72C3 DD E5            push ix
 478+ 72C5 FD E5            push iy
 479+ 72C7
 480+ 72C7                  ; ---------------------------------------------------------------
 481+ 72C7                  ; Azzera items_grid (32 x 16 = 512 byte)
 482+ 72C7                  ; ---------------------------------------------------------------
 483+ 72C7 21 00 B0         ld   hl, items_grid
 484+ 72CA 11 01 B0         ld   de, items_grid + 1
 485+ 72CD 36 00            ld   (hl), 0
 486+ 72CF 01 FF 01         ld   bc, 511
 487+ 72D2 ED B0            ldir
 488+ 72D4
 489+ 72D4                  ; ---------------------------------------------------------------
 490+ 72D4                  ; Nessun item attivo nella stanza
 491+ 72D4                  ; ---------------------------------------------------------------
 492+ 72D4 AF               xor  a
 493+ 72D5 32 13 79         ld   (num_room_items), a
 494+ 72D8
 495+ 72D8                  ; IY punta alla cache degli item attivi
 496+ 72D8 FD 21 C3 78      ld   iy, current_room_items
 497+ 72DC
 498+ 72DC                  ; ---------------------------------------------------------------
 499+ 72DC                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 500+ 72DC                  ; alla stanza corrente.
 501+ 72DC                  ;
 502+ 72DC                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 503+ 72DC                  ; ---------------------------------------------------------------
 504+ 72DC 2A 14 79         ld   hl, (room_ptr)
 505+ 72DF 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 506+ 72E2 19               add  hl, de
 507+ 72E3
 508+ 72E3 E5               push hl
 509+ 72E4 DD E1            pop  ix                ; IX = bitmap item
 510+ 72E6
 511+ 72E6                  ; ---------------------------------------------------------------
 512+ 72E6                  ; Inizio scansione della tabella degli item
 513+ 72E6                  ; ---------------------------------------------------------------
 514+ 72E6 21 E6 70         ld   hl, ItemsTable
 515+ 72E9
 516+ 72E9              .loop:
 517+ 72E9
 518+ 72E9                  ; ---------------------------------------------------------------
 519+ 72E9                  ; Legge il Room ID del record corrente
 520+ 72E9                  ; ---------------------------------------------------------------
 521+ 72E9 7E               ld   a, (hl)
 522+ 72EA
 523+ 72EA                  ; $FF indica fine tabella
 524+ 72EA FE FF            cp   $FF
 525+ 72EC 28 53            jr   z, .done
 526+ 72EE
 527+ 72EE                  ; ---------------------------------------------------------------
 528+ 72EE                  ; Verifica se l'item appartiene alla stanza corrente
 529+ 72EE                  ; ---------------------------------------------------------------
 530+ 72EE 57               ld   d, a
 531+ 72EF
 532+ 72EF 3A BA 78         ld   a, (current_room)
 533+ 72F2 BA               cp   d
 534+ 72F3 20 45            jr   nz, .next_item
 535+ 72F5
 536+ 72F5                  ; ---------------------------------------------------------------
 537+ 72F5                  ; Legge i dati dell'item
 538+ 72F5                  ; ---------------------------------------------------------------
 539+ 72F5
 540+ 72F5 23               inc  hl
 541+ 72F6 4E               ld   c, (hl)           ; X (colonna)
 542+ 72F7
 543+ 72F7 23               inc  hl
 544+ 72F8 46               ld   b, (hl)           ; Y (riga)
 545+ 72F9
 546+ 72F9 23               inc  hl
 547+ 72FA 5E               ld   e, (hl)           ; Colore
 548+ 72FB
 549+ 72FB 23               inc  hl
 550+ 72FC 7E               ld   a, (hl)           ; Collected flag
 551+ 72FD
 552+ 72FD                  ; Se diverso da zero l'item è già stato raccolto
 553+ 72FD B7               or   a
 554+ 72FE 20 3E            jr   nz, .next_no_inc
 555+ 7300
 556+ 7300                  ; ---------------------------------------------------------------
 557+ 7300                  ; Disegna l'item sullo schermo
 558+ 7300                  ;
 559+ 7300                  ; B = Row
 560+ 7300                  ; C = Column
 561+ 7300                  ; HL = bitmap pointer
 562+ 7300                  ; E = Color
 563+ 7300                  ; ---------------------------------------------------------------
 564+ 7300 E5               push hl
 565+ 7301
 566+ 7301 DD E5            push ix
 567+ 7303 E1               pop  hl
 568+ 7304
 569+ 7304 CD 49 73         call DrawItemGraphic
 570+ 7307
 571+ 7307 E1               pop  hl                ; ritorna al flag collected
 572+ 7308
 573+ 7308                  ; ---------------------------------------------------------------
 574+ 7308                  ; Aggiorna items_grid
 575+ 7308                  ;
 576+ 7308                  ; Calcolo:
 577+ 7308                  ;   offset = Row * 32 + Col
 578+ 7308                  ; ---------------------------------------------------------------
 579+ 7308 E5               push hl
 580+ 7309 D5               push de
 581+ 730A
 582+ 730A 26 00            ld   h, 0
 583+ 730C 68               ld   l, b              ; HL = Row
 584+ 730D
 585+ 730D 29               add  hl, hl            ; *2
 586+ 730E 29               add  hl, hl            ; *4
 587+ 730F 29               add  hl, hl            ; *8
 588+ 7310 29               add  hl, hl            ; *16
 589+ 7311 29               add  hl, hl            ; *32
 590+ 7312
 591+ 7312 16 00            ld   d, 0
 592+ 7314 59               ld   e, c              ; DE = Col
 593+ 7315
 594+ 7315 19               add  hl, de            ; Row*32 + Col
 595+ 7316
 596+ 7316 11 00 B0         ld   de, items_grid
 597+ 7319 19               add  hl, de            ; puntatore nella griglia
 598+ 731A
 599+ 731A D1               pop  de                ; ripristina colore
 600+ 731B
 601+ 731B 73               ld   (hl), e           ; salva colore cella
 602+ 731C
 603+ 731C E1               pop  hl
 604+ 731D
 605+ 731D                  ; ---------------------------------------------------------------
 606+ 731D                  ; Salva l'item nella cache della stanza
 607+ 731D                  ;
 608+ 731D                  ; Questo evita di dover scansionare tutta ItemsTable
 609+ 731D                  ; durante il controllo delle collisioni.
 610+ 731D                  ; ---------------------------------------------------------------
 611+ 731D
 612+ 731D FD 71 00         ld   (iy+0), c         ; Colonna
 613+ 7320 FD 70 01         ld   (iy+1), b         ; Riga
 614+ 7323 FD 73 02         ld   (iy+2), e         ; Colore
 615+ 7326
 616+ 7326                  ; Salva il puntatore al flag "collected"
 617+ 7326 FD 75 03         ld   (iy+3), l         ; Low byte
 618+ 7329 FD 74 04         ld   (iy+4), h         ; High byte
 619+ 732C
 620+ 732C                  ; Passa al record successivo della cache
 621+ 732C 01 05 00         ld   bc, 5
 622+ 732F FD 09            add  iy, bc
 623+ 7331
 624+ 7331                  ; Incrementa il numero di item attivi
 625+ 7331 3A 13 79         ld   a, (num_room_items)
 626+ 7334 3C               inc  a
 627+ 7335 32 13 79         ld   (num_room_items), a
 628+ 7338
 629+ 7338 18 04            jr   .next_no_inc
 630+ 733A
 631+ 733A              .next_item:
 632+ 733A
 633+ 733A                  ; ---------------------------------------------------------------
 634+ 733A                  ; L'item non appartiene alla stanza corrente.
 635+ 733A                  ; Salta i campi del record:
 636+ 733A                  ;   X
 637+ 733A                  ;   Y
 638+ 733A                  ;   Color
 639+ 733A                  ;   Collected
 640+ 733A                  ; ---------------------------------------------------------------
 641+ 733A 23               inc  hl
 642+ 733B 23               inc  hl
 643+ 733C 23               inc  hl
 644+ 733D 23               inc  hl
 645+ 733E
 646+ 733E              .next_no_inc:
 647+ 733E
 648+ 733E                  ; ---------------------------------------------------------------
 649+ 733E                  ; Avanza al record successivo
 650+ 733E                  ; (prossimo Room ID)
 651+ 733E                  ; ---------------------------------------------------------------
 652+ 733E 23               inc  hl
 653+ 733F 18 A8            jr   .loop
 654+ 7341
 655+ 7341              .done:
 656+ 7341
 657+ 7341                  ; Ripristina i registri
 658+ 7341 FD E1            pop  iy
 659+ 7343 DD E1            pop  ix
 660+ 7345 D1               pop  de
 661+ 7346 C1               pop  bc
 662+ 7347 E1               pop  hl
 663+ 7348
 664+ 7348 C9               ret
 665+ 7349
 666+ 7349              ; -------------------------------------------------------------------
 667+ 7349              ; DrawItemGraphic
 668+ 7349              ;
 669+ 7349              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 670+ 7349              ; utilizzando una bitmap di 8 byte e un attributo colore.
 671+ 7349              ;
 672+ 7349              ; Input:
 673+ 7349              ;   B = Riga attributi (3..18)
 674+ 7349              ;   C = Colonna attributi (0..31)
 675+ 7349              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 676+ 7349              ;   E = Attributo colore
 677+ 7349              ;
 678+ 7349              ; Output:
 679+ 7349              ;   Nessuno
 680+ 7349              ;
 681+ 7349              ; Registri preservati:
 682+ 7349              ;   BC, DE, HL
 683+ 7349              ; -------------------------------------------------------------------
 684+ 7349              DrawItemGraphic:
 685+ 7349
 686+ 7349                  ; Salva i registri originali
 687+ 7349 C5               push bc
 688+ 734A D5               push de
 689+ 734B E5               push hl
 690+ 734C
 691+ 734C                  ; ---------------------------------------------------------------
 692+ 734C                  ; Calcolo indirizzo bitmap dello Spectrum
 693+ 734C                  ;
 694+ 734C                  ; Ogni item occupa una cella attributi (8x8 pixel).
 695+ 734C                  ;
 696+ 734C                  ; Formula:
 697+ 734C                  ;   High = $40 + (Row AND $18)
 698+ 734C                  ;   Low  = (Row AND 7) * 32 + Col
 699+ 734C                  ;
 700+ 734C                  ; DE conterrà l'indirizzo della prima scanline.
 701+ 734C                  ; ---------------------------------------------------------------
 702+ 734C
 703+ 734C 78               ld   a, b
 704+ 734D E6 18            and  $18
 705+ 734F C6 40            add  a, $40
 706+ 7351 57               ld   d, a              ; Byte alto indirizzo video
 707+ 7352
 708+ 7352 78               ld   a, b
 709+ 7353 E6 07            and  7                 ; Riga interna al blocco da 8
 710+ 7355
 711+ 7355 87               add  a, a              ; *2
 712+ 7356 87               add  a, a              ; *4
 713+ 7357 87               add  a, a              ; *8
 714+ 7358 87               add  a, a              ; *16
 715+ 7359 87               add  a, a              ; *32
 716+ 735A
 717+ 735A 81               add  a, c              ; + colonna
 718+ 735B
 719+ 735B 5F               ld   e, a              ; Byte basso indirizzo video
 720+ 735C
 721+ 735C                  ; ---------------------------------------------------------------
 722+ 735C                  ; Disegno bitmap
 723+ 735C                  ;
 724+ 735C                  ; Copia 8 byte consecutivi nella memoria video.
 725+ 735C                  ; Ogni byte rappresenta una scanline da 8 pixel.
 726+ 735C                  ; ---------------------------------------------------------------
 727+ 735C
 728+ 735C C5               push bc                ; Conserva Row e Col
 729+ 735D
 730+ 735D 06 08            ld   b, 8              ; Numero scanline
 731+ 735F
 732+ 735F              .line_loop:
 733+ 735F
 734+ 735F 7E               ld   a, (hl)           ; Legge scanline bitmap
 735+ 7360 12               ld   (de), a           ; Scrive nella memoria video
 736+ 7361
 737+ 7361 14               inc  d                 ; Scanline successiva
 738+ 7362 23               inc  hl                ; Byte bitmap successivo
 739+ 7363
 740+ 7363 05               dec  b
 741+ 7364 20 F9            jr   nz, .line_loop
 742+ 7366
 743+ 7366 C1               pop  bc                ; Ripristina Row e Col
 744+ 7367
 745+ 7367                  ; ---------------------------------------------------------------
 746+ 7367                  ; Calcolo indirizzo attributo
 747+ 7367                  ;
 748+ 7367                  ; Formula:
 749+ 7367                  ;   AttrAddr = $5800 + Row * 32 + Col
 750+ 7367                  ;
 751+ 7367                  ; HL conterrà l'indirizzo della cella attributi.
 752+ 7367                  ; ---------------------------------------------------------------
 753+ 7367
 754+ 7367 26 00            ld   h, 0
 755+ 7369 68               ld   l, b              ; HL = Row
 756+ 736A
 757+ 736A 29               add  hl, hl            ; *2
 758+ 736B 29               add  hl, hl            ; *4
 759+ 736C 29               add  hl, hl            ; *8
 760+ 736D 29               add  hl, hl            ; *16
 761+ 736E 29               add  hl, hl            ; *32
 762+ 736F
 763+ 736F 79               ld   a, c              ; A = Colonna
 764+ 7370
 765+ 7370 85               add  a, l
 766+ 7371 6F               ld   l, a
 767+ 7372
 768+ 7372 30 01            jr   nc, .no_carry
 769+ 7374 24               inc  h
 770+ 7375
 771+ 7375              .no_carry:
 772+ 7375
 773+ 7375                  ; HL = Row * 32 + Col
 774+ 7375
 775+ 7375 11 00 58         ld   de, $5800
 776+ 7378 19               add  hl, de            ; HL = indirizzo attributi
 777+ 7379
 778+ 7379                  ; ---------------------------------------------------------------
 779+ 7379                  ; Recupera il colore originale dallo stack.
 780+ 7379                  ;
 781+ 7379                  ; Layout stack:
 782+ 7379                  ;   HL originale
 783+ 7379                  ;   DE originale (E = colore)
 784+ 7379                  ;   BC originale
 785+ 7379                  ; ---------------------------------------------------------------
 786+ 7379
 787+ 7379 C1               pop  bc                ; Recupera HL originale
 788+ 737A D1               pop  de                ; Recupera DE originale
 789+ 737B
 790+ 737B                  ; ---------------------------------------------------------------
 791+ 737B                  ; Scrive l'attributo colore
 792+ 737B                  ; ---------------------------------------------------------------
 793+ 737B
 794+ 737B 7B               ld   a, e              ; A = colore
 795+ 737C 77               ld   (hl), a           ; Scrive nella RAM attributi
 796+ 737D
 797+ 737D                  ; ---------------------------------------------------------------
 798+ 737D                  ; Ripristina HL e BC originali
 799+ 737D                  ; ---------------------------------------------------------------
 800+ 737D
 801+ 737D C5               push bc
 802+ 737E E1               pop  hl                ; HL originale
 803+ 737F
 804+ 737F C1               pop  bc                ; BC originale
 805+ 7380
 806+ 7380 C9               ret
 807+ 7381
 808+ 7381              ; -------------------------------------------------------------------
 809+ 7381              ; RestoreBackgroundCell
 810+ 7381              ;
 811+ 7381              ; Ripristina il contenuto originale di una cella della stanza.
 812+ 7381              ; Viene utilizzata principalmente quando un item viene raccolto:
 813+ 7381              ; invece di lasciare un "buco", la routine ridisegna il tile
 814+ 7381              ; originale presente nella mappa della stanza.
 815+ 7381              ;
 816+ 7381              ; Input:
 817+ 7381              ;   B = Row (3..18)
 818+ 7381              ;   C = Col (0..31)
 819+ 7381              ;
 820+ 7381              ; Utilizza:
 821+ 7381              ;   room_ptr -> struttura dati della stanza corrente
 822+ 7381              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 823+ 7381              ;   Gfx_DrawTile -> ridisegna il tile selezionato
 824+ 7381              ;
 825+ 7381              ; Tipi di cella:
 826+ 7381              ;   0 = Background
 827+ 7381              ;   1 = Floor
 828+ 7381              ;   2 = Wall
 829+ 7381              ;   3 = Nasty
 830+ 7381              ; -------------------------------------------------------------------
 831+ 7381              RestoreBackgroundCell:
 832+ 7381
 833+ 7381                  ; Salva tutti i registri utilizzati
 834+ 7381 FD E5            push iy
 835+ 7383 C5               push bc
 836+ 7384 D5               push de
 837+ 7385 E5               push hl
 838+ 7386 DD E5            push ix
 839+ 7388
 840+ 7388                  ; ---------------------------------------------------------------
 841+ 7388                  ; Conserva Row e Col in IY.
 842+ 7388                  ;
 843+ 7388                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 844+ 7388                  ; BC potrebbe essere modificato.
 845+ 7388                  ; ---------------------------------------------------------------
 846+ 7388 C5               push bc
 847+ 7389 FD E1            pop  iy                ; IYH = Row, IYL = Col
 848+ 738B
 849+ 738B                  ; ---------------------------------------------------------------
 850+ 738B                  ; Determina quale tipo di cella è presente nella posizione
 851+ 738B                  ; specificata.
 852+ 738B                  ;
 853+ 738B                  ; Input:
 854+ 738B                  ;   B = Row
 855+ 738B                  ;   C = Col
 856+ 738B                  ;
 857+ 738B                  ; Output:
 858+ 738B                  ;   A = tipo cella
 859+ 738B                  ; ---------------------------------------------------------------
 860+ 738B 78               ld   a, b
 861+ 738C
 862+ 738C CD A7 6B         call GetCellFromUnpacked
 863+ 738F
 864+ 738F                  ; ---------------------------------------------------------------
 865+ 738F                  ; Recupera il puntatore alla stanza corrente.
 866+ 738F                  ;
 867+ 738F                  ; DE = base della struttura stanza
 868+ 738F                  ; ---------------------------------------------------------------
 869+ 738F ED 5B 14 79      ld   de, (room_ptr)
 870+ 7393
 871+ 7393                  ; ---------------------------------------------------------------
 872+ 7393                  ; Seleziona il tile corretto in base al tipo di cella.
 873+ 7393                  ;
 874+ 7393                  ; A = 0 -> Background
 875+ 7393                  ; A = 1 -> Floor
 876+ 7393                  ; A = 2 -> Wall
 877+ 7393                  ; A = 3 -> Nasty
 878+ 7393                  ; ---------------------------------------------------------------
 879+ 7393
 880+ 7393 B7               or   a
 881+ 7394 20 06            jr   nz, .not_bg
 882+ 7396
 883+ 7396                  ; Background
 884+ 7396 21 A0 00         ld   hl, OFFSET_BG
 885+ 7399 19               add  hl, de
 886+ 739A 18 16            jr   .draw_cell
 887+ 739C
 888+ 739C              .not_bg:
 889+ 739C
 890+ 739C 3D               dec  a
 891+ 739D 20 06            jr   nz, .not_floor
 892+ 739F
 893+ 739F                  ; Floor
 894+ 739F 21 A9 00         ld   hl, OFFSET_FLOOR
 895+ 73A2 19               add  hl, de
 896+ 73A3 18 0D            jr   .draw_cell
 897+ 73A5
 898+ 73A5              .not_floor:
 899+ 73A5
 900+ 73A5 3D               dec  a
 901+ 73A6 20 06            jr   nz, .not_wall
 902+ 73A8
 903+ 73A8                  ; Wall
 904+ 73A8 21 B2 00         ld   hl, OFFSET_WALL
 905+ 73AB 19               add  hl, de
 906+ 73AC 18 04            jr   .draw_cell
 907+ 73AE
 908+ 73AE              .not_wall:
 909+ 73AE
 910+ 73AE                  ; Nasty
 911+ 73AE 21 BB 00         ld   hl, OFFSET_NASTY
 912+ 73B1 19               add  hl, de
 913+ 73B2
 914+ 73B2              .draw_cell:
 915+ 73B2
 916+ 73B2                  ; ---------------------------------------------------------------
 917+ 73B2                  ; HL punta ora alla grafica del tile da ridisegnare.
 918+ 73B2                  ;
 919+ 73B2                  ; Gfx_DrawTile si aspetta:
 920+ 73B2                  ;   IX = puntatore tile
 921+ 73B2                  ;   B  = Row
 922+ 73B2                  ;   C  = Col
 923+ 73B2                  ; ---------------------------------------------------------------
 924+ 73B2 E5               push hl
 925+ 73B3 DD E1            pop  ix
 926+ 73B5
 927+ 73B5                  ; Ripristina Row e Col salvati in IY
 928+ 73B5 FD E5            push iy
 929+ 73B7 C1               pop  bc
 930+ 73B8
 931+ 73B8                  ; Disegna il tile originale
 932+ 73B8 CD 8C 61         call Gfx_DrawTile
 933+ 73BB
 934+ 73BB                  ; ---------------------------------------------------------------
 935+ 73BB                  ; Ripristina i registri salvati
 936+ 73BB                  ; ---------------------------------------------------------------
 937+ 73BB DD E1            pop  ix
 938+ 73BD E1               pop  hl
 939+ 73BE D1               pop  de
 940+ 73BF C1               pop  bc
 941+ 73C0 FD E1            pop  iy
 942+ 73C2
 943+ 73C2 C9               ret
 944+ 73C3
 945+ 73C3              ; -------------------------------------------------------------------
 946+ 73C3              ; CheckWillyItemCollision
 947+ 73C3              ;
 948+ 73C3              ; Verifica se Willy collide con un item utilizzando il controllo
 949+ 73C3              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 950+ 73C3              ;
 951+ 73C3              ; Input:
 952+ 73C3              ;   A = ItemX (colonna attributi 0..31)
 953+ 73C3              ;   H = ItemY (riga attributi 3..18)
 954+ 73C3              ;
 955+ 73C3              ; Coordinate item:
 956+ 73C3              ;   Ogni item occupa una cella da 8x8 pixel.
 957+ 73C3              ;
 958+ 73C3              ; Coordinate Willy:
 959+ 73C3              ;   Willy occupa un rettangolo di 16x16 pixel.
 960+ 73C3              ;
 961+ 73C3              ; Output:
 962+ 73C3              ;   Carry Set   = collisione rilevata
 963+ 73C3              ;   Carry Clear = nessuna collisione
 964+ 73C3              ;
 965+ 73C3              ; Registri preservati:
 966+ 73C3              ;   BC, DE, HL
 967+ 73C3              ; -------------------------------------------------------------------
 968+ 73C3              CheckWillyItemCollision:
 969+ 73C3
 970+ 73C3                  ; Salva i registri utilizzati
 971+ 73C3 C5               push bc
 972+ 73C4 D5               push de
 973+ 73C5 E5               push hl
 974+ 73C6
 975+ 73C6                  ; ---------------------------------------------------------------
 976+ 73C6                  ; Calcola il bounding box orizzontale dell'item
 977+ 73C6                  ;
 978+ 73C6                  ; ItemLeft  = ItemX * 8
 979+ 73C6                  ; ItemRight = ItemLeft + 7
 980+ 73C6                  ;
 981+ 73C6                  ; E = ItemLeft
 982+ 73C6                  ; D = ItemRight
 983+ 73C6                  ; ---------------------------------------------------------------
 984+ 73C6 6F               ld   l, a              ; L = ItemX
 985+ 73C7
 986+ 73C7 7D               ld   a, l
 987+ 73C8 87               add  a, a              ; *2
 988+ 73C9 87               add  a, a              ; *4
 989+ 73CA 87               add  a, a              ; *8
