1161+ 75A4 30 1F            jr   nc, .not_wall
1162+ 75A6
1163+ 75A6                  ; 2. Calcola riga di layout: r = Y / 8
1164+ 75A6 CB 3F            srl  a
1165+ 75A8 CB 3F            srl  a
1166+ 75AA CB 3F            srl  a                 ; A = r (0..15)
1167+ 75AC
1168+ 75AC                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1169+ 75AC 5F               ld   e, a              ; E = r (Row)
1170+ 75AD 79               ld   a, c
1171+ 75AE CB 3F            srl  a
1172+ 75B0 CB 3F            srl  a
1173+ 75B2 CB 3F            srl  a                 ; A = c (0..31)
1174+ 75B4 4F               ld   c, a              ; C = c (Col)
1175+ 75B5
1176+ 75B5                  ; Se la cella è sulla rampa, non considerarla un muro!
1177+ 75B5 53               ld   d, e              ; D = Row
1178+ 75B6 59               ld   e, c              ; E = Col
1179+ 75B7 CD 23 75         call IsCellOnRamp
1180+ 75BA 38 09            jr   c, .not_wall
1181+ 75BC
1182+ 75BC 7A               ld   a, d              ; A = Row
1183+ 75BD 4B               ld   c, e              ; C = Col
1184+ 75BE CD 1E 76         call GetCellFromUnpacked ; A = cell type
