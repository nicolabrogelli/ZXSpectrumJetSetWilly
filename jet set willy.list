   6+ 652A              ; -------------------------------------------------------------------
   7+ 652A              ; Input_CheckCtrl
   8+ 652A              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 652A              ;
  10+ 652A              ; Output:
  11+ 652A              ;   D = bitmask tasti attivi:
  12+ 652A              ;       bit 0 → sinistra (O)
  13+ 652A              ;       bit 1 → destra   (P)
  14+ 652A              ;       bit 2 → salto    (Z)
  15+ 652A              ;
  16+ 652A              ; Effetti collaterali in RAM:
  17+ 652A              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 652A              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 652A              ;   (jump_prev)     → debounce tasto salto
  20+ 652A              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 652A              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 652A              ; -------------------------------------------------------------------
  23+ 652A
  24+ 652A              Input_CheckCtrl:
  25+ 652A AF               xor  a
  26+ 652B 32 DD 76         ld   (current_input_dir), a
  27+ 652E
  28+ 652E                  ; ── Sezione 1: tasto Q (cambio stanza) ──────────────────────────
  29+ 652E                  ;
  30+ 652E                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  31+ 652E                  ; Se bit 0 = 0, Q è premuto.
  32+ 652E
  33+ 652E 01 FE FB         ld   bc, $fbfe
  34+ 6531 ED 78            in   a, (c)
  35+ 6533 CB 47            bit  0, a
  36+ 6535 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  37+ 6537
  38+ 6537                  ; Q è premuto: debounce tramite (q_prev).
  39+ 6537                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  40+ 6537 3A DE 76         ld   a, (q_prev)
  41+ 653A B7               or   a
  42+ 653B 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  43+ 653D
  44+ 653D                  ; ── Primo frame di pressione di Q ──
  45+ 653D 3E 01            ld   a, 1
  46+ 653F 32 DE 76         ld   (q_prev), a            ; marca "Q era premuto"
  47+ 6542
  48+ 6542                  ; NOTA sullo stack:
  49+ 6542                  ; Input_CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  50+ 6542                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChange senza
  51+ 6542                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  52+ 6542                  ; poi JP salta direttamente.
  53+ 6542 E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  54+ 6543 C3 CC 65         jp   PerformRoomChange      ; salta al cambio stanza (non torna qui)
  55+ 6546
  56+ 6546              .q_not_pressed:
  57+ 6546 AF               xor  a
  58+ 6547 32 DE 76         ld   (q_prev), a            ; Q rilasciato → azzera debounce
  59+ 654A
  60+ 654A              .q_handled:
  61+ 654A
  62+ 654A                  ; ── Sezione 2: movimento (sinistra / destra) ────────────────────
  63+ 654A                  ;
  64+ 654A                  ; Porta $DF → riga P, O, I, U, Y.
  65+ 654A                  ; Bit 0 = P (destra), Bit 1 = O (sinistra).
  66+ 654A
  67+ 654A 16 00            ld  d, $00                  ; azzera output
  68+ 654C 01 FE DF         ld  bc, $dffe
  69+ 654F ED 78            in  a, (c)                  ; legge riga $FE
  70+ 6551
  71+ 6551                  ; Se Willy è sul conveyor nella stanza The Off Licence (room 0),
  72+ 6551                  ; impedisci lo spostamento da sinistra a destra (disabilita tasto destra P / bit 0).
  73+ 6551 F5               push af
  74+ 6552 3A E3 79         ld   a, (current_room)
  75+ 6555 B7               or   a                      ; Room 0 = The Off Licence
  76+ 6556 20 09            jr   nz, .no_block_conveyor
  77+ 6558 CD 98 6A         call CheckWillyOnConveyor
  78+ 655B 30 04            jr   nc, .no_block_conveyor
  79+ 655D F1               pop  af
  80+ 655E F6 01            or   $01                    ; Forza bit 0 (destra) a 1 (non premuto)
  81+ 6560 F5               push af
  82+ 6561              .no_block_conveyor:
  83+ 6561 F1               pop  af
  84+ 6562
  85+ 6562 DD 21 D1 76      ld  ix, flags               ; IX punta alla variabile flags
  86+ 6566
  87+ 6566              checkCtrl_left:
  88+ 6566 CB 4F            bit $01, a                  ; bit 1 = O → sinistra?
