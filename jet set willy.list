 655+ 60A8              .draw_body:
 656+ 60A8 ED 4B 2F F3      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY
 657+ 60AC 78               ld   a, b
 658+ 60AD C6 08            add  a, 8
 659+ 60AF 47               ld   b, a              ; B = PlayerY + 8
 660+ 60B0 CD 3F 5E         call Gfx_DrawPixelSprite8x8 ; Disegna corpo
