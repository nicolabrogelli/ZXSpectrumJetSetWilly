 187+ 822C
 188+ 822C              TOTAL_ITEMS: EQU (ItemsTableEnd - ItemsTable) / 5
 189+ 822C
 190+ 822C
 191+ 822C              ; -------------------------------------------------------------------
 192+ 822C              ; DetermineCurrentRoomID
 193+ 822C              ;
 194+ 822C              ; Determina l'ID numerico della stanza corrente confrontando
 195+ 822C              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 196+ 822C              ;
 197+ 822C              ; Se viene trovata una corrispondenza:
 198+ 822C              ;   A = ID della stanza
 199+ 822C              ;   current_room = A
 200+ 822C              ;
 201+ 822C              ; Mappatura:
 202+ 822C              ;    0 = The Off Licence
 203+ 822C              ;    1 = The Bridge
 204+ 822C              ;    2 = Under The Mega Tree
 205+ 822C              ;    3 = Gfx_At The Foot Of The Mega Tree
 206+ 822C              ;    4 = The Drive
 207+ 822C              ;    5 = The Security Guard
 208+ 822C              ;    6 = Entrance To Hades
 209+ 822C              ;    7 = Cuckoo's Nest
 210+ 822C              ;    8 = Inside The Mega Trunk
 211+ 822C              ;    9 = On A Branch Over The Drive
 212+ 822C              ;   10 = The Front Door
 213+ 822C              ;   11 = The Hall
 214+ 822C              ;   12 = Tree Top
 215+ 822C              ;   27 = The Chapel
 216+ 822C              ;   28 = First Landing
 217+ 822C              ;   29 = The Nightmare Room
 218+ 822C              ;   33 = The Bathroom
 219+ 822C              ;   35 = Master Bedroom
 220+ 822C              ;
