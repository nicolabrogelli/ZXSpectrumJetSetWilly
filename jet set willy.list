 231+ 6CA6              ; -------------------------------------------------------------------
 232+ 6CA6              ; DrawRoomItems
 233+ 6CA6              ;
 234+ 6CA6              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 235+ 6CA6              ;
 236+ 6CA6              ; Operazioni eseguite:
 237+ 6CA6              ;   1. Azzera la griglia items_grid.
 238+ 6CA6              ;   2. Svuota la cache degli oggetti attivi.
 239+ 6CA6              ;   3. Scansiona ItemsTable.
 240+ 6CA6              ;   4. Per ogni item della stanza corrente:
 241+ 6CA6              ;        - verifica se è già stato raccolto
 242+ 6CA6              ;        - disegna la grafica
 243+ 6CA6              ;        - aggiorna items_grid
 244+ 6CA6              ;        - memorizza l'item nella cache current_room_items
 245+ 6CA6              ;   5. Aggiorna num_room_items.
 246+ 6CA6              ;
 247+ 6CA6              ; Record ItemsTable:
 248+ 6CA6              ;   +0  Room ID
 249+ 6CA6              ;   +1  X (colonna)
 250+ 6CA6              ;   +2  Y (riga)
 251+ 6CA6              ;   +3  Colore
 252+ 6CA6              ;   +4  Collected flag
 253+ 6CA6              ;
 254+ 6CA6              ; Cache current_room_items:
 255+ 6CA6              ;   +0  Colonna
 256+ 6CA6              ;   +1  Riga
 257+ 6CA6              ;   +2  Colore
 258+ 6CA6              ;   +3  Collected flag ptr (Low)
 259+ 6CA6              ;   +4  Collected flag ptr (High)
 260+ 6CA6              ;
 261+ 6CA6              ; Ogni record cache occupa 5 byte.
 262+ 6CA6              ; -------------------------------------------------------------------
 263+ 6CA6              DrawRoomItems:
 264+ 6CA6
 265+ 6CA6                  ; Salva tutti i registri utilizzati
 266+ 6CA6 E5               push hl
 267+ 6CA7 D5               push de
 268+ 6CA8 C5               push bc
 269+ 6CA9 DD E5            push ix
 270+ 6CAB FD E5            push iy
 271+ 6CAD
 272+ 6CAD                  ; ---------------------------------------------------------------
 273+ 6CAD                  ; Azzera items_grid (32 x 16 = 512 byte)
 274+ 6CAD                  ; ---------------------------------------------------------------
 275+ 6CAD 21 00 90         ld   hl, items_grid
 276+ 6CB0 11 01 90         ld   de, items_grid + 1
 277+ 6CB3 36 00            ld   (hl), 0
 278+ 6CB5 01 FF 01         ld   bc, 511
 279+ 6CB8 ED B0            ldir
 280+ 6CBA
 281+ 6CBA                  ; ---------------------------------------------------------------
 282+ 6CBA                  ; Nessun item attivo nella stanza
 283+ 6CBA                  ; ---------------------------------------------------------------
 284+ 6CBA AF               xor  a
 285+ 6CBB 32 37 7E         ld   (num_room_items), a
 286+ 6CBE
 287+ 6CBE                  ; IY punta alla cache degli item attivi
 288+ 6CBE FD 21 E7 7D      ld   iy, current_room_items
 289+ 6CC2
 290+ 6CC2                  ; ---------------------------------------------------------------
 291+ 6CC2                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 292+ 6CC2                  ; alla stanza corrente.
 293+ 6CC2                  ;
 294+ 6CC2                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 295+ 6CC2                  ; ---------------------------------------------------------------
 296+ 6CC2 2A 38 7E         ld   hl, (room_ptr)
 297+ 6CC5 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 298+ 6CC8 19               add  hl, de
 299+ 6CC9
 300+ 6CC9 E5               push hl
 301+ 6CCA DD E1            pop  ix                ; IX = bitmap item
 302+ 6CCC
 303+ 6CCC                  ; ---------------------------------------------------------------
 304+ 6CCC                  ; Inizio scansione della tabella degli item
 305+ 6CCC                  ; ---------------------------------------------------------------
 306+ 6CCC 21 BF 6B         ld   hl, ItemsTable
 307+ 6CCF
 308+ 6CCF              .loop:
 309+ 6CCF
 310+ 6CCF                  ; ---------------------------------------------------------------
 311+ 6CCF                  ; Legge il Room ID del record corrente
 312+ 6CCF                  ; ---------------------------------------------------------------
 313+ 6CCF 7E               ld   a, (hl)
 314+ 6CD0
 315+ 6CD0                  ; $FF indica fine tabella
 316+ 6CD0 FE FF            cp   $FF
 317+ 6CD2 28 53            jr   z, .done
 318+ 6CD4
 319+ 6CD4                  ; ---------------------------------------------------------------
 320+ 6CD4                  ; Verifica se l'item appartiene alla stanza corrente
 321+ 6CD4                  ; ---------------------------------------------------------------
 322+ 6CD4 57               ld   d, a
 323+ 6CD5
 324+ 6CD5 3A DE 7D         ld   a, (current_room)
 325+ 6CD8 BA               cp   d
 326+ 6CD9 20 45            jr   nz, .next_item
 327+ 6CDB
 328+ 6CDB                  ; ---------------------------------------------------------------
 329+ 6CDB                  ; Legge i dati dell'item
 330+ 6CDB                  ; ---------------------------------------------------------------
 331+ 6CDB
 332+ 6CDB 23               inc  hl
 333+ 6CDC 4E               ld   c, (hl)           ; X (colonna)
 334+ 6CDD
 335+ 6CDD 23               inc  hl
 336+ 6CDE 46               ld   b, (hl)           ; Y (riga)
 337+ 6CDF
 338+ 6CDF 23               inc  hl
 339+ 6CE0 5E               ld   e, (hl)           ; Colore
 340+ 6CE1
 341+ 6CE1 23               inc  hl
 342+ 6CE2 7E               ld   a, (hl)           ; Collected flag
 343+ 6CE3
 344+ 6CE3                  ; Se diverso da zero l'item è già stato raccolto
 345+ 6CE3 B7               or   a
 346+ 6CE4 20 3E            jr   nz, .next_no_inc
 347+ 6CE6
 348+ 6CE6                  ; ---------------------------------------------------------------
 349+ 6CE6                  ; Disegna l'item sullo schermo
 350+ 6CE6                  ;
 351+ 6CE6                  ; B = Row
 352+ 6CE6                  ; C = Column
 353+ 6CE6                  ; HL = bitmap pointer
 354+ 6CE6                  ; E = Color
 355+ 6CE6                  ; ---------------------------------------------------------------
 356+ 6CE6 E5               push hl
 357+ 6CE7
 358+ 6CE7 DD E5            push ix
 359+ 6CE9 E1               pop  hl
 360+ 6CEA
 361+ 6CEA CD 2F 6D         call DrawItemGraphic
 362+ 6CED
 363+ 6CED E1               pop  hl                ; ritorna al flag collected
 364+ 6CEE
 365+ 6CEE                  ; ---------------------------------------------------------------
 366+ 6CEE                  ; Aggiorna items_grid
 367+ 6CEE                  ;
 368+ 6CEE                  ; Calcolo:
 369+ 6CEE                  ;   offset = Row * 32 + Col
 370+ 6CEE                  ; ---------------------------------------------------------------
 371+ 6CEE E5               push hl
 372+ 6CEF D5               push de
 373+ 6CF0
 374+ 6CF0 26 00            ld   h, 0
 375+ 6CF2 68               ld   l, b              ; HL = Row
 376+ 6CF3
 377+ 6CF3 29               add  hl, hl            ; *2
 378+ 6CF4 29               add  hl, hl            ; *4
 379+ 6CF5 29               add  hl, hl            ; *8
 380+ 6CF6 29               add  hl, hl            ; *16
 381+ 6CF7 29               add  hl, hl            ; *32
 382+ 6CF8
 383+ 6CF8 16 00            ld   d, 0
 384+ 6CFA 59               ld   e, c              ; DE = Col
 385+ 6CFB
 386+ 6CFB 19               add  hl, de            ; Row*32 + Col
 387+ 6CFC
 388+ 6CFC 11 00 90         ld   de, items_grid
 389+ 6CFF 19               add  hl, de            ; puntatore nella griglia
 390+ 6D00
 391+ 6D00 D1               pop  de                ; ripristina colore
 392+ 6D01
 393+ 6D01 73               ld   (hl), e           ; salva colore cella
 394+ 6D02
 395+ 6D02 E1               pop  hl
 396+ 6D03
 397+ 6D03                  ; ---------------------------------------------------------------
 398+ 6D03                  ; Salva l'item nella cache della stanza
 399+ 6D03                  ;
 400+ 6D03                  ; Questo evita di dover scansionare tutta ItemsTable
 401+ 6D03                  ; durante il controllo delle collisioni.
 402+ 6D03                  ; ---------------------------------------------------------------
 403+ 6D03
 404+ 6D03 FD 71 00         ld   (iy+0), c         ; Colonna
 405+ 6D06 FD 70 01         ld   (iy+1), b         ; Riga
 406+ 6D09 FD 73 02         ld   (iy+2), e         ; Colore
 407+ 6D0C
 408+ 6D0C                  ; Salva il puntatore al flag "collected"
 409+ 6D0C FD 75 03         ld   (iy+3), l         ; Low byte
 410+ 6D0F FD 74 04         ld   (iy+4), h         ; High byte
 411+ 6D12
 412+ 6D12                  ; Passa al record successivo della cache
 413+ 6D12 01 05 00         ld   bc, 5
 414+ 6D15 FD 09            add  iy, bc
 415+ 6D17
 416+ 6D17                  ; Incrementa il numero di item attivi
 417+ 6D17 3A 37 7E         ld   a, (num_room_items)
 418+ 6D1A 3C               inc  a
 419+ 6D1B 32 37 7E         ld   (num_room_items), a
 420+ 6D1E
 421+ 6D1E 18 04            jr   .next_no_inc
 422+ 6D20
 423+ 6D20              .next_item:
 424+ 6D20
 425+ 6D20                  ; ---------------------------------------------------------------
 426+ 6D20                  ; L'item non appartiene alla stanza corrente.
 427+ 6D20                  ; Salta i campi del record:
 428+ 6D20                  ;   X
 429+ 6D20                  ;   Y
 430+ 6D20                  ;   Color
 431+ 6D20                  ;   Collected
 432+ 6D20                  ; ---------------------------------------------------------------
 433+ 6D20 23               inc  hl
 434+ 6D21 23               inc  hl
 435+ 6D22 23               inc  hl
 436+ 6D23 23               inc  hl
 437+ 6D24
 438+ 6D24              .next_no_inc:
 439+ 6D24
