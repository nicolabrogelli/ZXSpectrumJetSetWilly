 913+ 7E6E DD 7E 07         ld   a, (ix+7)         ; Anim State
 914+ 7E71 3C               inc  a
 915+ 7E72 E6 01            and  1                 ; Alterna 0..1
 916+ 7E74 DD 77 07         ld   (ix+7), a
 917+ 7E77 18 09            jr   .anim_done
 918+ 7E79
 919+ 7E79              .canguro_anim:
 920+ 7E79 DD 7E 07         ld   a, (ix+7)         ; Anim State
 921+ 7E7C 3C               inc  a
