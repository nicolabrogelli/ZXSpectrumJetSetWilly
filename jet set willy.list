 387+ 5F77 C5               push bc            ; Salva il contatore delle linee (C) e lo shift (B)
 388+ 5F78 47               ld   b, a          ; B = contatore shift
 389+ 5F79 AF               xor  a             ; A = terzo byte (inizializzato a 0)
 390+ 5F7A
 391+ 5F7A              .shift_loop:
 392+ 5F7A CB 3A            srl  d
