 125+ 750C 21 39 75         ld   hl, Audio_MusicSheet
 126+ 750F 19               add  hl, de
 127+ 7510 19               add  hl, de                   ; hl punta al primo byte della nota
 128+ 7511 7E               ld   a, (hl)                  ; A = delay
 129+ 7512 B7               or   a
 130+ 7513 28 1F            jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 131+ 7515
 132+ 7515                  ; Suona la nota: 2 cicli
 133+ 7515 57               ld   d, a                     ; D = delay
 134+ 7516 06 02            ld   b, 2                     ; 2 cicli per frame
 135+ 7518              .note_loop:
 136+ 7518                  ; Speaker ON
 137+ 7518 3A AC 75         ld   a, (room_border_color)
 138+ 751B F6 10            or   $10
 139+ 751D D3 FE            out  ($fe), a
 140+ 751F 4A               ld   c, d
