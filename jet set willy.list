 125+ 75C3              ; -------------------------------------------------------------------
 126+ 75C3              ; DetermineCurrentRoomID
 127+ 75C3              ;
 128+ 75C3              ; Determina l'ID numerico della stanza corrente confrontando
 129+ 75C3              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 130+ 75C3              ;
 131+ 75C3              ; Se viene trovata una corrispondenza:
 132+ 75C3              ;   A = ID della stanza
 133+ 75C3              ;   current_room = A
 134+ 75C3              ;
 135+ 75C3              ; Mappatura:
 136+ 75C3              ;    0 = The Off Licence
 137+ 75C3              ;    1 = The Bridge
 138+ 75C3              ;    2 = Under The Mega Tree
 139+ 75C3              ;    3 = Gfx_At The Foot Of The Mega Tree
 140+ 75C3              ;    4 = The Drive
 141+ 75C3              ;    5 = The Security Guard
 142+ 75C3              ;    6 = Entrance To Hades
 143+ 75C3              ;    7 = Cuckoo's Nest
 144+ 75C3              ;    8 = Inside The Mega Trunk
 145+ 75C3              ;    9 = On A Branch Over The Drive
 146+ 75C3              ;   10 = The Front Door
 147+ 75C3              ;   11 = The Hall
 148+ 75C3              ;   12 = Tree Top
 149+ 75C3              ;   27 = The Chapel
 150+ 75C3              ;   28 = First Landing
 151+ 75C3              ;   29 = The Nightmare Room
 152+ 75C3              ;   33 = The Bathroom
 153+ 75C3              ;   35 = Master Bedroom
 154+ 75C3              ;
 155+ 75C3              ; Se nessuna stanza corrisponde viene impostato:
 156+ 75C3              ;   current_room = 0
 157+ 75C3              ; -------------------------------------------------------------------
 158+ 75C3              DetermineCurrentRoomID:
 159+ 75C3
 160+ 75C3                  ; Salva i registri utilizzati
 161+ 75C3 E5               push hl
 162+ 75C4 D5               push de
 163+ 75C5
 164+ 75C5                  ; ---------------------------------------------------------------
 165+ 75C5                  ; Confronto con TheOffLicenceLayout
 166+ 75C5                  ; ---------------------------------------------------------------
 167+ 75C5 2A B4 7E         ld   hl, (room_ptr)
 168+ 75C8 11 00 84         ld   de, TheOffLicenceLayout
 169+ 75CB B7               or   a
 170+ 75CC ED 52            sbc  hl, de
 171+ 75CE 20 05            jr   nz, .not_office
 172+ 75D0
 173+ 75D0 3E 00            ld   a, 0               ; Room ID = 0
 174+ 75D2 C3 57 78         jp   .set_room
 175+ 75D5
 176+ 75D5              .not_office:
 177+ 75D5
 178+ 75D5                  ; -------------------------------------------------q--------------
 179+ 75D5                  ; Confronto con TheBridgeLayout
 180+ 75D5                  ; ---------------------------------------------------------------
 181+ 75D5 2A B4 7E         ld   hl, (room_ptr)
 182+ 75D8 11 1E 85         ld   de, TheBridgeLayout
 183+ 75DB B7               or   a
 184+ 75DC ED 52            sbc  hl, de
 185+ 75DE 20 05            jr   nz, .not_bridge
 186+ 75E0
 187+ 75E0 3E 01            ld   a, 1               ; Room ID = 1
 188+ 75E2 C3 57 78         jp   .set_room
 189+ 75E5
 190+ 75E5              .not_bridge:
 191+ 75E5
 192+ 75E5                  ; ---------------------------------------------------------------
