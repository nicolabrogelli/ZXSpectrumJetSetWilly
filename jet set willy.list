1231+ 8360
1232+ 8360                  ; ---------------------------------------------------------------
1233+ 8360                  ; Aggiorna items_grid
1234+ 8360                  ;
1235+ 8360                  ; Calcolo:
1236+ 8360                  ;   offset = Row * 32 + Col
1237+ 8360                  ; ---------------------------------------------------------------
1238+ 8360 E5               push hl
1239+ 8361 D5               push de
1240+ 8362
1241+ 8362 26 00            ld   h, 0
1242+ 8364 68               ld   l, b              ; HL = Row
1243+ 8365
1244+ 8365 29               add  hl, hl            ; *2
1245+ 8366 29               add  hl, hl            ; *4
1246+ 8367 29               add  hl, hl            ; *8
1247+ 8368 29               add  hl, hl            ; *16
1248+ 8369 29               add  hl, hl            ; *32
1249+ 836A
1250+ 836A 16 00            ld   d, 0
