  40+ 796D                  ; 2. Imposta HL all'indirizzo dei dati dei nemici (room_ptr + 240)
  41+ 796D 2A 01 F0         ld   hl, (room_ptr)
  42+ 7970 11 F0 00         ld   de, 240           ; Offset degli enemy nella stanza
  43+ 7973 19               add  hl, de            ; HL = indirizzo di RoomXEnemy1
  44+ 7974
  45+ 7974 11 06 79         ld   de, ActiveEnemies
  46+ 7977 06 08            ld   b, 8              ; 8 slot per stanza
  47+ 7979              .loop:
