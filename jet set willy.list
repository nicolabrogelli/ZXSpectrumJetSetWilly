 174+ 7A1B              ; Audio_PlayCollectSound
 175+ 7A1B              ;
 176+ 7A1B              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 177+ 7A1B              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 178+ 7A1B              ; -------------------------------------------------------------------
 179+ 7A1B              Audio_PlayCollectSound:
 180+ 7A1B C5               push bc
 181+ 7A1C D5               push de
 182+ 7A1D
 183+ 7A1D 06 78            ld   b, 120
 184+ 7A1F              .sound_loop:
 185+ 7A1F 3A 48 7A         ld   a, (room_border_color)
 186+ 7A22 F6 10            or   $10               ; speaker ON
 187+ 7A24 D3 FE            out  ($fe), a
 188+ 7A26
 189+ 7A26 0E 3C            ld   c, 60
 190+ 7A28              .d1:
 191+ 7A28 0D               dec  c
 192+ 7A29 20 FD            jr   nz, .d1
 193+ 7A2B
 194+ 7A2B 3A 48 7A         ld   a, (room_border_color)
 195+ 7A2E E6 EF            and  $ef              ; speaker OFF
 196+ 7A30 D3 FE            out  ($fe), a
 197+ 7A32
 198+ 7A32 0E 3C            ld   c, 60
 199+ 7A34              .d2:
 200+ 7A34 0D               dec  c
 201+ 7A35 20 FD            jr   nz, .d2
 202+ 7A37
 203+ 7A37 10 E6            djnz .sound_loop
 204+ 7A39
 205+ 7A39 D1               pop  de
 206+ 7A3A C1               pop  bc
 207+ 7A3B C9               ret
