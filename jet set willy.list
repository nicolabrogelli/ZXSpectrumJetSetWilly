1384+ 6CB8 7E               ld   a, (hl)
1385+ 6CB9 B7               or   a
1386+ 6CBA 20 0C            jr   nz, .custom_settings
1387+ 6CBC
1388+ 6CBC 3E 06            ld   a, 6
1389+ 6CBE 32 DF 76         ld   (room_jump_strength), a
1390+ 6CC1 3E 01            ld   a, 1
1391+ 6CC3 32 E0 76         ld   (room_gravity_preset), a
1392+ 6CC6 18 12            jr   .done
1393+ 6CC8
1394+ 6CC8              .custom_settings:
1395+ 6CC8 F5               push af
1396+ 6CC9 E6 0F            and  $0f                  ; Maschera i 4 bit inferiori (JJJJ)
1397+ 6CCB 32 DF 76         ld   (room_jump_strength), a
