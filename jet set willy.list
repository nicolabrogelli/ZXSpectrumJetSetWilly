 196+ 75E8 11 3C 86         ld   de, UnderTheMegaTreeLayout
 197+ 75EB B7               or   a
 198+ 75EC ED 52            sbc  hl, de
 199+ 75EE 20 05            jr   nz, .not_undertree
 200+ 75F0
 201+ 75F0 3E 02            ld   a, 2               ; Room ID = 2
 202+ 75F2 C3 57 78         jp   .set_room
 203+ 75F5
 204+ 75F5              .not_undertree:
