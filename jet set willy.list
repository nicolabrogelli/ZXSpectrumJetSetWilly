 932+ 6B08                  ; Calcola B = Col - ramp_col
 933+ 6B08 7B               ld   a, e
 934+ 6B09 90               sub  b
 935+ 6B0A 47               ld   b, a              ; B = offset (0..ramp_len-1)
 936+ 6B0B
