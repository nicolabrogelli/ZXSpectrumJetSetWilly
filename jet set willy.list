   8+ 5DAD              SetupIM2:
   9+ 5DAD F3               di
  10+ 5DAE 11 00 FE         ld de,IM2_TABLE
  11+ 5DB1 21 FD FD         ld hl,IM2_VECTOR
  12+ 5DB4 7A               ld a,d
  13+ 5DB5 ED 47            ld i,a
  14+ 5DB7 7D               ld a,l
  15+ 5DB8              .fill_loop:
  16+ 5DB8 12               ld (de),a
  17+ 5DB9 1C               inc e
  18+ 5DBA C2 B8 5D         jp nz,.fill_loop
  19+ 5DBD 14               inc d
  20+ 5DBE 12               ld (de),a
  21+ 5DBF 36 C3            ld (hl),$C3
  22+ 5DC1 2C               inc l
  23+ 5DC2 36 CB            ld (hl),low im2_handler
  24+ 5DC4 2C               inc l
  25+ 5DC5 36 5D            ld (hl),high im2_handler
  26+ 5DC7 ED 5E            im 2
  27+ 5DC9 FB               ei
  28+ 5DCA C9               ret
  29+ 5DCB
  30+ 5DCB              ; -------------------------------------------------------------------
  31+ 5DCB              ; Handler interrupt IM2
