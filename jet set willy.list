1912+ 7A32
1913+ 7A32 ED 4B E8 F7      ld   bc, (PlayerPos)   ; B = Y, C = X
1914+ 7A36
1915+ 7A36                  ; Punto 1: Top-Left (X, Y)
1916+ 7A36 CD 08 7A         call CheckNastyCell
1917+ 7A39 38 38            jr   c, .collision
1918+ 7A3B
1919+ 7A3B                  ; Punto 2: Top-Right (X + 7, Y)
1920+ 7A3B 79               ld   a, c
1921+ 7A3C C6 07            add  a, 7
1922+ 7A3E 4F               ld   c, a
1923+ 7A3F CD 08 7A         call CheckNastyCell
1924+ 7A42 38 2F            jr   c, .collision
1925+ 7A44
1926+ 7A44                  ; Punto 3: Mid-Left (X, Y + 7)
1927+ 7A44 ED 4B E8 F7      ld   bc, (PlayerPos)
1928+ 7A48 78               ld   a, b
1929+ 7A49 C6 07            add  a, 7
1930+ 7A4B 47               ld   b, a
1931+ 7A4C CD 08 7A         call CheckNastyCell
1932+ 7A4F 38 22            jr   c, .collision
1933+ 7A51
1934+ 7A51                  ; Punto 4: Mid-Right (X + 7, Y + 7)
1935+ 7A51 79               ld   a, c
1936+ 7A52 C6 07            add  a, 7
1937+ 7A54 4F               ld   c, a
1938+ 7A55 CD 08 7A         call CheckNastyCell
1939+ 7A58 38 19            jr   c, .collision
1940+ 7A5A
1941+ 7A5A                  ; Punto 5: Bottom-Left (X, Y + 15)
1942+ 7A5A ED 4B E8 F7      ld   bc, (PlayerPos)
1943+ 7A5E 78               ld   a, b
1944+ 7A5F C6 0F            add  a, 15
1945+ 7A61 47               ld   b, a
1946+ 7A62 CD 08 7A         call CheckNastyCell
1947+ 7A65 38 0C            jr   c, .collision
1948+ 7A67
1949+ 7A67                  ; Punto 6: Bottom-Right (X + 7, Y + 15)
1950+ 7A67 79               ld   a, c
1951+ 7A68 C6 07            add  a, 7
1952+ 7A6A 4F               ld   c, a
1953+ 7A6B CD 08 7A         call CheckNastyCell
1954+ 7A6E 38 03            jr   c, .collision
1955+ 7A70
1956+ 7A70 C1               pop  bc
1957+ 7A71 B7               or   a                 ; Clear carry
1958+ 7A72 C9               ret
1959+ 7A73
1960+ 7A73              .collision:
1961+ 7A73 C1               pop  bc
1962+ 7A74 37               scf                    ; Set carry
1963+ 7A75 C9               ret
