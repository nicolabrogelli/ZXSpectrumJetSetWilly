 112  88F2                  ; 2. Rendering del giocatore (ridisegna Willy in primo piano se mosso o se coperto da un guardiano)
 113  88F2 CD B9 60         call Gfx_UpdatePlayer
 114  88F5
 115  88F5                  ; 3. Scorrimento dell'orologio di gioco (1 min di gioco = 40 sec reali)
 116  88F5 CD D2 8C         call Time_UpdateClock
 117  88F8
 118  88F8                  ; 2. Aggiornamento audio
 119  88F8                  IF ENABLE_EFFECTS != 0
 120  88F8 ~                call Audio_UpdateJumpSound    ; Aggiorna l'effetto sonoro del salto
 121  88F8                  ENDIF
 122  88F8
 123  88F8                  IF ENABLE_MUSIC != 0
 124  88F8 ~                call Audio_UpdateMusic        ; Aggiorna la musica
 125  88F8                  ENDIF
 126  88F8
 127  88F8                  ; Se l'animazione delle vite è abilitata, aggiorna la visualizzazione delle icone camminanti
 128  88F8                  IF ENABLE_ANIMATE_LIVES != 0
 129  88F8 ~                call Gfx_PrintWillyLives
 130  88F8                  ENDIF
 131  88F8
 132  88F8
 133  88F8                  ; 3. Salva le posizioni correnti del player per il prossimo frame
 134  88F8 ED 4B 57 F4      ld   bc, (PlayerPos)
 135  88FC ED 43 59 F4      ld   (PlayerPosOld), bc
 136  8900
 137  8900                  ; 4. Aggiorna le posizioni dei personaggi per il prossimo frame
 138  8900 CD 43 6E         call Input_CheckCtrl
 139  8903 CD 1D 6D         call MovePlayer
 140  8906 CD E4 71         call Phys_ApplyGravity
 141  8909 CD B3 75         call Phys_ApplyConveyor
 142  890C CD 90 7F         call Enemy_Update
 143  890F CD 71 87         call Items_CheckCollision
 144  8912
 145  8912                  ; Controlla condizione di vittoria (Tutti gli item + Master Bedroom + Conveyor)
 146  8912                  IF ENABLE_VICTORY_SCREEN != 0
 147  8912 CD 9D 8B         call CheckVictoryCondition
 148  8915 DA 1F 8B         jp   c, TriggerVictory
 149  8918                  ENDIF
 150  8918
 151  8918                  ; Controlla collisione con Nasties (morte di Willy)
 152  8918                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 153  8918 CD 31 7A         call Phys_CheckNastyCollision
 154  891B 38 0B            jr   c, .willy_dies
 155  891D                  ENDIF
 156  891D
 157  891D                  ; Controlla collisione con guardiani
 158  891D CD 2A 75         call CheckCollision
 159  8920 38 03            jr   c, .guardian_collision_found
 160  8922
 161  8922                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 162  8922                  IF ENABLE_RAMP_DEBUG_BARS != 0
 163  8922 ~                ld   a, (willy_on_ramp)
 164  8922 ~                or   a
 165  8922 ~                jp   nz, .draw_raster_bars
 166  8922                  ENDIF
 167  8922
 168  8922 C3 9F 89         jp   .no_collision
 169  8925
 170  8925              .guardian_collision_found:
 171  8925                  ; C'è collisione con un guardiano!
 172  8925                  ; Controlla se la morte per collisione con i guardiani è abilitata
 173  8925                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 174  8925 C3 28 89         jp   .willy_dies
 175  8928                  ELSE
 176  8928 ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 177  8928 ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 178  8928 ~                    ELSE
 179  8928 ~                    jp   .no_collision
 180  8928 ~                    ENDIF
 181  8928                  ENDIF
 182  8928
 183  8928              .willy_dies:
 184  8928                  ; 1. Decrementa le vite
 185  8928 21 64 F4         ld   hl, willy_lives
 186  892B 7E               ld   a, (hl)
 187  892C B7               or   a
 188  892D 28 05            jr   z, .check_game_over
 189  892F 35               dec  (hl)
 190  8930 28 02            jr   z, .check_game_over
 191  8932 18 03            jr   .normal_respawn
 192  8934
 193  8934              .check_game_over:
 194  8934                  IF ENABLE_GAME_OVER_RESTART != 0
 195  8934 C3 F6 89         jp   TriggerGameOver
 196  8937                  ELSE
 197  8937 ~                ld   a, 1
 198  8937 ~                ld   (willy_lives), a
 199  8937 ~                jr   .normal_respawn
 200  8937                  ENDIF
 201  8937
 202  8937              .normal_respawn:
 203  8937                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 204  8937 AF               xor  a
 205  8938 D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 206  893A 21 8D 5C         ld   hl, ATTR_P
 207  893D 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 208  893E CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 209  8941 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 210  8943 3E 07            ld   a, $07
 211  8945 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 212  8948
 213  8948                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 214  8948 06 19            ld   b, 25
 215  894A              .death_pause:
 216  894A 76               halt
 217  894B 10 FD            djnz .death_pause
 218  894D
 219  894D                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 220  894D AF               xor  a
 221  894E 32 65 F4         ld   (velocity_y), a
 222  8951 32 67 F4         ld   (jump_pressed), a
 223  8954 32 69 F4         ld   (coyote_timer), a
 224  8957 32 6C F4         ld   (jump_frame), a
 225  895A 32 6B F4         ld   (jump_dir), a
 226  895D 3E 01            ld   a, 1
 227  895F 32 66 F4         ld   (on_ground), a
 228  8962
 229  8962 3E 00            ld   a, RESPAWN_SAFETY_TIME
 230  8964 32 61 F8         ld   (willy_safety_timer), a
 231  8967
 232  8967                  ; 5. Riposiziona Willy nel punto di ingresso dell'ultima stanza raggiunta
 233  8967 CD 3E 82         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 234  896A 21 DE F7         ld   hl, room_entry_positions
 235  896D 5F               ld   e, a
 236  896E 16 00            ld   d, 0
 237  8970 19               add  hl, de
 238  8971 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 239  8972 4E               ld   c, (hl)                   ; C = X ingresso
 240  8973 23               inc  hl
 241  8974 46               ld   b, (hl)                   ; B = Y ingresso
 242  8975 ED 43 57 F4      ld   (PlayerPos), bc           ; Imposta le coordinate di respawn al punto di ingresso
 243  8979 ED 43 59 F4      ld   (PlayerPosOld), bc
 244  897D
 245  897D 3E 01            ld   a, 1
 246  897F 32 DD F7         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 247  8982
 248  8982                  ; 6. Ridisegna completamente la stanza e riposiziona Willy nel punto di ingresso
 249  8982 C3 89 88         jp   LoadRoomAndRestart
 250  8985
 251  8985              .draw_raster_bars:
 252  8985                  ; Collisione attiva: disegna le raster bar nel bordo
 253  8985 3A 78 F4         ld   a, (counter)
 254  8988 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 255  898A 06 1E            ld   b, 30             ; Numero di righe della barra raster
 256  898C              .raster_loop:
 257  898C D3 FE            out  ($fe), a
 258  898E 3C               inc  a
 259  898F E6 07            and  7
 260  8991 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 261  8993              .delay:
 262  8993 0D               dec  c
 263  8994 20 FD            jr   nz, .delay
 264  8996 10 F4            djnz .raster_loop
 265  8998
 266  8998                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 267  8998 3A 63 F4         ld   a, (room_border_color)
 268  899B D3 FE            out  ($fe), a
 269  899D 18 05            jr   .no_collision_change
 270  899F
 271  899F              .no_collision:
 272  899F                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 273  899F 3A 63 F4         ld   a, (room_border_color)
 274  89A2 D3 FE            out  ($fe), a
 275  89A4
 276  89A4              .no_collision_change:
 277  89A4 C3 CF 88         jp   Main_loop
 278  89A7
 279  89A7              ; -------------------------------------------------------------------
 280  89A7              ; ShowTitleScreen
 281  89A7              ; Visualizza la schermata iniziale del gioco (Title Screen).
 282  89A7              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 283  89A7              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 284  89A7              ; -------------------------------------------------------------------
 285  89A7              ShowTitleScreen:
 286  89A7                  ; 1. Disegna la schermata iniziale
 287  89A7 CD 1B 63         call Gfx_DrawTitleScreen
 288  89AA
 289  89AA                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 290  89AA              .wait_title_enter_release:
 291  89AA 76               halt
 292  89AB 3E BF            ld   a, $bf
 293  89AD DB FE            in   a, ($fe)
 294  89AF 1F               rra
 295  89B0 30 F8            jr   nc, .wait_title_enter_release
 296  89B2
 297  89B2                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 298  89B2 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 299  89B4              .title_loop:
 300  89B4 76               halt
 301  89B5
 302  89B5                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 303  89B5 0C               inc  c
 304  89B6 79               ld   a, c
 305  89B7 CB 3F            srl  a
 306  89B9 CB 3F            srl  a
 307  89BB CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 308  89BD E6 07            and  7
 309  89BF 5F               ld   e, a
 310  89C0 16 00            ld   d, 0
 311  89C2 21 13 63         ld   hl, title_color_table
 312  89C5 19               add  hl, de
 313  89C6 7E               ld   a, (hl)               ; A = nuovo colore
 314  89C7 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 315  89CA 06 20            ld   b, 32
 316  89CC              .color_title_loop:
 317  89CC 77               ld   (hl), a
 318  89CD 23               inc  hl
 319  89CE 10 FC            djnz .color_title_loop
 320  89D0
 321  89D0                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 322  89D0 3E BF            ld   a, $bf
 323  89D2 DB FE            in   a, ($fe)
 324  89D4 1F               rra
 325  89D5 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 326  89D7
 327  89D7                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 328  89D7              .wait_title_enter_release_after:
 329  89D7 76               halt
 330  89D8 3E BF            ld   a, $bf
 331  89DA DB FE            in   a, ($fe)
 332  89DC 1F               rra
 333  89DD 30 F8            jr   nc, .wait_title_enter_release_after
 334  89DF
 335  89DF                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 336  89DF AF               xor  a
 337  89E0 D3 FE            out  ($fe), a              ; Bordo a nero
 338  89E2 21 8D 5C         ld   hl, ATTR_P
 339  89E5 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 340  89E6 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 341  89E9 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 342  89EB 3E 07            ld   a, $07
 343  89ED 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 344  89F0
 345  89F0                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 346  89F0 CD 57 8C         call ResetFullGameState
 347  89F3
 348  89F3                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 349  89F3 C3 89 88         jp   LoadRoomAndRestart
 350  89F6
 351  89F6              ; -------------------------------------------------------------------
 352  89F6              ; TriggerGameOver
 353  89F6              ; Scatena la schermata di Game Over per la stanza corrente.
 354  89F6              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 355  89F6              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 356  89F6              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 357  89F6              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 358  89F6              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 359  89F6              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 360  89F6              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 361  89F6              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 362  89F6              ; -------------------------------------------------------------------
 363  89F6              TriggerGameOver:
 364  89F6                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 365  89F6 CD FC 64         call Gfx_DrawGameOverScreen
 366  89F9
 367  89F9                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 368  89F9              .wait_keys_release:
 369  89F9 76               halt
 370  89FA                  ; Controlla tasto Y (Porta $DF, bit 4)
 371  89FA 01 FE DF         ld   bc, $dffe
 372  89FD ED 78            in   a, (c)
 373  89FF CB 67            bit  4, a
 374  8A01 28 F6            jr   z, .wait_keys_release
 375  8A03
 376  8A03                  ; Controlla tasto N (Porta $7F, bit 3)
 377  8A03 01 FE 7F         ld   bc, $7ffe
 378  8A06 ED 78            in   a, (c)
 379  8A08 CB 5F            bit  3, a
 380  8A0A 28 ED            jr   z, .wait_keys_release
 381  8A0C
 382  8A0C                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 383  8A0C 01 FE BF         ld   bc, $bffe
 384  8A0F ED 78            in   a, (c)
 385  8A11 CB 47            bit  0, a
 386  8A13 28 E4            jr   z, .wait_keys_release
 387  8A15
 388  8A15                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 389  8A15 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 390  8A17              .wait_choice_loop:
 391  8A17 76               halt
 392  8A18
 393  8A18                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 394  8A18 0C               inc  c
 395  8A19 79               ld   a, c
 396  8A1A CB 3F            srl  a
 397  8A1C CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 398  8A1E E6 07            and  7
 399  8A20 5F               ld   e, a
 400  8A21 16 00            ld   d, 0
 401  8A23 21 B8 64         ld   hl, game_over_color_table
 402  8A26 19               add  hl, de
 403  8A27 7E               ld   a, (hl)               ; A = nuovo colore attributo
 404  8A28 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 405  8A2B 06 09            ld   b, 9
