 787+ 6129                  ; 2. Calcola riga di layout: r = H - 3
 788+ 6129 D6 03            sub  3
 789+ 612B
 790+ 612B                  ; 3. HL = r * 8
 791+ 612B 6F               ld   l, a
 792+ 612C 26 00            ld   h, 0
