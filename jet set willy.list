1071+ 7E44 E1               pop  hl
1072+ 7E45
1073+ 7E45 C9               ret
1074+ 7E46
1075+ 7E46              ; -------------------------------------------------------------------
1076+ 7E46              ; Items_DrawRoom
1077+ 7E46              ;
1078+ 7E46              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1079+ 7E46              ;
1080+ 7E46              ; Operazioni eseguite:
1081+ 7E46              ;   1. Azzera la griglia items_grid.
1082+ 7E46              ;   2. Svuota la cache degli oggetti attivi.
1083+ 7E46              ;   3. Scansiona ItemsTable.
1084+ 7E46              ;   4. Per ogni item della stanza corrente:
1085+ 7E46              ;        - verifica se è già stato raccolto
1086+ 7E46              ;        - disegna la grafica
1087+ 7E46              ;        - aggiorna items_grid
1088+ 7E46              ;        - memorizza l'item nella cache current_room_items
1089+ 7E46              ;   5. Aggiorna num_room_items.
1090+ 7E46              ;
1091+ 7E46              ; Record ItemsTable:
1092+ 7E46              ;   +0  Room ID
1093+ 7E46              ;   +1  X (colonna)
1094+ 7E46              ;   +2  Y (riga)
1095+ 7E46              ;   +3  Colore
1096+ 7E46              ;   +4  Collected flag
1097+ 7E46              ;
1098+ 7E46              ; Cache current_room_items:
1099+ 7E46              ;   +0  Colonna
1100+ 7E46              ;   +1  Riga
1101+ 7E46              ;   +2  Colore
1102+ 7E46              ;   +3  Collected flag ptr (Low)
1103+ 7E46              ;   +4  Collected flag ptr (High)
1104+ 7E46              ;
1105+ 7E46              ; Ogni record cache occupa 5 byte.
1106+ 7E46              ; -------------------------------------------------------------------
1107+ 7E46              Items_DrawRoom:
1108+ 7E46
1109+ 7E46                  ; Salva tutti i registri utilizzati
1110+ 7E46 E5               push hl
1111+ 7E47 D5               push de
1112+ 7E48 C5               push bc
1113+ 7E49 DD E5            push ix
1114+ 7E4B FD E5            push iy
1115+ 7E4D
1116+ 7E4D                  ; ---------------------------------------------------------------
1117+ 7E4D                  ; Azzera items_grid (32 x 16 = 512 byte)
1118+ 7E4D                  ; ---------------------------------------------------------------
1119+ 7E4D 21 26 E4         ld   hl, items_grid
1120+ 7E50 11 27 E4         ld   de, items_grid + 1
1121+ 7E53 36 00            ld   (hl), 0
1122+ 7E55 01 FF 01         ld   bc, 511
1123+ 7E58 ED B0            ldir
1124+ 7E5A
1125+ 7E5A                  ; ---------------------------------------------------------------
1126+ 7E5A                  ; Nessun item attivo nella stanza
1127+ 7E5A                  ; ---------------------------------------------------------------
1128+ 7E5A AF               xor  a
1129+ 7E5B 32 A5 E9         ld   (num_room_items), a
1130+ 7E5E
1131+ 7E5E                  ; IY punta alla cache degli item attivi
1132+ 7E5E FD 21 55 E9      ld   iy, current_room_items
1133+ 7E62
1134+ 7E62                  ; ---------------------------------------------------------------
1135+ 7E62                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1136+ 7E62                  ; alla stanza corrente.
1137+ 7E62                  ;
1138+ 7E62                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1139+ 7E62                  ; ---------------------------------------------------------------
1140+ 7E62 2A A6 E9         ld   hl, (room_ptr)
1141+ 7E65 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1142+ 7E68 19               add  hl, de
1143+ 7E69
1144+ 7E69 E5               push hl
1145+ 7E6A DD E1            pop  ix                ; IX = bitmap item
1146+ 7E6C
1147+ 7E6C                  ; ---------------------------------------------------------------
1148+ 7E6C                  ; Inizio scansione della tabella degli item
1149+ 7E6C                  ; ---------------------------------------------------------------
1150+ 7E6C 21 EF 78         ld   hl, ItemsTable
1151+ 7E6F
1152+ 7E6F              .loop:
1153+ 7E6F
1154+ 7E6F                  ; ---------------------------------------------------------------
1155+ 7E6F                  ; Legge il Room ID del record corrente
1156+ 7E6F                  ; ---------------------------------------------------------------
1157+ 7E6F 7E               ld   a, (hl)
1158+ 7E70
1159+ 7E70                  ; $FF indica fine tabella
1160+ 7E70 FE FF            cp   $FF
1161+ 7E72 28 53            jr   z, .done
1162+ 7E74
1163+ 7E74                  ; ---------------------------------------------------------------
1164+ 7E74                  ; Verifica se l'item appartiene alla stanza corrente
1165+ 7E74                  ; ---------------------------------------------------------------
1166+ 7E74 57               ld   d, a
1167+ 7E75
1168+ 7E75 3A 4C E9         ld   a, (current_room)
1169+ 7E78 BA               cp   d
1170+ 7E79 20 45            jr   nz, .next_item
1171+ 7E7B
1172+ 7E7B                  ; ---------------------------------------------------------------
1173+ 7E7B                  ; Legge i dati dell'item
1174+ 7E7B                  ; ---------------------------------------------------------------
1175+ 7E7B
1176+ 7E7B 23               inc  hl
1177+ 7E7C 4E               ld   c, (hl)           ; X (colonna)
1178+ 7E7D
1179+ 7E7D 23               inc  hl
1180+ 7E7E 46               ld   b, (hl)           ; Y (riga)
1181+ 7E7F
1182+ 7E7F 23               inc  hl
1183+ 7E80 5E               ld   e, (hl)           ; Colore
1184+ 7E81
1185+ 7E81 23               inc  hl
1186+ 7E82 7E               ld   a, (hl)           ; Collected flag
1187+ 7E83
1188+ 7E83                  ; Se diverso da zero l'item è già stato raccolto
1189+ 7E83 B7               or   a
1190+ 7E84 20 3E            jr   nz, .next_no_inc
1191+ 7E86
1192+ 7E86                  ; ---------------------------------------------------------------
1193+ 7E86                  ; Disegna l'item sullo schermo
1194+ 7E86                  ;
1195+ 7E86                  ; B = Row
1196+ 7E86                  ; C = Column
1197+ 7E86                  ; HL = bitmap pointer
1198+ 7E86                  ; E = Color
1199+ 7E86                  ; ---------------------------------------------------------------
1200+ 7E86 E5               push hl
1201+ 7E87
1202+ 7E87 DD E5            push ix
1203+ 7E89 E1               pop  hl
1204+ 7E8A
1205+ 7E8A CD CF 7E         call DrawItemGraphic
1206+ 7E8D
1207+ 7E8D E1               pop  hl                ; ritorna al flag collected
1208+ 7E8E
1209+ 7E8E                  ; ---------------------------------------------------------------
1210+ 7E8E                  ; Aggiorna items_grid
1211+ 7E8E                  ;
1212+ 7E8E                  ; Calcolo:
1213+ 7E8E                  ;   offset = Row * 32 + Col
1214+ 7E8E                  ; ---------------------------------------------------------------
1215+ 7E8E E5               push hl
1216+ 7E8F D5               push de
1217+ 7E90
1218+ 7E90 26 00            ld   h, 0
1219+ 7E92 68               ld   l, b              ; HL = Row
1220+ 7E93
1221+ 7E93 29               add  hl, hl            ; *2
1222+ 7E94 29               add  hl, hl            ; *4
1223+ 7E95 29               add  hl, hl            ; *8
1224+ 7E96 29               add  hl, hl            ; *16
1225+ 7E97 29               add  hl, hl            ; *32
1226+ 7E98
1227+ 7E98 16 00            ld   d, 0
1228+ 7E9A 59               ld   e, c              ; DE = Col
1229+ 7E9B
1230+ 7E9B 19               add  hl, de            ; Row*32 + Col
1231+ 7E9C
1232+ 7E9C 11 26 E4         ld   de, items_grid
1233+ 7E9F 19               add  hl, de            ; puntatore nella griglia
1234+ 7EA0
1235+ 7EA0 D1               pop  de                ; ripristina colore
1236+ 7EA1
1237+ 7EA1 73               ld   (hl), e           ; salva colore cella
1238+ 7EA2
1239+ 7EA2 E1               pop  hl
1240+ 7EA3
1241+ 7EA3                  ; ---------------------------------------------------------------
1242+ 7EA3                  ; Salva l'item nella cache della stanza
1243+ 7EA3                  ;
1244+ 7EA3                  ; Questo evita di dover scansionare tutta ItemsTable
1245+ 7EA3                  ; durante il controllo delle collisioni.
1246+ 7EA3                  ; ---------------------------------------------------------------
1247+ 7EA3
1248+ 7EA3 FD 71 00         ld   (iy+0), c         ; Colonna
1249+ 7EA6 FD 70 01         ld   (iy+1), b         ; Riga
1250+ 7EA9 FD 73 02         ld   (iy+2), e         ; Colore
1251+ 7EAC
1252+ 7EAC                  ; Salva il puntatore al flag "collected"
1253+ 7EAC FD 75 03         ld   (iy+3), l         ; Low byte
1254+ 7EAF FD 74 04         ld   (iy+4), h         ; High byte
1255+ 7EB2
1256+ 7EB2                  ; Passa al record successivo della cache
1257+ 7EB2 01 05 00         ld   bc, 5
1258+ 7EB5 FD 09            add  iy, bc
1259+ 7EB7
1260+ 7EB7                  ; Incrementa il numero di item attivi
1261+ 7EB7 3A A5 E9         ld   a, (num_room_items)
1262+ 7EBA 3C               inc  a
1263+ 7EBB 32 A5 E9         ld   (num_room_items), a
1264+ 7EBE
1265+ 7EBE 18 04            jr   .next_no_inc
1266+ 7EC0
1267+ 7EC0              .next_item:
1268+ 7EC0
1269+ 7EC0                  ; ---------------------------------------------------------------
1270+ 7EC0                  ; L'item non appartiene alla stanza corrente.
1271+ 7EC0                  ; Salta i campi del record:
1272+ 7EC0                  ;   X
1273+ 7EC0                  ;   Y
1274+ 7EC0                  ;   Color
1275+ 7EC0                  ;   Collected
1276+ 7EC0                  ; ---------------------------------------------------------------
1277+ 7EC0 23               inc  hl
1278+ 7EC1 23               inc  hl
1279+ 7EC2 23               inc  hl
1280+ 7EC3 23               inc  hl
1281+ 7EC4
1282+ 7EC4              .next_no_inc:
1283+ 7EC4
1284+ 7EC4                  ; ---------------------------------------------------------------
1285+ 7EC4                  ; Avanza al record successivo
1286+ 7EC4                  ; (prossimo Room ID)
1287+ 7EC4                  ; ---------------------------------------------------------------
1288+ 7EC4 23               inc  hl
1289+ 7EC5 18 A8            jr   .loop
1290+ 7EC7
1291+ 7EC7              .done:
1292+ 7EC7
1293+ 7EC7                  ; Ripristina i registri
1294+ 7EC7 FD E1            pop  iy
1295+ 7EC9 DD E1            pop  ix
1296+ 7ECB D1               pop  de
1297+ 7ECC C1               pop  bc
1298+ 7ECD E1               pop  hl
1299+ 7ECE
1300+ 7ECE C9               ret
1301+ 7ECF
1302+ 7ECF              ; -------------------------------------------------------------------
1303+ 7ECF              ; DrawItemGraphic
1304+ 7ECF              ;
1305+ 7ECF              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1306+ 7ECF              ; utilizzando una bitmap di 8 byte e un attributo colore.
1307+ 7ECF              ;
1308+ 7ECF              ; Input:
1309+ 7ECF              ;   B = Riga attributi (3..18)
1310+ 7ECF              ;   C = Colonna attributi (0..31)
1311+ 7ECF              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1312+ 7ECF              ;   E = Attributo colore
1313+ 7ECF              ;
1314+ 7ECF              ; Output:
1315+ 7ECF              ;   Nessuno
1316+ 7ECF              ;
1317+ 7ECF              ; Registri preservati:
1318+ 7ECF              ;   BC, DE, HL
1319+ 7ECF              ; -------------------------------------------------------------------
1320+ 7ECF              DrawItemGraphic:
1321+ 7ECF
1322+ 7ECF                  ; Salva i registri originali
1323+ 7ECF C5               push bc
1324+ 7ED0 D5               push de
1325+ 7ED1 E5               push hl
1326+ 7ED2
1327+ 7ED2                  ; ---------------------------------------------------------------
1328+ 7ED2                  ; Calcolo indirizzo bitmap dello Spectrum
1329+ 7ED2                  ;
1330+ 7ED2                  ; Ogni item occupa una cella attributi (8x8 pixel).
1331+ 7ED2                  ;
1332+ 7ED2                  ; Formula:
1333+ 7ED2                  ;   High = $40 + (Row AND $18)
1334+ 7ED2                  ;   Low  = (Row AND 7) * 32 + Col
1335+ 7ED2                  ;
1336+ 7ED2                  ; DE conterrà l'indirizzo della prima scanline.
1337+ 7ED2                  ; ---------------------------------------------------------------
1338+ 7ED2
1339+ 7ED2 78               ld   a, b
1340+ 7ED3 E6 18            and  $18
1341+ 7ED5 C6 40            add  a, $40
1342+ 7ED7 57               ld   d, a              ; Byte alto indirizzo video
1343+ 7ED8
1344+ 7ED8 78               ld   a, b
1345+ 7ED9 E6 07            and  7                 ; Riga interna al blocco da 8
1346+ 7EDB
1347+ 7EDB 87               add  a, a              ; *2
1348+ 7EDC 87               add  a, a              ; *4
1349+ 7EDD 87               add  a, a              ; *8
1350+ 7EDE 87               add  a, a              ; *16
1351+ 7EDF 87               add  a, a              ; *32
1352+ 7EE0
1353+ 7EE0 81               add  a, c              ; + colonna
1354+ 7EE1
1355+ 7EE1 5F               ld   e, a              ; Byte basso indirizzo video
1356+ 7EE2
1357+ 7EE2                  ; ---------------------------------------------------------------
1358+ 7EE2                  ; Disegno bitmap
1359+ 7EE2                  ;
1360+ 7EE2                  ; Copia 8 byte consecutivi nella memoria video.
1361+ 7EE2                  ; Ogni byte rappresenta una scanline da 8 pixel.
1362+ 7EE2                  ; ---------------------------------------------------------------
1363+ 7EE2
1364+ 7EE2 C5               push bc                ; Conserva Row e Col
1365+ 7EE3
1366+ 7EE3 06 08            ld   b, 8              ; Numero scanline
1367+ 7EE5
1368+ 7EE5              .line_loop:
1369+ 7EE5
1370+ 7EE5 7E               ld   a, (hl)           ; Legge scanline bitmap
1371+ 7EE6 12               ld   (de), a           ; Scrive nella memoria video
1372+ 7EE7
1373+ 7EE7 14               inc  d                 ; Scanline successiva
1374+ 7EE8 23               inc  hl                ; Byte bitmap successivo
1375+ 7EE9
1376+ 7EE9 05               dec  b
1377+ 7EEA 20 F9            jr   nz, .line_loop
1378+ 7EEC
1379+ 7EEC C1               pop  bc                ; Ripristina Row e Col
1380+ 7EED
1381+ 7EED                  ; ---------------------------------------------------------------
1382+ 7EED                  ; Calcolo indirizzo attributo
1383+ 7EED                  ;
1384+ 7EED                  ; Formula:
1385+ 7EED                  ;   AttrAddr = $5800 + Row * 32 + Col
1386+ 7EED                  ;
1387+ 7EED                  ; HL conterrà l'indirizzo della cella attributi.
1388+ 7EED                  ; ---------------------------------------------------------------
1389+ 7EED
1390+ 7EED 26 00            ld   h, 0
1391+ 7EEF 68               ld   l, b              ; HL = Row
1392+ 7EF0
1393+ 7EF0 29               add  hl, hl            ; *2
1394+ 7EF1 29               add  hl, hl            ; *4
1395+ 7EF2 29               add  hl, hl            ; *8
1396+ 7EF3 29               add  hl, hl            ; *16
1397+ 7EF4 29               add  hl, hl            ; *32
1398+ 7EF5
1399+ 7EF5 79               ld   a, c              ; A = Colonna
1400+ 7EF6
1401+ 7EF6 85               add  a, l
1402+ 7EF7 6F               ld   l, a
1403+ 7EF8
1404+ 7EF8 30 01            jr   nc, .no_carry
1405+ 7EFA 24               inc  h
1406+ 7EFB
1407+ 7EFB              .no_carry:
1408+ 7EFB
1409+ 7EFB                  ; HL = Row * 32 + Col
1410+ 7EFB
1411+ 7EFB 11 00 58         ld   de, $5800
1412+ 7EFE 19               add  hl, de            ; HL = indirizzo attributi
1413+ 7EFF
1414+ 7EFF                  ; ---------------------------------------------------------------
1415+ 7EFF                  ; Recupera il colore originale dallo stack.
1416+ 7EFF                  ;
1417+ 7EFF                  ; Layout stack:
1418+ 7EFF                  ;   HL originale
1419+ 7EFF                  ;   DE originale (E = colore)
1420+ 7EFF                  ;   BC originale
1421+ 7EFF                  ; ---------------------------------------------------------------
1422+ 7EFF
1423+ 7EFF C1               pop  bc                ; Recupera HL originale
1424+ 7F00 D1               pop  de                ; Recupera DE originale
1425+ 7F01
1426+ 7F01                  ; ---------------------------------------------------------------
1427+ 7F01                  ; Scrive l'attributo colore
1428+ 7F01                  ; ---------------------------------------------------------------
1429+ 7F01
1430+ 7F01 7B               ld   a, e              ; A = colore
1431+ 7F02 77               ld   (hl), a           ; Scrive nella RAM attributi
1432+ 7F03
1433+ 7F03                  ; ---------------------------------------------------------------
1434+ 7F03                  ; Ripristina HL e BC originali
1435+ 7F03                  ; ---------------------------------------------------------------
1436+ 7F03
1437+ 7F03 C5               push bc
1438+ 7F04 E1               pop  hl                ; HL originale
1439+ 7F05
1440+ 7F05 C1               pop  bc                ; BC originale
1441+ 7F06
1442+ 7F06 C9               ret
1443+ 7F07
1444+ 7F07              ; -------------------------------------------------------------------
1445+ 7F07              ; RestoreBackgroundCell
1446+ 7F07              ;
1447+ 7F07              ; Ripristina il contenuto originale di una cella della stanza.
1448+ 7F07              ; Viene utilizzata principalmente quando un item viene raccolto:
1449+ 7F07              ; invece di lasciare un "buco", la routine ridisegna il tile
1450+ 7F07              ; originale presente nella mappa della stanza.
1451+ 7F07              ;
1452+ 7F07              ; Input:
1453+ 7F07              ;   B = Row (3..18)
1454+ 7F07              ;   C = Col (0..31)
1455+ 7F07              ;
1456+ 7F07              ; Utilizza:
1457+ 7F07              ;   room_ptr -> struttura dati della stanza corrente
1458+ 7F07              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1459+ 7F07              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1460+ 7F07              ;
1461+ 7F07              ; Tipi di cella:
1462+ 7F07              ;   0 = Background
1463+ 7F07              ;   1 = Floor
1464+ 7F07              ;   2 = Wall
1465+ 7F07              ;   3 = Nasty
1466+ 7F07              ; -------------------------------------------------------------------
1467+ 7F07              RestoreBackgroundCell:
1468+ 7F07
1469+ 7F07                  ; Salva tutti i registri utilizzati
1470+ 7F07 FD E5            push iy
1471+ 7F09 C5               push bc
1472+ 7F0A D5               push de
1473+ 7F0B E5               push hl
1474+ 7F0C DD E5            push ix
1475+ 7F0E
1476+ 7F0E                  ; ---------------------------------------------------------------
1477+ 7F0E                  ; Conserva Row e Col in IY.
1478+ 7F0E                  ;
1479+ 7F0E                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1480+ 7F0E                  ; BC potrebbe essere modificato.
1481+ 7F0E                  ; ---------------------------------------------------------------
1482+ 7F0E C5               push bc
1483+ 7F0F FD E1            pop  iy                ; IYH = Row, IYL = Col
1484+ 7F11
1485+ 7F11                  ; ---------------------------------------------------------------
1486+ 7F11                  ; Determina quale tipo di cella è presente nella posizione
1487+ 7F11                  ; specificata.
1488+ 7F11                  ;
1489+ 7F11                  ; Input:
1490+ 7F11                  ;   B = Row
1491+ 7F11                  ;   C = Col
1492+ 7F11                  ;
1493+ 7F11                  ; Output:
1494+ 7F11                  ;   A = tipo cella
1495+ 7F11                  ; ---------------------------------------------------------------
1496+ 7F11 78               ld   a, b
1497+ 7F12
1498+ 7F12 CD 48 70         call GetCellFromUnpacked
1499+ 7F15
1500+ 7F15                  ; ---------------------------------------------------------------
1501+ 7F15                  ; Recupera il puntatore alla stanza corrente.
1502+ 7F15                  ;
1503+ 7F15                  ; DE = base della struttura stanza
1504+ 7F15                  ; ---------------------------------------------------------------
1505+ 7F15 ED 5B A6 E9      ld   de, (room_ptr)
1506+ 7F19
1507+ 7F19                  ; ---------------------------------------------------------------
1508+ 7F19                  ; Seleziona il tile corretto in base al tipo di cella.
1509+ 7F19                  ;
1510+ 7F19                  ; A = 0 -> Background
1511+ 7F19                  ; A = 1 -> Floor
1512+ 7F19                  ; A = 2 -> Wall
1513+ 7F19                  ; A = 3 -> Nasty
1514+ 7F19                  ; ---------------------------------------------------------------
1515+ 7F19
1516+ 7F19 B7               or   a
1517+ 7F1A 20 06            jr   nz, .not_bg
1518+ 7F1C
1519+ 7F1C                  ; Background
1520+ 7F1C 21 A0 00         ld   hl, OFFSET_BG
1521+ 7F1F 19               add  hl, de
1522+ 7F20 18 16            jr   .draw_cell
1523+ 7F22
1524+ 7F22              .not_bg:
1525+ 7F22
1526+ 7F22 3D               dec  a
1527+ 7F23 20 06            jr   nz, .not_floor
1528+ 7F25
1529+ 7F25                  ; Floor
1530+ 7F25 21 A9 00         ld   hl, OFFSET_FLOOR
1531+ 7F28 19               add  hl, de
1532+ 7F29 18 0D            jr   .draw_cell
1533+ 7F2B
1534+ 7F2B              .not_floor:
1535+ 7F2B
1536+ 7F2B 3D               dec  a
1537+ 7F2C 20 06            jr   nz, .not_wall
1538+ 7F2E
1539+ 7F2E                  ; Wall
1540+ 7F2E 21 B2 00         ld   hl, OFFSET_WALL
1541+ 7F31 19               add  hl, de
1542+ 7F32 18 04            jr   .draw_cell
1543+ 7F34
1544+ 7F34              .not_wall:
1545+ 7F34
1546+ 7F34                  ; Nasty
1547+ 7F34 21 BB 00         ld   hl, OFFSET_NASTY
1548+ 7F37 19               add  hl, de
1549+ 7F38
1550+ 7F38              .draw_cell:
1551+ 7F38
1552+ 7F38                  ; ---------------------------------------------------------------
1553+ 7F38                  ; HL punta ora alla grafica del tile da ridisegnare.
1554+ 7F38                  ;
1555+ 7F38                  ; Gfx_DrawTile si aspetta:
1556+ 7F38                  ;   IX = puntatore tile
1557+ 7F38                  ;   B  = Row
1558+ 7F38                  ;   C  = Col
1559+ 7F38                  ; ---------------------------------------------------------------
1560+ 7F38 E5               push hl
1561+ 7F39 DD E1            pop  ix
1562+ 7F3B
1563+ 7F3B                  ; Ripristina Row e Col salvati in IY
1564+ 7F3B FD E5            push iy
1565+ 7F3D C1               pop  bc
1566+ 7F3E
1567+ 7F3E                  ; Disegna il tile originale
1568+ 7F3E CD 4D 63         call Gfx_DrawTile
1569+ 7F41
1570+ 7F41                  ; ---------------------------------------------------------------
1571+ 7F41                  ; Ripristina i registri salvati
1572+ 7F41                  ; ---------------------------------------------------------------
1573+ 7F41 DD E1            pop  ix
1574+ 7F43 E1               pop  hl
1575+ 7F44 D1               pop  de
1576+ 7F45 C1               pop  bc
1577+ 7F46 FD E1            pop  iy
1578+ 7F48
1579+ 7F48 C9               ret
1580+ 7F49
1581+ 7F49              ; -------------------------------------------------------------------
1582+ 7F49              ; CheckWillyItemCollision
1583+ 7F49              ;
1584+ 7F49              ; Verifica se Willy collide con un item utilizzando il controllo
1585+ 7F49              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1586+ 7F49              ;
1587+ 7F49              ; Input:
1588+ 7F49              ;   A = ItemX (colonna attributi 0..31)
1589+ 7F49              ;   H = ItemY (riga attributi 3..18)
1590+ 7F49              ;
1591+ 7F49              ; Coordinate item:
1592+ 7F49              ;   Ogni item occupa una cella da 8x8 pixel.
1593+ 7F49              ;
1594+ 7F49              ; Coordinate Willy:
1595+ 7F49              ;   Willy occupa un rettangolo di 16x16 pixel.
1596+ 7F49              ;
1597+ 7F49              ; Output:
1598+ 7F49              ;   Carry Set   = collisione rilevata
1599+ 7F49              ;   Carry Clear = nessuna collisione
1600+ 7F49              ;
1601+ 7F49              ; Registri preservati:
1602+ 7F49              ;   BC, DE, HL
1603+ 7F49              ; -------------------------------------------------------------------
1604+ 7F49              CheckWillyItemCollision:
1605+ 7F49
1606+ 7F49                  ; Salva i registri utilizzati
1607+ 7F49 C5               push bc
1608+ 7F4A D5               push de
1609+ 7F4B E5               push hl
1610+ 7F4C
1611+ 7F4C                  ; ---------------------------------------------------------------
1612+ 7F4C                  ; Calcola il bounding box orizzontale dell'item
1613+ 7F4C                  ;
1614+ 7F4C                  ; ItemLeft  = ItemX * 8
1615+ 7F4C                  ; ItemRight = ItemLeft + 7
1616+ 7F4C                  ;
1617+ 7F4C                  ; E = ItemLeft
1618+ 7F4C                  ; D = ItemRight
1619+ 7F4C                  ; ---------------------------------------------------------------
1620+ 7F4C 6F               ld   l, a              ; L = ItemX
1621+ 7F4D
1622+ 7F4D 7D               ld   a, l
1623+ 7F4E 87               add  a, a              ; *2
1624+ 7F4F 87               add  a, a              ; *4
1625+ 7F50 87               add  a, a              ; *8
1626+ 7F51
1627+ 7F51 5F               ld   e, a              ; E = ItemLeft
1628+ 7F52
1629+ 7F52 C6 07            add  a, 7
1630+ 7F54 57               ld   d, a              ; D = ItemRight
1631+ 7F55
1632+ 7F55                  ; ---------------------------------------------------------------
1633+ 7F55                  ; Recupera la posizione corrente di Willy
1634+ 7F55                  ;
1635+ 7F55                  ; B = WillyY
1636+ 7F55                  ; C = WillyX
1637+ 7F55                  ; ---------------------------------------------------------------
1638+ 7F55 ED 4B 26 E6      ld   bc, (PlayerPos)
1639+ 7F59
1640+ 7F59                  ; ---------------------------------------------------------------
1641+ 7F59                  ; Primo test:
1642+ 7F59                  ;
1643+ 7F59                  ; WillyLeft <= ItemRight
1644+ 7F59                  ;
1645+ 7F59                  ; Se Willy è completamente a destra dell'item
1646+ 7F59                  ; non può esserci collisione.
1647+ 7F59                  ; ---------------------------------------------------------------
1648+ 7F59 79               ld   a, c              ; A = WillyLeft
1649+ 7F5A
1650+ 7F5A BA               cp   d                 ; WillyLeft vs ItemRight
1651+ 7F5B
1652+ 7F5B 28 04            jr   z, .x_ok
1653+ 7F5D 38 02            jr   c, .x_ok
1654+ 7F5F
1655+ 7F5F 18 29            jr   .no_collision
1656+ 7F61
1657+ 7F61              .x_ok:
1658+ 7F61
1659+ 7F61                  ; ---------------------------------------------------------------
1660+ 7F61                  ; Secondo test:
1661+ 7F61                  ;
1662+ 7F61                  ; WillyRight >= ItemLeft
1663+ 7F61                  ;
1664+ 7F61                  ; WillyRight = WillyX + 7
1665+ 7F61                  ; ---------------------------------------------------------------
1666+ 7F61 C6 07            add  a, 7
1667+ 7F63
1668+ 7F63 BB               cp   e                 ; WillyRight vs ItemLeft
1669+ 7F64
1670+ 7F64 28 04            jr   z, .y_check
1671+ 7F66 30 02            jr   nc, .y_check
1672+ 7F68
1673+ 7F68 18 20            jr   .no_collision
1674+ 7F6A
1675+ 7F6A              .y_check:
1676+ 7F6A
1677+ 7F6A                  ; ---------------------------------------------------------------
1678+ 7F6A                  ; Recupera ItemY dal valore originale di HL
1679+ 7F6A                  ;
1680+ 7F6A                  ; H contiene la riga dell'item.
1681+ 7F6A                  ; ---------------------------------------------------------------
1682+ 7F6A E1               pop  hl
1683+ 7F6B E5               push hl
1684+ 7F6C
1685+ 7F6C                  ; ---------------------------------------------------------------
1686+ 7F6C                  ; Calcola il bounding box verticale dell'item
1687+ 7F6C                  ;
1688+ 7F6C                  ; ItemTop    = ItemY * 8
1689+ 7F6C                  ; ItemBottom = ItemTop + 7
1690+ 7F6C                  ;
1691+ 7F6C                  ; E = ItemTop
1692+ 7F6C                  ; D = ItemBottom
1693+ 7F6C                  ; ---------------------------------------------------------------
1694+ 7F6C 7C               ld   a, h
1695+ 7F6D
1696+ 7F6D 87               add  a, a              ; *2
1697+ 7F6E 87               add  a, a              ; *4
1698+ 7F6F 87               add  a, a              ; *8
1699+ 7F70
1700+ 7F70 5F               ld   e, a              ; ItemTop
1701+ 7F71
1702+ 7F71 C6 07            add  a, 7
1703+ 7F73 57               ld   d, a              ; ItemBottom
1704+ 7F74
1705+ 7F74                  ; ---------------------------------------------------------------
1706+ 7F74                  ; Primo test verticale:
1707+ 7F74                  ;
1708+ 7F74                  ; WillyTop <= ItemBottom
1709+ 7F74                  ; ---------------------------------------------------------------
1710+ 7F74 78               ld   a, b              ; WillyTop
1711+ 7F75
1712+ 7F75 BA               cp   d
1713+ 7F76
1714+ 7F76 28 04            jr   z, .y_ok
1715+ 7F78 38 02            jr   c, .y_ok
1716+ 7F7A
1717+ 7F7A 18 0E            jr   .no_collision
1718+ 7F7C
1719+ 7F7C              .y_ok:
1720+ 7F7C
1721+ 7F7C                  ; ---------------------------------------------------------------
1722+ 7F7C                  ; Secondo test verticale:
1723+ 7F7C                  ;
1724+ 7F7C                  ; WillyBottom >= ItemTop
1725+ 7F7C                  ;
1726+ 7F7C                  ; WillyBottom = WillyY + 15
1727+ 7F7C                  ; ---------------------------------------------------------------
1728+ 7F7C C6 0F            add  a, 15
1729+ 7F7E
1730+ 7F7E BB               cp   e
1731+ 7F7F
1732+ 7F7F 28 04            jr   z, .collision
1733+ 7F81 30 02            jr   nc, .collision
1734+ 7F83
1735+ 7F83 18 05            jr   .no_collision
1736+ 7F85
1737+ 7F85              .collision:
1738+ 7F85
1739+ 7F85                  ; ---------------------------------------------------------------
1740+ 7F85                  ; Collisione rilevata
1741+ 7F85                  ; ---------------------------------------------------------------
1742+ 7F85 E1               pop  hl
1743+ 7F86 D1               pop  de
1744+ 7F87 C1               pop  bc
1745+ 7F88
1746+ 7F88 37               scf                    ; Carry = 1
1747+ 7F89
1748+ 7F89 C9               ret
1749+ 7F8A
1750+ 7F8A              .no_collision:
1751+ 7F8A
1752+ 7F8A                  ; ---------------------------------------------------------------
1753+ 7F8A                  ; Nessuna collisione
1754+ 7F8A                  ; ---------------------------------------------------------------
1755+ 7F8A E1               pop  hl
1756+ 7F8B D1               pop  de
1757+ 7F8C C1               pop  bc
1758+ 7F8D
1759+ 7F8D B7               or   a                 ; Carry = 0
1760+ 7F8E
1761+ 7F8E C9               ret
1762+ 7F8F
1763+ 7F8F              ; -------------------------------------------------------------------
1764+ 7F8F              ; Items_CheckCollision
1765+ 7F8F              ;
1766+ 7F8F              ; Controlla se Willy entra in collisione con uno degli item
1767+ 7F8F              ; attivi presenti nella stanza corrente.
1768+ 7F8F              ;
1769+ 7F8F              ; Per ogni item:
1770+ 7F8F              ;   - verifica che appartenga alla stanza corrente
1771+ 7F8F              ;   - verifica che non sia già stato raccolto
1772+ 7F8F              ;   - esegue il test di collisione con Willy
1773+ 7F8F              ;
1774+ 7F8F              ; Se l'item viene raccolto:
1775+ 7F8F              ;   - imposta il flag "collected"
1776+ 7F8F              ;   - rimuove l'item dalla cache items_grid
1777+ 7F8F              ;   - incrementa il contatore degli oggetti raccolti
1778+ 7F8F              ;   - aggiorna l'HUD
1779+ 7F8F              ;   - ripristina il tile di sfondo
1780+ 7F8F              ;   - riproduce il suono di raccolta
1781+ 7F8F              ;
1782+ 7F8F              ; Formato record ItemsTable:
1783+ 7F8F              ;   +0 RoomID
1784+ 7F8F              ;   +1 X
1785+ 7F8F              ;   +2 Y
1786+ 7F8F              ;   +3 Color
1787+ 7F8F              ;   +4 Collected
1788+ 7F8F              ;
1789+ 7F8F              ; Fine tabella:
1790+ 7F8F              ;   RoomID = $FF
1791+ 7F8F              ; -------------------------------------------------------------------
1792+ 7F8F              Items_CheckCollision:
1793+ 7F8F
1794+ 7F8F                  ; Salva i registri utilizzati
1795+ 7F8F E5               push hl
1796+ 7F90 D5               push de
1797+ 7F91 C5               push bc
1798+ 7F92
1799+ 7F92                  ; Inizio scansione della tabella degli item
1800+ 7F92 21 EF 78         ld   hl, ItemsTable
1801+ 7F95
1802+ 7F95              .loop:
1803+ 7F95
1804+ 7F95                  ; ---------------------------------------------------------------
1805+ 7F95                  ; Legge il Room ID dell'item corrente
1806+ 7F95                  ; ---------------------------------------------------------------
1807+ 7F95 7E               ld   a, (hl)
1808+ 7F96
1809+ 7F96                  ; $FF indica fine tabella
1810+ 7F96 FE FF            cp   $FF
1811+ 7F98 28 4D            jr   z, .done
1812+ 7F9A
1813+ 7F9A                  ; ---------------------------------------------------------------
1814+ 7F9A                  ; Verifica se l'item appartiene alla stanza corrente
1815+ 7F9A                  ; ---------------------------------------------------------------
1816+ 7F9A 57               ld   d, a              ; D = RoomID item
1817+ 7F9B
1818+ 7F9B 3A 4C E9         ld   a, (current_room)
1819+ 7F9E BA               cp   d
1820+ 7F9F
1821+ 7F9F                  ; Se appartiene a un'altra stanza salta il record
1822+ 7F9F 20 3F            jr   nz, .next_item
1823+ 7FA1
1824+ 7FA1                  ; ---------------------------------------------------------------
1825+ 7FA1                  ; Legge coordinate e stato dell'item
1826+ 7FA1                  ; ---------------------------------------------------------------
1827+ 7FA1
1828+ 7FA1 23               inc  hl
1829+ 7FA2 4E               ld   c, (hl)           ; C = X
1830+ 7FA3
1831+ 7FA3 23               inc  hl
1832+ 7FA4 46               ld   b, (hl)           ; B = Y
1833+ 7FA5
1834+ 7FA5 23               inc  hl                ; salta Color
1835+ 7FA6
1836+ 7FA6 23               inc  hl                ; punta a Collected
1837+ 7FA7
1838+ 7FA7 7E               ld   a, (hl)
1839+ 7FA8
1840+ 7FA8                  ; ---------------------------------------------------------------
1841+ 7FA8                  ; Item già raccolto?
1842+ 7FA8                  ; ---------------------------------------------------------------
1843+ 7FA8 B7               or   a
1844+ 7FA9 20 39            jr   nz, .next_no_inc
1845+ 7FAB
1846+ 7FAB                  ; ---------------------------------------------------------------
1847+ 7FAB                  ; Test collisione Willy ↔ Item
1848+ 7FAB                  ;
1849+ 7FAB                  ; Input richiesto:
1850+ 7FAB                  ;   A = ItemX
1851+ 7FAB                  ;   H = ItemY
1852+ 7FAB                  ; ---------------------------------------------------------------
1853+ 7FAB 79               ld   a, c
1854+ 7FAC
1855+ 7FAC E5               push hl                ; salva puntatore al flag Collected
1856+ 7FAD
1857+ 7FAD 60               ld   h, b
1858+ 7FAE
1859+ 7FAE CD 49 7F         call CheckWillyItemCollision
1860+ 7FB1
1861+ 7FB1 E1               pop  hl
1862+ 7FB2
1863+ 7FB2                  ; Nessuna collisione
1864+ 7FB2 30 30            jr   nc, .next_no_inc
1865+ 7FB4
1866+ 7FB4                  ; ===============================================================
1867+ 7FB4                  ; ITEM RACCOLTO
1868+ 7FB4                  ; ===============================================================
1869+ 7FB4
1870+ 7FB4                  ; ---------------------------------------------------------------
1871+ 7FB4                  ; Marca l'item come raccolto
1872+ 7FB4                  ; ---------------------------------------------------------------
1873+ 7FB4 36 01            ld   (hl), 1
1874+ 7FB6
1875+ 7FB6                  ; ---------------------------------------------------------------
1876+ 7FB6                  ; Rimuove l'item dalla cache items_grid
1877+ 7FB6                  ;
1878+ 7FB6                  ; Calcolo:
1879+ 7FB6                  ;   offset = Row * 32 + Col
1880+ 7FB6                  ; ---------------------------------------------------------------
1881+ 7FB6 E5               push hl
1882+ 7FB7 D5               push de
1883+ 7FB8
1884+ 7FB8 26 00            ld   h, 0
1885+ 7FBA 68               ld   l, b              ; HL = Row
1886+ 7FBB
1887+ 7FBB 29               add  hl, hl            ; *2
1888+ 7FBC 29               add  hl, hl            ; *4
1889+ 7FBD 29               add  hl, hl            ; *8
1890+ 7FBE 29               add  hl, hl            ; *16
1891+ 7FBF 29               add  hl, hl            ; *32
1892+ 7FC0
1893+ 7FC0 59               ld   e, c
1894+ 7FC1 16 00            ld   d, 0
1895+ 7FC3
1896+ 7FC3 19               add  hl, de            ; Row*32 + Col
1897+ 7FC4
1898+ 7FC4 11 26 E4         ld   de, items_grid
1899+ 7FC7 19               add  hl, de
1900+ 7FC8
1901+ 7FC8                  ; La cella non contiene più un item
1902+ 7FC8 36 00            ld   (hl), 0
1903+ 7FCA
1904+ 7FCA D1               pop  de
1905+ 7FCB E1               pop  hl
1906+ 7FCC
1907+ 7FCC                  ; ---------------------------------------------------------------
1908+ 7FCC                  ; Conserva il puntatore all'entry corrente
1909+ 7FCC                  ; poiché le routine successive possono alterare HL.
1910+ 7FCC                  ; ---------------------------------------------------------------
1911+ 7FCC E5               push hl
1912+ 7FCD
1913+ 7FCD                  ; ---------------------------------------------------------------
1914+ 7FCD                  ; Aggiorna il numero di oggetti raccolti
1915+ 7FCD                  ; ---------------------------------------------------------------
1916+ 7FCD 3A 30 E6         ld   a, (items_collected)
1917+ 7FD0
1918+ 7FD0 3C               inc  a
1919+ 7FD1
1920+ 7FD1 32 30 E6         ld   (items_collected), a
1921+ 7FD4
1922+ 7FD4                  ; ---------------------------------------------------------------
