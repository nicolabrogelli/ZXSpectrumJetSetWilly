1287+ 651D 01 7C 68         ld   bc, $687c             ; B = Y = 104 ($68), C = X = 124 ($7C)
1288+ 6520 DD 21 4D D1      ld   ix, Willy + (1 * 8)   ; Body right frame 0
1289+ 6524 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1290+ 6527
