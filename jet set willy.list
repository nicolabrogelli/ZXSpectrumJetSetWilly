 433+ 7223              ; -------------------------------------------------------------------
 434+ 7223              ; Items_DrawRoom
 435+ 7223              ;
 436+ 7223              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 437+ 7223              ;
 438+ 7223              ; Operazioni eseguite:
 439+ 7223              ;   1. Azzera la griglia items_grid.
 440+ 7223              ;   2. Svuota la cache degli oggetti attivi.
 441+ 7223              ;   3. Scansiona ItemsTable.
 442+ 7223              ;   4. Per ogni item della stanza corrente:
 443+ 7223              ;        - verifica se è già stato raccolto
 444+ 7223              ;        - disegna la grafica
 445+ 7223              ;        - aggiorna items_grid
 446+ 7223              ;        - memorizza l'item nella cache current_room_items
 447+ 7223              ;   5. Aggiorna num_room_items.
 448+ 7223              ;
 449+ 7223              ; Record ItemsTable:
 450+ 7223              ;   +0  Room ID
 451+ 7223              ;   +1  X (colonna)
 452+ 7223              ;   +2  Y (riga)
 453+ 7223              ;   +3  Colore
 454+ 7223              ;   +4  Collected flag
 455+ 7223              ;
 456+ 7223              ; Cache current_room_items:
 457+ 7223              ;   +0  Colonna
 458+ 7223              ;   +1  Riga
 459+ 7223              ;   +2  Colore
 460+ 7223              ;   +3  Collected flag ptr (Low)
 461+ 7223              ;   +4  Collected flag ptr (High)
 462+ 7223              ;
 463+ 7223              ; Ogni record cache occupa 5 byte.
 464+ 7223              ; -------------------------------------------------------------------
 465+ 7223              Items_DrawRoom:
 466+ 7223
 467+ 7223                  ; Salva tutti i registri utilizzati
 468+ 7223 E5               push hl
 469+ 7224 D5               push de
 470+ 7225 C5               push bc
 471+ 7226 DD E5            push ix
 472+ 7228 FD E5            push iy
 473+ 722A
 474+ 722A                  ; ---------------------------------------------------------------
 475+ 722A                  ; Azzera items_grid (32 x 16 = 512 byte)
 476+ 722A                  ; ---------------------------------------------------------------
 477+ 722A 21 00 B0         ld   hl, items_grid
 478+ 722D 11 01 B0         ld   de, items_grid + 1
 479+ 7230 36 00            ld   (hl), 0
 480+ 7232 01 FF 01         ld   bc, 511
 481+ 7235 ED B0            ldir
 482+ 7237
 483+ 7237                  ; ---------------------------------------------------------------
 484+ 7237                  ; Nessun item attivo nella stanza
 485+ 7237                  ; ---------------------------------------------------------------
 486+ 7237 AF               xor  a
 487+ 7238 32 73 78         ld   (num_room_items), a
 488+ 723B
 489+ 723B                  ; IY punta alla cache degli item attivi
 490+ 723B FD 21 23 78      ld   iy, current_room_items
 491+ 723F
 492+ 723F                  ; ---------------------------------------------------------------
 493+ 723F                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 494+ 723F                  ; alla stanza corrente.
 495+ 723F                  ;
 496+ 723F                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 497+ 723F                  ; ---------------------------------------------------------------
 498+ 723F 2A 74 78         ld   hl, (room_ptr)
 499+ 7242 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 500+ 7245 19               add  hl, de
 501+ 7246
 502+ 7246 E5               push hl
 503+ 7247 DD E1            pop  ix                ; IX = bitmap item
 504+ 7249
 505+ 7249                  ; ---------------------------------------------------------------
 506+ 7249                  ; Inizio scansione della tabella degli item
 507+ 7249                  ; ---------------------------------------------------------------
 508+ 7249 21 53 70         ld   hl, ItemsTable
 509+ 724C
 510+ 724C              .loop:
 511+ 724C
 512+ 724C                  ; ---------------------------------------------------------------
 513+ 724C                  ; Legge il Room ID del record corrente
 514+ 724C                  ; ---------------------------------------------------------------
 515+ 724C 7E               ld   a, (hl)
 516+ 724D
 517+ 724D                  ; $FF indica fine tabella
 518+ 724D FE FF            cp   $FF
 519+ 724F 28 53            jr   z, .done
 520+ 7251
 521+ 7251                  ; ---------------------------------------------------------------
 522+ 7251                  ; Verifica se l'item appartiene alla stanza corrente
 523+ 7251                  ; ---------------------------------------------------------------
 524+ 7251 57               ld   d, a
 525+ 7252
 526+ 7252 3A 1A 78         ld   a, (current_room)
 527+ 7255 BA               cp   d
 528+ 7256 20 45            jr   nz, .next_item
 529+ 7258
 530+ 7258                  ; ---------------------------------------------------------------
 531+ 7258                  ; Legge i dati dell'item
 532+ 7258                  ; ---------------------------------------------------------------
 533+ 7258
 534+ 7258 23               inc  hl
 535+ 7259 4E               ld   c, (hl)           ; X (colonna)
 536+ 725A
 537+ 725A 23               inc  hl
 538+ 725B 46               ld   b, (hl)           ; Y (riga)
 539+ 725C
 540+ 725C 23               inc  hl
 541+ 725D 5E               ld   e, (hl)           ; Colore
 542+ 725E
 543+ 725E 23               inc  hl
 544+ 725F 7E               ld   a, (hl)           ; Collected flag
 545+ 7260
 546+ 7260                  ; Se diverso da zero l'item è già stato raccolto
 547+ 7260 B7               or   a
 548+ 7261 20 3E            jr   nz, .next_no_inc
 549+ 7263
 550+ 7263                  ; ---------------------------------------------------------------
 551+ 7263                  ; Disegna l'item sullo schermo
 552+ 7263                  ;
 553+ 7263                  ; B = Row
 554+ 7263                  ; C = Column
 555+ 7263                  ; HL = bitmap pointer
 556+ 7263                  ; E = Color
 557+ 7263                  ; ---------------------------------------------------------------
 558+ 7263 E5               push hl
 559+ 7264
 560+ 7264 DD E5            push ix
 561+ 7266 E1               pop  hl
 562+ 7267
 563+ 7267 CD AC 72         call DrawItemGraphic
 564+ 726A
 565+ 726A E1               pop  hl                ; ritorna al flag collected
 566+ 726B
 567+ 726B                  ; ---------------------------------------------------------------
 568+ 726B                  ; Aggiorna items_grid
 569+ 726B                  ;
 570+ 726B                  ; Calcolo:
 571+ 726B                  ;   offset = Row * 32 + Col
 572+ 726B                  ; ---------------------------------------------------------------
 573+ 726B E5               push hl
 574+ 726C D5               push de
 575+ 726D
 576+ 726D 26 00            ld   h, 0
 577+ 726F 68               ld   l, b              ; HL = Row
 578+ 7270
 579+ 7270 29               add  hl, hl            ; *2
 580+ 7271 29               add  hl, hl            ; *4
 581+ 7272 29               add  hl, hl            ; *8
 582+ 7273 29               add  hl, hl            ; *16
 583+ 7274 29               add  hl, hl            ; *32
 584+ 7275
 585+ 7275 16 00            ld   d, 0
 586+ 7277 59               ld   e, c              ; DE = Col
 587+ 7278
 588+ 7278 19               add  hl, de            ; Row*32 + Col
 589+ 7279
 590+ 7279 11 00 B0         ld   de, items_grid
 591+ 727C 19               add  hl, de            ; puntatore nella griglia
 592+ 727D
 593+ 727D D1               pop  de                ; ripristina colore
 594+ 727E
 595+ 727E 73               ld   (hl), e           ; salva colore cella
 596+ 727F
 597+ 727F E1               pop  hl
 598+ 7280
 599+ 7280                  ; ---------------------------------------------------------------
 600+ 7280                  ; Salva l'item nella cache della stanza
 601+ 7280                  ;
 602+ 7280                  ; Questo evita di dover scansionare tutta ItemsTable
 603+ 7280                  ; durante il controllo delle collisioni.
 604+ 7280                  ; ---------------------------------------------------------------
 605+ 7280
 606+ 7280 FD 71 00         ld   (iy+0), c         ; Colonna
 607+ 7283 FD 70 01         ld   (iy+1), b         ; Riga
 608+ 7286 FD 73 02         ld   (iy+2), e         ; Colore
 609+ 7289
 610+ 7289                  ; Salva il puntatore al flag "collected"
 611+ 7289 FD 75 03         ld   (iy+3), l         ; Low byte
 612+ 728C FD 74 04         ld   (iy+4), h         ; High byte
 613+ 728F
 614+ 728F                  ; Passa al record successivo della cache
 615+ 728F 01 05 00         ld   bc, 5
 616+ 7292 FD 09            add  iy, bc
 617+ 7294
 618+ 7294                  ; Incrementa il numero di item attivi
 619+ 7294 3A 73 78         ld   a, (num_room_items)
 620+ 7297 3C               inc  a
 621+ 7298 32 73 78         ld   (num_room_items), a
 622+ 729B
 623+ 729B 18 04            jr   .next_no_inc
 624+ 729D
 625+ 729D              .next_item:
 626+ 729D
 627+ 729D                  ; ---------------------------------------------------------------
 628+ 729D                  ; L'item non appartiene alla stanza corrente.
 629+ 729D                  ; Salta i campi del record:
 630+ 729D                  ;   X
 631+ 729D                  ;   Y
 632+ 729D                  ;   Color
 633+ 729D                  ;   Collected
 634+ 729D                  ; ---------------------------------------------------------------
 635+ 729D 23               inc  hl
 636+ 729E 23               inc  hl
 637+ 729F 23               inc  hl
 638+ 72A0 23               inc  hl
 639+ 72A1
 640+ 72A1              .next_no_inc:
 641+ 72A1
 642+ 72A1                  ; ---------------------------------------------------------------
 643+ 72A1                  ; Avanza al record successivo
 644+ 72A1                  ; (prossimo Room ID)
 645+ 72A1                  ; ---------------------------------------------------------------
 646+ 72A1 23               inc  hl
 647+ 72A2 18 A8            jr   .loop
 648+ 72A4
 649+ 72A4              .done:
 650+ 72A4
 651+ 72A4                  ; Ripristina i registri
 652+ 72A4 FD E1            pop  iy
 653+ 72A6 DD E1            pop  ix
 654+ 72A8 D1               pop  de
 655+ 72A9 C1               pop  bc
 656+ 72AA E1               pop  hl
 657+ 72AB
 658+ 72AB C9               ret
 659+ 72AC
 660+ 72AC              ; -------------------------------------------------------------------
 661+ 72AC              ; DrawItemGraphic
 662+ 72AC              ;
 663+ 72AC              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 664+ 72AC              ; utilizzando una bitmap di 8 byte e un attributo colore.
 665+ 72AC              ;
 666+ 72AC              ; Input:
 667+ 72AC              ;   B = Riga attributi (3..18)
 668+ 72AC              ;   C = Colonna attributi (0..31)
 669+ 72AC              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 670+ 72AC              ;   E = Attributo colore
 671+ 72AC              ;
 672+ 72AC              ; Output:
 673+ 72AC              ;   Nessuno
 674+ 72AC              ;
 675+ 72AC              ; Registri preservati:
 676+ 72AC              ;   BC, DE, HL
 677+ 72AC              ; -------------------------------------------------------------------
 678+ 72AC              DrawItemGraphic:
 679+ 72AC
 680+ 72AC                  ; Salva i registri originali
 681+ 72AC C5               push bc
 682+ 72AD D5               push de
 683+ 72AE E5               push hl
 684+ 72AF
 685+ 72AF                  ; ---------------------------------------------------------------
 686+ 72AF                  ; Calcolo indirizzo bitmap dello Spectrum
 687+ 72AF                  ;
 688+ 72AF                  ; Ogni item occupa una cella attributi (8x8 pixel).
 689+ 72AF                  ;
 690+ 72AF                  ; Formula:
 691+ 72AF                  ;   High = $40 + (Row AND $18)
 692+ 72AF                  ;   Low  = (Row AND 7) * 32 + Col
 693+ 72AF                  ;
 694+ 72AF                  ; DE conterrà l'indirizzo della prima scanline.
 695+ 72AF                  ; ---------------------------------------------------------------
 696+ 72AF
 697+ 72AF 78               ld   a, b
 698+ 72B0 E6 18            and  $18
 699+ 72B2 C6 40            add  a, $40
 700+ 72B4 57               ld   d, a              ; Byte alto indirizzo video
 701+ 72B5
 702+ 72B5 78               ld   a, b
 703+ 72B6 E6 07            and  7                 ; Riga interna al blocco da 8
 704+ 72B8
 705+ 72B8 87               add  a, a              ; *2
 706+ 72B9 87               add  a, a              ; *4
 707+ 72BA 87               add  a, a              ; *8
 708+ 72BB 87               add  a, a              ; *16
 709+ 72BC 87               add  a, a              ; *32
 710+ 72BD
 711+ 72BD 81               add  a, c              ; + colonna
 712+ 72BE
 713+ 72BE 5F               ld   e, a              ; Byte basso indirizzo video
 714+ 72BF
 715+ 72BF                  ; ---------------------------------------------------------------
 716+ 72BF                  ; Disegno bitmap
 717+ 72BF                  ;
 718+ 72BF                  ; Copia 8 byte consecutivi nella memoria video.
 719+ 72BF                  ; Ogni byte rappresenta una scanline da 8 pixel.
 720+ 72BF                  ; ---------------------------------------------------------------
 721+ 72BF
 722+ 72BF C5               push bc                ; Conserva Row e Col
 723+ 72C0
 724+ 72C0 06 08            ld   b, 8              ; Numero scanline
 725+ 72C2
 726+ 72C2              .line_loop:
 727+ 72C2
 728+ 72C2 7E               ld   a, (hl)           ; Legge scanline bitmap
 729+ 72C3 12               ld   (de), a           ; Scrive nella memoria video
 730+ 72C4
 731+ 72C4 14               inc  d                 ; Scanline successiva
 732+ 72C5 23               inc  hl                ; Byte bitmap successivo
 733+ 72C6
 734+ 72C6 05               dec  b
 735+ 72C7 20 F9            jr   nz, .line_loop
 736+ 72C9
 737+ 72C9 C1               pop  bc                ; Ripristina Row e Col
 738+ 72CA
 739+ 72CA                  ; ---------------------------------------------------------------
 740+ 72CA                  ; Calcolo indirizzo attributo
 741+ 72CA                  ;
 742+ 72CA                  ; Formula:
 743+ 72CA                  ;   AttrAddr = $5800 + Row * 32 + Col
 744+ 72CA                  ;
 745+ 72CA                  ; HL conterrà l'indirizzo della cella attributi.
 746+ 72CA                  ; ---------------------------------------------------------------
 747+ 72CA
 748+ 72CA 26 00            ld   h, 0
 749+ 72CC 68               ld   l, b              ; HL = Row
 750+ 72CD
 751+ 72CD 29               add  hl, hl            ; *2
 752+ 72CE 29               add  hl, hl            ; *4
 753+ 72CF 29               add  hl, hl            ; *8
 754+ 72D0 29               add  hl, hl            ; *16
 755+ 72D1 29               add  hl, hl            ; *32
 756+ 72D2
 757+ 72D2 79               ld   a, c              ; A = Colonna
 758+ 72D3
 759+ 72D3 85               add  a, l
 760+ 72D4 6F               ld   l, a
 761+ 72D5
 762+ 72D5 30 01            jr   nc, .no_carry
 763+ 72D7 24               inc  h
 764+ 72D8
 765+ 72D8              .no_carry:
 766+ 72D8
 767+ 72D8                  ; HL = Row * 32 + Col
 768+ 72D8
 769+ 72D8 11 00 58         ld   de, $5800
 770+ 72DB 19               add  hl, de            ; HL = indirizzo attributi
 771+ 72DC
 772+ 72DC                  ; ---------------------------------------------------------------
 773+ 72DC                  ; Recupera il colore originale dallo stack.
 774+ 72DC                  ;
 775+ 72DC                  ; Layout stack:
 776+ 72DC                  ;   HL originale
 777+ 72DC                  ;   DE originale (E = colore)
 778+ 72DC                  ;   BC originale
 779+ 72DC                  ; ---------------------------------------------------------------
 780+ 72DC
 781+ 72DC C1               pop  bc                ; Recupera HL originale
 782+ 72DD D1               pop  de                ; Recupera DE originale
 783+ 72DE
 784+ 72DE                  ; ---------------------------------------------------------------
 785+ 72DE                  ; Scrive l'attributo colore
 786+ 72DE                  ; ---------------------------------------------------------------
 787+ 72DE
 788+ 72DE 7B               ld   a, e              ; A = colore
 789+ 72DF 77               ld   (hl), a           ; Scrive nella RAM attributi
 790+ 72E0
 791+ 72E0                  ; ---------------------------------------------------------------
 792+ 72E0                  ; Ripristina HL e BC originali
 793+ 72E0                  ; ---------------------------------------------------------------
 794+ 72E0
 795+ 72E0 C5               push bc
 796+ 72E1 E1               pop  hl                ; HL originale
 797+ 72E2
 798+ 72E2 C1               pop  bc                ; BC originale
 799+ 72E3
 800+ 72E3 C9               ret
 801+ 72E4
 802+ 72E4              ; -------------------------------------------------------------------
 803+ 72E4              ; RestoreBackgroundCell
 804+ 72E4              ;
 805+ 72E4              ; Ripristina il contenuto originale di una cella della stanza.
 806+ 72E4              ; Viene utilizzata principalmente quando un item viene raccolto:
 807+ 72E4              ; invece di lasciare un "buco", la routine ridisegna il tile
 808+ 72E4              ; originale presente nella mappa della stanza.
 809+ 72E4              ;
 810+ 72E4              ; Input:
 811+ 72E4              ;   B = Row (3..18)
 812+ 72E4              ;   C = Col (0..31)
 813+ 72E4              ;
 814+ 72E4              ; Utilizza:
 815+ 72E4              ;   room_ptr -> struttura dati della stanza corrente
 816+ 72E4              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 817+ 72E4              ;   Gfx_DrawTile -> ridisegna il tile selezionato
 818+ 72E4              ;
 819+ 72E4              ; Tipi di cella:
 820+ 72E4              ;   0 = Background
 821+ 72E4              ;   1 = Floor
 822+ 72E4              ;   2 = Wall
 823+ 72E4              ;   3 = Nasty
 824+ 72E4              ; -------------------------------------------------------------------
 825+ 72E4              RestoreBackgroundCell:
 826+ 72E4
 827+ 72E4                  ; Salva tutti i registri utilizzati
 828+ 72E4 FD E5            push iy
 829+ 72E6 C5               push bc
 830+ 72E7 D5               push de
 831+ 72E8 E5               push hl
 832+ 72E9 DD E5            push ix
 833+ 72EB
 834+ 72EB                  ; ---------------------------------------------------------------
 835+ 72EB                  ; Conserva Row e Col in IY.
 836+ 72EB                  ;
 837+ 72EB                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 838+ 72EB                  ; BC potrebbe essere modificato.
 839+ 72EB                  ; ---------------------------------------------------------------
 840+ 72EB C5               push bc
 841+ 72EC FD E1            pop  iy                ; IYH = Row, IYL = Col
 842+ 72EE
 843+ 72EE                  ; ---------------------------------------------------------------
 844+ 72EE                  ; Determina quale tipo di cella è presente nella posizione
 845+ 72EE                  ; specificata.
 846+ 72EE                  ;
 847+ 72EE                  ; Input:
 848+ 72EE                  ;   B = Row
 849+ 72EE                  ;   C = Col
 850+ 72EE                  ;
 851+ 72EE                  ; Output:
 852+ 72EE                  ;   A = tipo cella
 853+ 72EE                  ; ---------------------------------------------------------------
 854+ 72EE 78               ld   a, b
 855+ 72EF
 856+ 72EF CD 7F 6B         call GetCellFromUnpacked
 857+ 72F2
 858+ 72F2                  ; ---------------------------------------------------------------
 859+ 72F2                  ; Recupera il puntatore alla stanza corrente.
 860+ 72F2                  ;
 861+ 72F2                  ; DE = base della struttura stanza
 862+ 72F2                  ; ---------------------------------------------------------------
 863+ 72F2 ED 5B 74 78      ld   de, (room_ptr)
 864+ 72F6
 865+ 72F6                  ; ---------------------------------------------------------------
 866+ 72F6                  ; Seleziona il tile corretto in base al tipo di cella.
 867+ 72F6                  ;
 868+ 72F6                  ; A = 0 -> Background
 869+ 72F6                  ; A = 1 -> Floor
 870+ 72F6                  ; A = 2 -> Wall
 871+ 72F6                  ; A = 3 -> Nasty
 872+ 72F6                  ; ---------------------------------------------------------------
 873+ 72F6
 874+ 72F6 B7               or   a
 875+ 72F7 20 06            jr   nz, .not_bg
 876+ 72F9
 877+ 72F9                  ; Background
 878+ 72F9 21 A0 00         ld   hl, OFFSET_BG
 879+ 72FC 19               add  hl, de
 880+ 72FD 18 16            jr   .draw_cell
 881+ 72FF
 882+ 72FF              .not_bg:
 883+ 72FF
 884+ 72FF 3D               dec  a
 885+ 7300 20 06            jr   nz, .not_floor
 886+ 7302
 887+ 7302                  ; Floor
 888+ 7302 21 A9 00         ld   hl, OFFSET_FLOOR
 889+ 7305 19               add  hl, de
 890+ 7306 18 0D            jr   .draw_cell
 891+ 7308
 892+ 7308              .not_floor:
 893+ 7308
 894+ 7308 3D               dec  a
 895+ 7309 20 06            jr   nz, .not_wall
 896+ 730B
 897+ 730B                  ; Wall
 898+ 730B 21 B2 00         ld   hl, OFFSET_WALL
 899+ 730E 19               add  hl, de
 900+ 730F 18 04            jr   .draw_cell
 901+ 7311
 902+ 7311              .not_wall:
 903+ 7311
 904+ 7311                  ; Nasty
 905+ 7311 21 BB 00         ld   hl, OFFSET_NASTY
 906+ 7314 19               add  hl, de
 907+ 7315
 908+ 7315              .draw_cell:
 909+ 7315
 910+ 7315                  ; ---------------------------------------------------------------
 911+ 7315                  ; HL punta ora alla grafica del tile da ridisegnare.
 912+ 7315                  ;
 913+ 7315                  ; Gfx_DrawTile si aspetta:
 914+ 7315                  ;   IX = puntatore tile
 915+ 7315                  ;   B  = Row
 916+ 7315                  ;   C  = Col
 917+ 7315                  ; ---------------------------------------------------------------
 918+ 7315 E5               push hl
 919+ 7316 DD E1            pop  ix
 920+ 7318
 921+ 7318                  ; Ripristina Row e Col salvati in IY
 922+ 7318 FD E5            push iy
 923+ 731A C1               pop  bc
 924+ 731B
 925+ 731B                  ; Disegna il tile originale
 926+ 731B CD 8C 61         call Gfx_DrawTile
 927+ 731E
 928+ 731E                  ; ---------------------------------------------------------------
 929+ 731E                  ; Ripristina i registri salvati
 930+ 731E                  ; ---------------------------------------------------------------
 931+ 731E DD E1            pop  ix
 932+ 7320 E1               pop  hl
 933+ 7321 D1               pop  de
 934+ 7322 C1               pop  bc
 935+ 7323 FD E1            pop  iy
 936+ 7325
 937+ 7325 C9               ret
 938+ 7326
 939+ 7326              ; -------------------------------------------------------------------
 940+ 7326              ; CheckWillyItemCollision
 941+ 7326              ;
 942+ 7326              ; Verifica se Willy collide con un item utilizzando il controllo
 943+ 7326              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 944+ 7326              ;
 945+ 7326              ; Input:
 946+ 7326              ;   A = ItemX (colonna attributi 0..31)
 947+ 7326              ;   H = ItemY (riga attributi 3..18)
 948+ 7326              ;
 949+ 7326              ; Coordinate item:
 950+ 7326              ;   Ogni item occupa una cella da 8x8 pixel.
 951+ 7326              ;
 952+ 7326              ; Coordinate Willy:
 953+ 7326              ;   Willy occupa un rettangolo di 16x16 pixel.
 954+ 7326              ;
 955+ 7326              ; Output:
 956+ 7326              ;   Carry Set   = collisione rilevata
 957+ 7326              ;   Carry Clear = nessuna collisione
 958+ 7326              ;
 959+ 7326              ; Registri preservati:
 960+ 7326              ;   BC, DE, HL
 961+ 7326              ; -------------------------------------------------------------------
 962+ 7326              CheckWillyItemCollision:
 963+ 7326
 964+ 7326                  ; Salva i registri utilizzati
 965+ 7326 C5               push bc
 966+ 7327 D5               push de
 967+ 7328 E5               push hl
 968+ 7329
 969+ 7329                  ; ---------------------------------------------------------------
 970+ 7329                  ; Calcola il bounding box orizzontale dell'item
 971+ 7329                  ;
 972+ 7329                  ; ItemLeft  = ItemX * 8
 973+ 7329                  ; ItemRight = ItemLeft + 7
 974+ 7329                  ;
 975+ 7329                  ; E = ItemLeft
 976+ 7329                  ; D = ItemRight
 977+ 7329                  ; ---------------------------------------------------------------
 978+ 7329 6F               ld   l, a              ; L = ItemX
 979+ 732A
 980+ 732A 7D               ld   a, l
 981+ 732B 87               add  a, a              ; *2
 982+ 732C 87               add  a, a              ; *4
 983+ 732D 87               add  a, a              ; *8
 984+ 732E
 985+ 732E 5F               ld   e, a              ; E = ItemLeft
 986+ 732F
 987+ 732F C6 07            add  a, 7
 988+ 7331 57               ld   d, a              ; D = ItemRight
 989+ 7332
 990+ 7332                  ; ---------------------------------------------------------------
 991+ 7332                  ; Recupera la posizione corrente di Willy
 992+ 7332                  ;
 993+ 7332                  ; B = WillyY
 994+ 7332                  ; C = WillyX
 995+ 7332                  ; ---------------------------------------------------------------
 996+ 7332 ED 4B 03 75      ld   bc, (PlayerPos)
 997+ 7336
 998+ 7336                  ; ---------------------------------------------------------------
 999+ 7336                  ; Primo test:
1000+ 7336                  ;
1001+ 7336                  ; WillyLeft <= ItemRight
1002+ 7336                  ;
1003+ 7336                  ; Se Willy è completamente a destra dell'item
1004+ 7336                  ; non può esserci collisione.
1005+ 7336                  ; ---------------------------------------------------------------
1006+ 7336 79               ld   a, c              ; A = WillyLeft
1007+ 7337
1008+ 7337 BA               cp   d                 ; WillyLeft vs ItemRight
1009+ 7338
1010+ 7338 28 04            jr   z, .x_ok
1011+ 733A 38 02            jr   c, .x_ok
1012+ 733C
1013+ 733C 18 29            jr   .no_collision
1014+ 733E
1015+ 733E              .x_ok:
1016+ 733E
1017+ 733E                  ; ---------------------------------------------------------------
1018+ 733E                  ; Secondo test:
1019+ 733E                  ;
1020+ 733E                  ; WillyRight >= ItemLeft
1021+ 733E                  ;
1022+ 733E                  ; WillyRight = WillyX + 7
1023+ 733E                  ; ---------------------------------------------------------------
1024+ 733E C6 07            add  a, 7
1025+ 7340
1026+ 7340 BB               cp   e                 ; WillyRight vs ItemLeft
1027+ 7341
1028+ 7341 28 04            jr   z, .y_check
1029+ 7343 30 02            jr   nc, .y_check
1030+ 7345
1031+ 7345 18 20            jr   .no_collision
1032+ 7347
1033+ 7347              .y_check:
1034+ 7347
1035+ 7347                  ; ---------------------------------------------------------------
1036+ 7347                  ; Recupera ItemY dal valore originale di HL
1037+ 7347                  ;
1038+ 7347                  ; H contiene la riga dell'item.
1039+ 7347                  ; ---------------------------------------------------------------
1040+ 7347 E1               pop  hl
1041+ 7348 E5               push hl
1042+ 7349
1043+ 7349                  ; ---------------------------------------------------------------
1044+ 7349                  ; Calcola il bounding box verticale dell'item
1045+ 7349                  ;
1046+ 7349                  ; ItemTop    = ItemY * 8
1047+ 7349                  ; ItemBottom = ItemTop + 7
1048+ 7349                  ;
1049+ 7349                  ; E = ItemTop
1050+ 7349                  ; D = ItemBottom
1051+ 7349                  ; ---------------------------------------------------------------
1052+ 7349 7C               ld   a, h
1053+ 734A
1054+ 734A 87               add  a, a              ; *2
1055+ 734B 87               add  a, a              ; *4
1056+ 734C 87               add  a, a              ; *8
1057+ 734D
1058+ 734D 5F               ld   e, a              ; ItemTop
1059+ 734E
1060+ 734E C6 07            add  a, 7
1061+ 7350 57               ld   d, a              ; ItemBottom
1062+ 7351
1063+ 7351                  ; ---------------------------------------------------------------
1064+ 7351                  ; Primo test verticale:
1065+ 7351                  ;
1066+ 7351                  ; WillyTop <= ItemBottom
1067+ 7351                  ; ---------------------------------------------------------------
1068+ 7351 78               ld   a, b              ; WillyTop
1069+ 7352
1070+ 7352 BA               cp   d
1071+ 7353
1072+ 7353 28 04            jr   z, .y_ok
1073+ 7355 38 02            jr   c, .y_ok
1074+ 7357
1075+ 7357 18 0E            jr   .no_collision
1076+ 7359
1077+ 7359              .y_ok:
1078+ 7359
1079+ 7359                  ; ---------------------------------------------------------------
1080+ 7359                  ; Secondo test verticale:
1081+ 7359                  ;
1082+ 7359                  ; WillyBottom >= ItemTop
1083+ 7359                  ;
1084+ 7359                  ; WillyBottom = WillyY + 15
1085+ 7359                  ; ---------------------------------------------------------------
1086+ 7359 C6 0F            add  a, 15
1087+ 735B
1088+ 735B BB               cp   e
1089+ 735C
1090+ 735C 28 04            jr   z, .collision
1091+ 735E 30 02            jr   nc, .collision
1092+ 7360
1093+ 7360 18 05            jr   .no_collision
1094+ 7362
1095+ 7362              .collision:
1096+ 7362
1097+ 7362                  ; ---------------------------------------------------------------
1098+ 7362                  ; Collisione rilevata
1099+ 7362                  ; ---------------------------------------------------------------
1100+ 7362 E1               pop  hl
1101+ 7363 D1               pop  de
1102+ 7364 C1               pop  bc
1103+ 7365
1104+ 7365 37               scf                    ; Carry = 1
1105+ 7366
1106+ 7366 C9               ret
1107+ 7367
1108+ 7367              .no_collision:
1109+ 7367
1110+ 7367                  ; ---------------------------------------------------------------
1111+ 7367                  ; Nessuna collisione
1112+ 7367                  ; ---------------------------------------------------------------
1113+ 7367 E1               pop  hl
1114+ 7368 D1               pop  de
1115+ 7369 C1               pop  bc
1116+ 736A
1117+ 736A B7               or   a                 ; Carry = 0
1118+ 736B
1119+ 736B C9               ret
1120+ 736C
1121+ 736C              ; -------------------------------------------------------------------
1122+ 736C              ; Items_CheckCollision
1123+ 736C              ;
1124+ 736C              ; Controlla se Willy entra in collisione con uno degli item
1125+ 736C              ; attivi presenti nella stanza corrente.
1126+ 736C              ;
1127+ 736C              ; Per ogni item:
1128+ 736C              ;   - verifica che appartenga alla stanza corrente
1129+ 736C              ;   - verifica che non sia già stato raccolto
1130+ 736C              ;   - esegue il test di collisione con Willy
1131+ 736C              ;
1132+ 736C              ; Se l'item viene raccolto:
1133+ 736C              ;   - imposta il flag "collected"
1134+ 736C              ;   - rimuove l'item dalla cache items_grid
1135+ 736C              ;   - incrementa il contatore degli oggetti raccolti
1136+ 736C              ;   - aggiorna l'HUD
1137+ 736C              ;   - ripristina il tile di sfondo
1138+ 736C              ;   - riproduce il suono di raccolta
1139+ 736C              ;
1140+ 736C              ; Formato record ItemsTable:
1141+ 736C              ;   +0 RoomID
1142+ 736C              ;   +1 X
1143+ 736C              ;   +2 Y
1144+ 736C              ;   +3 Color
1145+ 736C              ;   +4 Collected
