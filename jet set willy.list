 408+ 6ABA
 409+ 6ABA 3A 1D 7E         ld   a, (enemy_update_timer)
 410+ 6ABD 3C               inc  a
 411+ 6ABE 47               ld   b, a                      ; B = timer + 1
 412+ 6ABF 3A 1C 7E         ld   a, (enemy_update_rate)
 413+ 6AC2 B8               cp   b
 414+ 6AC3 28 0C            jr   z, .reset_timer
 415+ 6AC5 38 0A            jr   c, .reset_timer
 416+ 6AC7
 417+ 6AC7                  ; Salva contatore incrementato e salta l'aggiornamento
 418+ 6AC7 78               ld   a, b
 419+ 6AC8 32 1D 7E         ld   (enemy_update_timer), a
