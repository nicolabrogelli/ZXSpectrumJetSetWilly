  72+ 884D ~            ; Audio_UpdateMusic
  73+ 884D ~            ;
  74+ 884D ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 884D ~            ; Viene chiamata a ogni frame.
  76+ 884D ~            ; -------------------------------------------------------------------
  77+ 884D ~            Audio_UpdateMusic:
  78+ 884D ~                push af
  79+ 884D ~                push bc
  80+ 884D ~                push de
  81+ 884D ~                push hl
  82+ 884D ~
  83+ 884D ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 884D ~                ld   a, (Audio_jump_sound_note)
  85+ 884D ~                cp   18
  86+ 884D ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 884D ~
  88+ 884D ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 884D ~                ld   a, (Audio_music_frame_counter)
  90+ 884D ~                dec  a
  91+ 884D ~                ld   (Audio_music_frame_counter), a
  92+ 884D ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 884D ~
  94+ 884D ~                ; Altrimenti carica la nota successiva
  95+ 884D ~                ld   a, (Audio_music_note_idx)
  96+ 884D ~                inc  a
  97+ 884D ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 884D ~                jr   c, .no_wrap
  99+ 884D ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 884D ~            .no_wrap:
 101+ 884D ~                ld   (Audio_music_note_idx), a
 102+ 884D ~
 103+ 884D ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 884D ~                ld   e, a
 105+ 884D ~                ld   d, 0
 106+ 884D ~                ld   hl, Audio_MusicSheet
 107+ 884D ~                add  hl, de
 108+ 884D ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 884D ~
 110+ 884D ~                ; Leggi durata (secondo byte)
 111+ 884D ~                inc  hl
 112+ 884D ~                ld   a, (hl)
 113+ 884D ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 884D ~                jr   nz, .dur_ok
 115+ 884D ~                ld   a, 1
 116+ 884D ~            .dur_ok:
 117+ 884D ~                ld   (Audio_music_frame_counter), a
 118+ 884D ~
 119+ 884D ~            .play_current_note:
 120+ 884D ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 884D ~                ld   a, (Audio_music_note_idx)
 122+ 884D ~                ld   e, a
 123+ 884D ~                ld   d, 0
 124+ 884D ~                ld   hl, Audio_MusicSheet
 125+ 884D ~                add  hl, de
 126+ 884D ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 884D ~                ld   a, (hl)                  ; A = delay
 128+ 884D ~                or   a
 129+ 884D ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 884D ~
 131+ 884D ~                ; Suona la nota: 2 cicli
 132+ 884D ~                ld   d, a                     ; D = delay
 133+ 884D ~                ld   b, 2                     ; 2 cicli per frame
 134+ 884D ~            .note_loop:
 135+ 884D ~                ; Speaker ON
 136+ 884D ~                ld   a, (room_border_color)
 137+ 884D ~                or   $10
 138+ 884D ~                out  ($fe), a
 139+ 884D ~                ld   c, d
 140+ 884D ~            .d1:
 141+ 884D ~                push af
 142+ 884D ~                pop  af
 143+ 884D ~                dec  c
 144+ 884D ~                jr   nz, .d1
 145+ 884D ~
 146+ 884D ~                ; Speaker OFF
 147+ 884D ~                ld   a, (room_border_color)
 148+ 884D ~                and  $ef
 149+ 884D ~                out  ($fe), a
 150+ 884D ~                ld   c, d
 151+ 884D ~            .d2:
 152+ 884D ~                push af
 153+ 884D ~                pop  af
 154+ 884D ~                dec  c
 155+ 884D ~                jr   nz, .d2
 156+ 884D ~
 157+ 884D ~                djnz .note_loop
 158+ 884D ~
 159+ 884D ~            .done:
 160+ 884D ~                pop  hl
 161+ 884D ~                pop  de
 162+ 884D ~                pop  bc
 163+ 884D ~                pop  af
 164+ 884D ~                ret
 165+ 884D ~
 166+ 884D ~            Audio_MusicSheet:
 167+ 884D ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 884D ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 884D ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 884D ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 884D ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 884D ~                db 90, 10, 107, 20, 68, 65
 173+ 884D                  ELSE
 174+ 884D              Audio_UpdateMusic:
 175+ 884D C9               ret
 176+ 884E                  ENDIF
