 372  8B9C              ; -------------------------------------------------------------------
 373  8B9C              ; TriggerGameOver
 374  8B9C              ; Scatena la schermata di Game Over per la stanza corrente.
 375  8B9C              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 376  8B9C              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 377  8B9C              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 378  8B9C              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 379  8B9C              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 380  8B9C              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 381  8B9C              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 382  8B9C              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 383  8B9C              ; -------------------------------------------------------------------
 384  8B9C              TriggerGameOver:
 385  8B9C                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 386  8B9C CD FC 64         call Gfx_DrawGameOverScreen
 387  8B9F
 388  8B9F                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 389  8B9F              .wait_keys_release:
 390  8B9F 76               halt
 391  8BA0                  ; Controlla tasto Y (Porta $DF, bit 4)
 392  8BA0 01 FE DF         ld   bc, $dffe
 393  8BA3 ED 78            in   a, (c)
 394  8BA5 CB 67            bit  4, a
 395  8BA7 28 F6            jr   z, .wait_keys_release
 396  8BA9
 397  8BA9                  ; Controlla tasto N (Porta $7F, bit 3)
 398  8BA9 01 FE 7F         ld   bc, $7ffe
 399  8BAC ED 78            in   a, (c)
 400  8BAE CB 5F            bit  3, a
 401  8BB0 28 ED            jr   z, .wait_keys_release
 402  8BB2
 403  8BB2                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 404  8BB2 01 FE BF         ld   bc, $bffe
 405  8BB5 ED 78            in   a, (c)
 406  8BB7 CB 47            bit  0, a
 407  8BB9 28 E4            jr   z, .wait_keys_release
 408  8BBB
 409  8BBB                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 410  8BBB 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 411  8BBD              .wait_choice_loop:
 412  8BBD 76               halt
 413  8BBE
 414  8BBE                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 415  8BBE 0C               inc  c
 416  8BBF 79               ld   a, c
 417  8BC0 CB 3F            srl  a
 418  8BC2 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 419  8BC4 E6 07            and  7
 420  8BC6 5F               ld   e, a
 421  8BC7 16 00            ld   d, 0
 422  8BC9 21 B8 64         ld   hl, game_over_color_table
 423  8BCC 19               add  hl, de
 424  8BCD 7E               ld   a, (hl)               ; A = nuovo colore attributo
 425  8BCE 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 426  8BD1 06 09            ld   b, 9
 427  8BD3              .color_cycle_loop:
 428  8BD3 77               ld   (hl), a
 429  8BD4 23               inc  hl
 430  8BD5 10 FC            djnz .color_cycle_loop
 431  8BD7
 432  8BD7                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 433  8BD7 01 FE DF         ld   bc, $dffe
 434  8BDA ED 78            in   a, (c)
 435  8BDC CB 67            bit  4, a
 436  8BDE 28 2A            jr   z, .continue_chosen
 437  8BE0
 438  8BE0                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 439  8BE0 01 FE 7F         ld   bc, $7ffe
 440  8BE3 ED 78            in   a, (c)
 441  8BE5 CB 5F            bit  3, a
 442  8BE7 28 0B            jr   z, .quit_chosen
 443  8BE9
 444  8BE9                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 445  8BE9 01 FE BF         ld   bc, $bffe
 446  8BEC ED 78            in   a, (c)
 447  8BEE CB 47            bit  0, a
 448  8BF0 28 02            jr   z, .quit_chosen
 449  8BF2
 450  8BF2 18 C9            jr   .wait_choice_loop
 451  8BF4
 452  8BF4              .quit_chosen:
 453  8BF4                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 454  8BF4              .wait_quit_release:
 455  8BF4 76               halt
 456  8BF5 01 FE 7F         ld   bc, $7ffe
 457  8BF8 ED 78            in   a, (c)
 458  8BFA CB 5F            bit  3, a
 459  8BFC 28 F6            jr   z, .wait_quit_release
 460  8BFE 01 FE BF         ld   bc, $bffe
 461  8C01 ED 78            in   a, (c)
 462  8C03 CB 47            bit  0, a
 463  8C05 28 ED            jr   z, .wait_quit_release
 464  8C07
 465  8C07                  ; 5a. Esegue il normale flusso del Game Over (ritorno a Title Screen)
 466  8C07 C3 43 8B         jp   ShowTitleScreen
 467  8C0A
 468  8C0A              .continue_chosen:
 469  8C0A                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 470  8C0A              .wait_continue_release:
 471  8C0A 76               halt
 472  8C0B 01 FE DF         ld   bc, $dffe
 473  8C0E ED 78            in   a, (c)
 474  8C10 CB 67            bit  4, a
 475  8C12 28 F6            jr   z, .wait_continue_release
 476  8C14
 477  8C14                  ; 5b. Ripristina lo stato per continuare la partita:
 478  8C14                  ; - Ripristina le vite di Willy al valore iniziale
 479  8C14 3E 07            ld   a, INITIAL_LIVES
 480  8C16 32 12 F8         ld   (willy_lives), a
 481  8C19
 482  8C19                  ; - Se il Game Over era avvenuto per limite di tempo (12:00 AM), ripristina a 07:00 AM
 483  8C19 3A 14 FC         ld   a, (time_period)
 484  8C1C B7               or   a
 485  8C1D 20 19            jr   nz, .keep_current_time
 486  8C1F 3A 12 FC         ld   a, (time_hours)
 487  8C22 FE 0C            cp   12
 488  8C24 20 12            jr   nz, .keep_current_time
 489  8C26 3E 07            ld   a, 7
 490  8C28 32 12 FC         ld   (time_hours), a
 491  8C2B AF               xor  a
 492  8C2C 32 13 FC         ld   (time_minutes), a
 493  8C2F 32 14 FC         ld   (time_period), a
 494  8C32 32 17 FC         ld   (game_objective_completed), a
 495  8C35 CD 6D 68         call Gfx_UpdateTimeDisplay
 496  8C38              .keep_current_time:
 497  8C38                  ; - Sincronizza i contatori temporali con counter hardware per evitare salti dopo la pausa a schermo
 498  8C38 2A 26 F8         ld   hl, (counter)
 499  8C3B 22 15 FC         ld   (time_last_counter), hl
 500  8C3E 22 29 F8         ld   (last_frame_counter), hl
 501  8C41
 502  8C41                  ; - Reimposta la fisica e le variabili di stato di Willy
 503  8C41 AF               xor  a
 504  8C42 32 13 F8         ld   (velocity_y), a
 505  8C45 32 15 F8         ld   (jump_pressed), a
 506  8C48 32 17 F8         ld   (coyote_timer), a
 507  8C4B 32 1A F8         ld   (jump_frame), a
 508  8C4E 32 19 F8         ld   (jump_dir), a
 509  8C51 32 0B F8         ld   (body_state), a
 510  8C54 32 1E F8         ld   (w_warp_state), a
 511  8C57 32 21 F8         ld   (w_key_prev), a
 512  8C5A 32 22 F8         ld   (enter_key_prev), a
 513  8C5D 32 0E F8         ld   (collision_active), a
 514  8C60 32 0D F8         ld   (flags), a
 515  8C63 32 06 FC         ld   (ramp_entry_guard), a
 516  8C66 32 11 FC         ld   (willy_on_ramp), a
 517  8C69 32 10 FC         ld   (willy_needs_redraw), a
 518  8C6C 3E FF            ld   a, $ff
 519  8C6E 32 23 F8         ld   (digit_key_prev), a
 520  8C71 32 0B FC         ld   (player_drawn_pos+1), a
 521  8C74 32 0C FC         ld   (player_old_dir), a
 522  8C77 32 0D FC         ld   (player_old_body), a
 523  8C7A 3E 01            ld   a, 1
 524  8C7C 32 1C F8         ld   (q_prev), a
 525  8C7F 32 1D F8         ld   (a_prev), a
 526  8C82 32 14 F8         ld   (on_ground), a
 527  8C85 32 0E FC         ld   (enemy_was_updated), a
 528  8C88
 529  8C88                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 530  8C88 3E 00            ld   a, RESPAWN_SAFETY_TIME
 531  8C8A 32 0F FC         ld   (willy_safety_timer), a
 532  8C8D
 533  8C8D                  ; - Ripristina lo stato audio
 534  8C8D 3E 12            ld   a, 18
 535  8C8F 32 18 FC         ld   (Audio_jump_sound_note), a
 536  8C92 AF               xor  a
 537  8C93 32 19 FC         ld   (Audio_jump_sound_timer), a
 538  8C96                  IF ENABLE_MUSIC != 0
 539  8C96 32 1A FC         ld   (Audio_music_note_idx), a
 540  8C99 3E 01            ld   a, 1
 541  8C9B 32 1B FC         ld   (Audio_music_frame_counter), a
 542  8C9E                  ENDIF
 543  8C9E
 544  8C9E                  ; - Riposiziona Willy nel punto di ingresso dell'ultima stanza raggiunta
 545  8C9E CD 7F 82         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 546  8CA1 21 8C FB         ld   hl, room_entry_positions
 547  8CA4 5F               ld   e, a
 548  8CA5 16 00            ld   d, 0
 549  8CA7 19               add  hl, de
 550  8CA8 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 551  8CA9 4E               ld   c, (hl)                   ; C = X ingresso
 552  8CAA 23               inc  hl
 553  8CAB 46               ld   b, (hl)                   ; B = Y ingresso
 554  8CAC ED 43 05 F8      ld   (PlayerPos), bc           ; Imposta le coordinate al punto di ingresso
 555  8CB0 ED 43 07 F8      ld   (PlayerPosOld), bc
 556  8CB4
 557  8CB4 3E 01            ld   a, 1
 558  8CB6 32 8B FB         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 559  8CB9
 560  8CB9                  ; - Cancella lo schermo a nero prima del caricamento
 561  8CB9 AF               xor  a
 562  8CBA D3 FE            out  ($fe), a
 563  8CBC 21 8D 5C         ld   hl, ATTR_P
 564  8CBF 77               ld   (hl), a
 565  8CC0 CD AF 0D         call CLS
 566  8CC3 36 07            ld   (hl), $07
 567  8CC5 3E 07            ld   a, $07
 568  8CC7 32 8F 5C         ld   (ATTR_T), a
 569  8CCA
 570  8CCA                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 571  8CCA C3 1F 8A         jp   LoadRoomAndRestart
 572  8CCD
 573  8CCD              ; -------------------------------------------------------------------
 574  8CCD              ; TriggerVictory
 575  8CCD              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 576  8CCD              ; - Pulisce gli elementi di gioco della stanza.
 577  8CCD              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 578  8CCD              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 579  8CCD              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 580  8CCD              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 581  8CCD              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 582  8CCD              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 583  8CCD              ; -------------------------------------------------------------------
 584  8CCD              TriggerVictory:
 585  8CCD                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 586  8CCD CD 17 66         call Gfx_DrawVictoryScreen
 587  8CD0
 588  8CD0                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 589  8CD0              .wait_keys_release:
 590  8CD0 76               halt
 591  8CD1                  ; Controlla tasto Y (Porta $DF, bit 4)
 592  8CD1 01 FE DF         ld   bc, $dffe
 593  8CD4 ED 78            in   a, (c)
 594  8CD6 CB 67            bit  4, a
 595  8CD8 28 F6            jr   z, .wait_keys_release
 596  8CDA
 597  8CDA                  ; Controlla tasto N (Porta $7F, bit 3)
 598  8CDA 01 FE 7F         ld   bc, $7ffe
 599  8CDD ED 78            in   a, (c)
 600  8CDF CB 5F            bit  3, a
 601  8CE1 28 ED            jr   z, .wait_keys_release
 602  8CE3
 603  8CE3                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 604  8CE3 01 FE BF         ld   bc, $bffe
 605  8CE6 ED 78            in   a, (c)
 606  8CE8 CB 47            bit  0, a
 607  8CEA 28 E4            jr   z, .wait_keys_release
 608  8CEC
 609  8CEC                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 610  8CEC 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 611  8CEE              .wait_choice_loop:
 612  8CEE 76               halt
 613  8CEF
 614  8CEF                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 615  8CEF 0C               inc  c
 616  8CF0 79               ld   a, c
 617  8CF1 CB 3F            srl  a
 618  8CF3 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 619  8CF5 E6 07            and  7
 620  8CF7 5F               ld   e, a
 621  8CF8 16 00            ld   d, 0
 622  8CFA 21 F4 64         ld   hl, victory_color_table
 623  8CFD 19               add  hl, de
 624  8CFE 7E               ld   a, (hl)               ; A = nuovo colore attributo
 625  8CFF 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 626  8D02 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 627  8D04              .color_cycle_loop:
 628  8D04 77               ld   (hl), a
 629  8D05 23               inc  hl
 630  8D06 10 FC            djnz .color_cycle_loop
 631  8D08
 632  8D08                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 633  8D08 01 FE DF         ld   bc, $dffe
 634  8D0B ED 78            in   a, (c)
 635  8D0D CB 67            bit  4, a
 636  8D0F 28 2A            jr   z, .play_again_chosen
 637  8D11
 638  8D11                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 639  8D11 01 FE 7F         ld   bc, $7ffe
 640  8D14 ED 78            in   a, (c)
 641  8D16 CB 5F            bit  3, a
 642  8D18 28 0B            jr   z, .quit_chosen
 643  8D1A
 644  8D1A                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 645  8D1A 01 FE BF         ld   bc, $bffe
 646  8D1D ED 78            in   a, (c)
 647  8D1F CB 47            bit  0, a
 648  8D21 28 02            jr   z, .quit_chosen
 649  8D23
 650  8D23 18 C9            jr   .wait_choice_loop
 651  8D25
 652  8D25              .quit_chosen:
 653  8D25                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 654  8D25              .wait_quit_release:
 655  8D25 76               halt
 656  8D26 01 FE 7F         ld   bc, $7ffe
 657  8D29 ED 78            in   a, (c)
 658  8D2B CB 5F            bit  3, a
 659  8D2D 28 F6            jr   z, .wait_quit_release
 660  8D2F 01 FE BF         ld   bc, $bffe
 661  8D32 ED 78            in   a, (c)
 662  8D34 CB 47            bit  0, a
 663  8D36 28 ED            jr   z, .wait_quit_release
 664  8D38
 665  8D38                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 666  8D38 C3 43 8B         jp   ShowTitleScreen
 667  8D3B
 668  8D3B              .play_again_chosen:
 669  8D3B                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 670  8D3B              .wait_play_again_release:
 671  8D3B 76               halt
 672  8D3C 01 FE DF         ld   bc, $dffe
 673  8D3F ED 78            in   a, (c)
 674  8D41 CB 67            bit  4, a
 675  8D43 28 F6            jr   z, .wait_play_again_release
 676  8D45
 677  8D45                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 678  8D45 CD 05 8E         call ResetFullGameState
 679  8D48 C3 1F 8A         jp   LoadRoomAndRestart
 680  8D4B
 681  8D4B              ; -------------------------------------------------------------------
 682  8D4B              ; CheckVictoryCondition
 683  8D4B              ; Verifica se si verificano contemporaneamente tutte le 3 condizioni di vittoria:
 684  8D4B              ; 1. Willy ha raccolto tutti gli oggetti collezionabili del gioco (tutti i flag in ItemsTable = 1);
 685  8D4B              ; 2. Willy si trova nella stanza Master Bedroom;
 686  8D4B              ; 3. Willy collide con un oggetto/tag di tipo Conveyor in quella stanza.
 687  8D4B              ;
 688  8D4B              ; Output:
 689  8D4B              ;   Carry Flag = 1 se la vittoria è attivata
 690  8D4B              ;   Carry Flag = 0 altrimenti
 691  8D4B              ; -------------------------------------------------------------------
 692  8D4B              CheckVictoryCondition:
 693  8D4B C5               push bc
 694  8D4C D5               push de
 695  8D4D E5               push hl
 696  8D4E
 697  8D4E                  ; 1. Condizione: tutti gli item raccolti?
 698  8D4E CD 67 8D         call CheckAllItemsCollected
 699  8D51 30 0F            jr   nc, .no_victory
 700  8D53
 701  8D53                  ; 2. Condizione: Willy è nella Master Bedroom?
 702  8D53 CD 8E 8D         call CheckInMasterBedroom
 703  8D56 30 0A            jr   nc, .no_victory
 704  8D58
 705  8D58                  ; 3. Condizione: Willy collide con il conveyor?
 706  8D58 CD AA 8D         call CheckWillyConveyorCollision
 707  8D5B 30 05            jr   nc, .no_victory
 708  8D5D
 709  8D5D                  ; Tutte le condizioni sono soddisfatte contemporaneamente!
 710  8D5D E1               pop  hl
 711  8D5E D1               pop  de
 712  8D5F C1               pop  bc
 713  8D60 37               scf
 714  8D61 C9               ret
 715  8D62
 716  8D62              .no_victory:
 717  8D62 E1               pop  hl
 718  8D63 D1               pop  de
 719  8D64 C1               pop  bc
 720  8D65 B7               or   a
 721  8D66 C9               ret
 722  8D67
 723  8D67              ; -------------------------------------------------------------------
 724  8D67              ; CheckAllItemsCollected
 725  8D67              ; Verifica che tutti gli item del gioco siano stati raccolti.
 726  8D67              ; - Controllo preliminare sul conteggio/flag globale
 727  8D67              ; - Verifica puntuale che ogni record in ItemsTable abbia flag = 1 (raccolto)
 728  8D67              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 729  8D67              ; -------------------------------------------------------------------
 730  8D67              CheckAllItemsCollected:
 731  8D67 E5               push hl
 732  8D68 3A 17 FC         ld   a, (game_objective_completed)
 733  8D6B B7               or   a
 734  8D6C 20 07            jr   nz, .verify_flags
 735  8D6E 3A 0F F8         ld   a, (items_collected)
 736  8D71 FE 4D            cp   TOTAL_ITEMS
 737  8D73 38 16            jr   c, .not_all
 738  8D75
 739  8D75              .verify_flags:
 740  8D75 21 FD 80         ld   hl, ItemsTable
 741  8D78              .loop:
 742  8D78 7E               ld   a, (hl)
 743  8D79 FE FF            cp   $FF
 744  8D7B 28 0B            jr   z, .done_all
 745  8D7D 23               inc  hl                    ; +1 X
 746  8D7E 23               inc  hl                    ; +2 Y
 747  8D7F 23               inc  hl                    ; +3 Color
 748  8D80 23               inc  hl                    ; +4 Collected flag
 749  8D81 7E               ld   a, (hl)
 750  8D82 B7               or   a
 751  8D83 28 06            jr   z, .not_all           ; Trovato un item non raccolto -> fail
 752  8D85 23               inc  hl                    ; Prossimo record
 753  8D86 18 F0            jr   .loop
 754  8D88
 755  8D88              .done_all:
 756  8D88 E1               pop  hl
 757  8D89 37               scf
 758  8D8A C9               ret
 759  8D8B
 760  8D8B              .not_all:
 761  8D8B E1               pop  hl
 762  8D8C B7               or   a
 763  8D8D C9               ret
 764  8D8E
 765  8D8E              ; -------------------------------------------------------------------
 766  8D8E              ; CheckInMasterBedroom
 767  8D8E              ; Verifica se la stanza corrente è Master Bedroom (ID 35 / MastreBedRoomLayout)
 768  8D8E              ; Output: Carry = 1 se Master Bedroom, Carry = 0 altrimenti
 769  8D8E              ; -------------------------------------------------------------------
 770  8D8E              CheckInMasterBedroom:
 771  8D8E E5               push hl
 772  8D8F D5               push de
 773  8D90 2A 85 FB         ld   hl, (room_ptr)
 774  8D93 11 F9 B5         ld   de, MastreBedRoomLayout
 775  8D96 B7               or   a
 776  8D97 ED 52            sbc  hl, de
 777  8D99 28 0B            jr   z, .is_master
 778  8D9B 3A 2B FB         ld   a, (current_room)
 779  8D9E FE 23            cp   ROOM_MASTER_BEDROOM
 780  8DA0 28 04            jr   z, .is_master
 781  8DA2 D1               pop  de
 782  8DA3 E1               pop  hl
 783  8DA4 B7               or   a
 784  8DA5 C9               ret
 785  8DA6              .is_master:
 786  8DA6 D1               pop  de
 787  8DA7 E1               pop  hl
 788  8DA8 37               scf
 789  8DA9 C9               ret
 790  8DAA
 791  8DAA              ; -------------------------------------------------------------------
 792  8DAA              ; CheckWillyConveyorCollision
 793  8DAA              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 794  8DAA              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 795  8DAA              ; -------------------------------------------------------------------
 796  8DAA              CheckWillyConveyorCollision:
 797  8DAA C5               push bc
 798  8DAB D5               push de
 799  8DAC E5               push hl
 800  8DAD
 801  8DAD                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 802  8DAD CD 43 76         call CheckWillyOnConveyor
 803  8DB0 38 49            jr   c, .collision_detected
 804  8DB2
 805  8DB2                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 806  8DB2 3A 2D FB         ld   a, (conveyor_len)
 807  8DB5 B7               or   a
