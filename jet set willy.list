 685+ 60CA 78               ld   a, b
 686+ 60CB BA               cp   d
 687+ 60CC 20 1E            jr   nz, .player_moved
 688+ 60CE 79               ld   a, c
 689+ 60CF BB               cp   e
 690+ 60D0 20 1A            jr   nz, .player_moved
 691+ 60D2
 692+ 60D2 3A 5E F4         ld   a, (direction)
 693+ 60D5 21 5E F8         ld   hl, player_old_dir
 694+ 60D8 BE               cp   (hl)
 695+ 60D9 20 11            jr   nz, .player_moved
 696+ 60DB
 697+ 60DB 3A 5D F4         ld   a, (body_state)
 698+ 60DE 21 5F F8         ld   hl, player_old_body
 699+ 60E1 BE               cp   (hl)
 700+ 60E2 20 08            jr   nz, .player_moved
 701+ 60E4
 702+ 60E4                  ; Willy non si è mosso. Ma se un nemico lo ha sovrascritto, ridisegnalo senza prima cancellarlo!
 703+ 60E4 3A 62 F8         ld   a, (willy_needs_redraw)
 704+ 60E7 B7               or   a
 705+ 60E8 20 2F            jr   nz, .redraw_overlay_only
 706+ 60EA 18 55            jr   .player_no_change
 707+ 60EC
 708+ 60EC              .player_moved:
