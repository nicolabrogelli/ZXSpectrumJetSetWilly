 323+ 74D1              ; -------------------------------------------------------------------
 324+ 74D1              ; Controlla se Willy collide con un item (pixel-level check)
 325+ 74D1              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 326+ 74D1              ; Output: Carry set se collide, altrimenti clear
 327+ 74D1              ; -------------------------------------------------------------------
 328+ 74D1              CheckWillyItemCollision:
 329+ 74D1 C5               push bc
 330+ 74D2 D5               push de
 331+ 74D3 E5               push hl
 332+ 74D4
 333+ 74D4                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 334+ 74D4 6F               ld   l, a
 335+ 74D5 7D               ld   a, l
 336+ 74D6 87               add  a, a              ; *2
 337+ 74D7 87               add  a, a              ; *4
 338+ 74D8 87               add  a, a              ; *8
 339+ 74D9 5F               ld   e, a              ; E = ItemLeft
 340+ 74DA C6 07            add  a, 7
 341+ 74DC 57               ld   d, a              ; D = ItemRight
 342+ 74DD
 343+ 74DD                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 344+ 74DD ED 4B 11 76      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 345+ 74E1
 346+ 74E1                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 347+ 74E1 79               ld   a, c
 348+ 74E2 BA               cp   d
 349+ 74E3 28 04            jr   z, .x_ok
 350+ 74E5 38 02            jr   c, .x_ok
 351+ 74E7 18 29            jr   .no_collision
 352+ 74E9              .x_ok:
 353+ 74E9 C6 0F            add  a, 15
 354+ 74EB BB               cp   e
 355+ 74EC 28 04            jr   z, .y_check
 356+ 74EE 30 02            jr   nc, .y_check
 357+ 74F0 18 20            jr   .no_collision
 358+ 74F2
 359+ 74F2              .y_check:
 360+ 74F2 E1               pop  hl                ; Recupera HL originale (H = ItemY)
 361+ 74F3 E5               push hl
 362+ 74F4 7C               ld   a, h
 363+ 74F5 87               add  a, a              ; *2
 364+ 74F6 87               add  a, a              ; *4
 365+ 74F7 87               add  a, a              ; *8
 366+ 74F8 5F               ld   e, a              ; E = ItemTop
 367+ 74F9 C6 07            add  a, 7
 368+ 74FB 57               ld   d, a              ; D = ItemBottom
 369+ 74FC
 370+ 74FC                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 371+ 74FC 78               ld   a, b
 372+ 74FD BA               cp   d
 373+ 74FE 28 04            jr   z, .y_ok
