 473  88D1
 474  88D1 C9               ret
 475  88D2
 476  88D2              ; -------------------------------------------------------------------
 477  88D2              ; Time_UpdateClock
 478  88D2              ; Gestisce lo scorrimento del tempo durante il gioco.
 479  88D2              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 480  88D2              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 481  88D2              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 482  88D2              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 483  88D2              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 484  88D2              ; sia completato, scatena immediatamente il Game Over.
 485  88D2              ; -------------------------------------------------------------------
 486  88D2              Time_UpdateClock:
 487  88D2                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 488  88D2 2A 78 EB         ld   hl, (counter)
 489  88D5 ED 5B 67 EF      ld   de, (time_last_counter)
 490  88D9 B7               or   a
 491  88DA ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 492  88DC
 493  88DC                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 494  88DC 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 495  88DF B7               or   a
 496  88E0 ED 52            sbc  hl, de
 497  88E2 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 498  88E3
 499  88E3                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 500  88E3 2A 67 EF         ld   hl, (time_last_counter)
 501  88E6 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 502  88E9 19               add  hl, de
 503  88EA 22 67 EF         ld   (time_last_counter), hl
 504  88ED
 505  88ED                  ; Incrementa di 1 minuto il tempo di gioco
 506  88ED 3A 65 EF         ld   a, (time_minutes)
 507  88F0 3C               inc  a
 508  88F1 FE 3C            cp   60
 509  88F3 38 21            jr   c, .minutes_ok
 510  88F5
 511  88F5                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 512  88F5 AF               xor  a
 513  88F6 32 65 EF         ld   (time_minutes), a
 514  88F9 3A 64 EF         ld   a, (time_hours)
 515  88FC 3C               inc  a
 516  88FD FE 0C            cp   12
 517  88FF 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 518  8901 FE 0D            cp   13
 519  8903 38 0E            jr   c, .hours_ok
 520  8905 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 521  8907 18 0A            jr   .hours_ok
 522  8909
 523  8909              .toggle_period:
 524  8909 F5               push af                     ; Salva A (valore 12)
 525  890A 3A 66 EF         ld   a, (time_period)
 526  890D EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 527  890F 32 66 EF         ld   (time_period), a
 528  8912 F1               pop  af                     ; Ripristina A = 12
 529  8913
 530  8913              .hours_ok:
 531  8913 32 64 EF         ld   (time_hours), a
 532  8916
 533  8916              .minutes_ok:
 534  8916 32 65 EF         ld   (time_minutes), a
 535  8919
 536  8919                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 537  8919 CD C6 66         call Gfx_UpdateTimeDisplay
 538  891C
 539  891C                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 540  891C 3A 69 EF         ld   a, (game_objective_completed)
 541  891F B7               or   a
 542  8920 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 543  8921
 544  8921                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 545  8921 3A 66 EF         ld   a, (time_period)
 546  8924 B7               or   a
 547  8925 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 548  8926
 549  8926 3A 64 EF         ld   a, (time_hours)
 550  8929 FE 0C            cp   12
 551  892B 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
 552  892D C9               ret
 553  892E
 554  892E              .time_limit_reached:
 555  892E                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
 556  892E                  ; Scatena immediatamente il Game Over temporale!
 557  892E C3 1E 88         jp   TriggerGameOver
