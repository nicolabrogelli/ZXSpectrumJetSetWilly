  33+ 5DCB              im2_handler:
  34+ 5DCB F5               push af
  35+ 5DCC E5               push hl
  36+ 5DCD
  37+ 5DCD                  ; Reset interrupt ULA
  38+ 5DCD DB FE            in a, (0xFE)
  39+ 5DCF
  40+ 5DCF                  ; Incrementa il contatore (usato per animazioni/raster bars)
  41+ 5DCF 2A EC 7A         ld hl, (counter)
  42+ 5DD2 23               inc hl
  43+ 5DD3 22 EC 7A         ld (counter), hl
  44+ 5DD6
  45+ 5DD6                  ; Ripristina registri
  46+ 5DD6 E1               pop hl
  47+ 5DD7 F1               pop af
  48+ 5DD8 FB               ei
  49+ 5DD9 ED 4D            reti
