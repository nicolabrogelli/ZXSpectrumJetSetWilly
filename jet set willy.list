  71+ 74CF              ; Audio_UpdateMusic
  72+ 74CF              ;
  73+ 74CF              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 74CF              ; Viene chiamata a ogni frame.
  75+ 74CF              ; -------------------------------------------------------------------
  76+ 74CF              Audio_UpdateMusic:
  77+ 74CF F5               push af
  78+ 74D0 C5               push bc
  79+ 74D1 D5               push de
  80+ 74D2 E5               push hl
  81+ 74D3
  82+ 74D3                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 74D3 3A 1A 79         ld   a, (Audio_jump_sound_note)
  84+ 74D6 FE 12            cp   18
  85+ 74D8 38 5A            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 74DA
  87+ 74DA                  ; Decrementa il contatore dei frame della nota corrente
  88+ 74DA 3A 1D 79         ld   a, (Audio_music_frame_counter)
  89+ 74DD 3D               dec  a
  90+ 74DE 32 1D 79         ld   (Audio_music_frame_counter), a
  91+ 74E1 20 23            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 74E3
  93+ 74E3                  ; Altrimenti carica la nota successiva
  94+ 74E3 3A 1C 79         ld   a, (Audio_music_note_idx)
  95+ 74E6 3C               inc  a
  96+ 74E7 FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 74E9 38 01            jr   c, .no_wrap
  98+ 74EB AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 74EC              .no_wrap:
 100+ 74EC 32 1C 79         ld   (Audio_music_note_idx), a
 101+ 74EF
 102+ 74EF                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 74EF 5F               ld   e, a
 104+ 74F0 16 00            ld   d, 0
 105+ 74F2 21 39 75         ld   hl, Audio_MusicSheet
 106+ 74F5 19               add  hl, de
 107+ 74F6 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 74F7
 109+ 74F7                  ; Leggi durata (secondo byte)
 110+ 74F7 23               inc  hl
 111+ 74F8 7E               ld   a, (hl)
 112+ 74F9 CB 3F            srl  a                        ; Divide per 8 (velocizza 8x)
 113+ 74FB CB 3F            srl  a
 114+ 74FD CB 3F            srl  a
 115+ 74FF 20 02            jr   nz, .dur_ok
 116+ 7501 3E 01            ld   a, 1
 117+ 7503              .dur_ok:
 118+ 7503 32 1D 79         ld   (Audio_music_frame_counter), a
