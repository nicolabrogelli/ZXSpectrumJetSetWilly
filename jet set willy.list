 187+ 7F94
 188+ 7F94              ; -------------------------------------------------------------------
 189+ 7F94              ; DetermineCurrentRoomID
 190+ 7F94              ;
 191+ 7F94              ; Determina l'ID numerico della stanza corrente confrontando
 192+ 7F94              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 193+ 7F94              ;
 194+ 7F94              ; Se viene trovata una corrispondenza:
 195+ 7F94              ;   A = ID della stanza
 196+ 7F94              ;   current_room = A
 197+ 7F94              ;
 198+ 7F94              ; Mappatura:
 199+ 7F94              ;    0 = The Off Licence
 200+ 7F94              ;    1 = The Bridge
 201+ 7F94              ;    2 = Under The Mega Tree
 202+ 7F94              ;    3 = Gfx_At The Foot Of The Mega Tree
 203+ 7F94              ;    4 = The Drive
 204+ 7F94              ;    5 = The Security Guard
 205+ 7F94              ;    6 = Entrance To Hades
 206+ 7F94              ;    7 = Cuckoo's Nest
 207+ 7F94              ;    8 = Inside The Mega Trunk
 208+ 7F94              ;    9 = On A Branch Over The Drive
 209+ 7F94              ;   10 = The Front Door
 210+ 7F94              ;   11 = The Hall
 211+ 7F94              ;   12 = Tree Top
 212+ 7F94              ;   27 = The Chapel
 213+ 7F94              ;   28 = First Landing
 214+ 7F94              ;   29 = The Nightmare Room
 215+ 7F94              ;   33 = The Bathroom
 216+ 7F94              ;   35 = Master Bedroom
 217+ 7F94              ;
 218+ 7F94              ; Se nessuna stanza corrisponde viene impostato:
 219+ 7F94              ;   current_room = 0
 220+ 7F94              ; -------------------------------------------------------------------
 221+ 7F94              DetermineCurrentRoomID:
 222+ 7F94
 223+ 7F94                  ; Salva i registri utilizzati
 224+ 7F94 E5               push hl
 225+ 7F95 D5               push de
 226+ 7F96
 227+ 7F96                  ; ---------------------------------------------------------------
 228+ 7F96                  ; Confronto con TheOffLicenceLayout
 229+ 7F96                  ; ---------------------------------------------------------------
 230+ 7F96 2A FF ED         ld   hl, (room_ptr)
 231+ 7F99 11 59 88         ld   de, TheOffLicenceLayout
 232+ 7F9C B7               or   a
 233+ 7F9D ED 52            sbc  hl, de
 234+ 7F9F 20 05            jr   nz, .not_office
 235+ 7FA1
 236+ 7FA1 3E 00            ld   a, 0               ; Room ID = 0
 237+ 7FA3 C3 68 83         jp   .set_room
 238+ 7FA6
 239+ 7FA6              .not_office:
