 106+ 654F                  ; Se collisione: non aggiornare posizione
 107+ 654F 38 6F            jr   c, save_x
 108+ 6551
 109+ 6551                  ; Applica movimento
 110+ 6551 3A FE 7E         ld   a, (player_speed)
 111+ 6554 5F               ld   e, a
 112+ 6555
 113+ 6555 79               ld   a, c
 114+ 6556 93               sub  e
 115+ 6557 4F               ld   c, a
 116+ 6558
 117+ 6558 18 66            jr   save_x
