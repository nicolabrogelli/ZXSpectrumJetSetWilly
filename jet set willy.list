 140+ 659B 5E               ld   e, (hl)
 141+ 659C 23               inc  hl
 142+ 659D 56               ld   d, (hl)                   ; DE = puntatore al layout della nuova stanza
 143+ 659E
 144+ 659E ED 53 21 7E      ld   (room_ptr), de            ; Aggiorna room_ptr
