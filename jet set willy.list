 128  88D0                  IF ENABLE_ANIMATE_LIVES != 0
 129  88D0 ~                call Gfx_PrintWillyLives
 130  88D0                  ENDIF
 131  88D0
 132  88D0
 133  88D0                  ; 3. Salva le posizioni correnti del player per il prossimo frame
 134  88D0 ED 4B 2F F3      ld   bc, (PlayerPos)
 135  88D4 ED 43 31 F3      ld   (PlayerPosOld), bc
 136  88D8
 137  88D8                  ; 4. Aggiorna le posizioni dei personaggi per il prossimo frame
 138  88D8 CD 43 6E         call Input_CheckCtrl
 139  88DB CD 1D 6D         call MovePlayer
 140  88DE CD E4 71         call Phys_ApplyGravity
 141  88E1 CD B3 75         call Phys_ApplyConveyor
 142  88E4 CD 7A 7F         call Enemy_Update
 143  88E7 CD 49 87         call Items_CheckCollision
 144  88EA
 145  88EA                  ; Controlla condizione di vittoria (Tutti gli item + Master Bedroom + Conveyor)
 146  88EA                  IF ENABLE_VICTORY_SCREEN != 0
 147  88EA CD 75 8B         call CheckVictoryCondition
 148  88ED DA F7 8A         jp   c, TriggerVictory
 149  88F0                  ENDIF
 150  88F0
 151  88F0                  ; Controlla collisione con Nasties (morte di Willy)
 152  88F0                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 153  88F0 CD 31 7A         call Phys_CheckNastyCollision
 154  88F3 38 0B            jr   c, .willy_dies
 155  88F5                  ENDIF
 156  88F5
 157  88F5                  ; Controlla collisione con guardiani
 158  88F5 CD 2A 75         call CheckCollision
 159  88F8 38 03            jr   c, .guardian_collision_found
 160  88FA
 161  88FA                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 162  88FA                  IF ENABLE_RAMP_DEBUG_BARS != 0
 163  88FA ~                ld   a, (willy_on_ramp)
 164  88FA ~                or   a
 165  88FA ~                jp   nz, .draw_raster_bars
 166  88FA                  ENDIF
 167  88FA
 168  88FA C3 77 89         jp   .no_collision
 169  88FD
 170  88FD              .guardian_collision_found:
 171  88FD                  ; C'è collisione con un guardiano!
 172  88FD                  ; Controlla se la morte per collisione con i guardiani è abilitata
 173  88FD                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 174  88FD C3 00 89         jp   .willy_dies
 175  8900                  ELSE
 176  8900 ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 177  8900 ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 178  8900 ~                    ELSE
 179  8900 ~                    jp   .no_collision
 180  8900 ~                    ENDIF
 181  8900                  ENDIF
 182  8900
 183  8900              .willy_dies:
 184  8900                  ; 1. Decrementa le vite
 185  8900 21 3C F3         ld   hl, willy_lives
 186  8903 7E               ld   a, (hl)
 187  8904 B7               or   a
 188  8905 28 05            jr   z, .check_game_over
 189  8907 35               dec  (hl)
 190  8908 28 02            jr   z, .check_game_over
 191  890A 18 03            jr   .normal_respawn
 192  890C
 193  890C              .check_game_over:
 194  890C                  IF ENABLE_GAME_OVER_RESTART != 0
 195  890C C3 CE 89         jp   TriggerGameOver
 196  890F                  ELSE
 197  890F ~                ld   a, 1
 198  890F ~                ld   (willy_lives), a
 199  890F ~                jr   .normal_respawn
 200  890F                  ENDIF
 201  890F
 202  890F              .normal_respawn:
 203  890F                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 204  890F AF               xor  a
 205  8910 D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 206  8912 21 8D 5C         ld   hl, ATTR_P
 207  8915 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 208  8916 CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 209  8919 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 210  891B 3E 07            ld   a, $07
 211  891D 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 212  8920
 213  8920                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 214  8920 06 19            ld   b, 25
 215  8922              .death_pause:
 216  8922 76               halt
 217  8923 10 FD            djnz .death_pause
 218  8925
 219  8925                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 220  8925 AF               xor  a
 221  8926 32 3D F3         ld   (velocity_y), a
 222  8929 32 3F F3         ld   (jump_pressed), a
 223  892C 32 41 F3         ld   (coyote_timer), a
 224  892F 32 44 F3         ld   (jump_frame), a
 225  8932 32 43 F3         ld   (jump_dir), a
 226  8935 3E 01            ld   a, 1
 227  8937 32 3E F3         ld   (on_ground), a
 228  893A
 229  893A 3E 00            ld   a, RESPAWN_SAFETY_TIME
 230  893C 32 39 F7         ld   (willy_safety_timer), a
 231  893F
 232  893F                  ; 5. Riposiziona Willy nel punto di ingresso dell'ultima stanza raggiunta
 233  893F CD 16 82         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 234  8942 21 B6 F6         ld   hl, room_entry_positions
 235  8945 5F               ld   e, a
 236  8946 16 00            ld   d, 0
 237  8948 19               add  hl, de
 238  8949 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 239  894A 4E               ld   c, (hl)                   ; C = X ingresso
 240  894B 23               inc  hl
 241  894C 46               ld   b, (hl)                   ; B = Y ingresso
 242  894D ED 43 2F F3      ld   (PlayerPos), bc           ; Imposta le coordinate di respawn al punto di ingresso
 243  8951 ED 43 31 F3      ld   (PlayerPosOld), bc
 244  8955
 245  8955 3E 01            ld   a, 1
 246  8957 32 B5 F6         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 247  895A
 248  895A                  ; 6. Ridisegna completamente la stanza e riposiziona Willy nel punto di ingresso
 249  895A C3 61 88         jp   LoadRoomAndRestart
 250  895D
 251  895D              .draw_raster_bars:
 252  895D                  ; Collisione attiva: disegna le raster bar nel bordo
 253  895D 3A 50 F3         ld   a, (counter)
 254  8960 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 255  8962 06 1E            ld   b, 30             ; Numero di righe della barra raster
 256  8964              .raster_loop:
 257  8964 D3 FE            out  ($fe), a
 258  8966 3C               inc  a
 259  8967 E6 07            and  7
 260  8969 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 261  896B              .delay:
 262  896B 0D               dec  c
 263  896C 20 FD            jr   nz, .delay
 264  896E 10 F4            djnz .raster_loop
 265  8970
 266  8970                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 267  8970 3A 3B F3         ld   a, (room_border_color)
 268  8973 D3 FE            out  ($fe), a
 269  8975 18 05            jr   .no_collision_change
 270  8977
 271  8977              .no_collision:
 272  8977                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 273  8977 3A 3B F3         ld   a, (room_border_color)
 274  897A D3 FE            out  ($fe), a
 275  897C
 276  897C              .no_collision_change:
 277  897C C3 A7 88         jp   Main_loop
 278  897F
 279  897F              ; -------------------------------------------------------------------
 280  897F              ; ShowTitleScreen
 281  897F              ; Visualizza la schermata iniziale del gioco (Title Screen).
 282  897F              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 283  897F              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 284  897F              ; -------------------------------------------------------------------
 285  897F              ShowTitleScreen:
 286  897F                  ; 1. Disegna la schermata iniziale
 287  897F CD 1B 63         call Gfx_DrawTitleScreen
 288  8982
 289  8982                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 290  8982              .wait_title_enter_release:
 291  8982 76               halt
 292  8983 3E BF            ld   a, $bf
 293  8985 DB FE            in   a, ($fe)
 294  8987 1F               rra
 295  8988 30 F8            jr   nc, .wait_title_enter_release
 296  898A
 297  898A                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 298  898A 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 299  898C              .title_loop:
 300  898C 76               halt
 301  898D
 302  898D                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 303  898D 0C               inc  c
 304  898E 79               ld   a, c
 305  898F CB 3F            srl  a
 306  8991 CB 3F            srl  a
 307  8993 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 308  8995 E6 07            and  7
 309  8997 5F               ld   e, a
 310  8998 16 00            ld   d, 0
 311  899A 21 13 63         ld   hl, title_color_table
 312  899D 19               add  hl, de
 313  899E 7E               ld   a, (hl)               ; A = nuovo colore
 314  899F 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 315  89A2 06 20            ld   b, 32
 316  89A4              .color_title_loop:
 317  89A4 77               ld   (hl), a
 318  89A5 23               inc  hl
 319  89A6 10 FC            djnz .color_title_loop
 320  89A8
 321  89A8                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 322  89A8 3E BF            ld   a, $bf
 323  89AA DB FE            in   a, ($fe)
 324  89AC 1F               rra
 325  89AD 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 326  89AF
 327  89AF                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 328  89AF              .wait_title_enter_release_after:
 329  89AF 76               halt
 330  89B0 3E BF            ld   a, $bf
 331  89B2 DB FE            in   a, ($fe)
 332  89B4 1F               rra
 333  89B5 30 F8            jr   nc, .wait_title_enter_release_after
 334  89B7
 335  89B7                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 336  89B7 AF               xor  a
 337  89B8 D3 FE            out  ($fe), a              ; Bordo a nero
 338  89BA 21 8D 5C         ld   hl, ATTR_P
 339  89BD 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 340  89BE CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 341  89C1 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 342  89C3 3E 07            ld   a, $07
 343  89C5 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 344  89C8
 345  89C8                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 346  89C8 CD 2F 8C         call ResetFullGameState
 347  89CB
 348  89CB                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 349  89CB C3 61 88         jp   LoadRoomAndRestart
 350  89CE
 351  89CE              ; -------------------------------------------------------------------
 352  89CE              ; TriggerGameOver
 353  89CE              ; Scatena la schermata di Game Over per la stanza corrente.
 354  89CE              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 355  89CE              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 356  89CE              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 357  89CE              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 358  89CE              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 359  89CE              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 360  89CE              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 361  89CE              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 362  89CE              ; -------------------------------------------------------------------
 363  89CE              TriggerGameOver:
 364  89CE                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 365  89CE CD FC 64         call Gfx_DrawGameOverScreen
 366  89D1
 367  89D1                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 368  89D1              .wait_keys_release:
 369  89D1 76               halt
 370  89D2                  ; Controlla tasto Y (Porta $DF, bit 4)
 371  89D2 01 FE DF         ld   bc, $dffe
 372  89D5 ED 78            in   a, (c)
 373  89D7 CB 67            bit  4, a
 374  89D9 28 F6            jr   z, .wait_keys_release
 375  89DB
 376  89DB                  ; Controlla tasto N (Porta $7F, bit 3)
 377  89DB 01 FE 7F         ld   bc, $7ffe
 378  89DE ED 78            in   a, (c)
 379  89E0 CB 5F            bit  3, a
 380  89E2 28 ED            jr   z, .wait_keys_release
 381  89E4
 382  89E4                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 383  89E4 01 FE BF         ld   bc, $bffe
 384  89E7 ED 78            in   a, (c)
 385  89E9 CB 47            bit  0, a
 386  89EB 28 E4            jr   z, .wait_keys_release
 387  89ED
 388  89ED                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 389  89ED 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 390  89EF              .wait_choice_loop:
 391  89EF 76               halt
 392  89F0
 393  89F0                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 394  89F0 0C               inc  c
 395  89F1 79               ld   a, c
 396  89F2 CB 3F            srl  a
 397  89F4 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 398  89F6 E6 07            and  7
 399  89F8 5F               ld   e, a
 400  89F9 16 00            ld   d, 0
 401  89FB 21 B8 64         ld   hl, game_over_color_table
 402  89FE 19               add  hl, de
 403  89FF 7E               ld   a, (hl)               ; A = nuovo colore attributo
 404  8A00 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 405  8A03 06 09            ld   b, 9
 406  8A05              .color_cycle_loop:
 407  8A05 77               ld   (hl), a
 408  8A06 23               inc  hl
 409  8A07 10 FC            djnz .color_cycle_loop
 410  8A09
 411  8A09                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 412  8A09 01 FE DF         ld   bc, $dffe
 413  8A0C ED 78            in   a, (c)
 414  8A0E CB 67            bit  4, a
 415  8A10 28 2A            jr   z, .continue_chosen
 416  8A12
 417  8A12                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 418  8A12 01 FE 7F         ld   bc, $7ffe
 419  8A15 ED 78            in   a, (c)
 420  8A17 CB 5F            bit  3, a
 421  8A19 28 0B            jr   z, .quit_chosen
 422  8A1B
 423  8A1B                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 424  8A1B 01 FE BF         ld   bc, $bffe
 425  8A1E ED 78            in   a, (c)
 426  8A20 CB 47            bit  0, a
 427  8A22 28 02            jr   z, .quit_chosen
 428  8A24
 429  8A24 18 C9            jr   .wait_choice_loop
 430  8A26
 431  8A26              .quit_chosen:
 432  8A26                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 433  8A26              .wait_quit_release:
 434  8A26 76               halt
 435  8A27 01 FE 7F         ld   bc, $7ffe
 436  8A2A ED 78            in   a, (c)
