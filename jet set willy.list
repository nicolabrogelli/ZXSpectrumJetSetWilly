 286+ 7CC8 2A 96 EA         ld   hl, (room_ptr)
 287+ 7CCB 11 68 89         ld   de, TheDriveLayout
 288+ 7CCE B7               or   a
 289+ 7CCF ED 52            sbc  hl, de
 290+ 7CD1 20 05            jr   nz, .not_thedrive
 291+ 7CD3
 292+ 7CD3 3E 04            ld   a, 4               ; Room ID = 4
 293+ 7CD5 C3 5A 80         jp   .set_room
