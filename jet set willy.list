 141+ 5E53 78               ld   a, b          ; Shift se necessario
 142+ 5E54 B7               or   a
 143+ 5E55 28 07            jr   z, .no_shift
 144+ 5E57
 145+ 5E57              .shift_loop:
 146+ 5E57 CB 3A            srl  d
 147+ 5E59 CB 1B            rr   e
 148+ 5E5B 3D               dec  a
 149+ 5E5C 20 F9            jr   nz, .shift_loop
 150+ 5E5E
 151+ 5E5E              .no_shift:
 152+ 5E5E                  ; Scrivi sullo schermo (OR trasparente)
 153+ 5E5E 7A               ld   a, d
 154+ 5E5F B6               or   (hl)
 155+ 5E60 77               ld   (hl), a
 156+ 5E61 23               inc  hl
 157+ 5E62 7B               ld   a, e
 158+ 5E63 B6               or   (hl)
 159+ 5E64 77               ld   (hl), a
 160+ 5E65 2B               dec  hl            ; Ritorna alla colonna iniziale
 161+ 5E66
 162+ 5E66 CD 2E 5E         call IncScreenLine ; Prossima scanline sullo schermo
 163+ 5E69 DD 23            inc  ix            ; Prossimo byte dello sprite
 164+ 5E6B 0D               dec  c
 165+ 5E6C 20 DF            jr   nz, .line_loop
