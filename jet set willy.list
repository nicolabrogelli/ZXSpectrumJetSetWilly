 312+ 6B9F
 313+ 6B9F C5               push bc
 314+ 6BA0 FD E1            pop  iy                ; IY = original BC (IYH = Row, IYL = Col)
 315+ 6BA2
 316+ 6BA2                  ; Riga di layout: r = B
 317+ 6BA2 78               ld   a, b
 318+ 6BA3                  ; A = r (0..15)
 319+ 6BA3
 320+ 6BA3                  ; Colonna: c = C (Col)
 321+ 6BA3 CD 85 67         call GetCellFromUnpacked ; A = cell type (0..3)
 322+ 6BA6
 323+ 6BA6 ED 5B 63 7A      ld   de, (room_ptr)
 324+ 6BAA B7               or   a
 325+ 6BAB 20 06            jr   nz, .not_bg
 326+ 6BAD 21 A0 00         ld   hl, OFFSET_BG
 327+ 6BB0 19               add  hl, de
 328+ 6BB1 18 16            jr   .draw_cell
