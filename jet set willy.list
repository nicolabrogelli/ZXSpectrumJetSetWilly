308+  5EEE              ; Disegna il player (testa e corpo) a coordinate pixel
309+  5EEE              ; -------------------------------------------------------------------
310+  5EEE              PrintPlayer:
311+  5EEE DD E5            push ix
312+  5EF0
313+  5EF0                  ; 1. Determina sprite per la testa (sinistra o destra)
314+  5EF0 3A 21 6C         ld   a, (direction)
315+  5EF3 FE 01            cp   1                 ; Sinistra?
316+  5EF5 20 06            jr   nz, .right_head
317+  5EF7
318+  5EF7 DD 21 D3 60      ld   ix, TilesDef + (4 * 8) ; 5° tile (HEAD_GRAPH_LEFT)
319+  5EFB 18 04            jr   .draw_head
320+  5EFD
321+  5EFD              .right_head:
322+  5EFD DD 21 B3 60      ld   ix, TilesDef + (0 * 8) ; 1° tile (HEAD_GRAPH_RIGHT)
323+  5F01
324+  5F01              .draw_head:
325+  5F01 ED 4B 0E 6C      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY
326+  5F05 CD 3D 5E         call DrawPixelSprite8x8 ; Disegna testa
327+  5F08
328+  5F08                  ; 2. Determina sprite per il corpo (sinistra o destra con frame animazione)
329+  5F08 3A 21 6C         ld   a, (direction)
330+  5F0B FE 01            cp   1                 ; Sinistra?
331+  5F0D 20 13            jr   nz, .right_body
332+  5F0F
333+  5F0F                  ; Corpo a sinistra
334+  5F0F 3A 20 6C         ld   a, (body_state)   ; 0, 1, 2
335+  5F12 C6 05            add  a, 5              ; offset del tile per il corpo sinistro (5, 6, 7)
336+  5F14 87               add  a, a              ; *2
337+  5F15 87               add  a, a              ; *4
338+  5F16 87               add  a, a              ; *8
339+  5F17 5F               ld   e, a
340+  5F18 16 00            ld   d, 0
341+  5F1A DD 21 B3 60      ld   ix, TilesDef
342+  5F1E DD 19            add  ix, de
343+  5F20 18 11            jr   .draw_body
344+  5F22
345+  5F22              .right_body:
346+  5F22                  ; Corpo a destra
