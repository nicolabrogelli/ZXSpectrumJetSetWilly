 657+ 6C40 28 1F            jr   z, .next
 658+ 6C42
 659+ 6C42                  ; 1. Controllo orizzontale: PlayerX - EnemyX + 7 in [0, 22]
 660+ 6C42 3A 26 E6         ld   a, (PlayerPos)    ; A = PlayerX
 661+ 6C45 DD 96 02         sub  (ix+2)            ; A = PlayerX - EnemyX (Offset 2: Current X)
 662+ 6C48 C6 07            add  a, 7              ; A = PlayerX - EnemyX + 7
 663+ 6C4A FE 17            cp   23                ; Se >= 23, nessuna collisione con questo
 664+ 6C4C 30 13            jr   nc, .next
 665+ 6C4E
 666+ 6C4E                  ; 2. Controllo verticale: PlayerY - EnemyY + 15 in [0, 30]
 667+ 6C4E 3A 27 E6         ld   a, (PlayerPos+1)  ; A = PlayerY
 668+ 6C51 DD 96 03         sub  (ix+3)            ; A = PlayerY - EnemyY (Offset 3: Current Y)
 669+ 6C54 C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 670+ 6C56 FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 671+ 6C58 30 07            jr   nc, .next
