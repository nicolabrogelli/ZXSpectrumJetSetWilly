 215+ 6C75
 216+ 6C75 C9               ret
 217+ 6C76
 218+ 6C76              ; -------------------------------------------------------------------
 219+ 6C76              ; DrawRoomItems
 220+ 6C76              ;
 221+ 6C76              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 222+ 6C76              ;
 223+ 6C76              ; Operazioni eseguite:
 224+ 6C76              ;   1. Azzera la griglia items_grid.
 225+ 6C76              ;   2. Svuota la cache degli oggetti attivi.
 226+ 6C76              ;   3. Scansiona ItemsTable.
 227+ 6C76              ;   4. Per ogni item della stanza corrente:
 228+ 6C76              ;        - verifica se è già stato raccolto
 229+ 6C76              ;        - disegna la grafica
 230+ 6C76              ;        - aggiorna items_grid
 231+ 6C76              ;        - memorizza l'item nella cache current_room_items
 232+ 6C76              ;   5. Aggiorna num_room_items.
 233+ 6C76              ;
 234+ 6C76              ; Record ItemsTable:
 235+ 6C76              ;   +0  Room ID
 236+ 6C76              ;   +1  X (colonna)
 237+ 6C76              ;   +2  Y (riga)
 238+ 6C76              ;   +3  Colore
 239+ 6C76              ;   +4  Collected flag
 240+ 6C76              ;
 241+ 6C76              ; Cache current_room_items:
 242+ 6C76              ;   +0  Colonna
 243+ 6C76              ;   +1  Riga
 244+ 6C76              ;   +2  Colore
 245+ 6C76              ;   +3  Collected flag ptr (Low)
 246+ 6C76              ;   +4  Collected flag ptr (High)
 247+ 6C76              ;
 248+ 6C76              ; Ogni record cache occupa 5 byte.
 249+ 6C76              ; -------------------------------------------------------------------
 250+ 6C76              DrawRoomItems:
 251+ 6C76
 252+ 6C76                  ; Salva tutti i registri utilizzati
 253+ 6C76 E5               push hl
 254+ 6C77 D5               push de
 255+ 6C78 C5               push bc
 256+ 6C79 DD E5            push ix
 257+ 6C7B FD E5            push iy
 258+ 6C7D
 259+ 6C7D                  ; ---------------------------------------------------------------
 260+ 6C7D                  ; Azzera items_grid (32 x 16 = 512 byte)
 261+ 6C7D                  ; ---------------------------------------------------------------
 262+ 6C7D 21 00 90         ld   hl, items_grid
 263+ 6C80 11 01 90         ld   de, items_grid + 1
 264+ 6C83 36 00            ld   (hl), 0
 265+ 6C85 01 FF 01         ld   bc, 511
 266+ 6C88 ED B0            ldir
 267+ 6C8A
 268+ 6C8A                  ; ---------------------------------------------------------------
 269+ 6C8A                  ; Nessun item attivo nella stanza
 270+ 6C8A                  ; ---------------------------------------------------------------
 271+ 6C8A AF               xor  a
 272+ 6C8B 32 07 7E         ld   (num_room_items), a
 273+ 6C8E
 274+ 6C8E                  ; IY punta alla cache degli item attivi
 275+ 6C8E FD 21 B7 7D      ld   iy, current_room_items
 276+ 6C92
 277+ 6C92                  ; ---------------------------------------------------------------
 278+ 6C92                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 279+ 6C92                  ; alla stanza corrente.
 280+ 6C92                  ;
 281+ 6C92                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 282+ 6C92                  ; ---------------------------------------------------------------
 283+ 6C92 2A 08 7E         ld   hl, (room_ptr)
 284+ 6C95 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 285+ 6C98 19               add  hl, de
 286+ 6C99
 287+ 6C99 E5               push hl
 288+ 6C9A DD E1            pop  ix                ; IX = bitmap item
 289+ 6C9C
 290+ 6C9C                  ; ---------------------------------------------------------------
 291+ 6C9C                  ; Inizio scansione della tabella degli item
 292+ 6C9C                  ; ---------------------------------------------------------------
 293+ 6C9C 21 9E 6B         ld   hl, ItemsTable
 294+ 6C9F
 295+ 6C9F              .loop:
 296+ 6C9F
 297+ 6C9F                  ; ---------------------------------------------------------------
 298+ 6C9F                  ; Legge il Room ID del record corrente
 299+ 6C9F                  ; ---------------------------------------------------------------
 300+ 6C9F 7E               ld   a, (hl)
 301+ 6CA0
 302+ 6CA0                  ; $FF indica fine tabella
 303+ 6CA0 FE FF            cp   $FF
 304+ 6CA2 28 53            jr   z, .done
 305+ 6CA4
 306+ 6CA4                  ; ---------------------------------------------------------------
 307+ 6CA4                  ; Verifica se l'item appartiene alla stanza corrente
 308+ 6CA4                  ; ---------------------------------------------------------------
 309+ 6CA4 57               ld   d, a
 310+ 6CA5
 311+ 6CA5 3A AE 7D         ld   a, (current_room)
 312+ 6CA8 BA               cp   d
 313+ 6CA9 20 45            jr   nz, .next_item
 314+ 6CAB
 315+ 6CAB                  ; ---------------------------------------------------------------
 316+ 6CAB                  ; Legge i dati dell'item
 317+ 6CAB                  ; ---------------------------------------------------------------
 318+ 6CAB
 319+ 6CAB 23               inc  hl
 320+ 6CAC 4E               ld   c, (hl)           ; X (colonna)
 321+ 6CAD
 322+ 6CAD 23               inc  hl
 323+ 6CAE 46               ld   b, (hl)           ; Y (riga)
 324+ 6CAF
 325+ 6CAF 23               inc  hl
 326+ 6CB0 5E               ld   e, (hl)           ; Colore
 327+ 6CB1
 328+ 6CB1 23               inc  hl
 329+ 6CB2 7E               ld   a, (hl)           ; Collected flag
 330+ 6CB3
 331+ 6CB3                  ; Se diverso da zero l'item è già stato raccolto
 332+ 6CB3 B7               or   a
 333+ 6CB4 20 3E            jr   nz, .next_no_inc
 334+ 6CB6
 335+ 6CB6                  ; ---------------------------------------------------------------
 336+ 6CB6                  ; Disegna l'item sullo schermo
 337+ 6CB6                  ;
 338+ 6CB6                  ; B = Row
 339+ 6CB6                  ; C = Column
 340+ 6CB6                  ; HL = bitmap pointer
 341+ 6CB6                  ; E = Color
 342+ 6CB6                  ; ---------------------------------------------------------------
 343+ 6CB6 E5               push hl
 344+ 6CB7
 345+ 6CB7 DD E5            push ix
 346+ 6CB9 E1               pop  hl
 347+ 6CBA
 348+ 6CBA CD FF 6C         call DrawItemGraphic
 349+ 6CBD
 350+ 6CBD E1               pop  hl                ; ritorna al flag collected
 351+ 6CBE
 352+ 6CBE                  ; ---------------------------------------------------------------
 353+ 6CBE                  ; Aggiorna items_grid
 354+ 6CBE                  ;
 355+ 6CBE                  ; Calcolo:
 356+ 6CBE                  ;   offset = Row * 32 + Col
 357+ 6CBE                  ; ---------------------------------------------------------------
 358+ 6CBE E5               push hl
 359+ 6CBF D5               push de
 360+ 6CC0
 361+ 6CC0 26 00            ld   h, 0
 362+ 6CC2 68               ld   l, b              ; HL = Row
 363+ 6CC3
 364+ 6CC3 29               add  hl, hl            ; *2
 365+ 6CC4 29               add  hl, hl            ; *4
 366+ 6CC5 29               add  hl, hl            ; *8
 367+ 6CC6 29               add  hl, hl            ; *16
 368+ 6CC7 29               add  hl, hl            ; *32
 369+ 6CC8
 370+ 6CC8 16 00            ld   d, 0
 371+ 6CCA 59               ld   e, c              ; DE = Col
 372+ 6CCB
 373+ 6CCB 19               add  hl, de            ; Row*32 + Col
 374+ 6CCC
 375+ 6CCC 11 00 90         ld   de, items_grid
 376+ 6CCF 19               add  hl, de            ; puntatore nella griglia
 377+ 6CD0
 378+ 6CD0 D1               pop  de                ; ripristina colore
 379+ 6CD1
 380+ 6CD1 73               ld   (hl), e           ; salva colore cella
 381+ 6CD2
 382+ 6CD2 E1               pop  hl
 383+ 6CD3
 384+ 6CD3                  ; ---------------------------------------------------------------
 385+ 6CD3                  ; Salva l'item nella cache della stanza
 386+ 6CD3                  ;
 387+ 6CD3                  ; Questo evita di dover scansionare tutta ItemsTable
 388+ 6CD3                  ; durante il controllo delle collisioni.
 389+ 6CD3                  ; ---------------------------------------------------------------
 390+ 6CD3
 391+ 6CD3 FD 71 00         ld   (iy+0), c         ; Colonna
 392+ 6CD6 FD 70 01         ld   (iy+1), b         ; Riga
 393+ 6CD9 FD 73 02         ld   (iy+2), e         ; Colore
 394+ 6CDC
 395+ 6CDC                  ; Salva il puntatore al flag "collected"
 396+ 6CDC FD 75 03         ld   (iy+3), l         ; Low byte
 397+ 6CDF FD 74 04         ld   (iy+4), h         ; High byte
 398+ 6CE2
 399+ 6CE2                  ; Passa al record successivo della cache
 400+ 6CE2 01 05 00         ld   bc, 5
 401+ 6CE5 FD 09            add  iy, bc
 402+ 6CE7
 403+ 6CE7                  ; Incrementa il numero di item attivi
 404+ 6CE7 3A 07 7E         ld   a, (num_room_items)
 405+ 6CEA 3C               inc  a
 406+ 6CEB 32 07 7E         ld   (num_room_items), a
 407+ 6CEE
 408+ 6CEE 18 04            jr   .next_no_inc
 409+ 6CF0
 410+ 6CF0              .next_item:
 411+ 6CF0
 412+ 6CF0                  ; ---------------------------------------------------------------
 413+ 6CF0                  ; L'item non appartiene alla stanza corrente.
 414+ 6CF0                  ; Salta i campi del record:
 415+ 6CF0                  ;   X
 416+ 6CF0                  ;   Y
 417+ 6CF0                  ;   Color
 418+ 6CF0                  ;   Collected
 419+ 6CF0                  ; ---------------------------------------------------------------
 420+ 6CF0 23               inc  hl
 421+ 6CF1 23               inc  hl
 422+ 6CF2 23               inc  hl
 423+ 6CF3 23               inc  hl
 424+ 6CF4
 425+ 6CF4              .next_no_inc:
 426+ 6CF4
 427+ 6CF4                  ; ---------------------------------------------------------------
 428+ 6CF4                  ; Avanza al record successivo
 429+ 6CF4                  ; (prossimo Room ID)
 430+ 6CF4                  ; ---------------------------------------------------------------
 431+ 6CF4 23               inc  hl
 432+ 6CF5 18 A8            jr   .loop
 433+ 6CF7
 434+ 6CF7              .done:
 435+ 6CF7
 436+ 6CF7                  ; Ripristina i registri
 437+ 6CF7 FD E1            pop  iy
 438+ 6CF9 DD E1            pop  ix
 439+ 6CFB D1               pop  de
 440+ 6CFC C1               pop  bc
 441+ 6CFD E1               pop  hl
 442+ 6CFE
 443+ 6CFE C9               ret
 444+ 6CFF
 445+ 6CFF              ; -------------------------------------------------------------------
 446+ 6CFF              ; DrawItemGraphic
 447+ 6CFF              ;
 448+ 6CFF              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 449+ 6CFF              ; utilizzando una bitmap di 8 byte e un attributo colore.
 450+ 6CFF              ;
 451+ 6CFF              ; Input:
 452+ 6CFF              ;   B = Riga attributi (3..18)
 453+ 6CFF              ;   C = Colonna attributi (0..31)
 454+ 6CFF              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 455+ 6CFF              ;   E = Attributo colore
 456+ 6CFF              ;
 457+ 6CFF              ; Output:
 458+ 6CFF              ;   Nessuno
 459+ 6CFF              ;
 460+ 6CFF              ; Registri preservati:
 461+ 6CFF              ;   BC, DE, HL
 462+ 6CFF              ; -------------------------------------------------------------------
 463+ 6CFF              DrawItemGraphic:
 464+ 6CFF
 465+ 6CFF                  ; Salva i registri originali
 466+ 6CFF C5               push bc
 467+ 6D00 D5               push de
 468+ 6D01 E5               push hl
 469+ 6D02
 470+ 6D02                  ; ---------------------------------------------------------------
 471+ 6D02                  ; Calcolo indirizzo bitmap dello Spectrum
 472+ 6D02                  ;
 473+ 6D02                  ; Ogni item occupa una cella attributi (8x8 pixel).
 474+ 6D02                  ;
 475+ 6D02                  ; Formula:
 476+ 6D02                  ;   High = $40 + (Row AND $18)
 477+ 6D02                  ;   Low  = (Row AND 7) * 32 + Col
 478+ 6D02                  ;
 479+ 6D02                  ; DE conterrà l'indirizzo della prima scanline.
 480+ 6D02                  ; ---------------------------------------------------------------
 481+ 6D02
 482+ 6D02 78               ld   a, b
 483+ 6D03 E6 18            and  $18
 484+ 6D05 C6 40            add  a, $40
 485+ 6D07 57               ld   d, a              ; Byte alto indirizzo video
 486+ 6D08
 487+ 6D08 78               ld   a, b
 488+ 6D09 E6 07            and  7                 ; Riga interna al blocco da 8
 489+ 6D0B
 490+ 6D0B 87               add  a, a              ; *2
 491+ 6D0C 87               add  a, a              ; *4
 492+ 6D0D 87               add  a, a              ; *8
 493+ 6D0E 87               add  a, a              ; *16
 494+ 6D0F 87               add  a, a              ; *32
 495+ 6D10
 496+ 6D10 81               add  a, c              ; + colonna
 497+ 6D11
 498+ 6D11 5F               ld   e, a              ; Byte basso indirizzo video
 499+ 6D12
 500+ 6D12                  ; ---------------------------------------------------------------
 501+ 6D12                  ; Disegno bitmap
 502+ 6D12                  ;
 503+ 6D12                  ; Copia 8 byte consecutivi nella memoria video.
 504+ 6D12                  ; Ogni byte rappresenta una scanline da 8 pixel.
 505+ 6D12                  ; ---------------------------------------------------------------
 506+ 6D12
 507+ 6D12 C5               push bc                ; Conserva Row e Col
 508+ 6D13
 509+ 6D13 06 08            ld   b, 8              ; Numero scanline
 510+ 6D15
 511+ 6D15              .line_loop:
 512+ 6D15
 513+ 6D15 7E               ld   a, (hl)           ; Legge scanline bitmap
 514+ 6D16 12               ld   (de), a           ; Scrive nella memoria video
 515+ 6D17
 516+ 6D17 14               inc  d                 ; Scanline successiva
 517+ 6D18 23               inc  hl                ; Byte bitmap successivo
 518+ 6D19
 519+ 6D19 05               dec  b
 520+ 6D1A 20 F9            jr   nz, .line_loop
 521+ 6D1C
 522+ 6D1C C1               pop  bc                ; Ripristina Row e Col
 523+ 6D1D
 524+ 6D1D                  ; ---------------------------------------------------------------
 525+ 6D1D                  ; Calcolo indirizzo attributo
 526+ 6D1D                  ;
 527+ 6D1D                  ; Formula:
 528+ 6D1D                  ;   AttrAddr = $5800 + Row * 32 + Col
 529+ 6D1D                  ;
 530+ 6D1D                  ; HL conterrà l'indirizzo della cella attributi.
 531+ 6D1D                  ; ---------------------------------------------------------------
 532+ 6D1D
 533+ 6D1D 26 00            ld   h, 0
 534+ 6D1F 68               ld   l, b              ; HL = Row
 535+ 6D20
 536+ 6D20 29               add  hl, hl            ; *2
 537+ 6D21 29               add  hl, hl            ; *4
 538+ 6D22 29               add  hl, hl            ; *8
 539+ 6D23 29               add  hl, hl            ; *16
 540+ 6D24 29               add  hl, hl            ; *32
 541+ 6D25
 542+ 6D25 79               ld   a, c              ; A = Colonna
 543+ 6D26
 544+ 6D26 85               add  a, l
 545+ 6D27 6F               ld   l, a
 546+ 6D28
 547+ 6D28 30 01            jr   nc, .no_carry
 548+ 6D2A 24               inc  h
 549+ 6D2B
 550+ 6D2B              .no_carry:
 551+ 6D2B
 552+ 6D2B                  ; HL = Row * 32 + Col
 553+ 6D2B
 554+ 6D2B 11 00 58         ld   de, $5800
 555+ 6D2E 19               add  hl, de            ; HL = indirizzo attributi
 556+ 6D2F
 557+ 6D2F                  ; ---------------------------------------------------------------
 558+ 6D2F                  ; Recupera il colore originale dallo stack.
 559+ 6D2F                  ;
 560+ 6D2F                  ; Layout stack:
 561+ 6D2F                  ;   HL originale
 562+ 6D2F                  ;   DE originale (E = colore)
 563+ 6D2F                  ;   BC originale
 564+ 6D2F                  ; ---------------------------------------------------------------
 565+ 6D2F
 566+ 6D2F C1               pop  bc                ; Recupera HL originale
 567+ 6D30 D1               pop  de                ; Recupera DE originale
 568+ 6D31
 569+ 6D31                  ; ---------------------------------------------------------------
 570+ 6D31                  ; Scrive l'attributo colore
 571+ 6D31                  ; ---------------------------------------------------------------
 572+ 6D31
 573+ 6D31 7B               ld   a, e              ; A = colore
 574+ 6D32 77               ld   (hl), a           ; Scrive nella RAM attributi
 575+ 6D33
 576+ 6D33                  ; ---------------------------------------------------------------
 577+ 6D33                  ; Ripristina HL e BC originali
 578+ 6D33                  ; ---------------------------------------------------------------
 579+ 6D33
 580+ 6D33 C5               push bc
 581+ 6D34 E1               pop  hl                ; HL originale
 582+ 6D35
 583+ 6D35 C1               pop  bc                ; BC originale
 584+ 6D36
 585+ 6D36 C9               ret
 586+ 6D37
 587+ 6D37              ; -------------------------------------------------------------------
 588+ 6D37              ; RestoreBackgroundCell
 589+ 6D37              ;
 590+ 6D37              ; Ripristina il contenuto originale di una cella della stanza.
 591+ 6D37              ; Viene utilizzata principalmente quando un item viene raccolto:
 592+ 6D37              ; invece di lasciare un "buco", la routine ridisegna il tile
 593+ 6D37              ; originale presente nella mappa della stanza.
 594+ 6D37              ;
 595+ 6D37              ; Input:
 596+ 6D37              ;   B = Row (3..18)
 597+ 6D37              ;   C = Col (0..31)
 598+ 6D37              ;
 599+ 6D37              ; Utilizza:
 600+ 6D37              ;   room_ptr -> struttura dati della stanza corrente
 601+ 6D37              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 602+ 6D37              ;   DrawTile -> ridisegna il tile selezionato
 603+ 6D37              ;
 604+ 6D37              ; Tipi di cella:
 605+ 6D37              ;   0 = Background
 606+ 6D37              ;   1 = Floor
 607+ 6D37              ;   2 = Wall
 608+ 6D37              ;   3 = Nasty
 609+ 6D37              ; -------------------------------------------------------------------
 610+ 6D37              RestoreBackgroundCell:
 611+ 6D37
 612+ 6D37                  ; Salva tutti i registri utilizzati
 613+ 6D37 FD E5            push iy
 614+ 6D39 C5               push bc
 615+ 6D3A D5               push de
 616+ 6D3B E5               push hl
 617+ 6D3C DD E5            push ix
 618+ 6D3E
 619+ 6D3E                  ; ---------------------------------------------------------------
 620+ 6D3E                  ; Conserva Row e Col in IY.
 621+ 6D3E                  ;
 622+ 6D3E                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 623+ 6D3E                  ; BC potrebbe essere modificato.
 624+ 6D3E                  ; ---------------------------------------------------------------
 625+ 6D3E C5               push bc
 626+ 6D3F FD E1            pop  iy                ; IYH = Row, IYL = Col
 627+ 6D41
 628+ 6D41                  ; ---------------------------------------------------------------
 629+ 6D41                  ; Determina quale tipo di cella è presente nella posizione
 630+ 6D41                  ; specificata.
 631+ 6D41                  ;
 632+ 6D41                  ; Input:
 633+ 6D41                  ;   B = Row
 634+ 6D41                  ;   C = Col
 635+ 6D41                  ;
 636+ 6D41                  ; Output:
 637+ 6D41                  ;   A = tipo cella
 638+ 6D41                  ; ---------------------------------------------------------------
 639+ 6D41 78               ld   a, b
 640+ 6D42
 641+ 6D42 CD 8D 68         call GetCellFromUnpacked
 642+ 6D45
 643+ 6D45                  ; ---------------------------------------------------------------
 644+ 6D45                  ; Recupera il puntatore alla stanza corrente.
 645+ 6D45                  ;
 646+ 6D45                  ; DE = base della struttura stanza
 647+ 6D45                  ; ---------------------------------------------------------------
 648+ 6D45 ED 5B 08 7E      ld   de, (room_ptr)
 649+ 6D49
 650+ 6D49                  ; ---------------------------------------------------------------
 651+ 6D49                  ; Seleziona il tile corretto in base al tipo di cella.
 652+ 6D49                  ;
 653+ 6D49                  ; A = 0 -> Background
 654+ 6D49                  ; A = 1 -> Floor
 655+ 6D49                  ; A = 2 -> Wall
 656+ 6D49                  ; A = 3 -> Nasty
 657+ 6D49                  ; ---------------------------------------------------------------
 658+ 6D49
 659+ 6D49 B7               or   a
 660+ 6D4A 20 06            jr   nz, .not_bg
 661+ 6D4C
 662+ 6D4C                  ; Background
 663+ 6D4C 21 A0 00         ld   hl, OFFSET_BG
 664+ 6D4F 19               add  hl, de
 665+ 6D50 18 16            jr   .draw_cell
 666+ 6D52
 667+ 6D52              .not_bg:
 668+ 6D52
 669+ 6D52 3D               dec  a
 670+ 6D53 20 06            jr   nz, .not_floor
 671+ 6D55
 672+ 6D55                  ; Floor
 673+ 6D55 21 A9 00         ld   hl, OFFSET_FLOOR
 674+ 6D58 19               add  hl, de
 675+ 6D59 18 0D            jr   .draw_cell
 676+ 6D5B
 677+ 6D5B              .not_floor:
 678+ 6D5B
 679+ 6D5B 3D               dec  a
 680+ 6D5C 20 06            jr   nz, .not_wall
 681+ 6D5E
 682+ 6D5E                  ; Wall
 683+ 6D5E 21 B2 00         ld   hl, OFFSET_WALL
 684+ 6D61 19               add  hl, de
 685+ 6D62 18 04            jr   .draw_cell
 686+ 6D64
 687+ 6D64              .not_wall:
 688+ 6D64
 689+ 6D64                  ; Nasty
 690+ 6D64 21 BB 00         ld   hl, OFFSET_NASTY
 691+ 6D67 19               add  hl, de
 692+ 6D68
 693+ 6D68              .draw_cell:
 694+ 6D68
 695+ 6D68                  ; ---------------------------------------------------------------
 696+ 6D68                  ; HL punta ora alla grafica del tile da ridisegnare.
 697+ 6D68                  ;
 698+ 6D68                  ; DrawTile si aspetta:
 699+ 6D68                  ;   IX = puntatore tile
 700+ 6D68                  ;   B  = Row
 701+ 6D68                  ;   C  = Col
 702+ 6D68                  ; ---------------------------------------------------------------
 703+ 6D68 E5               push hl
 704+ 6D69 DD E1            pop  ix
 705+ 6D6B
 706+ 6D6B                  ; Ripristina Row e Col salvati in IY
 707+ 6D6B FD E5            push iy
 708+ 6D6D C1               pop  bc
 709+ 6D6E
 710+ 6D6E                  ; Disegna il tile originale
 711+ 6D6E CD 8C 61         call DrawTile
 712+ 6D71
 713+ 6D71                  ; ---------------------------------------------------------------
 714+ 6D71                  ; Ripristina i registri salvati
 715+ 6D71                  ; ---------------------------------------------------------------
 716+ 6D71 DD E1            pop  ix
 717+ 6D73 E1               pop  hl
 718+ 6D74 D1               pop  de
 719+ 6D75 C1               pop  bc
 720+ 6D76 FD E1            pop  iy
 721+ 6D78
 722+ 6D78 C9               ret
 723+ 6D79
 724+ 6D79              ; -------------------------------------------------------------------
 725+ 6D79              ; CheckWillyItemCollision
 726+ 6D79              ;
 727+ 6D79              ; Verifica se Willy collide con un item utilizzando il controllo
 728+ 6D79              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 729+ 6D79              ;
 730+ 6D79              ; Input:
 731+ 6D79              ;   A = ItemX (colonna attributi 0..31)
 732+ 6D79              ;   H = ItemY (riga attributi 3..18)
 733+ 6D79              ;
 734+ 6D79              ; Coordinate item:
 735+ 6D79              ;   Ogni item occupa una cella da 8x8 pixel.
 736+ 6D79              ;
 737+ 6D79              ; Coordinate Willy:
 738+ 6D79              ;   Willy occupa un rettangolo di 16x16 pixel.
 739+ 6D79              ;
 740+ 6D79              ; Output:
 741+ 6D79              ;   Carry Set   = collisione rilevata
 742+ 6D79              ;   Carry Clear = nessuna collisione
 743+ 6D79              ;
 744+ 6D79              ; Registri preservati:
 745+ 6D79              ;   BC, DE, HL
 746+ 6D79              ; -------------------------------------------------------------------
 747+ 6D79              CheckWillyItemCollision:
 748+ 6D79
 749+ 6D79                  ; Salva i registri utilizzati
 750+ 6D79 C5               push bc
 751+ 6D7A D5               push de
 752+ 6D7B E5               push hl
 753+ 6D7C
 754+ 6D7C                  ; ---------------------------------------------------------------
 755+ 6D7C                  ; Calcola il bounding box orizzontale dell'item
 756+ 6D7C                  ;
 757+ 6D7C                  ; ItemLeft  = ItemX * 8
 758+ 6D7C                  ; ItemRight = ItemLeft + 7
 759+ 6D7C                  ;
 760+ 6D7C                  ; E = ItemLeft
 761+ 6D7C                  ; D = ItemRight
 762+ 6D7C                  ; ---------------------------------------------------------------
 763+ 6D7C 6F               ld   l, a              ; L = ItemX
 764+ 6D7D
 765+ 6D7D 7D               ld   a, l
 766+ 6D7E 87               add  a, a              ; *2
 767+ 6D7F 87               add  a, a              ; *4
 768+ 6D80 87               add  a, a              ; *8
 769+ 6D81
 770+ 6D81 5F               ld   e, a              ; E = ItemLeft
 771+ 6D82
 772+ 6D82 C6 07            add  a, 7
 773+ 6D84 57               ld   d, a              ; D = ItemRight
 774+ 6D85
 775+ 6D85                  ; ---------------------------------------------------------------
 776+ 6D85                  ; Recupera la posizione corrente di Willy
 777+ 6D85                  ;
 778+ 6D85                  ; B = WillyY
 779+ 6D85                  ; C = WillyX
 780+ 6D85                  ; ---------------------------------------------------------------
 781+ 6D85 ED 4B 9A 7A      ld   bc, (PlayerPos)
 782+ 6D89
 783+ 6D89                  ; ---------------------------------------------------------------
 784+ 6D89                  ; Primo test:
 785+ 6D89                  ;
 786+ 6D89                  ; WillyLeft <= ItemRight
 787+ 6D89                  ;
 788+ 6D89                  ; Se Willy è completamente a destra dell'item
 789+ 6D89                  ; non può esserci collisione.
 790+ 6D89                  ; ---------------------------------------------------------------
 791+ 6D89 79               ld   a, c              ; A = WillyLeft
 792+ 6D8A
 793+ 6D8A BA               cp   d                 ; WillyLeft vs ItemRight
 794+ 6D8B
 795+ 6D8B 28 04            jr   z, .x_ok
 796+ 6D8D 38 02            jr   c, .x_ok
 797+ 6D8F
 798+ 6D8F 18 29            jr   .no_collision
 799+ 6D91
 800+ 6D91              .x_ok:
 801+ 6D91
 802+ 6D91                  ; ---------------------------------------------------------------
 803+ 6D91                  ; Secondo test:
 804+ 6D91                  ;
 805+ 6D91                  ; WillyRight >= ItemLeft
 806+ 6D91                  ;
 807+ 6D91                  ; WillyRight = WillyX + 7
 808+ 6D91                  ; ---------------------------------------------------------------
 809+ 6D91 C6 07            add  a, 7
 810+ 6D93
 811+ 6D93 BB               cp   e                 ; WillyRight vs ItemLeft
 812+ 6D94
 813+ 6D94 28 04            jr   z, .y_check
 814+ 6D96 30 02            jr   nc, .y_check
 815+ 6D98
 816+ 6D98 18 20            jr   .no_collision
 817+ 6D9A
 818+ 6D9A              .y_check:
 819+ 6D9A
 820+ 6D9A                  ; ---------------------------------------------------------------
 821+ 6D9A                  ; Recupera ItemY dal valore originale di HL
 822+ 6D9A                  ;
 823+ 6D9A                  ; H contiene la riga dell'item.
 824+ 6D9A                  ; ---------------------------------------------------------------
 825+ 6D9A E1               pop  hl
 826+ 6D9B E5               push hl
 827+ 6D9C
 828+ 6D9C                  ; ---------------------------------------------------------------
 829+ 6D9C                  ; Calcola il bounding box verticale dell'item
 830+ 6D9C                  ;
 831+ 6D9C                  ; ItemTop    = ItemY * 8
 832+ 6D9C                  ; ItemBottom = ItemTop + 7
 833+ 6D9C                  ;
 834+ 6D9C                  ; E = ItemTop
 835+ 6D9C                  ; D = ItemBottom
 836+ 6D9C                  ; ---------------------------------------------------------------
 837+ 6D9C 7C               ld   a, h
 838+ 6D9D
 839+ 6D9D 87               add  a, a              ; *2
 840+ 6D9E 87               add  a, a              ; *4
 841+ 6D9F 87               add  a, a              ; *8
 842+ 6DA0
 843+ 6DA0 5F               ld   e, a              ; ItemTop
 844+ 6DA1
 845+ 6DA1 C6 07            add  a, 7
 846+ 6DA3 57               ld   d, a              ; ItemBottom
 847+ 6DA4
 848+ 6DA4                  ; ---------------------------------------------------------------
 849+ 6DA4                  ; Primo test verticale:
 850+ 6DA4                  ;
 851+ 6DA4                  ; WillyTop <= ItemBottom
 852+ 6DA4                  ; ---------------------------------------------------------------
 853+ 6DA4 78               ld   a, b              ; WillyTop
 854+ 6DA5
 855+ 6DA5 BA               cp   d
 856+ 6DA6
 857+ 6DA6 28 04            jr   z, .y_ok
 858+ 6DA8 38 02            jr   c, .y_ok
 859+ 6DAA
 860+ 6DAA 18 0E            jr   .no_collision
 861+ 6DAC
 862+ 6DAC              .y_ok:
 863+ 6DAC
 864+ 6DAC                  ; ---------------------------------------------------------------
 865+ 6DAC                  ; Secondo test verticale:
 866+ 6DAC                  ;
 867+ 6DAC                  ; WillyBottom >= ItemTop
 868+ 6DAC                  ;
 869+ 6DAC                  ; WillyBottom = WillyY + 15
 870+ 6DAC                  ; ---------------------------------------------------------------
 871+ 6DAC C6 0F            add  a, 15
 872+ 6DAE
 873+ 6DAE BB               cp   e
 874+ 6DAF
 875+ 6DAF 28 04            jr   z, .collision
 876+ 6DB1 30 02            jr   nc, .collision
 877+ 6DB3
 878+ 6DB3 18 05            jr   .no_collision
 879+ 6DB5
 880+ 6DB5              .collision:
 881+ 6DB5
 882+ 6DB5                  ; ---------------------------------------------------------------
 883+ 6DB5                  ; Collisione rilevata
 884+ 6DB5                  ; ---------------------------------------------------------------
 885+ 6DB5 E1               pop  hl
 886+ 6DB6 D1               pop  de
 887+ 6DB7 C1               pop  bc
 888+ 6DB8
 889+ 6DB8 37               scf                    ; Carry = 1
 890+ 6DB9
 891+ 6DB9 C9               ret
 892+ 6DBA
 893+ 6DBA              .no_collision:
 894+ 6DBA
 895+ 6DBA                  ; ---------------------------------------------------------------
 896+ 6DBA                  ; Nessuna collisione
 897+ 6DBA                  ; ---------------------------------------------------------------
 898+ 6DBA E1               pop  hl
 899+ 6DBB D1               pop  de
 900+ 6DBC C1               pop  bc
 901+ 6DBD
 902+ 6DBD B7               or   a                 ; Carry = 0
 903+ 6DBE
 904+ 6DBE C9               ret
 905+ 6DBF
 906+ 6DBF              ; -------------------------------------------------------------------
 907+ 6DBF              ; CheckRoomItemsCollision
 908+ 6DBF              ;
 909+ 6DBF              ; Controlla se Willy entra in collisione con uno degli item
 910+ 6DBF              ; attivi presenti nella stanza corrente.
 911+ 6DBF              ;
 912+ 6DBF              ; Per ogni item:
 913+ 6DBF              ;   - verifica che appartenga alla stanza corrente
 914+ 6DBF              ;   - verifica che non sia già stato raccolto
 915+ 6DBF              ;   - esegue il test di collisione con Willy
 916+ 6DBF              ;
 917+ 6DBF              ; Se l'item viene raccolto:
 918+ 6DBF              ;   - imposta il flag "collected"
 919+ 6DBF              ;   - rimuove l'item dalla cache items_grid
 920+ 6DBF              ;   - incrementa il contatore degli oggetti raccolti
 921+ 6DBF              ;   - aggiorna l'HUD
 922+ 6DBF              ;   - ripristina il tile di sfondo
 923+ 6DBF              ;   - riproduce il suono di raccolta
 924+ 6DBF              ;
 925+ 6DBF              ; Formato record ItemsTable:
 926+ 6DBF              ;   +0 RoomID
 927+ 6DBF              ;   +1 X
 928+ 6DBF              ;   +2 Y
 929+ 6DBF              ;   +3 Color
 930+ 6DBF              ;   +4 Collected
 931+ 6DBF              ;
 932+ 6DBF              ; Fine tabella:
 933+ 6DBF              ;   RoomID = $FF
 934+ 6DBF              ; -------------------------------------------------------------------
 935+ 6DBF              CheckRoomItemsCollision:
 936+ 6DBF
 937+ 6DBF                  ; Salva i registri utilizzati
 938+ 6DBF E5               push hl
 939+ 6DC0 D5               push de
 940+ 6DC1 C5               push bc
 941+ 6DC2
 942+ 6DC2                  ; Inizio scansione della tabella degli item
 943+ 6DC2 21 9E 6B         ld   hl, ItemsTable
 944+ 6DC5
 945+ 6DC5              .loop:
 946+ 6DC5
 947+ 6DC5                  ; ---------------------------------------------------------------
 948+ 6DC5                  ; Legge il Room ID dell'item corrente
 949+ 6DC5                  ; ---------------------------------------------------------------
 950+ 6DC5 7E               ld   a, (hl)
 951+ 6DC6
 952+ 6DC6                  ; $FF indica fine tabella
 953+ 6DC6 FE FF            cp   $FF
 954+ 6DC8 28 4D            jr   z, .done
 955+ 6DCA
 956+ 6DCA                  ; ---------------------------------------------------------------
 957+ 6DCA                  ; Verifica se l'item appartiene alla stanza corrente
 958+ 6DCA                  ; ---------------------------------------------------------------
 959+ 6DCA 57               ld   d, a              ; D = RoomID item
 960+ 6DCB
 961+ 6DCB 3A AE 7D         ld   a, (current_room)
 962+ 6DCE BA               cp   d
 963+ 6DCF
 964+ 6DCF                  ; Se appartiene a un'altra stanza salta il record
 965+ 6DCF 20 3F            jr   nz, .next_item
 966+ 6DD1
 967+ 6DD1                  ; ---------------------------------------------------------------
 968+ 6DD1                  ; Legge coordinate e stato dell'item
 969+ 6DD1                  ; ---------------------------------------------------------------
 970+ 6DD1
 971+ 6DD1 23               inc  hl
 972+ 6DD2 4E               ld   c, (hl)           ; C = X
 973+ 6DD3
 974+ 6DD3 23               inc  hl
 975+ 6DD4 46               ld   b, (hl)           ; B = Y
 976+ 6DD5
 977+ 6DD5 23               inc  hl                ; salta Color
 978+ 6DD6
 979+ 6DD6 23               inc  hl                ; punta a Collected
 980+ 6DD7
 981+ 6DD7 7E               ld   a, (hl)
 982+ 6DD8
 983+ 6DD8                  ; ---------------------------------------------------------------
 984+ 6DD8                  ; Item già raccolto?
 985+ 6DD8                  ; ---------------------------------------------------------------
 986+ 6DD8 B7               or   a
 987+ 6DD9 20 39            jr   nz, .next_no_inc
 988+ 6DDB
 989+ 6DDB                  ; ---------------------------------------------------------------
 990+ 6DDB                  ; Test collisione Willy ↔ Item
 991+ 6DDB                  ;
 992+ 6DDB                  ; Input richiesto:
 993+ 6DDB                  ;   A = ItemX
 994+ 6DDB                  ;   H = ItemY
 995+ 6DDB                  ; ---------------------------------------------------------------
 996+ 6DDB 79               ld   a, c
 997+ 6DDC
 998+ 6DDC E5               push hl                ; salva puntatore al flag Collected
 999+ 6DDD
1000+ 6DDD 60               ld   h, b
1001+ 6DDE
1002+ 6DDE CD 79 6D         call CheckWillyItemCollision
1003+ 6DE1
1004+ 6DE1 E1               pop  hl
1005+ 6DE2
1006+ 6DE2                  ; Nessuna collisione
1007+ 6DE2 30 30            jr   nc, .next_no_inc
1008+ 6DE4
1009+ 6DE4                  ; ===============================================================
1010+ 6DE4                  ; ITEM RACCOLTO
1011+ 6DE4                  ; ===============================================================
1012+ 6DE4
1013+ 6DE4                  ; ---------------------------------------------------------------
1014+ 6DE4                  ; Marca l'item come raccolto
1015+ 6DE4                  ; ---------------------------------------------------------------
1016+ 6DE4 36 01            ld   (hl), 1
1017+ 6DE6
1018+ 6DE6                  ; ---------------------------------------------------------------
1019+ 6DE6                  ; Rimuove l'item dalla cache items_grid
1020+ 6DE6                  ;
1021+ 6DE6                  ; Calcolo:
1022+ 6DE6                  ;   offset = Row * 32 + Col
1023+ 6DE6                  ; ---------------------------------------------------------------
1024+ 6DE6 E5               push hl
1025+ 6DE7 D5               push de
1026+ 6DE8
1027+ 6DE8 26 00            ld   h, 0
1028+ 6DEA 68               ld   l, b              ; HL = Row
1029+ 6DEB
1030+ 6DEB 29               add  hl, hl            ; *2
1031+ 6DEC 29               add  hl, hl            ; *4
1032+ 6DED 29               add  hl, hl            ; *8
1033+ 6DEE 29               add  hl, hl            ; *16
1034+ 6DEF 29               add  hl, hl            ; *32
1035+ 6DF0
1036+ 6DF0 59               ld   e, c
1037+ 6DF1 16 00            ld   d, 0
1038+ 6DF3
1039+ 6DF3 19               add  hl, de            ; Row*32 + Col
1040+ 6DF4
1041+ 6DF4 11 00 90         ld   de, items_grid
1042+ 6DF7 19               add  hl, de
1043+ 6DF8
1044+ 6DF8                  ; La cella non contiene più un item
1045+ 6DF8 36 00            ld   (hl), 0
1046+ 6DFA
1047+ 6DFA D1               pop  de
1048+ 6DFB E1               pop  hl
1049+ 6DFC
1050+ 6DFC                  ; ---------------------------------------------------------------
1051+ 6DFC                  ; Conserva il puntatore all'entry corrente
1052+ 6DFC                  ; poiché le routine successive possono alterare HL.
1053+ 6DFC                  ; ---------------------------------------------------------------
1054+ 6DFC E5               push hl
1055+ 6DFD
1056+ 6DFD                  ; ---------------------------------------------------------------
1057+ 6DFD                  ; Aggiorna il numero di oggetti raccolti
1058+ 6DFD                  ; ---------------------------------------------------------------
1059+ 6DFD 3A A4 7A         ld   a, (items_collected)
1060+ 6E00
1061+ 6E00 3C               inc  a
1062+ 6E01
1063+ 6E01 32 A4 7A         ld   (items_collected), a
1064+ 6E04
1065+ 6E04                  ; ---------------------------------------------------------------
1066+ 6E04                  ; Aggiorna il contatore visualizzato a schermo
1067+ 6E04                  ; ---------------------------------------------------------------
1068+ 6E04 CD CB 60         call UpdateItemsCollectedDisplay
1069+ 6E07
1070+ 6E07                  ; ---------------------------------------------------------------
1071+ 6E07                  ; Ripristina il tile originale della stanza
1072+ 6E07                  ; eliminando la grafica dell'item.
1073+ 6E07                  ;
1074+ 6E07                  ; Input:
1075+ 6E07                  ;   B = Row
1076+ 6E07                  ;   C = Col
1077+ 6E07                  ; ---------------------------------------------------------------
1078+ 6E07 CD 37 6D         call RestoreBackgroundCell
1079+ 6E0A
1080+ 6E0A                  ; ---------------------------------------------------------------
1081+ 6E0A                  ; Riproduce il suono di raccolta
1082+ 6E0A                  ; ---------------------------------------------------------------
1083+ 6E0A CD 1B 6E         call PlayCollectSound
1084+ 6E0D
1085+ 6E0D                  ; Ripristina il puntatore alla tabella
1086+ 6E0D E1               pop  hl
1087+ 6E0E
1088+ 6E0E                  ; Continua con il record successivo
1089+ 6E0E 18 04            jr   .next_no_inc
1090+ 6E10
1091+ 6E10              .next_item:
1092+ 6E10
1093+ 6E10                  ; ---------------------------------------------------------------
1094+ 6E10                  ; Salta i campi del record:
1095+ 6E10                  ;   X
1096+ 6E10                  ;   Y
1097+ 6E10                  ;   Color
1098+ 6E10                  ;   Collected
1099+ 6E10                  ; ---------------------------------------------------------------
1100+ 6E10 23               inc  hl
1101+ 6E11 23               inc  hl
1102+ 6E12 23               inc  hl
1103+ 6E13 23               inc  hl
1104+ 6E14
1105+ 6E14              .next_no_inc:
1106+ 6E14
1107+ 6E14                  ; ---------------------------------------------------------------
1108+ 6E14                  ; Avanza al record successivo.
1109+ 6E14                  ;
1110+ 6E14                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1111+ 6E14                  ; ---------------------------------------------------------------
1112+ 6E14 23               inc  hl
1113+ 6E15
1114+ 6E15 18 AE            jr   .loop
1115+ 6E17
1116+ 6E17              .done:
1117+ 6E17
1118+ 6E17                  ; Ripristina i registri
1119+ 6E17 C1               pop  bc
1120+ 6E18 D1               pop  de
1121+ 6E19 E1               pop  hl
1122+ 6E1A
1123+ 6E1A C9               ret
1124+ 6E1B
1125+ 6E1B              ; -------------------------------------------------------------------
1126+ 6E1B              ; PlayCollectSound
1127+ 6E1B              ;
1128+ 6E1B              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1129+ 6E1B              ; dello ZX Spectrum utilizzando il port $FE.
1130+ 6E1B              ;
1131+ 6E1B              ; Il suono viene prodotto alternando ON/OFF del bit 4
1132+ 6E1B              ; (speaker) con un semplice delay software.
1133+ 6E1B              ;
1134+ 6E1B              ; Effetto risultante:
1135+ 6E1B              ;   beep breve tipo "pickup item"
1136+ 6E1B              ; -------------------------------------------------------------------
1137+ 6E1B              PlayCollectSound:
1138+ 6E1B
1139+ 6E1B                  ; Salva registri utilizzati
1140+ 6E1B C5               push bc
1141+ 6E1C D5               push de
1142+ 6E1D
1143+ 6E1D                  ; ---------------------------------------------------------------
1144+ 6E1D                  ; Numero di cicli del beep (durata complessiva del suono)
1145+ 6E1D                  ; ---------------------------------------------------------------
1146+ 6E1D 06 78            ld   b, 120
1147+ 6E1F
1148+ 6E1F              .sound_loop:
1149+ 6E1F
1150+ 6E1F                  ; ---------------------------------------------------------------
1151+ 6E1F                  ; SPEAKER ON
1152+ 6E1F                  ;
1153+ 6E1F                  ; Legge il colore del bordo corrente e attiva il bit 4
1154+ 6E1F                  ; per pilotare lo speaker.
1155+ 6E1F                  ; ---------------------------------------------------------------
1156+ 6E1F 3A A6 7A         ld   a, (room_border_color)
1157+ 6E22 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1158+ 6E24
1159+ 6E24 D3 FE            out  ($fe), a         ; scrive sul port ULA
1160+ 6E26
1161+ 6E26                  ; ---------------------------------------------------------------
1162+ 6E26                  ; Delay (mezzo periodo)
1163+ 6E26                  ; Loop software a consumo CPU
1164+ 6E26                  ; ---------------------------------------------------------------
1165+ 6E26 0E 3C            ld   c, 60
1166+ 6E28
1167+ 6E28              .d1:
1168+ 6E28 0D               dec  c
1169+ 6E29 20 FD            jr   nz, .d1
1170+ 6E2B
1171+ 6E2B                  ; ---------------------------------------------------------------
1172+ 6E2B                  ; SPEAKER OFF
1173+ 6E2B                  ;
1174+ 6E2B                  ; Mantiene il colore del bordo ma disattiva lo speaker
1175+ 6E2B                  ; ---------------------------------------------------------------
1176+ 6E2B 3A A6 7A         ld   a, (room_border_color)
1177+ 6E2E E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1178+ 6E30
1179+ 6E30 D3 FE            out  ($fe), a
1180+ 6E32
1181+ 6E32                  ; ---------------------------------------------------------------
1182+ 6E32                  ; Secondo delay (mezzo periodo)
1183+ 6E32                  ; Completa l’onda quadra
1184+ 6E32                  ; ---------------------------------------------------------------
1185+ 6E32 0E 3C            ld   c, 60
1186+ 6E34
1187+ 6E34              .d2:
1188+ 6E34 0D               dec  c
1189+ 6E35 20 FD            jr   nz, .d2
1190+ 6E37
1191+ 6E37                  ; ---------------------------------------------------------------
1192+ 6E37                  ; Ripete fino a completare il numero di cicli
1193+ 6E37                  ; ---------------------------------------------------------------
1194+ 6E37 10 E6            djnz .sound_loop
1195+ 6E39
1196+ 6E39                  ; Ripristina registri salvati
1197+ 6E39 D1               pop  de
1198+ 6E3A C1               pop  bc
1199+ 6E3B
1200+ 6E3B C9               ret
1201+ 6E3C
1202+ 6E3C              ; -------------------------------------------------------------------
1203+ 6E3C              ; CheckActiveItemAtCell
1204+ 6E3C              ;
1205+ 6E3C              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1206+ 6E3C              ; nella cella specificata della griglia items_grid.
1207+ 6E3C              ;
1208+ 6E3C              ; Questa routine usa una lookup diretta su una mappa 32x16,
1209+ 6E3C              ; evitando la scansione della ItemsTable.
1210+ 6E3C              ;
1211+ 6E3C              ; Input:
1212+ 6E3C              ;   B = Colonna (0..31)
1213+ 6E3C              ;   C = Riga (0..15)
1214+ 6E3C              ;
1215+ 6E3C              ; Output:
1216+ 6E3C              ;   Carry Set   = item presente nella cella
1217+ 6E3C              ;   Carry Clear = nessun item
1218+ 6E3C              ;
1219+ 6E3C              ; Nota:
1220+ 6E3C              ;   HL NON è restituito valido (commento originale non corretto:
1221+ 6E3C              ;   la routine non punta a ItemsTable).
1222+ 6E3C              ; -------------------------------------------------------------------
1223+ 6E3C              CheckActiveItemAtCell:
1224+ 6E3C
1225+ 6E3C                  ; Salva registri usati
1226+ 6E3C D5               push de
1227+ 6E3D E5               push hl
1228+ 6E3E
1229+ 6E3E                  ; ---------------------------------------------------------------
1230+ 6E3E                  ; Calcolo indice lineare nella griglia 32x16:
1231+ 6E3E                  ;
1232+ 6E3E                  ; offset = Row * 32 + Col
1233+ 6E3E                  ; ---------------------------------------------------------------
1234+ 6E3E 26 00            ld   h, 0
1235+ 6E40 69               ld   l, c              ; HL = Row
1236+ 6E41
1237+ 6E41 29               add  hl, hl            ; *2
1238+ 6E42 29               add  hl, hl            ; *4
1239+ 6E43 29               add  hl, hl            ; *8
1240+ 6E44 29               add  hl, hl            ; *16
1241+ 6E45 29               add  hl, hl            ; *32
1242+ 6E46
1243+ 6E46                  ; Aggiunge la colonna
1244+ 6E46 58               ld   e, b
1245+ 6E47 16 00            ld   d, 0
1246+ 6E49 19               add  hl, de            ; HL = Row*32 + Col
1247+ 6E4A
1248+ 6E4A                  ; ---------------------------------------------------------------
1249+ 6E4A                  ; Accesso alla griglia degli item attivi
1250+ 6E4A                  ; ---------------------------------------------------------------
1251+ 6E4A 11 00 90         ld   de, items_grid
1252+ 6E4D 19               add  hl, de            ; HL = address cella
1253+ 6E4E
1254+ 6E4E                  ; ---------------------------------------------------------------
1255+ 6E4E                  ; Controllo presenza item
1256+ 6E4E                  ;
1257+ 6E4E                  ; items_grid contiene:
1258+ 6E4E                  ;   0 = nessun item
1259+ 6E4E                  ;   >0 = item attivo (colore o flag)
1260+ 6E4E                  ; ---------------------------------------------------------------
1261+ 6E4E 7E               ld   a, (hl)
1262+ 6E4F B7               or   a
1263+ 6E50 28 04            jr   z, .not_active
1264+ 6E52
1265+ 6E52                  ; ---------------------------------------------------------------
1266+ 6E52                  ; Item trovato
1267+ 6E52                  ; ---------------------------------------------------------------
1268+ 6E52 E1               pop  hl
1269+ 6E53 D1               pop  de
1270+ 6E54
1271+ 6E54 37               scf                    ; Carry = 1
