1391+ 78B6 29               add  hl, hl            ; *8
1392+ 78B7 29               add  hl, hl            ; *16
1393+ 78B8 29               add  hl, hl            ; *32
1394+ 78B9
1395+ 78B9 59               ld   e, c
1396+ 78BA 16 00            ld   d, 0
