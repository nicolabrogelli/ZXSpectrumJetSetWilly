  17+ 6E34              ; Tabella dei colori, se aggiungiamo $C davanti al colore questo diventa lampeggiante
  18+ 6E34              ; 1 - BLUE
  19+ 6E34              ; 2 - RED
  20+ 6E34              ; 3 - MAGENTA
  21+ 6E34              ; 4 - GREEN
  22+ 6E34              ; 5 - CYAN
  23+ 6E34              ; 6 - YELLOW
  24+ 6E34              ; 7 - WHITE
