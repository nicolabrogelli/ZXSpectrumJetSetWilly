 323+ 6FEA              ; DrawRoomItems
 324+ 6FEA              ;
 325+ 6FEA              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 326+ 6FEA              ;
 327+ 6FEA              ; Operazioni eseguite:
 328+ 6FEA              ;   1. Azzera la griglia items_grid.
 329+ 6FEA              ;   2. Svuota la cache degli oggetti attivi.
 330+ 6FEA              ;   3. Scansiona ItemsTable.
 331+ 6FEA              ;   4. Per ogni item della stanza corrente:
 332+ 6FEA              ;        - verifica se è già stato raccolto
 333+ 6FEA              ;        - disegna la grafica
 334+ 6FEA              ;        - aggiorna items_grid
 335+ 6FEA              ;        - memorizza l'item nella cache current_room_items
 336+ 6FEA              ;   5. Aggiorna num_room_items.
 337+ 6FEA              ;
 338+ 6FEA              ; Record ItemsTable:
 339+ 6FEA              ;   +0  Room ID
 340+ 6FEA              ;   +1  X (colonna)
 341+ 6FEA              ;   +2  Y (riga)
 342+ 6FEA              ;   +3  Colore
 343+ 6FEA              ;   +4  Collected flag
 344+ 6FEA              ;
 345+ 6FEA              ; Cache current_room_items:
 346+ 6FEA              ;   +0  Colonna
 347+ 6FEA              ;   +1  Riga
 348+ 6FEA              ;   +2  Colore
 349+ 6FEA              ;   +3  Collected flag ptr (Low)
 350+ 6FEA              ;   +4  Collected flag ptr (High)
 351+ 6FEA              ;
 352+ 6FEA              ; Ogni record cache occupa 5 byte.
 353+ 6FEA              ; -------------------------------------------------------------------
 354+ 6FEA              DrawRoomItems:
 355+ 6FEA
 356+ 6FEA                  ; Salva tutti i registri utilizzati
 357+ 6FEA E5               push hl
 358+ 6FEB D5               push de
 359+ 6FEC C5               push bc
 360+ 6FED DD E5            push ix
 361+ 6FEF FD E5            push iy
 362+ 6FF1
 363+ 6FF1                  ; ---------------------------------------------------------------
 364+ 6FF1                  ; Azzera items_grid (32 x 16 = 512 byte)
 365+ 6FF1                  ; ---------------------------------------------------------------
 366+ 6FF1 21 00 90         ld   hl, items_grid
 367+ 6FF4 11 01 90         ld   de, items_grid + 1
 368+ 6FF7 36 00            ld   (hl), 0
 369+ 6FF9 01 FF 01         ld   bc, 511
 370+ 6FFC ED B0            ldir
 371+ 6FFE
 372+ 6FFE                  ; ---------------------------------------------------------------
 373+ 6FFE                  ; Nessun item attivo nella stanza
 374+ 6FFE                  ; ---------------------------------------------------------------
 375+ 6FFE AF               xor  a
 376+ 6FFF 32 3D 75         ld   (num_room_items), a
 377+ 7002
 378+ 7002                  ; IY punta alla cache degli item attivi
 379+ 7002 FD 21 ED 74      ld   iy, current_room_items
 380+ 7006
 381+ 7006                  ; ---------------------------------------------------------------
 382+ 7006                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 383+ 7006                  ; alla stanza corrente.
 384+ 7006                  ;
 385+ 7006                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 386+ 7006                  ; ---------------------------------------------------------------
 387+ 7006 2A 3E 75         ld   hl, (room_ptr)
 388+ 7009 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 389+ 700C 19               add  hl, de
 390+ 700D
 391+ 700D E5               push hl
 392+ 700E DD E1            pop  ix                ; IX = bitmap item
 393+ 7010
 394+ 7010                  ; ---------------------------------------------------------------
 395+ 7010                  ; Inizio scansione della tabella degli item
 396+ 7010                  ; ---------------------------------------------------------------
 397+ 7010 21 9A 6E         ld   hl, ItemsTable
 398+ 7013
 399+ 7013              .loop:
 400+ 7013
 401+ 7013                  ; ---------------------------------------------------------------
 402+ 7013                  ; Legge il Room ID del record corrente
 403+ 7013                  ; ---------------------------------------------------------------
 404+ 7013 7E               ld   a, (hl)
 405+ 7014
 406+ 7014                  ; $FF indica fine tabella
 407+ 7014 FE FF            cp   $FF
 408+ 7016 28 53            jr   z, .done
 409+ 7018
 410+ 7018                  ; ---------------------------------------------------------------
 411+ 7018                  ; Verifica se l'item appartiene alla stanza corrente
 412+ 7018                  ; ---------------------------------------------------------------
 413+ 7018 57               ld   d, a
 414+ 7019
 415+ 7019 3A E4 74         ld   a, (current_room)
 416+ 701C BA               cp   d
 417+ 701D 20 45            jr   nz, .next_item
 418+ 701F
 419+ 701F                  ; ---------------------------------------------------------------
 420+ 701F                  ; Legge i dati dell'item
 421+ 701F                  ; ---------------------------------------------------------------
 422+ 701F
 423+ 701F 23               inc  hl
 424+ 7020 4E               ld   c, (hl)           ; X (colonna)
 425+ 7021
 426+ 7021 23               inc  hl
 427+ 7022 46               ld   b, (hl)           ; Y (riga)
 428+ 7023
 429+ 7023 23               inc  hl
 430+ 7024 5E               ld   e, (hl)           ; Colore
 431+ 7025
 432+ 7025 23               inc  hl
 433+ 7026 7E               ld   a, (hl)           ; Collected flag
 434+ 7027
 435+ 7027                  ; Se diverso da zero l'item è già stato raccolto
 436+ 7027 B7               or   a
 437+ 7028 20 3E            jr   nz, .next_no_inc
 438+ 702A
 439+ 702A                  ; ---------------------------------------------------------------
 440+ 702A                  ; Disegna l'item sullo schermo
 441+ 702A                  ;
 442+ 702A                  ; B = Row
 443+ 702A                  ; C = Column
 444+ 702A                  ; HL = bitmap pointer
 445+ 702A                  ; E = Color
 446+ 702A                  ; ---------------------------------------------------------------
 447+ 702A E5               push hl
 448+ 702B
 449+ 702B DD E5            push ix
 450+ 702D E1               pop  hl
 451+ 702E
 452+ 702E CD 73 70         call DrawItemGraphic
 453+ 7031
 454+ 7031 E1               pop  hl                ; ritorna al flag collected
 455+ 7032
 456+ 7032                  ; ---------------------------------------------------------------
 457+ 7032                  ; Aggiorna items_grid
 458+ 7032                  ;
 459+ 7032                  ; Calcolo:
 460+ 7032                  ;   offset = Row * 32 + Col
 461+ 7032                  ; ---------------------------------------------------------------
 462+ 7032 E5               push hl
 463+ 7033 D5               push de
 464+ 7034
 465+ 7034 26 00            ld   h, 0
 466+ 7036 68               ld   l, b              ; HL = Row
 467+ 7037
 468+ 7037 29               add  hl, hl            ; *2
 469+ 7038 29               add  hl, hl            ; *4
 470+ 7039 29               add  hl, hl            ; *8
 471+ 703A 29               add  hl, hl            ; *16
 472+ 703B 29               add  hl, hl            ; *32
 473+ 703C
 474+ 703C 16 00            ld   d, 0
 475+ 703E 59               ld   e, c              ; DE = Col
 476+ 703F
 477+ 703F 19               add  hl, de            ; Row*32 + Col
 478+ 7040
 479+ 7040 11 00 90         ld   de, items_grid
 480+ 7043 19               add  hl, de            ; puntatore nella griglia
 481+ 7044
 482+ 7044 D1               pop  de                ; ripristina colore
 483+ 7045
 484+ 7045 73               ld   (hl), e           ; salva colore cella
 485+ 7046
 486+ 7046 E1               pop  hl
 487+ 7047
 488+ 7047                  ; ---------------------------------------------------------------
 489+ 7047                  ; Salva l'item nella cache della stanza
 490+ 7047                  ;
 491+ 7047                  ; Questo evita di dover scansionare tutta ItemsTable
 492+ 7047                  ; durante il controllo delle collisioni.
 493+ 7047                  ; ---------------------------------------------------------------
 494+ 7047
 495+ 7047 FD 71 00         ld   (iy+0), c         ; Colonna
 496+ 704A FD 70 01         ld   (iy+1), b         ; Riga
 497+ 704D FD 73 02         ld   (iy+2), e         ; Colore
 498+ 7050
 499+ 7050                  ; Salva il puntatore al flag "collected"
 500+ 7050 FD 75 03         ld   (iy+3), l         ; Low byte
 501+ 7053 FD 74 04         ld   (iy+4), h         ; High byte
 502+ 7056
 503+ 7056                  ; Passa al record successivo della cache
 504+ 7056 01 05 00         ld   bc, 5
 505+ 7059 FD 09            add  iy, bc
 506+ 705B
 507+ 705B                  ; Incrementa il numero di item attivi
 508+ 705B 3A 3D 75         ld   a, (num_room_items)
 509+ 705E 3C               inc  a
 510+ 705F 32 3D 75         ld   (num_room_items), a
 511+ 7062
 512+ 7062 18 04            jr   .next_no_inc
 513+ 7064
 514+ 7064              .next_item:
 515+ 7064
 516+ 7064                  ; ---------------------------------------------------------------
 517+ 7064                  ; L'item non appartiene alla stanza corrente.
 518+ 7064                  ; Salta i campi del record:
 519+ 7064                  ;   X
 520+ 7064                  ;   Y
 521+ 7064                  ;   Color
 522+ 7064                  ;   Collected
 523+ 7064                  ; ---------------------------------------------------------------
 524+ 7064 23               inc  hl
 525+ 7065 23               inc  hl
 526+ 7066 23               inc  hl
 527+ 7067 23               inc  hl
 528+ 7068
 529+ 7068              .next_no_inc:
 530+ 7068
 531+ 7068                  ; ---------------------------------------------------------------
 532+ 7068                  ; Avanza al record successivo
 533+ 7068                  ; (prossimo Room ID)
 534+ 7068                  ; ---------------------------------------------------------------
 535+ 7068 23               inc  hl
 536+ 7069 18 A8            jr   .loop
 537+ 706B
 538+ 706B              .done:
 539+ 706B
 540+ 706B                  ; Ripristina i registri
 541+ 706B FD E1            pop  iy
 542+ 706D DD E1            pop  ix
 543+ 706F D1               pop  de
 544+ 7070 C1               pop  bc
 545+ 7071 E1               pop  hl
 546+ 7072
 547+ 7072 C9               ret
 548+ 7073
 549+ 7073              ; -------------------------------------------------------------------
 550+ 7073              ; DrawItemGraphic
 551+ 7073              ;
 552+ 7073              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 553+ 7073              ; utilizzando una bitmap di 8 byte e un attributo colore.
 554+ 7073              ;
 555+ 7073              ; Input:
 556+ 7073              ;   B = Riga attributi (3..18)
 557+ 7073              ;   C = Colonna attributi (0..31)
 558+ 7073              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 559+ 7073              ;   E = Attributo colore
 560+ 7073              ;
 561+ 7073              ; Output:
 562+ 7073              ;   Nessuno
 563+ 7073              ;
 564+ 7073              ; Registri preservati:
 565+ 7073              ;   BC, DE, HL
 566+ 7073              ; -------------------------------------------------------------------
 567+ 7073              DrawItemGraphic:
 568+ 7073
 569+ 7073                  ; Salva i registri originali
 570+ 7073 C5               push bc
 571+ 7074 D5               push de
 572+ 7075 E5               push hl
 573+ 7076
 574+ 7076                  ; ---------------------------------------------------------------
 575+ 7076                  ; Calcolo indirizzo bitmap dello Spectrum
 576+ 7076                  ;
 577+ 7076                  ; Ogni item occupa una cella attributi (8x8 pixel).
 578+ 7076                  ;
 579+ 7076                  ; Formula:
 580+ 7076                  ;   High = $40 + (Row AND $18)
 581+ 7076                  ;   Low  = (Row AND 7) * 32 + Col
 582+ 7076                  ;
 583+ 7076                  ; DE conterrà l'indirizzo della prima scanline.
 584+ 7076                  ; ---------------------------------------------------------------
 585+ 7076
 586+ 7076 78               ld   a, b
 587+ 7077 E6 18            and  $18
 588+ 7079 C6 40            add  a, $40
 589+ 707B 57               ld   d, a              ; Byte alto indirizzo video
 590+ 707C
 591+ 707C 78               ld   a, b
 592+ 707D E6 07            and  7                 ; Riga interna al blocco da 8
 593+ 707F
 594+ 707F 87               add  a, a              ; *2
 595+ 7080 87               add  a, a              ; *4
 596+ 7081 87               add  a, a              ; *8
 597+ 7082 87               add  a, a              ; *16
 598+ 7083 87               add  a, a              ; *32
 599+ 7084
 600+ 7084 81               add  a, c              ; + colonna
 601+ 7085
 602+ 7085 5F               ld   e, a              ; Byte basso indirizzo video
 603+ 7086
 604+ 7086                  ; ---------------------------------------------------------------
 605+ 7086                  ; Disegno bitmap
 606+ 7086                  ;
 607+ 7086                  ; Copia 8 byte consecutivi nella memoria video.
 608+ 7086                  ; Ogni byte rappresenta una scanline da 8 pixel.
 609+ 7086                  ; ---------------------------------------------------------------
 610+ 7086
 611+ 7086 C5               push bc                ; Conserva Row e Col
 612+ 7087
 613+ 7087 06 08            ld   b, 8              ; Numero scanline
 614+ 7089
 615+ 7089              .line_loop:
 616+ 7089
 617+ 7089 7E               ld   a, (hl)           ; Legge scanline bitmap
 618+ 708A 12               ld   (de), a           ; Scrive nella memoria video
 619+ 708B
 620+ 708B 14               inc  d                 ; Scanline successiva
 621+ 708C 23               inc  hl                ; Byte bitmap successivo
 622+ 708D
 623+ 708D 05               dec  b
 624+ 708E 20 F9            jr   nz, .line_loop
 625+ 7090
 626+ 7090 C1               pop  bc                ; Ripristina Row e Col
 627+ 7091
 628+ 7091                  ; ---------------------------------------------------------------
 629+ 7091                  ; Calcolo indirizzo attributo
 630+ 7091                  ;
 631+ 7091                  ; Formula:
 632+ 7091                  ;   AttrAddr = $5800 + Row * 32 + Col
 633+ 7091                  ;
 634+ 7091                  ; HL conterrà l'indirizzo della cella attributi.
 635+ 7091                  ; ---------------------------------------------------------------
 636+ 7091
 637+ 7091 26 00            ld   h, 0
 638+ 7093 68               ld   l, b              ; HL = Row
 639+ 7094
 640+ 7094 29               add  hl, hl            ; *2
 641+ 7095 29               add  hl, hl            ; *4
 642+ 7096 29               add  hl, hl            ; *8
 643+ 7097 29               add  hl, hl            ; *16
 644+ 7098 29               add  hl, hl            ; *32
 645+ 7099
 646+ 7099 79               ld   a, c              ; A = Colonna
 647+ 709A
 648+ 709A 85               add  a, l
 649+ 709B 6F               ld   l, a
 650+ 709C
 651+ 709C 30 01            jr   nc, .no_carry
 652+ 709E 24               inc  h
 653+ 709F
 654+ 709F              .no_carry:
 655+ 709F
 656+ 709F                  ; HL = Row * 32 + Col
 657+ 709F
 658+ 709F 11 00 58         ld   de, $5800
 659+ 70A2 19               add  hl, de            ; HL = indirizzo attributi
 660+ 70A3
 661+ 70A3                  ; ---------------------------------------------------------------
 662+ 70A3                  ; Recupera il colore originale dallo stack.
 663+ 70A3                  ;
 664+ 70A3                  ; Layout stack:
 665+ 70A3                  ;   HL originale
 666+ 70A3                  ;   DE originale (E = colore)
 667+ 70A3                  ;   BC originale
 668+ 70A3                  ; ---------------------------------------------------------------
 669+ 70A3
 670+ 70A3 C1               pop  bc                ; Recupera HL originale
 671+ 70A4 D1               pop  de                ; Recupera DE originale
 672+ 70A5
 673+ 70A5                  ; ---------------------------------------------------------------
 674+ 70A5                  ; Scrive l'attributo colore
 675+ 70A5                  ; ---------------------------------------------------------------
 676+ 70A5
 677+ 70A5 7B               ld   a, e              ; A = colore
 678+ 70A6 77               ld   (hl), a           ; Scrive nella RAM attributi
 679+ 70A7
 680+ 70A7                  ; ---------------------------------------------------------------
 681+ 70A7                  ; Ripristina HL e BC originali
 682+ 70A7                  ; ---------------------------------------------------------------
 683+ 70A7
 684+ 70A7 C5               push bc
 685+ 70A8 E1               pop  hl                ; HL originale
 686+ 70A9
 687+ 70A9 C1               pop  bc                ; BC originale
 688+ 70AA
 689+ 70AA C9               ret
 690+ 70AB
 691+ 70AB              ; -------------------------------------------------------------------
 692+ 70AB              ; RestoreBackgroundCell
 693+ 70AB              ;
 694+ 70AB              ; Ripristina il contenuto originale di una cella della stanza.
 695+ 70AB              ; Viene utilizzata principalmente quando un item viene raccolto:
 696+ 70AB              ; invece di lasciare un "buco", la routine ridisegna il tile
 697+ 70AB              ; originale presente nella mappa della stanza.
 698+ 70AB              ;
 699+ 70AB              ; Input:
 700+ 70AB              ;   B = Row (3..18)
 701+ 70AB              ;   C = Col (0..31)
 702+ 70AB              ;
 703+ 70AB              ; Utilizza:
 704+ 70AB              ;   room_ptr -> struttura dati della stanza corrente
 705+ 70AB              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 706+ 70AB              ;   DrawTile -> ridisegna il tile selezionato
 707+ 70AB              ;
 708+ 70AB              ; Tipi di cella:
 709+ 70AB              ;   0 = Background
 710+ 70AB              ;   1 = Floor
 711+ 70AB              ;   2 = Wall
 712+ 70AB              ;   3 = Nasty
 713+ 70AB              ; -------------------------------------------------------------------
 714+ 70AB              RestoreBackgroundCell:
 715+ 70AB
 716+ 70AB                  ; Salva tutti i registri utilizzati
 717+ 70AB FD E5            push iy
 718+ 70AD C5               push bc
 719+ 70AE D5               push de
 720+ 70AF E5               push hl
 721+ 70B0 DD E5            push ix
 722+ 70B2
 723+ 70B2                  ; ---------------------------------------------------------------
 724+ 70B2                  ; Conserva Row e Col in IY.
 725+ 70B2                  ;
 726+ 70B2                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 727+ 70B2                  ; BC potrebbe essere modificato.
 728+ 70B2                  ; ---------------------------------------------------------------
 729+ 70B2 C5               push bc
 730+ 70B3 FD E1            pop  iy                ; IYH = Row, IYL = Col
 731+ 70B5
 732+ 70B5                  ; ---------------------------------------------------------------
 733+ 70B5                  ; Determina quale tipo di cella è presente nella posizione
 734+ 70B5                  ; specificata.
 735+ 70B5                  ;
 736+ 70B5                  ; Input:
 737+ 70B5                  ;   B = Row
 738+ 70B5                  ;   C = Col
 739+ 70B5                  ;
 740+ 70B5                  ; Output:
 741+ 70B5                  ;   A = tipo cella
 742+ 70B5                  ; ---------------------------------------------------------------
 743+ 70B5 78               ld   a, b
 744+ 70B6
 745+ 70B6 CD BF 6A         call GetCellFromUnpacked
 746+ 70B9
 747+ 70B9                  ; ---------------------------------------------------------------
 748+ 70B9                  ; Recupera il puntatore alla stanza corrente.
 749+ 70B9                  ;
 750+ 70B9                  ; DE = base della struttura stanza
 751+ 70B9                  ; ---------------------------------------------------------------
 752+ 70B9 ED 5B 3E 75      ld   de, (room_ptr)
 753+ 70BD
 754+ 70BD                  ; ---------------------------------------------------------------
 755+ 70BD                  ; Seleziona il tile corretto in base al tipo di cella.
 756+ 70BD                  ;
 757+ 70BD                  ; A = 0 -> Background
 758+ 70BD                  ; A = 1 -> Floor
 759+ 70BD                  ; A = 2 -> Wall
 760+ 70BD                  ; A = 3 -> Nasty
 761+ 70BD                  ; ---------------------------------------------------------------
 762+ 70BD
 763+ 70BD B7               or   a
 764+ 70BE 20 06            jr   nz, .not_bg
 765+ 70C0
 766+ 70C0                  ; Background
 767+ 70C0 21 A0 00         ld   hl, OFFSET_BG
 768+ 70C3 19               add  hl, de
 769+ 70C4 18 16            jr   .draw_cell
 770+ 70C6
 771+ 70C6              .not_bg:
 772+ 70C6
 773+ 70C6 3D               dec  a
 774+ 70C7 20 06            jr   nz, .not_floor
 775+ 70C9
 776+ 70C9                  ; Floor
 777+ 70C9 21 A9 00         ld   hl, OFFSET_FLOOR
 778+ 70CC 19               add  hl, de
 779+ 70CD 18 0D            jr   .draw_cell
 780+ 70CF
 781+ 70CF              .not_floor:
 782+ 70CF
 783+ 70CF 3D               dec  a
 784+ 70D0 20 06            jr   nz, .not_wall
 785+ 70D2
 786+ 70D2                  ; Wall
 787+ 70D2 21 B2 00         ld   hl, OFFSET_WALL
 788+ 70D5 19               add  hl, de
 789+ 70D6 18 04            jr   .draw_cell
 790+ 70D8
 791+ 70D8              .not_wall:
 792+ 70D8
 793+ 70D8                  ; Nasty
 794+ 70D8 21 BB 00         ld   hl, OFFSET_NASTY
 795+ 70DB 19               add  hl, de
 796+ 70DC
 797+ 70DC              .draw_cell:
 798+ 70DC
 799+ 70DC                  ; ---------------------------------------------------------------
 800+ 70DC                  ; HL punta ora alla grafica del tile da ridisegnare.
 801+ 70DC                  ;
 802+ 70DC                  ; DrawTile si aspetta:
 803+ 70DC                  ;   IX = puntatore tile
 804+ 70DC                  ;   B  = Row
 805+ 70DC                  ;   C  = Col
 806+ 70DC                  ; ---------------------------------------------------------------
 807+ 70DC E5               push hl
 808+ 70DD DD E1            pop  ix
 809+ 70DF
 810+ 70DF                  ; Ripristina Row e Col salvati in IY
 811+ 70DF FD E5            push iy
 812+ 70E1 C1               pop  bc
 813+ 70E2
 814+ 70E2                  ; Disegna il tile originale
 815+ 70E2 CD 8C 61         call DrawTile
 816+ 70E5
 817+ 70E5                  ; ---------------------------------------------------------------
 818+ 70E5                  ; Ripristina i registri salvati
 819+ 70E5                  ; ---------------------------------------------------------------
 820+ 70E5 DD E1            pop  ix
 821+ 70E7 E1               pop  hl
 822+ 70E8 D1               pop  de
 823+ 70E9 C1               pop  bc
 824+ 70EA FD E1            pop  iy
 825+ 70EC
 826+ 70EC C9               ret
 827+ 70ED
 828+ 70ED              ; -------------------------------------------------------------------
 829+ 70ED              ; CheckWillyItemCollision
 830+ 70ED              ;
 831+ 70ED              ; Verifica se Willy collide con un item utilizzando il controllo
 832+ 70ED              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 833+ 70ED              ;
 834+ 70ED              ; Input:
 835+ 70ED              ;   A = ItemX (colonna attributi 0..31)
 836+ 70ED              ;   H = ItemY (riga attributi 3..18)
 837+ 70ED              ;
 838+ 70ED              ; Coordinate item:
 839+ 70ED              ;   Ogni item occupa una cella da 8x8 pixel.
 840+ 70ED              ;
 841+ 70ED              ; Coordinate Willy:
 842+ 70ED              ;   Willy occupa un rettangolo di 16x16 pixel.
 843+ 70ED              ;
 844+ 70ED              ; Output:
 845+ 70ED              ;   Carry Set   = collisione rilevata
 846+ 70ED              ;   Carry Clear = nessuna collisione
 847+ 70ED              ;
 848+ 70ED              ; Registri preservati:
 849+ 70ED              ;   BC, DE, HL
 850+ 70ED              ; -------------------------------------------------------------------
 851+ 70ED              CheckWillyItemCollision:
 852+ 70ED
 853+ 70ED                  ; Salva i registri utilizzati
 854+ 70ED C5               push bc
 855+ 70EE D5               push de
 856+ 70EF E5               push hl
 857+ 70F0
 858+ 70F0                  ; ---------------------------------------------------------------
 859+ 70F0                  ; Calcola il bounding box orizzontale dell'item
 860+ 70F0                  ;
 861+ 70F0                  ; ItemLeft  = ItemX * 8
 862+ 70F0                  ; ItemRight = ItemLeft + 7
 863+ 70F0                  ;
 864+ 70F0                  ; E = ItemLeft
 865+ 70F0                  ; D = ItemRight
 866+ 70F0                  ; ---------------------------------------------------------------
 867+ 70F0 6F               ld   l, a              ; L = ItemX
 868+ 70F1
 869+ 70F1 7D               ld   a, l
 870+ 70F2 87               add  a, a              ; *2
 871+ 70F3 87               add  a, a              ; *4
 872+ 70F4 87               add  a, a              ; *8
 873+ 70F5
 874+ 70F5 5F               ld   e, a              ; E = ItemLeft
 875+ 70F6
 876+ 70F6 C6 07            add  a, 7
 877+ 70F8 57               ld   d, a              ; D = ItemRight
 878+ 70F9
 879+ 70F9                  ; ---------------------------------------------------------------
 880+ 70F9                  ; Recupera la posizione corrente di Willy
 881+ 70F9                  ;
 882+ 70F9                  ; B = WillyY
 883+ 70F9                  ; C = WillyX
 884+ 70F9                  ; ---------------------------------------------------------------
 885+ 70F9 ED 4B CE 71      ld   bc, (PlayerPos)
 886+ 70FD
 887+ 70FD                  ; ---------------------------------------------------------------
 888+ 70FD                  ; Primo test:
 889+ 70FD                  ;
 890+ 70FD                  ; WillyLeft <= ItemRight
 891+ 70FD                  ;
 892+ 70FD                  ; Se Willy è completamente a destra dell'item
 893+ 70FD                  ; non può esserci collisione.
 894+ 70FD                  ; ---------------------------------------------------------------
 895+ 70FD 79               ld   a, c              ; A = WillyLeft
 896+ 70FE
 897+ 70FE BA               cp   d                 ; WillyLeft vs ItemRight
 898+ 70FF
 899+ 70FF 28 04            jr   z, .x_ok
 900+ 7101 38 02            jr   c, .x_ok
 901+ 7103
 902+ 7103 18 29            jr   .no_collision
 903+ 7105
 904+ 7105              .x_ok:
 905+ 7105
 906+ 7105                  ; ---------------------------------------------------------------
 907+ 7105                  ; Secondo test:
 908+ 7105                  ;
 909+ 7105                  ; WillyRight >= ItemLeft
 910+ 7105                  ;
 911+ 7105                  ; WillyRight = WillyX + 7
 912+ 7105                  ; ---------------------------------------------------------------
 913+ 7105 C6 07            add  a, 7
 914+ 7107
 915+ 7107 BB               cp   e                 ; WillyRight vs ItemLeft
 916+ 7108
 917+ 7108 28 04            jr   z, .y_check
 918+ 710A 30 02            jr   nc, .y_check
 919+ 710C
 920+ 710C 18 20            jr   .no_collision
 921+ 710E
 922+ 710E              .y_check:
 923+ 710E
 924+ 710E                  ; ---------------------------------------------------------------
 925+ 710E                  ; Recupera ItemY dal valore originale di HL
 926+ 710E                  ;
 927+ 710E                  ; H contiene la riga dell'item.
 928+ 710E                  ; ---------------------------------------------------------------
 929+ 710E E1               pop  hl
 930+ 710F E5               push hl
 931+ 7110
 932+ 7110                  ; ---------------------------------------------------------------
 933+ 7110                  ; Calcola il bounding box verticale dell'item
 934+ 7110                  ;
 935+ 7110                  ; ItemTop    = ItemY * 8
 936+ 7110                  ; ItemBottom = ItemTop + 7
 937+ 7110                  ;
 938+ 7110                  ; E = ItemTop
 939+ 7110                  ; D = ItemBottom
 940+ 7110                  ; ---------------------------------------------------------------
 941+ 7110 7C               ld   a, h
 942+ 7111
 943+ 7111 87               add  a, a              ; *2
 944+ 7112 87               add  a, a              ; *4
 945+ 7113 87               add  a, a              ; *8
 946+ 7114
 947+ 7114 5F               ld   e, a              ; ItemTop
 948+ 7115
 949+ 7115 C6 07            add  a, 7
 950+ 7117 57               ld   d, a              ; ItemBottom
 951+ 7118
 952+ 7118                  ; ---------------------------------------------------------------
 953+ 7118                  ; Primo test verticale:
 954+ 7118                  ;
 955+ 7118                  ; WillyTop <= ItemBottom
 956+ 7118                  ; ---------------------------------------------------------------
 957+ 7118 78               ld   a, b              ; WillyTop
 958+ 7119
 959+ 7119 BA               cp   d
 960+ 711A
 961+ 711A 28 04            jr   z, .y_ok
 962+ 711C 38 02            jr   c, .y_ok
 963+ 711E
 964+ 711E 18 0E            jr   .no_collision
 965+ 7120
 966+ 7120              .y_ok:
 967+ 7120
 968+ 7120                  ; ---------------------------------------------------------------
 969+ 7120                  ; Secondo test verticale:
 970+ 7120                  ;
 971+ 7120                  ; WillyBottom >= ItemTop
 972+ 7120                  ;
 973+ 7120                  ; WillyBottom = WillyY + 15
 974+ 7120                  ; ---------------------------------------------------------------
 975+ 7120 C6 0F            add  a, 15
 976+ 7122
 977+ 7122 BB               cp   e
 978+ 7123
 979+ 7123 28 04            jr   z, .collision
 980+ 7125 30 02            jr   nc, .collision
 981+ 7127
 982+ 7127 18 05            jr   .no_collision
 983+ 7129
 984+ 7129              .collision:
 985+ 7129
 986+ 7129                  ; ---------------------------------------------------------------
 987+ 7129                  ; Collisione rilevata
 988+ 7129                  ; ---------------------------------------------------------------
 989+ 7129 E1               pop  hl
 990+ 712A D1               pop  de
 991+ 712B C1               pop  bc
 992+ 712C
 993+ 712C 37               scf                    ; Carry = 1
 994+ 712D
 995+ 712D C9               ret
 996+ 712E
 997+ 712E              .no_collision:
 998+ 712E
