  71+ 8883              ; -------------------------------------------------------------------
  72+ 8883              ; Audio_UpdateMusic
  73+ 8883              ;
  74+ 8883              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8883              ; Riproduce "If I Were a Rich Man" fedele alla routine originale di Jet Set Willy:
  76+ 8883              ; - Tabella di 64 note (128 burst per ciclo completo)
  77+ 8883              ; - Cadenza temporizzata a 2 frame per burst (80ms) per rispettare il tempo reale
  78+ 8883              ; - Generazione tono con ciclo beeper originale (768 passaggi)
  79+ 8883              ; - Variazione dinamica dell'intonazione in base alle vite rimaste
  80+ 8883              ; -------------------------------------------------------------------
  81+ 8883              Audio_UpdateMusic:
  82+ 8883 F5               push af
  83+ 8884 C5               push bc
  84+ 8885 D5               push de
  85+ 8886 E5               push hl
  86+ 8887
  87+ 8887                  ; Gestione del tempo (suona 1 burst ogni 2 frame = 80ms per frame rate a 25FPS)
  88+ 8887 3A 1B FC         ld   a, (Audio_music_frame_counter)
  89+ 888A 3D               dec  a
  90+ 888B 32 1B FC         ld   (Audio_music_frame_counter), a
  91+ 888E 20 45            jr   nz, .done
  92+ 8890
  93+ 8890 3E 02            ld   a, 2                     ; Reimposta contatore a 2 frame
  94+ 8892 32 1B FC         ld   (Audio_music_frame_counter), a
  95+ 8895
  96+ 8895                  ; Incrementa l'indice delle note (0..127) e calcola l'offset nota (0..63)
  97+ 8895 3A 1A FC         ld   a, (Audio_music_note_idx)
  98+ 8898 3C               inc  a
  99+ 8899 32 1A FC         ld   (Audio_music_note_idx), a
 100+ 889C E6 7E            and  126                      ; Maschera bit 1..6 (2 burst per nota)
 101+ 889E 0F               rrca                          ; A = indice nota nella tabella (0..63)
 102+ 889F 5F               ld   e, a
 103+ 88A0 16 00            ld   d, 0
 104+ 88A2 21 DA 88         ld   hl, Audio_MusicTune
 105+ 88A5 19               add  hl, de
 106+ 88A6
 107+ 88A6                  ; Variazione di intonazione in base alle vite rimaste (come nell'originale)
 108+ 88A6 3A 12 F8         ld   a, (willy_lives)         ; Vite di Willy (0..7)
 109+ 88A9 FE 08            cp   8
 110+ 88AB 38 02            jr   c, .lives_ok
 111+ 88AD 3E 07            ld   a, 7
 112+ 88AF              .lives_ok:
 113+ 88AF 07               rlca
 114+ 88B0 07               rlca
 115+ 88B1 D6 1C            sub  28
 116+ 88B3 ED 44            neg                           ; A = 28 - (willy_lives * 4) -> 0 a 7 vite
 117+ 88B5 86               add  a, (hl)                  ; A = ritardo tono base + offset vite
 118+ 88B6 57               ld   d, a                     ; D = periodo semionda
 119+ 88B7
 120+ 88B7                  ; Generazione del tono con il beeper (768 passaggi identici all'originale)
 121+ 88B7 3A 11 F8         ld   a, (room_border_color)
 122+ 88BA E6 07            and  $07                      ; Mantiene i bit del bordo hardware puliti
 123+ 88BC 5A               ld   e, d                     ; E = contatore semionda
 124+ 88BD 06 00            ld   b, 0                     ; B = 0 (256 iterazioni djnz)
 125+ 88BF 0E 03            ld   c, 3                     ; C = 3 (3 * 256 = 768 passaggi totali, ~8.7ms)
 126+ 88C1              .tone_loop:
 127+ 88C1 D3 FE            out  ($fe), a                 ; 11 T-states
 128+ 88C3 1D               dec  e                        ; 4 T-states
 129+ 88C4 20 03            jr   nz, .no_toggle           ; 12 T-states
 130+ 88C6 5A               ld   e, d                     ; 4 T-states
 131+ 88C7 EE 18            xor  $18                      ; 7 T-states (toggle EAR bit 4 e MIC bit 3)
 132+ 88C9              .no_toggle:
 133+ 88C9 10 F6            djnz .tone_loop               ; 13 T-states
 134+ 88CB 0D               dec  c                        ; 4 T-states
 135+ 88CC 20 F3            jr   nz, .tone_loop           ; 12 T-states
 136+ 88CE
 137+ 88CE                  ; Ripristina speaker OFF mantenendo il colore del bordo
 138+ 88CE 3A 11 F8         ld   a, (room_border_color)
 139+ 88D1 E6 07            and  $07
 140+ 88D3 D3 FE            out  ($fe), a
 141+ 88D5
 142+ 88D5              .done:
 143+ 88D5 E1               pop  hl
 144+ 88D6 D1               pop  de
 145+ 88D7 C1               pop  bc
 146+ 88D8 F1               pop  af
 147+ 88D9 C9               ret
