 513+ 6C81              ; -------------------------------------------------------------------
 514+ 6C81              PlayCollectSound:
 515+ 6C81 C5               push bc
 516+ 6C82 D5               push de
 517+ 6C83
 518+ 6C83 06 78            ld   b, 120            ; Cicli della nota
 519+ 6C85              .sound_loop:
 520+ 6C85 3A EE 77         ld   a, (room_border_color)
 521+ 6C88 F6 10            or   $10               ; Speaker ON (bit 4 = 1)
 522+ 6C8A D3 FE            out  ($fe), a
 523+ 6C8C 0E 3C            ld   c, 60             ; Mezzo periodo delay
 524+ 6C8E 0D           .d1: dec  c
 525+ 6C8F 20 FD            jr   nz, .d1
 526+ 6C91
 527+ 6C91 3A EE 77         ld   a, (room_border_color)
 528+ 6C94 E6 EF            and  $ef               ; Speaker OFF (bit 4 = 0)
 529+ 6C96 D3 FE            out  ($fe), a
 530+ 6C98 0E 3C            ld   c, 60             ; Mezzo periodo delay
 531+ 6C9A 0D           .d2: dec  c
 532+ 6C9B 20 FD            jr   nz, .d2
 533+ 6C9D
 534+ 6C9D 10 E6            djnz .sound_loop
 535+ 6C9F
 536+ 6C9F D1               pop  de
 537+ 6CA0 C1               pop  bc
 538+ 6CA1 C9               ret
