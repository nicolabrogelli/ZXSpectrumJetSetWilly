 157+ 8918              ; Audio_PlayTitleNote
 158+ 8918              ;
 159+ 8918              ; Suona una nota della melodia del titolo (Moonlight Sonata).
 160+ 8918              ; HL = puntatore al byte della nota in Audio_TitleMusicSheet
 161+ 8918              ; Ritorna:
 162+ 8918              ;   Z flag SET   -> Tasto ENTER premuto (interrompi e avvia il gioco)
 163+ 8918              ;   Z flag RESET -> Nota completata regolarmente senza pressione di ENTER
 164+ 8918              ; -------------------------------------------------------------------
 165+ 8918              Audio_PlayTitleNote:
 166+ 8918 C5               push bc
 167+ 8919 D5               push de
 168+ 891A E5               push hl
 169+ 891B
 170+ 891B 5E               ld   e, (hl)               ; E = ritardo periodo nota
 171+ 891C 53               ld   d, e                  ; D = contatore ritardo
 172+ 891D 06 00            ld   b, 0                  ; B = 0 (256 iterazioni djnz)
 173+ 891F 0E 64            ld   c, 100                ; C = 100 passaggi di ciclo (50 alti, 50 bassi)
 174+ 8921 AF               xor  a                     ; Bordo nero, speaker off
 175+ 8922
 176+ 8922              .tone_loop:
 177+ 8922 D3 FE            out  ($fe), a              ; 11 T-states
 178+ 8924 15               dec  d                     ; 4 T-states
 179+ 8925 20 03            jr   nz, .no_toggle        ; 12 T-states
 180+ 8927 53               ld   d, e                  ; 4 T-states
 181+ 8928 EE 18            xor  $18                   ; 7 T-states (toggle EAR bit 4 e MIC bit 3)
 182+ 892A              .no_toggle:
 183+ 892A 10 F6            djnz .tone_loop            ; 13 T-states
 184+ 892C
 185+ 892C                  ; A metà nota (C = 50), dimezza la frequenza (raddoppia E) e controlla ENTER
 186+ 892C 08               ex   af, af'
 187+ 892D 79               ld   a, c
 188+ 892E FE 32            cp   50
 189+ 8930 20 09            jr   nz, .no_octave_drop
 190+ 8932 CB 13            rl   e                     ; Scala di un'ottava verso il basso
 191+ 8934
 192+ 8934                  ; Controllo reattivo di ENTER a metà nota (Porta $BFFE, Bit 0)
 193+ 8934 3E BF            ld   a, $bf
 194+ 8936 DB FE            in   a, ($fe)
 195+ 8938 1F               rra
 196+ 8939 30 14            jr   nc, .enter_hit        ; Carry = 0 -> tasto premuto!
 197+ 893B
 198+ 893B              .no_octave_drop:
 199+ 893B 08               ex   af, af'
 200+ 893C 0D               dec  c
 201+ 893D 20 E3            jr   nz, .tone_loop
 202+ 893F
 203+ 893F                  ; Controllo a fine nota
 204+ 893F AF               xor  a
 205+ 8940 D3 FE            out  ($fe), a              ; Spegne lo speaker
 206+ 8942 3E BF            ld   a, $bf
 207+ 8944 DB FE            in   a, ($fe)
 208+ 8946 1F               rra
 209+ 8947 30 07            jr   nc, .enter_hit_clean
 210+ 8949
 211+ 8949                  ; Nota completata senza tasti premuti
 212+ 8949 E1               pop  hl
 213+ 894A D1               pop  de
 214+ 894B C1               pop  bc
 215+ 894C F6 01            or   1                     ; Forza flag NZ (Zero = 0)
 216+ 894E C9               ret
 217+ 894F
 218+ 894F              .enter_hit:
 219+ 894F 08               ex   af, af'
 220+ 8950              .enter_hit_clean:
 221+ 8950 AF               xor  a
 222+ 8951 D3 FE            out  ($fe), a              ; Spegne lo speaker
 223+ 8953 E1               pop  hl
 224+ 8954 D1               pop  de
 225+ 8955 C1               pop  bc
 226+ 8956 BF               cp   a                     ; Forza flag Z (Zero = 1)
 227+ 8957 C9               ret
 228+ 8958
 229+ 8958              Audio_TitleMusicSheet:
 230+ 8958                  ; Melodia dello start screen (Moonlight Sonata - Beethoven, come in JSW originale)
 231+ 8958 51 3C 33 51      db 81, 60, 51, 81, 60, 51, 81, 60, 51, 81, 60, 51, 81, 60, 51, 81
 231+ 895C 3C 33 51 3C
