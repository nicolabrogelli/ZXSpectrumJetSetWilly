 457  88B0 CD 7C 6C         call InitRoomEntryPositions
 458  88B3
 459  88B3                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 460  88B3 3E 07            ld   a, 7
 461  88B5 32 64 EF         ld   (time_hours), a
 462  88B8 AF               xor  a
 463  88B9 32 65 EF         ld   (time_minutes), a
