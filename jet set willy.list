  63+ 6BF4              ; DetermineCurrentRoomID
  64+ 6BF4              ;
  65+ 6BF4              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 6BF4              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 6BF4              ;
  68+ 6BF4              ; Se viene trovata una corrispondenza:
  69+ 6BF4              ;   A = ID della stanza
  70+ 6BF4              ;   current_room = A
