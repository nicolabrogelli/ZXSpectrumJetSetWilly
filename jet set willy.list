 174+ 78CC              ; Audio_PlayCollectSound
 175+ 78CC              ;
 176+ 78CC              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 177+ 78CC              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 178+ 78CC              ; -------------------------------------------------------------------
 179+ 78CC              Audio_PlayCollectSound:
 180+ 78CC C5               push bc
 181+ 78CD D5               push de
 182+ 78CE
 183+ 78CE 06 78            ld   b, 120
