1467+ 854C              ; -------------------------------------------------------------------
1468+ 854C              ; RestoreBackgroundCell
1469+ 854C              ;
1470+ 854C              ; Ripristina il contenuto originale di una cella della stanza.
1471+ 854C              ; Viene utilizzata principalmente quando un item viene raccolto:
1472+ 854C              ; invece di lasciare un "buco", la routine ridisegna il tile
1473+ 854C              ; originale presente nella mappa della stanza.
1474+ 854C              ;
1475+ 854C              ; Input:
1476+ 854C              ;   B = Row (3..18)
1477+ 854C              ;   C = Col (0..31)
1478+ 854C              ;
1479+ 854C              ; Utilizza:
1480+ 854C              ;   room_ptr -> struttura dati della stanza corrente
1481+ 854C              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1482+ 854C              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1483+ 854C              ;
1484+ 854C              ; Tipi di cella:
1485+ 854C              ;   0 = Background
1486+ 854C              ;   1 = Floor
1487+ 854C              ;   2 = Wall
1488+ 854C              ;   3 = Nasty
1489+ 854C              ; -------------------------------------------------------------------
1490+ 854C              RestoreBackgroundCell:
1491+ 854C
1492+ 854C                  ; Salva tutti i registri utilizzati
1493+ 854C FD E5            push iy
1494+ 854E C5               push bc
1495+ 854F D5               push de
1496+ 8550 E5               push hl
1497+ 8551 DD E5            push ix
1498+ 8553
1499+ 8553                  ; ---------------------------------------------------------------
1500+ 8553                  ; Conserva Row e Col in IY.
1501+ 8553                  ;
1502+ 8553                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1503+ 8553                  ; BC potrebbe essere modificato.
1504+ 8553                  ; ---------------------------------------------------------------
1505+ 8553 C5               push bc
1506+ 8554 FD E1            pop  iy                ; IYH = Row, IYL = Col
1507+ 8556
1508+ 8556                  ; ---------------------------------------------------------------
1509+ 8556                  ; Determina quale tipo di cella è presente nella posizione
1510+ 8556                  ; specificata.
1511+ 8556                  ;
1512+ 8556                  ; Input:
1513+ 8556                  ;   B = Row
1514+ 8556                  ;   C = Col
1515+ 8556                  ;
1516+ 8556                  ; Output:
1517+ 8556                  ;   A = tipo cella
1518+ 8556                  ; ---------------------------------------------------------------
1519+ 8556 78               ld   a, b
1520+ 8557
1521+ 8557 CD 1E 76         call GetCellFromUnpacked
1522+ 855A
1523+ 855A                  ; ---------------------------------------------------------------
1524+ 855A                  ; Recupera il puntatore alla stanza corrente.
1525+ 855A                  ;
1526+ 855A                  ; DE = base della struttura stanza
1527+ 855A                  ; ---------------------------------------------------------------
1528+ 855A ED 5B FC EF      ld   de, (room_ptr)
1529+ 855E
1530+ 855E                  ; ---------------------------------------------------------------
1531+ 855E                  ; Seleziona il tile corretto in base al tipo di cella.
1532+ 855E                  ;
1533+ 855E                  ; A = 0 -> Background
1534+ 855E                  ; A = 1 -> Floor
1535+ 855E                  ; A = 2 -> Wall
1536+ 855E                  ; A = 3 -> Nasty
1537+ 855E                  ; ---------------------------------------------------------------
1538+ 855E
1539+ 855E B7               or   a
1540+ 855F 20 06            jr   nz, .not_bg
1541+ 8561
1542+ 8561                  ; Background
1543+ 8561 21 A0 00         ld   hl, OFFSET_BG
1544+ 8564 19               add  hl, de
1545+ 8565 18 16            jr   .draw_cell
1546+ 8567
1547+ 8567              .not_bg:
1548+ 8567
1549+ 8567 3D               dec  a
1550+ 8568 20 06            jr   nz, .not_floor
1551+ 856A
1552+ 856A                  ; Floor
1553+ 856A 21 A9 00         ld   hl, OFFSET_FLOOR
1554+ 856D 19               add  hl, de
1555+ 856E 18 0D            jr   .draw_cell
1556+ 8570
1557+ 8570              .not_floor:
1558+ 8570
1559+ 8570 3D               dec  a
1560+ 8571 20 06            jr   nz, .not_wall
1561+ 8573
1562+ 8573                  ; Wall
1563+ 8573 21 B2 00         ld   hl, OFFSET_WALL
1564+ 8576 19               add  hl, de
1565+ 8577 18 04            jr   .draw_cell
1566+ 8579
1567+ 8579              .not_wall:
1568+ 8579
1569+ 8579                  ; Nasty
1570+ 8579 21 BB 00         ld   hl, OFFSET_NASTY
1571+ 857C 19               add  hl, de
1572+ 857D
1573+ 857D              .draw_cell:
1574+ 857D
1575+ 857D                  ; ---------------------------------------------------------------
1576+ 857D                  ; HL punta ora alla grafica del tile da ridisegnare.
1577+ 857D                  ;
1578+ 857D                  ; Gfx_DrawTile si aspetta:
1579+ 857D                  ;   IX = puntatore tile
1580+ 857D                  ;   B  = Row
1581+ 857D                  ;   C  = Col
1582+ 857D                  ; ---------------------------------------------------------------
1583+ 857D E5               push hl
1584+ 857E DD E1            pop  ix
1585+ 8580
1586+ 8580                  ; Ripristina Row e Col salvati in IY
1587+ 8580 FD E5            push iy
1588+ 8582 C1               pop  bc
1589+ 8583
1590+ 8583                  ; Disegna il tile originale
1591+ 8583 CD ED 68         call Gfx_DrawTile
1592+ 8586
1593+ 8586                  ; ---------------------------------------------------------------
1594+ 8586                  ; Ripristina i registri salvati
1595+ 8586                  ; ---------------------------------------------------------------
1596+ 8586 DD E1            pop  ix
1597+ 8588 E1               pop  hl
1598+ 8589 D1               pop  de
1599+ 858A C1               pop  bc
1600+ 858B FD E1            pop  iy
1601+ 858D
1602+ 858D C9               ret
