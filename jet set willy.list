 362  87B7 DB FE            in   a, ($fe)
 363  87B9 1F               rra
 364  87BA 30 F8            jr   nc, .wait_enter_release
 365  87BC
 366  87BC                  ; 3. Attesa della pressione del tasto ENTER con animazione ciclo colore su GAME OVER (Riga 5, Col 11)
 367  87BC 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 368  87BE              .wait_enter_press:
 369  87BE 76               halt
 370  87BF
 371  87BF                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 372  87BF 0C               inc  c
 373  87C0 79               ld   a, c
 374  87C1 CB 3F            srl  a
 375  87C3 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 376  87C5 E6 07            and  7
 377  87C7 5F               ld   e, a
 378  87C8 16 00            ld   d, 0
 379  87CA 21 A4 64         ld   hl, game_over_color_table
 380  87CD 19               add  hl, de
 381  87CE 7E               ld   a, (hl)               ; A = nuovo colore attributo
 382  87CF 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 383  87D2 06 09            ld   b, 9
