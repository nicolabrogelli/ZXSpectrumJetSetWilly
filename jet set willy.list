  93+ 664A                  ; ── Sezione 2: movimento (sinistra / destra) ────────────────────
  94+ 664A                  ;
  95+ 664A                  ; Porta $DF → riga P, O, I, U, Y.
  96+ 664A                  ; Bit 0 = P (destra), Bit 1 = O (sinistra).
  97+ 664A
  98+ 664A 16 00            ld  d, $00                  ; azzera output
  99+ 664C 01 FE DF         ld  bc, $dffe
 100+ 664F ED 78            in  a, (c)                  ; legge riga $FE
