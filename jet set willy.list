 288  87D7 1F               rra
 289  87D8 30 F8            jr   nc, .wait_title_enter_release
 290  87DA
 291  87DA                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 292  87DA 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 293  87DC              .title_loop:
 294  87DC 76               halt
 295  87DD
 296  87DD                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 297  87DD 0C               inc  c
 298  87DE 79               ld   a, c
 299  87DF CB 3F            srl  a
 300  87E1 CB 3F            srl  a
 301  87E3 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 302  87E5 E6 07            and  7
 303  87E7 5F               ld   e, a
 304  87E8 16 00            ld   d, 0
 305  87EA 21 13 63         ld   hl, title_color_table
 306  87ED 19               add  hl, de
