1487+ 78E4              ; CheckActiveItemAtCell
1488+ 78E4              ;
1489+ 78E4              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1490+ 78E4              ; nella cella specificata della griglia items_grid.
1491+ 78E4              ;
1492+ 78E4              ; Questa routine usa una lookup diretta su una mappa 32x16,
1493+ 78E4              ; evitando la scansione della ItemsTable.
1494+ 78E4              ;
1495+ 78E4              ; Input:
1496+ 78E4              ;   B = Colonna (0..31)
1497+ 78E4              ;   C = Riga (0..15)
1498+ 78E4              ;
1499+ 78E4              ; Output:
1500+ 78E4              ;   Carry Set   = item presente nella cella
1501+ 78E4              ;   Carry Clear = nessun item
1502+ 78E4              ;
1503+ 78E4              ; Nota:
1504+ 78E4              ;   HL NON è restituito valido (commento originale non corretto:
1505+ 78E4              ;   la routine non punta a ItemsTable).
1506+ 78E4              ; -------------------------------------------------------------------
1507+ 78E4              CheckActiveItemAtCell:
1508+ 78E4
1509+ 78E4                  ; Salva registri usati
1510+ 78E4 D5               push de
1511+ 78E5 E5               push hl
1512+ 78E6
1513+ 78E6                  ; ---------------------------------------------------------------
1514+ 78E6                  ; Calcolo indice lineare nella griglia 32x16:
1515+ 78E6                  ;
1516+ 78E6                  ; offset = Row * 32 + Col
1517+ 78E6                  ; ---------------------------------------------------------------
1518+ 78E6 26 00            ld   h, 0
1519+ 78E8 69               ld   l, c              ; HL = Row
1520+ 78E9
1521+ 78E9 29               add  hl, hl            ; *2
1522+ 78EA 29               add  hl, hl            ; *4
1523+ 78EB 29               add  hl, hl            ; *8
1524+ 78EC 29               add  hl, hl            ; *16
1525+ 78ED 29               add  hl, hl            ; *32
1526+ 78EE
1527+ 78EE                  ; Aggiunge la colonna
1528+ 78EE 58               ld   e, b
1529+ 78EF 16 00            ld   d, 0
1530+ 78F1 19               add  hl, de            ; HL = Row*32 + Col
1531+ 78F2
1532+ 78F2                  ; ---------------------------------------------------------------
1533+ 78F2                  ; Accesso alla griglia degli item attivi
1534+ 78F2                  ; ---------------------------------------------------------------
1535+ 78F2 11 00 B0         ld   de, items_grid
1536+ 78F5 19               add  hl, de            ; HL = address cella
1537+ 78F6
1538+ 78F6                  ; ---------------------------------------------------------------
1539+ 78F6                  ; Controllo presenza item
1540+ 78F6                  ;
1541+ 78F6                  ; items_grid contiene:
1542+ 78F6                  ;   0 = nessun item
1543+ 78F6                  ;   >0 = item attivo (colore o flag)
1544+ 78F6                  ; ---------------------------------------------------------------
1545+ 78F6 7E               ld   a, (hl)
1546+ 78F7 B7               or   a
1547+ 78F8 28 04            jr   z, .not_active
1548+ 78FA
1549+ 78FA                  ; ---------------------------------------------------------------
1550+ 78FA                  ; Item trovato
1551+ 78FA                  ; ---------------------------------------------------------------
1552+ 78FA E1               pop  hl
1553+ 78FB D1               pop  de
1554+ 78FC
1555+ 78FC 37               scf                    ; Carry = 1
1556+ 78FD C9               ret
1557+ 78FE
1558+ 78FE              .not_active:
1559+ 78FE
1560+ 78FE                  ; ---------------------------------------------------------------
1561+ 78FE                  ; Nessun item nella cella
1562+ 78FE                  ; ---------------------------------------------------------------
1563+ 78FE E1               pop  hl
1564+ 78FF D1               pop  de
1565+ 7900
1566+ 7900 B7               or   a                 ; Carry = 0
1567+ 7901 C9               ret
