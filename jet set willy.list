 842+ 7CC0 3E 01            ld   a, 1
 843+ 7CC2 32 22 EE         ld   (enemy_was_updated), a
 844+ 7CC5
 845+ 7CC5 DD 21 C7 77      ld   ix, ActiveEnemies
 846+ 7CC9 06 08            ld   b, 8              ; 8 slot
 847+ 7CCB              .loop:
 848+ 7CCB DD 7E 00         ld   a, (ix+0)         ; Flags
 849+ 7CCE E6 80            and  $80               ; Active?
 850+ 7CD0 CA A2 7D         jp   z, .next
 851+ 7CD3
 852+ 7CD3                  ; 1. Aggiorna Anim State
 853+ 7CD3 DD 7E 01         ld   a, (ix+1)         ; Sprite Type (Offset 1)
 854+ 7CD6 E6 3F            and  $3F               ; Tipo
 855+ 7CD8 FE 0D            cp   13                ; Tipo 13 = Canguro?
 856+ 7CDA 28 2A            jr   z, .canguro_anim
 857+ 7CDC FE 0B            cp   11                ; Tipo 11 = Soldato?
 858+ 7CDE 28 1B            jr   z, .soldato_anim
 859+ 7CE0 FE 10            cp   16                ; Tipo 16 = Candelabro?
 860+ 7CE2 28 17            jr   z, .soldato_anim
 861+ 7CE4 FE 14            cp   20                ; Tipo 20 = Nonnino?
 862+ 7CE6 28 13            jr   z, .soldato_anim
 863+ 7CE8 FE 15            cp   21                ; Tipo 21 = Parrucca?
 864+ 7CEA 28 0F            jr   z, .soldato_anim
 865+ 7CEC FE 1D            cp   29                ; Tipo 29 = Saliera?
 866+ 7CEE 28 0B            jr   z, .soldato_anim
 867+ 7CF0
 868+ 7CF0 DD 7E 07         ld   a, (ix+7)         ; Anim State (Offset 7)
 869+ 7CF3 3C               inc  a
 870+ 7CF4 E6 03            and  3                 ; Alterna 0..3
 871+ 7CF6 DD 77 07         ld   (ix+7), a
 872+ 7CF9 18 14            jr   .anim_done
 873+ 7CFB
 874+ 7CFB              .soldato_anim:
 875+ 7CFB DD 7E 07         ld   a, (ix+7)         ; Anim State
 876+ 7CFE 3C               inc  a
 877+ 7CFF E6 01            and  1                 ; Alterna 0..1
 878+ 7D01 DD 77 07         ld   (ix+7), a
 879+ 7D04 18 09            jr   .anim_done
 880+ 7D06
 881+ 7D06              .canguro_anim:
 882+ 7D06 DD 7E 07         ld   a, (ix+7)         ; Anim State
 883+ 7D09 3C               inc  a
 884+ 7D0A E6 07            and  7                 ; Alterna 0..7
 885+ 7D0C DD 77 07         ld   (ix+7), a
 886+ 7D0F
 887+ 7D0F              .anim_done:
 888+ 7D0F
 889+ 7D0F                  ; 3. Determina se orizzontale o verticale
 890+ 7D0F DD 7E 00         ld   a, (ix+0)         ; Flags
 891+ 7D12 E6 40            and  $40               ; Vertical? (Bit 6)
 892+ 7D14 C2 5E 7D         jp   nz, .vertical
 893+ 7D17
 894+ 7D17              .horizontal:
 895+ 7D17 DD 7E 06         ld   a, (ix+6)         ; Direction (1=Left, 2=Right) (Offset 6)
 896+ 7D1A FE 01            cp   1
 897+ 7D1C 20 20            jr   nz, .horiz_right
 898+ 7D1E
 899+ 7D1E              .horiz_left:
 900+ 7D1E DD 7E 02         ld   a, (ix+2)         ; Current X
 901+ 7D21 D6 02            sub  2                 ; Muovi a sinistra di 2 pixel
 902+ 7D23 DD BE 04         cp   (ix+4)            ; Min Limit (Offset 4)
 903+ 7D26 28 08            jr   z, .h_rev_right
 904+ 7D28 38 06            jr   c, .h_rev_right
 905+ 7D2A DD 77 02         ld   (ix+2), a
 906+ 7D2D C3 A2 7D         jp   .next
 907+ 7D30
 908+ 7D30              .h_rev_right:
 909+ 7D30 DD 7E 04         ld   a, (ix+4)         ; Min Limit
 910+ 7D33 DD 77 02         ld   (ix+2), a
 911+ 7D36 3E 02            ld   a, 2
 912+ 7D38 DD 77 06         ld   (ix+6), a         ; Cambia direzione a Destra (Offset 6)
 913+ 7D3B C3 A2 7D         jp   .next
 914+ 7D3E
 915+ 7D3E              .horiz_right:
 916+ 7D3E DD 7E 02         ld   a, (ix+2)         ; Current X
 917+ 7D41 C6 02            add  a, 2              ; Muovi a destra di 2 pixel
 918+ 7D43 DD BE 05         cp   (ix+5)            ; Max Limit (Offset 5)
 919+ 7D46 28 08            jr   z, .h_rev_left
 920+ 7D48 30 06            jr   nc, .h_rev_left
 921+ 7D4A DD 77 02         ld   (ix+2), a
 922+ 7D4D C3 A2 7D         jp   .next
 923+ 7D50
 924+ 7D50              .h_rev_left:
 925+ 7D50 DD 7E 05         ld   a, (ix+5)         ; Max Limit
 926+ 7D53 DD 77 02         ld   (ix+2), a
 927+ 7D56 3E 01            ld   a, 1
 928+ 7D58 DD 77 06         ld   (ix+6), a         ; Cambia direzione a Sinistra
 929+ 7D5B C3 A2 7D         jp   .next
 930+ 7D5E
 931+ 7D5E              .vertical:
 932+ 7D5E DD 7E 06         ld   a, (ix+6)         ; Direction (1=Up, 2=Down)
 933+ 7D61 FE 01            cp   1
 934+ 7D63 20 20            jr   nz, .vert_down
 935+ 7D65
 936+ 7D65              .vert_up:
 937+ 7D65 DD 7E 03         ld   a, (ix+3)         ; Current Y
 938+ 7D68 D6 02            sub  2                 ; Muovi in alto di 2 pixel
 939+ 7D6A DD BE 04         cp   (ix+4)            ; Min Limit (Top)
 940+ 7D6D 28 08            jr   z, .v_rev_down
 941+ 7D6F 38 06            jr   c, .v_rev_down
 942+ 7D71 DD 77 03         ld   (ix+3), a
 943+ 7D74 C3 A2 7D         jp   .next
 944+ 7D77
 945+ 7D77              .v_rev_down:
 946+ 7D77 DD 7E 04         ld   a, (ix+4)         ; Min Limit
 947+ 7D7A DD 77 03         ld   (ix+3), a
 948+ 7D7D 3E 02            ld   a, 2
 949+ 7D7F DD 77 06         ld   (ix+6), a         ; Cambia direzione in Basso
 950+ 7D82 C3 A2 7D         jp   .next
 951+ 7D85
 952+ 7D85              .vert_down:
 953+ 7D85 DD 7E 03         ld   a, (ix+3)         ; Current Y
 954+ 7D88 C6 02            add  a, 2              ; Muovi in basso di 2 pixel
 955+ 7D8A DD BE 05         cp   (ix+5)            ; Max Limit (Bottom)
 956+ 7D8D 28 08            jr   z, .v_rev_up
 957+ 7D8F 30 06            jr   nc, .v_rev_up
 958+ 7D91 DD 77 03         ld   (ix+3), a
 959+ 7D94 C3 A2 7D         jp   .next
 960+ 7D97
 961+ 7D97              .v_rev_up:
 962+ 7D97 DD 7E 05         ld   a, (ix+5)         ; Max Limit
 963+ 7D9A DD 77 03         ld   (ix+3), a
 964+ 7D9D 3E 01            ld   a, 1
 965+ 7D9F DD 77 06         ld   (ix+6), a         ; Cambia direzione in Alto
 966+ 7DA2
 967+ 7DA2              .next:
 968+ 7DA2 11 0B 00         ld   de, 11
 969+ 7DA5 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 970+ 7DA7 05               dec  b
 971+ 7DA8 C2 CB 7C         jp   nz, .loop
 972+ 7DAB
 973+ 7DAB DD E1            pop  ix
 974+ 7DAD C1               pop  bc
 975+ 7DAE D1               pop  de
 976+ 7DAF E1               pop  hl
 977+ 7DB0 C9               ret
