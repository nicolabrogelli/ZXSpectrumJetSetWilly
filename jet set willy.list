 504+ 7646              ; Riproduce un breve segnale acustico all'altoparlante
 505+ 7646              ; -------------------------------------------------------------------
 506+ 7646              PlayCollectSound:
 507+ 7646 C5               push bc
 508+ 7647 D5               push de
 509+ 7648
 510+ 7648 06 78            ld   b, 120            ; Cicli della nota
 511+ 764A              .sound_loop:
 512+ 764A 3A 14 77         ld   a, (room_border_color)
 513+ 764D F6 10            or   $10               ; Speaker ON (bit 4 = 1)
 514+ 764F D3 FE            out  ($fe), a
 515+ 7651 0E 3C            ld   c, 60             ; Mezzo periodo delay
 516+ 7653 0D           .d1: dec  c
 517+ 7654 20 FD            jr   nz, .d1
 518+ 7656
 519+ 7656 3A 14 77         ld   a, (room_border_color)
 520+ 7659 E6 EF            and  $ef               ; Speaker OFF (bit 4 = 0)
 521+ 765B D3 FE            out  ($fe), a
 522+ 765D 0E 3C            ld   c, 60             ; Mezzo periodo delay
 523+ 765F 0D           .d2: dec  c
 524+ 7660 20 FD            jr   nz, .d2
 525+ 7662
 526+ 7662 10 E6            djnz .sound_loop
 527+ 7664
 528+ 7664 D1               pop  de
 529+ 7665 C1               pop  bc
 530+ 7666 C9               ret
