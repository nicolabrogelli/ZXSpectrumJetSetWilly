   1+ 68F7              ;===========================================================================
   2+ 68F7              ; physics.asm
   3+ 68F7              ;===========================================================================
   4+ 68F7
   5+ 68F7
   6+ 68F7              ; -------------------------------------------------------------------
   7+ 68F7              ; Verifica se c'è una cella solida (Floor o Wall) alle coordinate pixel (X, Y)
   8+ 68F7              ; Input: C = X, B = Y
   9+ 68F7              ; Output: Carry flag impostato se solida, altrimenti resettato
  10+ 68F7              ; -------------------------------------------------------------------
  11+ 68F7              CheckSolidCell:
  12+ 68F7 E5               push hl
  13+ 68F8 D5               push de
  14+ 68F9 C5               push bc
  15+ 68FA
  16+ 68FA                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout (Y < 24 o Y >= 152)
  17+ 68FA 78               ld   a, b
  18+ 68FB FE 18            cp   24
  19+ 68FD 38 4E            jr   c, .not_solid
  20+ 68FF FE 98            cp   152
  21+ 6901 30 4A            jr   nc, .not_solid
  22+ 6903
  23+ 6903                  ; 2. Calcola riga di layout: r = (Y - 24) / 8
  24+ 6903 D6 18            sub  24
  25+ 6905 CB 3F            srl  a
  26+ 6907 CB 3F            srl  a
  27+ 6909 CB 3F            srl  a                 ; A = r (0..15)
  28+ 690B
  29+ 690B                  ; 3. HL = r * 8
  30+ 690B 6F               ld   l, a
  31+ 690C 26 00            ld   h, 0
  32+ 690E 29               add  hl, hl
  33+ 690F 29               add  hl, hl
  34+ 6910 29               add  hl, hl            ; HL = r * 8
  35+ 6911
  36+ 6911                  ; 4. Calcola colonna di layout: c = X / 8 (in C)
  37+ 6911 79               ld   a, c
  38+ 6912 CB 3F            srl  a
  39+ 6914 CB 3F            srl  a
  40+ 6916 CB 3F            srl  a                 ; A = c (0..31)
  41+ 6918 4F               ld   c, a              ; C = c (salva colonna)
  42+ 6919
  43+ 6919                  ; HL = r * 8 + c / 4
  44+ 6919 CB 3F            srl  a
  45+ 691B CB 3F            srl  a                 ; A = c / 4
  46+ 691D 85               add  a, l
  47+ 691E 6F               ld   l, a              ; HL = r * 8 + c / 4
  48+ 691F
  49+ 691F ED 5B 89 6E      ld   de, (room_ptr)
  50+ 6923 19               add  hl, de            ; HL = layout byte address
  51+ 6924 7E               ld   a, (hl)           ; A = layout byte
  52+ 6925
  53+ 6925                  ; Estrai il bit-pair corrispondente a c % 4
  54+ 6925 57               ld   d, a              ; D = layout byte
  55+ 6926 79               ld   a, c
  56+ 6927 E6 03            and  3                 ; A = c % 4
  57+ 6929 28 15            jr   z, .shift_0
  58+ 692B 3D               dec  a
  59+ 692C 28 0B            jr   z, .shift_1
  60+ 692E 3D               dec  a
  61+ 692F 28 03            jr   z, .shift_2
  62+ 6931                  ; Case 3 (c % 4 = 3)
  63+ 6931 7A               ld   a, d
  64+ 6932 18 0F            jr   .got_type
  65+ 6934              .shift_2:
  66+ 6934 7A               ld   a, d
  67+ 6935 0F               rrca
  68+ 6936 0F               rrca
  69+ 6937 18 0A            jr   .got_type
  70+ 6939              .shift_1:
  71+ 6939 7A               ld   a, d
  72+ 693A 0F               rrca
  73+ 693B 0F               rrca
  74+ 693C 0F               rrca
  75+ 693D 0F               rrca
  76+ 693E 18 03            jr   .got_type
  77+ 6940              .shift_0:
  78+ 6940 7A               ld   a, d
  79+ 6941 07               rlca
  80+ 6942 07               rlca
  81+ 6943              .got_type:
  82+ 6943 E6 03            and  3                 ; A = cell type (0..3)
  83+ 6945
  84+ 6945                  ; 5. Controlla se è solida: Floor (1) o Wall (2)
  85+ 6945 FE 01            cp   1
  86+ 6947 28 09            jr   z, .solid
  87+ 6949 FE 02            cp   2
  88+ 694B 28 05            jr   z, .solid
  89+ 694D
  90+ 694D              .not_solid:
  91+ 694D C1               pop  bc
  92+ 694E D1               pop  de
  93+ 694F E1               pop  hl
  94+ 6950 B7               or   a                 ; Clear carry
  95+ 6951 C9               ret
  96+ 6952
  97+ 6952              .solid:
  98+ 6952 C1               pop  bc
  99+ 6953 D1               pop  de
 100+ 6954 E1               pop  hl
 101+ 6955 37               scf                    ; Set carry
 102+ 6956 C9               ret
 103+ 6957
 104+ 6957              ; -------------------------------------------------------------------
 105+ 6957              ; Applica gravità e gestisce salto
 106+ 6957              ; -------------------------------------------------------------------
 107+ 6957              ApplyGravity:
 108+ 6957 ED 4B 77 6D      ld  bc, (PlayerPos)
 109+ 695B 78               ld  a, b              ; B = PlayerY (pixel)
 110+ 695C
 111+ 695C                  ; Controlla se siamo a mezz'aria (on_ground == 0)
 112+ 695C 3A 83 6D         ld  a, (on_ground)
 113+ 695F B7               or  a
 114+ 6960 CA 99 69         jp  z, .in_air        ; Se siamo in volo, continua a volare
 115+ 6963
 116+ 6963                  ; Se on_ground == 1, controlliamo se siamo ancora su terreno solido
 117+ 6963                  ; Dobbiamo controllare i pixel direttamente sotto i piedi del player:
 118+ 6963                  ; (PlayerX, PlayerY + 16) e (PlayerX + 7, PlayerY + 16)
 119+ 6963 78               ld  a, b
 120+ 6964 C6 10            add  a, 16
 121+ 6966 47               ld  b, a              ; B = PlayerY + 16
 122+ 6967
 123+ 6967                  ; Controlla se la cella sotto il piede sinistro (PlayerX, PlayerY + 16) è solida
 124+ 6967 CD F7 68         call CheckSolidCell
 125+ 696A 38 13            jr   c, .still_on_ground
 126+ 696C
 127+ 696C                  ; Controlla se la cella sotto il piede destro (PlayerX + 7, PlayerY + 16) è solida
 128+ 696C 79               ld   a, c
 129+ 696D C6 07            add  a, 7
 130+ 696F 4F               ld   c, a              ; C = PlayerX + 7
 131+ 6970 CD F7 68         call CheckSolidCell
 132+ 6973 38 0A            jr   c, .still_on_ground
 133+ 6975
 134+ 6975                  ; Se nessuna delle due è solida, iniziamo a cadere!
 135+ 6975 AF               xor  a
 136+ 6976 32 83 6D         ld   (on_ground), a
 137+ 6979 32 82 6D         ld   (velocity_y), a   ; Inizia la caduta con velocità 0
 138+ 697C C3 99 69         jp   .in_air
 139+ 697F
 140+ 697F              .still_on_ground:
 141+ 697F                  ; Siamo ancora sulla piattaforma o sul pavimento
 142+ 697F                  ; Ripristina bc originale (PlayerPos)
 143+ 697F ED 4B 77 6D      ld   bc, (PlayerPos)
 144+ 6983
 145+ 6983                  ; Gestisci il salto
 146+ 6983 3A 84 6D         ld   a, (jump_pressed)
 147+ 6986 B7               or   a
 148+ 6987 CA 24 6A         jp   z, .end
 149+ 698A
 150+ 698A 3E 0C            ld   a, JUMP_STRENGTH
 151+ 698C 32 82 6D         ld   (velocity_y), a
 152+ 698F AF               xor  a
 153+ 6990 32 83 6D         ld   (on_ground), a
 154+ 6993 32 84 6D         ld   (jump_pressed), a
 155+ 6996 C3 99 69         jp   .in_air
 156+ 6999
 157+ 6999              .in_air:
 158+ 6999                  ; Applica gravità
 159+ 6999 3A 82 6D         ld  a, (velocity_y)
 160+ 699C D6 02            sub GRAVITY           ; gravity = 2
 161+ 699E
 162+ 699E                  ; Controlla se positivo per evitare bug con cp signed
 163+ 699E CB 7F            bit 7, a
 164+ 69A0 28 06            jr  z, .store_vel
 165+ 69A2
 166+ 69A2 FE F4            cp  -MAX_FALL_SPEED   ; -12
 167+ 69A4 30 02            jr  nc, .store_vel
 168+ 69A6 3E F4            ld  a, -MAX_FALL_SPEED
 169+ 69A8
 170+ 69A8              .store_vel:
 171+ 69A8 32 82 6D         ld  (velocity_y), a
 172+ 69AB
 173+ 69AB                  ; Applica movimento verticale: PlayerY = PlayerY - velocity_y
 174+ 69AB ED 4B 77 6D      ld  bc, (PlayerPos)
 175+ 69AF 57               ld  d, a              ; D = velocity_y (signed)
 176+ 69B0 78               ld  a, b              ; A = PlayerY
 177+ 69B1 92               sub d                 ; A = PlayerY - velocity_y
 178+ 69B2 47               ld  b, a              ; B = new PlayerY
 179+ 69B3
 180+ 69B3                  ; Controlla se stiamo cadendo (velocity_y <= 0)
 181+ 69B3 3A 82 6D         ld  a, (velocity_y)
 182+ 69B6 CB 7F            bit 7, a              ; Se negativo, bit 7 = 1
 183+ 69B8 20 05            jr  nz, .falling_checks
 184+ 69BA B7               or  a                 ; Se zero
 185+ 69BB 28 02            jr  z, .falling_checks
