 331+ 6B6C 20 06            jr   nz, .not_floor
 332+ 6B6E 21 A9 00         ld   hl, OFFSET_FLOOR
 333+ 6B71 19               add  hl, de
 334+ 6B72 18 0D            jr   .draw_cell
