 804+ 79EF              ; Aggiorna le posizioni dei nemici attivi per il prossimo frame
 805+ 79EF              ; -------------------------------------------------------------------
 806+ 79EF              Enemy_Update:
 807+ 79EF E5               push hl
 808+ 79F0 D5               push de
 809+ 79F1 C5               push bc
 810+ 79F2 DD E5            push ix
 811+ 79F4
 812+ 79F4                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 813+ 79F4 3A 98 EA         ld   a, (enemy_update_rate)
 814+ 79F7 FE 01            cp   1
 815+ 79F9 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 816+ 79FB
 817+ 79FB 3A 99 EA         ld   a, (enemy_update_timer)
 818+ 79FE 3C               inc  a
 819+ 79FF 47               ld   b, a                      ; B = timer + 1
 820+ 7A00 3A 98 EA         ld   a, (enemy_update_rate)
 821+ 7A03 B8               cp   b
 822+ 7A04 28 0C            jr   z, .reset_timer
 823+ 7A06 38 0A            jr   c, .reset_timer
 824+ 7A08
 825+ 7A08                  ; Salva contatore incrementato e salta l'aggiornamento
 826+ 7A08 78               ld   a, b
 827+ 7A09 32 99 EA         ld   (enemy_update_timer), a
 828+ 7A0C
 829+ 7A0C              .skip_update:
 830+ 7A0C DD E1            pop  ix
 831+ 7A0E C1               pop  bc
 832+ 7A0F D1               pop  de
 833+ 7A10 E1               pop  hl
