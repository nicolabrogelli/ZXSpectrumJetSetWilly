  63+ 7009              ; DetermineCurrentRoomID
  64+ 7009              ;
  65+ 7009              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 7009              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 7009              ;
  68+ 7009              ; Se viene trovata una corrispondenza:
  69+ 7009              ;   A = ID della stanza
  70+ 7009              ;   current_room = A
  71+ 7009              ;
  72+ 7009              ; Mappatura:
  73+ 7009              ;    0 = The Off Licence
  74+ 7009              ;    1 = The Bridge
  75+ 7009              ;    2 = Under The Mega Tree
  76+ 7009              ;    3 = At The Foot Of The Mega Tree
  77+ 7009              ;    4 = The Drive
  78+ 7009              ;    5 = The Security Guard
  79+ 7009              ;    6 = Entrance To Hades
  80+ 7009              ;    7 = Cuckoo's Nest
