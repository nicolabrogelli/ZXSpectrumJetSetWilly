1281+ 6513                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1282+ 6513 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1283+ 6516 DD 21 62 D1      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1284+ 651A CD 3F 5E         call Gfx_DrawPixelSprite8x8
