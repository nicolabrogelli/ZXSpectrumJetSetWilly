 861+ 6ABE 3A C0 78         ld   a, (ramp_len)
 862+ 6AC1 80               add  a, b              ; A = ramp_col + ramp_len
 863+ 6AC2 4F               ld   c, a              ; C = limit_right (exclusive)
 864+ 6AC3
 865+ 6AC3 7B               ld   a, e              ; A = Col
 866+ 6AC4 B8               cp   b
 867+ 6AC5 38 34            jr   c, .check_platform_case ; Col < ramp_col
 868+ 6AC7 B9               cp   c
 869+ 6AC8 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 870+ 6ACA
 871+ 6ACA                  ; Calcola B = Col - ramp_col
 872+ 6ACA 7B               ld   a, e
 873+ 6ACB 90               sub  b
 874+ 6ACC 47               ld   b, a              ; B = offset (0..ramp_len-1)
 875+ 6ACD
 876+ 6ACD                  ; SlopeRow = ramp_row - B
 877+ 6ACD 3A C1 78         ld   a, (ramp_row)
