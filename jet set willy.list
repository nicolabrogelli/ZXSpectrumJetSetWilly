2019+ 87B0              ; CheckActiveItemAtCell
2020+ 87B0              ;
2021+ 87B0              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2022+ 87B0              ; nella cella specificata della griglia items_grid.
2023+ 87B0              ;
2024+ 87B0              ; Questa routine usa una lookup diretta su una mappa 32x16,
2025+ 87B0              ; evitando la scansione della ItemsTable.
2026+ 87B0              ;
2027+ 87B0              ; Input:
2028+ 87B0              ;   B = Colonna (0..31)
2029+ 87B0              ;   C = Riga (0..15)
2030+ 87B0              ;
2031+ 87B0              ; Output:
2032+ 87B0              ;   Carry Set   = item presente nella cella
2033+ 87B0              ;   Carry Clear = nessun item
2034+ 87B0              ;
2035+ 87B0              ; Nota:
2036+ 87B0              ;   HL NON è restituito valido (commento originale non corretto:
2037+ 87B0              ;   la routine non punta a ItemsTable).
2038+ 87B0              ; -------------------------------------------------------------------
2039+ 87B0              CheckActiveItemAtCell:
2040+ 87B0
2041+ 87B0                  ; Salva registri usati
2042+ 87B0 D5               push de
2043+ 87B1 E5               push hl
2044+ 87B2
2045+ 87B2                  ; ---------------------------------------------------------------
2046+ 87B2                  ; Calcolo indice lineare nella griglia 32x16:
2047+ 87B2                  ;
2048+ 87B2                  ; offset = Row * 32 + Col
2049+ 87B2                  ; ---------------------------------------------------------------
2050+ 87B2 26 00            ld   h, 0
2051+ 87B4 69               ld   l, c              ; HL = Row
2052+ 87B5
2053+ 87B5 29               add  hl, hl            ; *2
2054+ 87B6 29               add  hl, hl            ; *4
2055+ 87B7 29               add  hl, hl            ; *8
2056+ 87B8 29               add  hl, hl            ; *16
2057+ 87B9 29               add  hl, hl            ; *32
2058+ 87BA
2059+ 87BA                  ; Aggiunge la colonna
2060+ 87BA 58               ld   e, b
2061+ 87BB 16 00            ld   d, 0
2062+ 87BD 19               add  hl, de            ; HL = Row*32 + Col
2063+ 87BE
2064+ 87BE                  ; ---------------------------------------------------------------
2065+ 87BE                  ; Accesso alla griglia degli item attivi
2066+ 87BE                  ; ---------------------------------------------------------------
2067+ 87BE 11 2F F1         ld   de, items_grid
2068+ 87C1 19               add  hl, de            ; HL = address cella
2069+ 87C2
2070+ 87C2                  ; ---------------------------------------------------------------
2071+ 87C2                  ; Controllo presenza item
2072+ 87C2                  ;
2073+ 87C2                  ; items_grid contiene:
2074+ 87C2                  ;   0 = nessun item
2075+ 87C2                  ;   >0 = item attivo (colore o flag)
2076+ 87C2                  ; ---------------------------------------------------------------
2077+ 87C2 7E               ld   a, (hl)
2078+ 87C3 B7               or   a
2079+ 87C4 28 04            jr   z, .not_active
2080+ 87C6
2081+ 87C6                  ; ---------------------------------------------------------------
2082+ 87C6                  ; Item trovato
2083+ 87C6                  ; ---------------------------------------------------------------
2084+ 87C6 E1               pop  hl
2085+ 87C7 D1               pop  de
2086+ 87C8
2087+ 87C8 37               scf                    ; Carry = 1
2088+ 87C9 C9               ret
2089+ 87CA
2090+ 87CA              .not_active:
2091+ 87CA
2092+ 87CA                  ; ---------------------------------------------------------------
2093+ 87CA                  ; Nessun item nella cella
2094+ 87CA                  ; ---------------------------------------------------------------
2095+ 87CA E1               pop  hl
2096+ 87CB D1               pop  de
2097+ 87CC
2098+ 87CC B7               or   a                 ; Carry = 0
2099+ 87CD C9               ret
