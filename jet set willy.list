 60   6BF1 AF               xor  a
 61   6BF2 32 97 6C         ld   (egg_body_state), a
 62   6BF5 3E 02            ld   a, 2              ; Inizia verso destra
 63   6BF7 32 98 6C         ld   (egg_direction), a
 64   6BFA CD 16 6B         call PrintEgg
 65   6BFD
 66   6BFD                  ; Inizializza Robot
 67   6BFD AF               xor  a
 68   6BFE 32 99 6C         ld   (robot_body_state), a
 69   6C01 3E 02            ld   a, 2              ; Inizia verso destra
 70   6C03 32 9A 6C         ld   (robot_direction), a
 71   6C06 CD 8D 6B         call PrintRobot
 72   6C09
 73   6C09                  ;call DrawVerticalBorders
 74   6C09 CD 5D 5F         call PrintPlayer
 75   6C0C
 76   6C0C              Main_loop:
 77   6C0C 76               halt
 78   6C0D 76               halt
 79   6C0E
 80   6C0E                  ; 1. Cancella i personaggi alle vecchie posizioni
 81   6C0E CD B0 5F         call DeleteCharAtOldPos
 82   6C11 CD C9 6A         call DeleteEnemyAtOldPos
 83   6C14 CD 40 6B         call DeleteEggAtOldPos
 84   6C17 CD AA 6B         call DeleteRobotAtOldPos
 85   6C1A
 86   6C1A CD 30 68         call CheckCtrl
 87   6C1D
 88   6C1D                  ; 2. Aggiorna le posizioni dei personaggi
 89   6C1D CD EA 67         call MovePlayer
 90   6C20 CD 8D 68         call ApplyGravity
 91   6C23 CD 5A 6A         call MoveEnemy
 92   6C26 CD D1 6A         call MoveEgg
 93   6C29 CD 48 6B         call MoveRobot
 94   6C2C
 95   6C2C                  ; 3. Salva le nuove posizioni per la cancellazione al prossimo frame
 96   6C2C ED 4B 7E 6C      ld   bc, (PlayerPos)
 97   6C30 ED 43 80 6C      ld   (PlayerPosOld), bc
 98   6C34 ED 4B 84 6C      ld   bc, (EnemyPos)
 99   6C38 ED 43 86 6C      ld   (EnemyPosOld), bc
100   6C3C ED 4B 88 6C      ld   bc, (EggPos)
101   6C40 ED 43 8A 6C      ld   (EggPosOld), bc
102   6C44 ED 4B 8C 6C      ld   bc, (RobotPos)
103   6C48 ED 43 8E 6C      ld   (RobotPosOld), bc
104   6C4C
105   6C4C                  ; 4. Disegna i personaggi alle nuove posizioni
106   6C4C CD 5D 5F         call PrintPlayer
107   6C4F CD 9F 6A         call PrintEnemy
108   6C52 CD 16 6B         call PrintEgg
109   6C55 CD 8D 6B         call PrintRobot
110   6C58 CD C1 60         call DrawPlatform
111   6C5B
112   6C5B                  ; 5. Gestisci la collisione (disegna le raster bar se collide)
113   6C5B CD 6C 69         call CheckCollision
114   6C5E 30 18            jr   nc, .no_collision
115   6C60
116   6C60                  ; Collisione attiva: disegna le raster bar nel bordo
117   6C60 3A 9F 6C         ld   a, (counter)
118   6C63 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
119   6C65 06 1E            ld   b, 30             ; Numero di righe della barra raster
120   6C67              .raster_loop:
121   6C67 D3 FE            out  ($fe), a
122   6C69 3C               inc  a
123   6C6A E6 07            and  7
124   6C6C 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
125   6C6E              .delay:
126   6C6E 0D               dec  c
127   6C6F 20 FD            jr   nz, .delay
128   6C71 10 F4            djnz .raster_loop
129   6C73
130   6C73                  ; Ripristina il bordo a nero dopo il disegno delle barre
131   6C73 AF               xor  a
132   6C74 D3 FE            out  ($fe), a
133   6C76 18 03            jr   .no_collision_change
134   6C78
135   6C78              .no_collision:
136   6C78                  ; Nessuna collisione: mantieni il bordo nero
137   6C78 AF               xor  a
138   6C79 D3 FE            out  ($fe), a
139   6C7B
140   6C7B              .no_collision_change:
141   6C7B C3 0C 6C         jp   Main_loop
