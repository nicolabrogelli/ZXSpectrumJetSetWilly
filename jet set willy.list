 770+ 6128 D5               push de
 771+ 6129 E5               push hl
 772+ 612A
 773+ 612A                  ; 1. Calcola indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
 774+ 612A                  ; HighByte = $40 + (B & $18)
 775+ 612A 78               ld   a, b
 776+ 612B E6 18            and  $18
 777+ 612D C6 40            add  a, $40
 778+ 612F 67               ld   h, a              ; H = High byte
 779+ 6130
 780+ 6130                  ; LowByte = ((B & 7) * 32) + C
 781+ 6130 78               ld   a, b
