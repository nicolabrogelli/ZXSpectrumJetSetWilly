  71+ 75F8              ; Audio_UpdateMusic
  72+ 75F8              ;
  73+ 75F8              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 75F8              ; Viene chiamata a ogni frame.
  75+ 75F8              ; -------------------------------------------------------------------
  76+ 75F8              Audio_UpdateMusic:
  77+ 75F8 F5               push af
  78+ 75F9 C5               push bc
  79+ 75FA D5               push de
  80+ 75FB E5               push hl
  81+ 75FC
  82+ 75FC                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 75FC 3A 43 7A         ld   a, (Audio_jump_sound_note)
  84+ 75FF FE 12            cp   18
  85+ 7601 38 5A            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 7603
  87+ 7603                  ; Decrementa il contatore dei frame della nota corrente
  88+ 7603 3A 46 7A         ld   a, (Audio_music_frame_counter)
  89+ 7606 3D               dec  a
  90+ 7607 32 46 7A         ld   (Audio_music_frame_counter), a
  91+ 760A 20 23            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 760C
  93+ 760C                  ; Altrimenti carica la nota successiva
  94+ 760C 3A 45 7A         ld   a, (Audio_music_note_idx)
  95+ 760F 3C               inc  a
  96+ 7610 FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 7612 38 01            jr   c, .no_wrap
  98+ 7614 AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 7615              .no_wrap:
 100+ 7615 32 45 7A         ld   (Audio_music_note_idx), a
 101+ 7618
 102+ 7618                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 7618 5F               ld   e, a
 104+ 7619 16 00            ld   d, 0
 105+ 761B 21 62 76         ld   hl, Audio_MusicSheet
 106+ 761E 19               add  hl, de
 107+ 761F 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 7620
 109+ 7620                  ; Leggi durata (secondo byte)
 110+ 7620 23               inc  hl
 111+ 7621 7E               ld   a, (hl)
 112+ 7622 CB 3F            srl  a                        ; Divide per 8 (velocizza 8x)
 113+ 7624 CB 3F            srl  a
 114+ 7626 CB 3F            srl  a
 115+ 7628 20 02            jr   nz, .dur_ok
 116+ 762A 3E 01            ld   a, 1
 117+ 762C              .dur_ok:
 118+ 762C 32 46 7A         ld   (Audio_music_frame_counter), a
