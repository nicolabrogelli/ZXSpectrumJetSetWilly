  41+ 7ADD 2A BA FA         ld   hl, (room_ptr)
  42+ 7AE0 11 F0 00         ld   de, 240           ; Offset degli enemy nella stanza
  43+ 7AE3 19               add  hl, de            ; HL = indirizzo di RoomXEnemy1
  44+ 7AE4
