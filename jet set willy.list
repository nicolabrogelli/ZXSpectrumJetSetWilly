1251+ 79AE              ; -------------------------------------------------------------------
1252+ 79AE              ; CheckWillyItemCollision
1253+ 79AE              ;
1254+ 79AE              ; Verifica se Willy collide con un item utilizzando il controllo
1255+ 79AE              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1256+ 79AE              ;
1257+ 79AE              ; Input:
1258+ 79AE              ;   A = ItemX (colonna attributi 0..31)
1259+ 79AE              ;   H = ItemY (riga attributi 3..18)
1260+ 79AE              ;
1261+ 79AE              ; Coordinate item:
1262+ 79AE              ;   Ogni item occupa una cella da 8x8 pixel.
1263+ 79AE              ;
1264+ 79AE              ; Coordinate Willy:
1265+ 79AE              ;   Willy occupa un rettangolo di 16x16 pixel.
1266+ 79AE              ;
1267+ 79AE              ; Output:
1268+ 79AE              ;   Carry Set   = collisione rilevata
1269+ 79AE              ;   Carry Clear = nessuna collisione
1270+ 79AE              ;
1271+ 79AE              ; Registri preservati:
1272+ 79AE              ;   BC, DE, HL
1273+ 79AE              ; -------------------------------------------------------------------
1274+ 79AE              CheckWillyItemCollision:
1275+ 79AE
1276+ 79AE                  ; Salva i registri utilizzati
1277+ 79AE C5               push bc
1278+ 79AF D5               push de
1279+ 79B0 E5               push hl
1280+ 79B1
1281+ 79B1                  ; ---------------------------------------------------------------
1282+ 79B1                  ; Calcola il bounding box orizzontale dell'item
1283+ 79B1                  ;
1284+ 79B1                  ; ItemLeft  = ItemX * 8
1285+ 79B1                  ; ItemRight = ItemLeft + 7
1286+ 79B1                  ;
1287+ 79B1                  ; E = ItemLeft
1288+ 79B1                  ; D = ItemRight
1289+ 79B1                  ; ---------------------------------------------------------------
1290+ 79B1 6F               ld   l, a              ; L = ItemX
1291+ 79B2
1292+ 79B2 7D               ld   a, l
1293+ 79B3 87               add  a, a              ; *2
1294+ 79B4 87               add  a, a              ; *4
1295+ 79B5 87               add  a, a              ; *8
1296+ 79B6
1297+ 79B6 5F               ld   e, a              ; E = ItemLeft
1298+ 79B7
1299+ 79B7 C6 07            add  a, 7
1300+ 79B9 57               ld   d, a              ; D = ItemRight
1301+ 79BA
1302+ 79BA                  ; ---------------------------------------------------------------
1303+ 79BA                  ; Recupera la posizione corrente di Willy
1304+ 79BA                  ;
1305+ 79BA                  ; B = WillyY
1306+ 79BA                  ; C = WillyX
1307+ 79BA                  ; ---------------------------------------------------------------
1308+ 79BA ED 4B DC 7A      ld   bc, (PlayerPos)
1309+ 79BE
1310+ 79BE                  ; ---------------------------------------------------------------
1311+ 79BE                  ; Primo test:
1312+ 79BE                  ;
1313+ 79BE                  ; WillyLeft <= ItemRight
1314+ 79BE                  ;
1315+ 79BE                  ; Se Willy è completamente a destra dell'item
1316+ 79BE                  ; non può esserci collisione.
1317+ 79BE                  ; ---------------------------------------------------------------
1318+ 79BE 79               ld   a, c              ; A = WillyLeft
1319+ 79BF
1320+ 79BF BA               cp   d                 ; WillyLeft vs ItemRight
1321+ 79C0
1322+ 79C0 28 04            jr   z, .x_ok
1323+ 79C2 38 02            jr   c, .x_ok
1324+ 79C4
1325+ 79C4 18 29            jr   .no_collision
1326+ 79C6
1327+ 79C6              .x_ok:
1328+ 79C6
1329+ 79C6                  ; ---------------------------------------------------------------
1330+ 79C6                  ; Secondo test:
1331+ 79C6                  ;
1332+ 79C6                  ; WillyRight >= ItemLeft
1333+ 79C6                  ;
1334+ 79C6                  ; WillyRight = WillyX + 7
1335+ 79C6                  ; ---------------------------------------------------------------
1336+ 79C6 C6 07            add  a, 7
1337+ 79C8
1338+ 79C8 BB               cp   e                 ; WillyRight vs ItemLeft
1339+ 79C9
1340+ 79C9 28 04            jr   z, .y_check
1341+ 79CB 30 02            jr   nc, .y_check
1342+ 79CD
1343+ 79CD 18 20            jr   .no_collision
1344+ 79CF
1345+ 79CF              .y_check:
1346+ 79CF
1347+ 79CF                  ; ---------------------------------------------------------------
1348+ 79CF                  ; Recupera ItemY dal valore originale di HL
1349+ 79CF                  ;
1350+ 79CF                  ; H contiene la riga dell'item.
1351+ 79CF                  ; ---------------------------------------------------------------
1352+ 79CF E1               pop  hl
1353+ 79D0 E5               push hl
1354+ 79D1
1355+ 79D1                  ; ---------------------------------------------------------------
1356+ 79D1                  ; Calcola il bounding box verticale dell'item
1357+ 79D1                  ;
1358+ 79D1                  ; ItemTop    = ItemY * 8
1359+ 79D1                  ; ItemBottom = ItemTop + 7
1360+ 79D1                  ;
1361+ 79D1                  ; E = ItemTop
1362+ 79D1                  ; D = ItemBottom
1363+ 79D1                  ; ---------------------------------------------------------------
1364+ 79D1 7C               ld   a, h
1365+ 79D2
1366+ 79D2 87               add  a, a              ; *2
1367+ 79D3 87               add  a, a              ; *4
1368+ 79D4 87               add  a, a              ; *8
1369+ 79D5
1370+ 79D5 5F               ld   e, a              ; ItemTop
1371+ 79D6
1372+ 79D6 C6 07            add  a, 7
1373+ 79D8 57               ld   d, a              ; ItemBottom
1374+ 79D9
1375+ 79D9                  ; ---------------------------------------------------------------
1376+ 79D9                  ; Primo test verticale:
1377+ 79D9                  ;
1378+ 79D9                  ; WillyTop <= ItemBottom
1379+ 79D9                  ; ---------------------------------------------------------------
1380+ 79D9 78               ld   a, b              ; WillyTop
1381+ 79DA
1382+ 79DA BA               cp   d
1383+ 79DB
1384+ 79DB 28 04            jr   z, .y_ok
1385+ 79DD 38 02            jr   c, .y_ok
1386+ 79DF
1387+ 79DF 18 0E            jr   .no_collision
1388+ 79E1
1389+ 79E1              .y_ok:
1390+ 79E1
1391+ 79E1                  ; ---------------------------------------------------------------
1392+ 79E1                  ; Secondo test verticale:
1393+ 79E1                  ;
1394+ 79E1                  ; WillyBottom >= ItemTop
1395+ 79E1                  ;
1396+ 79E1                  ; WillyBottom = WillyY + 15
1397+ 79E1                  ; ---------------------------------------------------------------
1398+ 79E1 C6 0F            add  a, 15
1399+ 79E3
1400+ 79E3 BB               cp   e
1401+ 79E4
1402+ 79E4 28 04            jr   z, .collision
1403+ 79E6 30 02            jr   nc, .collision
1404+ 79E8
1405+ 79E8 18 05            jr   .no_collision
1406+ 79EA
1407+ 79EA              .collision:
1408+ 79EA
1409+ 79EA                  ; ---------------------------------------------------------------
1410+ 79EA                  ; Collisione rilevata
1411+ 79EA                  ; ---------------------------------------------------------------
1412+ 79EA E1               pop  hl
1413+ 79EB D1               pop  de
1414+ 79EC C1               pop  bc
1415+ 79ED
1416+ 79ED 37               scf                    ; Carry = 1
1417+ 79EE
1418+ 79EE C9               ret
1419+ 79EF
1420+ 79EF              .no_collision:
1421+ 79EF
1422+ 79EF                  ; ---------------------------------------------------------------
1423+ 79EF                  ; Nessuna collisione
1424+ 79EF                  ; ---------------------------------------------------------------
1425+ 79EF E1               pop  hl
1426+ 79F0 D1               pop  de
1427+ 79F1 C1               pop  bc
1428+ 79F2
1429+ 79F2 B7               or   a                 ; Carry = 0
1430+ 79F3
1431+ 79F3 C9               ret
