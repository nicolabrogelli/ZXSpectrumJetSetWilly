 782+ 7D14                  ; Disegna alla coordinata corrente
 783+ 7D14 DD 4E 02         ld   c, (ix+2)         ; C = Current X (Offset 2)
 784+ 7D17 DD 46 03         ld   b, (ix+3)         ; B = Current Y (Offset 3)
 785+ 7D1A
 786+ 7D1A DD E5            push ix                ; Salva slot pointer
