 355  8B68
 356  8B68                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 357  8B68 AF               xor  a
 358  8B69 D3 FE            out  ($fe), a              ; Bordo a nero
 359  8B6B 21 8D 5C         ld   hl, ATTR_P
 360  8B6E 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 361  8B6F CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 362  8B72 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 363  8B74 3E 07            ld   a, $07
 364  8B76 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
