 381+ 5F71
 382+ 5F71                  ; Esegui lo shift a destra se necessario
 383+ 5F71 3A 71 76         ld   a, (sprite_shift)
 384+ 5F74 B7               or   a
 385+ 5F75 28 1C            jr   z, .no_shift
