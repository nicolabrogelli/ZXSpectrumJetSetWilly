1263+ 84EB 73               ld   (hl), e           ; salva colore cella
1264+ 84EC
1265+ 84EC E1               pop  hl
1266+ 84ED
1267+ 84ED                  ; ---------------------------------------------------------------
1268+ 84ED                  ; Salva l'item nella cache della stanza
