1262+ 6CD5
1263+ 6CD5 3A 42 7D         ld   a, (ramp_row)
1264+ 6CD8 21 41 7D         ld   hl, ramp_len
1265+ 6CDB 96               sub  (hl)
1266+ 6CDC 3C               inc  a                 ; A = Row
1267+ 6CDD 87               add  a, a              ; *2
1268+ 6CDE 87               add  a, a              ; *4
1269+ 6CDF 87               add  a, a              ; *8
