 195+ 8828              .d1:
 196+ 8828 0D               dec  c
 197+ 8829 20 FD            jr   nz, .d1
 198+ 882B
 199+ 882B 3A 3B F3         ld   a, (room_border_color)
 200+ 882E E6 EF            and  $ef              ; speaker OFF
 201+ 8830 D3 FE            out  ($fe), a
 202+ 8832
 203+ 8832 0E 3C            ld   c, 60
 204+ 8834              .d2:
 205+ 8834 0D               dec  c
 206+ 8835 20 FD            jr   nz, .d2
 207+ 8837
 208+ 8837 10 E6            djnz .sound_loop
 209+ 8839
 210+ 8839 D1               pop  de
 211+ 883A C1               pop  bc
 212+ 883B C9               ret
