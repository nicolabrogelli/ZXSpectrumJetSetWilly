   6+ 6D1F              ; MovePlayer
   7+ 6D1F              ;
   8+ 6D1F              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6D1F              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6D1F              ; con i muri.
  11+ 6D1F              ;
  12+ 6D1F              ; Input:
  13+ 6D1F              ;   D = stato dei controlli (bitfield)
  14+ 6D1F              ;
  15+ 6D1F              ; Strutture utilizzate:
  16+ 6D1F              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6D1F              ;   player_speed    -> velocità orizzontale
  18+ 6D1F              ;   flags           -> flag di stato input
  19+ 6D1F              ;
  20+ 6D1F              ; Bit controlli:
  21+ 6D1F              ;   bit 0 = sinistra
  22+ 6D1F              ;   bit 1 = destra
  23+ 6D1F              ;
  24+ 6D1F              ; Nota:
  25+ 6D1F              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6D1F              ;   ignorato per tutta la durata del salto.
  27+ 6D1F              ;
  28+ 6D1F              ; Output:
  29+ 6D1F              ;   aggiorna PlayerPos e body_state
  30+ 6D1F              ; -------------------------------------------------------------------
  31+ 6D1F              MovePlayer:
  32+ 6D1F
  33+ 6D1F                  ; ---------------------------------------------------------------
  34+ 6D1F                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6D1F                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6D1F                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6D1F                  ; ---------------------------------------------------------------
  38+ 6D1F 3A 53 F8         ld   a, (on_ground)
  39+ 6D22 B7               or   a
  40+ 6D23 20 1A            jr   nz, .on_ground_check
  41+ 6D25
  42+ 6D25 3A 58 F8         ld   a, (jump_dir)
  43+ 6D28 B7               or   a
  44+ 6D29 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6D2A
  46+ 6D2A                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6D2A DD 21 4C F8      ld   ix, flags
  48+ 6D2E DD CB 00 86      res  $00, (ix)
  49+ 6D32
  50+ 6D32 ED 4B 44 F8      ld   bc, (PlayerPos)
