 860+ 789B 20 3E            jr   nz, .next_no_inc
 861+ 789D
 862+ 789D                  ; ---------------------------------------------------------------
 863+ 789D                  ; Disegna l'item sullo schermo
 864+ 789D                  ;
 865+ 789D                  ; B = Row
 866+ 789D                  ; C = Column
 867+ 789D                  ; HL = bitmap pointer
 868+ 789D                  ; E = Color
