 255+ 6BA9 ED 4B 52 6F      ld   bc, (PlayerPos)
 256+ 6BAD 78               ld   a, b
 257+ 6BAE 92               sub  d                 ; A = Nuovo Y (calcolato in .store_vel)
 258+ 6BAF 47               ld   b, a              ; B = Nuovo Y
