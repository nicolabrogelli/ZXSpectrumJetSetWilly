  71+ 8881              ; -------------------------------------------------------------------
  72+ 8881              ; Audio_UpdateMusic
  73+ 8881              ;
  74+ 8881              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8881              ; Riproduce "If I Were a Rich Man" fedele alla routine originale di Jet Set Willy:
  76+ 8881              ; - Tabella di 64 note (128 burst per ciclo completo)
  77+ 8881              ; - Cadenza temporizzata a 2 frame per burst (80ms) per rispettare il tempo reale
  78+ 8881              ; - Generazione tono con ciclo beeper originale (768 passaggi)
  79+ 8881              ; - Variazione dinamica dell'intonazione in base alle vite rimaste
  80+ 8881              ; -------------------------------------------------------------------
  81+ 8881              Audio_UpdateMusic:
  82+ 8881 F5               push af
  83+ 8882 C5               push bc
  84+ 8883 D5               push de
  85+ 8884 E5               push hl
  86+ 8885
  87+ 8885                  ; Gestione del tempo (suona 1 burst ogni 2 frame = 80ms per frame rate a 25FPS)
  88+ 8885 3A 50 FB         ld   a, (Audio_music_frame_counter)
  89+ 8888 3D               dec  a
  90+ 8889 32 50 FB         ld   (Audio_music_frame_counter), a
  91+ 888C 20 45            jr   nz, .done
  92+ 888E
  93+ 888E 3E 02            ld   a, 2                     ; Reimposta contatore a 2 frame
  94+ 8890 32 50 FB         ld   (Audio_music_frame_counter), a
  95+ 8893
  96+ 8893                  ; Incrementa l'indice delle note (0..127) e calcola l'offset nota (0..63)
  97+ 8893 3A 4F FB         ld   a, (Audio_music_note_idx)
  98+ 8896 3C               inc  a
  99+ 8897 32 4F FB         ld   (Audio_music_note_idx), a
 100+ 889A E6 7E            and  126                      ; Maschera bit 1..6 (2 burst per nota)
 101+ 889C 0F               rrca                          ; A = indice nota nella tabella (0..63)
 102+ 889D 5F               ld   e, a
 103+ 889E 16 00            ld   d, 0
 104+ 88A0 21 D8 88         ld   hl, Audio_MusicTune
 105+ 88A3 19               add  hl, de
 106+ 88A4
 107+ 88A4                  ; Variazione di intonazione in base alle vite rimaste (come nell'originale)
 108+ 88A4 3A 47 F7         ld   a, (willy_lives)         ; Vite di Willy (0..7)
 109+ 88A7 FE 08            cp   8
 110+ 88A9 38 02            jr   c, .lives_ok
 111+ 88AB 3E 07            ld   a, 7
 112+ 88AD              .lives_ok:
 113+ 88AD 07               rlca
 114+ 88AE 07               rlca
 115+ 88AF D6 1C            sub  28
 116+ 88B1 ED 44            neg                           ; A = 28 - (willy_lives * 4) -> 0 a 7 vite
 117+ 88B3 86               add  a, (hl)                  ; A = ritardo tono base + offset vite
 118+ 88B4 57               ld   d, a                     ; D = periodo semionda
 119+ 88B5
 120+ 88B5                  ; Generazione del tono con il beeper (768 passaggi identici all'originale)
 121+ 88B5 3A 46 F7         ld   a, (room_border_color)
 122+ 88B8 E6 07            and  $07                      ; Mantiene i bit del bordo hardware puliti
 123+ 88BA 5A               ld   e, d                     ; E = contatore semionda
 124+ 88BB 06 00            ld   b, 0                     ; B = 0 (256 iterazioni djnz)
 125+ 88BD 0E 03            ld   c, 3                     ; C = 3 (3 * 256 = 768 passaggi totali, ~8.7ms)
 126+ 88BF              .tone_loop:
 127+ 88BF D3 FE            out  ($fe), a                 ; 11 T-states
 128+ 88C1 1D               dec  e                        ; 4 T-states
 129+ 88C2 20 03            jr   nz, .no_toggle           ; 12 T-states
 130+ 88C4 5A               ld   e, d                     ; 4 T-states
 131+ 88C5 EE 18            xor  $18                      ; 7 T-states (toggle EAR bit 4 e MIC bit 3)
 132+ 88C7              .no_toggle:
 133+ 88C7 10 F6            djnz .tone_loop               ; 13 T-states
 134+ 88C9 0D               dec  c                        ; 4 T-states
 135+ 88CA 20 F3            jr   nz, .tone_loop           ; 12 T-states
 136+ 88CC
 137+ 88CC                  ; Ripristina speaker OFF mantenendo il colore del bordo
 138+ 88CC 3A 46 F7         ld   a, (room_border_color)
 139+ 88CF E6 07            and  $07
 140+ 88D1 D3 FE            out  ($fe), a
 141+ 88D3
 142+ 88D3              .done:
 143+ 88D3 E1               pop  hl
 144+ 88D4 D1               pop  de
 145+ 88D5 C1               pop  bc
 146+ 88D6 F1               pop  af
 147+ 88D7 C9               ret
 148+ 88D8
 149+ 88D8              Audio_MusicTune:
 150+ 88D8                  ; Spartito originale in-game "If I Were a Rich Man" (64 note)
 151+ 88D8 56 60 56 60      db 86, 96, 86, 96, 102, 102, 128, 128, 128, 128, 102, 96, 86, 96, 86, 96
 151+ 88DC 66 66 80 80
 151+ 88E0 80 80 66 60
 151+ 88E4 56 60 56 60
 152+ 88E8 66 60 56 4C      db 102, 96, 86, 76,  72,  76,  72,  76,  86,  86,  86,  86, 86, 86, 86, 86
 152+ 88EC 48 4C 48 4C
 152+ 88F0 56 56 56 56
 152+ 88F4 56 56 56 56
 153+ 88F8 40 40 40 40      db  64, 64, 64, 64,  68,  68,  76,  76,  86,  96, 102,  96, 86, 86, 102, 102
 153+ 88FC 44 44 4C 4C
 153+ 8900 56 60 66 60
 153+ 8904 56 56 66 66
 154+ 8908 51 56 60 56      db  81, 86, 96, 86,  81,  81,  96,  96,  64,  64,  64,  64, 64, 64, 64, 64
 154+ 890C 51 51 60 60
 154+ 8910 40 40 40 40
 154+ 8914 40 40 40 40
 155+ 8918                  ELSE
 156+ 8918 ~            Audio_UpdateMusic:
 157+ 8918 ~                ret
 158+ 8918                  ENDIF
