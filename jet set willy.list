1187+ 6C8B 11 3B 7B         ld   de, unpacked_layout
1188+ 6C8E 19               add  hl, de
1189+ 6C8F 7E               ld   a, (hl)           ; A = cell type
1190+ 6C90
1191+ 6C90 D1               pop  de
1192+ 6C91 E1               pop  hl
