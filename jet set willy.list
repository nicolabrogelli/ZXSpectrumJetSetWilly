 190  8152              .no_lives_dec:
 191  8152
 192  8152                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 193  8152 AF               xor  a
 194  8153 D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 195  8155 21 8D 5C         ld   hl, ATTR_P
 196  8158 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 197  8159 CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 198  815C
 199  815C                  ; 3. Pausa a schermo nero (~0.5 secondi)
 200  815C 06 19            ld   b, 25
 201  815E              .death_pause:
 202  815E 76               halt
 203  815F 10 FD            djnz .death_pause
 204  8161
 205  8161                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 206  8161 AF               xor  a
 207  8162 32 34 E6         ld   (velocity_y), a
 208  8165 32 36 E6         ld   (jump_pressed), a
 209  8168 32 38 E6         ld   (coyote_timer), a
 210  816B 32 3B E6         ld   (jump_frame), a
 211  816E 32 3A E6         ld   (jump_dir), a
 212  8171 3E 01            ld   a, 1
 213  8173 32 35 E6         ld   (on_ground), a
 214  8176
 215  8176 3E 32            ld   a, RESPAWN_SAFETY_TIME
 216  8178 32 B6 E9         ld   (willy_safety_timer), a
 217  817B
 218  817B                  ; 5. Ridisegna completamente la stanza e riposiziona Willy
 219  817B C3 B6 80         jp   LoadRoomAndRestart
