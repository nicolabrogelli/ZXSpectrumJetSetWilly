  89+ 6551 5F               ld   e, a
  90+ 6552
  91+ 6552 79               ld   a, c
  92+ 6553 93               sub  e
  93+ 6554
  94+ 6554                  ; Controllo limite sinistro schermo
  95+ 6554 FE 05            cp   PLAYER_MIN_X
  96+ 6556 38 11            jr   c, .clamp_left
