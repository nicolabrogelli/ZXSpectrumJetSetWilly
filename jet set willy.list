 184+ 7C5B              ; -------------------------------------------------------------------
 185+ 7C5B              ; DetermineCurrentRoomID
 186+ 7C5B              ;
 187+ 7C5B              ; Determina l'ID numerico della stanza corrente confrontando
 188+ 7C5B              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 189+ 7C5B              ;
 190+ 7C5B              ; Se viene trovata una corrispondenza:
 191+ 7C5B              ;   A = ID della stanza
 192+ 7C5B              ;   current_room = A
 193+ 7C5B              ;
 194+ 7C5B              ; Mappatura:
 195+ 7C5B              ;    0 = The Off Licence
 196+ 7C5B              ;    1 = The Bridge
 197+ 7C5B              ;    2 = Under The Mega Tree
 198+ 7C5B              ;    3 = Gfx_At The Foot Of The Mega Tree
 199+ 7C5B              ;    4 = The Drive
 200+ 7C5B              ;    5 = The Security Guard
 201+ 7C5B              ;    6 = Entrance To Hades
 202+ 7C5B              ;    7 = Cuckoo's Nest
 203+ 7C5B              ;    8 = Inside The Mega Trunk
 204+ 7C5B              ;    9 = On A Branch Over The Drive
 205+ 7C5B              ;   10 = The Front Door
 206+ 7C5B              ;   11 = The Hall
 207+ 7C5B              ;   12 = Tree Top
 208+ 7C5B              ;   27 = The Chapel
 209+ 7C5B              ;   28 = First Landing
 210+ 7C5B              ;   29 = The Nightmare Room
 211+ 7C5B              ;   33 = The Bathroom
 212+ 7C5B              ;   35 = Master Bedroom
 213+ 7C5B              ;
 214+ 7C5B              ; Se nessuna stanza corrisponde viene impostato:
 215+ 7C5B              ;   current_room = 0
 216+ 7C5B              ; -------------------------------------------------------------------
 217+ 7C5B              DetermineCurrentRoomID:
 218+ 7C5B
 219+ 7C5B                  ; Salva i registri utilizzati
 220+ 7C5B E5               push hl
 221+ 7C5C D5               push de
 222+ 7C5D
 223+ 7C5D                  ; ---------------------------------------------------------------
 224+ 7C5D                  ; Confronto con TheOffLicenceLayout
 225+ 7C5D                  ; ---------------------------------------------------------------
 226+ 7C5D 2A 60 EA         ld   hl, (room_ptr)
 227+ 7C60 11 BA 84         ld   de, TheOffLicenceLayout
 228+ 7C63 B7               or   a
 229+ 7C64 ED 52            sbc  hl, de
 230+ 7C66 20 05            jr   nz, .not_office
 231+ 7C68
 232+ 7C68 3E 00            ld   a, 0               ; Room ID = 0
 233+ 7C6A C3 2F 80         jp   .set_room
 234+ 7C6D
 235+ 7C6D              .not_office:
 236+ 7C6D
 237+ 7C6D                  ; -------------------------------------------------q--------------
