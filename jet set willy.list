  11+ 5DDE 11 00 80         ld de, $8000  ; Indirizzo nella RAM in cui copiare il set di caratteri
  12+ 5DE1 01 00 03         ld bc, 768    ; Numero di byte da copiare (96 caratteri * 8 byte ciascuno)
  13+ 5DE4 ED B0            ldir          ; Copiare i dati
  14+ 5DE6 C9               ret
