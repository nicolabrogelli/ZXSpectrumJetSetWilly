1067+ 8475
1068+ 8475              .set_room:
1069+ 8475
1070+ 8475                  ; Salva l'ID della stanza corrente
1071+ 8475 32 A2 EF         ld   (current_room), a
1072+ 8478
1073+ 8478                  ; Ripristina i registri
1074+ 8478 D1               pop  de
1075+ 8479 E1               pop  hl
1076+ 847A
1077+ 847A C9               ret
1078+ 847B
1079+ 847B              ; -------------------------------------------------------------------
1080+ 847B              ; Items_DrawRoom
1081+ 847B              ;
1082+ 847B              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1083+ 847B              ;
1084+ 847B              ; Operazioni eseguite:
1085+ 847B              ;   1. Azzera la griglia items_grid.
1086+ 847B              ;   2. Svuota la cache degli oggetti attivi.
1087+ 847B              ;   3. Scansiona ItemsTable.
1088+ 847B              ;   4. Per ogni item della stanza corrente:
1089+ 847B              ;        - verifica se è già stato raccolto
1090+ 847B              ;        - disegna la grafica
1091+ 847B              ;        - aggiorna items_grid
1092+ 847B              ;        - memorizza l'item nella cache current_room_items
1093+ 847B              ;   5. Aggiorna num_room_items.
1094+ 847B              ;
1095+ 847B              ; Record ItemsTable:
1096+ 847B              ;   +0  Room ID
1097+ 847B              ;   +1  X (colonna)
1098+ 847B              ;   +2  Y (riga)
1099+ 847B              ;   +3  Colore
1100+ 847B              ;   +4  Collected flag
1101+ 847B              ;
1102+ 847B              ; Cache current_room_items:
1103+ 847B              ;   +0  Colonna
1104+ 847B              ;   +1  Riga
1105+ 847B              ;   +2  Colore
1106+ 847B              ;   +3  Collected flag ptr (Low)
1107+ 847B              ;   +4  Collected flag ptr (High)
1108+ 847B              ;
1109+ 847B              ; Ogni record cache occupa 5 byte.
1110+ 847B              ; -------------------------------------------------------------------
1111+ 847B              ; ResetItemsTable
1112+ 847B              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1113+ 847B              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1114+ 847B              ; -------------------------------------------------------------------
1115+ 847B              ResetItemsTable:
1116+ 847B 21 24 7F         ld   hl, ItemsTable
1117+ 847E              .reset_loop:
1118+ 847E 7E               ld   a, (hl)
1119+ 847F FE FF            cp   $FF
1120+ 8481 C8               ret  z
1121+ 8482 23               inc  hl                        ; +1 (X)
1122+ 8483 23               inc  hl                        ; +2 (Y)
1123+ 8484 23               inc  hl                        ; +3 (Color)
1124+ 8485 23               inc  hl                        ; +4 (Collected flag)
1125+ 8486 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1126+ 8488 23               inc  hl                        ; Prossimo record
1127+ 8489 18 F3            jr   .reset_loop
1128+ 848B
1129+ 848B              ; -------------------------------------------------------------------
1130+ 848B              Items_DrawRoom:
1131+ 848B
1132+ 848B                  ; Salva tutti i registri utilizzati
1133+ 848B E5               push hl
1134+ 848C D5               push de
1135+ 848D C5               push bc
1136+ 848E DD E5            push ix
1137+ 8490 FD E5            push iy
1138+ 8492
1139+ 8492                  ; ---------------------------------------------------------------
1140+ 8492                  ; Azzera items_grid (32 x 16 = 512 byte)
1141+ 8492                  ; ---------------------------------------------------------------
1142+ 8492 21 7C EA         ld   hl, items_grid
1143+ 8495 11 7D EA         ld   de, items_grid + 1
1144+ 8498 36 00            ld   (hl), 0
1145+ 849A 01 FF 01         ld   bc, 511
1146+ 849D ED B0            ldir
1147+ 849F
1148+ 849F                  ; ---------------------------------------------------------------
1149+ 849F                  ; Nessun item attivo nella stanza
1150+ 849F                  ; ---------------------------------------------------------------
1151+ 849F AF               xor  a
1152+ 84A0 32 FB EF         ld   (num_room_items), a
1153+ 84A3
1154+ 84A3                  ; IY punta alla cache degli item attivi
1155+ 84A3 FD 21 AB EF      ld   iy, current_room_items
1156+ 84A7
1157+ 84A7                  ; ---------------------------------------------------------------
1158+ 84A7                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1159+ 84A7                  ; alla stanza corrente.
1160+ 84A7                  ;
1161+ 84A7                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1162+ 84A7                  ; ---------------------------------------------------------------
1163+ 84A7 2A FC EF         ld   hl, (room_ptr)
1164+ 84AA 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1165+ 84AD 19               add  hl, de
1166+ 84AE
1167+ 84AE E5               push hl
1168+ 84AF DD E1            pop  ix                ; IX = bitmap item
1169+ 84B1
1170+ 84B1                  ; ---------------------------------------------------------------
1171+ 84B1                  ; Inizio scansione della tabella degli item
1172+ 84B1                  ; ---------------------------------------------------------------
1173+ 84B1 21 24 7F         ld   hl, ItemsTable
1174+ 84B4
1175+ 84B4              .loop:
1176+ 84B4
1177+ 84B4                  ; ---------------------------------------------------------------
1178+ 84B4                  ; Legge il Room ID del record corrente
