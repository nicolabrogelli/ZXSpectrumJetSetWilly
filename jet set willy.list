1418+ 73E9              ; CheckActiveItemAtCell
1419+ 73E9              ;
1420+ 73E9              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1421+ 73E9              ; nella cella specificata della griglia items_grid.
1422+ 73E9              ;
1423+ 73E9              ; Questa routine usa una lookup diretta su una mappa 32x16,
1424+ 73E9              ; evitando la scansione della ItemsTable.
1425+ 73E9              ;
1426+ 73E9              ; Input:
1427+ 73E9              ;   B = Colonna (0..31)
1428+ 73E9              ;   C = Riga (0..15)
1429+ 73E9              ;
1430+ 73E9              ; Output:
1431+ 73E9              ;   Carry Set   = item presente nella cella
1432+ 73E9              ;   Carry Clear = nessun item
1433+ 73E9              ;
1434+ 73E9              ; Nota:
1435+ 73E9              ;   HL NON è restituito valido (commento originale non corretto:
1436+ 73E9              ;   la routine non punta a ItemsTable).
1437+ 73E9              ; -------------------------------------------------------------------
1438+ 73E9              CheckActiveItemAtCell:
1439+ 73E9
1440+ 73E9                  ; Salva registri usati
1441+ 73E9 D5               push de
1442+ 73EA E5               push hl
1443+ 73EB
1444+ 73EB                  ; ---------------------------------------------------------------
1445+ 73EB                  ; Calcolo indice lineare nella griglia 32x16:
1446+ 73EB                  ;
1447+ 73EB                  ; offset = Row * 32 + Col
1448+ 73EB                  ; ---------------------------------------------------------------
1449+ 73EB 26 00            ld   h, 0
1450+ 73ED 69               ld   l, c              ; HL = Row
1451+ 73EE
1452+ 73EE 29               add  hl, hl            ; *2
1453+ 73EF 29               add  hl, hl            ; *4
1454+ 73F0 29               add  hl, hl            ; *8
1455+ 73F1 29               add  hl, hl            ; *16
1456+ 73F2 29               add  hl, hl            ; *32
1457+ 73F3
1458+ 73F3                  ; Aggiunge la colonna
1459+ 73F3 58               ld   e, b
1460+ 73F4 16 00            ld   d, 0
1461+ 73F6 19               add  hl, de            ; HL = Row*32 + Col
1462+ 73F7
1463+ 73F7                  ; ---------------------------------------------------------------
1464+ 73F7                  ; Accesso alla griglia degli item attivi
1465+ 73F7                  ; ---------------------------------------------------------------
1466+ 73F7 11 00 B0         ld   de, items_grid
1467+ 73FA 19               add  hl, de            ; HL = address cella
1468+ 73FB
1469+ 73FB                  ; ---------------------------------------------------------------
1470+ 73FB                  ; Controllo presenza item
1471+ 73FB                  ;
1472+ 73FB                  ; items_grid contiene:
1473+ 73FB                  ;   0 = nessun item
1474+ 73FB                  ;   >0 = item attivo (colore o flag)
1475+ 73FB                  ; ---------------------------------------------------------------
1476+ 73FB 7E               ld   a, (hl)
1477+ 73FC B7               or   a
1478+ 73FD 28 04            jr   z, .not_active
1479+ 73FF
1480+ 73FF                  ; ---------------------------------------------------------------
1481+ 73FF                  ; Item trovato
1482+ 73FF                  ; ---------------------------------------------------------------
1483+ 73FF E1               pop  hl
1484+ 7400 D1               pop  de
1485+ 7401
1486+ 7401 37               scf                    ; Carry = 1
1487+ 7402 C9               ret
1488+ 7403
1489+ 7403              .not_active:
1490+ 7403
1491+ 7403                  ; ---------------------------------------------------------------
1492+ 7403                  ; Nessun item nella cella
1493+ 7403                  ; ---------------------------------------------------------------
1494+ 7403 E1               pop  hl
1495+ 7404 D1               pop  de
1496+ 7405
1497+ 7405 B7               or   a                 ; Carry = 0
1498+ 7406 C9               ret
