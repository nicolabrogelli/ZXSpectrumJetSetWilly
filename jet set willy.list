2004+ 80F8              ; CheckActiveItemAtCell
2005+ 80F8              ;
2006+ 80F8              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2007+ 80F8              ; nella cella specificata della griglia items_grid.
2008+ 80F8              ;
2009+ 80F8              ; Questa routine usa una lookup diretta su una mappa 32x16,
2010+ 80F8              ; evitando la scansione della ItemsTable.
2011+ 80F8              ;
2012+ 80F8              ; Input:
2013+ 80F8              ;   B = Colonna (0..31)
2014+ 80F8              ;   C = Riga (0..15)
2015+ 80F8              ;
2016+ 80F8              ; Output:
2017+ 80F8              ;   Carry Set   = item presente nella cella
2018+ 80F8              ;   Carry Clear = nessun item
2019+ 80F8              ;
2020+ 80F8              ; Nota:
2021+ 80F8              ;   HL NON è restituito valido (commento originale non corretto:
2022+ 80F8              ;   la routine non punta a ItemsTable).
2023+ 80F8              ; -------------------------------------------------------------------
2024+ 80F8              CheckActiveItemAtCell:
2025+ 80F8
2026+ 80F8                  ; Salva registri usati
2027+ 80F8 D5               push de
2028+ 80F9 E5               push hl
2029+ 80FA
2030+ 80FA                  ; ---------------------------------------------------------------
2031+ 80FA                  ; Calcolo indice lineare nella griglia 32x16:
2032+ 80FA                  ;
2033+ 80FA                  ; offset = Row * 32 + Col
2034+ 80FA                  ; ---------------------------------------------------------------
2035+ 80FA 26 00            ld   h, 0
2036+ 80FC 69               ld   l, c              ; HL = Row
2037+ 80FD
2038+ 80FD 29               add  hl, hl            ; *2
2039+ 80FE 29               add  hl, hl            ; *4
2040+ 80FF 29               add  hl, hl            ; *8
2041+ 8100 29               add  hl, hl            ; *16
2042+ 8101 29               add  hl, hl            ; *32
2043+ 8102
2044+ 8102                  ; Aggiunge la colonna
2045+ 8102 58               ld   e, b
2046+ 8103 16 00            ld   d, 0
2047+ 8105 19               add  hl, de            ; HL = Row*32 + Col
2048+ 8106
2049+ 8106                  ; ---------------------------------------------------------------
2050+ 8106                  ; Accesso alla griglia degli item attivi
2051+ 8106                  ; ---------------------------------------------------------------
2052+ 8106 11 26 E4         ld   de, items_grid
2053+ 8109 19               add  hl, de            ; HL = address cella
2054+ 810A
2055+ 810A                  ; ---------------------------------------------------------------
2056+ 810A                  ; Controllo presenza item
2057+ 810A                  ;
2058+ 810A                  ; items_grid contiene:
2059+ 810A                  ;   0 = nessun item
2060+ 810A                  ;   >0 = item attivo (colore o flag)
2061+ 810A                  ; ---------------------------------------------------------------
2062+ 810A 7E               ld   a, (hl)
2063+ 810B B7               or   a
2064+ 810C 28 04            jr   z, .not_active
2065+ 810E
2066+ 810E                  ; ---------------------------------------------------------------
