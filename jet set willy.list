 964+ 7E24 DD 77 02         ld   (ix+2), a
 965+ 7E27 3E 01            ld   a, 1
 966+ 7E29 DD 77 06         ld   (ix+6), a         ; Cambia direzione a Sinistra
 967+ 7E2C C3 73 7E         jp   .next
