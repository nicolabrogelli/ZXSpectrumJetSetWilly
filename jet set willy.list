 362  8824 DB FE            in   a, ($fe)
 363  8826 1F               rra
 364  8827 30 F8            jr   nc, .wait_enter_release
 365  8829
 366  8829                  ; 3. Attesa della pressione del tasto ENTER con animazione ciclo colore su GAME OVER (Riga 5, Col 11)
 367  8829 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 368  882B              .wait_enter_press:
 369  882B 76               halt
 370  882C
 371  882C                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 372  882C 0C               inc  c
 373  882D 79               ld   a, c
 374  882E CB 3F            srl  a
 375  8830 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 376  8832 E6 07            and  7
 377  8834 5F               ld   e, a
 378  8835 16 00            ld   d, 0
 379  8837 21 A4 64         ld   hl, game_over_color_table
 380  883A 19               add  hl, de
 381  883B 7E               ld   a, (hl)               ; A = nuovo colore attributo
 382  883C 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 383  883F 06 09            ld   b, 9
