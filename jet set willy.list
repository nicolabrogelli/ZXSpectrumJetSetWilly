 279  89B2              ; -------------------------------------------------------------------
 280  89B2              ; ShowTitleScreen
 281  89B2              ; Visualizza la schermata iniziale del gioco (Title Screen).
 282  89B2              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 283  89B2              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 284  89B2              ; -------------------------------------------------------------------
 285  89B2              ShowTitleScreen:
 286  89B2                  ; 1. Disegna la schermata iniziale
 287  89B2 CD 1B 63         call Gfx_DrawTitleScreen
 288  89B5
 289  89B5                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 290  89B5              .wait_title_enter_release:
 291  89B5 76               halt
 292  89B6 3E BF            ld   a, $bf
 293  89B8 DB FE            in   a, ($fe)
 294  89BA 1F               rra
 295  89BB 30 F8            jr   nc, .wait_title_enter_release
 296  89BD
 297  89BD                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 298  89BD 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 299  89BF              .title_loop:
 300  89BF 76               halt
 301  89C0
 302  89C0                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 303  89C0 0C               inc  c
 304  89C1 79               ld   a, c
 305  89C2 CB 3F            srl  a
 306  89C4 CB 3F            srl  a
 307  89C6 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 308  89C8 E6 07            and  7
 309  89CA 5F               ld   e, a
 310  89CB 16 00            ld   d, 0
 311  89CD 21 13 63         ld   hl, title_color_table
 312  89D0 19               add  hl, de
 313  89D1 7E               ld   a, (hl)               ; A = nuovo colore
 314  89D2 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 315  89D5 06 20            ld   b, 32
 316  89D7              .color_title_loop:
 317  89D7 77               ld   (hl), a
 318  89D8 23               inc  hl
 319  89D9 10 FC            djnz .color_title_loop
 320  89DB
 321  89DB                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 322  89DB 3E BF            ld   a, $bf
 323  89DD DB FE            in   a, ($fe)
 324  89DF 1F               rra
 325  89E0 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 326  89E2
 327  89E2                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 328  89E2              .wait_title_enter_release_after:
 329  89E2 76               halt
 330  89E3 3E BF            ld   a, $bf
 331  89E5 DB FE            in   a, ($fe)
 332  89E7 1F               rra
 333  89E8 30 F8            jr   nc, .wait_title_enter_release_after
 334  89EA
 335  89EA                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 336  89EA AF               xor  a
 337  89EB D3 FE            out  ($fe), a              ; Bordo a nero
 338  89ED 21 8D 5C         ld   hl, ATTR_P
 339  89F0 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 340  89F1 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 341  89F4 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 342  89F6 3E 07            ld   a, $07
 343  89F8 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 344  89FB
 345  89FB                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 346  89FB CD 62 8C         call ResetFullGameState
 347  89FE
 348  89FE                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 349  89FE C3 94 88         jp   LoadRoomAndRestart
