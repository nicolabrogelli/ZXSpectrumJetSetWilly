2016+ 8220              ; CheckActiveItemAtCell
2017+ 8220              ;
2018+ 8220              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2019+ 8220              ; nella cella specificata della griglia items_grid.
2020+ 8220              ;
2021+ 8220              ; Questa routine usa una lookup diretta su una mappa 32x16,
2022+ 8220              ; evitando la scansione della ItemsTable.
2023+ 8220              ;
2024+ 8220              ; Input:
2025+ 8220              ;   B = Colonna (0..31)
2026+ 8220              ;   C = Riga (0..15)
2027+ 8220              ;
2028+ 8220              ; Output:
2029+ 8220              ;   Carry Set   = item presente nella cella
2030+ 8220              ;   Carry Clear = nessun item
2031+ 8220              ;
2032+ 8220              ; Nota:
2033+ 8220              ;   HL NON è restituito valido (commento originale non corretto:
2034+ 8220              ;   la routine non punta a ItemsTable).
2035+ 8220              ; -------------------------------------------------------------------
2036+ 8220              CheckActiveItemAtCell:
2037+ 8220
2038+ 8220                  ; Salva registri usati
2039+ 8220 D5               push de
2040+ 8221 E5               push hl
2041+ 8222
2042+ 8222                  ; ---------------------------------------------------------------
2043+ 8222                  ; Calcolo indice lineare nella griglia 32x16:
2044+ 8222                  ;
2045+ 8222                  ; offset = Row * 32 + Col
2046+ 8222                  ; ---------------------------------------------------------------
2047+ 8222 26 00            ld   h, 0
2048+ 8224 69               ld   l, c              ; HL = Row
2049+ 8225
2050+ 8225 29               add  hl, hl            ; *2
2051+ 8226 29               add  hl, hl            ; *4
2052+ 8227 29               add  hl, hl            ; *8
2053+ 8228 29               add  hl, hl            ; *16
2054+ 8229 29               add  hl, hl            ; *32
2055+ 822A
2056+ 822A                  ; Aggiunge la colonna
2057+ 822A 58               ld   e, b
2058+ 822B 16 00            ld   d, 0
2059+ 822D 19               add  hl, de            ; HL = Row*32 + Col
2060+ 822E
2061+ 822E                  ; ---------------------------------------------------------------
2062+ 822E                  ; Accesso alla griglia degli item attivi
2063+ 822E                  ; ---------------------------------------------------------------
2064+ 822E 11 16 E5         ld   de, items_grid
2065+ 8231 19               add  hl, de            ; HL = address cella
2066+ 8232
2067+ 8232                  ; ---------------------------------------------------------------
2068+ 8232                  ; Controllo presenza item
2069+ 8232                  ;
2070+ 8232                  ; items_grid contiene:
2071+ 8232                  ;   0 = nessun item
2072+ 8232                  ;   >0 = item attivo (colore o flag)
2073+ 8232                  ; ---------------------------------------------------------------
2074+ 8232 7E               ld   a, (hl)
2075+ 8233 B7               or   a
2076+ 8234 28 04            jr   z, .not_active
2077+ 8236
2078+ 8236                  ; ---------------------------------------------------------------
2079+ 8236                  ; Item trovato
2080+ 8236                  ; ---------------------------------------------------------------
2081+ 8236 E1               pop  hl
2082+ 8237 D1               pop  de
2083+ 8238
2084+ 8238 37               scf                    ; Carry = 1
2085+ 8239 C9               ret
2086+ 823A
2087+ 823A              .not_active:
2088+ 823A
2089+ 823A                  ; ---------------------------------------------------------------
2090+ 823A                  ; Nessun item nella cella
2091+ 823A                  ; ---------------------------------------------------------------
2092+ 823A E1               pop  hl
2093+ 823B D1               pop  de
2094+ 823C
2095+ 823C B7               or   a                 ; Carry = 0
2096+ 823D C9               ret
2097+ 823E
