 344  831B CD D8 67         call InitRoomEntryPositions
 345  831E
 346  831E                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 347  831E 3E 07            ld   a, 7
 348  8320 32 33 EA         ld   (time_hours), a
 349  8323 AF               xor  a
 350  8324 32 34 EA         ld   (time_minutes), a
 351  8327 32 35 EA         ld   (time_period), a       ; 0 = AM
 352  832A 32 38 EA         ld   (game_objective_completed), a
