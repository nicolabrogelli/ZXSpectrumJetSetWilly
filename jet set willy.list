  71+ 7473              ; Audio_UpdateMusic
  72+ 7473              ;
  73+ 7473              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 7473              ; Viene chiamata a ogni frame.
  75+ 7473              ; -------------------------------------------------------------------
  76+ 7473              Audio_UpdateMusic:
  77+ 7473 F5               push af
  78+ 7474 C5               push bc
  79+ 7475 D5               push de
  80+ 7476 E5               push hl
  81+ 7477
  82+ 7477                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 7477 3A BC 78         ld   a, (Audio_jump_sound_note)
  84+ 747A FE 12            cp   18
  85+ 747C 38 5A            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 747E
  87+ 747E                  ; Decrementa il contatore dei frame della nota corrente
  88+ 747E 3A BF 78         ld   a, (Audio_music_frame_counter)
  89+ 7481 3D               dec  a
  90+ 7482 32 BF 78         ld   (Audio_music_frame_counter), a
  91+ 7485 20 23            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 7487
