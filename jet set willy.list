 631+ 6084                  ; Corpo a sinistra
 632+ 6084 3A 0B F8         ld   a, (body_state)   ; 0, 1, 2
 633+ 6087 C6 05            add  a, 5              ; offset del tile per il corpo sinistro (5, 6, 7)
 634+ 6089 87               add  a, a              ; *2
 635+ 608A 87               add  a, a              ; *4
 636+ 608B 87               add  a, a              ; *8
