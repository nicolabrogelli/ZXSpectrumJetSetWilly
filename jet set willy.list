1174+ 6CEA              ; -------------------------------------------------------------------
1175+ 6CEA              ; GetRampY
1176+ 6CEA              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1177+ 6CEA              ; Input: C = PlayerX
1178+ 6CEA              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1179+ 6CEA              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1180+ 6CEA              ; -------------------------------------------------------------------
1181+ 6CEA              GetRampY:
1182+ 6CEA 3A A6 7E         ld   a, (ramp_len)
1183+ 6CED B7               or   a
1184+ 6CEE C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1185+ 6CEF
1186+ 6CEF 3A A5 7E         ld   a, (ramp_dir)
1187+ 6CF2 B7               or   a
1188+ 6CF3 28 5C            jr   z, .dir_left
1189+ 6CF5
1190+ 6CF5              .dir_right:
1191+ 6CF5                  ; Rampa sale a destra (up-right)
1192+ 6CF5 3A A8 7E         ld   a, (ramp_col)
1193+ 6CF8 87               add  a, a              ; *2
1194+ 6CF9 87               add  a, a              ; *4
1195+ 6CFA 87               add  a, a              ; *8 (X start in pixel)
1196+ 6CFB 5F               ld   e, a              ; E = X_left
1197+ 6CFC
1198+ 6CFC 3A A6 7E         ld   a, (ramp_len)
1199+ 6CFF 87               add  a, a              ; *2
1200+ 6D00 87               add  a, a              ; *4
1201+ 6D01 87               add  a, a              ; *8
1202+ 6D02 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1203+ 6D03 67               ld   h, a              ; H = X_right_boundary
1204+ 6D04 38 10            jr   c, .no_right_bound_check_right
1205+ 6D06
1206+ 6D06 79               ld   a, c              ; A = PlayerX
1207+ 6D07 BB               cp   e
1208+ 6D08 DA B7 6D         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1209+ 6D0B
1210+ 6D0B BC               cp   h
1211+ 6D0C 38 1E            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1212+ 6D0E
1213+ 6D0E                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1214+ 6D0E 94               sub  h                 ; A = PlayerX - X_right_boundary
1215+ 6D0F FE 08            cp   8
1216+ 6D11 D2 B7 6D         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1217+ 6D14 18 07            jr   .on_platform_right
1218+ 6D16
1219+ 6D16              .no_right_bound_check_right:
1220+ 6D16 79               ld   a, c              ; A = PlayerX
1221+ 6D17 BB               cp   e
1222+ 6D18 DA B7 6D         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1223+ 6D1B 18 0F            jr   .on_ramp_slope    ; Se >= X_left, è sicuramente sulla pendenza rampa (non può superare 256)
1224+ 6D1D
1225+ 6D1D              .on_platform_right:
1226+ 6D1D                  ; Piattaforma adiacente! Restituisci PlayerY = (ramp_row - ramp_len + 1) * 8 - 16
1227+ 6D1D 3A A7 7E         ld   a, (ramp_row)
1228+ 6D20 21 A6 7E         ld   hl, ramp_len
1229+ 6D23 96               sub  (hl)
1230+ 6D24 3C               inc  a                 ; A = Row
1231+ 6D25 87               add  a, a              ; *2
1232+ 6D26 87               add  a, a              ; *4
1233+ 6D27 87               add  a, a              ; *8
1234+ 6D28 D6 10            sub  16                ; A = Row * 8 - 16
1235+ 6D2A 37               scf                    ; Set carry (dentro rampa/piattaforma)
1236+ 6D2B C9               ret
1237+ 6D2C
1238+ 6D2C              .on_ramp_slope:
1239+ 6D2C 3A A7 7E         ld   a, (ramp_row)
1240+ 6D2F 87               add  a, a              ; *2
1241+ 6D30 87               add  a, a              ; *4
1242+ 6D31 87               add  a, a              ; *8
1243+ 6D32 D6 10            sub  16                ; A = ramp_row * 8 - 16
1244+ 6D34 83               add  a, e              ; A = ramp_row * 8 - 16 + X_left
1245+ 6D35 91               sub  c                 ; A = A - PlayerX
1246+ 6D36 57               ld   d, a              ; D = calculated Y
1247+ 6D37
1248+ 6D37                  ; H = platform_Y + 16 (confronto sicuro con offset +16)
1249+ 6D37 3A A7 7E         ld   a, (ramp_row)
1250+ 6D3A 21 A6 7E         ld   hl, ramp_len
1251+ 6D3D 96               sub  (hl)
1252+ 6D3E 3C               inc  a                 ; A = Row
1253+ 6D3F 87               add  a, a              ; *2
