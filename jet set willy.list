2019+ 87C6              ; CheckActiveItemAtCell
2020+ 87C6              ;
2021+ 87C6              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
2022+ 87C6              ; nella cella specificata della griglia items_grid.
2023+ 87C6              ;
2024+ 87C6              ; Questa routine usa una lookup diretta su una mappa 32x16,
2025+ 87C6              ; evitando la scansione della ItemsTable.
2026+ 87C6              ;
2027+ 87C6              ; Input:
2028+ 87C6              ;   B = Colonna (0..31)
2029+ 87C6              ;   C = Riga (0..15)
2030+ 87C6              ;
2031+ 87C6              ; Output:
2032+ 87C6              ;   Carry Set   = item presente nella cella
2033+ 87C6              ;   Carry Clear = nessun item
2034+ 87C6              ;
2035+ 87C6              ; Nota:
2036+ 87C6              ;   HL NON è restituito valido (commento originale non corretto:
2037+ 87C6              ;   la routine non punta a ItemsTable).
2038+ 87C6              ; -------------------------------------------------------------------
2039+ 87C6              CheckActiveItemAtCell:
2040+ 87C6
2041+ 87C6                  ; Salva registri usati
2042+ 87C6 D5               push de
2043+ 87C7 E5               push hl
2044+ 87C8
2045+ 87C8                  ; ---------------------------------------------------------------
2046+ 87C8                  ; Calcolo indice lineare nella griglia 32x16:
2047+ 87C8                  ;
2048+ 87C8                  ; offset = Row * 32 + Col
2049+ 87C8                  ; ---------------------------------------------------------------
2050+ 87C8 26 00            ld   h, 0
2051+ 87CA 69               ld   l, c              ; HL = Row
2052+ 87CB
2053+ 87CB 29               add  hl, hl            ; *2
2054+ 87CC 29               add  hl, hl            ; *4
2055+ 87CD 29               add  hl, hl            ; *8
2056+ 87CE 29               add  hl, hl            ; *16
2057+ 87CF 29               add  hl, hl            ; *32
2058+ 87D0
2059+ 87D0                  ; Aggiunge la colonna
2060+ 87D0 58               ld   e, b
2061+ 87D1 16 00            ld   d, 0
2062+ 87D3 19               add  hl, de            ; HL = Row*32 + Col
2063+ 87D4
2064+ 87D4                  ; ---------------------------------------------------------------
2065+ 87D4                  ; Accesso alla griglia degli item attivi
2066+ 87D4                  ; ---------------------------------------------------------------
2067+ 87D4 11 45 F2         ld   de, items_grid
2068+ 87D7 19               add  hl, de            ; HL = address cella
2069+ 87D8
2070+ 87D8                  ; ---------------------------------------------------------------
2071+ 87D8                  ; Controllo presenza item
2072+ 87D8                  ;
2073+ 87D8                  ; items_grid contiene:
2074+ 87D8                  ;   0 = nessun item
2075+ 87D8                  ;   >0 = item attivo (colore o flag)
2076+ 87D8                  ; ---------------------------------------------------------------
2077+ 87D8 7E               ld   a, (hl)
2078+ 87D9 B7               or   a
2079+ 87DA 28 04            jr   z, .not_active
2080+ 87DC
2081+ 87DC                  ; ---------------------------------------------------------------
2082+ 87DC                  ; Item trovato
2083+ 87DC                  ; ---------------------------------------------------------------
2084+ 87DC E1               pop  hl
2085+ 87DD D1               pop  de
2086+ 87DE
2087+ 87DE 37               scf                    ; Carry = 1
2088+ 87DF C9               ret
2089+ 87E0
2090+ 87E0              .not_active:
2091+ 87E0
2092+ 87E0                  ; ---------------------------------------------------------------
2093+ 87E0                  ; Nessun item nella cella
2094+ 87E0                  ; ---------------------------------------------------------------
2095+ 87E0 E1               pop  hl
2096+ 87E1 D1               pop  de
2097+ 87E2
2098+ 87E2 B7               or   a                 ; Carry = 0
2099+ 87E3 C9               ret
