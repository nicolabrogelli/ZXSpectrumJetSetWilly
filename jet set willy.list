   8+ 7483              ; Audio_UpdateJumpSound
   9+ 7483              ;
  10+ 7483              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7483              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7483              ; -------------------------------------------------------------------
  13+ 7483              Audio_UpdateJumpSound:
  14+ 7483 F5               push af
  15+ 7484 C5               push bc
  16+ 7485 D5               push de
  17+ 7486 E5               push hl
  18+ 7487
  19+ 7487                  ; Controlla se il suono è attivo (note < 18)
  20+ 7487 3A 1A 79         ld   a, (Audio_jump_sound_note)
  21+ 748A FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 748C 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 748E
  24+ 748E                  ; Carica la nota corrente da suonare
  25+ 748E 5F               ld   e, a
  26+ 748F 16 00            ld   d, 0
  27+ 7491 21 BD 74         ld   hl, Audio_JumpSoundDelays
  28+ 7494 19               add  hl, de
  29+ 7495 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7496 57               ld   d, a                      ; D = delay della nota
  31+ 7497
  32+ 7497                  ; Suona la nota: 15 cicli
  33+ 7497 06 0F            ld   b, 15
  34+ 7499              .note_loop:
  35+ 7499                  ; Speaker ON
  36+ 7499 3A AC 75         ld   a, (room_border_color)
  37+ 749C F6 10            or   $10
  38+ 749E D3 FE            out  ($fe), a
  39+ 74A0 4A               ld   c, d
  40+ 74A1              .d1:
  41+ 74A1 0D               dec  c
  42+ 74A2 20 FD            jr   nz, .d1
  43+ 74A4
  44+ 74A4                  ; Speaker OFF
  45+ 74A4 3A AC 75         ld   a, (room_border_color)
  46+ 74A7 E6 EF            and  $ef
  47+ 74A9 D3 FE            out  ($fe), a
  48+ 74AB 4A               ld   c, d
  49+ 74AC              .d2:
  50+ 74AC 0D               dec  c
  51+ 74AD 20 FD            jr   nz, .d2
  52+ 74AF
  53+ 74AF 10 E8            djnz .note_loop
  54+ 74B1
  55+ 74B1                  ; Passa alla nota successiva
  56+ 74B1 3A 1A 79         ld   a, (Audio_jump_sound_note)
  57+ 74B4 3C               inc  a
  58+ 74B5 32 1A 79         ld   (Audio_jump_sound_note), a
  59+ 74B8
  60+ 74B8              .done:
  61+ 74B8 E1               pop  hl
  62+ 74B9 D1               pop  de
  63+ 74BA C1               pop  bc
  64+ 74BB F1               pop  af
  65+ 74BC C9               ret
  66+ 74BD
  67+ 74BD              Audio_JumpSoundDelays:
  68+ 74BD 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 74C1 19 13 0C 06
  68+ 74C5 0C 13 19 20
  68+ 74C9 26 2D 33 3A
  68+ 74CD 40 47
