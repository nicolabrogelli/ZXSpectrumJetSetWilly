1114+ 791E              ; -------------------------------------------------------------------
1115+ 791E              ; RestoreBackgroundCell
1116+ 791E              ;
1117+ 791E              ; Ripristina il contenuto originale di una cella della stanza.
1118+ 791E              ; Viene utilizzata principalmente quando un item viene raccolto:
1119+ 791E              ; invece di lasciare un "buco", la routine ridisegna il tile
1120+ 791E              ; originale presente nella mappa della stanza.
1121+ 791E              ;
1122+ 791E              ; Input:
1123+ 791E              ;   B = Row (3..18)
1124+ 791E              ;   C = Col (0..31)
1125+ 791E              ;
1126+ 791E              ; Utilizza:
1127+ 791E              ;   room_ptr -> struttura dati della stanza corrente
1128+ 791E              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1129+ 791E              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1130+ 791E              ;
1131+ 791E              ; Tipi di cella:
1132+ 791E              ;   0 = Background
1133+ 791E              ;   1 = Floor
1134+ 791E              ;   2 = Wall
1135+ 791E              ;   3 = Nasty
1136+ 791E              ; -------------------------------------------------------------------
1137+ 791E              RestoreBackgroundCell:
1138+ 791E
1139+ 791E                  ; Salva tutti i registri utilizzati
1140+ 791E FD E5            push iy
1141+ 7920 C5               push bc
1142+ 7921 D5               push de
1143+ 7922 E5               push hl
1144+ 7923 DD E5            push ix
1145+ 7925
1146+ 7925                  ; ---------------------------------------------------------------
1147+ 7925                  ; Conserva Row e Col in IY.
1148+ 7925                  ;
1149+ 7925                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1150+ 7925                  ; BC potrebbe essere modificato.
1151+ 7925                  ; ---------------------------------------------------------------
1152+ 7925 C5               push bc
1153+ 7926 FD E1            pop  iy                ; IYH = Row, IYL = Col
1154+ 7928
1155+ 7928                  ; ---------------------------------------------------------------
1156+ 7928                  ; Determina quale tipo di cella è presente nella posizione
1157+ 7928                  ; specificata.
1158+ 7928                  ;
1159+ 7928                  ; Input:
1160+ 7928                  ;   B = Row
1161+ 7928                  ;   C = Col
1162+ 7928                  ;
1163+ 7928                  ; Output:
1164+ 7928                  ;   A = tipo cella
1165+ 7928                  ; ---------------------------------------------------------------
1166+ 7928 78               ld   a, b
1167+ 7929
1168+ 7929 CD 95 6C         call GetCellFromUnpacked
1169+ 792C
1170+ 792C                  ; ---------------------------------------------------------------
1171+ 792C                  ; Recupera il puntatore alla stanza corrente.
1172+ 792C                  ;
1173+ 792C                  ; DE = base della struttura stanza
1174+ 792C                  ; ---------------------------------------------------------------
1175+ 792C ED 5B B4 7E      ld   de, (room_ptr)
1176+ 7930
1177+ 7930                  ; ---------------------------------------------------------------
1178+ 7930                  ; Seleziona il tile corretto in base al tipo di cella.
1179+ 7930                  ;
1180+ 7930                  ; A = 0 -> Background
1181+ 7930                  ; A = 1 -> Floor
1182+ 7930                  ; A = 2 -> Wall
1183+ 7930                  ; A = 3 -> Nasty
1184+ 7930                  ; ---------------------------------------------------------------
1185+ 7930
1186+ 7930 B7               or   a
1187+ 7931 20 06            jr   nz, .not_bg
1188+ 7933
1189+ 7933                  ; Background
1190+ 7933 21 A0 00         ld   hl, OFFSET_BG
1191+ 7936 19               add  hl, de
1192+ 7937 18 16            jr   .draw_cell
1193+ 7939
1194+ 7939              .not_bg:
1195+ 7939
1196+ 7939 3D               dec  a
1197+ 793A 20 06            jr   nz, .not_floor
1198+ 793C
1199+ 793C                  ; Floor
1200+ 793C 21 A9 00         ld   hl, OFFSET_FLOOR
1201+ 793F 19               add  hl, de
1202+ 7940 18 0D            jr   .draw_cell
1203+ 7942
1204+ 7942              .not_floor:
1205+ 7942
1206+ 7942 3D               dec  a
1207+ 7943 20 06            jr   nz, .not_wall
1208+ 7945
1209+ 7945                  ; Wall
1210+ 7945 21 B2 00         ld   hl, OFFSET_WALL
1211+ 7948 19               add  hl, de
1212+ 7949 18 04            jr   .draw_cell
1213+ 794B
1214+ 794B              .not_wall:
1215+ 794B
1216+ 794B                  ; Nasty
1217+ 794B 21 BB 00         ld   hl, OFFSET_NASTY
1218+ 794E 19               add  hl, de
1219+ 794F
1220+ 794F              .draw_cell:
1221+ 794F
1222+ 794F                  ; ---------------------------------------------------------------
1223+ 794F                  ; HL punta ora alla grafica del tile da ridisegnare.
1224+ 794F                  ;
1225+ 794F                  ; Gfx_DrawTile si aspetta:
1226+ 794F                  ;   IX = puntatore tile
1227+ 794F                  ;   B  = Row
1228+ 794F                  ;   C  = Col
1229+ 794F                  ; ---------------------------------------------------------------
1230+ 794F E5               push hl
1231+ 7950 DD E1            pop  ix
1232+ 7952
1233+ 7952                  ; Ripristina Row e Col salvati in IY
1234+ 7952 FD E5            push iy
1235+ 7954 C1               pop  bc
1236+ 7955
1237+ 7955                  ; Disegna il tile originale
1238+ 7955 CD 5C 62         call Gfx_DrawTile
1239+ 7958
1240+ 7958                  ; ---------------------------------------------------------------
1241+ 7958                  ; Ripristina i registri salvati
1242+ 7958                  ; ---------------------------------------------------------------
1243+ 7958 DD E1            pop  ix
1244+ 795A E1               pop  hl
1245+ 795B D1               pop  de
1246+ 795C C1               pop  bc
1247+ 795D FD E1            pop  iy
1248+ 795F
1249+ 795F C9               ret
1250+ 7960
1251+ 7960              ; -------------------------------------------------------------------
1252+ 7960              ; CheckWillyItemCollision
1253+ 7960              ;
1254+ 7960              ; Verifica se Willy collide con un item utilizzando il controllo
1255+ 7960              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1256+ 7960              ;
1257+ 7960              ; Input:
1258+ 7960              ;   A = ItemX (colonna attributi 0..31)
1259+ 7960              ;   H = ItemY (riga attributi 3..18)
1260+ 7960              ;
1261+ 7960              ; Coordinate item:
1262+ 7960              ;   Ogni item occupa una cella da 8x8 pixel.
1263+ 7960              ;
1264+ 7960              ; Coordinate Willy:
1265+ 7960              ;   Willy occupa un rettangolo di 16x16 pixel.
1266+ 7960              ;
1267+ 7960              ; Output:
1268+ 7960              ;   Carry Set   = collisione rilevata
1269+ 7960              ;   Carry Clear = nessuna collisione
1270+ 7960              ;
1271+ 7960              ; Registri preservati:
1272+ 7960              ;   BC, DE, HL
1273+ 7960              ; -------------------------------------------------------------------
1274+ 7960              CheckWillyItemCollision:
1275+ 7960
1276+ 7960                  ; Salva i registri utilizzati
1277+ 7960 C5               push bc
1278+ 7961 D5               push de
1279+ 7962 E5               push hl
1280+ 7963
1281+ 7963                  ; ---------------------------------------------------------------
1282+ 7963                  ; Calcola il bounding box orizzontale dell'item
1283+ 7963                  ;
1284+ 7963                  ; ItemLeft  = ItemX * 8
1285+ 7963                  ; ItemRight = ItemLeft + 7
1286+ 7963                  ;
1287+ 7963                  ; E = ItemLeft
1288+ 7963                  ; D = ItemRight
1289+ 7963                  ; ---------------------------------------------------------------
1290+ 7963 6F               ld   l, a              ; L = ItemX
1291+ 7964
1292+ 7964 7D               ld   a, l
1293+ 7965 87               add  a, a              ; *2
1294+ 7966 87               add  a, a              ; *4
1295+ 7967 87               add  a, a              ; *8
1296+ 7968
1297+ 7968 5F               ld   e, a              ; E = ItemLeft
1298+ 7969
1299+ 7969 C6 07            add  a, 7
1300+ 796B 57               ld   d, a              ; D = ItemRight
1301+ 796C
1302+ 796C                  ; ---------------------------------------------------------------
1303+ 796C                  ; Recupera la posizione corrente di Willy
1304+ 796C                  ;
1305+ 796C                  ; B = WillyY
1306+ 796C                  ; C = WillyX
1307+ 796C                  ; ---------------------------------------------------------------
1308+ 796C ED 4B 39 7B      ld   bc, (PlayerPos)
1309+ 7970
1310+ 7970                  ; ---------------------------------------------------------------
1311+ 7970                  ; Primo test:
1312+ 7970                  ;
1313+ 7970                  ; WillyLeft <= ItemRight
1314+ 7970                  ;
1315+ 7970                  ; Se Willy è completamente a destra dell'item
1316+ 7970                  ; non può esserci collisione.
1317+ 7970                  ; ---------------------------------------------------------------
1318+ 7970 79               ld   a, c              ; A = WillyLeft
1319+ 7971
1320+ 7971 BA               cp   d                 ; WillyLeft vs ItemRight
1321+ 7972
1322+ 7972 28 04            jr   z, .x_ok
1323+ 7974 38 02            jr   c, .x_ok
1324+ 7976
1325+ 7976 18 29            jr   .no_collision
1326+ 7978
1327+ 7978              .x_ok:
1328+ 7978
1329+ 7978                  ; ---------------------------------------------------------------
1330+ 7978                  ; Secondo test:
1331+ 7978                  ;
1332+ 7978                  ; WillyRight >= ItemLeft
1333+ 7978                  ;
1334+ 7978                  ; WillyRight = WillyX + 7
1335+ 7978                  ; ---------------------------------------------------------------
1336+ 7978 C6 07            add  a, 7
1337+ 797A
1338+ 797A BB               cp   e                 ; WillyRight vs ItemLeft
1339+ 797B
1340+ 797B 28 04            jr   z, .y_check
1341+ 797D 30 02            jr   nc, .y_check
1342+ 797F
1343+ 797F 18 20            jr   .no_collision
1344+ 7981
1345+ 7981              .y_check:
1346+ 7981
1347+ 7981                  ; ---------------------------------------------------------------
1348+ 7981                  ; Recupera ItemY dal valore originale di HL
1349+ 7981                  ;
1350+ 7981                  ; H contiene la riga dell'item.
1351+ 7981                  ; ---------------------------------------------------------------
1352+ 7981 E1               pop  hl
1353+ 7982 E5               push hl
1354+ 7983
1355+ 7983                  ; ---------------------------------------------------------------
1356+ 7983                  ; Calcola il bounding box verticale dell'item
1357+ 7983                  ;
1358+ 7983                  ; ItemTop    = ItemY * 8
1359+ 7983                  ; ItemBottom = ItemTop + 7
1360+ 7983                  ;
1361+ 7983                  ; E = ItemTop
