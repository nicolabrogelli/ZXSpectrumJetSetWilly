1433+ 79F4              ; -------------------------------------------------------------------
1434+ 79F4              ; Items_CheckCollision
1435+ 79F4              ;
1436+ 79F4              ; Controlla se Willy entra in collisione con uno degli item
1437+ 79F4              ; attivi presenti nella stanza corrente.
1438+ 79F4              ;
1439+ 79F4              ; Per ogni item:
1440+ 79F4              ;   - verifica che appartenga alla stanza corrente
1441+ 79F4              ;   - verifica che non sia già stato raccolto
1442+ 79F4              ;   - esegue il test di collisione con Willy
1443+ 79F4              ;
1444+ 79F4              ; Se l'item viene raccolto:
1445+ 79F4              ;   - imposta il flag "collected"
1446+ 79F4              ;   - rimuove l'item dalla cache items_grid
1447+ 79F4              ;   - incrementa il contatore degli oggetti raccolti
1448+ 79F4              ;   - aggiorna l'HUD
1449+ 79F4              ;   - ripristina il tile di sfondo
1450+ 79F4              ;   - riproduce il suono di raccolta
1451+ 79F4              ;
1452+ 79F4              ; Formato record ItemsTable:
1453+ 79F4              ;   +0 RoomID
1454+ 79F4              ;   +1 X
1455+ 79F4              ;   +2 Y
1456+ 79F4              ;   +3 Color
1457+ 79F4              ;   +4 Collected
1458+ 79F4              ;
1459+ 79F4              ; Fine tabella:
1460+ 79F4              ;   RoomID = $FF
1461+ 79F4              ; -------------------------------------------------------------------
1462+ 79F4              Items_CheckCollision:
1463+ 79F4
1464+ 79F4                  ; Salva i registri utilizzati
1465+ 79F4 E5               push hl
1466+ 79F5 D5               push de
1467+ 79F6 C5               push bc
1468+ 79F7
1469+ 79F7                  ; Inizio scansione della tabella degli item
1470+ 79F7 21 2F 75         ld   hl, ItemsTable
1471+ 79FA
1472+ 79FA              .loop:
1473+ 79FA
1474+ 79FA                  ; ---------------------------------------------------------------
1475+ 79FA                  ; Legge il Room ID dell'item corrente
1476+ 79FA                  ; ---------------------------------------------------------------
1477+ 79FA 7E               ld   a, (hl)
1478+ 79FB
1479+ 79FB                  ; $FF indica fine tabella
1480+ 79FB FE FF            cp   $FF
1481+ 79FD 28 4D            jr   z, .done
1482+ 79FF
1483+ 79FF                  ; ---------------------------------------------------------------
1484+ 79FF                  ; Verifica se l'item appartiene alla stanza corrente
1485+ 79FF                  ; ---------------------------------------------------------------
1486+ 79FF 57               ld   d, a              ; D = RoomID item
1487+ 7A00
1488+ 7A00 3A FB 7D         ld   a, (current_room)
1489+ 7A03 BA               cp   d
1490+ 7A04
1491+ 7A04                  ; Se appartiene a un'altra stanza salta il record
1492+ 7A04 20 3F            jr   nz, .next_item
1493+ 7A06
1494+ 7A06                  ; ---------------------------------------------------------------
1495+ 7A06                  ; Legge coordinate e stato dell'item
1496+ 7A06                  ; ---------------------------------------------------------------
1497+ 7A06
1498+ 7A06 23               inc  hl
1499+ 7A07 4E               ld   c, (hl)           ; C = X
1500+ 7A08
1501+ 7A08 23               inc  hl
1502+ 7A09 46               ld   b, (hl)           ; B = Y
1503+ 7A0A
1504+ 7A0A 23               inc  hl                ; salta Color
1505+ 7A0B
1506+ 7A0B 23               inc  hl                ; punta a Collected
1507+ 7A0C
1508+ 7A0C 7E               ld   a, (hl)
1509+ 7A0D
1510+ 7A0D                  ; ---------------------------------------------------------------
1511+ 7A0D                  ; Item già raccolto?
1512+ 7A0D                  ; ---------------------------------------------------------------
1513+ 7A0D B7               or   a
1514+ 7A0E 20 39            jr   nz, .next_no_inc
1515+ 7A10
1516+ 7A10                  ; ---------------------------------------------------------------
1517+ 7A10                  ; Test collisione Willy ↔ Item
1518+ 7A10                  ;
1519+ 7A10                  ; Input richiesto:
1520+ 7A10                  ;   A = ItemX
1521+ 7A10                  ;   H = ItemY
1522+ 7A10                  ; ---------------------------------------------------------------
1523+ 7A10 79               ld   a, c
1524+ 7A11
1525+ 7A11 E5               push hl                ; salva puntatore al flag Collected
1526+ 7A12
1527+ 7A12 60               ld   h, b
1528+ 7A13
1529+ 7A13 CD AE 79         call CheckWillyItemCollision
1530+ 7A16
1531+ 7A16 E1               pop  hl
1532+ 7A17
1533+ 7A17                  ; Nessuna collisione
1534+ 7A17 30 30            jr   nc, .next_no_inc
1535+ 7A19
1536+ 7A19                  ; ===============================================================
1537+ 7A19                  ; ITEM RACCOLTO
1538+ 7A19                  ; ===============================================================
1539+ 7A19
1540+ 7A19                  ; ---------------------------------------------------------------
1541+ 7A19                  ; Marca l'item come raccolto
1542+ 7A19                  ; ---------------------------------------------------------------
1543+ 7A19 36 01            ld   (hl), 1
1544+ 7A1B
1545+ 7A1B                  ; ---------------------------------------------------------------
1546+ 7A1B                  ; Rimuove l'item dalla cache items_grid
1547+ 7A1B                  ;
1548+ 7A1B                  ; Calcolo:
1549+ 7A1B                  ;   offset = Row * 32 + Col
1550+ 7A1B                  ; ---------------------------------------------------------------
1551+ 7A1B E5               push hl
1552+ 7A1C D5               push de
1553+ 7A1D
1554+ 7A1D 26 00            ld   h, 0
1555+ 7A1F 68               ld   l, b              ; HL = Row
1556+ 7A20
1557+ 7A20 29               add  hl, hl            ; *2
1558+ 7A21 29               add  hl, hl            ; *4
1559+ 7A22 29               add  hl, hl            ; *8
1560+ 7A23 29               add  hl, hl            ; *16
1561+ 7A24 29               add  hl, hl            ; *32
1562+ 7A25
1563+ 7A25 59               ld   e, c
1564+ 7A26 16 00            ld   d, 0
1565+ 7A28
1566+ 7A28 19               add  hl, de            ; Row*32 + Col
1567+ 7A29
1568+ 7A29 11 EC CC         ld   de, items_grid
1569+ 7A2C 19               add  hl, de
1570+ 7A2D
1571+ 7A2D                  ; La cella non contiene più un item
1572+ 7A2D 36 00            ld   (hl), 0
1573+ 7A2F
1574+ 7A2F D1               pop  de
1575+ 7A30 E1               pop  hl
1576+ 7A31
1577+ 7A31                  ; ---------------------------------------------------------------
1578+ 7A31                  ; Conserva il puntatore all'entry corrente
1579+ 7A31                  ; poiché le routine successive possono alterare HL.
1580+ 7A31                  ; ---------------------------------------------------------------
1581+ 7A31 E5               push hl
1582+ 7A32
1583+ 7A32                  ; ---------------------------------------------------------------
1584+ 7A32                  ; Aggiorna il numero di oggetti raccolti
1585+ 7A32                  ; ---------------------------------------------------------------
1586+ 7A32 3A E6 7A         ld   a, (items_collected)
1587+ 7A35
1588+ 7A35 3C               inc  a
1589+ 7A36
1590+ 7A36 32 E6 7A         ld   (items_collected), a
1591+ 7A39
1592+ 7A39                  ; ---------------------------------------------------------------
1593+ 7A39                  ; Aggiorna il contatore visualizzato a schermo
1594+ 7A39                  ; ---------------------------------------------------------------
1595+ 7A39 CD 67 61         call Gfx_UpdateItemsCollectedDisplay
1596+ 7A3C
1597+ 7A3C                  ; ---------------------------------------------------------------
1598+ 7A3C                  ; Ripristina il tile originale della stanza
1599+ 7A3C                  ; eliminando la grafica dell'item.
1600+ 7A3C                  ;
1601+ 7A3C                  ; Input:
1602+ 7A3C                  ;   B = Row
1603+ 7A3C                  ;   C = Col
1604+ 7A3C                  ; ---------------------------------------------------------------
1605+ 7A3C CD 6C 79         call RestoreBackgroundCell
1606+ 7A3F
1607+ 7A3F                  ; ---------------------------------------------------------------
1608+ 7A3F                  ; Riproduce il suono di raccolta
1609+ 7A3F                  ; ---------------------------------------------------------------
1610+ 7A3F CD BB 7A         call Audio_PlayCollectSound
1611+ 7A42
1612+ 7A42                  ; Ripristina il puntatore alla tabella
1613+ 7A42 E1               pop  hl
1614+ 7A43
1615+ 7A43                  ; Continua con il record successivo
1616+ 7A43 18 04            jr   .next_no_inc
1617+ 7A45
1618+ 7A45              .next_item:
1619+ 7A45
1620+ 7A45                  ; ---------------------------------------------------------------
1621+ 7A45                  ; Salta i campi del record:
1622+ 7A45                  ;   X
1623+ 7A45                  ;   Y
1624+ 7A45                  ;   Color
1625+ 7A45                  ;   Collected
1626+ 7A45                  ; ---------------------------------------------------------------
1627+ 7A45 23               inc  hl
1628+ 7A46 23               inc  hl
1629+ 7A47 23               inc  hl
1630+ 7A48 23               inc  hl
1631+ 7A49
1632+ 7A49              .next_no_inc:
1633+ 7A49
1634+ 7A49                  ; ---------------------------------------------------------------
1635+ 7A49                  ; Avanza al record successivo.
1636+ 7A49                  ;
1637+ 7A49                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1638+ 7A49                  ; ---------------------------------------------------------------
1639+ 7A49 23               inc  hl
1640+ 7A4A
1641+ 7A4A 18 AE            jr   .loop
1642+ 7A4C
1643+ 7A4C              .done:
1644+ 7A4C
1645+ 7A4C                  ; Ripristina i registri
1646+ 7A4C C1               pop  bc
1647+ 7A4D D1               pop  de
1648+ 7A4E E1               pop  hl
1649+ 7A4F
1650+ 7A4F C9               ret
1651+ 7A50
1652+ 7A50
1653+ 7A50
1654+ 7A50              ; -------------------------------------------------------------------
1655+ 7A50              ; CheckActiveItemAtCell
1656+ 7A50              ;
1657+ 7A50              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1658+ 7A50              ; nella cella specificata della griglia items_grid.
1659+ 7A50              ;
1660+ 7A50              ; Questa routine usa una lookup diretta su una mappa 32x16,
1661+ 7A50              ; evitando la scansione della ItemsTable.
1662+ 7A50              ;
1663+ 7A50              ; Input:
1664+ 7A50              ;   B = Colonna (0..31)
1665+ 7A50              ;   C = Riga (0..15)
1666+ 7A50              ;
1667+ 7A50              ; Output:
1668+ 7A50              ;   Carry Set   = item presente nella cella
1669+ 7A50              ;   Carry Clear = nessun item
1670+ 7A50              ;
1671+ 7A50              ; Nota:
1672+ 7A50              ;   HL NON è restituito valido (commento originale non corretto:
1673+ 7A50              ;   la routine non punta a ItemsTable).
1674+ 7A50              ; -------------------------------------------------------------------
1675+ 7A50              CheckActiveItemAtCell:
1676+ 7A50
1677+ 7A50                  ; Salva registri usati
1678+ 7A50 D5               push de
1679+ 7A51 E5               push hl
1680+ 7A52
1681+ 7A52                  ; ---------------------------------------------------------------
1682+ 7A52                  ; Calcolo indice lineare nella griglia 32x16:
1683+ 7A52                  ;
1684+ 7A52                  ; offset = Row * 32 + Col
1685+ 7A52                  ; ---------------------------------------------------------------
1686+ 7A52 26 00            ld   h, 0
1687+ 7A54 69               ld   l, c              ; HL = Row
1688+ 7A55
1689+ 7A55 29               add  hl, hl            ; *2
1690+ 7A56 29               add  hl, hl            ; *4
1691+ 7A57 29               add  hl, hl            ; *8
1692+ 7A58 29               add  hl, hl            ; *16
1693+ 7A59 29               add  hl, hl            ; *32
1694+ 7A5A
1695+ 7A5A                  ; Aggiunge la colonna
1696+ 7A5A 58               ld   e, b
1697+ 7A5B 16 00            ld   d, 0
1698+ 7A5D 19               add  hl, de            ; HL = Row*32 + Col
1699+ 7A5E
1700+ 7A5E                  ; ---------------------------------------------------------------
1701+ 7A5E                  ; Accesso alla griglia degli item attivi
1702+ 7A5E                  ; ---------------------------------------------------------------
1703+ 7A5E 11 EC CC         ld   de, items_grid
1704+ 7A61 19               add  hl, de            ; HL = address cella
1705+ 7A62
1706+ 7A62                  ; ---------------------------------------------------------------
1707+ 7A62                  ; Controllo presenza item
1708+ 7A62                  ;
1709+ 7A62                  ; items_grid contiene:
1710+ 7A62                  ;   0 = nessun item
1711+ 7A62                  ;   >0 = item attivo (colore o flag)
1712+ 7A62                  ; ---------------------------------------------------------------
1713+ 7A62 7E               ld   a, (hl)
1714+ 7A63 B7               or   a
1715+ 7A64 28 04            jr   z, .not_active
1716+ 7A66
1717+ 7A66                  ; ---------------------------------------------------------------
1718+ 7A66                  ; Item trovato
1719+ 7A66                  ; ---------------------------------------------------------------
1720+ 7A66 E1               pop  hl
1721+ 7A67 D1               pop  de
1722+ 7A68
1723+ 7A68 37               scf                    ; Carry = 1
1724+ 7A69 C9               ret
1725+ 7A6A
1726+ 7A6A              .not_active:
1727+ 7A6A
1728+ 7A6A                  ; ---------------------------------------------------------------
1729+ 7A6A                  ; Nessun item nella cella
1730+ 7A6A                  ; ---------------------------------------------------------------
1731+ 7A6A E1               pop  hl
1732+ 7A6B D1               pop  de
1733+ 7A6C
1734+ 7A6C B7               or   a                 ; Carry = 0
1735+ 7A6D C9               ret
1736+ 7A6E
