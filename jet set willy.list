 956+ 6B27              ; -------------------------------------------------------------------
 957+ 6B27              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 958+ 6B27              ; Input: C = X, B = Y
 959+ 6B27              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 960+ 6B27              ; -------------------------------------------------------------------
 961+ 6B27              CheckWallCell:
 962+ 6B27 E5               push hl
 963+ 6B28 D5               push de
 964+ 6B29 C5               push bc
 965+ 6B2A
 966+ 6B2A                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 967+ 6B2A 78               ld   a, b
 968+ 6B2B FE 80            cp   128
 969+ 6B2D 30 1F            jr   nc, .not_wall
 970+ 6B2F
 971+ 6B2F                  ; 2. Calcola riga di layout: r = Y / 8
 972+ 6B2F CB 3F            srl  a
 973+ 6B31 CB 3F            srl  a
 974+ 6B33 CB 3F            srl  a                 ; A = r (0..15)
 975+ 6B35
 976+ 6B35                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 977+ 6B35 5F               ld   e, a              ; E = r (Row)
 978+ 6B36 79               ld   a, c
 979+ 6B37 CB 3F            srl  a
 980+ 6B39 CB 3F            srl  a
 981+ 6B3B CB 3F            srl  a                 ; A = c (0..31)
 982+ 6B3D 4F               ld   c, a              ; C = c (Col)
 983+ 6B3E
 984+ 6B3E                  ; Se la cella è sulla rampa, non considerarla un muro!
 985+ 6B3E 53               ld   d, e              ; D = Row
 986+ 6B3F 59               ld   e, c              ; E = Col
 987+ 6B40 CD AC 6A         call IsCellOnRamp
 988+ 6B43 38 09            jr   c, .not_wall
 989+ 6B45
 990+ 6B45 7A               ld   a, d              ; A = Row
 991+ 6B46 4B               ld   c, e              ; C = Col
 992+ 6B47 CD A7 6B         call GetCellFromUnpacked ; A = cell type
 993+ 6B4A
 994+ 6B4A                  ; Controlla se è Wall (2)
 995+ 6B4A FE 02            cp   2
 996+ 6B4C 28 05            jr   z, .is_wall
 997+ 6B4E
