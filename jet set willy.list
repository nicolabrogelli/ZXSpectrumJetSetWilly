1071+ 8653              .set_room:
1072+ 8653
1073+ 8653                  ; Salva l'ID della stanza corrente
1074+ 8653 32 6A FB         ld   (current_room), a
1075+ 8656
1076+ 8656                  ; Ripristina i registri
