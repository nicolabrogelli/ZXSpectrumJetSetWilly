 769  8DCD              ; CheckInMasterBedroom
 770  8DCD              ; Verifica se la stanza corrente è Master Bedroom (ID 35 / MastreBedRoomLayout)
 771  8DCD              ; Output: Carry = 1 se Master Bedroom, Carry = 0 altrimenti
 772  8DCD              ; -------------------------------------------------------------------
 773  8DCD              CheckInMasterBedroom:
 774  8DCD E5               push hl
 775  8DCE D5               push de
 776  8DCF 2A C4 FB         ld   hl, (room_ptr)
 777  8DD2 11 38 B6         ld   de, MastreBedRoomLayout
 778  8DD5 B7               or   a
 779  8DD6 ED 52            sbc  hl, de
 780  8DD8 28 0B            jr   z, .is_master
