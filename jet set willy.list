1408+ 73E4                  ; ---------------------------------------------------------------
1409+ 73E4 10 E6            djnz .sound_loop
1410+ 73E6
1411+ 73E6                  ; Ripristina registri salvati
1412+ 73E6 D1               pop  de
1413+ 73E7 C1               pop  bc
1414+ 73E8
1415+ 73E8 C9               ret
