 185+ 7884 3A AD 78         ld   a, (room_border_color)
 186+ 7887 F6 10            or   $10               ; speaker ON
 187+ 7889 D3 FE            out  ($fe), a
 188+ 788B
 189+ 788B 0E 3C            ld   c, 60
 190+ 788D              .d1:
 191+ 788D 0D               dec  c
 192+ 788E 20 FD            jr   nz, .d1
 193+ 7890
 194+ 7890 3A AD 78         ld   a, (room_border_color)
 195+ 7893 E6 EF            and  $ef              ; speaker OFF
 196+ 7895 D3 FE            out  ($fe), a
 197+ 7897
 198+ 7897 0E 3C            ld   c, 60
 199+ 7899              .d2:
 200+ 7899 0D               dec  c
 201+ 789A 20 FD            jr   nz, .d2
 202+ 789C
 203+ 789C 10 E6            djnz .sound_loop
 204+ 789E
 205+ 789E D1               pop  de
 206+ 789F C1               pop  bc
 207+ 78A0 C9               ret
