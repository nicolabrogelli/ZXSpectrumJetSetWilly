 351  8A01              ; -------------------------------------------------------------------
 352  8A01              ; TriggerGameOver
 353  8A01              ; Scatena la schermata di Game Over per la stanza corrente.
 354  8A01              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 355  8A01              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 356  8A01              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 357  8A01              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 358  8A01              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 359  8A01              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 360  8A01              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 361  8A01              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 362  8A01              ; -------------------------------------------------------------------
 363  8A01              TriggerGameOver:
 364  8A01                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 365  8A01 CD FC 64         call Gfx_DrawGameOverScreen
 366  8A04
 367  8A04                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 368  8A04              .wait_keys_release:
 369  8A04 76               halt
 370  8A05                  ; Controlla tasto Y (Porta $DF, bit 4)
 371  8A05 01 FE DF         ld   bc, $dffe
 372  8A08 ED 78            in   a, (c)
 373  8A0A CB 67            bit  4, a
 374  8A0C 28 F6            jr   z, .wait_keys_release
 375  8A0E
 376  8A0E                  ; Controlla tasto N (Porta $7F, bit 3)
 377  8A0E 01 FE 7F         ld   bc, $7ffe
 378  8A11 ED 78            in   a, (c)
 379  8A13 CB 5F            bit  3, a
 380  8A15 28 ED            jr   z, .wait_keys_release
 381  8A17
 382  8A17                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 383  8A17 01 FE BF         ld   bc, $bffe
 384  8A1A ED 78            in   a, (c)
 385  8A1C CB 47            bit  0, a
 386  8A1E 28 E4            jr   z, .wait_keys_release
 387  8A20
 388  8A20                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 389  8A20 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 390  8A22              .wait_choice_loop:
 391  8A22 76               halt
 392  8A23
