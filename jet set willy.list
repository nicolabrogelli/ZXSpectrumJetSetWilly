 120+ 762F              .play_current_note:
 121+ 762F                  ; Ottieni il delay della nota corrente (primo byte)
 122+ 762F 3A 45 7A         ld   a, (Audio_music_note_idx)
 123+ 7632 5F               ld   e, a
 124+ 7633 16 00            ld   d, 0
 125+ 7635 21 62 76         ld   hl, Audio_MusicSheet
 126+ 7638 19               add  hl, de
 127+ 7639 19               add  hl, de                   ; hl punta al primo byte della nota
 128+ 763A 7E               ld   a, (hl)                  ; A = delay
 129+ 763B B7               or   a
 130+ 763C 28 1F            jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 131+ 763E
 132+ 763E                  ; Suona la nota: 2 cicli
 133+ 763E 57               ld   d, a                     ; D = delay
 134+ 763F 06 02            ld   b, 2                     ; 2 cicli per frame
 135+ 7641              .note_loop:
 136+ 7641                  ; Speaker ON
 137+ 7641 3A D5 76         ld   a, (room_border_color)
 138+ 7644 F6 10            or   $10
 139+ 7646 D3 FE            out  ($fe), a
 140+ 7648 4A               ld   c, d
 141+ 7649              .d1:
 142+ 7649 F5               push af
 143+ 764A F1               pop  af
 144+ 764B 0D               dec  c
 145+ 764C 20 FB            jr   nz, .d1
 146+ 764E
 147+ 764E                  ; Speaker OFF
 148+ 764E 3A D5 76         ld   a, (room_border_color)
 149+ 7651 E6 EF            and  $ef
 150+ 7653 D3 FE            out  ($fe), a
 151+ 7655 4A               ld   c, d
 152+ 7656              .d2:
 153+ 7656 F5               push af
 154+ 7657 F1               pop  af
 155+ 7658 0D               dec  c
 156+ 7659 20 FB            jr   nz, .d2
 157+ 765B
 158+ 765B 10 E4            djnz .note_loop
 159+ 765D
 160+ 765D              .done:
 161+ 765D E1               pop  hl
 162+ 765E D1               pop  de
 163+ 765F C1               pop  bc
 164+ 7660 F1               pop  af
 165+ 7661 C9               ret
