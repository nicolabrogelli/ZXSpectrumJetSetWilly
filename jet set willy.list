 685+ 72AF                  ; ---------------------------------------------------------------
 686+ 72AF                  ; Calcolo indirizzo bitmap dello Spectrum
 687+ 72AF                  ;
 688+ 72AF                  ; Ogni item occupa una cella attributi (8x8 pixel).
 689+ 72AF                  ;
 690+ 72AF                  ; Formula:
 691+ 72AF                  ;   High = $40 + (Row AND $18)
 692+ 72AF                  ;   Low  = (Row AND 7) * 32 + Col
 693+ 72AF                  ;
 694+ 72AF                  ; DE conterrà l'indirizzo della prima scanline.
 695+ 72AF                  ; ---------------------------------------------------------------
 696+ 72AF
 697+ 72AF 78               ld   a, b
 698+ 72B0 E6 18            and  $18
 699+ 72B2 C6 40            add  a, $40
 700+ 72B4 57               ld   d, a              ; Byte alto indirizzo video
 701+ 72B5
 702+ 72B5 78               ld   a, b
 703+ 72B6 E6 07            and  7                 ; Riga interna al blocco da 8
 704+ 72B8
 705+ 72B8 87               add  a, a              ; *2
 706+ 72B9 87               add  a, a              ; *4
 707+ 72BA 87               add  a, a              ; *8
 708+ 72BB 87               add  a, a              ; *16
 709+ 72BC 87               add  a, a              ; *32
 710+ 72BD
 711+ 72BD 81               add  a, c              ; + colonna
 712+ 72BE
 713+ 72BE 5F               ld   e, a              ; Byte basso indirizzo video
 714+ 72BF
 715+ 72BF                  ; ---------------------------------------------------------------
 716+ 72BF                  ; Disegno bitmap
 717+ 72BF                  ;
 718+ 72BF                  ; Copia 8 byte consecutivi nella memoria video.
 719+ 72BF                  ; Ogni byte rappresenta una scanline da 8 pixel.
 720+ 72BF                  ; ---------------------------------------------------------------
 721+ 72BF
 722+ 72BF C5               push bc                ; Conserva Row e Col
 723+ 72C0
 724+ 72C0 06 08            ld   b, 8              ; Numero scanline
 725+ 72C2
 726+ 72C2              .line_loop:
 727+ 72C2
 728+ 72C2 7E               ld   a, (hl)           ; Legge scanline bitmap
 729+ 72C3 12               ld   (de), a           ; Scrive nella memoria video
 730+ 72C4
 731+ 72C4 14               inc  d                 ; Scanline successiva
 732+ 72C5 23               inc  hl                ; Byte bitmap successivo
 733+ 72C6
 734+ 72C6 05               dec  b
 735+ 72C7 20 F9            jr   nz, .line_loop
 736+ 72C9
 737+ 72C9 C1               pop  bc                ; Ripristina Row e Col
 738+ 72CA
 739+ 72CA                  ; ---------------------------------------------------------------
 740+ 72CA                  ; Calcolo indirizzo attributo
 741+ 72CA                  ;
 742+ 72CA                  ; Formula:
 743+ 72CA                  ;   AttrAddr = $5800 + Row * 32 + Col
 744+ 72CA                  ;
 745+ 72CA                  ; HL conterrà l'indirizzo della cella attributi.
 746+ 72CA                  ; ---------------------------------------------------------------
 747+ 72CA
 748+ 72CA 26 00            ld   h, 0
 749+ 72CC 68               ld   l, b              ; HL = Row
 750+ 72CD
 751+ 72CD 29               add  hl, hl            ; *2
 752+ 72CE 29               add  hl, hl            ; *4
 753+ 72CF 29               add  hl, hl            ; *8
 754+ 72D0 29               add  hl, hl            ; *16
 755+ 72D1 29               add  hl, hl            ; *32
 756+ 72D2
 757+ 72D2 79               ld   a, c              ; A = Colonna
 758+ 72D3
 759+ 72D3 85               add  a, l
 760+ 72D4 6F               ld   l, a
 761+ 72D5
 762+ 72D5 30 01            jr   nc, .no_carry
 763+ 72D7 24               inc  h
 764+ 72D8
 765+ 72D8              .no_carry:
 766+ 72D8
 767+ 72D8                  ; HL = Row * 32 + Col
 768+ 72D8
 769+ 72D8 11 00 58         ld   de, $5800
 770+ 72DB 19               add  hl, de            ; HL = indirizzo attributi
 771+ 72DC
 772+ 72DC                  ; ---------------------------------------------------------------
 773+ 72DC                  ; Recupera il colore originale dallo stack.
 774+ 72DC                  ;
 775+ 72DC                  ; Layout stack:
 776+ 72DC                  ;   HL originale
 777+ 72DC                  ;   DE originale (E = colore)
 778+ 72DC                  ;   BC originale
 779+ 72DC                  ; ---------------------------------------------------------------
 780+ 72DC
 781+ 72DC C1               pop  bc                ; Recupera HL originale
 782+ 72DD D1               pop  de                ; Recupera DE originale
 783+ 72DE
 784+ 72DE                  ; ---------------------------------------------------------------
 785+ 72DE                  ; Scrive l'attributo colore
 786+ 72DE                  ; ---------------------------------------------------------------
 787+ 72DE
 788+ 72DE 7B               ld   a, e              ; A = colore
 789+ 72DF 77               ld   (hl), a           ; Scrive nella RAM attributi
