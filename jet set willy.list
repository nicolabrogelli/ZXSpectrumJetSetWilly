 503+ 6C14              ; -------------------------------------------------------------------
 504+ 6C14              ; Riproduce un breve segnale acustico all'altoparlante
 505+ 6C14              ; -------------------------------------------------------------------
 506+ 6C14              PlayCollectSound:
 507+ 6C14 C5               push bc
 508+ 6C15 D5               push de
 509+ 6C16
 510+ 6C16 06 78            ld   b, 120            ; Cicli della nota
 511+ 6C18              .sound_loop:
 512+ 6C18 3A 00 77         ld   a, (room_border_color)
 513+ 6C1B F6 10            or   $10               ; Speaker ON (bit 4 = 1)
 514+ 6C1D D3 FE            out  ($fe), a
 515+ 6C1F 0E 3C            ld   c, 60             ; Mezzo periodo delay
 516+ 6C21 0D           .d1: dec  c
 517+ 6C22 20 FD            jr   nz, .d1
 518+ 6C24
 519+ 6C24 3A 00 77         ld   a, (room_border_color)
 520+ 6C27 E6 EF            and  $ef               ; Speaker OFF (bit 4 = 0)
 521+ 6C29 D3 FE            out  ($fe), a
 522+ 6C2B 0E 3C            ld   c, 60             ; Mezzo periodo delay
 523+ 6C2D 0D           .d2: dec  c
 524+ 6C2E 20 FD            jr   nz, .d2
 525+ 6C30
 526+ 6C30 10 E6            djnz .sound_loop
 527+ 6C32
 528+ 6C32 D1               pop  de
 529+ 6C33 C1               pop  bc
 530+ 6C34 C9               ret
