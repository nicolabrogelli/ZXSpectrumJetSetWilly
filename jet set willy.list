  12+ 68B7 3E FE            ld  a, $fe
  13+ 68B9 DB FE            in  a, ($fe)
  14+ 68BB DD 21 B0 6D      ld  ix,flags
  15+ 68BF
  16+ 68BF              checkCtrl_left:
  17+ 68BF CB 4F            bit $01, a
  18+ 68C1 20 0D            jr  nz, checkCtrl_right
  19+ 68C3 CB C2            set $00, d
  20+ 68C5 DD CB 00 C6      set 0,(ix)
  21+ 68C9 5F               ld  e, a
  22+ 68CA 3E 01            ld  a, 1
  23+ 68CC 32 AF 6D         ld  (direction), a
