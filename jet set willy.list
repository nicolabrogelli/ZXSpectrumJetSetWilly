 322+ 707D              ; -------------------------------------------------------------------
 323+ 707D              ; DrawRoomItems
 324+ 707D              ;
 325+ 707D              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 326+ 707D              ;
 327+ 707D              ; Operazioni eseguite:
 328+ 707D              ;   1. Azzera la griglia items_grid.
 329+ 707D              ;   2. Svuota la cache degli oggetti attivi.
 330+ 707D              ;   3. Scansiona ItemsTable.
 331+ 707D              ;   4. Per ogni item della stanza corrente:
 332+ 707D              ;        - verifica se è già stato raccolto
 333+ 707D              ;        - disegna la grafica
 334+ 707D              ;        - aggiorna items_grid
 335+ 707D              ;        - memorizza l'item nella cache current_room_items
 336+ 707D              ;   5. Aggiorna num_room_items.
 337+ 707D              ;
 338+ 707D              ; Record ItemsTable:
 339+ 707D              ;   +0  Room ID
 340+ 707D              ;   +1  X (colonna)
 341+ 707D              ;   +2  Y (riga)
 342+ 707D              ;   +3  Colore
 343+ 707D              ;   +4  Collected flag
 344+ 707D              ;
 345+ 707D              ; Cache current_room_items:
 346+ 707D              ;   +0  Colonna
 347+ 707D              ;   +1  Riga
 348+ 707D              ;   +2  Colore
 349+ 707D              ;   +3  Collected flag ptr (Low)
 350+ 707D              ;   +4  Collected flag ptr (High)
 351+ 707D              ;
 352+ 707D              ; Ogni record cache occupa 5 byte.
 353+ 707D              ; -------------------------------------------------------------------
 354+ 707D              DrawRoomItems:
 355+ 707D
 356+ 707D                  ; Salva tutti i registri utilizzati
 357+ 707D E5               push hl
 358+ 707E D5               push de
 359+ 707F C5               push bc
 360+ 7080 DD E5            push ix
 361+ 7082 FD E5            push iy
 362+ 7084
 363+ 7084                  ; ---------------------------------------------------------------
 364+ 7084                  ; Azzera items_grid (32 x 16 = 512 byte)
 365+ 7084                  ; ---------------------------------------------------------------
 366+ 7084 21 00 90         ld   hl, items_grid
 367+ 7087 11 01 90         ld   de, items_grid + 1
 368+ 708A 36 00            ld   (hl), 0
 369+ 708C 01 FF 01         ld   bc, 511
 370+ 708F ED B0            ldir
 371+ 7091
 372+ 7091                  ; ---------------------------------------------------------------
 373+ 7091                  ; Nessun item attivo nella stanza
 374+ 7091                  ; ---------------------------------------------------------------
 375+ 7091 AF               xor  a
 376+ 7092 32 D0 75         ld   (num_room_items), a
 377+ 7095
 378+ 7095                  ; IY punta alla cache degli item attivi
 379+ 7095 FD 21 80 75      ld   iy, current_room_items
 380+ 7099
 381+ 7099                  ; ---------------------------------------------------------------
 382+ 7099                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 383+ 7099                  ; alla stanza corrente.
 384+ 7099                  ;
 385+ 7099                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 386+ 7099                  ; ---------------------------------------------------------------
 387+ 7099 2A D1 75         ld   hl, (room_ptr)
 388+ 709C 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 389+ 709F 19               add  hl, de
 390+ 70A0
 391+ 70A0 E5               push hl
 392+ 70A1 DD E1            pop  ix                ; IX = bitmap item
 393+ 70A3
 394+ 70A3                  ; ---------------------------------------------------------------
 395+ 70A3                  ; Inizio scansione della tabella degli item
 396+ 70A3                  ; ---------------------------------------------------------------
 397+ 70A3 21 2D 6F         ld   hl, ItemsTable
 398+ 70A6
 399+ 70A6              .loop:
 400+ 70A6
 401+ 70A6                  ; ---------------------------------------------------------------
 402+ 70A6                  ; Legge il Room ID del record corrente
 403+ 70A6                  ; ---------------------------------------------------------------
 404+ 70A6 7E               ld   a, (hl)
 405+ 70A7
 406+ 70A7                  ; $FF indica fine tabella
 407+ 70A7 FE FF            cp   $FF
 408+ 70A9 28 53            jr   z, .done
 409+ 70AB
 410+ 70AB                  ; ---------------------------------------------------------------
 411+ 70AB                  ; Verifica se l'item appartiene alla stanza corrente
 412+ 70AB                  ; ---------------------------------------------------------------
 413+ 70AB 57               ld   d, a
 414+ 70AC
 415+ 70AC 3A 77 75         ld   a, (current_room)
 416+ 70AF BA               cp   d
 417+ 70B0 20 45            jr   nz, .next_item
 418+ 70B2
 419+ 70B2                  ; ---------------------------------------------------------------
 420+ 70B2                  ; Legge i dati dell'item
 421+ 70B2                  ; ---------------------------------------------------------------
 422+ 70B2
 423+ 70B2 23               inc  hl
 424+ 70B3 4E               ld   c, (hl)           ; X (colonna)
 425+ 70B4
 426+ 70B4 23               inc  hl
 427+ 70B5 46               ld   b, (hl)           ; Y (riga)
 428+ 70B6
 429+ 70B6 23               inc  hl
 430+ 70B7 5E               ld   e, (hl)           ; Colore
 431+ 70B8
 432+ 70B8 23               inc  hl
 433+ 70B9 7E               ld   a, (hl)           ; Collected flag
 434+ 70BA
 435+ 70BA                  ; Se diverso da zero l'item è già stato raccolto
 436+ 70BA B7               or   a
 437+ 70BB 20 3E            jr   nz, .next_no_inc
 438+ 70BD
 439+ 70BD                  ; ---------------------------------------------------------------
 440+ 70BD                  ; Disegna l'item sullo schermo
 441+ 70BD                  ;
 442+ 70BD                  ; B = Row
 443+ 70BD                  ; C = Column
 444+ 70BD                  ; HL = bitmap pointer
 445+ 70BD                  ; E = Color
 446+ 70BD                  ; ---------------------------------------------------------------
 447+ 70BD E5               push hl
 448+ 70BE
 449+ 70BE DD E5            push ix
 450+ 70C0 E1               pop  hl
 451+ 70C1
 452+ 70C1 CD 06 71         call DrawItemGraphic
 453+ 70C4
 454+ 70C4 E1               pop  hl                ; ritorna al flag collected
 455+ 70C5
 456+ 70C5                  ; ---------------------------------------------------------------
 457+ 70C5                  ; Aggiorna items_grid
 458+ 70C5                  ;
 459+ 70C5                  ; Calcolo:
 460+ 70C5                  ;   offset = Row * 32 + Col
 461+ 70C5                  ; ---------------------------------------------------------------
 462+ 70C5 E5               push hl
 463+ 70C6 D5               push de
 464+ 70C7
 465+ 70C7 26 00            ld   h, 0
 466+ 70C9 68               ld   l, b              ; HL = Row
 467+ 70CA
 468+ 70CA 29               add  hl, hl            ; *2
 469+ 70CB 29               add  hl, hl            ; *4
 470+ 70CC 29               add  hl, hl            ; *8
 471+ 70CD 29               add  hl, hl            ; *16
 472+ 70CE 29               add  hl, hl            ; *32
 473+ 70CF
 474+ 70CF 16 00            ld   d, 0
 475+ 70D1 59               ld   e, c              ; DE = Col
 476+ 70D2
 477+ 70D2 19               add  hl, de            ; Row*32 + Col
 478+ 70D3
 479+ 70D3 11 00 90         ld   de, items_grid
 480+ 70D6 19               add  hl, de            ; puntatore nella griglia
 481+ 70D7
 482+ 70D7 D1               pop  de                ; ripristina colore
 483+ 70D8
 484+ 70D8 73               ld   (hl), e           ; salva colore cella
 485+ 70D9
 486+ 70D9 E1               pop  hl
 487+ 70DA
 488+ 70DA                  ; ---------------------------------------------------------------
 489+ 70DA                  ; Salva l'item nella cache della stanza
 490+ 70DA                  ;
 491+ 70DA                  ; Questo evita di dover scansionare tutta ItemsTable
 492+ 70DA                  ; durante il controllo delle collisioni.
 493+ 70DA                  ; ---------------------------------------------------------------
 494+ 70DA
 495+ 70DA FD 71 00         ld   (iy+0), c         ; Colonna
 496+ 70DD FD 70 01         ld   (iy+1), b         ; Riga
 497+ 70E0 FD 73 02         ld   (iy+2), e         ; Colore
 498+ 70E3
 499+ 70E3                  ; Salva il puntatore al flag "collected"
 500+ 70E3 FD 75 03         ld   (iy+3), l         ; Low byte
 501+ 70E6 FD 74 04         ld   (iy+4), h         ; High byte
 502+ 70E9
 503+ 70E9                  ; Passa al record successivo della cache
 504+ 70E9 01 05 00         ld   bc, 5
 505+ 70EC FD 09            add  iy, bc
 506+ 70EE
 507+ 70EE                  ; Incrementa il numero di item attivi
 508+ 70EE 3A D0 75         ld   a, (num_room_items)
 509+ 70F1 3C               inc  a
 510+ 70F2 32 D0 75         ld   (num_room_items), a
 511+ 70F5
 512+ 70F5 18 04            jr   .next_no_inc
 513+ 70F7
 514+ 70F7              .next_item:
 515+ 70F7
 516+ 70F7                  ; ---------------------------------------------------------------
 517+ 70F7                  ; L'item non appartiene alla stanza corrente.
 518+ 70F7                  ; Salta i campi del record:
 519+ 70F7                  ;   X
 520+ 70F7                  ;   Y
 521+ 70F7                  ;   Color
 522+ 70F7                  ;   Collected
 523+ 70F7                  ; ---------------------------------------------------------------
 524+ 70F7 23               inc  hl
 525+ 70F8 23               inc  hl
 526+ 70F9 23               inc  hl
 527+ 70FA 23               inc  hl
 528+ 70FB
 529+ 70FB              .next_no_inc:
 530+ 70FB
 531+ 70FB                  ; ---------------------------------------------------------------
 532+ 70FB                  ; Avanza al record successivo
 533+ 70FB                  ; (prossimo Room ID)
 534+ 70FB                  ; ---------------------------------------------------------------
 535+ 70FB 23               inc  hl
 536+ 70FC 18 A8            jr   .loop
 537+ 70FE
 538+ 70FE              .done:
 539+ 70FE
 540+ 70FE                  ; Ripristina i registri
 541+ 70FE FD E1            pop  iy
 542+ 7100 DD E1            pop  ix
 543+ 7102 D1               pop  de
 544+ 7103 C1               pop  bc
 545+ 7104 E1               pop  hl
 546+ 7105
 547+ 7105 C9               ret
 548+ 7106
 549+ 7106              ; -------------------------------------------------------------------
 550+ 7106              ; DrawItemGraphic
 551+ 7106              ;
 552+ 7106              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 553+ 7106              ; utilizzando una bitmap di 8 byte e un attributo colore.
 554+ 7106              ;
 555+ 7106              ; Input:
 556+ 7106              ;   B = Riga attributi (3..18)
 557+ 7106              ;   C = Colonna attributi (0..31)
 558+ 7106              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 559+ 7106              ;   E = Attributo colore
 560+ 7106              ;
 561+ 7106              ; Output:
 562+ 7106              ;   Nessuno
 563+ 7106              ;
 564+ 7106              ; Registri preservati:
 565+ 7106              ;   BC, DE, HL
 566+ 7106              ; -------------------------------------------------------------------
 567+ 7106              DrawItemGraphic:
 568+ 7106
 569+ 7106                  ; Salva i registri originali
 570+ 7106 C5               push bc
 571+ 7107 D5               push de
 572+ 7108 E5               push hl
 573+ 7109
 574+ 7109                  ; ---------------------------------------------------------------
 575+ 7109                  ; Calcolo indirizzo bitmap dello Spectrum
 576+ 7109                  ;
 577+ 7109                  ; Ogni item occupa una cella attributi (8x8 pixel).
 578+ 7109                  ;
 579+ 7109                  ; Formula:
 580+ 7109                  ;   High = $40 + (Row AND $18)
 581+ 7109                  ;   Low  = (Row AND 7) * 32 + Col
 582+ 7109                  ;
 583+ 7109                  ; DE conterrà l'indirizzo della prima scanline.
 584+ 7109                  ; ---------------------------------------------------------------
 585+ 7109
 586+ 7109 78               ld   a, b
 587+ 710A E6 18            and  $18
 588+ 710C C6 40            add  a, $40
 589+ 710E 57               ld   d, a              ; Byte alto indirizzo video
 590+ 710F
 591+ 710F 78               ld   a, b
 592+ 7110 E6 07            and  7                 ; Riga interna al blocco da 8
 593+ 7112
 594+ 7112 87               add  a, a              ; *2
 595+ 7113 87               add  a, a              ; *4
 596+ 7114 87               add  a, a              ; *8
 597+ 7115 87               add  a, a              ; *16
 598+ 7116 87               add  a, a              ; *32
 599+ 7117
 600+ 7117 81               add  a, c              ; + colonna
 601+ 7118
 602+ 7118 5F               ld   e, a              ; Byte basso indirizzo video
 603+ 7119
 604+ 7119                  ; ---------------------------------------------------------------
 605+ 7119                  ; Disegno bitmap
 606+ 7119                  ;
 607+ 7119                  ; Copia 8 byte consecutivi nella memoria video.
 608+ 7119                  ; Ogni byte rappresenta una scanline da 8 pixel.
 609+ 7119                  ; ---------------------------------------------------------------
 610+ 7119
 611+ 7119 C5               push bc                ; Conserva Row e Col
 612+ 711A
 613+ 711A 06 08            ld   b, 8              ; Numero scanline
 614+ 711C
 615+ 711C              .line_loop:
 616+ 711C
 617+ 711C 7E               ld   a, (hl)           ; Legge scanline bitmap
 618+ 711D 12               ld   (de), a           ; Scrive nella memoria video
 619+ 711E
 620+ 711E 14               inc  d                 ; Scanline successiva
 621+ 711F 23               inc  hl                ; Byte bitmap successivo
 622+ 7120
 623+ 7120 05               dec  b
 624+ 7121 20 F9            jr   nz, .line_loop
 625+ 7123
 626+ 7123 C1               pop  bc                ; Ripristina Row e Col
 627+ 7124
 628+ 7124                  ; ---------------------------------------------------------------
 629+ 7124                  ; Calcolo indirizzo attributo
 630+ 7124                  ;
 631+ 7124                  ; Formula:
 632+ 7124                  ;   AttrAddr = $5800 + Row * 32 + Col
 633+ 7124                  ;
 634+ 7124                  ; HL conterrà l'indirizzo della cella attributi.
 635+ 7124                  ; ---------------------------------------------------------------
 636+ 7124
 637+ 7124 26 00            ld   h, 0
 638+ 7126 68               ld   l, b              ; HL = Row
 639+ 7127
 640+ 7127 29               add  hl, hl            ; *2
 641+ 7128 29               add  hl, hl            ; *4
 642+ 7129 29               add  hl, hl            ; *8
 643+ 712A 29               add  hl, hl            ; *16
 644+ 712B 29               add  hl, hl            ; *32
 645+ 712C
 646+ 712C 79               ld   a, c              ; A = Colonna
 647+ 712D
 648+ 712D 85               add  a, l
 649+ 712E 6F               ld   l, a
 650+ 712F
 651+ 712F 30 01            jr   nc, .no_carry
 652+ 7131 24               inc  h
 653+ 7132
 654+ 7132              .no_carry:
 655+ 7132
 656+ 7132                  ; HL = Row * 32 + Col
 657+ 7132
 658+ 7132 11 00 58         ld   de, $5800
 659+ 7135 19               add  hl, de            ; HL = indirizzo attributi
 660+ 7136
 661+ 7136                  ; ---------------------------------------------------------------
 662+ 7136                  ; Recupera il colore originale dallo stack.
 663+ 7136                  ;
 664+ 7136                  ; Layout stack:
 665+ 7136                  ;   HL originale
 666+ 7136                  ;   DE originale (E = colore)
 667+ 7136                  ;   BC originale
 668+ 7136                  ; ---------------------------------------------------------------
 669+ 7136
 670+ 7136 C1               pop  bc                ; Recupera HL originale
 671+ 7137 D1               pop  de                ; Recupera DE originale
 672+ 7138
 673+ 7138                  ; ---------------------------------------------------------------
 674+ 7138                  ; Scrive l'attributo colore
 675+ 7138                  ; ---------------------------------------------------------------
 676+ 7138
 677+ 7138 7B               ld   a, e              ; A = colore
 678+ 7139 77               ld   (hl), a           ; Scrive nella RAM attributi
 679+ 713A
 680+ 713A                  ; ---------------------------------------------------------------
 681+ 713A                  ; Ripristina HL e BC originali
 682+ 713A                  ; ---------------------------------------------------------------
 683+ 713A
 684+ 713A C5               push bc
 685+ 713B E1               pop  hl                ; HL originale
 686+ 713C
 687+ 713C C1               pop  bc                ; BC originale
 688+ 713D
 689+ 713D C9               ret
 690+ 713E
 691+ 713E              ; -------------------------------------------------------------------
 692+ 713E              ; RestoreBackgroundCell
 693+ 713E              ;
 694+ 713E              ; Ripristina il contenuto originale di una cella della stanza.
 695+ 713E              ; Viene utilizzata principalmente quando un item viene raccolto:
 696+ 713E              ; invece di lasciare un "buco", la routine ridisegna il tile
 697+ 713E              ; originale presente nella mappa della stanza.
 698+ 713E              ;
 699+ 713E              ; Input:
 700+ 713E              ;   B = Row (3..18)
 701+ 713E              ;   C = Col (0..31)
 702+ 713E              ;
 703+ 713E              ; Utilizza:
 704+ 713E              ;   room_ptr -> struttura dati della stanza corrente
 705+ 713E              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 706+ 713E              ;   DrawTile -> ridisegna il tile selezionato
 707+ 713E              ;
 708+ 713E              ; Tipi di cella:
 709+ 713E              ;   0 = Background
 710+ 713E              ;   1 = Floor
 711+ 713E              ;   2 = Wall
 712+ 713E              ;   3 = Nasty
 713+ 713E              ; -------------------------------------------------------------------
 714+ 713E              RestoreBackgroundCell:
 715+ 713E
 716+ 713E                  ; Salva tutti i registri utilizzati
 717+ 713E FD E5            push iy
 718+ 7140 C5               push bc
 719+ 7141 D5               push de
 720+ 7142 E5               push hl
 721+ 7143 DD E5            push ix
 722+ 7145
 723+ 7145                  ; ---------------------------------------------------------------
 724+ 7145                  ; Conserva Row e Col in IY.
 725+ 7145                  ;
 726+ 7145                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 727+ 7145                  ; BC potrebbe essere modificato.
 728+ 7145                  ; ---------------------------------------------------------------
 729+ 7145 C5               push bc
 730+ 7146 FD E1            pop  iy                ; IYH = Row, IYL = Col
 731+ 7148
 732+ 7148                  ; ---------------------------------------------------------------
 733+ 7148                  ; Determina quale tipo di cella è presente nella posizione
 734+ 7148                  ; specificata.
 735+ 7148                  ;
 736+ 7148                  ; Input:
 737+ 7148                  ;   B = Row
 738+ 7148                  ;   C = Col
 739+ 7148                  ;
 740+ 7148                  ; Output:
 741+ 7148                  ;   A = tipo cella
 742+ 7148                  ; ---------------------------------------------------------------
 743+ 7148 78               ld   a, b
 744+ 7149
 745+ 7149 CD DF 6A         call GetCellFromUnpacked
 746+ 714C
 747+ 714C                  ; ---------------------------------------------------------------
 748+ 714C                  ; Recupera il puntatore alla stanza corrente.
 749+ 714C                  ;
 750+ 714C                  ; DE = base della struttura stanza
 751+ 714C                  ; ---------------------------------------------------------------
 752+ 714C ED 5B D1 75      ld   de, (room_ptr)
 753+ 7150
 754+ 7150                  ; ---------------------------------------------------------------
 755+ 7150                  ; Seleziona il tile corretto in base al tipo di cella.
 756+ 7150                  ;
 757+ 7150                  ; A = 0 -> Background
 758+ 7150                  ; A = 1 -> Floor
 759+ 7150                  ; A = 2 -> Wall
 760+ 7150                  ; A = 3 -> Nasty
 761+ 7150                  ; ---------------------------------------------------------------
 762+ 7150
 763+ 7150 B7               or   a
 764+ 7151 20 06            jr   nz, .not_bg
 765+ 7153
 766+ 7153                  ; Background
 767+ 7153 21 A0 00         ld   hl, OFFSET_BG
 768+ 7156 19               add  hl, de
 769+ 7157 18 16            jr   .draw_cell
 770+ 7159
 771+ 7159              .not_bg:
 772+ 7159
 773+ 7159 3D               dec  a
 774+ 715A 20 06            jr   nz, .not_floor
 775+ 715C
 776+ 715C                  ; Floor
 777+ 715C 21 A9 00         ld   hl, OFFSET_FLOOR
 778+ 715F 19               add  hl, de
 779+ 7160 18 0D            jr   .draw_cell
 780+ 7162
 781+ 7162              .not_floor:
 782+ 7162
 783+ 7162 3D               dec  a
 784+ 7163 20 06            jr   nz, .not_wall
 785+ 7165
 786+ 7165                  ; Wall
 787+ 7165 21 B2 00         ld   hl, OFFSET_WALL
 788+ 7168 19               add  hl, de
 789+ 7169 18 04            jr   .draw_cell
 790+ 716B
 791+ 716B              .not_wall:
 792+ 716B
 793+ 716B                  ; Nasty
 794+ 716B 21 BB 00         ld   hl, OFFSET_NASTY
 795+ 716E 19               add  hl, de
 796+ 716F
 797+ 716F              .draw_cell:
 798+ 716F
 799+ 716F                  ; ---------------------------------------------------------------
 800+ 716F                  ; HL punta ora alla grafica del tile da ridisegnare.
 801+ 716F                  ;
 802+ 716F                  ; DrawTile si aspetta:
 803+ 716F                  ;   IX = puntatore tile
 804+ 716F                  ;   B  = Row
 805+ 716F                  ;   C  = Col
 806+ 716F                  ; ---------------------------------------------------------------
 807+ 716F E5               push hl
 808+ 7170 DD E1            pop  ix
 809+ 7172
 810+ 7172                  ; Ripristina Row e Col salvati in IY
 811+ 7172 FD E5            push iy
 812+ 7174 C1               pop  bc
 813+ 7175
 814+ 7175                  ; Disegna il tile originale
 815+ 7175 CD 8C 61         call DrawTile
 816+ 7178
 817+ 7178                  ; ---------------------------------------------------------------
 818+ 7178                  ; Ripristina i registri salvati
 819+ 7178                  ; ---------------------------------------------------------------
 820+ 7178 DD E1            pop  ix
 821+ 717A E1               pop  hl
 822+ 717B D1               pop  de
 823+ 717C C1               pop  bc
 824+ 717D FD E1            pop  iy
 825+ 717F
 826+ 717F C9               ret
 827+ 7180
 828+ 7180              ; -------------------------------------------------------------------
 829+ 7180              ; CheckWillyItemCollision
 830+ 7180              ;
 831+ 7180              ; Verifica se Willy collide con un item utilizzando il controllo
 832+ 7180              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 833+ 7180              ;
 834+ 7180              ; Input:
 835+ 7180              ;   A = ItemX (colonna attributi 0..31)
 836+ 7180              ;   H = ItemY (riga attributi 3..18)
 837+ 7180              ;
 838+ 7180              ; Coordinate item:
 839+ 7180              ;   Ogni item occupa una cella da 8x8 pixel.
 840+ 7180              ;
 841+ 7180              ; Coordinate Willy:
 842+ 7180              ;   Willy occupa un rettangolo di 16x16 pixel.
 843+ 7180              ;
 844+ 7180              ; Output:
 845+ 7180              ;   Carry Set   = collisione rilevata
 846+ 7180              ;   Carry Clear = nessuna collisione
 847+ 7180              ;
 848+ 7180              ; Registri preservati:
 849+ 7180              ;   BC, DE, HL
 850+ 7180              ; -------------------------------------------------------------------
 851+ 7180              CheckWillyItemCollision:
 852+ 7180
 853+ 7180                  ; Salva i registri utilizzati
 854+ 7180 C5               push bc
 855+ 7181 D5               push de
 856+ 7182 E5               push hl
 857+ 7183
 858+ 7183                  ; ---------------------------------------------------------------
 859+ 7183                  ; Calcola il bounding box orizzontale dell'item
 860+ 7183                  ;
 861+ 7183                  ; ItemLeft  = ItemX * 8
 862+ 7183                  ; ItemRight = ItemLeft + 7
 863+ 7183                  ;
 864+ 7183                  ; E = ItemLeft
 865+ 7183                  ; D = ItemRight
 866+ 7183                  ; ---------------------------------------------------------------
 867+ 7183 6F               ld   l, a              ; L = ItemX
 868+ 7184
 869+ 7184 7D               ld   a, l
 870+ 7185 87               add  a, a              ; *2
 871+ 7186 87               add  a, a              ; *4
 872+ 7187 87               add  a, a              ; *8
 873+ 7188
 874+ 7188 5F               ld   e, a              ; E = ItemLeft
 875+ 7189
 876+ 7189 C6 07            add  a, 7
 877+ 718B 57               ld   d, a              ; D = ItemRight
 878+ 718C
 879+ 718C                  ; ---------------------------------------------------------------
 880+ 718C                  ; Recupera la posizione corrente di Willy
 881+ 718C                  ;
 882+ 718C                  ; B = WillyY
 883+ 718C                  ; C = WillyX
 884+ 718C                  ; ---------------------------------------------------------------
 885+ 718C ED 4B 61 72      ld   bc, (PlayerPos)
 886+ 7190
 887+ 7190                  ; ---------------------------------------------------------------
 888+ 7190                  ; Primo test:
 889+ 7190                  ;
 890+ 7190                  ; WillyLeft <= ItemRight
 891+ 7190                  ;
 892+ 7190                  ; Se Willy è completamente a destra dell'item
 893+ 7190                  ; non può esserci collisione.
 894+ 7190                  ; ---------------------------------------------------------------
 895+ 7190 79               ld   a, c              ; A = WillyLeft
 896+ 7191
 897+ 7191 BA               cp   d                 ; WillyLeft vs ItemRight
 898+ 7192
 899+ 7192 28 04            jr   z, .x_ok
 900+ 7194 38 02            jr   c, .x_ok
 901+ 7196
 902+ 7196 18 29            jr   .no_collision
 903+ 7198
 904+ 7198              .x_ok:
 905+ 7198
 906+ 7198                  ; ---------------------------------------------------------------
 907+ 7198                  ; Secondo test:
 908+ 7198                  ;
 909+ 7198                  ; WillyRight >= ItemLeft
 910+ 7198                  ;
 911+ 7198                  ; WillyRight = WillyX + 7
 912+ 7198                  ; ---------------------------------------------------------------
 913+ 7198 C6 07            add  a, 7
 914+ 719A
 915+ 719A BB               cp   e                 ; WillyRight vs ItemLeft
 916+ 719B
 917+ 719B 28 04            jr   z, .y_check
 918+ 719D 30 02            jr   nc, .y_check
 919+ 719F
 920+ 719F 18 20            jr   .no_collision
 921+ 71A1
 922+ 71A1              .y_check:
 923+ 71A1
 924+ 71A1                  ; ---------------------------------------------------------------
 925+ 71A1                  ; Recupera ItemY dal valore originale di HL
 926+ 71A1                  ;
 927+ 71A1                  ; H contiene la riga dell'item.
 928+ 71A1                  ; ---------------------------------------------------------------
 929+ 71A1 E1               pop  hl
 930+ 71A2 E5               push hl
 931+ 71A3
 932+ 71A3                  ; ---------------------------------------------------------------
 933+ 71A3                  ; Calcola il bounding box verticale dell'item
 934+ 71A3                  ;
 935+ 71A3                  ; ItemTop    = ItemY * 8
 936+ 71A3                  ; ItemBottom = ItemTop + 7
 937+ 71A3                  ;
 938+ 71A3                  ; E = ItemTop
 939+ 71A3                  ; D = ItemBottom
 940+ 71A3                  ; ---------------------------------------------------------------
 941+ 71A3 7C               ld   a, h
 942+ 71A4
 943+ 71A4 87               add  a, a              ; *2
 944+ 71A5 87               add  a, a              ; *4
 945+ 71A6 87               add  a, a              ; *8
 946+ 71A7
 947+ 71A7 5F               ld   e, a              ; ItemTop
 948+ 71A8
 949+ 71A8 C6 07            add  a, 7
 950+ 71AA 57               ld   d, a              ; ItemBottom
 951+ 71AB
 952+ 71AB                  ; ---------------------------------------------------------------
 953+ 71AB                  ; Primo test verticale:
 954+ 71AB                  ;
 955+ 71AB                  ; WillyTop <= ItemBottom
 956+ 71AB                  ; ---------------------------------------------------------------
 957+ 71AB 78               ld   a, b              ; WillyTop
 958+ 71AC
 959+ 71AC BA               cp   d
 960+ 71AD
 961+ 71AD 28 04            jr   z, .y_ok
 962+ 71AF 38 02            jr   c, .y_ok
 963+ 71B1
 964+ 71B1 18 0E            jr   .no_collision
 965+ 71B3
 966+ 71B3              .y_ok:
 967+ 71B3
 968+ 71B3                  ; ---------------------------------------------------------------
 969+ 71B3                  ; Secondo test verticale:
 970+ 71B3                  ;
 971+ 71B3                  ; WillyBottom >= ItemTop
 972+ 71B3                  ;
 973+ 71B3                  ; WillyBottom = WillyY + 15
 974+ 71B3                  ; ---------------------------------------------------------------
 975+ 71B3 C6 0F            add  a, 15
 976+ 71B5
 977+ 71B5 BB               cp   e
 978+ 71B6
 979+ 71B6 28 04            jr   z, .collision
 980+ 71B8 30 02            jr   nc, .collision
 981+ 71BA
 982+ 71BA 18 05            jr   .no_collision
 983+ 71BC
 984+ 71BC              .collision:
 985+ 71BC
 986+ 71BC                  ; ---------------------------------------------------------------
 987+ 71BC                  ; Collisione rilevata
 988+ 71BC                  ; ---------------------------------------------------------------
 989+ 71BC E1               pop  hl
 990+ 71BD D1               pop  de
 991+ 71BE C1               pop  bc
 992+ 71BF
 993+ 71BF 37               scf                    ; Carry = 1
 994+ 71C0
 995+ 71C0 C9               ret
 996+ 71C1
 997+ 71C1              .no_collision:
 998+ 71C1
 999+ 71C1                  ; ---------------------------------------------------------------
1000+ 71C1                  ; Nessuna collisione
1001+ 71C1                  ; ---------------------------------------------------------------
1002+ 71C1 E1               pop  hl
1003+ 71C2 D1               pop  de
1004+ 71C3 C1               pop  bc
1005+ 71C4
1006+ 71C4 B7               or   a                 ; Carry = 0
1007+ 71C5
1008+ 71C5 C9               ret
1009+ 71C6
1010+ 71C6              ; -------------------------------------------------------------------
1011+ 71C6              ; CheckRoomItemsCollision
1012+ 71C6              ;
1013+ 71C6              ; Controlla se Willy entra in collisione con uno degli item
1014+ 71C6              ; attivi presenti nella stanza corrente.
1015+ 71C6              ;
1016+ 71C6              ; Per ogni item:
1017+ 71C6              ;   - verifica che appartenga alla stanza corrente
1018+ 71C6              ;   - verifica che non sia già stato raccolto
1019+ 71C6              ;   - esegue il test di collisione con Willy
1020+ 71C6              ;
1021+ 71C6              ; Se l'item viene raccolto:
1022+ 71C6              ;   - imposta il flag "collected"
1023+ 71C6              ;   - rimuove l'item dalla cache items_grid
1024+ 71C6              ;   - incrementa il contatore degli oggetti raccolti
1025+ 71C6              ;   - aggiorna l'HUD
1026+ 71C6              ;   - ripristina il tile di sfondo
1027+ 71C6              ;   - riproduce il suono di raccolta
1028+ 71C6              ;
1029+ 71C6              ; Formato record ItemsTable:
1030+ 71C6              ;   +0 RoomID
1031+ 71C6              ;   +1 X
1032+ 71C6              ;   +2 Y
1033+ 71C6              ;   +3 Color
1034+ 71C6              ;   +4 Collected
1035+ 71C6              ;
1036+ 71C6              ; Fine tabella:
1037+ 71C6              ;   RoomID = $FF
1038+ 71C6              ; -------------------------------------------------------------------
1039+ 71C6              CheckRoomItemsCollision:
1040+ 71C6
1041+ 71C6                  ; Salva i registri utilizzati
1042+ 71C6 E5               push hl
1043+ 71C7 D5               push de
1044+ 71C8 C5               push bc
1045+ 71C9
1046+ 71C9                  ; Inizio scansione della tabella degli item
1047+ 71C9 21 2D 6F         ld   hl, ItemsTable
1048+ 71CC
1049+ 71CC              .loop:
1050+ 71CC
1051+ 71CC                  ; ---------------------------------------------------------------
1052+ 71CC                  ; Legge il Room ID dell'item corrente
1053+ 71CC                  ; ---------------------------------------------------------------
1054+ 71CC 7E               ld   a, (hl)
1055+ 71CD
1056+ 71CD                  ; $FF indica fine tabella
1057+ 71CD FE FF            cp   $FF
1058+ 71CF 28 4D            jr   z, .done
1059+ 71D1
1060+ 71D1                  ; ---------------------------------------------------------------
1061+ 71D1                  ; Verifica se l'item appartiene alla stanza corrente
1062+ 71D1                  ; ---------------------------------------------------------------
1063+ 71D1 57               ld   d, a              ; D = RoomID item
1064+ 71D2
1065+ 71D2 3A 77 75         ld   a, (current_room)
1066+ 71D5 BA               cp   d
1067+ 71D6
1068+ 71D6                  ; Se appartiene a un'altra stanza salta il record
1069+ 71D6 20 3F            jr   nz, .next_item
1070+ 71D8
1071+ 71D8                  ; ---------------------------------------------------------------
1072+ 71D8                  ; Legge coordinate e stato dell'item
1073+ 71D8                  ; ---------------------------------------------------------------
1074+ 71D8
1075+ 71D8 23               inc  hl
1076+ 71D9 4E               ld   c, (hl)           ; C = X
1077+ 71DA
1078+ 71DA 23               inc  hl
1079+ 71DB 46               ld   b, (hl)           ; B = Y
1080+ 71DC
1081+ 71DC 23               inc  hl                ; salta Color
1082+ 71DD
1083+ 71DD 23               inc  hl                ; punta a Collected
1084+ 71DE
1085+ 71DE 7E               ld   a, (hl)
1086+ 71DF
1087+ 71DF                  ; ---------------------------------------------------------------
1088+ 71DF                  ; Item già raccolto?
1089+ 71DF                  ; ---------------------------------------------------------------
1090+ 71DF B7               or   a
1091+ 71E0 20 39            jr   nz, .next_no_inc
1092+ 71E2
1093+ 71E2                  ; ---------------------------------------------------------------
1094+ 71E2                  ; Test collisione Willy ↔ Item
1095+ 71E2                  ;
1096+ 71E2                  ; Input richiesto:
1097+ 71E2                  ;   A = ItemX
1098+ 71E2                  ;   H = ItemY
1099+ 71E2                  ; ---------------------------------------------------------------
1100+ 71E2 79               ld   a, c
1101+ 71E3
1102+ 71E3 E5               push hl                ; salva puntatore al flag Collected
1103+ 71E4
1104+ 71E4 60               ld   h, b
1105+ 71E5
1106+ 71E5 CD 80 71         call CheckWillyItemCollision
1107+ 71E8
1108+ 71E8 E1               pop  hl
1109+ 71E9
1110+ 71E9                  ; Nessuna collisione
1111+ 71E9 30 30            jr   nc, .next_no_inc
1112+ 71EB
1113+ 71EB                  ; ===============================================================
1114+ 71EB                  ; ITEM RACCOLTO
1115+ 71EB                  ; ===============================================================
1116+ 71EB
1117+ 71EB                  ; ---------------------------------------------------------------
1118+ 71EB                  ; Marca l'item come raccolto
1119+ 71EB                  ; ---------------------------------------------------------------
1120+ 71EB 36 01            ld   (hl), 1
1121+ 71ED
1122+ 71ED                  ; ---------------------------------------------------------------
1123+ 71ED                  ; Rimuove l'item dalla cache items_grid
1124+ 71ED                  ;
1125+ 71ED                  ; Calcolo:
1126+ 71ED                  ;   offset = Row * 32 + Col
1127+ 71ED                  ; ---------------------------------------------------------------
1128+ 71ED E5               push hl
1129+ 71EE D5               push de
1130+ 71EF
1131+ 71EF 26 00            ld   h, 0
1132+ 71F1 68               ld   l, b              ; HL = Row
1133+ 71F2
1134+ 71F2 29               add  hl, hl            ; *2
1135+ 71F3 29               add  hl, hl            ; *4
1136+ 71F4 29               add  hl, hl            ; *8
1137+ 71F5 29               add  hl, hl            ; *16
1138+ 71F6 29               add  hl, hl            ; *32
1139+ 71F7
1140+ 71F7 59               ld   e, c
1141+ 71F8 16 00            ld   d, 0
1142+ 71FA
1143+ 71FA 19               add  hl, de            ; Row*32 + Col
1144+ 71FB
1145+ 71FB 11 00 90         ld   de, items_grid
1146+ 71FE 19               add  hl, de
1147+ 71FF
1148+ 71FF                  ; La cella non contiene più un item
1149+ 71FF 36 00            ld   (hl), 0
1150+ 7201
1151+ 7201 D1               pop  de
1152+ 7202 E1               pop  hl
1153+ 7203
1154+ 7203                  ; ---------------------------------------------------------------
1155+ 7203                  ; Conserva il puntatore all'entry corrente
1156+ 7203                  ; poiché le routine successive possono alterare HL.
1157+ 7203                  ; ---------------------------------------------------------------
1158+ 7203 E5               push hl
1159+ 7204
1160+ 7204                  ; ---------------------------------------------------------------
1161+ 7204                  ; Aggiorna il numero di oggetti raccolti
1162+ 7204                  ; ---------------------------------------------------------------
1163+ 7204 3A 6B 72         ld   a, (items_collected)
1164+ 7207
1165+ 7207 3C               inc  a
1166+ 7208
1167+ 7208 32 6B 72         ld   (items_collected), a
1168+ 720B
1169+ 720B                  ; ---------------------------------------------------------------
1170+ 720B                  ; Aggiorna il contatore visualizzato a schermo
1171+ 720B                  ; ---------------------------------------------------------------
1172+ 720B CD CB 60         call UpdateItemsCollectedDisplay
1173+ 720E
1174+ 720E                  ; ---------------------------------------------------------------
1175+ 720E                  ; Ripristina il tile originale della stanza
1176+ 720E                  ; eliminando la grafica dell'item.
1177+ 720E                  ;
1178+ 720E                  ; Input:
1179+ 720E                  ;   B = Row
1180+ 720E                  ;   C = Col
1181+ 720E                  ; ---------------------------------------------------------------
1182+ 720E CD 3E 71         call RestoreBackgroundCell
1183+ 7211
1184+ 7211                  ; ---------------------------------------------------------------
1185+ 7211                  ; Riproduce il suono di raccolta
1186+ 7211                  ; ---------------------------------------------------------------
1187+ 7211 CD 22 72         call PlayCollectSound
1188+ 7214
1189+ 7214                  ; Ripristina il puntatore alla tabella
1190+ 7214 E1               pop  hl
1191+ 7215
1192+ 7215                  ; Continua con il record successivo
1193+ 7215 18 04            jr   .next_no_inc
1194+ 7217
1195+ 7217              .next_item:
1196+ 7217
1197+ 7217                  ; ---------------------------------------------------------------
1198+ 7217                  ; Salta i campi del record:
1199+ 7217                  ;   X
1200+ 7217                  ;   Y
1201+ 7217                  ;   Color
1202+ 7217                  ;   Collected
1203+ 7217                  ; ---------------------------------------------------------------
1204+ 7217 23               inc  hl
1205+ 7218 23               inc  hl
1206+ 7219 23               inc  hl
1207+ 721A 23               inc  hl
1208+ 721B
1209+ 721B              .next_no_inc:
1210+ 721B
1211+ 721B                  ; ---------------------------------------------------------------
1212+ 721B                  ; Avanza al record successivo.
1213+ 721B                  ;
1214+ 721B                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1215+ 721B                  ; ---------------------------------------------------------------
1216+ 721B 23               inc  hl
1217+ 721C
1218+ 721C 18 AE            jr   .loop
1219+ 721E
1220+ 721E              .done:
1221+ 721E
1222+ 721E                  ; Ripristina i registri
1223+ 721E C1               pop  bc
1224+ 721F D1               pop  de
1225+ 7220 E1               pop  hl
1226+ 7221
1227+ 7221 C9               ret
1228+ 7222
1229+ 7222              ; -------------------------------------------------------------------
1230+ 7222              ; PlayCollectSound
1231+ 7222              ;
1232+ 7222              ; Genera un breve effetto sonoro (beep) tramite il buzzer
1233+ 7222              ; dello ZX Spectrum utilizzando il port $FE.
1234+ 7222              ;
1235+ 7222              ; Il suono viene prodotto alternando ON/OFF del bit 4
1236+ 7222              ; (speaker) con un semplice delay software.
1237+ 7222              ;
1238+ 7222              ; Effetto risultante:
1239+ 7222              ;   beep breve tipo "pickup item"
1240+ 7222              ; -------------------------------------------------------------------
1241+ 7222              PlayCollectSound:
1242+ 7222
1243+ 7222                  ; Salva registri utilizzati
1244+ 7222 C5               push bc
1245+ 7223 D5               push de
1246+ 7224
1247+ 7224                  ; ---------------------------------------------------------------
1248+ 7224                  ; Numero di cicli del beep (durata complessiva del suono)
1249+ 7224                  ; ---------------------------------------------------------------
1250+ 7224 06 78            ld   b, 120
1251+ 7226
1252+ 7226              .sound_loop:
1253+ 7226
1254+ 7226                  ; ---------------------------------------------------------------
1255+ 7226                  ; SPEAKER ON
1256+ 7226                  ;
1257+ 7226                  ; Legge il colore del bordo corrente e attiva il bit 4
1258+ 7226                  ; per pilotare lo speaker.
1259+ 7226                  ; ---------------------------------------------------------------
1260+ 7226 3A 6D 72         ld   a, (room_border_color)
1261+ 7229 F6 10            or   $10               ; bit 4 = 1 → speaker ON
1262+ 722B
1263+ 722B D3 FE            out  ($fe), a         ; scrive sul port ULA
1264+ 722D
1265+ 722D                  ; ---------------------------------------------------------------
1266+ 722D                  ; Delay (mezzo periodo)
1267+ 722D                  ; Loop software a consumo CPU
1268+ 722D                  ; ---------------------------------------------------------------
1269+ 722D 0E 3C            ld   c, 60
1270+ 722F
1271+ 722F              .d1:
1272+ 722F 0D               dec  c
1273+ 7230 20 FD            jr   nz, .d1
1274+ 7232
1275+ 7232                  ; ---------------------------------------------------------------
1276+ 7232                  ; SPEAKER OFF
1277+ 7232                  ;
1278+ 7232                  ; Mantiene il colore del bordo ma disattiva lo speaker
1279+ 7232                  ; ---------------------------------------------------------------
1280+ 7232 3A 6D 72         ld   a, (room_border_color)
1281+ 7235 E6 EF            and  $ef              ; bit 4 = 0 → speaker OFF
1282+ 7237
1283+ 7237 D3 FE            out  ($fe), a
1284+ 7239
1285+ 7239                  ; ---------------------------------------------------------------
1286+ 7239                  ; Secondo delay (mezzo periodo)
1287+ 7239                  ; Completa l’onda quadra
1288+ 7239                  ; ---------------------------------------------------------------
1289+ 7239 0E 3C            ld   c, 60
1290+ 723B
1291+ 723B              .d2:
1292+ 723B 0D               dec  c
1293+ 723C 20 FD            jr   nz, .d2
1294+ 723E
1295+ 723E                  ; ---------------------------------------------------------------
1296+ 723E                  ; Ripete fino a completare il numero di cicli
1297+ 723E                  ; ---------------------------------------------------------------
1298+ 723E 10 E6            djnz .sound_loop
1299+ 7240
1300+ 7240                  ; Ripristina registri salvati
1301+ 7240 D1               pop  de
1302+ 7241 C1               pop  bc
1303+ 7242
1304+ 7242 C9               ret
1305+ 7243
1306+ 7243              ; -------------------------------------------------------------------
1307+ 7243              ; CheckActiveItemAtCell
1308+ 7243              ;
1309+ 7243              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1310+ 7243              ; nella cella specificata della griglia items_grid.
1311+ 7243              ;
1312+ 7243              ; Questa routine usa una lookup diretta su una mappa 32x16,
1313+ 7243              ; evitando la scansione della ItemsTable.
1314+ 7243              ;
1315+ 7243              ; Input:
1316+ 7243              ;   B = Colonna (0..31)
1317+ 7243              ;   C = Riga (0..15)
1318+ 7243              ;
1319+ 7243              ; Output:
1320+ 7243              ;   Carry Set   = item presente nella cella
1321+ 7243              ;   Carry Clear = nessun item
1322+ 7243              ;
1323+ 7243              ; Nota:
1324+ 7243              ;   HL NON è restituito valido (commento originale non corretto:
1325+ 7243              ;   la routine non punta a ItemsTable).
1326+ 7243              ; -------------------------------------------------------------------
1327+ 7243              CheckActiveItemAtCell:
1328+ 7243
1329+ 7243                  ; Salva registri usati
1330+ 7243 D5               push de
1331+ 7244 E5               push hl
1332+ 7245
1333+ 7245                  ; ---------------------------------------------------------------
1334+ 7245                  ; Calcolo indice lineare nella griglia 32x16:
1335+ 7245                  ;
1336+ 7245                  ; offset = Row * 32 + Col
1337+ 7245                  ; ---------------------------------------------------------------
1338+ 7245 26 00            ld   h, 0
1339+ 7247 69               ld   l, c              ; HL = Row
1340+ 7248
1341+ 7248 29               add  hl, hl            ; *2
1342+ 7249 29               add  hl, hl            ; *4
1343+ 724A 29               add  hl, hl            ; *8
1344+ 724B 29               add  hl, hl            ; *16
1345+ 724C 29               add  hl, hl            ; *32
1346+ 724D
1347+ 724D                  ; Aggiunge la colonna
1348+ 724D 58               ld   e, b
1349+ 724E 16 00            ld   d, 0
1350+ 7250 19               add  hl, de            ; HL = Row*32 + Col
1351+ 7251
1352+ 7251                  ; ---------------------------------------------------------------
1353+ 7251                  ; Accesso alla griglia degli item attivi
1354+ 7251                  ; ---------------------------------------------------------------
1355+ 7251 11 00 90         ld   de, items_grid
1356+ 7254 19               add  hl, de            ; HL = address cella
1357+ 7255
1358+ 7255                  ; ---------------------------------------------------------------
1359+ 7255                  ; Controllo presenza item
1360+ 7255                  ;
1361+ 7255                  ; items_grid contiene:
1362+ 7255                  ;   0 = nessun item
1363+ 7255                  ;   >0 = item attivo (colore o flag)
1364+ 7255                  ; ---------------------------------------------------------------
1365+ 7255 7E               ld   a, (hl)
1366+ 7256 B7               or   a
1367+ 7257 28 04            jr   z, .not_active
1368+ 7259
1369+ 7259                  ; ---------------------------------------------------------------
1370+ 7259                  ; Item trovato
1371+ 7259                  ; ---------------------------------------------------------------
1372+ 7259 E1               pop  hl
1373+ 725A D1               pop  de
1374+ 725B
1375+ 725B 37               scf                    ; Carry = 1
1376+ 725C C9               ret
1377+ 725D
