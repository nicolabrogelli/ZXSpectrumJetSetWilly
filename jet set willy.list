 205+ 854C 0D               dec  c
 206+ 854D 20 FD            jr   nz, .d2
 207+ 854F
 208+ 854F 10 E6            djnz .sound_loop
 209+ 8551
 210+ 8551 D1               pop  de
 211+ 8552 C1               pop  bc
 212+ 8553 C9               ret
