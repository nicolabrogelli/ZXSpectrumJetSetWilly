 125+ 75DC 21 09 76         ld   hl, Audio_MusicSheet
 126+ 75DF 19               add  hl, de
 127+ 75E0 19               add  hl, de                   ; hl punta al primo byte della nota
 128+ 75E1 7E               ld   a, (hl)                  ; A = delay
 129+ 75E2 B7               or   a
 130+ 75E3 28 1F            jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 131+ 75E5
 132+ 75E5                  ; Suona la nota: 2 cicli
 133+ 75E5 57               ld   d, a                     ; D = delay
 134+ 75E6 06 02            ld   b, 2                     ; 2 cicli per frame
