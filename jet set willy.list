 469+ 5FC7 23               inc  hl
 470+ 5FC8 7B               ld   a, e
 471+ 5FC9 C6 10            add  a, 16
 472+ 5FCB CD 74 5E         call GetBackgroundByte
 473+ 5FCE 77               ld   (hl), a
