 665  8D1B                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 666  8D1B C3 26 8B         jp   ShowTitleScreen
 667  8D1E
 668  8D1E              .play_again_chosen:
 669  8D1E                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 670  8D1E              .wait_play_again_release:
 671  8D1E 76               halt
 672  8D1F 01 FE DF         ld   bc, $dffe
 673  8D22 ED 78            in   a, (c)
 674  8D24 CB 67            bit  4, a
 675  8D26 28 F6            jr   z, .wait_play_again_release
 676  8D28
 677  8D28                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 678  8D28 CD E8 8D         call ResetFullGameState
 679  8D2B C3 02 8A         jp   LoadRoomAndRestart
 680  8D2E
 681  8D2E              ; -------------------------------------------------------------------
 682  8D2E              ; CheckVictoryCondition
 683  8D2E              ; Verifica se si verificano contemporaneamente tutte le 3 condizioni di vittoria:
 684  8D2E              ; 1. Willy ha raccolto tutti gli oggetti collezionabili del gioco (tutti i flag in ItemsTable = 1);
 685  8D2E              ; 2. Willy si trova nella stanza Master Bedroom;
 686  8D2E              ; 3. Willy collide con un oggetto/tag di tipo Conveyor in quella stanza.
 687  8D2E              ;
 688  8D2E              ; Output:
 689  8D2E              ;   Carry Flag = 1 se la vittoria è attivata
 690  8D2E              ;   Carry Flag = 0 altrimenti
 691  8D2E              ; -------------------------------------------------------------------
 692  8D2E              CheckVictoryCondition:
 693  8D2E C5               push bc
 694  8D2F D5               push de
 695  8D30 E5               push hl
 696  8D31
 697  8D31                  ; 1. Condizione: tutti gli item raccolti?
 698  8D31 CD 4A 8D         call CheckAllItemsCollected
 699  8D34 30 0F            jr   nc, .no_victory
 700  8D36
 701  8D36                  ; 2. Condizione: Willy è nella Master Bedroom?
 702  8D36 CD 71 8D         call CheckInMasterBedroom
 703  8D39 30 0A            jr   nc, .no_victory
 704  8D3B
 705  8D3B                  ; 3. Condizione: Willy collide con il conveyor?
 706  8D3B CD 8D 8D         call CheckWillyConveyorCollision
 707  8D3E 30 05            jr   nc, .no_victory
 708  8D40
 709  8D40                  ; Tutte le condizioni sono soddisfatte contemporaneamente!
 710  8D40 E1               pop  hl
 711  8D41 D1               pop  de
 712  8D42 C1               pop  bc
 713  8D43 37               scf
 714  8D44 C9               ret
 715  8D45
 716  8D45              .no_victory:
 717  8D45 E1               pop  hl
 718  8D46 D1               pop  de
 719  8D47 C1               pop  bc
 720  8D48 B7               or   a
 721  8D49 C9               ret
 722  8D4A
 723  8D4A              ; -------------------------------------------------------------------
 724  8D4A              ; CheckAllItemsCollected
 725  8D4A              ; Verifica che tutti gli item del gioco siano stati raccolti.
 726  8D4A              ; - Controllo preliminare sul conteggio/flag globale
 727  8D4A              ; - Verifica puntuale che ogni record in ItemsTable abbia flag = 1 (raccolto)
 728  8D4A              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 729  8D4A              ; -------------------------------------------------------------------
 730  8D4A              CheckAllItemsCollected:
 731  8D4A E5               push hl
 732  8D4B 3A FA FB         ld   a, (game_objective_completed)
 733  8D4E B7               or   a
 734  8D4F 20 07            jr   nz, .verify_flags
 735  8D51 3A F2 F7         ld   a, (items_collected)
 736  8D54 FE 4D            cp   TOTAL_ITEMS
 737  8D56 38 16            jr   c, .not_all
 738  8D58
 739  8D58              .verify_flags:
 740  8D58 21 FB 80         ld   hl, ItemsTable
 741  8D5B              .loop:
 742  8D5B 7E               ld   a, (hl)
 743  8D5C FE FF            cp   $FF
 744  8D5E 28 0B            jr   z, .done_all
 745  8D60 23               inc  hl                    ; +1 X
 746  8D61 23               inc  hl                    ; +2 Y
 747  8D62 23               inc  hl                    ; +3 Color
 748  8D63 23               inc  hl                    ; +4 Collected flag
 749  8D64 7E               ld   a, (hl)
 750  8D65 B7               or   a
 751  8D66 28 06            jr   z, .not_all           ; Trovato un item non raccolto -> fail
 752  8D68 23               inc  hl                    ; Prossimo record
 753  8D69 18 F0            jr   .loop
 754  8D6B
 755  8D6B              .done_all:
 756  8D6B E1               pop  hl
 757  8D6C 37               scf
 758  8D6D C9               ret
 759  8D6E
 760  8D6E              .not_all:
 761  8D6E E1               pop  hl
 762  8D6F B7               or   a
 763  8D70 C9               ret
 764  8D71
 765  8D71              ; -------------------------------------------------------------------
 766  8D71              ; CheckInMasterBedroom
 767  8D71              ; Verifica se la stanza corrente è Master Bedroom (ID 35 / MastreBedRoomLayout)
 768  8D71              ; Output: Carry = 1 se Master Bedroom, Carry = 0 altrimenti
 769  8D71              ; -------------------------------------------------------------------
 770  8D71              CheckInMasterBedroom:
 771  8D71 E5               push hl
 772  8D72 D5               push de
 773  8D73 2A 68 FB         ld   hl, (room_ptr)
 774  8D76 11 DC B5         ld   de, MastreBedRoomLayout
 775  8D79 B7               or   a
 776  8D7A ED 52            sbc  hl, de
 777  8D7C 28 0B            jr   z, .is_master
 778  8D7E 3A 0E FB         ld   a, (current_room)
 779  8D81 FE 23            cp   ROOM_MASTER_BEDROOM
 780  8D83 28 04            jr   z, .is_master
 781  8D85 D1               pop  de
 782  8D86 E1               pop  hl
 783  8D87 B7               or   a
 784  8D88 C9               ret
 785  8D89              .is_master:
 786  8D89 D1               pop  de
 787  8D8A E1               pop  hl
 788  8D8B 37               scf
 789  8D8C C9               ret
 790  8D8D
 791  8D8D              ; -------------------------------------------------------------------
 792  8D8D              ; CheckWillyConveyorCollision
 793  8D8D              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 794  8D8D              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 795  8D8D              ; -------------------------------------------------------------------
 796  8D8D              CheckWillyConveyorCollision:
 797  8D8D C5               push bc
 798  8D8E D5               push de
 799  8D8F E5               push hl
 800  8D90
 801  8D90                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 802  8D90 CD 41 76         call CheckWillyOnConveyor
 803  8D93 38 49            jr   c, .collision_detected
 804  8D95
 805  8D95                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 806  8D95 3A 10 FB         ld   a, (conveyor_len)
 807  8D98 B7               or   a
 808  8D99 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 809  8D9B
 810  8D9B                  ; B = WillyY, C = WillyX
 811  8D9B ED 4B E8 F7      ld   bc, (PlayerPos)
 812  8D9F
 813  8D9F                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 814  8D9F 3A 11 FB         ld   a, (conveyor_row)
 815  8DA2 87               add  a, a                  ; *2
 816  8DA3 87               add  a, a                  ; *4
 817  8DA4 87               add  a, a                  ; *8
 818  8DA5 5F               ld   e, a                  ; E = ConveyorTop
 819  8DA6 C6 07            add  a, 7
 820  8DA8 57               ld   d, a                  ; D = ConveyorBottom
 821  8DA9
 822  8DA9                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 823  8DA9 78               ld   a, b                  ; WillyTop
 824  8DAA BA               cp   d
 825  8DAB 28 04            jr   z, .y_overlap
 826  8DAD 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 827  8DAF 18 32            jr   .no_conv_collision
 828  8DB1
 829  8DB1              .y_overlap:
 830  8DB1 C6 0F            add  a, 15                 ; WillyBottom
 831  8DB3 BB               cp   e
 832  8DB4 28 04            jr   z, .x_check
 833  8DB6 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 834  8DB8 18 29            jr   .no_conv_collision
