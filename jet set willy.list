  65+ 6EAD              ; Applica gravità e gestisce salto
  66+ 6EAD              ; -------------------------------------------------------------------
  67+ 6EAD              ApplyGravity:
  68+ 6EAD ED 4B B3 76      ld  bc, (PlayerPos)
  69+ 6EB1 78               ld  a, b              ; B = PlayerY (pixel)
  70+ 6EB2
  71+ 6EB2                  ; Controlla se siamo a mezz'aria (on_ground == 0)
  72+ 6EB2 3A C0 76         ld  a, (on_ground)
  73+ 6EB5 B7               or  a
  74+ 6EB6 CA EF 6E         jp  z, .in_air        ; Se siamo in volo, continua a volare
  75+ 6EB9
  76+ 6EB9                  ; Se on_ground == 1, controlliamo se siamo ancora su terreno solido
  77+ 6EB9                  ; Dobbiamo controllare i pixel direttamente sotto i piedi del player:
  78+ 6EB9                  ; (PlayerX, PlayerY + 16) e (PlayerX + 7, PlayerY + 16)
  79+ 6EB9 78               ld  a, b
  80+ 6EBA C6 10            add  a, 16
  81+ 6EBC 47               ld  b, a              ; B = PlayerY + 16
  82+ 6EBD
  83+ 6EBD                  ; Controlla se la cella sotto il piede sinistro (PlayerX, PlayerY + 16) è solida
  84+ 6EBD CD 75 6E         call CheckSolidCell
  85+ 6EC0 38 13            jr   c, .still_on_ground
  86+ 6EC2
  87+ 6EC2                  ; Controlla se la cella sotto il piede destro (PlayerX + 7, PlayerY + 16) è solida
  88+ 6EC2 79               ld   a, c
  89+ 6EC3 C6 07            add  a, 7
  90+ 6EC5 4F               ld   c, a              ; C = PlayerX + 7
  91+ 6EC6 CD 75 6E         call CheckSolidCell
  92+ 6EC9 38 0A            jr   c, .still_on_ground
  93+ 6ECB
  94+ 6ECB                  ; Se nessuna delle due è solida, iniziamo a cadere!
  95+ 6ECB AF               xor  a
  96+ 6ECC 32 C0 76         ld   (on_ground), a
