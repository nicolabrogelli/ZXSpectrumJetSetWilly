1470+ 8551              ; -------------------------------------------------------------------
1471+ 8551              ; RestoreBackgroundCell
1472+ 8551              ;
1473+ 8551              ; Ripristina il contenuto originale di una cella della stanza.
1474+ 8551              ; Viene utilizzata principalmente quando un item viene raccolto:
1475+ 8551              ; invece di lasciare un "buco", la routine ridisegna il tile
1476+ 8551              ; originale presente nella mappa della stanza.
1477+ 8551              ;
1478+ 8551              ; Input:
1479+ 8551              ;   B = Row (3..18)
1480+ 8551              ;   C = Col (0..31)
1481+ 8551              ;
1482+ 8551              ; Utilizza:
1483+ 8551              ;   room_ptr -> struttura dati della stanza corrente
1484+ 8551              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1485+ 8551              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1486+ 8551              ;
1487+ 8551              ; Tipi di cella:
1488+ 8551              ;   0 = Background
1489+ 8551              ;   1 = Floor
1490+ 8551              ;   2 = Wall
1491+ 8551              ;   3 = Nasty
1492+ 8551              ; -------------------------------------------------------------------
1493+ 8551              RestoreBackgroundCell:
1494+ 8551
1495+ 8551                  ; Salva tutti i registri utilizzati
1496+ 8551 FD E5            push iy
1497+ 8553 C5               push bc
1498+ 8554 D5               push de
1499+ 8555 E5               push hl
1500+ 8556 DD E5            push ix
1501+ 8558
1502+ 8558                  ; ---------------------------------------------------------------
1503+ 8558                  ; Conserva Row e Col in IY.
1504+ 8558                  ;
1505+ 8558                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1506+ 8558                  ; BC potrebbe essere modificato.
1507+ 8558                  ; ---------------------------------------------------------------
1508+ 8558 C5               push bc
1509+ 8559 FD E1            pop  iy                ; IYH = Row, IYL = Col
1510+ 855B
1511+ 855B                  ; ---------------------------------------------------------------
1512+ 855B                  ; Determina quale tipo di cella è presente nella posizione
1513+ 855B                  ; specificata.
1514+ 855B                  ;
1515+ 855B                  ; Input:
1516+ 855B                  ;   B = Row
1517+ 855B                  ;   C = Col
1518+ 855B                  ;
1519+ 855B                  ; Output:
1520+ 855B                  ;   A = tipo cella
1521+ 855B                  ; ---------------------------------------------------------------
1522+ 855B 78               ld   a, b
1523+ 855C
1524+ 855C CD 1E 76         call GetCellFromUnpacked
1525+ 855F
1526+ 855F                  ; ---------------------------------------------------------------
1527+ 855F                  ; Recupera il puntatore alla stanza corrente.
1528+ 855F                  ;
1529+ 855F                  ; DE = base della struttura stanza
1530+ 855F                  ; ---------------------------------------------------------------
1531+ 855F ED 5B 01 F0      ld   de, (room_ptr)
1532+ 8563
1533+ 8563                  ; ---------------------------------------------------------------
1534+ 8563                  ; Seleziona il tile corretto in base al tipo di cella.
1535+ 8563                  ;
1536+ 8563                  ; A = 0 -> Background
1537+ 8563                  ; A = 1 -> Floor
1538+ 8563                  ; A = 2 -> Wall
1539+ 8563                  ; A = 3 -> Nasty
1540+ 8563                  ; ---------------------------------------------------------------
1541+ 8563
1542+ 8563 B7               or   a
1543+ 8564 20 06            jr   nz, .not_bg
1544+ 8566
1545+ 8566                  ; Background
1546+ 8566 21 A0 00         ld   hl, OFFSET_BG
1547+ 8569 19               add  hl, de
1548+ 856A 18 16            jr   .draw_cell
1549+ 856C
1550+ 856C              .not_bg:
1551+ 856C
1552+ 856C 3D               dec  a
1553+ 856D 20 06            jr   nz, .not_floor
1554+ 856F
1555+ 856F                  ; Floor
1556+ 856F 21 A9 00         ld   hl, OFFSET_FLOOR
1557+ 8572 19               add  hl, de
1558+ 8573 18 0D            jr   .draw_cell
1559+ 8575
1560+ 8575              .not_floor:
1561+ 8575
1562+ 8575 3D               dec  a
1563+ 8576 20 06            jr   nz, .not_wall
1564+ 8578
1565+ 8578                  ; Wall
1566+ 8578 21 B2 00         ld   hl, OFFSET_WALL
1567+ 857B 19               add  hl, de
1568+ 857C 18 04            jr   .draw_cell
1569+ 857E
1570+ 857E              .not_wall:
1571+ 857E
1572+ 857E                  ; Nasty
1573+ 857E 21 BB 00         ld   hl, OFFSET_NASTY
1574+ 8581 19               add  hl, de
1575+ 8582
1576+ 8582              .draw_cell:
1577+ 8582
1578+ 8582                  ; ---------------------------------------------------------------
1579+ 8582                  ; HL punta ora alla grafica del tile da ridisegnare.
1580+ 8582                  ;
1581+ 8582                  ; Gfx_DrawTile si aspetta:
1582+ 8582                  ;   IX = puntatore tile
1583+ 8582                  ;   B  = Row
1584+ 8582                  ;   C  = Col
1585+ 8582                  ; ---------------------------------------------------------------
1586+ 8582 E5               push hl
1587+ 8583 DD E1            pop  ix
1588+ 8585
1589+ 8585                  ; Ripristina Row e Col salvati in IY
1590+ 8585 FD E5            push iy
1591+ 8587 C1               pop  bc
1592+ 8588
1593+ 8588                  ; Disegna il tile originale
1594+ 8588 CD ED 68         call Gfx_DrawTile
1595+ 858B
1596+ 858B                  ; ---------------------------------------------------------------
1597+ 858B                  ; Ripristina i registri salvati
1598+ 858B                  ; ---------------------------------------------------------------
1599+ 858B DD E1            pop  ix
1600+ 858D E1               pop  hl
1601+ 858E D1               pop  de
1602+ 858F C1               pop  bc
1603+ 8590 FD E1            pop  iy
1604+ 8592
1605+ 8592 C9               ret
1606+ 8593
1607+ 8593              ; -------------------------------------------------------------------
1608+ 8593              ; CheckWillyItemCollision
1609+ 8593              ;
1610+ 8593              ; Verifica se Willy collide con un item utilizzando il controllo
1611+ 8593              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1612+ 8593              ;
1613+ 8593              ; Input:
1614+ 8593              ;   A = ItemX (colonna attributi 0..31)
1615+ 8593              ;   H = ItemY (riga attributi 3..18)
1616+ 8593              ;
1617+ 8593              ; Coordinate item:
1618+ 8593              ;   Ogni item occupa una cella da 8x8 pixel.
1619+ 8593              ;
1620+ 8593              ; Coordinate Willy:
1621+ 8593              ;   Willy occupa un rettangolo di 16x16 pixel.
1622+ 8593              ;
1623+ 8593              ; Output:
1624+ 8593              ;   Carry Set   = collisione rilevata
1625+ 8593              ;   Carry Clear = nessuna collisione
1626+ 8593              ;
1627+ 8593              ; Registri preservati:
1628+ 8593              ;   BC, DE, HL
1629+ 8593              ; -------------------------------------------------------------------
1630+ 8593              CheckWillyItemCollision:
1631+ 8593
1632+ 8593                  ; Salva i registri utilizzati
1633+ 8593 C5               push bc
1634+ 8594 D5               push de
1635+ 8595 E5               push hl
1636+ 8596
1637+ 8596                  ; ---------------------------------------------------------------
1638+ 8596                  ; Calcola il bounding box orizzontale dell'item
1639+ 8596                  ;
1640+ 8596                  ; ItemLeft  = ItemX * 8
1641+ 8596                  ; ItemRight = ItemLeft + 7
1642+ 8596                  ;
1643+ 8596                  ; E = ItemLeft
1644+ 8596                  ; D = ItemRight
1645+ 8596                  ; ---------------------------------------------------------------
1646+ 8596 6F               ld   l, a              ; L = ItemX
1647+ 8597
1648+ 8597 7D               ld   a, l
1649+ 8598 87               add  a, a              ; *2
1650+ 8599 87               add  a, a              ; *4
1651+ 859A 87               add  a, a              ; *8
1652+ 859B
1653+ 859B 5F               ld   e, a              ; E = ItemLeft
1654+ 859C
1655+ 859C C6 07            add  a, 7
1656+ 859E 57               ld   d, a              ; D = ItemRight
1657+ 859F
1658+ 859F                  ; ---------------------------------------------------------------
1659+ 859F                  ; Recupera la posizione corrente di Willy
1660+ 859F                  ;
1661+ 859F                  ; B = WillyY
1662+ 859F                  ; C = WillyX
1663+ 859F                  ; ---------------------------------------------------------------
1664+ 859F ED 4B 81 EC      ld   bc, (PlayerPos)
1665+ 85A3
1666+ 85A3                  ; ---------------------------------------------------------------
1667+ 85A3                  ; Primo test:
1668+ 85A3                  ;
1669+ 85A3                  ; WillyLeft <= ItemRight
1670+ 85A3                  ;
1671+ 85A3                  ; Se Willy è completamente a destra dell'item
1672+ 85A3                  ; non può esserci collisione.
1673+ 85A3                  ; ---------------------------------------------------------------
1674+ 85A3 79               ld   a, c              ; A = WillyLeft
1675+ 85A4
1676+ 85A4 BA               cp   d                 ; WillyLeft vs ItemRight
1677+ 85A5
1678+ 85A5 28 04            jr   z, .x_ok
1679+ 85A7 38 02            jr   c, .x_ok
1680+ 85A9
1681+ 85A9 18 29            jr   .no_collision
1682+ 85AB
1683+ 85AB              .x_ok:
1684+ 85AB
1685+ 85AB                  ; ---------------------------------------------------------------
1686+ 85AB                  ; Secondo test:
1687+ 85AB                  ;
1688+ 85AB                  ; WillyRight >= ItemLeft
1689+ 85AB                  ;
1690+ 85AB                  ; WillyRight = WillyX + 7
1691+ 85AB                  ; ---------------------------------------------------------------
1692+ 85AB C6 07            add  a, 7
1693+ 85AD
1694+ 85AD BB               cp   e                 ; WillyRight vs ItemLeft
1695+ 85AE
1696+ 85AE 28 04            jr   z, .y_check
1697+ 85B0 30 02            jr   nc, .y_check
1698+ 85B2
1699+ 85B2 18 20            jr   .no_collision
1700+ 85B4
1701+ 85B4              .y_check:
1702+ 85B4
1703+ 85B4                  ; ---------------------------------------------------------------
1704+ 85B4                  ; Recupera ItemY dal valore originale di HL
1705+ 85B4                  ;
1706+ 85B4                  ; H contiene la riga dell'item.
1707+ 85B4                  ; ---------------------------------------------------------------
1708+ 85B4 E1               pop  hl
1709+ 85B5 E5               push hl
1710+ 85B6
1711+ 85B6                  ; ---------------------------------------------------------------
1712+ 85B6                  ; Calcola il bounding box verticale dell'item
1713+ 85B6                  ;
1714+ 85B6                  ; ItemTop    = ItemY * 8
1715+ 85B6                  ; ItemBottom = ItemTop + 7
1716+ 85B6                  ;
1717+ 85B6                  ; E = ItemTop
1718+ 85B6                  ; D = ItemBottom
1719+ 85B6                  ; ---------------------------------------------------------------
1720+ 85B6 7C               ld   a, h
1721+ 85B7
1722+ 85B7 87               add  a, a              ; *2
1723+ 85B8 87               add  a, a              ; *4
1724+ 85B9 87               add  a, a              ; *8
1725+ 85BA
1726+ 85BA 5F               ld   e, a              ; ItemTop
1727+ 85BB
1728+ 85BB C6 07            add  a, 7
1729+ 85BD 57               ld   d, a              ; ItemBottom
1730+ 85BE
1731+ 85BE                  ; ---------------------------------------------------------------
1732+ 85BE                  ; Primo test verticale:
1733+ 85BE                  ;
1734+ 85BE                  ; WillyTop <= ItemBottom
1735+ 85BE                  ; ---------------------------------------------------------------
1736+ 85BE 78               ld   a, b              ; WillyTop
1737+ 85BF
1738+ 85BF BA               cp   d
1739+ 85C0
1740+ 85C0 28 04            jr   z, .y_ok
1741+ 85C2 38 02            jr   c, .y_ok
1742+ 85C4
1743+ 85C4 18 0E            jr   .no_collision
1744+ 85C6
