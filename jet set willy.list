   2+ 84E6              ; audio.asm
   3+ 84E6              ;
   4+ 84E6              ; Gestione degli effetti sonori e della musica di sottofondo per il beeper.
   5+ 84E6              ;===========================================================================
   6+ 84E6
   7+ 84E6              ; -------------------------------------------------------------------
   8+ 84E6              ; Audio_UpdateJumpSound
   9+ 84E6              ;
  10+ 84E6              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 84E6              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 84E6              ; -------------------------------------------------------------------
  13+ 84E6              Audio_UpdateJumpSound:
  14+ 84E6 F5               push af
  15+ 84E7 C5               push bc
  16+ 84E8 D5               push de
  17+ 84E9 E5               push hl
  18+ 84EA
  19+ 84EA                  ; Controlla se il suono è attivo (note < 18)
  20+ 84EA 3A 2C EE         ld   a, (Audio_jump_sound_note)
  21+ 84ED FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 84EF 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 84F1
  24+ 84F1                  ; Carica la nota corrente da suonare
  25+ 84F1 5F               ld   e, a
  26+ 84F2 16 00            ld   d, 0
