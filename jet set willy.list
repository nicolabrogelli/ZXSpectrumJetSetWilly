 512  8C3D 32 05 F8         ld   (enter_key_prev), a
 513  8C40 32 F1 F7         ld   (collision_active), a
 514  8C43 32 F0 F7         ld   (flags), a
 515  8C46 32 E9 FB         ld   (ramp_entry_guard), a
 516  8C49 32 F4 FB         ld   (willy_on_ramp), a
 517  8C4C 32 F3 FB         ld   (willy_needs_redraw), a
