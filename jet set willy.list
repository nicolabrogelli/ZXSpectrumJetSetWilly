 261+ 5EEF C2 F8 5E         jp   nz, .normal_grid  ; If not equal, not on ramp!
 262+ 5EF2
 263+ 5EF2 21 C4 00         ld   hl, OFFSET_RAMP
 264+ 5EF5 C3 17 5F         jp   .load_tile
 265+ 5EF8
 266+ 5EF8              .normal_grid:
 267+ 5EF8 7B               ld   a, e              ; A = r (Row, calculated at the start of GetBackgroundByte)
 268+ 5EF9                  ; C already contains c (Col, calculated at the start of GetBackgroundByte)
 269+ 5EF9 CD 57 70         call GetCellFromUnpacked ; A = cell type (0..3)
