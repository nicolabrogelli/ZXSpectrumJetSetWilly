1876+ 7871                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1877+ 7871 5F               ld   e, a              ; E = r
1878+ 7872 79               ld   a, c
1879+ 7873 CB 3F            srl  a
1880+ 7875 CB 3F            srl  a
1881+ 7877 CB 3F            srl  a                 ; A = c (0..31)
1882+ 7879 4F               ld   c, a              ; C = c
1883+ 787A 7B               ld   a, e              ; A = r
