   7+ 8837              ; -------------------------------------------------------------------
   8+ 8837              ; Audio_UpdateJumpSound
   9+ 8837              ;
  10+ 8837              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8837              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8837              ; -------------------------------------------------------------------
  13+ 8837              Audio_UpdateJumpSound:
  14+ 8837 F5               push af
  15+ 8838 C5               push bc
  16+ 8839 D5               push de
  17+ 883A E5               push hl
  18+ 883B
  19+ 883B                  ; Controlla se il suono è attivo (note < 18)
  20+ 883B 3A 18 FC         ld   a, (Audio_jump_sound_note)
  21+ 883E FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8840 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8842
  24+ 8842                  ; Carica la nota corrente da suonare
  25+ 8842 5F               ld   e, a
  26+ 8843 16 00            ld   d, 0
  27+ 8845 21 71 88         ld   hl, Audio_JumpSoundDelays
  28+ 8848 19               add  hl, de
  29+ 8849 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 884A 57               ld   d, a                      ; D = delay della nota
  31+ 884B
  32+ 884B                  ; Suona la nota: 15 cicli
  33+ 884B 06 0F            ld   b, 15
  34+ 884D              .note_loop:
  35+ 884D                  ; Speaker ON
  36+ 884D 3A 11 F8         ld   a, (room_border_color)
  37+ 8850 F6 10            or   $10
  38+ 8852 D3 FE            out  ($fe), a
  39+ 8854 4A               ld   c, d
  40+ 8855              .d1:
  41+ 8855 0D               dec  c
  42+ 8856 20 FD            jr   nz, .d1
  43+ 8858
  44+ 8858                  ; Speaker OFF
  45+ 8858 3A 11 F8         ld   a, (room_border_color)
  46+ 885B E6 EF            and  $ef
  47+ 885D D3 FE            out  ($fe), a
  48+ 885F 4A               ld   c, d
  49+ 8860              .d2:
  50+ 8860 0D               dec  c
  51+ 8861 20 FD            jr   nz, .d2
  52+ 8863
  53+ 8863 10 E8            djnz .note_loop
  54+ 8865
  55+ 8865                  ; Passa alla nota successiva
  56+ 8865 3A 18 FC         ld   a, (Audio_jump_sound_note)
  57+ 8868 3C               inc  a
  58+ 8869 32 18 FC         ld   (Audio_jump_sound_note), a
  59+ 886C
  60+ 886C              .done:
  61+ 886C E1               pop  hl
  62+ 886D D1               pop  de
  63+ 886E C1               pop  bc
  64+ 886F F1               pop  af
  65+ 8870 C9               ret
  66+ 8871
  67+ 8871              Audio_JumpSoundDelays:
  68+ 8871 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 8875 19 13 0C 06
  68+ 8879 0C 13 19 20
  68+ 887D 26 2D 33 3A
  68+ 8881 40 47
