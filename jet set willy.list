 408+ 6C26              ; Aggiorna le posizioni dei nemici attivi per il prossimo frame
 409+ 6C26              ; -------------------------------------------------------------------
 410+ 6C26              UpdateRoomEnemies:
 411+ 6C26 E5               push hl
 412+ 6C27 D5               push de
 413+ 6C28 C5               push bc
 414+ 6C29 DD E5            push ix
 415+ 6C2B
 416+ 6C2B                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 417+ 6C2B 3A B9 73         ld   a, (enemy_update_rate)
 418+ 6C2E FE 01            cp   1
 419+ 6C30 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 420+ 6C32
 421+ 6C32 3A BA 73         ld   a, (enemy_update_timer)
 422+ 6C35 3C               inc  a
 423+ 6C36 47               ld   b, a                      ; B = timer + 1
 424+ 6C37 3A B9 73         ld   a, (enemy_update_rate)
 425+ 6C3A B8               cp   b
 426+ 6C3B 28 0C            jr   z, .reset_timer
 427+ 6C3D 38 0A            jr   c, .reset_timer
 428+ 6C3F
 429+ 6C3F                  ; Salva contatore incrementato e salta l'aggiornamento
 430+ 6C3F 78               ld   a, b
 431+ 6C40 32 BA 73         ld   (enemy_update_timer), a
 432+ 6C43
 433+ 6C43              .skip_update:
 434+ 6C43 DD E1            pop  ix
 435+ 6C45 C1               pop  bc
 436+ 6C46 D1               pop  de
 437+ 6C47 E1               pop  hl
 438+ 6C48 C9               ret
 439+ 6C49
 440+ 6C49              .reset_timer:
 441+ 6C49 AF               xor  a
 442+ 6C4A 32 BA 73         ld   (enemy_update_timer), a
 443+ 6C4D 18 00            jr   .do_update
 444+ 6C4F
 445+ 6C4F              .do_update:
 446+ 6C4F DD 21 02 6A      ld   ix, ActiveEnemies
 447+ 6C53 06 04            ld   b, 4              ; 4 slot
 448+ 6C55              .loop:
 449+ 6C55 DD 7E 00         ld   a, (ix+0)         ; Flags
 450+ 6C58 E6 80            and  $80               ; Active?
 451+ 6C5A CA 05 6D         jp   z, .next
 452+ 6C5D
 453+ 6C5D                  ; 1. Salva la posizione corrente in Old X/Y per la cancellazione nel prossimo frame
 454+ 6C5D DD 7E 01         ld   a, (ix+1)
 455+ 6C60 DD 77 07         ld   (ix+7), a         ; Old X = Current X
 456+ 6C63 DD 7E 02         ld   a, (ix+2)
 457+ 6C66 DD 77 08         ld   (ix+8), a         ; Old Y = Current Y
 458+ 6C69
 459+ 6C69                  ; 2. Aggiorna Anim State
 460+ 6C69 DD 7E 06         ld   a, (ix+6)         ; Anim State (0..3)
 461+ 6C6C 3C               inc  a
 462+ 6C6D E6 03            and  3                 ; Alterna 0..3
 463+ 6C6F DD 77 06         ld   (ix+6), a
 464+ 6C72
 465+ 6C72                  ; 3. Determina se orizzontale o verticale
 466+ 6C72 DD 7E 00         ld   a, (ix+0)         ; Flags
 467+ 6C75 E6 40            and  $40               ; Vertical? (Bit 6)
 468+ 6C77 C2 C1 6C         jp   nz, .vertical
 469+ 6C7A
 470+ 6C7A              .horizontal:
 471+ 6C7A DD 7E 05         ld   a, (ix+5)         ; Direction (1=Left, 2=Right)
 472+ 6C7D FE 01            cp   1
 473+ 6C7F 20 20            jr   nz, .horiz_right
 474+ 6C81
 475+ 6C81              .horiz_left:
 476+ 6C81 DD 7E 01         ld   a, (ix+1)         ; Current X
 477+ 6C84 D6 02            sub  2                 ; Muovi a sinistra di 2 pixel
 478+ 6C86 DD BE 03         cp   (ix+3)            ; Min Limit
 479+ 6C89 28 08            jr   z, .h_rev_right
 480+ 6C8B 38 06            jr   c, .h_rev_right
 481+ 6C8D DD 77 01         ld   (ix+1), a
 482+ 6C90 C3 05 6D         jp   .next
 483+ 6C93
 484+ 6C93              .h_rev_right:
 485+ 6C93 DD 7E 03         ld   a, (ix+3)         ; Min Limit
 486+ 6C96 DD 77 01         ld   (ix+1), a
 487+ 6C99 3E 02            ld   a, 2
 488+ 6C9B DD 77 05         ld   (ix+5), a         ; Cambia direzione a Destra
 489+ 6C9E C3 05 6D         jp   .next
 490+ 6CA1
 491+ 6CA1              .horiz_right:
 492+ 6CA1 DD 7E 01         ld   a, (ix+1)         ; Current X
 493+ 6CA4 C6 02            add  a, 2              ; Muovi a destra di 2 pixel
 494+ 6CA6 DD BE 04         cp   (ix+4)            ; Max Limit
 495+ 6CA9 28 08            jr   z, .h_rev_left
 496+ 6CAB 30 06            jr   nc, .h_rev_left
 497+ 6CAD DD 77 01         ld   (ix+1), a
 498+ 6CB0 C3 05 6D         jp   .next
 499+ 6CB3
 500+ 6CB3              .h_rev_left:
 501+ 6CB3 DD 7E 04         ld   a, (ix+4)         ; Max Limit
 502+ 6CB6 DD 77 01         ld   (ix+1), a
 503+ 6CB9 3E 01            ld   a, 1
 504+ 6CBB DD 77 05         ld   (ix+5), a         ; Cambia direzione a Sinistra
 505+ 6CBE C3 05 6D         jp   .next
 506+ 6CC1
 507+ 6CC1              .vertical:
 508+ 6CC1 DD 7E 05         ld   a, (ix+5)         ; Direction (1=Up, 2=Down)
 509+ 6CC4 FE 01            cp   1
 510+ 6CC6 20 20            jr   nz, .vert_down
 511+ 6CC8
 512+ 6CC8              .vert_up:
 513+ 6CC8 DD 7E 02         ld   a, (ix+2)         ; Current Y
 514+ 6CCB D6 02            sub  2                 ; Muovi in alto di 2 pixel
 515+ 6CCD DD BE 03         cp   (ix+3)            ; Min Limit (Top)
 516+ 6CD0 28 08            jr   z, .v_rev_down
 517+ 6CD2 38 06            jr   c, .v_rev_down
 518+ 6CD4 DD 77 02         ld   (ix+2), a
 519+ 6CD7 C3 05 6D         jp   .next
 520+ 6CDA
 521+ 6CDA              .v_rev_down:
 522+ 6CDA DD 7E 03         ld   a, (ix+3)         ; Min Limit
 523+ 6CDD DD 77 02         ld   (ix+2), a
 524+ 6CE0 3E 02            ld   a, 2
 525+ 6CE2 DD 77 05         ld   (ix+5), a         ; Cambia direzione in Basso
 526+ 6CE5 C3 05 6D         jp   .next
 527+ 6CE8
 528+ 6CE8              .vert_down:
 529+ 6CE8 DD 7E 02         ld   a, (ix+2)         ; Current Y
 530+ 6CEB C6 02            add  a, 2              ; Muovi in basso di 2 pixel
 531+ 6CED DD BE 04         cp   (ix+4)            ; Max Limit (Bottom)
 532+ 6CF0 28 08            jr   z, .v_rev_up
 533+ 6CF2 30 06            jr   nc, .v_rev_up
 534+ 6CF4 DD 77 02         ld   (ix+2), a
 535+ 6CF7 C3 05 6D         jp   .next
 536+ 6CFA
 537+ 6CFA              .v_rev_up:
