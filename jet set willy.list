1092+ 6B13              ; -------------------------------------------------------------------
1093+ 6B13              ; GetRampY
1094+ 6B13              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1095+ 6B13              ; Input: C = PlayerX
1096+ 6B13              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1097+ 6B13              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1098+ 6B13              ; -------------------------------------------------------------------
1099+ 6B13              GetRampY:
1100+ 6B13 3A 22 76         ld   a, (ramp_len)
1101+ 6B16 B7               or   a
1102+ 6B17 C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1103+ 6B18
1104+ 6B18 3A 21 76         ld   a, (ramp_dir)
1105+ 6B1B B7               or   a
1106+ 6B1C 28 4C            jr   z, .dir_left
1107+ 6B1E
1108+ 6B1E              .dir_right:
1109+ 6B1E                  ; Rampa sale a destra (up-right)
1110+ 6B1E 3A 24 76         ld   a, (ramp_col)
1111+ 6B21 87               add  a, a              ; *2
1112+ 6B22 87               add  a, a              ; *4
1113+ 6B23 87               add  a, a              ; *8 (X start in pixel)
1114+ 6B24 5F               ld   e, a              ; E = X_left
1115+ 6B25
1116+ 6B25 3A 22 76         ld   a, (ramp_len)
1117+ 6B28 87               add  a, a              ; *2
1118+ 6B29 87               add  a, a              ; *4
1119+ 6B2A 87               add  a, a              ; *8
1120+ 6B2B 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1121+ 6B2C 67               ld   h, a              ; H = X_right_boundary
1122+ 6B2D
1123+ 6B2D 79               ld   a, c              ; A = PlayerX
1124+ 6B2E BB               cp   e
1125+ 6B2F DA C4 6B         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1126+ 6B32
1127+ 6B32 BC               cp   h
1128+ 6B33 38 15            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1129+ 6B35
1130+ 6B35                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1131+ 6B35 94               sub  h                 ; A = PlayerX - X_right_boundary
1132+ 6B36 FE 08            cp   8
1133+ 6B38 D2 C4 6B         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1134+ 6B3B
1135+ 6B3B                  ; Piattaforma adiacente! Restituisci PlayerY = (ramp_row - ramp_len + 1) * 8 - 16
1136+ 6B3B 3A 23 76         ld   a, (ramp_row)
1137+ 6B3E 21 22 76         ld   hl, ramp_len
1138+ 6B41 96               sub  (hl)
1139+ 6B42 3C               inc  a                 ; A = Row
1140+ 6B43 87               add  a, a              ; *2
1141+ 6B44 87               add  a, a              ; *4
1142+ 6B45 87               add  a, a              ; *8
1143+ 6B46 D6 10            sub  16                ; A = Row * 8 - 16
1144+ 6B48 37               scf                    ; Set carry (dentro rampa/piattaforma)
1145+ 6B49 C9               ret
1146+ 6B4A
1147+ 6B4A              .on_ramp_slope:
1148+ 6B4A 3A 23 76         ld   a, (ramp_row)
1149+ 6B4D 87               add  a, a              ; *2
1150+ 6B4E 87               add  a, a              ; *4
1151+ 6B4F 87               add  a, a              ; *8
1152+ 6B50 D6 10            sub  16                ; A = ramp_row * 8 - 16
1153+ 6B52 83               add  a, e              ; A = ramp_row * 8 - 16 + X_left
1154+ 6B53 91               sub  c                 ; A = A - PlayerX
1155+ 6B54
1156+ 6B54                  ; Calcola la quota della piattaforma:
1157+ 6B54                  ; platform_Y = (ramp_row - ramp_len + 1) * 8 - 16
1158+ 6B54 57               ld   d, a              ; D = calculated Y
1159+ 6B55
1160+ 6B55 3A 23 76         ld   a, (ramp_row)
1161+ 6B58 21 22 76         ld   hl, ramp_len
1162+ 6B5B 96               sub  (hl)
1163+ 6B5C 3C               inc  a                 ; A = Row
1164+ 6B5D 87               add  a, a              ; *2
1165+ 6B5E 87               add  a, a              ; *4
1166+ 6B5F 87               add  a, a              ; *8
1167+ 6B60 D6 10            sub  16                ; A = platform_Y
1168+ 6B62
1169+ 6B62 BA               cp   d                 ; Compara platform_Y con calculated Y
1170+ 6B63 38 02            jr   c, .no_clamp      ; Se platform_Y < calculated Y, non limitare
1171+ 6B65
1172+ 6B65                  ; Altrimenti, limita a platform_Y
1173+ 6B65 37               scf                    ; Set carry (dentro rampa)
1174+ 6B66 C9               ret
1175+ 6B67
1176+ 6B67              .no_clamp:
1177+ 6B67 7A               ld   a, d              ; Ripristina A = calculated Y
1178+ 6B68 37               scf                    ; Set carry
1179+ 6B69 C9               ret
1180+ 6B6A
1181+ 6B6A              .dir_left:
1182+ 6B6A                  ; Rampa sale a sinistra (up-left)
1183+ 6B6A 21 22 76         ld   hl, ramp_len
1184+ 6B6D 3A 24 76         ld   a, (ramp_col)
1185+ 6B70 96               sub  (hl)
1186+ 6B71 3C               inc  a                 ; A = ramp_col - ramp_len + 1
1187+ 6B72 87               add  a, a              ; *2
1188+ 6B73 87               add  a, a              ; *4
1189+ 6B74 87               add  a, a              ; *8
1190+ 6B75 5F               ld   e, a              ; E = X_left
1191+ 6B76
1192+ 6B76 3A 24 76         ld   a, (ramp_col)
1193+ 6B79 87               add  a, a              ; *2
1194+ 6B7A 87               add  a, a              ; *4
1195+ 6B7B 87               add  a, a              ; *8
1196+ 6B7C C6 08            add  a, 8              ; A = (ramp_col + 1) * 8 (X_right_boundary)
1197+ 6B7E 67               ld   h, a              ; H = X_right_boundary
1198+ 6B7F
1199+ 6B7F 79               ld   a, c              ; A = PlayerX
1200+ 6B80 BC               cp   h
1201+ 6B81 D2 C4 6B         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary, fuori
1202+ 6B84
1203+ 6B84 BB               cp   e
1204+ 6B85 30 16            jr   nc, .on_ramp_slope_left ; Se PlayerX >= X_left, pendenza rampa
1205+ 6B87
1206+ 6B87                  ; Controlla se è sulla cella della piattaforma adiacente in cima a sinistra: [X_left - 8, X_left - 1]
1207+ 6B87 7B               ld   a, e              ; A = X_left
1208+ 6B88 91               sub  c                 ; A = X_left - PlayerX
1209+ 6B89 FE 09            cp   9
1210+ 6B8B D2 C4 6B         jp   nc, .out_of_ramp  ; Se PlayerX <= X_left - 9, fuori
1211+ 6B8E
