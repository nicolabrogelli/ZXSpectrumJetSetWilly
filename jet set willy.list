1025+ 6B50              ; -------------------------------------------------------------------
1026+ 6B50              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1027+ 6B50              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1028+ 6B50              ; -------------------------------------------------------------------
1029+ 6B50              UnpackRoomLayout:
1030+ 6B50 E5               push hl
1031+ 6B51 D5               push de
1032+ 6B52 C5               push bc
1033+ 6B53
1034+ 6B53 2A 74 78         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1035+ 6B56 11 1A 76         ld   de, unpacked_layout ; DE = buffer RAM
1036+ 6B59 06 80            ld   b, 128             ; 128 byte
1037+ 6B5B              .byte_loop:
1038+ 6B5B 7E               ld   a, (hl)            ; Leggi byte compresso
1039+ 6B5C 23               inc  hl
1040+ 6B5D
1041+ 6B5D 4F               ld   c, a               ; C = salvataggio
1042+ 6B5E
1043+ 6B5E                  ; Cella 0: bit 7-6
1044+ 6B5E 07               rlca
1045+ 6B5F 07               rlca
1046+ 6B60 E6 03            and  3
1047+ 6B62 12               ld   (de), a
1048+ 6B63 13               inc  de
1049+ 6B64
1050+ 6B64                  ; Cella 1: bit 5-4
1051+ 6B64 79               ld   a, c
1052+ 6B65 07               rlca
1053+ 6B66 07               rlca
1054+ 6B67 07               rlca
1055+ 6B68 07               rlca
1056+ 6B69 E6 03            and  3
1057+ 6B6B 12               ld   (de), a
1058+ 6B6C 13               inc  de
1059+ 6B6D
1060+ 6B6D                  ; Cella 2: bit 3-2
1061+ 6B6D 79               ld   a, c
1062+ 6B6E 0F               rrca
1063+ 6B6F 0F               rrca
1064+ 6B70 E6 03            and  3
1065+ 6B72 12               ld   (de), a
1066+ 6B73 13               inc  de
1067+ 6B74
1068+ 6B74                  ; Cella 3: bit 1-0
1069+ 6B74 79               ld   a, c
1070+ 6B75 E6 03            and  3
1071+ 6B77 12               ld   (de), a
1072+ 6B78 13               inc  de
1073+ 6B79
1074+ 6B79 10 E0            djnz .byte_loop
1075+ 6B7B
1076+ 6B7B C1               pop  bc
1077+ 6B7C D1               pop  de
1078+ 6B7D E1               pop  hl
1079+ 6B7E C9               ret
1080+ 6B7F
1081+ 6B7F              ; -------------------------------------------------------------------
1082+ 6B7F              ; Legge il tipo di cella dal buffer decompresso in RAM
1083+ 6B7F              ; Input: A = Row (0..15), C = Col (0..31)
1084+ 6B7F              ; Output: A = tipo di cella (0..3)
1085+ 6B7F              ; Preserva tutti gli altri registri.
1086+ 6B7F              ; -------------------------------------------------------------------
1087+ 6B7F              GetCellFromUnpacked:
1088+ 6B7F E5               push hl
1089+ 6B80 D5               push de
1090+ 6B81
1091+ 6B81 6F               ld   l, a
1092+ 6B82 26 00            ld   h, 0
1093+ 6B84 29               add  hl, hl
1094+ 6B85 29               add  hl, hl
1095+ 6B86 29               add  hl, hl
1096+ 6B87 29               add  hl, hl
1097+ 6B88 29               add  hl, hl            ; HL = Row * 32
1098+ 6B89 59               ld   e, c
1099+ 6B8A 16 00            ld   d, 0
1100+ 6B8C 19               add  hl, de            ; HL = Row * 32 + Col
1101+ 6B8D 11 1A 76         ld   de, unpacked_layout
1102+ 6B90 19               add  hl, de
1103+ 6B91 7E               ld   a, (hl)           ; A = cell type
1104+ 6B92
1105+ 6B92 D1               pop  de
1106+ 6B93 E1               pop  hl
1107+ 6B94 C9               ret
