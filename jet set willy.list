 614+ 6A76 3A 83 7A         ld   a, (PlayerPos+1)  ; A = PlayerY
 615+ 6A79 DD 96 03         sub  (ix+3)            ; A = PlayerY - EnemyY (Offset 3: Current Y)
 616+ 6A7C C6 0F            add  a, 15             ; A = PlayerY - EnemyY + 15
 617+ 6A7E FE 1F            cp   31                ; Se >= 31, nessuna collisione con questo
 618+ 6A80 30 07            jr   nc, .next
