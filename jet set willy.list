1371+ 6D46              ; Carica le impostazioni di salto e gravità specifiche per la stanza corrente
1372+ 6D46              ; Legge il byte di configurazione ad offset OFFSET_PHYSICS_SETTINGS (239).
1373+ 6D46              ; Se è 0, applica le impostazioni di default (Jump = 6, Gravity = 1).
1374+ 6D46              ; Altrimenti, decodifica il formato %GGGGJJJJ (Jump = JJJJ, Gravity Preset = GGGG).
1375+ 6D46              ; -------------------------------------------------------------------
1376+ 6D46              Phys_LoadRoomSettings:
1377+ 6D46 E5               push hl
1378+ 6D47 D5               push de
1379+ 6D48 F5               push af
1380+ 6D49
1381+ 6D49 2A 95 7D         ld   hl, (room_ptr)
1382+ 6D4C 11 EF 00         ld   de, OFFSET_PHYSICS_SETTINGS
1383+ 6D4F 19               add  hl, de
