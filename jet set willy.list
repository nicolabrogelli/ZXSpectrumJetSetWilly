 880+ 7FC9              ; -------------------------------------------------------------------
 881+ 7FC9              Enemy_Update:
 882+ 7FC9 E5               push hl
 883+ 7FCA D5               push de
 884+ 7FCB C5               push bc
 885+ 7FCC DD E5            push ix
 886+ 7FCE
 887+ 7FCE                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 888+ 7FCE 3A 87 FB         ld   a, (enemy_update_rate)
 889+ 7FD1 FE 01            cp   1
 890+ 7FD3 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 891+ 7FD5
 892+ 7FD5 3A 88 FB         ld   a, (enemy_update_timer)
 893+ 7FD8 3C               inc  a
 894+ 7FD9 47               ld   b, a                      ; B = timer + 1
 895+ 7FDA 3A 87 FB         ld   a, (enemy_update_rate)
 896+ 7FDD B8               cp   b
 897+ 7FDE 28 0C            jr   z, .reset_timer
 898+ 7FE0 38 0A            jr   c, .reset_timer
 899+ 7FE2
 900+ 7FE2                  ; Salva contatore incrementato e salta l'aggiornamento
 901+ 7FE2 78               ld   a, b
 902+ 7FE3 32 88 FB         ld   (enemy_update_timer), a
