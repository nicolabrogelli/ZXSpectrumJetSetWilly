  10+ 6B6F              MovePlayer:
  11+ 6B6F                  ; Verifica se un tasto di movimento è premuto
  12+ 6B6F DD 21 0A 71      ld   ix, flags
  13+ 6B73 DD CB 00 46      bit  $00, (ix)
  14+ 6B77 C8               ret  z
  15+ 6B78 DD CB 00 86      res  $00, (ix)
  16+ 6B7C
  17+ 6B7C ED 4B 02 71      ld   bc, (PlayerPos)   ; C = PlayerX (pixel), B = PlayerY (pixel)
  18+ 6B80
  19+ 6B80 CB 4A            bit  $01, d            ; Tasto Destra premuto?
  20+ 6B82 20 11            jr   nz, movePlayer_right
  21+ 6B84
  22+ 6B84 CB 42            bit  $00, d            ; Tasto Sinistra premuto?
  23+ 6B86 C8               ret  z
  24+ 6B87
  25+ 6B87              movePlayer_left:
  26+ 6B87 79               ld   a, c
