 279  8A82              ; -------------------------------------------------------------------
 280  8A82              ; ShowTitleScreen
 281  8A82              ; Visualizza la schermata iniziale del gioco (Title Screen).
 282  8A82              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 283  8A82              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 284  8A82              ; -------------------------------------------------------------------
 285  8A82              ShowTitleScreen:
 286  8A82                  ; 1. Disegna la schermata iniziale
 287  8A82 CD 1B 63         call Gfx_DrawTitleScreen
 288  8A85
 289  8A85                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 290  8A85              .wait_title_enter_release:
 291  8A85 76               halt
 292  8A86 3E BF            ld   a, $bf
 293  8A88 DB FE            in   a, ($fe)
 294  8A8A 1F               rra
 295  8A8B 30 F8            jr   nc, .wait_title_enter_release
 296  8A8D
 297  8A8D                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 298  8A8D 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 299  8A8F              .title_loop:
 300  8A8F 76               halt
 301  8A90
 302  8A90                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 303  8A90 0C               inc  c
 304  8A91 79               ld   a, c
 305  8A92 CB 3F            srl  a
 306  8A94 CB 3F            srl  a
 307  8A96 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 308  8A98 E6 07            and  7
 309  8A9A 5F               ld   e, a
 310  8A9B 16 00            ld   d, 0
 311  8A9D 21 13 63         ld   hl, title_color_table
 312  8AA0 19               add  hl, de
 313  8AA1 7E               ld   a, (hl)               ; A = nuovo colore
 314  8AA2 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 315  8AA5 06 20            ld   b, 32
 316  8AA7              .color_title_loop:
 317  8AA7 77               ld   (hl), a
 318  8AA8 23               inc  hl
 319  8AA9 10 FC            djnz .color_title_loop
 320  8AAB
 321  8AAB                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 322  8AAB 3E BF            ld   a, $bf
 323  8AAD DB FE            in   a, ($fe)
 324  8AAF 1F               rra
 325  8AB0 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 326  8AB2
 327  8AB2                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 328  8AB2              .wait_title_enter_release_after:
 329  8AB2 76               halt
 330  8AB3 3E BF            ld   a, $bf
 331  8AB5 DB FE            in   a, ($fe)
 332  8AB7 1F               rra
 333  8AB8 30 F8            jr   nc, .wait_title_enter_release_after
 334  8ABA
 335  8ABA                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 336  8ABA AF               xor  a
 337  8ABB D3 FE            out  ($fe), a              ; Bordo a nero
 338  8ABD 21 8D 5C         ld   hl, ATTR_P
 339  8AC0 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 340  8AC1 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 341  8AC4 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 342  8AC6 3E 07            ld   a, $07
 343  8AC8 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 344  8ACB
 345  8ACB                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 346  8ACB CD 3A 8D         call ResetFullGameState
 347  8ACE
 348  8ACE                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 349  8ACE C3 5E 89         jp   LoadRoomAndRestart
 350  8AD1
 351  8AD1              ; -------------------------------------------------------------------
 352  8AD1              ; TriggerGameOver
 353  8AD1              ; Scatena la schermata di Game Over per la stanza corrente.
 354  8AD1              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 355  8AD1              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 356  8AD1              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 357  8AD1              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 358  8AD1              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 359  8AD1              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 360  8AD1              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 361  8AD1              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 362  8AD1              ; -------------------------------------------------------------------
 363  8AD1              TriggerGameOver:
 364  8AD1                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 365  8AD1 CD FC 64         call Gfx_DrawGameOverScreen
 366  8AD4
 367  8AD4                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 368  8AD4              .wait_keys_release:
 369  8AD4 76               halt
 370  8AD5                  ; Controlla tasto Y (Porta $DF, bit 4)
 371  8AD5 01 FE DF         ld   bc, $dffe
 372  8AD8 ED 78            in   a, (c)
 373  8ADA CB 67            bit  4, a
 374  8ADC 28 F6            jr   z, .wait_keys_release
 375  8ADE
 376  8ADE                  ; Controlla tasto N (Porta $7F, bit 3)
 377  8ADE 01 FE 7F         ld   bc, $7ffe
 378  8AE1 ED 78            in   a, (c)
 379  8AE3 CB 5F            bit  3, a
 380  8AE5 28 ED            jr   z, .wait_keys_release
 381  8AE7
 382  8AE7                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 383  8AE7 01 FE BF         ld   bc, $bffe
 384  8AEA ED 78            in   a, (c)
 385  8AEC CB 47            bit  0, a
 386  8AEE 28 E4            jr   z, .wait_keys_release
 387  8AF0
 388  8AF0                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 389  8AF0 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 390  8AF2              .wait_choice_loop:
 391  8AF2 76               halt
 392  8AF3
 393  8AF3                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 394  8AF3 0C               inc  c
 395  8AF4 79               ld   a, c
 396  8AF5 CB 3F            srl  a
 397  8AF7 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 398  8AF9 E6 07            and  7
 399  8AFB 5F               ld   e, a
 400  8AFC 16 00            ld   d, 0
 401  8AFE 21 B8 64         ld   hl, game_over_color_table
 402  8B01 19               add  hl, de
 403  8B02 7E               ld   a, (hl)               ; A = nuovo colore attributo
 404  8B03 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 405  8B06 06 09            ld   b, 9
 406  8B08              .color_cycle_loop:
 407  8B08 77               ld   (hl), a
 408  8B09 23               inc  hl
 409  8B0A 10 FC            djnz .color_cycle_loop
 410  8B0C
 411  8B0C                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 412  8B0C 01 FE DF         ld   bc, $dffe
 413  8B0F ED 78            in   a, (c)
 414  8B11 CB 67            bit  4, a
 415  8B13 28 2A            jr   z, .continue_chosen
 416  8B15
 417  8B15                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 418  8B15 01 FE 7F         ld   bc, $7ffe
 419  8B18 ED 78            in   a, (c)
 420  8B1A CB 5F            bit  3, a
 421  8B1C 28 0B            jr   z, .quit_chosen
 422  8B1E
 423  8B1E                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 424  8B1E 01 FE BF         ld   bc, $bffe
 425  8B21 ED 78            in   a, (c)
 426  8B23 CB 47            bit  0, a
 427  8B25 28 02            jr   z, .quit_chosen
 428  8B27
 429  8B27 18 C9            jr   .wait_choice_loop
 430  8B29
 431  8B29              .quit_chosen:
 432  8B29                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 433  8B29              .wait_quit_release:
 434  8B29 76               halt
 435  8B2A 01 FE 7F         ld   bc, $7ffe
 436  8B2D ED 78            in   a, (c)
 437  8B2F CB 5F            bit  3, a
 438  8B31 28 F6            jr   z, .wait_quit_release
 439  8B33 01 FE BF         ld   bc, $bffe
 440  8B36 ED 78            in   a, (c)
 441  8B38 CB 47            bit  0, a
 442  8B3A 28 ED            jr   z, .wait_quit_release
 443  8B3C
 444  8B3C                  ; 5a. Esegue il normale flusso del Game Over (ritorno a Title Screen)
 445  8B3C C3 82 8A         jp   ShowTitleScreen
 446  8B3F
 447  8B3F              .continue_chosen:
 448  8B3F                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 449  8B3F              .wait_continue_release:
 450  8B3F 76               halt
 451  8B40 01 FE DF         ld   bc, $dffe
 452  8B43 ED 78            in   a, (c)
 453  8B45 CB 67            bit  4, a
 454  8B47 28 F6            jr   z, .wait_continue_release
 455  8B49
 456  8B49                  ; 5b. Ripristina lo stato per continuare la partita:
 457  8B49                  ; - Ripristina le vite di Willy al valore iniziale
 458  8B49 3E 07            ld   a, INITIAL_LIVES
 459  8B4B 32 47 F7         ld   (willy_lives), a
 460  8B4E
