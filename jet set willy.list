  72+ 8598 ~            ; Audio_UpdateMusic
  73+ 8598 ~            ;
  74+ 8598 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8598 ~            ; Viene chiamata a ogni frame.
  76+ 8598 ~            ; -------------------------------------------------------------------
  77+ 8598 ~            Audio_UpdateMusic:
  78+ 8598 ~                push af
  79+ 8598 ~                push bc
  80+ 8598 ~                push de
  81+ 8598 ~                push hl
  82+ 8598 ~
  83+ 8598 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8598 ~                ld   a, (Audio_jump_sound_note)
  85+ 8598 ~                cp   18
  86+ 8598 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8598 ~
  88+ 8598 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8598 ~                ld   a, (Audio_music_frame_counter)
  90+ 8598 ~                dec  a
  91+ 8598 ~                ld   (Audio_music_frame_counter), a
  92+ 8598 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8598 ~
  94+ 8598 ~                ; Altrimenti carica la nota successiva
  95+ 8598 ~                ld   a, (Audio_music_note_idx)
  96+ 8598 ~                inc  a
  97+ 8598 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8598 ~                jr   c, .no_wrap
  99+ 8598 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8598 ~            .no_wrap:
 101+ 8598 ~                ld   (Audio_music_note_idx), a
 102+ 8598 ~
 103+ 8598 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8598 ~                ld   e, a
 105+ 8598 ~                ld   d, 0
 106+ 8598 ~                ld   hl, Audio_MusicSheet
 107+ 8598 ~                add  hl, de
 108+ 8598 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8598 ~
 110+ 8598 ~                ; Leggi durata (secondo byte)
 111+ 8598 ~                inc  hl
 112+ 8598 ~                ld   a, (hl)
 113+ 8598 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8598 ~                jr   nz, .dur_ok
 115+ 8598 ~                ld   a, 1
 116+ 8598 ~            .dur_ok:
 117+ 8598 ~                ld   (Audio_music_frame_counter), a
 118+ 8598 ~
 119+ 8598 ~            .play_current_note:
 120+ 8598 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8598 ~                ld   a, (Audio_music_note_idx)
 122+ 8598 ~                ld   e, a
 123+ 8598 ~                ld   d, 0
 124+ 8598 ~                ld   hl, Audio_MusicSheet
 125+ 8598 ~                add  hl, de
 126+ 8598 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8598 ~                ld   a, (hl)                  ; A = delay
 128+ 8598 ~                or   a
 129+ 8598 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8598 ~
 131+ 8598 ~                ; Suona la nota: 2 cicli
 132+ 8598 ~                ld   d, a                     ; D = delay
 133+ 8598 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8598 ~            .note_loop:
 135+ 8598 ~                ; Speaker ON
 136+ 8598 ~                ld   a, (room_border_color)
 137+ 8598 ~                or   $10
 138+ 8598 ~                out  ($fe), a
 139+ 8598 ~                ld   c, d
 140+ 8598 ~            .d1:
 141+ 8598 ~                push af
 142+ 8598 ~                pop  af
 143+ 8598 ~                dec  c
 144+ 8598 ~                jr   nz, .d1
 145+ 8598 ~
 146+ 8598 ~                ; Speaker OFF
 147+ 8598 ~                ld   a, (room_border_color)
 148+ 8598 ~                and  $ef
 149+ 8598 ~                out  ($fe), a
 150+ 8598 ~                ld   c, d
 151+ 8598 ~            .d2:
 152+ 8598 ~                push af
 153+ 8598 ~                pop  af
 154+ 8598 ~                dec  c
 155+ 8598 ~                jr   nz, .d2
 156+ 8598 ~
 157+ 8598 ~                djnz .note_loop
 158+ 8598 ~
 159+ 8598 ~            .done:
 160+ 8598 ~                pop  hl
 161+ 8598 ~                pop  de
 162+ 8598 ~                pop  bc
 163+ 8598 ~                pop  af
 164+ 8598 ~                ret
 165+ 8598 ~
 166+ 8598 ~            Audio_MusicSheet:
 167+ 8598 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8598 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8598 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8598 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8598 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8598 ~                db 90, 10, 107, 20, 68, 65
