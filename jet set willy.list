1295+ 6506 6F               ld   l, a
1296+ 6507 26 00            ld   h, 0
1297+ 6509 29               add  hl, hl                ; * 2
1298+ 650A 29               add  hl, hl                ; * 4
1299+ 650B 29               add  hl, hl                ; * 8
1300+ 650C 29               add  hl, hl                ; * 16
