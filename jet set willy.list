1251+ 75F2 2A FC EF         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1252+ 75F5 11 A2 ED         ld   de, unpacked_layout ; DE = buffer RAM
1253+ 75F8 06 80            ld   b, 128             ; 128 byte
1254+ 75FA              .byte_loop:
1255+ 75FA 7E               ld   a, (hl)            ; Leggi byte compresso
1256+ 75FB 23               inc  hl
1257+ 75FC
1258+ 75FC 4F               ld   c, a               ; C = salvataggio
1259+ 75FD
1260+ 75FD                  ; Cella 0: bit 7-6
1261+ 75FD 07               rlca
1262+ 75FE 07               rlca
1263+ 75FF E6 03            and  3
1264+ 7601 12               ld   (de), a
1265+ 7602 13               inc  de
1266+ 7603
1267+ 7603                  ; Cella 1: bit 5-4
1268+ 7603 79               ld   a, c
1269+ 7604 07               rlca
