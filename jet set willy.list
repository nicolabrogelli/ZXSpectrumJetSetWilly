  71+ 8670 ~            ; -------------------------------------------------------------------
  72+ 8670 ~            ; Audio_UpdateMusic
  73+ 8670 ~            ;
  74+ 8670 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8670 ~            ; Viene chiamata a ogni frame.
  76+ 8670 ~            ; -------------------------------------------------------------------
  77+ 8670 ~            Audio_UpdateMusic:
  78+ 8670 ~                push af
  79+ 8670 ~                push bc
  80+ 8670 ~                push de
  81+ 8670 ~                push hl
  82+ 8670 ~
  83+ 8670 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8670 ~                ld   a, (Audio_jump_sound_note)
  85+ 8670 ~                cp   18
  86+ 8670 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8670 ~
  88+ 8670 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8670 ~                ld   a, (Audio_music_frame_counter)
  90+ 8670 ~                dec  a
  91+ 8670 ~                ld   (Audio_music_frame_counter), a
  92+ 8670 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8670 ~
  94+ 8670 ~                ; Altrimenti carica la nota successiva
  95+ 8670 ~                ld   a, (Audio_music_note_idx)
  96+ 8670 ~                inc  a
  97+ 8670 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8670 ~                jr   c, .no_wrap
  99+ 8670 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8670 ~            .no_wrap:
 101+ 8670 ~                ld   (Audio_music_note_idx), a
 102+ 8670 ~
 103+ 8670 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8670 ~                ld   e, a
 105+ 8670 ~                ld   d, 0
 106+ 8670 ~                ld   hl, Audio_MusicSheet
 107+ 8670 ~                add  hl, de
 108+ 8670 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8670 ~
 110+ 8670 ~                ; Leggi durata (secondo byte)
 111+ 8670 ~                inc  hl
 112+ 8670 ~                ld   a, (hl)
 113+ 8670 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8670 ~                jr   nz, .dur_ok
 115+ 8670 ~                ld   a, 1
 116+ 8670 ~            .dur_ok:
 117+ 8670 ~                ld   (Audio_music_frame_counter), a
 118+ 8670 ~
 119+ 8670 ~            .play_current_note:
 120+ 8670 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8670 ~                ld   a, (Audio_music_note_idx)
 122+ 8670 ~                ld   e, a
 123+ 8670 ~                ld   d, 0
 124+ 8670 ~                ld   hl, Audio_MusicSheet
 125+ 8670 ~                add  hl, de
 126+ 8670 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8670 ~                ld   a, (hl)                  ; A = delay
 128+ 8670 ~                or   a
 129+ 8670 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8670 ~
 131+ 8670 ~                ; Suona la nota: 2 cicli
 132+ 8670 ~                ld   d, a                     ; D = delay
 133+ 8670 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8670 ~            .note_loop:
 135+ 8670 ~                ; Speaker ON
 136+ 8670 ~                ld   a, (room_border_color)
 137+ 8670 ~                or   $10
 138+ 8670 ~                out  ($fe), a
 139+ 8670 ~                ld   c, d
 140+ 8670 ~            .d1:
 141+ 8670 ~                push af
 142+ 8670 ~                pop  af
 143+ 8670 ~                dec  c
 144+ 8670 ~                jr   nz, .d1
 145+ 8670 ~
 146+ 8670 ~                ; Speaker OFF
 147+ 8670 ~                ld   a, (room_border_color)
 148+ 8670 ~                and  $ef
 149+ 8670 ~                out  ($fe), a
 150+ 8670 ~                ld   c, d
 151+ 8670 ~            .d2:
 152+ 8670 ~                push af
 153+ 8670 ~                pop  af
 154+ 8670 ~                dec  c
 155+ 8670 ~                jr   nz, .d2
 156+ 8670 ~
 157+ 8670 ~                djnz .note_loop
 158+ 8670 ~
 159+ 8670 ~            .done:
 160+ 8670 ~                pop  hl
 161+ 8670 ~                pop  de
 162+ 8670 ~                pop  bc
 163+ 8670 ~                pop  af
 164+ 8670 ~                ret
 165+ 8670 ~
 166+ 8670 ~            Audio_MusicSheet:
 167+ 8670 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8670 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8670 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8670 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8670 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8670 ~                db 90, 10, 107, 20, 68, 65
 173+ 8670                  ELSE
 174+ 8670              Audio_UpdateMusic:
 175+ 8670 C9               ret
 176+ 8671                  ENDIF
