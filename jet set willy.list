 153+ 5E5E 7A               ld   a, d
 154+ 5E5F B6               or   (hl)
 155+ 5E60 77               ld   (hl), a
 156+ 5E61 23               inc  hl
 157+ 5E62 7B               ld   a, e
 158+ 5E63 B6               or   (hl)
 159+ 5E64 77               ld   (hl), a
 160+ 5E65 2B               dec  hl            ; Ritorna alla colonna iniziale
 161+ 5E66
