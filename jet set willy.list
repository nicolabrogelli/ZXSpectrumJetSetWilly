 586+ 72B2 29               add  hl, hl            ; *4
 587+ 72B3 29               add  hl, hl            ; *8
 588+ 72B4 29               add  hl, hl            ; *16
 589+ 72B5 29               add  hl, hl            ; *32
 590+ 72B6
 591+ 72B6 16 00            ld   d, 0
 592+ 72B8 59               ld   e, c              ; DE = Col
 593+ 72B9
 594+ 72B9 19               add  hl, de            ; Row*32 + Col
