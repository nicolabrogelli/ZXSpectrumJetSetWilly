 177  7FB4              .draw_raster_bars:
 178  7FB4                  ; Collisione attiva: disegna le raster bar nel bordo
 179  7FB4 3A 55 7B         ld   a, (counter)
 180  7FB7 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 181  7FB9 06 1E            ld   b, 30             ; Numero di righe della barra raster
 182  7FBB              .raster_loop:
 183  7FBB D3 FE            out  ($fe), a
 184  7FBD 3C               inc  a
 185  7FBE E6 07            and  7
 186  7FC0 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 187  7FC2              .delay:
 188  7FC2 0D               dec  c
 189  7FC3 20 FD            jr   nz, .delay
 190  7FC5 10 F4            djnz .raster_loop
 191  7FC7
 192  7FC7                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 193  7FC7 3A 45 7B         ld   a, (room_border_color)
 194  7FCA D3 FE            out  ($fe), a
 195  7FCC 18 05            jr   .no_collision_change
 196  7FCE
