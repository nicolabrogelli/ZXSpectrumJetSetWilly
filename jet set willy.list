 804+ 77C8              ; -------------------------------------------------------------------
 805+ 77C8              ; DrawItemGraphic
 806+ 77C8              ;
 807+ 77C8              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 808+ 77C8              ; utilizzando una bitmap di 8 byte e un attributo colore.
 809+ 77C8              ;
 810+ 77C8              ; Input:
 811+ 77C8              ;   B = Riga attributi (3..18)
 812+ 77C8              ;   C = Colonna attributi (0..31)
 813+ 77C8              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 814+ 77C8              ;   E = Attributo colore
 815+ 77C8              ;
 816+ 77C8              ; Output:
 817+ 77C8              ;   Nessuno
 818+ 77C8              ;
 819+ 77C8              ; Registri preservati:
 820+ 77C8              ;   BC, DE, HL
 821+ 77C8              ; -------------------------------------------------------------------
 822+ 77C8              DrawItemGraphic:
 823+ 77C8
 824+ 77C8                  ; Salva i registri originali
 825+ 77C8 C5               push bc
 826+ 77C9 D5               push de
 827+ 77CA E5               push hl
 828+ 77CB
 829+ 77CB                  ; ---------------------------------------------------------------
 830+ 77CB                  ; Calcolo indirizzo bitmap dello Spectrum
 831+ 77CB                  ;
 832+ 77CB                  ; Ogni item occupa una cella attributi (8x8 pixel).
 833+ 77CB                  ;
 834+ 77CB                  ; Formula:
 835+ 77CB                  ;   High = $40 + (Row AND $18)
 836+ 77CB                  ;   Low  = (Row AND 7) * 32 + Col
 837+ 77CB                  ;
 838+ 77CB                  ; DE conterrà l'indirizzo della prima scanline.
 839+ 77CB                  ; ---------------------------------------------------------------
 840+ 77CB
 841+ 77CB 78               ld   a, b
 842+ 77CC E6 18            and  $18
 843+ 77CE C6 40            add  a, $40
 844+ 77D0 57               ld   d, a              ; Byte alto indirizzo video
 845+ 77D1
 846+ 77D1 78               ld   a, b
 847+ 77D2 E6 07            and  7                 ; Riga interna al blocco da 8
 848+ 77D4
 849+ 77D4 87               add  a, a              ; *2
 850+ 77D5 87               add  a, a              ; *4
 851+ 77D6 87               add  a, a              ; *8
 852+ 77D7 87               add  a, a              ; *16
 853+ 77D8 87               add  a, a              ; *32
 854+ 77D9
 855+ 77D9 81               add  a, c              ; + colonna
 856+ 77DA
 857+ 77DA 5F               ld   e, a              ; Byte basso indirizzo video
 858+ 77DB
 859+ 77DB                  ; ---------------------------------------------------------------
 860+ 77DB                  ; Disegno bitmap
 861+ 77DB                  ;
 862+ 77DB                  ; Copia 8 byte consecutivi nella memoria video.
 863+ 77DB                  ; Ogni byte rappresenta una scanline da 8 pixel.
 864+ 77DB                  ; ---------------------------------------------------------------
 865+ 77DB
 866+ 77DB C5               push bc                ; Conserva Row e Col
 867+ 77DC
 868+ 77DC 06 08            ld   b, 8              ; Numero scanline
 869+ 77DE
 870+ 77DE              .line_loop:
 871+ 77DE
 872+ 77DE 7E               ld   a, (hl)           ; Legge scanline bitmap
 873+ 77DF 12               ld   (de), a           ; Scrive nella memoria video
 874+ 77E0
 875+ 77E0 14               inc  d                 ; Scanline successiva
 876+ 77E1 23               inc  hl                ; Byte bitmap successivo
 877+ 77E2
 878+ 77E2 05               dec  b
 879+ 77E3 20 F9            jr   nz, .line_loop
 880+ 77E5
 881+ 77E5 C1               pop  bc                ; Ripristina Row e Col
 882+ 77E6
 883+ 77E6                  ; ---------------------------------------------------------------
 884+ 77E6                  ; Calcolo indirizzo attributo
 885+ 77E6                  ;
 886+ 77E6                  ; Formula:
 887+ 77E6                  ;   AttrAddr = $5800 + Row * 32 + Col
 888+ 77E6                  ;
 889+ 77E6                  ; HL conterrà l'indirizzo della cella attributi.
 890+ 77E6                  ; ---------------------------------------------------------------
 891+ 77E6
 892+ 77E6 26 00            ld   h, 0
 893+ 77E8 68               ld   l, b              ; HL = Row
 894+ 77E9
 895+ 77E9 29               add  hl, hl            ; *2
 896+ 77EA 29               add  hl, hl            ; *4
 897+ 77EB 29               add  hl, hl            ; *8
 898+ 77EC 29               add  hl, hl            ; *16
 899+ 77ED 29               add  hl, hl            ; *32
 900+ 77EE
 901+ 77EE 79               ld   a, c              ; A = Colonna
 902+ 77EF
 903+ 77EF 85               add  a, l
 904+ 77F0 6F               ld   l, a
 905+ 77F1
 906+ 77F1 30 01            jr   nc, .no_carry
 907+ 77F3 24               inc  h
 908+ 77F4
 909+ 77F4              .no_carry:
 910+ 77F4
 911+ 77F4                  ; HL = Row * 32 + Col
 912+ 77F4
 913+ 77F4 11 00 58         ld   de, $5800
 914+ 77F7 19               add  hl, de            ; HL = indirizzo attributi
 915+ 77F8
 916+ 77F8                  ; ---------------------------------------------------------------
 917+ 77F8                  ; Recupera il colore originale dallo stack.
 918+ 77F8                  ;
 919+ 77F8                  ; Layout stack:
 920+ 77F8                  ;   HL originale
 921+ 77F8                  ;   DE originale (E = colore)
 922+ 77F8                  ;   BC originale
 923+ 77F8                  ; ---------------------------------------------------------------
 924+ 77F8
 925+ 77F8 C1               pop  bc                ; Recupera HL originale
 926+ 77F9 D1               pop  de                ; Recupera DE originale
 927+ 77FA
 928+ 77FA                  ; ---------------------------------------------------------------
 929+ 77FA                  ; Scrive l'attributo colore
 930+ 77FA                  ; ---------------------------------------------------------------
 931+ 77FA
 932+ 77FA 7B               ld   a, e              ; A = colore
 933+ 77FB 77               ld   (hl), a           ; Scrive nella RAM attributi
 934+ 77FC
 935+ 77FC                  ; ---------------------------------------------------------------
 936+ 77FC                  ; Ripristina HL e BC originali
 937+ 77FC                  ; ---------------------------------------------------------------
 938+ 77FC
 939+ 77FC C5               push bc
 940+ 77FD E1               pop  hl                ; HL originale
 941+ 77FE
 942+ 77FE C1               pop  bc                ; BC originale
 943+ 77FF
 944+ 77FF C9               ret
 945+ 7800
 946+ 7800              ; -------------------------------------------------------------------
 947+ 7800              ; RestoreBackgroundCell
 948+ 7800              ;
 949+ 7800              ; Ripristina il contenuto originale di una cella della stanza.
 950+ 7800              ; Viene utilizzata principalmente quando un item viene raccolto:
 951+ 7800              ; invece di lasciare un "buco", la routine ridisegna il tile
 952+ 7800              ; originale presente nella mappa della stanza.
 953+ 7800              ;
 954+ 7800              ; Input:
 955+ 7800              ;   B = Row (3..18)
 956+ 7800              ;   C = Col (0..31)
 957+ 7800              ;
 958+ 7800              ; Utilizza:
 959+ 7800              ;   room_ptr -> struttura dati della stanza corrente
 960+ 7800              ;   GetCellFromUnpacked -> restituisce il tipo di cella
 961+ 7800              ;   Gfx_DrawTile -> ridisegna il tile selezionato
 962+ 7800              ;
 963+ 7800              ; Tipi di cella:
 964+ 7800              ;   0 = Background
 965+ 7800              ;   1 = Floor
 966+ 7800              ;   2 = Wall
 967+ 7800              ;   3 = Nasty
 968+ 7800              ; -------------------------------------------------------------------
 969+ 7800              RestoreBackgroundCell:
 970+ 7800
 971+ 7800                  ; Salva tutti i registri utilizzati
 972+ 7800 FD E5            push iy
 973+ 7802 C5               push bc
 974+ 7803 D5               push de
 975+ 7804 E5               push hl
 976+ 7805 DD E5            push ix
 977+ 7807
 978+ 7807                  ; ---------------------------------------------------------------
 979+ 7807                  ; Conserva Row e Col in IY.
 980+ 7807                  ;
 981+ 7807                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
 982+ 7807                  ; BC potrebbe essere modificato.
 983+ 7807                  ; ---------------------------------------------------------------
 984+ 7807 C5               push bc
 985+ 7808 FD E1            pop  iy                ; IYH = Row, IYL = Col
 986+ 780A
 987+ 780A                  ; ---------------------------------------------------------------
 988+ 780A                  ; Determina quale tipo di cella è presente nella posizione
 989+ 780A                  ; specificata.
 990+ 780A                  ;
 991+ 780A                  ; Input:
 992+ 780A                  ;   B = Row
 993+ 780A                  ;   C = Col
 994+ 780A                  ;
 995+ 780A                  ; Output:
 996+ 780A                  ;   A = tipo cella
 997+ 780A                  ; ---------------------------------------------------------------
 998+ 780A 78               ld   a, b
 999+ 780B
1000+ 780B CD 7D 6C         call GetCellFromUnpacked
1001+ 780E
1002+ 780E                  ; ---------------------------------------------------------------
1003+ 780E                  ; Recupera il puntatore alla stanza corrente.
1004+ 780E                  ;
1005+ 780E                  ; DE = base della struttura stanza
1006+ 780E                  ; ---------------------------------------------------------------
1007+ 780E ED 5B 95 7D      ld   de, (room_ptr)
1008+ 7812
1009+ 7812                  ; ---------------------------------------------------------------
1010+ 7812                  ; Seleziona il tile corretto in base al tipo di cella.
1011+ 7812                  ;
1012+ 7812                  ; A = 0 -> Background
1013+ 7812                  ; A = 1 -> Floor
1014+ 7812                  ; A = 2 -> Wall
1015+ 7812                  ; A = 3 -> Nasty
1016+ 7812                  ; ---------------------------------------------------------------
1017+ 7812
1018+ 7812 B7               or   a
1019+ 7813 20 06            jr   nz, .not_bg
1020+ 7815
1021+ 7815                  ; Background
1022+ 7815 21 A0 00         ld   hl, OFFSET_BG
1023+ 7818 19               add  hl, de
1024+ 7819 18 16            jr   .draw_cell
1025+ 781B
1026+ 781B              .not_bg:
1027+ 781B
1028+ 781B 3D               dec  a
1029+ 781C 20 06            jr   nz, .not_floor
1030+ 781E
1031+ 781E                  ; Floor
1032+ 781E 21 A9 00         ld   hl, OFFSET_FLOOR
1033+ 7821 19               add  hl, de
1034+ 7822 18 0D            jr   .draw_cell
1035+ 7824
1036+ 7824              .not_floor:
1037+ 7824
1038+ 7824 3D               dec  a
1039+ 7825 20 06            jr   nz, .not_wall
1040+ 7827
1041+ 7827                  ; Wall
1042+ 7827 21 B2 00         ld   hl, OFFSET_WALL
1043+ 782A 19               add  hl, de
1044+ 782B 18 04            jr   .draw_cell
1045+ 782D
1046+ 782D              .not_wall:
1047+ 782D
1048+ 782D                  ; Nasty
1049+ 782D 21 BB 00         ld   hl, OFFSET_NASTY
1050+ 7830 19               add  hl, de
1051+ 7831
1052+ 7831              .draw_cell:
1053+ 7831
1054+ 7831                  ; ---------------------------------------------------------------
1055+ 7831                  ; HL punta ora alla grafica del tile da ridisegnare.
1056+ 7831                  ;
1057+ 7831                  ; Gfx_DrawTile si aspetta:
1058+ 7831                  ;   IX = puntatore tile
1059+ 7831                  ;   B  = Row
1060+ 7831                  ;   C  = Col
1061+ 7831                  ; ---------------------------------------------------------------
1062+ 7831 E5               push hl
1063+ 7832 DD E1            pop  ix
1064+ 7834
1065+ 7834                  ; Ripristina Row e Col salvati in IY
1066+ 7834 FD E5            push iy
1067+ 7836 C1               pop  bc
1068+ 7837
1069+ 7837                  ; Disegna il tile originale
1070+ 7837 CD 26 62         call Gfx_DrawTile
1071+ 783A
1072+ 783A                  ; ---------------------------------------------------------------
1073+ 783A                  ; Ripristina i registri salvati
1074+ 783A                  ; ---------------------------------------------------------------
1075+ 783A DD E1            pop  ix
1076+ 783C E1               pop  hl
1077+ 783D D1               pop  de
1078+ 783E C1               pop  bc
1079+ 783F FD E1            pop  iy
1080+ 7841
1081+ 7841 C9               ret
1082+ 7842
1083+ 7842              ; -------------------------------------------------------------------
1084+ 7842              ; CheckWillyItemCollision
1085+ 7842              ;
1086+ 7842              ; Verifica se Willy collide con un item utilizzando il controllo
1087+ 7842              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1088+ 7842              ;
1089+ 7842              ; Input:
1090+ 7842              ;   A = ItemX (colonna attributi 0..31)
1091+ 7842              ;   H = ItemY (riga attributi 3..18)
1092+ 7842              ;
1093+ 7842              ; Coordinate item:
1094+ 7842              ;   Ogni item occupa una cella da 8x8 pixel.
1095+ 7842              ;
1096+ 7842              ; Coordinate Willy:
1097+ 7842              ;   Willy occupa un rettangolo di 16x16 pixel.
1098+ 7842              ;
1099+ 7842              ; Output:
1100+ 7842              ;   Carry Set   = collisione rilevata
1101+ 7842              ;   Carry Clear = nessuna collisione
1102+ 7842              ;
1103+ 7842              ; Registri preservati:
1104+ 7842              ;   BC, DE, HL
1105+ 7842              ; -------------------------------------------------------------------
1106+ 7842              CheckWillyItemCollision:
1107+ 7842
1108+ 7842                  ; Salva i registri utilizzati
1109+ 7842 C5               push bc
1110+ 7843 D5               push de
1111+ 7844 E5               push hl
1112+ 7845
