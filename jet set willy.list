   6+ 652A              ; -------------------------------------------------------------------
   7+ 652A              ; CheckCtrl
   8+ 652A              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 652A              ;
  10+ 652A              ; Output:
  11+ 652A              ;   D = bitmask tasti attivi:
  12+ 652A              ;       bit 0 → sinistra (O)
  13+ 652A              ;       bit 1 → destra   (P)
  14+ 652A              ;       bit 2 → salto    (Z)
  15+ 652A              ;
  16+ 652A              ; Effetti collaterali in RAM:
  17+ 652A              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 652A              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 652A              ;   (jump_prev)     → debounce tasto salto
  20+ 652A              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 652A              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 652A              ; -------------------------------------------------------------------
  23+ 652A
  24+ 652A              CheckCtrl:
  25+ 652A AF               xor  a
  26+ 652B 32 FE 73         ld   (current_input_dir), a
  27+ 652E
  28+ 652E                  ; ── Sezione 1: tasto Q (cambio stanza) ──────────────────────────
  29+ 652E                  ;
  30+ 652E                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  31+ 652E                  ; Se bit 0 = 0, Q è premuto.
  32+ 652E
  33+ 652E 3E FB            ld   a, $fb
  34+ 6530 DB FE            in   a, ($fe)
  35+ 6532 CB 47            bit  0, a
  36+ 6534 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  37+ 6536
  38+ 6536                  ; Q è premuto: debounce tramite (q_prev).
  39+ 6536                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  40+ 6536 3A FF 73         ld   a, (q_prev)
  41+ 6539 B7               or   a
  42+ 653A 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  43+ 653C
  44+ 653C                  ; ── Primo frame di pressione di Q ──
  45+ 653C 3E 01            ld   a, 1
  46+ 653E 32 FF 73         ld   (q_prev), a            ; marca "Q era premuto"
  47+ 6541
  48+ 6541                  ; NOTA sullo stack:
  49+ 6541                  ; CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  50+ 6541                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChange senza
  51+ 6541                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  52+ 6541                  ; poi JP salta direttamente.
  53+ 6541 E1               pop  hl                     ; rimuove indirizzo di ritorno di CheckCtrl
  54+ 6542 C3 C9 65         jp   PerformRoomChange      ; salta al cambio stanza (non torna qui)
  55+ 6545
  56+ 6545              .q_not_pressed:
  57+ 6545 AF               xor  a
  58+ 6546 32 FF 73         ld   (q_prev), a            ; Q rilasciato → azzera debounce
  59+ 6549
  60+ 6549              .q_handled:
  61+ 6549
  62+ 6549                  ; ── Sezione 2: movimento (sinistra / destra) ────────────────────
  63+ 6549                  ;
  64+ 6549                  ; Porta $DF → riga P, O, I, U, Y.
  65+ 6549                  ; Bit 0 = P (destra), Bit 1 = O (sinistra).
  66+ 6549
  67+ 6549 16 00            ld  d, $00                  ; azzera output
  68+ 654B 3E DF            ld  a, $df
  69+ 654D DB FE            in  a, ($fe)                ; legge riga $FE
  70+ 654F
  71+ 654F                  ; Se Willy è sul conveyor nella stanza The Off Licence (room 0),
  72+ 654F                  ; impedisci lo spostamento da sinistra a destra (disabilita tasto destra P / bit 0).
  73+ 654F F5               push af
  74+ 6550 3A 02 77         ld   a, (current_room)
  75+ 6553 B7               or   a                      ; Room 0 = The Off Licence
  76+ 6554 20 09            jr   nz, .no_block_conveyor
  77+ 6556 CD 16 6A         call CheckWillyOnConveyor
  78+ 6559 30 04            jr   nc, .no_block_conveyor
  79+ 655B F1               pop  af
  80+ 655C F6 01            or   $01                    ; Forza bit 0 (destra) a 1 (non premuto)
  81+ 655E F5               push af
  82+ 655F              .no_block_conveyor:
  83+ 655F F1               pop  af
  84+ 6560
  85+ 6560 DD 21 F3 73      ld  ix, flags               ; IX punta alla variabile flags
  86+ 6564
  87+ 6564              checkCtrl_left:
  88+ 6564 CB 4F            bit $01, a                  ; bit 1 = O → sinistra?
  89+ 6566 20 18            jr  nz, checkCtrl_right     ; bit = 1 → O non premuto, prova destra
  90+ 6568 CB C2            set $00, d                  ; imposta bit 0 di D = "sinistra attiva"
  91+ 656A DD CB 00 C6      set 0, (ix)                 ; flags bit 0 = "movimento in corso"
  92+ 656E 5F               ld  e, a                    ; salva A
  93+ 656F 3E 01            ld  a, 1
  94+ 6571 32 FE 73         ld  (current_input_dir), a
  95+ 6574 3A F9 73         ld  a, (on_ground)
  96+ 6577 B7               or  a
  97+ 6578 28 05            jr  z, .skip_dir_left
  98+ 657A 3E 01            ld  a, 1
  99+ 657C 32 F2 73         ld  (direction), a          ; direction = 1 → sinistra
 100+ 657F              .skip_dir_left:
 101+ 657F 7B               ld  a, e                    ; ripristina A
 102+ 6580
 103+ 6580              checkCtrl_right:
 104+ 6580 CB 47            bit $00, a                  ; bit 0 = P → destra?
