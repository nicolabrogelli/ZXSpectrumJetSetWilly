 455+ 5FB2 CD 2E 5E         call IncScreenLine ; Vai alla prossima riga dello schermo
 456+ 5FB5 DD 23            inc  ix
 457+ 5FB7 DD 23            inc  ix            ; Avanza di 2 byte nei dati dello sprite
 458+ 5FB9 0D               dec  c
 459+ 5FBA 20 C6            jr   nz, .line_loop
 460+ 5FBC
 461+ 5FBC DD E1            pop  ix
 462+ 5FBE E1               pop  hl
 463+ 5FBF D1               pop  de
 464+ 5FC0 C1               pop  bc
 465+ 5FC1 C9               ret
