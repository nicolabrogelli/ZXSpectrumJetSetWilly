1310+ 7793 29               add  hl, hl
1311+ 7794 29               add  hl, hl
1312+ 7795 29               add  hl, hl
1313+ 7796 29               add  hl, hl
1314+ 7797 29               add  hl, hl            ; HL = Row * 32
1315+ 7798 59               ld   e, c
1316+ 7799 16 00            ld   d, 0
1317+ 779B 19               add  hl, de            ; HL = Row * 32 + Col
1318+ 779C 11 08 F6         ld   de, unpacked_layout
1319+ 779F 19               add  hl, de
1320+ 77A0 7E               ld   a, (hl)           ; A = cell type
1321+ 77A1
1322+ 77A1 D1               pop  de
1323+ 77A2 E1               pop  hl
1324+ 77A3 C9               ret
