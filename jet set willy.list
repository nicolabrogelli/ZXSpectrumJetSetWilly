 925+ 7FF2              .anim_done:
 926+ 7FF2
 927+ 7FF2                  ; 3. Determina se orizzontale o verticale
 928+ 7FF2 DD 7E 00         ld   a, (ix+0)         ; Flags
 929+ 7FF5 E6 40            and  $40               ; Vertical? (Bit 6)
 930+ 7FF7 C2 41 80         jp   nz, .vertical
 931+ 7FFA
 932+ 7FFA              .horizontal:
 933+ 7FFA DD 7E 06         ld   a, (ix+6)         ; Direction (1=Left, 2=Right) (Offset 6)
