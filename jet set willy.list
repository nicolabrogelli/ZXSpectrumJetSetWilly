  18+ 6865
  19+ 6865 CB 4A            bit  $01, d            ; Tasto Destra premuto?
  20+ 6867 20 11            jr   nz, movePlayer_right
  21+ 6869
  22+ 6869 CB 42            bit  $00, d            ; Tasto Sinistra premuto?
  23+ 686B C8               ret  z
  24+ 686C
  25+ 686C              movePlayer_left:
  26+ 686C 79               ld   a, c
  27+ 686D D6 02            sub  2                 ; Prova a muoverti di 2 pixel a sinistra
  28+ 686F FE 08            cp   PLAYER_MIN_X      ; Confronta con il limite sinistro
  29+ 6871 38 03            jr   c, .clamp_left    ; Se < PLAYER_MIN_X, clampa
  30+ 6873 4F               ld   c, a              ; Altrimenti memorizza la nuova posizione
  31+ 6874 18 12            jr   save_x
  32+ 6876
  33+ 6876              .clamp_left:
  34+ 6876 0E 08            ld   c, PLAYER_MIN_X
  35+ 6878 18 0E            jr   save_x
  36+ 687A
  37+ 687A              movePlayer_right:
