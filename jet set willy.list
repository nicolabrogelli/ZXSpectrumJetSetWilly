 939+ 7326              ; -------------------------------------------------------------------
 940+ 7326              ; CheckWillyItemCollision
 941+ 7326              ;
 942+ 7326              ; Verifica se Willy collide con un item utilizzando il controllo
 943+ 7326              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
 944+ 7326              ;
 945+ 7326              ; Input:
 946+ 7326              ;   A = ItemX (colonna attributi 0..31)
 947+ 7326              ;   H = ItemY (riga attributi 3..18)
 948+ 7326              ;
 949+ 7326              ; Coordinate item:
 950+ 7326              ;   Ogni item occupa una cella da 8x8 pixel.
 951+ 7326              ;
 952+ 7326              ; Coordinate Willy:
 953+ 7326              ;   Willy occupa un rettangolo di 16x16 pixel.
 954+ 7326              ;
 955+ 7326              ; Output:
 956+ 7326              ;   Carry Set   = collisione rilevata
 957+ 7326              ;   Carry Clear = nessuna collisione
 958+ 7326              ;
 959+ 7326              ; Registri preservati:
 960+ 7326              ;   BC, DE, HL
 961+ 7326              ; -------------------------------------------------------------------
 962+ 7326              CheckWillyItemCollision:
 963+ 7326
 964+ 7326                  ; Salva i registri utilizzati
 965+ 7326 C5               push bc
 966+ 7327 D5               push de
 967+ 7328 E5               push hl
 968+ 7329
 969+ 7329                  ; ---------------------------------------------------------------
 970+ 7329                  ; Calcola il bounding box orizzontale dell'item
 971+ 7329                  ;
 972+ 7329                  ; ItemLeft  = ItemX * 8
 973+ 7329                  ; ItemRight = ItemLeft + 7
 974+ 7329                  ;
 975+ 7329                  ; E = ItemLeft
 976+ 7329                  ; D = ItemRight
 977+ 7329                  ; ---------------------------------------------------------------
 978+ 7329 6F               ld   l, a              ; L = ItemX
 979+ 732A
 980+ 732A 7D               ld   a, l
 981+ 732B 87               add  a, a              ; *2
 982+ 732C 87               add  a, a              ; *4
 983+ 732D 87               add  a, a              ; *8
 984+ 732E
 985+ 732E 5F               ld   e, a              ; E = ItemLeft
 986+ 732F
 987+ 732F C6 07            add  a, 7
 988+ 7331 57               ld   d, a              ; D = ItemRight
 989+ 7332
 990+ 7332                  ; ---------------------------------------------------------------
 991+ 7332                  ; Recupera la posizione corrente di Willy
 992+ 7332                  ;
 993+ 7332                  ; B = WillyY
 994+ 7332                  ; C = WillyX
 995+ 7332                  ; ---------------------------------------------------------------
 996+ 7332 ED 4B 03 75      ld   bc, (PlayerPos)
 997+ 7336
 998+ 7336                  ; ---------------------------------------------------------------
 999+ 7336                  ; Primo test:
1000+ 7336                  ;
1001+ 7336                  ; WillyLeft <= ItemRight
1002+ 7336                  ;
1003+ 7336                  ; Se Willy è completamente a destra dell'item
1004+ 7336                  ; non può esserci collisione.
1005+ 7336                  ; ---------------------------------------------------------------
1006+ 7336 79               ld   a, c              ; A = WillyLeft
1007+ 7337
1008+ 7337 BA               cp   d                 ; WillyLeft vs ItemRight
1009+ 7338
1010+ 7338 28 04            jr   z, .x_ok
1011+ 733A 38 02            jr   c, .x_ok
1012+ 733C
1013+ 733C 18 29            jr   .no_collision
1014+ 733E
1015+ 733E              .x_ok:
1016+ 733E
1017+ 733E                  ; ---------------------------------------------------------------
1018+ 733E                  ; Secondo test:
1019+ 733E                  ;
1020+ 733E                  ; WillyRight >= ItemLeft
1021+ 733E                  ;
1022+ 733E                  ; WillyRight = WillyX + 7
1023+ 733E                  ; ---------------------------------------------------------------
1024+ 733E C6 07            add  a, 7
1025+ 7340
1026+ 7340 BB               cp   e                 ; WillyRight vs ItemLeft
1027+ 7341
1028+ 7341 28 04            jr   z, .y_check
1029+ 7343 30 02            jr   nc, .y_check
1030+ 7345
1031+ 7345 18 20            jr   .no_collision
1032+ 7347
1033+ 7347              .y_check:
1034+ 7347
1035+ 7347                  ; ---------------------------------------------------------------
1036+ 7347                  ; Recupera ItemY dal valore originale di HL
1037+ 7347                  ;
1038+ 7347                  ; H contiene la riga dell'item.
1039+ 7347                  ; ---------------------------------------------------------------
1040+ 7347 E1               pop  hl
1041+ 7348 E5               push hl
1042+ 7349
1043+ 7349                  ; ---------------------------------------------------------------
1044+ 7349                  ; Calcola il bounding box verticale dell'item
1045+ 7349                  ;
1046+ 7349                  ; ItemTop    = ItemY * 8
1047+ 7349                  ; ItemBottom = ItemTop + 7
1048+ 7349                  ;
1049+ 7349                  ; E = ItemTop
1050+ 7349                  ; D = ItemBottom
1051+ 7349                  ; ---------------------------------------------------------------
1052+ 7349 7C               ld   a, h
1053+ 734A
1054+ 734A 87               add  a, a              ; *2
1055+ 734B 87               add  a, a              ; *4
1056+ 734C 87               add  a, a              ; *8
1057+ 734D
1058+ 734D 5F               ld   e, a              ; ItemTop
1059+ 734E
1060+ 734E C6 07            add  a, 7
1061+ 7350 57               ld   d, a              ; ItemBottom
1062+ 7351
1063+ 7351                  ; ---------------------------------------------------------------
1064+ 7351                  ; Primo test verticale:
1065+ 7351                  ;
1066+ 7351                  ; WillyTop <= ItemBottom
1067+ 7351                  ; ---------------------------------------------------------------
1068+ 7351 78               ld   a, b              ; WillyTop
1069+ 7352
1070+ 7352 BA               cp   d
1071+ 7353
1072+ 7353 28 04            jr   z, .y_ok
1073+ 7355 38 02            jr   c, .y_ok
1074+ 7357
1075+ 7357 18 0E            jr   .no_collision
1076+ 7359
1077+ 7359              .y_ok:
1078+ 7359
1079+ 7359                  ; ---------------------------------------------------------------
1080+ 7359                  ; Secondo test verticale:
1081+ 7359                  ;
1082+ 7359                  ; WillyBottom >= ItemTop
1083+ 7359                  ;
1084+ 7359                  ; WillyBottom = WillyY + 15
1085+ 7359                  ; ---------------------------------------------------------------
1086+ 7359 C6 0F            add  a, 15
1087+ 735B
1088+ 735B BB               cp   e
1089+ 735C
1090+ 735C 28 04            jr   z, .collision
1091+ 735E 30 02            jr   nc, .collision
1092+ 7360
1093+ 7360 18 05            jr   .no_collision
1094+ 7362
1095+ 7362              .collision:
1096+ 7362
1097+ 7362                  ; ---------------------------------------------------------------
1098+ 7362                  ; Collisione rilevata
1099+ 7362                  ; ---------------------------------------------------------------
1100+ 7362 E1               pop  hl
1101+ 7363 D1               pop  de
1102+ 7364 C1               pop  bc
1103+ 7365
1104+ 7365 37               scf                    ; Carry = 1
1105+ 7366
1106+ 7366 C9               ret
1107+ 7367
1108+ 7367              .no_collision:
1109+ 7367
1110+ 7367                  ; ---------------------------------------------------------------
1111+ 7367                  ; Nessuna collisione
1112+ 7367                  ; ---------------------------------------------------------------
1113+ 7367 E1               pop  hl
1114+ 7368 D1               pop  de
1115+ 7369 C1               pop  bc
1116+ 736A
1117+ 736A B7               or   a                 ; Carry = 0
1118+ 736B
1119+ 736B C9               ret
1120+ 736C
1121+ 736C              ; -------------------------------------------------------------------
1122+ 736C              ; CheckRoomItemsCollision
1123+ 736C              ;
1124+ 736C              ; Controlla se Willy entra in collisione con uno degli item
1125+ 736C              ; attivi presenti nella stanza corrente.
1126+ 736C              ;
1127+ 736C              ; Per ogni item:
1128+ 736C              ;   - verifica che appartenga alla stanza corrente
1129+ 736C              ;   - verifica che non sia già stato raccolto
1130+ 736C              ;   - esegue il test di collisione con Willy
1131+ 736C              ;
1132+ 736C              ; Se l'item viene raccolto:
1133+ 736C              ;   - imposta il flag "collected"
1134+ 736C              ;   - rimuove l'item dalla cache items_grid
1135+ 736C              ;   - incrementa il contatore degli oggetti raccolti
1136+ 736C              ;   - aggiorna l'HUD
1137+ 736C              ;   - ripristina il tile di sfondo
1138+ 736C              ;   - riproduce il suono di raccolta
1139+ 736C              ;
1140+ 736C              ; Formato record ItemsTable:
1141+ 736C              ;   +0 RoomID
1142+ 736C              ;   +1 X
1143+ 736C              ;   +2 Y
1144+ 736C              ;   +3 Color
1145+ 736C              ;   +4 Collected
1146+ 736C              ;
1147+ 736C              ; Fine tabella:
1148+ 736C              ;   RoomID = $FF
1149+ 736C              ; -------------------------------------------------------------------
1150+ 736C              CheckRoomItemsCollision:
1151+ 736C
1152+ 736C                  ; Salva i registri utilizzati
1153+ 736C E5               push hl
1154+ 736D D5               push de
1155+ 736E C5               push bc
1156+ 736F
1157+ 736F                  ; Inizio scansione della tabella degli item
1158+ 736F 21 53 70         ld   hl, ItemsTable
1159+ 7372
