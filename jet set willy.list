 120+ 655A              ; Clamp sinistra: forzatura al limite minimo
 121+ 655A              ; ---------------------------------------------------------------
 122+ 655A              .clamp_left:
 123+ 655A                  ; Controlla se c'è una stanza a sinistra
 124+ 655A 2A FA 7E         ld   hl, (room_ptr)
 125+ 655D 11 EB 00         ld   de, 235           ; Offset per stanza a sinistra
 126+ 6560 19               add  hl, de
 127+ 6561 7E               ld   a, (hl)           ; A = ID stanza a sinistra
 128+ 6562 FE FF            cp   $FF
 129+ 6564 28 05            jr   z, .no_left_transition
 130+ 6566
 131+ 6566                  ; C'è una stanza a sinistra!
 132+ 6566 0E F5            ld   c, PLAYER_MAX_X   ; Posiziona Willy a destra della nuova stanza
 133+ 6568 C3 08 67         jp   TriggerRoomChange ; Salta alla transizione (non ritorna qui)
