 641+ 6AE1 C1               pop  bc
 642+ 6AE2 D1               pop  de
 643+ 6AE3 E1               pop  hl
 644+ 6AE4 37               scf                    ; Imposta carry flag
 645+ 6AE5 C9               ret
 646+ 6AE6
 647+ 6AE6              .next:
 648+ 6AE6 11 0B 00         ld   de, 11
 649+ 6AE9 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 650+ 6AEB 05               dec  b
 651+ 6AEC 20 D2            jr   nz, .loop
 652+ 6AEE
 653+ 6AEE DD E1            pop  ix
 654+ 6AF0 C1               pop  bc
 655+ 6AF1 D1               pop  de
 656+ 6AF2 E1               pop  hl
