 253  837C              .delay:
 254  837C 0D               dec  c
 255  837D 20 FD            jr   nz, .delay
 256  837F 10 F4            djnz .raster_loop
 257  8381
 258  8381                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 259  8381 3A C9 E6         ld   a, (room_border_color)
 260  8384 D3 FE            out  ($fe), a
 261  8386 18 05            jr   .no_collision_change
 262  8388
 263  8388              .no_collision:
 264  8388                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 265  8388 3A C9 E6         ld   a, (room_border_color)
