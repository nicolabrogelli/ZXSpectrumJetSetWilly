1079+ 8060              ; -------------------------------------------------------------------
1080+ 8060              ; Items_DrawRoom
1081+ 8060              ;
1082+ 8060              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1083+ 8060              ;
1084+ 8060              ; Operazioni eseguite:
1085+ 8060              ;   1. Azzera la griglia items_grid.
1086+ 8060              ;   2. Svuota la cache degli oggetti attivi.
1087+ 8060              ;   3. Scansiona ItemsTable.
1088+ 8060              ;   4. Per ogni item della stanza corrente:
1089+ 8060              ;        - verifica se è già stato raccolto
1090+ 8060              ;        - disegna la grafica
1091+ 8060              ;        - aggiorna items_grid
1092+ 8060              ;        - memorizza l'item nella cache current_room_items
1093+ 8060              ;   5. Aggiorna num_room_items.
1094+ 8060              ;
1095+ 8060              ; Record ItemsTable:
1096+ 8060              ;   +0  Room ID
1097+ 8060              ;   +1  X (colonna)
1098+ 8060              ;   +2  Y (riga)
1099+ 8060              ;   +3  Colore
1100+ 8060              ;   +4  Collected flag
1101+ 8060              ;
1102+ 8060              ; Cache current_room_items:
1103+ 8060              ;   +0  Colonna
1104+ 8060              ;   +1  Riga
1105+ 8060              ;   +2  Colore
1106+ 8060              ;   +3  Collected flag ptr (Low)
1107+ 8060              ;   +4  Collected flag ptr (High)
1108+ 8060              ;
1109+ 8060              ; Ogni record cache occupa 5 byte.
1110+ 8060              ; -------------------------------------------------------------------
1111+ 8060              ; ResetItemsTable
1112+ 8060              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1113+ 8060              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1114+ 8060              ; -------------------------------------------------------------------
1115+ 8060              ResetItemsTable:
1116+ 8060 21 09 7B         ld   hl, ItemsTable
1117+ 8063              .reset_loop:
1118+ 8063 7E               ld   a, (hl)
1119+ 8064 FE FF            cp   $FF
1120+ 8066 C8               ret  z
1121+ 8067 23               inc  hl                        ; +1 (X)
1122+ 8068 23               inc  hl                        ; +2 (Y)
1123+ 8069 23               inc  hl                        ; +3 (Color)
1124+ 806A 23               inc  hl                        ; +4 (Collected flag)
1125+ 806B 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1126+ 806D 23               inc  hl                        ; Prossimo record
1127+ 806E 18 F3            jr   .reset_loop
1128+ 8070
1129+ 8070              ; -------------------------------------------------------------------
1130+ 8070              Items_DrawRoom:
1131+ 8070
1132+ 8070                  ; Salva tutti i registri utilizzati
1133+ 8070 E5               push hl
1134+ 8071 D5               push de
1135+ 8072 C5               push bc
1136+ 8073 DD E5            push ix
1137+ 8075 FD E5            push iy
1138+ 8077
1139+ 8077                  ; ---------------------------------------------------------------
1140+ 8077                  ; Azzera items_grid (32 x 16 = 512 byte)
1141+ 8077                  ; ---------------------------------------------------------------
1142+ 8077 21 16 E5         ld   hl, items_grid
1143+ 807A 11 17 E5         ld   de, items_grid + 1
1144+ 807D 36 00            ld   (hl), 0
1145+ 807F 01 FF 01         ld   bc, 511
1146+ 8082 ED B0            ldir
1147+ 8084
1148+ 8084                  ; ---------------------------------------------------------------
1149+ 8084                  ; Nessun item attivo nella stanza
1150+ 8084                  ; ---------------------------------------------------------------
1151+ 8084 AF               xor  a
1152+ 8085 32 95 EA         ld   (num_room_items), a
1153+ 8088
1154+ 8088                  ; IY punta alla cache degli item attivi
1155+ 8088 FD 21 45 EA      ld   iy, current_room_items
1156+ 808C
1157+ 808C                  ; ---------------------------------------------------------------
1158+ 808C                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1159+ 808C                  ; alla stanza corrente.
1160+ 808C                  ;
1161+ 808C                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1162+ 808C                  ; ---------------------------------------------------------------
1163+ 808C 2A 96 EA         ld   hl, (room_ptr)
1164+ 808F 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1165+ 8092 19               add  hl, de
1166+ 8093
1167+ 8093 E5               push hl
1168+ 8094 DD E1            pop  ix                ; IX = bitmap item
1169+ 8096
1170+ 8096                  ; ---------------------------------------------------------------
1171+ 8096                  ; Inizio scansione della tabella degli item
1172+ 8096                  ; ---------------------------------------------------------------
1173+ 8096 21 09 7B         ld   hl, ItemsTable
1174+ 8099
1175+ 8099              .loop:
1176+ 8099
1177+ 8099                  ; ---------------------------------------------------------------
1178+ 8099                  ; Legge il Room ID del record corrente
1179+ 8099                  ; ---------------------------------------------------------------
1180+ 8099 7E               ld   a, (hl)
1181+ 809A
1182+ 809A                  ; $FF indica fine tabella
1183+ 809A FE FF            cp   $FF
1184+ 809C 28 53            jr   z, .done
1185+ 809E
1186+ 809E                  ; ---------------------------------------------------------------
1187+ 809E                  ; Verifica se l'item appartiene alla stanza corrente
1188+ 809E                  ; ---------------------------------------------------------------
1189+ 809E 57               ld   d, a
1190+ 809F
1191+ 809F 3A 3C EA         ld   a, (current_room)
1192+ 80A2 BA               cp   d
1193+ 80A3 20 45            jr   nz, .next_item
1194+ 80A5
1195+ 80A5                  ; ---------------------------------------------------------------
1196+ 80A5                  ; Legge i dati dell'item
1197+ 80A5                  ; ---------------------------------------------------------------
1198+ 80A5
1199+ 80A5 23               inc  hl
1200+ 80A6 4E               ld   c, (hl)           ; X (colonna)
1201+ 80A7
1202+ 80A7 23               inc  hl
1203+ 80A8 46               ld   b, (hl)           ; Y (riga)
1204+ 80A9
1205+ 80A9 23               inc  hl
1206+ 80AA 5E               ld   e, (hl)           ; Colore
1207+ 80AB
1208+ 80AB 23               inc  hl
1209+ 80AC 7E               ld   a, (hl)           ; Collected flag
1210+ 80AD
1211+ 80AD                  ; Se diverso da zero l'item è già stato raccolto
1212+ 80AD B7               or   a
1213+ 80AE 20 3E            jr   nz, .next_no_inc
1214+ 80B0
1215+ 80B0                  ; ---------------------------------------------------------------
1216+ 80B0                  ; Disegna l'item sullo schermo
1217+ 80B0                  ;
1218+ 80B0                  ; B = Row
1219+ 80B0                  ; C = Column
1220+ 80B0                  ; HL = bitmap pointer
1221+ 80B0                  ; E = Color
1222+ 80B0                  ; ---------------------------------------------------------------
1223+ 80B0 E5               push hl
1224+ 80B1
1225+ 80B1 DD E5            push ix
1226+ 80B3 E1               pop  hl
1227+ 80B4
1228+ 80B4 CD F9 80         call DrawItemGraphic
1229+ 80B7
1230+ 80B7 E1               pop  hl                ; ritorna al flag collected
1231+ 80B8
1232+ 80B8                  ; ---------------------------------------------------------------
1233+ 80B8                  ; Aggiorna items_grid
1234+ 80B8                  ;
1235+ 80B8                  ; Calcolo:
1236+ 80B8                  ;   offset = Row * 32 + Col
1237+ 80B8                  ; ---------------------------------------------------------------
1238+ 80B8 E5               push hl
1239+ 80B9 D5               push de
1240+ 80BA
1241+ 80BA 26 00            ld   h, 0
1242+ 80BC 68               ld   l, b              ; HL = Row
1243+ 80BD
1244+ 80BD 29               add  hl, hl            ; *2
1245+ 80BE 29               add  hl, hl            ; *4
1246+ 80BF 29               add  hl, hl            ; *8
1247+ 80C0 29               add  hl, hl            ; *16
1248+ 80C1 29               add  hl, hl            ; *32
1249+ 80C2
1250+ 80C2 16 00            ld   d, 0
1251+ 80C4 59               ld   e, c              ; DE = Col
1252+ 80C5
1253+ 80C5 19               add  hl, de            ; Row*32 + Col
1254+ 80C6
1255+ 80C6 11 16 E5         ld   de, items_grid
1256+ 80C9 19               add  hl, de            ; puntatore nella griglia
1257+ 80CA
1258+ 80CA D1               pop  de                ; ripristina colore
1259+ 80CB
1260+ 80CB 73               ld   (hl), e           ; salva colore cella
1261+ 80CC
1262+ 80CC E1               pop  hl
1263+ 80CD
1264+ 80CD                  ; ---------------------------------------------------------------
1265+ 80CD                  ; Salva l'item nella cache della stanza
1266+ 80CD                  ;
1267+ 80CD                  ; Questo evita di dover scansionare tutta ItemsTable
1268+ 80CD                  ; durante il controllo delle collisioni.
1269+ 80CD                  ; ---------------------------------------------------------------
1270+ 80CD
1271+ 80CD FD 71 00         ld   (iy+0), c         ; Colonna
1272+ 80D0 FD 70 01         ld   (iy+1), b         ; Riga
1273+ 80D3 FD 73 02         ld   (iy+2), e         ; Colore
1274+ 80D6
1275+ 80D6                  ; Salva il puntatore al flag "collected"
1276+ 80D6 FD 75 03         ld   (iy+3), l         ; Low byte
1277+ 80D9 FD 74 04         ld   (iy+4), h         ; High byte
1278+ 80DC
1279+ 80DC                  ; Passa al record successivo della cache
1280+ 80DC 01 05 00         ld   bc, 5
1281+ 80DF FD 09            add  iy, bc
1282+ 80E1
1283+ 80E1                  ; Incrementa il numero di item attivi
1284+ 80E1 3A 95 EA         ld   a, (num_room_items)
1285+ 80E4 3C               inc  a
1286+ 80E5 32 95 EA         ld   (num_room_items), a
1287+ 80E8
1288+ 80E8 18 04            jr   .next_no_inc
1289+ 80EA
1290+ 80EA              .next_item:
1291+ 80EA
1292+ 80EA                  ; ---------------------------------------------------------------
1293+ 80EA                  ; L'item non appartiene alla stanza corrente.
1294+ 80EA                  ; Salta i campi del record:
1295+ 80EA                  ;   X
1296+ 80EA                  ;   Y
1297+ 80EA                  ;   Color
1298+ 80EA                  ;   Collected
1299+ 80EA                  ; ---------------------------------------------------------------
1300+ 80EA 23               inc  hl
1301+ 80EB 23               inc  hl
1302+ 80EC 23               inc  hl
1303+ 80ED 23               inc  hl
1304+ 80EE
1305+ 80EE              .next_no_inc:
1306+ 80EE
1307+ 80EE                  ; ---------------------------------------------------------------
1308+ 80EE                  ; Avanza al record successivo
1309+ 80EE                  ; (prossimo Room ID)
1310+ 80EE                  ; ---------------------------------------------------------------
1311+ 80EE 23               inc  hl
1312+ 80EF 18 A8            jr   .loop
1313+ 80F1
1314+ 80F1              .done:
1315+ 80F1
1316+ 80F1                  ; Ripristina i registri
1317+ 80F1 FD E1            pop  iy
1318+ 80F3 DD E1            pop  ix
1319+ 80F5 D1               pop  de
1320+ 80F6 C1               pop  bc
1321+ 80F7 E1               pop  hl
1322+ 80F8
1323+ 80F8 C9               ret
1324+ 80F9
1325+ 80F9              ; -------------------------------------------------------------------
1326+ 80F9              ; DrawItemGraphic
1327+ 80F9              ;
1328+ 80F9              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1329+ 80F9              ; utilizzando una bitmap di 8 byte e un attributo colore.
1330+ 80F9              ;
1331+ 80F9              ; Input:
1332+ 80F9              ;   B = Riga attributi (3..18)
1333+ 80F9              ;   C = Colonna attributi (0..31)
1334+ 80F9              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1335+ 80F9              ;   E = Attributo colore
1336+ 80F9              ;
1337+ 80F9              ; Output:
1338+ 80F9              ;   Nessuno
1339+ 80F9              ;
1340+ 80F9              ; Registri preservati:
1341+ 80F9              ;   BC, DE, HL
1342+ 80F9              ; -------------------------------------------------------------------
1343+ 80F9              DrawItemGraphic:
1344+ 80F9
1345+ 80F9                  ; Salva i registri originali
1346+ 80F9 C5               push bc
1347+ 80FA D5               push de
1348+ 80FB E5               push hl
1349+ 80FC
1350+ 80FC                  ; ---------------------------------------------------------------
1351+ 80FC                  ; Calcolo indirizzo bitmap dello Spectrum
1352+ 80FC                  ;
1353+ 80FC                  ; Ogni item occupa una cella attributi (8x8 pixel).
1354+ 80FC                  ;
1355+ 80FC                  ; Formula:
1356+ 80FC                  ;   High = $40 + (Row AND $18)
1357+ 80FC                  ;   Low  = (Row AND 7) * 32 + Col
1358+ 80FC                  ;
1359+ 80FC                  ; DE conterrà l'indirizzo della prima scanline.
1360+ 80FC                  ; ---------------------------------------------------------------
1361+ 80FC
1362+ 80FC 78               ld   a, b
1363+ 80FD E6 18            and  $18
1364+ 80FF C6 40            add  a, $40
1365+ 8101 57               ld   d, a              ; Byte alto indirizzo video
1366+ 8102
1367+ 8102 78               ld   a, b
1368+ 8103 E6 07            and  7                 ; Riga interna al blocco da 8
1369+ 8105
1370+ 8105 87               add  a, a              ; *2
1371+ 8106 87               add  a, a              ; *4
1372+ 8107 87               add  a, a              ; *8
1373+ 8108 87               add  a, a              ; *16
1374+ 8109 87               add  a, a              ; *32
1375+ 810A
1376+ 810A 81               add  a, c              ; + colonna
1377+ 810B
1378+ 810B 5F               ld   e, a              ; Byte basso indirizzo video
1379+ 810C
1380+ 810C                  ; ---------------------------------------------------------------
1381+ 810C                  ; Disegno bitmap
1382+ 810C                  ;
1383+ 810C                  ; Copia 8 byte consecutivi nella memoria video.
1384+ 810C                  ; Ogni byte rappresenta una scanline da 8 pixel.
1385+ 810C                  ; ---------------------------------------------------------------
1386+ 810C
1387+ 810C C5               push bc                ; Conserva Row e Col
1388+ 810D
1389+ 810D 06 08            ld   b, 8              ; Numero scanline
1390+ 810F
1391+ 810F              .line_loop:
1392+ 810F
1393+ 810F 7E               ld   a, (hl)           ; Legge scanline bitmap
1394+ 8110 12               ld   (de), a           ; Scrive nella memoria video
1395+ 8111
1396+ 8111 14               inc  d                 ; Scanline successiva
1397+ 8112 23               inc  hl                ; Byte bitmap successivo
1398+ 8113
1399+ 8113 05               dec  b
1400+ 8114 20 F9            jr   nz, .line_loop
1401+ 8116
1402+ 8116 C1               pop  bc                ; Ripristina Row e Col
1403+ 8117
1404+ 8117                  ; ---------------------------------------------------------------
1405+ 8117                  ; Calcolo indirizzo attributo
1406+ 8117                  ;
1407+ 8117                  ; Formula:
1408+ 8117                  ;   AttrAddr = $5800 + Row * 32 + Col
1409+ 8117                  ;
1410+ 8117                  ; HL conterrà l'indirizzo della cella attributi.
1411+ 8117                  ; ---------------------------------------------------------------
1412+ 8117
1413+ 8117 26 00            ld   h, 0
1414+ 8119 68               ld   l, b              ; HL = Row
1415+ 811A
1416+ 811A 29               add  hl, hl            ; *2
1417+ 811B 29               add  hl, hl            ; *4
1418+ 811C 29               add  hl, hl            ; *8
1419+ 811D 29               add  hl, hl            ; *16
1420+ 811E 29               add  hl, hl            ; *32
1421+ 811F
1422+ 811F 79               ld   a, c              ; A = Colonna
1423+ 8120
1424+ 8120 85               add  a, l
1425+ 8121 6F               ld   l, a
1426+ 8122
1427+ 8122 30 01            jr   nc, .no_carry
1428+ 8124 24               inc  h
1429+ 8125
1430+ 8125              .no_carry:
1431+ 8125
1432+ 8125                  ; HL = Row * 32 + Col
1433+ 8125
1434+ 8125 11 00 58         ld   de, $5800
1435+ 8128 19               add  hl, de            ; HL = indirizzo attributi
1436+ 8129
1437+ 8129                  ; ---------------------------------------------------------------
1438+ 8129                  ; Recupera il colore originale dallo stack.
1439+ 8129                  ;
1440+ 8129                  ; Layout stack:
1441+ 8129                  ;   HL originale
1442+ 8129                  ;   DE originale (E = colore)
1443+ 8129                  ;   BC originale
1444+ 8129                  ; ---------------------------------------------------------------
1445+ 8129
1446+ 8129 C1               pop  bc                ; Recupera HL originale
1447+ 812A D1               pop  de                ; Recupera DE originale
1448+ 812B
1449+ 812B                  ; ---------------------------------------------------------------
1450+ 812B                  ; Scrive l'attributo colore
1451+ 812B                  ; ---------------------------------------------------------------
1452+ 812B
1453+ 812B 7B               ld   a, e              ; A = colore
1454+ 812C 77               ld   (hl), a           ; Scrive nella RAM attributi
1455+ 812D
1456+ 812D                  ; ---------------------------------------------------------------
1457+ 812D                  ; Ripristina HL e BC originali
1458+ 812D                  ; ---------------------------------------------------------------
1459+ 812D
1460+ 812D C5               push bc
1461+ 812E E1               pop  hl                ; HL originale
1462+ 812F
1463+ 812F C1               pop  bc                ; BC originale
1464+ 8130
1465+ 8130 C9               ret
1466+ 8131
1467+ 8131              ; -------------------------------------------------------------------
1468+ 8131              ; RestoreBackgroundCell
1469+ 8131              ;
1470+ 8131              ; Ripristina il contenuto originale di una cella della stanza.
1471+ 8131              ; Viene utilizzata principalmente quando un item viene raccolto:
1472+ 8131              ; invece di lasciare un "buco", la routine ridisegna il tile
1473+ 8131              ; originale presente nella mappa della stanza.
1474+ 8131              ;
1475+ 8131              ; Input:
1476+ 8131              ;   B = Row (3..18)
1477+ 8131              ;   C = Col (0..31)
1478+ 8131              ;
1479+ 8131              ; Utilizza:
1480+ 8131              ;   room_ptr -> struttura dati della stanza corrente
1481+ 8131              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1482+ 8131              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1483+ 8131              ;
1484+ 8131              ; Tipi di cella:
1485+ 8131              ;   0 = Background
1486+ 8131              ;   1 = Floor
1487+ 8131              ;   2 = Wall
1488+ 8131              ;   3 = Nasty
1489+ 8131              ; -------------------------------------------------------------------
1490+ 8131              RestoreBackgroundCell:
1491+ 8131
1492+ 8131                  ; Salva tutti i registri utilizzati
1493+ 8131 FD E5            push iy
1494+ 8133 C5               push bc
1495+ 8134 D5               push de
1496+ 8135 E5               push hl
1497+ 8136 DD E5            push ix
1498+ 8138
1499+ 8138                  ; ---------------------------------------------------------------
1500+ 8138                  ; Conserva Row e Col in IY.
1501+ 8138                  ;
1502+ 8138                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1503+ 8138                  ; BC potrebbe essere modificato.
1504+ 8138                  ; ---------------------------------------------------------------
1505+ 8138 C5               push bc
1506+ 8139 FD E1            pop  iy                ; IYH = Row, IYL = Col
1507+ 813B
1508+ 813B                  ; ---------------------------------------------------------------
1509+ 813B                  ; Determina quale tipo di cella è presente nella posizione
1510+ 813B                  ; specificata.
1511+ 813B                  ;
1512+ 813B                  ; Input:
1513+ 813B                  ;   B = Row
1514+ 813B                  ;   C = Col
1515+ 813B                  ;
1516+ 813B                  ; Output:
1517+ 813B                  ;   A = tipo cella
1518+ 813B                  ; ---------------------------------------------------------------
1519+ 813B 78               ld   a, b
1520+ 813C
1521+ 813C CD 37 72         call GetCellFromUnpacked
1522+ 813F
1523+ 813F                  ; ---------------------------------------------------------------
1524+ 813F                  ; Recupera il puntatore alla stanza corrente.
1525+ 813F                  ;
1526+ 813F                  ; DE = base della struttura stanza
1527+ 813F                  ; ---------------------------------------------------------------
1528+ 813F ED 5B 96 EA      ld   de, (room_ptr)
1529+ 8143
1530+ 8143                  ; ---------------------------------------------------------------
1531+ 8143                  ; Seleziona il tile corretto in base al tipo di cella.
1532+ 8143                  ;
1533+ 8143                  ; A = 0 -> Background
1534+ 8143                  ; A = 1 -> Floor
1535+ 8143                  ; A = 2 -> Wall
1536+ 8143                  ; A = 3 -> Nasty
1537+ 8143                  ; ---------------------------------------------------------------
1538+ 8143
1539+ 8143 B7               or   a
1540+ 8144 20 06            jr   nz, .not_bg
1541+ 8146
1542+ 8146                  ; Background
1543+ 8146 21 A0 00         ld   hl, OFFSET_BG
1544+ 8149 19               add  hl, de
1545+ 814A 18 16            jr   .draw_cell
1546+ 814C
1547+ 814C              .not_bg:
1548+ 814C
1549+ 814C 3D               dec  a
1550+ 814D 20 06            jr   nz, .not_floor
1551+ 814F
1552+ 814F                  ; Floor
1553+ 814F 21 A9 00         ld   hl, OFFSET_FLOOR
1554+ 8152 19               add  hl, de
1555+ 8153 18 0D            jr   .draw_cell
1556+ 8155
1557+ 8155              .not_floor:
1558+ 8155
1559+ 8155 3D               dec  a
1560+ 8156 20 06            jr   nz, .not_wall
1561+ 8158
1562+ 8158                  ; Wall
1563+ 8158 21 B2 00         ld   hl, OFFSET_WALL
1564+ 815B 19               add  hl, de
1565+ 815C 18 04            jr   .draw_cell
1566+ 815E
1567+ 815E              .not_wall:
1568+ 815E
1569+ 815E                  ; Nasty
1570+ 815E 21 BB 00         ld   hl, OFFSET_NASTY
1571+ 8161 19               add  hl, de
1572+ 8162
1573+ 8162              .draw_cell:
1574+ 8162
1575+ 8162                  ; ---------------------------------------------------------------
1576+ 8162                  ; HL punta ora alla grafica del tile da ridisegnare.
1577+ 8162                  ;
1578+ 8162                  ; Gfx_DrawTile si aspetta:
1579+ 8162                  ;   IX = puntatore tile
1580+ 8162                  ;   B  = Row
1581+ 8162                  ;   C  = Col
1582+ 8162                  ; ---------------------------------------------------------------
1583+ 8162 E5               push hl
1584+ 8163 DD E1            pop  ix
1585+ 8165
1586+ 8165                  ; Ripristina Row e Col salvati in IY
1587+ 8165 FD E5            push iy
1588+ 8167 C1               pop  bc
1589+ 8168
1590+ 8168                  ; Disegna il tile originale
1591+ 8168 CD 06 65         call Gfx_DrawTile
1592+ 816B
1593+ 816B                  ; ---------------------------------------------------------------
1594+ 816B                  ; Ripristina i registri salvati
1595+ 816B                  ; ---------------------------------------------------------------
1596+ 816B DD E1            pop  ix
1597+ 816D E1               pop  hl
1598+ 816E D1               pop  de
1599+ 816F C1               pop  bc
1600+ 8170 FD E1            pop  iy
1601+ 8172
1602+ 8172 C9               ret
1603+ 8173
1604+ 8173              ; -------------------------------------------------------------------
1605+ 8173              ; CheckWillyItemCollision
1606+ 8173              ;
1607+ 8173              ; Verifica se Willy collide con un item utilizzando il controllo
1608+ 8173              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1609+ 8173              ;
1610+ 8173              ; Input:
1611+ 8173              ;   A = ItemX (colonna attributi 0..31)
1612+ 8173              ;   H = ItemY (riga attributi 3..18)
1613+ 8173              ;
1614+ 8173              ; Coordinate item:
1615+ 8173              ;   Ogni item occupa una cella da 8x8 pixel.
1616+ 8173              ;
1617+ 8173              ; Coordinate Willy:
1618+ 8173              ;   Willy occupa un rettangolo di 16x16 pixel.
1619+ 8173              ;
1620+ 8173              ; Output:
1621+ 8173              ;   Carry Set   = collisione rilevata
1622+ 8173              ;   Carry Clear = nessuna collisione
1623+ 8173              ;
1624+ 8173              ; Registri preservati:
1625+ 8173              ;   BC, DE, HL
1626+ 8173              ; -------------------------------------------------------------------
1627+ 8173              CheckWillyItemCollision:
1628+ 8173
1629+ 8173                  ; Salva i registri utilizzati
1630+ 8173 C5               push bc
1631+ 8174 D5               push de
1632+ 8175 E5               push hl
1633+ 8176
1634+ 8176                  ; ---------------------------------------------------------------
1635+ 8176                  ; Calcola il bounding box orizzontale dell'item
1636+ 8176                  ;
1637+ 8176                  ; ItemLeft  = ItemX * 8
1638+ 8176                  ; ItemRight = ItemLeft + 7
1639+ 8176                  ;
1640+ 8176                  ; E = ItemLeft
1641+ 8176                  ; D = ItemRight
1642+ 8176                  ; ---------------------------------------------------------------
1643+ 8176 6F               ld   l, a              ; L = ItemX
1644+ 8177
1645+ 8177 7D               ld   a, l
1646+ 8178 87               add  a, a              ; *2
1647+ 8179 87               add  a, a              ; *4
1648+ 817A 87               add  a, a              ; *8
1649+ 817B
1650+ 817B 5F               ld   e, a              ; E = ItemLeft
1651+ 817C
1652+ 817C C6 07            add  a, 7
1653+ 817E 57               ld   d, a              ; D = ItemRight
1654+ 817F
1655+ 817F                  ; ---------------------------------------------------------------
1656+ 817F                  ; Recupera la posizione corrente di Willy
1657+ 817F                  ;
1658+ 817F                  ; B = WillyY
1659+ 817F                  ; C = WillyX
1660+ 817F                  ; ---------------------------------------------------------------
1661+ 817F ED 4B 16 E7      ld   bc, (PlayerPos)
1662+ 8183
1663+ 8183                  ; ---------------------------------------------------------------
1664+ 8183                  ; Primo test:
1665+ 8183                  ;
1666+ 8183                  ; WillyLeft <= ItemRight
1667+ 8183                  ;
1668+ 8183                  ; Se Willy è completamente a destra dell'item
1669+ 8183                  ; non può esserci collisione.
1670+ 8183                  ; ---------------------------------------------------------------
1671+ 8183 79               ld   a, c              ; A = WillyLeft
1672+ 8184
1673+ 8184 BA               cp   d                 ; WillyLeft vs ItemRight
1674+ 8185
1675+ 8185 28 04            jr   z, .x_ok
1676+ 8187 38 02            jr   c, .x_ok
1677+ 8189
1678+ 8189 18 29            jr   .no_collision
1679+ 818B
1680+ 818B              .x_ok:
1681+ 818B
1682+ 818B                  ; ---------------------------------------------------------------
1683+ 818B                  ; Secondo test:
1684+ 818B                  ;
1685+ 818B                  ; WillyRight >= ItemLeft
1686+ 818B                  ;
1687+ 818B                  ; WillyRight = WillyX + 7
1688+ 818B                  ; ---------------------------------------------------------------
1689+ 818B C6 07            add  a, 7
1690+ 818D
1691+ 818D BB               cp   e                 ; WillyRight vs ItemLeft
1692+ 818E
1693+ 818E 28 04            jr   z, .y_check
1694+ 8190 30 02            jr   nc, .y_check
1695+ 8192
1696+ 8192 18 20            jr   .no_collision
1697+ 8194
1698+ 8194              .y_check:
1699+ 8194
1700+ 8194                  ; ---------------------------------------------------------------
1701+ 8194                  ; Recupera ItemY dal valore originale di HL
1702+ 8194                  ;
1703+ 8194                  ; H contiene la riga dell'item.
1704+ 8194                  ; ---------------------------------------------------------------
1705+ 8194 E1               pop  hl
1706+ 8195 E5               push hl
1707+ 8196
1708+ 8196                  ; ---------------------------------------------------------------
1709+ 8196                  ; Calcola il bounding box verticale dell'item
1710+ 8196                  ;
1711+ 8196                  ; ItemTop    = ItemY * 8
1712+ 8196                  ; ItemBottom = ItemTop + 7
1713+ 8196                  ;
1714+ 8196                  ; E = ItemTop
1715+ 8196                  ; D = ItemBottom
1716+ 8196                  ; ---------------------------------------------------------------
1717+ 8196 7C               ld   a, h
1718+ 8197
1719+ 8197 87               add  a, a              ; *2
1720+ 8198 87               add  a, a              ; *4
1721+ 8199 87               add  a, a              ; *8
1722+ 819A
1723+ 819A 5F               ld   e, a              ; ItemTop
1724+ 819B
1725+ 819B C6 07            add  a, 7
1726+ 819D 57               ld   d, a              ; ItemBottom
1727+ 819E
1728+ 819E                  ; ---------------------------------------------------------------
1729+ 819E                  ; Primo test verticale:
1730+ 819E                  ;
1731+ 819E                  ; WillyTop <= ItemBottom
1732+ 819E                  ; ---------------------------------------------------------------
1733+ 819E 78               ld   a, b              ; WillyTop
1734+ 819F
1735+ 819F BA               cp   d
1736+ 81A0
1737+ 81A0 28 04            jr   z, .y_ok
1738+ 81A2 38 02            jr   c, .y_ok
1739+ 81A4
1740+ 81A4 18 0E            jr   .no_collision
1741+ 81A6
1742+ 81A6              .y_ok:
1743+ 81A6
1744+ 81A6                  ; ---------------------------------------------------------------
1745+ 81A6                  ; Secondo test verticale:
1746+ 81A6                  ;
1747+ 81A6                  ; WillyBottom >= ItemTop
1748+ 81A6                  ;
1749+ 81A6                  ; WillyBottom = WillyY + 15
1750+ 81A6                  ; ---------------------------------------------------------------
1751+ 81A6 C6 0F            add  a, 15
1752+ 81A8
1753+ 81A8 BB               cp   e
1754+ 81A9
1755+ 81A9 28 04            jr   z, .collision
1756+ 81AB 30 02            jr   nc, .collision
1757+ 81AD
1758+ 81AD 18 05            jr   .no_collision
1759+ 81AF
1760+ 81AF              .collision:
1761+ 81AF
1762+ 81AF                  ; ---------------------------------------------------------------
1763+ 81AF                  ; Collisione rilevata
1764+ 81AF                  ; ---------------------------------------------------------------
1765+ 81AF E1               pop  hl
1766+ 81B0 D1               pop  de
1767+ 81B1 C1               pop  bc
1768+ 81B2
1769+ 81B2 37               scf                    ; Carry = 1
1770+ 81B3
1771+ 81B3 C9               ret
1772+ 81B4
1773+ 81B4              .no_collision:
1774+ 81B4
1775+ 81B4                  ; ---------------------------------------------------------------
1776+ 81B4                  ; Nessuna collisione
1777+ 81B4                  ; ---------------------------------------------------------------
1778+ 81B4 E1               pop  hl
1779+ 81B5 D1               pop  de
1780+ 81B6 C1               pop  bc
1781+ 81B7
1782+ 81B7 B7               or   a                 ; Carry = 0
1783+ 81B8
1784+ 81B8 C9               ret
1785+ 81B9
1786+ 81B9              ; -------------------------------------------------------------------
1787+ 81B9              ; Items_CheckCollision
1788+ 81B9              ;
1789+ 81B9              ; Controlla se Willy entra in collisione con uno degli item
1790+ 81B9              ; attivi presenti nella stanza corrente.
1791+ 81B9              ;
1792+ 81B9              ; Per ogni item:
1793+ 81B9              ;   - verifica che appartenga alla stanza corrente
1794+ 81B9              ;   - verifica che non sia già stato raccolto
1795+ 81B9              ;   - esegue il test di collisione con Willy
1796+ 81B9              ;
1797+ 81B9              ; Se l'item viene raccolto:
1798+ 81B9              ;   - imposta il flag "collected"
1799+ 81B9              ;   - rimuove l'item dalla cache items_grid
1800+ 81B9              ;   - incrementa il contatore degli oggetti raccolti
1801+ 81B9              ;   - aggiorna l'HUD
1802+ 81B9              ;   - ripristina il tile di sfondo
1803+ 81B9              ;   - riproduce il suono di raccolta
1804+ 81B9              ;
1805+ 81B9              ; Formato record ItemsTable:
1806+ 81B9              ;   +0 RoomID
1807+ 81B9              ;   +1 X
1808+ 81B9              ;   +2 Y
1809+ 81B9              ;   +3 Color
1810+ 81B9              ;   +4 Collected
1811+ 81B9              ;
1812+ 81B9              ; Fine tabella:
1813+ 81B9              ;   RoomID = $FF
1814+ 81B9              ; -------------------------------------------------------------------
1815+ 81B9              Items_CheckCollision:
1816+ 81B9
1817+ 81B9                  ; Salva i registri utilizzati
1818+ 81B9 E5               push hl
1819+ 81BA D5               push de
1820+ 81BB C5               push bc
1821+ 81BC
1822+ 81BC                  ; Inizio scansione della tabella degli item
1823+ 81BC 21 09 7B         ld   hl, ItemsTable
1824+ 81BF
1825+ 81BF              .loop:
1826+ 81BF
1827+ 81BF                  ; ---------------------------------------------------------------
1828+ 81BF                  ; Legge il Room ID dell'item corrente
1829+ 81BF                  ; ---------------------------------------------------------------
1830+ 81BF 7E               ld   a, (hl)
1831+ 81C0
1832+ 81C0                  ; $FF indica fine tabella
1833+ 81C0 FE FF            cp   $FF
1834+ 81C2 28 58            jr   z, .done
1835+ 81C4
1836+ 81C4                  ; ---------------------------------------------------------------
1837+ 81C4                  ; Verifica se l'item appartiene alla stanza corrente
1838+ 81C4                  ; ---------------------------------------------------------------
1839+ 81C4 57               ld   d, a              ; D = RoomID item
1840+ 81C5
1841+ 81C5 3A 3C EA         ld   a, (current_room)
1842+ 81C8 BA               cp   d
1843+ 81C9
1844+ 81C9                  ; Se appartiene a un'altra stanza salta il record
1845+ 81C9 20 4A            jr   nz, .next_item
1846+ 81CB
1847+ 81CB                  ; ---------------------------------------------------------------
1848+ 81CB                  ; Legge coordinate e stato dell'item
1849+ 81CB                  ; ---------------------------------------------------------------
1850+ 81CB
1851+ 81CB 23               inc  hl
1852+ 81CC 4E               ld   c, (hl)           ; C = X
1853+ 81CD
1854+ 81CD 23               inc  hl
1855+ 81CE 46               ld   b, (hl)           ; B = Y
1856+ 81CF
1857+ 81CF 23               inc  hl                ; salta Color
1858+ 81D0
1859+ 81D0 23               inc  hl                ; punta a Collected
1860+ 81D1
1861+ 81D1 7E               ld   a, (hl)
1862+ 81D2
1863+ 81D2                  ; ---------------------------------------------------------------
1864+ 81D2                  ; Item già raccolto?
1865+ 81D2                  ; ---------------------------------------------------------------
1866+ 81D2 B7               or   a
1867+ 81D3 20 44            jr   nz, .next_no_inc
1868+ 81D5
1869+ 81D5                  ; ---------------------------------------------------------------
1870+ 81D5                  ; Test collisione Willy ↔ Item
1871+ 81D5                  ;
1872+ 81D5                  ; Input richiesto:
1873+ 81D5                  ;   A = ItemX
1874+ 81D5                  ;   H = ItemY
1875+ 81D5                  ; ---------------------------------------------------------------
1876+ 81D5 79               ld   a, c
1877+ 81D6
1878+ 81D6 E5               push hl                ; salva puntatore al flag Collected
1879+ 81D7
1880+ 81D7 60               ld   h, b
1881+ 81D8
1882+ 81D8 CD 73 81         call CheckWillyItemCollision
1883+ 81DB
1884+ 81DB E1               pop  hl
1885+ 81DC
1886+ 81DC                  ; Nessuna collisione
1887+ 81DC 30 3B            jr   nc, .next_no_inc
1888+ 81DE
1889+ 81DE                  ; ===============================================================
1890+ 81DE                  ; ITEM RACCOLTO
1891+ 81DE                  ; ===============================================================
1892+ 81DE
1893+ 81DE                  ; ---------------------------------------------------------------
1894+ 81DE                  ; Marca l'item come raccolto
1895+ 81DE                  ; ---------------------------------------------------------------
1896+ 81DE 36 01            ld   (hl), 1
1897+ 81E0
1898+ 81E0                  ; ---------------------------------------------------------------
1899+ 81E0                  ; Rimuove l'item dalla cache items_grid
1900+ 81E0                  ;
1901+ 81E0                  ; Calcolo:
1902+ 81E0                  ;   offset = Row * 32 + Col
1903+ 81E0                  ; ---------------------------------------------------------------
1904+ 81E0 E5               push hl
1905+ 81E1 D5               push de
1906+ 81E2
1907+ 81E2 26 00            ld   h, 0
1908+ 81E4 68               ld   l, b              ; HL = Row
1909+ 81E5
1910+ 81E5 29               add  hl, hl            ; *2
1911+ 81E6 29               add  hl, hl            ; *4
1912+ 81E7 29               add  hl, hl            ; *8
1913+ 81E8 29               add  hl, hl            ; *16
1914+ 81E9 29               add  hl, hl            ; *32
1915+ 81EA
1916+ 81EA 59               ld   e, c
1917+ 81EB 16 00            ld   d, 0
1918+ 81ED
1919+ 81ED 19               add  hl, de            ; Row*32 + Col
1920+ 81EE
1921+ 81EE 11 16 E5         ld   de, items_grid
1922+ 81F1 19               add  hl, de
1923+ 81F2
1924+ 81F2                  ; La cella non contiene più un item
1925+ 81F2 36 00            ld   (hl), 0
1926+ 81F4
1927+ 81F4 D1               pop  de
1928+ 81F5 E1               pop  hl
1929+ 81F6
1930+ 81F6                  ; ---------------------------------------------------------------
1931+ 81F6                  ; Conserva il puntatore all'entry corrente
1932+ 81F6                  ; poiché le routine successive possono alterare HL.
1933+ 81F6                  ; ---------------------------------------------------------------
1934+ 81F6 E5               push hl
1935+ 81F7
1936+ 81F7                  ; ---------------------------------------------------------------
1937+ 81F7                  ; Aggiorna il numero di oggetti raccolti
1938+ 81F7                  ; ---------------------------------------------------------------
1939+ 81F7 3A 20 E7         ld   a, (items_collected)
1940+ 81FA
1941+ 81FA 3C               inc  a
1942+ 81FB
1943+ 81FB 32 20 E7         ld   (items_collected), a
1944+ 81FE
1945+ 81FE FE 05            cp   TOTAL_ITEMS
1946+ 8200 38 07            jr   c, .objective_not_completed
1947+ 8202 F5               push af
1948+ 8203 3E 01            ld   a, 1
1949+ 8205 32 28 EB         ld   (game_objective_completed), a
1950+ 8208 F1               pop  af
1951+ 8209              .objective_not_completed:
1952+ 8209
1953+ 8209                  ; ---------------------------------------------------------------
