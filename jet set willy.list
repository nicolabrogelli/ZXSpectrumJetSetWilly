1414+ 6DBC CB 3F            srl  a
1415+ 6DBE CB 3F            srl  a                 ; A = c (0..31)
1416+ 6DC0 4F               ld   c, a              ; C = c
1417+ 6DC1 7B               ld   a, e              ; A = r
