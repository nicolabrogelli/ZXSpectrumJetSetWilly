 863+ 6AB4 47               ld   b, a              ; B = limit_left
 864+ 6AB5
 865+ 6AB5 3A 22 78         ld   a, (ramp_col)
 866+ 6AB8 3C               inc  a
 867+ 6AB9 4F               ld   c, a              ; C = limit_right (exclusive)
 868+ 6ABA
 869+ 6ABA 7B               ld   a, e              ; A = Col
 870+ 6ABB B8               cp   b
 871+ 6ABC 38 15            jr   c, .check_platform_case
 872+ 6ABE B9               cp   c
 873+ 6ABF 30 12            jr   nc, .check_platform_case
 874+ 6AC1
 875+ 6AC1                  ; Calcola B = ramp_col - Col
 876+ 6AC1 3A 22 78         ld   a, (ramp_col)
 877+ 6AC4 93               sub  e
 878+ 6AC5 47               ld   b, a              ; B = offset
 879+ 6AC6
 880+ 6AC6                  ; SlopeRow = ramp_row - B
