 239+ 6C1B              ; DrawRoomItems
 240+ 6C1B              ;
 241+ 6C1B              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 242+ 6C1B              ;
 243+ 6C1B              ; Operazioni eseguite:
 244+ 6C1B              ;   1. Azzera la griglia items_grid.
 245+ 6C1B              ;   2. Svuota la cache degli oggetti attivi.
 246+ 6C1B              ;   3. Scansiona ItemsTable.
 247+ 6C1B              ;   4. Per ogni item della stanza corrente:
 248+ 6C1B              ;        - verifica se è già stato raccolto
 249+ 6C1B              ;        - disegna la grafica
 250+ 6C1B              ;        - aggiorna items_grid
 251+ 6C1B              ;        - memorizza l'item nella cache current_room_items
 252+ 6C1B              ;   5. Aggiorna num_room_items.
 253+ 6C1B              ;
 254+ 6C1B              ; Record ItemsTable:
 255+ 6C1B              ;   +0  Room ID
 256+ 6C1B              ;   +1  X (colonna)
 257+ 6C1B              ;   +2  Y (riga)
 258+ 6C1B              ;   +3  Colore
 259+ 6C1B              ;   +4  Collected flag
 260+ 6C1B              ;
 261+ 6C1B              ; Cache current_room_items:
 262+ 6C1B              ;   +0  Colonna
 263+ 6C1B              ;   +1  Riga
 264+ 6C1B              ;   +2  Colore
 265+ 6C1B              ;   +3  Collected flag ptr (Low)
 266+ 6C1B              ;   +4  Collected flag ptr (High)
 267+ 6C1B              ;
 268+ 6C1B              ; Ogni record cache occupa 5 byte.
 269+ 6C1B              ; -------------------------------------------------------------------
 270+ 6C1B              DrawRoomItems:
 271+ 6C1B
 272+ 6C1B                  ; Salva tutti i registri utilizzati
 273+ 6C1B E5               push hl
 274+ 6C1C D5               push de
 275+ 6C1D C5               push bc
 276+ 6C1E DD E5            push ix
 277+ 6C20 FD E5            push iy
 278+ 6C22
 279+ 6C22                  ; ---------------------------------------------------------------
 280+ 6C22                  ; Azzera items_grid (32 x 16 = 512 byte)
 281+ 6C22                  ; ---------------------------------------------------------------
 282+ 6C22 21 00 90         ld   hl, items_grid
 283+ 6C25 11 01 90         ld   de, items_grid + 1
 284+ 6C28 36 00            ld   (hl), 0
 285+ 6C2A 01 FF 01         ld   bc, 511
 286+ 6C2D ED B0            ldir
 287+ 6C2F
 288+ 6C2F                  ; ---------------------------------------------------------------
 289+ 6C2F                  ; Nessun item attivo nella stanza
 290+ 6C2F                  ; ---------------------------------------------------------------
 291+ 6C2F AF               xor  a
 292+ 6C30 32 AC 7D         ld   (num_room_items), a
 293+ 6C33
 294+ 6C33                  ; IY punta alla cache degli item attivi
 295+ 6C33 FD 21 5C 7D      ld   iy, current_room_items
 296+ 6C37
 297+ 6C37                  ; ---------------------------------------------------------------
 298+ 6C37                  ; Recupera il puntatore alla bitmap dell'oggetto associato
 299+ 6C37                  ; alla stanza corrente.
 300+ 6C37                  ;
 301+ 6C37                  ; room_ptr + OFFSET_ITEM_GRAPHIC
 302+ 6C37                  ; ---------------------------------------------------------------
 303+ 6C37 2A AD 7D         ld   hl, (room_ptr)
 304+ 6C3A 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
 305+ 6C3D 19               add  hl, de
 306+ 6C3E
 307+ 6C3E E5               push hl
 308+ 6C3F DD E1            pop  ix                ; IX = bitmap item
 309+ 6C41
 310+ 6C41                  ; ---------------------------------------------------------------
 311+ 6C41                  ; Inizio scansione della tabella degli item
 312+ 6C41                  ; ---------------------------------------------------------------
 313+ 6C41 21 2F 6B         ld   hl, ItemsTable
 314+ 6C44
 315+ 6C44              .loop:
 316+ 6C44
 317+ 6C44                  ; ---------------------------------------------------------------
 318+ 6C44                  ; Legge il Room ID del record corrente
 319+ 6C44                  ; ---------------------------------------------------------------
 320+ 6C44 7E               ld   a, (hl)
 321+ 6C45
 322+ 6C45                  ; $FF indica fine tabella
 323+ 6C45 FE FF            cp   $FF
 324+ 6C47 28 53            jr   z, .done
 325+ 6C49
 326+ 6C49                  ; ---------------------------------------------------------------
 327+ 6C49                  ; Verifica se l'item appartiene alla stanza corrente
 328+ 6C49                  ; ---------------------------------------------------------------
 329+ 6C49 57               ld   d, a
 330+ 6C4A
 331+ 6C4A 3A 53 7D         ld   a, (current_room)
 332+ 6C4D BA               cp   d
 333+ 6C4E 20 45            jr   nz, .next_item
