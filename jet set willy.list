  63+ 6C4C 7A               ld   a, d
  64+ 6C4D 18 0F            jr   .got_type
  65+ 6C4F              .shift_2:
  66+ 6C4F 7A               ld   a, d
  67+ 6C50 0F               rrca
  68+ 6C51 0F               rrca
  69+ 6C52 18 0A            jr   .got_type
  70+ 6C54              .shift_1:
  71+ 6C54 7A               ld   a, d
  72+ 6C55 0F               rrca
  73+ 6C56 0F               rrca
  74+ 6C57 0F               rrca
  75+ 6C58 0F               rrca
  76+ 6C59 18 03            jr   .got_type
  77+ 6C5B              .shift_0:
  78+ 6C5B 7A               ld   a, d
  79+ 6C5C 07               rlca
  80+ 6C5D 07               rlca
  81+ 6C5E              .got_type:
  82+ 6C5E E6 03            and  3                 ; A = cell type (0..3)
  83+ 6C60
  84+ 6C60                  ; 5. Controlla se è solida: Floor (1) o Wall (2)
  85+ 6C60 FE 01            cp   1
