 179+ 86AB              ; Audio_PlayCollectSound
 180+ 86AB              ;
 181+ 86AB              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 86AB              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 86AB              ; -------------------------------------------------------------------
 184+ 86AB              Audio_PlayCollectSound:
 185+ 86AB C5               push bc
 186+ 86AC D5               push de
 187+ 86AD
 188+ 86AD 06 78            ld   b, 120
 189+ 86AF              .sound_loop:
 190+ 86AF 3A 8D EC         ld   a, (room_border_color)
 191+ 86B2 F6 10            or   $10               ; speaker ON
 192+ 86B4 D3 FE            out  ($fe), a
 193+ 86B6
 194+ 86B6 0E 3C            ld   c, 60
 195+ 86B8              .d1:
 196+ 86B8 0D               dec  c
 197+ 86B9 20 FD            jr   nz, .d1
 198+ 86BB
 199+ 86BB 3A 8D EC         ld   a, (room_border_color)
 200+ 86BE E6 EF            and  $ef              ; speaker OFF
 201+ 86C0 D3 FE            out  ($fe), a
 202+ 86C2
 203+ 86C2 0E 3C            ld   c, 60
