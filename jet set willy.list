 415  885A 21 8D 5C         ld   hl, ATTR_P
 416  885D 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 417  885E CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 418  8861 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 419  8863 3E 07            ld   a, $07
 420  8865 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 421  8868
 422  8868                  ; Ripristina il numero di vite iniziali
