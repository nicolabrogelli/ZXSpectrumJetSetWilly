1223+ 6CAB 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1224+ 6CAC 67               ld   h, a              ; H = X_right_boundary
1225+ 6CAD
1226+ 6CAD 79               ld   a, c              ; A = PlayerX
