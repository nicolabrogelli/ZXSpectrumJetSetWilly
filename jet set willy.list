1392+ 77F5                  ; X_left = ramp_col * 8
1393+ 77F5 3A 73 F7         ld   a, (ramp_col)
1394+ 77F8 87               add  a, a
1394+ 77F9 87             add a, a
1394+ 77FA 87             add a, a ; *8
