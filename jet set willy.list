1919+ 778C                  ; Punto 2: Top-Right (X + 7, Y)
1920+ 778C 79               ld   a, c
1921+ 778D C6 07            add  a, 7
1922+ 778F 4F               ld   c, a
1923+ 7790 CD 59 77         call CheckNastyCell
1924+ 7793 38 2F            jr   c, .collision
1925+ 7795
1926+ 7795                  ; Punto 3: Mid-Left (X, Y + 7)
1927+ 7795 ED 4B 19 EA      ld   bc, (PlayerPos)
1928+ 7799 78               ld   a, b
1929+ 779A C6 07            add  a, 7
1930+ 779C 47               ld   b, a
1931+ 779D CD 59 77         call CheckNastyCell
1932+ 77A0 38 22            jr   c, .collision
1933+ 77A2
1934+ 77A2                  ; Punto 4: Mid-Right (X + 7, Y + 7)
1935+ 77A2 79               ld   a, c
1936+ 77A3 C6 07            add  a, 7
