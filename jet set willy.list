 361+ 6BDA              ; -------------------------------------------------------------------
 362+ 6BDA              ; Controlla se Willy collide con un item (pixel-level check)
 363+ 6BDA              ; Input: A = ItemX (0..31), H = ItemY (3..18)
 364+ 6BDA              ; Output: Carry set se collide, altrimenti clear
 365+ 6BDA              ; -------------------------------------------------------------------
 366+ 6BDA              CheckWillyItemCollision:
 367+ 6BDA C5               push bc
 368+ 6BDB D5               push de
 369+ 6BDC E5               push hl
 370+ 6BDD
 371+ 6BDD                  ; Calcola ItemLeft = ItemX * 8, ItemRight = ItemLeft + 7
 372+ 6BDD 6F               ld   l, a
 373+ 6BDE 7D               ld   a, l
 374+ 6BDF 87               add  a, a              ; *2
 375+ 6BE0 87               add  a, a              ; *4
 376+ 6BE1 87               add  a, a              ; *8
 377+ 6BE2 5F               ld   e, a              ; E = ItemLeft
 378+ 6BE3 C6 07            add  a, 7
 379+ 6BE5 57               ld   d, a              ; D = ItemRight
 380+ 6BE6
 381+ 6BE6                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 382+ 6BE6 ED 4B 47 77      ld   bc, (PlayerPos)   ; C = WillyX, B = WillyY
 383+ 6BEA
 384+ 6BEA                  ; Controlla X: WillyX <= ItemRight (D) e WillyX + 15 >= ItemLeft (E)
 385+ 6BEA 79               ld   a, c
 386+ 6BEB BA               cp   d
 387+ 6BEC 28 04            jr   z, .x_ok
 388+ 6BEE 38 02            jr   c, .x_ok
 389+ 6BF0 18 29            jr   .no_collision
 390+ 6BF2              .x_ok:
 391+ 6BF2 C6 0F            add  a, 15
 392+ 6BF4 BB               cp   e
 393+ 6BF5 28 04            jr   z, .y_check
 394+ 6BF7 30 02            jr   nc, .y_check
 395+ 6BF9 18 20            jr   .no_collision
 396+ 6BFB
 397+ 6BFB              .y_check:
 398+ 6BFB E1               pop  hl                ; Recupera HL originale (H = ItemY)
 399+ 6BFC E5               push hl
 400+ 6BFD 7C               ld   a, h
 401+ 6BFE 87               add  a, a              ; *2
 402+ 6BFF 87               add  a, a              ; *4
 403+ 6C00 87               add  a, a              ; *8
 404+ 6C01 5F               ld   e, a              ; E = ItemTop
 405+ 6C02 C6 07            add  a, 7
 406+ 6C04 57               ld   d, a              ; D = ItemBottom
 407+ 6C05
 408+ 6C05                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 409+ 6C05 78               ld   a, b
 410+ 6C06 BA               cp   d
 411+ 6C07 28 04            jr   z, .y_ok
 412+ 6C09 38 02            jr   c, .y_ok
 413+ 6C0B 18 0E            jr   .no_collision
 414+ 6C0D              .y_ok:
 415+ 6C0D C6 0F            add  a, 15
 416+ 6C0F BB               cp   e
 417+ 6C10 28 04            jr   z, .collision
 418+ 6C12 30 02            jr   nc, .collision
 419+ 6C14 18 05            jr   .no_collision
 420+ 6C16
 421+ 6C16              .collision:
 422+ 6C16 E1               pop  hl
 423+ 6C17 D1               pop  de
 424+ 6C18 C1               pop  bc
 425+ 6C19 37               scf                    ; Set carry (collisione!)
 426+ 6C1A C9               ret
 427+ 6C1B
 428+ 6C1B              .no_collision:
 429+ 6C1B E1               pop  hl
 430+ 6C1C D1               pop  de
 431+ 6C1D C1               pop  bc
 432+ 6C1E B7               or   a                 ; Clear carry
 433+ 6C1F C9               ret
 434+ 6C20
 435+ 6C20              ; -------------------------------------------------------------------
 436+ 6C20              ; Controlla se Willy tocca un item attivo nella stanza corrente
 437+ 6C20              ; -------------------------------------------------------------------
 438+ 6C20              CheckRoomItemsCollision:
 439+ 6C20 E5               push hl
 440+ 6C21 D5               push de
 441+ 6C22 C5               push bc
 442+ 6C23
 443+ 6C23 21 34 6A         ld   hl, ItemsTable
 444+ 6C26              .loop:
 445+ 6C26 7E               ld   a, (hl)           ; A = Room ID
 446+ 6C27 FE FF            cp   $FF               ; Fine tabella?
 447+ 6C29 28 37            jr   z, .done
 448+ 6C2B
 449+ 6C2B                  ; Stanza corrente?
 450+ 6C2B 57               ld   d, a              ; D = Room ID
 451+ 6C2C 3A 5A 7A         ld   a, (current_room)
 452+ 6C2F BA               cp   d
 453+ 6C30 20 29            jr   nz, .next_item
 454+ 6C32
 455+ 6C32 23               inc  hl                ; HL punta a X
 456+ 6C33 4E               ld   c, (hl)           ; C = X
 457+ 6C34 23               inc  hl                ; HL punta a Y
 458+ 6C35 46               ld   b, (hl)           ; B = Y
 459+ 6C36 23               inc  hl                ; HL punta al colore (lo saltiamo per il controllo collisione)
 460+ 6C37 23               inc  hl                ; HL punta a collected
 461+ 6C38 7E               ld   a, (hl)           ; A = collected
 462+ 6C39 B7               or   a
 463+ 6C3A 20 23            jr   nz, .next_no_inc  ; Già raccolto, salta
 464+ 6C3C
 465+ 6C3C                  ; Controlla collisione
 466+ 6C3C 79               ld   a, c
 467+ 6C3D E5               push hl
 468+ 6C3E 60               ld   h, b
 469+ 6C3F CD DA 6B         call CheckWillyItemCollision
 470+ 6C42 E1               pop  hl
 471+ 6C43 30 1A            jr   nc, .next_no_inc
 472+ 6C45
 473+ 6C45                  ; RACCOLTO!
 474+ 6C45 36 01            ld   (hl), 1           ; Imposta collected = 1
 475+ 6C47
 476+ 6C47 E5               push hl
 477+ 6C48
 478+ 6C48                  ; Incrementa contatore oggetti raccolti
 479+ 6C48 3A 51 77         ld   a, (items_collected)
 480+ 6C4B 3C               inc  a
 481+ 6C4C 32 51 77         ld   (items_collected), a
 482+ 6C4F
 483+ 6C4F                  ; Aggiorna stringa e visualizzazione a schermo
 484+ 6C4F CD A9 60         call UpdateItemsCollectedDisplay
 485+ 6C52
 486+ 6C52                  ; Cancella item dallo schermo
 487+ 6C52 CD 98 6B         call RestoreBackgroundCell
 488+ 6C55
 489+ 6C55                  ; Suono di raccolta
 490+ 6C55 CD 66 6C         call PlayCollectSound
 491+ 6C58
 492+ 6C58 E1               pop  hl
 493+ 6C59
 494+ 6C59 18 04            jr   .next_no_inc
 495+ 6C5B
 496+ 6C5B              .next_item:
 497+ 6C5B 23               inc  hl                ; salta X
 498+ 6C5C 23               inc  hl                ; salta Y
 499+ 6C5D 23               inc  hl                ; salta colore
 500+ 6C5E 23               inc  hl                ; salta collected
 501+ 6C5F              .next_no_inc:
 502+ 6C5F 23               inc  hl                ; vai al prossimo item
 503+ 6C60 18 C4            jr   .loop
 504+ 6C62
 505+ 6C62              .done:
 506+ 6C62 C1               pop  bc
 507+ 6C63 D1               pop  de
 508+ 6C64 E1               pop  hl
 509+ 6C65 C9               ret
 510+ 6C66
 511+ 6C66              ; -------------------------------------------------------------------
 512+ 6C66              ; Riproduce un breve segnale acustico all'altoparlante
 513+ 6C66              ; -------------------------------------------------------------------
 514+ 6C66              PlayCollectSound:
 515+ 6C66 C5               push bc
 516+ 6C67 D5               push de
 517+ 6C68
 518+ 6C68 06 78            ld   b, 120            ; Cicli della nota
 519+ 6C6A              .sound_loop:
 520+ 6C6A 3A 53 77         ld   a, (room_border_color)
 521+ 6C6D F6 10            or   $10               ; Speaker ON (bit 4 = 1)
 522+ 6C6F D3 FE            out  ($fe), a
 523+ 6C71 0E 3C            ld   c, 60             ; Mezzo periodo delay
 524+ 6C73 0D           .d1: dec  c
