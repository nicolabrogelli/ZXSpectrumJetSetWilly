 528+ 6013 C6 01            add  a, 1              ; offset del tile per il corpo destro (1, 2, 3)
 529+ 6015 87               add  a, a              ; *2
 530+ 6016 87               add  a, a              ; *4
 531+ 6017 87               add  a, a              ; *8
