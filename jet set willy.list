 207+ 5E92 4B               ld   c, e              ; C = Row
 208+ 5E93 CD 6E 7C         call CheckActiveItemAtCell
 209+ 5E96 30 17            jr   nc, .no_item
 210+ 5E98
 211+ 5E98 C1               pop  bc
 212+ 5E99 D1               pop  de
 213+ 5E9A
 214+ 5E9A 7A               ld   a, d
 215+ 5E9B E6 07            and  7                 ; A = scanline (0..7)
 216+ 5E9D 5F               ld   e, a
 217+ 5E9E 16 00            ld   d, 0              ; DE = scanline offset
 218+ 5EA0 2A A5 E9         ld   hl, (room_ptr)
