  71+ 796F              ; Audio_UpdateMusic
  72+ 796F              ;
  73+ 796F              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  74+ 796F              ; Viene chiamata a ogni frame.
  75+ 796F              ; -------------------------------------------------------------------
  76+ 796F              Audio_UpdateMusic:
  77+ 796F F5               push af
  78+ 7970 C5               push bc
  79+ 7971 D5               push de
  80+ 7972 E5               push hl
  81+ 7973
  82+ 7973                  ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  83+ 7973 3A BD 7D         ld   a, (Audio_jump_sound_note)
  84+ 7976 FE 12            cp   18
  85+ 7978 38 56            jr   c, .done                 ; Salto attivo -> niente musica
  86+ 797A
  87+ 797A                  ; Decrementa il contatore dei frame della nota corrente
  88+ 797A 3A C0 7D         ld   a, (Audio_music_frame_counter)
  89+ 797D 3D               dec  a
  90+ 797E 32 C0 7D         ld   (Audio_music_frame_counter), a
  91+ 7981 20 1F            jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  92+ 7983
  93+ 7983                  ; Altrimenti carica la nota successiva
  94+ 7983 3A BF 7D         ld   a, (Audio_music_note_idx)
  95+ 7986 3C               inc  a
  96+ 7987 FE 23            cp   35                       ; Abbiamo 35 note in totale
  97+ 7989 38 01            jr   c, .no_wrap
  98+ 798B AF               xor  a                        ; Torna a 0 se raggiunge la fine (loop)
  99+ 798C              .no_wrap:
 100+ 798C 32 BF 7D         ld   (Audio_music_note_idx), a
 101+ 798F
 102+ 798F                  ; Carica la durata e impostala come nuovo contatore di frame
 103+ 798F 5F               ld   e, a
 104+ 7990 16 00            ld   d, 0
 105+ 7992 21 D5 79         ld   hl, Audio_MusicSheet
 106+ 7995 19               add  hl, de
 107+ 7996 19               add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 108+ 7997
 109+ 7997                  ; Leggi durata (secondo byte)
 110+ 7997 23               inc  hl
 111+ 7998 7E               ld   a, (hl)
 112+ 7999 CB 3F            srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 113+ 799B 20 02            jr   nz, .dur_ok
 114+ 799D 3E 01            ld   a, 1
 115+ 799F              .dur_ok:
 116+ 799F 32 C0 7D         ld   (Audio_music_frame_counter), a
 117+ 79A2
 118+ 79A2              .play_current_note:
 119+ 79A2                  ; Ottieni il delay della nota corrente (primo byte)
 120+ 79A2 3A BF 7D         ld   a, (Audio_music_note_idx)
 121+ 79A5 5F               ld   e, a
 122+ 79A6 16 00            ld   d, 0
 123+ 79A8 21 D5 79         ld   hl, Audio_MusicSheet
 124+ 79AB 19               add  hl, de
 125+ 79AC 19               add  hl, de                   ; hl punta al primo byte della nota
 126+ 79AD 7E               ld   a, (hl)                  ; A = delay
 127+ 79AE B7               or   a
 128+ 79AF 28 1F            jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 129+ 79B1
 130+ 79B1                  ; Suona la nota: 2 cicli
 131+ 79B1 57               ld   d, a                     ; D = delay
 132+ 79B2 06 02            ld   b, 2                     ; 2 cicli per frame
 133+ 79B4              .note_loop:
 134+ 79B4                  ; Speaker ON
 135+ 79B4 3A 48 7A         ld   a, (room_border_color)
 136+ 79B7 F6 10            or   $10
 137+ 79B9 D3 FE            out  ($fe), a
 138+ 79BB 4A               ld   c, d
 139+ 79BC              .d1:
 140+ 79BC F5               push af
 141+ 79BD F1               pop  af
 142+ 79BE 0D               dec  c
 143+ 79BF 20 FB            jr   nz, .d1
 144+ 79C1
 145+ 79C1                  ; Speaker OFF
 146+ 79C1 3A 48 7A         ld   a, (room_border_color)
 147+ 79C4 E6 EF            and  $ef
 148+ 79C6 D3 FE            out  ($fe), a
 149+ 79C8 4A               ld   c, d
 150+ 79C9              .d2:
 151+ 79C9 F5               push af
 152+ 79CA F1               pop  af
 153+ 79CB 0D               dec  c
 154+ 79CC 20 FB            jr   nz, .d2
 155+ 79CE
 156+ 79CE 10 E4            djnz .note_loop
 157+ 79D0
 158+ 79D0              .done:
 159+ 79D0 E1               pop  hl
 160+ 79D1 D1               pop  de
 161+ 79D2 C1               pop  bc
 162+ 79D3 F1               pop  af
 163+ 79D4 C9               ret
