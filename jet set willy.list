 218+ 64E7              ; LoadPositionPlayeinRoom
 219+ 64E7              ;
 220+ 64E7              ; Inizializza la posizione del player (Willy) quando entra
 221+ 64E7              ; in una nuova stanza.
 222+ 64E7              ;
 223+ 64E7              ; La posizione viene letta direttamente dai dati della stanza
 224+ 64E7              ; (layout/metadata) a partire da room_ptr.
 225+ 64E7              ;
