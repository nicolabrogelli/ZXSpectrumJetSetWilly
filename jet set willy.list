 841+ 7DD5              ; -------------------------------------------------------------------
 842+ 7DD5              ; Aggiorna le posizioni dei nemici attivi per il prossimo frame
 843+ 7DD5              ; -------------------------------------------------------------------
 844+ 7DD5              Enemy_Update:
 845+ 7DD5 E5               push hl
 846+ 7DD6 D5               push de
 847+ 7DD7 C5               push bc
 848+ 7DD8 DD E5            push ix
 849+ 7DDA
 850+ 7DDA                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 851+ 7DDA 3A D9 EE         ld   a, (enemy_update_rate)
 852+ 7DDD FE 01            cp   1
 853+ 7DDF 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 854+ 7DE1
 855+ 7DE1 3A DA EE         ld   a, (enemy_update_timer)
 856+ 7DE4 3C               inc  a
 857+ 7DE5 47               ld   b, a                      ; B = timer + 1
 858+ 7DE6 3A D9 EE         ld   a, (enemy_update_rate)
 859+ 7DE9 B8               cp   b
 860+ 7DEA 28 0C            jr   z, .reset_timer
 861+ 7DEC 38 0A            jr   c, .reset_timer
 862+ 7DEE
 863+ 7DEE                  ; Salva contatore incrementato e salta l'aggiornamento
 864+ 7DEE 78               ld   a, b
 865+ 7DEF 32 DA EE         ld   (enemy_update_timer), a
 866+ 7DF2
 867+ 7DF2              .skip_update:
 868+ 7DF2 DD E1            pop  ix
 869+ 7DF4 C1               pop  bc
 870+ 7DF5 D1               pop  de
 871+ 7DF6 E1               pop  hl
 872+ 7DF7 C9               ret
 873+ 7DF8
 874+ 7DF8              .reset_timer:
 875+ 7DF8 AF               xor  a
 876+ 7DF9 32 DA EE         ld   (enemy_update_timer), a
 877+ 7DFC 18 00            jr   .do_update
 878+ 7DFE
 879+ 7DFE              .do_update:
 880+ 7DFE 3E 01            ld   a, 1
 881+ 7E00 32 60 EF         ld   (enemy_was_updated), a
 882+ 7E03
 883+ 7E03 DD 21 D1 78      ld   ix, ActiveEnemies
 884+ 7E07 06 08            ld   b, 8              ; 8 slot
 885+ 7E09              .loop:
 886+ 7E09 DD 7E 00         ld   a, (ix+0)         ; Flags
 887+ 7E0C E6 80            and  $80               ; Active?
 888+ 7E0E CA E0 7E         jp   z, .next
 889+ 7E11
 890+ 7E11                  ; 1. Aggiorna Anim State
 891+ 7E11 DD 7E 01         ld   a, (ix+1)         ; Sprite Type (Offset 1)
 892+ 7E14 E6 3F            and  $3F               ; Tipo
 893+ 7E16 FE 0D            cp   13                ; Tipo 13 = Canguro?
 894+ 7E18 28 2A            jr   z, .canguro_anim
 895+ 7E1A FE 0B            cp   11                ; Tipo 11 = Soldato?
 896+ 7E1C 28 1B            jr   z, .soldato_anim
 897+ 7E1E FE 10            cp   16                ; Tipo 16 = Candelabro?
 898+ 7E20 28 17            jr   z, .soldato_anim
 899+ 7E22 FE 14            cp   20                ; Tipo 20 = Nonnino?
 900+ 7E24 28 13            jr   z, .soldato_anim
 901+ 7E26 FE 15            cp   21                ; Tipo 21 = Parrucca?
 902+ 7E28 28 0F            jr   z, .soldato_anim
 903+ 7E2A FE 1D            cp   29                ; Tipo 29 = Saliera?
 904+ 7E2C 28 0B            jr   z, .soldato_anim
 905+ 7E2E
 906+ 7E2E DD 7E 07         ld   a, (ix+7)         ; Anim State (Offset 7)
 907+ 7E31 3C               inc  a
 908+ 7E32 E6 03            and  3                 ; Alterna 0..3
 909+ 7E34 DD 77 07         ld   (ix+7), a
 910+ 7E37 18 14            jr   .anim_done
 911+ 7E39
 912+ 7E39              .soldato_anim:
 913+ 7E39 DD 7E 07         ld   a, (ix+7)         ; Anim State
 914+ 7E3C 3C               inc  a
 915+ 7E3D E6 01            and  1                 ; Alterna 0..1
 916+ 7E3F DD 77 07         ld   (ix+7), a
 917+ 7E42 18 09            jr   .anim_done
 918+ 7E44
 919+ 7E44              .canguro_anim:
 920+ 7E44 DD 7E 07         ld   a, (ix+7)         ; Anim State
 921+ 7E47 3C               inc  a
 922+ 7E48 E6 07            and  7                 ; Alterna 0..7
 923+ 7E4A DD 77 07         ld   (ix+7), a
 924+ 7E4D
 925+ 7E4D              .anim_done:
 926+ 7E4D
 927+ 7E4D                  ; 3. Determina se orizzontale o verticale
 928+ 7E4D DD 7E 00         ld   a, (ix+0)         ; Flags
 929+ 7E50 E6 40            and  $40               ; Vertical? (Bit 6)
 930+ 7E52 C2 9C 7E         jp   nz, .vertical
 931+ 7E55
 932+ 7E55              .horizontal:
 933+ 7E55 DD 7E 06         ld   a, (ix+6)         ; Direction (1=Left, 2=Right) (Offset 6)
 934+ 7E58 FE 01            cp   1
 935+ 7E5A 20 20            jr   nz, .horiz_right
 936+ 7E5C
 937+ 7E5C              .horiz_left:
 938+ 7E5C DD 7E 02         ld   a, (ix+2)         ; Current X
 939+ 7E5F D6 02            sub  2                 ; Muovi a sinistra di 2 pixel
 940+ 7E61 DD BE 04         cp   (ix+4)            ; Min Limit (Offset 4)
 941+ 7E64 28 08            jr   z, .h_rev_right
 942+ 7E66 38 06            jr   c, .h_rev_right
 943+ 7E68 DD 77 02         ld   (ix+2), a
 944+ 7E6B C3 E0 7E         jp   .next
 945+ 7E6E
 946+ 7E6E              .h_rev_right:
 947+ 7E6E DD 7E 04         ld   a, (ix+4)         ; Min Limit
 948+ 7E71 DD 77 02         ld   (ix+2), a
 949+ 7E74 3E 02            ld   a, 2
 950+ 7E76 DD 77 06         ld   (ix+6), a         ; Cambia direzione a Destra (Offset 6)
 951+ 7E79 C3 E0 7E         jp   .next
 952+ 7E7C
 953+ 7E7C              .horiz_right:
 954+ 7E7C DD 7E 02         ld   a, (ix+2)         ; Current X
 955+ 7E7F C6 02            add  a, 2              ; Muovi a destra di 2 pixel
 956+ 7E81 DD BE 05         cp   (ix+5)            ; Max Limit (Offset 5)
 957+ 7E84 28 08            jr   z, .h_rev_left
 958+ 7E86 30 06            jr   nc, .h_rev_left
 959+ 7E88 DD 77 02         ld   (ix+2), a
 960+ 7E8B C3 E0 7E         jp   .next
 961+ 7E8E
 962+ 7E8E              .h_rev_left:
 963+ 7E8E DD 7E 05         ld   a, (ix+5)         ; Max Limit
 964+ 7E91 DD 77 02         ld   (ix+2), a
 965+ 7E94 3E 01            ld   a, 1
 966+ 7E96 DD 77 06         ld   (ix+6), a         ; Cambia direzione a Sinistra
 967+ 7E99 C3 E0 7E         jp   .next
 968+ 7E9C
 969+ 7E9C              .vertical:
 970+ 7E9C DD 7E 06         ld   a, (ix+6)         ; Direction (1=Up, 2=Down)
 971+ 7E9F FE 01            cp   1
 972+ 7EA1 20 20            jr   nz, .vert_down
 973+ 7EA3
 974+ 7EA3              .vert_up:
 975+ 7EA3 DD 7E 03         ld   a, (ix+3)         ; Current Y
 976+ 7EA6 D6 02            sub  2                 ; Muovi in alto di 2 pixel
 977+ 7EA8 DD BE 04         cp   (ix+4)            ; Min Limit (Top)
 978+ 7EAB 28 08            jr   z, .v_rev_down
 979+ 7EAD 38 06            jr   c, .v_rev_down
 980+ 7EAF DD 77 03         ld   (ix+3), a
 981+ 7EB2 C3 E0 7E         jp   .next
 982+ 7EB5
 983+ 7EB5              .v_rev_down:
 984+ 7EB5 DD 7E 04         ld   a, (ix+4)         ; Min Limit
 985+ 7EB8 DD 77 03         ld   (ix+3), a
 986+ 7EBB 3E 02            ld   a, 2
 987+ 7EBD DD 77 06         ld   (ix+6), a         ; Cambia direzione in Basso
 988+ 7EC0 C3 E0 7E         jp   .next
 989+ 7EC3
 990+ 7EC3              .vert_down:
 991+ 7EC3 DD 7E 03         ld   a, (ix+3)         ; Current Y
 992+ 7EC6 C6 02            add  a, 2              ; Muovi in basso di 2 pixel
 993+ 7EC8 DD BE 05         cp   (ix+5)            ; Max Limit (Bottom)
 994+ 7ECB 28 08            jr   z, .v_rev_up
 995+ 7ECD 30 06            jr   nc, .v_rev_up
 996+ 7ECF DD 77 03         ld   (ix+3), a
 997+ 7ED2 C3 E0 7E         jp   .next
 998+ 7ED5
 999+ 7ED5              .v_rev_up:
1000+ 7ED5 DD 7E 05         ld   a, (ix+5)         ; Max Limit
1001+ 7ED8 DD 77 03         ld   (ix+3), a
1002+ 7EDB 3E 01            ld   a, 1
1003+ 7EDD DD 77 06         ld   (ix+6), a         ; Cambia direzione in Alto
1004+ 7EE0
1005+ 7EE0              .next:
1006+ 7EE0 11 0B 00         ld   de, 11
1007+ 7EE3 DD 19            add  ix, de            ; Prossimo slot (11 byte)
1008+ 7EE5 05               dec  b
1009+ 7EE6 C2 09 7E         jp   nz, .loop
1010+ 7EE9
1011+ 7EE9 DD E1            pop  ix
1012+ 7EEB C1               pop  bc
1013+ 7EEC D1               pop  de
1014+ 7EED E1               pop  hl
1015+ 7EEE C9               ret
