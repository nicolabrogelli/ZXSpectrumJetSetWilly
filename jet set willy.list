1144+ 8325 36 00            ld   (hl), 0
1145+ 8327 01 FF 01         ld   bc, 511
1146+ 832A ED B0            ldir
1147+ 832C
1148+ 832C                  ; ---------------------------------------------------------------
1149+ 832C                  ; Nessun item attivo nella stanza
1150+ 832C                  ; ---------------------------------------------------------------
