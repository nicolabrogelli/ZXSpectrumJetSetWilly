 128+ 5E44 CD 0E 5E         call GetScreenAddr ; HL = indirizzo schermo
 129+ 5E47
 130+ 5E47                  ; 2. Calcola offset shift = X & 7
 131+ 5E47 79               ld   a, c
 132+ 5E48 E6 07            and  7
 133+ 5E4A 47               ld   b, a          ; B = shift offset (0..7)
 134+ 5E4B
 135+ 5E4B 0E 08            ld   c, 8          ; 8 linee
 136+ 5E4D              .line_loop:
 137+ 5E4D DD 7E 00         ld   a, (ix+0)     ; A = byte dello sprite
 138+ 5E50 57               ld   d, a
 139+ 5E51 1E 00            ld   e, 0
 140+ 5E53
 141+ 5E53 78               ld   a, b          ; Shift se necessario
 142+ 5E54 B7               or   a
 143+ 5E55 28 07            jr   z, .no_shift
 144+ 5E57
 145+ 5E57              .shift_loop:
 146+ 5E57 CB 3A            srl  d
 147+ 5E59 CB 1B            rr   e
 148+ 5E5B 3D               dec  a
 149+ 5E5C 20 F9            jr   nz, .shift_loop
 150+ 5E5E
 151+ 5E5E              .no_shift:
 152+ 5E5E                  ; Scrivi sullo schermo (OR trasparente)
 153+ 5E5E 7A               ld   a, d
 154+ 5E5F B6               or   (hl)
 155+ 5E60 77               ld   (hl), a
 156+ 5E61 23               inc  hl
 157+ 5E62 7B               ld   a, e
 158+ 5E63 B6               or   (hl)
 159+ 5E64 77               ld   (hl), a
 160+ 5E65 2B               dec  hl            ; Ritorna alla colonna iniziale
 161+ 5E66
 162+ 5E66 CD 2E 5E         call IncScreenLine ; Prossima scanline sullo schermo
 163+ 5E69 DD 23            inc  ix            ; Prossimo byte dello sprite
 164+ 5E6B 0D               dec  c
 165+ 5E6C 20 DF            jr   nz, .line_loop
