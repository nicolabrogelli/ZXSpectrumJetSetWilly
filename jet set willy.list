 174+ 6C69
 175+ 6C69                  ; ---------------------------------------------------------------
 176+ 6C69                  ; Confronto con TheBathroomLayout
 177+ 6C69                  ; ---------------------------------------------------------------
 178+ 6C69 2A 21 7E         ld   hl, (room_ptr)
 179+ 6C6C 11 0C 89         ld   de, TheBathroomLayout
 180+ 6C6F B7               or   a
 181+ 6C70 ED 52            sbc  hl, de
 182+ 6C72 20 04            jr   nz, .not_thebathroom
 183+ 6C74
