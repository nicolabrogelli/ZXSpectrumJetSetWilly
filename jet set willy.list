1865+ 77F9
1866+ 77F9                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1867+ 77F9 78               ld   a, b
1868+ 77FA FE 80            cp   128
1869+ 77FC 30 17            jr   nc, .not_nasty
1870+ 77FE
1871+ 77FE                  ; 2. Calcola riga di layout: r = Y / 8
1872+ 77FE CB 3F            srl  a
1873+ 7800 CB 3F            srl  a
1874+ 7802 CB 3F            srl  a                 ; A = r (0..15)
1875+ 7804
1876+ 7804                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1877+ 7804 5F               ld   e, a              ; E = r
1878+ 7805 79               ld   a, c
1879+ 7806 CB 3F            srl  a
1880+ 7808 CB 3F            srl  a
1881+ 780A CB 3F            srl  a                 ; A = c (0..31)
1882+ 780C 4F               ld   c, a              ; C = c
1883+ 780D 7B               ld   a, e              ; A = r
1884+ 780E
1885+ 780E CD 7C 75         call GetCellFromUnpacked ; A = cell type
