  42+ 6A87 4F               ld   c, a              ; C = c
  43+ 6A88 7B               ld   a, e              ; A = r
  44+ 6A89
  45+ 6A89 CD 48 70         call GetCellFromUnpacked ; A = cell type
  46+ 6A8C
