   4+ 7B13              ; Gestione degli effetti sonori e della musica di sottofondo per il beeper.
   5+ 7B13              ;===========================================================================
   6+ 7B13
   7+ 7B13              ; -------------------------------------------------------------------
   8+ 7B13              ; Audio_UpdateJumpSound
   9+ 7B13              ;
  10+ 7B13              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7B13              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7B13              ; -------------------------------------------------------------------
  13+ 7B13              Audio_UpdateJumpSound:
  14+ 7B13 F5               push af
  15+ 7B14 C5               push bc
  16+ 7B15 D5               push de
  17+ 7B16 E5               push hl
  18+ 7B17
  19+ 7B17                  ; Controlla se il suono è attivo (note < 18)
  20+ 7B17 3A 00 7F         ld   a, (Audio_jump_sound_note)
  21+ 7B1A FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7B1C 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7B1E
  24+ 7B1E                  ; Carica la nota corrente da suonare
  25+ 7B1E 5F               ld   e, a
  26+ 7B1F 16 00            ld   d, 0
  27+ 7B21 21 4D 7B         ld   hl, Audio_JumpSoundDelays
  28+ 7B24 19               add  hl, de
  29+ 7B25 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7B26 57               ld   d, a                      ; D = delay della nota
  31+ 7B27
  32+ 7B27                  ; Suona la nota: 15 cicli
  33+ 7B27 06 0F            ld   b, 15
  34+ 7B29              .note_loop:
  35+ 7B29                  ; Speaker ON
  36+ 7B29 3A 8D 7B         ld   a, (room_border_color)
  37+ 7B2C F6 10            or   $10
  38+ 7B2E D3 FE            out  ($fe), a
  39+ 7B30 4A               ld   c, d
  40+ 7B31              .d1:
  41+ 7B31 0D               dec  c
  42+ 7B32 20 FD            jr   nz, .d1
  43+ 7B34
  44+ 7B34                  ; Speaker OFF
  45+ 7B34 3A 8D 7B         ld   a, (room_border_color)
  46+ 7B37 E6 EF            and  $ef
  47+ 7B39 D3 FE            out  ($fe), a
  48+ 7B3B 4A               ld   c, d
  49+ 7B3C              .d2:
  50+ 7B3C 0D               dec  c
  51+ 7B3D 20 FD            jr   nz, .d2
  52+ 7B3F
  53+ 7B3F 10 E8            djnz .note_loop
  54+ 7B41
  55+ 7B41                  ; Passa alla nota successiva
  56+ 7B41 3A 00 7F         ld   a, (Audio_jump_sound_note)
  57+ 7B44 3C               inc  a
  58+ 7B45 32 00 7F         ld   (Audio_jump_sound_note), a
  59+ 7B48
  60+ 7B48              .done:
  61+ 7B48 E1               pop  hl
  62+ 7B49 D1               pop  de
  63+ 7B4A C1               pop  bc
  64+ 7B4B F1               pop  af
  65+ 7B4C C9               ret
  66+ 7B4D
  67+ 7B4D              Audio_JumpSoundDelays:
  68+ 7B4D 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7B51 19 13 0C 06
  68+ 7B55 0C 13 19 20
  68+ 7B59 26 2D 33 3A
  68+ 7B5D 40 47
  69+ 7B5F
