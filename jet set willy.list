1840+ 85AB
1841+ 85AB 3A 7D EE         ld   a, (current_room)
1842+ 85AE BA               cp   d
1843+ 85AF
1844+ 85AF                  ; Se appartiene a un'altra stanza salta il record
1845+ 85AF 20 4A            jr   nz, .next_item
1846+ 85B1
1847+ 85B1                  ; ---------------------------------------------------------------
1848+ 85B1                  ; Legge coordinate e stato dell'item
1849+ 85B1                  ; ---------------------------------------------------------------
1850+ 85B1
1851+ 85B1 23               inc  hl
1852+ 85B2 4E               ld   c, (hl)           ; C = X
1853+ 85B3
1854+ 85B3 23               inc  hl
1855+ 85B4 46               ld   b, (hl)           ; B = Y
1856+ 85B5
1857+ 85B5 23               inc  hl                ; salta Color
1858+ 85B6
1859+ 85B6 23               inc  hl                ; punta a Collected
1860+ 85B7
1861+ 85B7 7E               ld   a, (hl)
1862+ 85B8
