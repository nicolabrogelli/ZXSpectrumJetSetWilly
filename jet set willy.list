1906+ 74B7              ; Controlla la collisione di Willy con le celle Nasty (tipo 3)
1907+ 74B7              ; Controlla 6 punti strategici della bounding box di Willy (16x8 pixel)
1908+ 74B7              ; Output: Carry flag impostato se c'è collisione, altrimenti resettato
1909+ 74B7              ; -------------------------------------------------------------------
1910+ 74B7              Phys_CheckNastyCollision:
1911+ 74B7 C5               push bc
1912+ 74B8
1913+ 74B8 ED 4B BD E6      ld   bc, (PlayerPos)   ; B = Y, C = X
1914+ 74BC
1915+ 74BC                  ; Punto 1: Top-Left (X, Y)
1916+ 74BC CD 8E 74         call CheckNastyCell
1917+ 74BF 38 38            jr   c, .collision
1918+ 74C1
1919+ 74C1                  ; Punto 2: Top-Right (X + 7, Y)
1920+ 74C1 79               ld   a, c
1921+ 74C2 C6 07            add  a, 7
1922+ 74C4 4F               ld   c, a
1923+ 74C5 CD 8E 74         call CheckNastyCell
1924+ 74C8 38 2F            jr   c, .collision
1925+ 74CA
1926+ 74CA                  ; Punto 3: Mid-Left (X, Y + 7)
1927+ 74CA ED 4B BD E6      ld   bc, (PlayerPos)
1928+ 74CE 78               ld   a, b
1929+ 74CF C6 07            add  a, 7
1930+ 74D1 47               ld   b, a
1931+ 74D2 CD 8E 74         call CheckNastyCell
1932+ 74D5 38 22            jr   c, .collision
1933+ 74D7
1934+ 74D7                  ; Punto 4: Mid-Right (X + 7, Y + 7)
1935+ 74D7 79               ld   a, c
1936+ 74D8 C6 07            add  a, 7
1937+ 74DA 4F               ld   c, a
1938+ 74DB CD 8E 74         call CheckNastyCell
1939+ 74DE 38 19            jr   c, .collision
1940+ 74E0
1941+ 74E0                  ; Punto 5: Bottom-Left (X, Y + 15)
1942+ 74E0 ED 4B BD E6      ld   bc, (PlayerPos)
1943+ 74E4 78               ld   a, b
1944+ 74E5 C6 0F            add  a, 15
1945+ 74E7 47               ld   b, a
1946+ 74E8 CD 8E 74         call CheckNastyCell
1947+ 74EB 38 0C            jr   c, .collision
1948+ 74ED
1949+ 74ED                  ; Punto 6: Bottom-Right (X + 7, Y + 15)
1950+ 74ED 79               ld   a, c
1951+ 74EE C6 07            add  a, 7
1952+ 74F0 4F               ld   c, a
1953+ 74F1 CD 8E 74         call CheckNastyCell
1954+ 74F4 38 03            jr   c, .collision
1955+ 74F6
1956+ 74F6 C1               pop  bc
1957+ 74F7 B7               or   a                 ; Clear carry
1958+ 74F8 C9               ret
1959+ 74F9
1960+ 74F9              .collision:
1961+ 74F9 C1               pop  bc
1962+ 74FA 37               scf                    ; Set carry
1963+ 74FB C9               ret
