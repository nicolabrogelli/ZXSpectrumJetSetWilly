1183+ 7974                  ; A = 1 -> Floor
1184+ 7974                  ; A = 2 -> Wall
1185+ 7974                  ; A = 3 -> Nasty
1186+ 7974                  ; ---------------------------------------------------------------
1187+ 7974
1188+ 7974 B7               or   a
1189+ 7975 20 06            jr   nz, .not_bg
1190+ 7977
1191+ 7977                  ; Background
1192+ 7977 21 A0 00         ld   hl, OFFSET_BG
1193+ 797A 19               add  hl, de
1194+ 797B 18 16            jr   .draw_cell
1195+ 797D
1196+ 797D              .not_bg:
1197+ 797D
1198+ 797D 3D               dec  a
1199+ 797E 20 06            jr   nz, .not_floor
1200+ 7980
1201+ 7980                  ; Floor
1202+ 7980 21 A9 00         ld   hl, OFFSET_FLOOR
1203+ 7983 19               add  hl, de
1204+ 7984 18 0D            jr   .draw_cell
1205+ 7986
1206+ 7986              .not_floor:
1207+ 7986
1208+ 7986 3D               dec  a
1209+ 7987 20 06            jr   nz, .not_wall
