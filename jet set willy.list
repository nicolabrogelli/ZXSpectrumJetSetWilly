   8+ 8009              ; Audio_UpdateJumpSound
   9+ 8009              ;
  10+ 8009              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8009              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8009              ; -------------------------------------------------------------------
  13+ 8009              Audio_UpdateJumpSound:
  14+ 8009 F5               push af
  15+ 800A C5               push bc
  16+ 800B D5               push de
  17+ 800C E5               push hl
  18+ 800D
  19+ 800D                  ; Controlla se il suono è attivo (note < 18)
  20+ 800D 3A B9 E9         ld   a, (Audio_jump_sound_note)
  21+ 8010 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8012 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8014
  24+ 8014                  ; Carica la nota corrente da suonare
  25+ 8014 5F               ld   e, a
  26+ 8015 16 00            ld   d, 0
  27+ 8017 21 43 80         ld   hl, Audio_JumpSoundDelays
  28+ 801A 19               add  hl, de
  29+ 801B 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 801C 57               ld   d, a                      ; D = delay della nota
  31+ 801D
  32+ 801D                  ; Suona la nota: 15 cicli
  33+ 801D 06 0F            ld   b, 15
  34+ 801F              .note_loop:
  35+ 801F                  ; Speaker ON
  36+ 801F 3A 32 E6         ld   a, (room_border_color)
  37+ 8022 F6 10            or   $10
  38+ 8024 D3 FE            out  ($fe), a
  39+ 8026 4A               ld   c, d
  40+ 8027              .d1:
  41+ 8027 0D               dec  c
  42+ 8028 20 FD            jr   nz, .d1
  43+ 802A
  44+ 802A                  ; Speaker OFF
  45+ 802A 3A 32 E6         ld   a, (room_border_color)
  46+ 802D E6 EF            and  $ef
  47+ 802F D3 FE            out  ($fe), a
  48+ 8031 4A               ld   c, d
  49+ 8032              .d2:
  50+ 8032 0D               dec  c
  51+ 8033 20 FD            jr   nz, .d2
  52+ 8035
  53+ 8035 10 E8            djnz .note_loop
  54+ 8037
  55+ 8037                  ; Passa alla nota successiva
  56+ 8037 3A B9 E9         ld   a, (Audio_jump_sound_note)
  57+ 803A 3C               inc  a
  58+ 803B 32 B9 E9         ld   (Audio_jump_sound_note), a
  59+ 803E
  60+ 803E              .done:
  61+ 803E E1               pop  hl
  62+ 803F D1               pop  de
  63+ 8040 C1               pop  bc
  64+ 8041 F1               pop  af
  65+ 8042 C9               ret
  66+ 8043
  67+ 8043              Audio_JumpSoundDelays:
  68+ 8043 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 8047 19 13 0C 06
  68+ 804B 0C 13 19 20
  68+ 804F 26 2D 33 3A
  68+ 8053 40 47
