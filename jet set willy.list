 385  8841 77               ld   (hl), a
 386  8842 23               inc  hl
 387  8843 10 FC            djnz .color_cycle_loop
 388  8845
 389  8845                  ; Controlla se il tasto ENTER è premuto
 390  8845 3E BF            ld   a, $bf
 391  8847 DB FE            in   a, ($fe)
 392  8849 1F               rra
 393  884A 38 DF            jr   c, .wait_enter_press
