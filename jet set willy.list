  65+ 7027              ; Determina l'ID numerico della stanza corrente confrontando
  66+ 7027              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
  67+ 7027              ;
  68+ 7027              ; Se viene trovata una corrispondenza:
  69+ 7027              ;   A = ID della stanza
  70+ 7027              ;   current_room = A
  71+ 7027              ;
  72+ 7027              ; Mappatura:
  73+ 7027              ;    0 = The Off Licence
  74+ 7027              ;    1 = The Bridge
  75+ 7027              ;    2 = Under The Mega Tree
  76+ 7027              ;    3 = At The Foot Of The Mega Tree
  77+ 7027              ;    4 = The Drive
  78+ 7027              ;    5 = The Security Guard
  79+ 7027              ;    6 = Entrance To Hades
  80+ 7027              ;    7 = Cuckoo's Nest
  81+ 7027              ;    8 = Inside The Mega Trunk
  82+ 7027              ;    9 = On A Branch Over The Drive
  83+ 7027              ;   10 = The Front Door
  84+ 7027              ;   11 = The Hall
  85+ 7027              ;   12 = Tree Top
  86+ 7027              ;   33 = The Bathroom
  87+ 7027              ;   35 = Master Bedroom
  88+ 7027              ;
  89+ 7027              ; Se nessuna stanza corrisponde viene impostato:
  90+ 7027              ;   current_room = 0
  91+ 7027              ; -------------------------------------------------------------------
  92+ 7027              DetermineCurrentRoomID:
  93+ 7027
  94+ 7027                  ; Salva i registri utilizzati
  95+ 7027 E5               push hl
  96+ 7028 D5               push de
  97+ 7029
