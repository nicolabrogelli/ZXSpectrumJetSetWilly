1253+ 7211 06 80            ld   b, 128             ; 128 byte
1254+ 7213              .byte_loop:
1255+ 7213 7E               ld   a, (hl)            ; Leggi byte compresso
1256+ 7214 23               inc  hl
1257+ 7215
1258+ 7215 4F               ld   c, a               ; C = salvataggio
1259+ 7216
1260+ 7216                  ; Cella 0: bit 7-6
1261+ 7216 07               rlca
1262+ 7217 07               rlca
1263+ 7218 E6 03            and  3
1264+ 721A 12               ld   (de), a
1265+ 721B 13               inc  de
1266+ 721C
1267+ 721C                  ; Cella 1: bit 5-4
1268+ 721C 79               ld   a, c
1269+ 721D 07               rlca
1270+ 721E 07               rlca
1271+ 721F 07               rlca
1272+ 7220 07               rlca
1273+ 7221 E6 03            and  3
1274+ 7223 12               ld   (de), a
1275+ 7224 13               inc  de
1276+ 7225
1277+ 7225                  ; Cella 2: bit 3-2
1278+ 7225 79               ld   a, c
1279+ 7226 0F               rrca
1280+ 7227 0F               rrca
1281+ 7228 E6 03            and  3
1282+ 722A 12               ld   (de), a
1283+ 722B 13               inc  de
1284+ 722C
1285+ 722C                  ; Cella 3: bit 1-0
1286+ 722C 79               ld   a, c
1287+ 722D E6 03            and  3
1288+ 722F 12               ld   (de), a
1289+ 7230 13               inc  de
1290+ 7231
1291+ 7231 10 E0            djnz .byte_loop
1292+ 7233
1293+ 7233 C1               pop  bc
1294+ 7234 D1               pop  de
1295+ 7235 E1               pop  hl
1296+ 7236 C9               ret
