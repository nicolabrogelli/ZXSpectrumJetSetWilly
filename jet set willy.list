 174+ 79FA              ; Audio_PlayCollectSound
 175+ 79FA              ;
 176+ 79FA              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 177+ 79FA              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 178+ 79FA              ; -------------------------------------------------------------------
 179+ 79FA              Audio_PlayCollectSound:
 180+ 79FA C5               push bc
 181+ 79FB D5               push de
 182+ 79FC
 183+ 79FC 06 78            ld   b, 120
 184+ 79FE              .sound_loop:
 185+ 79FE 3A 27 7A         ld   a, (room_border_color)
 186+ 7A01 F6 10            or   $10               ; speaker ON
 187+ 7A03 D3 FE            out  ($fe), a
 188+ 7A05
 189+ 7A05 0E 3C            ld   c, 60
 190+ 7A07              .d1:
 191+ 7A07 0D               dec  c
 192+ 7A08 20 FD            jr   nz, .d1
 193+ 7A0A
 194+ 7A0A 3A 27 7A         ld   a, (room_border_color)
 195+ 7A0D E6 EF            and  $ef              ; speaker OFF
 196+ 7A0F D3 FE            out  ($fe), a
 197+ 7A11
 198+ 7A11 0E 3C            ld   c, 60
 199+ 7A13              .d2:
 200+ 7A13 0D               dec  c
 201+ 7A14 20 FD            jr   nz, .d2
 202+ 7A16
 203+ 7A16 10 E6            djnz .sound_loop
 204+ 7A18
 205+ 7A18 D1               pop  de
 206+ 7A19 C1               pop  bc
 207+ 7A1A C9               ret
