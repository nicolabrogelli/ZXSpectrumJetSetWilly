1211+ 8355                  ; Se diverso da zero l'item è già stato raccolto
1212+ 8355 B7               or   a
1213+ 8356 20 3E            jr   nz, .next_no_inc
1214+ 8358
1215+ 8358                  ; ---------------------------------------------------------------
1216+ 8358                  ; Disegna l'item sullo schermo
1217+ 8358                  ;
1218+ 8358                  ; B = Row
1219+ 8358                  ; C = Column
1220+ 8358                  ; HL = bitmap pointer
1221+ 8358                  ; E = Color
1222+ 8358                  ; ---------------------------------------------------------------
1223+ 8358 E5               push hl
1224+ 8359
1225+ 8359 DD E5            push ix
