 984+ 7EEA DD 7E 04         ld   a, (ix+4)         ; Min Limit
 985+ 7EED DD 77 03         ld   (ix+3), a
 986+ 7EF0 3E 02            ld   a, 2
 987+ 7EF2 DD 77 06         ld   (ix+6), a         ; Cambia direzione in Basso
