 882  8E05              ; -------------------------------------------------------------------
 883  8E05              ; ResetFullGameState
 884  8E05              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 885  8E05              ; per l'avvio di una nuova partita dopo il Game Over.
 886  8E05              ; -------------------------------------------------------------------
 887  8E05              ResetFullGameState:
 888  8E05                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 889  8E05 AF               xor  a
 890  8E06 D3 FE            out  ($fe), a              ; Bordo a nero
 891  8E08 21 8D 5C         ld   hl, ATTR_P
 892  8E0B 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 893  8E0C CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 894  8E0F 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 895  8E11 3E 07            ld   a, $07
 896  8E13 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 897  8E16
 898  8E16                  ; Ripristina il numero di vite iniziali
 899  8E16 3E 07            ld   a, INITIAL_LIVES
 900  8E18 32 12 F8         ld   (willy_lives), a
 901  8E1B
 902  8E1B                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 903  8E1B AF               xor  a
 904  8E1C 32 0F F8         ld   (items_collected), a
 905  8E1F 32 0B F8         ld   (body_state), a
 906  8E22 32 1E F8         ld   (w_warp_state), a
 907  8E25 32 21 F8         ld   (w_key_prev), a
 908  8E28 32 22 F8         ld   (enter_key_prev), a
 909  8E2B 32 13 F8         ld   (velocity_y), a
 910  8E2E 32 15 F8         ld   (jump_pressed), a
 911  8E31 32 17 F8         ld   (coyote_timer), a
 912  8E34 32 1A F8         ld   (jump_frame), a
 913  8E37 32 19 F8         ld   (jump_dir), a
 914  8E3A 32 8B FB         ld   (transition_active), a
 915  8E3D 32 0F FC         ld   (willy_safety_timer), a
 916  8E40 3E FF            ld   a, $ff
 917  8E42 32 23 F8         ld   (digit_key_prev), a
 918  8E45 3E 01            ld   a, 1
 919  8E47 32 1C F8         ld   (q_prev), a
 920  8E4A 32 1D F8         ld   (a_prev), a
 921  8E4D 32 14 F8         ld   (on_ground), a
 922  8E50
 923  8E50                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 924  8E50 3E 30            ld   a, '0'
 925  8E52 32 FB 68         ld   (status_line + 16), a
 926  8E55 32 FC 68         ld   (status_line + 17), a
 927  8E58 32 FD 68         ld   (status_line + 18), a
 928  8E5B
 929  8E5B                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 930  8E5B CD 59 86         call ResetItemsTable
 931  8E5E
 932  8E5E                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 933  8E5E CD 23 6E         call InitRoomEntryPositions
 934  8E61
 935  8E61                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 936  8E61 3E 07            ld   a, 7
 937  8E63 32 12 FC         ld   (time_hours), a
 938  8E66 AF               xor  a
 939  8E67 32 13 FC         ld   (time_minutes), a
 940  8E6A 32 14 FC         ld   (time_period), a       ; 0 = AM
 941  8E6D 32 17 FC         ld   (game_objective_completed), a
 942  8E70 2A 26 F8         ld   hl, (counter)
 943  8E73 22 15 FC         ld   (time_last_counter), hl
 944  8E76 CD 6D 68         call Gfx_UpdateTimeDisplay
 945  8E79
 946  8E79                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 947  8E79 21 BD B3         ld   hl, TheBathroomLayout; TheOffLicenceLayout
