1071+ 85EA              .set_room:
1072+ 85EA
1073+ 85EA                  ; Salva l'ID della stanza corrente
1074+ 85EA 32 55 F6         ld   (current_room), a
1075+ 85ED
1076+ 85ED                  ; Ripristina i registri
1077+ 85ED D1               pop  de
1078+ 85EE E1               pop  hl
1079+ 85EF
1080+ 85EF C9               ret
1081+ 85F0
1082+ 85F0              ; -------------------------------------------------------------------
1083+ 85F0              ; Items_DrawRoom
1084+ 85F0              ;
1085+ 85F0              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1086+ 85F0              ;
1087+ 85F0              ; Operazioni eseguite:
1088+ 85F0              ;   1. Azzera la griglia items_grid.
1089+ 85F0              ;   2. Svuota la cache degli oggetti attivi.
1090+ 85F0              ;   3. Scansiona ItemsTable.
1091+ 85F0              ;   4. Per ogni item della stanza corrente:
1092+ 85F0              ;        - verifica se è già stato raccolto
1093+ 85F0              ;        - disegna la grafica
1094+ 85F0              ;        - aggiorna items_grid
1095+ 85F0              ;        - memorizza l'item nella cache current_room_items
1096+ 85F0              ;   5. Aggiorna num_room_items.
1097+ 85F0              ;
1098+ 85F0              ; Record ItemsTable:
1099+ 85F0              ;   +0  Room ID
1100+ 85F0              ;   +1  X (colonna)
1101+ 85F0              ;   +2  Y (riga)
1102+ 85F0              ;   +3  Colore
1103+ 85F0              ;   +4  Collected flag
1104+ 85F0              ;
1105+ 85F0              ; Cache current_room_items:
1106+ 85F0              ;   +0  Colonna
1107+ 85F0              ;   +1  Riga
1108+ 85F0              ;   +2  Colore
1109+ 85F0              ;   +3  Collected flag ptr (Low)
1110+ 85F0              ;   +4  Collected flag ptr (High)
1111+ 85F0              ;
1112+ 85F0              ; Ogni record cache occupa 5 byte.
1113+ 85F0              ; -------------------------------------------------------------------
1114+ 85F0              ; ResetItemsTable
1115+ 85F0              ; Ripristina il flag di raccolta (byte 4) di ciascun record in ItemsTable
1116+ 85F0              ; a 0 (non raccolto) per azzerare lo stato di tutti gli item in tutti i livelli.
1117+ 85F0              ; -------------------------------------------------------------------
1118+ 85F0              ResetItemsTable:
1119+ 85F0 21 94 80         ld   hl, ItemsTable
1120+ 85F3              .reset_loop:
1121+ 85F3 7E               ld   a, (hl)
1122+ 85F4 FE FF            cp   $FF
1123+ 85F6 C8               ret  z
1124+ 85F7 23               inc  hl                        ; +1 (X)
1125+ 85F8 23               inc  hl                        ; +2 (Y)
1126+ 85F9 23               inc  hl                        ; +3 (Color)
1127+ 85FA 23               inc  hl                        ; +4 (Collected flag)
1128+ 85FB 36 00            ld   (hl), 0                   ; Imposta collected flag a 0 (non raccolto)
1129+ 85FD 23               inc  hl                        ; Prossimo record
1130+ 85FE 18 F3            jr   .reset_loop
1131+ 8600
1132+ 8600              ; -------------------------------------------------------------------
1133+ 8600              Items_DrawRoom:
1134+ 8600
1135+ 8600                  ; Salva tutti i registri utilizzati
1136+ 8600 E5               push hl
1137+ 8601 D5               push de
1138+ 8602 C5               push bc
1139+ 8603 DD E5            push ix
1140+ 8605 FD E5            push iy
1141+ 8607
1142+ 8607                  ; ---------------------------------------------------------------
1143+ 8607                  ; Azzera items_grid (32 x 16 = 512 byte)
1144+ 8607                  ; ---------------------------------------------------------------
1145+ 8607 21 2F F1         ld   hl, items_grid
1146+ 860A 11 30 F1         ld   de, items_grid + 1
1147+ 860D 36 00            ld   (hl), 0
1148+ 860F 01 FF 01         ld   bc, 511
1149+ 8612 ED B0            ldir
1150+ 8614
1151+ 8614                  ; ---------------------------------------------------------------
1152+ 8614                  ; Nessun item attivo nella stanza
1153+ 8614                  ; ---------------------------------------------------------------
1154+ 8614 AF               xor  a
1155+ 8615 32 AE F6         ld   (num_room_items), a
1156+ 8618
1157+ 8618                  ; IY punta alla cache degli item attivi
1158+ 8618 FD 21 5E F6      ld   iy, current_room_items
1159+ 861C
1160+ 861C                  ; ---------------------------------------------------------------
1161+ 861C                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1162+ 861C                  ; alla stanza corrente.
1163+ 861C                  ;
1164+ 861C                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1165+ 861C                  ; ---------------------------------------------------------------
1166+ 861C 2A AF F6         ld   hl, (room_ptr)
1167+ 861F 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1168+ 8622 19               add  hl, de
1169+ 8623
1170+ 8623 E5               push hl
1171+ 8624 DD E1            pop  ix                ; IX = bitmap item
1172+ 8626
1173+ 8626                  ; ---------------------------------------------------------------
1174+ 8626                  ; Inizio scansione della tabella degli item
1175+ 8626                  ; ---------------------------------------------------------------
1176+ 8626 21 94 80         ld   hl, ItemsTable
1177+ 8629
1178+ 8629              .loop:
1179+ 8629
1180+ 8629                  ; ---------------------------------------------------------------
1181+ 8629                  ; Legge il Room ID del record corrente
1182+ 8629                  ; ---------------------------------------------------------------
1183+ 8629 7E               ld   a, (hl)
1184+ 862A
1185+ 862A                  ; $FF indica fine tabella
1186+ 862A FE FF            cp   $FF
1187+ 862C 28 53            jr   z, .done
1188+ 862E
1189+ 862E                  ; ---------------------------------------------------------------
1190+ 862E                  ; Verifica se l'item appartiene alla stanza corrente
1191+ 862E                  ; ---------------------------------------------------------------
1192+ 862E 57               ld   d, a
1193+ 862F
1194+ 862F 3A 55 F6         ld   a, (current_room)
1195+ 8632 BA               cp   d
1196+ 8633 20 45            jr   nz, .next_item
1197+ 8635
1198+ 8635                  ; ---------------------------------------------------------------
1199+ 8635                  ; Legge i dati dell'item
1200+ 8635                  ; ---------------------------------------------------------------
1201+ 8635
1202+ 8635 23               inc  hl
1203+ 8636 4E               ld   c, (hl)           ; X (colonna)
1204+ 8637
1205+ 8637 23               inc  hl
1206+ 8638 46               ld   b, (hl)           ; Y (riga)
1207+ 8639
1208+ 8639 23               inc  hl
1209+ 863A 5E               ld   e, (hl)           ; Colore
1210+ 863B
1211+ 863B 23               inc  hl
1212+ 863C 7E               ld   a, (hl)           ; Collected flag
1213+ 863D
1214+ 863D                  ; Se diverso da zero l'item è già stato raccolto
1215+ 863D B7               or   a
1216+ 863E 20 3E            jr   nz, .next_no_inc
1217+ 8640
1218+ 8640                  ; ---------------------------------------------------------------
1219+ 8640                  ; Disegna l'item sullo schermo
1220+ 8640                  ;
1221+ 8640                  ; B = Row
1222+ 8640                  ; C = Column
1223+ 8640                  ; HL = bitmap pointer
1224+ 8640                  ; E = Color
1225+ 8640                  ; ---------------------------------------------------------------
1226+ 8640 E5               push hl
1227+ 8641
1228+ 8641 DD E5            push ix
1229+ 8643 E1               pop  hl
1230+ 8644
1231+ 8644 CD 89 86         call DrawItemGraphic
1232+ 8647
1233+ 8647 E1               pop  hl                ; ritorna al flag collected
1234+ 8648
1235+ 8648                  ; ---------------------------------------------------------------
1236+ 8648                  ; Aggiorna items_grid
1237+ 8648                  ;
1238+ 8648                  ; Calcolo:
1239+ 8648                  ;   offset = Row * 32 + Col
1240+ 8648                  ; ---------------------------------------------------------------
1241+ 8648 E5               push hl
1242+ 8649 D5               push de
1243+ 864A
1244+ 864A 26 00            ld   h, 0
1245+ 864C 68               ld   l, b              ; HL = Row
1246+ 864D
1247+ 864D 29               add  hl, hl            ; *2
1248+ 864E 29               add  hl, hl            ; *4
1249+ 864F 29               add  hl, hl            ; *8
1250+ 8650 29               add  hl, hl            ; *16
1251+ 8651 29               add  hl, hl            ; *32
1252+ 8652
1253+ 8652 16 00            ld   d, 0
1254+ 8654 59               ld   e, c              ; DE = Col
1255+ 8655
1256+ 8655 19               add  hl, de            ; Row*32 + Col
1257+ 8656
1258+ 8656 11 2F F1         ld   de, items_grid
1259+ 8659 19               add  hl, de            ; puntatore nella griglia
1260+ 865A
1261+ 865A D1               pop  de                ; ripristina colore
1262+ 865B
1263+ 865B 73               ld   (hl), e           ; salva colore cella
1264+ 865C
1265+ 865C E1               pop  hl
1266+ 865D
1267+ 865D                  ; ---------------------------------------------------------------
1268+ 865D                  ; Salva l'item nella cache della stanza
1269+ 865D                  ;
1270+ 865D                  ; Questo evita di dover scansionare tutta ItemsTable
1271+ 865D                  ; durante il controllo delle collisioni.
1272+ 865D                  ; ---------------------------------------------------------------
1273+ 865D
1274+ 865D FD 71 00         ld   (iy+0), c         ; Colonna
1275+ 8660 FD 70 01         ld   (iy+1), b         ; Riga
1276+ 8663 FD 73 02         ld   (iy+2), e         ; Colore
1277+ 8666
1278+ 8666                  ; Salva il puntatore al flag "collected"
1279+ 8666 FD 75 03         ld   (iy+3), l         ; Low byte
1280+ 8669 FD 74 04         ld   (iy+4), h         ; High byte
1281+ 866C
1282+ 866C                  ; Passa al record successivo della cache
1283+ 866C 01 05 00         ld   bc, 5
1284+ 866F FD 09            add  iy, bc
1285+ 8671
1286+ 8671                  ; Incrementa il numero di item attivi
1287+ 8671 3A AE F6         ld   a, (num_room_items)
1288+ 8674 3C               inc  a
1289+ 8675 32 AE F6         ld   (num_room_items), a
1290+ 8678
1291+ 8678 18 04            jr   .next_no_inc
1292+ 867A
1293+ 867A              .next_item:
1294+ 867A
1295+ 867A                  ; ---------------------------------------------------------------
1296+ 867A                  ; L'item non appartiene alla stanza corrente.
1297+ 867A                  ; Salta i campi del record:
1298+ 867A                  ;   X
1299+ 867A                  ;   Y
1300+ 867A                  ;   Color
1301+ 867A                  ;   Collected
1302+ 867A                  ; ---------------------------------------------------------------
1303+ 867A 23               inc  hl
1304+ 867B 23               inc  hl
1305+ 867C 23               inc  hl
1306+ 867D 23               inc  hl
1307+ 867E
1308+ 867E              .next_no_inc:
1309+ 867E
1310+ 867E                  ; ---------------------------------------------------------------
1311+ 867E                  ; Avanza al record successivo
1312+ 867E                  ; (prossimo Room ID)
1313+ 867E                  ; ---------------------------------------------------------------
1314+ 867E 23               inc  hl
1315+ 867F 18 A8            jr   .loop
1316+ 8681
1317+ 8681              .done:
1318+ 8681
1319+ 8681                  ; Ripristina i registri
1320+ 8681 FD E1            pop  iy
1321+ 8683 DD E1            pop  ix
1322+ 8685 D1               pop  de
1323+ 8686 C1               pop  bc
1324+ 8687 E1               pop  hl
1325+ 8688
1326+ 8688 C9               ret
1327+ 8689
1328+ 8689              ; -------------------------------------------------------------------
1329+ 8689              ; DrawItemGraphic
1330+ 8689              ;
1331+ 8689              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1332+ 8689              ; utilizzando una bitmap di 8 byte e un attributo colore.
1333+ 8689              ;
1334+ 8689              ; Input:
1335+ 8689              ;   B = Riga attributi (3..18)
1336+ 8689              ;   C = Colonna attributi (0..31)
1337+ 8689              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1338+ 8689              ;   E = Attributo colore
1339+ 8689              ;
1340+ 8689              ; Output:
1341+ 8689              ;   Nessuno
1342+ 8689              ;
1343+ 8689              ; Registri preservati:
1344+ 8689              ;   BC, DE, HL
1345+ 8689              ; -------------------------------------------------------------------
1346+ 8689              DrawItemGraphic:
1347+ 8689
1348+ 8689                  ; Salva i registri originali
1349+ 8689 C5               push bc
1350+ 868A D5               push de
1351+ 868B E5               push hl
1352+ 868C
1353+ 868C                  ; ---------------------------------------------------------------
1354+ 868C                  ; Calcolo indirizzo bitmap dello Spectrum
1355+ 868C                  ;
1356+ 868C                  ; Ogni item occupa una cella attributi (8x8 pixel).
1357+ 868C                  ;
1358+ 868C                  ; Formula:
1359+ 868C                  ;   High = $40 + (Row AND $18)
1360+ 868C                  ;   Low  = (Row AND 7) * 32 + Col
1361+ 868C                  ;
1362+ 868C                  ; DE conterrà l'indirizzo della prima scanline.
1363+ 868C                  ; ---------------------------------------------------------------
1364+ 868C
1365+ 868C 78               ld   a, b
1366+ 868D E6 18            and  $18
1367+ 868F C6 40            add  a, $40
1368+ 8691 57               ld   d, a              ; Byte alto indirizzo video
1369+ 8692
1370+ 8692 78               ld   a, b
1371+ 8693 E6 07            and  7                 ; Riga interna al blocco da 8
1372+ 8695
1373+ 8695 87               add  a, a              ; *2
1374+ 8696 87               add  a, a              ; *4
1375+ 8697 87               add  a, a              ; *8
1376+ 8698 87               add  a, a              ; *16
1377+ 8699 87               add  a, a              ; *32
1378+ 869A
1379+ 869A 81               add  a, c              ; + colonna
1380+ 869B
1381+ 869B 5F               ld   e, a              ; Byte basso indirizzo video
1382+ 869C
1383+ 869C                  ; ---------------------------------------------------------------
1384+ 869C                  ; Disegno bitmap
1385+ 869C                  ;
1386+ 869C                  ; Copia 8 byte consecutivi nella memoria video.
1387+ 869C                  ; Ogni byte rappresenta una scanline da 8 pixel.
1388+ 869C                  ; ---------------------------------------------------------------
1389+ 869C
1390+ 869C C5               push bc                ; Conserva Row e Col
1391+ 869D
1392+ 869D 06 08            ld   b, 8              ; Numero scanline
1393+ 869F
1394+ 869F              .line_loop:
1395+ 869F
1396+ 869F 7E               ld   a, (hl)           ; Legge scanline bitmap
1397+ 86A0 12               ld   (de), a           ; Scrive nella memoria video
1398+ 86A1
1399+ 86A1 14               inc  d                 ; Scanline successiva
1400+ 86A2 23               inc  hl                ; Byte bitmap successivo
1401+ 86A3
1402+ 86A3 05               dec  b
1403+ 86A4 20 F9            jr   nz, .line_loop
1404+ 86A6
1405+ 86A6 C1               pop  bc                ; Ripristina Row e Col
1406+ 86A7
1407+ 86A7                  ; ---------------------------------------------------------------
1408+ 86A7                  ; Calcolo indirizzo attributo
1409+ 86A7                  ;
1410+ 86A7                  ; Formula:
1411+ 86A7                  ;   AttrAddr = $5800 + Row * 32 + Col
1412+ 86A7                  ;
1413+ 86A7                  ; HL conterrà l'indirizzo della cella attributi.
1414+ 86A7                  ; ---------------------------------------------------------------
1415+ 86A7
1416+ 86A7 26 00            ld   h, 0
1417+ 86A9 68               ld   l, b              ; HL = Row
1418+ 86AA
1419+ 86AA 29               add  hl, hl            ; *2
1420+ 86AB 29               add  hl, hl            ; *4
1421+ 86AC 29               add  hl, hl            ; *8
1422+ 86AD 29               add  hl, hl            ; *16
1423+ 86AE 29               add  hl, hl            ; *32
1424+ 86AF
1425+ 86AF 79               ld   a, c              ; A = Colonna
1426+ 86B0
1427+ 86B0 85               add  a, l
1428+ 86B1 6F               ld   l, a
1429+ 86B2
1430+ 86B2 30 01            jr   nc, .no_carry
1431+ 86B4 24               inc  h
1432+ 86B5
1433+ 86B5              .no_carry:
1434+ 86B5
1435+ 86B5                  ; HL = Row * 32 + Col
1436+ 86B5
1437+ 86B5 11 00 58         ld   de, $5800
1438+ 86B8 19               add  hl, de            ; HL = indirizzo attributi
1439+ 86B9
1440+ 86B9                  ; ---------------------------------------------------------------
1441+ 86B9                  ; Recupera il colore originale dallo stack.
1442+ 86B9                  ;
1443+ 86B9                  ; Layout stack:
1444+ 86B9                  ;   HL originale
1445+ 86B9                  ;   DE originale (E = colore)
1446+ 86B9                  ;   BC originale
1447+ 86B9                  ; ---------------------------------------------------------------
1448+ 86B9
1449+ 86B9 C1               pop  bc                ; Recupera HL originale
1450+ 86BA D1               pop  de                ; Recupera DE originale
1451+ 86BB
1452+ 86BB                  ; ---------------------------------------------------------------
1453+ 86BB                  ; Scrive l'attributo colore
1454+ 86BB                  ; ---------------------------------------------------------------
1455+ 86BB
1456+ 86BB 7B               ld   a, e              ; A = colore
1457+ 86BC 77               ld   (hl), a           ; Scrive nella RAM attributi
1458+ 86BD
1459+ 86BD                  ; ---------------------------------------------------------------
1460+ 86BD                  ; Ripristina HL e BC originali
1461+ 86BD                  ; ---------------------------------------------------------------
1462+ 86BD
1463+ 86BD C5               push bc
1464+ 86BE E1               pop  hl                ; HL originale
1465+ 86BF
1466+ 86BF C1               pop  bc                ; BC originale
1467+ 86C0
1468+ 86C0 C9               ret
1469+ 86C1
1470+ 86C1              ; -------------------------------------------------------------------
1471+ 86C1              ; RestoreBackgroundCell
1472+ 86C1              ;
1473+ 86C1              ; Ripristina il contenuto originale di una cella della stanza.
1474+ 86C1              ; Viene utilizzata principalmente quando un item viene raccolto:
1475+ 86C1              ; invece di lasciare un "buco", la routine ridisegna il tile
1476+ 86C1              ; originale presente nella mappa della stanza.
1477+ 86C1              ;
1478+ 86C1              ; Input:
1479+ 86C1              ;   B = Row (3..18)
1480+ 86C1              ;   C = Col (0..31)
1481+ 86C1              ;
1482+ 86C1              ; Utilizza:
1483+ 86C1              ;   room_ptr -> struttura dati della stanza corrente
1484+ 86C1              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1485+ 86C1              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1486+ 86C1              ;
1487+ 86C1              ; Tipi di cella:
1488+ 86C1              ;   0 = Background
1489+ 86C1              ;   1 = Floor
1490+ 86C1              ;   2 = Wall
1491+ 86C1              ;   3 = Nasty
1492+ 86C1              ; -------------------------------------------------------------------
1493+ 86C1              RestoreBackgroundCell:
1494+ 86C1
1495+ 86C1                  ; Salva tutti i registri utilizzati
1496+ 86C1 FD E5            push iy
1497+ 86C3 C5               push bc
1498+ 86C4 D5               push de
1499+ 86C5 E5               push hl
1500+ 86C6 DD E5            push ix
1501+ 86C8
1502+ 86C8                  ; ---------------------------------------------------------------
1503+ 86C8                  ; Conserva Row e Col in IY.
1504+ 86C8                  ;
1505+ 86C8                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1506+ 86C8                  ; BC potrebbe essere modificato.
1507+ 86C8                  ; ---------------------------------------------------------------
1508+ 86C8 C5               push bc
1509+ 86C9 FD E1            pop  iy                ; IYH = Row, IYL = Col
1510+ 86CB
1511+ 86CB                  ; ---------------------------------------------------------------
1512+ 86CB                  ; Determina quale tipo di cella è presente nella posizione
1513+ 86CB                  ; specificata.
1514+ 86CB                  ;
1515+ 86CB                  ; Input:
1516+ 86CB                  ;   B = Row
1517+ 86CB                  ;   C = Col
1518+ 86CB                  ;
1519+ 86CB                  ; Output:
1520+ 86CB                  ;   A = tipo cella
1521+ 86CB                  ; ---------------------------------------------------------------
1522+ 86CB 78               ld   a, b
1523+ 86CC
1524+ 86CC CD 8E 77         call GetCellFromUnpacked
1525+ 86CF
1526+ 86CF                  ; ---------------------------------------------------------------
1527+ 86CF                  ; Recupera il puntatore alla stanza corrente.
1528+ 86CF                  ;
1529+ 86CF                  ; DE = base della struttura stanza
1530+ 86CF                  ; ---------------------------------------------------------------
1531+ 86CF ED 5B AF F6      ld   de, (room_ptr)
1532+ 86D3
1533+ 86D3                  ; ---------------------------------------------------------------
1534+ 86D3                  ; Seleziona il tile corretto in base al tipo di cella.
1535+ 86D3                  ;
1536+ 86D3                  ; A = 0 -> Background
1537+ 86D3                  ; A = 1 -> Floor
1538+ 86D3                  ; A = 2 -> Wall
1539+ 86D3                  ; A = 3 -> Nasty
1540+ 86D3                  ; ---------------------------------------------------------------
1541+ 86D3
1542+ 86D3 B7               or   a
1543+ 86D4 20 06            jr   nz, .not_bg
1544+ 86D6
1545+ 86D6                  ; Background
1546+ 86D6 21 A0 00         ld   hl, OFFSET_BG
1547+ 86D9 19               add  hl, de
1548+ 86DA 18 16            jr   .draw_cell
1549+ 86DC
1550+ 86DC              .not_bg:
1551+ 86DC
1552+ 86DC 3D               dec  a
1553+ 86DD 20 06            jr   nz, .not_floor
1554+ 86DF
1555+ 86DF                  ; Floor
1556+ 86DF 21 A9 00         ld   hl, OFFSET_FLOOR
1557+ 86E2 19               add  hl, de
1558+ 86E3 18 0D            jr   .draw_cell
1559+ 86E5
1560+ 86E5              .not_floor:
1561+ 86E5
1562+ 86E5 3D               dec  a
1563+ 86E6 20 06            jr   nz, .not_wall
1564+ 86E8
1565+ 86E8                  ; Wall
1566+ 86E8 21 B2 00         ld   hl, OFFSET_WALL
1567+ 86EB 19               add  hl, de
1568+ 86EC 18 04            jr   .draw_cell
1569+ 86EE
1570+ 86EE              .not_wall:
1571+ 86EE
1572+ 86EE                  ; Nasty
1573+ 86EE 21 BB 00         ld   hl, OFFSET_NASTY
1574+ 86F1 19               add  hl, de
1575+ 86F2
1576+ 86F2              .draw_cell:
1577+ 86F2
1578+ 86F2                  ; ---------------------------------------------------------------
1579+ 86F2                  ; HL punta ora alla grafica del tile da ridisegnare.
1580+ 86F2                  ;
1581+ 86F2                  ; Gfx_DrawTile si aspetta:
1582+ 86F2                  ;   IX = puntatore tile
1583+ 86F2                  ;   B  = Row
1584+ 86F2                  ;   C  = Col
1585+ 86F2                  ; ---------------------------------------------------------------
1586+ 86F2 E5               push hl
1587+ 86F3 DD E1            pop  ix
1588+ 86F5
1589+ 86F5                  ; Ripristina Row e Col salvati in IY
1590+ 86F5 FD E5            push iy
1591+ 86F7 C1               pop  bc
1592+ 86F8
1593+ 86F8                  ; Disegna il tile originale
1594+ 86F8 CD 5D 6A         call Gfx_DrawTile
1595+ 86FB
1596+ 86FB                  ; ---------------------------------------------------------------
1597+ 86FB                  ; Ripristina i registri salvati
1598+ 86FB                  ; ---------------------------------------------------------------
1599+ 86FB DD E1            pop  ix
1600+ 86FD E1               pop  hl
1601+ 86FE D1               pop  de
1602+ 86FF C1               pop  bc
1603+ 8700 FD E1            pop  iy
1604+ 8702
1605+ 8702 C9               ret
1606+ 8703
1607+ 8703              ; -------------------------------------------------------------------
1608+ 8703              ; CheckWillyItemCollision
1609+ 8703              ;
1610+ 8703              ; Verifica se Willy collide con un item utilizzando il controllo
1611+ 8703              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1612+ 8703              ;
1613+ 8703              ; Input:
1614+ 8703              ;   A = ItemX (colonna attributi 0..31)
1615+ 8703              ;   H = ItemY (riga attributi 3..18)
1616+ 8703              ;
1617+ 8703              ; Coordinate item:
1618+ 8703              ;   Ogni item occupa una cella da 8x8 pixel.
1619+ 8703              ;
1620+ 8703              ; Coordinate Willy:
1621+ 8703              ;   Willy occupa un rettangolo di 16x16 pixel.
1622+ 8703              ;
1623+ 8703              ; Output:
1624+ 8703              ;   Carry Set   = collisione rilevata
1625+ 8703              ;   Carry Clear = nessuna collisione
1626+ 8703              ;
1627+ 8703              ; Registri preservati:
1628+ 8703              ;   BC, DE, HL
1629+ 8703              ; -------------------------------------------------------------------
1630+ 8703              CheckWillyItemCollision:
1631+ 8703
1632+ 8703                  ; Salva i registri utilizzati
1633+ 8703 C5               push bc
1634+ 8704 D5               push de
1635+ 8705 E5               push hl
1636+ 8706
1637+ 8706                  ; ---------------------------------------------------------------
1638+ 8706                  ; Calcola il bounding box orizzontale dell'item
1639+ 8706                  ;
1640+ 8706                  ; ItemLeft  = ItemX * 8
1641+ 8706                  ; ItemRight = ItemLeft + 7
1642+ 8706                  ;
1643+ 8706                  ; E = ItemLeft
1644+ 8706                  ; D = ItemRight
1645+ 8706                  ; ---------------------------------------------------------------
1646+ 8706 6F               ld   l, a              ; L = ItemX
1647+ 8707
1648+ 8707 7D               ld   a, l
1649+ 8708 87               add  a, a              ; *2
1650+ 8709 87               add  a, a              ; *4
1651+ 870A 87               add  a, a              ; *8
1652+ 870B
1653+ 870B 5F               ld   e, a              ; E = ItemLeft
1654+ 870C
1655+ 870C C6 07            add  a, 7
1656+ 870E 57               ld   d, a              ; D = ItemRight
1657+ 870F
1658+ 870F                  ; ---------------------------------------------------------------
1659+ 870F                  ; Recupera la posizione corrente di Willy
1660+ 870F                  ;
1661+ 870F                  ; B = WillyY
1662+ 870F                  ; C = WillyX
1663+ 870F                  ; ---------------------------------------------------------------
1664+ 870F ED 4B 2F F3      ld   bc, (PlayerPos)
1665+ 8713
1666+ 8713                  ; ---------------------------------------------------------------
1667+ 8713                  ; Primo test:
1668+ 8713                  ;
1669+ 8713                  ; WillyLeft <= ItemRight
1670+ 8713                  ;
1671+ 8713                  ; Se Willy è completamente a destra dell'item
1672+ 8713                  ; non può esserci collisione.
1673+ 8713                  ; ---------------------------------------------------------------
1674+ 8713 79               ld   a, c              ; A = WillyLeft
1675+ 8714
1676+ 8714 BA               cp   d                 ; WillyLeft vs ItemRight
1677+ 8715
1678+ 8715 28 04            jr   z, .x_ok
1679+ 8717 38 02            jr   c, .x_ok
1680+ 8719
1681+ 8719 18 29            jr   .no_collision
1682+ 871B
1683+ 871B              .x_ok:
1684+ 871B
1685+ 871B                  ; ---------------------------------------------------------------
1686+ 871B                  ; Secondo test:
1687+ 871B                  ;
1688+ 871B                  ; WillyRight >= ItemLeft
1689+ 871B                  ;
1690+ 871B                  ; WillyRight = WillyX + 7
1691+ 871B                  ; ---------------------------------------------------------------
1692+ 871B C6 07            add  a, 7
1693+ 871D
1694+ 871D BB               cp   e                 ; WillyRight vs ItemLeft
1695+ 871E
1696+ 871E 28 04            jr   z, .y_check
1697+ 8720 30 02            jr   nc, .y_check
1698+ 8722
1699+ 8722 18 20            jr   .no_collision
1700+ 8724
1701+ 8724              .y_check:
1702+ 8724
1703+ 8724                  ; ---------------------------------------------------------------
1704+ 8724                  ; Recupera ItemY dal valore originale di HL
1705+ 8724                  ;
1706+ 8724                  ; H contiene la riga dell'item.
1707+ 8724                  ; ---------------------------------------------------------------
1708+ 8724 E1               pop  hl
1709+ 8725 E5               push hl
1710+ 8726
1711+ 8726                  ; ---------------------------------------------------------------
1712+ 8726                  ; Calcola il bounding box verticale dell'item
1713+ 8726                  ;
1714+ 8726                  ; ItemTop    = ItemY * 8
1715+ 8726                  ; ItemBottom = ItemTop + 7
1716+ 8726                  ;
1717+ 8726                  ; E = ItemTop
1718+ 8726                  ; D = ItemBottom
1719+ 8726                  ; ---------------------------------------------------------------
1720+ 8726 7C               ld   a, h
1721+ 8727
1722+ 8727 87               add  a, a              ; *2
1723+ 8728 87               add  a, a              ; *4
1724+ 8729 87               add  a, a              ; *8
1725+ 872A
1726+ 872A 5F               ld   e, a              ; ItemTop
1727+ 872B
1728+ 872B C6 07            add  a, 7
1729+ 872D 57               ld   d, a              ; ItemBottom
1730+ 872E
1731+ 872E                  ; ---------------------------------------------------------------
1732+ 872E                  ; Primo test verticale:
1733+ 872E                  ;
1734+ 872E                  ; WillyTop <= ItemBottom
1735+ 872E                  ; ---------------------------------------------------------------
1736+ 872E 78               ld   a, b              ; WillyTop
1737+ 872F
1738+ 872F BA               cp   d
1739+ 8730
1740+ 8730 28 04            jr   z, .y_ok
1741+ 8732 38 02            jr   c, .y_ok
1742+ 8734
1743+ 8734 18 0E            jr   .no_collision
1744+ 8736
1745+ 8736              .y_ok:
1746+ 8736
1747+ 8736                  ; ---------------------------------------------------------------
1748+ 8736                  ; Secondo test verticale:
1749+ 8736                  ;
1750+ 8736                  ; WillyBottom >= ItemTop
1751+ 8736                  ;
1752+ 8736                  ; WillyBottom = WillyY + 15
1753+ 8736                  ; ---------------------------------------------------------------
1754+ 8736 C6 0F            add  a, 15
1755+ 8738
1756+ 8738 BB               cp   e
1757+ 8739
1758+ 8739 28 04            jr   z, .collision
1759+ 873B 30 02            jr   nc, .collision
1760+ 873D
1761+ 873D 18 05            jr   .no_collision
1762+ 873F
1763+ 873F              .collision:
1764+ 873F
1765+ 873F                  ; ---------------------------------------------------------------
1766+ 873F                  ; Collisione rilevata
1767+ 873F                  ; ---------------------------------------------------------------
1768+ 873F E1               pop  hl
1769+ 8740 D1               pop  de
1770+ 8741 C1               pop  bc
1771+ 8742
1772+ 8742 37               scf                    ; Carry = 1
1773+ 8743
1774+ 8743 C9               ret
1775+ 8744
1776+ 8744              .no_collision:
1777+ 8744
1778+ 8744                  ; ---------------------------------------------------------------
1779+ 8744                  ; Nessuna collisione
1780+ 8744                  ; ---------------------------------------------------------------
1781+ 8744 E1               pop  hl
1782+ 8745 D1               pop  de
1783+ 8746 C1               pop  bc
1784+ 8747
1785+ 8747 B7               or   a                 ; Carry = 0
1786+ 8748
1787+ 8748 C9               ret
1788+ 8749
1789+ 8749              ; -------------------------------------------------------------------
1790+ 8749              ; Items_CheckCollision
1791+ 8749              ;
1792+ 8749              ; Controlla se Willy entra in collisione con uno degli item
1793+ 8749              ; attivi presenti nella stanza corrente.
1794+ 8749              ;
1795+ 8749              ; Per ogni item:
1796+ 8749              ;   - verifica che appartenga alla stanza corrente
1797+ 8749              ;   - verifica che non sia già stato raccolto
1798+ 8749              ;   - esegue il test di collisione con Willy
1799+ 8749              ;
1800+ 8749              ; Se l'item viene raccolto:
1801+ 8749              ;   - imposta il flag "collected"
1802+ 8749              ;   - rimuove l'item dalla cache items_grid
1803+ 8749              ;   - incrementa il contatore degli oggetti raccolti
1804+ 8749              ;   - aggiorna l'HUD
1805+ 8749              ;   - ripristina il tile di sfondo
1806+ 8749              ;   - riproduce il suono di raccolta
1807+ 8749              ;
1808+ 8749              ; Formato record ItemsTable:
1809+ 8749              ;   +0 RoomID
1810+ 8749              ;   +1 X
1811+ 8749              ;   +2 Y
1812+ 8749              ;   +3 Color
1813+ 8749              ;   +4 Collected
1814+ 8749              ;
1815+ 8749              ; Fine tabella:
1816+ 8749              ;   RoomID = $FF
1817+ 8749              ; -------------------------------------------------------------------
1818+ 8749              Items_CheckCollision:
1819+ 8749
1820+ 8749                  ; Salva i registri utilizzati
1821+ 8749 E5               push hl
1822+ 874A D5               push de
1823+ 874B C5               push bc
1824+ 874C
1825+ 874C                  ; Inizio scansione della tabella degli item
1826+ 874C 21 94 80         ld   hl, ItemsTable
1827+ 874F
1828+ 874F              .loop:
1829+ 874F
1830+ 874F                  ; ---------------------------------------------------------------
1831+ 874F                  ; Legge il Room ID dell'item corrente
1832+ 874F                  ; ---------------------------------------------------------------
1833+ 874F 7E               ld   a, (hl)
1834+ 8750
1835+ 8750                  ; $FF indica fine tabella
1836+ 8750 FE FF            cp   $FF
1837+ 8752 28 58            jr   z, .done
1838+ 8754
1839+ 8754                  ; ---------------------------------------------------------------
1840+ 8754                  ; Verifica se l'item appartiene alla stanza corrente
1841+ 8754                  ; ---------------------------------------------------------------
1842+ 8754 57               ld   d, a              ; D = RoomID item
1843+ 8755
1844+ 8755 3A 55 F6         ld   a, (current_room)
1845+ 8758 BA               cp   d
1846+ 8759
1847+ 8759                  ; Se appartiene a un'altra stanza salta il record
1848+ 8759 20 4A            jr   nz, .next_item
1849+ 875B
1850+ 875B                  ; ---------------------------------------------------------------
1851+ 875B                  ; Legge coordinate e stato dell'item
1852+ 875B                  ; ---------------------------------------------------------------
1853+ 875B
1854+ 875B 23               inc  hl
1855+ 875C 4E               ld   c, (hl)           ; C = X
1856+ 875D
1857+ 875D 23               inc  hl
1858+ 875E 46               ld   b, (hl)           ; B = Y
1859+ 875F
1860+ 875F 23               inc  hl                ; salta Color
1861+ 8760
1862+ 8760 23               inc  hl                ; punta a Collected
1863+ 8761
1864+ 8761 7E               ld   a, (hl)
1865+ 8762
1866+ 8762                  ; ---------------------------------------------------------------
1867+ 8762                  ; Item già raccolto?
1868+ 8762                  ; ---------------------------------------------------------------
1869+ 8762 B7               or   a
1870+ 8763 20 44            jr   nz, .next_no_inc
1871+ 8765
1872+ 8765                  ; ---------------------------------------------------------------
1873+ 8765                  ; Test collisione Willy ↔ Item
1874+ 8765                  ;
1875+ 8765                  ; Input richiesto:
1876+ 8765                  ;   A = ItemX
1877+ 8765                  ;   H = ItemY
1878+ 8765                  ; ---------------------------------------------------------------
1879+ 8765 79               ld   a, c
1880+ 8766
1881+ 8766 E5               push hl                ; salva puntatore al flag Collected
1882+ 8767
1883+ 8767 60               ld   h, b
1884+ 8768
1885+ 8768 CD 03 87         call CheckWillyItemCollision
1886+ 876B
1887+ 876B E1               pop  hl
1888+ 876C
1889+ 876C                  ; Nessuna collisione
1890+ 876C 30 3B            jr   nc, .next_no_inc
1891+ 876E
1892+ 876E                  ; ===============================================================
1893+ 876E                  ; ITEM RACCOLTO
1894+ 876E                  ; ===============================================================
