 346  86E0              ; TriggerGameOver
 347  86E0              ; Scatena la schermata di Game Over per la stanza corrente.
 348  86E0              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 349  86E0              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 350  86E0              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 351  86E0              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 352  86E0              ; - Premendo ENTER, riporta il giocatore alla schermata iniziale (Title Screen).
 353  86E0              ; -------------------------------------------------------------------
 354  86E0              TriggerGameOver:
 355  86E0                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede e della scritta GAME OVER
 356  86E0 CD 0F 64         call Gfx_DrawGameOverScreen
 357  86E3
 358  86E3                  ; 2. Attende il rilascio del tasto ENTER se era già premuto
 359  86E3              .wait_enter_release:
 360  86E3 76               halt
 361  86E4 3E BF            ld   a, $bf
 362  86E6 DB FE            in   a, ($fe)
 363  86E8 1F               rra
 364  86E9 30 F8            jr   nc, .wait_enter_release
 365  86EB
 366  86EB                  ; 3. Attesa della pressione del tasto ENTER con animazione ciclo colore su GAME OVER (Riga 5, Col 11)
 367  86EB 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 368  86ED              .wait_enter_press:
 369  86ED 76               halt
 370  86EE
 371  86EE                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 372  86EE 0C               inc  c
 373  86EF 79               ld   a, c
 374  86F0 CB 3F            srl  a
 375  86F2 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 376  86F4 E6 07            and  7
 377  86F6 5F               ld   e, a
 378  86F7 16 00            ld   d, 0
 379  86F9 21 07 64         ld   hl, game_over_color_table
 380  86FC 19               add  hl, de
 381  86FD 7E               ld   a, (hl)               ; A = nuovo colore attributo
 382  86FE 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 383  8701 06 09            ld   b, 9
