 484+ 6E38                  ; Controlla il tasso di aggiornamento dei nemici (speed divider)
 485+ 6E38 3A C7 75         ld   a, (enemy_update_rate)
 486+ 6E3B FE 01            cp   1
 487+ 6E3D 28 1D            jr   z, .do_update             ; Se 1, aggiorna ad ogni frame (velocità normale)
 488+ 6E3F
 489+ 6E3F 3A C8 75         ld   a, (enemy_update_timer)
 490+ 6E42 3C               inc  a
 491+ 6E43 47               ld   b, a                      ; B = timer + 1
 492+ 6E44 3A C7 75         ld   a, (enemy_update_rate)
 493+ 6E47 B8               cp   b
 494+ 6E48 28 0C            jr   z, .reset_timer
 495+ 6E4A 38 0A            jr   c, .reset_timer
 496+ 6E4C
 497+ 6E4C                  ; Salva contatore incrementato e salta l'aggiornamento
 498+ 6E4C 78               ld   a, b
 499+ 6E4D 32 C8 75         ld   (enemy_update_timer), a
 500+ 6E50
 501+ 6E50              .skip_update:
 502+ 6E50 DD E1            pop  ix
 503+ 6E52 C1               pop  bc
 504+ 6E53 D1               pop  de
 505+ 6E54 E1               pop  hl
 506+ 6E55 C9               ret
 507+ 6E56
 508+ 6E56              .reset_timer:
 509+ 6E56 AF               xor  a
 510+ 6E57 32 C8 75         ld   (enemy_update_timer), a
 511+ 6E5A 18 00            jr   .do_update
 512+ 6E5C
 513+ 6E5C              .do_update:
 514+ 6E5C DD 21 9C 6B      ld   ix, ActiveEnemies
 515+ 6E60 06 08            ld   b, 8              ; 8 slot
 516+ 6E62              .loop:
 517+ 6E62 DD 7E 00         ld   a, (ix+0)         ; Flags
 518+ 6E65 E6 80            and  $80               ; Active?
 519+ 6E67 CA 12 6F         jp   z, .next
 520+ 6E6A
 521+ 6E6A                  ; 1. Salva la posizione corrente in Old X/Y per la cancellazione nel prossimo frame
 522+ 6E6A DD 7E 01         ld   a, (ix+1)
 523+ 6E6D DD 77 07         ld   (ix+7), a         ; Old X = Current X
 524+ 6E70 DD 7E 02         ld   a, (ix+2)
 525+ 6E73 DD 77 08         ld   (ix+8), a         ; Old Y = Current Y
 526+ 6E76
 527+ 6E76                  ; 2. Aggiorna Anim State
 528+ 6E76 DD 7E 06         ld   a, (ix+6)         ; Anim State (0..3)
 529+ 6E79 3C               inc  a
 530+ 6E7A E6 03            and  3                 ; Alterna 0..3
 531+ 6E7C DD 77 06         ld   (ix+6), a
 532+ 6E7F
 533+ 6E7F                  ; 3. Determina se orizzontale o verticale
 534+ 6E7F DD 7E 00         ld   a, (ix+0)         ; Flags
 535+ 6E82 E6 40            and  $40               ; Vertical? (Bit 6)
 536+ 6E84 C2 CE 6E         jp   nz, .vertical
