  58+ 6BB0 AF               xor  a
  59+ 6BB1 32 30 EA         ld   (q_prev), a            ; Q rilasciato → azzera debounce
  60+ 6BB4
  61+ 6BB4              .q_handled:
  62+ 6BB4
  63+ 6BB4                  ; ── Sezione 1b: tasto A (cambio stanza INDIETRO) ────────────────────
  64+ 6BB4                  ;
  65+ 6BB4                  ; Porta $FD → riga A, S, D, F, G. Bit 0 = A.
  66+ 6BB4                  ; Se bit 0 = 0, A è premuto.
  67+ 6BB4
  68+ 6BB4 01 FE FD         ld   bc, $fdfe
  69+ 6BB7 ED 78            in   a, (c)
  70+ 6BB9 CB 47            bit  0, a
  71+ 6BBB 20 0F            jr   nz, .a_not_pressed     ; bit 0 = 1 → A non premuto, salta
  72+ 6BBD
  73+ 6BBD                  ; A è premuto: debounce tramite (a_prev).
  74+ 6BBD 3A 31 EA         ld   a, (a_prev)
  75+ 6BC0 B7               or   a
  76+ 6BC1 20 0D            jr   nz, .a_handled         ; era già premuto, niente da fare
  77+ 6BC3
  78+ 6BC3                  ; ── Primo frame di pressione di A ──
  79+ 6BC3 3E 01            ld   a, 1
  80+ 6BC5 32 31 EA         ld   (a_prev), a            ; marca "A era premuto"
  81+ 6BC8
  82+ 6BC8 E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  83+ 6BC9 C3 63 6C         jp   PerformRoomChangePrev  ; salta al cambio stanza indietro (non torna qui)
  84+ 6BCC
  85+ 6BCC              .a_not_pressed:
  86+ 6BCC AF               xor  a
  87+ 6BCD 32 31 EA         ld   (a_prev), a            ; A rilasciato → azzera debounce
  88+ 6BD0
  89+ 6BD0              .a_handled:
  90+ 6BD0 CD C4 6C         call Input_CheckWarpKeys
  91+ 6BD3                  ENDIF
