1470+ 872A              ; -------------------------------------------------------------------
1471+ 872A              ; RestoreBackgroundCell
1472+ 872A              ;
1473+ 872A              ; Ripristina il contenuto originale di una cella della stanza.
1474+ 872A              ; Viene utilizzata principalmente quando un item viene raccolto:
1475+ 872A              ; invece di lasciare un "buco", la routine ridisegna il tile
1476+ 872A              ; originale presente nella mappa della stanza.
1477+ 872A              ;
1478+ 872A              ; Input:
1479+ 872A              ;   B = Row (3..18)
1480+ 872A              ;   C = Col (0..31)
1481+ 872A              ;
1482+ 872A              ; Utilizza:
1483+ 872A              ;   room_ptr -> struttura dati della stanza corrente
1484+ 872A              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1485+ 872A              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1486+ 872A              ;
1487+ 872A              ; Tipi di cella:
1488+ 872A              ;   0 = Background
1489+ 872A              ;   1 = Floor
1490+ 872A              ;   2 = Wall
1491+ 872A              ;   3 = Nasty
1492+ 872A              ; -------------------------------------------------------------------
1493+ 872A              RestoreBackgroundCell:
1494+ 872A
1495+ 872A                  ; Salva tutti i registri utilizzati
1496+ 872A FD E5            push iy
1497+ 872C C5               push bc
1498+ 872D D5               push de
1499+ 872E E5               push hl
1500+ 872F DD E5            push ix
1501+ 8731
1502+ 8731                  ; ---------------------------------------------------------------
1503+ 8731                  ; Conserva Row e Col in IY.
1504+ 8731                  ;
1505+ 8731                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1506+ 8731                  ; BC potrebbe essere modificato.
1507+ 8731                  ; ---------------------------------------------------------------
1508+ 8731 C5               push bc
1509+ 8732 FD E1            pop  iy                ; IYH = Row, IYL = Col
1510+ 8734
1511+ 8734                  ; ---------------------------------------------------------------
1512+ 8734                  ; Determina quale tipo di cella è presente nella posizione
1513+ 8734                  ; specificata.
1514+ 8734                  ;
1515+ 8734                  ; Input:
1516+ 8734                  ;   B = Row
1517+ 8734                  ;   C = Col
1518+ 8734                  ;
1519+ 8734                  ; Output:
1520+ 8734                  ;   A = tipo cella
1521+ 8734                  ; ---------------------------------------------------------------
1522+ 8734 78               ld   a, b
1523+ 8735
1524+ 8735 CD 90 77         call GetCellFromUnpacked
1525+ 8738
1526+ 8738                  ; ---------------------------------------------------------------
1527+ 8738                  ; Recupera il puntatore alla stanza corrente.
1528+ 8738                  ;
1529+ 8738                  ; DE = base della struttura stanza
1530+ 8738                  ; ---------------------------------------------------------------
1531+ 8738 ED 5B 85 FB      ld   de, (room_ptr)
1532+ 873C
1533+ 873C                  ; ---------------------------------------------------------------
1534+ 873C                  ; Seleziona il tile corretto in base al tipo di cella.
1535+ 873C                  ;
1536+ 873C                  ; A = 0 -> Background
1537+ 873C                  ; A = 1 -> Floor
1538+ 873C                  ; A = 2 -> Wall
1539+ 873C                  ; A = 3 -> Nasty
1540+ 873C                  ; ---------------------------------------------------------------
1541+ 873C
1542+ 873C B7               or   a
1543+ 873D 20 06            jr   nz, .not_bg
1544+ 873F
1545+ 873F                  ; Background
1546+ 873F 21 A0 00         ld   hl, OFFSET_BG
1547+ 8742 19               add  hl, de
1548+ 8743 18 16            jr   .draw_cell
1549+ 8745
1550+ 8745              .not_bg:
1551+ 8745
1552+ 8745 3D               dec  a
1553+ 8746 20 06            jr   nz, .not_floor
1554+ 8748
1555+ 8748                  ; Floor
1556+ 8748 21 A9 00         ld   hl, OFFSET_FLOOR
1557+ 874B 19               add  hl, de
1558+ 874C 18 0D            jr   .draw_cell
1559+ 874E
1560+ 874E              .not_floor:
1561+ 874E
1562+ 874E 3D               dec  a
1563+ 874F 20 06            jr   nz, .not_wall
1564+ 8751
1565+ 8751                  ; Wall
1566+ 8751 21 B2 00         ld   hl, OFFSET_WALL
1567+ 8754 19               add  hl, de
1568+ 8755 18 04            jr   .draw_cell
1569+ 8757
1570+ 8757              .not_wall:
1571+ 8757
1572+ 8757                  ; Nasty
1573+ 8757 21 BB 00         ld   hl, OFFSET_NASTY
1574+ 875A 19               add  hl, de
1575+ 875B
1576+ 875B              .draw_cell:
1577+ 875B
1578+ 875B                  ; ---------------------------------------------------------------
1579+ 875B                  ; HL punta ora alla grafica del tile da ridisegnare.
1580+ 875B                  ;
1581+ 875B                  ; Gfx_DrawTile si aspetta:
1582+ 875B                  ;   IX = puntatore tile
1583+ 875B                  ;   B  = Row
1584+ 875B                  ;   C  = Col
1585+ 875B                  ; ---------------------------------------------------------------
1586+ 875B E5               push hl
1587+ 875C DD E1            pop  ix
1588+ 875E
1589+ 875E                  ; Ripristina Row e Col salvati in IY
1590+ 875E FD E5            push iy
1591+ 8760 C1               pop  bc
1592+ 8761
1593+ 8761                  ; Disegna il tile originale
1594+ 8761 CD 5F 6A         call Gfx_DrawTile
1595+ 8764
1596+ 8764                  ; ---------------------------------------------------------------
1597+ 8764                  ; Ripristina i registri salvati
1598+ 8764                  ; ---------------------------------------------------------------
1599+ 8764 DD E1            pop  ix
1600+ 8766 E1               pop  hl
1601+ 8767 D1               pop  de
1602+ 8768 C1               pop  bc
1603+ 8769 FD E1            pop  iy
1604+ 876B
1605+ 876B C9               ret
1606+ 876C
1607+ 876C              ; -------------------------------------------------------------------
1608+ 876C              ; CheckWillyItemCollision
1609+ 876C              ;
1610+ 876C              ; Verifica se Willy collide con un item utilizzando il controllo
1611+ 876C              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1612+ 876C              ;
1613+ 876C              ; Input:
1614+ 876C              ;   A = ItemX (colonna attributi 0..31)
1615+ 876C              ;   H = ItemY (riga attributi 3..18)
1616+ 876C              ;
1617+ 876C              ; Coordinate item:
1618+ 876C              ;   Ogni item occupa una cella da 8x8 pixel.
1619+ 876C              ;
1620+ 876C              ; Coordinate Willy:
1621+ 876C              ;   Willy occupa un rettangolo di 16x16 pixel.
1622+ 876C              ;
1623+ 876C              ; Output:
1624+ 876C              ;   Carry Set   = collisione rilevata
1625+ 876C              ;   Carry Clear = nessuna collisione
1626+ 876C              ;
1627+ 876C              ; Registri preservati:
1628+ 876C              ;   BC, DE, HL
1629+ 876C              ; -------------------------------------------------------------------
1630+ 876C              CheckWillyItemCollision:
1631+ 876C
1632+ 876C                  ; Salva i registri utilizzati
1633+ 876C C5               push bc
1634+ 876D D5               push de
1635+ 876E E5               push hl
1636+ 876F
1637+ 876F                  ; ---------------------------------------------------------------
1638+ 876F                  ; Calcola il bounding box orizzontale dell'item
1639+ 876F                  ;
1640+ 876F                  ; ItemLeft  = ItemX * 8
1641+ 876F                  ; ItemRight = ItemLeft + 7
1642+ 876F                  ;
1643+ 876F                  ; E = ItemLeft
1644+ 876F                  ; D = ItemRight
1645+ 876F                  ; ---------------------------------------------------------------
1646+ 876F 6F               ld   l, a              ; L = ItemX
1647+ 8770
1648+ 8770 7D               ld   a, l
1649+ 8771 87               add  a, a              ; *2
1650+ 8772 87               add  a, a              ; *4
1651+ 8773 87               add  a, a              ; *8
1652+ 8774
1653+ 8774 5F               ld   e, a              ; E = ItemLeft
1654+ 8775
1655+ 8775 C6 07            add  a, 7
1656+ 8777 57               ld   d, a              ; D = ItemRight
1657+ 8778
1658+ 8778                  ; ---------------------------------------------------------------
1659+ 8778                  ; Recupera la posizione corrente di Willy
1660+ 8778                  ;
1661+ 8778                  ; B = WillyY
1662+ 8778                  ; C = WillyX
1663+ 8778                  ; ---------------------------------------------------------------
1664+ 8778 ED 4B 05 F8      ld   bc, (PlayerPos)
1665+ 877C
1666+ 877C                  ; ---------------------------------------------------------------
1667+ 877C                  ; Primo test:
1668+ 877C                  ;
1669+ 877C                  ; WillyLeft <= ItemRight
1670+ 877C                  ;
1671+ 877C                  ; Se Willy è completamente a destra dell'item
1672+ 877C                  ; non può esserci collisione.
1673+ 877C                  ; ---------------------------------------------------------------
1674+ 877C 79               ld   a, c              ; A = WillyLeft
1675+ 877D
1676+ 877D BA               cp   d                 ; WillyLeft vs ItemRight
1677+ 877E
1678+ 877E 28 04            jr   z, .x_ok
1679+ 8780 38 02            jr   c, .x_ok
1680+ 8782
1681+ 8782 18 29            jr   .no_collision
1682+ 8784
1683+ 8784              .x_ok:
1684+ 8784
1685+ 8784                  ; ---------------------------------------------------------------
1686+ 8784                  ; Secondo test:
1687+ 8784                  ;
1688+ 8784                  ; WillyRight >= ItemLeft
1689+ 8784                  ;
1690+ 8784                  ; WillyRight = WillyX + 7
1691+ 8784                  ; ---------------------------------------------------------------
1692+ 8784 C6 07            add  a, 7
1693+ 8786
1694+ 8786 BB               cp   e                 ; WillyRight vs ItemLeft
1695+ 8787
1696+ 8787 28 04            jr   z, .y_check
1697+ 8789 30 02            jr   nc, .y_check
1698+ 878B
1699+ 878B 18 20            jr   .no_collision
1700+ 878D
1701+ 878D              .y_check:
1702+ 878D
1703+ 878D                  ; ---------------------------------------------------------------
1704+ 878D                  ; Recupera ItemY dal valore originale di HL
1705+ 878D                  ;
1706+ 878D                  ; H contiene la riga dell'item.
1707+ 878D                  ; ---------------------------------------------------------------
1708+ 878D E1               pop  hl
1709+ 878E E5               push hl
1710+ 878F
1711+ 878F                  ; ---------------------------------------------------------------
1712+ 878F                  ; Calcola il bounding box verticale dell'item
1713+ 878F                  ;
1714+ 878F                  ; ItemTop    = ItemY * 8
1715+ 878F                  ; ItemBottom = ItemTop + 7
1716+ 878F                  ;
1717+ 878F                  ; E = ItemTop
1718+ 878F                  ; D = ItemBottom
1719+ 878F                  ; ---------------------------------------------------------------
1720+ 878F 7C               ld   a, h
1721+ 8790
1722+ 8790 87               add  a, a              ; *2
1723+ 8791 87               add  a, a              ; *4
1724+ 8792 87               add  a, a              ; *8
1725+ 8793
1726+ 8793 5F               ld   e, a              ; ItemTop
1727+ 8794
1728+ 8794 C6 07            add  a, 7
1729+ 8796 57               ld   d, a              ; ItemBottom
1730+ 8797
1731+ 8797                  ; ---------------------------------------------------------------
1732+ 8797                  ; Primo test verticale:
1733+ 8797                  ;
1734+ 8797                  ; WillyTop <= ItemBottom
1735+ 8797                  ; ---------------------------------------------------------------
1736+ 8797 78               ld   a, b              ; WillyTop
1737+ 8798
1738+ 8798 BA               cp   d
1739+ 8799
1740+ 8799 28 04            jr   z, .y_ok
1741+ 879B 38 02            jr   c, .y_ok
1742+ 879D
1743+ 879D 18 0E            jr   .no_collision
1744+ 879F
1745+ 879F              .y_ok:
1746+ 879F
1747+ 879F                  ; ---------------------------------------------------------------
1748+ 879F                  ; Secondo test verticale:
1749+ 879F                  ;
1750+ 879F                  ; WillyBottom >= ItemTop
1751+ 879F                  ;
1752+ 879F                  ; WillyBottom = WillyY + 15
1753+ 879F                  ; ---------------------------------------------------------------
1754+ 879F C6 0F            add  a, 15
1755+ 87A1
1756+ 87A1 BB               cp   e
1757+ 87A2
1758+ 87A2 28 04            jr   z, .collision
1759+ 87A4 30 02            jr   nc, .collision
1760+ 87A6
1761+ 87A6 18 05            jr   .no_collision
1762+ 87A8
1763+ 87A8              .collision:
1764+ 87A8
1765+ 87A8                  ; ---------------------------------------------------------------
1766+ 87A8                  ; Collisione rilevata
1767+ 87A8                  ; ---------------------------------------------------------------
1768+ 87A8 E1               pop  hl
1769+ 87A9 D1               pop  de
1770+ 87AA C1               pop  bc
1771+ 87AB
1772+ 87AB 37               scf                    ; Carry = 1
1773+ 87AC
1774+ 87AC C9               ret
1775+ 87AD
1776+ 87AD              .no_collision:
1777+ 87AD
1778+ 87AD                  ; ---------------------------------------------------------------
1779+ 87AD                  ; Nessuna collisione
1780+ 87AD                  ; ---------------------------------------------------------------
1781+ 87AD E1               pop  hl
1782+ 87AE D1               pop  de
1783+ 87AF C1               pop  bc
1784+ 87B0
1785+ 87B0 B7               or   a                 ; Carry = 0
1786+ 87B1
1787+ 87B1 C9               ret
1788+ 87B2
1789+ 87B2              ; -------------------------------------------------------------------
1790+ 87B2              ; Items_CheckCollision
1791+ 87B2              ;
1792+ 87B2              ; Controlla se Willy entra in collisione con uno degli item
1793+ 87B2              ; attivi presenti nella stanza corrente.
1794+ 87B2              ;
1795+ 87B2              ; Per ogni item:
1796+ 87B2              ;   - verifica che appartenga alla stanza corrente
1797+ 87B2              ;   - verifica che non sia già stato raccolto
1798+ 87B2              ;   - esegue il test di collisione con Willy
1799+ 87B2              ;
1800+ 87B2              ; Se l'item viene raccolto:
1801+ 87B2              ;   - imposta il flag "collected"
1802+ 87B2              ;   - rimuove l'item dalla cache items_grid
1803+ 87B2              ;   - incrementa il contatore degli oggetti raccolti
1804+ 87B2              ;   - aggiorna l'HUD
1805+ 87B2              ;   - ripristina il tile di sfondo
1806+ 87B2              ;   - riproduce il suono di raccolta
1807+ 87B2              ;
1808+ 87B2              ; Formato record ItemsTable:
1809+ 87B2              ;   +0 RoomID
1810+ 87B2              ;   +1 X
1811+ 87B2              ;   +2 Y
1812+ 87B2              ;   +3 Color
1813+ 87B2              ;   +4 Collected
1814+ 87B2              ;
1815+ 87B2              ; Fine tabella:
1816+ 87B2              ;   RoomID = $FF
1817+ 87B2              ; -------------------------------------------------------------------
1818+ 87B2              Items_CheckCollision:
1819+ 87B2
1820+ 87B2                  ; Salva i registri utilizzati
1821+ 87B2 E5               push hl
1822+ 87B3 D5               push de
1823+ 87B4 C5               push bc
1824+ 87B5
1825+ 87B5                  ; Inizio scansione della tabella degli item
1826+ 87B5 21 FD 80         ld   hl, ItemsTable
1827+ 87B8
1828+ 87B8              .loop:
1829+ 87B8
1830+ 87B8                  ; ---------------------------------------------------------------
1831+ 87B8                  ; Legge il Room ID dell'item corrente
1832+ 87B8                  ; ---------------------------------------------------------------
1833+ 87B8 7E               ld   a, (hl)
1834+ 87B9
1835+ 87B9                  ; $FF indica fine tabella
1836+ 87B9 FE FF            cp   $FF
1837+ 87BB 28 58            jr   z, .done
1838+ 87BD
1839+ 87BD                  ; ---------------------------------------------------------------
1840+ 87BD                  ; Verifica se l'item appartiene alla stanza corrente
1841+ 87BD                  ; ---------------------------------------------------------------
1842+ 87BD 57               ld   d, a              ; D = RoomID item
1843+ 87BE
1844+ 87BE 3A 2B FB         ld   a, (current_room)
1845+ 87C1 BA               cp   d
1846+ 87C2
1847+ 87C2                  ; Se appartiene a un'altra stanza salta il record
