 467  8858 22 FA EE         ld   (time_last_counter), hl
 468  885B CD C3 66         call Gfx_UpdateTimeDisplay
 469  885E
 470  885E                  ; Ripristina la stanza iniziale (Stanza 0: The Off Licence)
 471  885E 21 A2 AD         ld   hl, TheBathroomLayout; TheOffLicenceLayout
 472  8861 22 6A EE         ld   (room_ptr), hl
 473  8864
 474  8864 C9               ret
 475  8865
 476  8865              ; -------------------------------------------------------------------
 477  8865              ; Time_UpdateClock
 478  8865              ; Gestisce lo scorrimento del tempo durante il gioco.
 479  8865              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 480  8865              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 481  8865              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 482  8865              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 483  8865              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 484  8865              ; sia completato, scatena immediatamente il Game Over.
 485  8865              ; -------------------------------------------------------------------
 486  8865              Time_UpdateClock:
 487  8865                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 488  8865 2A 0B EB         ld   hl, (counter)
 489  8868 ED 5B FA EE      ld   de, (time_last_counter)
 490  886C B7               or   a
 491  886D ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 492  886F
 493  886F                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 494  886F 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 495  8872 B7               or   a
 496  8873 ED 52            sbc  hl, de
 497  8875 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 498  8876
 499  8876                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 500  8876 2A FA EE         ld   hl, (time_last_counter)
 501  8879 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 502  887C 19               add  hl, de
 503  887D 22 FA EE         ld   (time_last_counter), hl
 504  8880
 505  8880                  ; Incrementa di 1 minuto il tempo di gioco
 506  8880 3A F8 EE         ld   a, (time_minutes)
 507  8883 3C               inc  a
 508  8884 FE 3C            cp   60
 509  8886 38 21            jr   c, .minutes_ok
 510  8888
 511  8888                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 512  8888 AF               xor  a
 513  8889 32 F8 EE         ld   (time_minutes), a
 514  888C 3A F7 EE         ld   a, (time_hours)
 515  888F 3C               inc  a
 516  8890 FE 0C            cp   12
 517  8892 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 518  8894 FE 0D            cp   13
 519  8896 38 0E            jr   c, .hours_ok
 520  8898 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 521  889A 18 0A            jr   .hours_ok
 522  889C
 523  889C              .toggle_period:
 524  889C F5               push af                     ; Salva A (valore 12)
 525  889D 3A F9 EE         ld   a, (time_period)
 526  88A0 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 527  88A2 32 F9 EE         ld   (time_period), a
 528  88A5 F1               pop  af                     ; Ripristina A = 12
 529  88A6
 530  88A6              .hours_ok:
 531  88A6 32 F7 EE         ld   (time_hours), a
 532  88A9
 533  88A9              .minutes_ok:
 534  88A9 32 F8 EE         ld   (time_minutes), a
 535  88AC
 536  88AC                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 537  88AC CD C3 66         call Gfx_UpdateTimeDisplay
 538  88AF
 539  88AF                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 540  88AF 3A FC EE         ld   a, (game_objective_completed)
 541  88B2 B7               or   a
 542  88B3 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 543  88B4
 544  88B4                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 545  88B4 3A F9 EE         ld   a, (time_period)
 546  88B7 B7               or   a
 547  88B8 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 548  88B9
 549  88B9 3A F7 EE         ld   a, (time_hours)
 550  88BC FE 0C            cp   12
 551  88BE 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
 552  88C0 C9               ret
 553  88C1
 554  88C1              .time_limit_reached:
 555  88C1                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
 556  88C1                  ; Scatena immediatamente il Game Over temporale!
 557  88C1 C3 B1 87         jp   TriggerGameOver
