 237+ 5ECC D6 03            sub  3                 ; A = RampRowStart
 238+ 5ECE BB               cp   e                 ; compare with player row E
 239+ 5ECF DA F8 5E         jp   c, .normal_grid   ; if RampRowStart < E, skip!
 240+ 5ED2
 241+ 5ED2 93               sub  e                 ; A = RampRowStart - E
 242+ 5ED3 47               ld   b, a              ; B = distance from start row (0..ramp_len-1)
 243+ 5ED4 3A 21 7A         ld   a, (ramp_len)
 244+ 5ED7 B8               cp   b
 245+ 5ED8 CA F8 5E         jp   z, .normal_grid   ; if B == ramp_len, too high!
 246+ 5EDB DA F8 5E         jp   c, .normal_grid   ; if B > ramp_len, too high!
 247+ 5EDE
 248+ 5EDE                  ; Calcola ExpectedCol:
