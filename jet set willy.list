   7+ 6CD3              ; Input_CheckCtrl
   8+ 6CD3              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 6CD3              ;
  10+ 6CD3              ; Output:
  11+ 6CD3              ;   D = bitmask tasti attivi:
  12+ 6CD3              ;       bit 0 → sinistra (O)
  13+ 6CD3              ;       bit 1 → destra   (P)
  14+ 6CD3              ;       bit 2 → salto    (Z)
  15+ 6CD3              ;
  16+ 6CD3              ; Effetti collaterali in RAM:
  17+ 6CD3              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 6CD3              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 6CD3              ;   (jump_prev)     → debounce tasto salto
  20+ 6CD3              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 6CD3              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 6CD3              ; -------------------------------------------------------------------
  23+ 6CD3
  24+ 6CD3              Input_CheckCtrl:
  25+ 6CD3 AF               xor  a
  26+ 6CD4 32 97 EC         ld   (current_input_dir), a
  27+ 6CD7
  28+ 6CD7                  IF ENABLE_ROOM_SKIP_KEYS != 0
  29+ 6CD7                  ; ── Sezione 1a: tasto Q (cambio stanza AVANTI) ─────────────────────
  30+ 6CD7                  ;
  31+ 6CD7                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  32+ 6CD7                  ; Se bit 0 = 0, Q è premuto.
  33+ 6CD7
  34+ 6CD7 01 FE FB         ld   bc, $fbfe
  35+ 6CDA ED 78            in   a, (c)
  36+ 6CDC CB 47            bit  0, a
  37+ 6CDE 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 6CE0
  39+ 6CE0                  ; Q è premuto: debounce tramite (q_prev).
  40+ 6CE0                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 6CE0 3A 98 EC         ld   a, (q_prev)
  42+ 6CE3 B7               or   a
  43+ 6CE4 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 6CE6
  45+ 6CE6                  ; ── Primo frame di pressione di Q ──
  46+ 6CE6 3E 01            ld   a, 1
  47+ 6CE8 32 98 EC         ld   (q_prev), a            ; marca "Q era premuto"
  48+ 6CEB
  49+ 6CEB                  ; NOTA sullo stack:
  50+ 6CEB                  ; Input_CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  51+ 6CEB                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChangeNext senza
  52+ 6CEB                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  53+ 6CEB                  ; poi JP salta direttamente.
  54+ 6CEB E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  55+ 6CEC C3 9E 6D         jp   PerformRoomChangeNext  ; salta al cambio stanza avanti (non torna qui)
  56+ 6CEF
  57+ 6CEF              .q_not_pressed:
  58+ 6CEF AF               xor  a
  59+ 6CF0 32 98 EC         ld   (q_prev), a            ; Q rilasciato → azzera debounce
  60+ 6CF3
  61+ 6CF3              .q_handled:
  62+ 6CF3
  63+ 6CF3                  ; ── Sezione 1b: tasto A (cambio stanza INDIETRO) ────────────────────
  64+ 6CF3                  ;
  65+ 6CF3                  ; Porta $FD → riga A, S, D, F, G. Bit 0 = A.
  66+ 6CF3                  ; Se bit 0 = 0, A è premuto.
  67+ 6CF3
  68+ 6CF3 01 FE FD         ld   bc, $fdfe
  69+ 6CF6 ED 78            in   a, (c)
