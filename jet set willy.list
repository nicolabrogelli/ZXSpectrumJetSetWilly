1025+ 6B50              ; -------------------------------------------------------------------
1026+ 6B50              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1027+ 6B50              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1028+ 6B50              ; -------------------------------------------------------------------
1029+ 6B50              UnpackRoomLayout:
1030+ 6B50 E5               push hl
1031+ 6B51 D5               push de
1032+ 6B52 C5               push bc
1033+ 6B53
1034+ 6B53 2A 74 78         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1035+ 6B56 11 1A 76         ld   de, unpacked_layout ; DE = buffer RAM
1036+ 6B59 06 80            ld   b, 128             ; 128 byte
1037+ 6B5B              .byte_loop:
1038+ 6B5B 7E               ld   a, (hl)            ; Leggi byte compresso
1039+ 6B5C 23               inc  hl
1040+ 6B5D
1041+ 6B5D 4F               ld   c, a               ; C = salvataggio
1042+ 6B5E
1043+ 6B5E                  ; Cella 0: bit 7-6
1044+ 6B5E 07               rlca
1045+ 6B5F 07               rlca
1046+ 6B60 E6 03            and  3
1047+ 6B62 12               ld   (de), a
1048+ 6B63 13               inc  de
1049+ 6B64
1050+ 6B64                  ; Cella 1: bit 5-4
1051+ 6B64 79               ld   a, c
1052+ 6B65 07               rlca
1053+ 6B66 07               rlca
1054+ 6B67 07               rlca
1055+ 6B68 07               rlca
1056+ 6B69 E6 03            and  3
1057+ 6B6B 12               ld   (de), a
1058+ 6B6C 13               inc  de
1059+ 6B6D
1060+ 6B6D                  ; Cella 2: bit 3-2
1061+ 6B6D 79               ld   a, c
1062+ 6B6E 0F               rrca
1063+ 6B6F 0F               rrca
1064+ 6B70 E6 03            and  3
1065+ 6B72 12               ld   (de), a
1066+ 6B73 13               inc  de
1067+ 6B74
1068+ 6B74                  ; Cella 3: bit 1-0
1069+ 6B74 79               ld   a, c
1070+ 6B75 E6 03            and  3
1071+ 6B77 12               ld   (de), a
1072+ 6B78 13               inc  de
1073+ 6B79
1074+ 6B79 10 E0            djnz .byte_loop
1075+ 6B7B
1076+ 6B7B C1               pop  bc
1077+ 6B7C D1               pop  de
1078+ 6B7D E1               pop  hl
1079+ 6B7E C9               ret
1080+ 6B7F
1081+ 6B7F              ; -------------------------------------------------------------------
1082+ 6B7F              ; Legge il tipo di cella dal buffer decompresso in RAM
1083+ 6B7F              ; Input: A = Row (0..15), C = Col (0..31)
1084+ 6B7F              ; Output: A = tipo di cella (0..3)
1085+ 6B7F              ; Preserva tutti gli altri registri.
1086+ 6B7F              ; -------------------------------------------------------------------
1087+ 6B7F              GetCellFromUnpacked:
1088+ 6B7F E5               push hl
1089+ 6B80 D5               push de
1090+ 6B81
1091+ 6B81 6F               ld   l, a
1092+ 6B82 26 00            ld   h, 0
1093+ 6B84 29               add  hl, hl
1094+ 6B85 29               add  hl, hl
1095+ 6B86 29               add  hl, hl
1096+ 6B87 29               add  hl, hl
1097+ 6B88 29               add  hl, hl            ; HL = Row * 32
1098+ 6B89 59               ld   e, c
1099+ 6B8A 16 00            ld   d, 0
1100+ 6B8C 19               add  hl, de            ; HL = Row * 32 + Col
1101+ 6B8D 11 1A 76         ld   de, unpacked_layout
1102+ 6B90 19               add  hl, de
1103+ 6B91 7E               ld   a, (hl)           ; A = cell type
1104+ 6B92
1105+ 6B92 D1               pop  de
1106+ 6B93 E1               pop  hl
1107+ 6B94 C9               ret
1108+ 6B95
1109+ 6B95              ; -------------------------------------------------------------------
1110+ 6B95              ; GetRampY
1111+ 6B95              ; Calcola la coordinata Y teorica di Willy se si trova sulla rampa
1112+ 6B95              ; Input: C = PlayerX
1113+ 6B95              ; Output: Carry flag impostato se PlayerX è nel range della rampa,
1114+ 6B95              ;         in tal caso A = PlayerY (Y teorico del player sulla rampa)
1115+ 6B95              ; -------------------------------------------------------------------
1116+ 6B95              GetRampY:
1117+ 6B95 3A 20 78         ld   a, (ramp_len)
1118+ 6B98 B7               or   a
1119+ 6B99 C8               ret  z                 ; Se non c'è rampa (len=0), return carry clear
1120+ 6B9A
1121+ 6B9A 3A 1F 78         ld   a, (ramp_dir)
1122+ 6B9D B7               or   a
1123+ 6B9E 28 4C            jr   z, .dir_left
1124+ 6BA0
1125+ 6BA0              .dir_right:
1126+ 6BA0                  ; Rampa sale a destra (up-right)
1127+ 6BA0 3A 22 78         ld   a, (ramp_col)
1128+ 6BA3 87               add  a, a              ; *2
1129+ 6BA4 87               add  a, a              ; *4
1130+ 6BA5 87               add  a, a              ; *8 (X start in pixel)
1131+ 6BA6 5F               ld   e, a              ; E = X_left
1132+ 6BA7
1133+ 6BA7 3A 20 78         ld   a, (ramp_len)
1134+ 6BAA 87               add  a, a              ; *2
1135+ 6BAB 87               add  a, a              ; *4
1136+ 6BAC 87               add  a, a              ; *8
1137+ 6BAD 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1138+ 6BAE 67               ld   h, a              ; H = X_right_boundary
1139+ 6BAF
1140+ 6BAF 79               ld   a, c              ; A = PlayerX
1141+ 6BB0 BB               cp   e
1142+ 6BB1 DA 46 6C         jp   c, .out_of_ramp   ; Se PlayerX < X_left, fuori
1143+ 6BB4
1144+ 6BB4 BC               cp   h
1145+ 6BB5 38 15            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1146+ 6BB7
1147+ 6BB7                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1148+ 6BB7 94               sub  h                 ; A = PlayerX - X_right_boundary
1149+ 6BB8 FE 08            cp   8
1150+ 6BBA D2 46 6C         jp   nc, .out_of_ramp  ; Se PlayerX >= X_right_boundary + 8, fuori
1151+ 6BBD
1152+ 6BBD                  ; Piattaforma adiacente! Restituisci PlayerY = (ramp_row - ramp_len + 1) * 8 - 16
1153+ 6BBD 3A 21 78         ld   a, (ramp_row)
1154+ 6BC0 21 20 78         ld   hl, ramp_len
1155+ 6BC3 96               sub  (hl)
1156+ 6BC4 3C               inc  a                 ; A = Row
1157+ 6BC5 87               add  a, a              ; *2
1158+ 6BC6 87               add  a, a              ; *4
1159+ 6BC7 87               add  a, a              ; *8
1160+ 6BC8 D6 10            sub  16                ; A = Row * 8 - 16
1161+ 6BCA 37               scf                    ; Set carry (dentro rampa/piattaforma)
1162+ 6BCB C9               ret
1163+ 6BCC
1164+ 6BCC              .on_ramp_slope:
1165+ 6BCC 3A 21 78         ld   a, (ramp_row)
1166+ 6BCF 87               add  a, a              ; *2
1167+ 6BD0 87               add  a, a              ; *4
1168+ 6BD1 87               add  a, a              ; *8
