 298+ 6C67 DD 7E 02         ld   a, (ix+2)
 299+ 6C6A DD 77 08         ld   (ix+8), a         ; Old Y = Current Y
 300+ 6C6D
 301+ 6C6D                  ; 2. Aggiorna Anim State
