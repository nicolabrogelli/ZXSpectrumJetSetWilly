 417+ 75F3              ; -------------------------------------------------------------------
 418+ 75F3              ; Riproduce un breve segnale acustico all'altoparlante
 419+ 75F3              ; -------------------------------------------------------------------
 420+ 75F3              PlayCollectSound:
 421+ 75F3 C5               push bc
 422+ 75F4 D5               push de
 423+ 75F5
 424+ 75F5 06 78            ld   b, 120            ; Cicli della nota
 425+ 75F7              .sound_loop:
 426+ 75F7 3A BE 76         ld   a, (room_border_color)
 427+ 75FA F6 10            or   $10               ; Speaker ON (bit 4 = 1)
 428+ 75FC D3 FE            out  ($fe), a
 429+ 75FE 0E 3C            ld   c, 60             ; Mezzo periodo delay
 430+ 7600 0D           .d1: dec  c
 431+ 7601 20 FD            jr   nz, .d1
 432+ 7603
 433+ 7603 3A BE 76         ld   a, (room_border_color)
 434+ 7606 E6 EF            and  $ef               ; Speaker OFF (bit 4 = 0)
 435+ 7608 D3 FE            out  ($fe), a
 436+ 760A 0E 3C            ld   c, 60             ; Mezzo periodo delay
 437+ 760C 0D           .d2: dec  c
 438+ 760D 20 FD            jr   nz, .d2
 439+ 760F
 440+ 760F 10 E6            djnz .sound_loop
 441+ 7611
 442+ 7611 D1               pop  de
 443+ 7612 C1               pop  bc
 444+ 7613 C9               ret
