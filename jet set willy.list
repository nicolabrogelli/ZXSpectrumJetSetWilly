 195+ 5E85
 196+ 5E85 78               ld   a, b
 197+ 5E86 CB 3F            srl  a
 198+ 5E88 CB 3F            srl  a
 199+ 5E8A CB 3F            srl  a                 ; A = column c (0..31)
 200+ 5E8C 4F               ld   c, a              ; C = c (Col)
 201+ 5E8D
 202+ 5E8D                  ; --- Controlla se c'è un Item Attivo in questa cella ---
 203+ 5E8D D5               push de
 204+ 5E8E C5               push bc
