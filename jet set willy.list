1008+ 6ACE              ; -------------------------------------------------------------------
1009+ 6ACE              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1010+ 6ACE              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1011+ 6ACE              ; -------------------------------------------------------------------
1012+ 6ACE              UnpackRoomLayout:
1013+ 6ACE E5               push hl
1014+ 6ACF D5               push de
1015+ 6AD0 C5               push bc
1016+ 6AD1
1017+ 6AD1 2A 76 76         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1018+ 6AD4 11 1C 74         ld   de, unpacked_layout ; DE = buffer RAM
1019+ 6AD7 06 80            ld   b, 128             ; 128 byte
1020+ 6AD9              .byte_loop:
1021+ 6AD9 7E               ld   a, (hl)            ; Leggi byte compresso
1022+ 6ADA 23               inc  hl
1023+ 6ADB
1024+ 6ADB 4F               ld   c, a               ; C = salvataggio
1025+ 6ADC
1026+ 6ADC                  ; Cella 0: bit 7-6
1027+ 6ADC 07               rlca
1028+ 6ADD 07               rlca
1029+ 6ADE E6 03            and  3
1030+ 6AE0 12               ld   (de), a
1031+ 6AE1 13               inc  de
1032+ 6AE2
1033+ 6AE2                  ; Cella 1: bit 5-4
1034+ 6AE2 79               ld   a, c
1035+ 6AE3 07               rlca
1036+ 6AE4 07               rlca
1037+ 6AE5 07               rlca
1038+ 6AE6 07               rlca
1039+ 6AE7 E6 03            and  3
1040+ 6AE9 12               ld   (de), a
1041+ 6AEA 13               inc  de
1042+ 6AEB
1043+ 6AEB                  ; Cella 2: bit 3-2
1044+ 6AEB 79               ld   a, c
1045+ 6AEC 0F               rrca
1046+ 6AED 0F               rrca
1047+ 6AEE E6 03            and  3
1048+ 6AF0 12               ld   (de), a
1049+ 6AF1 13               inc  de
1050+ 6AF2
1051+ 6AF2                  ; Cella 3: bit 1-0
1052+ 6AF2 79               ld   a, c
1053+ 6AF3 E6 03            and  3
1054+ 6AF5 12               ld   (de), a
1055+ 6AF6 13               inc  de
1056+ 6AF7
1057+ 6AF7 10 E0            djnz .byte_loop
1058+ 6AF9
1059+ 6AF9 C1               pop  bc
1060+ 6AFA D1               pop  de
1061+ 6AFB E1               pop  hl
1062+ 6AFC C9               ret
