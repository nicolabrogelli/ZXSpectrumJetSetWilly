 174+ 5E74              ; -------------------------------------------------------------------
 175+ 5E74              ; Ripristina un byte dello sfondo statico.
 176+ 5E74              ; Input: A = X del byte schermo in pixel (0, 8, 16...), D = Y pixel
 177+ 5E74              ; Output: A = byte di sfondo
 178+ 5E74              ; ---------------------------------------------------------------
 179+ 5E74              GetBackgroundByte:
 180+ 5E74 E5               push hl
 181+ 5E75 D5               push de
 182+ 5E76 C5               push bc
 183+ 5E77
 184+ 5E77 47               ld   b, a              ; B = X (pixel)
 185+ 5E78
 186+ 5E78                  ; 1. Controlla se Y (in D) è fuori dalla griglia di layout (Y < 24 o Y >= 152)
 187+ 5E78 7A               ld   a, d
 188+ 5E79 FE 18            cp   24
 189+ 5E7B DA 2C 5F         jp   c, .blank
 190+ 5E7E FE 98            cp   152
 191+ 5E80 D2 2C 5F         jp   nc, .blank
 192+ 5E83
 193+ 5E83                  ; Converti Y (in D) e X (in B) a cella
 194+ 5E83 D6 18            sub  24
 195+ 5E85 CB 3F            srl  a
 196+ 5E87 CB 3F            srl  a
 197+ 5E89 CB 3F            srl  a                 ; A = layout row r (0..15)
 198+ 5E8B 5F               ld   e, a              ; E = r (Row)
 199+ 5E8C
 200+ 5E8C 78               ld   a, b
 201+ 5E8D CB 3F            srl  a
 202+ 5E8F CB 3F            srl  a
 203+ 5E91 CB 3F            srl  a                 ; A = column c (0..31)
 204+ 5E93 4F               ld   c, a              ; C = c (Col)
 205+ 5E94
 206+ 5E94                  ; --- Controlla Conveyor ---
 207+ 5E94 3A C7 79         ld   a, (conveyor_len)
 208+ 5E97 B7               or   a
 209+ 5E98 CA C2 5E         jp   z, .check_ramp
 210+ 5E9B
 211+ 5E9B 3A C8 79         ld   a, (conveyor_row)
 212+ 5E9E D6 03            sub  3
 213+ 5EA0 BB               cp   e
 214+ 5EA1 C2 C2 5E         jp   nz, .check_ramp
 215+ 5EA4
 216+ 5EA4 3A C9 79         ld   a, (conveyor_col)
 217+ 5EA7 B9               cp   c
 218+ 5EA8 CA BC 5E         jp   z, .is_conveyor
 219+ 5EAB DA B1 5E         jp   c, .c_greater
 220+ 5EAE C3 C2 5E         jp   .check_ramp
 221+ 5EB1              .c_greater:
 222+ 5EB1 21 C7 79         ld   hl, conveyor_len
 223+ 5EB4 86               add  a, (hl)
 224+ 5EB5 B9               cp   c
 225+ 5EB6 CA C2 5E         jp   z, .check_ramp
 226+ 5EB9 DA C2 5E         jp   c, .check_ramp
 227+ 5EBC              .is_conveyor:
 228+ 5EBC 21 CD 00         ld   hl, OFFSET_CONVEYOR
 229+ 5EBF C3 17 5F         jp   .load_tile
 230+ 5EC2
 231+ 5EC2              .check_ramp:
 232+ 5EC2 3A CB 79         ld   a, (ramp_len)
 233+ 5EC5 B7               or   a
 234+ 5EC6 CA F8 5E         jp   z, .normal_grid
 235+ 5EC9
 236+ 5EC9 3A CC 79         ld   a, (ramp_row)
 237+ 5ECC D6 03            sub  3                 ; A = RampRowStart
 238+ 5ECE BB               cp   e                 ; compare with player row E
 239+ 5ECF DA F8 5E         jp   c, .normal_grid   ; if RampRowStart < E, skip!
 240+ 5ED2
 241+ 5ED2 93               sub  e                 ; A = RampRowStart - E
 242+ 5ED3 47               ld   b, a              ; B = distance from start row (0..ramp_len-1)
 243+ 5ED4 3A CB 79         ld   a, (ramp_len)
 244+ 5ED7 B8               cp   b
 245+ 5ED8 CA F8 5E         jp   z, .normal_grid   ; if B == ramp_len, too high!
 246+ 5EDB DA F8 5E         jp   c, .normal_grid   ; if B > ramp_len, too high!
 247+ 5EDE
 248+ 5EDE                  ; Calcola ExpectedCol:
 249+ 5EDE 3A CA 79         ld   a, (ramp_dir)
 250+ 5EE1 B7               or   a
 251+ 5EE2 28 06            jr   z, .r_left
 252+ 5EE4              .r_right:
 253+ 5EE4 3A CD 79         ld   a, (ramp_col)
 254+ 5EE7 80               add  a, b              ; A = ramp_col + B
 255+ 5EE8 18 04            jr   .compare_col
 256+ 5EEA              .r_left:
 257+ 5EEA 3A CD 79         ld   a, (ramp_col)
 258+ 5EED 90               sub  b                 ; A = ramp_col - B
 259+ 5EEE              .compare_col:
