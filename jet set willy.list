 839+ 78D0
 840+ 78D0 3A F1 7D         ld   a, (current_room)
 841+ 78D3 BA               cp   d
 842+ 78D4 20 45            jr   nz, .next_item
 843+ 78D6
 844+ 78D6                  ; ---------------------------------------------------------------
 845+ 78D6                  ; Legge i dati dell'item
 846+ 78D6                  ; ---------------------------------------------------------------
 847+ 78D6
 848+ 78D6 23               inc  hl
 849+ 78D7 4E               ld   c, (hl)           ; X (colonna)
 850+ 78D8
 851+ 78D8 23               inc  hl
 852+ 78D9 46               ld   b, (hl)           ; Y (riga)
 853+ 78DA
 854+ 78DA 23               inc  hl
 855+ 78DB 5E               ld   e, (hl)           ; Colore
 856+ 78DC
 857+ 78DC 23               inc  hl
 858+ 78DD 7E               ld   a, (hl)           ; Collected flag
 859+ 78DE
 860+ 78DE                  ; Se diverso da zero l'item è già stato raccolto
 861+ 78DE B7               or   a
 862+ 78DF 20 3E            jr   nz, .next_no_inc
 863+ 78E1
 864+ 78E1                  ; ---------------------------------------------------------------
 865+ 78E1                  ; Disegna l'item sullo schermo
 866+ 78E1                  ;
 867+ 78E1                  ; B = Row
 868+ 78E1                  ; C = Column
 869+ 78E1                  ; HL = bitmap pointer
 870+ 78E1                  ; E = Color
 871+ 78E1                  ; ---------------------------------------------------------------
 872+ 78E1 E5               push hl
 873+ 78E2
 874+ 78E2 DD E5            push ix
 875+ 78E4 E1               pop  hl
 876+ 78E5
 877+ 78E5 CD 2A 79         call DrawItemGraphic
 878+ 78E8
 879+ 78E8 E1               pop  hl                ; ritorna al flag collected
 880+ 78E9
 881+ 78E9                  ; ---------------------------------------------------------------
 882+ 78E9                  ; Aggiorna items_grid
 883+ 78E9                  ;
 884+ 78E9                  ; Calcolo:
 885+ 78E9                  ;   offset = Row * 32 + Col
 886+ 78E9                  ; ---------------------------------------------------------------
 887+ 78E9 E5               push hl
 888+ 78EA D5               push de
 889+ 78EB
 890+ 78EB 26 00            ld   h, 0
 891+ 78ED 68               ld   l, b              ; HL = Row
 892+ 78EE
 893+ 78EE 29               add  hl, hl            ; *2
 894+ 78EF 29               add  hl, hl            ; *4
 895+ 78F0 29               add  hl, hl            ; *8
 896+ 78F1 29               add  hl, hl            ; *16
 897+ 78F2 29               add  hl, hl            ; *32
 898+ 78F3
 899+ 78F3 16 00            ld   d, 0
 900+ 78F5 59               ld   e, c              ; DE = Col
 901+ 78F6
 902+ 78F6 19               add  hl, de            ; Row*32 + Col
 903+ 78F7
 904+ 78F7 11 6C CD         ld   de, items_grid
 905+ 78FA 19               add  hl, de            ; puntatore nella griglia
 906+ 78FB
 907+ 78FB D1               pop  de                ; ripristina colore
 908+ 78FC
 909+ 78FC 73               ld   (hl), e           ; salva colore cella
 910+ 78FD
 911+ 78FD E1               pop  hl
 912+ 78FE
 913+ 78FE                  ; ---------------------------------------------------------------
 914+ 78FE                  ; Salva l'item nella cache della stanza
 915+ 78FE                  ;
 916+ 78FE                  ; Questo evita di dover scansionare tutta ItemsTable
 917+ 78FE                  ; durante il controllo delle collisioni.
 918+ 78FE                  ; ---------------------------------------------------------------
 919+ 78FE
 920+ 78FE FD 71 00         ld   (iy+0), c         ; Colonna
 921+ 7901 FD 70 01         ld   (iy+1), b         ; Riga
 922+ 7904 FD 73 02         ld   (iy+2), e         ; Colore
 923+ 7907
 924+ 7907                  ; Salva il puntatore al flag "collected"
 925+ 7907 FD 75 03         ld   (iy+3), l         ; Low byte
 926+ 790A FD 74 04         ld   (iy+4), h         ; High byte
 927+ 790D
 928+ 790D                  ; Passa al record successivo della cache
 929+ 790D 01 05 00         ld   bc, 5
 930+ 7910 FD 09            add  iy, bc
 931+ 7912
 932+ 7912                  ; Incrementa il numero di item attivi
 933+ 7912 3A 4A 7E         ld   a, (num_room_items)
 934+ 7915 3C               inc  a
 935+ 7916 32 4A 7E         ld   (num_room_items), a
 936+ 7919
 937+ 7919 18 04            jr   .next_no_inc
 938+ 791B
 939+ 791B              .next_item:
 940+ 791B
 941+ 791B                  ; ---------------------------------------------------------------
 942+ 791B                  ; L'item non appartiene alla stanza corrente.
 943+ 791B                  ; Salta i campi del record:
 944+ 791B                  ;   X
 945+ 791B                  ;   Y
 946+ 791B                  ;   Color
 947+ 791B                  ;   Collected
 948+ 791B                  ; ---------------------------------------------------------------
 949+ 791B 23               inc  hl
 950+ 791C 23               inc  hl
 951+ 791D 23               inc  hl
 952+ 791E 23               inc  hl
 953+ 791F
 954+ 791F              .next_no_inc:
 955+ 791F
 956+ 791F                  ; ---------------------------------------------------------------
 957+ 791F                  ; Avanza al record successivo
 958+ 791F                  ; (prossimo Room ID)
 959+ 791F                  ; ---------------------------------------------------------------
 960+ 791F 23               inc  hl
 961+ 7920 18 A8            jr   .loop
 962+ 7922
 963+ 7922              .done:
 964+ 7922
 965+ 7922                  ; Ripristina i registri
 966+ 7922 FD E1            pop  iy
 967+ 7924 DD E1            pop  ix
 968+ 7926 D1               pop  de
 969+ 7927 C1               pop  bc
 970+ 7928 E1               pop  hl
 971+ 7929
 972+ 7929 C9               ret
