 408+ 751E FE FF            cp   $FF               ; Fine tabella?
 409+ 7520 28 2B            jr   z, .done
 410+ 7522
 411+ 7522                  ; Stanza corrente?
 412+ 7522 57               ld   d, a              ; D = Room ID
 413+ 7523 3A 23 77         ld   a, (current_room)
 414+ 7526 BA               cp   d
 415+ 7527 20 1D            jr   nz, .next_item
 416+ 7529
 417+ 7529 23               inc  hl                ; HL punta a X
 418+ 752A 4E               ld   c, (hl)           ; C = X
 419+ 752B 23               inc  hl                ; HL punta a Y
 420+ 752C 46               ld   b, (hl)           ; B = Y
 421+ 752D 23               inc  hl                ; HL punta al colore (lo saltiamo per il controllo collisione)
 422+ 752E 23               inc  hl                ; HL punta a collected
 423+ 752F 7E               ld   a, (hl)           ; A = collected
 424+ 7530 B7               or   a
 425+ 7531 20 17            jr   nz, .next_no_inc  ; Già raccolto, salta
 426+ 7533
 427+ 7533                  ; Controlla collisione
 428+ 7533 79               ld   a, c
 429+ 7534 60               ld   h, b
 430+ 7535 CD D1 74         call CheckWillyItemCollision
 431+ 7538 30 10            jr   nc, .next_no_inc
 432+ 753A
 433+ 753A                  ; RACCOLTO!
 434+ 753A 36 01            ld   (hl), 1           ; Imposta collected = 1
 435+ 753C
 436+ 753C E5               push hl
 437+ 753D
 438+ 753D                  ; Cancella item dallo schermo
 439+ 753D CD 5C 74         call RestoreBackgroundCell
 440+ 7540
 441+ 7540                  ; Suono di raccolta
 442+ 7540 CD 51 75         call PlayCollectSound
 443+ 7543
 444+ 7543 E1               pop  hl
 445+ 7544
 446+ 7544 18 04            jr   .next_no_inc
 447+ 7546
 448+ 7546              .next_item:
 449+ 7546 23               inc  hl                ; salta X
 450+ 7547 23               inc  hl                ; salta Y
 451+ 7548 23               inc  hl                ; salta colore
 452+ 7549 23               inc  hl                ; salta collected
 453+ 754A              .next_no_inc:
 454+ 754A 23               inc  hl                ; vai al prossimo item
 455+ 754B 18 D0            jr   .loop
 456+ 754D
 457+ 754D              .done:
 458+ 754D C1               pop  bc
 459+ 754E D1               pop  de
 460+ 754F E1               pop  hl
 461+ 7550 C9               ret
