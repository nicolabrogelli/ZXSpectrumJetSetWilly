 173+ 7B18              ; -------------------------------------------------------------------
 174+ 7B18              ; Audio_PlayCollectSound
 175+ 7B18              ;
 176+ 7B18              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 177+ 7B18              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 178+ 7B18              ; -------------------------------------------------------------------
 179+ 7B18              Audio_PlayCollectSound:
 180+ 7B18 C5               push bc
 181+ 7B19 D5               push de
 182+ 7B1A
 183+ 7B1A 06 78            ld   b, 120
 184+ 7B1C              .sound_loop:
 185+ 7B1C 3A 45 7B         ld   a, (room_border_color)
 186+ 7B1F F6 10            or   $10               ; speaker ON
 187+ 7B21 D3 FE            out  ($fe), a
 188+ 7B23
 189+ 7B23 0E 3C            ld   c, 60
 190+ 7B25              .d1:
 191+ 7B25 0D               dec  c
 192+ 7B26 20 FD            jr   nz, .d1
 193+ 7B28
 194+ 7B28 3A 45 7B         ld   a, (room_border_color)
 195+ 7B2B E6 EF            and  $ef              ; speaker OFF
 196+ 7B2D D3 FE            out  ($fe), a
 197+ 7B2F
 198+ 7B2F 0E 3C            ld   c, 60
 199+ 7B31              .d2:
 200+ 7B31 0D               dec  c
 201+ 7B32 20 FD            jr   nz, .d2
 202+ 7B34
 203+ 7B34 10 E6            djnz .sound_loop
 204+ 7B36
 205+ 7B36 D1               pop  de
 206+ 7B37 C1               pop  bc
 207+ 7B38 C9               ret
 208+ 7B39
