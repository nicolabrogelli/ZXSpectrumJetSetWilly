 885+ 6AC3 86               add  a, (hl)           ; A = ramp_col + ramp_len
 886+ 6AC4 18 07            jr   .compare_plat
 887+ 6AC6              .plat_left:
 888+ 6AC6 3A 0A 77         ld   a, (ramp_col)
 889+ 6AC9 21 08 77         ld   hl, ramp_len
 890+ 6ACC 96               sub  (hl)              ; A = ramp_col - ramp_len
 891+ 6ACD              .compare_plat:
 892+ 6ACD BB               cp   e                 ; Compare with Col
 893+ 6ACE 20 0B            jr   nz, .no
 894+ 6AD0
 895+ 6AD0 3A 09 77         ld   a, (ramp_row)
 896+ 6AD3 21 08 77         ld   hl, ramp_len
 897+ 6AD6 96               sub  (hl)
 898+ 6AD7 3C               inc  a                 ; A = ramp_row - ramp_len + 1
 899+ 6AD8 BA               cp   d                 ; Compare with Row
 900+ 6AD9 28 04            jr   z, .yes
 901+ 6ADB
 902+ 6ADB              .no:
 903+ 6ADB E1               pop  hl
 904+ 6ADC C1               pop  bc
 905+ 6ADD B7               or   a
 906+ 6ADE C9               ret
 907+ 6ADF
 908+ 6ADF              .yes:
 909+ 6ADF E1               pop  hl
 910+ 6AE0 C1               pop  bc
 911+ 6AE1 37               scf
 912+ 6AE2 C9               ret
