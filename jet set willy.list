 641+ 6095 18 11            jr   .draw_body
 642+ 6097
 643+ 6097              .right_body:
 644+ 6097                  ; Corpo a destra
 645+ 6097 3A 40 F7         ld   a, (body_state)   ; 0, 1, 2
 646+ 609A C6 01            add  a, 1              ; offset del tile per il corpo destro (1, 2, 3)
 647+ 609C 87               add  a, a              ; *2
 648+ 609D 87               add  a, a              ; *4
 649+ 609E 87               add  a, a              ; *8
 650+ 609F 5F               ld   e, a
 651+ 60A0 16 00            ld   d, 0
 652+ 60A2 DD 21 3A D2      ld   ix, Willy
 653+ 60A6 DD 19            add  ix, de
