  63  7F91
  64  7F91                  ; Leggi il colore del bordo dalla stanza corrente e impostalo
  65  7F91 2A 5C 77         ld   hl, (room_ptr)
  66  7F94 11 DE 00         ld   de, OFFSET_BORDER_COLOR
  67  7F97 19               add  hl, de
  68  7F98 7E               ld   a, (hl)
  69  7F99 32 F7 73         ld   (room_border_color), a
  70  7F9C D3 FE            out  ($fe), a          ; Imposta colore bordo hardware
  71  7F9E
  72  7F9E                  ; Aggiorna BORDCR per far sì che la ROM usi lo stesso colore
  73  7F9E 87               add  a, a
  74  7F9F 87               add  a, a
  75  7FA0 87               add  a, a              ; Sposta nei bit 3-5
  76  7FA1 47               ld   b, a
  77  7FA2 3A 48 5C         ld   a, (BORDCR)
  78  7FA5 E6 C7            and  $c7               ; Pulisce vecchi bit del bordo
  79  7FA7 B0               or   b                 ; Imposta nuovo colore bordo
  80  7FA8 F6 07            or   $07               ; Imposta ink a bianco
  81  7FAA 32 48 5C         ld   (BORDCR), a
  82  7FAD
  83  7FAD CD F3 5F         call PrintPlayer
  84  7FB0
  85  7FB0              Main_loop:
  86  7FB0 76               halt
  87  7FB1
  88  7FB1                  ; 1. Cancella e disegna i personaggi (back-to-back per minimizzare il flickering)
  89  7FB1 CD 46 60         call DeleteCharAtOldPos
  90  7FB4 CD F3 5F         call PrintPlayer
  91  7FB7
  92  7FB7 CD AE 6D         call EraseRoomEnemies
  93  7FBA CD E2 6D         call DrawRoomEnemies
  94  7FBD
  95  7FBD                  ; 3. Salva le posizioni correnti del player per il prossimo frame
  96  7FBD ED 4B EB 73      ld   bc, (PlayerPos)
  97  7FC1 ED 43 ED 73      ld   (PlayerPosOld), bc
  98  7FC5
  99  7FC5                  ; 4. Aggiorna le posizioni dei personaggi per il prossimo frame
 100  7FC5 CD 2A 65         call CheckCtrl
 101  7FC8 CD 4C 64         call MovePlayer
 102  7FCB CD EB 66         call ApplyGravity
 103  7FCE CD B6 69         call ApplyConveyorForce
 104  7FD1 CD 20 6F         call UpdateRoomEnemies
 105  7FD4 CD 50 73         call CheckRoomItemsCollision
 106  7FD7
 107  7FD7                  ; 5. Gestisci la collisione (disegna le raster bar se collide)
 108  7FD7 CD 08 69         call CheckCollision
 109  7FDA 30 1A            jr   nc, .no_collision
 110  7FDC
 111  7FDC                  ; Collisione attiva: disegna le raster bar nel bordo
 112  7FDC 3A 00 74         ld   a, (counter)
 113  7FDF E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 114  7FE1 06 1E            ld   b, 30             ; Numero di righe della barra raster
 115  7FE3              .raster_loop:
 116  7FE3 D3 FE            out  ($fe), a
 117  7FE5 3C               inc  a
 118  7FE6 E6 07            and  7
 119  7FE8 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 120  7FEA              .delay:
 121  7FEA 0D               dec  c
 122  7FEB 20 FD            jr   nz, .delay
 123  7FED 10 F4            djnz .raster_loop
 124  7FEF
 125  7FEF                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 126  7FEF 3A F7 73         ld   a, (room_border_color)
 127  7FF2 D3 FE            out  ($fe), a
 128  7FF4 18 05            jr   .no_collision_change
 129  7FF6
 130  7FF6              .no_collision:
 131  7FF6                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 132  7FF6 3A F7 73         ld   a, (room_border_color)
 133  7FF9 D3 FE            out  ($fe), a
 134  7FFB
 135  7FFB              .no_collision_change:
 136  7FFB C3 B0 7F         jp   Main_loop
