1000+ 807A DD 7E 05         ld   a, (ix+5)         ; Max Limit
1001+ 807D DD 77 03         ld   (ix+3), a
1002+ 8080 3E 01            ld   a, 1
1003+ 8082 DD 77 06         ld   (ix+6), a         ; Cambia direzione in Alto
