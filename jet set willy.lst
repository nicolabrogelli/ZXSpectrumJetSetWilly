 177+ 76B2              ; -------------------------------------------------------------------
 178+ 76B2              ; DetermineCurrentRoomID
 179+ 76B2              ;
 180+ 76B2              ; Determina l'ID numerico della stanza corrente confrontando
 181+ 76B2              ; il puntatore room_ptr con gli indirizzi dei layout delle stanze.
 182+ 76B2              ;
 183+ 76B2              ; Se viene trovata una corrispondenza:
 184+ 76B2              ;   A = ID della stanza
 185+ 76B2              ;   current_room = A
 186+ 76B2              ;
 187+ 76B2              ; Mappatura:
 188+ 76B2              ;    0 = The Off Licence
 189+ 76B2              ;    1 = The Bridge
 190+ 76B2              ;    2 = Under The Mega Tree
 191+ 76B2              ;    3 = Gfx_At The Foot Of The Mega Tree
 192+ 76B2              ;    4 = The Drive
 193+ 76B2              ;    5 = The Security Guard
 194+ 76B2              ;    6 = Entrance To Hades
 195+ 76B2              ;    7 = Cuckoo's Nest
 196+ 76B2              ;    8 = Inside The Mega Trunk
 197+ 76B2              ;    9 = On A Branch Over The Drive
 198+ 76B2              ;   10 = The Front Door
 199+ 76B2              ;   11 = The Hall
 200+ 76B2              ;   12 = Tree Top
 201+ 76B2              ;   27 = The Chapel
 202+ 76B2              ;   28 = First Landing
 203+ 76B2              ;   29 = The Nightmare Room
 204+ 76B2              ;   33 = The Bathroom
 205+ 76B2              ;   35 = Master Bedroom
 206+ 76B2              ;
 207+ 76B2              ; Se nessuna stanza corrisponde viene impostato:
 208+ 76B2              ;   current_room = 0
 209+ 76B2              ; -------------------------------------------------------------------
 210+ 76B2              DetermineCurrentRoomID:
 211+ 76B2
 212+ 76B2                  ; Salva i registri utilizzati
 213+ 76B2 E5               push hl
 214+ 76B3 D5               push de
