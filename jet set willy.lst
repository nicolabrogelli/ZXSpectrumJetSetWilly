1172+ 6E35 29               add  hl, hl
1173+ 6E36 29               add  hl, hl
1174+ 6E37 29               add  hl, hl
1175+ 6E38 29               add  hl, hl
1176+ 6E39 29               add  hl, hl            ; HL = Row * 32
1177+ 6E3A 59               ld   e, c
1178+ 6E3B 16 00            ld   d, 0
1179+ 6E3D 19               add  hl, de            ; HL = Row * 32 + Col
1180+ 6E3E 11 4B E7         ld   de, unpacked_layout
1181+ 6E41 19               add  hl, de
1182+ 6E42 7E               ld   a, (hl)           ; A = cell type
1183+ 6E43
1184+ 6E43 D1               pop  de
1185+ 6E44 E1               pop  hl
1186+ 6E45 C9               ret
