 774+ 745A                  ; 1. Salva la posizione corrente in Old X/Y per la cancellazione nel prossimo frame
 775+ 745A DD 7E 02         ld   a, (ix+2)         ; Current X (Offset 2)
 776+ 745D DD 77 08         ld   (ix+8), a         ; Old X = Current X (Offset 8)
 777+ 7460 DD 7E 03         ld   a, (ix+3)         ; Current Y (Offset 3)
 778+ 7463 DD 77 09         ld   (ix+9), a         ; Old Y = Current Y (Offset 9)
 779+ 7466
