  72+ 7C9B ~            ; Audio_UpdateMusic
  73+ 7C9B ~            ;
  74+ 7C9B ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 7C9B ~            ; Viene chiamata a ogni frame.
  76+ 7C9B ~            ; -------------------------------------------------------------------
  77+ 7C9B ~            Audio_UpdateMusic:
  78+ 7C9B ~                push af
  79+ 7C9B ~                push bc
  80+ 7C9B ~                push de
  81+ 7C9B ~                push hl
  82+ 7C9B ~
  83+ 7C9B ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 7C9B ~                ld   a, (Audio_jump_sound_note)
  85+ 7C9B ~                cp   18
  86+ 7C9B ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 7C9B ~
  88+ 7C9B ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 7C9B ~                ld   a, (Audio_music_frame_counter)
  90+ 7C9B ~                dec  a
  91+ 7C9B ~                ld   (Audio_music_frame_counter), a
  92+ 7C9B ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 7C9B ~
  94+ 7C9B ~                ; Altrimenti carica la nota successiva
  95+ 7C9B ~                ld   a, (Audio_music_note_idx)
  96+ 7C9B ~                inc  a
  97+ 7C9B ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 7C9B ~                jr   c, .no_wrap
  99+ 7C9B ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 7C9B ~            .no_wrap:
 101+ 7C9B ~                ld   (Audio_music_note_idx), a
 102+ 7C9B ~
 103+ 7C9B ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 7C9B ~                ld   e, a
 105+ 7C9B ~                ld   d, 0
 106+ 7C9B ~                ld   hl, Audio_MusicSheet
 107+ 7C9B ~                add  hl, de
 108+ 7C9B ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 7C9B ~
 110+ 7C9B ~                ; Leggi durata (secondo byte)
 111+ 7C9B ~                inc  hl
 112+ 7C9B ~                ld   a, (hl)
 113+ 7C9B ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 7C9B ~                jr   nz, .dur_ok
 115+ 7C9B ~                ld   a, 1
 116+ 7C9B ~            .dur_ok:
 117+ 7C9B ~                ld   (Audio_music_frame_counter), a
 118+ 7C9B ~
 119+ 7C9B ~            .play_current_note:
 120+ 7C9B ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 7C9B ~                ld   a, (Audio_music_note_idx)
 122+ 7C9B ~                ld   e, a
 123+ 7C9B ~                ld   d, 0
 124+ 7C9B ~                ld   hl, Audio_MusicSheet
 125+ 7C9B ~                add  hl, de
 126+ 7C9B ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 7C9B ~                ld   a, (hl)                  ; A = delay
 128+ 7C9B ~                or   a
 129+ 7C9B ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 7C9B ~
 131+ 7C9B ~                ; Suona la nota: 2 cicli
 132+ 7C9B ~                ld   d, a                     ; D = delay
 133+ 7C9B ~                ld   b, 2                     ; 2 cicli per frame
 134+ 7C9B ~            .note_loop:
 135+ 7C9B ~                ; Speaker ON
 136+ 7C9B ~                ld   a, (room_border_color)
 137+ 7C9B ~                or   $10
 138+ 7C9B ~                out  ($fe), a
 139+ 7C9B ~                ld   c, d
 140+ 7C9B ~            .d1:
 141+ 7C9B ~                push af
 142+ 7C9B ~                pop  af
 143+ 7C9B ~                dec  c
 144+ 7C9B ~                jr   nz, .d1
 145+ 7C9B ~
 146+ 7C9B ~                ; Speaker OFF
 147+ 7C9B ~                ld   a, (room_border_color)
 148+ 7C9B ~                and  $ef
 149+ 7C9B ~                out  ($fe), a
 150+ 7C9B ~                ld   c, d
 151+ 7C9B ~            .d2:
 152+ 7C9B ~                push af
 153+ 7C9B ~                pop  af
 154+ 7C9B ~                dec  c
 155+ 7C9B ~                jr   nz, .d2
 156+ 7C9B ~
 157+ 7C9B ~                djnz .note_loop
 158+ 7C9B ~
 159+ 7C9B ~            .done:
 160+ 7C9B ~                pop  hl
 161+ 7C9B ~                pop  de
 162+ 7C9B ~                pop  bc
 163+ 7C9B ~                pop  af
 164+ 7C9B ~                ret
 165+ 7C9B ~
 166+ 7C9B ~            Audio_MusicSheet:
 167+ 7C9B ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 7C9B ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 7C9B ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 7C9B ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
