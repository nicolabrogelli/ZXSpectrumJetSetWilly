 220+ 76B7 11 00 84         ld   de, TheOffLicenceLayout
 221+ 76BA B7               or   a
 222+ 76BB ED 52            sbc  hl, de
 223+ 76BD 20 05            jr   nz, .not_office
 224+ 76BF
 225+ 76BF 3E 00            ld   a, 0               ; Room ID = 0
 226+ 76C1 C3 86 7A         jp   .set_room
 227+ 76C4
 228+ 76C4              .not_office:
