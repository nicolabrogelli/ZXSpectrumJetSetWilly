1069+ 7A8C              ; Items_DrawRoom
1070+ 7A8C              ;
1071+ 7A8C              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
1072+ 7A8C              ;
1073+ 7A8C              ; Operazioni eseguite:
1074+ 7A8C              ;   1. Azzera la griglia items_grid.
1075+ 7A8C              ;   2. Svuota la cache degli oggetti attivi.
1076+ 7A8C              ;   3. Scansiona ItemsTable.
1077+ 7A8C              ;   4. Per ogni item della stanza corrente:
1078+ 7A8C              ;        - verifica se è già stato raccolto
1079+ 7A8C              ;        - disegna la grafica
1080+ 7A8C              ;        - aggiorna items_grid
1081+ 7A8C              ;        - memorizza l'item nella cache current_room_items
1082+ 7A8C              ;   5. Aggiorna num_room_items.
1083+ 7A8C              ;
1084+ 7A8C              ; Record ItemsTable:
1085+ 7A8C              ;   +0  Room ID
1086+ 7A8C              ;   +1  X (colonna)
1087+ 7A8C              ;   +2  Y (riga)
1088+ 7A8C              ;   +3  Colore
1089+ 7A8C              ;   +4  Collected flag
1090+ 7A8C              ;
1091+ 7A8C              ; Cache current_room_items:
1092+ 7A8C              ;   +0  Colonna
1093+ 7A8C              ;   +1  Riga
1094+ 7A8C              ;   +2  Colore
1095+ 7A8C              ;   +3  Collected flag ptr (Low)
1096+ 7A8C              ;   +4  Collected flag ptr (High)
1097+ 7A8C              ;
1098+ 7A8C              ; Ogni record cache occupa 5 byte.
1099+ 7A8C              ; -------------------------------------------------------------------
1100+ 7A8C              Items_DrawRoom:
1101+ 7A8C
1102+ 7A8C                  ; Salva tutti i registri utilizzati
1103+ 7A8C E5               push hl
1104+ 7A8D D5               push de
1105+ 7A8E C5               push bc
1106+ 7A8F DD E5            push ix
1107+ 7A91 FD E5            push iy
1108+ 7A93
1109+ 7A93                  ; ---------------------------------------------------------------
1110+ 7A93                  ; Azzera items_grid (32 x 16 = 512 byte)
1111+ 7A93                  ; ---------------------------------------------------------------
1112+ 7A93 21 26 E4         ld   hl, items_grid
1113+ 7A96 11 27 E4         ld   de, items_grid + 1
1114+ 7A99 36 00            ld   (hl), 0
1115+ 7A9B 01 FF 01         ld   bc, 511
1116+ 7A9E ED B0            ldir
1117+ 7AA0
1118+ 7AA0                  ; ---------------------------------------------------------------
1119+ 7AA0                  ; Nessun item attivo nella stanza
1120+ 7AA0                  ; ---------------------------------------------------------------
1121+ 7AA0 AF               xor  a
1122+ 7AA1 32 A4 E9         ld   (num_room_items), a
1123+ 7AA4
1124+ 7AA4                  ; IY punta alla cache degli item attivi
1125+ 7AA4 FD 21 54 E9      ld   iy, current_room_items
1126+ 7AA8
1127+ 7AA8                  ; ---------------------------------------------------------------
1128+ 7AA8                  ; Recupera il puntatore alla bitmap dell'oggetto associato
1129+ 7AA8                  ; alla stanza corrente.
1130+ 7AA8                  ;
1131+ 7AA8                  ; room_ptr + OFFSET_ITEM_GRAPHIC
1132+ 7AA8                  ; ---------------------------------------------------------------
1133+ 7AA8 2A A5 E9         ld   hl, (room_ptr)
1134+ 7AAB 11 E3 00         ld   de, OFFSET_ITEM_GRAPHIC
1135+ 7AAE 19               add  hl, de
1136+ 7AAF
1137+ 7AAF E5               push hl
1138+ 7AB0 DD E1            pop  ix                ; IX = bitmap item
1139+ 7AB2
1140+ 7AB2                  ; ---------------------------------------------------------------
1141+ 7AB2                  ; Inizio scansione della tabella degli item
1142+ 7AB2                  ; ---------------------------------------------------------------
1143+ 7AB2 21 44 75         ld   hl, ItemsTable
1144+ 7AB5
1145+ 7AB5              .loop:
1146+ 7AB5
1147+ 7AB5                  ; ---------------------------------------------------------------
1148+ 7AB5                  ; Legge il Room ID del record corrente
1149+ 7AB5                  ; ---------------------------------------------------------------
1150+ 7AB5 7E               ld   a, (hl)
1151+ 7AB6
1152+ 7AB6                  ; $FF indica fine tabella
1153+ 7AB6 FE FF            cp   $FF
1154+ 7AB8 28 53            jr   z, .done
1155+ 7ABA
1156+ 7ABA                  ; ---------------------------------------------------------------
1157+ 7ABA                  ; Verifica se l'item appartiene alla stanza corrente
1158+ 7ABA                  ; ---------------------------------------------------------------
1159+ 7ABA 57               ld   d, a
1160+ 7ABB
1161+ 7ABB 3A 4B E9         ld   a, (current_room)
1162+ 7ABE BA               cp   d
1163+ 7ABF 20 45            jr   nz, .next_item
1164+ 7AC1
1165+ 7AC1                  ; ---------------------------------------------------------------
1166+ 7AC1                  ; Legge i dati dell'item
1167+ 7AC1                  ; ---------------------------------------------------------------
1168+ 7AC1
1169+ 7AC1 23               inc  hl
1170+ 7AC2 4E               ld   c, (hl)           ; X (colonna)
1171+ 7AC3
1172+ 7AC3 23               inc  hl
1173+ 7AC4 46               ld   b, (hl)           ; Y (riga)
1174+ 7AC5
1175+ 7AC5 23               inc  hl
1176+ 7AC6 5E               ld   e, (hl)           ; Colore
1177+ 7AC7
1178+ 7AC7 23               inc  hl
1179+ 7AC8 7E               ld   a, (hl)           ; Collected flag
1180+ 7AC9
1181+ 7AC9                  ; Se diverso da zero l'item è già stato raccolto
1182+ 7AC9 B7               or   a
1183+ 7ACA 20 3E            jr   nz, .next_no_inc
1184+ 7ACC
1185+ 7ACC                  ; ---------------------------------------------------------------
1186+ 7ACC                  ; Disegna l'item sullo schermo
1187+ 7ACC                  ;
1188+ 7ACC                  ; B = Row
1189+ 7ACC                  ; C = Column
1190+ 7ACC                  ; HL = bitmap pointer
1191+ 7ACC                  ; E = Color
1192+ 7ACC                  ; ---------------------------------------------------------------
1193+ 7ACC E5               push hl
1194+ 7ACD
1195+ 7ACD DD E5            push ix
1196+ 7ACF E1               pop  hl
1197+ 7AD0
1198+ 7AD0 CD 15 7B         call DrawItemGraphic
1199+ 7AD3
1200+ 7AD3 E1               pop  hl                ; ritorna al flag collected
1201+ 7AD4
1202+ 7AD4                  ; ---------------------------------------------------------------
1203+ 7AD4                  ; Aggiorna items_grid
1204+ 7AD4                  ;
1205+ 7AD4                  ; Calcolo:
1206+ 7AD4                  ;   offset = Row * 32 + Col
1207+ 7AD4                  ; ---------------------------------------------------------------
1208+ 7AD4 E5               push hl
1209+ 7AD5 D5               push de
1210+ 7AD6
1211+ 7AD6 26 00            ld   h, 0
1212+ 7AD8 68               ld   l, b              ; HL = Row
1213+ 7AD9
1214+ 7AD9 29               add  hl, hl            ; *2
1215+ 7ADA 29               add  hl, hl            ; *4
1216+ 7ADB 29               add  hl, hl            ; *8
1217+ 7ADC 29               add  hl, hl            ; *16
1218+ 7ADD 29               add  hl, hl            ; *32
1219+ 7ADE
1220+ 7ADE 16 00            ld   d, 0
1221+ 7AE0 59               ld   e, c              ; DE = Col
1222+ 7AE1
1223+ 7AE1 19               add  hl, de            ; Row*32 + Col
1224+ 7AE2
1225+ 7AE2 11 26 E4         ld   de, items_grid
1226+ 7AE5 19               add  hl, de            ; puntatore nella griglia
1227+ 7AE6
1228+ 7AE6 D1               pop  de                ; ripristina colore
1229+ 7AE7
1230+ 7AE7 73               ld   (hl), e           ; salva colore cella
1231+ 7AE8
1232+ 7AE8 E1               pop  hl
1233+ 7AE9
1234+ 7AE9                  ; ---------------------------------------------------------------
1235+ 7AE9                  ; Salva l'item nella cache della stanza
1236+ 7AE9                  ;
1237+ 7AE9                  ; Questo evita di dover scansionare tutta ItemsTable
1238+ 7AE9                  ; durante il controllo delle collisioni.
1239+ 7AE9                  ; ---------------------------------------------------------------
1240+ 7AE9
1241+ 7AE9 FD 71 00         ld   (iy+0), c         ; Colonna
1242+ 7AEC FD 70 01         ld   (iy+1), b         ; Riga
1243+ 7AEF FD 73 02         ld   (iy+2), e         ; Colore
1244+ 7AF2
1245+ 7AF2                  ; Salva il puntatore al flag "collected"
1246+ 7AF2 FD 75 03         ld   (iy+3), l         ; Low byte
1247+ 7AF5 FD 74 04         ld   (iy+4), h         ; High byte
1248+ 7AF8
1249+ 7AF8                  ; Passa al record successivo della cache
1250+ 7AF8 01 05 00         ld   bc, 5
1251+ 7AFB FD 09            add  iy, bc
1252+ 7AFD
1253+ 7AFD                  ; Incrementa il numero di item attivi
1254+ 7AFD 3A A4 E9         ld   a, (num_room_items)
1255+ 7B00 3C               inc  a
1256+ 7B01 32 A4 E9         ld   (num_room_items), a
1257+ 7B04
1258+ 7B04 18 04            jr   .next_no_inc
1259+ 7B06
1260+ 7B06              .next_item:
1261+ 7B06
1262+ 7B06                  ; ---------------------------------------------------------------
1263+ 7B06                  ; L'item non appartiene alla stanza corrente.
1264+ 7B06                  ; Salta i campi del record:
1265+ 7B06                  ;   X
1266+ 7B06                  ;   Y
1267+ 7B06                  ;   Color
1268+ 7B06                  ;   Collected
1269+ 7B06                  ; ---------------------------------------------------------------
1270+ 7B06 23               inc  hl
1271+ 7B07 23               inc  hl
1272+ 7B08 23               inc  hl
1273+ 7B09 23               inc  hl
1274+ 7B0A
1275+ 7B0A              .next_no_inc:
1276+ 7B0A
1277+ 7B0A                  ; ---------------------------------------------------------------
1278+ 7B0A                  ; Avanza al record successivo
1279+ 7B0A                  ; (prossimo Room ID)
1280+ 7B0A                  ; ---------------------------------------------------------------
1281+ 7B0A 23               inc  hl
1282+ 7B0B 18 A8            jr   .loop
1283+ 7B0D
1284+ 7B0D              .done:
1285+ 7B0D
1286+ 7B0D                  ; Ripristina i registri
1287+ 7B0D FD E1            pop  iy
1288+ 7B0F DD E1            pop  ix
1289+ 7B11 D1               pop  de
1290+ 7B12 C1               pop  bc
1291+ 7B13 E1               pop  hl
1292+ 7B14
1293+ 7B14 C9               ret
1294+ 7B15
1295+ 7B15              ; -------------------------------------------------------------------
1296+ 7B15              ; DrawItemGraphic
1297+ 7B15              ;
1298+ 7B15              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
1299+ 7B15              ; utilizzando una bitmap di 8 byte e un attributo colore.
1300+ 7B15              ;
1301+ 7B15              ; Input:
1302+ 7B15              ;   B = Riga attributi (3..18)
1303+ 7B15              ;   C = Colonna attributi (0..31)
1304+ 7B15              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
1305+ 7B15              ;   E = Attributo colore
1306+ 7B15              ;
1307+ 7B15              ; Output:
1308+ 7B15              ;   Nessuno
1309+ 7B15              ;
1310+ 7B15              ; Registri preservati:
1311+ 7B15              ;   BC, DE, HL
1312+ 7B15              ; -------------------------------------------------------------------
1313+ 7B15              DrawItemGraphic:
1314+ 7B15
1315+ 7B15                  ; Salva i registri originali
1316+ 7B15 C5               push bc
1317+ 7B16 D5               push de
1318+ 7B17 E5               push hl
1319+ 7B18
1320+ 7B18                  ; ---------------------------------------------------------------
1321+ 7B18                  ; Calcolo indirizzo bitmap dello Spectrum
1322+ 7B18                  ;
1323+ 7B18                  ; Ogni item occupa una cella attributi (8x8 pixel).
1324+ 7B18                  ;
1325+ 7B18                  ; Formula:
1326+ 7B18                  ;   High = $40 + (Row AND $18)
1327+ 7B18                  ;   Low  = (Row AND 7) * 32 + Col
1328+ 7B18                  ;
1329+ 7B18                  ; DE conterrà l'indirizzo della prima scanline.
1330+ 7B18                  ; ---------------------------------------------------------------
1331+ 7B18
1332+ 7B18 78               ld   a, b
1333+ 7B19 E6 18            and  $18
1334+ 7B1B C6 40            add  a, $40
1335+ 7B1D 57               ld   d, a              ; Byte alto indirizzo video
1336+ 7B1E
1337+ 7B1E 78               ld   a, b
1338+ 7B1F E6 07            and  7                 ; Riga interna al blocco da 8
1339+ 7B21
1340+ 7B21 87               add  a, a              ; *2
1341+ 7B22 87               add  a, a              ; *4
1342+ 7B23 87               add  a, a              ; *8
1343+ 7B24 87               add  a, a              ; *16
1344+ 7B25 87               add  a, a              ; *32
1345+ 7B26
1346+ 7B26 81               add  a, c              ; + colonna
1347+ 7B27
1348+ 7B27 5F               ld   e, a              ; Byte basso indirizzo video
1349+ 7B28
1350+ 7B28                  ; ---------------------------------------------------------------
1351+ 7B28                  ; Disegno bitmap
1352+ 7B28                  ;
1353+ 7B28                  ; Copia 8 byte consecutivi nella memoria video.
1354+ 7B28                  ; Ogni byte rappresenta una scanline da 8 pixel.
1355+ 7B28                  ; ---------------------------------------------------------------
1356+ 7B28
1357+ 7B28 C5               push bc                ; Conserva Row e Col
1358+ 7B29
1359+ 7B29 06 08            ld   b, 8              ; Numero scanline
1360+ 7B2B
1361+ 7B2B              .line_loop:
1362+ 7B2B
1363+ 7B2B 7E               ld   a, (hl)           ; Legge scanline bitmap
1364+ 7B2C 12               ld   (de), a           ; Scrive nella memoria video
1365+ 7B2D
1366+ 7B2D 14               inc  d                 ; Scanline successiva
1367+ 7B2E 23               inc  hl                ; Byte bitmap successivo
1368+ 7B2F
1369+ 7B2F 05               dec  b
1370+ 7B30 20 F9            jr   nz, .line_loop
1371+ 7B32
1372+ 7B32 C1               pop  bc                ; Ripristina Row e Col
1373+ 7B33
1374+ 7B33                  ; ---------------------------------------------------------------
1375+ 7B33                  ; Calcolo indirizzo attributo
1376+ 7B33                  ;
1377+ 7B33                  ; Formula:
1378+ 7B33                  ;   AttrAddr = $5800 + Row * 32 + Col
1379+ 7B33                  ;
1380+ 7B33                  ; HL conterrà l'indirizzo della cella attributi.
1381+ 7B33                  ; ---------------------------------------------------------------
1382+ 7B33
1383+ 7B33 26 00            ld   h, 0
1384+ 7B35 68               ld   l, b              ; HL = Row
1385+ 7B36
1386+ 7B36 29               add  hl, hl            ; *2
1387+ 7B37 29               add  hl, hl            ; *4
1388+ 7B38 29               add  hl, hl            ; *8
1389+ 7B39 29               add  hl, hl            ; *16
1390+ 7B3A 29               add  hl, hl            ; *32
1391+ 7B3B
1392+ 7B3B 79               ld   a, c              ; A = Colonna
1393+ 7B3C
1394+ 7B3C 85               add  a, l
1395+ 7B3D 6F               ld   l, a
1396+ 7B3E
1397+ 7B3E 30 01            jr   nc, .no_carry
1398+ 7B40 24               inc  h
1399+ 7B41
1400+ 7B41              .no_carry:
1401+ 7B41
1402+ 7B41                  ; HL = Row * 32 + Col
1403+ 7B41
1404+ 7B41 11 00 58         ld   de, $5800
1405+ 7B44 19               add  hl, de            ; HL = indirizzo attributi
1406+ 7B45
1407+ 7B45                  ; ---------------------------------------------------------------
1408+ 7B45                  ; Recupera il colore originale dallo stack.
1409+ 7B45                  ;
1410+ 7B45                  ; Layout stack:
1411+ 7B45                  ;   HL originale
1412+ 7B45                  ;   DE originale (E = colore)
1413+ 7B45                  ;   BC originale
1414+ 7B45                  ; ---------------------------------------------------------------
1415+ 7B45
1416+ 7B45 C1               pop  bc                ; Recupera HL originale
1417+ 7B46 D1               pop  de                ; Recupera DE originale
1418+ 7B47
1419+ 7B47                  ; ---------------------------------------------------------------
1420+ 7B47                  ; Scrive l'attributo colore
1421+ 7B47                  ; ---------------------------------------------------------------
1422+ 7B47
1423+ 7B47 7B               ld   a, e              ; A = colore
1424+ 7B48 77               ld   (hl), a           ; Scrive nella RAM attributi
1425+ 7B49
1426+ 7B49                  ; ---------------------------------------------------------------
1427+ 7B49                  ; Ripristina HL e BC originali
1428+ 7B49                  ; ---------------------------------------------------------------
1429+ 7B49
1430+ 7B49 C5               push bc
1431+ 7B4A E1               pop  hl                ; HL originale
1432+ 7B4B
1433+ 7B4B C1               pop  bc                ; BC originale
1434+ 7B4C
1435+ 7B4C C9               ret
1436+ 7B4D
1437+ 7B4D              ; -------------------------------------------------------------------
1438+ 7B4D              ; RestoreBackgroundCell
1439+ 7B4D              ;
1440+ 7B4D              ; Ripristina il contenuto originale di una cella della stanza.
1441+ 7B4D              ; Viene utilizzata principalmente quando un item viene raccolto:
1442+ 7B4D              ; invece di lasciare un "buco", la routine ridisegna il tile
1443+ 7B4D              ; originale presente nella mappa della stanza.
1444+ 7B4D              ;
1445+ 7B4D              ; Input:
1446+ 7B4D              ;   B = Row (3..18)
1447+ 7B4D              ;   C = Col (0..31)
1448+ 7B4D              ;
1449+ 7B4D              ; Utilizza:
1450+ 7B4D              ;   room_ptr -> struttura dati della stanza corrente
1451+ 7B4D              ;   GetCellFromUnpacked -> restituisce il tipo di cella
1452+ 7B4D              ;   Gfx_DrawTile -> ridisegna il tile selezionato
1453+ 7B4D              ;
1454+ 7B4D              ; Tipi di cella:
1455+ 7B4D              ;   0 = Background
1456+ 7B4D              ;   1 = Floor
1457+ 7B4D              ;   2 = Wall
1458+ 7B4D              ;   3 = Nasty
1459+ 7B4D              ; -------------------------------------------------------------------
1460+ 7B4D              RestoreBackgroundCell:
1461+ 7B4D
1462+ 7B4D                  ; Salva tutti i registri utilizzati
1463+ 7B4D FD E5            push iy
1464+ 7B4F C5               push bc
1465+ 7B50 D5               push de
1466+ 7B51 E5               push hl
1467+ 7B52 DD E5            push ix
1468+ 7B54
1469+ 7B54                  ; ---------------------------------------------------------------
1470+ 7B54                  ; Conserva Row e Col in IY.
1471+ 7B54                  ;
1472+ 7B54                  ; Dopo la chiamata a GetCellFromUnpacked e i calcoli successivi
1473+ 7B54                  ; BC potrebbe essere modificato.
1474+ 7B54                  ; ---------------------------------------------------------------
1475+ 7B54 C5               push bc
1476+ 7B55 FD E1            pop  iy                ; IYH = Row, IYL = Col
1477+ 7B57
1478+ 7B57                  ; ---------------------------------------------------------------
1479+ 7B57                  ; Determina quale tipo di cella è presente nella posizione
1480+ 7B57                  ; specificata.
1481+ 7B57                  ;
1482+ 7B57                  ; Input:
1483+ 7B57                  ;   B = Row
1484+ 7B57                  ;   C = Col
1485+ 7B57                  ;
1486+ 7B57                  ; Output:
1487+ 7B57                  ;   A = tipo cella
1488+ 7B57                  ; ---------------------------------------------------------------
1489+ 7B57 78               ld   a, b
1490+ 7B58
1491+ 7B58 CD 30 6E         call GetCellFromUnpacked
1492+ 7B5B
1493+ 7B5B                  ; ---------------------------------------------------------------
1494+ 7B5B                  ; Recupera il puntatore alla stanza corrente.
1495+ 7B5B                  ;
1496+ 7B5B                  ; DE = base della struttura stanza
1497+ 7B5B                  ; ---------------------------------------------------------------
1498+ 7B5B ED 5B A5 E9      ld   de, (room_ptr)
1499+ 7B5F
1500+ 7B5F                  ; ---------------------------------------------------------------
1501+ 7B5F                  ; Seleziona il tile corretto in base al tipo di cella.
1502+ 7B5F                  ;
1503+ 7B5F                  ; A = 0 -> Background
1504+ 7B5F                  ; A = 1 -> Floor
1505+ 7B5F                  ; A = 2 -> Wall
1506+ 7B5F                  ; A = 3 -> Nasty
1507+ 7B5F                  ; ---------------------------------------------------------------
1508+ 7B5F
1509+ 7B5F B7               or   a
1510+ 7B60 20 06            jr   nz, .not_bg
1511+ 7B62
1512+ 7B62                  ; Background
1513+ 7B62 21 A0 00         ld   hl, OFFSET_BG
1514+ 7B65 19               add  hl, de
1515+ 7B66 18 16            jr   .draw_cell
1516+ 7B68
1517+ 7B68              .not_bg:
1518+ 7B68
1519+ 7B68 3D               dec  a
1520+ 7B69 20 06            jr   nz, .not_floor
1521+ 7B6B
1522+ 7B6B                  ; Floor
1523+ 7B6B 21 A9 00         ld   hl, OFFSET_FLOOR
1524+ 7B6E 19               add  hl, de
1525+ 7B6F 18 0D            jr   .draw_cell
1526+ 7B71
1527+ 7B71              .not_floor:
1528+ 7B71
1529+ 7B71 3D               dec  a
1530+ 7B72 20 06            jr   nz, .not_wall
1531+ 7B74
1532+ 7B74                  ; Wall
1533+ 7B74 21 B2 00         ld   hl, OFFSET_WALL
1534+ 7B77 19               add  hl, de
1535+ 7B78 18 04            jr   .draw_cell
1536+ 7B7A
1537+ 7B7A              .not_wall:
1538+ 7B7A
1539+ 7B7A                  ; Nasty
1540+ 7B7A 21 BB 00         ld   hl, OFFSET_NASTY
1541+ 7B7D 19               add  hl, de
1542+ 7B7E
1543+ 7B7E              .draw_cell:
1544+ 7B7E
1545+ 7B7E                  ; ---------------------------------------------------------------
1546+ 7B7E                  ; HL punta ora alla grafica del tile da ridisegnare.
1547+ 7B7E                  ;
1548+ 7B7E                  ; Gfx_DrawTile si aspetta:
1549+ 7B7E                  ;   IX = puntatore tile
1550+ 7B7E                  ;   B  = Row
1551+ 7B7E                  ;   C  = Col
1552+ 7B7E                  ; ---------------------------------------------------------------
1553+ 7B7E E5               push hl
1554+ 7B7F DD E1            pop  ix
1555+ 7B81
1556+ 7B81                  ; Ripristina Row e Col salvati in IY
1557+ 7B81 FD E5            push iy
1558+ 7B83 C1               pop  bc
1559+ 7B84
1560+ 7B84                  ; Disegna il tile originale
1561+ 7B84 CD 47 62         call Gfx_DrawTile
1562+ 7B87
1563+ 7B87                  ; ---------------------------------------------------------------
1564+ 7B87                  ; Ripristina i registri salvati
1565+ 7B87                  ; ---------------------------------------------------------------
1566+ 7B87 DD E1            pop  ix
1567+ 7B89 E1               pop  hl
1568+ 7B8A D1               pop  de
1569+ 7B8B C1               pop  bc
1570+ 7B8C FD E1            pop  iy
1571+ 7B8E
1572+ 7B8E C9               ret
1573+ 7B8F
1574+ 7B8F              ; -------------------------------------------------------------------
1575+ 7B8F              ; CheckWillyItemCollision
1576+ 7B8F              ;
1577+ 7B8F              ; Verifica se Willy collide con un item utilizzando il controllo
1578+ 7B8F              ; di sovrapposizione tra rettangoli (Bounding Box Collision).
1579+ 7B8F              ;
1580+ 7B8F              ; Input:
1581+ 7B8F              ;   A = ItemX (colonna attributi 0..31)
1582+ 7B8F              ;   H = ItemY (riga attributi 3..18)
1583+ 7B8F              ;
1584+ 7B8F              ; Coordinate item:
1585+ 7B8F              ;   Ogni item occupa una cella da 8x8 pixel.
1586+ 7B8F              ;
1587+ 7B8F              ; Coordinate Willy:
1588+ 7B8F              ;   Willy occupa un rettangolo di 16x16 pixel.
1589+ 7B8F              ;
1590+ 7B8F              ; Output:
1591+ 7B8F              ;   Carry Set   = collisione rilevata
1592+ 7B8F              ;   Carry Clear = nessuna collisione
1593+ 7B8F              ;
1594+ 7B8F              ; Registri preservati:
1595+ 7B8F              ;   BC, DE, HL
1596+ 7B8F              ; -------------------------------------------------------------------
1597+ 7B8F              CheckWillyItemCollision:
1598+ 7B8F
1599+ 7B8F                  ; Salva i registri utilizzati
1600+ 7B8F C5               push bc
1601+ 7B90 D5               push de
1602+ 7B91 E5               push hl
1603+ 7B92
1604+ 7B92                  ; ---------------------------------------------------------------
1605+ 7B92                  ; Calcola il bounding box orizzontale dell'item
1606+ 7B92                  ;
1607+ 7B92                  ; ItemLeft  = ItemX * 8
1608+ 7B92                  ; ItemRight = ItemLeft + 7
1609+ 7B92                  ;
1610+ 7B92                  ; E = ItemLeft
1611+ 7B92                  ; D = ItemRight
1612+ 7B92                  ; ---------------------------------------------------------------
1613+ 7B92 6F               ld   l, a              ; L = ItemX
1614+ 7B93
1615+ 7B93 7D               ld   a, l
1616+ 7B94 87               add  a, a              ; *2
1617+ 7B95 87               add  a, a              ; *4
1618+ 7B96 87               add  a, a              ; *8
1619+ 7B97
1620+ 7B97 5F               ld   e, a              ; E = ItemLeft
1621+ 7B98
1622+ 7B98 C6 07            add  a, 7
1623+ 7B9A 57               ld   d, a              ; D = ItemRight
1624+ 7B9B
1625+ 7B9B                  ; ---------------------------------------------------------------
1626+ 7B9B                  ; Recupera la posizione corrente di Willy
1627+ 7B9B                  ;
1628+ 7B9B                  ; B = WillyY
1629+ 7B9B                  ; C = WillyX
1630+ 7B9B                  ; ---------------------------------------------------------------
1631+ 7B9B ED 4B 26 E6      ld   bc, (PlayerPos)
1632+ 7B9F
1633+ 7B9F                  ; ---------------------------------------------------------------
1634+ 7B9F                  ; Primo test:
1635+ 7B9F                  ;
1636+ 7B9F                  ; WillyLeft <= ItemRight
1637+ 7B9F                  ;
1638+ 7B9F                  ; Se Willy è completamente a destra dell'item
1639+ 7B9F                  ; non può esserci collisione.
1640+ 7B9F                  ; ---------------------------------------------------------------
1641+ 7B9F 79               ld   a, c              ; A = WillyLeft
1642+ 7BA0
1643+ 7BA0 BA               cp   d                 ; WillyLeft vs ItemRight
1644+ 7BA1
1645+ 7BA1 28 04            jr   z, .x_ok
1646+ 7BA3 38 02            jr   c, .x_ok
1647+ 7BA5
1648+ 7BA5 18 29            jr   .no_collision
1649+ 7BA7
1650+ 7BA7              .x_ok:
1651+ 7BA7
1652+ 7BA7                  ; ---------------------------------------------------------------
1653+ 7BA7                  ; Secondo test:
1654+ 7BA7                  ;
1655+ 7BA7                  ; WillyRight >= ItemLeft
1656+ 7BA7                  ;
1657+ 7BA7                  ; WillyRight = WillyX + 7
1658+ 7BA7                  ; ---------------------------------------------------------------
1659+ 7BA7 C6 07            add  a, 7
1660+ 7BA9
1661+ 7BA9 BB               cp   e                 ; WillyRight vs ItemLeft
1662+ 7BAA
1663+ 7BAA 28 04            jr   z, .y_check
1664+ 7BAC 30 02            jr   nc, .y_check
1665+ 7BAE
1666+ 7BAE 18 20            jr   .no_collision
1667+ 7BB0
1668+ 7BB0              .y_check:
1669+ 7BB0
1670+ 7BB0                  ; ---------------------------------------------------------------
1671+ 7BB0                  ; Recupera ItemY dal valore originale di HL
1672+ 7BB0                  ;
1673+ 7BB0                  ; H contiene la riga dell'item.
1674+ 7BB0                  ; ---------------------------------------------------------------
1675+ 7BB0 E1               pop  hl
1676+ 7BB1 E5               push hl
1677+ 7BB2
1678+ 7BB2                  ; ---------------------------------------------------------------
1679+ 7BB2                  ; Calcola il bounding box verticale dell'item
1680+ 7BB2                  ;
1681+ 7BB2                  ; ItemTop    = ItemY * 8
1682+ 7BB2                  ; ItemBottom = ItemTop + 7
1683+ 7BB2                  ;
1684+ 7BB2                  ; E = ItemTop
1685+ 7BB2                  ; D = ItemBottom
1686+ 7BB2                  ; ---------------------------------------------------------------
1687+ 7BB2 7C               ld   a, h
1688+ 7BB3
1689+ 7BB3 87               add  a, a              ; *2
1690+ 7BB4 87               add  a, a              ; *4
1691+ 7BB5 87               add  a, a              ; *8
1692+ 7BB6
1693+ 7BB6 5F               ld   e, a              ; ItemTop
1694+ 7BB7
1695+ 7BB7 C6 07            add  a, 7
1696+ 7BB9 57               ld   d, a              ; ItemBottom
1697+ 7BBA
1698+ 7BBA                  ; ---------------------------------------------------------------
1699+ 7BBA                  ; Primo test verticale:
1700+ 7BBA                  ;
1701+ 7BBA                  ; WillyTop <= ItemBottom
1702+ 7BBA                  ; ---------------------------------------------------------------
1703+ 7BBA 78               ld   a, b              ; WillyTop
1704+ 7BBB
1705+ 7BBB BA               cp   d
1706+ 7BBC
1707+ 7BBC 28 04            jr   z, .y_ok
1708+ 7BBE 38 02            jr   c, .y_ok
1709+ 7BC0
1710+ 7BC0 18 0E            jr   .no_collision
1711+ 7BC2
1712+ 7BC2              .y_ok:
1713+ 7BC2
1714+ 7BC2                  ; ---------------------------------------------------------------
1715+ 7BC2                  ; Secondo test verticale:
1716+ 7BC2                  ;
1717+ 7BC2                  ; WillyBottom >= ItemTop
1718+ 7BC2                  ;
1719+ 7BC2                  ; WillyBottom = WillyY + 15
1720+ 7BC2                  ; ---------------------------------------------------------------
1721+ 7BC2 C6 0F            add  a, 15
1722+ 7BC4
1723+ 7BC4 BB               cp   e
1724+ 7BC5
1725+ 7BC5 28 04            jr   z, .collision
1726+ 7BC7 30 02            jr   nc, .collision
1727+ 7BC9
1728+ 7BC9 18 05            jr   .no_collision
1729+ 7BCB
1730+ 7BCB              .collision:
1731+ 7BCB
1732+ 7BCB                  ; ---------------------------------------------------------------
1733+ 7BCB                  ; Collisione rilevata
1734+ 7BCB                  ; ---------------------------------------------------------------
1735+ 7BCB E1               pop  hl
1736+ 7BCC D1               pop  de
1737+ 7BCD C1               pop  bc
1738+ 7BCE
1739+ 7BCE 37               scf                    ; Carry = 1
1740+ 7BCF
1741+ 7BCF C9               ret
1742+ 7BD0
1743+ 7BD0              .no_collision:
1744+ 7BD0
1745+ 7BD0                  ; ---------------------------------------------------------------
1746+ 7BD0                  ; Nessuna collisione
1747+ 7BD0                  ; ---------------------------------------------------------------
1748+ 7BD0 E1               pop  hl
1749+ 7BD1 D1               pop  de
1750+ 7BD2 C1               pop  bc
1751+ 7BD3
1752+ 7BD3 B7               or   a                 ; Carry = 0
1753+ 7BD4
1754+ 7BD4 C9               ret
1755+ 7BD5
1756+ 7BD5              ; -------------------------------------------------------------------
1757+ 7BD5              ; Items_CheckCollision
1758+ 7BD5              ;
1759+ 7BD5              ; Controlla se Willy entra in collisione con uno degli item
1760+ 7BD5              ; attivi presenti nella stanza corrente.
1761+ 7BD5              ;
1762+ 7BD5              ; Per ogni item:
1763+ 7BD5              ;   - verifica che appartenga alla stanza corrente
1764+ 7BD5              ;   - verifica che non sia già stato raccolto
1765+ 7BD5              ;   - esegue il test di collisione con Willy
1766+ 7BD5              ;
1767+ 7BD5              ; Se l'item viene raccolto:
1768+ 7BD5              ;   - imposta il flag "collected"
1769+ 7BD5              ;   - rimuove l'item dalla cache items_grid
1770+ 7BD5              ;   - incrementa il contatore degli oggetti raccolti
1771+ 7BD5              ;   - aggiorna l'HUD
1772+ 7BD5              ;   - ripristina il tile di sfondo
1773+ 7BD5              ;   - riproduce il suono di raccolta
1774+ 7BD5              ;
1775+ 7BD5              ; Formato record ItemsTable:
1776+ 7BD5              ;   +0 RoomID
1777+ 7BD5              ;   +1 X
1778+ 7BD5              ;   +2 Y
1779+ 7BD5              ;   +3 Color
1780+ 7BD5              ;   +4 Collected
1781+ 7BD5              ;
1782+ 7BD5              ; Fine tabella:
1783+ 7BD5              ;   RoomID = $FF
1784+ 7BD5              ; -------------------------------------------------------------------
1785+ 7BD5              Items_CheckCollision:
1786+ 7BD5
1787+ 7BD5                  ; Salva i registri utilizzati
1788+ 7BD5 E5               push hl
1789+ 7BD6 D5               push de
1790+ 7BD7 C5               push bc
1791+ 7BD8
1792+ 7BD8                  ; Inizio scansione della tabella degli item
1793+ 7BD8 21 44 75         ld   hl, ItemsTable
1794+ 7BDB
1795+ 7BDB              .loop:
1796+ 7BDB
1797+ 7BDB                  ; ---------------------------------------------------------------
1798+ 7BDB                  ; Legge il Room ID dell'item corrente
1799+ 7BDB                  ; ---------------------------------------------------------------
1800+ 7BDB 7E               ld   a, (hl)
1801+ 7BDC
1802+ 7BDC                  ; $FF indica fine tabella
1803+ 7BDC FE FF            cp   $FF
1804+ 7BDE 28 4D            jr   z, .done
1805+ 7BE0
1806+ 7BE0                  ; ---------------------------------------------------------------
1807+ 7BE0                  ; Verifica se l'item appartiene alla stanza corrente
1808+ 7BE0                  ; ---------------------------------------------------------------
1809+ 7BE0 57               ld   d, a              ; D = RoomID item
1810+ 7BE1
1811+ 7BE1 3A 4B E9         ld   a, (current_room)
1812+ 7BE4 BA               cp   d
1813+ 7BE5
1814+ 7BE5                  ; Se appartiene a un'altra stanza salta il record
1815+ 7BE5 20 3F            jr   nz, .next_item
1816+ 7BE7
1817+ 7BE7                  ; ---------------------------------------------------------------
1818+ 7BE7                  ; Legge coordinate e stato dell'item
1819+ 7BE7                  ; ---------------------------------------------------------------
1820+ 7BE7
1821+ 7BE7 23               inc  hl
1822+ 7BE8 4E               ld   c, (hl)           ; C = X
1823+ 7BE9
1824+ 7BE9 23               inc  hl
1825+ 7BEA 46               ld   b, (hl)           ; B = Y
1826+ 7BEB
1827+ 7BEB 23               inc  hl                ; salta Color
1828+ 7BEC
1829+ 7BEC 23               inc  hl                ; punta a Collected
1830+ 7BED
1831+ 7BED 7E               ld   a, (hl)
1832+ 7BEE
1833+ 7BEE                  ; ---------------------------------------------------------------
1834+ 7BEE                  ; Item già raccolto?
1835+ 7BEE                  ; ---------------------------------------------------------------
1836+ 7BEE B7               or   a
1837+ 7BEF 20 39            jr   nz, .next_no_inc
1838+ 7BF1
1839+ 7BF1                  ; ---------------------------------------------------------------
1840+ 7BF1                  ; Test collisione Willy ↔ Item
1841+ 7BF1                  ;
1842+ 7BF1                  ; Input richiesto:
1843+ 7BF1                  ;   A = ItemX
1844+ 7BF1                  ;   H = ItemY
1845+ 7BF1                  ; ---------------------------------------------------------------
1846+ 7BF1 79               ld   a, c
1847+ 7BF2
1848+ 7BF2 E5               push hl                ; salva puntatore al flag Collected
1849+ 7BF3
1850+ 7BF3 60               ld   h, b
1851+ 7BF4
1852+ 7BF4 CD 8F 7B         call CheckWillyItemCollision
1853+ 7BF7
1854+ 7BF7 E1               pop  hl
1855+ 7BF8
1856+ 7BF8                  ; Nessuna collisione
1857+ 7BF8 30 30            jr   nc, .next_no_inc
1858+ 7BFA
1859+ 7BFA                  ; ===============================================================
1860+ 7BFA                  ; ITEM RACCOLTO
1861+ 7BFA                  ; ===============================================================
1862+ 7BFA
1863+ 7BFA                  ; ---------------------------------------------------------------
1864+ 7BFA                  ; Marca l'item come raccolto
1865+ 7BFA                  ; ---------------------------------------------------------------
1866+ 7BFA 36 01            ld   (hl), 1
1867+ 7BFC
1868+ 7BFC                  ; ---------------------------------------------------------------
1869+ 7BFC                  ; Rimuove l'item dalla cache items_grid
1870+ 7BFC                  ;
1871+ 7BFC                  ; Calcolo:
1872+ 7BFC                  ;   offset = Row * 32 + Col
1873+ 7BFC                  ; ---------------------------------------------------------------
1874+ 7BFC E5               push hl
1875+ 7BFD D5               push de
1876+ 7BFE
1877+ 7BFE 26 00            ld   h, 0
1878+ 7C00 68               ld   l, b              ; HL = Row
1879+ 7C01
1880+ 7C01 29               add  hl, hl            ; *2
1881+ 7C02 29               add  hl, hl            ; *4
1882+ 7C03 29               add  hl, hl            ; *8
1883+ 7C04 29               add  hl, hl            ; *16
1884+ 7C05 29               add  hl, hl            ; *32
1885+ 7C06
1886+ 7C06 59               ld   e, c
1887+ 7C07 16 00            ld   d, 0
1888+ 7C09
1889+ 7C09 19               add  hl, de            ; Row*32 + Col
1890+ 7C0A
1891+ 7C0A 11 26 E4         ld   de, items_grid
1892+ 7C0D 19               add  hl, de
1893+ 7C0E
1894+ 7C0E                  ; La cella non contiene più un item
1895+ 7C0E 36 00            ld   (hl), 0
1896+ 7C10
1897+ 7C10 D1               pop  de
1898+ 7C11 E1               pop  hl
1899+ 7C12
1900+ 7C12                  ; ---------------------------------------------------------------
1901+ 7C12                  ; Conserva il puntatore all'entry corrente
1902+ 7C12                  ; poiché le routine successive possono alterare HL.
1903+ 7C12                  ; ---------------------------------------------------------------
1904+ 7C12 E5               push hl
1905+ 7C13
1906+ 7C13                  ; ---------------------------------------------------------------
1907+ 7C13                  ; Aggiorna il numero di oggetti raccolti
1908+ 7C13                  ; ---------------------------------------------------------------
1909+ 7C13 3A 30 E6         ld   a, (items_collected)
1910+ 7C16
1911+ 7C16 3C               inc  a
1912+ 7C17
1913+ 7C17 32 30 E6         ld   (items_collected), a
1914+ 7C1A
1915+ 7C1A                  ; ---------------------------------------------------------------
1916+ 7C1A                  ; Aggiorna il contatore visualizzato a schermo
1917+ 7C1A                  ; ---------------------------------------------------------------
1918+ 7C1A CD 67 61         call Gfx_UpdateItemsCollectedDisplay
1919+ 7C1D
1920+ 7C1D                  ; ---------------------------------------------------------------
1921+ 7C1D                  ; Ripristina il tile originale della stanza
1922+ 7C1D                  ; eliminando la grafica dell'item.
1923+ 7C1D                  ;
1924+ 7C1D                  ; Input:
1925+ 7C1D                  ;   B = Row
1926+ 7C1D                  ;   C = Col
1927+ 7C1D                  ; ---------------------------------------------------------------
1928+ 7C1D CD 4D 7B         call RestoreBackgroundCell
1929+ 7C20
1930+ 7C20                  ; ---------------------------------------------------------------
1931+ 7C20                  ; Riproduce il suono di raccolta
1932+ 7C20                  ; ---------------------------------------------------------------
1933+ 7C20 CD 9C 7C         call Audio_PlayCollectSound
1934+ 7C23
1935+ 7C23                  ; Ripristina il puntatore alla tabella
1936+ 7C23 E1               pop  hl
1937+ 7C24
1938+ 7C24                  ; Continua con il record successivo
1939+ 7C24 18 04            jr   .next_no_inc
1940+ 7C26
1941+ 7C26              .next_item:
1942+ 7C26
1943+ 7C26                  ; ---------------------------------------------------------------
1944+ 7C26                  ; Salta i campi del record:
1945+ 7C26                  ;   X
1946+ 7C26                  ;   Y
1947+ 7C26                  ;   Color
1948+ 7C26                  ;   Collected
1949+ 7C26                  ; ---------------------------------------------------------------
1950+ 7C26 23               inc  hl
1951+ 7C27 23               inc  hl
1952+ 7C28 23               inc  hl
1953+ 7C29 23               inc  hl
1954+ 7C2A
1955+ 7C2A              .next_no_inc:
1956+ 7C2A
1957+ 7C2A                  ; ---------------------------------------------------------------
1958+ 7C2A                  ; Avanza al record successivo.
1959+ 7C2A                  ;
1960+ 7C2A                  ; Dopo Collected troviamo il RoomID dell'item seguente.
1961+ 7C2A                  ; ---------------------------------------------------------------
1962+ 7C2A 23               inc  hl
1963+ 7C2B
1964+ 7C2B 18 AE            jr   .loop
1965+ 7C2D
1966+ 7C2D              .done:
1967+ 7C2D
1968+ 7C2D                  ; Ripristina i registri
1969+ 7C2D C1               pop  bc
1970+ 7C2E D1               pop  de
1971+ 7C2F E1               pop  hl
1972+ 7C30
1973+ 7C30 C9               ret
1974+ 7C31
1975+ 7C31
1976+ 7C31
1977+ 7C31              ; -------------------------------------------------------------------
1978+ 7C31              ; CheckActiveItemAtCell
1979+ 7C31              ;
1980+ 7C31              ; Verifica in modo rapido se esiste un item attivo (non raccolto)
1981+ 7C31              ; nella cella specificata della griglia items_grid.
1982+ 7C31              ;
1983+ 7C31              ; Questa routine usa una lookup diretta su una mappa 32x16,
1984+ 7C31              ; evitando la scansione della ItemsTable.
1985+ 7C31              ;
1986+ 7C31              ; Input:
1987+ 7C31              ;   B = Colonna (0..31)
1988+ 7C31              ;   C = Riga (0..15)
1989+ 7C31              ;
1990+ 7C31              ; Output:
1991+ 7C31              ;   Carry Set   = item presente nella cella
1992+ 7C31              ;   Carry Clear = nessun item
1993+ 7C31              ;
1994+ 7C31              ; Nota:
1995+ 7C31              ;   HL NON è restituito valido (commento originale non corretto:
1996+ 7C31              ;   la routine non punta a ItemsTable).
1997+ 7C31              ; -------------------------------------------------------------------
1998+ 7C31              CheckActiveItemAtCell:
1999+ 7C31
2000+ 7C31                  ; Salva registri usati
2001+ 7C31 D5               push de
2002+ 7C32 E5               push hl
2003+ 7C33
2004+ 7C33                  ; ---------------------------------------------------------------
2005+ 7C33                  ; Calcolo indice lineare nella griglia 32x16:
2006+ 7C33                  ;
2007+ 7C33                  ; offset = Row * 32 + Col
2008+ 7C33                  ; ---------------------------------------------------------------
2009+ 7C33 26 00            ld   h, 0
2010+ 7C35 69               ld   l, c              ; HL = Row
2011+ 7C36
2012+ 7C36 29               add  hl, hl            ; *2
