1208+ 6E55 87               add  a, a              ; *4
1209+ 6E56 87               add  a, a              ; *8 (X start in pixel)
1210+ 6E57 5F               ld   e, a              ; E = X_left
1211+ 6E58
1212+ 6E58 3A 51 E9         ld   a, (ramp_len)
1213+ 6E5B 87               add  a, a              ; *2
1214+ 6E5C 87               add  a, a              ; *4
1215+ 6E5D 87               add  a, a              ; *8
1216+ 6E5E 83               add  a, e              ; A = (ramp_col + ramp_len) * 8 = X_right_boundary
1217+ 6E5F 67               ld   h, a              ; H = X_right_boundary
1218+ 6E60 38 10            jr   c, .no_right_bound_check_right
1219+ 6E62
1220+ 6E62 79               ld   a, c              ; A = PlayerX
1221+ 6E63 BB               cp   e
