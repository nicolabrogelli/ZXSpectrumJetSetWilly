 264+ 65EE              ; LoadPositionPlayeinRoom
 265+ 65EE              ;
 266+ 65EE              ; Inizializza la posizione del player (Willy) quando entra
 267+ 65EE              ; in una nuova stanza.
 268+ 65EE              ;
 269+ 65EE              ; La posizione viene letta direttamente dai dati della stanza
 270+ 65EE              ; (layout/metadata) a partire da room_ptr.
 271+ 65EE              ;
 272+ 65EE              ; Output:
 273+ 65EE              ;   PlayerPos     = posizione iniziale (Y, X)
 274+ 65EE              ;   PlayerPosOld  = copia della posizione iniziale
