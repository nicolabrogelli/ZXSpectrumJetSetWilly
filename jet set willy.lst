   7+ 6601              ; Input_CheckCtrl
   8+ 6601              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 6601              ;
  10+ 6601              ; Output:
  11+ 6601              ;   D = bitmask tasti attivi:
  12+ 6601              ;       bit 0 → sinistra (O)
  13+ 6601              ;       bit 1 → destra   (P)
  14+ 6601              ;       bit 2 → salto    (Z)
  15+ 6601              ;
  16+ 6601              ; Effetti collaterali in RAM:
  17+ 6601              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 6601              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 6601              ;   (jump_prev)     → debounce tasto salto
  20+ 6601              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 6601              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 6601              ; -------------------------------------------------------------------
  23+ 6601
  24+ 6601              Input_CheckCtrl:
  25+ 6601 AF               xor  a
  26+ 6602 32 3B E6         ld   (current_input_dir), a
  27+ 6605
  28+ 6605                  IF ENABLE_ROOM_SKIP_KEYS != 0
  29+ 6605                  ; ── Sezione 1a: tasto Q (cambio stanza AVANTI) ─────────────────────
  30+ 6605                  ;
  31+ 6605                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  32+ 6605                  ; Se bit 0 = 0, Q è premuto.
  33+ 6605
  34+ 6605 01 FE FB         ld   bc, $fbfe
  35+ 6608 ED 78            in   a, (c)
  36+ 660A CB 47            bit  0, a
  37+ 660C 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 660E
  39+ 660E                  ; Q è premuto: debounce tramite (q_prev).
  40+ 660E                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 660E 3A 3C E6         ld   a, (q_prev)
  42+ 6611 B7               or   a
  43+ 6612 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 6614
  45+ 6614                  ; ── Primo frame di pressione di Q ──
  46+ 6614 3E 01            ld   a, 1
  47+ 6616 32 3C E6         ld   (q_prev), a            ; marca "Q era premuto"
  48+ 6619
  49+ 6619                  ; NOTA sullo stack:
  50+ 6619                  ; Input_CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  51+ 6619                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChangeNext senza
  52+ 6619                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  53+ 6619                  ; poi JP salta direttamente.
  54+ 6619 E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  55+ 661A C3 C2 66         jp   PerformRoomChangeNext  ; salta al cambio stanza avanti (non torna qui)
  56+ 661D
  57+ 661D              .q_not_pressed:
  58+ 661D AF               xor  a
  59+ 661E 32 3C E6         ld   (q_prev), a            ; Q rilasciato → azzera debounce
  60+ 6621
  61+ 6621              .q_handled:
  62+ 6621
  63+ 6621                  ; ── Sezione 1b: tasto A (cambio stanza INDIETRO) ────────────────────
  64+ 6621                  ;
  65+ 6621                  ; Porta $FD → riga A, S, D, F, G. Bit 0 = A.
  66+ 6621                  ; Se bit 0 = 0, A è premuto.
  67+ 6621
  68+ 6621 01 FE FD         ld   bc, $fdfe
  69+ 6624 ED 78            in   a, (c)
  70+ 6626 CB 47            bit  0, a
  71+ 6628 20 0F            jr   nz, .a_not_pressed     ; bit 0 = 1 → A non premuto, salta
  72+ 662A
  73+ 662A                  ; A è premuto: debounce tramite (a_prev).
  74+ 662A 3A 3D E6         ld   a, (a_prev)
  75+ 662D B7               or   a
  76+ 662E 20 0D            jr   nz, .a_handled         ; era già premuto, niente da fare
  77+ 6630
  78+ 6630                  ; ── Primo frame di pressione di A ──
  79+ 6630 3E 01            ld   a, 1
  80+ 6632 32 3D E6         ld   (a_prev), a            ; marca "A era premuto"
  81+ 6635
  82+ 6635 E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  83+ 6636 C3 C6 66         jp   PerformRoomChangePrev  ; salta al cambio stanza indietro (non torna qui)
  84+ 6639
