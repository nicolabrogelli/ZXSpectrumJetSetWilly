1223+ 6E67
1224+ 6E67 BC               cp   h
1225+ 6E68 38 1E            jr   c, .on_ramp_slope ; Se PlayerX < X_right_boundary, pendenza rampa
1226+ 6E6A
1227+ 6E6A                  ; Controlla se è sulla cella della piattaforma adiacente in cima: [X_right_boundary, X_right_boundary + 7]
1228+ 6E6A 94               sub  h                 ; A = PlayerX - X_right_boundary
1229+ 6E6B FE 08            cp   8
