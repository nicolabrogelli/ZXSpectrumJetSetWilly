1105+ 6E01              ; Decomprime il layout della stanza (128 byte) in un buffer di 512 byte in RAM.
1106+ 6E01              ; Ciascuna cella occupa così 1 byte (valore 0..3), consentendo accessi O(1) velocissimi.
1107+ 6E01              ; -------------------------------------------------------------------
1108+ 6E01              UnpackRoomLayout:
1109+ 6E01 E5               push hl
1110+ 6E02 D5               push de
1111+ 6E03 C5               push bc
1112+ 6E04
1113+ 6E04 2A A5 E9         ld   hl, (room_ptr)     ; HL = inizio layout stanza (128 byte)
1114+ 6E07 11 4B E7         ld   de, unpacked_layout ; DE = buffer RAM
1115+ 6E0A 06 80            ld   b, 128             ; 128 byte
1116+ 6E0C              .byte_loop:
1117+ 6E0C 7E               ld   a, (hl)            ; Leggi byte compresso
1118+ 6E0D 23               inc  hl
1119+ 6E0E
1120+ 6E0E 4F               ld   c, a               ; C = salvataggio
1121+ 6E0F
1122+ 6E0F                  ; Cella 0: bit 7-6
1123+ 6E0F 07               rlca
1124+ 6E10 07               rlca
1125+ 6E11 E6 03            and  3
1126+ 6E13 12               ld   (de), a
1127+ 6E14 13               inc  de
1128+ 6E15
1129+ 6E15                  ; Cella 1: bit 5-4
1130+ 6E15 79               ld   a, c
1131+ 6E16 07               rlca
1132+ 6E17 07               rlca
1133+ 6E18 07               rlca
1134+ 6E19 07               rlca
1135+ 6E1A E6 03            and  3
1136+ 6E1C 12               ld   (de), a
1137+ 6E1D 13               inc  de
1138+ 6E1E
1139+ 6E1E                  ; Cella 2: bit 3-2
1140+ 6E1E 79               ld   a, c
1141+ 6E1F 0F               rrca
1142+ 6E20 0F               rrca
1143+ 6E21 E6 03            and  3
1144+ 6E23 12               ld   (de), a
1145+ 6E24 13               inc  de
1146+ 6E25
1147+ 6E25                  ; Cella 3: bit 1-0
1148+ 6E25 79               ld   a, c
1149+ 6E26 E6 03            and  3
1150+ 6E28 12               ld   (de), a
1151+ 6E29 13               inc  de
1152+ 6E2A
1153+ 6E2A 10 E0            djnz .byte_loop
1154+ 6E2C
1155+ 6E2C C1               pop  bc
1156+ 6E2D D1               pop  de
1157+ 6E2E E1               pop  hl
1158+ 6E2F C9               ret
