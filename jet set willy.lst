 293+ 65F4 19               add  hl, de
 294+ 65F5
 295+ 65F5                  ; ---------------------------------------------------------------
 296+ 65F5                  ; Legge posizione iniziale del player
 297+ 65F5                  ; ---------------------------------------------------------------
 298+ 65F5
 299+ 65F5 4E               ld   c, (hl)           ; C = X iniziale
 300+ 65F6 23               inc  hl
 301+ 65F7 46               ld   b, (hl)           ; B = Y iniziale
 302+ 65F8
 303+ 65F8                  ; ---------------------------------------------------------------
 304+ 65F8                  ; Salva posizione corrente e posizione precedente
 305+ 65F8                  ; ---------------------------------------------------------------
 306+ 65F8 ED 43 26 E6      ld   (PlayerPos), bc
 307+ 65FC ED 43 28 E6      ld   (PlayerPosOld), bc
