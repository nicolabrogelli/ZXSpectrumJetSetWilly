 790+ 7479 28 13            jr   z, .soldato_anim
 791+ 747B FE 15            cp   21                ; Tipo 21 = Parrucca?
 792+ 747D 28 0F            jr   z, .soldato_anim
 793+ 747F FE 1D            cp   29                ; Tipo 29 = Saliera?
 794+ 7481 28 0B            jr   z, .soldato_anim
