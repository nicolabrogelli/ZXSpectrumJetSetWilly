 121+ 6660 CB C2            set $00, d                  ; imposta bit 0 di D = "sinistra attiva"
 122+ 6662 DD CB 00 C6      set 0, (ix)                 ; flags bit 0 = "movimento in corso"
 123+ 6666 5F               ld  e, a                    ; salva A
