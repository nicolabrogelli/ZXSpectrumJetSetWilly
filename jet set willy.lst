 743+ 7432 3C               inc  a
 744+ 7433 47               ld   b, a                      ; B = timer + 1
 745+ 7434 3A A7 E9         ld   a, (enemy_update_rate)
 746+ 7437 B8               cp   b
 747+ 7438 28 0C            jr   z, .reset_timer
 748+ 743A 38 0A            jr   c, .reset_timer
 749+ 743C
 750+ 743C                  ; Salva contatore incrementato e salta l'aggiornamento
 751+ 743C 78               ld   a, b
 752+ 743D 32 A8 E9         ld   (enemy_update_timer), a
