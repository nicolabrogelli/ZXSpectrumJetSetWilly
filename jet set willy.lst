1255+ 6E8C 87               add  a, a              ; *4
1256+ 6E8D 87               add  a, a              ; *8
1257+ 6E8E D6 10            sub  16                ; A = ramp_row * 8 - 16
1258+ 6E90 83               add  a, e              ; A = ramp_row * 8 - 16 + X_left
1259+ 6E91 91               sub  c                 ; A = A - PlayerX
1260+ 6E92 57               ld   d, a              ; D = calculated Y
