1262+ 6E93                  ; H = platform_Y + 16 (confronto sicuro con offset +16)
1263+ 6E93 3A 52 E9         ld   a, (ramp_row)
1264+ 6E96 21 51 E9         ld   hl, ramp_len
1265+ 6E99 96               sub  (hl)
1266+ 6E9A 3C               inc  a                 ; A = Row
1267+ 6E9B 87               add  a, a              ; *2
1268+ 6E9C 87               add  a, a              ; *4
1269+ 6E9D 87               add  a, a              ; *8
1270+ 6E9E 67               ld   h, a              ; H = platform_Y + 16
1271+ 6E9F
1272+ 6E9F 7A               ld   a, d              ; A = calculated Y
1273+ 6EA0 C6 10            add  a, 16             ; A = calculated Y + 16
1274+ 6EA2 BC               cp   h                 ; Compare (calculated Y + 16) con (platform_Y + 16)
1275+ 6EA3 30 05            jr   nc, .no_clamp     ; Se calculated Y >= platform_Y, non limitare
1276+ 6EA5
1277+ 6EA5                  ; Altrimenti, limita a platform_Y
1278+ 6EA5 7C               ld   a, h
