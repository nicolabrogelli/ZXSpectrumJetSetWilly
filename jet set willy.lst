   8+ 7C4F              ; Audio_UpdateJumpSound
   9+ 7C4F              ;
  10+ 7C4F              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7C4F              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7C4F              ; -------------------------------------------------------------------
  13+ 7C4F              Audio_UpdateJumpSound:
  14+ 7C4F F5               push af
  15+ 7C50 C5               push bc
  16+ 7C51 D5               push de
  17+ 7C52 E5               push hl
  18+ 7C53
  19+ 7C53                  ; Controlla se il suono è attivo (note < 18)
  20+ 7C53 3A AC E9         ld   a, (Audio_jump_sound_note)
  21+ 7C56 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7C58 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7C5A
  24+ 7C5A                  ; Carica la nota corrente da suonare
  25+ 7C5A 5F               ld   e, a
  26+ 7C5B 16 00            ld   d, 0
  27+ 7C5D 21 89 7C         ld   hl, Audio_JumpSoundDelays
  28+ 7C60 19               add  hl, de
  29+ 7C61 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7C62 57               ld   d, a                      ; D = delay della nota
  31+ 7C63
  32+ 7C63                  ; Suona la nota: 15 cicli
  33+ 7C63 06 0F            ld   b, 15
  34+ 7C65              .note_loop:
  35+ 7C65                  ; Speaker ON
  36+ 7C65 3A 32 E6         ld   a, (room_border_color)
  37+ 7C68 F6 10            or   $10
  38+ 7C6A D3 FE            out  ($fe), a
  39+ 7C6C 4A               ld   c, d
  40+ 7C6D              .d1:
  41+ 7C6D 0D               dec  c
  42+ 7C6E 20 FD            jr   nz, .d1
  43+ 7C70
  44+ 7C70                  ; Speaker OFF
  45+ 7C70 3A 32 E6         ld   a, (room_border_color)
  46+ 7C73 E6 EF            and  $ef
  47+ 7C75 D3 FE            out  ($fe), a
  48+ 7C77 4A               ld   c, d
  49+ 7C78              .d2:
  50+ 7C78 0D               dec  c
  51+ 7C79 20 FD            jr   nz, .d2
  52+ 7C7B
  53+ 7C7B 10 E8            djnz .note_loop
  54+ 7C7D
  55+ 7C7D                  ; Passa alla nota successiva
  56+ 7C7D 3A AC E9         ld   a, (Audio_jump_sound_note)
  57+ 7C80 3C               inc  a
  58+ 7C81 32 AC E9         ld   (Audio_jump_sound_note), a
