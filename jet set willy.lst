 276+ 65EE              ; Struttura dati stanza:
 277+ 65EE              ;   OFFSET_POS_WILLY:
 278+ 65EE              ;       +0 = X
 279+ 65EE              ;       +1 = Y
 280+ 65EE              ; -------------------------------------------------------------------
 281+ 65EE              LoadPositionPlayeinRoom:
 282+ 65EE
 283+ 65EE                  ; ---------------------------------------------------------------
 284+ 65EE                  ; Accede alla struttura dati della stanza corrente
 285+ 65EE                  ; ---------------------------------------------------------------
 286+ 65EE 2A A5 E9         ld   hl, (room_ptr)
 287+ 65F1
 288+ 65F1                  ; ---------------------------------------------------------------
 289+ 65F1                  ; Salta all’offset dove è memorizzata la posizione iniziale
 290+ 65F1                  ; di Willy nella stanza
 291+ 65F1                  ; ---------------------------------------------------------------
