 944+ 6D66 3A 53 E9         ld   a, (ramp_col)
 945+ 6D69 3C               inc  a
 946+ 6D6A 4F               ld   c, a              ; C = limit_right (exclusive)
 947+ 6D6B
 948+ 6D6B 7B               ld   a, e              ; A = Col
 949+ 6D6C B8               cp   b
 950+ 6D6D 38 15            jr   c, .check_platform_case
 951+ 6D6F B9               cp   c
